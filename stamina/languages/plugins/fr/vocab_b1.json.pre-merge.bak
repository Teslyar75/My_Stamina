          "cefr_level": "A1",
          "word_slugs": [
            "kate-name"
          ]
        },
        {
          "id": "15203",
          "text": "Jean et Kate sont jumeaux.",
          "translation": "Джейн и Кейт — близнецы.",
          "source": "Tatoeba #15203 @dominiko / #835417 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/15203",
