      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6861599",
          "text": "Buvons à notre amitié.",
          "translation": "Выпьем за нашу дружбу.",
          "source": "Tatoeba #6861599 @Micsmithel / #6862529 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6861599",
          "cefr_level": "A1",
          "word_slugs": [
            "amitié-noun"
          ]
        },
        {
          "id": "7528159",
          "text": "L'amitié est importante.",
          "translation": "Дружба - это важно.",
          "source": "Tatoeba #7528159 @Micsmithel / #9003789 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7528159",
          "cefr_level": "A1",
          "word_slugs": [
            "amitié-noun"
          ]
        },
        {
          "id": "12747538",
          "text": "Notre amitié est solide.",
          "translation": "Наша дружба крепка.",
          "source": "Tatoeba #12747538 @LdjuherTaqvaylit / #12747548 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12747538",
          "cefr_level": "A1",
          "word_slugs": [
            "amitié-noun"
          ]
        },
        {
          "id": "10603667",
          "text": "Notre amitié est terminée.",
          "translation": "Наша дружба закончилась.",
          "source": "Tatoeba #10603667 @Adelpa / #11347724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10603667",
          "cefr_level": "A1",
          "word_slugs": [
            "amitié-noun"
          ]
        },
        {
          "id": "5721617",
          "text": "L'amitié ne vieillit pas.",
          "translation": "Дружба не стареет.",
          "source": "Tatoeba #5721617 @anino / #5943848 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5721617",
          "cefr_level": "A1",
          "word_slugs": [
            "amitié-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
