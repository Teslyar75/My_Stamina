    {
      "slug": "serons-verb",
      "lemma": "serons",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1980,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1997526",
          "text": "Nous y serons.",
          "translation": "Мы там будем.",
          "source": "Tatoeba #1997526 @sacredceltic / #3572387 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1997526",
          "cefr_level": "A1",
          "word_slugs": [
            "serons-verb"
          ]
        },
        {
          "id": "2567848",
          "text": "Où serons-nous ?",
          "translation": "Где мы будем?",
          "source": "Tatoeba #2567848 @Amastan / #13996749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2567848",
          "cefr_level": "A1",
          "word_slugs": [
            "serons-verb"
          ]
        },
        {
          "id": "10108844",
          "text": "Nous serons tués.",
          "translation": "Нас убьют.",
          "source": "Tatoeba #10108844 @Micsmithel / #2518016 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10108844",
          "cefr_level": "A1",
          "word_slugs": [
            "serons-verb"
          ]
        },
        {
          "id": "2076915",
          "text": "Nous serons prêts.",
          "translation": "Мы будем готовы.",
          "source": "Tatoeba #2076915 @Amastan / #2518005 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2076915",
          "cefr_level": "A1",
          "word_slugs": [
            "serons-verb"
          ]
        },
        {
          "id": "2077066",
          "text": "Nous serons déçus.",
          "translation": "Мы будем разочарованы.",
          "source": "Tatoeba #2077066 @Amastan / #3037418 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2077066",
          "cefr_level": "A1",
          "word_slugs": [
            "serons-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "serons",
