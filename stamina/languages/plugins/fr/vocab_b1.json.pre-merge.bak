      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8961009",
          "text": "Il s'est fait virer.",
          "translation": "Его уволили.",
          "source": "Tatoeba #8961009 @Micsmithel / #3758353 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8961009",
          "cefr_level": "A1",
          "word_slugs": [
            "virer-verb"
          ]
        },
        {
          "id": "12867456",
          "text": "Je pense à te virer.",
