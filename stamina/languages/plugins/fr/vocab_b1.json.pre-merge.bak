    {
      "slug": "lors-adv",
      "lemma": "lors",
      "pos": "adv",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1509,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "330289",
          "text": "Depuis lors nous sommes amis.",
          "translation": "С тех пор мы дружим.",
          "source": "Tatoeba #330289 @hortusdei / #9712953 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/330289",
          "cefr_level": "A1",
          "word_slugs": [
            "lors-adv"
          ]
        },
        {
          "id": "1540531",
          "text": "Nous ne le voyons pas depuis lors.",
          "translation": "Мы его с тех пор не видим.",
          "source": "Tatoeba #1540531 @Rovo / #12456291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1540531",
          "cefr_level": "A1",
          "word_slugs": [
            "lors-adv"
          ]
        },
        {
          "id": "12077263",
          "text": "Où étiez-vous lors de l'attentat ?",
          "translation": "Где вы были в момент покушения?",
          "source": "Tatoeba #12077263 @zogwarg / #12422180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12077263",
          "cefr_level": "A1",
          "word_slugs": [
            "lors-adv"
          ]
        },
        {
          "id": "1949390",
          "text": "Que lui est-il advenu, depuis lors ?",
          "translation": "Что с ним стало с тех пор?",
          "source": "Tatoeba #1949390 @sacredceltic / #445944 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1949390",
          "cefr_level": "A1",
          "word_slugs": [
            "lors-adv"
          ]
        },
        {
          "id": "1443571",
          "text": "La ville a beaucoup changé depuis lors.",
          "translation": "Город с тех пор очень изменился.",
          "source": "Tatoeba #1443571 @sacredceltic / #10625251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1443571",
          "cefr_level": "A1",
          "word_slugs": [
            "lors-adv"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
