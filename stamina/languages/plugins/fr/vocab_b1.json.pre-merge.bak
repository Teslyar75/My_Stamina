    {
      "slug": "politique-adj",
      "lemma": "politique",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1420,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "политический"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1173632",
          "text": "J'abhorre la politique.",
          "translation": "Я ненавижу политику.",
          "source": "Tatoeba #1173632 @sacredceltic / #1494810 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1173632",
          "cefr_level": "A1",
          "word_slugs": [
            "politique-adj"
          ]
        },
        {
          "id": "1173630",
          "text": "Je déteste la politique.",
          "translation": "Я ненавижу политику.",
          "source": "Tatoeba #1173630 @sacredceltic / #1494810 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1173630",
          "cefr_level": "A1",
          "word_slugs": [
            "politique-adj"
          ]
        },
        {
          "id": "7410936",
          "text": "Tom est homme politique.",
