    {
      "slug": "vacances-noun",
      "lemma": "vacances",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1339,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6192283",
          "text": "Vive les vacances !",
          "translation": "Да здравствуют каникулы!",
          "source": "Tatoeba #6192283 @felix63 / #6736847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6192283",
          "cefr_level": "A1",
          "word_slugs": [
            "vacances-noun"
          ]
        },
        {
          "id": "13499663",
          "text": "Bientôt les vacances !",
          "translation": "Скоро каникулы!",
          "source": "Tatoeba #13499663 @Rafik / #13504348 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13499663",
          "cefr_level": "A1",
          "word_slugs": [
            "vacances-noun"
          ]
        },
        {
          "id": "3093173",
          "text": "Vivement les vacances !",
          "translation": "Скорее бы каникулы!",
          "source": "Tatoeba #3093173 @Blabla / #3094523 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3093173",
          "cefr_level": "A1",
          "word_slugs": [
            "vacances-noun"
          ]
        },
        {
          "id": "576686",
          "text": "Es-tu en vacances ?",
          "translation": "Ты в отпуске?",
          "source": "Tatoeba #576686 @Shishir / #3837024 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/576686",
          "cefr_level": "A1",
          "word_slugs": [
            "vacances-noun"
          ]
        },
        {
          "id": "6538",
          "text": "Je suis en vacances.",
          "translation": "У меня каникулы.",
          "source": "Tatoeba #6538 @TRANG / #2574765 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6538",
          "cefr_level": "A1",
          "word_slugs": [
            "vacances-noun"
          ]
        }
      ],
