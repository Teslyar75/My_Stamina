      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "краткий"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4693354",
          "text": "Je serai bref.",
          "translation": "Буду краток.",
          "source": "Tatoeba #4693354 @sacredceltic / #2589803 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4693354",
          "cefr_level": "A1",
          "word_slugs": [
            "bref-adj"
          ]
        },
        {
          "id": "8486446",
          "text": "Bref, il avait tort.",
          "translation": "Короче, он был не прав.",
          "source": "Tatoeba #8486446 @Aiji / #2869526 @svetla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8486446",
          "cefr_level": "A1",
