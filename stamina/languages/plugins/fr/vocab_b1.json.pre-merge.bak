      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "856440",
          "text": "La polémique à deux balles !",
          "translation": "Дешёвая полемика!",
          "source": "Tatoeba #856440 @U2FS / #12694884 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/856440",
          "cefr_level": "A1",
          "word_slugs": [
            "balles-noun"
          ]
        },
        {
          "id": "10050026",
          "text": "Je sais jongler avec deux balles.",
          "translation": "Я умею жонглировать двумя мячами.",
          "source": "Tatoeba #10050026 @lbdx / #12013700 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10050026",
          "cefr_level": "A1",
          "word_slugs": [
            "balles-noun"
          ]
        },
        {
          "id": "10050027",
          "text": "Je sais jongler avec trois balles.",
          "translation": "Я умею жонглировать тремя мячами.",
          "source": "Tatoeba #10050027 @lbdx / #13650573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10050027",
          "cefr_level": "A1",
          "word_slugs": [
            "balles-noun"
          ]
        },
        {
          "id": "4468576",
          "text": "Je sais jongler avec quatre balles.",
          "translation": "Я умею жонглировать четырьмя мячами.",
          "source": "Tatoeba #4468576 @Mutusen / #5276051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4468576",
          "cefr_level": "A1",
          "word_slugs": [
            "balles-noun"
          ]
        },
        {
          "id": "8648201",
          "text": "Les chiens aiment récupérer des balles.",
          "translation": "Собаки любят приносить мячик.",
          "source": "Tatoeba #8648201 @lbdx / #5563924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8648201",
          "cefr_level": "A1",
          "word_slugs": [
            "balles-noun"
          ]
        }
      ],
