        },
        {
          "id": "1170592",
          "text": "La fortune s'est tournée contre lui.",
          "translation": "Фортуна от него отвернулась.",
          "source": "Tatoeba #1170592 @sacredceltic / #5872836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1170592",
          "cefr_level": "A1",
          "word_slugs": [
