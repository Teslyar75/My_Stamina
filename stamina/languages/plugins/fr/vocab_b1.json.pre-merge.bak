    {
      "slug": "charles-name",
      "lemma": "Charles",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1790,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1042481",
          "text": "Tu parles, Charles.",
          "translation": "Мели, Емеля, твоя неделя.",
          "source": "Tatoeba #1042481 @sacredceltic / #3052375 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1042481",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-name"
          ]
        },
        {
          "id": "8672871",
          "text": "Charles voyage seul.",
          "translation": "Шарль путешествует один.",
          "source": "Tatoeba #8672871 @felix63 / #8681290 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8672871",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-name"
          ]
        },
        {
          "id": "4022247",
          "text": "Où es-tu, Charles ?",
          "translation": "Ты где, Шарль?",
