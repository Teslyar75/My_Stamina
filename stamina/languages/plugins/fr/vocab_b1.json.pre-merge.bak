    {
      "slug": "fesses-noun",
      "lemma": "fesses",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1869,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "470370",
          "text": "J'ai mal aux fesses.",
          "translation": "У меня болит жопа.",
          "source": "Tatoeba #470370 @sacredceltic / #470970 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/470370",
          "cefr_level": "A1",
          "word_slugs": [
            "fesses-noun"
          ]
        },
        {
          "id": "8698823",
          "text": "Ça coûte la peau des fesses !",
          "translation": "Это стоит бешеных денег!",
          "source": "Tatoeba #8698823 @Julien_PDC / #10323932 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8698823",
          "cefr_level": "A1",
          "word_slugs": [
            "fesses-noun"
          ]
        },
        {
          "id": "12318340",
          "text": "Sami a embrassé les fesses de Layla.",
          "translation": "Сами чмокнул Лейлу в ягодицу.",
          "source": "Tatoeba #12318340 @carlosalberto / #7937314 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12318340",
          "cefr_level": "A1",
          "word_slugs": [
            "fesses-noun"
          ]
        },
        {
          "id": "8698824",
          "text": "Ça va me coûter la peau des fesses !",
          "translation": "Это будет стоить мне бешеных денег!",
          "source": "Tatoeba #8698824 @Julien_PDC / #10323933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8698824",
          "cefr_level": "A1",
          "word_slugs": [
            "fesses-noun"
          ]
        },
        {
          "id": "6933748",
          "text": "Tom glissa sur l'herbe humide et tomba sur ses fesses.",
          "translation": "Том поскользнулся на мокрой траве и упал на задницу.",
          "source": "Tatoeba #6933748 @Micsmithel / #6933854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6933748",
          "cefr_level": "A1",
          "word_slugs": [
            "fesses-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "f",
        "singular": "la fesses",
        "plural": "",
        "infinitive": ""
      }
