    {
      "slug": "lorsque-conj",
      "lemma": "lorsque",
      "pos": "conj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1289,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "когда"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5923083",
          "text": "J'aime lorsque vous chantez.",
          "translation": "Я люблю, когда вы поёте.",
          "source": "Tatoeba #5923083 @Aiji / #5962697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5923083",
          "cefr_level": "A1",
          "word_slugs": [
            "lorsque-conj"
          ]
        },
        {
          "id": "2061267",
          "text": "Lorsque je cours, je transpire.",
          "translation": "Когда я бегаю, я потею.",
          "source": "Tatoeba #2061267 @sacredceltic / #2746802 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2061267",
          "cefr_level": "A1",
          "word_slugs": [
            "lorsque-conj"
          ]
        },
        {
          "id": "1130315",
          "text": "Lorsque Marc arriva, je dormais.",
          "translation": "Когда приехал Марк, я спал.",
          "source": "Tatoeba #1130315 @sacredceltic / #6845588 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1130315",
          "cefr_level": "A1",
          "word_slugs": [
            "lorsque-conj"
          ]
        },
        {
          "id": "3516246",
          "text": "Attache-toi, lorsque tu conduis !",
          "translation": "Пристёгивайся, когда садишься за руль!",
          "source": "Tatoeba #3516246 @sacredceltic / #12854345 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3516246",
          "cefr_level": "A1",
          "word_slugs": [
            "lorsque-conj"
          ]
        },
        {
          "id": "10321149",
          "text": "Soyez attentif lorsque vous conduisez !",
          "translation": "Будьте внимательны, когда ведёте машину.",
          "source": "Tatoeba #10321149 @Julien_PDC / #12170400 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10321149",
          "cefr_level": "A1",
          "word_slugs": [
            "lorsque-conj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "lorsque",
        "plural": "",
        "infinitive": ""
      }
