      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10993463",
          "text": "Lis-moi ton discours.",
          "translation": "Прочти мне свою речь.",
          "source": "Tatoeba #10993463 @lbdx / #5479424 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10993463",
          "cefr_level": "A1",
          "word_slugs": [
            "discours-noun"
          ]
        },
        {
          "id": "1316316",
          "text": "Il prononça un discours.",
          "translation": "Он произнёс речь.",
          "source": "Tatoeba #1316316 @sacredceltic / #4419500 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1316316",
          "cefr_level": "A1",
          "word_slugs": [
            "discours-noun"
          ]
        },
        {
          "id": "14066079",
          "text": "Je poursuivis le discours.",
          "translation": "Я продолжил речь.",
          "source": "Tatoeba #14066079 @Rovo / #14066087 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14066079",
          "cefr_level": "A1",
          "word_slugs": [
            "discours-noun"
          ]
        },
        {
          "id": "14066081",
          "text": "Je continuai mon discours.",
          "translation": "Я продолжил свою речь.",
          "source": "Tatoeba #14066081 @Rovo / #14066089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14066081",
          "cefr_level": "A1",
          "word_slugs": [
