          ]
        },
        {
          "id": "5712614",
          "text": "Cependant il continuera d'écrire.",
          "translation": "Тем не менее он продолжит писать.",
          "source": "Tatoeba #5712614 @anino / #11135172 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5712614",
