      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12963270",
          "text": "Tu vas te blesser.",
          "translation": "Ты поранишься.",
          "source": "Tatoeba #12963270 @lbdx / #1236895 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12963270",
          "cefr_level": "A1",
          "word_slugs": [
            "blesser-verb"
          ]
        },
        {
          "id": "13241552",
          "text": "Les mots peuvent blesser.",
          "translation": "Слова могут ранить.",
          "source": "Tatoeba #13241552 @LdjuherTaqvaylit / #2898721 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13241552",
