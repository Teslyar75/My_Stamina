      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "бегство"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13496653",
          "text": "Et si ça fuite ?",
          "translation": "А если оно протечёт?",
          "source": "Tatoeba #13496653 @sacredceltic / #13496676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13496653",
          "cefr_level": "A1",
          "word_slugs": [
            "fuite-noun"
          ]
        },
        {
          "id": "4629664",
          "text": "Tom était en fuite.",
          "translation": "Том был в бегах.",
          "source": "Tatoeba #4629664 @Scorpionvenin14 / #5211425 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4629664",
          "cefr_level": "A1",
          "word_slugs": [
            "fuite-noun"
          ]
        },
        {
          "id": "12128308",
          "text": "Ils cherchent la fuite.",
          "translation": "Они ищут способ сбежать.",
          "source": "Tatoeba #12128308 @Tilelliatabas / #14100192 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12128308",
          "cefr_level": "A1",
          "word_slugs": [
            "fuite-noun"
          ]
        },
        {
          "id": "7699879",
          "text": "Il y a une fuite.",
          "translation": "Тут протечка.",
          "source": "Tatoeba #7699879 @sacredceltic / #12762307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7699879",
          "cefr_level": "A1",
          "word_slugs": [
            "fuite-noun"
          ]
        },
        {
          "id": "7220871",
          "text": "Tom a pris la fuite.",
          "translation": "Том сбежал.",
          "source": "Tatoeba #7220871 @Adelpa / #2501734 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7220871",
          "cefr_level": "A1",
          "word_slugs": [
            "fuite-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
