      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "559236",
          "text": "Tu dois remettre les rapports lundi.",
          "translation": "Ты должен сдать отчёты в понедельник.",
          "source": "Tatoeba #559236 @sacredceltic / #4398175 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/559236",
          "cefr_level": "A1",
          "word_slugs": [
            "rapports-noun"
          ]
        },
        {
          "id": "1426976",
          "text": "Nous devons présenter nos rapports lundi.",
          "translation": "Мы должны представить отчёты в понедельник.",
          "source": "Tatoeba #1426976 @sacredceltic / #3836281 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1426976",
          "cefr_level": "A1",
          "word_slugs": [
            "rapports-noun"
          ]
        },
        {
          "id": "13341955",
          "text": "Tu n'as pas lu les rapports ?",
          "translation": "Ты не читал отчёты?",
          "source": "Tatoeba #13341955 @genes1s / #13366801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13341955",
          "cefr_level": "A1",
          "word_slugs": [
            "rapports-noun"
          ]
        },
        {
          "id": "747370",
          "text": "Avez-vous eu des rapports non protégés ?",
          "translation": "У вас был незащищённый секс?",
          "source": "Tatoeba #747370 @Cocorico / #8183294 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/747370",
          "cefr_level": "A1",
          "word_slugs": [
            "rapports-noun"
          ]
        },
        {
          "id": "11594310",
          "text": "Tom et Mary ont de très bons rapports.",
          "translation": "У Тома с Мэри очень хорошие отношения.",
          "source": "Tatoeba #11594310 @Adrien_FR / #11595047 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11594310",
          "cefr_level": "A1",
          "word_slugs": [
            "rapports-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
