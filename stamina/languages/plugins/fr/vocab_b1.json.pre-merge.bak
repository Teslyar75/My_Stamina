          ]
        },
        {
          "id": "9437738",
          "text": "Il nous faudra tout.",
          "translation": "Нам понадобится всё.",
          "source": "Tatoeba #9437738 @sacredceltic / #4081618 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9437738",
