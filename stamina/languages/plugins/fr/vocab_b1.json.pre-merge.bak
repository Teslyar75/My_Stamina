          ]
        },
        {
          "id": "3693571",
          "text": "Il faudrait vous raser.",
          "translation": "Вам надо побриться.",
          "source": "Tatoeba #3693571 @Elliv / #3688340 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3693571",
          "cefr_level": "A1",
          "word_slugs": [
            "faudrait-verb"
          ]
        },
        {
          "id": "7998344",
          "text": "Il faudrait appeler Tom.",
          "translation": "Надо бы позвать Тома.",
          "source": "Tatoeba #7998344 @Micsmithel / #8041133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7998344",
          "cefr_level": "A1",
          "word_slugs": [
            "faudrait-verb"
          ]
        },
        {
          "id": "9163557",
          "text": "Il faudrait te dépêcher.",
          "translation": "Тебе надо бы поторопиться.",
          "source": "Tatoeba #9163557 @Julien_PDC / #9163565 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9163557",
          "cefr_level": "A1",
          "word_slugs": [
