    {
      "slug": "arrestation-noun",
      "lemma": "arrestation",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2467,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8949630",
          "text": "Son arrestation est justifiée.",
          "translation": "Его арест оправдан.",
          "source": "Tatoeba #8949630 @Julien_PDC / #8949858 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8949630",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestation-noun"
          ]
        },
        {
          "id": "1334642",
          "text": "M. Roberto ? Vous êtes en état d'arrestation.",
          "translation": "Господин Роберто? Вы арестованы.",
          "source": "Tatoeba #1334642 @Scott / #6457854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1334642",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestation-noun"
          ]
        },
        {
          "id": "12850942",
          "text": "Son arrestation a été prolongée d'une semaine.",
          "translation": "Его арест был продлён на неделю.",
          "source": "Tatoeba #12850942 @Hakim / #12870042 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12850942",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestation-noun"
          ]
        },
        {
          "id": "12645806",
          "text": "Les personnes en état d'arrestation attendaient d'être interrogées.",
          "translation": "Задержанные ожидали, когда их допросят.",
          "source": "Tatoeba #12645806 @lbdx / #4180891 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12645806",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestation-noun"
          ]
        },
        {
          "id": "13378322",
          "text": "Vous êtes en état d'arrestation pour vol à main armée.",
          "translation": "Вы находитесь под арестом за вооружённое ограбление.",
          "source": "Tatoeba #13378322 @lbdx / #13378379 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13378322",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestation-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "f",
        "singular": "la arrestation",
        "plural": "",
        "infinitive": ""
      }
    },
