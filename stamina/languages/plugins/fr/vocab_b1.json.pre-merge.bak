    {
      "slug": "recherches-noun",
      "lemma": "recherches",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1639,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1998971",
          "text": "Je sais qui tu recherches.",
          "translation": "Я знаю, кого ты ищешь.",
          "source": "Tatoeba #1998971 @sacredceltic / #8548606 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1998971",
          "cefr_level": "A1",
          "word_slugs": [
            "recherches-noun"
          ]
        },
        {
          "id": "10868590",
          "text": "Je dois faire des recherches.",
          "translation": "Мне надо провести кое-какие исследования.",
          "source": "Tatoeba #10868590 @Aiji / #11174446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10868590",
          "cefr_level": "A1",
          "word_slugs": [
            "recherches-noun"
          ]
        },
        {
          "id": "8673829",
          "text": "Je vais continuer mes recherches.",
          "translation": "Я буду продолжать свои исследования.",
          "source": "Tatoeba #8673829 @Julien_PDC / #10179987 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8673829",
          "cefr_level": "A1",
          "word_slugs": [
            "recherches-noun"
          ]
        },
        {
          "id": "5691779",
          "text": "Tom est occupé par ses recherches.",
          "translation": "Том занят своими исследованиями.",
          "source": "Tatoeba #5691779 @nimfeo / #5691793 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5691779",
          "cefr_level": "A1",
          "word_slugs": [
            "recherches-noun"
          ]
        },
        {
          "id": "2436019",
          "text": "Quel genre de travail recherches-tu ?",
          "translation": "Какого рода работу ты ищешь?",
          "source": "Tatoeba #2436019 @Rovo / #11011406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2436019",
          "cefr_level": "A1",
          "word_slugs": [
            "recherches-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
