      "examples": [
        {
          "id": "8619965",
          "text": "Il faudra du temps.",
          "translation": "Понадобится время.",
          "source": "Tatoeba #8619965 @Micsmithel / #8620198 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8619965",
          "cefr_level": "A1",
