    {
      "slug": "note-noun",
      "lemma": "Note",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1931,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "отметка",
          "записка",
          "счёт"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1131270",
          "text": "Note son adresse.",
          "translation": "Запиши его адрес.",
          "source": "Tatoeba #1131270 @sysko / #467020 @Aqn (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1131270",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        },
        {
          "id": "8585927",
          "text": "J’en prends note.",
          "translation": "Я это учитываю.",
          "source": "Tatoeba #8585927 @felix63 / #8602562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8585927",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        },
        {
          "id": "12681473",
          "text": "Tom relut la note.",
          "translation": "Том перечитал записку.",
          "source": "Tatoeba #12681473 @Olcyx / #8068508 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12681473",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        },
        {
          "id": "11224541",
          "text": "Qui paiera la note ?",
          "translation": "Кто будет оплачивать счёт?",
          "source": "Tatoeba #11224541 @lbdx / #3777339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11224541",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        },
        {
          "id": "2392452",
          "text": "J'ai reçu ta note.",
          "translation": "Я получил твою записку.",
          "source": "Tatoeba #2392452 @sacredceltic / #3464557 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2392452",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        }
