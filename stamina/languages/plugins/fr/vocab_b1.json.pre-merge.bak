    {
      "slug": "pourrez-verb",
      "lemma": "pourrez",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1924,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5824850",
          "text": "Vous pourrez venir ?",
          "translation": "Вы сможете прийти?",
          "source": "Tatoeba #5824850 @EvaFranska / #8694413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5824850",
          "cefr_level": "A1",
          "word_slugs": [
            "pourrez-verb"
          ]
        },
        {
          "id": "12146314",
          "text": "Vous pourrez le faire.",
          "translation": "Вы сможете это сделать.",
          "source": "Tatoeba #12146314 @LdjuherTaqvaylit / #12146888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12146314",
          "cefr_level": "A1",
          "word_slugs": [
            "pourrez-verb"
          ]
        },
        {
          "id": "10603830",
          "text": "Que pourrez-vous faire ?",
          "translation": "Что вы сможете сделать?",
          "source": "Tatoeba #10603830 @AutoBot / #10603945 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10603830",
          "cefr_level": "A1",
          "word_slugs": [
            "pourrez-verb"
          ]
        },
        {
          "id": "13079005",
          "text": "Quand pourrez-vous faire ça ?",
          "translation": "Когда вы сможете это сделать?",
          "source": "Tatoeba #13079005 @Rovo / #6406333 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13079005",
          "cefr_level": "A1",
          "word_slugs": [
            "pourrez-verb"
          ]
        },
        {
          "id": "8419312",
          "text": "Vous ne pourrez pas le prouver.",
          "translation": "Вы не сможете это доказать.",
          "source": "Tatoeba #8419312 @Aiji / #5021406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8419312",
          "cefr_level": "A1",
          "word_slugs": [
            "pourrez-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
