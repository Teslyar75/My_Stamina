        },
        {
          "id": "11584033",
          "text": "Je suis heureuse cependant.",
          "translation": "И всё-таки я счастлива.",
          "source": "Tatoeba #11584033 @Rovo / #12374855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11584033",
