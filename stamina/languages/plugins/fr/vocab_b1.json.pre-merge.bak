    {
      "slug": "esprits-noun",
      "lemma": "esprits",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2487,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "890082",
          "text": "Crois-tu aux esprits ?",
          "translation": "Ты веришь в духов?",
          "source": "Tatoeba #890082 @sacredceltic / #1460640 @vladb314 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/890082",
          "cefr_level": "A1",
          "word_slugs": [
            "esprits-noun"
          ]
        },
        {
          "id": "4049033",
          "text": "Croyez-vous aux esprits ?",
          "translation": "Вы верите в духов?",
          "source": "Tatoeba #4049033 @GB3 / #5203167 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4049033",
          "cefr_level": "A1",
          "word_slugs": [
            "esprits-noun"
          ]
        },
        {
          "id": "13558746",
          "text": "Il a repris ses esprits.",
          "translation": "Он пришёл в себя.",
          "source": "Tatoeba #13558746 @Aghanim / #3337313 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13558746",
          "cefr_level": "A1",
          "word_slugs": [
            "esprits-noun"
          ]
        },
        {
          "id": "9463885",
          "text": "Tom a repris ses esprits.",
          "translation": "Том пришёл в сознание.",
          "source": "Tatoeba #9463885 @Micsmithel / #7933643 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9463885",
          "cefr_level": "A1",
          "word_slugs": [
            "esprits-noun"
          ]
        },
        {
          "id": "13558756",
