    {
      "slug": "lancer-verb",
      "lemma": "lancer",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1982,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "бросать",
          "бросить"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9707451",
          "text": "Je songe à me lancer en politique.",
          "translation": "Я подумываю о том, чтобы пойти в политику.",
          "source": "Tatoeba #9707451 @lbdx / #10962609 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9707451",
          "cefr_level": "A1",
          "word_slugs": [
            "lancer-verb"
          ]
        },
        {
          "id": "4213468",
          "text": "Il va lancer sur toi une malédiction.",
          "translation": "Он на тебя проклятие наложит.",
          "source": "Tatoeba #4213468 @Amastan / #4213476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4213468",
          "cefr_level": "A1",
          "word_slugs": [
            "lancer-verb"
          ]
        },
        {
          "id": "4213481",
          "text": "Tom va lancer sur toi une malédiction.",
          "translation": "Том наложит на тебя проклятие.",
          "source": "Tatoeba #4213481 @Amastan / #5397869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4213481",
          "cefr_level": "A1",
