    {
      "slug": "créer-verb",
      "lemma": "créer",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1835,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12730871",
          "text": "Cessez de créer des problèmes.",
          "translation": "Перестаньте создавать проблемы.",
          "source": "Tatoeba #12730871 @sad15 / #12731372 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12730871",
          "cefr_level": "A1",
          "word_slugs": [
            "créer-verb"
          ]
        },
        {
          "id": "3272467",
          "text": "Ça a permis de créer 4,000 emplois.",
          "translation": "Это позволило создать четыре тысячи рабочих мест.",
          "source": "Tatoeba #3272467 @Micsmithel / #4504133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3272467",
          "cefr_level": "A1",
          "word_slugs": [
            "créer-verb"
          ]
        },
        {
          "id": "12730872",
          "text": "L'entreprise va créer de nouveaux emplois.",
          "translation": "Предприятие создаст новые рабочие места.",
          "source": "Tatoeba #12730872 @sad15 / #12731373 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12730872",
          "cefr_level": "A1",
          "word_slugs": [
            "créer-verb"
          ]
        },
        {
          "id": "959825",
          "text": "C'était une bonne idée de créer Tatoeba.",
          "translation": "Хорошая была идея - создать Татоэбу.",
          "source": "Tatoeba #959825 @alexmarcelo / #12006534 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/959825",
          "cefr_level": "A1",
          "word_slugs": [
            "créer-verb"
          ]
        },
        {
          "id": "9745361",
          "text": "Il cherche à créer la discorde entre nous.",
          "translation": "Он пытается посеять разногласия между нами.",
          "source": "Tatoeba #9745361 @Aiji / #10118413 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9745361",
          "cefr_level": "A1",
          "word_slugs": [
            "créer-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
