    {
      "slug": "forcément-adv",
      "lemma": "forcément",
      "pos": "adv",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2418,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8851771",
          "text": "Non, pas forcément.",
          "translation": "Нет, необязательно.",
          "source": "Tatoeba #8851771 @Julien_PDC / #8852919 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8851771",
          "cefr_level": "A1",
          "word_slugs": [
            "forcément-adv"
          ]
        },
        {
          "id": "338149",
          "text": "Ce travail n'est pas forcément facile.",
          "translation": "Эта работа необязательно простая.",
          "source": "Tatoeba #338149 @shiboy / #12902350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/338149",
          "cefr_level": "A1",
          "word_slugs": [
            "forcément-adv"
          ]
        },
        {
          "id": "10545169",
          "text": "Ils sont neuf, mais pas forcément tous neufs.",
          "translation": "Их девять, но они необязательно все новые.",
          "source": "Tatoeba #10545169 @sacredceltic / #10545182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10545169",
          "cefr_level": "A1",
          "word_slugs": [
            "forcément-adv"
          ]
        },
        {
          "id": "9547479",
          "text": "Ce n'est pas forcément l'un d'eux.",
          "translation": "Это необязательно кто-то из них.",
          "source": "Tatoeba #9547479 @Aiji / #10742549 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9547479",
          "cefr_level": "A1",
          "word_slugs": [
            "forcément-adv"
          ]
        },
        {
          "id": "10739184",
          "text": "Ce qu'il dit n'est pas forcément vrai.",
          "translation": "То, что он говорит, необязательно правда.",
          "source": "Tatoeba #10739184 @lbdx / #10974405 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10739184",
          "cefr_level": "A1",
          "word_slugs": [
            "forcément-adv"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
