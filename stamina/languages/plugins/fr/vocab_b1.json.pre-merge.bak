    {
      "slug": "demandais-verb",
      "lemma": "demandais",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1694,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2371261",
          "text": "Je demandais l'heure.",
          "translation": "Я спрашивал, который час.",
          "source": "Tatoeba #2371261 @Amastan / #6485989 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2371261",
          "cefr_level": "A1",
          "word_slugs": [
            "demandais-verb"
          ]
        },
        {
          "id": "2371265",
          "text": "Tu demandais l'heure.",
          "translation": "Ты спрашивал, который час.",
          "source": "Tatoeba #2371265 @Amastan / #6485985 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2371265",
          "cefr_level": "A1",
          "word_slugs": [
            "demandais-verb"
          ]
        },
        {
          "id": "7701688",
          "text": "Je ne te le demandais pas.",
          "translation": "Я тебя об этом не спрашивал.",
          "source": "Tatoeba #7701688 @Maxence / #2739521 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7701688",
          "cefr_level": "A1",
          "word_slugs": [
            "demandais-verb"
          ]
        },
        {
          "id": "5912819",
          "text": "Je me demandais la même chose.",
          "translation": "Я задавалась тем же вопросом.",
          "source": "Tatoeba #5912819 @Aiji / #8726117 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5912819",
          "cefr_level": "A1",
          "word_slugs": [
            "demandais-verb"
          ]
        },
        {
          "id": "12993902",
          "text": "Je leur demandais de décrire cela.",
          "translation": "Я просил их это описать.",
          "source": "Tatoeba #12993902 @Rovo / #13571057 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12993902",
          "cefr_level": "A1",
          "word_slugs": [
            "demandais-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
