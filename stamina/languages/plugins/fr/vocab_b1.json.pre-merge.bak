          ]
        },
        {
          "id": "10738077",
          "text": "L'essence est trop chère.",
          "translation": "Бензин слишком дорогой.",
          "source": "Tatoeba #10738077 @lbdx / #11499758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10738077",
          "cefr_level": "A1",
          "word_slugs": [
            "essence-noun"
          ]
        },
        {
          "id": "1527488",
          "text": "L'essence va nous manquer.",
          "translation": "У нас кончается бензин.",
          "source": "Tatoeba #1527488 @sacredceltic / #1527487 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1527488",
          "cefr_level": "A1",
