          "word_slugs": [
            "pourrions-verb"
          ]
        },
        {
          "id": "5743032",
          "text": "Nous pourrions les aider.",
          "translation": "Мы могли бы им помочь.",
          "source": "Tatoeba #5743032 @Petrus / #11668373 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5743032",
