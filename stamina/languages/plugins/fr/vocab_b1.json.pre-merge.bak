      "examples": [
        {
          "id": "11464734",
          "text": "Pouvez-vous l'imaginer ?",
          "translation": "Вы можете себе это представить?",
          "source": "Tatoeba #11464734 @carlosalberto / #10204624 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11464734",
          "cefr_level": "A1",
          "word_slugs": [
            "imaginer-verb"
          ]
        },
        {
          "id": "1157012",
          "text": "Je ne peux l'imaginer.",
          "translation": "Я не могу этого представить.",
          "source": "Tatoeba #1157012 @sacredceltic / #14085939 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1157012",
          "cefr_level": "A1",
