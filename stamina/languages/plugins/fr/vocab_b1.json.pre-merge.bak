    {
      "slug": "traiter-verb",
      "lemma": "traiter",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2379,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1263859",
          "text": "Je vais traiter ce problème.",
          "translation": "Я займусь этой проблемой.",
          "source": "Tatoeba #1263859 @rene1596 / #679058 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1263859",
          "cefr_level": "A1",
          "word_slugs": [
            "traiter-verb"
          ]
        },
        {
          "id": "8315055",
          "text": "Je sais comment traiter une dame.",
          "translation": "Я умею обращаться с дамой.",
          "source": "Tatoeba #8315055 @Aiji / #3040216 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8315055",
          "cefr_level": "A1",
          "word_slugs": [
            "traiter-verb"
          ]
        },
        {
          "id": "12159916",
          "text": "Comment oses-tu me traiter d’imbécile !",
          "translation": "Как ты смеешь называть меня дураком!",
          "source": "Tatoeba #12159916 @Taibouche / #5802331 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12159916",
          "cefr_level": "A1",
          "word_slugs": [
            "traiter-verb"
          ]
        },
        {
          "id": "11483832",
          "text": "Comment oses-tu me traiter d'hypocrite ?",
          "translation": "Как ты смеешь называть меня лицемером?",
          "source": "Tatoeba #11483832 @lbdx / #11485043 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11483832",
          "cefr_level": "A1",
          "word_slugs": [
            "traiter-verb"
          ]
        },
        {
          "id": "13871822",
          "text": "Comment osez-vous me traiter de criminel ?",
          "translation": "Как вы смеете называть меня уголовником?",
          "source": "Tatoeba #13871822 @tieguy / #5555027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13871822",
          "cefr_level": "A1",
          "word_slugs": [
            "traiter-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
