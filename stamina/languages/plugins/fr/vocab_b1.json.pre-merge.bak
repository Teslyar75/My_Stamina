          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        },
        {
          "id": "393548",
          "text": "Susan aime écouter de la musique.",
          "translation": "Сьюзан любит слушать музыку.",
          "source": "Tatoeba #393548 @Scott / #4480162 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/393548",
          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        },
        {
          "id": "331965",
          "text": "Susan est en fait ta demi-sœur.",
          "translation": "Сьюзан на самом деле твоя сводная сестра.",
          "source": "Tatoeba #331965 @TRANG / #8599604 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/331965",
          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        }
      ],
