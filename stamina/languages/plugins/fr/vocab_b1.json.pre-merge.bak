          ]
        },
        {
          "id": "8643849",
          "text": "Pierre est paresseux.",
          "translation": "Пьер ленив.",
          "source": "Tatoeba #8643849 @Julien_PDC / #8643870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8643849",
          "cefr_level": "A1",
