    {
      "slug": "risques-noun",
      "lemma": "risques",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2036,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7244864",
          "text": "Tu ne risques rien.",
          "translation": "Ты ничем не рискуешь.",
          "source": "Tatoeba #7244864 @Micsmithel / #6943847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7244864",
          "cefr_level": "A1",
          "word_slugs": [
            "risques-noun"
          ]
        },
        {
          "id": "6204307",
          "text": "Tu risques de baver.",
          "translation": "Ты можешь ошалеть.",
          "source": "Tatoeba #6204307 @LINGUISTE / #10812801 @Snark (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6204307",
          "cefr_level": "A1",
          "word_slugs": [
            "risques-noun"
          ]
        },
        {
          "id": "10664216",
          "text": "Ça réduit les risques.",
          "translation": "Это сокращает риски.",
          "source": "Tatoeba #10664216 @samir_t / #10885900 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10664216",
          "cefr_level": "A1",
          "word_slugs": [
            "risques-noun"
          ]
        },
        {
          "id": "1662450",
          "text": "Il comprend les risques.",
          "translation": "Он понимает риски.",
