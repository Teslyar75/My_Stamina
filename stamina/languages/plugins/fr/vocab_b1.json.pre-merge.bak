    {
      "slug": "park-noun",
      "lemma": "park",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2357,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5644085",
          "text": "Je suis presque sûre que Tom habite à Park Street.",
          "translation": "Я почти уверена, что Том живёт на Парк-стрит.",
          "source": "Tatoeba #5644085 @narnar / #5650058 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5644085",
          "cefr_level": "A1",
          "word_slugs": [
            "park-noun"
          ]
        },
        {
          "id": "5644083",
          "text": "Je suis presque sûre que Tom habite sur Park Street.",
          "translation": "Я почти уверена, что Том живёт на Парк-стрит.",
          "source": "Tatoeba #5644083 @narnar / #5650058 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5644083",
          "cefr_level": "A1",
          "word_slugs": [
            "park-noun"
          ]
        },
        {
          "id": "11652385",
          "text": "Tom et moi voulons acheter une maison sur Park Street.",
          "translation": "Мы с Томом хотим купить дом на Парк-стрит.",
          "source": "Tatoeba #11652385 @LdjuherTaqvaylit / #11739770 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11652385",
          "cefr_level": "A1",
          "word_slugs": [
            "park-noun"
          ]
        },
        {
          "id": "1794085",
          "text": "Il vit dans un appartement de luxe près de Central Park.",
          "translation": "Он живёт в роскошной квартире рядом с Центральным парком.",
          "source": "Tatoeba #1794085 @sacredceltic / #13936408 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1794085",
          "cefr_level": "A1",
          "word_slugs": [
            "park-noun"
          ]
        },
        {
          "id": "120086",
          "text": "Pouvez-vous me dire comment je peux me rendre à Hyde Park ?",
          "translation": "Вы не подскажете, как мне дойти до Гайд-парка?",
          "source": "Tatoeba #120086 @9h0ost / #11508626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/120086",
          "cefr_level": "A1",
          "word_slugs": [
            "park-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le park",
        "plural": "",
        "infinitive": ""
      }
