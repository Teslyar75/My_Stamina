    {
      "slug": "robert-name",
      "lemma": "Robert",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1642,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11596268",
          "text": "Robert était au téléphone.",
          "translation": "Роберт говорил по телефону.",
          "source": "Tatoeba #11596268 @Adrien_FR / #11598141 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11596268",
          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        },
        {
          "id": "333052",
          "text": "Nous surnommions Robert \"Bob\".",
          "translation": "Мы называли Роберта Бобом.",
          "source": "Tatoeba #333052 @sysko / #10209598 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/333052",
          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        },
        {
          "id": "825373",
          "text": "Je suis un ami de Robert.",
          "translation": "Я друг Роберта.",
