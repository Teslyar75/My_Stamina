      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3673246",
          "text": "Le gouverneur était furieux.",
          "translation": "Губернатор был в ярости.",
          "source": "Tatoeba #3673246 @dafp / #4413758 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3673246",
          "cefr_level": "A1",
          "word_slugs": [
            "gouverneur-noun"
          ]
        },
        {
          "id": "1067046",
          "text": "Le gouverneur du Texas était furieux.",
          "translation": "Губернатор Техаса был в бешенстве.",
          "source": "Tatoeba #1067046 @elgranjuego / #13193413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1067046",
          "cefr_level": "A1",
          "word_slugs": [
            "gouverneur-noun"
          ]
        },
        {
          "id": "1238034",
          "text": "Rockefeller a été gouverneur de New York.",
          "translation": "Рокфеллер был губернатором Нью-Йорка.",
