    {
      "slug": "siècle-noun",
      "lemma": "siècle",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2429,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7273991",
          "text": "Je veux vivre un siècle.",
          "translation": "Я хочу прожить век.",
          "source": "Tatoeba #7273991 @Talwit / #7274029 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7273991",
          "cefr_level": "A1",
          "word_slugs": [
            "siècle-noun"
          ]
        },
        {
          "id": "10022",
          "text": "Un siècle fait cent années.",
          "translation": "Век — это сто лет.",
          "source": "Tatoeba #10022 @sysko / #1039892 @Vixen96 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10022",
          "cefr_level": "A1",
          "word_slugs": [
            "siècle-noun"
          ]
        },
        {
          "id": "11782308",
          "text": "Nous sommes au XXIᵉ siècle.",
          "translation": "Мы в XXI веке.",
          "source": "Tatoeba #11782308 @Fenrir / #12296385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11782308",
          "cefr_level": "A1",
          "word_slugs": [
            "siècle-noun"
          ]
        },
        {
          "id": "13903741",
          "text": "Il mourut au XVIIIᵉ siècle.",
          "translation": "Он умер в восемнадцатом веке.",
          "source": "Tatoeba #13903741 @menaud / #13903773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13903741",
          "cefr_level": "A1",
          "word_slugs": [
            "siècle-noun"
          ]
        },
        {
          "id": "8698766",
          "text": "En quel siècle vivons-nous ?",
          "translation": "В каком веке мы живём?",
          "source": "Tatoeba #8698766 @Julien_PDC / #10323219 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8698766",
          "cefr_level": "A1",
          "word_slugs": [
            "siècle-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le siècle",
        "plural": "",
        "infinitive": ""
      }
