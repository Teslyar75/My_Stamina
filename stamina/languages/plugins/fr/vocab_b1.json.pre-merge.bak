          "id": "13290757",
          "text": "Sois sur tes gardes.",
          "translation": "Будь начеку.",
          "source": "Tatoeba #13290757 @LdjuherTaqvaylit / #2501571 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13290757",
          "cefr_level": "A1",
          "word_slugs": [
            "gardes-noun"
          ]
        },
        {
          "id": "1224805",
          "text": "Sois sur tes gardes !",
          "translation": "Будь начеку!",
          "source": "Tatoeba #1224805 @sacredceltic / #6572151 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1224805",
          "cefr_level": "A1",
          "word_slugs": [
            "gardes-noun"
          ]
        },
