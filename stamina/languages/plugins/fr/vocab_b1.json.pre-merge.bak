            "chicago-name"
          ]
        },
        {
          "id": "454424",
          "text": "Il pleuvait aux alentours de Chicago.",
          "translation": "В окрестностях Чикаго шёл дождь.",
          "source": "Tatoeba #454424 @mamat / #7108780 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454424",
          "cefr_level": "A1",
          "word_slugs": [
            "chicago-name"
          ]
        },
        {
          "id": "815620",
          "text": "Tom vit à Chicago depuis un an.",
          "translation": "Том живет в Чикаго уже год.",
          "source": "Tatoeba #815620 @GeeZ / #1824195 @Jefim (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/815620",
          "cefr_level": "A1",
          "word_slugs": [
            "chicago-name"
          ]
        }
