    {
      "slug": "envers-prep",
      "lemma": "envers",
      "pos": "prep",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1378,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13388641",
          "text": "Soyons indulgents envers lui.",
          "translation": "Будем к нему снисходительны.",
          "source": "Tatoeba #13388641 @lbdx / #13389255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13388641",
          "cefr_level": "A1",
          "word_slugs": [
            "envers-prep"
          ]
        },
        {
          "id": "508040",
          "text": "Tout est à l'envers.",
          "translation": "Всё наоборот.",
          "source": "Tatoeba #508040 @Bruno / #5569517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/508040",
          "cefr_level": "A1",
          "word_slugs": [
            "envers-prep"
          ]
        },
        {
          "id": "4303033",
          "text": "Tu es injuste envers elle.",
          "translation": "Ты к ней несправедлив.",
          "source": "Tatoeba #4303033 @Blabla / #4303038 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4303033",
          "cefr_level": "A1",
          "word_slugs": [
            "envers-prep"
          ]
        },
        {
          "id": "10838917",
          "text": "Tom est amical envers moi.",
          "translation": "Том со мной дружелюбен.",
          "source": "Tatoeba #10838917 @Rovo / #14060978 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10838917",
          "cefr_level": "A1",
          "word_slugs": [
            "envers-prep"
          ]
        },
        {
          "id": "12458425",
          "text": "Je fus injuste envers toi.",
