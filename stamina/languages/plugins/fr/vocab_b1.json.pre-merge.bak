    {
      "slug": "adorable-adj",
      "lemma": "adorable",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2169,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8648137",
          "text": "Cette fille est adorable.",
          "translation": "Эта девушка очаровательна.",
          "source": "Tatoeba #8648137 @Rafik / #10817193 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8648137",
          "cefr_level": "A1",
          "word_slugs": [
            "adorable-adj"
          ]
        },
        {
          "id": "859127",
          "text": "Mon frère me donna une adorable poupée.",
          "translation": "Брат подарил мне чудесную куклу.",
          "source": "Tatoeba #859127 @sacredceltic / #3543507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/859127",
          "cefr_level": "A1",
          "word_slugs": [
            "adorable-adj"
          ]
        },
        {
          "id": "133737",
          "text": "C'était un soulagement de voir son adorable sourire.",
          "translation": "Видеть её прелестную улыбку было облегчением.",
          "source": "Tatoeba #133737 @Micsmithel / #12430269 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/133737",
          "cefr_level": "A1",
          "word_slugs": [
            "adorable-adj"
          ]
        },
        {
          "id": "373926",
          "text": "Elle a accouché d’une adorable petite fille la semaine dernière.",
          "translation": "Она родила хорошенькую девочку на прошлой неделе.",
          "source": "Tatoeba #373926 @zmoo / #351611 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/373926",
          "cefr_level": "A1",
          "word_slugs": [
            "adorable-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le adorable",
        "plural": "",
        "infinitive": ""
      }
