    {
      "slug": "jeff-name",
      "lemma": "Jeff",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2288,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "441535",
          "text": "Tout le monde l'appelle Jeff.",
          "translation": "Все зовут его Джефф.",
          "source": "Tatoeba #441535 @Archibald / #1796509 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/441535",
          "cefr_level": "A1",
          "word_slugs": [
            "jeff-name"
          ]
        },
        {
          "id": "1515861",
          "text": "Jeff semble savoir qui elle est.",
          "translation": "Джефф, похоже, знает, кто она.",
