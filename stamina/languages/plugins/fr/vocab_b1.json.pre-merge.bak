            "faudra-verb"
          ]
        },
        {
          "id": "1064738",
          "text": "Il me faudra les aider.",
          "translation": "Мне придётся им помочь.",
          "source": "Tatoeba #1064738 @sacredceltic / #2061151 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1064738",
          "cefr_level": "A1",
          "word_slugs": [
            "faudra-verb"
          ]
        },
        {
          "id": "11841726",
          "text": "Il lui faudra du temps.",
          "translation": "Ему потребуется время.",
          "source": "Tatoeba #11841726 @LdjuherTaqvaylit / #11845194 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11841726",
