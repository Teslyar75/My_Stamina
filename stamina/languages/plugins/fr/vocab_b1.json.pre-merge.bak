    {
      "slug": "meurtres-noun",
      "lemma": "meurtres",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2212,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13877385",
          "text": "Il a commis cinq meurtres.",
          "translation": "Он совершил пять убийств.",
          "source": "Tatoeba #13877385 @zogwarg / #4433525 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13877385",
          "cefr_level": "A1",
          "word_slugs": [
            "meurtres-noun"
          ]
        },
        {
          "id": "10468247",
          "text": "Le nombre de meurtres a augmenté.",
          "translation": "Количество убийств возросло.",
          "source": "Tatoeba #10468247 @lbdx / #11245574 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10468247",
          "cefr_level": "A1",
          "word_slugs": [
            "meurtres-noun"
          ]
        },
        {
          "id": "8307962",
          "text": "Ça me donne des envies de meurtres.",
          "translation": "От этого мне хочется убивать.",
          "source": "Tatoeba #8307962 @Aiji / #13992736 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8307962",
          "cefr_level": "A1",
          "word_slugs": [
            "meurtres-noun"
          ]
        },
        {
          "id": "1258917",
          "text": "Ce mois-ci, il y a eu deux meurtres.",
          "translation": "В этом месяце произошло два убийства.",
          "source": "Tatoeba #1258917 @rene1596 / #791369 @tony (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1258917",
          "cefr_level": "A1",
          "word_slugs": [
            "meurtres-noun"
          ]
        },
        {
          "id": "12426479",
          "text": "Il doit y avoir un lien entre ces meurtres.",
          "translation": "Между этими убийствами должна быть связь.",
          "source": "Tatoeba #12426479 @lbdx / #4597269 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12426479",
          "cefr_level": "A1",
          "word_slugs": [
            "meurtres-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
