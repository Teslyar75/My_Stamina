      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1470,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10615827",
          "text": "Étant enfant, Tom zézayait.",
          "translation": "В детстве Том шепелявил.",
          "source": "Tatoeba #10615827 @felix63 / #13564805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10615827",
          "cefr_level": "A1",
          "word_slugs": [
            "étant-noun"
          ]
        },
        {
          "id": "13683499",
          "text": "Il somnole tout en étant debout.",
          "translation": "Он дремлет стоя.",
          "source": "Tatoeba #13683499 @slahatuvelli / #13683513 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13683499",
          "cefr_level": "A1",
          "word_slugs": [
            "étant-noun"
          ]
        },
        {
          "id": "7839602",
          "text": "Personne ne danse en étant sobre.",
          "translation": "Никто не танцует трезвым.",
          "source": "Tatoeba #7839602 @sacredceltic / #5492745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7839602",
          "cefr_level": "A1",
          "word_slugs": [
            "étant-noun"
          ]
        },
        {
          "id": "12370123",
          "text": "Elle a grandi en étant orpheline.",
          "translation": "Она выросла сиротой.",
          "source": "Tatoeba #12370123 @Rafik / #12370129 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12370123",
          "cefr_level": "A1",
          "word_slugs": [
            "étant-noun"
          ]
        },
        {
          "id": "1242837",
          "text": "Elle marchait en étant très attentive.",
          "translation": "Она шла очень осторожно.",
          "source": "Tatoeba #1242837 @rene1596 / #445422 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1242837",
          "cefr_level": "A1",
          "word_slugs": [
            "étant-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
