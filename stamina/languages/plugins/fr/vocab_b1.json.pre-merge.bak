    {
      "slug": "afin-conj",
      "lemma": "afin",
      "pos": "conj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1580,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2965267",
          "text": "Je dis cela afin que tu comprennes.",
          "translation": "Я говорю это, чтобы ты понял.",
          "source": "Tatoeba #2965267 @Wakano / #830544 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2965267",
          "cefr_level": "A1",
          "word_slugs": [
            "afin-conj"
          ]
        },
        {
          "id": "3432461",
          "text": "Je le dis afin que vous compreniez.",
          "translation": "Я говорю это, чтобы вы поняли.",
          "source": "Tatoeba #3432461 @sacredceltic / #4566530 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3432461",
          "cefr_level": "A1",
          "word_slugs": [
            "afin-conj"
          ]
        },
        {
          "id": "4477742",
          "text": "Il économise afin d'acheter une maison.",
          "translation": "Он откладывает деньги на покупку дома.",
          "source": "Tatoeba #4477742 @mouche / #8245630 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4477742",
          "cefr_level": "A1",
          "word_slugs": [
            "afin-conj"
          ]
        },
        {
          "id": "1276205",
          "text": "Je courus, afin d'être à l'heure.",
          "translation": "Я побежал, чтобы успеть вовремя.",
          "source": "Tatoeba #1276205 @sacredceltic / #9352716 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1276205",
          "cefr_level": "A1",
          "word_slugs": [
            "afin-conj"
          ]
        },
        {
          "id": "1276206",
          "text": "Afin d'être à l'heure, je courus.",
          "translation": "Я побежал, чтобы успеть вовремя.",
