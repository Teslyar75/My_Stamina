    {
      "slug": "harry-name",
      "lemma": "Harry",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1382,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "627721",
          "text": "Harry n'a que 40 ans.",
          "translation": "Гарри всего сорок.",
          "source": "Tatoeba #627721 @sysko / #2615123 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/627721",
          "cefr_level": "A1",
          "word_slugs": [
            "harry-name"
          ]
        },
        {
          "id": "626936",
          "text": "Harry est tombé gravement malade.",
          "translation": "Гарри тяжело заболел.",
          "source": "Tatoeba #626936 @U2FS / #2940442 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/626936",
          "cefr_level": "A1",
          "word_slugs": [
            "harry-name"
          ]
        },
        {
          "id": "639771",
          "text": "Il a réussi à réveiller Harry.",
          "translation": "Ему удалось разбудить Гарри.",
          "source": "Tatoeba #639771 @qdii / #1239575 @Squaw (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/639771",
          "cefr_level": "A1",
          "word_slugs": [
            "harry-name"
          ]
        },
        {
          "id": "13117",
          "text": "Harry réussit à traverser la rivière à la nage.",
          "translation": "Гарри удалось переплыть реку.",
          "source": "Tatoeba #13117 @Micsmithel / #6572144 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13117",
