          "cefr_level": "A1",
          "word_slugs": [
            "facilement-adv"
          ]
        },
        {
          "id": "1049648",
          "text": "Il se vexe facilement.",
          "translation": "Он легко расстраивается.",
          "source": "Tatoeba #1049648 @jeo / #12036606 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1049648",
          "cefr_level": "A1",
          "word_slugs": [
            "facilement-adv"
          ]
        },
        {
          "id": "7465592",
          "text": "On se perd facilement.",
          "translation": "Потеряться легко.",
          "source": "Tatoeba #7465592 @tras / #7453749 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7465592",
          "cefr_level": "A1",
          "word_slugs": [
            "facilement-adv"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
