    {
      "slug": "fortune-noun",
      "lemma": "fortune",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2216,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "916679",
          "text": "Ça vaut une fortune.",
          "translation": "Это стоит целое состояние.",
          "source": "Tatoeba #916679 @Scott / #1542676 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/916679",
          "cefr_level": "A1",
          "word_slugs": [
            "fortune-noun"
          ]
        },
        {
          "id": "11688609",
          "text": "Ça coûte une fortune.",
          "translation": "Это стоит целое состояние.",
          "source": "Tatoeba #11688609 @Adrien_FR / #1542676 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11688609",
          "cefr_level": "A1",
          "word_slugs": [
            "fortune-noun"
          ]
        },
        {
          "id": "792835",
          "text": "La fortune lui sourit.",
          "translation": "Удача ему улыбнулась.",
          "source": "Tatoeba #792835 @U2FS / #9726664 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/792835",
          "cefr_level": "A1",
          "word_slugs": [
            "fortune-noun"
          ]
        },
        {
          "id": "11339292",
          "text": "La fortune nous sourit.",
          "translation": "Удача нам улыбнулась.",
          "source": "Tatoeba #11339292 @felix63 / #11339296 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11339292",
          "cefr_level": "A1",
          "word_slugs": [
            "fortune-noun"
          ]
        },
        {
          "id": "13367110",
          "text": "Sa fortune vous aveugle.",
          "translation": "Вас ослепляет его богатство.",
          "source": "Tatoeba #13367110 @LdjuherTaqvaylit / #13374109 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13367110",
          "cefr_level": "A1",
          "word_slugs": [
            "fortune-noun"
          ]
        }
      ],
      "tags": [
