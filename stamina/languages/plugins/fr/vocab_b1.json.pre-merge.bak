      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13482383",
          "text": "Tu vas atteindre le but.",
          "translation": "Ты достигнешь цели.",
          "source": "Tatoeba #13482383 @LdjuherTaqvaylit / #4059866 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13482383",
          "cefr_level": "A1",
          "word_slugs": [
