    {
      "slug": "signal-noun",
      "lemma": "signal",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1608,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "сигнал"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "8533029",
          "text": "Le signal est clair.",
          "translation": "Сигнал чёткий.",
          "source": "Tatoeba #8533029 @Aiji / #6548519 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8533029",
          "cefr_level": "A1",
          "word_slugs": [
            "signal-noun"
          ]
        },
        {
          "id": "13477531",
          "text": "Le signal est mauvais ici.",
          "translation": "Здесь плохой сигнал.",
          "source": "Tatoeba #13477531 @LdjuherTaqvaylit / #13481299 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13477531",
          "cefr_level": "A1",
          "word_slugs": [
            "signal-noun"
          ]
        },
        {
          "id": "13024131",
          "text": "Ce signal est un mauvais présage.",
          "translation": "Этот сигнал - плохое предзнаменование.",
          "source": "Tatoeba #13024131 @madjidoumnia / #13072594 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13024131",
          "cefr_level": "A1",
          "word_slugs": [
            "signal-noun"
          ]
        },
        {
          "id": "12252579",
          "text": "Avez-vous entendu le signal d'alarme ?",
          "translation": "Вы слышали сигнал тревоги?",
          "source": "Tatoeba #12252579 @lbdx / #12253029 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12252579",
          "cefr_level": "A1",
          "word_slugs": [
            "signal-noun"
          ]
        },
        {
          "id": "11037841",
          "text": "À mon signal, tu te mets à courir.",
          "translation": "По моему сигналу ты начинаешь бежать.",
          "source": "Tatoeba #11037841 @felix63 / #11501909 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11037841",
          "cefr_level": "A1",
          "word_slugs": [
            "signal-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
