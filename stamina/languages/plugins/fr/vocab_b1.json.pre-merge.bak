      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7775696",
          "text": "Qu'as-tu à offrir ?",
          "translation": "Что ты можешь предложить?",
          "source": "Tatoeba #7775696 @Rockaround / #5550446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7775696",
          "cefr_level": "A1",
          "word_slugs": [
            "offrir-verb"
          ]
        },
        {
          "id": "10344755",
          "text": "Je vais te l'offrir.",
          "translation": "Я тебе его подарю.",
          "source": "Tatoeba #10344755 @Julien_PDC / #10456383 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10344755",
          "cefr_level": "A1",
