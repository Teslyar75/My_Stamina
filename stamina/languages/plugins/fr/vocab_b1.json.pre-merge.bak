      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "9347973",
          "text": "Ramène-les ici !",
          "translation": "Приведи их сюда.",
          "source": "Tatoeba #9347973 @massin / #9351217 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9347973",
