      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2769063",
          "text": "Je vais le permettre.",
          "translation": "Я это разрешу.",
          "source": "Tatoeba #2769063 @Rovo / #8837712 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2769063",
          "cefr_level": "A1",
          "word_slugs": [
            "permettre-verb"
          ]
        },
        {
          "id": "1157055",
          "text": "Je ne peux me le permettre.",
          "translation": "Я не могу себе этого позволить.",
          "source": "Tatoeba #1157055 @sacredceltic / #4371401 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1157055",
          "cefr_level": "A1",
          "word_slugs": [
            "permettre-verb"
          ]
        },
        {
          "id": "7108987",
          "text": "Je ne peux pas permettre ça.",
          "translation": "Я не могу этого позволить.",
          "source": "Tatoeba #7108987 @Aiji / #2456602 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7108987",
          "cefr_level": "A1",
          "word_slugs": [
            "permettre-verb"
          ]
        },
        {
          "id": "1073422",
          "text": "Veuillez me permettre d'y aller.",
          "translation": "Пожалуйста, позвольте мне пойти.",
          "source": "Tatoeba #1073422 @sacredceltic / #3046183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1073422",
          "cefr_level": "A1",
          "word_slugs": [
            "permettre-verb"
          ]
        },
        {
          "id": "3631747",
          "text": "Nous ne pouvons nous le permettre.",
          "translation": "Мы не можем себе этого позволить.",
          "source": "Tatoeba #3631747 @sacredceltic / #2999205 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3631747",
          "cefr_level": "A1",
          "word_slugs": [
            "permettre-verb"
          ]
        }
