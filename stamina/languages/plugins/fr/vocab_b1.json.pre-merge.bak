    {
      "slug": "gérer-verb",
      "lemma": "gérer",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1724,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8304142",
          "text": "On peut gérer sans toi.",
          "translation": "Без тебя справимся.",
          "source": "Tatoeba #8304142 @Aiji / #8428266 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8304142",
          "cefr_level": "A1",
          "word_slugs": [
            "gérer-verb"
          ]
        },
        {
          "id": "5373446",
          "text": "Comment vas-tu gérer ça ?",
          "translation": "Как ты это уладишь?",
          "source": "Tatoeba #5373446 @Scorpionvenin14 / #13821001 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5373446",
          "cefr_level": "A1",
          "word_slugs": [
            "gérer-verb"
          ]
        },
        {
          "id": "6153761",
          "text": "Merci de gérer tout ceci.",
          "translation": "Уладьте это всё, пожалуйста.",
          "source": "Tatoeba #6153761 @Aiji / #13998218 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6153761",
          "cefr_level": "A1",
          "word_slugs": [
            "gérer-verb"
          ]
        },
        {
          "id": "13520898",
          "text": "Je peux gérer mes problèmes.",
          "translation": "Я могу уладить свои проблемы.",
          "source": "Tatoeba #13520898 @LdjuherTaqvaylit / #13523390 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13520898",
          "cefr_level": "A1",
          "word_slugs": [
            "gérer-verb"
          ]
        },
        {
          "id": "6474154",
          "text": "Nous pensons pouvoir gérer cela.",
          "translation": "Мы думаем, что сможем это уладить.",
          "source": "Tatoeba #6474154 @Aiji / #6482251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6474154",
          "cefr_level": "A1",
          "word_slugs": [
            "gérer-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
