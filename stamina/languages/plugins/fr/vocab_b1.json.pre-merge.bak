          "cefr_level": "A1",
          "word_slugs": [
            "sud-noun"
          ]
        },
        {
          "id": "11006225",
          "text": "Elle doit être du sud.",
          "translation": "Она, должно быть, с юга.",
          "source": "Tatoeba #11006225 @Lumpawurump / #11014638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11006225",
