      "frequency_rank": 1926,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12746132",
          "text": "J'espérais voir Tom.",
          "translation": "Я надеялся увидеть Тома.",
          "source": "Tatoeba #12746132 @glossboss / #5209910 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12746132",
