          "cefr_level": "A1",
          "word_slugs": [
            "henry-noun"
          ]
        },
        {
          "id": "1680961",
          "text": "Tout le monde admire Henry.",
          "translation": "Все восхищаются Генри.",
          "source": "Tatoeba #1680961 @belgavox / #4863710 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1680961",
          "cefr_level": "A1",
          "word_slugs": [
            "henry-noun"
          ]
        },
        {
          "id": "6943244",
          "text": "Henry est le dernier des Baskervilles.",
          "translation": "Генри - последний из Баскервилей.",
          "source": "Tatoeba #6943244 @Rockaround / #6990081 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6943244",
          "cefr_level": "A1",
