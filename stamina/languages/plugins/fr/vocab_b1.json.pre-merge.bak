    {
      "slug": "anciens-adj",
      "lemma": "anciens",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2415,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11235114",
          "text": "Nos anciens l'ont dit.",
          "translation": "Так сказали наши старейшины.",
          "source": "Tatoeba #11235114 @Aghanim / #12251777 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11235114",
          "cefr_level": "A1",
          "word_slugs": [
            "anciens-adj"
          ]
        },
        {
          "id": "848887",
          "text": "Il vend des tapis anciens.",
          "translation": "Он продаёт старинные ковры.",
          "source": "Tatoeba #848887 @nimfeo / #4356351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/848887",
          "cefr_level": "A1",
          "word_slugs": [
            "anciens-adj"
          ]
        },
        {
          "id": "848888",
          "text": "Ils vendent des tapis anciens.",
          "translation": "Они продают старинные ковры.",
          "source": "Tatoeba #848888 @nimfeo / #4356352 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/848888",
          "cefr_level": "A1",
          "word_slugs": [
            "anciens-adj"
          ]
        },
        {
          "id": "12591356",
          "text": "Les temps anciens sont passés.",
          "translation": "Прежние времена прошли.",
          "source": "Tatoeba #12591356 @Tighra_tlelli / #13867092 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12591356",
          "cefr_level": "A1",
          "word_slugs": [
            "anciens-adj"
          ]
        },
        {
          "id": "1153563",
          "text": "Vous devez respecter les anciens.",
          "translation": "Вы должны уважать старших.",
          "source": "Tatoeba #1153563 @belgavox / #2028537 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1153563",
          "cefr_level": "A1",
          "word_slugs": [
            "anciens-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
