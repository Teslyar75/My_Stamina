            "vienne-name"
          ]
        },
        {
          "id": "757841",
          "text": "Pourvu qu'elle vienne !",
          "translation": "Только бы она пришла!",
          "source": "Tatoeba #757841 @sacredceltic / #12222568 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/757841",
          "cefr_level": "A1",
          "word_slugs": [
            "vienne-name"
          ]
        },
        {
          "id": "8730419",
          "text": "Vienne est en Autriche.",
          "translation": "Вена находится в Австрии.",
          "source": "Tatoeba #8730419 @Julien_PDC / #5241051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8730419",
          "cefr_level": "A1",
          "word_slugs": [
            "vienne-name"
          ]
        },
        {
          "id": "1141447",
          "text": "Dis-lui qu'il vienne.",
          "translation": "Скажи ему, чтобы пришёл.",
          "source": "Tatoeba #1141447 @sacredceltic / #2767545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1141447",
          "cefr_level": "A1",
          "word_slugs": [
            "vienne-name"
          ]
        }
