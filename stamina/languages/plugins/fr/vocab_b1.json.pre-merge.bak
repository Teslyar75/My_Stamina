    {
      "slug": "faisant-verb",
      "lemma": "faisant",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1830,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12785154",
          "text": "On apprend en faisant.",
          "translation": "Мы учимся на практике.",
          "source": "Tatoeba #12785154 @lbdx / #12785371 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12785154",
          "cefr_level": "A1",
          "word_slugs": [
            "faisant-verb"
          ]
        },
        {
          "id": "7070969",
          "text": "Qu'as-tu pensé en le faisant ?",
          "translation": "О чём ты думал, когда это делал?",
          "source": "Tatoeba #7070969 @felix63 / #14084189 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7070969",
          "cefr_level": "A1",
          "word_slugs": [
            "faisant-verb"
          ]
        },
        {
          "id": "12084265",
          "text": "Il s'est blessé en faisant ça.",
          "translation": "Он поранился, делая это.",
          "source": "Tatoeba #12084265 @LdjuherTaqvaylit / #12084838 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12084265",
          "cefr_level": "A1",
          "word_slugs": [
            "faisant-verb"
          ]
        },
        {
          "id": "12537632",
          "text": "Je risque ma vie en faisant ça.",
          "translation": "Я рискую жизнью, делая это.",
