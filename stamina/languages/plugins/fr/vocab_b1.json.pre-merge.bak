      "examples": [
        {
          "id": "11932419",
          "text": "Unissons nos forces.",
          "translation": "Объединим наши усилия.",
          "source": "Tatoeba #11932419 @Adelpa / #11932362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11932419",
          "cefr_level": "A1",
          "word_slugs": [
            "forces-noun"
          ]
        },
        {
          "id": "589220",
          "text": "Économise tes forces.",
          "translation": "Береги силы.",
