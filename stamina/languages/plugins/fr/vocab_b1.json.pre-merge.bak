      "gender": "m",
      "examples": [
        {
          "id": "3516406",
          "text": "Tom est pilote.",
          "translation": "Том - лётчик.",
          "source": "Tatoeba #3516406 @maydoo / #5878289 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3516406",
          "cefr_level": "A1",
