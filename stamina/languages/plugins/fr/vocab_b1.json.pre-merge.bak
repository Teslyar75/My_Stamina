    {
      "slug": "mademoiselle-pron",
      "lemma": "Mademoiselle",
      "pos": "pron",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1397,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6061764",
          "text": "Excusez-moi, mademoiselle.",
          "translation": "Простите, мадемуазель.",
          "source": "Tatoeba #6061764 @Blabla / #8183258 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6061764",
          "cefr_level": "A1",
          "word_slugs": [
            "mademoiselle-pron"
          ]
        },
        {
          "id": "1143788",
          "text": "Veuillez vous asseoir, Mademoiselle !",
          "translation": "Садитесь, пожалуйста, барышня!",
          "source": "Tatoeba #1143788 @sacredceltic / #2785570 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1143788",
          "cefr_level": "A1",
          "word_slugs": [
            "mademoiselle-pron"
          ]
        },
        {
          "id": "2817312",
          "text": "Est-ce que mademoiselle Sandra habite ici ?",
          "translation": "Мадемуазель Сандра здесь живёт?",
          "source": "Tatoeba #2817312 @bleton / #8202677 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2817312",
          "cefr_level": "A1",
          "word_slugs": [
            "mademoiselle-pron"
          ]
        },
        {
          "id": "5844700",
          "text": "Vous avez tort de vous fâcher, mademoiselle.",
          "translation": "Напрасно вы сердитесь, мадемуазель.",
          "source": "Tatoeba #5844700 @Blabla / #6016249 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5844700",
          "cefr_level": "A1",
          "word_slugs": [
            "mademoiselle-pron"
          ]
        },
        {
          "id": "11499784",
          "text": "Calmez-vous, mademoiselle, sinon je vous envoie au couvent.",
          "translation": "Успокойтесь, мадемуазель, а не то я отправлю Вас в монастырь.",
          "source": "Tatoeba #11499784 @Amessikel / #13548496 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11499784",
          "cefr_level": "A1",
          "word_slugs": [
            "mademoiselle-pron"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
