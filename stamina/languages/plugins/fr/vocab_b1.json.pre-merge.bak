    {
      "slug": "moments-noun",
      "lemma": "moments",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2112,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11182242",
          "text": "Je veux vivre de beaux moments.",
          "translation": "Я хочу прожить прекрасные моменты.",
          "source": "Tatoeba #11182242 @janTuki / #11182294 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11182242",
          "cefr_level": "A1",
          "word_slugs": [
            "moments-noun"
          ]
        },
        {
          "id": "13476988",
          "text": "Nous avons passé de bons moments.",
          "translation": "Мы хорошо провели время.",
          "source": "Tatoeba #13476988 @LdjuherTaqvaylit / #3533957 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13476988",
          "cefr_level": "A1",
          "word_slugs": [
            "moments-noun"
          ]
        },
        {
          "id": "4937077",
          "text": "Tu gâches toujours les bons moments.",
          "translation": "Ты всегда портишь хорошие моменты.",
          "source": "Tatoeba #4937077 @Sisyphe / #10681020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4937077",
          "cefr_level": "A1",
          "word_slugs": [
            "moments-noun"
          ]
        },
        {
          "id": "13398524",
          "text": "Il passe par des moments très difficiles.",
          "translation": "Он переживает очень сложные моменты.",
          "source": "Tatoeba #13398524 @Aghanim / #13581588 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13398524",
          "cefr_level": "A1",
          "word_slugs": [
            "moments-noun"
          ]
        },
        {
          "id": "9741573",
          "text": "Plusieurs moments ont été coupés au montage.",
          "translation": "Многие моменты были вырезаны при монтаже.",
          "source": "Tatoeba #9741573 @Aiji / #10118429 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9741573",
          "cefr_level": "A1",
          "word_slugs": [
            "moments-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le moments",
        "plural": "",
        "infinitive": ""
      }
