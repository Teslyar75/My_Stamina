      "cefr_level": "B1",
      "frequency_rank": 1859,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1652375",
          "text": "Que ressens-tu ?",
          "translation": "Что ты чувствуешь?",
          "source": "Tatoeba #1652375 @sacredceltic / #3503940 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1652375",
          "cefr_level": "A1",
          "word_slugs": [
            "ressens-verb"
          ]
        },
        {
          "id": "13395042",
          "text": "Je ne ressens rien.",
          "translation": "Я ничего не чувствую.",
          "source": "Tatoeba #13395042 @lbdx / #2309826 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13395042",
          "cefr_level": "A1",
