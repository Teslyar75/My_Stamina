      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13395352",
          "text": "On échange nos places ?",
          "translation": "Поменяемся местами?",
          "source": "Tatoeba #13395352 @lbdx / #13395362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13395352",
          "cefr_level": "A1",
