      "examples": [
        {
          "id": "7702294",
          "text": "T'es un salaud.",
          "translation": "Ты мерзавец.",
          "source": "Tatoeba #7702294 @Maxence / #5494073 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7702294",
          "cefr_level": "A1",
