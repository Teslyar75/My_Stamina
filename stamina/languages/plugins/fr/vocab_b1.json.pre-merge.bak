          "cefr_level": "A1",
          "word_slugs": [
            "zone-name"
          ]
        },
        {
          "id": "1869484",
          "text": "Je vis dans une zone rurale.",
          "translation": "Я живу в сельской местности.",
          "source": "Tatoeba #1869484 @sacredceltic / #2473073 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1869484",
          "cefr_level": "A1",
          "word_slugs": [
            "zone-name"
          ]
        },
        {
          "id": "1890018",
          "text": "Nous vivons dans une zone reculée.",
          "translation": "Мы живём в удалённом районе.",
          "source": "Tatoeba #1890018 @sacredceltic / #2686345 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1890018",
          "cefr_level": "A1",
          "word_slugs": [
            "zone-name"
          ]
        }
      ],
