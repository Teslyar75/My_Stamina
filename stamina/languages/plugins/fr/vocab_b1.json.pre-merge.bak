    {
      "slug": "ha-symbol",
      "lemma": "Ha",
      "pos": "symbol",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1342,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "9752705",
          "text": "Ha, ha ! Très drôle.",
          "translation": "Ха-ха! Очень смешно.",
          "source": "Tatoeba #9752705 @Adelpa / #10976645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9752705",
          "cefr_level": "A1",
          "word_slugs": [
            "ha-symbol"
          ]
        },
        {
          "id": "10056325",
          "text": "Ha ! Ha ! Ha ! Quoi ?",
          "translation": "Ха-ха-ха! Что?",
          "source": "Tatoeba #10056325 @Aimi / #13609478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10056325",
          "cefr_level": "A1",
          "word_slugs": [
            "ha-symbol"
          ]
        },
        {
          "id": "969237",
          "text": "\"Ha, ha!\", dit-il en espagnol.",
          "translation": "\"Ха-ха!\" - сказал он по-испански.",
          "source": "Tatoeba #969237 @marcp / #2401813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/969237",
          "cefr_level": "A1",
          "word_slugs": [
            "ha-symbol"
          ]
        },
        {
          "id": "6865426",
          "text": "Ha ha ha ! Tu veux tuer toutes les mouches ?",
          "translation": "Ха-ха-ха! Ты хочешь убить всех мух?",
          "source": "Tatoeba #6865426 @GB3 / #6883927 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6865426",
          "cefr_level": "A1",
          "word_slugs": [
            "ha-symbol"
          ]
        },
        {
          "id": "6865428",
          "text": "Ha ha ha ! Vous voulez tuer toutes les mouches ?",
          "translation": "Ха-ха-ха! Вы хотите убить всех мух?",
          "source": "Tatoeba #6865428 @GB3 / #6883926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6865428",
          "cefr_level": "A1",
          "word_slugs": [
            "ha-symbol"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
