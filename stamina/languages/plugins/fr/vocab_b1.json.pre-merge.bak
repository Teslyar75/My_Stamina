    {
      "slug": "terme-noun",
      "lemma": "terme",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2079,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "термин",
          "слово"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5399750",
          "text": "Nous y mettrons un terme.",
          "translation": "Мы положим этому конец.",
          "source": "Tatoeba #5399750 @Aiji / #5399762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5399750",
          "cefr_level": "A1",
          "word_slugs": [
            "terme-noun"
          ]
        },
        {
          "id": "6926792",
          "text": "Est-ce un terme technique ?",
          "translation": "Это технический термин?",
          "source": "Tatoeba #6926792 @Aiji / #6930365 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6926792",
          "cefr_level": "A1",
          "word_slugs": [
            "terme-noun"
          ]
        },
        {
          "id": "4627211",
          "text": "Le terme est un peu fort.",
          "translation": "Это громко сказано.",
          "source": "Tatoeba #4627211 @sacredceltic / #4627260 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4627211",
          "cefr_level": "A1",
          "word_slugs": [
            "terme-noun"
          ]
        },
        {
          "id": "9505659",
          "text": "Il veut y mettre un terme.",
          "translation": "Он хочет положить этому конец.",
          "source": "Tatoeba #9505659 @Julien_PDC / #10329867 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9505659",
          "cefr_level": "A1",
          "word_slugs": [
            "terme-noun"
          ]
        },
        {
          "id": "6219189",
          "text": "Mettons un terme à ce débat.",
          "translation": "Положим конец этому спору.",
          "source": "Tatoeba #6219189 @Aiji / #6304601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6219189",
          "cefr_level": "A1",
          "word_slugs": [
            "terme-noun"
          ]
        }
      ],
