          "source": "Tatoeba #12867456 @Maksenatsaleh / #12867493 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12867456",
          "cefr_level": "A1",
          "word_slugs": [
            "virer-noun"
          ]
        },
        {
          "id": "569859",
          "text": "Il va se faire virer.",
          "translation": "Его уволят.",
          "source": "Tatoeba #569859 @sacredceltic / #8548478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/569859",
          "cefr_level": "A1",
          "word_slugs": [
            "virer-noun"
          ]
        },
        {
          "id": "2036104",
          "text": "Ils ne peuvent te virer.",
          "translation": "Они не могут тебя уволить.",
          "source": "Tatoeba #2036104 @sacredceltic / #2233175 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2036104",
          "cefr_level": "A1",
          "word_slugs": [
            "virer-noun"
          ]
        },
        {
          "id": "2036105",
          "text": "Ils ne peuvent vous virer.",
          "translation": "Они не могут Вас уволить.",
          "source": "Tatoeba #2036105 @sacredceltic / #2771637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2036105",
          "cefr_level": "A1",
          "word_slugs": [
            "virer-noun"
          ]
        }
