          "cefr_level": "A1",
          "word_slugs": [
            "jeff-name"
          ]
        },
        {
          "id": "1330571",
          "text": "Il est appelé Jeff par tout le monde.",
          "translation": "Все зовут его Джефф.",
          "source": "Tatoeba #1330571 @Eldad / #1796509 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1330571",
          "cefr_level": "A1",
          "word_slugs": [
            "jeff-name"
          ]
        },
        {
          "id": "1515860",
          "text": "Il semble que Jeff sache qui elle est.",
          "translation": "Джефф, похоже, знает, кто она.",
          "source": "Tatoeba #1515860 @Rovo / #8145268 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1515860",
          "cefr_level": "A1",
          "word_slugs": [
            "jeff-name"
          ]
        }
