      "frequency_rank": 1991,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1593426",
          "text": "Kim vit avec Ken.",
          "translation": "Ким живёт с Кеном.",
          "source": "Tatoeba #1593426 @Petrus / #470481 @vilnat (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1593426",
          "cefr_level": "A1",
          "word_slugs": [
            "kim-symbol"
          ]
        },
        {
          "id": "1525368",
          "text": "Kim et moi sommes du même âge.",
          "translation": "Мы с Кимом одного возраста.",
