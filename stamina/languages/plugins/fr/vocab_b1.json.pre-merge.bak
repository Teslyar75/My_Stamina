      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4547288",
          "text": "Rien ne se produit.",
          "translation": "Ничего не происходит.",
          "source": "Tatoeba #4547288 @sacredceltic / #3195521 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4547288",
          "cefr_level": "A1",
          "word_slugs": [
            "produit-noun"
          ]
        },
        {
          "id": "1114494",
          "text": "Rien ne produit rien.",
          "translation": "Из ничего ничего не бывает.",
          "source": "Tatoeba #1114494 @sacredceltic / #2005101 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1114494",
          "cefr_level": "A1",
          "word_slugs": [
            "produit-noun"
          ]
        },
        {
          "id": "5645762",
          "text": "Le produit est cassé.",
          "translation": "Товар сломан.",
          "source": "Tatoeba #5645762 @narnar / #5650488 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5645762",
          "cefr_level": "A1",
          "word_slugs": [
            "produit-noun"
          ]
        },
        {
          "id": "7352734",
          "text": "Cela se produit souvent.",
          "translation": "Такое часто бывает.",
          "source": "Tatoeba #7352734 @Aiji / #5549886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7352734",
          "cefr_level": "A1",
          "word_slugs": [
