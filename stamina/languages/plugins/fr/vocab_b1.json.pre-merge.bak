      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "955501",
          "text": "Richard Roberts est l'auteur de nombreux livres.",
          "translation": "Ричард Робертс - автор множества книг.",
          "source": "Tatoeba #955501 @Micsmithel / #2780615 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/955501",
          "cefr_level": "A1",
          "word_slugs": [
            "richard-name"
          ]
        },
        {
          "id": "1541720",
          "text": "Est-ce que monsieur Richard est à la maison ?",
          "translation": "Господин Ришар дома?",
          "source": "Tatoeba #1541720 @martin9 / #8045119 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1541720",
          "cefr_level": "A1",
          "word_slugs": [
            "richard-name"
          ]
        },
        {
          "id": "15057",
          "text": "Richard est juste, même envers les gens qu'il n'aime pas.",
          "translation": "Ричард справедлив даже по отношению к людям, которые ему не нравятся.",
          "source": "Tatoeba #15057 @Selenyt / #437882 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/15057",
          "cefr_level": "A1",
          "word_slugs": [
            "richard-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
