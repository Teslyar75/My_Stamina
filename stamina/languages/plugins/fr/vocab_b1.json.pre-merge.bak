            "semblait-verb"
          ]
        },
        {
          "id": "1245685",
          "text": "Il semblait sincère.",
          "translation": "Он казался искренним.",
          "source": "Tatoeba #1245685 @sacredceltic / #6537478 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1245685",
