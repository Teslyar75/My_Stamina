      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8648821",
          "text": "Cela coûte des vies.",
          "translation": "Цена этому - человеческие жизни.",
          "source": "Tatoeba #8648821 @Micsmithel / #10326958 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8648821",
          "cefr_level": "A1",
          "word_slugs": [
            "vies-noun"
          ]
        },
        {
          "id": "5307256",
          "text": "Nos vies en dépendent.",
          "translation": "От этого зависят наши жизни.",
          "source": "Tatoeba #5307256 @Scorpionvenin14 / #5307479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5307256",
