    {
      "slug": "ayant-verb",
      "lemma": "ayant",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2387,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8210",
          "text": "Ayant fait son travail, il sortit.",
          "translation": "Закончив свою работу, он вышел.",
          "source": "Tatoeba #8210 @gillux / #882109 @aleph (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8210",
          "cefr_level": "A1",
          "word_slugs": [
            "ayant-verb"
          ]
        },
        {
          "id": "10543624",
          "text": "Ayant dit cela, il disparut simplement.",
          "translation": "Сказав это, он просто исчез.",
          "source": "Tatoeba #10543624 @sacredceltic / #10956455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10543624",
          "cefr_level": "A1",
          "word_slugs": [
            "ayant-verb"
          ]
        },
        {
          "id": "5246852",
          "text": "Ayant trouvé une pomme, je l'ai mangée.",
          "translation": "Найдя яблоко, я его съел.",
          "source": "Tatoeba #5246852 @martin9 / #10815071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5246852",
          "cefr_level": "A1",
          "word_slugs": [
            "ayant-verb"
          ]
        },
        {
          "id": "11223709",
          "text": "L'ayant vu auparavant, je l'ai reconnu.",
          "translation": "Я его раньше видел и поэтому сразу узнал.",
          "source": "Tatoeba #11223709 @lbdx / #11890442 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11223709",
          "cefr_level": "A1",
          "word_slugs": [
            "ayant-verb"
          ]
        },
        {
          "id": "1810069",
          "text": "Ayant achevé le travail, il alla au lit.",
          "translation": "Закончив работу, он пошёл спать.",
          "source": "Tatoeba #1810069 @sacredceltic / #3176643 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1810069",
          "cefr_level": "A1",
          "word_slugs": [
            "ayant-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "ayant",
        "plural": "",
        "infinitive": "ayant"
      }
