          ]
        },
        {
          "id": "331092",
          "text": "J'ai trouvé l'immeuble.",
          "translation": "Я нашёл здание.",
          "source": "Tatoeba #331092 @TRANG / #3155353 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/331092",
