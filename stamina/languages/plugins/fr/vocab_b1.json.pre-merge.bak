    {
      "slug": "marque-noun",
      "lemma": "marque",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1883,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1847496",
          "text": "Quelle est la marque ?",
          "translation": "Какой счёт?",
          "source": "Tatoeba #1847496 @sacredceltic / #2787882 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1847496",
          "cefr_level": "A1",
          "word_slugs": [
            "marque-noun"
          ]
        },
        {
          "id": "138669",
          "text": "Quelle marque préfères-tu ?",
          "translation": "Какую марку ты предпочитаешь?",
          "source": "Tatoeba #138669 @hortusdei / #2418285 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/138669",
          "cefr_level": "A1",
          "word_slugs": [
            "marque-noun"
          ]
        },
        {
          "id": "444806",
          "text": "Cette ligne marque ta taille.",
          "translation": "Эта черта отмечает твой рост.",
          "source": "Tatoeba #444806 @Archibald / #12233286 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/444806",
          "cefr_level": "A1",
          "word_slugs": [
            "marque-noun"
          ]
        },
        {
          "id": "2141088",
          "text": "Auldey est une marque chinoise.",
          "translation": "\"Auldey\" — это китайская марка.",
          "source": "Tatoeba #2141088 @Dreamk33 / #478973 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2141088",
          "cefr_level": "A1",
          "word_slugs": [
            "marque-noun"
          ]
        },
        {
          "id": "13867474",
          "text": "Le vouvoiement marque le respect.",
          "translation": "Обращение на «вы» — знак уважения.",
          "source": "Tatoeba #13867474 @felix63 / #14039518 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13867474",
          "cefr_level": "A1",
          "word_slugs": [
            "marque-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
