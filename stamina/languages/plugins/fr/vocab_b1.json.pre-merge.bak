    {
      "slug": "attendant-adj",
      "lemma": "attendant",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1632,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13320015",
          "text": "Installez-vous confortablement en attendant.",
          "translation": "Устраивайтесь пока поудобнее.",
          "source": "Tatoeba #13320015 @madjidoumnia / #13326810 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13320015",
          "cefr_level": "A1",
          "word_slugs": [
            "attendant-adj"
          ]
        },
        {
          "id": "7498357",
          "text": "Tom s'endormit en attendant Mary.",
          "translation": "Том заснул, пока ждал Марию.",
          "source": "Tatoeba #7498357 @tras / #7498892 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7498357",
          "cefr_level": "A1",
          "word_slugs": [
            "attendant-adj"
          ]
        },
        {
          "id": "4959222",
          "text": "Que devrais-je faire en attendant ?",
          "translation": "Что мне пока делать?",
          "source": "Tatoeba #4959222 @franlexcois / #4959423 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4959222",
          "cefr_level": "A1",
          "word_slugs": [
            "attendant-adj"
          ]
        },
        {
          "id": "11796543",
          "text": "En attendant, j'habite à l'hôtel.",
          "translation": "Я пока остановился в гостинице.",
          "source": "Tatoeba #11796543 @Rovo / #11795728 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11796543",
          "cefr_level": "A1",
          "word_slugs": [
            "attendant-adj"
          ]
        },
        {
          "id": "11352657",
          "text": "En attendant, je veux de la glace.",
          "translation": "А пока я хочу мороженого.",
          "source": "Tatoeba #11352657 @carlosalberto / #11352691 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11352657",
          "cefr_level": "A1",
          "word_slugs": [
            "attendant-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le attendant",
        "plural": "",
        "infinitive": ""
      }
    },
