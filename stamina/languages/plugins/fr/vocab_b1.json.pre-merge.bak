    {
      "slug": "prennent-verb",
      "lemma": "prennent",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2354,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "11361823",
          "text": "Ils prennent peur.",
          "translation": "Они пугаются.",
          "source": "Tatoeba #11361823 @Fenrir / #12401883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11361823",
          "cefr_level": "A1",
          "word_slugs": [
            "prennent-verb"
          ]
        },
        {
          "id": "11361826",
          "text": "Elles prennent peur.",
          "translation": "Они пугаются.",
          "source": "Tatoeba #11361826 @Fenrir / #12401883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11361826",
