          "id": "5702774",
          "text": "Ils ne pourraient pas nous aider.",
          "translation": "Они бы не смогли нам помочь.",
          "source": "Tatoeba #5702774 @Aiji / #5702850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5702774",
          "cefr_level": "A1",
          "word_slugs": [
            "pourraient-verb"
          ]
        },
        {
          "id": "2153816",
          "text": "Les mots ne pourraient le décrire.",
          "translation": "Это вряд ли можно описать словами.",
          "source": "Tatoeba #2153816 @sacredceltic / #13369050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2153816",
          "cefr_level": "A1",
          "word_slugs": [
            "pourraient-verb"
          ]
        },
        {
          "id": "542820",
          "text": "Ils pourraient nous dire la vérité.",
          "translation": "Они могли бы сказать нам правду.",
          "source": "Tatoeba #542820 @sacredceltic / #2381293 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/542820",
          "cefr_level": "A1",
          "word_slugs": [
            "pourraient-verb"
          ]
        }
      ],
