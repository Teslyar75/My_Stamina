      "cefr_level": "B1",
      "frequency_rank": 2093,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1901328",
          "text": "Le coq chante.",
          "translation": "Петух поёт.",
          "source": "Tatoeba #1901328 @Scott / #3512618 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1901328",
          "cefr_level": "A1",
          "word_slugs": [
            "chante-verb"
          ]
        },
        {
          "id": "6463155",
          "text": "Ne chante pas.",
          "translation": "Не пой.",
          "source": "Tatoeba #6463155 @Aiji / #2991700 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6463155",
          "cefr_level": "A1",
          "word_slugs": [
            "chante-verb"
          ]
        },
        {
          "id": "10520166",
          "text": "Je chante mal.",
          "translation": "Я плохо пою.",
          "source": "Tatoeba #10520166 @lbdx / #11280288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10520166",
          "cefr_level": "A1",
          "word_slugs": [
            "chante-verb"
          ]
        },
        {
          "id": "872912",
          "text": "Je chante bien.",
          "translation": "Я хорошо пою.",
          "source": "Tatoeba #872912 @Scott / #2038438 @Vokabre (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/872912",
          "cefr_level": "A1",
          "word_slugs": [
            "chante-verb"
          ]
        },
        {
          "id": "1316324",
