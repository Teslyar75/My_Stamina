          ]
        },
        {
          "id": "835541",
          "text": "Son discours fut excellent.",
          "translation": "Её речь была превосходна.",
          "source": "Tatoeba #835541 @sacredceltic / #12198659 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/835541",
