    {
      "slug": "devra-verb",
      "lemma": "devra",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2497,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "11691089",
          "text": "Elle devra l'attendre.",
          "translation": "Ей придётся его подождать.",
          "source": "Tatoeba #11691089 @LdjuherTaqvaylit / #11701880 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11691089",
          "cefr_level": "A1",
          "word_slugs": [
            "devra-verb"
          ]
        },
        {
          "id": "6402391",
          "text": "Ceci devra être remplacé.",
          "translation": "Это надо будет заменить.",
          "source": "Tatoeba #6402391 @Aiji / #6479050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6402391",
          "cefr_level": "A1",
          "word_slugs": [
            "devra-verb"
          ]
        },
        {
          "id": "12453056",
          "text": "On devra tout stériliser.",
          "translation": "Мы должны будем всё простерилизовать.",
          "source": "Tatoeba #12453056 @Rovo / #12453062 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12453056",
          "cefr_level": "A1",
          "word_slugs": [
            "devra-verb"
          ]
        },
        {
          "id": "12928789",
          "text": "Tom devra bientôt partir.",
          "translation": "Тому скоро придётся уйти.",
          "source": "Tatoeba #12928789 @Rovo / #12928325 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12928789",
          "cefr_level": "A1",
          "word_slugs": [
            "devra-verb"
          ]
        },
        {
          "id": "12453055",
          "text": "Tout devra être stérilisé.",
          "translation": "Всё должно быть простерилизовано.",
          "source": "Tatoeba #12453055 @Rovo / #12453061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12453055",
          "cefr_level": "A1",
