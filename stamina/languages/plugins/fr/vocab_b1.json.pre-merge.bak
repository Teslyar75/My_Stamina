            "imaginer-verb"
          ]
        },
        {
          "id": "6198824",
          "text": "Je ne peux pas imaginer ça.",
          "translation": "Я не могу себе этого представить.",
          "source": "Tatoeba #6198824 @nimfeo / #6219992 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6198824",
          "cefr_level": "A1",
          "word_slugs": [
            "imaginer-verb"
          ]
        },
        {
          "id": "5549983",
          "text": "Cela, je ne peux l'imaginer.",
          "translation": "Этого я не могу себе представить.",
          "source": "Tatoeba #5549983 @sacredceltic / #5550029 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549983",
