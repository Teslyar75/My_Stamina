          "cefr_level": "A1",
          "word_slugs": [
            "ours-noun"
          ]
        },
        {
          "id": "3846387",
          "text": "Un ours vit ici.",
          "translation": "Здесь живёт медведь.",
          "source": "Tatoeba #3846387 @Whidou / #5357117 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3846387",
