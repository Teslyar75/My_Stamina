          ]
        },
        {
          "id": "10887984",
          "text": "Les pièces sont rondes.",
          "translation": "Монеты круглые.",
          "source": "Tatoeba #10887984 @Micsmithel / #8314744 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10887984",
          "cefr_level": "A1",
          "word_slugs": [
            "pièces-noun"
          ]
        },
