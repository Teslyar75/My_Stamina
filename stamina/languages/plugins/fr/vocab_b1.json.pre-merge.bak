    {
      "slug": "bill-noun",
      "lemma": "bill",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1348,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8593782",
          "text": "Bill, viens ici !",
          "translation": "Билл, иди сюда!",
          "source": "Tatoeba #8593782 @Micsmithel / #8594328 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8593782",
          "cefr_level": "A1",
          "word_slugs": [
            "bill-noun"
          ]
        },
        {
          "id": "373845",
          "text": "Bill était au Japon.",
          "translation": "Билл был в Японии.",
          "source": "Tatoeba #373845 @zmoo / #625959 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/373845",
          "cefr_level": "A1",
          "word_slugs": [
            "bill-noun"
          ]
        },
        {
          "id": "331849",
          "text": "Bill, ouvre la porte.",
          "translation": "Билл, открой дверь.",
          "source": "Tatoeba #331849 @pierrephi / #738413 @GranD (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/331849",
          "cefr_level": "A1",
          "word_slugs": [
            "bill-noun"
          ]
        },
        {
          "id": "13189",
          "text": "Bill alluma la télévision.",
          "translation": "Билл включил телевизор.",
          "source": "Tatoeba #13189 @Whidou / #1443543 @chispa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13189",
          "cefr_level": "A1",
          "word_slugs": [
            "bill-noun"
          ]
        },
        {
          "id": "2991303",
          "text": "Bill a simplement plaisanté.",
          "translation": "Билл просто пошутил.",
          "source": "Tatoeba #2991303 @nimfeo / #2991830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2991303",
          "cefr_level": "A1",
          "word_slugs": [
            "bill-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
