    {
      "slug": "attente-noun",
      "lemma": "attente",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2430,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "ожидание"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8318301",
          "text": "L'attente est interminable.",
          "translation": "Ожидание бесконечно.",
          "source": "Tatoeba #8318301 @Julien_PDC / #8399463 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8318301",
          "cefr_level": "A1",
          "word_slugs": [
            "attente-noun"
          ]
        },
        {
          "id": "7141522",
          "text": "La longue attente est terminée.",
          "translation": "Долгое ожидание закончилось.",
          "source": "Tatoeba #7141522 @Aiji / #13997278 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7141522",
          "cefr_level": "A1",
          "word_slugs": [
            "attente-noun"
          ]
        },
        {
          "id": "10706601",
          "text": "La file d’attente est énorme.",
          "translation": "Очередь огромная.",
          "source": "Tatoeba #10706601 @AutoBot / #13755853 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10706601",
          "cefr_level": "A1",
          "word_slugs": [
            "attente-noun"
          ]
        },
        {
          "id": "4233",
          "text": "Attendez dans la salle d'attente.",
          "translation": "Подождите в зале ожидания.",
          "source": "Tatoeba #4233 @TRANG / #3400499 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4233",
          "cefr_level": "A1",
          "word_slugs": [
            "attente-noun"
          ]
        },
        {
          "id": "1681477",
          "text": "Contre toute attente, nous devînmes amis.",
          "translation": "Против всякого ожидания, мы стали друзьями.",
          "source": "Tatoeba #1681477 @sacredceltic / #2005556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1681477",
          "cefr_level": "A1",
          "word_slugs": [
            "attente-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
