    {
      "slug": "amy-name",
      "lemma": "Amy",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1576,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2862912",
          "text": "Amy me regardait en souriant.",
          "translation": "Эми смотрела на меня, улыбаясь.",
          "source": "Tatoeba #2862912 @manuchko / #8235601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2862912",
          "cefr_level": "A1",
          "word_slugs": [
            "amy-name"
          ]
        },
        {
          "id": "10776",
          "text": "Amy va à la gare à pied tous les matins.",
          "translation": "Эми каждое утро ходит пешком на станцию.",
          "source": "Tatoeba #10776 @KotobaNiko / #13231988 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10776",
          "cefr_level": "A1",
          "word_slugs": [
            "amy-name"
          ]
        },
        {
          "id": "1633362",
          "text": "Amy va à l’arrêt de bus à pied tous les matins.",
          "translation": "Эми каждое утро ходит пешком на автобусную остановку.",
          "source": "Tatoeba #1633362 @GeeZ / #13231980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1633362",
          "cefr_level": "A1",
          "word_slugs": [
            "amy-name"
          ]
        },
        {
          "id": "1633363",
          "text": "Amy va à l’arrêt de tram à pied tous les matins.",
          "translation": "Эми каждое утро ходит пешком на остановку трамвая.",
          "source": "Tatoeba #1633363 @GeeZ / #13231987 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1633363",
          "cefr_level": "A1",
          "word_slugs": [
            "amy-name"
          ]
        },
        {
          "id": "1633364",
          "text": "Amy va à l’arrêt de métro à pied tous les matins.",
          "translation": "Эми каждое утро ходит пешком до метро.",
          "source": "Tatoeba #1633364 @GeeZ / #13231989 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1633364",
          "cefr_level": "A1",
          "word_slugs": [
            "amy-name"
          ]
        }
      ],
      "tags": [
        "B1"
