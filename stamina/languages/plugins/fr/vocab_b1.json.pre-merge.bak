    {
      "slug": "types-noun",
      "lemma": "types",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1545,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8357391",
          "text": "Ces types d'erreurs sont inévitables.",
          "translation": "Такого рода ошибки неизбежны.",
          "source": "Tatoeba #8357391 @zarisi / #5137873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8357391",
          "cefr_level": "A1",
          "word_slugs": [
            "types-noun"
          ]
        },
        {
          "id": "11737556",
          "text": "Il existe plusieurs types de freinage.",
          "translation": "Существует несколько видов торможения.",
          "source": "Tatoeba #11737556 @Aiji / #14043950 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11737556",
          "cefr_level": "A1",
          "word_slugs": [
            "types-noun"
          ]
        },
        {
          "id": "8582515",
          "text": "Ce sont différents types d'ordinateurs.",
          "translation": "Это разные типы компьютеров.",
          "source": "Tatoeba #8582515 @Aiji / #8582985 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8582515",
          "cefr_level": "A1",
          "word_slugs": [
            "types-noun"
          ]
        },
        {
          "id": "9547454",
          "text": "J'ai horreur des types comme lui.",
          "translation": "Терпеть не могу таких, как он.",
          "source": "Tatoeba #9547454 @Aiji / #10742548 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9547454",
          "cefr_level": "A1",
          "word_slugs": [
            "types-noun"
          ]
        },
        {
          "id": "2699613",
          "text": "Elle aime tous les types de sports.",
          "translation": "Ей нравятся все виды спорта.",
          "source": "Tatoeba #2699613 @Anthaus / #2780981 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2699613",
          "cefr_level": "A1",
          "word_slugs": [
            "types-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
