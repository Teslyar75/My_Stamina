          "word_slugs": [
            "campagne-noun"
          ]
        },
        {
          "id": "529827",
          "text": "Elle vit à la campagne.",
          "translation": "Она живет в деревне.",
          "source": "Tatoeba #529827 @zmoo / #528166 @Klaus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/529827",
