          "пресса"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "9506356",
          "text": "Oui, ça presse.",
          "translation": "Да, это срочно.",
          "source": "Tatoeba #9506356 @Julien_PDC / #11689628 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9506356",
          "cefr_level": "A1",
