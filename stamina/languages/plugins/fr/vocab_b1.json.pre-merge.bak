    {
      "slug": "découvrir-verb",
      "lemma": "découvrir",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1343,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7414567",
          "text": "Ils vont le découvrir !",
          "translation": "Они всё узнают!",
          "source": "Tatoeba #7414567 @lbdx / #10636815 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7414567",
          "cefr_level": "A1",
          "word_slugs": [
            "découvrir-verb"
          ]
        },
        {
          "id": "13618316",
          "text": "Qu'espères-tu découvrir ?",
          "translation": "Что ты надеешься обнаружить?",
          "source": "Tatoeba #13618316 @unetoilebrille / #13618311 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13618316",
          "cefr_level": "A1",
          "word_slugs": [
            "découvrir-verb"
          ]
        },
        {
          "id": "2369962",
          "text": "Je viens de le découvrir.",
          "translation": "Я это только что обнаружил.",
          "source": "Tatoeba #2369962 @sacredceltic / #3683896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2369962",
          "cefr_level": "A1",
          "word_slugs": [
            "découvrir-verb"
          ]
        },
        {
          "id": "13581863",
          "text": "Qu'espères-tu y découvrir ?",
          "translation": "Что ты надеешься там обнаружить?",
          "source": "Tatoeba #13581863 @LdjuherTaqvaylit / #13618314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13581863",
          "cefr_level": "A1",
          "word_slugs": [
            "découvrir-verb"
          ]
        },
        {
          "id": "8110653",
          "text": "Je dois découvrir la vérité.",
          "translation": "Я должен узнать правду.",
          "source": "Tatoeba #8110653 @Aiji / #3081759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8110653",
          "cefr_level": "A1",
          "word_slugs": [
            "découvrir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
