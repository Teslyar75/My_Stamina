    {
      "slug": "fuir-verb",
      "lemma": "fuir",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2030,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6287320",
          "text": "Tom a dû fuir.",
          "translation": "Тому пришлось сбежать.",
          "source": "Tatoeba #6287320 @nimfeo / #6287409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6287320",
          "cefr_level": "A1",
          "word_slugs": [
            "fuir-verb"
          ]
        },
        {
          "id": "6316520",
          "text": "Il nous faut fuir.",
          "translation": "Нам надо бежать.",
          "source": "Tatoeba #6316520 @Adelpa / #4779629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6316520",
          "cefr_level": "A1",
          "word_slugs": [
            "fuir-verb"
          ]
        },
        {
          "id": "6201949",
          "text": "Tom arrivera à fuir.",
          "translation": "Тому удастся сбежать.",
          "source": "Tatoeba #6201949 @LINGUISTE / #12639181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6201949",
          "cefr_level": "A1",
          "word_slugs": [
            "fuir-verb"
          ]
        },
        {
          "id": "13205262",
          "text": "Ils t'ont fait fuir.",
          "translation": "Они обратили тебя в бегство.",
          "source": "Tatoeba #13205262 @Tighra_tlelli / #14076064 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13205262",
          "cefr_level": "A1",
          "word_slugs": [
            "fuir-verb"
          ]
        },
        {
          "id": "8671799",
          "text": "Il se tourna pour fuir.",
          "translation": "Он повернулся, чтобы бежать.",
          "source": "Tatoeba #8671799 @felix63 / #12454683 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8671799",
          "cefr_level": "A1",
          "word_slugs": [
            "fuir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
