          ]
        },
        {
          "id": "8901164",
          "text": "Il voulait s'en assurer.",
          "translation": "Он хотел в этом убедиться.",
          "source": "Tatoeba #8901164 @Julien_PDC / #10144261 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8901164",
