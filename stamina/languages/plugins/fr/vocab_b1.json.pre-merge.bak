      "examples": [
        {
          "id": "5381241",
          "text": "Qu'es-tu censé faire ?",
          "translation": "Что ты должен делать?",
          "source": "Tatoeba #5381241 @Aiji / #4765339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5381241",
