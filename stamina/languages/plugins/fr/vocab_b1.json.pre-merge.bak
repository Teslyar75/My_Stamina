      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "892752",
          "text": "La connaissance est la puissance.",
          "translation": "Знание — сила.",
          "source": "Tatoeba #892752 @Scott / #651166 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/892752",
          "cefr_level": "A1",
          "word_slugs": [
            "puissance-noun"
          ]
        },
        {
          "id": "3277",
          "text": "Ne sous-estime pas ma puissance.",
          "translation": "Не недооценивай мои силы.",
          "source": "Tatoeba #3277 @SUZIE / #5593 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3277",
          "cefr_level": "A1",
          "word_slugs": [
            "puissance-noun"
          ]
        },
        {
          "id": "7435161",
          "text": "Personne ne l'égale en puissance.",
