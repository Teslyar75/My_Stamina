    {
      "slug": "remettre-verb",
      "lemma": "remettre",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1338,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4679101",
          "text": "Je peux remettre.",
          "translation": "Я могу перенести.",
          "source": "Tatoeba #4679101 @sacredceltic / #5191583 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4679101",
          "cefr_level": "A1",
          "word_slugs": [
            "remettre-verb"
          ]
        },
        {
          "id": "10810358",
          "text": "On peut se remettre de tout.",
          "translation": "От всего можно оправиться.",
          "source": "Tatoeba #10810358 @samir_t / #10810436 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10810358",
          "cefr_level": "A1",
          "word_slugs": [
            "remettre-verb"
          ]
        },
        {
          "id": "3143286",
          "text": "Je pense me remettre au travail.",
          "translation": "Я, пожалуй, вернусь к работе.",
          "source": "Tatoeba #3143286 @sacredceltic / #8302356 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3143286",
          "cefr_level": "A1",
          "word_slugs": [
            "remettre-verb"
          ]
        },
        {
          "id": "8372037",
          "text": "Puis-je me remettre au travail ?",
          "translation": "Я могу вернуться к работе?",
          "source": "Tatoeba #8372037 @Aiji / #3565770 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8372037",
          "cefr_level": "A1",
          "word_slugs": [
            "remettre-verb"
          ]
        },
        {
          "id": "591149",
          "text": "Je proposai de remettre la réunion.",
          "translation": "Я предложил перенести собрание.",
          "source": "Tatoeba #591149 @sacredceltic / #1733858 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/591149",
          "cefr_level": "A1",
          "word_slugs": [
            "remettre-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
