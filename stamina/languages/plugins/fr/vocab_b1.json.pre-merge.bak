          "cefr_level": "A1",
          "word_slugs": [
            "vies-noun"
          ]
        },
        {
          "id": "1640282",
          "text": "Nous risquions nos vies.",
          "translation": "Мы рисковали своей жизнью.",
          "source": "Tatoeba #1640282 @belgavox / #6080467 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1640282",
          "cefr_level": "A1",
          "word_slugs": [
            "vies-noun"
          ]
        },
        {
          "id": "1794070",
          "text": "Vos vies seront épargnées.",
          "translation": "Вам будет сохранена жизнь.",
          "source": "Tatoeba #1794070 @sacredceltic / #4115080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1794070",
          "cefr_level": "A1",
          "word_slugs": [
            "vies-noun"
          ]
        }
