      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10473567",
          "text": "Il suit les traces.",
          "translation": "Он идёт по следу.",
          "source": "Tatoeba #10473567 @madjidoumnia / #11878384 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10473567",
