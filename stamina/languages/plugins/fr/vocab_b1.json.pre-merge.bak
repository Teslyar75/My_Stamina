        },
        {
          "id": "1554044",
          "text": "En êtes-vous certaines ?",
          "translation": "Вы в этом уверены?",
          "source": "Tatoeba #1554044 @sacredceltic / #2072784 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1554044",
