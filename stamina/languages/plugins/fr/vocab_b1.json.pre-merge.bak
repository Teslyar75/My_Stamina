      "examples": [
        {
          "id": "8636184",
          "text": "Il s'inquiète à la moindre alerte.",
          "translation": "Он переживает по любому поводу.",
          "source": "Tatoeba #8636184 @Julien_PDC / #11863668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636184",
