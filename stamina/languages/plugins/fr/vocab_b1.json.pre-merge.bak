          "word_slugs": [
            "mandat-noun"
          ]
        },
        {
          "id": "12176039",
          "text": "Nous avons un mandat pour perquisitionner votre maison.",
          "translation": "У нас есть ордер на обыск вашего дома.",
          "source": "Tatoeba #12176039 @lbdx / #12176041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12176039",
          "cefr_level": "A1",
          "word_slugs": [
            "mandat-noun"
          ]
        },
        {
          "id": "12175916",
          "text": "Nous avons un mandat pour perquisitionner votre appartement.",
          "translation": "У нас есть ордер на обыск вашей квартиры.",
          "source": "Tatoeba #12175916 @lbdx / #12176161 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12175916",
          "cefr_level": "A1",
          "word_slugs": [
            "mandat-noun"
          ]
        }
