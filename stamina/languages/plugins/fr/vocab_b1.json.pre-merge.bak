    {
      "slug": "milliers-noun",
      "lemma": "milliers",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2017,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13714358",
          "text": "Le Japon compte des milliers d'îles.",
          "translation": "В Японии насчитываются тысячи островов.",
          "source": "Tatoeba #13714358 @zogwarg / #13714406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13714358",
          "cefr_level": "A1",
          "word_slugs": [
            "milliers-noun"
          ]
        },
        {
          "id": "12916127",
          "text": "Des milliers d'emplois ont été créés.",
          "translation": "Были созданы тысячи рабочих мест.",
          "source": "Tatoeba #12916127 @lbdx / #14094595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12916127",
          "cefr_level": "A1",
          "word_slugs": [
            "milliers-noun"
          ]
        },
        {
          "id": "911703",
          "text": "Des milliers de gens moururent de faim.",
          "translation": "Тысячи людей умерли от голода.",
          "source": "Tatoeba #911703 @sacredceltic / #2840186 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/911703",
          "cefr_level": "A1",
          "word_slugs": [
            "milliers-noun"
          ]
        },
        {
          "id": "8376064",
          "text": "Des milliers de personnes y ont assisté.",
          "translation": "Там были тысячи людей.",
          "source": "Tatoeba #8376064 @Bafy78 / #6881224 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8376064",
          "cefr_level": "A1",
          "word_slugs": [
            "milliers-noun"
          ]
        },
        {
          "id": "11509281",
          "text": "L'univers compte des milliers d'étoiles.",
          "translation": "Во Вселенной тысячи звёзд.",
          "source": "Tatoeba #11509281 @megamanenm / #12873395 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11509281",
          "cefr_level": "A1",
          "word_slugs": [
            "milliers-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le milliers",
        "plural": "",
        "infinitive": ""
      }
