    {
      "slug": "amener-verb",
      "lemma": "amener",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1636,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8947923",
          "text": "Je vais t'y amener.",
          "translation": "Я тебя туда отведу.",
          "source": "Tatoeba #8947923 @Julien_PDC / #7821052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8947923",
          "cefr_level": "A1",
          "word_slugs": [
            "amener-verb"
          ]
        },
        {
          "id": "11716929",
          "text": "Tu peux amener qui tu veux.",
          "translation": "Можешь привести кого хочешь.",
          "source": "Tatoeba #11716929 @Aiji / #8187208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11716929",
          "cefr_level": "A1",
          "word_slugs": [
            "amener-verb"
          ]
        },
        {
          "id": "5306789",
          "text": "Je veux amener ma famille ici.",
          "translation": "Я хочу привести сюда свою семью.",
          "source": "Tatoeba #5306789 @Aiji / #5314423 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5306789",
          "cefr_level": "A1",
          "word_slugs": [
            "amener-verb"
          ]
        },
        {
          "id": "8329284",
          "text": "Tu dois m'amener à l'hôpital.",
          "translation": "Ты должен отвезти меня в больницу.",
          "source": "Tatoeba #8329284 @Julien_PDC / #8631521 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8329284",
          "cefr_level": "A1",
          "word_slugs": [
            "amener-verb"
          ]
        },
        {
          "id": "3793169",
          "text": "Peux-tu m'y amener en voiture ?",
          "translation": "Можешь меня подвезти?",
          "source": "Tatoeba #3793169 @sacredceltic / #3793338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3793169",
          "cefr_level": "A1",
          "word_slugs": [
            "amener-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "amener",
