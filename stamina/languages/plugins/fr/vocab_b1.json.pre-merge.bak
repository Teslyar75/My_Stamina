          "word_slugs": [
            "blesser-verb"
          ]
        },
        {
          "id": "2080135",
          "text": "Je ne veux blesser personne.",
          "translation": "Я никого не хочу обидеть.",
          "source": "Tatoeba #2080135 @sacredceltic / #3544726 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2080135",
          "cefr_level": "A1",
          "word_slugs": [
            "blesser-verb"
          ]
        },
        {
          "id": "4561834",
          "text": "Elle craignait de le blesser.",
          "translation": "Она боялась его ранить.",
          "source": "Tatoeba #4561834 @sacredceltic / #11851443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4561834",
          "cefr_level": "A1",
          "word_slugs": [
            "blesser-verb"
          ]
        },
        {
          "id": "5674594",
          "text": "Je ne voulais blesser personne.",
          "translation": "Я никого не хотел обидеть.",
          "source": "Tatoeba #5674594 @lbdx / #5644657 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5674594",
          "cefr_level": "A1",
          "word_slugs": [
            "blesser-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
