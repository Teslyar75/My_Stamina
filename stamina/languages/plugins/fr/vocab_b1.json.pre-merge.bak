          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        },
        {
          "id": "10783",
          "text": "Edward est plus jeune que Robert.",
          "translation": "Эдвард младше Роберта.",
          "source": "Tatoeba #10783 @KotobaNiko / #538264 @tirpitz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10783",
          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        },
        {
          "id": "6000375",
          "text": "J'ai entendu que Robert était malade.",
          "translation": "Я слышал, Роберт болен.",
          "source": "Tatoeba #6000375 @PERCE_NEIGE / #6616177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6000375",
          "cefr_level": "A1",
