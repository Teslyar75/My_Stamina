    {
      "slug": "bal-symbol",
      "lemma": "bal",
      "pos": "symbol",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1853,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1244225",
          "text": "Elle était la reine du bal.",
          "translation": "Она была королевой бала.",
          "source": "Tatoeba #1244225 @sacredceltic / #1944362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1244225",
          "cefr_level": "A1",
          "word_slugs": [
            "bal-symbol"
          ]
        },
        {
          "id": "5979763",
          "text": "Elle était en toilette de bal.",
          "translation": "Она была в бальном платье.",
          "source": "Tatoeba #5979763 @Blabla / #14077755 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5979763",
          "cefr_level": "A1",
          "word_slugs": [
            "bal-symbol"
          ]
        },
        {
          "id": "2373416",
          "text": "À cette occasion, il sera donné un bal.",
          "translation": "По этому случаю будет дан бал.",
          "source": "Tatoeba #2373416 @sacredceltic / #12273533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2373416",
          "cefr_level": "A1",
          "word_slugs": [
            "bal-symbol"
          ]
        },
        {
          "id": "1372870",
          "text": "Elle dansa avec lui au bal des étudiants.",
          "translation": "Она танцевала с ним на студенческом балу.",
          "source": "Tatoeba #1372870 @sacredceltic / #8302833 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1372870",
          "cefr_level": "A1",
          "word_slugs": [
            "bal-symbol"
          ]
        },
        {
          "id": "1692638",
          "text": "Tom et Marie participèrent à un bal masqué.",
          "translation": "Том и Мэри приняли участие в костюмированном балу.",
          "source": "Tatoeba #1692638 @Scott / #3537606 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1692638",
          "cefr_level": "A1",
          "word_slugs": [
            "bal-symbol"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
