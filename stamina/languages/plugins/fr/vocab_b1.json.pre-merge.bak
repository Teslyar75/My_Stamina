      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "11584032",
          "text": "Je suis heureux cependant.",
          "translation": "И всё-таки я счастлив.",
          "source": "Tatoeba #11584032 @Rovo / #12374854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11584032",
          "cefr_level": "A1",
