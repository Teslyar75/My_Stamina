          ]
        },
        {
          "id": "11494730",
          "text": "Revenez au bateau !",
          "translation": "Возвращайтесь на корабль!",
          "source": "Tatoeba #11494730 @Rovo / #11494731 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11494730",
          "cefr_level": "A1",
          "word_slugs": [
            "revenez-verb"
          ]
        },
        {
          "id": "12712570",
          "text": "Revenez en arrière.",
          "translation": "Возвращайтесь обратно.",
          "source": "Tatoeba #12712570 @slahatuvelli / #12712590 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12712570",
          "cefr_level": "A1",
          "word_slugs": [
            "revenez-verb"
          ]
        }
      ],
