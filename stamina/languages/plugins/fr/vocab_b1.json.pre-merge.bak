          "также"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3640853",
          "text": "Il ira également.",
          "translation": "Он тоже пойдет.",
          "source": "Tatoeba #3640853 @sacredceltic / #2152243 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3640853",
          "cefr_level": "A1",
