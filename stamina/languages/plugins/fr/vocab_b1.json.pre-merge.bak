      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "12542274",
          "text": "Quelques pièces manquaient.",
          "translation": "Не хватало нескольких деталей.",
          "source": "Tatoeba #12542274 @Rovo / #12542208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12542274",
