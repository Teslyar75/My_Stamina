          "воспользоваться"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13927598",
          "text": "J'aime profiter de la vie.",
          "translation": "Мне нравится наслаждаться жизнью.",
          "source": "Tatoeba #13927598 @zogwarg / #13927613 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13927598",
          "cefr_level": "A1",
          "word_slugs": [
