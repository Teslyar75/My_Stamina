    {
      "slug": "surveillance-noun",
      "lemma": "surveillance",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2023,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "надзор"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "12456690",
          "text": "Tom est sous surveillance.",
          "translation": "Том находится под наблюдением.",
          "source": "Tatoeba #12456690 @zogwarg / #10983849 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12456690",
          "cefr_level": "A1",
          "word_slugs": [
            "surveillance-noun"
          ]
        },
        {
          "id": "6488248",
          "text": "Il est sous surveillance constante.",
          "translation": "Он находится под постоянным наблюдением.",
          "source": "Tatoeba #6488248 @Micsmithel / #6489666 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6488248",
          "cefr_level": "A1",
          "word_slugs": [
            "surveillance-noun"
          ]
        },
        {
          "id": "341719",
          "text": "Sommes-nous tous sous surveillance ?",
          "translation": "Мы все под наблюдением?",
          "source": "Tatoeba #341719 @MUIRIEL / #3197225 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341719",
          "cefr_level": "A1",
          "word_slugs": [
            "surveillance-noun"
          ]
        },
        {
          "id": "12354580",
          "text": "Merci de ne pas laisser vos bagages sans surveillance.",
          "translation": "Не оставляйте, пожалуйста, свой багаж без присмотра.",
          "source": "Tatoeba #12354580 @lbdx / #13237293 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12354580",
          "cefr_level": "A1",
          "word_slugs": [
            "surveillance-noun"
          ]
        },
        {
          "id": "10552035",
          "text": "La police a placé la maison du suspect sous surveillance.",
          "translation": "Полиция поставила дом подозреваемого под наблюдение.",
          "source": "Tatoeba #10552035 @lbdx / #10619024 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10552035",
          "cefr_level": "A1",
          "word_slugs": [
            "surveillance-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
