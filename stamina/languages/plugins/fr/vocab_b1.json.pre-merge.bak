      "translations": {
        "ru": [
          "генри"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2695192",
          "text": "Mon nom est Henry.",
          "translation": "Меня зовут Генри.",
          "source": "Tatoeba #2695192 @Aiji / #1678396 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2695192",
          "cefr_level": "A1",
          "word_slugs": [
            "henry-noun"
          ]
        },
        {
          "id": "962434",
          "text": "Je m'appelle Henry.",
          "translation": "Меня зовут Генри.",
          "source": "Tatoeba #962434 @Adou_Fr / #1678396 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/962434",
          "cefr_level": "A1",
          "word_slugs": [
            "henry-noun"
          ]
        },
        {
          "id": "7204950",
          "text": "Henry veut te voir.",
