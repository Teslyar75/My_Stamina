    {
      "slug": "appels-noun",
      "lemma": "appels",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1981,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5418996",
          "text": "Je passerai quelques appels.",
          "translation": "Я сделаю несколько звонков.",
          "source": "Tatoeba #5418996 @Aiji / #4909358 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5418996",
          "cefr_level": "A1",
          "word_slugs": [
            "appels-noun"
          ]
        },
        {
          "id": "11274436",
          "text": "Vous avez trois appels manqués.",
          "translation": "У вас три пропущенных вызова.",
          "source": "Tatoeba #11274436 @lbdx / #7863304 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11274436",
          "cefr_level": "A1",
          "word_slugs": [
            "appels-noun"
          ]
        },
        {
          "id": "3414103",
          "text": "Il me faut passer quelques appels.",
          "translation": "Мне надо сделать несколько звонков.",
          "source": "Tatoeba #3414103 @sacredceltic / #3066580 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3414103",
          "cefr_level": "A1",
          "word_slugs": [
            "appels-noun"
          ]
        },
        {
          "id": "12037126",
          "text": "Je reçois des appels tous les jours.",
          "translation": "Мне каждый день звонят.",
          "source": "Tatoeba #12037126 @lbdx / #10016497 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12037126",
          "cefr_level": "A1",
          "word_slugs": [
            "appels-noun"
          ]
        },
        {
          "id": "749997",
          "text": "Je travaille dans un centre d'appels.",
          "translation": "Я работаю в колл-центре.",
          "source": "Tatoeba #749997 @Aiji / #5655519 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/749997",
          "cefr_level": "A1",
          "word_slugs": [
            "appels-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
