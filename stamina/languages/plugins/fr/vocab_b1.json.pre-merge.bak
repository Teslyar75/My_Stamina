    {
      "slug": "faudrait-verb",
      "lemma": "faudrait",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1475,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "9163556",
          "text": "Il faudrait y aller.",
          "translation": "Надо бы туда сходить.",
          "source": "Tatoeba #9163556 @Julien_PDC / #9163576 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9163556",
          "cefr_level": "A1",
          "word_slugs": [
            "faudrait-verb"
          ]
        },
        {
          "id": "3693572",
          "text": "Il faudrait te raser.",
          "translation": "Тебе надо побриться.",
          "source": "Tatoeba #3693572 @Elliv / #3688339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3693572",
          "cefr_level": "A1",
          "word_slugs": [
