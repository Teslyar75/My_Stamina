    {
      "slug": "nuits-noun",
      "lemma": "nuits",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2469,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "11766860",
          "text": "Les nuits sont belles.",
          "translation": "Ночи прекрасны.",
          "source": "Tatoeba #11766860 @Fenrir / #11767090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11766860",
          "cefr_level": "A1",
          "word_slugs": [
            "nuits-noun"
          ]
        },
        {
          "id": "445353",
          "text": "Pour combien de nuits ?",
          "translation": "На сколько ночей?",
          "source": "Tatoeba #445353 @gamma / #13088581 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/445353",
          "cefr_level": "A1",
          "word_slugs": [
            "nuits-noun"
          ]
        },
        {
          "id": "2140619",
          "text": "Je resterai deux nuits.",
          "translation": "Я останусь на две ночи.",
          "source": "Tatoeba #2140619 @Dreamk33 / #5533739 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2140619",
          "cefr_level": "A1",
          "word_slugs": [
            "nuits-noun"
          ]
        },
        {
          "id": "11766961",
          "text": "Les nuits sont longues.",
          "translation": "Ночи длинные.",
          "source": "Tatoeba #11766961 @Fenrir / #11767077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11766961",
          "cefr_level": "A1",
          "word_slugs": [
            "nuits-noun"
          ]
        },
        {
          "id": "12170546",
          "text": "Il ronfle toutes les nuits.",
          "translation": "Он каждую ночь храпит.",
          "source": "Tatoeba #12170546 @megamanenm / #10073222 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12170546",
          "cefr_level": "A1",
          "word_slugs": [
            "nuits-noun"
          ]
        }
