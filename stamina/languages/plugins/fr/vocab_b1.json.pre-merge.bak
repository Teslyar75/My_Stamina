          "cefr_level": "A1",
          "word_slugs": [
            "pouvoirs-noun"
          ]
        },
        {
          "id": "9502498",
          "text": "Quels sont les pouvoirs du juge ?",
          "translation": "Каковы полномочия судьи?",
          "source": "Tatoeba #9502498 @Julien_PDC / #11697447 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9502498",
          "cefr_level": "A1",
          "word_slugs": [
            "pouvoirs-noun"
          ]
        },
        {
          "id": "9130797",
          "text": "Il délègue une partie de ses pouvoirs.",
          "translation": "Он делегирует часть своих полномочий.",
          "source": "Tatoeba #9130797 @Julien_PDC / #11694614 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9130797",
          "cefr_level": "A1",
          "word_slugs": [
            "pouvoirs-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
