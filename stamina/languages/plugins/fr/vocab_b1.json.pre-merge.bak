          "source": "Tatoeba #3148687 @nimfeo / #5391687 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3148687",
          "cefr_level": "A1",
          "word_slugs": [
            "privée-verb"
          ]
        },
        {
          "id": "13388618",
          "text": "Je tiens à ma vie privée.",
          "translation": "Я дорожу своей частной жизнью.",
          "source": "Tatoeba #13388618 @lbdx / #13389362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13388618",
          "cefr_level": "A1",
          "word_slugs": [
            "privée-verb"
          ]
        },
        {
          "id": "1079025",
          "text": "J'étudie dans une école privée.",
          "translation": "Я учусь в частной школе.",
          "source": "Tatoeba #1079025 @alexmarcelo / #13642429 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1079025",
          "cefr_level": "A1",
          "word_slugs": [
            "privée-verb"
          ]
        },
        {
          "id": "1104076",
          "text": "Sa vie privée intéresse la presse.",
          "translation": "Его личная жизнь интересует прессу.",
          "source": "Tatoeba #1104076 @sacredceltic / #3213704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1104076",
          "cefr_level": "A1",
          "word_slugs": [
            "privée-verb"
          ]
        }
      ],
