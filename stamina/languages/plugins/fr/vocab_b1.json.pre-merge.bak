      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10473626",
          "text": "Puisque vous le dites...",
          "translation": "Раз вы так говорите...",
          "source": "Tatoeba #10473626 @Adelpa / #10474431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10473626",
          "cefr_level": "A1",
          "word_slugs": [
            "puisque-conj"
          ]
        },
        {
          "id": "4581077",
          "text": "Pourquoi vivre puisque nous allons mourir ?",
          "translation": "Зачем жить, если мы умрём?",
          "source": "Tatoeba #4581077 @franlexcois / #11949684 @scriptin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4581077",
          "cefr_level": "A1",
          "word_slugs": [
            "puisque-conj"
          ]
        },
        {
          "id": "11072490",
          "text": "Puisque tu le souhaites, je le ferai.",
          "translation": "Раз уж ты так хочешь, сделаю.",
          "source": "Tatoeba #11072490 @carlosalberto / #11248111 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11072490",
          "cefr_level": "A1",
          "word_slugs": [
            "puisque-conj"
          ]
        },
        {
          "id": "11072478",
          "text": "Puisque vous le souhaitez, je le ferai.",
          "translation": "Раз уж вы так хотите, сделаю.",
          "source": "Tatoeba #11072478 @carlosalberto / #11248112 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11072478",
          "cefr_level": "A1",
          "word_slugs": [
            "puisque-conj"
          ]
        },
        {
          "id": "607577",
          "text": "Puisque tu es ici, tu peux m'aider.",
          "translation": "Раз уж ты здесь - можешь мне помочь.",
          "source": "Tatoeba #607577 @qdii / #1460156 @MikaM (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/607577",
          "cefr_level": "A1",
          "word_slugs": [
            "puisque-conj"
          ]
        }
      ],
