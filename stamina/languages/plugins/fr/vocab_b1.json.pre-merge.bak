    {
      "slug": "attraper-verb",
      "lemma": "attraper",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1591,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13345104",
          "text": "Elle va t'attraper.",
          "translation": "Она тебя поймает.",
          "source": "Tatoeba #13345104 @genes1s / #13423814 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13345104",
          "cefr_level": "A1",
          "word_slugs": [
            "attraper-verb"
          ]
        },
        {
          "id": "12746946",
          "text": "Peux-tu l'attraper ?",
          "translation": "Ты можешь его поймать?",
          "source": "Tatoeba #12746946 @LdjuherTaqvaylit / #6290662 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12746946",
          "cefr_level": "A1",
          "word_slugs": [
            "attraper-verb"
          ]
        },
        {
          "id": "11582455",
          "text": "Essaie de m'attraper.",
          "translation": "Попробуй меня поймать.",
          "source": "Tatoeba #11582455 @Aiji / #3519433 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11582455",
          "cefr_level": "A1",
          "word_slugs": [
            "attraper-verb"
          ]
        },
        {
          "id": "11980749",
          "text": "Tu vas attraper froid.",
          "translation": "Ты простудишься.",
          "source": "Tatoeba #11980749 @Fenrir / #655728 @Sanida (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11980749",
          "cefr_level": "A1",
          "word_slugs": [
            "attraper-verb"
          ]
        },
        {
          "id": "2388407",
          "text": "Ils se faisaient attraper.",
          "translation": "Они попадались.",
          "source": "Tatoeba #2388407 @Amastan / #2760742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2388407",
          "cefr_level": "A1",
          "word_slugs": [
            "attraper-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
