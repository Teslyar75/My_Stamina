          ]
        },
        {
          "id": "9934961",
          "text": "Viens-tu d'Europe ?",
          "translation": "Ты из Европы?",
          "source": "Tatoeba #9934961 @codl / #6027686 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9934961",
