      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1201885",
          "text": "Le feras-tu ?",
          "translation": "Ты это сделаешь?",
          "source": "Tatoeba #1201885 @sacredceltic / #3060311 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1201885",
          "cefr_level": "A1",
          "word_slugs": [
            "feras-verb"
          ]
        },
        {
          "id": "540826",
          "text": "Que feras-tu ?",
          "translation": "Что ты будешь делать?",
          "source": "Tatoeba #540826 @sacredceltic / #1411470 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/540826",
          "cefr_level": "A1",
          "word_slugs": [
            "feras-verb"
          ]
        },
        {
          "id": "8851622",
          "text": "Quel choix feras-tu ?",
