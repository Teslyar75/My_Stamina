          ]
        },
        {
          "id": "1301683",
          "text": "Ils craignent les dieux.",
          "translation": "Они боятся богов.",
          "source": "Tatoeba #1301683 @sacredceltic / #3887884 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1301683",
          "cefr_level": "A1",
          "word_slugs": [
            "dieux-noun"
          ]
        },
        {
          "id": "8823990",
          "text": "Les dieux sont satisfaits.",
          "translation": "Боги довольны.",
          "source": "Tatoeba #8823990 @Aiji / #8824123 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8823990",
          "cefr_level": "A1",
          "word_slugs": [
            "dieux-noun"
          ]
        }
      ],
