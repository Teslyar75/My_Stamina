    {
      "slug": "lieux-noun",
      "lemma": "lieux",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2269,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10603630",
          "text": "J'inspecte les lieux.",
          "translation": "Я обследую место преступления.",
          "source": "Tatoeba #10603630 @Igider / #10760602 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10603630",
          "cefr_level": "A1",
          "word_slugs": [
            "lieux-noun"
          ]
        },
        {
          "id": "9002685",
          "text": "Est-ce que tu connais ces lieux ?",
          "translation": "Ты знаешь эти места?",
          "source": "Tatoeba #9002685 @carlosalberto / #9002692 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9002685",
          "cefr_level": "A1",
          "word_slugs": [
            "lieux-noun"
          ]
        },
        {
          "id": "526864",
          "text": "Quels sont les lieux qui vous plaisent ?",
          "translation": "Какие места вам нравятся?",
          "source": "Tatoeba #526864 @sacredceltic / #9002353 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/526864",
          "cefr_level": "A1",
          "word_slugs": [
            "lieux-noun"
          ]
        },
        {
          "id": "7696300",
          "text": "Interdiction de fumer dans les lieux publics.",
          "translation": "В общественных местах курить запрещено.",
          "source": "Tatoeba #7696300 @Maxence / #8019238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7696300",
          "cefr_level": "A1",
          "word_slugs": [
            "lieux-noun"
          ]
        },
        {
          "id": "3388160",
          "text": "Deux autres policiers arrivèrent sur les lieux.",
          "translation": "На место происшествия прибыли ещё двое полицейских.",
          "source": "Tatoeba #3388160 @Ginette / #13268932 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3388160",
          "cefr_level": "A1",
          "word_slugs": [
            "lieux-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le lieux",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "los-noun",
      "lemma": "Los",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2270,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "n",
      "examples": [
        {
          "id": "10372862",
          "text": "Comment était Los Angeles ?",
          "translation": "Как Лос-Анджелес?",
          "source": "Tatoeba #10372862 @Adelpa / #10336546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10372862",
          "cefr_level": "A1",
          "word_slugs": [
            "los-noun"
          ]
        },
        {
          "id": "11027123",
          "text": "Il a grandi à Los Angeles.",
          "translation": "Он вырос в Лос-Анджелесе.",
          "source": "Tatoeba #11027123 @lbdx / #11027128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11027123",
          "cefr_level": "A1",
          "word_slugs": [
            "los-noun"
          ]
        },
        {
          "id": "356186",
          "text": "J'ai une tante qui vit à Los Angeles.",
          "translation": "У меня тётя живёт в Лос-Анджелесе.",
          "source": "Tatoeba #356186 @yorickvidal / #5204043 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/356186",
          "cefr_level": "A1",
          "word_slugs": [
            "los-noun"
          ]
        },
        {
          "id": "2044158",
          "text": "Je pensais que vous aviez grandi à Los Angeles.",
          "translation": "Я думал, вы выросли в Лос-Анджелесе.",
          "source": "Tatoeba #2044158 @jcgillet / #12782993 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2044158",
          "cefr_level": "A1",
          "word_slugs": [
            "los-noun"
          ]
        },
        {
          "id": "8470369",
          "text": "Los Angeles est un des endroits que je souhaite visiter.",
          "translation": "Лос-Анджелес - одно из мест, которое я хочу посетить.",
          "source": "Tatoeba #8470369 @Aiji / #8575278 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8470369",
          "cefr_level": "A1",
          "word_slugs": [
            "los-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "n",
