          "word_slugs": [
            "pilote-noun"
          ]
        },
        {
          "id": "6592687",
          "text": "Tom est notre meilleur pilote.",
          "translation": "Том - наш лучший лётчик.",
          "source": "Tatoeba #6592687 @GB3 / #6592697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6592687",
          "cefr_level": "A1",
          "word_slugs": [
            "pilote-noun"
          ]
        },
        {
          "id": "441791",
          "text": "Il a décidé de devenir pilote.",
          "translation": "Он решил стать лётчиком.",
          "source": "Tatoeba #441791 @jerom / #13795063 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/441791",
          "cefr_level": "A1",
