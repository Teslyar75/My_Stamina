    {
      "slug": "paquet-noun",
      "lemma": "paquet",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2038,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6941597",
          "text": "Ouvre le paquet.",
          "translation": "Вскрой пакет.",
          "source": "Tatoeba #6941597 @Aiji / #6948264 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6941597",
          "cefr_level": "A1",
          "word_slugs": [
            "paquet-noun"
          ]
        },
        {
          "id": "6941598",
          "text": "Ouvrez le paquet.",
          "translation": "Вскройте пакет.",
          "source": "Tatoeba #6941598 @Aiji / #2780767 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6941598",
          "cefr_level": "A1",
          "word_slugs": [
            "paquet-noun"
          ]
        },
        {
          "id": "8312913",
          "text": "Le paquet semble déchiré.",
          "translation": "Пакет, похоже, порван.",
          "source": "Tatoeba #8312913 @Julien_PDC / #8313104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8312913",
          "cefr_level": "A1",
          "word_slugs": [
            "paquet-noun"
          ]
        },
        {
          "id": "9983329",
          "text": "Ce paquet contient 9 mouchoirs.",
          "translation": "В этой пачке девять платочков.",
          "source": "Tatoeba #9983329 @Julien_PDC / #11998187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9983329",
          "cefr_level": "A1",
          "word_slugs": [
            "paquet-noun"
          ]
        },
        {
          "id": "3211556",
          "text": "Elle a reçu un paquet.",
          "translation": "Она получила посылку.",
          "source": "Tatoeba #3211556 @sacredceltic / #7969742 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3211556",
          "cefr_level": "A1",
          "word_slugs": [
            "paquet-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
