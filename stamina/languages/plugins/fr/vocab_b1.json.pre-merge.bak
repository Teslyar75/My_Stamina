            "paraît-verb"
          ]
        },
        {
          "id": "12785261",
          "text": "Ça paraît simple.",
          "translation": "Кажется, что это просто.",
          "source": "Tatoeba #12785261 @Rovo / #8029601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12785261",
          "cefr_level": "A1",
          "word_slugs": [
