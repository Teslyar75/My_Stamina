          "cefr_level": "A1",
          "word_slugs": [
            "puissance-noun"
          ]
        },
        {
          "id": "12816349",
          "text": "La Russie est une puissance nucléaire.",
          "translation": "Россия - ядерная держава.",
          "source": "Tatoeba #12816349 @Adelpa / #12818869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12816349",
          "cefr_level": "A1",
          "word_slugs": [
            "puissance-noun"
          ]
        },
        {
          "id": "10780563",
          "text": "La Russie est une grande puissance navale.",
          "translation": "Россия – великая морская держава.",
          "source": "Tatoeba #10780563 @lbdx / #4020470 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10780563",
          "cefr_level": "A1",
          "word_slugs": [
            "puissance-noun"
          ]
        }
