      "examples": [
        {
          "id": "10565042",
          "text": "Comment auraient-ils su ?",
          "translation": "Откуда они могли знать?",
          "source": "Tatoeba #10565042 @felix63 / #10565039 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10565042",
