          ]
        },
        {
          "id": "12692838",
          "text": "Il manque plusieurs pièces.",
          "translation": "Не хватает нескольких монет.",
          "source": "Tatoeba #12692838 @Igider / #12693571 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12692838",
          "cefr_level": "A1",
