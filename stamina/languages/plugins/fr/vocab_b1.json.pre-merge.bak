      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5273722",
          "text": "Il parlait fort.",
          "translation": "Он громко разговаривал.",
          "source": "Tatoeba #5273722 @martin9 / #10293887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5273722",
          "cefr_level": "A1",
