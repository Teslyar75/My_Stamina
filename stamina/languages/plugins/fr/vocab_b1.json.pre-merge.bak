      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13275440",
          "text": "Le lendemain est incertain.",
          "translation": "Будущее туманно.",
          "source": "Tatoeba #13275440 @LdjuherTaqvaylit / #9869521 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13275440",
          "cefr_level": "A1",
          "word_slugs": [
            "lendemain-noun"
          ]
        },
        {
          "id": "13057188",
          "text": "Son lendemain est incertain.",
          "translation": "Его будущее неопределённо.",
          "source": "Tatoeba #13057188 @LdjuherTaqvaylit / #13092778 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13057188",
          "cefr_level": "A1",
          "word_slugs": [
            "lendemain-noun"
          ]
        },
        {
          "id": "2514731",
          "text": "Il est parti le lendemain.",
          "translation": "Он уехал на следующий день.",
          "source": "Tatoeba #2514731 @Anthaus / #2729536 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2514731",
          "cefr_level": "A1",
          "word_slugs": [
            "lendemain-noun"
          ]
        },
        {
          "id": "8727611",
          "text": "Je suis revenu le lendemain.",
          "translation": "Я вернулся на следующий день.",
          "source": "Tatoeba #8727611 @Julien_PDC / #8727973 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8727611",
          "cefr_level": "A1",
          "word_slugs": [
            "lendemain-noun"
          ]
        },
        {
          "id": "13681280",
          "text": "Le lendemain, il a regretté.",
          "translation": "На следующий день он пожалел об этом.",
          "source": "Tatoeba #13681280 @Rafik / #13681284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13681280",
          "cefr_level": "A1",
          "word_slugs": [
            "lendemain-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
