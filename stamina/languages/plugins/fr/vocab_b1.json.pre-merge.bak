          "cefr_level": "A1",
          "word_slugs": [
            "inquiétez-verb"
          ]
        },
        {
          "id": "7771163",
          "text": "Vous vous inquiétez de tout.",
          "translation": "Вы из-за всего беспокоитесь.",
          "source": "Tatoeba #7771163 @Aiji / #8058720 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7771163",
          "cefr_level": "A1",
          "word_slugs": [
            "inquiétez-verb"
          ]
        },
        {
          "id": "903060",
          "text": "Ne vous inquiétez pas pour ça.",
          "translation": "Об этом не беспокойтесь.",
          "source": "Tatoeba #903060 @dominiko / #2580428 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/903060",
          "cefr_level": "A1",
          "word_slugs": [
