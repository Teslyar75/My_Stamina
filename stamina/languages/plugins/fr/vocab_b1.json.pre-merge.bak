    {
      "slug": "traverser-verb",
      "lemma": "traverser",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2355,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "пересекать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5589084",
          "text": "Tom va traverser la rivière.",
          "translation": "Том будет переправляться через реку.",
          "source": "Tatoeba #5589084 @Aiji / #6374783 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589084",
          "cefr_level": "A1",
          "word_slugs": [
            "traverser-verb"
          ]
        },
        {
          "id": "1818470",
          "text": "Traverser ce désert est dangereux.",
          "translation": "Переход через эту пустыню опасен.",
          "source": "Tatoeba #1818470 @sacredceltic / #2587863 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1818470",
          "cefr_level": "A1",
          "word_slugs": [
            "traverser-verb"
          ]
        },
        {
          "id": "13699188",
          "text": "Nous souhaitons traverser le pont.",
          "translation": "Мы хотим перейти через мост.",
          "source": "Tatoeba #13699188 @Aghanim / #14101156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13699188",
          "cefr_level": "A1",
          "word_slugs": [
            "traverser-verb"
          ]
        },
        {
          "id": "8643636",
          "text": "Nous devons traverser la frontière.",
          "translation": "Мы должны перейти границу.",
          "source": "Tatoeba #8643636 @Julien_PDC / #8644103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8643636",
          "cefr_level": "A1",
          "word_slugs": [
            "traverser-verb"
          ]
        },
        {
          "id": "14106039",
          "text": "Je crains de traverser la rivière.",
          "translation": "Я боюсь переправляться через реку.",
          "source": "Tatoeba #14106039 @Aghanim / #14114556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14106039",
          "cefr_level": "A1",
          "word_slugs": [
            "traverser-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "traverser",
        "plural": "",
        "infinitive": "traverser"
      }
