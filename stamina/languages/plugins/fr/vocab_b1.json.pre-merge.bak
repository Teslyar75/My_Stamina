      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "716558",
          "text": "Ne vous inquiétez pas.",
          "translation": "Не беспокойтесь.",
          "source": "Tatoeba #716558 @qdii / #790856 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/716558",
          "cefr_level": "A1",
          "word_slugs": [
            "inquiétez-verb"
          ]
        },
        {
          "id": "1473758",
          "text": "Ne vous inquiétez pas !",
          "translation": "Не беспокойтесь.",
          "source": "Tatoeba #1473758 @Rovo / #790856 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1473758",
          "cefr_level": "A1",
          "word_slugs": [
            "inquiétez-verb"
          ]
        },
        {
          "id": "2319630",
          "text": "Vous vous inquiétez trop.",
          "translation": "Вы слишком много переживаете.",
