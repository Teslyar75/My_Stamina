          "source": "Tatoeba #8049559 @Rockaround / #3966512 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8049559",
          "cefr_level": "A1",
          "word_slugs": [
            "pensent-verb"
          ]
        },
        {
          "id": "12688950",
          "text": "Elles pensent à eux.",
          "translation": "Они думают о них.",
          "source": "Tatoeba #12688950 @LdjuherTaqvaylit / #12688980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12688950",
          "cefr_level": "A1",
          "word_slugs": [
            "pensent-verb"
          ]
        },
        {
          "id": "11257237",
          "text": "À quoi pensent-elles ?",
          "translation": "О чём они думают?",
          "source": "Tatoeba #11257237 @madjidoumnia / #12702645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11257237",
          "cefr_level": "A1",
          "word_slugs": [
            "pensent-verb"
          ]
        },
        {
          "id": "13428391",
          "text": "Ils pensent tout savoir.",
          "translation": "Они думают, что всё знают.",
          "source": "Tatoeba #13428391 @LdjuherTaqvaylit / #8919435 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13428391",
          "cefr_level": "A1",
          "word_slugs": [
            "pensent-verb"
          ]
        },
        {
          "id": "961167",
          "text": "La plupart pensent ainsi.",
          "translation": "Так думает большинство.",
          "source": "Tatoeba #961167 @sacredceltic / #5901997 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/961167",
          "cefr_level": "A1",
          "word_slugs": [
            "pensent-verb"
          ]
        }
      ],
