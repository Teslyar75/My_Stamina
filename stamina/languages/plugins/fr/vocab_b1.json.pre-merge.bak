          "source": "Tatoeba #1590006 @Petrus / #4476614 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1590006",
          "cefr_level": "A1",
          "word_slugs": [
            "km-noun"
          ]
        },
        {
          "id": "1082273",
          "text": "J'habite à 10 km de la mer.",
          "translation": "Я живу в десяти километрах от моря.",
          "source": "Tatoeba #1082273 @Aiji / #4975564 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1082273",
          "cefr_level": "A1",
          "word_slugs": [
            "km-noun"
          ]
        },
        {
          "id": "8315183",
          "text": "La vitesse est limitée à 50km/h.",
          "translation": "Ограничение скорости - 50 км/ч.",
          "source": "Tatoeba #8315183 @Julien_PDC / #8342670 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8315183",
          "cefr_level": "A1",
          "word_slugs": [
            "km-noun"
          ]
        },
        {
          "id": "5127693",
          "text": "Les deux pays partagent 500 km de frontière.",
          "translation": "У двух стран пятьсот километров общей границы.",
          "source": "Tatoeba #5127693 @Pino / #5134208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5127693",
          "cefr_level": "A1",
          "word_slugs": [
            "km-noun"
          ]
        },
        {
          "id": "5724352",
          "text": "Tom habite à 16 km de la frontière canadienne.",
          "translation": "Том живёт в шестнадцати километрах от канадской границы.",
          "source": "Tatoeba #5724352 @Aiji / #3554919 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5724352",
          "cefr_level": "A1",
          "word_slugs": [
            "km-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
