      "frequency_rank": 2064,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5185372",
          "text": "Nous avons un mandat de perquisition.",
          "translation": "У нас есть ордер на обыск.",
          "source": "Tatoeba #5185372 @Amastan / #3501933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5185372",
          "cefr_level": "A1",
          "word_slugs": [
            "mandat-noun"
          ]
        },
        {
          "id": "2320537",
          "text": "Le mandat du président dure cinq ans.",
          "translation": "Президентский мандат длится пять лет.",
          "source": "Tatoeba #2320537 @Rovo / #11682861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2320537",
          "cefr_level": "A1",
          "word_slugs": [
            "mandat-noun"
          ]
        },
        {
          "id": "5185371",
          "text": "Nous avons obtenu un mandat de perquisition.",
