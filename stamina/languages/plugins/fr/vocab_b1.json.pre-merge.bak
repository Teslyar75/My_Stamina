    {
      "slug": "washington-name",
      "lemma": "Washington",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1768,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "181123",
          "text": "George Washington est né en 1732.",
          "translation": "Джордж Вашингтон родился в 1732 году.",
          "source": "Tatoeba #181123 @Romira / #3066697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/181123",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        },
        {
          "id": "7110086",
          "text": "Lincoln est retourné à Washington.",
          "translation": "Линкольн вернулся в Вашингтон.",
          "source": "Tatoeba #7110086 @Micsmithel / #5137846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7110086",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        },
        {
          "id": "12466350",
          "text": "Il vous a cherché à Washington.",
          "translation": "Он искал Вас в Вашингтоне.",
          "source": "Tatoeba #12466350 @LdjuherTaqvaylit / #12938472 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12466350",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        },
        {
          "id": "2950047",
          "text": "Je suis chez mon ami à Washington.",
          "translation": "Я у своего друга в Вашингтоне.",
          "source": "Tatoeba #2950047 @Wakano / #5013949 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2950047",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        },
        {
          "id": "435548",
          "text": "La capitale des États-Unis est Washington.",
          "translation": "Столица Соединённых Штатов - Вашингтон.",
          "source": "Tatoeba #435548 @jerom / #652749 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/435548",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le Washington",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "champ-noun",
      "lemma": "champ",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1769,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11069212",
          "text": "C'est notre champ.",
          "translation": "Это наше поле.",
          "source": "Tatoeba #11069212 @Igider / #12579691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11069212",
          "cefr_level": "A1",
          "word_slugs": [
            "champ-noun"
          ]
        },
        {
          "id": "8638107",
          "text": "Il cultive son champ.",
          "translation": "Он возделывает своё поле.",
          "source": "Tatoeba #8638107 @Julien_PDC / #11450989 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8638107",
          "cefr_level": "A1",
          "word_slugs": [
            "champ-noun"
          ]
        },
        {
          "id": "12005598",
          "text": "Le champ a pris feu.",
          "translation": "Поле загорелось.",
          "source": "Tatoeba #12005598 @Igider / #12006095 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12005598",
          "cefr_level": "A1",
          "word_slugs": [
            "champ-noun"
          ]
        },
        {
          "id": "12550249",
          "text": "Tu as traversé le champ.",
          "translation": "Ты перешёл поле.",
          "source": "Tatoeba #12550249 @slahatuvelli / #14081391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12550249",
          "cefr_level": "A1",
          "word_slugs": [
            "champ-noun"
          ]
        },
        {
          "id": "2382242",
          "text": "Le champ est-il fertile ?",
          "translation": "Поле плодородно?",
          "source": "Tatoeba #2382242 @sacredceltic / #12362818 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2382242",
          "cefr_level": "A1",
          "word_slugs": [
            "champ-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
