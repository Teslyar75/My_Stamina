          ]
        },
        {
          "id": "13357591",
          "text": "Que feras-tu demain ?",
          "translation": "Что ты будешь делать завтра?",
          "source": "Tatoeba #13357591 @madjidoumnia / #5897477 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13357591",
          "cefr_level": "A1",
          "word_slugs": [
            "feras-verb"
          ]
        },
        {
          "id": "2073699",
          "text": "Tu feras la vaisselle.",
          "translation": "Ты помоешь посуду.",
          "source": "Tatoeba #2073699 @Amastan / #2738028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2073699",
          "cefr_level": "A1",
          "word_slugs": [
            "feras-verb"
          ]
        }
      ],
      "tags": [
