      },
      "gender": null,
      "examples": [
        {
          "id": "11280371",
          "text": "Ils nagent facilement.",
          "translation": "Они легко плавают.",
          "source": "Tatoeba #11280371 @carlosalberto / #11280390 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11280371",
          "cefr_level": "A1",
