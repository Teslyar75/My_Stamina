            "atteindre-verb"
          ]
        },
        {
          "id": "12886629",
          "text": "Je veux atteindre les nuages.",
          "translation": "Я хочу достать до облаков.",
          "source": "Tatoeba #12886629 @Aghanim / #12886727 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12886629",
          "cefr_level": "A1",
          "word_slugs": [
            "atteindre-verb"
          ]
        }
