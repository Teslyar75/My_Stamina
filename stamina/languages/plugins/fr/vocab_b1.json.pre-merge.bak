          "word_slugs": [
            "réseau-noun"
          ]
        },
        {
          "id": "13376122",
          "text": "Il n'y a pas de réseau ici.",
          "translation": "Здесь нет сети.",
          "source": "Tatoeba #13376122 @lbdx / #13382841 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13376122",
          "cefr_level": "A1",
          "word_slugs": [
            "réseau-noun"
          ]
        },
        {
          "id": "13961092",
          "text": "Les caméras surveillent certaines zones du réseau routier.",
          "translation": "Камеры следят за определёнными участками дорожной сети.",
          "source": "Tatoeba #13961092 @Naityahia / #13961547 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13961092",
          "cefr_level": "A1",
          "word_slugs": [
            "réseau-noun"
          ]
        }
