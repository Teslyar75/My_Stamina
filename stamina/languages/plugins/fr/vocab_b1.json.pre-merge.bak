    {
      "slug": "seraient-verb",
      "lemma": "seraient",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2371,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7644965",
          "text": "Ne seraient-ils pas heureux ?",
          "translation": "Разве они не были бы счастливы?",
          "source": "Tatoeba #7644965 @Vykan / #11770394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7644965",
          "cefr_level": "A1",
          "word_slugs": [
            "seraient-verb"
          ]
        },
        {
          "id": "10137006",
          "text": "Il promit aux esclaves qu'ils seraient libérés.",
          "translation": "Он пообещал рабам, что их освободят.",
          "source": "Tatoeba #10137006 @Aiji / #10160365 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10137006",
          "cefr_level": "A1",
          "word_slugs": [
            "seraient-verb"
          ]
        },
        {
          "id": "3630500",
          "text": "Beaucoup croient que les baleines seraient des poissons.",
          "translation": "Многие считают, что киты — это рыбы.",
          "source": "Tatoeba #3630500 @sacredceltic / #10196221 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3630500",
          "cefr_level": "A1",
          "word_slugs": [
            "seraient-verb"
          ]
        },
        {
          "id": "13314258",
          "text": "Ils ont promis qu'ils seraient à l'heure.",
          "translation": "Они пообещали, что будут вовремя.",
          "source": "Tatoeba #13314258 @saillier / #13314295 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13314258",
          "cefr_level": "A1",
          "word_slugs": [
            "seraient-verb"
          ]
        },
        {
          "id": "7459567",
          "text": "Ils m'ont dit qu'ils seraient occupés lundi.",
          "translation": "Они сказали мне, что в понедельник будут заняты.",
          "source": "Tatoeba #7459567 @Micsmithel / #7460263 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7459567",
          "cefr_level": "A1",
          "word_slugs": [
            "seraient-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "seraient",
        "plural": "",
        "infinitive": "seraient"
      }
    },
    {
      "slug": "bébés-noun",
      "lemma": "bébés",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2372,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6978527",
          "text": "Les bébés crient.",
          "translation": "Дети кричат.",
          "source": "Tatoeba #6978527 @Rockaround / #4509797 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6978527",
          "cefr_level": "A1",
          "word_slugs": [
            "bébés-noun"
          ]
        },
        {
          "id": "6060721",
          "text": "Tous les bébés pleurent.",
          "translation": "Все младенцы плачут.",
          "source": "Tatoeba #6060721 @sicerabibax / #6293621 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6060721",
          "cefr_level": "A1",
          "word_slugs": [
            "bébés-noun"
          ]
        },
        {
          "id": "835059",
          "text": "Les bébés tombent souvent.",
          "translation": "Малыши часто падают.",
          "source": "Tatoeba #835059 @sacredceltic / #10547926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/835059",
          "cefr_level": "A1",
          "word_slugs": [
            "bébés-noun"
          ]
        },
        {
          "id": "12342138",
          "text": "Elles allaitent leurs bébés.",
          "translation": "Они кормят грудью своих детей.",
          "source": "Tatoeba #12342138 @lbdx / #12342259 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12342138",
          "cefr_level": "A1",
          "word_slugs": [
            "bébés-noun"
          ]
        },
        {
          "id": "13055496",
          "text": "D'où viennent les bébés ?",
          "translation": "Откуда берутся дети?",
          "source": "Tatoeba #13055496 @menaud / #3536874 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13055496",
          "cefr_level": "A1",
          "word_slugs": [
            "bébés-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le bébés",
        "plural": "",
        "infinitive": ""
      }
    },
