      "examples": [
        {
          "id": "4775682",
          "text": "Nous sommes certaines.",
          "translation": "Мы уверены.",
          "source": "Tatoeba #4775682 @sacredceltic / #4775955 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4775682",
          "cefr_level": "A1",
