      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "11339769",
          "text": "Tu laisses un commentaire.",
          "translation": "Ты оставляешь комментарий.",
          "source": "Tatoeba #11339769 @LdjuherTaqvaylit / #11358164 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11339769",
          "cefr_level": "A1",
          "word_slugs": [
            "laisses-noun"
          ]
        },
        {
          "id": "1650759",
          "text": "Tu ne me laisses aucun choix.",
          "translation": "Ты не оставляешь мне выбора.",
          "source": "Tatoeba #1650759 @sacredceltic / #2493433 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1650759",
          "cefr_level": "A1",
          "word_slugs": [
            "laisses-noun"
          ]
        },
        {
          "id": "5741756",
          "text": "Te laisses-tu pousser la barbe ?",
