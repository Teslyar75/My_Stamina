    {
      "slug": "soient-verb",
      "lemma": "soient",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1368,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7981887",
          "text": "Je veux qu'ils soient amis.",
          "translation": "Я хочу, чтобы они были друзьями.",
          "source": "Tatoeba #7981887 @Aiji / #14055041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7981887",
          "cefr_level": "A1",
          "word_slugs": [
            "soient-verb"
          ]
        },
        {
          "id": "7981888",
          "text": "Je veux qu'elles soient amies.",
          "translation": "Я хочу, чтобы они были подругами.",
          "source": "Tatoeba #7981888 @Aiji / #14055042 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7981888",
          "cefr_level": "A1",
          "word_slugs": [
            "soient-verb"
          ]
        },
        {
          "id": "4924964",
          "text": "Il faut qu'elles soient libres.",
          "translation": "Надо, чтобы они были свободны.",
          "source": "Tatoeba #4924964 @Asorel / #4925020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4924964",
          "cefr_level": "A1",
          "word_slugs": [
            "soient-verb"
          ]
        },
        {
          "id": "12201150",
          "text": "Il faut qu'ils soient patients.",
          "translation": "Надо, чтобы они были терпеливы.",
