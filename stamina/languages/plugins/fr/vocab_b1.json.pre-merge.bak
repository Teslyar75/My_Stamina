    {
      "slug": "vienne-name",
      "lemma": "Vienne",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1880,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "Вьенна"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "815439",
          "text": "Pourvu qu'elle vienne.",
          "translation": "Лишь бы она пришла.",
          "source": "Tatoeba #815439 @U2FS / #2493982 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/815439",
          "cefr_level": "A1",
          "word_slugs": [
            "vienne-name"
          ]
        },
        {
          "id": "6636214",
          "text": "Que ton règne vienne !",
          "translation": "Да приидет Царствие Твоё!",
          "source": "Tatoeba #6636214 @GB3 / #6636250 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6636214",
          "cefr_level": "A1",
