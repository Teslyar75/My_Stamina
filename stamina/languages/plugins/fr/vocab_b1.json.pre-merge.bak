    {
      "slug": "disant-adj",
      "lemma": "disant",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1917,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11232312",
          "text": "Il répond en disant oui.",
          "translation": "Он отвечает, что да.",
          "source": "Tatoeba #11232312 @carlosalberto / #11232329 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11232312",
          "cefr_level": "A1",
          "word_slugs": [
            "disant-adj"
          ]
        },
        {
          "id": "463550",
          "text": "Il est un soi-disant libéral.",
          "translation": "Он - так называемый либерал.",
          "source": "Tatoeba #463550 @sacredceltic / #513288 @Airy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/463550",
          "cefr_level": "A1",
          "word_slugs": [
            "disant-adj"
          ]
        },
        {
          "id": "4617931",
          "text": "Le soi-disant homme est une femme.",
          "translation": "Так называемый мужчина - женщина.",
          "source": "Tatoeba #4617931 @sacredceltic / #10480691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4617931",
          "cefr_level": "A1",
          "word_slugs": [
            "disant-adj"
          ]
        },
        {
          "id": "139021",
          "text": "Il y avait un panneau disant « Pelouse interdite ».",
          "translation": "Была табличка с надписью «По траве не ходить».",
          "source": "Tatoeba #139021 @kurisutofu / #10474994 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/139021",
          "cefr_level": "A1",
          "word_slugs": [
            "disant-adj"
          ]
        },
        {
          "id": "1324374",
          "text": "Elle a menti en disant qu'elle était enceinte.",
          "translation": "Она солгала, сказав, что беременна.",
          "source": "Tatoeba #1324374 @Eldad / #14051028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1324374",
          "cefr_level": "A1",
          "word_slugs": [
            "disant-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le disant",
        "plural": "",
        "infinitive": ""
      }
    },
