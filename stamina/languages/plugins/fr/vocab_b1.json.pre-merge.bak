    {
      "slug": "relations-noun",
      "lemma": "relations",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1925,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5092972",
          "text": "Nous avons des relations ouvertes.",
          "translation": "У нас открытые отношения.",
          "source": "Tatoeba #5092972 @Scorpionvenin14 / #7903014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5092972",
          "cefr_level": "A1",
          "word_slugs": [
            "relations-noun"
          ]
        },
        {
          "id": "12594753",
          "text": "Nous entretenons de bonnes relations.",
          "translation": "Мы поддерживаем хорошие отношения.",
          "source": "Tatoeba #12594753 @lbdx / #12594758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12594753",
          "cefr_level": "A1",
          "word_slugs": [
            "relations-noun"
          ]
        },
        {
          "id": "1128852",
          "text": "Les relations impliquent des compromis.",
          "translation": "Отношения подразумевают компромисс.",
          "source": "Tatoeba #1128852 @sacredceltic / #1674558 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1128852",
          "cefr_level": "A1",
          "word_slugs": [
            "relations-noun"
          ]
        },
        {
          "id": "8639747",
          "text": "Ils entretiennent des relations amicales.",
          "translation": "Они поддерживают дружеские отношения.",
          "source": "Tatoeba #8639747 @Julien_PDC / #10328511 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8639747",
          "cefr_level": "A1",
          "word_slugs": [
            "relations-noun"
          ]
        },
        {
          "id": "1450064",
          "text": "J'ai des relations au gouvernement.",
          "translation": "У меня есть связи в правительстве.",
          "source": "Tatoeba #1450064 @sacredceltic / #2369395 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1450064",
          "cefr_level": "A1",
          "word_slugs": [
            "relations-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "f",
        "singular": "la relations",
        "plural": "",
        "infinitive": ""
      }
