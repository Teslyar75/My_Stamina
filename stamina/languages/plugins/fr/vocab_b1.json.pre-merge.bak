    {
      "slug": "blessures-noun",
      "lemma": "blessures",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2481,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "11837750",
          "text": "Les blessures guérissent.",
          "translation": "Раны заживают.",
          "source": "Tatoeba #11837750 @Amastan / #12396362 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11837750",
          "cefr_level": "A1",
          "word_slugs": [
            "blessures-noun"
          ]
        },
        {
          "id": "1090297",
          "text": "Toutes ses blessures sont externes.",
          "translation": "Все его раны поверхностные.",
          "source": "Tatoeba #1090297 @sacredceltic / #3671436 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1090297",
          "cefr_level": "A1",
          "word_slugs": [
            "blessures-noun"
          ]
        },
        {
          "id": "1090295",
          "text": "Ses blessures sont toutes superficielles.",
          "translation": "Все его раны поверхностные.",
          "source": "Tatoeba #1090295 @sacredceltic / #3671436 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1090295",
          "cefr_level": "A1",
          "word_slugs": [
            "blessures-noun"
          ]
        },
        {
          "id": "10532748",
          "text": "Certaines blessures ne guérissent jamais.",
          "translation": "Некоторые раны никогда не заживают.",
          "source": "Tatoeba #10532748 @Adelpa / #4643422 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10532748",
          "cefr_level": "A1",
          "word_slugs": [
            "blessures-noun"
          ]
        },
        {
          "id": "5116766",
          "text": "Tom a guéri de ses blessures.",
          "translation": "Том вылечился от ран.",
          "source": "Tatoeba #5116766 @gege_veggie / #5194149 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5116766",
          "cefr_level": "A1",
          "word_slugs": [
            "blessures-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "f",
        "singular": "la blessures",
        "plural": "",
        "infinitive": ""
      }
    },
