    {
      "slug": "justement-adv",
      "lemma": "justement",
      "pos": "adv",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1649,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1157283",
          "text": "Je voulais justement cela.",
          "translation": "Я именно этого и хотел.",
          "source": "Tatoeba #1157283 @sacredceltic / #8053021 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1157283",
          "cefr_level": "A1",
          "word_slugs": [
            "justement-adv"
          ]
        },
        {
          "id": "1074794",
          "text": "Il a été justement puni.",
          "translation": "Он был справедливо наказан.",
          "source": "Tatoeba #1074794 @Anthony / #6633323 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1074794",
          "cefr_level": "A1",
          "word_slugs": [
            "justement-adv"
          ]
        },
        {
          "id": "14117531",
          "text": "Je pensais justement à toi.",
          "translation": "Я как раз думал о тебе.",
          "source": "Tatoeba #14117531 @lbdx / #5318130 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14117531",
          "cefr_level": "A1",
          "word_slugs": [
            "justement-adv"
          ]
        },
        {
          "id": "3224977",
          "text": "C'est justement le contraire.",
          "translation": "Всё ровно наоборот.",
          "source": "Tatoeba #3224977 @sicerabibax / #9364780 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3224977",
          "cefr_level": "A1",
          "word_slugs": [
            "justement-adv"
          ]
        },
        {
          "id": "10703984",
          "text": "Nous parlions justement de lui.",
          "translation": "Мы как раз о нём говорили.",
          "source": "Tatoeba #10703984 @AutoBot / #11830891 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10703984",
          "cefr_level": "A1",
          "word_slugs": [
            "justement-adv"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
