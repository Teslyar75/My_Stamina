          ]
        },
        {
          "id": "12368883",
          "text": "Personne n'a pris ma défense.",
          "translation": "Никто не встал на мою защиту.",
          "source": "Tatoeba #12368883 @lbdx / #12368890 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12368883",
          "cefr_level": "A1",
          "word_slugs": [
            "défense-noun"
          ]
        },
        {
          "id": "11915833",
          "text": "Merci d'avoir pris ma défense.",
          "translation": "Спасибо, что заступился за меня.",
          "source": "Tatoeba #11915833 @lbdx / #8568779 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11915833",
          "cefr_level": "A1",
          "word_slugs": [
            "défense-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
