    {
      "slug": "major-noun",
      "lemma": "major",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2177,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "майор"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12604881",
          "text": "L'état-major a approuvé le plan.",
          "translation": "Штаб одобрил план.",
          "source": "Tatoeba #12604881 @lbdx / #12606185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12604881",
          "cefr_level": "A1",
          "word_slugs": [
            "major-noun"
          ]
        },
        {
          "id": "128484",
          "text": "Un major est au-dessus d'un capitaine.",
          "translation": "Майор выше капитана.",
          "source": "Tatoeba #128484 @Aiji / #5321498 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/128484",
          "cefr_level": "A1",
          "word_slugs": [
            "major-noun"
          ]
        },
        {
          "id": "12604885",
          "text": "Les ordres viennent directement de l'état-major.",
          "translation": "Приказы приходят непосредственно из штаба.",
          "source": "Tatoeba #12604885 @lbdx / #12606183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12604885",
          "cefr_level": "A1",
          "word_slugs": [
            "major-noun"
          ]
        },
        {
          "id": "12604891",
          "text": "Nous attendons les instructions de l'état-major.",
          "translation": "Мы ждём указаний из штаба.",
          "source": "Tatoeba #12604891 @lbdx / #12606180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12604891",
          "cefr_level": "A1",
          "word_slugs": [
            "major-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le major",
        "plural": "",
        "infinitive": ""
      }
