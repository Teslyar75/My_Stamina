      "frequency_rank": 2191,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1044186",
          "text": "Ne revenez pas.",
          "translation": "Не возвращайтесь.",
