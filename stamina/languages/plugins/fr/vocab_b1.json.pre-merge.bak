          "cefr_level": "A1",
          "word_slugs": [
            "course-noun"
          ]
        },
        {
          "id": "7698969",
          "text": "Tom a fini la course.",
          "translation": "Том завершил гонку.",
          "source": "Tatoeba #7698969 @Maxence / #7826505 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7698969",
          "cefr_level": "A1",
          "word_slugs": [
