      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7556289",
          "text": "L'ours grogne.",
          "translation": "Медведь рычит.",
          "source": "Tatoeba #7556289 @Micsmithel / #5585532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7556289",
          "cefr_level": "A1",
          "word_slugs": [
            "ours-noun"
          ]
        },
        {
          "id": "10509426",
          "text": "Les ours hibernent.",
          "translation": "Медведи впадают в спячку.",
          "source": "Tatoeba #10509426 @pkill / #9928201 @prokofyev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10509426",
          "cefr_level": "A1",
          "word_slugs": [
            "ours-noun"
          ]
        },
