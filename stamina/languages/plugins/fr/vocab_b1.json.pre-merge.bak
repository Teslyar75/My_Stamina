    {
      "slug": "agents-noun",
      "lemma": "agents",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1683,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1564207",
          "text": "Les agents de police portent des uniformes bleus.",
          "translation": "Полицейские носят форму синего цвета.",
          "source": "Tatoeba #1564207 @sacredceltic / #12050879 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1564207",
          "cefr_level": "A1",
          "word_slugs": [
            "agents-noun"
          ]
        },
        {
          "id": "12990160",
          "text": "Je n'ai pas peur des agents de police.",
          "translation": "Я не боюсь полицейских.",
          "source": "Tatoeba #12990160 @Rovo / #12990188 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12990160",
          "cefr_level": "A1",
          "word_slugs": [
            "agents-noun"
          ]
        },
        {
          "id": "13630373",
          "text": "Les virus sont les agents responsables de nombreuses maladies.",
          "translation": "Вирусы являются возбудителями многих заболеваний.",
          "source": "Tatoeba #13630373 @carlosalberto / #11041347 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13630373",
          "cefr_level": "A1",
          "word_slugs": [
            "agents-noun"
          ]
        },
        {
          "id": "13960571",
          "text": "Le système immunitaire protège le corps contre les agents pathogènes.",
          "translation": "Иммунная система защищает организм от патогенных возбудителей.",
          "source": "Tatoeba #13960571 @Naityahia / #13961448 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13960571",
          "cefr_level": "A1",
          "word_slugs": [
            "agents-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le agents",
        "plural": "",
        "infinitive": ""
      }
    },
