          "word_slugs": [
            "construire-verb"
          ]
        },
        {
          "id": "9163766",
          "text": "Il faut en construire davantage.",
          "translation": "Надо их строить больше.",
          "source": "Tatoeba #9163766 @Julien_PDC / #9164948 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9163766",
          "cefr_level": "A1",
          "word_slugs": [
            "construire-verb"
          ]
        },
        {
          "id": "13091842",
          "text": "Vous allez construire une maison.",
          "translation": "Вы будете строить дом.",
          "source": "Tatoeba #13091842 @LdjuherTaqvaylit / #13092811 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13091842",
