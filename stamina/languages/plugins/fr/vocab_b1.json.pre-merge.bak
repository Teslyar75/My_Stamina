            "parie-verb"
          ]
        },
        {
          "id": "2297119",
          "text": "Je parie que tu as raison.",
          "translation": "Держу пари, ты прав.",
          "source": "Tatoeba #2297119 @sacredceltic / #3982179 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2297119",
          "cefr_level": "A1",
          "word_slugs": [
            "parie-verb"
          ]
        }
