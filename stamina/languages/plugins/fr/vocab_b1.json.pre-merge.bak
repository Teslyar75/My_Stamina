      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13811361",
          "text": "Prenez du fromage.",
          "translation": "Возьмите сыра.",
          "source": "Tatoeba #13811361 @slahatuvelli / #13821223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13811361",
          "cefr_level": "A1",
