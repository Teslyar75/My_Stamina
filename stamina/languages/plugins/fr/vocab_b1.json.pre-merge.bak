    {
      "slug": "quiconque-pron",
      "lemma": "quiconque",
      "pos": "pron",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2323,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "всякий",
          "любой"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3671181",
          "text": "Demande à quiconque !",
          "translation": "Спроси у кого-нибудь.",
          "source": "Tatoeba #3671181 @sacredceltic / #3603289 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3671181",
          "cefr_level": "A1",
          "word_slugs": [
            "quiconque-pron"
          ]
        },
        {
          "id": "2099457",
          "text": "Reconnais-tu quiconque ?",
          "translation": "Ты кого-нибудь узнаёшь?",
          "source": "Tatoeba #2099457 @sacredceltic / #3144087 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2099457",
          "cefr_level": "A1",
          "word_slugs": [
            "quiconque-pron"
          ]
        },
        {
          "id": "13401680",
          "text": "Quiconque souhaite réussit.",
          "translation": "Кто хочет, тот добьётся успеха.",
          "source": "Tatoeba #13401680 @madjidoumnia / #13471233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13401680",
          "cefr_level": "A1",
          "word_slugs": [
            "quiconque-pron"
          ]
        },
        {
          "id": "2099455",
          "text": "Reconnaissez-vous quiconque ?",
          "translation": "Вы кого-нибудь узнаёте?",
          "source": "Tatoeba #2099455 @sacredceltic / #3144086 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2099455",
          "cefr_level": "A1",
          "word_slugs": [
            "quiconque-pron"
          ]
        },
        {
          "id": "4653831",
          "text": "Quiconque t'a vu ?",
          "translation": "Тебя кто-нибудь видел?",
          "source": "Tatoeba #4653831 @sacredceltic / #2509690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4653831",
          "cefr_level": "A1",
          "word_slugs": [
            "quiconque-pron"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
