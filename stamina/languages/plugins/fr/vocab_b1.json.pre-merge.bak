    {
      "slug": "tribunal-noun",
      "lemma": "tribunal",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1653,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3532232",
          "text": "Rendez-vous au tribunal !",
          "translation": "Встретимся в суде!",
          "source": "Tatoeba #3532232 @sacredceltic / #3532254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3532232",
          "cefr_level": "A1",
          "word_slugs": [
            "tribunal-noun"
          ]
        },
        {
          "id": "4483723",
          "text": "On se verra au tribunal.",
          "translation": "Увидимся в суде.",
          "source": "Tatoeba #4483723 @Petrus / #4483571 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4483723",
          "cefr_level": "A1",
          "word_slugs": [
            "tribunal-noun"
          ]
        },
        {
          "id": "10568806",
          "text": "C'est au tribunal de trancher.",
          "translation": "Это суду решать.",
          "source": "Tatoeba #10568806 @lbdx / #10568910 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10568806",
          "cefr_level": "A1",
          "word_slugs": [
            "tribunal-noun"
          ]
        },
        {
          "id": "13016929",
          "text": "Il a comparu devant le tribunal.",
          "translation": "Он предстал перед судом.",
          "source": "Tatoeba #13016929 @LdjuherTaqvaylit / #13017496 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13016929",
          "cefr_level": "A1",
          "word_slugs": [
            "tribunal-noun"
          ]
        },
        {
          "id": "10187",
          "text": "Je dois témoigner au Tribunal demain.",
          "translation": "Я буду завтра выступать свидетелем в суде.",
          "source": "Tatoeba #10187 @bogantsev / #3604748 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10187",
          "cefr_level": "A1",
          "word_slugs": [
            "tribunal-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
