          ]
        },
        {
          "id": "5707298",
          "text": "Tom a perdu la course.",
          "translation": "Том проиграл гонку.",
          "source": "Tatoeba #5707298 @Aiji / #5207562 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5707298",
          "cefr_level": "A1",
          "word_slugs": [
            "course-noun"
          ]
        }
