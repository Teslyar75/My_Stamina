      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2172,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2931954",
          "text": "Je déteste la violence.",
          "translation": "Я ненавижу насилие.",
          "source": "Tatoeba #2931954 @Blabla / #3980708 @tasarut (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2931954",
          "cefr_level": "A1",
          "word_slugs": [
            "violence-noun"
          ]
        },
        {
          "id": "8313216",
          "text": "La violence est inutile.",
          "translation": "Насилие бессмысленно.",
          "source": "Tatoeba #8313216 @Julien_PDC / #8316215 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8313216",
          "cefr_level": "A1",
          "word_slugs": [
            "violence-noun"
          ]
        },
        {
          "id": "7698914",
          "text": "Nous rejetons la violence.",
          "translation": "Мы отвергаем насилие.",
          "source": "Tatoeba #7698914 @Maxence / #14054471 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7698914",
          "cefr_level": "A1",
          "word_slugs": [
            "violence-noun"
          ]
        },
        {
          "id": "11894416",
          "text": "Nous refusons la violence.",
          "translation": "Мы отвергаем насилие.",
          "source": "Tatoeba #11894416 @Rovo / #14054471 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11894416",
          "cefr_level": "A1",
          "word_slugs": [
            "violence-noun"
          ]
        },
        {
          "id": "1937746",
          "text": "Mon cœur battait avec violence.",
          "translation": "Моё сердце билось с неистовой силой.",
          "source": "Tatoeba #1937746 @Scott / #5348992 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1937746",
          "cefr_level": "A1",
          "word_slugs": [
            "violence-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
