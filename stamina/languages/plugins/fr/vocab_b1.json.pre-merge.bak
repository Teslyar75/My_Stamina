            "ressens-verb"
          ]
        },
        {
          "id": "9384",
          "text": "Je ressens le froid.",
          "translation": "Я чувствую холод.",
          "source": "Tatoeba #9384 @sacredceltic / #2436512 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9384",
          "cefr_level": "A1",
          "word_slugs": [
            "ressens-verb"
          ]
        },
        {
          "id": "13884040",
          "text": "Dis ce que tu ressens.",
          "translation": "Скажи, что ты чувствуешь.",
          "source": "Tatoeba #13884040 @slahatuvelli / #13884139 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13884040",
          "cefr_level": "A1",
          "word_slugs": [
            "ressens-verb"
          ]
        },
        {
          "id": "2421256",
          "text": "Je ne ressens plus rien.",
          "translation": "Я больше ничего не чувствую.",
          "source": "Tatoeba #2421256 @sacredceltic / #3039679 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2421256",
          "cefr_level": "A1",
          "word_slugs": [
            "ressens-verb"
          ]
        }
