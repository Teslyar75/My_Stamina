          "cefr_level": "A1",
          "word_slugs": [
            "code-noun"
          ]
        },
        {
          "id": "11378896",
          "text": "Ce code a besoin d'être réécrit.",
          "translation": "Этот код надо переписать.",
          "source": "Tatoeba #11378896 @lbdx / #11379063 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11378896",
          "cefr_level": "A1",
          "word_slugs": [
            "code-noun"
          ]
        },
        {
          "id": "1038752",
          "text": "Je ne connais pas le code secret.",
          "translation": "Я не знаю секретного кода.",
          "source": "Tatoeba #1038752 @elgranjuego / #6932961 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1038752",
          "cefr_level": "A1",
          "word_slugs": [
            "code-noun"
          ]
        }
      ],
