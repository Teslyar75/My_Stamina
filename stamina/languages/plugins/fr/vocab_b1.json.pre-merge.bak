    {
      "slug": "concernant-adj",
      "lemma": "concernant",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2404,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13683449",
          "text": "Sais-tu quelque chose concernant cela ?",
          "translation": "Ты что-нибудь знаешь об этом?",
          "source": "Tatoeba #13683449 @slahatuvelli / #5225343 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13683449",
          "cefr_level": "A1",
          "word_slugs": [
            "concernant-adj"
          ]
        },
        {
          "id": "119807",
          "text": "C'est un livre concernant les étoiles.",
          "translation": "Это книга о звёздах.",
          "source": "Tatoeba #119807 @9h0ost / #525727 @papersaltserver (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/119807",
          "cefr_level": "A1",
          "word_slugs": [
            "concernant-adj"
          ]
        },
        {
          "id": "7267281",
          "text": "J'ai un bon pressentiment concernant ceci.",
          "translation": "У меня хорошее предчувствие на этот счёт.",
          "source": "Tatoeba #7267281 @Aiji / #13999792 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7267281",
          "cefr_level": "A1",
          "word_slugs": [
            "concernant-adj"
          ]
        },
        {
          "id": "13359445",
          "text": "Concernant leur position, elles l'ont annoncée.",
          "translation": "Что касается их позиции, они её озвучили.",
          "source": "Tatoeba #13359445 @slahatuvelli / #13414277 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13359445",
          "cefr_level": "A1",
          "word_slugs": [
            "concernant-adj"
          ]
        },
        {
          "id": "11293719",
          "text": "Que sais-tu concernant la famille de Tom ?",
          "translation": "Что ты знаешь о семье Тома?",
          "source": "Tatoeba #11293719 @Rovo / #4628422 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11293719",
          "cefr_level": "A1",
          "word_slugs": [
            "concernant-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le concernant",
        "plural": "",
        "infinitive": ""
      }
