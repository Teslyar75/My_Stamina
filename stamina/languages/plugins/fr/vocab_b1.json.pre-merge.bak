      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4777486",
          "text": "Nous pourrions lire.",
          "translation": "Мы могли бы почитать.",
          "source": "Tatoeba #4777486 @sacredceltic / #9052214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4777486",
          "cefr_level": "A1",
