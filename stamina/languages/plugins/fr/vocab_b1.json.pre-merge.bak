      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5189909",
          "text": "La maison sera à construire.",
          "translation": "Дом надо будет построить.",
          "source": "Tatoeba #5189909 @rmateo / #12989748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5189909",
          "cefr_level": "A1",
          "word_slugs": [
            "construire-verb"
          ]
        },
        {
          "id": "12578753",
          "text": "Je dois construire une maison.",
          "translation": "Я должен построить дом.",
          "source": "Tatoeba #12578753 @LdjuherTaqvaylit / #12581410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12578753",
