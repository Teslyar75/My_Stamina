          ]
        },
        {
          "id": "4404163",
          "text": "Je me suis tournée et retournée toute la nuit.",
          "translation": "Я всю ночь проворочалась.",
          "source": "Tatoeba #4404163 @sacredceltic / #5294419 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4404163",
          "cefr_level": "A1",
          "word_slugs": [
