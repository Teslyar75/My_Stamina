          ]
        },
        {
          "id": "6284267",
          "text": "Tom veut devenir pilote.",
          "translation": "Том хочет стать лётчиком.",
          "source": "Tatoeba #6284267 @Adelpa / #8208063 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6284267",
