      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8304808",
          "text": "Bien au contraire !",
          "translation": "Наоборот!",
          "source": "Tatoeba #8304808 @Micsmithel / #4560097 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8304808",
          "cefr_level": "A1",
          "word_slugs": [
            "contraire-noun"
          ]
        },
        {
          "id": "1151745",
          "text": "Il fit le contraire.",
          "translation": "Он сделал всё наоборот.",
          "source": "Tatoeba #1151745 @sacredceltic / #1458726 @vladb314 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1151745",
          "cefr_level": "A1",
          "word_slugs": [
            "contraire-noun"
          ]
        },
        {
          "id": "7695947",
          "text": "Malheureusement non, au contraire.",
          "translation": "К сожалению, нет. Наоборот.",
          "source": "Tatoeba #7695947 @Maxence / #8021887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7695947",
          "cefr_level": "A1",
          "word_slugs": [
            "contraire-noun"
          ]
        },
        {
          "id": "1156998",
          "text": "Malheureusement non ; au contraire.",
