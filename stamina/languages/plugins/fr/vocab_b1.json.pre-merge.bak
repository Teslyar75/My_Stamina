    {
      "slug": "recevoir-verb",
      "lemma": "recevoir",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1787,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "получить",
          "получать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5644464",
          "text": "Merci de nous recevoir.",
          "translation": "Спасибо, что приняли нас.",
          "source": "Tatoeba #5644464 @Scorpionvenin14 / #5644518 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5644464",
          "cefr_level": "A1",
          "word_slugs": [
            "recevoir-verb"
          ]
        },
        {
          "id": "12574207",
          "text": "Vous allez les recevoir ?",
          "translation": "Вы их получите?",
          "source": "Tatoeba #12574207 @LdjuherTaqvaylit / #12574239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12574207",
          "cefr_level": "A1",
          "word_slugs": [
            "recevoir-verb"
          ]
        },
        {
          "id": "1049567",
          "text": "Je dois recevoir un vaccin.",
          "translation": "Мне надо вакцинироваться.",
          "source": "Tatoeba #1049567 @jeo / #10814638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1049567",
          "cefr_level": "A1",
          "word_slugs": [
            "recevoir-verb"
          ]
        },
        {
          "id": "8595092",
          "text": "Mieux vaut donner que recevoir.",
          "translation": "Лучше давать, чем получать.",
          "source": "Tatoeba #8595092 @Adelpa / #8595464 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8595092",
          "cefr_level": "A1",
          "word_slugs": [
            "recevoir-verb"
          ]
        },
        {
          "id": "8961733",
          "text": "Donner vaut mieux que recevoir.",
          "translation": "Лучше отдавать, чем получать.",
          "source": "Tatoeba #8961733 @Adelpa / #3570499 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8961733",
          "cefr_level": "A1",
          "word_slugs": [
            "recevoir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
