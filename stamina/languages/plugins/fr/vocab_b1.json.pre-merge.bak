    {
      "slug": "rires-noun",
      "lemma": "rires",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2034,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8690144",
          "text": "J'entends des rires.",
          "translation": "Я слышу смех.",
          "source": "Tatoeba #8690144 @Micsmithel / #2010508 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8690144",
          "cefr_level": "A1",
          "word_slugs": [
            "rires-noun"
          ]
        },
        {
          "id": "10004882",
          "text": "Les rires se sont tus.",
          "translation": "Смех умолк.",
          "source": "Tatoeba #10004882 @Julien_PDC / #10824033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10004882",
          "cefr_level": "A1",
          "word_slugs": [
            "rires-noun"
          ]
        },
        {
          "id": "1513538",
          "text": "Un jour sans rires est un jour perdu.",
          "translation": "День без смеха — потерянный день.",
          "source": "Tatoeba #1513538 @martin9 / #13899895 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1513538",
          "cefr_level": "A1",
          "word_slugs": [
            "rires-noun"
          ]
        },
        {
          "id": "13380337",
          "text": "Marie pouvait entendre des rires étouffés à travers le mur.",
          "translation": "Через стену до Мэри доносился приглушённый смех.",
          "source": "Tatoeba #13380337 @aviannek / #9946797 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13380337",
          "cefr_level": "A1",
          "word_slugs": [
            "rires-noun"
          ]
        },
        {
          "id": "5844708",
          "text": "Les rires, les cris joyeux s’élevaient de tous les côtés.",
          "translation": "Со всех сторон раздавался смех и радостные возгласы.",
          "source": "Tatoeba #5844708 @Blabla / #6016240 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5844708",
          "cefr_level": "A1",
          "word_slugs": [
            "rires-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le rires",
        "plural": "",
        "infinitive": ""
      }
