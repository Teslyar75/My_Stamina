          ]
        },
        {
          "id": "1460555",
          "text": "Il paraît heureux.",
          "translation": "Он, кажется, счастлив.",
          "source": "Tatoeba #1460555 @sacredceltic / #12129533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1460555",
