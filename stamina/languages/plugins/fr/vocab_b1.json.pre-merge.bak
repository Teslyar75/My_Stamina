            "prennent-verb"
          ]
        },
        {
          "id": "8875789",
          "text": "Pour qui se prennent-ils ?",
          "translation": "Кем они себя считают?",
          "source": "Tatoeba #8875789 @Talwit / #8876134 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8875789",
          "cefr_level": "A1",
