          "cefr_level": "A1",
          "word_slugs": [
            "offrir-verb"
          ]
        },
        {
          "id": "10344757",
          "text": "J'aimerais te l'offrir.",
          "translation": "Я хотел бы тебе его подарить.",
          "source": "Tatoeba #10344757 @Julien_PDC / #10456389 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10344757",
          "cefr_level": "A1",
          "word_slugs": [
            "offrir-verb"
          ]
        },
        {
          "id": "4096325",
          "text": "Je veux lui offrir cela.",
          "translation": "Я хочу ему это подарить.",
          "source": "Tatoeba #4096325 @sbamsbamsbam / #5434669 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4096325",
          "cefr_level": "A1",
          "word_slugs": [
            "offrir-verb"
          ]
        }
      ],
