          ]
        },
        {
          "id": "994716",
          "text": "La bataille se poursuit !",
          "translation": "Битва продолжается!",
          "source": "Tatoeba #994716 @sacredceltic / #4444324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/994716",
          "cefr_level": "A1",
          "word_slugs": [
            "bataille-name"
          ]
        },
        {
          "id": "6402093",
          "text": "La bataille était commencée.",
          "translation": "Битва была начата.",
          "source": "Tatoeba #6402093 @Blabla / #13045713 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6402093",
          "cefr_level": "A1",
          "word_slugs": [
            "bataille-name"
          ]
        },
        {
          "id": "8313206",
          "text": "La bataille semblait perdue.",
          "translation": "Битва казалась проигранной.",
          "source": "Tatoeba #8313206 @Julien_PDC / #8316187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8313206",
          "cefr_level": "A1",
          "word_slugs": [
            "bataille-name"
          ]
        },
        {
          "id": "896310",
          "text": "Nous remportâmes la bataille.",
          "translation": "Мы выиграли битву.",
          "source": "Tatoeba #896310 @sacredceltic / #1728447 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/896310",
          "cefr_level": "A1",
          "word_slugs": [
            "bataille-name"
          ]
        }
      ],
