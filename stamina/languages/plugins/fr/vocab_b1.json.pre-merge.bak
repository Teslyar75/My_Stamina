    {
      "slug": "falloir-verb",
      "lemma": "falloir",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1742,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "надлежать",
          "долженствовать",
          "следовать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7419772",
          "text": "Il va falloir être attentif.",
          "translation": "Придётся быть внимательным.",
          "source": "Tatoeba #7419772 @Adelpa / #14085975 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7419772",
          "cefr_level": "A1",
          "word_slugs": [
            "falloir-verb"
          ]
        },
        {
          "id": "7311405",
          "text": "Il va falloir travailler dur.",
          "translation": "Надо будет много работать.",
          "source": "Tatoeba #7311405 @Adelpa / #11497433 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7311405",
          "cefr_level": "A1",
          "word_slugs": [
            "falloir-verb"
          ]
        },
        {
          "id": "12449658",
          "text": "Il va nous falloir réfléchir.",
          "translation": "Нам нужно будет подумать.",
          "source": "Tatoeba #12449658 @Rovo / #14076372 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12449658",
          "cefr_level": "A1",
          "word_slugs": [
            "falloir-verb"
          ]
        },
        {
          "id": "7311972",
          "text": "Il va falloir s'y faire.",
          "translation": "К этому надо будет привыкнуть.",
          "source": "Tatoeba #7311972 @Adelpa / #7312032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7311972",
          "cefr_level": "A1",
          "word_slugs": [
            "falloir-verb"
          ]
        },
        {
          "id": "11179003",
          "text": "Il va falloir t'y faire.",
          "translation": "Тебе придётся к этому привыкнуть.",
          "source": "Tatoeba #11179003 @lbdx / #7877298 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11179003",
          "cefr_level": "A1",
          "word_slugs": [
            "falloir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
