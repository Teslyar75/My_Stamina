    {
      "slug": "détruire-verb",
      "lemma": "détruire",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1340,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10513452",
          "text": "Il faut détruire Rome.",
          "translation": "Надо разрушить Рим.",
          "source": "Tatoeba #10513452 @pkill / #11154905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10513452",
          "cefr_level": "A1",
          "word_slugs": [
            "détruire-verb"
          ]
        },
        {
          "id": "1511909",
          "text": "Il faut détruire Carthage.",
          "translation": "Карфаген должен быть разрушен.",
          "source": "Tatoeba #1511909 @sacredceltic / #1670272 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1511909",
          "cefr_level": "A1",
          "word_slugs": [
            "détruire-verb"
          ]
        },
        {
          "id": "12269338",
          "text": "Il veut détruire le reste.",
          "translation": "Он хочет разрушить остальное.",
          "source": "Tatoeba #12269338 @LdjuherTaqvaylit / #12284273 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12269338",
          "cefr_level": "A1",
          "word_slugs": [
            "détruire-verb"
          ]
        },
        {
          "id": "10513454",
          "text": "Il faut détruire cette ville.",
          "translation": "Надо разрушить этот город.",
          "source": "Tatoeba #10513454 @pkill / #11115545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10513454",
          "cefr_level": "A1",
          "word_slugs": [
            "détruire-verb"
          ]
        },
        {
          "id": "7821652",
          "text": "Les anarchistes veulent tout détruire.",
          "translation": "Анархисты хотят всё разрушить.",
          "source": "Tatoeba #7821652 @theachaean / #7821654 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7821652",
          "cefr_level": "A1",
          "word_slugs": [
            "détruire-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "détruire",
        "plural": "",
        "infinitive": "détruire"
      }
