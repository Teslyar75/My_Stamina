    {
      "slug": "sacrée-adj",
      "lemma": "sacrée",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2426,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13491648",
          "text": "La vie est sacrée.",
          "translation": "Жизнь священна.",
          "source": "Tatoeba #13491648 @Aghanim / #13491649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13491648",
          "cefr_level": "A1",
          "word_slugs": [
            "sacrée-adj"
          ]
        },
        {
          "id": "3392287",
          "text": "La vie humaine est sacrée.",
          "translation": "Человеческая жизнь священна.",
          "source": "Tatoeba #3392287 @sacredceltic / #4774086 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3392287",
          "cefr_level": "A1",
          "word_slugs": [
            "sacrée-adj"
          ]
        },
        {
          "id": "13388316",
          "text": "Tu as une sacrée imagination.",
          "translation": "Ну и воображение у тебя.",
          "source": "Tatoeba #13388316 @lbdx / #13388398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13388316",
          "cefr_level": "A1",
          "word_slugs": [
            "sacrée-adj"
          ]
        },
        {
          "id": "8654496",
          "text": "Sacrée tradition que la nôtre.",
          "translation": "Такая у нас традиция.",
          "source": "Tatoeba #8654496 @colique / #7720943 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8654496",
          "cefr_level": "A1",
          "word_slugs": [
            "sacrée-adj"
          ]
        },
        {
          "id": "8676452",
          "text": "C'est une sacrée coïncidence !",
          "translation": "Это чёртово совпадение!",
          "source": "Tatoeba #8676452 @Julien_PDC / #10208806 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8676452",
          "cefr_level": "A1",
          "word_slugs": [
            "sacrée-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
