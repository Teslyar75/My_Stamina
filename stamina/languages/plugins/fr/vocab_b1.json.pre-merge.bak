      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5552237",
          "text": "Je l'aime malgré tout.",
          "translation": "Я люблю его несмотря ни на что.",
          "source": "Tatoeba #5552237 @sacredceltic / #5552918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5552237",
