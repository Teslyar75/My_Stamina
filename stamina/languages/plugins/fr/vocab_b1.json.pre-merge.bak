      "frequency_rank": 1825,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12620132",
          "text": "Il travaille aux services sociaux.",
          "translation": "Он работает в собесе.",
          "source": "Tatoeba #12620132 @Amnafeq / #12622510 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12620132",
          "cefr_level": "A1",
          "word_slugs": [
            "services-verb"
          ]
        },
        {
          "id": "1850150",
          "text": "On se passera de vos services.",
          "translation": "Обойдёмся без ваших услуг.",
          "source": "Tatoeba #1850150 @Rovo / #2765204 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1850150",
          "cefr_level": "A1",
          "word_slugs": [
            "services-verb"
          ]
        },
        {
          "id": "803751",
          "text": "Vos services ne sont plus requis.",
          "translation": "Ваши услуги более не требуются.",
          "source": "Tatoeba #803751 @sacredceltic / #8596556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/803751",
          "cefr_level": "A1",
          "word_slugs": [
            "services-verb"
          ]
        },
        {
          "id": "13961144",
          "text": "Les administrations utilisent des services numériques.",
          "translation": "Учреждения используют цифровые сервисы.",
          "source": "Tatoeba #13961144 @Naityahia / #13961648 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13961144",
          "cefr_level": "A1",
          "word_slugs": [
            "services-verb"
          ]
        },
        {
          "id": "1915207",
          "text": "Je ne leur rends pas de services.",
          "translation": "Я не оказываю им никаких услуг.",
          "source": "Tatoeba #1915207 @Amastan / #11855343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1915207",
          "cefr_level": "A1",
          "word_slugs": [
            "services-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
