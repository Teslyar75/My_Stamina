    {
      "slug": "maria-name",
      "lemma": "Maria",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2223,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8609259",
          "text": "Tom dérange Maria.",
          "translation": "Том мешает Мэри.",
          "source": "Tatoeba #8609259 @Micsmithel / #5515254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8609259",
          "cefr_level": "A1",
          "word_slugs": [
            "maria-name"
          ]
        },
        {
          "id": "6860998",
          "text": "Maria est militante.",
          "translation": "Мэри - активистка.",
          "source": "Tatoeba #6860998 @Micsmithel / #6861284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6860998",
          "cefr_level": "A1",
          "word_slugs": [
            "maria-name"
          ]
        },
        {
          "id": "5090680",
          "text": "Maria naquit aveugle.",
          "translation": "Мэри родилась слепой.",
          "source": "Tatoeba #5090680 @PaulLacasse1960 / #5128570 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5090680",
          "cefr_level": "A1",
          "word_slugs": [
            "maria-name"
          ]
        },
        {
