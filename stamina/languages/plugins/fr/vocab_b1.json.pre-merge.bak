          "cefr_level": "A1",
          "word_slugs": [
            "haute-verb"
          ]
        },
        {
          "id": "9054088",
          "text": "La mer est haute.",
          "translation": "На море прилив.",
          "source": "Tatoeba #9054088 @Julien_PDC / #9054090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9054088",
