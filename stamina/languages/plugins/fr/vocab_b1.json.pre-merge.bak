          ]
        },
        {
          "id": "2445266",
          "text": "Arrête de faire le crétin.",
          "translation": "Прекрати валять дурака.",
          "source": "Tatoeba #2445266 @gillux / #2762933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2445266",
