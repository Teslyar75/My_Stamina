    {
      "slug": "parlant-adj",
      "lemma": "parlant",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2101,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "538384",
          "text": "En parlant du diable.",
          "translation": "Лёгок на помине.",
          "source": "Tatoeba #538384 @sacredceltic / #395089 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/538384",
          "cefr_level": "A1",
          "word_slugs": [
            "parlant-adj"
          ]
        },
        {
          "id": "8897483",
          "text": "Cet exemple est plus parlant.",
          "translation": "Этот пример более показателен.",
          "source": "Tatoeba #8897483 @Julien_PDC / #10345693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8897483",
          "cefr_level": "A1",
          "word_slugs": [
            "parlant-adj"
          ]
        },
        {
          "id": "465115",
          "text": "Strictement parlant, tu as tort.",
          "translation": "Строго говоря, ты ошибаешься.",
          "source": "Tatoeba #465115 @sysko / #4978896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/465115",
          "cefr_level": "A1",
          "word_slugs": [
            "parlant-adj"
          ]
        },
        {
          "id": "2894396",
          "text": "En parlant peu, tu entends davantage.",
          "translation": "Меньше говоришь - больше слышишь.",
          "source": "Tatoeba #2894396 @carlosalberto / #6603680 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2894396",
          "cefr_level": "A1",
          "word_slugs": [
            "parlant-adj"
          ]
        },
        {
          "id": "1876143",
          "text": "Connais-tu un docteur parlant japonais ?",
          "translation": "Ты знаешь врача, говорящего по-японски?",
