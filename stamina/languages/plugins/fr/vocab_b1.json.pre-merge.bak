    {
      "slug": "durant-prep",
      "lemma": "durant",
      "pos": "prep",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1418,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "в течение",
          "в продолжение"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1182798",
          "text": "Il plut durant la nuit.",
          "translation": "Ночью шёл дождь.",
          "source": "Tatoeba #1182798 @sacredceltic / #12883959 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1182798",
          "cefr_level": "A1",
          "word_slugs": [
            "durant-prep"
          ]
        },
        {
          "id": "1492408",
          "text": "Elle dansa durant un été.",
