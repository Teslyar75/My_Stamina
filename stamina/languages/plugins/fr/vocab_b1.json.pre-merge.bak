    {
      "slug": "caméras-noun",
      "lemma": "caméras",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2313,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8736792",
          "text": "À quoi servent ces caméras ?",
          "translation": "Зачем нужны эти камеры?",
          "source": "Tatoeba #8736792 @Julien_PDC / #11692069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8736792",
          "cefr_level": "A1",
          "word_slugs": [
            "caméras-noun"
          ]
        },
        {
          "id": "8736790",
          "text": "Ils installent des caméras partout.",
          "translation": "Они везде ставят камеры.",
          "source": "Tatoeba #8736790 @Julien_PDC / #10368118 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8736790",
          "cefr_level": "A1",
          "word_slugs": [
            "caméras-noun"
          ]
        },
        {
          "id": "11239217",
          "text": "Il y avait des caméras partout.",
          "translation": "Повсюду были камеры.",
          "source": "Tatoeba #11239217 @lbdx / #11239696 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11239217",
          "cefr_level": "A1",
          "word_slugs": [
            "caméras-noun"
          ]
        },
        {
          "id": "5367331",
          "text": "Nous avons installé plusieurs caméras de sécurité.",
          "translation": "Мы установили несколько камер наблюдения.",
          "source": "Tatoeba #5367331 @Aiji / #5373325 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5367331",
          "cefr_level": "A1",
          "word_slugs": [
            "caméras-noun"
          ]
        },
        {
          "id": "9505678",
          "text": "Ils installent des caméras de reconnaissance faciale.",
          "translation": "Они устанавливают камеры распознавания лиц.",
          "source": "Tatoeba #9505678 @Julien_PDC / #13427891 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9505678",
          "cefr_level": "A1",
          "word_slugs": [
            "caméras-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "f",
        "singular": "la caméras",
        "plural": "",
        "infinitive": ""
      }
