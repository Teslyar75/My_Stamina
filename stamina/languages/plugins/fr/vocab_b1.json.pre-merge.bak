    {
      "slug": "victimes-noun",
      "lemma": "victimes",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1393,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8168799",
          "text": "Où sont les victimes ?",
          "translation": "Где жертвы?",
          "source": "Tatoeba #8168799 @Aiji / #8035952 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8168799",
          "cefr_level": "A1",
          "word_slugs": [
            "victimes-noun"
          ]
        },
        {
          "id": "2603351",
          "text": "Les victimes furent inévitables.",
          "translation": "Жертвы были неизбежны.",
          "source": "Tatoeba #2603351 @sacredceltic / #2603360 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2603351",
          "cefr_level": "A1",
          "word_slugs": [
            "victimes-noun"
          ]
        },
        {
          "id": "12432926",
          "text": "Ne joue pas les victimes !",
          "translation": "Не строй из себя жертву!",
          "source": "Tatoeba #12432926 @Rovo / #12432930 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12432926",
          "cefr_level": "A1",
          "word_slugs": [
            "victimes-noun"
          ]
        },
        {
          "id": "2603354",
          "text": "Les victimes ont été inévitables.",
          "translation": "Жертвы были неизбежны.",
          "source": "Tatoeba #2603354 @sacredceltic / #2603360 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2603354",
          "cefr_level": "A1",
          "word_slugs": [
            "victimes-noun"
          ]
        },
        {
          "id": "13098024",
          "text": "Il y a eu de nombreuses victimes.",
          "translation": "Было много жертв.",
          "source": "Tatoeba #13098024 @lbdx / #13098107 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13098024",
          "cefr_level": "A1",
          "word_slugs": [
            "victimes-noun"
          ]
        }
