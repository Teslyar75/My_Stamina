    {
      "slug": "martin-noun",
      "lemma": "martin",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1720,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8254698",
          "text": "Le martin-pêcheur est un oiseau.",
          "translation": "Зимородок — это птица.",
          "source": "Tatoeba #8254698 @Adelpa / #13718126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8254698",
          "cefr_level": "A1",
          "word_slugs": [
            "martin-noun"
          ]
        },
        {
          "id": "7284171",
          "text": "Tom rougissait quand Martin le regardait.",
          "translation": "Том краснел, когда Мартин на него смотрел.",
          "source": "Tatoeba #7284171 @Rockaround / #8558848 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7284171",
          "cefr_level": "A1",
          "word_slugs": [
            "martin-noun"
          ]
        },
        {
          "id": "886018",
          "text": "On essaie d'impressionner les filles, Martin ?",
          "translation": "Хочешь произвести впечатление на девочек, Мартин?",
          "source": "Tatoeba #886018 @sacredceltic / #1724542 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/886018",
          "cefr_level": "A1",
          "word_slugs": [
            "martin-noun"
          ]
        },
        {
          "id": "180333",
          "text": "Dépêche-toi, Martin - nous sommes déjà bien en retard !",
          "translation": "Мартин, давай быстрей. Мы уже опаздываем!",
