          "cefr_level": "A1",
          "word_slugs": [
            "charles-name"
          ]
        },
        {
          "id": "8678047",
          "text": "Charles est au lit.",
          "translation": "Шарль лежит в постели.",
          "source": "Tatoeba #8678047 @felix63 / #8681244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8678047",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-name"
          ]
        },
        {
          "id": "8727182",
          "text": "Charles t'a demandé.",
          "translation": "Тебя Шарль спрашивал.",
          "source": "Tatoeba #8727182 @felix63 / #8728159 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8727182",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-name"
          ]
        }
