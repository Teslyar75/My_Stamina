      "examples": [
        {
          "id": "8254698",
          "text": "Le martin-pêcheur est un oiseau.",
          "translation": "Зимородок — это птица.",
          "source": "Tatoeba #8254698 @Adelpa / #13718126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8254698",
          "cefr_level": "A1",
          "word_slugs": [
            "martin-name"
          ]
        },
        {
          "id": "7284171",
          "text": "Tom rougissait quand Martin le regardait.",
          "translation": "Том краснел, когда Мартин на него смотрел.",
