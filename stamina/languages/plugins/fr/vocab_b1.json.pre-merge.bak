    {
      "slug": "majesté-noun",
      "lemma": "majesté",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1690,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1600712",
          "text": "Sa Majesté attend.",
          "translation": "Их Величество ждут.",
          "source": "Tatoeba #1600712 @sacredceltic / #1814660 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1600712",
          "cefr_level": "A1",
          "word_slugs": [
            "majesté-noun"
          ]
        },
        {
          "id": "6381794",
          "text": "Sa Majesté a-t-elle bien dormi ?",
          "translation": "Как спалось Его Величеству?",
          "source": "Tatoeba #6381794 @Blabla / #6381835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6381794",
          "cefr_level": "A1",
          "word_slugs": [
            "majesté-noun"
          ]
        },
        {
          "id": "1317987",
          "text": "J'ai dit au roi : « Votre majesté, pardonnez-moi ! »",
          "translation": "Я сказал королю: простите меня, Ваше Величество!",
          "source": "Tatoeba #1317987 @Mutusen / #2785643 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1317987",
          "cefr_level": "A1",
          "word_slugs": [
            "majesté-noun"
          ]
        },
        {
          "id": "1172087",
          "text": "J'ai dit au roi : Votre Majesté, veuillez me pardonner !",
          "translation": "Я сказал королю: \"Ваше Величество, простите меня, пожалуйста!\"",
          "source": "Tatoeba #1172087 @sacredceltic / #6317747 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1172087",
          "cefr_level": "A1",
          "word_slugs": [
            "majesté-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "f",
        "singular": "la majesté",
        "plural": "",
        "infinitive": ""
      }
    },
