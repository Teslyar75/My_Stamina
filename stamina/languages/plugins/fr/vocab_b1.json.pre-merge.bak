      "examples": [
        {
          "id": "8943924",
          "text": "Ça va mal tourner.",
          "translation": "Это плохо кончится.",
          "source": "Tatoeba #8943924 @Julien_PDC / #2401820 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8943924",
          "cefr_level": "A1",
          "word_slugs": [
            "tourner-verb"
          ]
        },
        {
          "id": "2568752",
          "text": "Veuillez tourner la page.",
          "translation": "Переверните, пожалуйста, страницу.",
          "source": "Tatoeba #2568752 @Rovo / #4586073 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2568752",
          "cefr_level": "A1",
