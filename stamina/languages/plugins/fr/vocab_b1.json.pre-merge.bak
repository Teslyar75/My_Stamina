            "bref-adj"
          ]
        },
        {
          "id": "13306615",
          "text": "Bref, chacun son interprétation.",
          "translation": "Короче, каждый интерпретирует по-своему.",
          "source": "Tatoeba #13306615 @LdjuherTaqvaylit / #13308576 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13306615",
