          ]
        },
        {
          "id": "8751356",
          "text": "Pierre est faible.",
          "translation": "Пьер слаб.",
          "source": "Tatoeba #8751356 @Adelpa / #8751491 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8751356",
