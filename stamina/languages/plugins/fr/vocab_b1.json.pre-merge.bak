    {
      "slug": "o-symbol",
      "lemma": "O",
      "pos": "symbol",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2156,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1010091",
          "text": "Tes O ressemblent à des A.",
          "translation": "Твои \"о\" похожи на \"а\".",
          "source": "Tatoeba #1010091 @elgranjuego / #1799385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1010091",
          "cefr_level": "A1",
          "word_slugs": [
            "o-symbol"
          ]
        },
        {
          "id": "591208",
          "text": "Tes \"O\" ressemblent à des \"A\".",
          "translation": "У тебя \"о\" похожи на \"а\".",
          "source": "Tatoeba #591208 @Scott / #2573593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/591208",
          "cefr_level": "A1",
          "word_slugs": [
            "o-symbol"
          ]
        },
        {
          "id": "1066065",
          "text": "Tes « o » ressemblent à des « a ».",
          "translation": "Твои \"о\" похожи на \"а\".",
          "source": "Tatoeba #1066065 @sacredceltic / #1799385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1066065",
          "cefr_level": "A1",
          "word_slugs": [
            "o-symbol"
          ]
        },
        {
          "id": "1450241",
          "text": "En espéranto, tous les noms finissent par o.",
          "translation": "В эсперанто все существительные оканчиваются на \"о\".",
          "source": "Tatoeba #1450241 @martin9 / #2478085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1450241",
          "cefr_level": "A1",
          "word_slugs": [
            "o-symbol"
          ]
        },
        {
          "id": "1503959",
          "text": "En espéranto, le substantif finit toujours par o.",
          "translation": "В эсперанто существительное всегда оканчивается на \"o\".",
          "source": "Tatoeba #1503959 @martin9 / #4256790 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1503959",
          "cefr_level": "A1",
          "word_slugs": [
            "o-symbol"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
