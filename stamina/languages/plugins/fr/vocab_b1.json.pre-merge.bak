          ]
        },
        {
          "id": "4777499",
          "text": "Nous pourrions marcher.",
          "translation": "Мы могли бы пройтись.",
          "source": "Tatoeba #4777499 @sacredceltic / #5190827 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4777499",
          "cefr_level": "A1",
