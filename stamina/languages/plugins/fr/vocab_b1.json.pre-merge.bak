    {
      "slug": "représente-verb",
      "lemma": "représente",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2485,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13187766",
          "text": "Je représente mon pays.",
          "translation": "Я представляю свою страну.",
          "source": "Tatoeba #13187766 @slahatuvelli / #13219605 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13187766",
          "cefr_level": "A1",
          "word_slugs": [
            "représente-verb"
          ]
        },
        {
          "id": "1304723",
          "text": "Qui représente la France cette année ?",
          "translation": "Кто в этом году представляет Францию?",
          "source": "Tatoeba #1304723 @rene1596 / #611950 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1304723",
          "cefr_level": "A1",
          "word_slugs": [
            "représente-verb"
          ]
        },
        {
          "id": "7089134",
          "text": "J'ignore ce que ce symbole représente.",
          "translation": "Я не знаю, что обозначает этот символ.",
          "source": "Tatoeba #7089134 @Aiji / #3007977 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7089134",
          "cefr_level": "A1",
          "word_slugs": [
            "représente-verb"
          ]
        },
        {
          "id": "7370556",
          "text": "Le mariage représente plus qu'un papier.",
          "translation": "Брак - это не просто бумажка.",
          "source": "Tatoeba #7370556 @tras / #7804794 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7370556",
          "cefr_level": "A1",
          "word_slugs": [
            "représente-verb"
          ]
        },
        {
          "id": "13960580",
          "text": "L’accélération représente une variation de vitesse.",
          "translation": "Ускорение представляет собой изменение скорости.",
          "source": "Tatoeba #13960580 @Naityahia / #13961464 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13960580",
          "cefr_level": "A1",
          "word_slugs": [
            "représente-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "représente",
        "plural": "",
        "infinitive": "représente"
      }
    },
