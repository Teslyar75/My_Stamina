          "кодекс",
          "устав"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1523342",
          "text": "Il a déjà le code !",
          "translation": "У него уже есть код!",
          "source": "Tatoeba #1523342 @martin9 / #2876122 @ainurshakirov (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1523342",
          "cefr_level": "A1",
          "word_slugs": [
            "code-noun"
          ]
        },
        {
          "id": "11411263",
          "text": "J'ai oublié mon code PIN.",
          "translation": "Я забыл свой ПИН-код.",
          "source": "Tatoeba #11411263 @lbdx / #11701060 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11411263",
          "cefr_level": "A1",
          "word_slugs": [
            "code-noun"
          ]
        },
        {
          "id": "6380858",
          "text": "Y a-t-il un code vestimentaire ?",
          "translation": "Есть какой-то дресс-код?",
