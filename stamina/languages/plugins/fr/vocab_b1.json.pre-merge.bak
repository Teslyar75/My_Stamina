    {
      "slug": "empreintes-noun",
      "lemma": "empreintes",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1702,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8682601",
          "text": "Les empreintes digitales sont uniques.",
          "translation": "Отпечатки пальцев уникальны.",
          "source": "Tatoeba #8682601 @Julien_PDC / #9057502 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8682601",
          "cefr_level": "A1",
          "word_slugs": [
            "empreintes-noun"
          ]
        },
        {
          "id": "691373",
          "text": "Nous avons trouvé des empreintes sur le sable.",
          "translation": "Мы обнаружили следы на песке.",
          "source": "Tatoeba #691373 @Scott / #2171859 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/691373",
          "cefr_level": "A1",
          "word_slugs": [
            "empreintes-noun"
          ]
        },
        {
          "id": "12004850",
          "text": "Les empreintes sur le pistolet correspondent aux vôtres.",
          "translation": "Отпечатки пальцев на пистолете совпадают с вашими.",
          "source": "Tatoeba #12004850 @lbdx / #10493182 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12004850",
          "cefr_level": "A1",
          "word_slugs": [
            "empreintes-noun"
          ]
        },
        {
          "id": "7045272",
          "text": "La police a-t-elle trouvé des empreintes digitales ?",
          "translation": "Полиция обнаружила отпечатки пальцев?",
          "source": "Tatoeba #7045272 @Aiji / #4768421 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7045272",
          "cefr_level": "A1",
          "word_slugs": [
            "empreintes-noun"
          ]
        },
        {
          "id": "5139617",
          "text": "Vos empreintes digitales ont été trouvées sur le couteau.",
          "translation": "Отпечатки ваших пальцев были обнаружены на ноже.",
          "source": "Tatoeba #5139617 @gege_veggie / #5145755 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5139617",
          "cefr_level": "A1",
          "word_slugs": [
            "empreintes-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "f",
        "singular": "la empreintes",
        "plural": "",
        "infinitive": ""
      }
