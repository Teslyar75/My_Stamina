    {
      "slug": "rues-noun",
      "lemma": "rues",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2356,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8648361",
          "text": "Les rues sont vides.",
          "translation": "Улицы пусты.",
          "source": "Tatoeba #8648361 @Julien_PDC / #7802916 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8648361",
          "cefr_level": "A1",
          "word_slugs": [
            "rues-noun"
          ]
        },
        {
          "id": "8643562",
          "text": "Les rues sont calmes.",
          "translation": "На улицах спокойно.",
          "source": "Tatoeba #8643562 @Julien_PDC / #8644782 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8643562",
          "cefr_level": "A1",
          "word_slugs": [
            "rues-noun"
          ]
        },
        {
          "id": "8315635",
          "text": "Les rues sont bondées.",
          "translation": "На улицах полно народа.",
          "source": "Tatoeba #8315635 @Julien_PDC / #11253429 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8315635",
          "cefr_level": "A1",
          "word_slugs": [
            "rues-noun"
          ]
        },
        {
          "id": "12572137",
          "text": "Je surveille les rues.",
          "translation": "Я наблюдаю за улицами.",
          "source": "Tatoeba #12572137 @LdjuherTaqvaylit / #12575439 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12572137",
          "cefr_level": "A1",
          "word_slugs": [
            "rues-noun"
          ]
        },
        {
          "id": "1549602",
          "text": "Les rues étaient vides.",
          "translation": "Улицы были пусты.",
          "source": "Tatoeba #1549602 @sacredceltic / #2729629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1549602",
          "cefr_level": "A1",
          "word_slugs": [
            "rues-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
