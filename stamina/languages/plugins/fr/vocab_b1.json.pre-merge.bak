      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8391198",
          "text": "La campagne finit lundi.",
          "translation": "Кампания заканчивается в понедельник.",
          "source": "Tatoeba #8391198 @Aiji / #7976024 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8391198",
          "cefr_level": "A1",
          "word_slugs": [
