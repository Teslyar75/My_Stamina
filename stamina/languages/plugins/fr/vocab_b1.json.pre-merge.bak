    {
      "slug": "jim-name",
      "lemma": "Jim",
      "pos": "name",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1383,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "644874",
          "text": "Où est Jim ?",
          "translation": "Где Джим?",
          "source": "Tatoeba #644874 @Micsmithel / #3613739 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/644874",
          "cefr_level": "A1",
          "word_slugs": [
            "jim-name"
          ]
        },
        {
          "id": "6480087",
          "text": "Jim exagère légèrement.",
          "translation": "Джим слегка преувеличивает.",
          "source": "Tatoeba #6480087 @Micsmithel / #6480145 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6480087",
          "cefr_level": "A1",
          "word_slugs": [
            "jim-name"
          ]
        },
        {
          "id": "1018539",
          "text": "Jim ouvre la porte.",
          "translation": "Джим открывает дверь.",
          "source": "Tatoeba #1018539 @Batko / #1582075 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1018539",
          "cefr_level": "A1",
          "word_slugs": [
            "jim-name"
          ]
        },
        {
          "id": "11728",
          "text": "Jim lit le japonais.",
          "translation": "Джим читает по-японски.",
          "source": "Tatoeba #11728 @Lulantis / #10976573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11728",
          "cefr_level": "A1",
          "word_slugs": [
            "jim-name"
          ]
        },
        {
          "id": "472737",
          "text": "Ils l'appellent Jim.",
          "translation": "Они зовут его Джимом.",
          "source": "Tatoeba #472737 @mamat / #1528837 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/472737",
          "cefr_level": "A1",
          "word_slugs": [
            "jim-name"
          ]
        }
