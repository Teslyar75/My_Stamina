      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11645326",
          "text": "Louis, réveille-toi !",
          "translation": "Луи, просыпайся!",
          "source": "Tatoeba #11645326 @felix63 / #11983464 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11645326",
          "cefr_level": "A1",
          "word_slugs": [
            "louis-noun"
          ]
        },
        {
          "id": "5844710",
          "text": "Louis rougit involontairement.",
          "translation": "Луи невольно покраснел.",
          "source": "Tatoeba #5844710 @Blabla / #6016237 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5844710",
          "cefr_level": "A1",
          "word_slugs": [
            "louis-noun"
          ]
        },
        {
          "id": "181717",
          "text": "Louis, tes amis arrivent.",
          "translation": "Луи, там твои друзья идут.",
