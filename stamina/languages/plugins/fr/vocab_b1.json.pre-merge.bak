    {
      "slug": "raconter-verb",
      "lemma": "raconter",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 1650,
      "frequency_band": "delf-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1204588",
          "text": "Je veux tout te raconter.",
          "translation": "Я хочу всё тебе рассказать.",
          "source": "Tatoeba #1204588 @Shishir / #13138509 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1204588",
          "cefr_level": "A1",
          "word_slugs": [
            "raconter-verb"
          ]
        },
        {
          "id": "8197362",
          "text": "Tu peux tout me raconter.",
          "translation": "Ты можешь всё мне рассказать.",
          "source": "Tatoeba #8197362 @felix63 / #8197368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8197362",
          "cefr_level": "A1",
          "word_slugs": [
            "raconter-verb"
          ]
        },
        {
          "id": "7157399",
          "text": "Je peux tout lui raconter.",
          "translation": "Я могу рассказать ей всё.",
          "source": "Tatoeba #7157399 @Micsmithel / #11642479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7157399",
          "cefr_level": "A1",
          "word_slugs": [
            "raconter-verb"
          ]
        },
        {
          "id": "5344213",
          "text": "Tom aime raconter des blagues.",
          "translation": "Том любит рассказывать анекдоты.",
          "source": "Tatoeba #5344213 @Aiji / #5349335 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5344213",
          "cefr_level": "A1",
          "word_slugs": [
            "raconter-verb"
          ]
        },
        {
          "id": "5242196",
          "text": "Arrête de raconter ces horreurs.",
          "translation": "Хватит рассказывать эти ужасы.",
          "source": "Tatoeba #5242196 @nimfeo / #5242212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5242196",
          "cefr_level": "A1",
          "word_slugs": [
            "raconter-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
