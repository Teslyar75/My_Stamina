    {
      "slug": "rentrée-noun",
      "lemma": "rentrée",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2317,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "возвращение"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5136757",
          "text": "Chéri, je suis rentrée.",
          "translation": "Дорогой, я дома.",
          "source": "Tatoeba #5136757 @gege_veggie / #5138382 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5136757",
          "cefr_level": "A1",
          "word_slugs": [
            "rentrée-noun"
          ]
        },
        {
          "id": "8065046",
          "text": "Je suis rentrée en bus.",
          "translation": "Я приехала домой на автобусе.",
          "source": "Tatoeba #8065046 @Aiji / #8065812 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8065046",
          "cefr_level": "A1",
          "word_slugs": [
            "rentrée-noun"
          ]
        },
        {
          "id": "3655637",
          "text": "Je suis rentrée chez moi.",
          "translation": "Я вернулась домой.",
          "source": "Tatoeba #3655637 @fleur74 / #4375129 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3655637",
          "cefr_level": "A1",
          "word_slugs": [
            "rentrée-noun"
          ]
        },
        {
          "id": "4614290",
          "text": "Je suis rentrée de Chine.",
          "translation": "Я вернулась из Китая.",
          "source": "Tatoeba #4614290 @Amastan / #4620374 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4614290",
          "cefr_level": "A1",
          "word_slugs": [
            "rentrée-noun"
          ]
        },
        {
          "id": "13855515",
          "text": "Demain, c’est la rentrée.",
          "translation": "Завтра первый учебный день.",
          "source": "Tatoeba #13855515 @casperdewith / #13855555 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13855515",
          "cefr_level": "A1",
          "word_slugs": [
            "rentrée-noun"
          ]
        }
      ],
