          "source": "Tatoeba #13755011 @madjidoumnia / #13852432 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13755011",
          "cefr_level": "A1",
          "word_slugs": [
            "soucis-noun"
          ]
        },
        {
          "id": "12966561",
          "text": "Chacun a ses propres soucis.",
          "translation": "У всех свои заботы.",
          "source": "Tatoeba #12966561 @anzart / #4934508 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12966561",
          "cefr_level": "A1",
          "word_slugs": [
            "soucis-noun"
          ]
        },
        {
          "id": "573975",
          "text": "Il n'a pas de soucis.",
          "translation": "У него нет забот.",
          "source": "Tatoeba #573975 @sacredceltic / #5484928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/573975",
          "cefr_level": "A1",
          "word_slugs": [
            "soucis-noun"
          ]
        },
        {
          "id": "12360940",
          "text": "Tu n'avais pas de soucis.",
          "translation": "У тебя не было забот.",
          "source": "Tatoeba #12360940 @Tighra_tlelli / #5398015 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12360940",
          "cefr_level": "A1",
          "word_slugs": [
            "soucis-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
