    {
      "slug": "canon-noun",
      "lemma": "canon",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "B1",
      "frequency_rank": 2350,
      "frequency_band": "delf-b1",
      "translations": {
        "ru": [
          "канон"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12342136",
          "text": "Mary est canon.",
          "translation": "Мэри — клёвая тёлка.",
          "source": "Tatoeba #12342136 @lbdx / #4698050 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12342136",
          "cefr_level": "A1",
          "word_slugs": [
            "canon-noun"
          ]
        },
        {
          "id": "1846401",
          "text": "Débarrasse-toi du canon !",
          "translation": "Брось пушку!",
          "source": "Tatoeba #1846401 @sacredceltic / #2833607 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1846401",
          "cefr_level": "A1",
          "word_slugs": [
            "canon-noun"
          ]
        },
        {
          "id": "2201038",
          "text": "C'est un vrai canon.",
          "translation": "Она настоящая бомба.",
          "source": "Tatoeba #2201038 @sacredceltic / #4028596 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2201038",
          "cefr_level": "A1",
          "word_slugs": [
            "canon-noun"
          ]
        },
        {
          "id": "909794",
          "text": "Les enfants furent utilisés comme chair à canon.",
          "translation": "Детей использовали как пушечное мясо.",
          "source": "Tatoeba #909794 @sacredceltic / #10636246 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/909794",
          "cefr_level": "A1",
          "word_slugs": [
            "canon-noun"
          ]
        },
        {
          "id": "8558582",
          "text": "Tom n'a pas inventé la poudre à canon.",
          "translation": "Том не семи пядей во лбу.",
          "source": "Tatoeba #8558582 @Micsmithel / #12087405 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8558582",
          "cefr_level": "A1",
          "word_slugs": [
            "canon-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
