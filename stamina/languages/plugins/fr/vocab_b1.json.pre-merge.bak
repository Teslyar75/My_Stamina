            "parlait-verb"
          ]
        },
        {
          "id": "8897408",
          "text": "Il parlait seul.",
          "translation": "Он разговаривал с самим собой.",
          "source": "Tatoeba #8897408 @Julien_PDC / #10132759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8897408",
          "cefr_level": "A1",
          "word_slugs": [
            "parlait-verb"
          ]
        },
        {
          "id": "12046455",
          "text": "Elle lui parlait.",
