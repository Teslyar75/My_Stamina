          ]
        },
        {
          "id": "13394433",
          "text": "Ils vont profiter de l'occasion.",
          "translation": "Они воспользуются этой возможностью.",
          "source": "Tatoeba #13394433 @Aghanim / #13394539 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13394433",
          "cefr_level": "A1",
          "word_slugs": [
            "profiter-verb"
          ]
        },
        {
          "id": "845906",
          "text": "Tu dois profiter de cette occasion.",
          "translation": "Ты должен воспользоваться этой возможностью.",
          "source": "Tatoeba #845906 @U2FS / #2773015 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/845906",
