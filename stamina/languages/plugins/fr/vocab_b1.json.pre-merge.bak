          ]
        },
        {
          "id": "2932066",
          "text": "C'est beau la campagne.",
          "translation": "За городом красиво.",
          "source": "Tatoeba #2932066 @Blabla / #10986797 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2932066",
          "cefr_level": "A1",
