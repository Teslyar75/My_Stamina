          "cefr_level": "A1",
          "word_slugs": [
            "politique-adj"
          ]
        },
        {
          "id": "4717105",
          "text": "Il adore parler politique.",
          "translation": "Он обожает говорить о политике.",
          "source": "Tatoeba #4717105 @sacredceltic / #3593142 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4717105",
          "cefr_level": "A1",
