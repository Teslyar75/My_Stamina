          ]
        },
        {
          "id": "13377784",
          "text": "Je peux vous l'assurer.",
          "translation": "Могу вас в этом уверить.",
          "source": "Tatoeba #13377784 @lbdx / #13377883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13377784",
