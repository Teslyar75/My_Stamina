      "frequency_band": "delf-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7698716",
          "text": "Susan était terrifiée.",
          "translation": "Сьюзан была в ужасе.",
          "source": "Tatoeba #7698716 @Maxence / #7827487 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7698716",
          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        },
        {
          "id": "11840",
          "text": "Susan est bonne cuisinière.",
          "translation": "Сюзан хорошо готовит.",
          "source": "Tatoeba #11840 @Lulantis / #4566954 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11840",
          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        },
        {
          "id": "439254",
          "text": "Susan tient beaucoup de sa mère.",
          "translation": "Сьюзан очень похожа на свою мать.",
