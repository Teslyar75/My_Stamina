    {
      "id": "a1-13-near-future",
      "order": 13,
      "title": "Futur proche: aller + infinitif",
      "subtitle": "Ближайшее будущее: 'собираюсь/поеду делать'",
      "topics": [
        "futur_proche"
      ],
      "prereq": [
        "a1-05-present-irregular"
      ],
      "minutes": 12,
      "theory": [
        {
          "kind": "text",
          "text": "Futur proche = aller (présent) + infinitif. Аналог русского 'собираюсь/поеду делать'. Je vais manger = Я собираюсь есть / Я поем."
        },
        {
          "kind": "rule",
          "title": "Структура",
          "text": "Sujet + aller (présent) + infinitif. Je vais partir. Nous allons manger. Ils vont arriver."
        },
        {
          "kind": "rule",
          "title": "Не путать с futur simple",
          "text": "Futur simple = одна форма (je parlerai). Futur proche = две части (je vais parler)."
        },
        {
          "kind": "example",
          "fr": "Je vais manger. Nous allons partir. Ils vont arriver.",
          "ru": "Я собираюсь есть. Мы уходим. Они приедут.",
          "note": "Aller спрягается, второй глагол — инфинитив."
        }
      ],
      "drills": [
        {
          "id": "a1-13-d01",
          "type": "choice",
          "prompt": "Je ____ (aller) manger.",
          "options": [
            "vais",
            "vas",
            "va",
            "allons"
          ],
          "answer": [
            "vais"
          ],
          "why": "Je vais + infinitif."
        },
        {
          "id": "a1-13-d02",
          "type": "choice",
          "prompt": "Nous ____ (aller) partir demain.",
          "options": [
            "allons",
            "allez",
            "vont",
            "vais"
          ],
          "answer": [
            "allons"
          ],
          "why": "Nous allons + infinitif."
        },
        {
          "id": "a1-13-d03",
          "type": "fill",
          "prompt": "Ils ____ (aller) arriver bientôt.",
          "answer": [
            "vont"
          ],
          "why": "Ils vont + infinitif."
        },
        {
          "id": "a1-13-d04",
          "type": "transform",
          "prompt": "Présent → Futur proche: 'Je mange.' → ____",
          "answer": [
            "Je vais manger."
          ],
          "why": "Aller (présent) + infinitif."
        }
      ]
    },
    {
      "id": "a1-14-imperative",
      "order": 14,
      "title": "Impératif: tu / nous / vous",
      "subtitle": "Повелительное наклонение",
      "topics": [
        "imperative"
      ],
      "prereq": [
        "a1-04-present-er"
      ],
      "minutes": 12,
      "theory": [
        {
          "kind": "text",
          "text": "Impératif существует только для tu, nous, vous. Формы = présent БЕЗ подлежащего. Глаголы на -er: tu forme БЕЗ -s."
        },
        {
          "kind": "rule",
          "title": "Формы",
          "text": "Parler: Parle! (tu), Parlons! (nous), Parlez! (vous). Finir: Finis! Finissons! Finissez! Être: Sois! Soyons! Soyez! Avoir: Aie! Ayons! Ayez!"
        },
        {
          "kind": "rule",
          "title": "Отрицание",
          "text": "Ne + verbe + pas! Ne parle pas! Ne finissons pas! Réflexif: Lève-toi! Ne te lève pas!"
        },
        {
          "kind": "example",
          "fr": "Parle français! Mangeons! Ne parlez pas!",
          "ru": "Говори по-французски! Поедим! Не говорите!",
          "note": "Tu parle (не *parles*). Réflexif: pronouns после глагола с дефисом."
        }
      ],
      "drills": [
        {
          "id": "a1-14-d01",
          "type": "choice",
          "prompt": "____ (parler) français!",
          "options": [
            "Parle",
            "Parles",
            "Parlons",
            "Parlez"
          ],
          "answer": [
            "Parle"
          ],
          "why": "Tu forme без -s для -er глаголов."
        },
        {
          "id": "a1-14-d02",
          "type": "choice",
          "prompt": "____ (finir) le travail!",
          "options": [
            "Finis",
            "Finit",
            "Finissons",
            "Finissez"
          ],
          "answer": [
            "Finis"
          ],
          "why": "Tu finis (как présent)."
        },
        {
          "id": "a1-14-d03",
          "type": "fill",
          "prompt": "____ (manger) ensemble!",
          "answer": [
            "Mangeons"
          ],
          "why": "Nous mangeons → Mangeons!"
        },
        {
          "id": "a1-14-d04",
          "type": "choice",
          "prompt": "Ne ____ (parler) pas!",
          "options": [
            "parle",
            "parles",
            "parlez",
            "parlons"
          ],
          "answer": [
            "parle"
          ],
          "why": "Отрицательный императив: ne + forme impérative + pas."
        }
      ]
    }
  ]
