          "word_slugs": [
            "gouvernement-noun"
          ]
        },
        {
          "id": "11781507",
          "text": "Le gouvernement s'en fiche.",
          "translation": "Правительству на это наплевать.",
          "source": "Tatoeba #11781507 @Rovo / #11781598 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11781507",
          "cefr_level": "A1",
