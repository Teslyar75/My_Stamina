      "cefr_level": "A2",
      "frequency_rank": 1199,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1505433",
          "text": "Beaucoup de journalistes assistèrent au procès.",
          "translation": "На процессе присутствовало много журналистов.",
          "source": "Tatoeba #1505433 @martin9 / #2563903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1505433",
          "cefr_level": "A1",
          "word_slugs": [
            "procès-noun"
          ]
        },
        {
          "id": "590674",
          "text": "Le procès se tient à huis clos.",
          "translation": "Процесс проходит при закрытых дверях.",
          "source": "Tatoeba #590674 @sacredceltic / #6887566 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/590674",
          "cefr_level": "A1",
          "word_slugs": [
            "procès-noun"
          ]
        },
        {
          "id": "12451195",
          "text": "Je suis le plaignant dans ce procès.",
          "translation": "Я в этом процессе истец.",
          "source": "Tatoeba #12451195 @lbdx / #12451730 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12451195",
          "cefr_level": "A1",
          "word_slugs": [
            "procès-noun"
          ]
        },
        {
          "id": "840506",
          "text": "On appelle cela un procès d'intention.",
          "translation": "Это называется \"осуждение за намерение\".",
          "source": "Tatoeba #840506 @U2FS / #4366032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/840506",
          "cefr_level": "A1",
          "word_slugs": [
            "procès-noun"
          ]
        },
        {
          "id": "1405410",
          "text": "Qui est prêt à écrire le procès-verbal ?",
          "translation": "Кто готов писать протокол?",
          "source": "Tatoeba #1405410 @sacredceltic / #12744132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1405410",
          "cefr_level": "A1",
          "word_slugs": [
            "procès-noun"
          ]
        }
      ],
      "tags": [
