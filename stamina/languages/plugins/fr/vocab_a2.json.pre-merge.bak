            "servir-verb"
          ]
        },
        {
          "id": "5289118",
          "text": "Je veux servir mon pays.",
          "translation": "Я хочу послужить своей стране.",
          "source": "Tatoeba #5289118 @Aiji / #5300537 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5289118",
          "cefr_level": "A1",
          "word_slugs": [
            "servir-verb"
          ]
        },
        {
          "id": "11539975",
          "text": "Tu dois servir ton maître.",
          "translation": "Ты должен служить своему хозяину.",
          "source": "Tatoeba #11539975 @Aiji / #12382089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11539975",
          "cefr_level": "A1",
          "word_slugs": [
            "servir-verb"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
