      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "общественный",
          "государственный"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2850556",
          "text": "Le public appréciera !",
          "translation": "Публике понравится!",
          "source": "Tatoeba #2850556 @nimfeo / #13236940 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2850556",
          "cefr_level": "A1",
          "word_slugs": [
            "public-adj"
          ]
        },
        {
          "id": "1268072",
          "text": "Ne jure pas en public.",
          "translation": "Не ругайся прилюдно.",
          "source": "Tatoeba #1268072 @gillux / #1828035 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1268072",
          "cefr_level": "A1",
          "word_slugs": [
            "public-adj"
          ]
        },
        {
          "id": "7527613",
          "text": "Le public ici est bon.",
          "translation": "Публика здесь хорошая.",
          "source": "Tatoeba #7527613 @Micsmithel / #8070050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7527613",
          "cefr_level": "A1",
          "word_slugs": [
            "public-adj"
          ]
        },
        {
          "id": "8696048",
          "text": "C'est un endroit public.",
          "translation": "Это общественное место.",
          "source": "Tatoeba #8696048 @Julien_PDC / #10211886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8696048",
