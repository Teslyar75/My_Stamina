    {
      "slug": "aille-verb",
      "lemma": "aille",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1037,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3625422",
          "text": "Que tout aille bien !",
          "translation": "Пусть всё будет хорошо!",
          "source": "Tatoeba #3625422 @sacredceltic / #3625809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3625422",
          "cefr_level": "A1",
          "word_slugs": [
            "aille-verb"
          ]
        },
        {
          "id": "3218964",
          "text": "Qu'il aille au Diable !",
          "translation": "Пусть идёт к чёрту!",
          "source": "Tatoeba #3218964 @sacredceltic / #3813192 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3218964",
          "cefr_level": "A1",
          "word_slugs": [
            "aille-verb"
          ]
        },
        {
          "id": "13343158",
          "text": "Qu'il aille au diable !",
