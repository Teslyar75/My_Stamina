      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1330140",
          "text": "Veuillez emmener les autres.",
          "translation": "Приведите, пожалуйста, остальных.",
          "source": "Tatoeba #1330140 @sacredceltic / #7866015 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1330140",
          "cefr_level": "A1",
          "word_slugs": [
            "emmener-verb"
          ]
        },
        {
          "id": "6071307",
          "text": "Je vais t'y emmener.",
          "translation": "Я тебя туда отведу.",
          "source": "Tatoeba #6071307 @Whidou / #7821052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6071307",
