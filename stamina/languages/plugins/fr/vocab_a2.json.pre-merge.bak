      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "бабки",
          "бабло"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13234468",
          "text": "Il a le fric.",
          "translation": "У него есть бабло.",
          "source": "Tatoeba #13234468 @LdjuherTaqvaylit / #13240791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13234468",
          "cefr_level": "A1",
          "word_slugs": [
            "fric-noun"
          ]
        },
        {
          "id": "11814506",
          "text": "Tom a du fric.",
          "translation": "У Тома есть бабки.",
          "source": "Tatoeba #11814506 @Adelpa / #11814665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11814506",
          "cefr_level": "A1",
          "word_slugs": [
            "fric-noun"
          ]
        },
        {
          "id": "5318709",
          "text": "Il est bourré de fric.",
          "translation": "У него полно бабла.",
          "source": "Tatoeba #5318709 @Blabla / #5428463 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5318709",
          "cefr_level": "A1",
          "word_slugs": [
            "fric-noun"
          ]
        },
        {
          "id": "6850036",
          "text": "Tom ne pense qu'au fric.",
          "translation": "Том только о деньгах и думает.",
          "source": "Tatoeba #6850036 @Blabla / #6850048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6850036",
          "cefr_level": "A1",
          "word_slugs": [
            "fric-noun"
          ]
        },
        {
          "id": "1533473",
          "text": "Prends le fric et tire-toi !",
          "translation": "Бери бабки и отваливай!",
          "source": "Tatoeba #1533473 @sacredceltic / #2345453 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1533473",
          "cefr_level": "A1",
