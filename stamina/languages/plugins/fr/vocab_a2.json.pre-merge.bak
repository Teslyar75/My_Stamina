      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11976507",
          "text": "Elle compte dix millions d'habitants.",
          "translation": "Она насчитывает десять миллионов жителей.",
          "source": "Tatoeba #11976507 @Rafik / #11976607 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11976507",
          "cefr_level": "A1",
          "word_slugs": [
            "millions-noun"
          ]
        },
        {
          "id": "3047542",
          "text": "Tatoeba a presque 3 millions de phrases !",
          "translation": "На Татоэбе почти 3 миллиона предложений!",
          "source": "Tatoeba #3047542 @mervert1 / #3092068 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3047542",
          "cefr_level": "A1",
          "word_slugs": [
            "millions-noun"
          ]
        },
        {
          "id": "9354537",
          "text": "Des millions de personnes nous soutiennent.",
          "translation": "Нас поддерживает множество людей.",
          "source": "Tatoeba #9354537 @Julien_PDC / #10181956 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9354537",
          "cefr_level": "A1",
          "word_slugs": [
            "millions-noun"
          ]
        },
        {
          "id": "13960441",
          "text": "Internet connecte des millions d'ordinateurs.",
          "translation": "Интернет связывает миллионы компьютеров.",
          "source": "Tatoeba #13960441 @Naityahia / #13960799 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13960441",
          "cefr_level": "A1",
          "word_slugs": [
            "millions-noun"
          ]
        },
        {
          "id": "8698620",
          "text": "Il y a trois millions d'habitants.",
          "translation": "Там три миллиона жителей.",
          "source": "Tatoeba #8698620 @Julien_PDC / #10641633 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8698620",
          "cefr_level": "A1",
          "word_slugs": [
            "millions-noun"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
