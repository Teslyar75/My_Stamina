            "gouvernement-noun"
          ]
        },
        {
          "id": "12803171",
          "text": "Le gouvernement ment continuellement.",
          "translation": "Правительство постоянно врёт.",
          "source": "Tatoeba #12803171 @Rovo / #13311665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12803171",
