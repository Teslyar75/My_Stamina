      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13065548",
          "text": "Il agit seul.",
          "translation": "Он действует в одиночку.",
          "source": "Tatoeba #13065548 @felix63 / #13067239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13065548",
