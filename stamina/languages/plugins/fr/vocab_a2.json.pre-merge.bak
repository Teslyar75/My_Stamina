            "paris-name"
          ]
        },
        {
          "id": "13684774",
          "text": "Paris est grand.",
          "translation": "Париж большой.",
          "source": "Tatoeba #13684774 @Adelpa / #13684787 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13684774",
          "cefr_level": "A1",
