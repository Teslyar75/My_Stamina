      "frequency_rank": 1188,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3245349",
          "text": "Qui peut l'empêcher ?",
          "translation": "Кто может этому помешать?",
          "source": "Tatoeba #3245349 @sacredceltic / #3539944 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3245349",
          "cefr_level": "A1",
          "word_slugs": [
            "empêcher-verb"
          ]
        },
        {
          "id": "11670504",
          "text": "J’aurais pu l’empêcher.",
          "translation": "Я бы мог это предотвратить.",
          "source": "Tatoeba #11670504 @Bernie75 / #3616121 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11670504",
          "cefr_level": "A1",
          "word_slugs": [
            "empêcher-verb"
          ]
        },
        {
          "id": "5800802",
          "text": "Je ne pouvais m'en empêcher.",
          "translation": "Я не мог удержаться.",
          "source": "Tatoeba #5800802 @Toynop / #6317268 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5800802",
          "cefr_level": "A1",
          "word_slugs": [
            "empêcher-verb"
          ]
        },
        {
          "id": "12621682",
          "text": "J'ai essayé d'empêcher cela.",
          "translation": "Я пытался этому помешать.",
          "source": "Tatoeba #12621682 @lbdx / #12625236 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12621682",
          "cefr_level": "A1",
          "word_slugs": [
            "empêcher-verb"
          ]
        },
        {
          "id": "11406834",
          "text": "On a essayé de vous empêcher.",
          "translation": "Мы пытались вам помешать.",
          "source": "Tatoeba #11406834 @LdjuherTaqvaylit / #11448107 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11406834",
          "cefr_level": "A1",
          "word_slugs": [
            "empêcher-verb"
          ]
        }
      ],
