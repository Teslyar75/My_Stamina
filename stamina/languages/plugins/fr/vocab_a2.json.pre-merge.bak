    {
      "slug": "mike-noun",
      "lemma": "mike",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 959,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "537273",
          "text": "Mike a souri.",
          "translation": "Майк улыбнулся.",
          "source": "Tatoeba #537273 @SUZIE / #3621373 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/537273",
          "cefr_level": "A1",
          "word_slugs": [
            "mike-noun"
          ]
        },
        {
          "id": "5255293",
          "text": "Bonjour, dit Mike.",
          "translation": "\"Здравствуйте\", - сказал Майк.",
          "source": "Tatoeba #5255293 @martin9 / #12958919 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5255293",
          "cefr_level": "A1",
          "word_slugs": [
            "mike-noun"
          ]
        },
        {
          "id": "127759",
          "text": "Je l'appelle Mike.",
          "translation": "Я зову его Майк.",
          "source": "Tatoeba #127759 @Micsmithel / #445256 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/127759",
          "cefr_level": "A1",
          "word_slugs": [
            "mike-noun"
          ]
        },
        {
          "id": "7499217",
          "text": "Mike attend en bas.",
          "translation": "Майк ждёт внизу.",
          "source": "Tatoeba #7499217 @Micsmithel / #3299835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7499217",
          "cefr_level": "A1",
          "word_slugs": [
            "mike-noun"
          ]
        },
        {
          "id": "548946",
          "text": "Mike a deux copines.",
          "translation": "У Майка две девушки.",
          "source": "Tatoeba #548946 @Scott / #7758416 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/548946",
          "cefr_level": "A1",
          "word_slugs": [
            "mike-noun"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
