    {
      "slug": "apparemment-adv",
      "lemma": "apparemment",
      "pos": "adv",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1175,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4047855",
          "text": "Apparemment, j'avais tort.",
          "translation": "Видимо, я ошибался.",
          "source": "Tatoeba #4047855 @maydoo / #11651467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4047855",
          "cefr_level": "A1",
          "word_slugs": [
            "apparemment-adv"
          ]
        },
        {
          "id": "12321440",
          "text": "Apparemment c'est interdit.",
          "translation": "Очевидно, это запрещено.",
          "source": "Tatoeba #12321440 @Odhran_Gwydhenn / #12404398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12321440",
          "cefr_level": "A1",
          "word_slugs": [
            "apparemment-adv"
          ]
        },
        {
          "id": "4047854",
          "text": "Apparemment, ça a fonctionné.",
          "translation": "Видимо, это сработало.",
          "source": "Tatoeba #4047854 @maydoo / #3055571 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4047854",
          "cefr_level": "A1",
          "word_slugs": [
            "apparemment-adv"
          ]
        },
        {
          "id": "7839598",
          "text": "Apparemment, personne ne remarqua.",
          "translation": "Очевидно, никто не заметил.",
          "source": "Tatoeba #7839598 @sacredceltic / #7861789 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7839598",
          "cefr_level": "A1",
          "word_slugs": [
            "apparemment-adv"
          ]
        },
        {
          "id": "4860275",
          "text": "Apparemment, guère n'a changé.",
          "translation": "Очевидно, мало что изменилось.",
          "source": "Tatoeba #4860275 @sacredceltic / #4684439 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4860275",
          "cefr_level": "A1",
          "word_slugs": [
            "apparemment-adv"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
