      "examples": [
        {
          "id": "181261",
          "text": "Auriez-vous l'heure ?",
          "translation": "Не подскажете, который час?",
          "source": "Tatoeba #181261 @wilouf / #944707 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/181261",
          "cefr_level": "A1",
