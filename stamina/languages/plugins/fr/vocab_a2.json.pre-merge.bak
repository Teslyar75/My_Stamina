          "cefr_level": "A1",
          "word_slugs": [
            "gamin-noun"
          ]
        },
        {
          "id": "1975590",
          "text": "Un gamin peut rêver, non ?",
          "translation": "Может же мальчишка помечтать?",
          "source": "Tatoeba #1975590 @nimfeo / #13930454 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1975590",
          "cefr_level": "A1",
          "word_slugs": [
            "gamin-noun"
          ]
        },
        {
          "id": "7777974",
          "text": "Je ne suis plus un gamin.",
          "translation": "Я уже не мальчик.",
