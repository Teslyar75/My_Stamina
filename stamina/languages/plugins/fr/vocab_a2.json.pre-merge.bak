    {
      "slug": "servir-verb",
      "lemma": "servir",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1107,
      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "служить"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8748604",
          "text": "Ça va lui servir.",
          "translation": "Это ему пригодится.",
          "source": "Tatoeba #8748604 @Adelpa / #8755179 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8748604",
          "cefr_level": "A1",
          "word_slugs": [
            "servir-verb"
          ]
        },
        {
          "id": "559176",
          "text": "Servir de préférence frais.",
          "translation": "Лучше подавать холодным.",
          "source": "Tatoeba #559176 @sacredceltic / #10611080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/559176",
          "cefr_level": "A1",
          "word_slugs": [
            "servir-verb"
          ]
        },
        {
          "id": "2505026",
          "text": "Je n'aime pas servir.",
          "translation": "Не люблю прислуживать.",
