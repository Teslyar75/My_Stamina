    {
      "slug": "bravo-noun",
      "lemma": "bravo",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1181,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12436789",
          "text": "Bravo ! C'est la bonne réponse !",
          "translation": "Браво! Это правильный ответ!",
          "source": "Tatoeba #12436789 @LdjuherTaqvaylit / #12436840 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12436789",
          "cefr_level": "A1",
          "word_slugs": [
            "bravo-noun"
          ]
        },
        {
          "id": "11349044",
          "text": "Comment dit-on « bravo » en allemand ?",
          "translation": "Как будет \"браво\" по-немецки?",
          "source": "Tatoeba #11349044 @felix63 / #11864067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11349044",
          "cefr_level": "A1",
          "word_slugs": [
            "bravo-noun"
          ]
        },
        {
          "id": "3005338",
          "text": "Bravo, Tom ! C'est toi le meilleur !",
          "translation": "Браво, Том! Ты лучше всех!",
          "source": "Tatoeba #3005338 @Blabla / #3308421 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3005338",
          "cefr_level": "A1",
          "word_slugs": [
            "bravo-noun"
          ]
        },
        {
          "id": "3865834",
          "text": "Il portait une veste bleue sur laquelle était écrit : « Bravo ».",
          "translation": "Он был в синей куртке с надписью \"Браво\".",
          "source": "Tatoeba #3865834 @Amastan / #12296354 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3865834",
          "cefr_level": "A1",
          "word_slugs": [
            "bravo-noun"
          ]
        }
      ],
