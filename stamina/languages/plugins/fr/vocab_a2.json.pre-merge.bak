    {
      "slug": "sentir-verb",
      "lemma": "sentir",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 989,
      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "чувствовать",
          "чуять"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6062061",
          "text": "Vivre c'est sentir.",
          "translation": "Жить – значит чувствовать.",
          "source": "Tatoeba #6062061 @sicerabibax / #6061934 @sergiomelo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6062061",
          "cefr_level": "A1",
          "word_slugs": [
            "sentir-verb"
          ]
        },
        {
          "id": "8237293",
          "text": "Tu dois te sentir mieux.",
          "translation": "Ты, должно быть, чувствуешь себя лучше.",
          "source": "Tatoeba #8237293 @Verena / #14099270 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8237293",
          "cefr_level": "A1",
          "word_slugs": [
            "sentir-verb"
          ]
        },
        {
          "id": "4652570",
          "text": "Vous n'allez rien sentir.",
          "translation": "Вы ничего не почувствуете.",
          "source": "Tatoeba #4652570 @sicerabibax / #3258882 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4652570",
          "cefr_level": "A1",
          "word_slugs": [
            "sentir-verb"
          ]
        },
        {
          "id": "4138826",
          "text": "Devrais-je me sentir mal ?",
          "translation": "Я должен чувствовать себя плохо?",
          "source": "Tatoeba #4138826 @sacredceltic / #4121713 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4138826",
