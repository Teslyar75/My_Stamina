    {
      "slug": "colonel-adj",
      "lemma": "colonel",
      "pos": "adj",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1150,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2878957",
          "text": "Il a été promu colonel.",
          "translation": "Он получил звание полковника.",
          "source": "Tatoeba #2878957 @Rovo / #4581791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2878957",
          "cefr_level": "A1",
          "word_slugs": [
            "colonel-adj"
          ]
        },
        {
          "id": "8489762",
          "text": "Pas de lettre pour le colonel.",
          "translation": "Полковнику никто не пишет.",
          "source": "Tatoeba #8489762 @samir_t / #10888292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8489762",
          "cefr_level": "A1",
          "word_slugs": [
            "colonel-adj"
          ]
        },
        {
          "id": "8959164",
          "text": "Le colonel était rouge de colère.",
          "translation": "Полковник покраснел от гнева.",
          "source": "Tatoeba #8959164 @lbdx / #8959182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8959164",
          "cefr_level": "A1",
          "word_slugs": [
            "colonel-adj"
          ]
        },
        {
          "id": "5551365",
          "text": "Tom a atteint le grade de colonel.",
          "translation": "Том дослужился до полковника.",
          "source": "Tatoeba #5551365 @nimfeo / #6166658 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551365",
          "cefr_level": "A1",
          "word_slugs": [
            "colonel-adj"
          ]
        },
        {
          "id": "2878959",
          "text": "Il a été promu au grade de colonel.",
          "translation": "Он получил звание полковника.",
          "source": "Tatoeba #2878959 @Rovo / #4581791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2878959",
          "cefr_level": "A1",
          "word_slugs": [
            "colonel-adj"
          ]
        }
      ],
