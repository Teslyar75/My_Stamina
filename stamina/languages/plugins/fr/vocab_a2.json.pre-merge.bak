      "gender": null,
      "examples": [
        {
          "id": "2076923",
          "text": "Ils seront prêts.",
          "translation": "Они будут готовы.",
          "source": "Tatoeba #2076923 @Amastan / #10836264 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2076923",
