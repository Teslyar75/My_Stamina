    {
      "slug": "mecs-noun",
      "lemma": "mecs",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1033,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12798759",
          "text": "Attendez-moi, les mecs !",
          "translation": "Ребята, подождите меня.",
          "source": "Tatoeba #12798759 @Rovo / #13707281 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12798759",
          "cefr_level": "A1",
          "word_slugs": [
            "mecs-noun"
          ]
        },
        {
          "id": "2382294",
          "text": "Les mecs, je vous adore.",
          "translation": "Парни, я вас обожаю.",
          "source": "Tatoeba #2382294 @sacredceltic / #8250602 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2382294",
          "cefr_level": "A1",
          "word_slugs": [
            "mecs-noun"
          ]
        },
        {
          "id": "7073066",
          "text": "Les mecs parlent trop peu.",
          "translation": "Парни слишком мало говорят.",
          "source": "Tatoeba #7073066 @verymuchso / #10688459 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7073066",
          "cefr_level": "A1",
          "word_slugs": [
            "mecs-noun"
          ]
        },
        {
          "id": "4737388",
          "text": "Regarde ! Deux mecs se battent.",
          "translation": "Гляди! Два пацана дерутся.",
          "source": "Tatoeba #4737388 @lovasoa / #3694294 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4737388",
          "cefr_level": "A1",
          "word_slugs": [
            "mecs-noun"
          ]
        },
        {
          "id": "12034457",
          "text": "Je suis différent des autres mecs.",
          "translation": "Я не такой, как другие парни.",
          "source": "Tatoeba #12034457 @lbdx / #12037176 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12034457",
          "cefr_level": "A1",
          "word_slugs": [
            "mecs-noun"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
