    {
      "slug": "vaisseau-noun",
      "lemma": "vaisseau",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1026,
      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "сосуд"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "11542335",
          "text": "Retournez au vaisseau.",
          "translation": "Возвращайтесь на судно.",
          "source": "Tatoeba #11542335 @Aiji / #12946263 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11542335",
          "cefr_level": "A1",
          "word_slugs": [
            "vaisseau-noun"
          ]
        },
        {
          "id": "8447896",
          "text": "Un vaisseau est en détresse.",
          "translation": "Судно терпит бедствие.",
          "source": "Tatoeba #8447896 @Aiji / #7812321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8447896",
          "cefr_level": "A1",
          "word_slugs": [
            "vaisseau-noun"
          ]
        },
        {
          "id": "7973395",
          "text": "Nous devons retourner au vaisseau.",
          "translation": "Мы должны вернуться на судно.",
          "source": "Tatoeba #7973395 @Micsmithel / #7973402 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7973395",
          "cefr_level": "A1",
          "word_slugs": [
            "vaisseau-noun"
          ]
        },
        {
          "id": "11611033",
          "text": "Le chameau est le vaisseau du désert.",
          "translation": "Верблюд - корабль пустыни.",
          "source": "Tatoeba #11611033 @Adelpa / #639652 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11611033",
          "cefr_level": "A1",
          "word_slugs": [
            "vaisseau-noun"
          ]
        },
        {
          "id": "1450860",
          "text": "Le vaisseau spatial atteindra bientôt la Lune.",
          "translation": "Космический корабль скоро достигнет Луны.",
          "source": "Tatoeba #1450860 @sacredceltic / #2738692 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1450860",
          "cefr_level": "A1",
          "word_slugs": [
            "vaisseau-noun"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "m",
        "singular": "le vaisseau",
        "plural": "",
