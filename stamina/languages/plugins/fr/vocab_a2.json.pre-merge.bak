      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11652627",
          "text": "Le gouvernement nous ment.",
          "translation": "Правительство нам лжёт.",
          "source": "Tatoeba #11652627 @Adelpa / #12499996 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11652627",
          "cefr_level": "A1",
