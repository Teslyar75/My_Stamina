    {
      "slug": "suppose-verb",
      "lemma": "suppose",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 653,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4594744",
          "text": "Je le suppose.",
          "translation": "Полагаю, что так.",
          "source": "Tatoeba #4594744 @sacredceltic / #4682128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4594744",
          "cefr_level": "A1",
          "word_slugs": [
            "suppose-verb"
          ]
        },
        {
          "id": "4681994",
          "text": "Je suppose que non.",
          "translation": "Полагаю, что нет.",
          "source": "Tatoeba #4681994 @sacredceltic / #5885441 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4681994",
          "cefr_level": "A1",
          "word_slugs": [
            "suppose-verb"
          ]
        },
        {
          "id": "9548902",
          "text": "Je suppose que oui.",
          "translation": "Полагаю, что да.",
          "source": "Tatoeba #9548902 @Julien_PDC / #10546541 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9548902",
          "cefr_level": "A1",
          "word_slugs": [
            "suppose-verb"
          ]
        },
        {
          "id": "4682072",
          "text": "Je suppose que nous pourrions.",
          "translation": "Я полагаю, мы могли бы.",
          "source": "Tatoeba #4682072 @sacredceltic / #5761698 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4682072",
          "cefr_level": "A1",
          "word_slugs": [
            "suppose-verb"
          ]
        },
        {
