          "cefr_level": "A1",
          "word_slugs": [
            "retrouver-verb"
          ]
        },
        {
          "id": "8676897",
          "text": "Nous devons retrouver les traîtres.",
          "translation": "Мы должны найти предателей.",
          "source": "Tatoeba #8676897 @Julien_PDC / #10139725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8676897",
          "cefr_level": "A1",
          "word_slugs": [
            "retrouver-verb"
          ]
        },
        {
          "id": "9161098",
          "text": "Je vais essayer de le retrouver.",
          "translation": "Я попробую его найти.",
          "source": "Tatoeba #9161098 @Julien_PDC / #9180532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9161098",
          "cefr_level": "A1",
          "word_slugs": [
            "retrouver-verb"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
