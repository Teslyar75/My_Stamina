          ]
        },
        {
          "id": "10498262",
          "text": "Le début est facile.",
          "translation": "Начало простое.",
          "source": "Tatoeba #10498262 @pkill / #13223520 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10498262",
          "cefr_level": "A1",
