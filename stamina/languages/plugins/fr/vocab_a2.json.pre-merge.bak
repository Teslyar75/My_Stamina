      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "невредимый"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "10322576",
          "text": "Tout sauf ça !",
          "translation": "Всё что угодно, только не это!",
          "source": "Tatoeba #10322576 @felix63 / #11363750 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10322576",
          "cefr_level": "A1",
          "word_slugs": [
