            "devais-verb"
          ]
        },
        {
          "id": "5434809",
          "text": "Je devais être sûr.",
          "translation": "Я должен был быть уверен.",
          "source": "Tatoeba #5434809 @pititnatole / #5434846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5434809",
          "cefr_level": "A1",
          "word_slugs": [
            "devais-verb"
          ]
        },
        {
          "id": "10722622",
          "text": "Je devais le faire.",
          "translation": "Я должен был это сделать.",
          "source": "Tatoeba #10722622 @Fenrir / #11462163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10722622",
