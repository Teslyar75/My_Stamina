          ]
        },
        {
          "id": "11151382",
          "text": "Tom va sûrement venir.",
          "translation": "Том точно придёт.",
          "source": "Tatoeba #11151382 @felix63 / #5498684 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11151382",
          "cefr_level": "A1",
          "word_slugs": [
            "sûrement-adv"
          ]
        },
        {
          "id": "534926",
          "text": "Lucie va sûrement venir.",
          "translation": "Люси обязательно придёт.",
          "source": "Tatoeba #534926 @zmoo / #534580 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/534926",
          "cefr_level": "A1",
          "word_slugs": [
