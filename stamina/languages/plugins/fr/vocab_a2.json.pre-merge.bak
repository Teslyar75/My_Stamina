    {
      "slug": "puisse-verb",
      "lemma": "puisse",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 720,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1395169",
          "text": "Puisse Dieu t'entendre !",
          "translation": "Да услышит тебя Господь!",
          "source": "Tatoeba #1395169 @sacredceltic / #11518245 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1395169",
          "cefr_level": "A1",
          "word_slugs": [
            "puisse-verb"
          ]
        },
        {
          "id": "5959453",
          "text": "Espérons que cela puisse continuer.",
          "translation": "Будем надеяться, что это сможет продолжиться.",
          "source": "Tatoeba #5959453 @Aiji / #5963041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5959453",
          "cefr_level": "A1",
          "word_slugs": [
            "puisse-verb"
          ]
        },
        {
          "id": "13376594",
          "text": "Pourvu qu'il puisse y arriver.",
          "translation": "Только бы у него получилось.",
          "source": "Tatoeba #13376594 @LdjuherTaqvaylit / #13376602 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13376594",
          "cefr_level": "A1",
          "word_slugs": [
            "puisse-verb"
          ]
        },
        {
          "id": "5684520",
          "text": "Puisse ton âme reposer en paix.",
          "translation": "Да упокоится твоя душа с миром.",
          "source": "Tatoeba #5684520 @Yemana / #3766773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5684520",
          "cefr_level": "A1",
          "word_slugs": [
            "puisse-verb"
          ]
        },
        {
          "id": "5179103",
          "text": "Espérons que Tom puisse réparer ça.",
          "translation": "Будем надеяться, Том сможет это починить.",
          "source": "Tatoeba #5179103 @bodomdeneige / #7953034 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5179103",
          "cefr_level": "A1",
          "word_slugs": [
            "puisse-verb"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "puisse",
        "plural": "",
        "infinitive": "puisse"
      }
    },
    {
      "slug": "écoutez-verb",
      "lemma": "écoutez",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 721,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1842499",
          "text": "M'écoutez-vous ?",
          "translation": "Вы меня слушаете?",
          "source": "Tatoeba #1842499 @sacredceltic / #3176595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1842499",
          "cefr_level": "A1",
          "word_slugs": [
            "écoutez-verb"
          ]
        },
        {
          "id": "6365692",
          "text": "Eh, écoutez ceci.",
          "translation": "Эй, послушайте-ка это.",
          "source": "Tatoeba #6365692 @Aiji / #6382237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6365692",
          "cefr_level": "A1",
          "word_slugs": [
            "écoutez-verb"
          ]
        },
        {
          "id": "8304828",
          "text": "Écoutez-moi bien !",
          "translation": "Слушайте меня внимательно.",
          "source": "Tatoeba #8304828 @Micsmithel / #1496322 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8304828",
          "cefr_level": "A1",
          "word_slugs": [
            "écoutez-verb"
          ]
        },
        {
          "id": "810288",
          "text": "Écoutez, vous tous.",
          "translation": "Слушайте все.",
          "source": "Tatoeba #810288 @sacredceltic / #580353 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/810288",
          "cefr_level": "A1",
          "word_slugs": [
            "écoutez-verb"
          ]
        },
        {
          "id": "11445806",
          "text": "Écoutez votre père.",
          "translation": "Слушайте отца.",
          "source": "Tatoeba #11445806 @Fenrir / #13054028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11445806",
          "cefr_level": "A1",
          "word_slugs": [
            "écoutez-verb"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
