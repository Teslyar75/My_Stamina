    {
      "slug": "tenir-verb",
      "lemma": "tenir",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 900,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1159084",
          "text": "À quoi se tenir ?",
          "translation": "За что держаться?",
          "source": "Tatoeba #1159084 @sacredceltic / #9004751 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1159084",
          "cefr_level": "A1",
          "word_slugs": [
            "tenir-verb"
          ]
        },
        {
          "id": "5682901",
          "text": "On doit tenir parole.",
          "translation": "Надо держать слово.",
          "source": "Tatoeba #5682901 @nimfeo / #5683119 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5682901",
          "cefr_level": "A1",
          "word_slugs": [
            "tenir-verb"
          ]
        },
        {
          "id": "13821519",
          "text": "Va lui tenir compagnie.",
          "translation": "Иди составь ему компанию.",
          "source": "Tatoeba #13821519 @slahatuvelli / #13821639 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13821519",
          "cefr_level": "A1",
          "word_slugs": [
            "tenir-verb"
          ]
        },
        {
          "id": "1835350",
          "text": "Veuillez le tenir secret.",
          "translation": "Будьте добры держать это в тайне.",
          "source": "Tatoeba #1835350 @sacredceltic / #1976148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1835350",
          "cefr_level": "A1",
          "word_slugs": [
            "tenir-verb"
          ]
        },
        {
          "id": "3399297",
