    {
      "slug": "joe-name",
      "lemma": "Joe",
      "pos": "name",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 954,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7813018",
          "text": "Où est-ce que Joe est allé ?",
          "translation": "Куда Джо пошёл?",
          "source": "Tatoeba #7813018 @felix63 / #11632886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7813018",
          "cefr_level": "A1",
          "word_slugs": [
            "joe-name"
          ]
        },
        {
          "id": "2124400",
          "text": "Joe a insisté pour que je paye.",
          "translation": "Джо настоял на том, чтобы я заплатил.",
          "source": "Tatoeba #2124400 @pierrephi / #11782198 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2124400",
          "cefr_level": "A1",
          "word_slugs": [
            "joe-name"
          ]
        },
        {
          "id": "788576",
          "text": "Joe et moi avons vu un lion hier.",
          "translation": "Мы с Джо видели вчера льва.",
          "source": "Tatoeba #788576 @siggg / #1002281 @arseniiv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/788576",
          "cefr_level": "A1",
          "word_slugs": [
            "joe-name"
          ]
        },
        {
          "id": "392036",
          "text": "Bonjour. C'est Joe Carlton. Puis-je parler à Michael ?",
          "translation": "Добрый день. Это Джо Карлтон. Можно поговорить с Майклом?",
          "source": "Tatoeba #392036 @Sushiman / #3294402 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/392036",
          "cefr_level": "A1",
          "word_slugs": [
            "joe-name"
          ]
        }
      ],
