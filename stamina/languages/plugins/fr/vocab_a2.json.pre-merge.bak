    {
      "slug": "seigneur-noun",
      "lemma": "seigneur",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 649,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1204179",
          "text": "Seigneur, écoute ma prière !",
          "translation": "Боже, услышь мои молитвы!",
          "source": "Tatoeba #1204179 @rene1596 / #1195809 @Keiden (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1204179",
          "cefr_level": "A1",
          "word_slugs": [
            "seigneur-noun"
          ]
        },
        {
          "id": "6697954",
          "text": "Que le Seigneur soit avec vous.",
          "translation": "Да пребудет с вами Господь.",
