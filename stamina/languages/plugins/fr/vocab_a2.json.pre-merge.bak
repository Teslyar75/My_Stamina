      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1075,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "430348",
          "text": "IA signifie Intelligence Artificielle.",
          "translation": "ИИ означает \"искусственный интеллект\".",
          "source": "Tatoeba #430348 @slist / #2150745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/430348",
          "cefr_level": "A1",
          "word_slugs": [
            "ia-name"
          ]
        },
        {
          "id": "14054370",
          "text": "C'est de l'IA.",
          "translation": "Это ИИ.",
          "source": "Tatoeba #14054370 @Rovo / #14052187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14054370",
          "cefr_level": "A1",
          "word_slugs": [
            "ia-name"
          ]
        },
        {
          "id": "13285165",
          "text": "L'IA n'existe pas.",
          "translation": "ИИ не существует.",
          "source": "Tatoeba #13285165 @Adelpa / #13287973 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13285165",
          "cefr_level": "A1",
          "word_slugs": [
            "ia-name"
          ]
        },
        {
          "id": "13582728",
          "text": "L'IA peut commettre des erreurs.",
          "translation": "ИИ может ошибаться.",
          "source": "Tatoeba #13582728 @carlosalberto / #13581615 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13582728",
          "cefr_level": "A1",
          "word_slugs": [
            "ia-name"
          ]
        },
        {
          "id": "12030891",
          "text": "Quels métiers seront remplacés par l'IA ?",
          "translation": "Какие профессии заменит ИИ?",
          "source": "Tatoeba #12030891 @lbdx / #12030892 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12030891",
          "cefr_level": "A1",
          "word_slugs": [
            "ia-name"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
