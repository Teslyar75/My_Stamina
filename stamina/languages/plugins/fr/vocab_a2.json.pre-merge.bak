      "gender": "f",
      "examples": [
        {
          "id": "10344349",
          "text": "Quelle impayable scène !",
          "translation": "Какая уморительная сцена!",
          "source": "Tatoeba #10344349 @Julien_PDC / #11672195 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10344349",
          "cefr_level": "A1",
