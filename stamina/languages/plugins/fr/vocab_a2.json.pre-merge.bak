    {
      "slug": "lycée-noun",
      "lemma": "lycée",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1186,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6326971",
          "text": "Tom va au lycée.",
          "translation": "Том ходит в лицей.",
          "source": "Tatoeba #6326971 @felix63 / #6327051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326971",
          "cefr_level": "A1",
          "word_slugs": [
            "lycée-noun"
          ]
        },
        {
          "id": "1354200",
          "text": "J'ai été expulsée du lycée.",
          "translation": "Меня выгнали из гимназии.",
          "source": "Tatoeba #1354200 @sacredceltic / #13487246 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1354200",
          "cefr_level": "A1",
          "word_slugs": [
            "lycée-noun"
          ]
        },
        {
          "id": "1823341",
          "text": "J'ai la nostalgie du lycée.",
          "translation": "Я скучаю по лицею.",
          "source": "Tatoeba #1823341 @sacredceltic / #3686499 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1823341",
          "cefr_level": "A1",
          "word_slugs": [
            "lycée-noun"
          ]
        },
        {
          "id": "12730865",
          "text": "Ils marchent pour aller au lycée.",
          "translation": "Они идут до лицея пешком.",
          "source": "Tatoeba #12730865 @sad15 / #12731376 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12730865",
          "cefr_level": "A1",
          "word_slugs": [
            "lycée-noun"
          ]
        },
        {
          "id": "8703611",
          "text": "Tom enseigne le français dans un lycée.",
          "translation": "Том преподаёт французский в лицее.",
          "source": "Tatoeba #8703611 @Julien_PDC / #8706152 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8703611",
          "cefr_level": "A1",
          "word_slugs": [
            "lycée-noun"
          ]
        }
