    {
      "slug": "vouloir-verb",
      "lemma": "vouloir",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 902,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3596",
          "text": "Vouloir c'est pouvoir.",
          "translation": "Всё возможно - было бы желание.",
          "source": "Tatoeba #3596 @le_petit_ane_gris / #5646 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3596",
          "cefr_level": "A1",
          "word_slugs": [
            "vouloir-verb"
          ]
        },
        {
          "id": "1285716",
          "text": "Vouloir, c'est pouvoir.",
          "translation": "Хотеть - значит мочь.",
          "source": "Tatoeba #1285716 @enteka / #2461952 @dimitris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1285716",
          "cefr_level": "A1",
          "word_slugs": [
            "vouloir-verb"
          ]
        },
        {
          "id": "2471793",
          "text": "Tu es sûr de vouloir ?",
          "translation": "Ты уверен, что хочешь?",
          "source": "Tatoeba #2471793 @arnxy20 / #3515038 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2471793",
          "cefr_level": "A1",
          "word_slugs": [
            "vouloir-verb"
          ]
        },
        {
          "id": "7414074",
          "text": "Vous allez vouloir voir ça.",
          "translation": "Вы захотите на это посмотреть.",
          "source": "Tatoeba #7414074 @lbdx / #7417759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7414074",
          "cefr_level": "A1",
          "word_slugs": [
            "vouloir-verb"
          ]
        },
        {
          "id": "12678270",
          "text": "Agis selon ton bon vouloir.",
          "translation": "Поступай как хочешь.",
          "source": "Tatoeba #12678270 @anzart / #13061602 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12678270",
          "cefr_level": "A1",
          "word_slugs": [
            "vouloir-verb"
          ]
        }
