    {
      "slug": "max-symbol",
      "lemma": "max",
      "pos": "symbol",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1111,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12573972",
          "text": "Max mange pour deux.",
          "translation": "Макс ест за двоих.",
          "source": "Tatoeba #12573972 @Amnafeq / #12574166 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12573972",
          "cefr_level": "A1",
          "word_slugs": [
            "max-symbol"
          ]
        },
        {
          "id": "12563863",
          "text": "Max a coupé du bois pour l'hiver.",
          "translation": "Макс нарубил дров на зиму.",
          "source": "Tatoeba #12563863 @Iwiziw / #12654998 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12563863",
          "cefr_level": "A1",
          "word_slugs": [
            "max-symbol"
          ]
        },
        {
          "id": "12557401",
          "text": "Le chien de Max a attrapé une perdrix.",
          "translation": "Собака Макса поймала куропатку.",
          "source": "Tatoeba #12557401 @Iwiziw / #12729323 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12557401",
          "cefr_level": "A1",
          "word_slugs": [
            "max-symbol"
          ]
        },
        {
          "id": "12556075",
          "text": "La femme de Max a accouché des jumeaux.",
          "translation": "Жена Макса родила близнецов.",
          "source": "Tatoeba #12556075 @Iwiziw / #12568800 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12556075",
          "cefr_level": "A1",
          "word_slugs": [
            "max-symbol"
          ]
        },
        {
          "id": "12554476",
          "text": "Max passe ses jours de repos à jardiner.",
          "translation": "Макс проводит выходные, занимаясь садоводством.",
          "source": "Tatoeba #12554476 @Iwiziw / #13675490 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12554476",
          "cefr_level": "A1",
          "word_slugs": [
            "max-symbol"
          ]
        }
      ],
