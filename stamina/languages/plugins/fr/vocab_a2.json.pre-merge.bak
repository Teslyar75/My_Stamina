    {
      "slug": "sinon-conj",
      "lemma": "sinon",
      "pos": "conj",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 681,
      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "иначе",
          "если не"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7811204",
          "text": "Sinon, tu mourras.",
          "translation": "Иначе ты умрёшь.",
          "source": "Tatoeba #7811204 @Aiji / #2727338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7811204",
          "cefr_level": "A1",
          "word_slugs": [
            "sinon-conj"
          ]
        },
        {
          "id": "7811207",
          "text": "Sinon, vous mourrez.",
          "translation": "Иначе Вы умрёте.",
          "source": "Tatoeba #7811207 @Aiji / #2727339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7811207",
          "cefr_level": "A1",
          "word_slugs": [
            "sinon-conj"
          ]
        },
        {
          "id": "7774567",
          "text": "C'est correct sinon.",
          "translation": "А так всё правильно.",
          "source": "Tatoeba #7774567 @Rockaround / #7774573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7774567",
          "cefr_level": "A1",
          "word_slugs": [
            "sinon-conj"
          ]
        },
        {
          "id": "133357",
          "text": "Il lit rarement, sinon jamais.",
          "translation": "Он если и читает книги, то редко.",
          "source": "Tatoeba #133357 @nimfeo / #7225037 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/133357",
          "cefr_level": "A1",
          "word_slugs": [
            "sinon-conj"
          ]
        },
        {
          "id": "11999681",
          "text": "Faites vite sinon il nous rattrapera.",
          "translation": "Давайте быстрей, а то он нас догонит.",
          "source": "Tatoeba #11999681 @Igider / #12601859 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11999681",
          "cefr_level": "A1",
          "word_slugs": [
            "sinon-conj"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": null,
        "singular": "sinon",
        "plural": "",
        "infinitive": ""
      }
