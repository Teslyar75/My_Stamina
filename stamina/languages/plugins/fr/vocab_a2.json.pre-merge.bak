    {
      "slug": "avenir-noun",
      "lemma": "avenir",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1176,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "237187",
          "text": "À ton avenir !",
          "translation": "За твоё будущее!",
          "source": "Tatoeba #237187 @hortusdei / #3897732 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/237187",
          "cefr_level": "A1",
          "word_slugs": [
            "avenir-noun"
          ]
        },
        {
          "id": "7763106",
          "text": "Tu as un avenir.",
          "translation": "У тебя есть будущее.",
          "source": "Tatoeba #7763106 @sacredceltic / #5297310 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7763106",
          "cefr_level": "A1",
          "word_slugs": [
            "avenir-noun"
          ]
        },
        {
          "id": "564332",
          "text": "L'avenir le dira.",
          "translation": "Будущее покажет.",
          "source": "Tatoeba #564332 @sacredceltic / #2480402 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/564332",
          "cefr_level": "A1",
          "word_slugs": [
            "avenir-noun"
          ]
        },
        {
          "id": "10854922",
          "text": "Ils sont l'avenir.",
          "translation": "За ними будущее.",
          "source": "Tatoeba #10854922 @carlosalberto / #10854710 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854922",
          "cefr_level": "A1",
          "word_slugs": [
            "avenir-noun"
          ]
        },
        {
          "id": "1084278",
          "text": "Pense à ton avenir.",
          "translation": "Подумай о своём будущем!",
          "source": "Tatoeba #1084278 @nimfeo / #1485689 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1084278",
          "cefr_level": "A1",
          "word_slugs": [
            "avenir-noun"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
