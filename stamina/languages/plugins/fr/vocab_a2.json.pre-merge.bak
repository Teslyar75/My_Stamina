            "dirais-verb"
          ]
        },
        {
          "id": "8952599",
          "text": "Je ne dirais plus rien.",
          "translation": "Я бы больше ничего не стал говорить.",
          "source": "Tatoeba #8952599 @Julien_PDC / #10321451 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8952599",
          "cefr_level": "A1",
