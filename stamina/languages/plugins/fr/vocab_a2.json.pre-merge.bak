      "gender": null,
      "examples": [
        {
          "id": "1980696",
          "text": "Trois semaines environ.",
          "translation": "Около трёх недель.",
          "source": "Tatoeba #1980696 @nimfeo / #2521008 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1980696",
