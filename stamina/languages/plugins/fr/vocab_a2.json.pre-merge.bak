          ]
        },
        {
          "id": "5685920",
          "text": "Vous auriez pu mourir.",
          "translation": "Вы могли умереть.",
          "source": "Tatoeba #5685920 @Aiji / #3532789 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5685920",
