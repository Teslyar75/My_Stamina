    {
      "slug": "aimer-verb",
      "lemma": "aimer",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 976,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12785066",
          "text": "Vous allez aimer.",
          "translation": "Вам понравится.",
          "source": "Tatoeba #12785066 @LdjuherTaqvaylit / #3532324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12785066",
          "cefr_level": "A1",
          "word_slugs": [
            "aimer-verb"
          ]
        },
        {
          "id": "11015",
          "text": "Il doit t'aimer.",
          "translation": "Он тебя, наверное, любит.",
          "source": "Tatoeba #11015 @Apex / #9981071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11015",
          "cefr_level": "A1",
          "word_slugs": [
            "aimer-verb"
          ]
        },
        {
          "id": "3288891",
          "text": "Marie va l'aimer.",
          "translation": "Мэри он понравится.",
          "source": "Tatoeba #3288891 @Amastan / #3576772 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3288891",
          "cefr_level": "A1",
          "word_slugs": [
            "aimer-verb"
          ]
        },
        {
          "id": "804759",
          "text": "Il rêvait d'aimer.",
          "translation": "Он мечтал о любви.",
          "source": "Tatoeba #804759 @sacredceltic / #9096528 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/804759",
          "cefr_level": "A1",
          "word_slugs": [
            "aimer-verb"
          ]
        },
        {
          "id": "6402386",
