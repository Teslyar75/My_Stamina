    {
      "slug": "plupart-noun",
      "lemma": "plupart",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1185,
      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "большинство"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3544507",
          "text": "La plupart y consentent.",
          "translation": "Большинство с этим согласно.",
          "source": "Tatoeba #3544507 @Rovo / #3544513 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3544507",
          "cefr_level": "A1",
          "word_slugs": [
            "plupart-noun"
          ]
        },
        {
          "id": "961167",
          "text": "La plupart pensent ainsi.",
          "translation": "Так думает большинство.",
          "source": "Tatoeba #961167 @sacredceltic / #5901997 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/961167",
          "cefr_level": "A1",
          "word_slugs": [
            "plupart-noun"
          ]
        },
        {
          "id": "5100944",
          "text": "La plupart s'en fiche.",
          "translation": "Большинству плевать.",
          "source": "Tatoeba #5100944 @kamillel / #5100946 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5100944",
          "cefr_level": "A1",
          "word_slugs": [
            "plupart-noun"
          ]
        },
        {
          "id": "11614982",
          "text": "Ça arrive la plupart du temps.",
          "translation": "Так чаще всего бывает.",
          "source": "Tatoeba #11614982 @Bernie75 / #2946020 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11614982",
          "cefr_level": "A1",
          "word_slugs": [
            "plupart-noun"
          ]
        },
        {
          "id": "182070",
          "text": "La plupart des gens pensent ça.",
          "translation": "Так думает большинство.",
          "source": "Tatoeba #182070 @trotter / #5901997 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/182070",
          "cefr_level": "A1",
          "word_slugs": [
            "plupart-noun"
          ]
        }
      ],
      "tags": [
        "A2"
      ],
      "source": "Kaikki fr (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "french": {
        "gender": "f",
        "singular": "la plupart",
        "plural": "",
        "infinitive": ""
      }
