          ]
        },
        {
          "id": "1745005",
          "text": "Vous auriez une cigarette ?",
          "translation": "Сигаретки не будет?",
          "source": "Tatoeba #1745005 @Bgayet / #4249737 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1745005",
