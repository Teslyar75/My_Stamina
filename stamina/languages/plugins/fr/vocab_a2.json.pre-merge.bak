    {
      "slug": "devais-verb",
      "lemma": "devais",
      "pos": "verb",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 837,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6701464",
          "text": "Tu devais rester.",
          "translation": "Ты должен был остаться.",
          "source": "Tatoeba #6701464 @felix63 / #6701550 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6701464",
          "cefr_level": "A1",
          "word_slugs": [
            "devais-verb"
          ]
        },
        {
          "id": "1116859",
          "text": "Je devais y aller.",
          "translation": "Я должен был пойти.",
          "source": "Tatoeba #1116859 @sacredceltic / #4075579 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1116859",
          "cefr_level": "A1",
