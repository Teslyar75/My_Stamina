      "frequency_rank": 765,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13946483",
          "text": "J'aime me retrouver seul.",
          "translation": "Я люблю быть один.",
          "source": "Tatoeba #13946483 @Aghanim / #2497333 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13946483",
          "cefr_level": "A1",
          "word_slugs": [
            "retrouver-verb"
          ]
        },
        {
          "id": "12484310",
          "text": "Je dois retrouver sa confiance.",
          "translation": "Я должен вернуть его доверие.",
          "source": "Tatoeba #12484310 @menaud / #12626434 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12484310",
          "cefr_level": "A1",
          "word_slugs": [
            "retrouver-verb"
          ]
        },
        {
          "id": "13404494",
          "text": "Comment allons-nous la retrouver ?",
