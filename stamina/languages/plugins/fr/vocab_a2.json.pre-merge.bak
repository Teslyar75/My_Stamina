    {
      "slug": "coups-noun",
      "lemma": "coups",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1073,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7234822",
          "text": "Une pierre, deux coups.",
          "translation": "Одним ударом двух зайцев.",
          "source": "Tatoeba #7234822 @Talwit / #7234971 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7234822",
          "cefr_level": "A1",
          "word_slugs": [
            "coups-noun"
          ]
        },
        {
          "id": "2423600",
          "text": "J'ai rendu les coups.",
          "translation": "Я дал сдачи.",
          "source": "Tatoeba #2423600 @sacredceltic / #3677738 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2423600",
          "cefr_level": "A1",
          "word_slugs": [
            "coups-noun"
          ]
        },
        {
          "id": "12480592",
          "text": "Les coups se sont arrêtés.",
