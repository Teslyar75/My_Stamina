    {
      "slug": "président-noun",
      "lemma": "président",
      "pos": "noun",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 678,
      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "президент",
          "председатель",
          "глава"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13806108",
          "text": "Protégez le président !",
          "translation": "Защищайте президента!",
          "source": "Tatoeba #13806108 @unetoilebrille / #13806255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13806108",
          "cefr_level": "A1",
          "word_slugs": [
            "président-noun"
          ]
        },
        {
          "id": "507784",
          "text": "Où est le président ?",
          "translation": "Где президент?",
          "source": "Tatoeba #507784 @Goofy / #2882108 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/507784",
          "cefr_level": "A1",
          "word_slugs": [
            "président-noun"
          ]
        },
        {
          "id": "11640181",
          "text": "Il est élu président.",
          "translation": "Он избран президентом.",
          "source": "Tatoeba #11640181 @LdjuherTaqvaylit / #12550169 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11640181",
          "cefr_level": "A1",
          "word_slugs": [
            "président-noun"
          ]
        },
        {
          "id": "11837667",
          "text": "Le président a refusé.",
          "translation": "Президент отказался.",
          "source": "Tatoeba #11837667 @Amastan / #13246437 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11837667",
          "cefr_level": "A1",
          "word_slugs": [
            "président-noun"
          ]
        },
        {
          "id": "997876",
