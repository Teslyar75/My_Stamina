          ]
        },
        {
          "id": "8962622",
          "text": "Tout début est difficile.",
          "translation": "Начало - это всегда сложно.",
          "source": "Tatoeba #8962622 @felix63 / #8971334 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8962622",
          "cefr_level": "A1",
          "word_slugs": [
            "début-noun"
          ]
        },
        {
          "id": "11261050",
          "text": "Commencez depuis le début.",
          "translation": "Начните с начала.",
          "source": "Tatoeba #11261050 @Rovo / #3605921 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11261050",
