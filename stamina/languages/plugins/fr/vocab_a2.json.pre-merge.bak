      "frequency_band": "delf-a2",
      "translations": {
        "ru": [
          "ебать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8984292",
          "text": "Va te faire foutre.",
          "translation": "Пошёл в жопу!",
          "source": "Tatoeba #8984292 @Micsmithel / #4408222 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8984292",
          "cefr_level": "A1",
          "word_slugs": [
            "foutre-verb"
          ]
        },
        {
          "id": "403910",
          "text": "Va te faire foutre !",
          "translation": "Пошёл на хуй!",
          "source": "Tatoeba #403910 @trotter / #390451 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/403910",
          "cefr_level": "A1",
          "word_slugs": [
            "foutre-verb"
          ]
        },
        {
          "id": "4737409",
          "text": "J'ai que ça à foutre.",
          "translation": "Мне, блин, делать больше нечего.",
          "source": "Tatoeba #4737409 @lovasoa / #4107773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4737409",
          "cefr_level": "A1",
          "word_slugs": [
            "foutre-verb"
          ]
        },
        {
          "id": "2136857",
