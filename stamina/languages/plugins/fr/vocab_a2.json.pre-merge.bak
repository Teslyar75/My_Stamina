    {
      "slug": "chacun-pron",
      "lemma": "chacun",
      "pos": "pron",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 1006,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "562644",
          "text": "Chacun l'aime.",
          "translation": "Его все любят.",
          "source": "Tatoeba #562644 @sacredceltic / #408096 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/562644",
          "cefr_level": "A1",
          "word_slugs": [
            "chacun-pron"
          ]
        },
        {
          "id": "5740877",
          "text": "Chacun pour soi.",
          "translation": "Каждый сам за себя.",
          "source": "Tatoeba #5740877 @Yemana / #7969831 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5740877",
          "cefr_level": "A1",
          "word_slugs": [
            "chacun-pron"
          ]
        },
        {
          "id": "605578",
          "text": "Chacun ses goûts.",
          "translation": "У каждого свой вкус.",
          "source": "Tatoeba #605578 @Micsmithel / #2830836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/605578",
          "cefr_level": "A1",
          "word_slugs": [
            "chacun-pron"
          ]
        },
        {
          "id": "12697561",
          "text": "Chacun a regardé.",
          "translation": "Все посмотрели.",
          "source": "Tatoeba #12697561 @Rovo / #4465030 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12697561",
          "cefr_level": "A1",
          "word_slugs": [
            "chacun-pron"
          ]
        },
        {
          "id": "5961081",
          "text": "Chacun son boulot.",
          "translation": "Пусть каждый занимается своим делом.",
          "source": "Tatoeba #5961081 @Blabla / #9351539 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5961081",
          "cefr_level": "A1",
          "word_slugs": [
            "chacun-pron"
          ]
        }
      ],
