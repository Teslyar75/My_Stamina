        },
        {
          "id": "1257241",
          "text": "Tous vinrent sauf elle.",
          "translation": "Все пришли, кроме неё.",
          "source": "Tatoeba #1257241 @sacredceltic / #8284926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1257241",
          "cefr_level": "A1",
          "word_slugs": [
            "sauf-verb"
          ]
        },
        {
          "id": "8568618",
          "text": "C’est tout sauf ça.",
          "translation": "Это всё что угодно, кроме этого.",
          "source": "Tatoeba #8568618 @sacredceltic / #14076747 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8568618",
