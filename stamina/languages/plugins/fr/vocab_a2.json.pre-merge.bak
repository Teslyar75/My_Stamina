      "pos": "name",
      "language": "fr",
      "cefr_level": "A2",
      "frequency_rank": 700,
      "frequency_band": "delf-a2",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1510696",
          "text": "Je lis souvent.",
          "translation": "Я часто читаю.",
          "source": "Tatoeba #1510696 @sacredceltic / #1719672 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1510696",
          "cefr_level": "A1",
          "word_slugs": [
            "souvent-name"
          ]
        },
        {
          "id": "7230",
          "text": "Je skie souvent.",
          "translation": "Я часто катаюсь на лыжах.",
          "source": "Tatoeba #7230 @sacredceltic / #4465568 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7230",
          "cefr_level": "A1",
          "word_slugs": [
            "souvent-name"
          ]
        },
        {
          "id": "9554730",
          "text": "Il mange souvent.",
          "translation": "Он часто ест.",
          "source": "Tatoeba #9554730 @Julien_PDC / #10067862 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9554730",
          "cefr_level": "A1",
          "word_slugs": [
            "souvent-name"
          ]
        },
        {
          "id": "11026175",
          "text": "Il gagne souvent.",
          "translation": "Он часто выигрывает.",
          "source": "Tatoeba #11026175 @lbdx / #8675222 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11026175",
          "cefr_level": "A1",
          "word_slugs": [
            "souvent-name"
          ]
        },
        {
          "id": "437401",
          "text": "J'éternue souvent.",
          "translation": "Я часто чихаю.",
          "source": "Tatoeba #437401 @jerom / #2118811 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/437401",
          "cefr_level": "A1",
