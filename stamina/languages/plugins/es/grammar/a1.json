    {
      "id": "a1-11-preposiciones",
      "order": 11,
      "title": "Preposiciones básicas: a, de, en, con, sin, por, para",
      "subtitle": "Contracciones: al, del",
      "topics": [
        "preposiciones"
      ],
      "prereq": [
        "a1-09-demostrativos"
      ],
      "minutes": 12,
      "theory": [
        {
          "kind": "text",
          "text": "A + el = al. De + el = del. A = dirección. De = origen/posesión. En = lugar/tiempo. Con = compañía. Sin = falta."
        },
        {
          "kind": "rule",
          "title": "A personal",
          "text": "Veo a María (persona/animado). No *veo María*."
        },
        {
          "kind": "rule",
          "title": "Por vs Para (intro)",
          "text": "Por = causa/medio. Para = finalidad/destino."
        }
      ],
      "drills": [
        {
          "id": "a1-11-d01",
          "type": "choice",
          "prompt": "Voy ____ (a + el) parque.",
          "options": [
            "a el",
            "al",
            "del",
            "a"
          ],
          "answer": [
            "al"
          ],
          "why": "A + el = al."
        },
        {
          "id": "a1-11-d02",
          "type": "choice",
          "prompt": "Vengo ____ (de + el) cine.",
          "options": [
            "de el",
            "del",
            "al",
            "de"
          ],
          "answer": [
            "del"
          ],
          "why": "De + el = del."
        },
        {
          "id": "a1-11-d03",
          "type": "fill",
          "prompt": "Estoy ____ casa.",
          "answer": [
            "en"
          ],
          "why": "En = lugar."
        },
        {
          "id": "a1-11-d04",
          "type": "choice",
          "prompt": "Lo hago ____ ti.",
          "options": [
            "por",
            "para",
            "con",
            "sin"
          ],
          "answer": [
            "por"
          ],
          "why": "Por = causa/motivo (por ti = por tu causa)."
        }
      ]
    },
    {
