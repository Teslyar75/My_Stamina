      "translations": {
        "en": [
          "past participle of quedar"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2313056",
          "text": "¿Dónde nos habíamos quedado?",
          "translation": "На чём мы остановились?",
          "source": "Tatoeba #2313056 @Shishir / #1941716 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2313056",
          "cefr_level": "A1",
          "word_slugs": [
            "quedado-verb"
          ]
        },
        {
          "id": "4616100",
          "text": "Deberíamos habernos quedado contigo.",
          "translation": "Нам надо было остаться с тобой.",
          "source": "Tatoeba #4616100 @Shishir / #5476992 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4616100",
          "cefr_level": "A1",
          "word_slugs": [
            "quedado-verb"
          ]
        },
        {
          "id": "1617172",
          "text": "Tom se había quedado mudo.",
          "translation": "Том потерял дар речи.",
          "source": "Tatoeba #1617172 @marcelostockle / #6941866 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1617172",
          "cefr_level": "A1",
          "word_slugs": [
            "quedado-verb"
          ]
        },
        {
          "id": "6677039",
          "text": "He quedado con una persona.",
          "translation": "Я договорился о встрече с одним человеком.",
          "source": "Tatoeba #6677039 @arh / #6677321 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6677039",
          "cefr_level": "A1",
          "word_slugs": [
            "quedado-verb"
          ]
        },
        {
          "id": "3756322",
          "text": "Debería haberme quedado con Tom.",
          "translation": "Я должен был остаться с Томом.",
          "source": "Tatoeba #3756322 @Shishir / #3757720 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3756322",
