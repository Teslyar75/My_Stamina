          ]
        },
        {
          "id": "4633268",
          "text": "Debes limpiar la mesa.",
          "translation": "Ты должен убрать со стола.",
          "source": "Tatoeba #4633268 @AucaCoyan / #4633280 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4633268",
          "cefr_level": "A1",
          "word_slugs": [
            "limpiar-verb"
          ]
        },
        {
          "id": "342311",
          "text": "Hice limpiar mi habitación.",
          "translation": "Я проделал уборку в своей комнате.",
          "source": "Tatoeba #342311 @tatoerique / #4034322 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/342311",
          "cefr_level": "A1",
