          "cefr_level": "A1",
          "word_slugs": [
            "perdone-verb"
          ]
        },
        {
          "id": "346545",
          "text": "Le ruego que me perdone.",
          "translation": "Я прошу вас простить меня.",
          "source": "Tatoeba #346545 @tatoerique / #2372912 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/346545",
          "cefr_level": "A1",
          "word_slugs": [
            "perdone-verb"
          ]
        }
