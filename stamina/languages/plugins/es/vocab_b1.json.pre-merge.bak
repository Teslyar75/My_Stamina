          "first-person singular preterite indicative of llamar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "743157",
          "text": "Le llamé ayer.",
          "translation": "Я звонил ему вчера.",
          "source": "Tatoeba #743157 @darinmex / #2657194 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/743157",
          "cefr_level": "A1",
          "word_slugs": [
