      "examples": [
        {
          "id": "2419363",
          "text": "Alguien quiere conocerte.",
          "translation": "Кое-кто хочет с тобой познакомиться.",
          "source": "Tatoeba #2419363 @Shishir / #6596131 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2419363",
          "cefr_level": "A1",
          "word_slugs": [
            "conocerte-verb"
          ]
        },
        {
          "id": "1863608",
          "text": "Es un placer conocerte.",
          "translation": "Приятно познакомиться.",
          "source": "Tatoeba #1863608 @kerbear407 / #426021 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1863608",
          "cefr_level": "A1",
          "word_slugs": [
            "conocerte-verb"
          ]
        },
        {
          "id": "959350",
          "text": "Siempre he querido conocerte.",
          "translation": "Я всегда хотел с тобой познакомиться.",
          "source": "Tatoeba #959350 @hundo / #10183307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/959350",
          "cefr_level": "A1",
          "word_slugs": [
            "conocerte-verb"
          ]
        },
        {
          "id": "2672",
          "text": "Todos quieren conocerte. ¡Eres famoso!",
          "translation": "Все хотят с тобой познакомиться. Ты знаменит!",
          "source": "Tatoeba #2672 @Raimondi / #13070772 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2672",
          "cefr_level": "A1",
          "word_slugs": [
            "conocerte-verb"
          ]
        },
        {
          "id": "7950455",
          "text": "Todos quieren conocerte, ¡eres famoso!",
          "translation": "Все хотят с тобой познакомиться. Ты знаменит!",
          "source": "Tatoeba #7950455 @arh / #13070772 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7950455",
          "cefr_level": "A1",
          "word_slugs": [
            "conocerte-verb"
          ]
