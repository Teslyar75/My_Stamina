      },
      "gender": "f",
      "examples": [
        {
          "id": "11031778",
          "text": "La longitud es una cantidad física.",
          "translation": "Длина — физическая величина.",
          "source": "Tatoeba #11031778 @janTuki / #5381044 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11031778",
          "cefr_level": "A1",
          "word_slugs": [
            "cantidad-noun"
          ]
        },
        {
          "id": "658717",
          "text": "Cualidad es más importante que cantidad.",
          "translation": "Качество важнее количества.",
          "source": "Tatoeba #658717 @darinmex / #407964 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/658717",
          "cefr_level": "A1",
          "word_slugs": [
            "cantidad-noun"
          ]
        },
        {
          "id": "1451781",
          "text": "Se perdió una gran cantidad de dinero.",
          "translation": "Большая сумма денег была потеряна.",
          "source": "Tatoeba #1451781 @marcelostockle / #1452232 @chispa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1451781",
          "cefr_level": "A1",
          "word_slugs": [
            "cantidad-noun"
          ]
        },
        {
          "id": "10956475",
          "text": "La calidad viene antes de la cantidad.",
          "translation": "Качество важнее количества.",
          "source": "Tatoeba #10956475 @Adelpa / #407964 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10956475",
          "cefr_level": "A1",
          "word_slugs": [
            "cantidad-noun"
          ]
        },
        {
          "id": "347478",
          "text": "Japón importa una gran cantidad de petróleo.",
          "translation": "Япония импортирует большие объёмы нефти.",
