      "gender": null,
      "examples": [
        {
          "id": "2411737",
          "text": "Hablemos de amor.",
          "translation": "Давай поговорим о любви.",
          "source": "Tatoeba #2411737 @Shishir / #5969763 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2411737",
          "cefr_level": "A1",
