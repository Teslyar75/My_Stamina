      "examples": [
        {
          "id": "633045",
          "text": "Dé la contraseña.",
          "translation": "Дайте пароль.",
          "source": "Tatoeba #633045 @Dejo / #5238035 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/633045",
          "cefr_level": "A1",
          "word_slugs": [
            "dé-verb"
          ]
        },
        {
          "id": "7965602",
          "text": "No me lo dé.",
          "translation": "Не давайте мне этого.",
          "source": "Tatoeba #7965602 @Seael / #8312110 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7965602",
          "cefr_level": "A1",
          "word_slugs": [
            "dé-verb"
          ]
        },
        {
          "id": "4122862",
          "text": "Dile que te los dé.",
          "translation": "Скажи ей, чтобы она тебе их дала.",
          "source": "Tatoeba #4122862 @dan1ruusianspanish / #2751346 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4122862",
          "cefr_level": "A1",
          "word_slugs": [
            "dé-verb"
          ]
        },
        {
          "id": "4431515",
          "text": "Dile que se dé prisa.",
