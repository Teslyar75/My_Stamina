    {
      "slug": "muestra-noun",
      "lemma": "muestra",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1476,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "sample, sampling",
          "exhibition (artistic or technological collection for display)",
          "specimen",
          "demonstration, showing"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1523934",
          "text": "Muestra tus cartas.",
          "translation": "Покажи свои карты.",
          "source": "Tatoeba #1523934 @marcelostockle / #7422120 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1523934",
          "cefr_level": "A1",
          "word_slugs": [
            "muestra-noun"
          ]
        },
        {
          "id": "1297501",
          "text": "No muestra sus sentimientos.",
          "translation": "Он не показывает своих чувств.",
          "source": "Tatoeba #1297501 @enteka / #7826011 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1297501",
          "cefr_level": "A1",
          "word_slugs": [
            "muestra-noun"
          ]
        },
        {
          "id": "2258225",
          "text": "En todo muestra que tiene carácter.",
          "translation": "Она проявляет характер во всём, что делает.",
          "source": "Tatoeba #2258225 @THURET / #3855496 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2258225",
          "cefr_level": "A1",
          "word_slugs": [
            "muestra-noun"
          ]
        },
        {
          "id": "5853548",
          "text": "Un mapamundi muestra todos los países.",
          "translation": "На карте мира представлены все страны.",
          "source": "Tatoeba #5853548 @solmyrbcn / #7014089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5853548",
          "cefr_level": "A1",
          "word_slugs": [
            "muestra-noun"
          ]
        },
        {
          "id": "1740947",
          "text": "Él no muestra sus verdaderos sentimientos.",
          "translation": "Он не показывает своих настоящих чувств.",
          "source": "Tatoeba #1740947 @hayastan / #2788603 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1740947",
          "cefr_level": "A1",
          "word_slugs": [
            "muestra-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "muestra",
