          ]
        },
        {
          "id": "3143683",
          "text": "Tom es tímido y cobarde.",
          "translation": "Том робок и труслив.",
          "source": "Tatoeba #3143683 @faehrmann / #4525718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3143683",
          "cefr_level": "A1",
