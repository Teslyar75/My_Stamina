    {
      "slug": "enviar-verb",
      "lemma": "enviar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1942,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to send"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3039806",
          "text": "Quiero enviar un telegrama.",
          "translation": "Я хочу послать телеграмму.",
          "source": "Tatoeba #3039806 @marcelostockle / #3022553 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3039806",
          "cefr_level": "A1",
          "word_slugs": [
