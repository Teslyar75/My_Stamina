    {
      "slug": "imbécil-adj",
      "lemma": "imbécil",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1359,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "дурак",
          "имбецил"
        ],
        "en": [
          "dumb, having the properties of an imbecile"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6804607",
          "text": "¡Qué estás haciendo, imbécil!",
          "translation": "Ты что делаешь, придурок!",
          "source": "Tatoeba #6804607 @agj / #6804632 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804607",
          "cefr_level": "A1",
          "word_slugs": [
            "imbécil-adj"
          ]
        },
        {
          "id": "1402367",
          "text": "Tu exnovio es un imbécil.",
          "translation": "Твой бывший — придурок.",
          "source": "Tatoeba #1402367 @enteka / #6461178 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1402367",
          "cefr_level": "A1",
          "word_slugs": [
            "imbécil-adj"
          ]
        },
        {
          "id": "5718563",
          "text": "No te comportes como un imbécil.",
          "translation": "Не веди себя как придурок.",
          "source": "Tatoeba #5718563 @arh / #5979093 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5718563",
          "cefr_level": "A1",
          "word_slugs": [
            "imbécil-adj"
          ]
        },
        {
          "id": "1070817",
          "text": "¿Cuándo te pararás de reírte como un imbécil?",
          "translation": "Когда ты перестанешь смеяться как идиот?",
          "source": "Tatoeba #1070817 @qweruiop / #2197558 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1070817",
          "cefr_level": "A1",
          "word_slugs": [
            "imbécil-adj"
          ]
        }
      ],
      "tags": [
        "B1"
