    {
      "slug": "policías-noun",
      "lemma": "policías",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1582,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of policía"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10225471",
          "text": "Saben que somos policías.",
          "translation": "Они знают, что мы полицейские.",
          "source": "Tatoeba #10225471 @Shishir / #13227499 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10225471",
          "cefr_level": "A1",
          "word_slugs": [
            "policías-noun"
          ]
        },
        {
          "id": "4571236",
          "text": "¿En dónde están los policías?",
          "translation": "Где полицейские?",
          "source": "Tatoeba #4571236 @cueyayotl / #4960244 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4571236",
          "cefr_level": "A1",
          "word_slugs": [
            "policías-noun"
          ]
        },
        {
          "id": "1355308",
          "text": "¿Dónde está la estación de policías?",
          "translation": "Где находится полицейский участок?",
          "source": "Tatoeba #1355308 @marcelostockle / #1484453 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1355308",
          "cefr_level": "A1",
          "word_slugs": [
            "policías-noun"
          ]
        },
        {
          "id": "4541871",
          "text": "Los policías primero madrean, luego preguntan.",
          "translation": "Полицейские сначала отметелят, потом спрашивают.",
          "source": "Tatoeba #4541871 @ecorralest101 / #4541886 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4541871",
          "cefr_level": "A1",
          "word_slugs": [
            "policías-noun"
          ]
        },
        {
          "id": "851815",
          "text": "La mayoría de los policías perdió su trabajo.",
          "translation": "Большинство полицейских потеряли работу.",
          "source": "Tatoeba #851815 @pilotcdmark / #1485657 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/851815",
          "cefr_level": "A1",
          "word_slugs": [
            "policías-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "policías",
        "plural": "",
        "infinitive": ""
      }
