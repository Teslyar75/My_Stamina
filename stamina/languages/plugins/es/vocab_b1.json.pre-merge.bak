    {
      "slug": "diversión-noun",
      "lemma": "diversión",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2183,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "fun, entertainment, amusement, levity"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1023573",
          "text": "Nosotros no tuvimos mucha diversión.",
          "translation": "Мы не очень веселились.",
          "source": "Tatoeba #1023573 @jayefes65 / #4004017 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1023573",
          "cefr_level": "A1",
          "word_slugs": [
            "diversión-noun"
          ]
        },
        {
          "id": "2099946",
          "text": "Hubo mucha música y mucha diversión.",
          "translation": "Было много музыки и веселья.",
          "source": "Tatoeba #2099946 @marcelostockle / #5668328 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2099946",
          "cefr_level": "A1",
          "word_slugs": [
            "diversión-noun"
          ]
        },
        {
          "id": "3009384",
          "text": "Por diversión, me uní a la propuesta.",
          "translation": "Забавы ради я согласился на предложение.",
          "source": "Tatoeba #3009384 @marcelostockle / #3011238 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3009384",
          "cefr_level": "A1",
          "word_slugs": [
            "diversión-noun"
          ]
        },
        {
          "id": "1903823",
          "text": "Es el fin de la diversión y los juegos.",
          "translation": "Веселью и играм конец.",
          "source": "Tatoeba #1903823 @marcelostockle / #6569197 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1903823",
          "cefr_level": "A1",
          "word_slugs": [
            "diversión-noun"
          ]
        },
        {
          "id": "1298570",
          "text": "Tom es la clase de tipo que discute por diversión.",
          "translation": "Том из тех людей, что спорят для развлечения.",
          "source": "Tatoeba #1298570 @hayastan / #4922446 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1298570",
          "cefr_level": "A1",
          "word_slugs": [
            "diversión-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "diversión",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "pareció-verb",
      "lemma": "pareció",
      "pos": "verb",
      "language": "es",
