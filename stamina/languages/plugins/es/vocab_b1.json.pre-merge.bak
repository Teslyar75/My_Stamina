        {
          "id": "5079412",
          "text": "Hablaremos cuando vuelvas.",
          "translation": "Поговорим, когда вернёшься.",
          "source": "Tatoeba #5079412 @diegohn / #5084254 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5079412",
          "cefr_level": "A1",
          "word_slugs": [
            "vuelvas-verb"
          ]
        },
        {
          "id": "2766977",
          "text": "¡No vuelvas a Roma!",
          "translation": "Не возвращайся в Рим.",
          "source": "Tatoeba #2766977 @estambulista / #7774591 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2766977",
          "cefr_level": "A1",
          "word_slugs": [
            "vuelvas-verb"
          ]
        },
        {
          "id": "6591736",
          "text": "No vuelvas por aquí.",
          "translation": "Не возвращайся сюда.",
          "source": "Tatoeba #6591736 @arh / #4927996 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6591736",
          "cefr_level": "A1",
          "word_slugs": [
            "vuelvas-verb"
          ]
        },
        {
          "id": "2405328",
          "text": "No quiero que vuelvas.",
          "translation": "Я не хочу, чтобы ты возвращалась.",
          "source": "Tatoeba #2405328 @Shishir / #3554338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2405328",
          "cefr_level": "A1",
          "word_slugs": [
            "vuelvas-verb"
          ]
        }
      ],
