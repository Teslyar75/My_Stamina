    {
      "slug": "pondré-verb",
      "lemma": "pondré",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2403,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular future indicative of poner"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2722902",
          "text": "Simplemente pondré esto en el frigorífico.",
          "translation": "Я просто поставлю это в холодильник.",
          "source": "Tatoeba #2722902 @ikarias / #12260571 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2722902",
          "cefr_level": "A1",
          "word_slugs": [
            "pondré-verb"
          ]
        },
        {
          "id": "761893",
          "text": "Creo que me pondré este suéter rojo.",
          "translation": "Я, пожалуй, надену этот красный свитер.",
          "source": "Tatoeba #761893 @Shishir / #9182805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/761893",
          "cefr_level": "A1",
          "word_slugs": [
            "pondré-verb"
          ]
        },
        {
          "id": "1946164",
          "text": "Si un día te vas, me pondré muy triste.",
          "translation": "Если ты однажды уйдёшь, мне будет очень грустно.",
          "source": "Tatoeba #1946164 @teskmon / #4594577 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1946164",
          "cefr_level": "A1",
          "word_slugs": [
            "pondré-verb"
          ]
        },
        {
          "id": "9361954",
          "text": "Pondré las flores en el jarrón que me regaló Ana.",
          "translation": "Я поставлю цветы в вазу, которую подарила мне Анна.",
          "source": "Tatoeba #9361954 @ignacio / #12188622 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9361954",
          "cefr_level": "A1",
          "word_slugs": [
            "pondré-verb"
          ]
        },
        {
          "id": "2486848",
          "text": "Prepararé suficiente café para una noche y me pondré a trabajar.",
          "translation": "Я приготовлю достаточно кофе на ночь и примусь за работу.",
          "source": "Tatoeba #2486848 @marcelostockle / #14073014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2486848",
          "cefr_level": "A1",
          "word_slugs": [
            "pondré-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "pondré",
        "plural": "",
        "infinitive": "pondré"
      }
    },
