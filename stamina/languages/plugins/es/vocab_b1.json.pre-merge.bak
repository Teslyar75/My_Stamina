          ]
        },
        {
          "id": "2831723",
          "text": "Necesito contratar a un asistente.",
          "translation": "Мне нужно нанять ассистента.",
          "source": "Tatoeba #2831723 @marcelostockle / #2832509 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2831723",
          "cefr_level": "A1",
          "word_slugs": [
            "asistente-noun"
          ]
        },
        {
          "id": "2851994",
          "text": "El joven al que contraté como mi asistente trabaja muy duro.",
