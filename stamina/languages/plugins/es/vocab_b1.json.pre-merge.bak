    {
      "slug": "haberme-verb",
      "lemma": "haberme",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2051,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of haber combined with me",
          "first-person singular infinitive of haberse"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3885482",
          "text": "Podrías haberme preguntado.",
          "translation": "Ты мог бы меня спросить.",
          "source": "Tatoeba #3885482 @Shishir / #3885485 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3885482",
          "cefr_level": "A1",
          "word_slugs": [
            "haberme-verb"
          ]
        },
        {
          "id": "1676315",
          "text": "Gracias por haberme salvado.",
          "translation": "Спасибо, что спас меня.",
          "source": "Tatoeba #1676315 @hayastan / #3461898 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1676315",
          "cefr_level": "A1",
          "word_slugs": [
            "haberme-verb"
          ]
        },
        {
          "id": "2671639",
          "text": "No deberías haberme mentido.",
          "translation": "Тебе не следовало мне лгать.",
          "source": "Tatoeba #2671639 @Shishir / #6594781 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2671639",
          "cefr_level": "A1",
          "word_slugs": [
            "haberme-verb"
          ]
        },
        {
          "id": "1525835",
          "text": "Creía haberme vuelto inmortal.",
          "translation": "Я думал, что обрёл бессмертие.",
          "source": "Tatoeba #1525835 @marcelostockle / #5450428 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1525835",
          "cefr_level": "A1",
          "word_slugs": [
            "haberme-verb"
          ]
        },
        {
          "id": "4617530",
          "text": "Gracias por haberme escuchado.",
          "translation": "Спасибо, что выслушали меня.",
          "source": "Tatoeba #4617530 @don_ramon / #4617986 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4617530",
          "cefr_level": "A1",
          "word_slugs": [
            "haberme-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "haberme",
        "plural": "",
        "infinitive": "haberme"
