    {
      "slug": "sepa-phrase",
      "lemma": "sepa",
      "pos": "phrase",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1225,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "dunno, who knows"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3627089",
          "text": "Sepa la bola.",
          "translation": "Фиг знает.",
          "source": "Tatoeba #3627089 @ecorralest101 / #3627076 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3627089",
          "cefr_level": "A1",
          "word_slugs": [
            "sepa-phrase"
          ]
        },
        {
          "id": "619851",
          "text": "No que yo sepa.",
          "translation": "Насколько я знаю, нет.",
          "source": "Tatoeba #619851 @Shishir / #7835016 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/619851",
          "cefr_level": "A1",
          "word_slugs": [
            "sepa-phrase"
          ]
        },
        {
          "id": "4574320",
          "text": "Que yo sepa, sí.",
          "translation": "Насколько мне известно, да.",
          "source": "Tatoeba #4574320 @lazarus1907 / #12497597 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4574320",
          "cefr_level": "A1",
          "word_slugs": [
            "sepa-phrase"
          ]
        },
        {
          "id": "12606809",
          "text": "Quizá Tom sepa algo.",
          "translation": "Может быть, Том что-нибудь знает.",
          "source": "Tatoeba #12606809 @urro / #13672267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12606809",
          "cefr_level": "A1",
          "word_slugs": [
            "sepa-phrase"
          ]
        },
        {
          "id": "12606808",
          "text": "Quizás Tom sepa algo.",
          "translation": "Может быть, Том что-то знает.",
          "source": "Tatoeba #12606808 @urro / #2927666 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12606808",
          "cefr_level": "A1",
          "word_slugs": [
            "sepa-phrase"
          ]
        }
