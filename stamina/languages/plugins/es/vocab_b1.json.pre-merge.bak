    {
      "slug": "tv-noun",
      "lemma": "tv",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1978,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "TV"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3564893",
          "text": "¿Podemos apagar la TV?",
          "translation": "Мы можем выключить телевизор?",
          "source": "Tatoeba #3564893 @ficion / #3565889 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3564893",
          "cefr_level": "A1",
          "word_slugs": [
            "tv-noun"
          ]
        },
        {
          "id": "1707913",
          "text": "Mi hermano mayor está viendo TV.",
          "translation": "Мой старший брат смотрит телевизор.",
          "source": "Tatoeba #1707913 @hayastan / #3940271 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1707913",
          "cefr_level": "A1",
          "word_slugs": [
            "tv-noun"
          ]
        },
        {
          "id": "855358",
          "text": "Su hermano está siempre viendo la TV.",
          "translation": "Его брат всегда смотрит телевизор.",
          "source": "Tatoeba #855358 @Crul / #677300 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/855358",
          "cefr_level": "A1",
          "word_slugs": [
            "tv-noun"
          ]
        },
        {
          "id": "1332039",
          "text": "¿Cuál es tu comercial de TV preferido?",
          "translation": "Какая твоя любимая телевизионная реклама?",
          "source": "Tatoeba #1332039 @hayastan / #6466988 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1332039",
          "cefr_level": "A1",
          "word_slugs": [
            "tv-noun"
          ]
        },
        {
          "id": "1070157",
          "text": "Estaba viendo TV cuando sonó el teléfono.",
          "translation": "Я смотрела телевизор, когда зазвонил телефон.",
          "source": "Tatoeba #1070157 @hayastan / #3940324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1070157",
          "cefr_level": "A1",
          "word_slugs": [
            "tv-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "tv",
