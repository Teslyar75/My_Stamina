    {
      "slug": "casada-noun",
      "lemma": "casada",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2390,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "female equivalent of casado: married woman"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1384705",
          "text": "No está casada.",
          "translation": "Она не замужем.",
          "source": "Tatoeba #1384705 @enteka / #1677348 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1384705",
          "cefr_level": "A1",
          "word_slugs": [
            "casada-noun"
          ]
        },
        {
          "id": "2209056",
          "text": "No estoy casada.",
          "translation": "Я не замужем.",
          "source": "Tatoeba #2209056 @Shishir / #1551773 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2209056",
          "cefr_level": "A1",
          "word_slugs": [
            "casada-noun"
          ]
        },
        {
          "id": "3015611",
          "text": "He estado casada.",
