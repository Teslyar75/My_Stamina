    {
      "slug": "mataré-verb",
      "lemma": "mataré",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2398,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular future indicative of matar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2612570",
          "text": "No te mataré.",
          "translation": "Я тебя не убью.",
          "source": "Tatoeba #2612570 @Shishir / #4525338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2612570",
          "cefr_level": "A1",
          "word_slugs": [
            "mataré-verb"
          ]
        },
        {
          "id": "4583639",
          "text": "Yo la mataré.",
          "translation": "Я её убью.",
          "source": "Tatoeba #4583639 @cueyayotl / #3999407 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4583639",
          "cefr_level": "A1",
          "word_slugs": [
            "mataré-verb"
          ]
        },
        {
          "id": "3450478",
          "text": "Los mataré a todos.",
          "translation": "Я убью их всех.",
          "source": "Tatoeba #3450478 @sacredceltic / #3451473 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3450478",
          "cefr_level": "A1",
          "word_slugs": [
            "mataré-verb"
          ]
        },
        {
          "id": "6332824",
          "text": "Si te mueves, te mataré.",
          "translation": "Если двинешься с места, я тебя убью.",
          "source": "Tatoeba #6332824 @Adelpa / #8609764 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6332824",
          "cefr_level": "A1",
          "word_slugs": [
            "mataré-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "mataré",
