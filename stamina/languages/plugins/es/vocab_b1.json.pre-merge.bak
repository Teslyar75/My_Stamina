          "cefr_level": "A1",
          "word_slugs": [
            "alice-name"
          ]
        },
        {
          "id": "8011448",
          "text": "Mary y Alice son muy lindas.",
          "translation": "Мэри и Элис очень красивые.",
          "source": "Tatoeba #8011448 @Seael / #7814851 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8011448",
          "cefr_level": "A1",
          "word_slugs": [
            "alice-name"
          ]
        },
        {
          "id": "1460890",
          "text": "Alice está durmiendo en mi habitación.",
          "translation": "Алиса спит в моей комнате.",
          "source": "Tatoeba #1460890 @Ankio / #1460860 @beshine (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1460890",
          "cefr_level": "A1",
          "word_slugs": [
            "alice-name"
          ]
        }
