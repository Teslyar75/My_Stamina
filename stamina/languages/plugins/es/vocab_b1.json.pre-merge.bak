    {
      "slug": "yendo-verb",
      "lemma": "yendo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1538,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "gerund of ir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3712941",
          "text": "Estamos yendo a casa.",
          "translation": "Мы идём домой.",
          "source": "Tatoeba #3712941 @cueyayotl / #562912 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3712941",
          "cefr_level": "A1",
          "word_slugs": [
            "yendo-verb"
          ]
        },
        {
          "id": "5147686",
          "text": "Estoy yendo al mercado.",
          "translation": "Я иду на рынок.",
          "source": "Tatoeba #5147686 @don_ramon / #6015816 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5147686",
          "cefr_level": "A1",
          "word_slugs": [
            "yendo-verb"
          ]
        },
        {
          "id": "5629662",
          "text": "Estoy yendo a mi trabajo.",
          "translation": "Я иду на свою работу.",
          "source": "Tatoeba #5629662 @arh / #7045564 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629662",
          "cefr_level": "A1",
          "word_slugs": [
            "yendo-verb"
          ]
        },
        {
          "id": "2270058",
          "text": "Yendo en auto llegaremos en tres horas.",
          "translation": "На машине мы доберёмся за три часа.",
          "source": "Tatoeba #2270058 @cueyayotl / #6926224 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2270058",
          "cefr_level": "A1",
          "word_slugs": [
            "yendo-verb"
          ]
        },
        {
          "id": "633427",
          "text": "¿Cómo te está yendo con tu nuevo trabajo?",
          "translation": "Как у тебя дела на новой работе?",
          "source": "Tatoeba #633427 @Leono / #2486144 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/633427",
          "cefr_level": "A1",
          "word_slugs": [
            "yendo-verb"
          ]
        }
      ],
