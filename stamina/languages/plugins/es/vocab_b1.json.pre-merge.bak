          "cefr_level": "A1",
          "word_slugs": [
            "juntas-adj"
          ]
        },
        {
          "id": "13603955",
          "text": "Mañana estaremos juntas.",
          "translation": "Завтра мы будем вместе.",
          "source": "Tatoeba #13603955 @Seael / #13604044 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13603955",
          "cefr_level": "A1",
          "word_slugs": [
            "juntas-adj"
          ]
        },
        {
          "id": "3796806",
          "text": "Necesitáis trabajar juntas.",
