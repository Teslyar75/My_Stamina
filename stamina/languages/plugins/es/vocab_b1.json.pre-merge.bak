      },
      "gender": null,
      "examples": [
        {
          "id": "4392152",
          "text": "Relájate por un segundo.",
          "translation": "Расслабься на секунду.",
          "source": "Tatoeba #4392152 @pchamorro / #4394212 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4392152",
          "cefr_level": "A1",
          "word_slugs": [
            "relájate-verb"
          ]
        },
        {
          "id": "1039942",
          "text": "\"Oh cariño,\" dijo ella, \"siéntate, relájate y cierra tus ojos.\"",
          "translation": "«Ах, дорогой, — сказала она, — сядь, расслабься и закрой глаза».",
          "source": "Tatoeba #1039942 @oscarguille / #808664 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1039942",
          "cefr_level": "A1",
          "word_slugs": [
            "relájate-verb"
          ]
        }
      ],
