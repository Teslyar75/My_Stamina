      "frequency_rank": 1814,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "forward!",
          "Used to indicate that you can start eating."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1006271",
          "text": "Siga su ejemplo.",
          "translation": "Следуйте его примеру.",
