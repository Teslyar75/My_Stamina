            "negros-noun"
          ]
        },
        {
          "id": "1712273",
          "text": "Tengo los ojos negros.",
          "translation": "У меня чёрные глаза.",
          "source": "Tatoeba #1712273 @teskmon / #1512497 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1712273",
