          "source": "Tatoeba #7281819 @arh / #7926100 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7281819",
          "cefr_level": "A1",
          "word_slugs": [
            "nacional-adj"
          ]
        },
        {
