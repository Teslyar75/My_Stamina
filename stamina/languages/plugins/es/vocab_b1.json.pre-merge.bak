          "embarrassment"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "850654",
          "text": "Me das vergüenza.",
          "translation": "Мне стыдно за тебя.",
          "source": "Tatoeba #850654 @Warnerbroder / #880929 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/850654",
