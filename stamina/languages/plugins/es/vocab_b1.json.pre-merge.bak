          "work (usually literary or artistic)",
          "construction"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1671091",
          "text": "¡Manos a la obra!",
          "translation": "За дело!",
          "source": "Tatoeba #1671091 @termito2nd / #650446 @salikh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1671091",
          "cefr_level": "A1",
          "word_slugs": [
            "obra-noun"
          ]
        },
        {
          "id": "7715955",
          "text": "Su obra fue censurada.",
          "translation": "Его произведение подверглось цензуре.",
          "source": "Tatoeba #7715955 @arh / #7716736 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7715955",
          "cefr_level": "A1",
          "word_slugs": [
            "obra-noun"
          ]
        },
        {
          "id": "6055893",
          "text": "Obra empezada, medio acabada.",
          "translation": "Хорошее начало — половина дела.",
          "source": "Tatoeba #6055893 @Adelpa / #2460726 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6055893",
          "cefr_level": "A1",
          "word_slugs": [
            "obra-noun"
          ]
        },
        {
          "id": "576189",
          "text": "El fin corona la obra.",
          "translation": "Конец — делу венец.",
          "source": "Tatoeba #576189 @Leono / #379346 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/576189",
          "cefr_level": "A1",
          "word_slugs": [
            "obra-noun"
          ]
