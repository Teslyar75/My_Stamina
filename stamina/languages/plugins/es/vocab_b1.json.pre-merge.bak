          "visit",
          "visitor, visitors",
          "view",
          "chapel at the center of a barrio"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "12887222",
          "text": "Estoy de visita.",
          "translation": "Я в гостях.",
