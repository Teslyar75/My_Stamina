    {
      "slug": "washington-name",
      "lemma": "Washington",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1977,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "Washington, Washington State (a state in the Pacific Northwest region of the United States)",
          "the letter W in the Spanish spelling alphabet"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1388300",
          "text": "Washington estaba preocupado.",
          "translation": "Вашингтон был обеспокоен.",
          "source": "Tatoeba #1388300 @marcelostockle / #3075097 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1388300",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        },
        {
          "id": "5137820",
          "text": "Lincoln volvió a Washington.",
          "translation": "Линкольн вернулся в Вашингтон.",
          "source": "Tatoeba #5137820 @don_ramon / #5137846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5137820",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        },
        {
          "id": "536220",
          "text": "George Washington nació en 1732.",
          "translation": "Джордж Вашингтон родился в 1732 году.",
          "source": "Tatoeba #536220 @Shishir / #3066697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/536220",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        },
        {
          "id": "2077832",
          "text": "¿Hace mucho calor en Washington?",
          "translation": "В Вашингтоне очень жарко?",
          "source": "Tatoeba #2077832 @marcelostockle / #6024532 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2077832",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        },
        {
          "id": "1524243",
          "text": "Ella iría a Washington con él.",
          "translation": "Она бы поехала в Вашингтон с ним.",
          "source": "Tatoeba #1524243 @marcelostockle / #5336346 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1524243",
          "cefr_level": "A1",
          "word_slugs": [
            "washington-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "Washington",
        "plural": "",
        "infinitive": ""
      }
