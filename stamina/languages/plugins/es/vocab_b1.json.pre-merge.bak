        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1392489",
          "text": "He metido la pata.",
          "translation": "Я лоханулся.",
          "source": "Tatoeba #1392489 @enteka / #5243527 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1392489",
          "cefr_level": "A1",
          "word_slugs": [
