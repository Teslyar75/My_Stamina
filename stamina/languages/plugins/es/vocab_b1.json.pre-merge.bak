    {
      "slug": "dirá-verb",
      "lemma": "dirá",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2260,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular future indicative of decir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9154928",
          "text": "Tom te dirá.",
          "translation": "Том тебе скажет.",
          "source": "Tatoeba #9154928 @rafaeldejesus8199 / #4652135 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9154928",
          "cefr_level": "A1",
          "word_slugs": [
            "dirá-verb"
          ]
        },
        {
          "id": "6630319",
          "text": "Os dirá que no.",
          "translation": "Он скажет вам нет.",
          "source": "Tatoeba #6630319 @arh / #6932896 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6630319",
          "cefr_level": "A1",
          "word_slugs": [
            "dirá-verb"
          ]
        },
        {
          "id": "1829297",
          "text": "¿Me dirá la verdad?",
          "translation": "Вы скажете мне правду?",
          "source": "Tatoeba #1829297 @Shishir / #7166985 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1829297",
          "cefr_level": "A1",
          "word_slugs": [
            "dirá-verb"
          ]
        },
        {
          "id": "2319905",
          "text": "No sé qué dirá Tom.",
          "translation": "Я не знаю, что скажет Том.",
          "source": "Tatoeba #2319905 @marcelostockle / #3878074 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2319905",
          "cefr_level": "A1",
          "word_slugs": [
            "dirá-verb"
          ]
        },
        {
          "id": "4490160",
          "text": "Me pregunto qué él dirá.",
          "translation": "Мне интересно, что он скажет.",
          "source": "Tatoeba #4490160 @mervert1 / #5919783 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4490160",
          "cefr_level": "A1",
          "word_slugs": [
            "dirá-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
