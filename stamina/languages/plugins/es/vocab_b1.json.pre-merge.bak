      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "bullet"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4541104",
          "text": "La cabra bala.",
          "translation": "Коза блеет.",
          "source": "Tatoeba #4541104 @cueyayotl / #4899771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4541104",
          "cefr_level": "A1",
          "word_slugs": [
            "bala-noun"
          ]
        },
        {
          "id": "4538892",
          "text": "El borrego bala.",
          "translation": "Овца блеет.",
          "source": "Tatoeba #4538892 @cueyayotl / #4539179 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538892",
          "cefr_level": "A1",
          "word_slugs": [
            "bala-noun"
          ]
        },
        {
          "id": "1273931",
          "text": "Él fue herido por una bala.",
          "translation": "Он был ранен пулей.",
          "source": "Tatoeba #1273931 @marcelostockle / #2974325 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1273931",
          "cefr_level": "A1",
          "word_slugs": [
            "bala-noun"
          ]
        },
        {
          "id": "2259276",
          "text": "La bala le atravesó el brazo.",
          "translation": "Пуля прошла ему через руку.",
          "source": "Tatoeba #2259276 @hayastan / #3552553 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259276",
          "cefr_level": "A1",
          "word_slugs": [
            "bala-noun"
          ]
        },
        {
          "id": "10111228",
          "text": "¿Alguna vez has tenido una herida de bala?",
          "translation": "У тебя были огнестрельные ранения?",
          "source": "Tatoeba #10111228 @manufrutos / #12847606 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10111228",
          "cefr_level": "A1",
          "word_slugs": [
            "bala-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
