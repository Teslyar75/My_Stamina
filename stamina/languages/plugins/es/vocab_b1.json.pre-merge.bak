    {
      "slug": "irá-verb",
      "lemma": "irá",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1315,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular future indicative of ir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1384676",
          "text": "Todo irá bien.",
          "translation": "Всё пройдёт хорошо.",
          "source": "Tatoeba #1384676 @enteka / #1434078 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1384676",
          "cefr_level": "A1",
          "word_slugs": [
            "irá-verb"
          ]
        },
        {
          "id": "750430",
          "text": "Él también irá.",
          "translation": "Он тоже пойдет.",
          "source": "Tatoeba #750430 @Shishir / #2152243 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/750430",
          "cefr_level": "A1",
          "word_slugs": [
            "irá-verb"
          ]
        },
        {
          "id": "2217432",
          "text": "Tom irá primero.",
          "translation": "Том пойдёт первым.",
          "source": "Tatoeba #2217432 @hayastan / #4477827 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2217432",
          "cefr_level": "A1",
