    {
      "slug": "molesto-adj",
      "lemma": "molesto",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2288,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "annoyed, vexed",
          "annoying, obtrusive",
          "uncomfortable"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1819848",
          "text": "No te molesto, ¿verdad?",
          "translation": "Я тебе не мешаю, нет?",
