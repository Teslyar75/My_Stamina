      "translations": {
        "en": [
          "theory"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2807584",
          "text": "Tenemos una teoría.",
          "translation": "У нас есть теория.",
          "source": "Tatoeba #2807584 @nancy / #4067555 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2807584",
          "cefr_level": "A1",
          "word_slugs": [
            "teoría-noun"
          ]
        },
        {
          "id": "2830280",
          "text": "Esa es la teoría.",
