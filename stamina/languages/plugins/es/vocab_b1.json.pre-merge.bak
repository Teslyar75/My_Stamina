    {
      "slug": "podrás-verb",
      "lemma": "podrás",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1707,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular future indicative of poder"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1667304",
          "text": "Mañana podrás verlo.",
          "translation": "Завтра ты сможешь его увидеть.",
          "source": "Tatoeba #1667304 @marcelostockle / #13992124 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1667304",
          "cefr_level": "A1",
          "word_slugs": [
            "podrás-verb"
          ]
        },
        {
          "id": "455009",
          "text": "Pronto te podrás ir.",
          "translation": "Скоро ты сможешь уйти.",
          "source": "Tatoeba #455009 @Shishir / #5327615 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455009",
          "cefr_level": "A1",
          "word_slugs": [
            "podrás-verb"
          ]
        },
        {
          "id": "6634340",
          "text": "Creo que no podrás hacerlo.",
          "translation": "Я думаю, у тебя не получится это сделать.",
          "source": "Tatoeba #6634340 @UsuarioX / #4311432 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6634340",
          "cefr_level": "A1",
          "word_slugs": [
            "podrás-verb"
          ]
        },
        {
          "id": "1957957",
          "text": "Solo allí podrás comprar esto.",
          "translation": "Только там ты сможешь купить это.",
          "source": "Tatoeba #1957957 @teskmon / #6981990 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1957957",
          "cefr_level": "A1",
          "word_slugs": [
            "podrás-verb"
          ]
        },
        {
          "id": "960190",
          "text": "Podrás correr, pero no escapar.",
          "translation": "Ты можешь бежать, но не убежать.",
          "source": "Tatoeba #960190 @Sonoriuxo / #5141797 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/960190",
          "cefr_level": "A1",
          "word_slugs": [
            "podrás-verb"
          ]
        }
