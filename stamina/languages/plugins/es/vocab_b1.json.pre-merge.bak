      },
      "gender": null,
      "examples": [
        {
          "id": "338839",
          "text": "¿Qué desea beber?",
          "translation": "Что желаете пить?",
          "source": "Tatoeba #338839 @tatoerique / #1441180 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/338839",
