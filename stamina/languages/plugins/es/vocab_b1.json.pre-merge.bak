    {
      "slug": "gira-noun",
      "lemma": "gira",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2305,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "tour (a journey through a list of places)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7276575",
          "text": "Gira la llave.",
          "translation": "Поверни ключ.",
          "source": "Tatoeba #7276575 @arh / #7285882 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7276575",
          "cefr_level": "A1",
          "word_slugs": [
            "gira-noun"
          ]
        },
        {
          "id": "950650",
          "text": "La tierra gira.",
          "translation": "Земля вертится.",
          "source": "Tatoeba #950650 @hayastan / #739807 @GranD (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/950650",
          "cefr_level": "A1",
          "word_slugs": [
            "gira-noun"
          ]
        },
        {
          "id": "2268653",
          "text": "La rueda no gira.",
          "translation": "Колесо не крутится.",
          "source": "Tatoeba #2268653 @cueyayotl / #5628149 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2268653",
          "cefr_level": "A1",
          "word_slugs": [
            "gira-noun"
          ]
        },
        {
          "id": "5748744",
          "text": "El ventilador no gira.",
          "translation": "Вентилятор не крутится.",
          "source": "Tatoeba #5748744 @arh / #5748820 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5748744",
          "cefr_level": "A1",
          "word_slugs": [
            "gira-noun"
          ]
        },
        {
          "id": "347379",
          "text": "Gira en aquella esquina.",
          "translation": "Поверни на том углу.",
          "source": "Tatoeba #347379 @tatoerique / #3366093 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/347379",
