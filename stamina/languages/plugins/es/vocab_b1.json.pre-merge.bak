    {
      "slug": "violencia-noun",
      "lemma": "violencia",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2276,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "violence",
          "act of violence"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5038515",
          "text": "No uses violencia.",
          "translation": "Не прибегай к насилию.",
          "source": "Tatoeba #5038515 @cueyayotl / #6171356 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5038515",
          "cefr_level": "A1",
          "word_slugs": [
            "violencia-noun"
          ]
        },
        {
          "id": "1296951",
          "text": "Aborrecemos la violencia.",
          "translation": "Мы не терпим насилия.",
          "source": "Tatoeba #1296951 @marcelostockle / #5619900 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1296951",
          "cefr_level": "A1",
          "word_slugs": [
            "violencia-noun"
          ]
        },
        {
          "id": "1296950",
          "text": "Nos disgusta la violencia.",
          "translation": "Нам не нравится насилие.",
          "source": "Tatoeba #1296950 @marcelostockle / #6001453 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1296950",
          "cefr_level": "A1",
          "word_slugs": [
            "violencia-noun"
          ]
        },
        {
          "id": "1642055",
          "text": "No hace falta la violencia.",
          "translation": "Нет необходимости в насилии.",
          "source": "Tatoeba #1642055 @marcelostockle / #7578563 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1642055",
          "cefr_level": "A1",
          "word_slugs": [
            "violencia-noun"
          ]
        },
        {
          "id": "1594509",
          "text": "Debemos acabar con la violencia.",
          "translation": "Мы должны покончить с насилием.",
          "source": "Tatoeba #1594509 @marcelostockle / #5160443 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1594509",
          "cefr_level": "A1",
          "word_slugs": [
            "violencia-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "violencia",
