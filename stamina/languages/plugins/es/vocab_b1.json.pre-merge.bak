      "gender": null,
      "examples": [
        {
          "id": "1084907",
          "text": "Son mis últimas vacaciones.",
          "translation": "Это мои последние каникулы.",
          "source": "Tatoeba #1084907 @alexmarcelo / #5430311 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1084907",
