    {
      "slug": "serie-noun",
      "lemma": "serie",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1649,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "series (a number of things that follow one another)",
          "series (a television or radio program with several episodes)",
          "series",
          "set"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1125847",
          "text": "Eres un asesino en serie.",
          "translation": "Ты серийный убийца.",
          "source": "Tatoeba #1125847 @cueyayotl / #7338594 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1125847",
          "cefr_level": "A1",
          "word_slugs": [
            "serie-noun"
          ]
        },
        {
          "id": "4378643",
          "text": "¿Cuántas temporadas tiene esa serie?",
          "translation": "Сколько сезонов в этом сериале?",
          "source": "Tatoeba #4378643 @umano / #5316528 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4378643",
          "cefr_level": "A1",
          "word_slugs": [
            "serie-noun"
          ]
        },
        {
          "id": "504515",
          "text": "Betty es una asesina en serie.",
          "translation": "Бетти — серийная убийца.",
          "source": "Tatoeba #504515 @Shishir / #423493 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/504515",
          "cefr_level": "A1",
          "word_slugs": [
            "serie-noun"
          ]
        },
        {
          "id": "3902052",
          "text": "Tom cometió una serie de asesinatos.",
          "translation": "Том совершил серию убийств.",
          "source": "Tatoeba #3902052 @gianich73 / #3901963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3902052",
          "cefr_level": "A1",
          "word_slugs": [
            "serie-noun"
          ]
        },
        {
          "id": "1292299",
          "text": "Ellos dieron una serie de conciertos.",
          "translation": "Они дали серию концертов.",
          "source": "Tatoeba #1292299 @hayastan / #5079812 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1292299",
          "cefr_level": "A1",
