    {
      "slug": "velocidad-noun",
      "lemma": "velocidad",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1622,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "speed",
          "velocity",
          "gear"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1759770",
          "text": "Esta velocidad es demencial.",
          "translation": "Это сумасшедшая скорость.",
          "source": "Tatoeba #1759770 @wallebot / #5661387 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1759770",
          "cefr_level": "A1",
          "word_slugs": [
            "velocidad-noun"
          ]
        },
        {
          "id": "4444231",
          "text": "¿Sabes a qué velocidad ibas?",
          "translation": "Ты знаешь, с какой скоростью ты шёл?",
          "source": "Tatoeba #4444231 @Shishir / #4477684 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4444231",
          "cefr_level": "A1",
          "word_slugs": [
            "velocidad-noun"
          ]
        },
        {
          "id": "339996",
          "text": "Lo detuvieron por exceso de velocidad.",
          "translation": "Его задержали за превышение скорости.",
          "source": "Tatoeba #339996 @tatoerique / #3963729 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/339996",
          "cefr_level": "A1",
          "word_slugs": [
            "velocidad-noun"
          ]
        },
        {
          "id": "6592117",
          "text": "Tomamos la curva a demasiada velocidad.",
          "translation": "Мы въехали в поворот на слишком большой скорости.",
          "source": "Tatoeba #6592117 @arh / #7575315 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6592117",
          "cefr_level": "A1",
          "word_slugs": [
            "velocidad-noun"
          ]
        },
        {
          "id": "2141441",
          "text": "¡Baja la velocidad o vamos a morir!",
          "translation": "Сбавь скорость, или мы умрём!",
          "source": "Tatoeba #2141441 @marcelostockle / #5992221 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2141441",
          "cefr_level": "A1",
          "word_slugs": [
            "velocidad-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "velocidad",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "total-adj",
      "lemma": "total",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1623,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "total, complete, outright"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2230056",
          "text": "Son cinco en total.",
          "translation": "Всего их пять.",
          "source": "Tatoeba #2230056 @Shishir / #6107717 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2230056",
          "cefr_level": "A1",
          "word_slugs": [
            "total-adj"
          ]
        },
        {
          "id": "746431",
          "text": "Somos ocho en total.",
          "translation": "Нас всего восемь человек.",
          "source": "Tatoeba #746431 @darinmex / #14027012 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/746431",
          "cefr_level": "A1",
          "word_slugs": [
            "total-adj"
          ]
        },
        {
          "id": "3411075",
          "text": "En total, somos once.",
          "translation": "Итого, нас одиннадцать.",
          "source": "Tatoeba #3411075 @cueyayotl / #3413442 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3411075",
          "cefr_level": "A1",
          "word_slugs": [
            "total-adj"
          ]
        },
        {
          "id": "5971223",
          "text": "Fue un total desastre.",
          "translation": "Это была полная катастрофа.",
          "source": "Tatoeba #5971223 @albrusgher / #4155681 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971223",
          "cefr_level": "A1",
          "word_slugs": [
            "total-adj"
          ]
        },
        {
          "id": "331451",
          "text": "Es una total pérdida de tiempo.",
          "translation": "Это пустая трата времени.",
          "source": "Tatoeba #331451 @danilo / #1711368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/331451",
          "cefr_level": "A1",
          "word_slugs": [
            "total-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el total",
        "plural": "",
        "infinitive": ""
      }
    },
