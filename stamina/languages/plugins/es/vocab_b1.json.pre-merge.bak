        "en": [
          "infinitive of ver combined with la"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2058915",
          "text": "Acabo de verla.",
          "translation": "Я только что её видел.",
          "source": "Tatoeba #2058915 @Shishir / #6139911 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2058915",
          "cefr_level": "A1",
          "word_slugs": [
            "verla-verb"
          ]
        },
        {
          "id": "5836342",
          "text": "Tom quería verla.",
          "translation": "Том хотел увидеть её.",
          "source": "Tatoeba #5836342 @Berkay / #6883224 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5836342",
          "cefr_level": "A1",
          "word_slugs": [
            "verla-verb"
          ]
        },
        {
          "id": "10319899",
          "text": "¿Volveré a verla?",
