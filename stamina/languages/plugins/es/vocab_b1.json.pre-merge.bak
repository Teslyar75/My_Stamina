    {
      "slug": "encargo-noun",
      "lemma": "encargo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2500,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "order (a product that is ordered)",
          "errand, task",
          "commission, assignment, job (an order at work from one's boss)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1156203",
          "text": "Te encargo este trabajo.",
          "translation": "Я поручаю тебе эту работу.",
          "source": "Tatoeba #1156203 @marcelostockle / #5627857 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1156203",
          "cefr_level": "A1",
          "word_slugs": [
            "encargo-noun"
          ]
        },
        {
          "id": "3967736",
          "text": "¡De ti me encargo yo!",
          "translation": "Тобой займусь я!",
          "source": "Tatoeba #3967736 @gianich73 / #7453531 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3967736",
          "cefr_level": "A1",
          "word_slugs": [
            "encargo-noun"
          ]
        },
        {
          "id": "2077805",
          "text": "Mañana me encargo de eso.",
          "translation": "Завтра я позабочусь об этом.",
          "source": "Tatoeba #2077805 @marcelostockle / #4683761 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2077805",
          "cefr_level": "A1",
          "word_slugs": [
            "encargo-noun"
          ]
        },
        {
          "id": "2060126",
          "text": "Déjamelo a mí: yo me encargo.",
          "translation": "Предоставь это мне. Я обо всём позабочусь.",
          "source": "Tatoeba #2060126 @lazarus1907 / #5465075 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2060126",
          "cefr_level": "A1",
          "word_slugs": [
            "encargo-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
