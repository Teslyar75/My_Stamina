    {
      "slug": "chaqueta-noun",
      "lemma": "chaqueta",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2451,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "jacket, piece of clothing worn on the upper body outside a shirt or blouse, often waist length to thigh length"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "992657",
          "text": "Abróchate la chaqueta.",
          "translation": "Застегни куртку.",
          "source": "Tatoeba #992657 @hayastan / #4476055 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/992657",
          "cefr_level": "A1",
          "word_slugs": [
            "chaqueta-noun"
          ]
        },
        {
          "id": "3303176",
          "text": "Me gusta tu chaqueta.",
          "translation": "Мне нравится твоя куртка.",
          "source": "Tatoeba #3303176 @Shishir / #7672656 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3303176",
          "cefr_level": "A1",
          "word_slugs": [
            "chaqueta-noun"
          ]
        },
        {
          "id": "12679964",
          "text": "Necesito una chaqueta nueva.",
          "translation": "Мне нужна новая куртка.",
          "source": "Tatoeba #12679964 @Shishir / #5964640 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12679964",
          "cefr_level": "A1",
          "word_slugs": [
            "chaqueta-noun"
          ]
        },
        {
          "id": "4289895",
