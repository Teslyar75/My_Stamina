          "third-person plural preterite indicative of dar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5967573",
          "text": "Nada os dieron.",
          "translation": "Ничего вам не дали.",
          "source": "Tatoeba #5967573 @arh / #6976056 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5967573",
          "cefr_level": "A1",
