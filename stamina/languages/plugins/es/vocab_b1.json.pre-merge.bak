    {
      "slug": "protección-noun",
      "lemma": "protección",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2105,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "protection"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4392195",
          "text": "No necesito protección.",
          "translation": "Мне не нужна защита.",
          "source": "Tatoeba #4392195 @pchamorro / #5062574 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4392195",
          "cefr_level": "A1",
          "word_slugs": [
            "protección-noun"
          ]
        },
        {
          "id": "10795640",
          "text": "Tom necesitaba protección.",
          "translation": "Тому нужна была защита.",
          "source": "Tatoeba #10795640 @Curro / #3056139 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10795640",
          "cefr_level": "A1",
          "word_slugs": [
            "protección-noun"
          ]
        },
        {
          "id": "2340318",
          "text": "No necesito tu protección.",
          "translation": "Я не нуждаюсь в твоей защите.",
          "source": "Tatoeba #2340318 @hayastan / #2498093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2340318",
          "cefr_level": "A1",
          "word_slugs": [
            "protección-noun"
          ]
        },
        {
          "id": "8310972",
          "text": "Estos árboles necesitan nuestra protección.",
          "translation": "Эти деревья нуждаются в нашей защите.",
          "source": "Tatoeba #8310972 @arh / #13742733 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8310972",
          "cefr_level": "A1",
          "word_slugs": [
            "protección-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "protección",
        "plural": "",
