          ]
        },
        {
          "id": "7860103",
          "text": "No va a funcionar.",
          "translation": "Это не сработает.",
          "source": "Tatoeba #7860103 @arh / #4437449 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7860103",
          "cefr_level": "A1",
          "word_slugs": [
            "funcionar-verb"
          ]
        },
        {
          "id": "1321079",
          "text": "Eso no va a funcionar.",
