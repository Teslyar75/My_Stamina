    {
      "slug": "santo-adj",
      "lemma": "santo",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1232,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "holy, godly"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "752245",
          "text": "¡Cielo santo! ¡Está delicioso!",
          "translation": "Святые небеса! Как вкусно!",
          "source": "Tatoeba #752245 @chinopinyin / #4269289 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/752245",
          "cefr_level": "A1",
          "word_slugs": [
            "santo-adj"
          ]
        },
        {
          "id": "7974197",
          "text": "Yo tampoco soy un santo.",
          "translation": "Я тоже не святой.",
          "source": "Tatoeba #7974197 @Seael / #7974189 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7974197",
          "cefr_level": "A1",
          "word_slugs": [
            "santo-adj"
          ]
        },
        {
          "id": "3724709",
          "text": "Que Dios el Espíritu Santo sea contigo siempre.",
          "translation": "Да пребудет с тобой Святой Дух отныне и вовеки веков.",
          "source": "Tatoeba #3724709 @cueyayotl / #6144759 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3724709",
          "cefr_level": "A1",
          "word_slugs": [
            "santo-adj"
          ]
        },
        {
          "id": "7910032",
          "text": "Santo Tomé es la capital de Santo Tomé y Príncipe.",
          "translation": "Сан-Томе - столица Сан-Томе и Принсипи.",
          "source": "Tatoeba #7910032 @MarijnKp / #12834579 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7910032",
          "cefr_level": "A1",
          "word_slugs": [
            "santo-adj"
          ]
        },
        {
          "id": "12131882",
          "text": "En el nombre del Padre, y del Hijo, y del Espíritu Santo.",
          "translation": "Во имя Отца и Сына и Святого Духа.",
          "source": "Tatoeba #12131882 @Adelpa / #6015805 @sicerabibax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12131882",
          "cefr_level": "A1",
          "word_slugs": [
            "santo-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
