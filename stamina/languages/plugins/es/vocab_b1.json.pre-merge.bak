        {
          "id": "1705596",
          "text": "Necesito tu firma aquí.",
          "translation": "Мне нужна твоя подпись здесь.",
          "source": "Tatoeba #1705596 @marcelostockle / #3689074 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1705596",
          "cefr_level": "A1",
          "word_slugs": [
            "firma-verb"
          ]
        },
        {
          "id": "3260655",
          "text": "Esa no es mi firma.",
          "translation": "Это не моя подпись.",
          "source": "Tatoeba #3260655 @Shishir / #3260704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3260655",
          "cefr_level": "A1",
          "word_slugs": [
            "firma-verb"
          ]
        },
        {
          "id": "7586964",
          "text": "Esa firma no es válida.",
          "translation": "Эта подпись недействительна.",
          "source": "Tatoeba #7586964 @arh / #7587543 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7586964",
          "cefr_level": "A1",
          "word_slugs": [
            "firma-verb"
          ]
        },
        {
          "id": "1023276",
          "text": "Esta carta no tiene firma.",
          "translation": "Это письмо не подписано.",
          "source": "Tatoeba #1023276 @arashi_29 / #4060072 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1023276",
          "cefr_level": "A1",
          "word_slugs": [
            "firma-verb"
          ]
        },
        {
          "id": "6779678",
          "text": "Pon la fecha debajo de la firma.",
          "translation": "Под подписью поставь дату.",
          "source": "Tatoeba #6779678 @arh / #9434283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6779678",
          "cefr_level": "A1",
          "word_slugs": [
            "firma-verb"
          ]
        }
      ],
