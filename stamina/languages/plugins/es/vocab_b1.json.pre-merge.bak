        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13342732",
          "text": "Lo dijo claramente.",
          "translation": "Он ясно это сказал.",
          "source": "Tatoeba #13342732 @frpzzd / #12477429 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13342732",
          "cefr_level": "A1",
