          ]
        },
        {
          "id": "4463384",
          "text": "¿Está limpio el lugar?",
          "translation": "Место чистое?",
          "source": "Tatoeba #4463384 @cueyayotl / #4463453 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4463384",
          "cefr_level": "A1",
          "word_slugs": [
            "limpio-adj"
          ]
        },
        {
          "id": "3037599",
          "text": "Su cachorro está limpio.",
          "translation": "Её щенок чистый.",
          "source": "Tatoeba #3037599 @marcelostockle / #3632440 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3037599",
          "cefr_level": "A1",
          "word_slugs": [
            "limpio-adj"
          ]
        },
        {
          "id": "610594",
          "text": "Él mantiene su cuarto limpio.",
          "translation": "Он содержит свою комнату в чистоте.",
          "source": "Tatoeba #610594 @qdii / #7144783 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/610594",
          "cefr_level": "A1",
          "word_slugs": [
            "limpio-adj"
          ]
        },
        {
          "id": "13416120",
          "text": "Mi cuarto siempre está limpio.",
          "translation": "Моя комната всегда чистая.",
          "source": "Tatoeba #13416120 @frpzzd / #3932654 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13416120",
          "cefr_level": "A1",
          "word_slugs": [
            "limpio-adj"
          ]
        }
      ],
      "tags": [
