    {
      "slug": "puedan-verb",
      "lemma": "puedan",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2016,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of poder:",
          "third-person plural present subjunctive",
          "inflection of poder:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3267017",
          "text": "Ojalá los ciegos puedan ver.",
          "translation": "Дай Бог слепым прозреть.",
          "source": "Tatoeba #3267017 @ecorralest101 / #3267018 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3267017",
          "cefr_level": "A1",
          "word_slugs": [
            "puedan-verb"
          ]
        },
        {
          "id": "6779687",
          "text": "Dicen que volverán cuando puedan.",
          "translation": "Они говорят, что вернутся, когда смогут.",
          "source": "Tatoeba #6779687 @arh / #6783050 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6779687",
          "cefr_level": "A1",
          "word_slugs": [
            "puedan-verb"
          ]
        },
        {
          "id": "5000274",
          "text": "Reúnan todo el dinero que puedan.",
          "translation": "Соберите все деньги, какие можете.",
          "source": "Tatoeba #5000274 @DarkHollow / #5315736 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5000274",
          "cefr_level": "A1",
          "word_slugs": [
            "puedan-verb"
          ]
        },
        {
          "id": "672227",
          "text": "Habla más fuerte para que todos puedan oírte.",
          "translation": "Говори громче, чтобы все могли тебя слышать.",
          "source": "Tatoeba #672227 @Leono / #2029695 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/672227",
          "cefr_level": "A1",
          "word_slugs": [
            "puedan-verb"
          ]
        },
        {
          "id": "3418018",
          "text": "No hay muchos estudiantes que puedan leer latín.",
          "translation": "Немногие студенты умеют читать на латыни.",
          "source": "Tatoeba #3418018 @cueyayotl / #3556554 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3418018",
          "cefr_level": "A1",
          "word_slugs": [
            "puedan-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "puedan",
