    {
      "slug": "verle-verb",
      "lemma": "verle",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2240,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of ver combined with le"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1784979",
          "text": "No puedo verle.",
          "translation": "Я его не вижу.",
          "source": "Tatoeba #1784979 @Shishir / #3249097 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1784979",
          "cefr_level": "A1",
          "word_slugs": [
            "verle-verb"
          ]
        },
        {
          "id": "1713600",
          "text": "Necesito verle nuevamente.",
          "translation": "Мне нужно снова его увидеть.",
          "source": "Tatoeba #1713600 @marcelostockle / #5379943 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1713600",
          "cefr_level": "A1",
          "word_slugs": [
            "verle-verb"
          ]
        },
        {
          "id": "2108295",
          "text": "Nunca volví a verle.",
          "translation": "Больше я его не видел.",
          "source": "Tatoeba #2108295 @Shishir / #6900775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2108295",
          "cefr_level": "A1",
          "word_slugs": [
            "verle-verb"
          ]
        },
        {
          "id": "1290194",
          "text": "No podía verle sufrir.",
          "translation": "Я не мог видеть, как он страдает.",
          "source": "Tatoeba #1290194 @enteka / #8286076 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1290194",
          "cefr_level": "A1",
          "word_slugs": [
            "verle-verb"
          ]
        },
        {
          "id": "346662",
          "text": "¿Puedo verle esta noche?",
          "translation": "Могу ли я увидеть вас сегодня вечером?",
          "source": "Tatoeba #346662 @tatoerique / #9952139 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/346662",
          "cefr_level": "A1",
          "word_slugs": [
            "verle-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "verle",
