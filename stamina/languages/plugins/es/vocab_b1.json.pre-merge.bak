    {
      "slug": "debió-verb",
      "lemma": "debió",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1778,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular preterite indicative of deber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1165861",
          "text": "Tom debió haber llamado.",
          "translation": "Том должен был позвонить.",
          "source": "Tatoeba #1165861 @marcelostockle / #5256068 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1165861",
          "cefr_level": "A1",
          "word_slugs": [
            "debió-verb"
          ]
        },
        {
          "id": "3860192",
          "text": "Es lo que debió ocurrir.",
          "translation": "Это то, что и должно происходить.",
          "source": "Tatoeba #3860192 @gianich73 / #3860176 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3860192",
          "cefr_level": "A1",
          "word_slugs": [
            "debió-verb"
          ]
        },
        {
          "id": "3860194",
          "text": "Esto no debió haber ocurrido.",
          "translation": "Этого ещё не должно было случиться.",
          "source": "Tatoeba #3860194 @gianich73 / #3860171 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3860194",
          "cefr_level": "A1",
          "word_slugs": [
            "debió-verb"
          ]
        },
        {
          "id": "1880200",
          "text": "Debió haber comprado algunos lápices.",
          "translation": "Ему надо было карандашей купить.",
          "source": "Tatoeba #1880200 @marcelostockle / #13085835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1880200",
          "cefr_level": "A1",
          "word_slugs": [
            "debió-verb"
          ]
        },
        {
          "id": "1165840",
          "text": "Tom no debió haber venido aquí.",
          "translation": "Тому не надо было сюда приходить.",
          "source": "Tatoeba #1165840 @marcelostockle / #5682568 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1165840",
          "cefr_level": "A1",
          "word_slugs": [
            "debió-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "debió",
        "plural": "",
        "infinitive": "debió"
      }
