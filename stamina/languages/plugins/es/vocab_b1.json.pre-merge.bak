            "podéis-verb"
          ]
        },
        {
          "id": "6862016",
          "text": "¿Podéis volver ahora?",
          "translation": "Вы можете сейчас вернуться?",
          "source": "Tatoeba #6862016 @arh / #7001828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6862016",
