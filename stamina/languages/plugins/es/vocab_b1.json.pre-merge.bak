          "cefr_level": "A1",
          "word_slugs": [
            "sur-noun"
          ]
        },
        {
          "id": "10265704",
          "text": "Los pájaros vuelan al sur.",
          "translation": "Птицы летят на юг.",
          "source": "Tatoeba #10265704 @Seael / #2649827 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10265704",
          "cefr_level": "A1",
          "word_slugs": [
            "sur-noun"
          ]
        },
        {
          "id": "1642744",
          "text": "Alemania del sur es montañosa.",
          "translation": "Юг Германии гористый.",
