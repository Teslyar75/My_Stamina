    {
      "slug": "época-noun",
      "lemma": "época",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1669,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "epoch, era, age, time, day",
          "season, time",
          "period (of time), time period",
          "epoch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5022397",
          "text": "En esa época era joven.",
          "translation": "В то время я был молод.",
          "source": "Tatoeba #5022397 @don_ramon / #4429269 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5022397",
          "cefr_level": "A1",
          "word_slugs": [
            "época-noun"
          ]
        },
        {
          "id": "1943543",
          "text": "Hace frío para esta época.",
          "translation": "Для этого времени года погода холодная.",
          "source": "Tatoeba #1943543 @wallebot / #6981997 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1943543",
          "cefr_level": "A1",
          "word_slugs": [
            "época-noun"
          ]
        },
        {
          "id": "2193508",
          "text": "En esa época éramos ricos.",
          "translation": "В то время мы были богаты.",
          "source": "Tatoeba #2193508 @Shishir / #2402165 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2193508",
          "cefr_level": "A1",
          "word_slugs": [
            "época-noun"
          ]
        },
        {
          "id": "2054936",
          "text": "Vivimos en una época maravillosa.",
          "translation": "Мы живём в замечательное время.",
          "source": "Tatoeba #2054936 @Shishir / #5552143 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2054936",
          "cefr_level": "A1",
          "word_slugs": [
            "época-noun"
          ]
        },
        {
          "id": "703023",
          "text": "Yo era estudiante en esa época.",
          "translation": "Я тогда была студенткой.",
          "source": "Tatoeba #703023 @andresevargas / #12716766 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/703023",
          "cefr_level": "A1",
          "word_slugs": [
            "época-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
