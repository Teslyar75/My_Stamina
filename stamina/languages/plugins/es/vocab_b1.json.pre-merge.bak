      },
      "gender": null,
      "examples": [
        {
          "id": "1966650",
          "text": "No tengo sentimientos.",
          "translation": "У меня нет чувств.",
          "source": "Tatoeba #1966650 @hayastan / #4930939 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1966650",
          "cefr_level": "A1",
          "word_slugs": [
