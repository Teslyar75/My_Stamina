    {
      "slug": "confianza-noun",
      "lemma": "confianza",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1409,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "confidence, trust"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1901096",
          "text": "La confianza se gana.",
          "translation": "Доверие надо заслужить.",
          "source": "Tatoeba #1901096 @marcelostockle / #7108770 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1901096",
          "cefr_level": "A1",
          "word_slugs": [
            "confianza-noun"
          ]
        },
        {
          "id": "2255622",
          "text": "Abusó de mi confianza.",
          "translation": "Он злоупотребил моим доверием.",
          "source": "Tatoeba #2255622 @cueyayotl / #1936741 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2255622",
          "cefr_level": "A1",
          "word_slugs": [
            "confianza-noun"
          ]
        },
        {
          "id": "1458615",
          "text": "No abuses de mi confianza.",
          "translation": "Не злоупотребляй моим доверием.",
          "source": "Tatoeba #1458615 @marcelostockle / #2464404 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1458615",
          "cefr_level": "A1",
          "word_slugs": [
            "confianza-noun"
          ]
        },
        {
          "id": "2996444",
          "text": "Lo esencial es tener confianza.",
          "translation": "Самое главное - иметь доверие.",
          "source": "Tatoeba #2996444 @marcelostockle / #2997272 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2996444",
          "cefr_level": "A1",
          "word_slugs": [
            "confianza-noun"
          ]
        },
        {
          "id": "7284702",
          "text": "Tengo absoluta confianza en él.",
          "translation": "Я ему полностью доверяю.",
          "source": "Tatoeba #7284702 @UsuarioX / #1442085 @chispa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7284702",
          "cefr_level": "A1",
          "word_slugs": [
            "confianza-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "confianza",
        "plural": "",
