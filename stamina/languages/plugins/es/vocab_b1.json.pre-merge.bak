            "veía-verb"
          ]
        },
        {
          "id": "3882910",
          "text": "Tom se veía muy triste.",
          "translation": "Том выглядел очень грустным.",
          "source": "Tatoeba #3882910 @cueyayotl / #5636012 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3882910",
          "cefr_level": "A1",
          "word_slugs": [
            "veía-verb"
          ]
        },
        {
          "id": "4130659",
          "text": "Hace tiempo que no te veía.",
          "translation": "Давно я тебя не видел.",
          "source": "Tatoeba #4130659 @gianich73 / #4130622 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4130659",
          "cefr_level": "A1",
