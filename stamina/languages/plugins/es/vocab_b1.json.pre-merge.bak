          "cefr_level": "A1",
          "word_slugs": [
            "crear-verb"
          ]
        },
        {
          "id": "1745363",
          "text": "Tengo que crear un nuevo sitio web.",
          "translation": "Мне надо создать новый сайт.",
          "source": "Tatoeba #1745363 @marcelostockle / #5927601 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1745363",
          "cefr_level": "A1",
          "word_slugs": [
            "crear-verb"
          ]
        },
        {
          "id": "5959962",
          "text": "Necesito un algoritmo para crear autómatas celulares.",
