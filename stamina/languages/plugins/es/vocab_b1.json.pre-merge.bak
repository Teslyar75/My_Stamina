      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2446,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of preguntar combined with te"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1904095",
          "text": "Quiero preguntarte algo.",
          "translation": "Я хочу тебя кое о чём спросить.",
          "source": "Tatoeba #1904095 @marcelostockle / #2383451 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1904095",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntarte-verb"
          ]
        },
        {
          "id": "2065705",
          "text": "Necesito preguntarte algo.",
          "translation": "Мне нужно кое-что у тебя спросить.",
          "source": "Tatoeba #2065705 @marcelostockle / #5188975 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2065705",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntarte-verb"
          ]
        },
        {
          "id": "813896",
          "text": "Tengo algo que preguntarte.",
