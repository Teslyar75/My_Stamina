          "inflection of intentar:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1712376",
          "text": "Intenta no llorar.",
          "translation": "Постарайся не плакать.",
          "source": "Tatoeba #1712376 @teskmon / #5226040 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1712376",
          "cefr_level": "A1",
          "word_slugs": [
            "intenta-verb"
          ]
        },
        {
          "id": "3666816",
          "text": "Ahora intenta dormir.",
          "translation": "Сейчас постарайся поспать.",
          "source": "Tatoeba #3666816 @Seael / #4509754 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3666816",
          "cefr_level": "A1",
          "word_slugs": [
            "intenta-verb"
          ]
        },
        {
          "id": "3948601",
          "text": "Intenta mantenerte despierto.",
          "translation": "Постарайся не спать.",
          "source": "Tatoeba #3948601 @nieku / #3950680 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3948601",
          "cefr_level": "A1",
          "word_slugs": [
            "intenta-verb"
          ]
        },
        {
          "id": "1619545",
          "text": "Siempre intenta decirnos algo.",
          "translation": "Она всё время пытается нам что-то сказать.",
          "source": "Tatoeba #1619545 @Shishir / #11965525 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1619545",
          "cefr_level": "A1",
          "word_slugs": [
            "intenta-verb"
          ]
        },
        {
          "id": "6623963",
          "text": "Intenta frenar sin brusquedad.",
          "translation": "Старайся тормозить плавно.",
          "source": "Tatoeba #6623963 @arh / #6624343 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6623963",
          "cefr_level": "A1",
          "word_slugs": [
            "intenta-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
