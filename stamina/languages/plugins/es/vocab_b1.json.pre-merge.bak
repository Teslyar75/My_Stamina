        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1794850",
          "text": "Vendí muchos autos.",
          "translation": "Я продал много машин.",
          "source": "Tatoeba #1794850 @marcelostockle / #5103976 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1794850",
          "cefr_level": "A1",
          "word_slugs": [
            "autos-noun"
          ]
        },
        {
          "id": "532028",
          "text": "Tú tienes tres autos.",
          "translation": "У тебя три машины.",
          "source": "Tatoeba #532028 @darinmex / #2029851 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/532028",
          "cefr_level": "A1",
          "word_slugs": [
            "autos-noun"
          ]
        },
        {
          "id": "1619217",
          "text": "Esos son nuestros autos.",
          "translation": "Это наши машины.",
          "source": "Tatoeba #1619217 @marcelostockle / #2159152 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1619217",
          "cefr_level": "A1",
          "word_slugs": [
            "autos-noun"
          ]
        },
        {
          "id": "12919329",
          "text": "Tenemos dos autos negros.",
          "translation": "У нас две чёрные машины.",
          "source": "Tatoeba #12919329 @araneo / #8441674 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12919329",
          "cefr_level": "A1",
          "word_slugs": [
            "autos-noun"
          ]
        },
        {
          "id": "1433850",
          "text": "¿Cuántos autos tiene Alex?",
          "translation": "Сколько машин у Алекса?",
          "source": "Tatoeba #1433850 @marcelostockle / #1433981 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1433850",
          "cefr_level": "A1",
          "word_slugs": [
