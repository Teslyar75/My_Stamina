        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7797463",
          "text": "Nos encontraremos allá.",
          "translation": "Увидимся там.",
          "source": "Tatoeba #7797463 @arh / #5553799 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7797463",
          "cefr_level": "A1",
          "word_slugs": [
            "encontraremos-verb"
          ]
        },
        {
          "id": "2270076",
          "text": "Nos encontraremos en el lugar acostumbrado.",
          "translation": "Мы встретимся где обычно.",
          "source": "Tatoeba #2270076 @hayastan / #4005244 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2270076",
          "cefr_level": "A1",
          "word_slugs": [
            "encontraremos-verb"
          ]
        },
        {
          "id": "1903911",
          "text": "Estoy seguro de que encontraremos una solución.",
          "translation": "Я уверен, что мы найдём решение.",
          "source": "Tatoeba #1903911 @marcelostockle / #1120009 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1903911",
          "cefr_level": "A1",
          "word_slugs": [
            "encontraremos-verb"
          ]
        },
        {
          "id": "14043681",
          "text": "Estoy segura de que encontraremos una solución.",
          "translation": "Я уверена, что мы найдём решение.",
          "source": "Tatoeba #14043681 @Adelpa / #4384185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14043681",
          "cefr_level": "A1",
          "word_slugs": [
            "encontraremos-verb"
          ]
        },
        {
          "id": "12696026",
          "text": "No importa, encontraremos algo para comer. No pasaremos hambre.",
          "translation": "Ничего, найдём что поесть. Голодными не останемся.",
          "source": "Tatoeba #12696026 @carlosalberto / #12695931 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12696026",
          "cefr_level": "A1",
          "word_slugs": [
            "encontraremos-verb"
          ]
        }
      ],
