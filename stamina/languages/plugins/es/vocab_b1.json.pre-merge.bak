  "words": [
    {
      "slug": "decirlo-verb",
      "lemma": "decirlo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1201,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of decir combined with lo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1319671",
          "text": "¡No basta con decirlo!",
          "translation": "Недостаточно сказать это!",
          "source": "Tatoeba #1319671 @massama / #4622188 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1319671",
          "cefr_level": "A1",
          "word_slugs": [
            "decirlo-verb"
          ]
        },
        {
          "id": "7682823",
          "text": "No sabía cómo decirlo.",
          "translation": "Я не знал, как это сказать.",
          "source": "Tatoeba #7682823 @arh / #7698163 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7682823",
          "cefr_level": "A1",
          "word_slugs": [
            "decirlo-verb"
          ]
        },
        {
          "id": "5690449",
          "text": "Desafortunadamente no puedo decirlo.",
          "translation": "К сожалению, я не могу этого сказать.",
          "source": "Tatoeba #5690449 @baudelaire / #7328729 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690449",
          "cefr_level": "A1",
          "word_slugs": [
            "decirlo-verb"
          ]
        },
        {
          "id": "1853422",
          "text": "Tuvo el valor de decirlo.",
          "translation": "Ему хватило мужества это сказать.",
          "source": "Tatoeba #1853422 @Shishir / #5734261 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1853422",
          "cefr_level": "A1",
          "word_slugs": [
            "decirlo-verb"
          ]
        },
        {
          "id": "5690450",
          "text": "Por desgracia no puedo decirlo.",
          "translation": "К сожалению, не могу этого сказать.",
          "source": "Tatoeba #5690450 @baudelaire / #6489716 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690450",
          "cefr_level": "A1",
          "word_slugs": [
            "decirlo-verb"
          ]
        }
      ],
