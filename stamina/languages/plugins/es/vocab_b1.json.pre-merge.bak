      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2327,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "kingdom",
          "kingdom",
          "realm, world"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1235171",
          "text": "Él reinó con justicia su reino.",
          "translation": "Он правил своим королевством справедливо.",
          "source": "Tatoeba #1235171 @marcelostockle / #7923928 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1235171",
          "cefr_level": "A1",
          "word_slugs": [
            "reino-noun"
          ]
        },
        {
          "id": "1825304",
          "text": "Este reino necesita un nuevo rey.",
          "translation": "Этому королевству нужен новый король.",
          "source": "Tatoeba #1825304 @hayastan / #6462719 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1825304",
          "cefr_level": "A1",
          "word_slugs": [
            "reino-noun"
          ]
        },
        {
          "id": "1158000",
          "text": "El reino fue invadido por el enemigo.",
          "translation": "Королевство было захвачено противником.",
          "source": "Tatoeba #1158000 @nancy / #4069521 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1158000",
          "cefr_level": "A1",
          "word_slugs": [
            "reino-noun"
          ]
        },
        {
          "id": "3441860",
          "text": "Voy al Reino Unido para ver a mis padres.",
          "translation": "Я еду в Великобританию навестить родителей.",
          "source": "Tatoeba #3441860 @ulymarrero / #13623264 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3441860",
          "cefr_level": "A1",
          "word_slugs": [
            "reino-noun"
          ]
        },
        {
          "id": "9421132",
          "text": "Reino Unido ha aprobado el uso de la vacuna.",
          "translation": "Великобритания одобрила применение вакцины.",
          "source": "Tatoeba #9421132 @ignacio / #12919128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9421132",
          "cefr_level": "A1",
          "word_slugs": [
            "reino-noun"
          ]
        }
      ],
