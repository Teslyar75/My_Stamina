          ]
        },
        {
          "id": "1598447",
          "text": "Debes limpiar tu habitación.",
          "translation": "Ты должен убраться в своей комнате.",
          "source": "Tatoeba #1598447 @AgentGreen / #2265568 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1598447",
