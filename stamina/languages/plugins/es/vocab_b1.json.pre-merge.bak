      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "France (a country located primarily in Western Europe)",
          "the letter F in the Spanish spelling alphabet"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9288817",
          "text": "Vivo en Francia.",
          "translation": "Я живу во Франции.",
          "source": "Tatoeba #9288817 @Javea / #8554439 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9288817",
          "cefr_level": "A1",
          "word_slugs": [
            "francia-name"
          ]
        },
        {
          "id": "464349",
          "text": "Somos de Francia.",
          "translation": "Мы из Франции.",
          "source": "Tatoeba #464349 @lukaszpp / #3572302 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/464349",
          "cefr_level": "A1",
          "word_slugs": [
            "francia-name"
          ]
        },
        {
          "id": "1923243",
          "text": "Vengo de Francia.",
          "translation": "Я из Франции.",
