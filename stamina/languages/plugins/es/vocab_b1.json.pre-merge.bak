          "word_slugs": [
            "oeste-noun"
          ]
        },
        {
          "id": "4762527",
          "text": "El avión voló hacia el oeste.",
          "translation": "Самолёт полетел на запад.",
          "source": "Tatoeba #4762527 @DarkHollow / #6727016 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4762527",
