          ]
        },
        {
          "id": "12470021",
          "text": "Éramos como hermanas.",
          "translation": "Мы были как сёстры.",
          "source": "Tatoeba #12470021 @Shishir / #12470123 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12470021",
          "cefr_level": "A1",
          "word_slugs": [
            "éramos-verb"
          ]
        },
        {
          "id": "1834105",
          "text": "Entonces éramos ricos.",
          "translation": "Тогда мы были богатыми.",
          "source": "Tatoeba #1834105 @Shishir / #11436421 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1834105",
          "cefr_level": "A1",
          "word_slugs": [
            "éramos-verb"
          ]
        },
        {
          "id": "14003527",
          "text": "Éramos aún muy jóvenes.",
          "translation": "Мы были ещё совсем молоды.",
          "source": "Tatoeba #14003527 @carlosalberto / #14003532 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14003527",
          "cefr_level": "A1",
          "word_slugs": [
            "éramos-verb"
          ]
        },
        {
          "id": "10029001",
          "text": "Pensé que éramos amigos.",
          "translation": "Я думал, мы друзья.",
          "source": "Tatoeba #10029001 @DJ_Saidez / #5653255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10029001",
          "cefr_level": "A1",
          "word_slugs": [
            "éramos-verb"
          ]
        }
      ],
