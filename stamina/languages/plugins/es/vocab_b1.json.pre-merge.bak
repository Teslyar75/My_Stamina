    {
      "slug": "cuello-noun",
      "lemma": "cuello",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1321,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "neck (part of body connecting the head and the torso)",
          "collar (part of a shirt fitting around the neck)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1239059",
          "text": "¡Te quebrarás el cuello!",
          "translation": "Ты себе шею сломаешь!",
          "source": "Tatoeba #1239059 @marcelostockle / #6285873 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1239059",
          "cefr_level": "A1",
          "word_slugs": [
            "cuello-noun"
          ]
        },
        {
          "id": "2260278",
          "text": "Él me besó el cuello.",
          "translation": "Он поцеловал меня в шею.",
          "source": "Tatoeba #2260278 @marcelostockle / #4004839 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2260278",
          "cefr_level": "A1",
          "word_slugs": [
            "cuello-noun"
          ]
        },
        {
          "id": "1136748",
          "text": "Él me agarró del cuello.",
          "translation": "Он схватил меня за шею.",
          "source": "Tatoeba #1136748 @nancy / #3708301 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1136748",
          "cefr_level": "A1",
          "word_slugs": [
            "cuello-noun"
          ]
        },
        {
          "id": "2266330",
          "text": "Tiene un cuello muy largo.",
          "translation": "У него очень длинная шея.",
          "source": "Tatoeba #2266330 @cueyayotl / #13957809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2266330",
          "cefr_level": "A1",
          "word_slugs": [
            "cuello-noun"
          ]
        },
        {
          "id": "1741692",
          "text": "Quítame la mano del cuello.",
          "translation": "Убери свою руку с моей шеи.",
          "source": "Tatoeba #1741692 @Shishir / #4196622 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1741692",
          "cefr_level": "A1",
          "word_slugs": [
            "cuello-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
