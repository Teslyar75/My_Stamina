          ]
        },
        {
          "id": "2079804",
          "text": "Soy candidato a alcalde.",
          "translation": "Я баллотируюсь на пост мэра.",
          "source": "Tatoeba #2079804 @marcelostockle / #7042785 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2079804",
          "cefr_level": "A1",
          "word_slugs": [
            "alcalde-name"
          ]
        },
        {
          "id": "1481585",
          "text": "Lo elegimos para alcalde.",
          "translation": "Мы выбрали его мэром.",
          "source": "Tatoeba #1481585 @marcelostockle / #5355295 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1481585",
          "cefr_level": "A1",
