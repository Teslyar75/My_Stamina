    {
      "slug": "ibas-verb",
      "lemma": "ibas",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1518,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular imperfect indicative of ir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4444231",
          "text": "¿Sabes a qué velocidad ibas?",
          "translation": "Ты знаешь, с какой скоростью ты шёл?",
          "source": "Tatoeba #4444231 @Shishir / #4477684 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4444231",
          "cefr_level": "A1",
          "word_slugs": [
            "ibas-verb"
          ]
        },
        {
          "id": "2059155",
          "text": "Pensé que me ibas a matar.",
          "translation": "Я думал, ты меня убьёшь.",
          "source": "Tatoeba #2059155 @hayastan / #5181573 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2059155",
          "cefr_level": "A1",
          "word_slugs": [
            "ibas-verb"
          ]
        },
        {
          "id": "3232846",
          "text": "Creía que no ibas a venir.",
