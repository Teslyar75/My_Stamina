    {
      "slug": "acabar-verb",
      "lemma": "acabar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1435,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to finish; to end",
          "to end up (eventually doing)",
          "to have just; just (indicates recency)",
          "to exhaust, to use up"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5950107",
          "text": "Al acabar, sal afuera.",
          "translation": "Уйди отсюда, когда закончишь.",
          "source": "Tatoeba #5950107 @arh / #9775519 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5950107",
          "cefr_level": "A1",
          "word_slugs": [
            "acabar-verb"
          ]
        },
        {
          "id": "1987436",
          "text": "No me has dejado acabar.",
          "translation": "Ты не дал мне закончить.",
          "source": "Tatoeba #1987436 @Shishir / #1895854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1987436",
          "cefr_level": "A1",
          "word_slugs": [
            "acabar-verb"
          ]
        },
        {
          "id": "5950058",
          "text": "Al acabar, apaga la luz.",
          "translation": "Как закончишь, выключи свет.",
          "source": "Tatoeba #5950058 @arh / #5951729 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5950058",
          "cefr_level": "A1",
          "word_slugs": [
            "acabar-verb"
          ]
        },
        {
          "id": "5950125",
          "text": "Al acabar, vete de aquí.",
          "translation": "Как закончишь, иди отсюда.",
          "source": "Tatoeba #5950125 @arh / #5951715 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5950125",
          "cefr_level": "A1",
          "word_slugs": [
            "acabar-verb"
          ]
        },
        {
          "id": "5950071",
          "text": "Al acabar, abre la ventana.",
          "translation": "Как закончишь, открой окно.",
          "source": "Tatoeba #5950071 @arh / #5951738 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5950071",
          "cefr_level": "A1",
          "word_slugs": [
            "acabar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el acabar",
        "plural": "",
        "infinitive": "acabar"
      }
