    {
      "slug": "sienta-verb",
      "lemma": "sienta",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2088,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of sentir:",
          "first/third-person singular present subjunctive",
          "inflection of sentir:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4554998",
          "text": "Deja que lo sienta.",
          "translation": "Дай мне это почувствовать.",
          "source": "Tatoeba #4554998 @swyter / #6376697 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4554998",
          "cefr_level": "A1",
          "word_slugs": [
            "sienta-verb"
          ]
        },
        {
          "id": "7865190",
          "text": "El traje te sienta de maravilla.",
          "translation": "Костюм прекрасно на тебе сидит.",
          "source": "Tatoeba #7865190 @arh / #7869738 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7865190",
          "cefr_level": "A1",
          "word_slugs": [
            "sienta-verb"
          ]
        },
        {
          "id": "878780",
          "text": "Mi abuelo siempre se sienta en esta silla.",
          "translation": "Мой дедушка всегда сидит на этом стуле.",
          "source": "Tatoeba #878780 @Pablete / #1708885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/878780",
          "cefr_level": "A1",
          "word_slugs": [
            "sienta-verb"
          ]
        },
        {
          "id": "1090715",
          "text": "La mujer que se sienta allí es su esposa actual.",
          "translation": "Женщина, сидящая там, является его нынешней супругой.",
          "source": "Tatoeba #1090715 @Shishir / #2746699 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1090715",
          "cefr_level": "A1",
          "word_slugs": [
            "sienta-verb"
          ]
        },
        {
          "id": "1619910",
          "text": "Mi perro se sienta al lado mío y mira televisión.",
          "translation": "Моя собака садится рядом со мной и смотрит телевизор.",
          "source": "Tatoeba #1619910 @marcelostockle / #12287833 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1619910",
          "cefr_level": "A1",
          "word_slugs": [
            "sienta-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "sienta",
        "plural": "",
        "infinitive": "sienta"
      }
