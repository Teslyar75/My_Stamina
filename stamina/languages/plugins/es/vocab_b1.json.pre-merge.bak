    {
      "slug": "ambas-adj",
      "lemma": "ambas",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2261,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "feminine plural of ambos"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6863627",
          "text": "Ambas son mías.",
          "translation": "Обе мои.",
          "source": "Tatoeba #6863627 @arh / #6888603 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6863627",
          "cefr_level": "A1",
          "word_slugs": [
            "ambas-adj"
          ]
        },
        {
          "id": "2992118",
          "text": "Gracias a ambas.",
          "translation": "Спасибо обеим.",
          "source": "Tatoeba #2992118 @alexmarcelo / #2992988 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2992118",
          "cefr_level": "A1",
          "word_slugs": [
            "ambas-adj"
          ]
        },
        {
          "id": "2909895",
          "text": "Ambas están muertas.",
          "translation": "Они обе мертвы.",
          "source": "Tatoeba #2909895 @marcelostockle / #2584560 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2909895",
          "cefr_level": "A1",
          "word_slugs": [
            "ambas-adj"
          ]
        },
        {
          "id": "4932814",
          "text": "Ambas somos adultas.",
          "translation": "Мы обе взрослые.",
          "source": "Tatoeba #4932814 @Leono / #4932872 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4932814",
          "cefr_level": "A1",
          "word_slugs": [
            "ambas-adj"
          ]
        },
        {
          "id": "6857995",
          "text": "Felicidades a ambas.",
          "translation": "Поздравляю вас обеих.",
          "source": "Tatoeba #6857995 @arh / #6858697 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857995",
          "cefr_level": "A1",
          "word_slugs": [
            "ambas-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "ambas",
        "plural": "",
        "infinitive": ""
      }
