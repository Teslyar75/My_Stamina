          "tree (any structure or construct having branches representing divergence or possible choices)",
          "mast (tall, slim post or tower used to support the sails on a ship)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9456294",
          "text": "Veis un árbol.",
