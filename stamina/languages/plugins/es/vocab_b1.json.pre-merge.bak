        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8189249",
          "text": "Continuaremos la conversación.",
          "translation": "Мы продолжим разговор.",
          "source": "Tatoeba #8189249 @Curro / #1118581 @mpffll (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8189249",
          "cefr_level": "A1",
