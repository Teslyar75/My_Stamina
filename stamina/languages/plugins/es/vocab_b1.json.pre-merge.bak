    {
      "slug": "tengan-verb",
      "lemma": "tengan",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1735,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of tener:",
          "third-person plural present subjunctive",
          "inflection of tener:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1535416",
          "text": "Tengan piedad de mí.",
          "translation": "Сжальтесь надо мной.",
          "source": "Tatoeba #1535416 @marcelostockle / #5155225 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1535416",
          "cefr_level": "A1",
          "word_slugs": [
            "tengan-verb"
          ]
        },
        {
          "id": "7426452",
          "text": "Diles que tengan cuidado.",
          "translation": "Скажи им, чтобы были осторожны.",
          "source": "Tatoeba #7426452 @emigonza / #5185066 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7426452",
          "cefr_level": "A1",
          "word_slugs": [
            "tengan-verb"
          ]
        },
        {
          "id": "2767123",
          "text": "¡Que tengan un buen domingo!",
          "translation": "Хорошего вам воскресенья!",
          "source": "Tatoeba #2767123 @cueyayotl / #2765922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2767123",
          "cefr_level": "A1",
          "word_slugs": [
            "tengan-verb"
          ]
        },
        {
          "id": "1543417",
          "text": "¡Tengan todos un buen examen!",
          "translation": "Всем хорошей сдачи экзамена!",
          "source": "Tatoeba #1543417 @hayastan / #4155584 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1543417",
          "cefr_level": "A1",
          "word_slugs": [
            "tengan-verb"
          ]
        },
        {
          "id": "2864997",
          "text": "Espero que los dos tengan hambre.",
          "translation": "Надеюсь, вы оба проголодались.",
          "source": "Tatoeba #2864997 @marcelostockle / #3065532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2864997",
          "cefr_level": "A1",
          "word_slugs": [
            "tengan-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "tengan",
        "plural": "",
        "infinitive": "tengan"
      }
    },
    {
      "slug": "quede-verb",
      "lemma": "quede",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1736,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of quedar:",
          "first/third-person singular present subjunctive",
          "inflection of quedar:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3530385",
          "text": "¿Quieres que me quede?",
          "translation": "Хочешь, чтобы я остался?",
          "source": "Tatoeba #3530385 @gianich73 / #5969809 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3530385",
          "cefr_level": "A1",
          "word_slugs": [
            "quede-verb"
          ]
        },
        {
          "id": "1290629",
          "text": "Que quede entre nosotros.",
          "translation": "Пусть это будет между нами.",
          "source": "Tatoeba #1290629 @enteka / #7880517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1290629",
          "cefr_level": "A1",
          "word_slugs": [
            "quede-verb"
          ]
        },
        {
          "id": "2798270",
          "text": "Tom no quiere que me quede.",
          "translation": "Том не хочет, чтобы я оставался.",
          "source": "Tatoeba #2798270 @nancy / #3508870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2798270",
          "cefr_level": "A1",
          "word_slugs": [
            "quede-verb"
          ]
        },
        {
          "id": "1099169",
          "text": "¿Querés que me quede con vos?",
          "translation": "Хочешь, чтобы я остался с тобой?",
          "source": "Tatoeba #1099169 @hayastan / #8272053 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1099169",
          "cefr_level": "A1",
          "word_slugs": [
            "quede-verb"
          ]
        },
        {
          "id": "2175993",
          "text": "Queremos que Tom se quede y ayude.",
          "translation": "Мы хотим, чтобы Том остался и помог.",
          "source": "Tatoeba #2175993 @hayastan / #5492770 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2175993",
          "cefr_level": "A1",
          "word_slugs": [
            "quede-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "quede",
        "plural": "",
        "infinitive": "quede"
      }
    },
    {
