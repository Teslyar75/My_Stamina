      "gender": null,
      "examples": [
        {
          "id": "5794918",
          "text": "¡Qué declaración más absurda!",
          "translation": "Какое абсурдное заявление!",
          "source": "Tatoeba #5794918 @albrusgher / #5795988 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5794918",
          "cefr_level": "A1",
          "word_slugs": [
            "declaración-noun"
          ]
        },
        {
          "id": "2924724",
          "text": "¿Querés hacer una declaración?",
          "translation": "Ты хочешь сделать заявление?",
          "source": "Tatoeba #2924724 @alexmarcelo / #4036971 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2924724",
          "cefr_level": "A1",
          "word_slugs": [
            "declaración-noun"
          ]
        },
        {
          "id": "2940150",
          "text": "¡Qué hermosa declaración de amor!",
          "translation": "Какое красивое признание в любви!",
          "source": "Tatoeba #2940150 @hayastan / #2940473 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2940150",
          "cefr_level": "A1",
          "word_slugs": [
            "declaración-noun"
          ]
        },
        {
          "id": "5136834",
          "text": "Esa es una declaración muy fuerte.",
          "translation": "Это очень сильное заявление.",
          "source": "Tatoeba #5136834 @ficion / #7713268 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5136834",
          "cefr_level": "A1",
          "word_slugs": [
            "declaración-noun"
          ]
        },
        {
          "id": "2267694",
          "text": "Lea su declaración antes de firmarla.",
          "translation": "Прочитайте Ваше заявление, перед тем как подписать его.",
          "source": "Tatoeba #2267694 @hayastan / #2268199 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2267694",
          "cefr_level": "A1",
