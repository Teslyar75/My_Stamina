        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1448050",
          "text": "La situación es seria.",
          "translation": "Ситуация серьёзная.",
          "source": "Tatoeba #1448050 @marcelostockle / #1448102 @Girlblum (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1448050",
          "cefr_level": "A1",
          "word_slugs": [
            "seria-adj"
          ]
        },
        {
          "id": "1854788",
          "text": "Casarse es cosa seria.",
          "translation": "Женитьба - дело серьёзное.",
          "source": "Tatoeba #1854788 @marcelostockle / #2160350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1854788",
          "cefr_level": "A1",
          "word_slugs": [
            "seria-adj"
          ]
        },
        {
          "id": "3932769",
          "text": "Es una enfermedad seria.",
