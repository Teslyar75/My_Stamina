          ]
        },
        {
          "id": "743582",
          "text": "¿Quieren hacerse ricas?",
          "translation": "Вы хотите разбогатеть?",
          "source": "Tatoeba #743582 @Shishir / #4638402 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/743582",
          "cefr_level": "A1",
