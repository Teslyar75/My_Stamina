            "veía-verb"
          ]
        },
        {
          "id": "1387663",
          "text": "Ella lo veía como su salvador.",
          "translation": "Она смотрела на него, как на своего спасителя.",
          "source": "Tatoeba #1387663 @marcelostockle / #2708942 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1387663",
          "cefr_level": "A1",
