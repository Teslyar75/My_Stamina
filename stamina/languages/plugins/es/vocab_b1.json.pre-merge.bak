          "cefr_level": "A1",
          "word_slugs": [
            "resultado-noun"
          ]
        },
        {
          "id": "5408648",
          "text": "Nunca dudé del resultado.",
          "translation": "Я никогда не сомневался в результате.",
          "source": "Tatoeba #5408648 @albrusgher / #13730410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408648",
          "cefr_level": "A1",
          "word_slugs": [
            "resultado-noun"
          ]
        },
        {
          "id": "2917279",
          "text": "El resultado fue negativo.",
          "translation": "Результат был отрицательным.",
