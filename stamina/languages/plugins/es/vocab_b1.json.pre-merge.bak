    {
      "slug": "casarse-verb",
      "lemma": "casarse",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2168,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of casar combined with se"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10949548",
          "text": "Él quiere casarse.",
          "translation": "Он хочет жениться.",
          "source": "Tatoeba #10949548 @Adelpa / #11194825 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10949548",
          "cefr_level": "A1",
          "word_slugs": [
            "casarse-verb"
          ]
        },
        {
          "id": "10949566",
          "text": "No quiere casarse.",
          "translation": "Он не хочет жениться.",
          "source": "Tatoeba #10949566 @Adelpa / #4604082 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10949566",
          "cefr_level": "A1",
          "word_slugs": [
            "casarse-verb"
          ]
        },
        {
          "id": "2260480",
          "text": "Tom quiere casarse.",
          "translation": "Том хочет жениться.",
          "source": "Tatoeba #2260480 @marcelostockle / #3543841 @pgavda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2260480",
          "cefr_level": "A1",
          "word_slugs": [
            "casarse-verb"
          ]
        },
        {
          "id": "3344160",
          "text": "Quiere casarse conmigo.",
          "translation": "Он хочет на мне жениться.",
          "source": "Tatoeba #3344160 @Shishir / #3342694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3344160",
          "cefr_level": "A1",
          "word_slugs": [
            "casarse-verb"
          ]
        },
        {
          "id": "1854788",
          "text": "Casarse es cosa seria.",
          "translation": "Женитьба - дело серьёзное.",
          "source": "Tatoeba #1854788 @marcelostockle / #2160350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1854788",
          "cefr_level": "A1",
          "word_slugs": [
            "casarse-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
