    {
      "slug": "suyo-pron",
      "lemma": "suyo",
      "pos": "pron",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1309,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "his, hers, its",
          "theirs",
          "yours"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1246436",
          "text": "¿Es suyo esto?",
          "translation": "Это ваше?",
          "source": "Tatoeba #1246436 @wallebot / #2723967 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246436",
          "cefr_level": "A1",
          "word_slugs": [
            "suyo-pron"
          ]
        },
        {
          "id": "13411319",
          "text": "Te dará el suyo.",
          "translation": "Она даст тебе свой.",
          "source": "Tatoeba #13411319 @frpzzd / #10123147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13411319",
          "cefr_level": "A1",
          "word_slugs": [
            "suyo-pron"
          ]
        },
        {
          "id": "2038359",
          "text": "El perro es suyo.",
          "translation": "Собака его.",
          "source": "Tatoeba #2038359 @Shishir / #2553628 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2038359",
          "cefr_level": "A1",
          "word_slugs": [
            "suyo-pron"
          ]
        },
        {
          "id": "1284267",
          "text": "Este auto es suyo.",
          "translation": "Эта машина — его.",
          "source": "Tatoeba #1284267 @marcelostockle / #6569199 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1284267",
          "cefr_level": "A1",
          "word_slugs": [
            "suyo-pron"
          ]
        },
        {
          "id": "3881758",
          "text": "Es suyo si quiere.",
          "translation": "Берите себе, если хотите.",
          "source": "Tatoeba #3881758 @cueyayotl / #3496356 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3881758",
          "cefr_level": "A1",
          "word_slugs": [
            "suyo-pron"
          ]
        }
