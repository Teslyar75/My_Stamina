    {
      "slug": "bola-noun",
      "lemma": "bola",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2396,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "ball",
          "testicle",
          "scoop",
          "hilt (of a sword)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3627089",
          "text": "Sepa la bola.",
          "translation": "Фиг знает.",
          "source": "Tatoeba #3627089 @ecorralest101 / #3627076 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3627089",
          "cefr_level": "A1",
          "word_slugs": [
            "bola-noun"
          ]
        },
        {
          "id": "5889610",
          "text": "Arrójale la bola a ella.",
          "translation": "Кинь ей мяч.",
          "source": "Tatoeba #5889610 @albrusgher / #6330902 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889610",
          "cefr_level": "A1",
          "word_slugs": [
            "bola-noun"
          ]
        },
        {
          "id": "5015484",
          "text": "Me arrojó una bola de nieve.",
          "translation": "Он бросил в меня снежок.",
          "source": "Tatoeba #5015484 @don_ramon / #5015848 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5015484",
          "cefr_level": "A1",
          "word_slugs": [
            "bola-noun"
          ]
        },
        {
          "id": "1263758",
          "text": "El sol es una bola llameante.",
          "translation": "Солнце - пылающий шар.",
          "source": "Tatoeba #1263758 @marcelostockle / #2511623 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1263758",
          "cefr_level": "A1",
          "word_slugs": [
            "bola-noun"
          ]
        },
        {
          "id": "5142084",
          "text": "La calva de papá es como la de una bola de billar.",
          "translation": "Лысина у папы как бильярдный шар.",
          "source": "Tatoeba #5142084 @albrusgher / #6376767 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5142084",
          "cefr_level": "A1",
          "word_slugs": [
            "bola-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
