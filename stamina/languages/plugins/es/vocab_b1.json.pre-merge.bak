          "cefr_level": "A1",
          "word_slugs": [
            "quedarme-verb"
          ]
        },
        {
          "id": "2084656",
          "text": "No quiero quedarme acá.",
          "translation": "Я не хочу здесь оставаться.",
          "source": "Tatoeba #2084656 @hayastan / #4225601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2084656",
          "cefr_level": "A1",
