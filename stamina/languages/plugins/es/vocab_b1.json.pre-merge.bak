    {
      "slug": "especialmente-adv",
      "lemma": "especialmente",
      "pos": "adv",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1412,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "specially",
          "especially"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "329831",
          "text": "Hoy no hace calor especialmente.",
          "translation": "Сегодня не особенно жарко.",
          "source": "Tatoeba #329831 @tatoerique / #441448 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/329831",
          "cefr_level": "A1",
          "word_slugs": [
            "especialmente-adv"
          ]
        },
        {
          "id": "3225099",
          "text": "Me gusta escuchar música, especialmente jazz.",
          "translation": "Я люблю слушать музыку, особенно джаз.",
          "source": "Tatoeba #3225099 @Shishir / #7810041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3225099",
          "cefr_level": "A1",
          "word_slugs": [
            "especialmente-adv"
          ]
        },
        {
          "id": "1263604",
          "text": "Las alfombras antiguas son especialmente valiosas.",
          "translation": "Старинные ковры особенно ценны.",
          "source": "Tatoeba #1263604 @marcelostockle / #6962689 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1263604",
          "cefr_level": "A1",
          "word_slugs": [
            "especialmente-adv"
          ]
        },
        {
          "id": "1138986",
          "text": "Me gusta caminar, especialmente a la mañana.",
          "translation": "Я люблю гулять, особенно по утрам.",
          "source": "Tatoeba #1138986 @nancy / #7327839 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1138986",
          "cefr_level": "A1",
          "word_slugs": [
            "especialmente-adv"
          ]
        },
        {
          "id": "3196225",
          "text": "No se ocupa especialmente bien de sus hijos.",
          "translation": "Она не очень хорошо заботится о своих детях.",
          "source": "Tatoeba #3196225 @Shishir / #6462655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3196225",
          "cefr_level": "A1",
          "word_slugs": [
            "especialmente-adv"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "especialmente",
        "plural": "",
