      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "hey, listen, excuse me (said as a request for an individual's attention)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1395158",
          "text": "¡Que Dios te oiga!",
          "translation": "Да услышит тебя Господь!",
          "source": "Tatoeba #1395158 @enteka / #11518245 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1395158",
          "cefr_level": "A1",
          "word_slugs": [
            "oiga-intj"
          ]
        },
        {
          "id": "3341380",
          "text": "Os llamo cuando oiga algo.",
          "translation": "Я вам позвоню, если что-то услышу.",
          "source": "Tatoeba #3341380 @Shishir / #3711904 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3341380",
          "cefr_level": "A1",
          "word_slugs": [
            "oiga-intj"
          ]
        },
        {
          "id": "1827571",
          "text": "¡Oiga! ¡Por favor no entre al jardín!",
          "translation": "Послушайте! Пожалуйста, не заходите в сад!",
          "source": "Tatoeba #1827571 @marcelostockle / #7026640 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1827571",
