          "cefr_level": "A1",
          "word_slugs": [
            "errores-noun"
          ]
        },
        {
          "id": "764786",
          "text": "Corrige los errores.",
          "translation": "Исправь ошибки.",
          "source": "Tatoeba #764786 @darinmex / #2787947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/764786",
          "cefr_level": "A1",
          "word_slugs": [
