    {
      "slug": "andando-verb",
      "lemma": "andando",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2495,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "gerund of andar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1067508",
          "text": "Normalmente voy andando.",
          "translation": "Обычно я хожу пешком.",
          "source": "Tatoeba #1067508 @Shishir / #2484559 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1067508",
          "cefr_level": "A1",
          "word_slugs": [
            "andando-verb"
          ]
        },
        {
          "id": "4435065",
          "text": "Puedo ir ahí andando.",
          "translation": "Я могу пойти туда пешком.",
          "source": "Tatoeba #4435065 @Shishir / #4425822 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4435065",
          "cefr_level": "A1",
          "word_slugs": [
            "andando-verb"
          ]
        },
        {
          "id": "3476610",
          "text": "Dejó el motor andando.",
          "translation": "Он оставил двигатель включённым.",
          "source": "Tatoeba #3476610 @ulymarrero / #3288707 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3476610",
          "cefr_level": "A1",
          "word_slugs": [
            "andando-verb"
          ]
        },
        {
          "id": "1334275",
          "text": "Fui andando a la escuela.",
          "translation": "Я пошёл в школу пешком.",
          "source": "Tatoeba #1334275 @Shishir / #10795216 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1334275",
          "cefr_level": "A1",
