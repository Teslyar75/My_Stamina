    {
      "slug": "pelota-noun",
      "lemma": "pelota",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2447,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "ball (a round or ellipsoidal object)",
          "ball game",
          "testicle"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6172278",
          "text": "Dame la pelota.",
          "translation": "Дай мне мяч.",
          "source": "Tatoeba #6172278 @cueyayotl / #5689068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6172278",
          "cefr_level": "A1",
          "word_slugs": [
            "pelota-noun"
          ]
        },
        {
          "id": "6172279",
          "text": "Dadme la pelota.",
          "translation": "Дайте мне мяч.",
          "source": "Tatoeba #6172279 @cueyayotl / #5689069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6172279",
          "cefr_level": "A1",
          "word_slugs": [
            "pelota-noun"
          ]
        },
        {
          "id": "6172280",
          "text": "Denme la pelota.",
          "translation": "Дайте мне мяч.",
          "source": "Tatoeba #6172280 @cueyayotl / #5689069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6172280",
          "cefr_level": "A1",
          "word_slugs": [
            "pelota-noun"
          ]
        },
        {
          "id": "10543524",
          "text": "¡Coge la pelota!",
          "translation": "Лови мяч!",
          "source": "Tatoeba #10543524 @Shishir / #10956407 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10543524",
          "cefr_level": "A1",
          "word_slugs": [
            "pelota-noun"
          ]
        },
        {
          "id": "1296938",
          "text": "Tom pateó la pelota.",
          "translation": "Том ударил мяч ногой.",
          "source": "Tatoeba #1296938 @marcelostockle / #1489684 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1296938",
          "cefr_level": "A1",
          "word_slugs": [
            "pelota-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
