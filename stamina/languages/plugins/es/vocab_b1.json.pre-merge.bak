          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5087469",
          "text": "¡Vengan y miren!",
          "translation": "Придите и посмотрите!",
          "source": "Tatoeba #5087469 @cueyayotl / #6926947 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5087469",
