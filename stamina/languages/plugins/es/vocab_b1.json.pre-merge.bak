          ]
        },
        {
          "id": "7410753",
          "text": "Tengo que enviar unos regalos.",
          "translation": "Мне нужно отправить несколько подарков.",
          "source": "Tatoeba #7410753 @arh / #7761228 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7410753",
          "cefr_level": "A1",
          "word_slugs": [
            "enviar-verb"
          ]
        },
