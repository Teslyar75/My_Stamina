    {
      "slug": "recoger-verb",
      "lemma": "recoger",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2124,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to collect, to gather, to pick up, to fetch, to retrieve (something previously left behind)",
          "to pick up (a person or people by vehicle)",
          "to clean up (e.g., a room)",
          "to pack up"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4554637",
          "text": "Lo acabo de recoger.",
          "translation": "Я только что его подобрал.",
          "source": "Tatoeba #4554637 @swyter / #7027206 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4554637",
          "cefr_level": "A1",
          "word_slugs": [
            "recoger-verb"
          ]
        },
        {
          "id": "1391468",
          "text": "¿A qué hora me vienes a recoger?",
          "translation": "Во сколько ты за мной заедешь?",
          "source": "Tatoeba #1391468 @enteka / #1910450 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1391468",
          "cefr_level": "A1",
          "word_slugs": [
            "recoger-verb"
          ]
        },
        {
          "id": "5722649",
          "text": "Soy incapaz de recoger toda la hierba.",
          "translation": "Я не в силах собрать всю траву.",
          "source": "Tatoeba #5722649 @arh / #7794894 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5722649",
