          "cefr_level": "A1",
          "word_slugs": [
            "siga-intj"
          ]
        },
        {
          "id": "2160342",
          "text": "Siga mi consejo.",
          "translation": "Последуйте моему совету.",
          "source": "Tatoeba #2160342 @Shishir / #2783099 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2160342",
          "cefr_level": "A1",
          "word_slugs": [
            "siga-intj"
          ]
        },
        {
          "id": "982858",
          "text": "Siga a las estrellas.",
          "translation": "Следуйте за звёздами.",
          "source": "Tatoeba #982858 @hayastan / #2743082 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/982858",
          "cefr_level": "A1",
          "word_slugs": [
            "siga-intj"
          ]
        },
        {
          "id": "434465",
          "text": "Siga usted todo recto.",
          "translation": "Продолжайте двигаться прямо.",
          "source": "Tatoeba #434465 @lukaszpp / #3128481 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/434465",
          "cefr_level": "A1",
          "word_slugs": [
            "siga-intj"
          ]
        },
        {
          "id": "1543418",
          "text": "Siga correctamente las instrucciones.",
          "translation": "Правильно следуйте инструкциям.",
          "source": "Tatoeba #1543418 @hayastan / #4504967 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1543418",
          "cefr_level": "A1",
          "word_slugs": [
            "siga-intj"
          ]
        }
      ],
      "tags": [
