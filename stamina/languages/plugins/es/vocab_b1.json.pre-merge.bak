          ]
        },
        {
          "id": "5365621",
          "text": "Le envió a paseo.",
          "translation": "Он отправил его на прогулку.",
          "source": "Tatoeba #5365621 @capiscuas / #9822388 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5365621",
          "cefr_level": "A1",
          "word_slugs": [
