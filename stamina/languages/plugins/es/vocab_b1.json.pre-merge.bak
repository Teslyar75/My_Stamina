    {
      "slug": "decidido-adj",
      "lemma": "decidido",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1512,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "decided",
          "purposeful",
          "determined",
          "resolute"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3281058",
          "text": "He decidido jubilarme.",
          "translation": "Я решил уйти на пенсию.",
          "source": "Tatoeba #3281058 @Shishir / #2834122 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3281058",
          "cefr_level": "A1",
