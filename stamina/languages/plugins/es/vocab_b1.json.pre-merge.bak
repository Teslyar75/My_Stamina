    {
      "slug": "visión-noun",
      "lemma": "visión",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2180,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "точка зрения"
        ],
        "en": [
          "vision (something seen; an object perceived visually)",
          "vision, sight (the sense or ability of sight)",
          "view (a way of understanding something, an opinion, a theory)",
          "vision (something imaginary one thinks one sees)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4554562",
          "text": "Acabo de tener una visión.",
          "translation": "У меня только что было видение.",
          "source": "Tatoeba #4554562 @swyter / #5888088 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4554562",
          "cefr_level": "A1",
          "word_slugs": [
            "visión-noun"
          ]
        },
        {
          "id": "10673280",
          "text": "Tienes una visión diferente de este mundo. Tú eres americano.",
          "translation": "Ты по-другому смотришь на этот мир. Ты американец.",
          "source": "Tatoeba #10673280 @ecorralest101 / #12827890 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10673280",
          "cefr_level": "A1",
          "word_slugs": [
            "visión-noun"
          ]
        },
        {
          "id": "970686",
          "text": "El amor te vuelve ciego, el matrimonio te devuelve la visión.",
          "translation": "Любовь ослепляет, брак позволяет вновь обрести зрение.",
          "source": "Tatoeba #970686 @hundo / #4161118 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/970686",
          "cefr_level": "A1",
          "word_slugs": [
            "visión-noun"
          ]
        },
        {
          "id": "1447925",
          "text": "Ahora tenemos una visión más clara de lo que está sucediendo.",
          "translation": "Теперь у нас более ясное представление о том, что происходит.",
          "source": "Tatoeba #1447925 @nancy / #3301450 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1447925",
          "cefr_level": "A1",
          "word_slugs": [
            "visión-noun"
          ]
        },
        {
          "id": "4136954",
          "text": "La visión y la audición siempre fueron considerados los sentidos más importantes.",
          "translation": "Зрение и слух всегда считались самыми важными видами восприятия действительности.",
          "source": "Tatoeba #4136954 @hayastan / #4141361 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4136954",
          "cefr_level": "A1",
          "word_slugs": [
            "visión-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "f",
        "singular": "la visión",
        "plural": "",
        "infinitive": ""
      }
    },
