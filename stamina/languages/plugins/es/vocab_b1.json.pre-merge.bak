      "frequency_rank": 2498,
      "frequency_band": "cervantes-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "329840",
          "text": "Soy Susan Greene.",
          "translation": "Я Сьюзан Грин.",
          "source": "Tatoeba #329840 @tatoerique / #338465 @rednaxela (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/329840",
          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        },
        {
          "id": "5002170",
          "text": "Susan nunca fuma.",
          "translation": "Сюзан вообще не курит.",
          "source": "Tatoeba #5002170 @marara / #2615523 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5002170",
          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        },
        {
          "id": "889030",
          "text": "Yo soy Susan Greene.",
          "translation": "Я Сьюзан Грин.",
          "source": "Tatoeba #889030 @Shishir / #338465 @rednaxela (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/889030",
          "cefr_level": "A1",
