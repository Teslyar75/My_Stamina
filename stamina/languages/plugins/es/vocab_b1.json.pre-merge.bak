          "cefr_level": "A1",
          "word_slugs": [
            "puse-verb"
          ]
        },
        {
          "id": "2437922",
          "text": "Me puse mi sombrero.",
          "translation": "Я надел свою шляпу.",
          "source": "Tatoeba #2437922 @marcelostockle / #6139438 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2437922",
          "cefr_level": "A1",
          "word_slugs": [
            "puse-verb"
          ]
        },
        {
          "id": "445867",
          "text": "Me puse los pantalones.",
          "translation": "Я надел штаны.",
          "source": "Tatoeba #445867 @Shishir / #417108 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/445867",
          "cefr_level": "A1",
          "word_slugs": [
