    {
      "slug": "evidencia-noun",
      "lemma": "evidencia",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1652,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "evidence"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10104931",
          "text": "La ausencia de evidencia no es la evidencia de la ausencia.",
          "translation": "Отсутствие доказательств не доказательство отсутствия.",
          "source": "Tatoeba #10104931 @Eremon / #14067763 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10104931",
          "cefr_level": "A1",
          "word_slugs": [
            "evidencia-noun"
          ]
        },
        {
          "id": "1370023",
          "text": "No hay evidencia de que esta enfermedad sea causada por la dieta.",
          "translation": "Нет никаких доказательств того, что это заболевание вызвано диетой.",
          "source": "Tatoeba #1370023 @marcelostockle / #13499840 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1370023",
          "cefr_level": "A1",
          "word_slugs": [
            "evidencia-noun"
          ]
        },
        {
          "id": "1270736",
          "text": "Un pene cortado constituye una pieza importante de evidencia en una violación.",
          "translation": "Отрезанный член является важным доказательством изнасилования.",
          "source": "Tatoeba #1270736 @hayastan / #5356018 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1270736",
          "cefr_level": "A1",
          "word_slugs": [
            "evidencia-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
