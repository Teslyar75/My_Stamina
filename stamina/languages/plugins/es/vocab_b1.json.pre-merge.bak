        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1369950",
          "text": "¿Qué enfermedad tengo?",
          "translation": "Что у меня за болезнь?",
          "source": "Tatoeba #1369950 @AMIKEMA / #1947734 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1369950",
          "cefr_level": "A1",
          "word_slugs": [
            "enfermedad-noun"
          ]
        },
        {
          "id": "1236820",
          "text": "Su enfermedad le mató.",
          "translation": "Болезнь его убила.",
          "source": "Tatoeba #1236820 @Shishir / #5349319 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1236820",
          "cefr_level": "A1",
          "word_slugs": [
            "enfermedad-noun"
          ]
        },
        {
          "id": "3932769",
          "text": "Es una enfermedad seria.",
          "translation": "Это плохая болезнь.",
          "source": "Tatoeba #3932769 @gianich73 / #3932740 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3932769",
          "cefr_level": "A1",
          "word_slugs": [
            "enfermedad-noun"
          ]
        },
        {
          "id": "1519728",
          "text": "Esta enfermedad es fatal.",
          "translation": "Это смертельная болезнь.",
          "source": "Tatoeba #1519728 @danielements / #13077116 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1519728",
          "cefr_level": "A1",
          "word_slugs": [
            "enfermedad-noun"
          ]
        },
        {
          "id": "4632992",
          "text": "Lucha contra la enfermedad.",
          "translation": "Борись с болезнью.",
          "source": "Tatoeba #4632992 @cueyayotl / #4634569 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4632992",
          "cefr_level": "A1",
