    {
      "slug": "área-noun",
      "lemma": "área",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1680,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "area (a particular geographic region)",
          "are (SI unit of area equal to 100 square metres)",
          "area, field (the extent, scope, or range of an object or concept)",
          "area (a measure of the extent of a surface)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3540680",
          "text": "Trabajo en el área de la metalurgia.",
          "translation": "Я работаю в сфере металлургии.",
          "source": "Tatoeba #3540680 @hayastan / #3540856 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3540680",
          "cefr_level": "A1",
          "word_slugs": [
            "área-noun"
          ]
        },
        {
          "id": "3540683",
          "text": "Trabajo en el área de la siderurgia.",
          "translation": "Я работаю в сфере чёрной металлургии.",
          "source": "Tatoeba #3540683 @hayastan / #3540869 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3540683",
          "cefr_level": "A1",
          "word_slugs": [
            "área-noun"
          ]
        },
        {
          "id": "1828830",
          "text": "El Ártico es el área que rodea al Polo Norte.",
          "translation": "Арктика — это территория вокруг Северного полюса.",
          "source": "Tatoeba #1828830 @marcelostockle / #6391579 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1828830",
          "cefr_level": "A1",
          "word_slugs": [
            "área-noun"
          ]
        },
        {
          "id": "3690022",
          "text": "¿Cuál es la fórmula para calcular el área del círculo?",
          "translation": "Какова формула для вычисления площади круга?",
          "source": "Tatoeba #3690022 @carlosboyero / #7760352 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3690022",
          "cefr_level": "A1",
          "word_slugs": [
            "área-noun"
          ]
        },
        {
          "id": "987237",
          "text": "Llevo trabajando en la misma área desde hace veinte años.",
          "translation": "Я работаю в одном и том же районе уже двадцать лет.",
          "source": "Tatoeba #987237 @Shishir / #3893409 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/987237",
          "cefr_level": "A1",
          "word_slugs": [
            "área-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "área",
        "plural": "",
        "infinitive": ""
      }
