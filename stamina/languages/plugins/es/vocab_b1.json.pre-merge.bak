          "third-person singular preterite indicative of parecer"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "618742",
          "text": "¿Qué te pareció mi casa?",
          "translation": "Как тебе мой дом?",
          "source": "Tatoeba #618742 @Shishir / #3060227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/618742",
          "cefr_level": "A1",
          "word_slugs": [
            "pareció-verb"
          ]
        },
        {
          "id": "3551884",
          "text": "Me pareció como un sueño.",
          "translation": "Мне казалось, что это сон.",
          "source": "Tatoeba #3551884 @clerval / #3551946 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3551884",
          "cefr_level": "A1",
          "word_slugs": [
            "pareció-verb"
          ]
        },
        {
          "id": "8726445",
          "text": "¿Qué les pareció mi casa?",
          "translation": "Каким вам показался мой дом?",
          "source": "Tatoeba #8726445 @gianich73 / #1542559 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8726445",
          "cefr_level": "A1",
          "word_slugs": [
            "pareció-verb"
          ]
        },
        {
          "id": "1191439",
          "text": "El libro me pareció aburrido.",
          "translation": "Книга показалась мне скучной.",
          "source": "Tatoeba #1191439 @Shishir / #4328718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1191439",
          "cefr_level": "A1",
          "word_slugs": [
            "pareció-verb"
          ]
        },
        {
          "id": "3885646",
          "text": "El juego me pareció sencillo.",
          "translation": "Игра показалась мне простой.",
          "source": "Tatoeba #3885646 @gianich73 / #3885558 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3885646",
          "cefr_level": "A1",
          "word_slugs": [
            "pareció-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
