    {
      "slug": "discutir-verb",
      "lemma": "discutir",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2112,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to discuss, to argue; to talk about",
          "to examine some subject in detail"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4330772",
          "text": "Estoy harto de discutir.",
          "translation": "Я устал спорить.",
          "source": "Tatoeba #4330772 @cueyayotl / #4331611 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4330772",
          "cefr_level": "A1",
          "word_slugs": [
            "discutir-verb"
          ]
        },
        {
          "id": "3365957",
          "text": "Ella discute por discutir.",
          "translation": "Она спорит ради спора.",
          "source": "Tatoeba #3365957 @gianich73 / #3365585 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3365957",
          "cefr_level": "A1",
          "word_slugs": [
            "discutir-verb"
          ]
        },
        {
          "id": "3562870",
          "text": "¿No podemos discutir esto?",
          "translation": "Мы не можем это обсудить?",
          "source": "Tatoeba #3562870 @ficion / #3566239 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3562870",
          "cefr_level": "A1",
          "word_slugs": [
            "discutir-verb"
          ]
        },
        {
          "id": "3670785",
          "text": "No quiero discutir contigo.",
          "translation": "Я не хочу с тобой спорить.",
          "source": "Tatoeba #3670785 @Seael / #3642582 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3670785",
          "cefr_level": "A1",
          "word_slugs": [
            "discutir-verb"
          ]
        },
        {
          "id": "8279386",
          "text": "Preferiría no discutir eso.",
          "translation": "Я бы предпочёл это не обсуждать.",
          "source": "Tatoeba #8279386 @GuidoW / #8277988 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8279386",
          "cefr_level": "A1",
          "word_slugs": [
            "discutir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el discutir",
        "plural": "",
        "infinitive": "discutir"
      }
