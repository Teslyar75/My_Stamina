          ]
        },
        {
          "id": "340512",
          "text": "Su debut en el escenario fue en 1969.",
          "translation": "Она дебютировала на сцене в 1969 году.",
          "source": "Tatoeba #340512 @tatoerique / #3155566 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/340512",
          "cefr_level": "A1",
          "word_slugs": [
            "escenario-noun"
          ]
        },
        {
          "id": "12380820",
          "text": "En el escenario, se olvidaba de todo.",
          "translation": "На сцене он забывал обо всём.",
          "source": "Tatoeba #12380820 @carlosalberto / #10604563 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12380820",
          "cefr_level": "A1",
          "word_slugs": [
            "escenario-noun"
          ]
        },
        {
          "id": "2017012",
          "text": "¿Hay algún músico famoso en el escenario?",
          "translation": "На сцене есть какие-нибудь известные музыканты?",
          "source": "Tatoeba #2017012 @Joseshka / #424436 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2017012",
          "cefr_level": "A1",
          "word_slugs": [
            "escenario-noun"
          ]
        },
        {
          "id": "1336564",
          "text": "El hombre que está bailando en el escenario es mi tío.",
          "translation": "Мужчина, что танцует на сцене, — мой дядя.",
          "source": "Tatoeba #1336564 @hayastan / #4616408 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1336564",
          "cefr_level": "A1",
          "word_slugs": [
            "escenario-noun"
          ]
        }
