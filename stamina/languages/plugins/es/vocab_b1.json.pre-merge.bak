    {
      "slug": "temporada-noun",
      "lemma": "temporada",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2095,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "season, period, span of time",
          "season, series (group of episodes of a television broadcast)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2461902",
          "text": "Es la temporada de las fresas.",
          "translation": "Сейчас сезон клубники.",
          "source": "Tatoeba #2461902 @Shishir / #6455757 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2461902",
          "cefr_level": "A1",
          "word_slugs": [
            "temporada-noun"
          ]
        },
        {
          "id": "1868903",
          "text": "La temporada de béisbol ha empezado.",
          "translation": "Начался бейсбольный сезон.",
          "source": "Tatoeba #1868903 @wallebot / #3810587 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1868903",
          "cefr_level": "A1",
          "word_slugs": [
            "temporada-noun"
          ]
        },
        {
          "id": "3555521",
          "text": "¿Cuándo empieza la temporada de pesca?",
          "translation": "Когда начинается промысловый сезон?",
          "source": "Tatoeba #3555521 @cueyayotl / #2364648 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3555521",
          "cefr_level": "A1",
          "word_slugs": [
            "temporada-noun"
          ]
        },
        {
          "id": "1303983",
          "text": "Ahora es la temporada de las sandías.",
          "translation": "Сейчас сезон арбузов.",
          "source": "Tatoeba #1303983 @Shishir / #3693046 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1303983",
          "cefr_level": "A1",
          "word_slugs": [
            "temporada-noun"
          ]
        },
        {
          "id": "2515306",
          "text": "La temporada de lluvias comienza a finales de junio.",
          "translation": "Сезон дождей начинается в конце июня.",
          "source": "Tatoeba #2515306 @marcelostockle / #4585836 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2515306",
          "cefr_level": "A1",
          "word_slugs": [
            "temporada-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "temporada",
        "plural": "",
        "infinitive": ""
      }
