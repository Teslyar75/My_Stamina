          "cefr_level": "A1",
          "word_slugs": [
            "papa-noun"
          ]
        },
        {
          "id": "3965321",
          "text": "Soy una papa enterrada.",
          "translation": "Я вообще ни бум-бум.",
          "source": "Tatoeba #3965321 @ecorralest101 / #3965323 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3965321",
          "cefr_level": "A1",
          "word_slugs": [
            "papa-noun"
          ]
        },
        {
          "id": "1070372",
          "text": "El Papa no puede casarse.",
          "translation": "Папе нельзя жениться.",
          "source": "Tatoeba #1070372 @hayastan / #8559384 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1070372",
