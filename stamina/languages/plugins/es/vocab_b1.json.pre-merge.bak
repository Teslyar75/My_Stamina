    {
      "slug": "castillo-noun",
      "lemma": "castillo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2395,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "castle (a large building that is fortified and contains many defences)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2112318",
          "text": "Visité el castillo.",
          "translation": "Я побывал в замке.",
          "source": "Tatoeba #2112318 @marcelostockle / #7021494 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2112318",
          "cefr_level": "A1",
          "word_slugs": [
            "castillo-noun"
          ]
        },
        {
          "id": "2412344",
