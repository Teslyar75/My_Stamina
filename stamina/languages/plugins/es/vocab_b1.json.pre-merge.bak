          ]
        },
        {
          "id": "9162293",
          "text": "Hablé de leones.",
          "translation": "Я говорил о львах.",
          "source": "Tatoeba #9162293 @carlosalberto / #5476009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9162293",
          "cefr_level": "A1",
          "word_slugs": [
            "hablé-verb"
          ]
        },
        {
          "id": "356124",
          "text": "Hablé por teléfono.",
          "translation": "Я говорила по телефону.",
          "source": "Tatoeba #356124 @tatoerique / #3195985 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/356124",
