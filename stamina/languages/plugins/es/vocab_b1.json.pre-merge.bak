    {
      "slug": "tratar-verb",
      "lemma": "tratar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1210,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to treat (to handle, behave toward in a specific way)",
          "to treat (to apply medical care)",
          "to treat (to submit to a chemical action)",
          "to address, to refer to as"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2517015",
          "text": "¡Tienes que tratar!",
          "translation": "Ты должен попробовать!",
          "source": "Tatoeba #2517015 @BoriQa / #4351096 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2517015",
          "cefr_level": "A1",
          "word_slugs": [
            "tratar-verb"
          ]
        },
        {
          "id": "1673603",
          "text": "Déjeme tratar otra vez.",
          "translation": "Дайте мне попробовать ещё раз.",
          "source": "Tatoeba #1673603 @marcelostockle / #6130452 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1673603",
          "cefr_level": "A1",
          "word_slugs": [
            "tratar-verb"
          ]
        },
        {
          "id": "1751455",
          "text": "Yo no sé como tratar con niños.",
          "translation": "Я не знаю, как обращаться с детьми.",
          "source": "Tatoeba #1751455 @leoruilova / #3694151 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1751455",
          "cefr_level": "A1",
          "word_slugs": [
            "tratar-verb"
          ]
        },
        {
          "id": "1309205",
          "text": "Él es bueno para tratar con niños.",
          "translation": "Он умеет обращаться с детьми.",
          "source": "Tatoeba #1309205 @marcelostockle / #6861370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1309205",
          "cefr_level": "A1",
          "word_slugs": [
            "tratar-verb"
          ]
        },
        {
          "id": "1826771",
          "text": "Es inútil tratar de convencerlo de eso.",
          "translation": "Бесполезно пытаться убедить его в этом.",
          "source": "Tatoeba #1826771 @marcelostockle / #2215340 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1826771",
          "cefr_level": "A1",
          "word_slugs": [
            "tratar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
