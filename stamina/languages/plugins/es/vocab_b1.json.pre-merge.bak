          "source": "Tatoeba #1991831 @marcelostockle / #5649828 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1991831",
          "cefr_level": "A1",
          "word_slugs": [
            "mono-adj"
          ]
        },
        {
          "id": "2268396",
          "text": "El mono está en la jaula.",
          "translation": "Обезьяна в клетке.",
          "source": "Tatoeba #2268396 @hayastan / #4289328 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2268396",
          "cefr_level": "A1",
          "word_slugs": [
            "mono-adj"
          ]
        },
        {
          "id": "728877",
          "text": "¿Quién hizo el mono de nieve?",
          "translation": "Кто слепил снеговика?",
          "source": "Tatoeba #728877 @ventana / #1949616 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/728877",
          "cefr_level": "A1",
          "word_slugs": [
            "mono-adj"
          ]
        }
      ],
