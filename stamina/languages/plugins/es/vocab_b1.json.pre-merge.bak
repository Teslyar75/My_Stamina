      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "424372",
          "text": "Kim vive con Ken.",
          "translation": "Ким живёт с Кеном.",
          "source": "Tatoeba #424372 @hayastan / #470481 @vilnat (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/424372",
          "cefr_level": "A1",
          "word_slugs": [
            "kim-name"
          ]
        },
        {
          "id": "1522823",
          "text": "Kim es dos años mayor que él.",
          "translation": "Ким на два года старше его.",
          "source": "Tatoeba #1522823 @marcelostockle / #3229296 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1522823",
          "cefr_level": "A1",
          "word_slugs": [
            "kim-name"
          ]
        },
        {
          "id": "2314674",
          "text": "Kim es cuatro años mayor que yo.",
          "translation": "Ким на четыре года старше меня.",
          "source": "Tatoeba #2314674 @Shishir / #3038893 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2314674",
          "cefr_level": "A1",
          "word_slugs": [
            "kim-name"
          ]
        },
        {
