          ]
        },
        {
          "id": "456288",
          "text": "Damas y caballeros, siéntense por favor.",
          "translation": "Дамы и господа, садитесь, пожалуйста.",
          "source": "Tatoeba #456288 @lukaszpp / #1526947 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/456288",
          "cefr_level": "A1",
          "word_slugs": [
            "damas-noun"
          ]
        },
        {
          "id": "1235124",
          "text": "Tom le ganó a Mary en damas.",
          "translation": "Том обыграл Мэри в шашки.",
          "source": "Tatoeba #1235124 @marcelostockle / #6478982 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1235124",
