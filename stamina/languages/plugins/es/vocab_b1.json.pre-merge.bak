          ]
        },
        {
          "id": "2844397",
          "text": "Llamé hoy a Tom.",
          "translation": "Я позвонил Тому сегодня.",
          "source": "Tatoeba #2844397 @marcelostockle / #2848932 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2844397",
          "cefr_level": "A1",
          "word_slugs": [
            "llamé-verb"
          ]
        },
        {
          "id": "4589036",
          "text": "Yo llamé a casa.",
          "translation": "Я позвонил домой.",
          "source": "Tatoeba #4589036 @Francisco_M / #4679099 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4589036",
