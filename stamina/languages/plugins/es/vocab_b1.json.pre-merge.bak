          ]
        },
        {
          "id": "1289960",
          "text": "Hoy no he bebido ni un trago.",
          "translation": "Сегодня я не выпил ни капли.",
          "source": "Tatoeba #1289960 @enteka / #3893646 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1289960",
          "cefr_level": "A1",
          "word_slugs": [
            "trago-noun"
          ]
        },
        {
          "id": "3008470",
          "text": "Tom le ofreció un trago a Mary.",
