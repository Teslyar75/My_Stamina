          "word_slugs": [
            "cien-num"
          ]
        },
        {
          "id": "13736068",
          "text": "Gasté cien euros.",
          "translation": "Я потратил сто евро.",
          "source": "Tatoeba #13736068 @ecorralest101 / #13736051 @gregoryguy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13736068",
          "cefr_level": "A1",
          "word_slugs": [
            "cien-num"
          ]
        },
        {
          "id": "1624728",
          "text": "Cuenta hasta cien.",
          "translation": "Посчитай до ста.",
          "source": "Tatoeba #1624728 @marcelostockle / #2306725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1624728",
          "cefr_level": "A1",
