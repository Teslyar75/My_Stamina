    {
      "slug": "déjalo-verb",
      "lemma": "déjalo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1374,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular imperative of dejar combined with lo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2136851",
          "text": "Déjalo en la mesa.",
          "translation": "Оставь его на столе.",
          "source": "Tatoeba #2136851 @Shishir / #4024179 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2136851",
          "cefr_level": "A1",
          "word_slugs": [
            "déjalo-verb"
          ]
        },
        {
          "id": "540434",
          "text": "Déjalo encima de la mesa.",
          "translation": "Оставь его на столе.",
          "source": "Tatoeba #540434 @Shishir / #4024179 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/540434",
          "cefr_level": "A1",
          "word_slugs": [
            "déjalo-verb"
          ]
        },
        {
          "id": "986543",
          "text": "Déjalo. No se te da bien el inglés.",
          "translation": "Брось английский. Не твоё это.",
          "source": "Tatoeba #986543 @Shishir / #5153496 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/986543",
          "cefr_level": "A1",
          "word_slugs": [
            "déjalo-verb"
          ]
        },
        {
          "id": "1854376",
          "text": "Cuando te hayas acabado el libro, déjalo donde lo encontraste.",
          "translation": "Прочтешь эту книгу, положи её на прежнее место.",
          "source": "Tatoeba #1854376 @Shishir / #2017307 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1854376",
          "cefr_level": "A1",
          "word_slugs": [
            "déjalo-verb"
          ]
        },
        {
          "id": "1628552",
          "text": "Déjalo de mi cuenta, yo me haré cargo de este problema.",
          "translation": "Оставь это мне, я займусь этой проблемой.",
          "source": "Tatoeba #1628552 @Shishir / #6112911 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1628552",
          "cefr_level": "A1",
          "word_slugs": [
            "déjalo-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "déjalo",
        "plural": "",
        "infinitive": "déjalo"
      }
