          "inflection of sentir:",
          "second-person singular voseo imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5041955",
          "text": "Me sentí usada.",
          "translation": "Я чувствовала себя использованной.",
          "source": "Tatoeba #5041955 @don_ramon / #5286159 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5041955",
          "cefr_level": "A1",
          "word_slugs": [
            "sentí-verb"
          ]
        },
        {
          "id": "1365375",
          "text": "Me sentí muy feliz.",
          "translation": "Я почувствовал себя очень счастливым.",
          "source": "Tatoeba #1365375 @marcelostockle / #11367856 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1365375",
          "cefr_level": "A1",
          "word_slugs": [
            "sentí-verb"
          ]
        },
        {
          "id": "3032876",
          "text": "Después me sentí mal.",
          "translation": "Потом я себя плохо чувствовал.",
          "source": "Tatoeba #3032876 @Shishir / #3247150 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3032876",
          "cefr_level": "A1",
          "word_slugs": [
            "sentí-verb"
          ]
        },
        {
          "id": "5864170",
          "text": "Sentí ganas de bailar.",
          "translation": "Мне хотелось танцевать.",
          "source": "Tatoeba #5864170 @arh / #5863020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5864170",
          "cefr_level": "A1",
          "word_slugs": [
            "sentí-verb"
          ]
        },
        {
          "id": "1767611",
          "text": "Sentí un dolor intenso.",
          "translation": "Я чувствовал сильную боль.",
          "source": "Tatoeba #1767611 @marcelostockle / #5504770 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1767611",
          "cefr_level": "A1",
