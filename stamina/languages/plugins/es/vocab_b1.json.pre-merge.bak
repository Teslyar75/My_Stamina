    {
      "slug": "fecha-noun",
      "lemma": "fecha",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2275,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "date (that which specifies the time when something was made)",
          "date (a specific day in time at which a transaction or event takes place)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4526804",
          "text": "Cambié la fecha.",
          "translation": "Я изменил дату.",
          "source": "Tatoeba #4526804 @cueyayotl / #9795175 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4526804",
          "cefr_level": "A1",
          "word_slugs": [
            "fecha-noun"
          ]
        },
        {
          "id": "10188681",
          "text": "Me equivoqué de fecha.",
          "translation": "Я перепутал дату.",
          "source": "Tatoeba #10188681 @Shishir / #10469710 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10188681",
          "cefr_level": "A1",
          "word_slugs": [
            "fecha-noun"
          ]
        },
        {
          "id": "1173928",
          "text": "La fecha exacta es 1742.",
          "translation": "Точная дата - 1742 год.",
          "source": "Tatoeba #1173928 @marcelostockle / #1518828 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1173928",
          "cefr_level": "A1",
          "word_slugs": [
            "fecha-noun"
          ]
        },
        {
          "id": "4600218",
          "text": "La fecha límite fue ayer.",
          "translation": "Последний срок был вчера.",
          "source": "Tatoeba #4600218 @DarkHollow / #6787430 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4600218",
          "cefr_level": "A1",
          "word_slugs": [
            "fecha-noun"
          ]
        },
        {
          "id": "2879417",
          "text": "Se ha equivocado de fecha.",
          "translation": "Он ошибся с датой.",
          "source": "Tatoeba #2879417 @massama / #5086734 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2879417",
          "cefr_level": "A1",
          "word_slugs": [
            "fecha-noun"
          ]
        }
      ],
      "tags": [
        "B1"
