          ]
        },
        {
          "id": "445866",
          "text": "Me pongo los pantalones.",
          "translation": "Я надеваю брюки.",
          "source": "Tatoeba #445866 @Shishir / #11392896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/445866",
          "cefr_level": "A1",
          "word_slugs": [
            "pantalones-noun"
          ]
        },
        {
          "id": "3346078",
          "text": "Te rajaste los pantalones.",
          "translation": "Ты порвал свои штаны.",
          "source": "Tatoeba #3346078 @gianich73 / #3346033 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3346078",
          "cefr_level": "A1",
          "word_slugs": [
            "pantalones-noun"
          ]
        },
        {
          "id": "2894410",
          "text": "Tus pantalones están sucios.",
          "translation": "У тебя брюки грязные.",
          "source": "Tatoeba #2894410 @marcelostockle / #3588952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2894410",
          "cefr_level": "A1",
          "word_slugs": [
            "pantalones-noun"
          ]
        }
      ],
