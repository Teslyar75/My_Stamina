        {
          "id": "1218730",
          "text": "Estaré listo en unos momentos.",
          "translation": "Я буду готов через несколько минут.",
          "source": "Tatoeba #1218730 @marcelostockle / #3285319 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1218730",
          "cefr_level": "A1",
          "word_slugs": [
            "momentos-noun"
          ]
        },
        {
          "id": "4940943",
          "text": "Siempre fastidias los buenos momentos.",
          "translation": "Ты всегда портишь хорошие моменты.",
          "source": "Tatoeba #4940943 @Shishir / #10681020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4940943",
          "cefr_level": "A1",
          "word_slugs": [
            "momentos-noun"
          ]
        },
        {
          "id": "1218728",
          "text": "Por unos momentos, hubo completo silencio.",
          "translation": "На несколько мгновений воцарилась полная тишина.",
          "source": "Tatoeba #1218728 @marcelostockle / #6707683 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1218728",
          "cefr_level": "A1",
          "word_slugs": [
            "momentos-noun"
          ]
        },
        {
          "id": "3748230",
          "text": "La vida no consiste solo en buenos momentos.",
          "translation": "Жизнь состоит не из одних хороших моментов.",
          "source": "Tatoeba #3748230 @carlosalberto / #9007957 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3748230",
          "cefr_level": "A1",
          "word_slugs": [
            "momentos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "momentos",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "coger-verb",
      "lemma": "coger",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1564,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to take, catch, hold, to get, to seize",
          "to pick, harvest",
          "to fish",
          "to seize, arrest; to overtake"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4272185",
          "text": "Pueden coger el tren.",
          "translation": "Они могут поехать на поезде.",
          "source": "Tatoeba #4272185 @mervert1 / #12094188 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4272185",
          "cefr_level": "A1",
          "word_slugs": [
            "coger-verb"
          ]
        },
        {
          "id": "2409275",
          "text": "Puedo coger el autobús.",
          "translation": "Я могу сесть на автобус.",
          "source": "Tatoeba #2409275 @Shishir / #4271268 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2409275",
          "cefr_level": "A1",
          "word_slugs": [
            "coger-verb"
          ]
        },
        {
          "id": "2131414",
          "text": "¿Qué tren quieres coger?",
          "translation": "На какой поезд ты хочешь сесть?",
          "source": "Tatoeba #2131414 @Shishir / #5253701 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2131414",
          "cefr_level": "A1",
          "word_slugs": [
            "coger-verb"
          ]
        },
        {
          "id": "769403",
          "text": "¿Qué tren vas a coger?",
          "translation": "На каком поезде ты поедешь?",
          "source": "Tatoeba #769403 @Shishir / #1510399 @polymerase (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/769403",
          "cefr_level": "A1",
          "word_slugs": [
            "coger-verb"
          ]
        },
        {
          "id": "1359616",
          "text": "¿Qué tren vais a coger?",
          "translation": "На каком поезде вы поедете?",
          "source": "Tatoeba #1359616 @Shishir / #6055531 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1359616",
          "cefr_level": "A1",
          "word_slugs": [
            "coger-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el coger",
        "plural": "",
        "infinitive": "coger"
      }
