          "cefr_level": "A1",
          "word_slugs": [
            "tesoro-noun"
          ]
        },
        {
          "id": "13857409",
          "text": "Fuimos nosotros quienes encontramos el tesoro.",
          "translation": "Это мы нашли клад.",
          "source": "Tatoeba #13857409 @mraz / #14020346 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13857409",
          "cefr_level": "A1",
          "word_slugs": [
            "tesoro-noun"
          ]
        },
        {
          "id": "2108801",
          "text": "El tesoro fue robado por los piratas.",
          "translation": "Сокровища были украдены пиратами.",
          "source": "Tatoeba #2108801 @hayastan / #5601311 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2108801",
          "cefr_level": "A1",
          "word_slugs": [
            "tesoro-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
