        "en": [
          "plural of mentira"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "582487",
          "text": "No digas mentiras.",
          "translation": "Не лги.",
          "source": "Tatoeba #582487 @Shishir / #793002 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/582487",
          "cefr_level": "A1",
          "word_slugs": [
            "mentiras-noun"
          ]
        },
        {
          "id": "9739862",
          "text": "Dice puras mentiras.",
          "translation": "Сказанное им - чистейшая ложь.",
          "source": "Tatoeba #9739862 @JSKabylie / #9965832 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9739862",
          "cefr_level": "A1",
          "word_slugs": [
            "mentiras-noun"
          ]
        },
        {
          "id": "537740",
          "text": "Nunca digas mentiras.",
          "translation": "Никогда не лги.",
          "source": "Tatoeba #537740 @Shishir / #5637740 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/537740",
          "cefr_level": "A1",
          "word_slugs": [
            "mentiras-noun"
          ]
        },
        {
          "id": "1752628",
          "text": "Él sabe decir mentiras.",
          "translation": "Он умеет врать.",
          "source": "Tatoeba #1752628 @marcelostockle / #5286070 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1752628",
          "cefr_level": "A1",
          "word_slugs": [
            "mentiras-noun"
          ]
        },
        {
          "id": "1207292",
          "text": "¡No digas nunca mentiras!",
          "translation": "Никогда не говори неправду!",
          "source": "Tatoeba #1207292 @Shishir / #1076172 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1207292",
          "cefr_level": "A1",
