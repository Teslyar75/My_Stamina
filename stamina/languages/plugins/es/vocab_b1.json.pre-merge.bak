    {
      "slug": "humanos-adj",
      "lemma": "humanos",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1306,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "masculine plural of humano"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3783129",
          "text": "Ellos son humanos.",
          "translation": "Они люди.",
          "source": "Tatoeba #3783129 @marcelostockle / #9718104 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3783129",
          "cefr_level": "A1",
