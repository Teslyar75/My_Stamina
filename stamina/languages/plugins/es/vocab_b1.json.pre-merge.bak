    {
      "slug": "averiguar-verb",
      "lemma": "averiguar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1532,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to find out, figure out, work out, determine",
          "to dig up, to investigate",
          "to argue"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4587311",
          "text": "Tenemos que averiguar.",
          "translation": "Мы должны выяснить.",
          "source": "Tatoeba #4587311 @cueyayotl / #4587301 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4587311",
          "cefr_level": "A1",
          "word_slugs": [
            "averiguar-verb"
          ]
        },
        {
          "id": "1305382",
          "text": "Pude averiguar su dirección.",
          "translation": "Мне удалось узнать его адрес.",
          "source": "Tatoeba #1305382 @marcelostockle / #9723700 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1305382",
          "cefr_level": "A1",
          "word_slugs": [
            "averiguar-verb"
          ]
        },
        {
          "id": "1305375",
          "text": "No pudimos averiguar su dirección.",
          "translation": "Мы не смогли установить её адрес.",
          "source": "Tatoeba #1305375 @marcelostockle / #5968481 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1305375",
          "cefr_level": "A1",
          "word_slugs": [
            "averiguar-verb"
          ]
        },
        {
          "id": "725733",
          "text": "¿Podrías averiguar cómo llegar ahí?",
          "translation": "Не мог бы ты узнать, как туда добраться?",
          "source": "Tatoeba #725733 @darinmex / #9723703 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/725733",
          "cefr_level": "A1",
          "word_slugs": [
            "averiguar-verb"
          ]
        },
        {
          "id": "1305349",
          "text": "Debo averiguar exactamente qué salió mal.",
          "translation": "Я должен выяснить, что именно пошло не так.",
          "source": "Tatoeba #1305349 @marcelostockle / #6819182 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1305349",
          "cefr_level": "A1",
          "word_slugs": [
            "averiguar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el averiguar",
        "plural": "",
        "infinitive": "averiguar"
      }
    },
    {
      "slug": "volar-verb",
      "lemma": "volar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1533,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "летать",
          "лететь"
        ],
        "en": [
          "to fly, to fly away",
          "to fly (on an airplane)",
          "to blow up",
          "to anger, to exasperate, to infuriate"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4553567",
          "text": "Él puede volar.",
          "translation": "Он может летать.",
          "source": "Tatoeba #4553567 @swyter / #4550964 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4553567",
          "cefr_level": "A1",
          "word_slugs": [
            "volar-verb"
          ]
        },
        {
          "id": "3210938",
          "text": "Además, puedo volar.",
          "translation": "Кроме того, я могу летать.",
          "source": "Tatoeba #3210938 @Dreamk33 / #3211234 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3210938",
          "cefr_level": "A1",
          "word_slugs": [
            "volar-verb"
          ]
        },
        {
          "id": "2189579",
          "text": "¡Ojalá pudiera volar!",
          "translation": "Вот бы я мог летать!",
          "source": "Tatoeba #2189579 @Shishir / #7350172 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2189579",
          "cefr_level": "A1",
          "word_slugs": [
            "volar-verb"
          ]
        },
        {
          "id": "917145",
          "text": "Yo no sé volar.",
          "translation": "Я не умею летать.",
          "source": "Tatoeba #917145 @aye1995 / #1436549 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/917145",
          "cefr_level": "A1",
          "word_slugs": [
            "volar-verb"
          ]
        },
        {
          "id": "13465230",
          "text": "Me da miedo volar.",
          "translation": "Я боюсь летать.",
          "source": "Tatoeba #13465230 @Seael / #4551378 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13465230",
          "cefr_level": "A1",
          "word_slugs": [
            "volar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el volar",
