    {
      "slug": "c-character",
      "lemma": "c",
      "pos": "character",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2491,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
