    {
      "slug": "irte-verb",
      "lemma": "irte",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1246,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of ir combined with te"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1841891",
          "text": "Debes irte a casa.",
          "translation": "Ты должен идти домой.",
          "source": "Tatoeba #1841891 @marcelostockle / #3257686 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1841891",
          "cefr_level": "A1",
          "word_slugs": [
            "irte-verb"
          ]
        },
        {
          "id": "1286264",
          "text": "Puedes irte a casa.",
          "translation": "Ты можешь идти домой.",
          "source": "Tatoeba #1286264 @marcelostockle / #664160 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1286264",
          "cefr_level": "A1",
          "word_slugs": [
            "irte-verb"
          ]
        },
        {
          "id": "2093574",
          "text": "Todavía no puedes irte.",
          "translation": "Тебе пока нельзя уезжать.",
          "source": "Tatoeba #2093574 @Shishir / #11806279 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2093574",
          "cefr_level": "A1",
          "word_slugs": [
            "irte-verb"
          ]
        },
        {
          "id": "5290055",
          "text": "No puedes simplemente irte.",
          "translation": "Ты не можешь просто уйти.",
          "source": "Tatoeba #5290055 @baudelaire / #2038990 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5290055",
          "cefr_level": "A1",
          "word_slugs": [
            "irte-verb"
          ]
        },
        {
