    {
      "slug": "planta-noun",
      "lemma": "planta",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2372,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "растение"
        ],
        "en": [
          "plant (an organism of the kingdom Plantae, and now specifically, a living organism of the Embryophyta (land plants) or of the Chlorophyta (green algae), a eukaryote that includes d",
          "plant (factory)",
          "floor, level (of a high building)",
          "sole"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3027641",
          "text": "Es una planta.",
          "translation": "Это растение.",
          "source": "Tatoeba #3027641 @alexmarcelo / #5655182 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3027641",
          "cefr_level": "A1",
          "word_slugs": [
            "planta-noun"
          ]
        },
        {
          "id": "687701",
          "text": "¿Qué planta es?",
          "translation": "Что это за растение?",
          "source": "Tatoeba #687701 @lukaszpp / #4958870 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/687701",
          "cefr_level": "A1",
          "word_slugs": [
            "planta-noun"
          ]
        },
        {
          "id": "942477",
          "text": "Esta planta es comestible.",
          "translation": "Это растение съедобно.",
          "source": "Tatoeba #942477 @Shishir / #3713475 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/942477",
          "cefr_level": "A1",
          "word_slugs": [
            "planta-noun"
          ]
        },
        {
          "id": "9510748",
          "text": "Esta planta necesita sombra.",
          "translation": "Этому растению нужна тень.",
          "source": "Tatoeba #9510748 @hayastan / #13043639 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9510748",
          "cefr_level": "A1",
          "word_slugs": [
            "planta-noun"
          ]
        },
        {
          "id": "12943964",
          "text": "Esta planta necesita fertilizante.",
          "translation": "Этому растению нужно удобрение.",
          "source": "Tatoeba #12943964 @araneo / #12945286 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12943964",
          "cefr_level": "A1",
          "word_slugs": [
            "planta-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
