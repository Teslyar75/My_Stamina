      "examples": [
        {
          "id": "2121233",
          "text": "Laura es mi novia.",
          "translation": "Лаура — моя девушка.",
          "source": "Tatoeba #2121233 @hayastan / #6044341 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2121233",
          "cefr_level": "A1",
          "word_slugs": [
            "laura-name"
          ]
        },
        {
          "id": "1110336",
          "text": "Laura es de Brasil. Es brasileña.",
          "translation": "Лаура из Бразилии. Она бразильянка.",
          "source": "Tatoeba #1110336 @alexmarcelo / #7806498 @Txoria (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1110336",
          "cefr_level": "A1",
