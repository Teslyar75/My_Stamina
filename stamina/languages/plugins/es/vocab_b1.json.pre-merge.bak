          "cefr_level": "A1",
          "word_slugs": [
            "podéis-verb"
          ]
        },
        {
          "id": "1878906",
          "text": "Podéis hablar alemán.",
          "translation": "Вы можете говорить по-немецки.",
          "source": "Tatoeba #1878906 @Shishir / #4271253 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1878906",
