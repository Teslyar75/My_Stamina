    {
      "slug": "contar-verb",
      "lemma": "contar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1264,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to count; to tally",
          "to tell (a story); narrate",
          "to be (a certain number of years of age)",
          "to rely"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3666716",
          "text": "Puedes contar conmigo.",
          "translation": "Можешь на меня рассчитывать.",
          "source": "Tatoeba #3666716 @Seael / #3743609 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3666716",
          "cefr_level": "A1",
          "word_slugs": [
            "contar-verb"
          ]
        },
        {
          "id": "7304339",
          "text": "¿Podemos contar contigo?",
          "translation": "Мы можем на тебя рассчитывать?",
          "source": "Tatoeba #7304339 @UsuarioX / #3467944 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7304339",
          "cefr_level": "A1",
          "word_slugs": [
            "contar-verb"
          ]
        },
        {
          "id": "2857553",
          "text": "Él no sabe contar.",
          "translation": "Он не умеет считать.",
          "source": "Tatoeba #2857553 @marcelostockle / #894620 @pauldhunt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2857553",
          "cefr_level": "A1",
          "word_slugs": [
            "contar-verb"
          ]
        },
        {
          "id": "2697484",
          "text": "Sé contar hasta cien.",
          "translation": "Я умею считать до ста.",
          "source": "Tatoeba #2697484 @Shishir / #5177294 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2697484",
          "cefr_level": "A1",
          "word_slugs": [
            "contar-verb"
          ]
        },
        {
          "id": "3467860",
          "text": "¿Podemos contar con vos?",
          "translation": "Мы можем на тебя рассчитывать?",
          "source": "Tatoeba #3467860 @hayastan / #3467944 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3467860",
          "cefr_level": "A1",
          "word_slugs": [
            "contar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el contar",
