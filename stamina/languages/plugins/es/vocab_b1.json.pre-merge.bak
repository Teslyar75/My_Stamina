    {
      "slug": "date-verb",
      "lemma": "date",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1750,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of dar:",
          "second-person singular imperative combined with te",
          "inflection of dar:",
          "second-person singular voseo imperative combined with te"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2399410",
          "text": "Por favor, date prisa.",
          "translation": "Побыстрей, пожалуйста!",
          "source": "Tatoeba #2399410 @Shishir / #13936416 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2399410",
          "cefr_level": "A1",
          "word_slugs": [
            "date-verb"
          ]
        },
        {
          "id": "2304588",
          "text": "¡Por favor, date prisa!",
          "translation": "Побыстрей, пожалуйста!",
          "source": "Tatoeba #2304588 @Shishir / #13936416 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2304588",
          "cefr_level": "A1",
          "word_slugs": [
            "date-verb"
          ]
        },
        {
          "id": "764780",
          "text": "Date prisa o llegarás tarde.",
          "translation": "Поторапливайся, а то опоздаешь.",
          "source": "Tatoeba #764780 @Shishir / #1676870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/764780",
          "cefr_level": "A1",
          "word_slugs": [
            "date-verb"
          ]
        },
        {
          "id": "863767",
          "text": "Date prisa, o llegarás tarde.",
          "translation": "Поторапливайся, а то опоздаешь.",
          "source": "Tatoeba #863767 @washisnein / #1676870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/863767",
          "cefr_level": "A1",
          "word_slugs": [
            "date-verb"
          ]
        },
        {
          "id": "970953",
          "text": "¡Date prisa! Empieza el concierto.",
          "translation": "Давай быстрей! Концерт начинается.",
          "source": "Tatoeba #970953 @opor / #7836180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/970953",
          "cefr_level": "A1",
          "word_slugs": [
            "date-verb"
          ]
        }
      ],
