      },
      "gender": null,
      "examples": [
        {
          "id": "2271679",
          "text": "Vi casas bonitas.",
          "translation": "Я видел красивые дома.",
          "source": "Tatoeba #2271679 @Espi / #5518852 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2271679",
          "cefr_level": "A1",
