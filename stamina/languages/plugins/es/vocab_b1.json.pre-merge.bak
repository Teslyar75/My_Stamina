    {
      "slug": "compromiso-noun",
      "lemma": "compromiso",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2420,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "commitment",
          "engagement, appointment",
          "compromise",
          "predicament (an unfortunate or trying position)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6677429",
          "text": "Tengo un compromiso que atender.",
          "translation": "Мне нужно выполнить одно обязательство.",
          "source": "Tatoeba #6677429 @arh / #6835786 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6677429",
          "cefr_level": "A1",
          "word_slugs": [
            "compromiso-noun"
          ]
        },
        {
          "id": "673936",
          "text": "Al final alcanzamos un compromiso.",
          "translation": "Мы наконец пришли к компромиссу.",
          "source": "Tatoeba #673936 @Dejo / #8299390 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/673936",
          "cefr_level": "A1",
          "word_slugs": [
            "compromiso-noun"
          ]
        },
        {
          "id": "3975685",
          "text": "Muchas personas están evitando tener un compromiso serio.",
          "translation": "Многие люди избегают узаконивания своих отношений.",
          "source": "Tatoeba #3975685 @hayastan / #3976987 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3975685",
          "cefr_level": "A1",
          "word_slugs": [
            "compromiso-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "compromiso",
        "plural": "",
        "infinitive": ""
      }
