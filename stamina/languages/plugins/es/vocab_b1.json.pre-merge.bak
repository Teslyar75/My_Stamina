    {
      "slug": "vean-verb",
      "lemma": "vean",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2496,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of ver:",
          "third-person plural present subjunctive",
          "inflection of ver:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2081580",
          "text": "No quiero que vean esto.",
          "translation": "Я не хочу, чтобы вы это видели.",
          "source": "Tatoeba #2081580 @marcelostockle / #3946077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2081580",
          "cefr_level": "A1",
          "word_slugs": [
            "vean-verb"
          ]
        },
        {
          "id": "1508809",
          "text": "Vete antes de que te vean.",
          "translation": "Сматывайся, пока они тебя тут не увидели.",
          "source": "Tatoeba #1508809 @marcelostockle / #2015467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1508809",
          "cefr_level": "A1",
          "word_slugs": [
            "vean-verb"
          ]
        },
        {
          "id": "550490",
          "text": "No quiero que me vean con él.",
          "translation": "Я не хочу, чтобы меня с ним видели.",
          "source": "Tatoeba #550490 @Shishir / #11002887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/550490",
          "cefr_level": "A1",
          "word_slugs": [
            "vean-verb"
          ]
        },
        {
          "id": "2368780",
          "text": "Tom no quiere que le vean con Mary.",
          "translation": "Том не хочет, чтобы его видели с Мэри.",
          "source": "Tatoeba #2368780 @Shishir / #3842578 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2368780",
          "cefr_level": "A1",
          "word_slugs": [
            "vean-verb"
          ]
        },
        {
          "id": "3088929",
          "text": "No dejes que los niños vean esta película.",
          "translation": "Не давай детям смотреть этот фильм.",
          "source": "Tatoeba #3088929 @marcelostockle / #6981994 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3088929",
          "cefr_level": "A1",
          "word_slugs": [
            "vean-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "vean",
        "plural": "",
        "infinitive": "vean"
      }
