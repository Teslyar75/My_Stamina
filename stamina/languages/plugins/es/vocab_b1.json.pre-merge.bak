    {
      "slug": "pérdida-noun",
      "lemma": "pérdida",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2063,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "loss",
          "leak"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3373535",
          "text": "Siento tu pérdida.",
          "translation": "Я сожалею о твоей потере.",
          "source": "Tatoeba #3373535 @gianich73 / #3372320 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3373535",
          "cefr_level": "A1",
          "word_slugs": [
            "pérdida-noun"
          ]
        },
        {
          "id": "3298734",
          "text": "Es vuestra pérdida.",
          "translation": "Это ваша потеря.",
          "source": "Tatoeba #3298734 @gianich73 / #2722248 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3298734",
          "cefr_level": "A1",
          "word_slugs": [
            "pérdida-noun"
          ]
        },
        {
          "id": "4360543",
          "text": "Fue una gran pérdida.",
          "translation": "Это была большая потеря.",
          "source": "Tatoeba #4360543 @hayastan / #4360501 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4360543",
          "cefr_level": "A1",
          "word_slugs": [
            "pérdida-noun"
          ]
        },
        {
          "id": "2534279",
          "text": "¡Qué pérdida de tiempo!",
          "translation": "Какая потеря времени!",
          "source": "Tatoeba #2534279 @Balamax / #2534320 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2534279",
          "cefr_level": "A1",
          "word_slugs": [
            "pérdida-noun"
          ]
        },
        {
          "id": "5267925",
          "text": "Es una pérdida irreparable.",
          "translation": "Это невосполнимая потеря.",
          "source": "Tatoeba #5267925 @ecorralest101 / #6908036 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5267925",
          "cefr_level": "A1",
          "word_slugs": [
            "pérdida-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
