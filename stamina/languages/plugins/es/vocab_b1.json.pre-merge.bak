    {
      "slug": "amistad-noun",
      "lemma": "amistad",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2367,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "friendship"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2669202",
          "text": "¡Por nuestra amistad!",
          "translation": "За нашу дружбу!",
          "source": "Tatoeba #2669202 @ramonj / #2668629 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2669202",
          "cefr_level": "A1",
          "word_slugs": [
            "amistad-noun"
          ]
        },
        {
          "id": "2259642",
          "text": "Pronto hicieron amistad.",
          "translation": "Они вскоре подружились.",
          "source": "Tatoeba #2259642 @cueyayotl / #4036193 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259642",
          "cefr_level": "A1",
          "word_slugs": [
            "amistad-noun"
          ]
        },
        {
          "id": "557623",
          "text": "Creo en la amistad.",
          "translation": "Я верю в дружбу.",
          "source": "Tatoeba #557623 @Shishir / #1479049 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/557623",
          "cefr_level": "A1",
          "word_slugs": [
            "amistad-noun"
          ]
        },
        {
          "id": "2087359",
          "text": "La amistad es magia.",
          "translation": "Дружба - это магия.",
          "source": "Tatoeba #2087359 @marcelostockle / #3285577 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2087359",
          "cefr_level": "A1",
          "word_slugs": [
            "amistad-noun"
          ]
        },
        {
          "id": "1993133",
          "text": "No merezco tu amistad.",
          "translation": "Я не заслуживаю твоей дружбы.",
          "source": "Tatoeba #1993133 @marcelostockle / #1993116 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1993133",
          "cefr_level": "A1",
          "word_slugs": [
            "amistad-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
