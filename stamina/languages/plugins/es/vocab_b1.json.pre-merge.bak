    {
      "slug": "llevas-verb",
      "lemma": "llevas",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1220,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular present indicative of llevar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1583493",
          "text": "¿Me llevas allá?",
          "translation": "Ты возьмешь меня туда?",
          "source": "Tatoeba #1583493 @marcelostockle / #1584032 @chispa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1583493",
          "cefr_level": "A1",
          "word_slugs": [
            "llevas-verb"
          ]
        },
        {
          "id": "2132189",
          "text": "¿Qué llevas puesto?",
          "translation": "Что на тебе надето?",
          "source": "Tatoeba #2132189 @Shishir / #2850331 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2132189",
          "cefr_level": "A1",
          "word_slugs": [
            "llevas-verb"
          ]
        },
        {
          "id": "1384689",
          "text": "¿Me llevas a casa?",
          "translation": "Ты отвезёшь меня домой?",
          "source": "Tatoeba #1384689 @enteka / #796161 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1384689",
          "cefr_level": "A1",
          "word_slugs": [
            "llevas-verb"
          ]
        },
        {
          "id": "512393",
          "text": "Creo que llevas razón.",
          "translation": "Я думаю, что ты прав.",
          "source": "Tatoeba #512393 @Shishir / #788188 @korntex (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/512393",
          "cefr_level": "A1",
          "word_slugs": [
            "llevas-verb"
          ]
        },
        {
          "id": "2495484",
          "text": "¿No llevas dinero encima?",
          "translation": "У тебя нет с собой денег?",
          "source": "Tatoeba #2495484 @Amastan / #4024170 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2495484",
          "cefr_level": "A1",
          "word_slugs": [
            "llevas-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
