          "cefr_level": "A1",
          "word_slugs": [
            "veía-verb"
          ]
        },
        {
          "id": "3883686",
          "text": "¿Tom se veía feliz?",
          "translation": "Том выглядел счастливым?",
          "source": "Tatoeba #3883686 @cueyayotl / #2611174 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3883686",
