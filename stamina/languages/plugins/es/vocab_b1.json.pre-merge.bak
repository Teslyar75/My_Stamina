    {
      "slug": "william-name",
      "lemma": "William",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2208,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "a male given name from English"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2266396",
          "text": "William Shakespeare fue un dramaturgo inglés.",
          "translation": "Уильям Шекспир был английским драматургом.",
          "source": "Tatoeba #2266396 @hayastan / #3652001 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2266396",
          "cefr_level": "A1",
          "word_slugs": [
            "william-name"
          ]
        },
        {
          "id": "1337789",
          "text": "Se lo dije a William, pero no me creyó.",
          "translation": "Я сказал Уильяму, но он не поверил мне.",
          "source": "Tatoeba #1337789 @hayastan / #4648827 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1337789",
          "cefr_level": "A1",
          "word_slugs": [
            "william-name"
          ]
        },
        {
          "id": "1165432",
          "text": "Habiendo fallado dos veces, William ya no quería tratar otra vez.",
          "translation": "Дважды потерпев неудачу, Вильям больше не хотел пытаться.",
          "source": "Tatoeba #1165432 @marcelostockle / #4367170 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1165432",
          "cefr_level": "A1",
          "word_slugs": [
            "william-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
