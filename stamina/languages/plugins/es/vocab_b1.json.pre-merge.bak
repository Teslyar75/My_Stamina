        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3804655",
          "text": "Tiene pocas amigas.",
          "translation": "У неё мало подруг.",
          "source": "Tatoeba #3804655 @cueyayotl / #4099690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3804655",
          "cefr_level": "A1",
