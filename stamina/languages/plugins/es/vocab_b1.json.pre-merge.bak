          "transit, crossing",
          "moment, time",
          "turn, run, instance",
          "play, move, turn in a game"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3777149",
          "text": "Es pasada medianoche.",
          "translation": "Уже за полночь.",
          "source": "Tatoeba #3777149 @marcelostockle / #3944487 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3777149",
          "cefr_level": "A1",
          "word_slugs": [
