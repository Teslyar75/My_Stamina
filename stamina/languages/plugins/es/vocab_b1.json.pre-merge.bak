    {
      "slug": "casos-noun",
      "lemma": "casos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1774,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of caso"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7447452",
          "text": "Hay casos semejantes.",
          "translation": "Есть похожие случаи.",
          "source": "Tatoeba #7447452 @arh / #7791162 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7447452",
          "cefr_level": "A1",
          "word_slugs": [
            "casos-noun"
          ]
        },
        {
          "id": "905748",
          "text": "Son los casos extremos.",
          "translation": "Это крайние случаи.",
          "source": "Tatoeba #905748 @darinmex / #11234284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/905748",
          "cefr_level": "A1",
          "word_slugs": [
            "casos-noun"
          ]
        },
        {
          "id": "7447454",
          "text": "Hay muchos casos similares.",
          "translation": "Есть много похожих случаев.",
          "source": "Tatoeba #7447454 @arh / #7453862 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7447454",
          "cefr_level": "A1",
          "word_slugs": [
            "casos-noun"
          ]
        },
        {
          "id": "3100593",
          "text": "Adiviné bien en nueve de diez casos.",
          "translation": "В девяти случаях из десяти я угадал.",
          "source": "Tatoeba #3100593 @marcelostockle / #5743529 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3100593",
          "cefr_level": "A1",
          "word_slugs": [
            "casos-noun"
          ]
        },
        {
          "id": "2265996",
          "text": "Debe evitarse la dureza en esos casos.",
          "translation": "В таких случаях надо избегать резкости.",
          "source": "Tatoeba #2265996 @cueyayotl / #6323589 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2265996",
          "cefr_level": "A1",
          "word_slugs": [
            "casos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
