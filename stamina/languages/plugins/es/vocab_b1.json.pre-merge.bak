    {
      "slug": "descubrir-verb",
      "lemma": "descubrir",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2044,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to discover",
          "to reveal",
          "to invent"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5130189",
          "text": "Tomás va a descubrir la verdad.",
          "translation": "Том узнает правду.",
          "source": "Tatoeba #5130189 @don_ramon / #5130194 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5130189",
          "cefr_level": "A1",
          "word_slugs": [
            "descubrir-verb"
          ]
        },
        {
          "id": "3999165",
          "text": "Solo quiero descubrir qué ha pasado.",
          "translation": "Я всего лишь хочу выяснить, что случилось.",
          "source": "Tatoeba #3999165 @Shishir / #3999389 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3999165",
          "cefr_level": "A1",
          "word_slugs": [
            "descubrir-verb"
          ]
        },
        {
          "id": "1238762",
          "text": "Tom intentó descubrir adónde había ido Mary.",
          "translation": "Том пытался выяснить, куда пошла Мэри.",
          "source": "Tatoeba #1238762 @wallebot / #3155551 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1238762",
          "cefr_level": "A1",
          "word_slugs": [
            "descubrir-verb"
          ]
        },
        {
          "id": "583034",
          "text": "Fueron incapaces de descubrir el menor secreto.",
          "translation": "Они не могли раскрыть хоть какую-то тайну.",
          "source": "Tatoeba #583034 @qdii / #1319315 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/583034",
          "cefr_level": "A1",
          "word_slugs": [
            "descubrir-verb"
          ]
        },
        {
          "id": "2831933",
          "text": "Acabo de descubrir el lado oscuro de Tatoeba.",
          "translation": "Я только что обнаружил тёмную сторону Татоэбы.",
          "source": "Tatoeba #2831933 @ramonj / #2831936 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2831933",
          "cefr_level": "A1",
          "word_slugs": [
            "descubrir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el descubrir",
        "plural": "",
        "infinitive": "descubrir"
      }
    },
