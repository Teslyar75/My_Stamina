    {
      "slug": "acciones-noun",
      "lemma": "acciones",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2279,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of acción"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4531977",
          "text": "¡Exigimos que tomen acciones!",
          "translation": "Мы требуем от вас действий!",
          "source": "Tatoeba #4531977 @Kiraness / #9822396 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4531977",
          "cefr_level": "A1",
          "word_slugs": [
            "acciones-noun"
          ]
        },
        {
          "id": "945496",
          "text": "Necesitamos acciones no palabras.",
          "translation": "Нам нужны действия, а не слова.",
          "source": "Tatoeba #945496 @marcelostockle / #2354009 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/945496",
          "cefr_level": "A1",
          "word_slugs": [
            "acciones-noun"
          ]
        },
        {
          "id": "1769234",
          "text": "Haz buenas acciones y vocifera.",
          "translation": "Делай добрые дела и кричи об этом.",
          "source": "Tatoeba #1769234 @marcelostockle / #9822402 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1769234",
          "cefr_level": "A1",
          "word_slugs": [
            "acciones-noun"
          ]
        },
        {
          "id": "1171969",
          "text": "Tiene acciones en esta compañía.",
          "translation": "У него есть акции этой компании.",
          "source": "Tatoeba #1171969 @Shishir / #4156250 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1171969",
          "cefr_level": "A1",
          "word_slugs": [
            "acciones-noun"
          ]
        },
        {
          "id": "2788214",
          "text": "Estoy hablando sobre tus acciones.",
          "translation": "Я говорю о твоих действиях.",
          "source": "Tatoeba #2788214 @cueyayotl / #2793845 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2788214",
          "cefr_level": "A1",
          "word_slugs": [
            "acciones-noun"
          ]
        }
