    {
      "slug": "hiciera-verb",
      "lemma": "hiciera",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1751,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect subjunctive of hacer"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2362713",
          "text": "Le pedí que hiciera té.",
          "translation": "Я попросил его приготовить чай.",
          "source": "Tatoeba #2362713 @Shishir / #4413918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2362713",
          "cefr_level": "A1",
          "word_slugs": [
            "hiciera-verb"
          ]
        },
        {
          "id": "2751239",
          "text": "Dudaba que él lo hiciera.",
          "translation": "Я сомневался, что он это сделает.",
          "source": "Tatoeba #2751239 @cueyayotl / #2751238 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2751239",
          "cefr_level": "A1",
          "word_slugs": [
            "hiciera-verb"
          ]
        },
        {
          "id": "3388906",
          "text": "Me dijiste que hiciera esto.",
          "translation": "Ты сказал мне, чтобы я это сделал.",
          "source": "Tatoeba #3388906 @carlosalberto / #10590284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3388906",
          "cefr_level": "A1",
          "word_slugs": [
            "hiciera-verb"
          ]
        },
        {
          "id": "1526252",
          "text": "Todos querían que lo hiciera.",
          "translation": "Все хотели, чтобы я это сделал.",
          "source": "Tatoeba #1526252 @marcelostockle / #1870701 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1526252",
          "cefr_level": "A1",
          "word_slugs": [
            "hiciera-verb"
          ]
        },
        {
          "id": "13902318",
          "text": "¿Qué pensarías si yo hiciera eso?",
          "translation": "Что бы ты подумал, если бы я это сделал?",
          "source": "Tatoeba #13902318 @mervert1 / #13908832 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13902318",
          "cefr_level": "A1",
          "word_slugs": [
            "hiciera-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "hiciera",
        "plural": "",
        "infinitive": "hiciera"
      }
    },
    {
      "slug": "hablé-verb",
