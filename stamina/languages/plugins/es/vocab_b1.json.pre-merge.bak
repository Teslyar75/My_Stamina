    {
      "slug": "cuestión-noun",
      "lemma": "cuestión",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1253,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "matter, question, issue",
          "a question; a sentence that asks for information",
          "thing"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1574884",
          "text": "Es cuestión de tiempo.",
          "translation": "Это вопрос времени.",
          "source": "Tatoeba #1574884 @marcelostockle / #3571818 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1574884",
          "cefr_level": "A1",
          "word_slugs": [
            "cuestión-noun"
          ]
        },
        {
          "id": "2259250",
          "text": "Eso es cuestión aparte.",
          "translation": "Это отдельный вопрос.",
          "source": "Tatoeba #2259250 @cueyayotl / #4556819 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259250",
          "cefr_level": "A1",
          "word_slugs": [
            "cuestión-noun"
          ]
        },
        {
          "id": "2924545",
          "text": "La cuestión es delicada.",
          "translation": "Вопрос деликатный.",
          "source": "Tatoeba #2924545 @alexmarcelo / #4992998 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2924545",
          "cefr_level": "A1",
          "word_slugs": [
            "cuestión-noun"
          ]
        },
        {
          "id": "10957972",
          "text": "Es una cuestión delicada.",
          "translation": "Это деликатный вопрос.",
          "source": "Tatoeba #10957972 @Adelpa / #11928226 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10957972",
          "cefr_level": "A1",
          "word_slugs": [
            "cuestión-noun"
          ]
        },
        {
          "id": "2246753",
          "text": "La cuestión es si vendrá.",
          "translation": "Вопрос в том, придёт он или нет.",
          "source": "Tatoeba #2246753 @Shishir / #4936384 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2246753",
          "cefr_level": "A1",
          "word_slugs": [
            "cuestión-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
