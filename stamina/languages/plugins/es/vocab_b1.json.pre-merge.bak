          ]
        },
        {
          "id": "13513448",
          "text": "¿Alguno de vosotros habéis leído '1984'?",
          "translation": "Кто-нибудь из вас читал \"1984\"?",
          "source": "Tatoeba #13513448 @Seael / #13513490 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13513448",
