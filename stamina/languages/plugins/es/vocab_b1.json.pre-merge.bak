    {
      "slug": "dejen-verb",
      "lemma": "dejen",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2054,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of dejar:",
          "third-person plural present subjunctive",
          "inflection of dejar:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4505711",
          "text": "Dejen de leer.",
          "translation": "Перестаньте читать.",
          "source": "Tatoeba #4505711 @cueyayotl / #6141049 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4505711",
          "cefr_level": "A1",
          "word_slugs": [
            "dejen-verb"
          ]
        },
        {
          "id": "7814311",
          "text": "¡Dejen de interrumpirme!",
          "translation": "Перестаньте меня перебивать!",
          "source": "Tatoeba #7814311 @User83002 / #7814309 @User83002 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7814311",
          "cefr_level": "A1",
          "word_slugs": [
            "dejen-verb"
          ]
        },
        {
          "id": "5651077",
          "text": "No lo dejen tomar.",
          "translation": "Не давайте ему пить.",
          "source": "Tatoeba #5651077 @cueyayotl / #5651069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5651077",
          "cefr_level": "A1",
          "word_slugs": [
            "dejen-verb"
          ]
        },
        {
          "id": "2092203",
          "text": "Dejen de ser crueles.",
          "translation": "Перестаньте быть жестокими.",
          "source": "Tatoeba #2092203 @alexmarcelo / #4156355 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2092203",
          "cefr_level": "A1",
          "word_slugs": [
            "dejen-verb"
          ]
        },
        {
          "id": "4351042",
          "text": "No los dejen escapar.",
          "translation": "Не давайте им сбежать.",
          "source": "Tatoeba #4351042 @umano / #5500498 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4351042",
          "cefr_level": "A1",
          "word_slugs": [
            "dejen-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
