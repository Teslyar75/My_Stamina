          "misfortune, bad luck",
          "accident, disaster"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3666283",
          "text": "Por desgracia es cierto.",
          "translation": "К сожалению, это правда.",
          "source": "Tatoeba #3666283 @Seael / #5454 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3666283",
