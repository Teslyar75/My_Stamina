    {
      "slug": "fortuna-noun",
      "lemma": "fortuna",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2294,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "fortune",
          "fortune, prophecy, reading",
          "wealth",
          "luck"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1604492",
          "text": "La fortuna es ciega.",
          "translation": "Удача слепа.",
          "source": "Tatoeba #1604492 @marcelostockle / #3510189 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1604492",
          "cefr_level": "A1",
          "word_slugs": [
            "fortuna-noun"
          ]
        },
        {
          "id": "1528043",
          "text": "¡Dios mío, que fortuna!",
          "translation": "Бог мой, какая удача!",
          "source": "Tatoeba #1528043 @hayastan / #4925130 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1528043",
          "cefr_level": "A1",
          "word_slugs": [
            "fortuna-noun"
          ]
        },
        {
          "id": "5920191",
          "text": "Perdió toda su fortuna.",
          "translation": "Он потерял всё своё состояние.",
          "source": "Tatoeba #5920191 @arh / #7124560 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5920191",
          "cefr_level": "A1",
          "word_slugs": [
            "fortuna-noun"
          ]
        },
        {
          "id": "2265966",
          "text": "Por fortuna pudieron escapar.",
          "translation": "К счастью, им удалось сбежать.",
          "source": "Tatoeba #2265966 @cueyayotl / #5083288 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2265966",
          "cefr_level": "A1",
          "word_slugs": [
            "fortuna-noun"
          ]
        },
        {
          "id": "6401178",
          "text": "No creo en la fortuna.",
          "translation": "Я не верю в удачу.",
          "source": "Tatoeba #6401178 @emigonza / #2826855 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6401178",
          "cefr_level": "A1",
          "word_slugs": [
            "fortuna-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "fortuna",
        "plural": "",
        "infinitive": ""
      }
