      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to go up or come up",
          "to raise",
          "to climb",
          "to upload"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1019133",
          "text": "¿Puedes subir al árbol?",
          "translation": "Ты можешь забраться на дерево?",
          "source": "Tatoeba #1019133 @Shishir / #6537075 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1019133",
          "cefr_level": "A1",
          "word_slugs": [
            "subir-verb"
          ]
        },
        {
          "id": "1915042",
          "text": "¿Cómo puedo subir de peso?",
          "translation": "Как мне набрать вес?",
          "source": "Tatoeba #1915042 @hayastan / #4418427 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1915042",
          "cefr_level": "A1",
          "word_slugs": [
            "subir-verb"
          ]
        },
        {
          "id": "500653",
          "text": "Queremos subir a esa montaña.",
          "translation": "Мы хотим подняться на эту гору.",
          "source": "Tatoeba #500653 @drnm2 / #5179850 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/500653",
          "cefr_level": "A1",
          "word_slugs": [
            "subir-verb"
          ]
        },
        {
          "id": "5052118",
          "text": "Tenemos que subir los precios.",
          "translation": "Мы должны поднять цены.",
          "source": "Tatoeba #5052118 @don_ramon / #6109441 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5052118",
          "cefr_level": "A1",
          "word_slugs": [
            "subir-verb"
          ]
        },
        {
          "id": "1695077",
          "text": "¿Me ayudás a subir las escaleras?",
          "translation": "Ты поможешь мне подняться по лестнице?",
          "source": "Tatoeba #1695077 @hayastan / #5672734 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1695077",
          "cefr_level": "A1",
          "word_slugs": [
            "subir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
