    {
      "slug": "estemos-verb",
      "lemma": "estemos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2441,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of estar:",
          "first-person plural present subjunctive",
          "inflection of estar:",
          "first-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2087349",
          "text": "Quiero que estemos juntos.",
          "translation": "Я хочу, чтобы мы были вместе.",
          "source": "Tatoeba #2087349 @hayastan / #718729 @loins (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2087349",
          "cefr_level": "A1",
          "word_slugs": [
            "estemos-verb"
          ]
        },
        {
          "id": "8231736",
          "text": "No parece que estemos en otoño.",
          "translation": "Не похоже, что уже осень.",
          "source": "Tatoeba #8231736 @arh / #8231774 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8231736",
          "cefr_level": "A1",
          "word_slugs": [
            "estemos-verb"
          ]
        },
        {
          "id": "2184725",
          "text": "Quiero que estemos juntos otra vez.",
          "translation": "Я хочу, чтобы мы снова были вместе.",
          "source": "Tatoeba #2184725 @hayastan / #4004417 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2184725",
          "cefr_level": "A1",
          "word_slugs": [
            "estemos-verb"
          ]
        },
        {
          "id": "1610634",
          "text": "No te vayas hasta que estemos allí.",
          "translation": "Не уезжай, пока мы дотуда не доберёмся.",
          "source": "Tatoeba #1610634 @teskmon / #3944134 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1610634",
          "cefr_level": "A1",
          "word_slugs": [
            "estemos-verb"
          ]
        },
        {
          "id": "2182863",
          "text": "Me alegra que estemos de acuerdo en algo.",
          "translation": "Я рад, что мы в чём-то согласны.",
          "source": "Tatoeba #2182863 @hayastan / #8581544 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2182863",
          "cefr_level": "A1",
          "word_slugs": [
            "estemos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "estemos",
        "plural": "",
        "infinitive": "estemos"
      }
