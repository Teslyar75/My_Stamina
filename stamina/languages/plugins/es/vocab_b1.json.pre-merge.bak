    {
      "slug": "rock-noun",
      "lemma": "rock",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2236,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "rock (music style)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1411060",
          "text": "Tom solo escucha punk rock.",
          "translation": "Том слушает только панк-рок.",
          "source": "Tatoeba #1411060 @marcelostockle / #4637347 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1411060",
          "cefr_level": "A1",
          "word_slugs": [
            "rock-noun"
          ]
        },
        {
          "id": "623935",
          "text": "Es conocido como cantante de rock.",
          "translation": "Он известен как рок-певец.",
          "source": "Tatoeba #623935 @clerval / #1591968 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/623935",
          "cefr_level": "A1",
          "word_slugs": [
            "rock-noun"
          ]
        },
        {
          "id": "982855",
          "text": "Elvis Presley fue una estrella de rock.",
          "translation": "Элвис Пресли был рок-звездой.",
          "source": "Tatoeba #982855 @hayastan / #4328809 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/982855",
          "cefr_level": "A1",
          "word_slugs": [
            "rock-noun"
          ]
        },
        {
          "id": "1654657",
          "text": "¿Quién es tu cantante de rock preferido?",
          "translation": "Кто твой любимый рок-певец?",
          "source": "Tatoeba #1654657 @hayastan / #7863297 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1654657",
          "cefr_level": "A1",
          "word_slugs": [
            "rock-noun"
          ]
        },
        {
          "id": "1520844",
          "text": "Tom es una estrella del rock and roll.",
          "translation": "Том — звезда рок-н-ролла.",
          "source": "Tatoeba #1520844 @marcelostockle / #6203097 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1520844",
