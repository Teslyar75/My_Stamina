          ]
        },
        {
          "id": "4916962",
          "text": "Murió en tus brazos.",
          "translation": "Она умерла у тебя на руках.",
          "source": "Tatoeba #4916962 @Shishir / #5171879 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4916962",
          "cefr_level": "A1",
          "word_slugs": [
            "brazos-noun"
          ]
        },
        {
          "id": "6403853",
          "text": "Él cruzó sus brazos.",
          "translation": "Он сложил руки.",
          "source": "Tatoeba #6403853 @ZetKPL / #7813379 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6403853",
          "cefr_level": "A1",
          "word_slugs": [
            "brazos-noun"
          ]
        },
        {
          "id": "4916970",
          "text": "Me duelen los brazos.",
          "translation": "У меня болят руки.",
          "source": "Tatoeba #4916970 @Shishir / #5364300 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4916970",
          "cefr_level": "A1",
