    {
      "slug": "quedar-verb",
      "lemma": "quedar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1290,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to be (as a result of something), to end up",
          "to be situated; to be located (used with only static objects, such as buildings)",
          "to be left; to remain",
          "to fit, to suit; to look good (clothes)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2166426",
          "text": "¿Te querés quedar?",
          "translation": "Ты хочешь остаться?",
          "source": "Tatoeba #2166426 @hayastan / #3297845 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2166426",
          "cefr_level": "A1",
          "word_slugs": [
            "quedar-verb"
          ]
        },
        {
          "id": "2968542",
          "text": "Tom se debe quedar.",
          "translation": "Том должен остаться.",
          "source": "Tatoeba #2968542 @marcelostockle / #2968680 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2968542",
          "cefr_level": "A1",
          "word_slugs": [
            "quedar-verb"
          ]
        },
        {
          "id": "3947930",
          "text": "Te debes quedar aquí.",
          "translation": "Ты должен остаться здесь.",
          "source": "Tatoeba #3947930 @marcelostockle / #3670514 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3947930",
          "cefr_level": "A1",
          "word_slugs": [
            "quedar-verb"
          ]
        },
        {
          "id": "5022228",
          "text": "No puede quedar embarazada.",
          "translation": "Она не может забеременеть.",
          "source": "Tatoeba #5022228 @don_ramon / #5668311 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5022228",
          "cefr_level": "A1",
          "word_slugs": [
            "quedar-verb"
          ]
        },
        {
          "id": "5017287",
          "text": "No quiere quedar embarazada.",
          "translation": "Она не хочет забеременеть.",
          "source": "Tatoeba #5017287 @don_ramon / #5349329 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5017287",
          "cefr_level": "A1",
          "word_slugs": [
            "quedar-verb"
          ]
        }
      ],
