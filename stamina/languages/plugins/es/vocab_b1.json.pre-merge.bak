        {
          "id": "4916961",
          "text": "Murió en sus brazos.",
          "translation": "Он умер у Вас на руках.",
          "source": "Tatoeba #4916961 @Shishir / #5171912 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4916961",
          "cefr_level": "A1",
