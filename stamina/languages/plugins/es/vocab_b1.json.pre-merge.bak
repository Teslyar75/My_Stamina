    {
      "slug": "presencia-noun",
      "lemma": "presencia",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2298,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "presence",
          "appearance, look"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8726459",
          "text": "Él notó mi presencia.",
          "translation": "Он заметил мое присутствие.",
          "source": "Tatoeba #8726459 @gianich73 / #4767669 @stifler86 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8726459",
          "cefr_level": "A1",
          "word_slugs": [
            "presencia-noun"
          ]
        },
        {
          "id": "2182730",
          "text": "Su presencia es vital.",
          "translation": "Ваше присутствие жизненно важно.",
          "source": "Tatoeba #2182730 @babelpoint / #2182178 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2182730",
          "cefr_level": "A1",
          "word_slugs": [
            "presencia-noun"
          ]
        },
        {
          "id": "2756025",
          "text": "Mi presencia parece ser prescindible.",
          "translation": "Мое присутствие, кажется, необязательно.",
          "source": "Tatoeba #2756025 @marcelostockle / #3280103 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2756025",
          "cefr_level": "A1",
          "word_slugs": [
            "presencia-noun"
          ]
        },
        {
          "id": "1181892",
          "text": "Tom espera contar con tu presencia.",
          "translation": "Том рассчитывает на твоё присутствие.",
          "source": "Tatoeba #1181892 @nancy / #4465147 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1181892",
          "cefr_level": "A1",
          "word_slugs": [
            "presencia-noun"
          ]
        },
        {
          "id": "4123787",
          "text": "Su presencia es importante para mí.",
          "translation": "Ваше присутствие для меня важно.",
          "source": "Tatoeba #4123787 @konrad509 / #8026837 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4123787",
