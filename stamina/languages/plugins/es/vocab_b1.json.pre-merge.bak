        ],
        "en": [
          "twenty"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10163212",
          "text": "Tengo veinte años.",
          "translation": "Мне двадцать лет.",
          "source": "Tatoeba #10163212 @Ahha / #6487217 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10163212",
          "cefr_level": "A1",
          "word_slugs": [
            "veinte-num"
          ]
        },
        {
          "id": "4701773",
          "text": "Tiene veinte niños.",
          "translation": "У него двадцать детей.",
          "source": "Tatoeba #4701773 @cueyayotl / #4706825 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4701773",
          "cefr_level": "A1",
          "word_slugs": [
            "veinte-num"
          ]
        },
        {
          "id": "5614665",
          "text": "Él tiene veinte niños.",
