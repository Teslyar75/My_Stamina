          ]
        },
        {
          "id": "2110693",
          "text": "Hola, Susan. ¿Cómo te va?",
          "translation": "Привет, Сьюзан. Как дела?",
          "source": "Tatoeba #2110693 @marcelostockle / #466611 @unholywhale (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2110693",
          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        },
        {
          "id": "1088016",
          "text": "Susan es un nombre inglés.",
          "translation": "Сьюзен — английское имя.",
          "source": "Tatoeba #1088016 @alexmarcelo / #10179975 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1088016",
          "cefr_level": "A1",
          "word_slugs": [
            "susan-name"
          ]
        }
      ],
      "tags": [
