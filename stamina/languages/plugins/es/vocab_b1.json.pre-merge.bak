      "cefr_level": "B1",
      "frequency_rank": 2455,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "interested",
          "acquisitive, grabby",
          "opportunistic"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4433896",
          "text": "Estoy realmente interesado.",
          "translation": "Мне действительно интересно.",
          "source": "Tatoeba #4433896 @pchamorro / #4434805 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4433896",
          "cefr_level": "A1",
          "word_slugs": [
            "interesado-adj"
          ]
        },
        {
          "id": "3013944",
          "text": "Él no estaba interesado.",
          "translation": "Ему не было интересно.",
          "source": "Tatoeba #3013944 @hayastan / #3014542 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3013944",
          "cefr_level": "A1",
          "word_slugs": [
            "interesado-adj"
          ]
        },
        {
          "id": "2993918",
          "text": "Tom no estaba interesado.",
          "translation": "Том не был заинтересован.",
          "source": "Tatoeba #2993918 @marcelostockle / #2994246 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2993918",
          "cefr_level": "A1",
          "word_slugs": [
            "interesado-adj"
          ]
        },
        {
          "id": "13191912",
          "text": "Veo que no estás interesado.",
          "translation": "Я вижу, тебе не интересно.",
          "source": "Tatoeba #13191912 @frpzzd / #12588806 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13191912",
          "cefr_level": "A1",
          "word_slugs": [
            "interesado-adj"
          ]
        },
        {
          "id": "11125484",
          "text": "Él parece interesado en ella.",
          "translation": "Он, похоже, ей интересуется.",
          "source": "Tatoeba #11125484 @iyibirinsan / #13904007 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11125484",
          "cefr_level": "A1",
