    {
      "slug": "podrá-verb",
      "lemma": "podrá",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1450,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular future indicative of poder"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "726068",
          "text": "¡Nadie podrá detenerme!",
          "translation": "Никто не сможет меня остановить!",
          "source": "Tatoeba #726068 @arashi_29 / #6462550 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/726068",
          "cefr_level": "A1",
          "word_slugs": [
            "podrá-verb"
          ]
        },
        {
          "id": "3782707",
          "text": "¿Podrá usted visitarnos?",
          "translation": "Вы бы могли нас навестить?",
          "source": "Tatoeba #3782707 @emigonza / #6113020 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3782707",
          "cefr_level": "A1",
          "word_slugs": [
            "podrá-verb"
          ]
        },
        {
          "id": "1753823",
          "text": "¿Él podrá venir mañana?",
          "translation": "Он сможет прийти завтра?",
          "source": "Tatoeba #1753823 @Shishir / #2110068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1753823",
          "cefr_level": "A1",
          "word_slugs": [
            "podrá-verb"
          ]
        },
        {
          "id": "6634098",
          "text": "Creo que Tom podrá ayudar.",
          "translation": "Я думаю, Том сможет помочь.",
          "source": "Tatoeba #6634098 @UsuarioX / #10336333 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6634098",
          "cefr_level": "A1",
          "word_slugs": [
            "podrá-verb"
          ]
        },
        {
          "id": "963075",
          "text": "¿Podrá él realizar su sueño?",
          "translation": "Он сможет осуществить свою мечту?",
          "source": "Tatoeba #963075 @hundo / #4630293 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/963075",
          "cefr_level": "A1",
          "word_slugs": [
            "podrá-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
