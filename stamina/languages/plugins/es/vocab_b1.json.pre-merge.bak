            "negros-noun"
          ]
        },
        {
          "id": "12919329",
          "text": "Tenemos dos autos negros.",
          "translation": "У нас две чёрные машины.",
          "source": "Tatoeba #12919329 @araneo / #8441674 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12919329",
          "cefr_level": "A1",
          "word_slugs": [
            "negros-noun"
          ]
        },
        {
          "id": "12919319",
          "text": "Tenemos dos coches negros.",
          "translation": "У нас две чёрные машины.",
          "source": "Tatoeba #12919319 @araneo / #8441674 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12919319",
