    {
      "slug": "disparo-noun",
      "lemma": "disparo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2081,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "shot",
          "gunfire, shooting (shooting in the uncountable sense)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2258965",
          "text": "Fue un disparo certero.",
          "translation": "Это был меткий выстрел.",
          "source": "Tatoeba #2258965 @hayastan / #11096541 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2258965",
          "cefr_level": "A1",
          "word_slugs": [
            "disparo-noun"
          ]
        },
        {
          "id": "1658911",
          "text": "De repente oímos un disparo.",
          "translation": "Вдруг мы услышали выстрел.",
          "source": "Tatoeba #1658911 @marcelostockle / #4426580 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1658911",
          "cefr_level": "A1",
          "word_slugs": [
            "disparo-noun"
          ]
        },
        {
          "id": "1285784",
          "text": "Todavía no se sabe cuál policía realizó el disparo.",
          "translation": "Пока неизвестно, кто из полицейских произвёл выстрел.",
          "source": "Tatoeba #1285784 @hayastan / #10032428 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1285784",
          "cefr_level": "A1",
          "word_slugs": [
            "disparo-noun"
          ]
        },
        {
          "id": "1031027",
          "text": "\"¿Quién anda ahí? ¡pare o disparo!\", gritó el centinela.",
          "translation": "«Кто идёт? Стой! Стрелять буду!» — крикнул караульный.",
          "source": "Tatoeba #1031027 @hayastan / #5715197 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1031027",
          "cefr_level": "A1",
          "word_slugs": [
            "disparo-noun"
          ]
        },
        {
          "id": "1999412",
          "text": "Las tres víctimas de disparo están en condición crítica.",
          "translation": "Три жертвы выстрела находятся в критическом состоянии.",
          "source": "Tatoeba #1999412 @marcelostockle / #7578961 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1999412",
          "cefr_level": "A1",
          "word_slugs": [
            "disparo-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "disparo",
        "plural": "",
        "infinitive": ""
      }
    },
