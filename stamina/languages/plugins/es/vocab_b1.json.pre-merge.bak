        {
          "id": "927338",
          "text": "Él a menudo aparece en televisión.",
          "translation": "Он часто появляется на телевидении.",
          "source": "Tatoeba #927338 @mrc3306 / #14045979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/927338",
          "cefr_level": "A1",
          "word_slugs": [
            "aparece-verb"
          ]
        },
        {
          "id": "2417572",
          "text": "Si aparece gangrena habrá que amputar.",
          "translation": "Если появится гангрена, придётся ампутировать.",
          "source": "Tatoeba #2417572 @wallebot / #4239688 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2417572",
          "cefr_level": "A1",
          "word_slugs": [
            "aparece-verb"
          ]
        },
        {
          "id": "971488",
          "text": "Esta palabra no aparece en la lista.",
          "translation": "Этого слова нет в списке.",
          "source": "Tatoeba #971488 @Shishir / #1944494 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/971488",
          "cefr_level": "A1",
          "word_slugs": [
            "aparece-verb"
          ]
        },
        {
          "id": "2769291",
          "text": "Su nombre aparece primero en mi lista.",
          "translation": "Ваше имя у меня в списке стоит первым.",
          "source": "Tatoeba #2769291 @marcelostockle / #2894687 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2769291",
          "cefr_level": "A1",
          "word_slugs": [
            "aparece-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
