    {
      "slug": "hable-verb",
      "lemma": "hable",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1639,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of hablar:",
          "first/third-person singular present subjunctive",
          "inflection of hablar:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3777315",
          "text": "¡Hable más bajo!",
          "translation": "Говорите потише!",
          "source": "Tatoeba #3777315 @Shishir / #3777345 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3777315",
          "cefr_level": "A1",
          "word_slugs": [
            "hable-verb"
          ]
        },
        {
          "id": "2210033",
          "text": "Hable más despacio.",
          "translation": "Говорите помедленнее!",
          "source": "Tatoeba #2210033 @Shishir / #4525614 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2210033",
          "cefr_level": "A1",
          "word_slugs": [
            "hable-verb"
          ]
        },
        {
          "id": "10209183",
          "text": "No hable de eso.",
          "translation": "Не говорите об этом.",
          "source": "Tatoeba #10209183 @DJ_Saidez / #5496899 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10209183",
          "cefr_level": "A1",
          "word_slugs": [
            "hable-verb"
          ]
        },
        {
          "id": "2671302",
          "text": "Por favor, no hable.",
          "translation": "Пожалуйста, не говорите.",
          "source": "Tatoeba #2671302 @Shishir / #2671314 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2671302",
          "cefr_level": "A1",
          "word_slugs": [
            "hable-verb"
          ]
        },
        {
          "id": "867848",
          "text": "Por favor, hable despacio.",
          "translation": "Говорите, пожалуйста, медленно.",
          "source": "Tatoeba #867848 @opor / #903007 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/867848",
          "cefr_level": "A1",
          "word_slugs": [
            "hable-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
