    {
      "slug": "cadáver-noun",
      "lemma": "cadáver",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2090,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "cadaver, corpse"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1459604",
          "text": "¡Sobre mi cadáver!",
          "translation": "Только через мой труп!",
          "source": "Tatoeba #1459604 @marcelostockle / #1585935 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1459604",
          "cefr_level": "A1",
          "word_slugs": [
            "cadáver-noun"
          ]
        },
        {
          "id": "1234482",
          "text": "Es profano desenterrar un cadáver.",
          "translation": "Выкапывать труп — кощунство.",
          "source": "Tatoeba #1234482 @marcelostockle / #5524912 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1234482",
          "cefr_level": "A1",
          "word_slugs": [
            "cadáver-noun"
          ]
        },
        {
          "id": "3104150",
          "text": "¿Cómo lograste meter el cadáver ahí?",
          "translation": "Как тебе удалось запихнуть туда труп?",
          "source": "Tatoeba #3104150 @marcelostockle / #2515761 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3104150",
          "cefr_level": "A1",
          "word_slugs": [
            "cadáver-noun"
          ]
        },
        {
          "id": "1172375",
          "text": "Tom encontró un cadáver en la playa.",
          "translation": "Том обнаружил на пляже труп.",
          "source": "Tatoeba #1172375 @nancy / #2940223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1172375",
          "cefr_level": "A1",
          "word_slugs": [
            "cadáver-noun"
          ]
        },
        {
          "id": "1332070",
          "text": "Todo hombre es un cadáver en potencia.",
          "translation": "Каждый человек - потенциальный труп.",
          "source": "Tatoeba #1332070 @marcelostockle / #3095400 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1332070",
          "cefr_level": "A1",
          "word_slugs": [
            "cadáver-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
