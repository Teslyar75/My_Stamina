          "word_slugs": [
            "lunes-noun"
          ]
        },
        {
          "id": "2311671",
          "text": "¿Hoy es lunes?",
          "translation": "Сегодня понедельник?",
          "source": "Tatoeba #2311671 @hayastan / #3338695 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2311671",
          "cefr_level": "A1",
