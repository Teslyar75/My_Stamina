      "frequency_rank": 2154,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "chocolate (food made from cocoa beans)",
          "hot chocolate (drink made by dissolving chocolate in milk or water)",
          "hashish (the leaves of the Indian hemp plant)",
          "an Aztec drink, chocolātl, made from roasted cacao powder and water"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10092918",
          "text": "Odio el chocolate.",
          "translation": "Я терпеть не могу шоколад.",
          "source": "Tatoeba #10092918 @manufrutos / #12536428 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10092918",
          "cefr_level": "A1",
          "word_slugs": [
            "chocolate-noun"
          ]
        },
        {
          "id": "463181",
          "text": "Ellos comen chocolate.",
          "translation": "Они едят шоколад.",
          "source": "Tatoeba #463181 @lukaszpp / #2400455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/463181",
          "cefr_level": "A1",
          "word_slugs": [
            "chocolate-noun"
          ]
        },
        {
          "id": "1698852",
          "text": "Quisiera chocolate blanco.",
          "translation": "Я бы хотел белого шоколада.",
          "source": "Tatoeba #1698852 @marcelostockle / #7841045 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1698852",
          "cefr_level": "A1",
          "word_slugs": [
            "chocolate-noun"
          ]
        },
        {
          "id": "1236883",
          "text": "Me gusta el chocolate.",
          "translation": "Я люблю шоколад.",
          "source": "Tatoeba #1236883 @Shishir / #749052 @nadya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1236883",
          "cefr_level": "A1",
          "word_slugs": [
            "chocolate-noun"
          ]
        },
        {
          "id": "2049377",
          "text": "Me encanta el chocolate.",
          "translation": "Обожаю шоколад.",
          "source": "Tatoeba #2049377 @Shishir / #5571756 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2049377",
          "cefr_level": "A1",
          "word_slugs": [
            "chocolate-noun"
          ]
        }
