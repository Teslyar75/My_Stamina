    {
      "slug": "pesar-verb",
      "lemma": "pesar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1398,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to weigh (to determine the weight of an object)",
          "to weigh (to have a certain weight)",
          "to ponder",
          "to be serious, to be grave"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4644198",
          "text": "Empezó a pesar de la lluvia.",
          "translation": "Он начал, несмотря на дождь.",
          "source": "Tatoeba #4644198 @Shishir / #8633338 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4644198",
          "cefr_level": "A1",
          "word_slugs": [
            "pesar-verb"
          ]
        },
        {
          "id": "3215626",
          "text": "No puedo, a pesar que quiero.",
          "translation": "Я не могу, хоть и хочу.",
          "source": "Tatoeba #3215626 @marcelostockle / #4066691 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3215626",
          "cefr_level": "A1",
          "word_slugs": [
            "pesar-verb"
          ]
        },
        {
          "id": "2225326",
          "text": "Trabajó a pesar de estar cansado.",
          "translation": "Он работал, несмотря на усталость.",
          "source": "Tatoeba #2225326 @Shishir / #5171156 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2225326",
          "cefr_level": "A1",
          "word_slugs": [
            "pesar-verb"
          ]
        },
        {
          "id": "610382",
          "text": "Lo amo a pesar de sus defectos.",
          "translation": "Люблю его, несмотря на его недостатки.",
          "source": "Tatoeba #610382 @Leono / #1576483 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/610382",
          "cefr_level": "A1",
          "word_slugs": [
            "pesar-verb"
          ]
        },
        {
          "id": "5997141",
          "text": "Tom habría ido a pesar de todo.",
          "translation": "Том бы пошёл в любом случае.",
          "source": "Tatoeba #5997141 @albrusgher / #5997293 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997141",
          "cefr_level": "A1",
          "word_slugs": [
            "pesar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
