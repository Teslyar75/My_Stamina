    {
      "slug": "operación-noun",
      "lemma": "operación",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1456,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "operation (a surgical procedure)",
          "operation (the method or practice by which actions are done)",
          "operation (a procedure for generating a value from one or more other values)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "687531",
          "text": "¿Cuándo es mi operación?",
          "translation": "Когда у меня операция?",
          "source": "Tatoeba #687531 @lukaszpp / #5575723 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/687531",
          "cefr_level": "A1",
          "word_slugs": [
            "operación-noun"
          ]
        },
        {
          "id": "3773791",
          "text": "Murió durante la operación.",
          "translation": "Он умер во время операции.",
          "source": "Tatoeba #3773791 @cueyayotl / #2721990 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3773791",
          "cefr_level": "A1",
          "word_slugs": [
            "operación-noun"
          ]
        },
        {
          "id": "1216497",
          "text": "Mi padre ha mejorado desde la operación.",
          "translation": "Мой отец оправился после операции.",
          "source": "Tatoeba #1216497 @wallebot / #4630385 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1216497",
          "cefr_level": "A1",
          "word_slugs": [
            "operación-noun"
          ]
        },
        {
          "id": "1555783",
          "text": "Tom tuvo una operación a corazón abierto.",
          "translation": "Том перенес операцию на открытом сердце.",
          "source": "Tatoeba #1555783 @hayastan / #4507125 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1555783",
          "cefr_level": "A1",
          "word_slugs": [
            "operación-noun"
          ]
        },
        {
          "id": "1592542",
          "text": "La operación tenía que mantenerse en secreto.",
