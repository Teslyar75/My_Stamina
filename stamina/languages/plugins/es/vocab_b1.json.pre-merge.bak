          "cefr_level": "A1",
          "word_slugs": [
            "hablé-verb"
          ]
        },
        {
          "id": "2173765",
          "text": "Hablé con ella.",
          "translation": "Я поговорил с ней.",
          "source": "Tatoeba #2173765 @Shishir / #2583671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2173765",
          "cefr_level": "A1",
