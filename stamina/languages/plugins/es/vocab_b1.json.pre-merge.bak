    {
      "slug": "recibir-verb",
      "lemma": "recibir",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1753,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to receive, get",
          "to welcome, to greet, to receive (guests, patients)",
          "to receive visitors",
          "to graduate"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5963879",
          "text": "Quiero recibir más.",
          "translation": "Я хочу получить больше.",
          "source": "Tatoeba #5963879 @arh / #5963951 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5963879",
          "cefr_level": "A1",
          "word_slugs": [
            "recibir-verb"
          ]
        },
        {
