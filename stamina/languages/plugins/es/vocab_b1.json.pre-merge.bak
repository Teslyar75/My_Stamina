      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "вера"
        ],
        "en": [
          "faith"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1345062",
          "text": "Tengo fe en ti.",
          "translation": "Я в тебя верю.",
          "source": "Tatoeba #1345062 @marcelostockle / #5693653 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1345062",
          "cefr_level": "A1",
          "word_slugs": [
            "fe-noun"
          ]
        },
        {
          "id": "4033693",
          "text": "Ten fe en Dios.",
          "translation": "Верь в Бога.",
          "source": "Tatoeba #4033693 @mervert1 / #6167553 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4033693",
          "cefr_level": "A1",
          "word_slugs": [
            "fe-noun"
          ]
        },
        {
          "id": "2277658",
          "text": "Tenemos fe en Dios.",
          "translation": "Мы верим в Бога.",
          "source": "Tatoeba #2277658 @hayastan / #6167471 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2277658",
          "cefr_level": "A1",
          "word_slugs": [
            "fe-noun"
          ]
        },
        {
          "id": "400971",
          "text": "La fe mueve montañas.",
          "translation": "Вера свергает горы.",
          "source": "Tatoeba #400971 @catakaoe / #1525477 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/400971",
          "cefr_level": "A1",
          "word_slugs": [
            "fe-noun"
          ]
        },
        {
          "id": "1430411",
          "text": "¡La fe hace milagros!",
          "translation": "Вера творит чудеса!",
          "source": "Tatoeba #1430411 @marcelostockle / #1430401 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1430411",
          "cefr_level": "A1",
          "word_slugs": [
            "fe-noun"
          ]
        }
