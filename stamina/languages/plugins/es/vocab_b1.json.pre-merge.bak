      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "result, outcome, finding, upshot",
          "product, consequence, output",
          "score"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2900899",
          "text": "El resultado es este.",
          "translation": "Результат таков.",
          "source": "Tatoeba #2900899 @hayastan / #6932952 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2900899",
          "cefr_level": "A1",
          "word_slugs": [
            "resultado-noun"
          ]
        },
        {
          "id": "1535517",
          "text": "¿Cuál fue el resultado?",
          "translation": "Каков был результат?",
          "source": "Tatoeba #1535517 @marcelostockle / #4342765 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1535517",
          "cefr_level": "A1",
          "word_slugs": [
            "resultado-noun"
          ]
        },
        {
          "id": "5757169",
          "text": "Ya conocía el resultado.",
          "translation": "Я уже знал результаты.",
