        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10114039",
          "text": "Se convirtió en vagabundo.",
          "translation": "Он стал бродягой.",
          "source": "Tatoeba #10114039 @DJ_Saidez / #12136733 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10114039",
