    {
      "slug": "dueño-noun",
      "lemma": "dueño",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1845,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "owner, proprietor, landlord",
          "master"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2928021",
          "text": "¿El dueño del auto es él?",
          "translation": "Это он владелец машины?",
          "source": "Tatoeba #2928021 @marcelostockle / #2854318 @Shady_arc (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2928021",
          "cefr_level": "A1",
          "word_slugs": [
            "dueño-noun"
          ]
        },
        {
          "id": "1543415",
          "text": "Juan es dueño de una zapatería.",
          "translation": "Хуан — хозяин обувного магазина.",
          "source": "Tatoeba #1543415 @hayastan / #5513230 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1543415",
          "cefr_level": "A1",
          "word_slugs": [
            "dueño-noun"
          ]
        },
        {
          "id": "1527484",
          "text": "El perro va donde va el dueño.",
          "translation": "Собака идёт туда, куда идёт её хозяин.",
          "source": "Tatoeba #1527484 @hayastan / #5098214 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1527484",
          "cefr_level": "A1",
          "word_slugs": [
            "dueño-noun"
          ]
        },
        {
          "id": "10761538",
          "text": "¡El perro se parece a su dueño!",
          "translation": "Собака похожа на хозяина!",
          "source": "Tatoeba #10761538 @Shishir / #10761543 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10761538",
          "cefr_level": "A1",
          "word_slugs": [
            "dueño-noun"
          ]
        },
        {
          "id": "2229886",
          "text": "¿Quién es el dueño de este auto?",
          "translation": "Кто владелец этой машины?",
          "source": "Tatoeba #2229886 @marcelostockle / #2262707 @the_orange (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2229886",
          "cefr_level": "A1",
          "word_slugs": [
            "dueño-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "f",
        "singular": "la dueño",
