    {
      "slug": "acción-noun",
      "lemma": "acción",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1249,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "действие"
        ],
        "en": [
          "action, act, deed (something done)",
          "action (way of motion or functioning)",
          "action (fast-paced activity)",
          "combat, action"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "12401077",
          "text": "Más acción, menos palabras.",
          "translation": "Больше дела, меньше слов.",
          "source": "Tatoeba #12401077 @DJ_Saidez / #14085789 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12401077",
          "cefr_level": "A1",
          "word_slugs": [
            "acción-noun"
          ]
        },
        {
          "id": "1282044",
          "text": "Es un hombre de acción.",
          "translation": "Он - человек действия.",
          "source": "Tatoeba #1282044 @Shishir / #659934 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1282044",
          "cefr_level": "A1",
          "word_slugs": [
            "acción-noun"
          ]
        },
        {
          "id": "2287126",
          "text": "Toda acción tiene sus consecuencias.",
          "translation": "У всякого действия есть свои последствия.",
          "source": "Tatoeba #2287126 @Shishir / #5059308 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2287126",
          "cefr_level": "A1",
          "word_slugs": [
            "acción-noun"
          ]
        },
        {
          "id": "1178773",
          "text": "Su plan fue puesto en acción.",
          "translation": "Его план был приведён в действие.",
          "source": "Tatoeba #1178773 @marcelostockle / #3233147 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1178773",
          "cefr_level": "A1",
          "word_slugs": [
            "acción-noun"
          ]
        },
        {
          "id": "1551479",
          "text": "Thomas es un hombre de acción.",
          "translation": "Том — человек действия.",
          "source": "Tatoeba #1551479 @Shishir / #4353195 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1551479",
          "cefr_level": "A1",
          "word_slugs": [
            "acción-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
