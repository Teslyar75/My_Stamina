    {
      "slug": "golpe-noun",
      "lemma": "golpe",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1283,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "hit, blow, strike",
          "punch, jab",
          "knock (door)",
          "bump, bang, bash (sound of a blow or dull impact)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2114421",
          "text": "Es un golpe bajo.",
          "translation": "Это удар ниже пояса.",
          "source": "Tatoeba #2114421 @Shishir / #3781047 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2114421",
          "cefr_level": "A1",
          "word_slugs": [
            "golpe-noun"
          ]
        },
        {
          "id": "10921612",
          "text": "Tom tuvo un golpe de calor.",
          "translation": "Том получил тепловой удар.",
          "source": "Tatoeba #10921612 @Adelpa / #11161062 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10921612",
          "cefr_level": "A1",
          "word_slugs": [
            "golpe-noun"
          ]
        },
        {
          "id": "434883",
          "text": "Sintió un golpe en el hombro.",
          "translation": "Он ощутил удар по плечу.",
          "source": "Tatoeba #434883 @lukaszpp / #2720805 @Leonid204 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/434883",
          "cefr_level": "A1",
          "word_slugs": [
            "golpe-noun"
          ]
        },
        {
          "id": "1289694",
          "text": "Tom oyó un golpe en la puerta.",
          "translation": "Том услышал стук в дверь.",
          "source": "Tatoeba #1289694 @marcelostockle / #5449449 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1289694",
          "cefr_level": "A1",
          "word_slugs": [
            "golpe-noun"
          ]
        },
        {
          "id": "3235846",
          "text": "Ese golpe a la cabeza lo noqueó.",
          "translation": "Этот удар по голове отправил его в нокаут.",
          "source": "Tatoeba #3235846 @marcelostockle / #3855161 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3235846",
          "cefr_level": "A1",
          "word_slugs": [
            "golpe-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "golpe",
        "plural": "",
        "infinitive": ""
      }
