    {
      "slug": "dejan-verb",
      "lemma": "dejan",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2387,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural present indicative of dejar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8333980",
          "text": "No la dejan en paz.",
          "translation": "Они не оставляют её в покое.",
          "source": "Tatoeba #8333980 @arh / #8348882 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8333980",
          "cefr_level": "A1",
          "word_slugs": [
            "dejan-verb"
          ]
        },
        {
          "id": "6690790",
          "text": "No me dejan ni tomarme un café.",
          "translation": "Мне даже кофе не дают выпить.",
          "source": "Tatoeba #6690790 @arh / #6694857 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6690790",
          "cefr_level": "A1",
          "word_slugs": [
            "dejan-verb"
          ]
        },
        {
          "id": "7564165",
          "text": "A Tom no le dejan comer caramelos.",
          "translation": "Тому не разрешают есть конфеты.",
          "source": "Tatoeba #7564165 @gianich73 / #7564136 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7564165",
          "cefr_level": "A1",
          "word_slugs": [
            "dejan-verb"
          ]
        },
        {
          "id": "10888725",
          "text": "Nuestros padres no dejan que nos veamos.",
          "translation": "Родители не разрешают нам встречаться.",
          "source": "Tatoeba #10888725 @carlosalberto / #10888542 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10888725",
          "cefr_level": "A1",
          "word_slugs": [
            "dejan-verb"
          ]
        },
        {
          "id": "5452645",
          "text": "Al crecer muchas cosas dejan de fascinarnos.",
          "translation": "Когда мы вырастаем, многие вещи перестают приводить нас в восторг.",
          "source": "Tatoeba #5452645 @Seael / #6817412 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452645",
          "cefr_level": "A1",
          "word_slugs": [
            "dejan-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "dejan",
        "plural": "",
        "infinitive": "dejan"
      }
    },
