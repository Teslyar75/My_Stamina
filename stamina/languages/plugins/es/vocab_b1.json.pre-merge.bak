    {
      "slug": "colega-noun",
      "lemma": "colega",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1609,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "colleague",
          "buddy"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1496824",
          "text": "Tom es mi colega.",
          "translation": "Том — мой коллега.",
          "source": "Tatoeba #1496824 @marcelostockle / #2012877 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1496824",
          "cefr_level": "A1",
          "word_slugs": [
            "colega-noun"
          ]
        },
        {
          "id": "1190130",
          "text": "¿Tu colega es americano?",
          "translation": "Твой коллега американец?",
          "source": "Tatoeba #1190130 @marcelostockle / #2197019 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1190130",
          "cefr_level": "A1",
          "word_slugs": [
            "colega-noun"
          ]
        },
        {
          "id": "13418910",
          "text": "Ella es una antigua colega mía.",
          "translation": "Это моя бывшая коллега.",
          "source": "Tatoeba #13418910 @frpzzd / #13418908 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13418910",
          "cefr_level": "A1",
          "word_slugs": [
            "colega-noun"
          ]
        },
        {
          "id": "2032128",
