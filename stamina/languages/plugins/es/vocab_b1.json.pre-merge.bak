    {
      "slug": "llámame-verb",
      "lemma": "llámame",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1824,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular imperative of llamar combined with me"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5769365",
          "text": "Llámame el lunes.",
          "translation": "Позвони мне в понедельник.",
          "source": "Tatoeba #5769365 @arh / #4667490 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5769365",
          "cefr_level": "A1",
          "word_slugs": [
            "llámame-verb"
          ]
        },
        {
          "id": "656877",
          "text": "Llámame si llueve.",
          "translation": "Позвони мне, если пойдет дождь.",
          "source": "Tatoeba #656877 @Shishir / #471913 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/656877",
          "cefr_level": "A1",
          "word_slugs": [
            "llámame-verb"
          ]
        },
        {
          "id": "13265097",
          "text": "Si llueve llámame.",
          "translation": "Если будет дождь, позвони.",
          "source": "Tatoeba #13265097 @Shishir / #13265114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13265097",
          "cefr_level": "A1",
          "word_slugs": [
            "llámame-verb"
          ]
        },
        {
          "id": "580887",
          "text": "Llámame esta tarde.",
          "translation": "Позвони мне сегодня вечером.",
          "source": "Tatoeba #580887 @Shishir / #1271302 @lera (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/580887",
          "cefr_level": "A1",
          "word_slugs": [
            "llámame-verb"
          ]
        },
        {
          "id": "656876",
          "text": "Si llueve, llámame.",
          "translation": "Если пойдёт дождь, позвони мне.",
          "source": "Tatoeba #656876 @Shishir / #6811433 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/656876",
          "cefr_level": "A1",
          "word_slugs": [
            "llámame-verb"
          ]
        }
      ],
      "tags": [
