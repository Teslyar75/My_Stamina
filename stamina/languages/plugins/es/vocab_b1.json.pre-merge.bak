    {
      "slug": "déjeme-verb",
      "lemma": "déjeme",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1621,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular imperative of dejar combined with me"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "510995",
          "text": "¡Déjeme en paz!",
          "translation": "Оставьте меня в покое!",
          "source": "Tatoeba #510995 @darinmex / #2105025 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/510995",
          "cefr_level": "A1",
          "word_slugs": [
            "déjeme-verb"
          ]
        },
        {
          "id": "1673603",
          "text": "Déjeme tratar otra vez.",
          "translation": "Дайте мне попробовать ещё раз.",
          "source": "Tatoeba #1673603 @marcelostockle / #6130452 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1673603",
          "cefr_level": "A1",
          "word_slugs": [
            "déjeme-verb"
          ]
        },
        {
          "id": "2461965",
          "text": "Por favor, déjeme solo.",
          "translation": "Пожалуйста, оставьте меня одного.",
          "source": "Tatoeba #2461965 @Shishir / #2464855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2461965",
          "cefr_level": "A1",
          "word_slugs": [
            "déjeme-verb"
          ]
        },
        {
          "id": "4364165",
          "text": "¡Déjeme pasar, por favor!",
          "translation": "Дайте мне пройти, пожалуйста!",
          "source": "Tatoeba #4364165 @Shishir / #4409194 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4364165",
          "cefr_level": "A1",
          "word_slugs": [
            "déjeme-verb"
          ]
        },
        {
          "id": "2044248",
          "text": "Déjeme echarle un vistazo.",
          "translation": "Позвольте мне взглянуть.",
          "source": "Tatoeba #2044248 @Shishir / #2505434 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2044248",
          "cefr_level": "A1",
          "word_slugs": [
            "déjeme-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "déjeme",
        "plural": "",
        "infinitive": "déjeme"
      }
