            "alice-name"
          ]
        },
        {
          "id": "1545420",
          "text": "Alice es mi madre.",
          "translation": "Алиса - моя мама.",
          "source": "Tatoeba #1545420 @marcelostockle / #1544716 @gleki (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1545420",
          "cefr_level": "A1",
          "word_slugs": [
            "alice-name"
          ]
        },
        {
          "id": "1230827",
          "text": "Alice no vio al perro.",
