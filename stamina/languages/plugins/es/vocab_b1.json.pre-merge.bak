        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4431480",
          "text": "Tiene cien años.",
          "translation": "Ему сто лет.",
          "source": "Tatoeba #4431480 @Shishir / #3443893 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4431480",
          "cefr_level": "A1",
