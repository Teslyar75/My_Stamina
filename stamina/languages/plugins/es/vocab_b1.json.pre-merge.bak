          ]
        },
        {
          "id": "4997732",
          "text": "Ya no me hables.",
          "translation": "Больше со мной не говори.",
          "source": "Tatoeba #4997732 @alexmarcelo / #4999107 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4997732",
          "cefr_level": "A1",
