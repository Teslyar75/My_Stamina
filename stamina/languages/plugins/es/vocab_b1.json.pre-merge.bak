      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1168908",
          "text": "Jimmy es mi hijo adoptivo.",
          "translation": "Джимми — мой приёмный сын.",
          "source": "Tatoeba #1168908 @marcelostockle / #5630340 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1168908",
