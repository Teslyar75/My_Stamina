          ]
        },
        {
          "id": "13559954",
          "text": "No lo dudo en absoluto.",
          "translation": "Я в этом вообще не сомневаюсь.",
          "source": "Tatoeba #13559954 @Seael / #13927143 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13559954",
          "cefr_level": "A1",
