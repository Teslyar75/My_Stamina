    {
      "slug": "paga-noun",
      "lemma": "paga",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1785,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "payment",
          "payoff",
          "salary",
          "allowance (money given to children by their parents)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5056321",
          "text": "¿Quién te paga?",
          "translation": "Кто тебе платит?",
          "source": "Tatoeba #5056321 @don_ramon / #4136459 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5056321",
          "cefr_level": "A1",
          "word_slugs": [
            "paga-noun"
          ]
        },
        {
          "id": "6629535",
          "text": "Nadie aquí paga.",
          "translation": "Тут никто не платит.",
          "source": "Tatoeba #6629535 @Schuager / #7110378 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6629535",
          "cefr_level": "A1",
          "word_slugs": [
            "paga-noun"
          ]
        },
        {
          "id": "2911904",
          "text": "Juan paga alquiler.",
          "translation": "Хуан платит за аренду.",
          "source": "Tatoeba #2911904 @hayastan / #4356452 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2911904",
          "cefr_level": "A1",
          "word_slugs": [
            "paga-noun"
          ]
        },
        {
          "id": "5952231",
          "text": "La paga es buena.",
          "translation": "Платят хорошо.",
          "source": "Tatoeba #5952231 @albrusgher / #8695040 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5952231",
          "cefr_level": "A1",
          "word_slugs": [
            "paga-noun"
          ]
        },
        {
          "id": "3231187",
          "text": "¿Cuánto te paga Tom?",
          "translation": "Сколько Том тебе платит?",
          "source": "Tatoeba #3231187 @Shishir / #3231192 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3231187",
          "cefr_level": "A1",
          "word_slugs": [
            "paga-noun"
          ]
        }
      ],
