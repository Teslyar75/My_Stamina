    {
      "slug": "mensajes-noun",
      "lemma": "mensajes",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2274,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of mensaje"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2709028",
          "text": "Tienes tres mensajes.",
          "translation": "У тебя три сообщения.",
          "source": "Tatoeba #2709028 @Shishir / #2709029 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2709028",
          "cefr_level": "A1",
          "word_slugs": [
            "mensajes-noun"
          ]
        },
        {
          "id": "2699941",
          "text": "Tiene treinta mensajes.",
          "translation": "У Вас тридцать сообщений.",
          "source": "Tatoeba #2699941 @Shishir / #5204037 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2699941",
          "cefr_level": "A1",
          "word_slugs": [
            "mensajes-noun"
          ]
        },
        {
          "id": "1302077",
          "text": "¿Te llegaron los mensajes?",
          "translation": "Тебе дошли сообщения?",
          "source": "Tatoeba #1302077 @hayastan / #4465661 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1302077",
          "cefr_level": "A1",
          "word_slugs": [
            "mensajes-noun"
          ]
        },
        {
          "id": "1406408",
          "text": "Nadie lee los mensajes largos.",
          "translation": "Никто не читает длинных сообщений.",
          "source": "Tatoeba #1406408 @marcelostockle / #3893486 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1406408",
          "cefr_level": "A1",
          "word_slugs": [
            "mensajes-noun"
          ]
        },
        {
          "id": "7726725",
          "text": "He recibido dos mensajes tuyos.",
          "translation": "Я получил от тебя два сообщения.",
          "source": "Tatoeba #7726725 @arh / #7726925 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7726725",
          "cefr_level": "A1",
          "word_slugs": [
            "mensajes-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "mensajes",
