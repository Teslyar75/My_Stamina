    {
      "slug": "bomba-noun",
      "lemma": "bomba",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1292,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "bomb (an explosive device used or intended as a weapon)",
          "pump (a device for moving or compressing a liquid or gas)",
          "adjustable metal slide used to tune brass instruments",
          "lamp globe"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3056556",
          "text": "No encontraron la bomba.",
          "translation": "Они не нашли бомбу.",
          "source": "Tatoeba #3056556 @marcelostockle / #3662791 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3056556",
          "cefr_level": "A1",
          "word_slugs": [
            "bomba-noun"
          ]
        },
        {
          "id": "3073856",
          "text": "¡Hay una bomba a bordo!",
          "translation": "На борту бомба!",
          "source": "Tatoeba #3073856 @cueyayotl / #11487828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3073856",
          "cefr_level": "A1",
          "word_slugs": [
            "bomba-noun"
          ]
        },
        {
          "id": "1834754",
          "text": "Oímos cómo explotaba la bomba.",
          "translation": "Мы слышали, как взорвалась бомба.",
          "source": "Tatoeba #1834754 @Shishir / #443254 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1834754",
          "cefr_level": "A1",
          "word_slugs": [
            "bomba-noun"
          ]
        },
        {
          "id": "5319593",
          "text": "¡Hay una bomba en el avión!",
          "translation": "В самолёте бомба!",
          "source": "Tatoeba #5319593 @Shishir / #5319597 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5319593",
          "cefr_level": "A1",
          "word_slugs": [
            "bomba-noun"
          ]
        },
        {
