        ],
        "en": [
          "web, mesh",
          "net",
          "spiderweb",
          "trap, snare"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "7551345",
          "text": "La araña teje la red.",
          "translation": "Паук плетёт паутину.",
          "source": "Tatoeba #7551345 @baudelaire / #2238559 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7551345",
          "cefr_level": "A1",
          "word_slugs": [
            "red-noun"
          ]
        },
        {
          "id": "3993014",
          "text": "La araña teje una red.",
          "translation": "Паук плетёт паутину.",
          "source": "Tatoeba #3993014 @gianich73 / #2238559 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3993014",
          "cefr_level": "A1",
          "word_slugs": [
            "red-noun"
          ]
        },
        {
          "id": "4571213",
          "text": "Tatoeba no es una red social.",
          "translation": "Татоэба не социальная сеть.",
          "source": "Tatoeba #4571213 @DarkHollow / #4603393 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4571213",
          "cefr_level": "A1",
          "word_slugs": [
            "red-noun"
          ]
        },
        {
          "id": "1135916",
          "text": "El pez se escapó de la red.",
          "translation": "Рыба вырвалась из сети.",
          "source": "Tatoeba #1135916 @Shishir / #3870014 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1135916",
          "cefr_level": "A1",
          "word_slugs": [
            "red-noun"
          ]
        },
        {
          "id": "858669",
          "text": "¡Mándame por la red tu foto hoy!",
          "translation": "Отправь мне сегодня по сети твоё фото.",
          "source": "Tatoeba #858669 @manufrutos / #3632899 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/858669",
          "cefr_level": "A1",
          "word_slugs": [
            "red-noun"
          ]
        }
      ],
