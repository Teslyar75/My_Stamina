      },
      "gender": "m",
      "examples": [
        {
          "id": "8674293",
          "text": "Te dejaré elegir.",
          "translation": "Я дам тебе выбрать.",
          "source": "Tatoeba #8674293 @ajje / #8674527 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8674293",
          "cefr_level": "A1",
          "word_slugs": [
