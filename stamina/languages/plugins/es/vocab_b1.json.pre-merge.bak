      "cefr_level": "B1",
      "frequency_rank": 1924,
      "frequency_band": "cervantes-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1559947",
          "text": "Kate tiene un perro.",
          "translation": "У Кейт есть собака.",
          "source": "Tatoeba #1559947 @Shishir / #1137398 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1559947",
          "cefr_level": "A1",
          "word_slugs": [
            "kate-name"
          ]
        },
        {
          "id": "698917",
          "text": "Jean y Kate son gemelas.",
          "translation": "Джейн и Кейт — близнецы.",
          "source": "Tatoeba #698917 @darinmex / #835417 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/698917",
          "cefr_level": "A1",
          "word_slugs": [
            "kate-name"
          ]
        },
        {
          "id": "2551838",
          "text": "Emily y Kate son amigas.",
          "translation": "Эмили и Кейт - подруги.",
          "source": "Tatoeba #2551838 @ilovegreece / #7451830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2551838",
          "cefr_level": "A1",
          "word_slugs": [
            "kate-name"
          ]
        },
        {
          "id": "1203110",
          "text": "Kate casi no habla chino.",
          "translation": "Кейт почти не говорит по-китайски.",
          "source": "Tatoeba #1203110 @cariito / #4766809 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1203110",
          "cefr_level": "A1",
          "word_slugs": [
            "kate-name"
          ]
        },
        {
          "id": "5017728",
          "text": "Kate está vistiendo a su muñeca.",
          "translation": "Кейт одевает свою куклу.",
          "source": "Tatoeba #5017728 @don_ramon / #5022461 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5017728",
          "cefr_level": "A1",
          "word_slugs": [
