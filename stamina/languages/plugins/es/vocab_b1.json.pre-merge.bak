      "translations": {
        "en": [
          "first-person singular preterite indicative of preguntar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1650270",
          "text": "Yo le pregunté.",
          "translation": "Я его спросил.",
          "source": "Tatoeba #1650270 @marcelostockle / #6138297 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1650270",
          "cefr_level": "A1",
          "word_slugs": [
            "pregunté-verb"
          ]
        },
        {
          "id": "6031426",
          "text": "Yo no pregunté.",
          "translation": "Я не спросил.",
          "source": "Tatoeba #6031426 @albrusgher / #4694137 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6031426",
          "cefr_level": "A1",
          "word_slugs": [
            "pregunté-verb"
          ]
        },
        {
          "id": "1534798",
          "text": "¿Te pregunté algo?",
          "translation": "Я тебя о чём-то спрашивал?",
          "source": "Tatoeba #1534798 @alexmarcelo / #7043029 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1534798",
          "cefr_level": "A1",
          "word_slugs": [
            "pregunté-verb"
          ]
        },
        {
          "id": "2075082",
          "text": "Le pregunté a Tom.",
          "translation": "Я спросил Тома.",
          "source": "Tatoeba #2075082 @Shishir / #5672522 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2075082",
          "cefr_level": "A1",
          "word_slugs": [
            "pregunté-verb"
          ]
        },
        {
          "id": "5920611",
          "text": "Le pregunté dónde vive.",
          "translation": "Я спросил его, где он живет.",
          "source": "Tatoeba #5920611 @baudelaire / #875065 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5920611",
          "cefr_level": "A1",
          "word_slugs": [
            "pregunté-verb"
          ]
        }
      ],
