    {
      "slug": "conseguiste-verb",
      "lemma": "conseguiste",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2497,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular preterite indicative of conseguir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5305337",
          "text": "¿Dónde conseguiste esto?",
          "translation": "Где ты это раздобыл?",
          "source": "Tatoeba #5305337 @ulymarrero / #2555177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5305337",
          "cefr_level": "A1",
          "word_slugs": [
