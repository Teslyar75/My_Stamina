    {
      "slug": "sonido-noun",
      "lemma": "sonido",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1540,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "sound, noise",
          "tone"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1669656",
          "text": "¿Cuándo oyeron el sonido?",
          "translation": "Когда они услышали звук?",
          "source": "Tatoeba #1669656 @alexmarcelo / #5155277 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1669656",
          "cefr_level": "A1",
          "word_slugs": [
            "sonido-noun"
          ]
        },
        {
          "id": "3302491",
          "text": "¡No emita ni un sonido!",
          "translation": "Не издавайте ни звука!",
          "source": "Tatoeba #3302491 @gianich73 / #2804724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3302491",
          "cefr_level": "A1",
          "word_slugs": [
            "sonido-noun"
          ]
        },
        {
          "id": "1442225",
          "text": "¿Qué sonido hacen las ovejas?",
          "translation": "Какой звук издают овцы?",
          "source": "Tatoeba #1442225 @marcelostockle / #1443986 @chispa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1442225",
          "cefr_level": "A1",
          "word_slugs": [
            "sonido-noun"
          ]
        },
        {
          "id": "3463329",
          "text": "El sonido era prácticamente imperceptible.",
          "translation": "Звук был практически неразличим.",
          "source": "Tatoeba #3463329 @hayastan / #3463341 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3463329",
          "cefr_level": "A1",
          "word_slugs": [
            "sonido-noun"
          ]
        },
        {
          "id": "1107357",
          "text": "Me gusta el sonido del piano.",
          "translation": "Мне нравится, как звучит пианино.",
          "source": "Tatoeba #1107357 @alexmarcelo / #14075028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1107357",
          "cefr_level": "A1",
          "word_slugs": [
            "sonido-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
