          "go-back"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2447385",
          "text": "¡Dejá de dar vueltas y respondé mi pregunta!",
          "translation": "Перестань ходить вокруг да около и ответь на мой вопрос!",
          "source": "Tatoeba #2447385 @hayastan / #4905981 @venticello (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2447385",
          "cefr_level": "A1",
          "word_slugs": [
            "vueltas-noun"
          ]
        },
        {
          "id": "5035708",
          "text": "Dejá de dar vueltas y andá al grano por favor.",
          "translation": "Перестань ходить вокруг да около и переходи к сути, пожалуйста.",
          "source": "Tatoeba #5035708 @don_ramon / #5590343 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5035708",
          "cefr_level": "A1",
