    {
      "slug": "bruja-noun",
      "lemma": "bruja",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2490,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "witch, sorceress (woman who practices witchcraft)",
          "specifically, a Wiccan",
          "crone, hag (ugly, evil-looking, or frightening old woman)",
          "owl (bird of prey of the order Strigiformes)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12927441",
          "text": "Soy una bruja.",
          "translation": "Я ведьма.",
          "source": "Tatoeba #12927441 @araneo / #12927427 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12927441",
          "cefr_level": "A1",
