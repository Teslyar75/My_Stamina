          ]
        },
        {
          "id": "7304604",
          "text": "¿Puedes arreglar mi computadora?",
          "translation": "Можешь починить мой компьютер?",
          "source": "Tatoeba #7304604 @UsuarioX / #3451482 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7304604",
          "cefr_level": "A1",
          "word_slugs": [
