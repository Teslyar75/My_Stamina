    {
      "slug": "viven-verb",
      "lemma": "viven",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2369,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of vivar:",
          "third-person plural present subjunctive",
          "inflection of vivar:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11251034",
          "text": "No viven aquí.",
          "translation": "Они тут не живут.",
          "source": "Tatoeba #11251034 @Masatami / #11251010 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11251034",
          "cefr_level": "A1",
          "word_slugs": [
            "viven-verb"
          ]
        },
        {
          "id": "1089104",
          "text": "Sé dónde viven.",
          "translation": "Я знаю, где они живут.",
          "source": "Tatoeba #1089104 @Shishir / #1435059 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1089104",
          "cefr_level": "A1",
          "word_slugs": [
            "viven-verb"
          ]
        },
        {
          "id": "1284286",
          "text": "Ellos viven allí.",
          "translation": "Они живут там.",
          "source": "Tatoeba #1284286 @marcelostockle / #3419668 @Ars (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1284286",
          "cefr_level": "A1",
          "word_slugs": [
            "viven-verb"
          ]
        },
        {
          "id": "1701655",
          "text": "¿Con quién viven?",
          "translation": "С кем вы живёте?",
          "source": "Tatoeba #1701655 @marcelostockle / #11274440 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1701655",
          "cefr_level": "A1",
          "word_slugs": [
            "viven-verb"
          ]
        },
        {
          "id": "12028695",
          "text": "Viven en Londres.",
          "translation": "Они живут в Лондоне.",
          "source": "Tatoeba #12028695 @JSKabylie15 / #3278658 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12028695",
          "cefr_level": "A1",
          "word_slugs": [
            "viven-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "viven",
        "plural": "",
        "infinitive": "viven"
      }
    },
    {
      "slug": "huesos-noun",
      "lemma": "huesos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2370,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of hueso"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6102212",
          "text": "Estos son huesos humanos.",
          "translation": "Это человеческие кости.",
          "source": "Tatoeba #6102212 @hayastan / #7666017 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6102212",
          "cefr_level": "A1",
          "word_slugs": [
            "huesos-noun"
          ]
        },
        {
          "id": "1642745",
          "text": "Me duelen todos los huesos.",
          "translation": "У меня все кости болят.",
          "source": "Tatoeba #1642745 @marcelostockle / #6332052 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1642745",
          "cefr_level": "A1",
          "word_slugs": [
            "huesos-noun"
          ]
        },
        {
          "id": "1127780",
          "text": "¡No le eches huesos al perro!",
          "translation": "Не бросай собаке кости!",
          "source": "Tatoeba #1127780 @alexmarcelo / #4541225 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1127780",
          "cefr_level": "A1",
          "word_slugs": [
            "huesos-noun"
          ]
        },
        {
          "id": "3038040",
          "text": "Tom se empapó hasta los huesos.",
          "translation": "Том промок до костей.",
          "source": "Tatoeba #3038040 @ecorralest101 / #3030931 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3038040",
          "cefr_level": "A1",
          "word_slugs": [
            "huesos-noun"
          ]
        },
        {
          "id": "1512815",
          "text": "El cráneo humano consiste de 23 huesos.",
          "translation": "Череп человека состоит из двадцати трёх костей.",
          "source": "Tatoeba #1512815 @marcelostockle / #1511995 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1512815",
          "cefr_level": "A1",
          "word_slugs": [
            "huesos-noun"
          ]
        }
