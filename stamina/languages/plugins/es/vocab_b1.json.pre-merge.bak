    {
      "slug": "construir-verb",
      "lemma": "construir",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2252,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to build",
          "to construct"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2399098",
          "text": "Me gusta construir puentes.",
          "translation": "Я люблю строить мосты.",
          "source": "Tatoeba #2399098 @marcelostockle / #6563331 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2399098",
          "cefr_level": "A1",
          "word_slugs": [
            "construir-verb"
          ]
        },
        {
          "id": "10790080",
          "text": "Quiero construir mi propia casa.",
          "translation": "Я хочу построить собственный дом.",
          "source": "Tatoeba #10790080 @megamanenm / #10976184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790080",
          "cefr_level": "A1",
          "word_slugs": [
            "construir-verb"
          ]
        },
        {
          "id": "9360334",
          "text": "Voy a construir edificios en Italia.",
          "translation": "Я буду строить здания в Италии.",
          "source": "Tatoeba #9360334 @ignacio / #9392951 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9360334",
          "cefr_level": "A1",
          "word_slugs": [
            "construir-verb"
          ]
        },
        {
          "id": "1033651",
          "text": "Fueron acusados ​​de construir bombas caseras.",
          "translation": "Их обвинили в изготовлении самодельных бомб.",
          "source": "Tatoeba #1033651 @hayastan / #7927650 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1033651",
          "cefr_level": "A1",
          "word_slugs": [
            "construir-verb"
          ]
        },
        {
          "id": "8636902",
          "text": "Él dice que quiere construir una casa.",
          "translation": "Он говорит, что хочет построить дом.",
          "source": "Tatoeba #8636902 @pcarolina / #9464508 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636902",
          "cefr_level": "A1",
          "word_slugs": [
            "construir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
