    {
      "slug": "descubierto-adj",
      "lemma": "descubierto",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2483,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "discovered"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1684347",
          "text": "¡He descubierto todo!",
          "translation": "Я всё разузнал!",
          "source": "Tatoeba #1684347 @marcelostockle / #6829838 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684347",
          "cefr_level": "A1",
          "word_slugs": [
            "descubierto-adj"
          ]
        },
        {
          "id": "723872",
          "text": "Hemos descubierto dónde vive.",
          "translation": "Мы выяснили, где он живёт.",
          "source": "Tatoeba #723872 @Shishir / #3505088 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/723872",
          "cefr_level": "A1",
          "word_slugs": [
            "descubierto-adj"
          ]
        },
        {
          "id": "1623575",
          "text": "¡He descubierto algo asombroso!",
          "translation": "Я обнаружил кое-что удивительное!",
          "source": "Tatoeba #1623575 @teskmon / #6140915 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1623575",
          "cefr_level": "A1",
          "word_slugs": [
            "descubierto-adj"
          ]
        },
        {
          "id": "2177141",
          "text": "He descubierto que es mi padre adoptivo.",
          "translation": "Я узнал, что он мой приёмный отец.",
          "source": "Tatoeba #2177141 @Shishir / #5042545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2177141",
          "cefr_level": "A1",
          "word_slugs": [
            "descubierto-adj"
          ]
        },
        {
          "id": "13405671",
          "text": "Hasta ahora no se ha descubierto nada más.",
          "translation": "Больше ничего пока узнать не удалось.",
          "source": "Tatoeba #13405671 @carlosalberto / #13405635 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13405671",
          "cefr_level": "A1",
          "word_slugs": [
            "descubierto-adj"
          ]
        }
      ],
