    {
      "slug": "acto-noun",
      "lemma": "acto",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1994,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "акт"
        ],
        "en": [
          "act (something done)",
          "act",
          "ceremony, function"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4066417",
          "text": "Su donación es un acto de amor.",
          "translation": "Ваше пожертвование — это акт любви.",
          "source": "Tatoeba #4066417 @hayastan / #4092674 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4066417",
          "cefr_level": "A1",
          "word_slugs": [
            "acto-noun"
          ]
        },
        {
          "id": "2898193",
          "text": "Donar sangre es un acto de amor.",
          "translation": "Давать свою кровь — жест любви.",
          "source": "Tatoeba #2898193 @hayastan / #4380611 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2898193",
          "cefr_level": "A1",
          "word_slugs": [
            "acto-noun"
          ]
        },
        {
          "id": "2259460",
          "text": "Ahora va a empezar el tercer acto.",
          "translation": "Сейчас начнётся третий акт.",
          "source": "Tatoeba #2259460 @hayastan / #5533514 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259460",
          "cefr_level": "A1",
          "word_slugs": [
            "acto-noun"
          ]
        },
        {
          "id": "2504937",
          "text": "La justificación es peor que el acto.",
          "translation": "Оправдание хуже самого поступка.",
          "source": "Tatoeba #2504937 @marcelostockle / #3391154 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2504937",
          "cefr_level": "A1",
          "word_slugs": [
            "acto-noun"
          ]
        },
        {
          "id": "5902370",
          "text": "El aborto me parece un acto abominable.",
          "translation": "Аборт мне кажется отвратительным поступком.",
          "source": "Tatoeba #5902370 @arh / #6107600 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5902370",
          "cefr_level": "A1",
          "word_slugs": [
            "acto-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el acto",
        "plural": "",
        "infinitive": ""
      }
