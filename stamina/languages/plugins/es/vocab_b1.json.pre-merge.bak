          "page"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "803636",
          "text": "Falta una página.",
          "translation": "Не хватает страницы.",
          "source": "Tatoeba #803636 @Munia / #1877870 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/803636",
          "cefr_level": "A1",
          "word_slugs": [
            "página-noun"
          ]
        },
        {
          "id": "1615444",
          "text": "Da vuelta la página.",
          "translation": "Переверни страницу.",
          "source": "Tatoeba #1615444 @alexmarcelo / #3006478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1615444",
          "cefr_level": "A1",
          "word_slugs": [
            "página-noun"
          ]
        },
        {
          "id": "4718870",
          "text": "¿En qué página estás?",
          "translation": "На какой ты странице?",
          "source": "Tatoeba #4718870 @Shishir / #3525049 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4718870",
          "cefr_level": "A1",
          "word_slugs": [
            "página-noun"
          ]
        },
        {
          "id": "1441735",
          "text": "Empecemos en la página 30.",
          "translation": "Начнем со страницы тридцать.",
          "source": "Tatoeba #1441735 @Shishir / #1442099 @chispa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1441735",
          "cefr_level": "A1",
          "word_slugs": [
            "página-noun"
          ]
        },
        {
          "id": "2112306",
          "text": "Y esta es mi página.",
          "translation": "А это моя страница.",
          "source": "Tatoeba #2112306 @marcelostockle / #6915626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2112306",
          "cefr_level": "A1",
          "word_slugs": [
            "página-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "página",
        "plural": "",
        "infinitive": ""
      }
