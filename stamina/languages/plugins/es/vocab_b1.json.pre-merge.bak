    {
      "slug": "entera-adj",
      "lemma": "entera",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2197,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "feminine singular of entero"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1293106",
          "text": "Bailamos la noche entera.",
          "translation": "Мы танцевали всю ночь.",
          "source": "Tatoeba #1293106 @hayastan / #4487985 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1293106",
          "cefr_level": "A1",
          "word_slugs": [
            "entera-adj"
          ]
        },
        {
          "id": "2530491",
          "text": "Tú eres mi vida entera.",
          "translation": "Ты - вся моя жизнь.",
          "source": "Tatoeba #2530491 @marcelostockle / #4363758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2530491",
          "cefr_level": "A1",
          "word_slugs": [
            "entera-adj"
          ]
        },
        {
          "id": "2141167",
          "text": "Su familia entera es así.",
          "translation": "Вся его семья такая.",
          "source": "Tatoeba #2141167 @marcelostockle / #5658081 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2141167",
          "cefr_level": "A1",
          "word_slugs": [
            "entera-adj"
          ]
        },
        {
          "id": "1122621",
          "text": "He comido una vaca entera.",
          "translation": "Я съел целую корову.",
          "source": "Tatoeba #1122621 @alexmarcelo / #5341924 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1122621",
          "cefr_level": "A1",
          "word_slugs": [
            "entera-adj"
          ]
        },
        {
          "id": "2297037",
          "text": "Decidí estudiar la noche entera.",
