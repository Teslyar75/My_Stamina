    {
      "slug": "venía-verb",
      "lemma": "venía",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2486,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect indicative of venir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2589",
          "text": "No sabía de dónde venía eso.",
          "translation": "Я не знал, откуда это пришло.",
          "source": "Tatoeba #2589 @Raimondi / #5517 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2589",
          "cefr_level": "A1",
          "word_slugs": [
            "venía-verb"
          ]
        },
        {
          "id": "3101192",
          "text": "El bote venía equipado con radar.",
          "translation": "Лодка была оснащена радаром.",
          "source": "Tatoeba #3101192 @marcelostockle / #2195371 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3101192",
          "cefr_level": "A1",
          "word_slugs": [
            "venía-verb"
          ]
        },
        {
          "id": "2225303",
          "text": "Quería saber de dónde venía la voz.",
          "translation": "Она хотела знать, откуда идёт голос.",
          "source": "Tatoeba #2225303 @Shishir / #4584080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2225303",
          "cefr_level": "A1",
          "word_slugs": [
            "venía-verb"
          ]
        },
        {
          "id": "2707903",
          "text": "Él se perdió cuando venía para acá.",
          "translation": "Он потерялся, когда шёл сюда.",
          "source": "Tatoeba #2707903 @nancy / #2708139 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2707903",
          "cefr_level": "A1",
          "word_slugs": [
            "venía-verb"
          ]
        },
        {
          "id": "1906708",
          "text": "Mi hija venía a verme con frecuencia.",
          "translation": "Дочь меня иногда навещала.",
          "source": "Tatoeba #1906708 @Shishir / #8040901 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1906708",
          "cefr_level": "A1",
          "word_slugs": [
            "venía-verb"
          ]
        }
      ],
