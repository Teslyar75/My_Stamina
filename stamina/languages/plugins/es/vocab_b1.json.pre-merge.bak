    {
      "slug": "ritmo-noun",
      "lemma": "ritmo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2373,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "rhythm",
          "pace"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2039312",
          "text": "Hagámoslo a nuestro propio ritmo, sin apresurarnos.",
          "translation": "Давайте сделаем это в удобном для нас темпе без спешки.",
          "source": "Tatoeba #2039312 @Shishir / #3537810 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2039312",
          "cefr_level": "A1",
          "word_slugs": [
            "ritmo-noun"
          ]
        },
        {
          "id": "11862927",
          "text": "A este ritmo no vamos a acabar nunca.",
          "translation": "Такими темпами мы никогда не закончим.",
          "source": "Tatoeba #11862927 @Seael / #11862976 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11862927",
          "cefr_level": "A1",
          "word_slugs": [
            "ritmo-noun"
          ]
        },
        {
          "id": "1701688",
          "text": "Me gusta el ritmo lento de esta canción.",
          "translation": "Мне нравится медленный ритм этой песни.",
          "source": "Tatoeba #1701688 @marcelostockle / #3292465 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1701688",
          "cefr_level": "A1",
          "word_slugs": [
            "ritmo-noun"
          ]
        },
        {
          "id": "2615512",
          "text": "No pude correr lo suficientemente rápido para seguirles el ritmo.",
          "translation": "Я не мог бежать достаточно быстро, чтобы не отставать от них.",
          "source": "Tatoeba #2615512 @teskmon / #2615520 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2615512",
          "cefr_level": "A1",
          "word_slugs": [
            "ritmo-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "ritmo",
        "plural": "",
        "infinitive": ""
      }
    },
