          ]
        },
        {
          "id": "5046166",
          "text": "¿Tengo que elegir?",
          "translation": "Мне надо выбрать?",
          "source": "Tatoeba #5046166 @don_ramon / #5052475 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5046166",
          "cefr_level": "A1",
