    {
      "slug": "íbamos-verb",
      "lemma": "íbamos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2104,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person plural imperfect indicative of ir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2494992",
          "text": "No íbamos a hacer eso.",
          "translation": "Мы не собирались делать это.",
          "source": "Tatoeba #2494992 @Amastan / #2494997 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2494992",
          "cefr_level": "A1",
          "word_slugs": [
            "íbamos-verb"
          ]
        },
        {
          "id": "2130643",
          "text": "Pensé que íbamos a ganar.",
          "translation": "Я думал, что мы победим.",
          "source": "Tatoeba #2130643 @marcelostockle / #2564690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2130643",
          "cefr_level": "A1",
          "word_slugs": [
            "íbamos-verb"
          ]
        },
        {
          "id": "2162962",
          "text": "Pensé que íbamos a hablar.",
          "translation": "Я думал, мы поговорим.",
          "source": "Tatoeba #2162962 @hayastan / #7797586 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2162962",
          "cefr_level": "A1",
          "word_slugs": [
            "íbamos-verb"
          ]
        },
        {
          "id": "4296710",
          "text": "¿Quién dijo que íbamos a morir?",
          "translation": "Кто сказал, что мы умрём?",
          "source": "Tatoeba #4296710 @DarkHollow / #2900062 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4296710",
          "cefr_level": "A1",
          "word_slugs": [
            "íbamos-verb"
          ]
        },
        {
          "id": "2130645",
          "text": "Pensé que íbamos a jugar béisbol.",
          "translation": "Я думал, мы будем играть в бейсбол.",
          "source": "Tatoeba #2130645 @marcelostockle / #13467811 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2130645",
          "cefr_level": "A1",
          "word_slugs": [
            "íbamos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "íbamos",
        "plural": "",
        "infinitive": "íbamos"
      }
