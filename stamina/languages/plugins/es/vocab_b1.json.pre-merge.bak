    {
      "slug": "decirles-verb",
      "lemma": "decirles",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2201,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of decir combined with les"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2041628",
          "text": "Queremos decirles algo.",
          "translation": "Мы хотим вам кое-что сказать.",
          "source": "Tatoeba #2041628 @marcelostockle / #6593960 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2041628",
          "cefr_level": "A1",
          "word_slugs": [
            "decirles-verb"
          ]
        },
        {
          "id": "1731703",
          "text": "Déjenme decirles una cosa.",
          "translation": "Позвольте мне сказать вам одну вещь.",
          "source": "Tatoeba #1731703 @marcelostockle / #8217714 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1731703",
          "cefr_level": "A1",
          "word_slugs": [
            "decirles-verb"
          ]
        },
        {
          "id": "4096394",
          "text": "Tengo que decirles una cosa.",
          "translation": "Я должен сказать вам одну вещь.",
          "source": "Tatoeba #4096394 @gianich73 / #4096241 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4096394",
          "cefr_level": "A1",
          "word_slugs": [
            "decirles-verb"
          ]
        },
        {
          "id": "3277405",
          "text": "Tenemos que decirles una cosa.",
          "translation": "Нам надо сказать им одну вещь.",
