          ]
        },
        {
          "id": "2847862",
          "text": "La cantante extranjera cantó precioso.",
          "translation": "Иностранная певица пела красиво.",
          "source": "Tatoeba #2847862 @marcelostockle / #2848143 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2847862",
          "cefr_level": "A1",
