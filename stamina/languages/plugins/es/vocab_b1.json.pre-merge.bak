        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1684091",
          "text": "Súbete al techo.",
          "translation": "Заберись на крышу.",
          "source": "Tatoeba #1684091 @marcelostockle / #4508679 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684091",
          "cefr_level": "A1",
          "word_slugs": [
