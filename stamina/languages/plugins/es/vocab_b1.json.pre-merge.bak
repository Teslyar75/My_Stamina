    {
      "slug": "necesitaba-verb",
      "lemma": "necesitaba",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1204,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect indicative of necesitar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2429314",
          "text": "Tom nos necesitaba.",
          "translation": "Мы были нужны Тому.",
          "source": "Tatoeba #2429314 @hayastan / #3056133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2429314",
          "cefr_level": "A1",
          "word_slugs": [
            "necesitaba-verb"
          ]
        },
        {
          "id": "5292246",
          "text": "Ayer lo necesitaba.",
          "translation": "Вчера он был мне нужен.",
          "source": "Tatoeba #5292246 @Shishir / #7488167 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5292246",
          "cefr_level": "A1",
          "word_slugs": [
            "necesitaba-verb"
          ]
        },
        {
          "id": "9832408",
          "text": "Mary te necesitaba.",
          "translation": "Ты был нужен Мэри.",
          "source": "Tatoeba #9832408 @Shishir / #7893786 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9832408",
          "cefr_level": "A1",
          "word_slugs": [
            "necesitaba-verb"
          ]
        },
        {
          "id": "9432174",
          "text": "Tom necesitaba agua.",
          "translation": "Тому нужна была вода.",
          "source": "Tatoeba #9432174 @ignacio / #3056132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9432174",
          "cefr_level": "A1",
          "word_slugs": [
            "necesitaba-verb"
          ]
        },
        {
          "id": "2429316",
          "text": "Tom necesitaba ayuda.",
          "translation": "Тому нужна была помощь.",
          "source": "Tatoeba #2429316 @hayastan / #3056142 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2429316",
          "cefr_level": "A1",
          "word_slugs": [
            "necesitaba-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
