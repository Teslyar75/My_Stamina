          "first-person singular present indicative of dudar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4323760",
          "text": "Dudo que llueva.",
          "translation": "Сомневаюсь, что будет дождь.",
          "source": "Tatoeba #4323760 @mervert1 / #2760832 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4323760",
          "cefr_level": "A1",
