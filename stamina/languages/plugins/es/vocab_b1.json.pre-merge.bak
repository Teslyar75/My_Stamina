    {
      "slug": "acabamos-verb",
      "lemma": "acabamos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2289,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person plural present/preterite indicative of acabar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2074810",
          "text": "Acabamos de empezar.",
          "translation": "Мы только начали.",
          "source": "Tatoeba #2074810 @Shishir / #2525707 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2074810",
          "cefr_level": "A1",
          "word_slugs": [
            "acabamos-verb"
          ]
        },
        {
          "id": "2874603",
          "text": "Tom y yo acabamos de conocernos.",
          "translation": "Мы с Томом только что познакомились.",
          "source": "Tatoeba #2874603 @nancy / #2875322 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2874603",
          "cefr_level": "A1",
          "word_slugs": [
            "acabamos-verb"
          ]
        },
        {
          "id": "2415740",
          "text": "Acabamos de llegar a la estación.",
          "translation": "Мы только что приехали на вокзал.",
          "source": "Tatoeba #2415740 @Shishir / #4570238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2415740",
          "cefr_level": "A1",
          "word_slugs": [
            "acabamos-verb"
          ]
        },
        {
          "id": "1606856",
          "text": "Acabamos de recibir un nuevo modelo.",
          "translation": "Мы только что получили новую модель.",
          "source": "Tatoeba #1606856 @hayastan / #4347944 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1606856",
          "cefr_level": "A1",
          "word_slugs": [
            "acabamos-verb"
          ]
        },
        {
          "id": "1939830",
          "text": "Nos acabamos de encontrar en el pasillo.",
          "translation": "Мы только что встретились в коридоре.",
          "source": "Tatoeba #1939830 @marcelostockle / #10780666 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1939830",
          "cefr_level": "A1",
          "word_slugs": [
            "acabamos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
