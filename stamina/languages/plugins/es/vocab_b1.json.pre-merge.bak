      "gender": null,
      "examples": [
        {
          "id": "5872584",
          "text": "¿Qué son esos números?",
          "translation": "Что это за номера?",
          "source": "Tatoeba #5872584 @baudelaire / #5911071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5872584",
          "cefr_level": "A1",
          "word_slugs": [
            "números-name"
          ]
        },
        {
          "id": "7679341",
          "text": "Estoy en números rojos.",
          "translation": "Я по уши в долгах.",
          "source": "Tatoeba #7679341 @arh / #1937164 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7679341",
          "cefr_level": "A1",
          "word_slugs": [
            "números-name"
          ]
        },
        {
          "id": "3216313",
          "text": "2, 4 y 6 son números pares.",
          "translation": "2,4 и 6 — чётные числа.",
          "source": "Tatoeba #3216313 @cueyayotl / #6323609 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3216313",
          "cefr_level": "A1",
