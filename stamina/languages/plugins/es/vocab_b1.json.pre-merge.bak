    {
      "slug": "huevos-noun",
      "lemma": "huevos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1705,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of huevo",
          "guts, balls (courage, bravery)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5974984",
          "text": "Ayer comí huevos.",
          "translation": "Вчера я ел яйца.",
          "source": "Tatoeba #5974984 @diegohn / #6982099 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5974984",
          "cefr_level": "A1",
          "word_slugs": [
            "huevos-noun"
          ]
        },
        {
          "id": "5845157",
          "text": "¡Bájale de huevos!",
          "translation": "Остынь!",
          "source": "Tatoeba #5845157 @ecorralest101 / #2069722 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845157",
          "cefr_level": "A1",
          "word_slugs": [
            "huevos-noun"
          ]
        },
        {
          "id": "10275058",
          "text": "Herví unos huevos.",
          "translation": "Я сварил несколько яиц.",
          "source": "Tatoeba #10275058 @Seael / #12183846 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10275058",
          "cefr_level": "A1",
          "word_slugs": [
            "huevos-noun"
          ]
        },
        {
          "id": "3623432",
          "text": "Tenemos seis huevos.",
          "translation": "У нас шесть яиц.",
          "source": "Tatoeba #3623432 @SrTortuga / #4690675 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3623432",
          "cefr_level": "A1",
          "word_slugs": [
            "huevos-noun"
          ]
        },
        {
          "id": "1288616",
          "text": "¿Comés huevos fritos?",
          "translation": "Ты ешь яичницу?",
          "source": "Tatoeba #1288616 @hayastan / #2757463 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1288616",
          "cefr_level": "A1",
          "word_slugs": [
            "huevos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
