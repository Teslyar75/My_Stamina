    {
      "slug": "riesgo-noun",
      "lemma": "riesgo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1546,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "risk; the possibility of harm or an unfavorable outcome from random chance"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9453315",
          "text": "Acepto el riesgo.",
          "translation": "Я иду на риск.",
          "source": "Tatoeba #9453315 @eltacodemex / #9615370 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9453315",
          "cefr_level": "A1",
          "word_slugs": [
            "riesgo-noun"
          ]
        },
        {
          "id": "9453314",
          "text": "Acepto tomar el riesgo.",
          "translation": "Я иду на риск.",
          "source": "Tatoeba #9453314 @eltacodemex / #9615370 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9453314",
          "cefr_level": "A1",
          "word_slugs": [
            "riesgo-noun"
          ]
        },
        {
          "id": "6874970",
          "text": "Estamos en grave riesgo.",
          "translation": "Мы подвергаем себя большому риску.",
          "source": "Tatoeba #6874970 @arh / #6875713 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6874970",
          "cefr_level": "A1",
          "word_slugs": [
            "riesgo-noun"
          ]
        },
        {
          "id": "2725312",
          "text": "Has corrido un gran riesgo.",
          "translation": "Ты сильно рисковал.",
          "source": "Tatoeba #2725312 @Shishir / #6316191 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2725312",
          "cefr_level": "A1",
          "word_slugs": [
            "riesgo-noun"
          ]
        },
        {
          "id": "1355868",
          "text": "Tomé el riesgo de aconsejarla.",
