      "cefr_level": "B1",
      "frequency_rank": 2339,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "surgery"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1252059",
          "text": "¿Ayudará la cirugía?",
          "translation": "Операция поможет?",
          "source": "Tatoeba #1252059 @Hohen / #3531782 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1252059",
          "cefr_level": "A1",
          "word_slugs": [
            "cirugía-noun"
          ]
        },
        {
          "id": "4433949",
          "text": "Recientemente tuve cirugía.",
          "translation": "Я недавно перенёс операцию.",
          "source": "Tatoeba #4433949 @pchamorro / #4434788 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4433949",
          "cefr_level": "A1",
          "word_slugs": [
            "cirugía-noun"
          ]
        },
        {
          "id": "9458737",
          "text": "Tom va a tener cirugía.",
          "translation": "Тому предстоит операция.",
          "source": "Tatoeba #9458737 @ignacio / #9528843 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9458737",
          "cefr_level": "A1",
          "word_slugs": [
            "cirugía-noun"
          ]
        },
        {
          "id": "7110340",
          "text": "La cirugía duró tres horas.",
          "translation": "Операция длилась три часа.",
          "source": "Tatoeba #7110340 @Schuager / #7110345 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7110340",
          "cefr_level": "A1",
          "word_slugs": [
            "cirugía-noun"
          ]
        },
        {
          "id": "536698",
          "text": "La cirugía es la mejor solución.",
          "translation": "Операция - лучшее решение.",
          "source": "Tatoeba #536698 @Leono / #9536801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/536698",
          "cefr_level": "A1",
          "word_slugs": [
            "cirugía-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
