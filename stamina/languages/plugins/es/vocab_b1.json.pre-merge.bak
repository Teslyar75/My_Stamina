    {
      "slug": "conocí-verb",
      "lemma": "conocí",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1322,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular preterite indicative of conocer"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10685853",
          "text": "Un día la conocí.",
          "translation": "Однажды я её встретил.",
          "source": "Tatoeba #10685853 @carlosalberto / #10684654 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10685853",
          "cefr_level": "A1",
          "word_slugs": [
            "conocí-verb"
          ]
        },
        {
          "id": "3354574",
          "text": "Conocí a tu padre.",
          "translation": "Я познакомился с твоим отцом.",
          "source": "Tatoeba #3354574 @marcelostockle / #4571535 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3354574",
          "cefr_level": "A1",
          "word_slugs": [
            "conocí-verb"
          ]
        },
        {
          "id": "7972152",
          "text": "La conocí en París.",
          "translation": "Я познакомился с ней в Париже.",
          "source": "Tatoeba #7972152 @kikan321 / #7977576 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7972152",
          "cefr_level": "A1",
          "word_slugs": [
            "conocí-verb"
          ]
        },
        {
          "id": "853787",
          "text": "Así conocí a tu madre.",
          "translation": "Так я и познакомился с твоей мамой.",
          "source": "Tatoeba #853787 @ygpons / #5650697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/853787",
          "cefr_level": "A1",
          "word_slugs": [
            "conocí-verb"
          ]
        },
        {
          "id": "1841785",
          "text": "Nunca conocí a mi padre.",
          "translation": "Отца я никогда не знал.",
          "source": "Tatoeba #1841785 @hayastan / #5803545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1841785",
          "cefr_level": "A1",
          "word_slugs": [
            "conocí-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "conocí",
        "plural": "",
        "infinitive": "conocí"
      }
    },
    {
      "slug": "tiempos-noun",
      "lemma": "tiempos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1323,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of tiempo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1405338",
          "text": "Los tiempos cambian.",
          "translation": "Времена меняются.",
          "source": "Tatoeba #1405338 @enteka / #1759777 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1405338",
          "cefr_level": "A1",
          "word_slugs": [
            "tiempos-noun"
          ]
        },
        {
          "id": "4523679",
          "text": "Eran tiempos felices.",
          "translation": "То были счастливые времена.",
          "source": "Tatoeba #4523679 @Shishir / #4620977 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4523679",
          "cefr_level": "A1",
          "word_slugs": [
            "tiempos-noun"
          ]
        },
        {
          "id": "1388304",
          "text": "Eran tiempos peligrosos.",
          "translation": "Это были опасные времена.",
          "source": "Tatoeba #1388304 @marcelostockle / #3075299 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1388304",
          "cefr_level": "A1",
          "word_slugs": [
            "tiempos-noun"
          ]
        },
        {
          "id": "745683",
          "text": "Recuerdo aquellos tiempos.",
          "translation": "Я помню те времена.",
          "source": "Tatoeba #745683 @Shishir / #4935594 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/745683",
          "cefr_level": "A1",
          "word_slugs": [
            "tiempos-noun"
          ]
        },
        {
          "id": "1469534",
          "text": "Los tiempos han cambiado.",
          "translation": "Времена изменились.",
          "source": "Tatoeba #1469534 @marcelostockle / #1800116 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1469534",
          "cefr_level": "A1",
          "word_slugs": [
            "tiempos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
