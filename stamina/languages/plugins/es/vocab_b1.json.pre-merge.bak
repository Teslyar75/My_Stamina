    {
      "slug": "empezamos-verb",
      "lemma": "empezamos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2284,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person plural present/preterite indicative of empezar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4934897",
          "text": "Empezamos de nuevo.",
          "translation": "Мы начинаем снова.",
          "source": "Tatoeba #4934897 @Leono / #6169579 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4934897",
          "cefr_level": "A1",
          "word_slugs": [
            "empezamos-verb"
          ]
        },
        {
          "id": "4009576",
          "text": "Empezamos a caminar.",
          "translation": "Мы зашагали.",
          "source": "Tatoeba #4009576 @alexmarcelo / #4171929 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4009576",
          "cefr_level": "A1",
          "word_slugs": [
            "empezamos-verb"
          ]
        },
        {
          "id": "3949858",
          "text": "Empezamos a besarnos.",
          "translation": "Мы стали целоваться.",
          "source": "Tatoeba #3949858 @mervert1 / #3950622 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3949858",
          "cefr_level": "A1",
          "word_slugs": [
            "empezamos-verb"
          ]
        },
        {
          "id": "5045699",
          "text": "¿Por dónde empezamos?",
          "translation": "С чего начнём?",
          "source": "Tatoeba #5045699 @don_ramon / #2732026 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5045699",
          "cefr_level": "A1",
          "word_slugs": [
            "empezamos-verb"
          ]
        },
        {
          "id": "2270098",
          "text": "Hoy empezamos a trabajar.",
          "translation": "Сегодня мы начинаем работать.",
          "source": "Tatoeba #2270098 @Shishir / #3893630 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2270098",
          "cefr_level": "A1",
          "word_slugs": [
            "empezamos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "empezamos",
        "plural": "",
        "infinitive": "empezamos"
      }
