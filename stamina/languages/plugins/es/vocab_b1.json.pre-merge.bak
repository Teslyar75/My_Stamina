          "cefr_level": "A1",
          "word_slugs": [
            "varias-adj"
          ]
        },
        {
          "id": "449811",
          "text": "Él vino varias veces.",
          "translation": "Он приходил несколько раз.",
          "source": "Tatoeba #449811 @Shishir / #2383713 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/449811",
          "cefr_level": "A1",
          "word_slugs": [
            "varias-adj"
          ]
        },
        {
          "id": "949007",
          "text": "Visitamos Tokio varias veces.",
          "translation": "Мы неоднократно посещали Токио.",
          "source": "Tatoeba #949007 @hayastan / #4077090 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/949007",
