    {
      "slug": "perdona-verb",
      "lemma": "perdona",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1281,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of perdonar:",
          "third-person singular present indicative",
          "inflection of perdonar:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "922343",
          "text": "¡Perdona mis pecados!",
          "translation": "Прости мои грехи!",
          "source": "Tatoeba #922343 @Shishir / #5615872 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/922343",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        },
        {
          "id": "768692",
          "text": "Perdona que lo diga.",
          "translation": "Прости, что я это говорю.",
          "source": "Tatoeba #768692 @darinmex / #2263834 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/768692",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        },
        {
          "id": "12018491",
          "text": "Perdona pero no olivdes.",
          "translation": "Прощай, но не забывай.",
          "source": "Tatoeba #12018491 @emma_zunz / #12020119 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12018491",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        },
        {
          "id": "2278545",
          "text": "Perdona que haya escrito tanto.",
          "translation": "Прости, что столько написал.",
          "source": "Tatoeba #2278545 @Shishir / #7763420 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2278545",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        },
        {
          "id": "3423610",
          "text": "Perdona pero no me gusta Rossini.",
          "translation": "Извини, но мне не нравится Россини.",
          "source": "Tatoeba #3423610 @gianich73 / #3423558 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3423610",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        }
      ],
