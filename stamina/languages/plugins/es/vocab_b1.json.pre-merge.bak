    {
      "slug": "tecnología-noun",
      "lemma": "tecnología",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2262,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "technology"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3203158",
          "text": "Ella no comprende la tecnología moderna.",
          "translation": "Она не понимает современных технологий.",
          "source": "Tatoeba #3203158 @cueyayotl / #3510411 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3203158",
          "cefr_level": "A1",
          "word_slugs": [
            "tecnología-noun"
          ]
        },
        {
          "id": "966567",
          "text": "La tecnología resolvió muchos de los problemas.",
          "translation": "Технология решила множество проблем.",
          "source": "Tatoeba #966567 @hundo / #4424859 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/966567",
          "cefr_level": "A1",
          "word_slugs": [
            "tecnología-noun"
          ]
        },
        {
          "id": "3106352",
          "text": "La gente de Atlántida tenía tecnología avanzada.",
          "translation": "У жителей Атлантиды были передовые технологии.",
          "source": "Tatoeba #3106352 @marcelostockle / #3926095 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3106352",
          "cefr_level": "A1",
          "word_slugs": [
            "tecnología-noun"
          ]
        },
        {
          "id": "1690661",
          "text": "A los ancianos les cuesta entender la tecnología moderna.",
          "translation": "Пожилым людям трудно понять современные технологии.",
          "source": "Tatoeba #1690661 @marcelostockle / #5338660 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1690661",
          "cefr_level": "A1",
          "word_slugs": [
            "tecnología-noun"
          ]
        },
        {
          "id": "9056702",
          "text": "Con la tecnología actual, las barreras del idioma no existen.",
          "translation": "С сегодняшними технологиями языковых барьеров не существует.",
          "source": "Tatoeba #9056702 @rafaeldejesus8199 / #9056807 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9056702",
          "cefr_level": "A1",
          "word_slugs": [
            "tecnología-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "tecnología",
        "plural": "",
        "infinitive": ""
      }
    },
