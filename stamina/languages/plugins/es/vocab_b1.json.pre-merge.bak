    {
      "slug": "suponía-verb",
      "lemma": "suponía",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2283,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect indicative of suponer"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10967240",
          "text": "No lo sabía, pero lo suponía.",
          "translation": "Я не знал, но догадывался.",
          "source": "Tatoeba #10967240 @carlosalberto / #10966462 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967240",
          "cefr_level": "A1",
          "word_slugs": [
            "suponía-verb"
          ]
        },
        {
          "id": "3860286",
          "text": "Se suponía que habría silencio aquí.",
          "translation": "Предполагалось, что здесь будет тихо.",
          "source": "Tatoeba #3860286 @gianich73 / #3860137 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3860286",
          "cefr_level": "A1",
          "word_slugs": [
            "suponía-verb"
          ]
        },
        {
          "id": "10265703",
          "text": "Se suponía que eso era un secreto.",
          "translation": "Это должно было быть секретом.",
          "source": "Tatoeba #10265703 @Seael / #10266354 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10265703",
          "cefr_level": "A1",
          "word_slugs": [
            "suponía-verb"
          ]
        },
        {
          "id": "6539442",
          "text": "Sami suponía un peligro para sí mismo.",
          "translation": "Сами представлял опасность для самого себя.",
          "source": "Tatoeba #6539442 @HAYACH / #6387580 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6539442",
          "cefr_level": "A1",
          "word_slugs": [
            "suponía-verb"
          ]
        },
        {
          "id": "3860203",
          "text": "Se suponía que ustedes harían eso mañana.",
          "translation": "Предполагалось, что вы сделаете это вчера.",
          "source": "Tatoeba #3860203 @gianich73 / #3860155 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3860203",
          "cefr_level": "A1",
          "word_slugs": [
            "suponía-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "suponía",
        "plural": "",
        "infinitive": "suponía"
      }
