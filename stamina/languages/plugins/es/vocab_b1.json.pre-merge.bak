    {
      "slug": "daniel-name",
      "lemma": "Daniel",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1749,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "Daniel (biblical book and prophet)",
          "a male given name from Hebrew, equivalent to English Daniel",
          "the letter D in the Spanish spelling alphabet"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2277496",
          "text": "Daniel tiene un buen trabajo.",
          "translation": "У Даниэля хорошая работа.",
          "source": "Tatoeba #2277496 @Shishir / #5552147 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2277496",
          "cefr_level": "A1",
          "word_slugs": [
            "daniel-name"
          ]
        },
        {
          "id": "12533462",
          "text": "Daniel está en la biblioteca.",
          "translation": "Даниэль в библиотеке.",
          "source": "Tatoeba #12533462 @Polyglot01 / #13516378 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12533462",
          "cefr_level": "A1",
          "word_slugs": [
            "daniel-name"
          ]
        },
        {
          "id": "2036571",
          "text": "Daniel le dio las gracias al policía.",
          "translation": "Даниэль поблагодарил полицию.",
          "source": "Tatoeba #2036571 @marcelostockle / #4841120 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2036571",
          "cefr_level": "A1",
          "word_slugs": [
            "daniel-name"
          ]
        },
        {
          "id": "1055922",
          "text": "Los padres de Daniel están siempre enfermos.",
          "translation": "Родители Даниэля постоянно болеют.",
          "source": "Tatoeba #1055922 @hayastan / #7054572 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1055922",
          "cefr_level": "A1",
          "word_slugs": [
            "daniel-name"
          ]
        },
        {
          "id": "1430851",
          "text": "Laura se ha puesto muy guapa para ir a ver a Daniel.",
          "translation": "Лаура прихорошилась перед встречей с Даниэлем.",
          "source": "Tatoeba #1430851 @Shishir / #5665777 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1430851",
          "cefr_level": "A1",
          "word_slugs": [
            "daniel-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
