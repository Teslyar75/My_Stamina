          ]
        },
        {
          "id": "5854067",
          "text": "Tom está claramente decepcionado.",
          "translation": "Том явно разочарован.",
          "source": "Tatoeba #5854067 @arh / #5879986 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5854067",
          "cefr_level": "A1",
          "word_slugs": [
            "claramente-adv"
          ]
        },
        {
          "id": "4566639",
          "text": "Dilo claramente en voz alta.",
          "translation": "Скажи это чётко и громко.",
          "source": "Tatoeba #4566639 @cueyayotl / #4683639 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4566639",
