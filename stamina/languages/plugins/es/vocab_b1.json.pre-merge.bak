    {
      "slug": "tantos-noun",
      "lemma": "tantos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1901,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of tanto",
          "score"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3263765",
          "text": "¡Hablas tantos idiomas!",
          "translation": "Ты говоришь на стольких языках!",
          "source": "Tatoeba #3263765 @Tono / #3263761 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3263765",
          "cefr_level": "A1",
          "word_slugs": [
            "tantos-noun"
          ]
        },
        {
          "id": "1617605",
          "text": "Han pasado tantos años.",
          "translation": "Прошло столько лет.",
          "source": "Tatoeba #1617605 @Shishir / #6148247 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1617605",
          "cefr_level": "A1",
          "word_slugs": [
            "tantos-noun"
          ]
        },
        {
          "id": "2940140",
          "text": "No necesitamos tantos detalles.",
          "translation": "Нам не нужно так много подробностей.",
          "source": "Tatoeba #2940140 @hayastan / #3413791 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2940140",
          "cefr_level": "A1",
          "word_slugs": [
            "tantos-noun"
          ]
        },
        {
          "id": "862745",
          "text": "Cuantos hombres, tantos pareceres.",
          "translation": "Сколько людей, столько и мнений.",
          "source": "Tatoeba #862745 @Leynaf / #1962812 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/862745",
          "cefr_level": "A1",
          "word_slugs": [
            "tantos-noun"
          ]
        },
        {
          "id": "1127734",
          "text": "No pensé que serían tantos.",
          "translation": "Я не думал, что их будет так много.",
          "source": "Tatoeba #1127734 @alexmarcelo / #5155272 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1127734",
          "cefr_level": "A1",
          "word_slugs": [
            "tantos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
