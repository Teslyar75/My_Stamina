    {
      "slug": "defensa-noun",
      "lemma": "defensa",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1417,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "defense",
          "retaining wall",
          "bumper"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2492094",
          "text": "Deberías aprender defensa personal.",
          "translation": "Тебе надо научиться самозащите.",
          "source": "Tatoeba #2492094 @marcelostockle / #4917640 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2492094",
          "cefr_level": "A1",
          "word_slugs": [
            "defensa-noun"
          ]
        },
        {
          "id": "4079396",
          "text": "¿Por qué sales en su defensa?",
          "translation": "Почему ты встаёшь на её защиту?",
          "source": "Tatoeba #4079396 @gianich73 / #4079330 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4079396",
          "cefr_level": "A1",
          "word_slugs": [
            "defensa-noun"
          ]
        },
        {
          "id": "1769260",
          "text": "La mejor defensa es el ataque.",
          "translation": "Лучшая защита - это нападение.",
          "source": "Tatoeba #1769260 @hayastan / #2761328 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1769260",
          "cefr_level": "A1",
          "word_slugs": [
            "defensa-noun"
          ]
        },
        {
          "id": "554922",
          "text": "Nadie alzó la voz en su defensa.",
          "translation": "Никто и слова не сказал в его защиту.",
          "source": "Tatoeba #554922 @darinmex / #4155349 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/554922",
          "cefr_level": "A1",
          "word_slugs": [
            "defensa-noun"
          ]
        },
        {
          "id": "10795641",
          "text": "Mañana tengo mi defensa de la tesis.",
          "translation": "У меня завтра защита диссертации.",
          "source": "Tatoeba #10795641 @Curro / #7254284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10795641",
          "cefr_level": "A1",
          "word_slugs": [
            "defensa-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "defensa",
