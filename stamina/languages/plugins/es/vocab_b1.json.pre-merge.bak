    {
      "slug": "mismos-adj",
      "lemma": "mismos",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1402,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "masculine plural of mismo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7578217",
          "text": "Miradlo vosotros mismos.",
          "translation": "Посмотрите сами.",
          "source": "Tatoeba #7578217 @arh / #3048430 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7578217",
          "cefr_level": "A1",
          "word_slugs": [
            "mismos-adj"
          ]
        },
        {
          "id": "3527501",
          "text": "Ellos mismos lo hacen.",
          "translation": "Они сами это делают.",
          "source": "Tatoeba #3527501 @cueyayotl / #6171191 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3527501",
          "cefr_level": "A1",
          "word_slugs": [
            "mismos-adj"
          ]
        },
        {
          "id": "10341868",
          "text": "Sólo sean ustedes mismos.",
          "translation": "Просто будьте самими собой.",
          "source": "Tatoeba #10341868 @JSKabylie / #10620387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10341868",
          "cefr_level": "A1",
          "word_slugs": [
            "mismos-adj"
          ]
        },
        {
          "id": "5309991",
          "text": "Hablen por ustedes mismos.",
          "translation": "Говорите за себя.",
          "source": "Tatoeba #5309991 @baudelaire / #4885483 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5309991",
          "cefr_level": "A1",
          "word_slugs": [
            "mismos-adj"
          ]
        },
        {
          "id": "11816451",
          "text": "Tenemos los mismos amigos.",
          "translation": "У нас одни и те же друзья.",
          "source": "Tatoeba #11816451 @saverius / #13042052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11816451",
          "cefr_level": "A1",
          "word_slugs": [
            "mismos-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
