          ]
        },
        {
          "id": "8333964",
          "text": "Algunas veces dudo.",
          "translation": "Иногда я сомневаюсь.",
          "source": "Tatoeba #8333964 @arh / #8348885 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8333964",
          "cefr_level": "A1",
