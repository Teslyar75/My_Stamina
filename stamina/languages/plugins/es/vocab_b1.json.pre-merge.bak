    {
      "slug": "iban-verb",
      "lemma": "iban",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2065,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural imperfect indicative of ir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3174709",
          "text": "Ellas iban lejos.",
          "translation": "Они шли далеко.",
          "source": "Tatoeba #3174709 @cueyayotl / #5308269 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3174709",
          "cefr_level": "A1",
          "word_slugs": [
            "iban-verb"
          ]
        },
        {
          "id": "640403",
          "text": "¿Adónde iban ellos?",
          "translation": "Куда они ехали?",
          "source": "Tatoeba #640403 @Shishir / #7881394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/640403",
          "cefr_level": "A1",
          "word_slugs": [
            "iban-verb"
          ]
        },
        {
          "id": "687697",
          "text": "¿En qué dirección iban?",
          "translation": "Куда они направлялись?",
          "source": "Tatoeba #687697 @lukaszpp / #13937411 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/687697",
          "cefr_level": "A1",
          "word_slugs": [
            "iban-verb"
          ]
        },
        {
          "id": "2719328",
          "text": "Ellos iban al hospital.",
          "translation": "Они ходили в больницу.",
          "source": "Tatoeba #2719328 @cueyayotl / #2749189 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2719328",
          "cefr_level": "A1",
          "word_slugs": [
            "iban-verb"
          ]
        },
        {
          "id": "3174581",
          "text": "Ellos iban tomados de la mano.",
          "translation": "Они шли, держась за руки.",
          "source": "Tatoeba #3174581 @marcelostockle / #5597952 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3174581",
          "cefr_level": "A1",
          "word_slugs": [
            "iban-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
