    {
      "slug": "andar-verb",
      "lemma": "andar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2449,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to walk, to go",
          "to amble, to travel",
          "to ride",
          "to function, to work, to run, to go"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1237168",
          "text": "El niño sabe andar.",
          "translation": "Ребёнок умеет ходить.",
          "source": "Tatoeba #1237168 @Shishir / #2401705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1237168",
          "cefr_level": "A1",
          "word_slugs": [
            "andar-verb"
          ]
        },
        {
          "id": "691104",
          "text": "Le gusta andar sola.",
          "translation": "Ему нравится ходить одному.",
          "source": "Tatoeba #691104 @Shishir / #1440107 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/691104",
          "cefr_level": "A1",
          "word_slugs": [
            "andar-verb"
          ]
        },
        {
          "id": "2259462",
          "text": "El tren echó a andar.",
          "translation": "Поезд тронулся.",
          "source": "Tatoeba #2259462 @cueyayotl / #4027269 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259462",
          "cefr_level": "A1",
          "word_slugs": [
            "andar-verb"
          ]
        },
        {
          "id": "1334894",
          "text": "Me gusta andar en tren.",
          "translation": "Мне нравится ездить на поезде.",
          "source": "Tatoeba #1334894 @marcelostockle / #3042873 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1334894",
          "cefr_level": "A1",
          "word_slugs": [
            "andar-verb"
          ]
        },
        {
          "id": "566104",
          "text": "Deja de andar con rodeos.",
          "translation": "Хватит ходить вокруг да около.",
          "source": "Tatoeba #566104 @darinmex / #423134 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/566104",
          "cefr_level": "A1",
          "word_slugs": [
            "andar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
