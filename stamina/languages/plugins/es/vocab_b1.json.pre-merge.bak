          "storm",
          "thunderstorm, lightning storm"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2259436",
          "text": "La tormenta aflojó.",
          "translation": "Буря утихла.",
          "source": "Tatoeba #2259436 @cueyayotl / #5693697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259436",
          "cefr_level": "A1",
          "word_slugs": [
            "tormenta-noun"
          ]
        },
        {
          "id": "7119447",
          "text": "Anoche hubo tormenta.",
          "translation": "Вчера ночью была буря.",
          "source": "Tatoeba #7119447 @arh / #7121117 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7119447",
          "cefr_level": "A1",
          "word_slugs": [
            "tormenta-noun"
          ]
        },
        {
          "id": "5052935",
          "text": "Nos atrapó una tormenta.",
          "translation": "Мы попали в грозу.",
          "source": "Tatoeba #5052935 @don_ramon / #2330550 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5052935",
          "cefr_level": "A1",
          "word_slugs": [
            "tormenta-noun"
          ]
        },
        {
          "id": "1974027",
          "text": "Una tormenta es peligrosa.",
          "translation": "Шторм опасен.",
          "source": "Tatoeba #1974027 @marcelostockle / #2841006 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1974027",
          "cefr_level": "A1",
          "word_slugs": [
            "tormenta-noun"
          ]
        },
        {
          "id": "434151",
          "text": "Viene una tormenta de nieve.",
          "translation": "Приближается снежная буря.",
          "source": "Tatoeba #434151 @lukaszpp / #6775680 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/434151",
          "cefr_level": "A1",
          "word_slugs": [
            "tormenta-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
