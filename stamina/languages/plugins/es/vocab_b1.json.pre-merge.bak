    {
      "slug": "emergencia-noun",
      "lemma": "emergencia",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1637,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "emergency",
          "emergence"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "475610",
          "text": "Es una emergencia.",
          "translation": "Это экстренная ситуация.",
          "source": "Tatoeba #475610 @Shishir / #646457 @nami (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/475610",
          "cefr_level": "A1",
          "word_slugs": [
            "emergencia-noun"
          ]
        },
        {
          "id": "4798076",
          "text": "Es una emergencia, Tom.",
          "translation": "Том, это срочно.",
          "source": "Tatoeba #4798076 @Shishir / #5582083 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4798076",
          "cefr_level": "A1",
          "word_slugs": [
            "emergencia-noun"
          ]
        },
        {
          "id": "10147557",
          "text": "Busco la salida de emergencia.",
          "translation": "Я ищу запасной выход.",
          "source": "Tatoeba #10147557 @Shishir / #10147562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10147557",
          "cefr_level": "A1",
          "word_slugs": [
            "emergencia-noun"
          ]
        },
        {
          "id": "1769202",
          "text": "Usar solo en caso de emergencia.",
          "translation": "Использовать только в случае экстренной необходимости.",
          "source": "Tatoeba #1769202 @marcelostockle / #6578887 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1769202",
          "cefr_level": "A1",
          "word_slugs": [
            "emergencia-noun"
          ]
        },
        {
          "id": "5565962",
          "text": "Tom haló el freno de emergencia.",
          "translation": "Том задействовал аварийный тормоз.",
          "source": "Tatoeba #5565962 @baudelaire / #6106536 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5565962",
          "cefr_level": "A1",
          "word_slugs": [
            "emergencia-noun"
          ]
        }
      ],
