          "difficulty, problem, issue"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5939734",
          "text": "Me serví un trago.",
          "translation": "Я налил себе выпить.",
          "source": "Tatoeba #5939734 @arh / #12667824 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5939734",
          "cefr_level": "A1",
          "word_slugs": [
            "trago-noun"
          ]
        },
        {
          "id": "1061638",
          "text": "¿Cuál es tu trago favorito?",
          "translation": "Какой твой любимый напиток?",
          "source": "Tatoeba #1061638 @alexmarcelo / #5120145 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1061638",
          "cefr_level": "A1",
          "word_slugs": [
            "trago-noun"
          ]
        },
        {
          "id": "2337570",
          "text": "Solo me he tomado un trago.",
          "translation": "Я выпил всего одну кружку.",
