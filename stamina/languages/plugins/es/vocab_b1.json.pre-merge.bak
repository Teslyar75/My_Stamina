    {
      "slug": "dispuesto-adj",
      "lemma": "dispuesto",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2052,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "willing, ready, game, down",
          "willing to, ready to"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1715612",
          "text": "¿Estarías dispuesto a ayudar?",
          "translation": "Ты был бы готов помочь?",
          "source": "Tatoeba #1715612 @marcelostockle / #6207017 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1715612",
          "cefr_level": "A1",
          "word_slugs": [
            "dispuesto-adj"
          ]
        },
        {
          "id": "7586985",
          "text": "Esto no estoy dispuesto a negociarlo.",
          "translation": "Это я обсуждать не готов.",
          "source": "Tatoeba #7586985 @arh / #7587521 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7586985",
          "cefr_level": "A1",
          "word_slugs": [
            "dispuesto-adj"
          ]
        },
        {
          "id": "1876660",
          "text": "Estoy dispuesto a ayudarte si quieres.",
          "translation": "Я готов помочь тебе, если хочешь.",
          "source": "Tatoeba #1876660 @marcelostockle / #5044704 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1876660",
          "cefr_level": "A1",
          "word_slugs": [
            "dispuesto-adj"
          ]
        },
        {
          "id": "4062774",
          "text": "Estoy dispuesto a pedirte perdón de rodillas.",
          "translation": "Я готов на коленях просить у тебя прощения.",
          "source": "Tatoeba #4062774 @hayastan / #4063952 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4062774",
          "cefr_level": "A1",
          "word_slugs": [
            "dispuesto-adj"
          ]
        },
        {
          "id": "7463338",
          "text": "Él estaba dispuesto a ayudar a los demás.",
          "translation": "Он был готов помогать другим.",
          "source": "Tatoeba #7463338 @UsuarioX / #7463989 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7463338",
          "cefr_level": "A1",
          "word_slugs": [
            "dispuesto-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el dispuesto",
        "plural": "",
        "infinitive": ""
      }
