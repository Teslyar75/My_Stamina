        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2959917",
          "text": "Éramos como hermanos.",
          "translation": "Мы были как братья.",
          "source": "Tatoeba #2959917 @marcelostockle / #3246982 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2959917",
          "cefr_level": "A1",
