    {
      "slug": "carga-noun",
      "lemma": "carga",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1738,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "load",
          "burden",
          "cargo",
          "charge"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10799687",
          "text": "Puedo llevar una carga grande.",
          "translation": "Я могу нести большой груз.",
          "source": "Tatoeba #10799687 @Curro / #6712340 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10799687",
          "cefr_level": "A1",
          "word_slugs": [
            "carga-noun"
          ]
        },
        {
          "id": "4745454",
          "text": "¿Cuándo dejaré de ser una carga?",
          "translation": "Когда я перестану быть обузой?",
          "source": "Tatoeba #4745454 @halime / #9687896 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4745454",
          "cefr_level": "A1",
          "word_slugs": [
            "carga-noun"
          ]
        },
        {
          "id": "4745446",
          "text": "No quiero ser una carga para ti.",
          "translation": "Я не хочу быть для тебя обузой.",
