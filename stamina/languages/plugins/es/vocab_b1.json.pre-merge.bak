          ]
        },
        {
          "id": "492999",
          "text": "¿Puedes enseñarme a robar?",
          "translation": "Ты можешь научить меня воровать?",
          "source": "Tatoeba #492999 @Shishir / #626560 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/492999",
          "cefr_level": "A1",
          "word_slugs": [
