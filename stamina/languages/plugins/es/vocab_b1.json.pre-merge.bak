    {
      "slug": "imaginar-verb",
      "lemma": "imaginar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2296,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to imagine",
          "to imagine, to suppose"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6711594",
          "text": "Era de imaginar.",
          "translation": "Это было предсказуемо.",
          "source": "Tatoeba #6711594 @arh / #2870037 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6711594",
          "cefr_level": "A1",
          "word_slugs": [
            "imaginar-verb"
          ]
        },
        {
          "id": "5011783",
          "text": "¿Te lo podés imaginar?",
          "translation": "Можешь себе это представить?",
          "source": "Tatoeba #5011783 @don_ramon / #3467938 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5011783",
          "cefr_level": "A1",
          "word_slugs": [
            "imaginar-verb"
          ]
        },
        {
          "id": "719886",
          "text": "No puedo imaginar vivir sin él.",
          "translation": "Я не могу представить себе жизни без него.",
          "source": "Tatoeba #719886 @darinmex / #10885770 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/719886",
          "cefr_level": "A1",
          "word_slugs": [
            "imaginar-verb"
          ]
        },
        {
          "id": "1142296",
          "text": "¿Puedes imaginar el esplendor de Babel?",
          "translation": "Можешь представить себе великолепие Вавилона?",
          "source": "Tatoeba #1142296 @marcelostockle / #5816323 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1142296",
          "cefr_level": "A1",
          "word_slugs": [
            "imaginar-verb"
          ]
        },
        {
          "id": "2440520",
          "text": "No puedo imaginar mi vida sin ti.",
          "translation": "Я не могу представить свою жизнь без тебя.",
          "source": "Tatoeba #2440520 @marcelostockle / #2440526 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2440520",
          "cefr_level": "A1",
          "word_slugs": [
            "imaginar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el imaginar",
        "plural": "",
        "infinitive": "imaginar"
      }
    },
    {
      "slug": "archivos-noun",
      "lemma": "archivos",
      "pos": "noun",
