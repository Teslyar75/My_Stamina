    {
      "slug": "aquellos-pron",
      "lemma": "aquellos",
      "pos": "pron",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1694,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "alternative spelling of aquéllos; those ones (over there; implying some distance). The unaccented form can function as a pronoun if it can be unambiguously deduced as such from con"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "745683",
          "text": "Recuerdo aquellos tiempos.",
          "translation": "Я помню те времена.",
          "source": "Tatoeba #745683 @Shishir / #4935594 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/745683",
          "cefr_level": "A1",
          "word_slugs": [
            "aquellos-pron"
          ]
        },
        {
          "id": "2432086",
          "text": "Aquellos libros son suyos.",
          "translation": "Те книги ваши.",
          "source": "Tatoeba #2432086 @Shishir / #5816206 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2432086",
          "cefr_level": "A1",
          "word_slugs": [
            "aquellos-pron"
          ]
        },
        {
          "id": "436938",
          "text": "Me acuerdo de aquellos tiempos.",
          "translation": "Я помню те времена.",
          "source": "Tatoeba #436938 @lukaszpp / #4935594 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/436938",
          "cefr_level": "A1",
          "word_slugs": [
            "aquellos-pron"
          ]
        },
        {
          "id": "1237587",
          "text": "¿Cómo puedo olvidar aquellos días?",
          "translation": "Как мне забыть те дни?",
          "source": "Tatoeba #1237587 @hayastan / #13953048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1237587",
          "cefr_level": "A1",
          "word_slugs": [
            "aquellos-pron"
          ]
        },
        {
          "id": "3707654",
          "text": "Aquellos perros no paran de ladrar.",
          "translation": "Те собаки не перестают лаять.",
          "source": "Tatoeba #3707654 @hayastan / #4099081 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3707654",
          "cefr_level": "A1",
          "word_slugs": [
            "aquellos-pron"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "aquellos",
        "plural": "",
        "infinitive": ""
      }
