          "id": "3494002",
          "text": "¡Hija del diablo!",
          "translation": "Чертовка!",
          "source": "Tatoeba #3494002 @marcosruben / #4269799 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3494002",
          "cefr_level": "A1",
          "word_slugs": [
            "diablo-intj"
          ]
        },
        {
          "id": "6162939",
          "text": "Dios creó al diablo.",
          "translation": "Бог создал дьявола.",
          "source": "Tatoeba #6162939 @wallebot / #6163410 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6162939",
          "cefr_level": "A1",
          "word_slugs": [
            "diablo-intj"
          ]
        },
        {
          "id": "5994170",
          "text": "Diablo no come diablo.",
          "translation": "Ворон ворону глаз не выклюет.",
          "source": "Tatoeba #5994170 @magnificentgoddess / #450096 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5994170",
          "cefr_level": "A1",
          "word_slugs": [
            "diablo-intj"
          ]
        }
      ],
