      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1394,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "движение"
        ],
        "en": [
          "movement (physical motion between points in space)",
          "movement (a trend in various fields or social categories)",
          "transaction",
          "movement (a large division of a larger composition)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2905878",
          "text": "El movimiento es sensual.",
          "translation": "Движение чувственное.",
          "source": "Tatoeba #2905878 @hayastan / #2906080 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2905878",
          "cefr_level": "A1",
          "word_slugs": [
            "movimiento-noun"
          ]
        },
        {
          "id": "1101090",
          "text": "Ese movimiento fue un gran error.",
          "translation": "Тот переезд был большой ошибкой.",
          "source": "Tatoeba #1101090 @humbertovs / #4031531 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1101090",
          "cefr_level": "A1",
          "word_slugs": [
            "movimiento-noun"
          ]
        },
        {
          "id": "2268719",
          "text": "Hay mucho movimiento en esa calle.",
          "translation": "На этой улице очень оживлённое движение.",
          "source": "Tatoeba #2268719 @hayastan / #11001992 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2268719",
          "cefr_level": "A1",
          "word_slugs": [
            "movimiento-noun"
          ]
        },
        {
          "id": "1952155",
          "text": "Cada movimiento del bailarín fue perfecto.",
          "translation": "Каждое движение танцора было идеальным.",
          "source": "Tatoeba #1952155 @topofabi / #2161162 @Leonid204 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1952155",
          "cefr_level": "A1",
          "word_slugs": [
            "movimiento-noun"
          ]
        },
        {
          "id": "1433556",
          "text": "Muchas personas famosas sostienen el movimiento.",
          "translation": "Движение поддерживают многие известные люди.",
          "source": "Tatoeba #1433556 @Ankio / #7633588 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1433556",
          "cefr_level": "A1",
          "word_slugs": [
            "movimiento-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
