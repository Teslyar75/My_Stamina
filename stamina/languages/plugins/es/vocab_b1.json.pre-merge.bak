    {
      "slug": "oyes-verb",
      "lemma": "oyes",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1972,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular present indicative of oír"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5041500",
          "text": "¿Oyes la voz?",
          "translation": "Слышишь голос?",
          "source": "Tatoeba #5041500 @don_ramon / #5041517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5041500",
          "cefr_level": "A1",
          "word_slugs": [
            "oyes-verb"
          ]
        },
        {
          "id": "761822",
          "text": "¿Oyes cantar a los pájaros?",
          "translation": "Ты слышишь, как поют птицы?",
          "source": "Tatoeba #761822 @Shishir / #14079500 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/761822",
          "cefr_level": "A1",
          "word_slugs": [
            "oyes-verb"
          ]
        },
        {
          "id": "3392847",
          "text": "Te quiero, ¿me oyes? ¡Te amo!",
          "translation": "Я люблю тебя, слышишь меня? Я люблю тебя!",
          "source": "Tatoeba #3392847 @carlosalberto / #3406597 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3392847",
          "cefr_level": "A1",
          "word_slugs": [
            "oyes-verb"
          ]
        },
        {
          "id": "3109020",
          "text": "¿Oyes el canto de los pájaros?",
          "translation": "Ты слышишь пение птиц?",
          "source": "Tatoeba #3109020 @marcelostockle / #3111029 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3109020",
          "cefr_level": "A1",
          "word_slugs": [
            "oyes-verb"
          ]
        },
        {
          "id": "1406596",
          "text": "Tú siempre oyes pero no escuchas.",
          "translation": "Ты всегда слушаешь, но не слышишь.",
          "source": "Tatoeba #1406596 @marcelostockle / #5598343 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1406596",
          "cefr_level": "A1",
          "word_slugs": [
            "oyes-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "oyes",
        "plural": "",
        "infinitive": "oyes"
      }
    },
    {
      "slug": "thomas-name",
      "lemma": "Thomas",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1973,
      "frequency_band": "cervantes-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5015644",
          "text": "No te amo más, Thomas.",
          "translation": "Я тебя больше не люблю, Том.",
          "source": "Tatoeba #5015644 @don_ramon / #2999861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5015644",
          "cefr_level": "A1",
          "word_slugs": [
            "thomas-name"
          ]
        },
        {
          "id": "5016917",
          "text": "Soy el hermano de Thomas.",
          "translation": "Я брат Тома.",
          "source": "Tatoeba #5016917 @don_ramon / #3069004 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5016917",
          "cefr_level": "A1",
          "word_slugs": [
            "thomas-name"
          ]
        },
        {
          "id": "1121947",
          "text": "Thomas está viendo una película.",
          "translation": "Томас смотрит фильм.",
          "source": "Tatoeba #1121947 @FiRez / #3800534 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1121947",
          "cefr_level": "A1",
          "word_slugs": [
            "thomas-name"
          ]
        },
        {
          "id": "1198499",
          "text": "Miriam quería casarse con Thomas.",
          "translation": "Мириам хотела выйти замуж за Томаса.",
          "source": "Tatoeba #1198499 @cueyayotl / #5140647 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1198499",
          "cefr_level": "A1",
          "word_slugs": [
            "thomas-name"
          ]
        },
        {
          "id": "1551479",
          "text": "Thomas es un hombre de acción.",
          "translation": "Том — человек действия.",
          "source": "Tatoeba #1551479 @Shishir / #4353195 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1551479",
          "cefr_level": "A1",
          "word_slugs": [
            "thomas-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "Thomas",
        "plural": "",
        "infinitive": ""
      }
