          ]
        },
        {
          "id": "1272092",
          "text": "Corrija los errores.",
          "translation": "Исправьте ошибки.",
          "source": "Tatoeba #1272092 @marcelostockle / #467797 @AmaDeus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1272092",
