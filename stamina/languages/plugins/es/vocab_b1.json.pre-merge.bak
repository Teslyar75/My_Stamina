          ]
        },
        {
          "id": "5016918",
          "text": "¡Hablemos en francés!",
          "translation": "Давайте поговорим на французском!",
          "source": "Tatoeba #5016918 @don_ramon / #6476291 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5016918",
