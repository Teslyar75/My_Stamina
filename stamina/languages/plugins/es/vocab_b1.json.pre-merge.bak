    {
      "slug": "querer-verb",
      "lemma": "querer",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1557,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "хотеть",
          "желать"
        ],
        "en": [
          "to desire, to want, to want to",
          "to love; to be fond of (usually used with people or personified objects)",
          "would you ... ?",
          "to mean to, to try to"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2914",
          "text": "Querer es poder.",
          "translation": "Всё возможно - было бы желание.",
          "source": "Tatoeba #2914 @Shishir / #5646 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2914",
          "cefr_level": "A1",
          "word_slugs": [
            "querer-verb"
          ]
        },
        {
          "id": "1824805",
          "text": "No creo querer eso.",
          "translation": "Не думаю, что я этого хочу.",
          "source": "Tatoeba #1824805 @Shishir / #8695409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1824805",
          "cefr_level": "A1",
          "word_slugs": [
            "querer-verb"
          ]
        },
        {
          "id": "7764680",
          "text": "Lo hice sin querer.",
          "translation": "Я сделал это нечаянно.",
          "source": "Tatoeba #7764680 @arh / #1192640 @Imp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7764680",
          "cefr_level": "A1",
          "word_slugs": [
            "querer-verb"
          ]
        },
        {
          "id": "2411736",
          "text": "¿Qué más podría querer?",
          "translation": "Чего ещё я мог бы желать?",
          "source": "Tatoeba #2411736 @Shishir / #9105212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2411736",
          "cefr_level": "A1",
          "word_slugs": [
            "querer-verb"
          ]
        },
        {
          "id": "2011987",
          "text": "Vas a querer ver esto.",
          "translation": "Ты захочешь на это посмотреть.",
          "source": "Tatoeba #2011987 @marcelostockle / #7417763 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2011987",
          "cefr_level": "A1",
