          ]
        },
        {
          "id": "1252244",
          "text": "¿Cómo conseguiste ese dinero?",
          "translation": "Как ты достал эти деньги?",
          "source": "Tatoeba #1252244 @hayastan / #5320809 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1252244",
          "cefr_level": "A1",
          "word_slugs": [
            "conseguiste-verb"
          ]
        },
        {
          "id": "1837737",
          "text": "¿Dónde conseguiste la información?",
          "translation": "Где ты добыл информацию?",
          "source": "Tatoeba #1837737 @teskmon / #3053226 @kukla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1837737",
          "cefr_level": "A1",
          "word_slugs": [
            "conseguiste-verb"
          ]
        },
        {
          "id": "821419",
          "text": "¿Dónde conseguiste el dinero para comprar ese vestido?",
          "translation": "Где ты взяла деньги, чтобы купить это платье?",
          "source": "Tatoeba #821419 @darinmex / #5500409 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/821419",
          "cefr_level": "A1",
          "word_slugs": [
            "conseguiste-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
