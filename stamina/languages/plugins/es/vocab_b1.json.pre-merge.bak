      },
      "gender": null,
      "examples": [
        {
          "id": "563786",
          "text": "Ganamos la batalla.",
          "translation": "Мы выиграли битву.",
          "source": "Tatoeba #563786 @Shishir / #1728447 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/563786",
