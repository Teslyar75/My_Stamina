    {
      "slug": "hayan-verb",
      "lemma": "hayan",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1962,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of haber:",
          "third-person plural present subjunctive",
          "inflection of haber:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1638669",
          "text": "No creo que ellos nos hayan oído.",
          "translation": "Не думаю, что они нас слышали.",
          "source": "Tatoeba #1638669 @marcelostockle / #7371160 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1638669",
          "cefr_level": "A1",
          "word_slugs": [
            "hayan-verb"
          ]
        },
        {
          "id": "1086381",
          "text": "Sólo los que hayan pagado pueden entrar.",
          "translation": "Войти могут только те, кто заплатил.",
          "source": "Tatoeba #1086381 @hayastan / #5136370 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1086381",
          "cefr_level": "A1",
          "word_slugs": [
            "hayan-verb"
          ]
        },
        {
          "id": "882423",
          "text": "Que levanten las manos los que lo hayan entendido.",
          "translation": "Те, кто понял, поднимите руки.",
          "source": "Tatoeba #882423 @Shishir / #6294427 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/882423",
          "cefr_level": "A1",
          "word_slugs": [
            "hayan-verb"
          ]
        },
        {
          "id": "3933699",
          "text": "No recuerdo que ustedes hayan hablado algo de ese tema.",
          "translation": "Не помню, чтобы вы что-то говорили на эту тему.",
          "source": "Tatoeba #3933699 @gianich73 / #3933656 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3933699",
          "cefr_level": "A1",
          "word_slugs": [
            "hayan-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "hayan",
        "plural": "",
        "infinitive": "hayan"
      }
    },
    {
      "slug": "fueras-verb",
      "lemma": "fueras",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1963,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular imperfect subjunctive of ir",
          "second-person singular imperfect subjunctive of ser"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6589539",
          "text": "No sabía que fueras así.",
          "translation": "Я не знал, что ты такой.",
          "source": "Tatoeba #6589539 @arh / #7448338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6589539",
          "cefr_level": "A1",
          "word_slugs": [
            "fueras-verb"
          ]
        },
        {
          "id": "1618058",
          "text": "¿Qué harías si fueras rico?",
          "translation": "Что бы ты сделал, если бы был богат?",
          "source": "Tatoeba #1618058 @alexmarcelo / #13001798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1618058",
          "cefr_level": "A1",
          "word_slugs": [
            "fueras-verb"
          ]
        },
        {
          "id": "5755680",
          "text": "No sabía que fueras canadiense.",
          "translation": "Я не знал, что ты канадец.",
          "source": "Tatoeba #5755680 @arh / #4079219 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5755680",
          "cefr_level": "A1",
          "word_slugs": [
            "fueras-verb"
          ]
        },
        {
          "id": "12295110",
          "text": "Me gustaría que fueras conmigo.",
          "translation": "Я хотел бы, чтобы ты пошёл со мной.",
          "source": "Tatoeba #12295110 @Serrot / #2945582 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12295110",
          "cefr_level": "A1",
          "word_slugs": [
            "fueras-verb"
          ]
        },
        {
          "id": "3657026",
          "text": "Harías lo mismo si fueras yo.",
          "translation": "На моём месте ты бы сделал то же самое.",
          "source": "Tatoeba #3657026 @cueyayotl / #7184868 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3657026",
          "cefr_level": "A1",
          "word_slugs": [
            "fueras-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "fueras",
        "plural": "",
        "infinitive": "fueras"
      }
    },
    {
