    {
      "slug": "militar-adj",
      "lemma": "militar",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1920,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "military"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13644581",
          "text": "¿Volverá el servicio militar obligatorio?",
          "translation": "Вернётся ли обязательная воинская повинность?",
          "source": "Tatoeba #13644581 @Seael / #13644585 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13644581",
          "cefr_level": "A1",
          "word_slugs": [
            "militar-adj"
          ]
        },
        {
          "id": "1324095",
          "text": "Hice mi servicio militar en Ankara.",
          "translation": "Я проходил военную службу в Анкаре.",
          "source": "Tatoeba #1324095 @marcelostockle / #4427712 @caponych (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1324095",
          "cefr_level": "A1",
          "word_slugs": [
            "militar-adj"
          ]
        },
        {
          "id": "1410110",
          "text": "Ellos tienen un poderoso arsenal militar.",
          "translation": "У них есть мощный военный арсенал.",
          "source": "Tatoeba #1410110 @marcelostockle / #3344577 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1410110",
          "cefr_level": "A1",
          "word_slugs": [
            "militar-adj"
          ]
        },
        {
          "id": "558722",
          "text": "Hay una base militar cerca de aquí.",
          "translation": "Тут рядом военная база.",
          "source": "Tatoeba #558722 @darinmex / #8065068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/558722",
          "cefr_level": "A1",
          "word_slugs": [
            "militar-adj"
          ]
        },
        {
          "id": "1995868",
          "text": "El servicio militar obligatorio existe en Turquía.",
          "translation": "В Турции есть обязательная воинская служба.",
          "source": "Tatoeba #1995868 @Shishir / #5076268 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1995868",
          "cefr_level": "A1",
          "word_slugs": [
            "militar-adj"
          ]
        }
      ],
