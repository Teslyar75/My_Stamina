        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "399577",
          "text": "¿Irás en tren?",
          "translation": "Поедешь на поезде?",
          "source": "Tatoeba #399577 @catakaoe / #4327524 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399577",
          "cefr_level": "A1",
          "word_slugs": [
            "irás-verb"
          ]
        },
        {
          "id": "816540",
          "text": "¿Con quién irás?",
