    {
      "slug": "presente-intj",
      "lemma": "presente",
      "pos": "intj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1742,
      "frequency_band": "cervantes-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1139998",
          "text": "Deje que me presente.",
          "translation": "Позвольте представиться.",
          "source": "Tatoeba #1139998 @Shishir / #2335170 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1139998",
          "cefr_level": "A1",
          "word_slugs": [
            "presente-intj"
          ]
        },
        {
          "id": "2244113",
          "text": "Esta oración está en presente.",
          "translation": "Это предложение в настоящем времени.",
          "source": "Tatoeba #2244113 @Espi / #3229979 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2244113",
          "cefr_level": "A1",
          "word_slugs": [
            "presente-intj"
          ]
        },
        {
          "id": "5022812",
          "text": "No hace falta que se presente.",
          "translation": "Вам нет нужды представляться.",
          "source": "Tatoeba #5022812 @don_ramon / #6946958 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5022812",
          "cefr_level": "A1",
          "word_slugs": [
            "presente-intj"
          ]
        },
        {
          "id": "2295464",
          "text": "Él está presente en la reunión.",
          "translation": "Он присутствует на встрече.",
          "source": "Tatoeba #2295464 @marcelostockle / #4332016 @elread (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2295464",
          "cefr_level": "A1",
          "word_slugs": [
            "presente-intj"
          ]
        },
        {
          "id": "605675",
          "text": "¿Estabas presente cuando ocurrió el accidente?",
          "translation": "Ты присутствовал при аварии?",
          "source": "Tatoeba #605675 @Leono / #4519933 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/605675",
          "cefr_level": "A1",
          "word_slugs": [
            "presente-intj"
          ]
        }
