          "third-person singular present indicative",
          "inflection of alegrar:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1227570",
          "text": "Me alegra verte.",
          "translation": "Я рад тебя видеть.",
          "source": "Tatoeba #1227570 @wallebot / #1087772 @Katheriinne (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1227570",
          "cefr_level": "A1",
          "word_slugs": [
            "alegra-verb"
          ]
        },
        {
          "id": "2485018",
          "text": "Me alegra mucho.",
          "translation": "Меня это очень радует.",
          "source": "Tatoeba #2485018 @marcelostockle / #10962560 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2485018",
