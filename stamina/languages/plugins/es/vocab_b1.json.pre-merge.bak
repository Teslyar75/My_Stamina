          "national (native to a nation)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1237082",
          "text": "Hoy es fiesta nacional.",
          "translation": "Сегодня национальный праздник.",
          "source": "Tatoeba #1237082 @Shishir / #384555 @Dorenda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1237082",
          "cefr_level": "A1",
