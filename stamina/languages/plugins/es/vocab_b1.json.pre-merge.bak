      },
      "gender": null,
      "examples": [
        {
          "id": "1110824",
          "text": "Tom casi muere.",
          "translation": "Том чуть не умер.",
          "source": "Tatoeba #1110824 @jmdm78 / #4557972 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1110824",
          "cefr_level": "A1",
