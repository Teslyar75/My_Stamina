          "cefr_level": "A1",
          "word_slugs": [
            "estarán-verb"
          ]
        },
        {
          "id": "2115563",
          "text": "Estarán aquí a las tres.",
          "translation": "Они будут здесь в три.",
          "source": "Tatoeba #2115563 @Shishir / #3844470 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2115563",
