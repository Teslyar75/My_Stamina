          ]
        },
        {
          "id": "2781979",
          "text": "No quiero conducir.",
          "translation": "Я не хочу водить.",
          "source": "Tatoeba #2781979 @marcelostockle / #3632962 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2781979",
          "cefr_level": "A1",
