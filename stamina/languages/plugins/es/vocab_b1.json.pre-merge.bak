      },
      "gender": null,
      "examples": [
        {
          "id": "1506779",
          "text": "Las calles están sucias.",
          "translation": "Улицы грязные.",
          "source": "Tatoeba #1506779 @marco87 / #12298148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1506779",
