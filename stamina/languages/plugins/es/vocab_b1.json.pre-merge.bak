      "gender": null,
      "examples": [
        {
          "id": "2381242",
          "text": "Hice algunas llamadas.",
          "translation": "Я сделал несколько звонков.",
          "source": "Tatoeba #2381242 @hayastan / #2936976 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2381242",
