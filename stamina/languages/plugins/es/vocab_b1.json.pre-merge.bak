      "gender": null,
      "examples": [
        {
          "id": "3836051",
          "text": "¿Tuviste relaciones sexuales con él?",
          "translation": "У тебя были с ним интимные отношения?",
          "source": "Tatoeba #3836051 @cueyayotl / #3836164 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3836051",
          "cefr_level": "A1",
          "word_slugs": [
            "relaciones-noun"
          ]
        },
        {
          "id": "5854123",
          "text": "Las relaciones humanas son complejas.",
          "translation": "Человеческие взаимоотношения сложны.",
