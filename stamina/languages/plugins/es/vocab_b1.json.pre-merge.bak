    {
      "slug": "pon-verb",
      "lemma": "pon",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1834,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular imperative of poner"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6588234",
          "text": "Pon la mesa.",
          "translation": "Накрой на стол.",
          "source": "Tatoeba #6588234 @arh / #5048923 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6588234",
          "cefr_level": "A1",
          "word_slugs": [
            "pon-verb"
          ]
        },
        {
          "id": "5105639",
          "text": "Pon el vídeo.",
          "translation": "Включи видео.",
          "source": "Tatoeba #5105639 @ecorralest101 / #6778929 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5105639",
          "cefr_level": "A1",
          "word_slugs": [
            "pon-verb"
          ]
        },
        {
          "id": "6603974",
          "text": "Pon los faros.",
          "translation": "Включи фары.",
          "source": "Tatoeba #6603974 @arh / #5552553 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6603974",
          "cefr_level": "A1",
          "word_slugs": [
            "pon-verb"
          ]
        },
        {
          "id": "7860142",
          "text": "Pon más cuidado.",
          "translation": "Будь осторожнее.",
          "source": "Tatoeba #7860142 @arh / #904770 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7860142",
          "cefr_level": "A1",
          "word_slugs": [
            "pon-verb"
          ]
        },
        {
          "id": "12292504",
          "text": "Pon eso en el piso.",
          "translation": "Положи это на пол.",
          "source": "Tatoeba #12292504 @Serrot / #12293081 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12292504",
          "cefr_level": "A1",
