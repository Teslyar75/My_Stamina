    {
      "slug": "encantaría-verb",
      "lemma": "encantaría",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1486,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular conditional of encantar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "803412",
          "text": "Me encantaría tener tu edad.",
          "translation": "Хотел бы я быть сейчас в твоём возрасте.",
          "source": "Tatoeba #803412 @Shishir / #4421669 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/803412",
          "cefr_level": "A1",
          "word_slugs": [
            "encantaría-verb"
          ]
        },
        {
          "id": "3564777",
          "text": "Me encantaría conocer a Tom.",
          "translation": "Я бы с удовольствием познакомился с Томом.",
          "source": "Tatoeba #3564777 @ficion / #3566193 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3564777",
          "cefr_level": "A1",
          "word_slugs": [
            "encantaría-verb"
          ]
        },
        {
          "id": "1783244",
          "text": "Me encantaría una cerveza fría.",
          "translation": "Я бы с удовольствием выпил холодного пива.",
          "source": "Tatoeba #1783244 @marcelostockle / #7771223 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1783244",
          "cefr_level": "A1",
          "word_slugs": [
            "encantaría-verb"
          ]
        },
        {
          "id": "1440170",
          "text": "Me encantaría ayudarte si pudiera.",
          "translation": "Я бы с радостью тебе помог, если бы мог.",
          "source": "Tatoeba #1440170 @marcelostockle / #6441148 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1440170",
          "cefr_level": "A1",
          "word_slugs": [
            "encantaría-verb"
          ]
        },
        {
          "id": "931286",
          "text": "Me encantaría saber por qué ella dijo eso.",
          "translation": "Я хотел бы узнать, почему она так сказала.",
          "source": "Tatoeba #931286 @Sango / #1869003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/931286",
          "cefr_level": "A1",
          "word_slugs": [
            "encantaría-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
