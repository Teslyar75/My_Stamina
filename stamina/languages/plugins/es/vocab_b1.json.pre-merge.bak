    {
      "slug": "tirar-verb",
      "lemma": "tirar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2408,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to drop intentionally",
          "to throw, to toss",
          "to throw out, to toss, to dump",
          "to shoot; to launch"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3041615",
          "text": "¡Paren de tirar!",
          "translation": "Прекратите огонь!",
          "source": "Tatoeba #3041615 @hayastan / #2021533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3041615",
          "cefr_level": "A1",
          "word_slugs": [
            "tirar-verb"
          ]
        },
        {
          "id": "7160350",
          "text": "Tengo que tirar una pared.",
          "translation": "Я должен снести стену.",
          "source": "Tatoeba #7160350 @arh / #10265289 @TamilaRus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7160350",
          "cefr_level": "A1",
          "word_slugs": [
            "tirar-verb"
          ]
        },
        {
          "id": "5079477",
          "text": "Hay que tirar esos ordenadores viejos.",
          "translation": "Надо выбросить эти старые компьютеры.",
          "source": "Tatoeba #5079477 @diegohn / #5268703 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5079477",
          "cefr_level": "A1",
          "word_slugs": [
            "tirar-verb"
          ]
        },
        {
          "id": "4004883",
          "text": "Los chimpancés pueden tirar piedras cuando se sienten amenazados.",
          "translation": "Шимпанзе могут бросаться камнями, когда чувствуют угрозу.",
          "source": "Tatoeba #4004883 @hayastan / #4093992 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4004883",
          "cefr_level": "A1",
          "word_slugs": [
            "tirar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
