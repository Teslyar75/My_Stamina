    {
      "slug": "lástima-noun",
      "lemma": "lástima",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1884,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "pity"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10472080",
          "text": "Tom me dio lástima.",
          "translation": "Мне стало жаль Тома.",
          "source": "Tatoeba #10472080 @Shishir / #5593836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10472080",
          "cefr_level": "A1",
          "word_slugs": [
            "lástima-noun"
          ]
        },
        {
          "id": "2112204",
          "text": "No quiero lástima ni compasión.",
          "translation": "Я не хочу ни жалости, ни сострадания.",
          "source": "Tatoeba #2112204 @marcelostockle / #5133165 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2112204",
          "cefr_level": "A1",
          "word_slugs": [
            "lástima-noun"
          ]
        },
        {
          "id": "652718",
          "text": "Es una lástima que se divorcien.",
          "translation": "Жаль, что они разводятся.",
          "source": "Tatoeba #652718 @Shishir / #3522477 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/652718",
          "cefr_level": "A1",
          "word_slugs": [
            "lástima-noun"
          ]
        },
        {
          "id": "1101421",
          "text": "Este pobre perro me dio lástima.",
          "translation": "Мне стало жаль этого бедного пса.",
          "source": "Tatoeba #1101421 @Shishir / #10472085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1101421",
          "cefr_level": "A1",
          "word_slugs": [
            "lástima-noun"
          ]
        },
        {
          "id": "1132166",
          "text": "¡Qué lástima que no pueda venir!",
          "translation": "Как жаль, что она не может прийти!",
