    {
      "slug": "felicitaciones-noun",
      "lemma": "felicitaciones",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2248,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of felicitación"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2940915",
          "text": "¡Felicitaciones! ¡Sos un payaso!",
          "translation": "Поздравляю! Ты клоун!",
          "source": "Tatoeba #2940915 @hayastan / #2942332 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2940915",
          "cefr_level": "A1",
          "word_slugs": [
            "felicitaciones-noun"
          ]
        },
        {
          "id": "1553252",
          "text": "Oí decir que te jubilaste.¡Felicitaciones!",
          "translation": "Я слышал, что ты ушёл на пенсию. Поздравляю!",
          "source": "Tatoeba #1553252 @hayastan / #1553978 @BarinovDenis (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1553252",
          "cefr_level": "A1",
          "word_slugs": [
            "felicitaciones-noun"
          ]
        },
        {
          "id": "1006305",
          "text": "¿Estás embarazada? ¡Mis más sinceras felicitaciones!",
          "translation": "Ты беременна? От всей души поздравляю!",
          "source": "Tatoeba #1006305 @Shishir / #6144941 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1006305",
          "cefr_level": "A1",
          "word_slugs": [
            "felicitaciones-noun"
          ]
        },
        {
          "id": "13212358",
          "text": "Pues, felicitaciones. Lo arruinaste todo por completo.",
          "translation": "Ну что, поздравляю тебя. Ты окончательно всё испортил.",
          "source": "Tatoeba #13212358 @frpzzd / #13212326 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13212358",
          "cefr_level": "A1",
          "word_slugs": [
            "felicitaciones-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "felicitaciones",
        "plural": "",
        "infinitive": ""
      }
