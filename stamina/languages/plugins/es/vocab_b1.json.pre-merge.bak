      "translations": {
        "en": [
          "first/third-person singular imperfect indicative of conocer"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10061141",
          "text": "No la conocía.",
          "translation": "Я её не знал.",
          "source": "Tatoeba #10061141 @jxff / #8623083 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10061141",
          "cefr_level": "A1",
          "word_slugs": [
            "conocía-verb"
          ]
        },
        {
          "id": "4438812",
          "text": "Tom conocía a Mary.",
          "translation": "Том знал Мэри.",
          "source": "Tatoeba #4438812 @miren / #4453886 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4438812",
          "cefr_level": "A1",
          "word_slugs": [
            "conocía-verb"
          ]
        },
        {
          "id": "5750925",
          "text": "¿Conocía Tom a Mary?",
          "translation": "Том знал Мэри?",
          "source": "Tatoeba #5750925 @arh / #3478741 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5750925",
          "cefr_level": "A1",
          "word_slugs": [
            "conocía-verb"
          ]
        },
        {
          "id": "5757169",
          "text": "Ya conocía el resultado.",
          "translation": "Я уже знал результаты.",
          "source": "Tatoeba #5757169 @albrusgher / #5856763 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5757169",
          "cefr_level": "A1",
          "word_slugs": [
            "conocía-verb"
          ]
        },
        {
          "id": "5000975",
          "text": "No lo conocía muy bien.",
          "translation": "Я не очень хорошо его знал.",
          "source": "Tatoeba #5000975 @DarkHollow / #5000986 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5000975",
          "cefr_level": "A1",
          "word_slugs": [
            "conocía-verb"
          ]
        }
      ],
