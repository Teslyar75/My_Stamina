    {
      "slug": "ruego-noun",
      "lemma": "ruego",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2386,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plea, appeal"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "346545",
          "text": "Le ruego que me perdone.",
          "translation": "Я прошу вас простить меня.",
          "source": "Tatoeba #346545 @tatoerique / #2372912 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/346545",
          "cefr_level": "A1",
          "word_slugs": [
            "ruego-noun"
          ]
        },
        {
          "id": "1642563",
          "text": "Te ruego que no me interrumpas.",
          "translation": "Умоляю тебя, не перебивай меня.",
          "source": "Tatoeba #1642563 @Agar / #3985890 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1642563",
          "cefr_level": "A1",
          "word_slugs": [
            "ruego-noun"
          ]
        },
        {
          "id": "2179046",
          "text": "Dame una botella, ¡te lo ruego!",
          "translation": "Дай мне бутылку, умоляю!",
          "source": "Tatoeba #2179046 @marcelostockle / #6835017 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2179046",
          "cefr_level": "A1",
          "word_slugs": [
            "ruego-noun"
          ]
        },
        {
          "id": "1585408",
          "text": "Os lo ruego, dadme otra oportunidad.",
          "translation": "Умоляю вас, дайте мне ещё один шанс.",
          "source": "Tatoeba #1585408 @Shishir / #6171350 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1585408",
          "cefr_level": "A1",
          "word_slugs": [
            "ruego-noun"
          ]
        },
        {
          "id": "1599677",
          "text": "Te ruego que me digas la verdad.",
          "translation": "Умоляю тебя, скажи мне правду.",
          "source": "Tatoeba #1599677 @marcelostockle / #3447947 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1599677",
          "cefr_level": "A1",
          "word_slugs": [
            "ruego-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "ruego",
        "plural": "",
        "infinitive": ""
      }
