          ]
        },
        {
          "id": "2217040",
          "text": "¿Necesitamos un plan B?",
          "translation": "Нам нужен план Б?",
          "source": "Tatoeba #2217040 @Shishir / #3256051 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2217040",
          "cefr_level": "A1",
          "word_slugs": [
            "b-character"
          ]
        },
        {
          "id": "8443369",
          "text": "¿Y cuál es el puto plan B?",
