    {
      "slug": "consigue-verb",
      "lemma": "consigue",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2070,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of conseguir:",
          "third-person singular present indicative",
          "inflection of conseguir:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1165939",
          "text": "Nada se consigue sin luchar.",
          "translation": "Ничего не достигается без борьбы.",
          "source": "Tatoeba #1165939 @nancy / #4069605 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1165939",
          "cefr_level": "A1",
          "word_slugs": [
            "consigue-verb"
          ]
        },
        {
          "id": "2789",
          "text": "Nada se consigue sin esfuerzo.",
          "translation": "Без усилий ничего не добьешься.",
          "source": "Tatoeba #2789 @Shishir / #2717143 @Leonid204 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2789",
          "cefr_level": "A1",
          "word_slugs": [
            "consigue-verb"
          ]
        },
        {
          "id": "5607215",
          "text": "¿Cuánto consigue usted dormir usualmente?",
          "translation": "Сколько Вам обычно удаётся поспать?",
          "source": "Tatoeba #5607215 @Omnivoro / #5607751 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607215",
          "cefr_level": "A1",
          "word_slugs": [
            "consigue-verb"
          ]
        },
        {
          "id": "1285705",
          "text": "El que la sigue, la consigue.",
          "translation": "Терпение и труд всё перетрут.",
          "source": "Tatoeba #1285705 @enteka / #432546 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1285705",
          "cefr_level": "A1",
          "word_slugs": [
            "consigue-verb"
          ]
        },
        {
          "id": "1627616",
          "text": "El éxito se consigue con constancia.",
          "translation": "Успех достигается постоянством.",
          "source": "Tatoeba #1627616 @wallebot / #6139914 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1627616",
          "cefr_level": "A1",
          "word_slugs": [
            "consigue-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
