        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9636758",
          "text": "¿Por qué unidad vais?",
          "translation": "Из какого вы подразделения?",
          "source": "Tatoeba #9636758 @Shishir / #9942229 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9636758",
          "cefr_level": "A1",
          "word_slugs": [
            "unidad-noun"
          ]
        },
        {
          "id": "4508607",
          "text": "Unidad en la diversidad.",
          "translation": "Единство в разнообразии.",
          "source": "Tatoeba #4508607 @cueyayotl / #5515702 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4508607",
          "cefr_level": "A1",
          "word_slugs": [
            "unidad-noun"
          ]
        },
        {
          "id": "6119320",
          "text": "Una frase es una unidad sintáctica.",
          "translation": "Предложение - это синтаксическая единица.",
          "source": "Tatoeba #6119320 @baudelaire / #6487751 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6119320",
          "cefr_level": "A1",
          "word_slugs": [
            "unidad-noun"
          ]
        },
        {
          "id": "3302498",
          "text": "La unidad es el principio de todo.",
          "translation": "Единое есть начало всего.",
          "source": "Tatoeba #3302498 @gianich73 / #1012248 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3302498",
          "cefr_level": "A1",
          "word_slugs": [
            "unidad-noun"
          ]
        },
        {
          "id": "3464036",
          "text": "La unidad de tiempo es el segundo.",
          "translation": "Единица времени - секунда.",
          "source": "Tatoeba #3464036 @hayastan / #5534429 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3464036",
          "cefr_level": "A1",
          "word_slugs": [
            "unidad-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
