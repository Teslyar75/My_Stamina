    {
      "slug": "víctimas-noun",
      "lemma": "víctimas",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1801,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of víctima"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1112736",
          "text": "¿Cuántas víctimas hubo?",
          "translation": "Сколько было жертв?",
          "source": "Tatoeba #1112736 @alexmarcelo / #5084595 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1112736",
          "cefr_level": "A1",
          "word_slugs": [
            "víctimas-noun"
          ]
        },
        {
          "id": "7038079",
          "text": "Hubo numerosas víctimas.",
          "translation": "Было много жертв.",
          "source": "Tatoeba #7038079 @arh / #13098107 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7038079",
          "cefr_level": "A1",
          "word_slugs": [
            "víctimas-noun"
          ]
        },
        {
          "id": "5451327",
          "text": "Había víctimas por todas partes.",
          "translation": "Повсюду были жертвы.",
          "source": "Tatoeba #5451327 @Seael / #6146697 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5451327",
          "cefr_level": "A1",
          "word_slugs": [
            "víctimas-noun"
          ]
        },
        {
          "id": "1845451",
          "text": "Siento una profunda simpatía por las víctimas.",
          "translation": "Я испытываю глубокое сочувствие к жертвам.",
          "source": "Tatoeba #1845451 @topofabi / #12925048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1845451",
          "cefr_level": "A1",
          "word_slugs": [
            "víctimas-noun"
          ]
        },
        {
