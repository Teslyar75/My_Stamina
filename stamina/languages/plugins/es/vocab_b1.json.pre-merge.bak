      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "minister"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1860140",
          "text": "Él fue nombrado ministro de finanzas.",
          "translation": "Его назначили министром финансов.",
          "source": "Tatoeba #1860140 @marcelostockle / #750595 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1860140",
          "cefr_level": "A1",
          "word_slugs": [
            "ministro-noun"
          ]
        },
        {
          "id": "1630824",
          "text": "Su padre es el Ministro de Turismo.",
          "translation": "Его отец - министр туризма.",
          "source": "Tatoeba #1630824 @hayastan / #2997328 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1630824",
          "cefr_level": "A1",
          "word_slugs": [
            "ministro-noun"
          ]
        },
        {
          "id": "1695051",
          "text": "Es el primer viaje oficial del ministro.",
          "translation": "Это первая официальная поездка министра.",
          "source": "Tatoeba #1695051 @marcelostockle / #5281737 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1695051",
          "cefr_level": "A1",
          "word_slugs": [
            "ministro-noun"
          ]
        },
        {
          "id": "646137",
          "text": "El ministro aprobó los planes de construcción.",
          "translation": "Министр одобрил планы строительства.",
          "source": "Tatoeba #646137 @darinmex / #2207188 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/646137",
          "cefr_level": "A1",
          "word_slugs": [
            "ministro-noun"
          ]
        },
        {
          "id": "2884066",
          "text": "La prostituta comenzó a chantajear al ministro.",
          "translation": "Проститутка начала шантажировать министра.",
          "source": "Tatoeba #2884066 @marcelostockle / #5812446 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2884066",
          "cefr_level": "A1",
          "word_slugs": [
            "ministro-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
