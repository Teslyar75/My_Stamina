      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "combat"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3793633",
          "text": "Combate tus miedos.",
          "translation": "Борись со своими страхами.",
          "source": "Tatoeba #3793633 @Seael / #9943501 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3793633",
          "cefr_level": "A1",
          "word_slugs": [
            "combate-noun"
          ]
        },
        {
          "id": "1597602",
          "text": "Lo hirieron en combate.",
          "translation": "Его ранило в бою.",
          "source": "Tatoeba #1597602 @Alba / #6391582 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1597602",
          "cefr_level": "A1",
          "word_slugs": [
            "combate-noun"
          ]
        },
        {
          "id": "1112543",
          "text": "El soldado fue asesinado en combate.",
          "translation": "Солдат был убит в бою.",
          "source": "Tatoeba #1112543 @karenm2s / #3043370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1112543",
          "cefr_level": "A1",
          "word_slugs": [
            "combate-noun"
          ]
        },
        {
          "id": "1288621",
          "text": "¿Será verdad que el huevo podrido combate la impotencia sexual?",
          "translation": "Правда ли, что тухлые яйца помогают при половом бессилии?",
          "source": "Tatoeba #1288621 @hayastan / #6887413 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1288621",
          "cefr_level": "A1",
          "word_slugs": [
            "combate-noun"
          ]
        }
      ],
