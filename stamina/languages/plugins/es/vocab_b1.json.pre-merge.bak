    {
      "slug": "oí-verb",
      "lemma": "oí",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1224,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of oír:",
          "first-person singular preterite indicative",
          "inflection of oír:",
          "second-person singular voseo imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3371691",
          "text": "Oí un grito.",
          "translation": "Я слышал крик.",
          "source": "Tatoeba #3371691 @marcelostockle / #2608470 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3371691",
          "cefr_level": "A1",
          "word_slugs": [
            "oí-verb"
          ]
        },
        {
          "id": "3197629",
          "text": "Oí el mensaje.",
          "translation": "Я слышал сообщение.",
          "source": "Tatoeba #3197629 @Shishir / #3262685 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3197629",
          "cefr_level": "A1",
          "word_slugs": [
            "oí-verb"
          ]
        },
        {
          "id": "5566475",
          "text": "Oí la campana.",
          "translation": "Я слышал колокол.",
          "source": "Tatoeba #5566475 @swyter / #6560704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5566475",
          "cefr_level": "A1",
          "word_slugs": [
            "oí-verb"
          ]
        },
        {
          "id": "602667",
          "text": "La oí cantando.",
          "translation": "Я слышал, как она поёт.",
          "source": "Tatoeba #602667 @darinmex / #4052479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/602667",
          "cefr_level": "A1",
          "word_slugs": [
            "oí-verb"
          ]
        },
        {
          "id": "12795655",
          "text": "Te oí estornudar.",
          "translation": "Я слышал, как ты чихнул.",
          "source": "Tatoeba #12795655 @Tom9358 / #12795659 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12795655",
          "cefr_level": "A1",
          "word_slugs": [
            "oí-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
