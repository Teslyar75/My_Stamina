          "speech"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2758282",
          "text": "¿Debo dar un discurso?",
          "translation": "Я должен выступить с речью?",
          "source": "Tatoeba #2758282 @marcelostockle / #5379115 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2758282",
          "cefr_level": "A1",
          "word_slugs": [
            "discurso-noun"
          ]
        },
        {
          "id": "1247901",
          "text": "Daré un discurso mañana.",
          "translation": "Завтра я выступлю с речью.",
          "source": "Tatoeba #1247901 @hayastan / #9583460 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1247901",
          "cefr_level": "A1",
          "word_slugs": [
            "discurso-noun"
          ]
        },
        {
          "id": "639476",
          "text": "Su discurso fue excelente.",
          "translation": "Его речь была прекрасна.",
          "source": "Tatoeba #639476 @darinmex / #1436728 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/639476",
          "cefr_level": "A1",
          "word_slugs": [
            "discurso-noun"
          ]
        },
        {
          "id": "2530457",
          "text": "Tu discurso fue espléndido.",
          "translation": "Твоя речь была великолепной.",
          "source": "Tatoeba #2530457 @marcelostockle / #5668793 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2530457",
          "cefr_level": "A1",
          "word_slugs": [
            "discurso-noun"
          ]
        },
        {
          "id": "2161788",
          "text": "Tom dio un buen discurso.",
          "translation": "Том выступил с хорошей речью.",
          "source": "Tatoeba #2161788 @Shishir / #5715214 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2161788",
