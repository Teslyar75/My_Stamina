    {
      "slug": "tamaño-adj",
      "lemma": "tamaño",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2053,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "as big or small; equivalent in size; so big/so small; such a big/small"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "599180",
          "text": "El tamaño no importa.",
          "translation": "Размер не имеет значения.",
          "source": "Tatoeba #599180 @Shishir / #1655013 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/599180",
          "cefr_level": "A1",
          "word_slugs": [
            "tamaño-adj"
          ]
        },
        {
          "id": "1640108",
          "text": "El tamaño sí importa.",
          "translation": "Размер имеет значение.",
          "source": "Tatoeba #1640108 @marcelostockle / #3537104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1640108",
          "cefr_level": "A1",
          "word_slugs": [
            "tamaño-adj"
          ]
        },
        {
          "id": "1630860",
          "text": "¡Mirá el tamaño de esta fila!",
          "translation": "Ты посмотри на длину этой очереди!",
          "source": "Tatoeba #1630860 @hayastan / #5347102 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1630860",
          "cefr_level": "A1",
          "word_slugs": [
            "tamaño-adj"
          ]
        },
        {
          "id": "1290159",
          "text": "¡Mirá el tamaño de este avión!",
          "translation": "Гляди на размер этого самолёта!",
          "source": "Tatoeba #1290159 @hayastan / #3841003 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1290159",
          "cefr_level": "A1",
          "word_slugs": [
            "tamaño-adj"
          ]
        },
        {
          "id": "537831",
          "text": "Los zapatos son del mismo tamaño.",
          "translation": "Туфли одного размера.",
          "source": "Tatoeba #537831 @Shishir / #6139384 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/537831",
          "cefr_level": "A1",
