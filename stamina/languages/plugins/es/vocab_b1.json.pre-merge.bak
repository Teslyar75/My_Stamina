          "hair (mass of hairs)",
          "hair strand"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4485579",
          "text": "Tu cabello es bonito.",
          "translation": "У тебя красивые волосы.",
          "source": "Tatoeba #4485579 @cueyayotl / #2622016 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4485579",
