    {
      "slug": "enorme-adj",
      "lemma": "enorme",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1473,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "огромный"
        ],
        "en": [
          "enormous, huge"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5014005",
          "text": "Rusia es enorme.",
          "translation": "Россия огромна.",
          "source": "Tatoeba #5014005 @don_ramon / #5038401 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5014005",
          "cefr_level": "A1",
          "word_slugs": [
            "enorme-adj"
          ]
        },
        {
          "id": "1526272",
          "text": "¡Ese animal es enorme!",
          "translation": "Это животное огромное!",
          "source": "Tatoeba #1526272 @marcelostockle / #7329507 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1526272",
          "cefr_level": "A1",
          "word_slugs": [
            "enorme-adj"
          ]
        },
        {
          "id": "5115715",
          "text": "Vuestra casa es enorme.",
          "translation": "Ваш дом огромен.",
          "source": "Tatoeba #5115715 @helpa / #6300853 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5115715",
          "cefr_level": "A1",
          "word_slugs": [
            "enorme-adj"
          ]
        },
        {
          "id": "3625281",
          "text": "Brasil es enorme, ¿verdad?",
          "translation": "Бразилия огромна, правда?",
          "source": "Tatoeba #3625281 @cueyayotl / #6113023 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3625281",
          "cefr_level": "A1",
          "word_slugs": [
            "enorme-adj"
          ]
        },
        {
          "id": "2228132",
          "text": "Una enorme multitud esperaba.",
          "translation": "Огромная толпа людей ждала.",
          "source": "Tatoeba #2228132 @marcelostockle / #4420789 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2228132",
          "cefr_level": "A1",
          "word_slugs": [
            "enorme-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
