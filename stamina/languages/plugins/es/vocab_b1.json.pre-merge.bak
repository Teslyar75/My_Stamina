          "a third (interval)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2259584",
          "text": "Viven en la Tercera Avenida.",
          "translation": "Они живут на Третьей авеню.",
          "source": "Tatoeba #2259584 @cueyayotl / #6572191 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259584",
          "cefr_level": "A1",
          "word_slugs": [
            "tercera-noun"
          ]
        },
        {
          "id": "7726605",
          "text": "Estamos en la tercera planta.",
          "translation": "Мы на третьем этаже.",
          "source": "Tatoeba #7726605 @arh / #7726968 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7726605",
          "cefr_level": "A1",
          "word_slugs": [
            "tercera-noun"
          ]
        },
        {
          "id": "1783160",
          "text": "No hay una tercera oportunidad.",
