    {
      "slug": "derechos-adj",
      "lemma": "derechos",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2058,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "masculine plural of derecho"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4593949",
          "text": "Yo tengo derechos.",
          "translation": "У меня есть права.",
          "source": "Tatoeba #4593949 @Francisco_M / #2785483 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4593949",
          "cefr_level": "A1",
          "word_slugs": [
            "derechos-adj"
          ]
        },
        {
          "id": "4009418",
          "text": "Conoces tus derechos.",
          "translation": "Ты знаешь свои права.",
          "source": "Tatoeba #4009418 @alexmarcelo / #4171944 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4009418",
          "cefr_level": "A1",
          "word_slugs": [
            "derechos-adj"
          ]
        },
        {
          "id": "3389832",
          "text": "¿Cuáles son sus derechos?",
          "translation": "Какие у них права?",
          "source": "Tatoeba #3389832 @marcelostockle / #7874084 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3389832",
          "cefr_level": "A1",
          "word_slugs": [
            "derechos-adj"
          ]
        },
        {
          "id": "1001342",
          "text": "Todos tenemos derechos y deberes.",
          "translation": "У всех нас есть права и обязанности.",
          "source": "Tatoeba #1001342 @Shishir / #5511190 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1001342",
          "cefr_level": "A1",
          "word_slugs": [
            "derechos-adj"
          ]
        },
        {
          "id": "3540663",
          "text": "Nosotros luchamos por los mismos derechos.",
          "translation": "Мы боремся за равные права.",
          "source": "Tatoeba #3540663 @hayastan / #3540792 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3540663",
          "cefr_level": "A1",
