    {
      "slug": "preguntaba-verb",
      "lemma": "preguntaba",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2100,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect indicative of preguntar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2104007",
          "text": "Tom se preguntaba lo mismo.",
          "translation": "Том задавался тем же вопросом.",
          "source": "Tatoeba #2104007 @marcelostockle / #3984891 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2104007",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntaba-verb"
          ]
        },
        {
          "id": "3209977",
          "text": "Ella se preguntaba por qué lo hizo.",
          "translation": "Она задавалась вопросом, почему он это сделал.",
          "source": "Tatoeba #3209977 @Shishir / #9799333 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3209977",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntaba-verb"
          ]
        },
        {
          "id": "2440544",
          "text": "Él se preguntaba por qué ella hizo eso.",
          "translation": "Он задавался вопросом, почему она это сделала.",
          "source": "Tatoeba #2440544 @marcelostockle / #3211317 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2440544",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntaba-verb"
          ]
        },
        {
          "id": "5746387",
          "text": "Tom se preguntaba por que su esposa lo dejó.",
          "translation": "Том спрашивал себя, почему от него ушла жена.",
          "source": "Tatoeba #5746387 @baudelaire / #7807423 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5746387",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntaba-verb"
          ]
        },
        {
          "id": "2968299",
          "text": "Tom se preguntaba por qué todos lo miraban fijamente.",
          "translation": "Том спрашивал себя, почему все пристально смотрят на него?",
          "source": "Tatoeba #2968299 @marcelostockle / #2968823 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2968299",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntaba-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
