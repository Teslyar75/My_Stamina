    {
      "slug": "hubieras-verb",
      "lemma": "hubieras",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1779,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular imperfect subjunctive of haber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3073656",
          "text": "Me hubieras dicho algo antes.",
          "translation": "Ты мог бы рассказать мне об этом раньше.",
          "source": "Tatoeba #3073656 @cueyayotl / #3073643 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3073656",
          "cefr_level": "A1",
          "word_slugs": [
            "hubieras-verb"
          ]
        },
        {
          "id": "6119303",
          "text": "Parece que hubieras visto un fantasma.",
          "translation": "Ты как будто увидел привидение.",
          "source": "Tatoeba #6119303 @baudelaire / #6131380 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6119303",
          "cefr_level": "A1",
          "word_slugs": [
            "hubieras-verb"
          ]
        },
        {
          "id": "3355192",
          "text": "Si hubieras preguntado, yo te lo habría dicho.",
          "translation": "Если бы ты спросил, я бы тебе сказал.",
          "source": "Tatoeba #3355192 @carlosalberto / #3357184 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3355192",
          "cefr_level": "A1",
          "word_slugs": [
            "hubieras-verb"
          ]
        },
        {
          "id": "623388",
          "text": "Si me hubieras ayudado, podría haber terminado el trabajo.",
          "translation": "Если бы ты помог мне, я бы смог закончить свою работу.",
          "source": "Tatoeba #623388 @clerval / #3295948 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/623388",
          "cefr_level": "A1",
          "word_slugs": [
            "hubieras-verb"
          ]
        },
        {
          "id": "1684192",
          "text": "Si solo me hubieras escuchado, nada de esto hubiera pasado.",
          "translation": "Если бы ты только меня послушал, ничего этого бы не случилось.",
          "source": "Tatoeba #1684192 @marcelostockle / #3835367 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684192",
          "cefr_level": "A1",
          "word_slugs": [
            "hubieras-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "hubieras",
        "plural": "",
        "infinitive": "hubieras"
      }
    },
    {
      "slug": "últimamente-adv",
      "lemma": "últimamente",
      "pos": "adv",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1780,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "recently, lately"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "755816",
          "text": "He engordado últimamente.",
          "translation": "Я прибавил в весе за последнее время.",
          "source": "Tatoeba #755816 @Shishir / #2777892 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/755816",
          "cefr_level": "A1",
          "word_slugs": [
            "últimamente-adv"
          ]
        },
        {
          "id": "359483",
          "text": "Estoy ocupado últimamente.",
          "translation": "В последнее время я занят.",
          "source": "Tatoeba #359483 @tatoerique / #5082047 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/359483",
          "cefr_level": "A1",
          "word_slugs": [
            "últimamente-adv"
          ]
        },
        {
          "id": "551093",
          "text": "¿Qué has hecho últimamente?",
          "translation": "Что ты сделал за последнее время?",
          "source": "Tatoeba #551093 @darinmex / #3289510 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/551093",
          "cefr_level": "A1",
          "word_slugs": [
            "últimamente-adv"
          ]
        },
        {
          "id": "1661864",
          "text": "No duermo bien últimamente.",
          "translation": "Я в последнее время неважно сплю.",
          "source": "Tatoeba #1661864 @wallebot / #10310367 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1661864",
          "cefr_level": "A1",
          "word_slugs": [
            "últimamente-adv"
          ]
        },
        {
          "id": "855095",
          "text": "Ella ha engordado últimamente.",
          "translation": "Она прибавила в весе за последнее время.",
          "source": "Tatoeba #855095 @Coyolxauhqui / #9733533 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/855095",
          "cefr_level": "A1",
          "word_slugs": [
            "últimamente-adv"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "últimamente",
        "plural": "",
        "infinitive": ""
      }
