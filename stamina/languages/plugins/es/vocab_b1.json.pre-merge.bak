      "examples": [
        {
          "id": "3250474",
          "text": "Tengo mis propios problemas.",
          "translation": "У меня есть свои проблемы.",
          "source": "Tatoeba #3250474 @Shishir / #7790584 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3250474",
