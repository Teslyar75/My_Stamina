      },
      "gender": null,
      "examples": [
        {
          "id": "4069866",
          "text": "Tom trabaja en dos lugares.",
          "translation": "Том работает на двух работах.",
          "source": "Tatoeba #4069866 @gianich73 / #4069395 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4069866",
          "cefr_level": "A1",
          "word_slugs": [
            "lugares-noun"
          ]
        },
        {
          "id": "2720168",
          "text": "¿Qué lugares le gustaría visitar?",
          "translation": "Какие места Вы бы хотели посетить?",
          "source": "Tatoeba #2720168 @Shishir / #2720181 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2720168",
          "cefr_level": "A1",
          "word_slugs": [
            "lugares-noun"
          ]
        },
        {
          "id": "2387944",
          "text": "No se fuma en lugares públicos.",
          "translation": "В общественных местах не курят.",
          "source": "Tatoeba #2387944 @diegohn / #5268631 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2387944",
          "cefr_level": "A1",
          "word_slugs": [
            "lugares-noun"
          ]
        },
        {
          "id": "3041712",
          "text": "Tengo miedo a los lugares cerrados.",
          "translation": "У меня боязнь замкнутых пространств.",
          "source": "Tatoeba #3041712 @emigonza / #3041914 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3041712",
          "cefr_level": "A1",
          "word_slugs": [
            "lugares-noun"
          ]
        },
        {
          "id": "931627",
          "text": "Hay muchos lugares bonitos en Japón.",
          "translation": "В Японии много красивых мест.",
          "source": "Tatoeba #931627 @azulmarino / #4614988 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/931627",
          "cefr_level": "A1",
          "word_slugs": [
            "lugares-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
