    {
      "slug": "médicos-adj",
      "lemma": "médicos",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2106,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "masculine plural of médico"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1649186",
          "text": "Ellos son médicos.",
          "translation": "Они врачи.",
          "source": "Tatoeba #1649186 @alexmarcelo / #3195949 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1649186",
          "cefr_level": "A1",
          "word_slugs": [
            "médicos-adj"
          ]
        },
        {
          "id": "1617933",
          "text": "Los médicos salvan vidas.",
          "translation": "Врачи спасают жизни.",
          "source": "Tatoeba #1617933 @Alba / #3571701 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1617933",
          "cefr_level": "A1",
          "word_slugs": [
            "médicos-adj"
          ]
        },
        {
          "id": "2898233",
          "text": "Brasil necesita más médicos.",
          "translation": "Бразилии нужно больше врачей.",
          "source": "Tatoeba #2898233 @hayastan / #2898720 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2898233",
          "cefr_level": "A1",
          "word_slugs": [
            "médicos-adj"
          ]
        },
        {
          "id": "2787412",
          "text": "No me gustan los médicos.",
          "translation": "Не люблю врачей.",
          "source": "Tatoeba #2787412 @cueyayotl / #2787134 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2787412",
          "cefr_level": "A1",
          "word_slugs": [
            "médicos-adj"
          ]
        },
        {
          "id": "1674992",
          "text": "¿Conoces médicos que hablen japonés?",
          "translation": "У тебя есть знакомые врачи, говорящие по-японски?",
          "source": "Tatoeba #1674992 @termito2nd / #11138983 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1674992",
          "cefr_level": "A1",
          "word_slugs": [
