    {
      "slug": "propiedad-noun",
      "lemma": "propiedad",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1933,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "propriety (fact of possessing something), proprietary",
          "property, belongings, estate (something that is possessed especially a real estate)",
          "ownership (state of possessing something)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "480358",
          "text": "La propiedad es mía.",
          "translation": "Собственность моя.",
          "source": "Tatoeba #480358 @quarzoliquido / #3211917 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/480358",
          "cefr_level": "A1",
          "word_slugs": [
            "propiedad-noun"
          ]
        },
        {
          "id": "5069334",
          "text": "La propiedad es un robo.",
          "translation": "Собственность есть кража.",
          "source": "Tatoeba #5069334 @ecorralest101 / #5069335 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5069334",
          "cefr_level": "A1",
          "word_slugs": [
            "propiedad-noun"
          ]
        },
        {
          "id": "783605",
          "text": "Esta tierra es mi propiedad.",
          "translation": "Эта земля — моя собственность.",
          "source": "Tatoeba #783605 @newyears1985 / #1525152 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/783605",
          "cefr_level": "A1",
          "word_slugs": [
            "propiedad-noun"
          ]
        },
        {
          "id": "1617603",
          "text": "Esta es una propiedad privada.",
          "translation": "Это частная собственность.",
          "source": "Tatoeba #1617603 @Shishir / #3571699 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1617603",
          "cefr_level": "A1",
          "word_slugs": [
            "propiedad-noun"
          ]
        },
        {
          "id": "1313012",
          "text": "Ellos no tienen derechos sobre la propiedad.",
          "translation": "У них нет прав на собственность.",
          "source": "Tatoeba #1313012 @marcelostockle / #6045005 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1313012",
          "cefr_level": "A1",
          "word_slugs": [
            "propiedad-noun"
          ]
        }
      ],
      "tags": [
