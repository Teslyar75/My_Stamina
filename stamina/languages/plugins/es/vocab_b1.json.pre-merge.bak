    {
      "slug": "pensó-verb",
      "lemma": "pensó",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2089,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular preterite indicative of pensar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3012366",
          "text": "Ella pensó en todo.",
          "translation": "Она всё обдумала.",
          "source": "Tatoeba #3012366 @hayastan / #3013808 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3012366",
          "cefr_level": "A1",
          "word_slugs": [
            "pensó-verb"
          ]
        },
        {
          "id": "1218279",
          "text": "Tom no pensó en eso.",
          "translation": "Том не подумал об этом.",
          "source": "Tatoeba #1218279 @darinmex / #4283610 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1218279",
          "cefr_level": "A1",
          "word_slugs": [
            "pensó-verb"
          ]
        },
        {
          "id": "1278929",
          "text": "Tom pensó que era extraño.",
          "translation": "Том подумал, что это странно.",
          "source": "Tatoeba #1278929 @marcelostockle / #5566127 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1278929",
          "cefr_level": "A1",
          "word_slugs": [
            "pensó-verb"
          ]
        },
        {
          "id": "3357718",
          "text": "No sé en qué pensó Tom.",
          "translation": "Не знаю, о чём думал Том.",
          "source": "Tatoeba #3357718 @marcelostockle / #3360901 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3357718",
          "cefr_level": "A1",
          "word_slugs": [
            "pensó-verb"
          ]
        },
        {
          "id": "722459",
          "text": "Ella pensó en un buen plan.",
          "translation": "Она придумала хороший план.",
          "source": "Tatoeba #722459 @Shishir / #426517 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/722459",
          "cefr_level": "A1",
          "word_slugs": [
            "pensó-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "pensó",
        "plural": "",
        "infinitive": "pensó"
      }
