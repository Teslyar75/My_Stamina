          ]
        },
        {
          "id": "10689911",
          "text": "No te preocupes, tengo un plan B.",
          "translation": "Не беспокойся, у меня есть план Б.",
          "source": "Tatoeba #10689911 @Ekim / #9144056 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10689911",
          "cefr_level": "A1",
          "word_slugs": [
            "b-character"
          ]
        },
        {
          "id": "2666837",
          "text": "¿Cuál es la diferencia entre A y B?",
