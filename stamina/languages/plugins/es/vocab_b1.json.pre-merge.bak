            "irá-verb"
          ]
        },
        {
          "id": "3763461",
          "text": "¿Quién irá conmigo?",
          "translation": "Кто со мной пойдёт?",
          "source": "Tatoeba #3763461 @marcelostockle / #4868156 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3763461",
          "cefr_level": "A1",
          "word_slugs": [
            "irá-verb"
          ]
        },
        {
          "id": "2201441",
