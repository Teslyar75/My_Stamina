    {
      "slug": "hayas-noun",
      "lemma": "hayas",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1215,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of haya"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1466280",
          "text": "Llámame cuando hayas llegado.",
          "translation": "Позвони мне, как приедешь.",
          "source": "Tatoeba #1466280 @marcelostockle / #889046 @nadya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1466280",
          "cefr_level": "A1",
          "word_slugs": [
            "hayas-noun"
          ]
        },
        {
          "id": "3037678",
          "text": "Espero que hayas dormido bien.",
          "translation": "Надеюсь, ты хорошо спал.",
          "source": "Tatoeba #3037678 @alexmarcelo / #3037690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3037678",
          "cefr_level": "A1",
          "word_slugs": [
            "hayas-noun"
          ]
        },
        {
          "id": "5950112",
          "text": "Cuando hayas acabado, sal afuera.",
          "translation": "Когда закончишь, выйди.",
          "source": "Tatoeba #5950112 @arh / #5951706 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5950112",
          "cefr_level": "A1",
          "word_slugs": [
            "hayas-noun"
          ]
        },
        {
          "id": "5950061",
          "text": "Cuando hayas acabado, apaga la luz.",
          "translation": "Как закончишь, выключи свет.",
          "source": "Tatoeba #5950061 @arh / #5951729 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5950061",
          "cefr_level": "A1",
          "word_slugs": [
            "hayas-noun"
          ]
        },
        {
          "id": "5950129",
          "text": "Cuando hayas acabado, vete de aquí.",
          "translation": "Когда закончишь, уходи отсюда.",
          "source": "Tatoeba #5950129 @arh / #5951718 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5950129",
          "cefr_level": "A1",
          "word_slugs": [
            "hayas-noun"
          ]
        }
      ],
