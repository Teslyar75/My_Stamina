    {
      "slug": "sepas-verb",
      "lemma": "sepas",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1757,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular present subjunctive of saber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3410154",
          "text": "Quiero que sepas.",
          "translation": "Я хочу, чтобы ты знал.",
          "source": "Tatoeba #3410154 @gianich73 / #3410149 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3410154",
          "cefr_level": "A1",
          "word_slugs": [
            "sepas-verb"
          ]
        },
        {
          "id": "10948426",
          "text": "Infórmanos cuando sepas algo.",
          "translation": "Сообщи нам, как что-нибудь узнаешь.",
          "source": "Tatoeba #10948426 @Seael / #10948430 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10948426",
          "cefr_level": "A1",
          "word_slugs": [
            "sepas-verb"
          ]
        },
        {
          "id": "1469741",
          "text": "Basta con que sepas eso.",
          "translation": "Этой информации тебе хватит.",
          "source": "Tatoeba #1469741 @marcelostockle / #5820197 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1469741",
          "cefr_level": "A1",
          "word_slugs": [
            "sepas-verb"
          ]
        },
        {
          "id": "1810616",
          "text": "No quieren que lo sepas.",
          "translation": "Они не хотят, чтобы ты об этом знал.",
          "source": "Tatoeba #1810616 @Shishir / #2110503 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1810616",
          "cefr_level": "A1",
          "word_slugs": [
            "sepas-verb"
          ]
        },
        {
          "id": "2081490",
          "text": "Tom quería que sepas eso.",
          "translation": "Том хотел, чтобы ты это знал.",
          "source": "Tatoeba #2081490 @marcelostockle / #6594691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2081490",
          "cefr_level": "A1",
          "word_slugs": [
            "sepas-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
