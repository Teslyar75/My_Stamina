      "gender": null,
      "examples": [
        {
          "id": "3308694",
          "text": "¡Tienen poca memoria!",
          "translation": "У вас слабая память!",
          "source": "Tatoeba #3308694 @gianich73 / #3308648 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3308694",
          "cefr_level": "A1",
          "word_slugs": [
            "memoria-noun"
          ]
        },
        {
          "id": "6562364",
          "text": "¿Tienes buena memoria?",
          "translation": "У тебя хорошая память?",
          "source": "Tatoeba #6562364 @marcelostockle / #6150314 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6562364",
          "cefr_level": "A1",
          "word_slugs": [
            "memoria-noun"
          ]
        },
        {
          "id": "10545377",
          "text": "Tiene memoria fotográfica.",
