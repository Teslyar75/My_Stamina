      "frequency_rank": 1869,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "female equivalent of negro",
          "crotchet, quarter note",
          "black piece",
          "bad luck"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "850420",
          "text": "La negra es mía.",
          "translation": "Чёрная моя.",
          "source": "Tatoeba #850420 @Warnerbroder / #10499100 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/850420",
