    {
      "slug": "necesidad-noun",
      "lemma": "necesidad",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1844,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "need",
          "necessity",
          "neediness, state of being in need",
          "neediness (emotional)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3943206",
          "text": "No hay necesidad de mentir.",
          "translation": "Нет нужды лгать.",
          "source": "Tatoeba #3943206 @hayastan / #3950809 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3943206",
          "cefr_level": "A1",
          "word_slugs": [
            "necesidad-noun"
          ]
        },
        {
          "id": "1642740",
          "text": "La necesidad enseña a rezar.",
          "translation": "Нужда учит молитве.",
          "source": "Tatoeba #1642740 @marcelostockle / #5341097 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1642740",
          "cefr_level": "A1",
          "word_slugs": [
            "necesidad-noun"
          ]
        },
        {
          "id": "4929748",
          "text": "No hay necesidad de exagerar.",
          "translation": "Нет необходимости преувеличивать.",
          "source": "Tatoeba #4929748 @cueyayotl / #5347101 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4929748",
          "cefr_level": "A1",
          "word_slugs": [
            "necesidad-noun"
          ]
        },
        {
          "id": "853663",
          "text": "No hay necesidad de disculparse.",
          "translation": "Не нужно извиняться.",
          "source": "Tatoeba #853663 @ygpons / #561219 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/853663",
          "cefr_level": "A1",
          "word_slugs": [
            "necesidad-noun"
          ]
        },
        {
          "id": "2758712",
          "text": "De la necesidad nace la genialidad.",
          "translation": "Голь на выдумки хитра.",
          "source": "Tatoeba #2758712 @Balamax / #1747023 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2758712",
          "cefr_level": "A1",
          "word_slugs": [
            "necesidad-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "necesidad",
        "plural": "",
        "infinitive": ""
      }
