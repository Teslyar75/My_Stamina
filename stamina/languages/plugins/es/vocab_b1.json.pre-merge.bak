      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural present indicative of llevar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "463221",
          "text": "Se llevan a matar.",
          "translation": "Они убить друг друга готовы.",
          "source": "Tatoeba #463221 @lukaszpp / #6321242 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/463221",
          "cefr_level": "A1",
          "word_slugs": [
            "llevan-verb"
          ]
        },
        {
          "id": "2745059",
          "text": "Llevan casados veinte años.",
          "translation": "Они женаты двадцать лет.",
          "source": "Tatoeba #2745059 @esteban / #473326 @Iolanda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2745059",
          "cefr_level": "A1",
          "word_slugs": [
            "llevan-verb"
          ]
        },
        {
          "id": "5057905",
          "text": "Todos ellos llevan uniformes.",
          "translation": "Они все в униформе.",
          "source": "Tatoeba #5057905 @don_ramon / #5058618 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5057905",
          "cefr_level": "A1",
          "word_slugs": [
            "llevan-verb"
          ]
        },
        {
          "id": "1458431",
          "text": "¿Cuánto tiempo llevan caminando?",
          "translation": "Как долго они шли?",
          "source": "Tatoeba #1458431 @marcelostockle / #9821197 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1458431",
          "cefr_level": "A1",
          "word_slugs": [
            "llevan-verb"
          ]
        },
        {
          "id": "1445295",
          "text": "Ellos llevan diez años casados.",
          "translation": "Они женаты уже десять лет.",
          "source": "Tatoeba #1445295 @marcelostockle / #2550898 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1445295",
          "cefr_level": "A1",
          "word_slugs": [
            "llevan-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "llevan",
