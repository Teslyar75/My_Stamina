          "second-person singular present subjunctive of hablar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "736716",
          "text": "No hables así.",
          "translation": "Не говори так.",
          "source": "Tatoeba #736716 @Shishir / #467996 @vilnat (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/736716",
