    {
      "slug": "siéntese-verb",
      "lemma": "siéntese",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2153,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular imperative of sentar combined with se"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "454135",
          "text": "Siéntese, por favor.",
          "translation": "Садитесь, пожалуйста.",
          "source": "Tatoeba #454135 @mamat / #381258 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454135",
          "cefr_level": "A1",
          "word_slugs": [
            "siéntese-verb"
          ]
        },
        {
          "id": "614449",
          "text": "Por favor, siéntese.",
          "translation": "Сядьте, пожалуйста.",
          "source": "Tatoeba #614449 @Leono / #415610 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/614449",
          "cefr_level": "A1",
          "word_slugs": [
            "siéntese-verb"
          ]
        },
        {
          "id": "871006",
          "text": "Siéntese aquí y caliéntese.",
          "translation": "Садитесь сюда и грейтесь.",
          "source": "Tatoeba #871006 @Shishir / #7820254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/871006",
          "cefr_level": "A1",
          "word_slugs": [
            "siéntese-verb"
          ]
        },
        {
          "id": "1598962",
          "text": "¡Cierre la puerta y siéntese!",
          "translation": "Закройте дверь и сядьте.",
          "source": "Tatoeba #1598962 @marcelostockle / #12170943 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1598962",
          "cefr_level": "A1",
          "word_slugs": [
            "siéntese-verb"
          ]
        },
        {
          "id": "1391553",
          "text": "Por favor, siéntese aquí y espere.",
          "translation": "Пожалуйста, присядьте здесь и подождите.",
          "source": "Tatoeba #1391553 @Shishir / #4923099 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1391553",
          "cefr_level": "A1",
          "word_slugs": [
            "siéntese-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
