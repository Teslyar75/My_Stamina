    {
      "slug": "regresa-verb",
      "lemma": "regresa",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1817,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of regresar:",
          "third-person singular present indicative",
          "inflection of regresar:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3564790",
          "text": "Regresa al auto.",
          "translation": "Вернись в машину.",
          "source": "Tatoeba #3564790 @ficion / #3566166 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3564790",
          "cefr_level": "A1",
          "word_slugs": [
            "regresa-verb"
          ]
        },
        {
          "id": "10119877",
          "text": "¿Cuándo regresa Tom?",
          "translation": "Когда Том возвращается?",
          "source": "Tatoeba #10119877 @Teiruzu / #5498780 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10119877",
          "cefr_level": "A1",
          "word_slugs": [
            "regresa-verb"
          ]
        },
        {
          "id": "5011475",
          "text": "Regresa cuando quieras.",
          "translation": "Возвращайся, когда захочешь.",
          "source": "Tatoeba #5011475 @don_ramon / #4916779 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5011475",
          "cefr_level": "A1",
          "word_slugs": [
            "regresa-verb"
          ]
        },
        {
          "id": "1809316",
          "text": "Regresa hacia donde comenzaste.",
          "translation": "Вернись туда, где начал.",
          "source": "Tatoeba #1809316 @marcelostockle / #5956047 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1809316",
          "cefr_level": "A1",
          "word_slugs": [
            "regresa-verb"
          ]
        },
        {
          "id": "2944803",
          "text": "Él regresa a su casa.",
          "translation": "Он возвращается к себе домой.",
          "source": "Tatoeba #2944803 @marcelostockle / #2945282 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2944803",
          "cefr_level": "A1",
          "word_slugs": [
            "regresa-verb"
          ]
        }
      ],
