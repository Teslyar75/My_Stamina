    {
      "slug": "siglo-noun",
      "lemma": "siglo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2287,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "век"
        ],
        "en": [
          "century",
          "age (significant period of time)",
          "eon"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "615980",
          "text": "Un siglo es cien años.",
          "translation": "Век — это сто лет.",
          "source": "Tatoeba #615980 @darinmex / #1039892 @Vixen96 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/615980",
          "cefr_level": "A1",
          "word_slugs": [
            "siglo-noun"
          ]
        },
        {
          "id": "780530",
          "text": "Nació en el siglo XIX.",
          "translation": "Он родился в 19-м веке.",
          "source": "Tatoeba #780530 @BraveSentry / #651101 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/780530",
          "cefr_level": "A1",
          "word_slugs": [
            "siglo-noun"
          ]
        },
        {
          "id": "1059967",
          "text": "Un siglo tiene cien años.",
          "translation": "Век — это сто лет.",
          "source": "Tatoeba #1059967 @hayastan / #1039892 @Vixen96 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1059967",
          "cefr_level": "A1",
          "word_slugs": [
            "siglo-noun"
          ]
        },
        {
          "id": "10021082",
          "text": "El siglo XXI comenzó en 2001.",
          "translation": "XXI век начался в 2001 году.",
          "source": "Tatoeba #10021082 @Shishir / #13649613 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10021082",
          "cefr_level": "A1",
          "word_slugs": [
            "siglo-noun"
          ]
        },
        {
          "id": "7820737",
          "text": "Naciste en el siglo equivocado.",
          "translation": "Ты родился не в том веке.",
          "source": "Tatoeba #7820737 @emigonza / #7822230 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7820737",
          "cefr_level": "A1",
          "word_slugs": [
            "siglo-noun"
          ]
        }
