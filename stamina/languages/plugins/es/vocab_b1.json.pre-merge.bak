      "gender": null,
      "examples": [
        {
          "id": "1589679",
          "text": "Gracias por los recuerdos.",
          "translation": "Спасибо за воспоминания.",
          "source": "Tatoeba #1589679 @Quabazaa / #502350 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1589679",
          "cefr_level": "A1",
          "word_slugs": [
            "recuerdos-noun"
          ]
        },
        {
          "id": "434783",
          "text": "Da recuerdos a tus padres.",
          "translation": "Передай приветы твоим родителям.",
          "source": "Tatoeba #434783 @lukaszpp / #744508 @jonnywalker (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/434783",
          "cefr_level": "A1",
          "word_slugs": [
            "recuerdos-noun"
          ]
        },
        {
          "id": "1389977",
          "text": "Ese cuadro trae buenos recuerdos.",
          "translation": "Эта картина навевает хорошие воспоминания.",
          "source": "Tatoeba #1389977 @alexmarcelo / #3261110 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1389977",
          "cefr_level": "A1",
          "word_slugs": [
            "recuerdos-noun"
          ]
        },
        {
          "id": "1441612",
          "text": "Esa foto me trajo muchos recuerdos.",
          "translation": "Эта фотография вызвала у меня кучу воспоминаний.",
          "source": "Tatoeba #1441612 @Shishir / #4004810 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1441612",
          "cefr_level": "A1",
          "word_slugs": [
            "recuerdos-noun"
          ]
        },
        {
          "id": "2416826",
          "text": "Estas fotos me traen muchos recuerdos.",
          "translation": "Эти фотографии навевают на меня множество воспоминаний.",
          "source": "Tatoeba #2416826 @wallebot / #2720820 @Leonid204 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2416826",
          "cefr_level": "A1",
          "word_slugs": [
            "recuerdos-noun"
          ]
