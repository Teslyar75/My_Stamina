    {
      "slug": "desearía-verb",
      "lemma": "desearía",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2347,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular conditional of desear"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "723207",
          "text": "Desearía ser rica.",
          "translation": "Хотела бы я быть богатой.",
          "source": "Tatoeba #723207 @Shishir / #2601069 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/723207",
          "cefr_level": "A1",
          "word_slugs": [
            "desearía-verb"
          ]
        },
        {
          "id": "710225",
          "text": "¡Desearía estar muerta!",
          "translation": "Я бы хотела умереть!",
          "source": "Tatoeba #710225 @Shishir / #5627840 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/710225",
          "cefr_level": "A1",
          "word_slugs": [
            "desearía-verb"
          ]
        },
        {
          "id": "1289918",
          "text": "Desearía ser millonario.",
          "translation": "Я хотел бы быть миллионером.",
          "source": "Tatoeba #1289918 @marcelostockle / #3062447 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1289918",
          "cefr_level": "A1",
          "word_slugs": [
            "desearía-verb"
          ]
        },
        {
          "id": "3698261",
          "text": "Desearía ser un pájaro.",
          "translation": "Я бы хотел быть птицей.",
          "source": "Tatoeba #3698261 @SrTortuga / #7002978 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3698261",
          "cefr_level": "A1",
          "word_slugs": [
            "desearía-verb"
          ]
        },
        {
          "id": "687449",
          "text": "¿Qué desearía comer hoy?",
          "translation": "Чего бы Вы хотели сегодня поесть?",
          "source": "Tatoeba #687449 @lukaszpp / #13061403 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/687449",
          "cefr_level": "A1",
          "word_slugs": [
            "desearía-verb"
          ]
        }
      ],
