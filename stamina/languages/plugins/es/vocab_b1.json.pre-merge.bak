          "main, most important",
          "essential"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1264439",
          "text": "Es la puerta principal.",
          "translation": "Это главная дверь.",
          "source": "Tatoeba #1264439 @alexmarcelo / #5084746 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1264439",
          "cefr_level": "A1",
