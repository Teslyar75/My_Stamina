        "en": [
          "to look after, take care of (e.g. a house, a person)",
          "to mind, watch, pay attention to, be mindful of",
          "to look after oneself, take care",
          "to be careful of, watch out for"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2409276",
          "text": "Puedo cuidar de Tom.",
          "translation": "Я могу позаботиться о Томе.",
          "source": "Tatoeba #2409276 @Shishir / #3885534 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2409276",
          "cefr_level": "A1",
          "word_slugs": [
            "cuidar-verb"
          ]
        },
        {
          "id": "1426330",
          "text": "Se debe cuidar la salud.",
          "translation": "Здоровье надо беречь.",
          "source": "Tatoeba #1426330 @marcelostockle / #6087876 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1426330",
          "cefr_level": "A1",
          "word_slugs": [
            "cuidar-verb"
          ]
        },
        {
          "id": "5103985",
          "text": "Hay que cuidar el planeta.",
          "translation": "Нужно беречь планету.",
          "source": "Tatoeba #5103985 @VEGGETTA777 / #5153453 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5103985",
          "cefr_level": "A1",
          "word_slugs": [
            "cuidar-verb"
          ]
        },
        {
          "id": "776486",
          "text": "¿Podrías cuidar de los niños?",
          "translation": "Не мог бы ты присмотреть за детьми?",
          "source": "Tatoeba #776486 @inmadom / #1498702 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/776486",
          "cefr_level": "A1",
          "word_slugs": [
            "cuidar-verb"
          ]
        },
        {
          "id": "3039316",
          "text": "Tenemos familias que debemos cuidar.",
          "translation": "У нас есть семьи, о которых мы должны заботиться.",
          "source": "Tatoeba #3039316 @marcelostockle / #3041000 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3039316",
          "cefr_level": "A1",
          "word_slugs": [
            "cuidar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el cuidar",
        "plural": "",
        "infinitive": "cuidar"
      }
