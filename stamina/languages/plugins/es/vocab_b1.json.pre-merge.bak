    {
      "slug": "controlar-verb",
      "lemma": "controlar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2351,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to control, to rein in",
          "to manage, to handle (e.g. managing symptoms, pain, stress or emotions)",
          "to monitor, to check, to supervise, to oversee, to verify, to regulate, to check on",
          "to be controlled, to be managed"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1841336",
          "text": "No me puedo controlar.",
          "translation": "Я не могу себя контролировать.",
          "source": "Tatoeba #1841336 @marcelostockle / #5318102 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1841336",
          "cefr_level": "A1",
          "word_slugs": [
            "controlar-verb"
          ]
        },
        {
          "id": "7872131",
          "text": "Ya no se podían controlar.",
          "translation": "Они уже не могли себя контролировать.",
          "source": "Tatoeba #7872131 @Seael / #7873956 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7872131",
          "cefr_level": "A1",
          "word_slugs": [
            "controlar-verb"
          ]
        },
        {
          "id": "7872134",
          "text": "Ya no se pudieron controlar.",
          "translation": "Они уже не могли себя контролировать.",
          "source": "Tatoeba #7872134 @Seael / #7873956 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7872134",
          "cefr_level": "A1",
          "word_slugs": [
            "controlar-verb"
          ]
        },
        {
          "id": "1322018",
          "text": "Tom no pudo controlar su enfado.",
          "translation": "Том не мог контролировать свой гнев.",
          "source": "Tatoeba #1322018 @Shishir / #7006565 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1322018",
          "cefr_level": "A1",
          "word_slugs": [
            "controlar-verb"
          ]
        },
        {
          "id": "7037638",
          "text": "El maestro no nos puede controlar.",
          "translation": "Учитель не может контролировать нас.",
          "source": "Tatoeba #7037638 @Goatstein / #7048034 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7037638",
          "cefr_level": "A1",
          "word_slugs": [
            "controlar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el controlar",
        "plural": "",
        "infinitive": "controlar"
      }
