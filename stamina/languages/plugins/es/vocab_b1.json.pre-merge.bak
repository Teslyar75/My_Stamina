    {
      "slug": "levántate-verb",
      "lemma": "levántate",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1912,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular imperative of levantar combined with te"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4618720",
          "text": "¡Yo dije levántate!",
          "translation": "Я сказала: «Вставай!»",
          "source": "Tatoeba #4618720 @Francisco_M / #5773772 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4618720",
          "cefr_level": "A1",
          "word_slugs": [
            "levántate-verb"
          ]
        },
        {
          "id": "5950056",
          "text": "Levántate cuando quieras.",
          "translation": "Вставай когда хочешь.",
          "source": "Tatoeba #5950056 @arh / #5951728 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5950056",
          "cefr_level": "A1",
          "word_slugs": [
            "levántate-verb"
          ]
        },
        {
          "id": "789009",
          "text": "Levántate tan pronto como puedas.",
          "translation": "Вставай как можно раньше.",
          "source": "Tatoeba #789009 @Shishir / #3697373 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/789009",
          "cefr_level": "A1",
          "word_slugs": [
            "levántate-verb"
          ]
        },
        {
          "id": "3225072",
          "text": "¡Son las dos de la tarde! ¡Ya levántate huevón!",
          "translation": "Два часа дня! Вставай уже, лентяй!",
          "source": "Tatoeba #3225072 @cueyayotl / #3630082 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3225072",
          "cefr_level": "A1",
          "word_slugs": [
            "levántate-verb"
          ]
        },
        {
          "id": "9353020",
          "text": "No seas zángano, levántate y dúchate antes de que llegue tu padre.",
          "translation": "Не будь лодырем, вставай и прими душ, пока не пришёл твой отец.",
          "source": "Tatoeba #9353020 @ignacio / #10501063 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9353020",
          "cefr_level": "A1",
          "word_slugs": [
            "levántate-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "levántate",
        "plural": "",
        "infinitive": "levántate"
      }
