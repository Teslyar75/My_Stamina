        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1386081",
          "text": "No podré asistir.",
          "translation": "Я не смогу присутствовать.",
          "source": "Tatoeba #1386081 @marcelostockle / #4688842 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1386081",
          "cefr_level": "A1",
          "word_slugs": [
            "podré-verb"
          ]
        },
        {
          "id": "2752582",
          "text": "Pronto podré nadar.",
          "translation": "Скоро я смогу плавать.",
          "source": "Tatoeba #2752582 @Shishir / #3638901 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2752582",
          "cefr_level": "A1",
          "word_slugs": [
            "podré-verb"
          ]
        },
        {
          "id": "3039076",
          "text": "Mañana podré reposar.",
          "translation": "Завтра я смогу отдохнуть.",
          "source": "Tatoeba #3039076 @cueyayotl / #3042304 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3039076",
          "cefr_level": "A1",
          "word_slugs": [
            "podré-verb"
          ]
        },
        {
          "id": "7824068",
          "text": "Mañana podré descansar.",
          "translation": "Завтра я смогу отдохнуть.",
          "source": "Tatoeba #7824068 @gianich73 / #3042304 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7824068",
          "cefr_level": "A1",
          "word_slugs": [
            "podré-verb"
          ]
        },
        {
          "id": "6671676",
          "text": "No podré reparar eso.",
          "translation": "Я не смогу это починить.",
          "source": "Tatoeba #6671676 @arh / #6926980 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6671676",
