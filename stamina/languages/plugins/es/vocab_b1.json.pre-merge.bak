          ]
        },
        {
          "id": "1845291",
          "text": "Mi herida sigue doliéndome.",
          "translation": "Моя рана всё ещё болит.",
          "source": "Tatoeba #1845291 @Shishir / #5575212 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1845291",
