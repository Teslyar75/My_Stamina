        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4553895",
          "text": "Nada parecía funcionar.",
          "translation": "Казалось, ничего не работает.",
          "source": "Tatoeba #4553895 @swyter / #10183308 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4553895",
          "cefr_level": "A1",
          "word_slugs": [
