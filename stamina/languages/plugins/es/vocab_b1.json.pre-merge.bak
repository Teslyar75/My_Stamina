    {
      "slug": "posibilidad-noun",
      "lemma": "posibilidad",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1565,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "possibility",
          "means",
          "potential, chance, odds, opportunity"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7795475",
          "text": "Hay posibilidad de que llueva.",
          "translation": "Возможен дождь.",
          "source": "Tatoeba #7795475 @emigonza / #7801982 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7795475",
          "cefr_level": "A1",
          "word_slugs": [
            "posibilidad-noun"
          ]
        },
        {
          "id": "1614185",
          "text": "Hay poca posibilidad de curación.",
          "translation": "Вероятность излечения невелика.",
          "source": "Tatoeba #1614185 @wallebot / #4525889 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1614185",
          "cefr_level": "A1",
          "word_slugs": [
            "posibilidad-noun"
          ]
        },
        {
          "id": "2645",
          "text": "Pero la posibilidad es improbable.",
          "translation": "Но вероятность невелика.",
          "source": "Tatoeba #2645 @jmeredith3 / #5574 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2645",
          "cefr_level": "A1",
          "word_slugs": [
            "posibilidad-noun"
          ]
        },
        {
          "id": "3791808",
          "text": "He considerado esa posibilidad también.",
          "translation": "Эту возможность я тоже рассматривал.",
          "source": "Tatoeba #3791808 @cueyayotl / #6805350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3791808",
          "cefr_level": "A1",
          "word_slugs": [
            "posibilidad-noun"
          ]
        },
        {
          "id": "338918",
          "text": "Existe una pequeña posibilidad de recaída.",
          "translation": "Существует небольшая вероятность рецидива.",
          "source": "Tatoeba #338918 @tatoerique / #4630417 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/338918",
          "cefr_level": "A1",
          "word_slugs": [
            "posibilidad-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "posibilidad",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "hubiese-verb",
      "lemma": "hubiese",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1566,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect subjunctive of haber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2971695",
          "text": "Actuá como si nada hubiese pasado.",
          "translation": "Действуй так, будто ничего не произошло.",
          "source": "Tatoeba #2971695 @hayastan / #2972329 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2971695",
          "cefr_level": "A1",
          "word_slugs": [
            "hubiese-verb"
          ]
        },
        {
          "id": "804803",
          "text": "Parecía como si hubiese visto un fantasma.",
          "translation": "У нее был такой вид, как будто она увидела привидение.",
          "source": "Tatoeba #804803 @Munia / #1197176 @Keiden (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/804803",
          "cefr_level": "A1",
          "word_slugs": [
            "hubiese-verb"
          ]
        },
        {
          "id": "1364598",
          "text": "Sin tu ayuda no hubiese superado esa crisis.",
          "translation": "Без твоей помощи я бы не преодолел этот кризис.",
          "source": "Tatoeba #1364598 @Kiraness / #5514616 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1364598",
          "cefr_level": "A1",
          "word_slugs": [
            "hubiese-verb"
          ]
        },
        {
          "id": "398399",
          "text": "Si hubiese tenido más tiempo, te habría escrito.",
          "translation": "Если бы у меня было больше времени, я бы тебе написал.",
          "source": "Tatoeba #398399 @mane / #783694 @tania_soleil (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398399",
          "cefr_level": "A1",
          "word_slugs": [
            "hubiese-verb"
          ]
        },
        {
          "id": "1068307",
          "text": "Él habla como si ya hubiese leído el libro.",
          "translation": "Он говорит так, будто уже прочитал книгу.",
          "source": "Tatoeba #1068307 @hayastan / #7762447 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1068307",
          "cefr_level": "A1",
          "word_slugs": [
            "hubiese-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "hubiese",
        "plural": "",
        "infinitive": "hubiese"
      }
    },
    {
      "slug": "mark-noun",
      "lemma": "mark",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1567,
      "frequency_band": "cervantes-b1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3523399",
          "text": "Mark trajo el libro.",
          "translation": "Марк принёс книгу.",
          "source": "Tatoeba #3523399 @Shishir / #5585803 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3523399",
          "cefr_level": "A1",
          "word_slugs": [
            "mark-noun"
          ]
        },
        {
          "id": "10024980",
          "text": "¿Karl Mark era un comunista?",
          "translation": "Карл Маркс был коммунистом?",
          "source": "Tatoeba #10024980 @manufrutos / #10012137 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10024980",
          "cefr_level": "A1",
          "word_slugs": [
            "mark-noun"
          ]
        },
        {
          "id": "1289074",
          "text": "Mark se graduó de Harvard en 1991.",
          "translation": "Марк окончил Гарвард в 1991 году.",
          "source": "Tatoeba #1289074 @marcelostockle / #3040222 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1289074",
          "cefr_level": "A1",
          "word_slugs": [
            "mark-noun"
          ]
        },
        {
          "id": "5542809",
          "text": "Mark flirtea con todo lo que se mueve.",
          "translation": "Марк флиртует со всем, что движется.",
          "source": "Tatoeba #5542809 @albrusgher / #5543047 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5542809",
          "cefr_level": "A1",
          "word_slugs": [
            "mark-noun"
          ]
        },
        {
          "id": "1061570",
          "text": "¿Cuál es tu cita favorita de Mark Twain?",
          "translation": "Какая твоя любимая цитата из Марка Твена?",
          "source": "Tatoeba #1061570 @alexmarcelo / #4630582 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1061570",
          "cefr_level": "A1",
          "word_slugs": [
            "mark-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "f",
        "singular": "la mark",
        "plural": "",
        "infinitive": ""
      }
    },
