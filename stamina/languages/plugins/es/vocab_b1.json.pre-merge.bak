    {
      "slug": "u-character",
      "lemma": "u",
      "pos": "character",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2383,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "The twenty-second letter of the Spanish alphabet, written in the Latin script."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5516097",
          "text": "Estaré de vuelta alrededor de las siete u ocho.",
          "translation": "Я вернусь часов в семь-восемь.",
          "source": "Tatoeba #5516097 @Leono / #5516215 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5516097",
          "cefr_level": "A1",
          "word_slugs": [
            "u-character"
          ]
        },
        {
          "id": "356220",
          "text": "U.R.S.S. significa Unión de Repúblicas Socialistas Soviéticas.",
          "translation": "«СССР» значит «Союз Советских Социалистических Республик».",
          "source": "Tatoeba #356220 @tatoerique / #435502 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/356220",
          "cefr_level": "A1",
          "word_slugs": [
            "u-character"
          ]
        },
        {
          "id": "2765436",
          "text": "No pasa nada, todo resultará bien, de alguna u otra forma pasará.",
          "translation": "Ничего, как-нибудь обойдётся.",
          "source": "Tatoeba #2765436 @ecorralest101 / #2751582 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2765436",
          "cefr_level": "A1",
          "word_slugs": [
            "u-character"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "u",
        "plural": "",
        "infinitive": ""
      }
