          ]
        },
        {
          "id": "3945932",
          "text": "La nieve cesó.",
          "translation": "Снег перестал.",
          "source": "Tatoeba #3945932 @gianich73 / #3945853 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3945932",
          "cefr_level": "A1",
          "word_slugs": [
            "nieve-verb"
          ]
        },
        {
          "id": "5961254",
          "text": "Odio la nieve.",
          "translation": "Терпеть не могу снег.",
          "source": "Tatoeba #5961254 @Adelpa / #5962223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5961254",
