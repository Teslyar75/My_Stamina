      "translations": {
        "en": [
          "beauty (the quality of being beautiful)",
          "beauty (beautiful person or object)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13673165",
          "text": "¡Oh, qué belleza!",
          "translation": "О, какая красота!",
          "source": "Tatoeba #13673165 @Seael / #10887626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13673165",
          "cefr_level": "A1",
          "word_slugs": [
            "belleza-noun"
          ]
        },
        {
          "id": "4796068",
          "text": "Amamos la belleza.",
          "translation": "Мы любим красоту.",
          "source": "Tatoeba #4796068 @Shishir / #1331819 @Imp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4796068",
          "cefr_level": "A1",
          "word_slugs": [
            "belleza-noun"
          ]
        },
        {
          "id": "7715929",
          "text": "Su belleza es única.",
          "translation": "Её красота уникальна.",
          "source": "Tatoeba #7715929 @arh / #10610158 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7715929",
          "cefr_level": "A1",
          "word_slugs": [
            "belleza-noun"
          ]
        },
        {
          "id": "3669362",
          "text": "Su belleza lo embrujó.",
          "translation": "Её красота его пленила.",
          "source": "Tatoeba #3669362 @Seael / #5932294 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3669362",
          "cefr_level": "A1",
          "word_slugs": [
            "belleza-noun"
          ]
        },
        {
          "id": "3669363",
          "text": "Su belleza lo hechizó.",
          "translation": "Её красота околдовала его.",
          "source": "Tatoeba #3669363 @Seael / #5351741 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3669363",
          "cefr_level": "A1",
          "word_slugs": [
            "belleza-noun"
          ]
        }
      ],
