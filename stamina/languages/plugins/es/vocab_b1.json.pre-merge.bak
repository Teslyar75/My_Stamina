    {
      "slug": "droga-noun",
      "lemma": "droga",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2281,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "drug",
          "indebtedness, debt"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5533773",
          "text": "Necesito esa droga.",
          "translation": "Мне нужно это лекарство.",
          "source": "Tatoeba #5533773 @baudelaire / #3695614 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5533773",
          "cefr_level": "A1",
          "word_slugs": [
            "droga-noun"
          ]
        },
        {
          "id": "1295127",
          "text": "Tu hija se droga.",
          "translation": "Твоя дочь принимает наркотики.",
          "source": "Tatoeba #1295127 @marcelostockle / #5069575 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1295127",
          "cefr_level": "A1",
          "word_slugs": [
            "droga-noun"
          ]
        },
        {
          "id": "13906156",
          "text": "Tatoeba es una droga.",
          "translation": "Татоэба - это наркотик.",
          "source": "Tatoeba #13906156 @rul / #3576768 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13906156",
          "cefr_level": "A1",
          "word_slugs": [
            "droga-noun"
          ]
        },
        {
          "id": "1221830",
          "text": "Te convertiste en una droga para mí.",
          "translation": "Ты стала для меня наркотиком.",
          "source": "Tatoeba #1221830 @nancy / #4069096 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1221830",
          "cefr_level": "A1",
          "word_slugs": [
            "droga-noun"
          ]
        },
        {
          "id": "1046132",
          "text": "Esta droga era ilegal en los años 90.",
          "translation": "Этот препарат был запрещён в девяностых.",
          "source": "Tatoeba #1046132 @hayastan / #5049785 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1046132",
          "cefr_level": "A1",
          "word_slugs": [
            "droga-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
