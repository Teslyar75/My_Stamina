          ]
        },
        {
          "id": "1909683",
          "text": "Tu madre es una bruja.",
          "translation": "Твоя мать — ведьма.",
          "source": "Tatoeba #1909683 @hayastan / #6112986 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1909683",
          "cefr_level": "A1",
          "word_slugs": [
