        ],
        "en": [
          "search",
          "quest"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1221941",
          "text": "Fueron en búsqueda de tesoro.",
          "translation": "Они отправились на поиски сокровищ.",
          "source": "Tatoeba #1221941 @darinmex / #4851328 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1221941",
          "cefr_level": "A1",
          "word_slugs": [
            "búsqueda-noun"
          ]
        },
        {
          "id": "1702305",
          "text": "La vida es una búsqueda constante.",
          "translation": "Жизнь — это постоянный поиск.",
          "source": "Tatoeba #1702305 @marcelostockle / #6107656 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1702305",
          "cefr_level": "A1",
          "word_slugs": [
            "búsqueda-noun"
          ]
        },
        {
          "id": "12111156",
          "text": "La función de búsqueda no funciona.",
          "translation": "Поиск не работает.",
