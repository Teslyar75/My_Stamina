      "frequency_rank": 2494,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular preterite indicative of romper"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "863355",
          "text": "¿Quién rompió esto?",
          "translation": "Кто сломал это?",
          "source": "Tatoeba #863355 @Rafp / #1464707 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/863355",
          "cefr_level": "A1",
          "word_slugs": [
            "rompió-verb"
          ]
        },
        {
          "id": "1548004",
          "text": "El vaso se rompió.",
          "translation": "Стакан разбился.",
          "source": "Tatoeba #1548004 @marcelostockle / #5480812 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1548004",
          "cefr_level": "A1",
          "word_slugs": [
            "rompió-verb"
          ]
        },
        {
          "id": "1691410",
          "text": "El radio se rompió.",
          "translation": "Приёмник сломался.",
          "source": "Tatoeba #1691410 @hayastan / #4513085 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1691410",
          "cefr_level": "A1",
          "word_slugs": [
            "rompió-verb"
          ]
        },
        {
          "id": "1548005",
          "text": "El vidrio se rompió.",
          "translation": "Стекло разбилось.",
          "source": "Tatoeba #1548005 @marcelostockle / #13124115 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1548005",
          "cefr_level": "A1",
          "word_slugs": [
            "rompió-verb"
          ]
        },
        {
          "id": "1906199",
          "text": "Él rompió el récord.",
          "translation": "Он побил рекорд.",
          "source": "Tatoeba #1906199 @alexmarcelo / #2017161 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1906199",
          "cefr_level": "A1",
          "word_slugs": [
            "rompió-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
