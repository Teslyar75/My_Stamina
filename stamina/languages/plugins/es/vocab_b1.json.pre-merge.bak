      },
      "gender": null,
      "examples": [
        {
          "id": "9770521",
          "text": "Tom escribe canciones.",
          "translation": "Том пишет песни.",
          "source": "Tatoeba #9770521 @Ferchus / #8914170 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9770521",
          "cefr_level": "A1",
