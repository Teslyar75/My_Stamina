    {
      "slug": "pacientes-adj",
      "lemma": "pacientes",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2062,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of paciente"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3255100",
          "text": "Tenemos que ser pacientes.",
          "translation": "Мы должны быть терпеливыми.",
          "source": "Tatoeba #3255100 @Shishir / #5158270 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3255100",
          "cefr_level": "A1",
          "word_slugs": [
            "pacientes-adj"
          ]
        },
        {
          "id": "2101670",
          "text": "Los pacientes cuentan historias.",
          "translation": "Пациенты рассказывают истории.",
          "source": "Tatoeba #2101670 @marcelostockle / #9105205 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2101670",
          "cefr_level": "A1",
          "word_slugs": [
            "pacientes-adj"
          ]
        },
        {
          "id": "2976038",
          "text": "Tom era uno de mis pacientes.",
          "translation": "Том был одним из моих пациентов.",
          "source": "Tatoeba #2976038 @marcelostockle / #2976162 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2976038",
          "cefr_level": "A1",
          "word_slugs": [
            "pacientes-adj"
          ]
        },
        {
          "id": "8014809",
          "text": "No quería molestar a los pacientes.",
          "translation": "Я не хотел беспокоить пациентов.",
          "source": "Tatoeba #8014809 @Seael / #8017391 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8014809",
          "cefr_level": "A1",
          "word_slugs": [
            "pacientes-adj"
          ]
        },
        {
          "id": "5140843",
          "text": "Los médicos son los peores pacientes.",
          "translation": "Врачи — худшие пациенты.",
          "source": "Tatoeba #5140843 @don_ramon / #6167747 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5140843",
          "cefr_level": "A1",
          "word_slugs": [
            "pacientes-adj"
          ]
        }
      ],
