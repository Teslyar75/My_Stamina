    {
      "slug": "robert-name",
      "lemma": "Robert",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1581,
      "frequency_band": "cervantes-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "743089",
          "text": "He oído que Robert está enfermo.",
          "translation": "Я слышал, Роберт болеет.",
          "source": "Tatoeba #743089 @Shishir / #8596225 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/743089",
          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        },
        {
          "id": "2282889",
          "text": "He oído decir que Robert está enfermo.",
          "translation": "Я слышал, что Роберт болен.",
          "source": "Tatoeba #2282889 @Shishir / #527132 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2282889",
          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        },
        {
          "id": "885627",
          "text": "Robert es brasileño. Su padre es canadiense.",
          "translation": "Роберт - бразилец. Его отец - канадец.",
          "source": "Tatoeba #885627 @Shishir / #1434607 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/885627",
          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        },
        {
          "id": "329813",
          "text": "Robert nunca se ha retrasado a una reunión.",
          "translation": "Роберт ни разу не опаздывал на собрания.",
          "source": "Tatoeba #329813 @jorgearestrepo / #8296306 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/329813",
          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        },
        {
          "id": "856852",
          "text": "Me pusieron de nombre Robert por mi abuelo.",
          "translation": "Меня назвали Робертом в честь моего дедушки.",
          "source": "Tatoeba #856852 @rafmen / #3158139 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/856852",
          "cefr_level": "A1",
          "word_slugs": [
            "robert-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "Robert",
        "plural": "",
        "infinitive": ""
      }
