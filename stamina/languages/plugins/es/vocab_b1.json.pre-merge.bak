    {
      "slug": "sois-verb",
      "lemma": "sois",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1604,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
