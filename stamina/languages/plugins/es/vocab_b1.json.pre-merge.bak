    {
      "slug": "criminal-adj",
      "lemma": "criminal",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2118,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "criminal"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5084486",
          "text": "El criminal confesó.",
          "translation": "Преступник сознался.",
          "source": "Tatoeba #5084486 @Shishir / #2492885 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5084486",
          "cefr_level": "A1",
          "word_slugs": [
            "criminal-adj"
          ]
        },
        {
          "id": "1602183",
          "text": "El criminal dejó huellas.",
          "translation": "Преступник оставил следы.",
          "source": "Tatoeba #1602183 @marcelostockle / #5914403 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1602183",
          "cefr_level": "A1",
          "word_slugs": [
            "criminal-adj"
          ]
        },
        {
          "id": "3875894",
          "text": "Tom no es un criminal.",
          "translation": "Том не преступник.",
          "source": "Tatoeba #3875894 @hayastan / #2746977 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3875894",
          "cefr_level": "A1",
          "word_slugs": [
            "criminal-adj"
          ]
        },
        {
          "id": "4079393",
          "text": "Me tratan como un criminal.",
          "translation": "Со мной обращаются как с преступником.",
          "source": "Tatoeba #4079393 @gianich73 / #4079359 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4079393",
          "cefr_level": "A1",
          "word_slugs": [
            "criminal-adj"
          ]
        },
        {
          "id": "1946235",
          "text": "El criminal escapó de prisión.",
          "translation": "Преступник сбежал из тюрьмы.",
          "source": "Tatoeba #1946235 @teskmon / #1017133 @naXa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1946235",
          "cefr_level": "A1",
          "word_slugs": [
            "criminal-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
