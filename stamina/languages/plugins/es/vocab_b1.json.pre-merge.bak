    {
      "slug": "den-verb",
      "lemma": "den",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2453,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of dar:",
          "third-person plural present subjunctive",
          "inflection of dar:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7965603",
          "text": "No me lo den.",
          "translation": "Не давайте мне этого.",
          "source": "Tatoeba #7965603 @Seael / #8312110 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7965603",
          "cefr_level": "A1",
          "word_slugs": [
            "den-verb"
          ]
        },
        {
          "id": "2889448",
          "text": "Diles que te lo den.",
          "translation": "Скажи им, чтобы они дали тебе это.",
          "source": "Tatoeba #2889448 @don_ramon / #2751343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2889448",
          "cefr_level": "A1",
          "word_slugs": [
            "den-verb"
          ]
        },
        {
          "id": "3297097",
          "text": "No me den por descontado.",
          "translation": "Не сбрасывайте меня со счетов.",
          "source": "Tatoeba #3297097 @gianich73 / #2498954 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3297097",
          "cefr_level": "A1",
          "word_slugs": [
            "den-verb"
          ]
        },
        {
          "id": "4047351",
          "text": "No den de comer a las palomas.",
          "translation": "Не кормите голубей.",
          "source": "Tatoeba #4047351 @gianich73 / #4047281 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4047351",
          "cefr_level": "A1",
          "word_slugs": [
            "den-verb"
          ]
        },
        {
          "id": "2993919",
          "text": "¿Por qué dejas que te den órdenes así?",
          "translation": "Почему ты позволяешь, чтобы тебе отдавали такие приказы?",
