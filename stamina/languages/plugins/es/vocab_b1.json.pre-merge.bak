          ]
        },
        {
          "id": "7468988",
          "text": "He dejado el alcohol.",
          "translation": "Я завязал с алкоголем.",
          "source": "Tatoeba #7468988 @arh / #7534832 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7468988",
          "cefr_level": "A1",
          "word_slugs": [
            "alcohol-noun"
          ]
        },
        {
          "id": "10204376",
          "text": "No bebe nunca alcohol.",
          "translation": "Он вообще не пьёт.",
          "source": "Tatoeba #10204376 @Shishir / #12680983 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10204376",
          "cefr_level": "A1",
