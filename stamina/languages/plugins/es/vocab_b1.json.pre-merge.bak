      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural future indicative of estar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3147744",
          "text": "Pronto estarán aquí.",
          "translation": "Скоро они будут здесь.",
          "source": "Tatoeba #3147744 @Shishir / #6107627 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3147744",
          "cefr_level": "A1",
