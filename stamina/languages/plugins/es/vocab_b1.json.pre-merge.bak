          ]
        },
        {
          "id": "2257062",
          "text": "Esta canción me alegra.",
          "translation": "Эта песня меня радует.",
          "source": "Tatoeba #2257062 @marcelostockle / #3376046 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2257062",
