    {
      "slug": "mirada-noun",
      "lemma": "mirada",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1819,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "look, glance"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5233131",
          "text": "Ella apartó su mirada.",
          "translation": "Она отвела взгляд.",
          "source": "Tatoeba #5233131 @cueyayotl / #2060932 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5233131",
          "cefr_level": "A1",
          "word_slugs": [
            "mirada-noun"
          ]
        },
        {
          "id": "2515487",
          "text": "Tienes una mirada tierna.",
          "translation": "У тебя нежный взгляд.",
          "source": "Tatoeba #2515487 @marcelostockle / #4522892 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2515487",
          "cefr_level": "A1",
          "word_slugs": [
            "mirada-noun"
          ]
        },
        {
          "id": "1618085",
          "text": "No puedo soportar su mirada.",
          "translation": "Я не могу выдержать его взгляд.",
          "source": "Tatoeba #1618085 @alexmarcelo / #5342819 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1618085",
          "cefr_level": "A1",
          "word_slugs": [
            "mirada-noun"
          ]
        },
        {
          "id": "1906232",
          "text": "Había desprecio en su mirada.",
          "translation": "В его взгляде было презрение.",
          "source": "Tatoeba #1906232 @hayastan / #3928368 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1906232",
          "cefr_level": "A1",
          "word_slugs": [
            "mirada-noun"
          ]
        },
        {
          "id": "5961050",
          "text": "Me lanzó una mirada socarrona.",
          "translation": "Он лукаво посмотрел на меня.",
          "source": "Tatoeba #5961050 @gianich73 / #6980698 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5961050",
          "cefr_level": "A1",
