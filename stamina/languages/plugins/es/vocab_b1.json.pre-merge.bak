    {
      "slug": "fuese-verb",
      "lemma": "fuese",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1919,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect subjunctive of ir",
          "first/third-person singular imperfect subjunctive of ser"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3298197",
          "text": "No quería que Tom se fuese.",
          "translation": "Не хотел, чтобы Том ушёл.",
          "source": "Tatoeba #3298197 @gianich73 / #2524804 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3298197",
          "cefr_level": "A1",
          "word_slugs": [
            "fuese-verb"
          ]
        },
        {
          "id": "858837",
          "text": "Habla como si fuese un erudito.",
          "translation": "Он говорит так, будто всё знает.",
          "source": "Tatoeba #858837 @sharin / #379965 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/858837",
          "cefr_level": "A1",
          "word_slugs": [
            "fuese-verb"
          ]
        },
        {
          "id": "1408349",
          "text": "Yo no haría eso si fuese ella.",
          "translation": "На её месте я бы этого не сделала.",
          "source": "Tatoeba #1408349 @hayastan / #6144135 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1408349",
          "cefr_level": "A1",
          "word_slugs": [
            "fuese-verb"
          ]
        },
        {
          "id": "3287835",
          "text": "Usted hacía como si no fuese nada.",
          "translation": "Вы вели себя как ни в чём не бывало.",
          "source": "Tatoeba #3287835 @cueyayotl / #5245538 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3287835",
          "cefr_level": "A1",
          "word_slugs": [
            "fuese-verb"
          ]
        },
        {
          "id": "3287837",
          "text": "Hacía usted como si no fuese nada.",
          "translation": "Вы вели себя как ни в чём не бывало.",
          "source": "Tatoeba #3287837 @cueyayotl / #5245538 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3287837",
          "cefr_level": "A1",
          "word_slugs": [
            "fuese-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
