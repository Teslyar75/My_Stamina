    {
      "slug": "pasé-verb",
      "lemma": "pasé",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1908,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular preterite indicative of pasar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2099805",
          "text": "La pasé bien.",
          "translation": "Я хорошо провёл время.",
          "source": "Tatoeba #2099805 @marcelostockle / #2041014 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2099805",
          "cefr_level": "A1",
          "word_slugs": [
            "pasé-verb"
          ]
        },
        {
          "id": "7865150",
          "text": "Lo pasé bien.",
          "translation": "Я хорошо провёл время.",
          "source": "Tatoeba #7865150 @arh / #2041014 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7865150",
          "cefr_level": "A1",
          "word_slugs": [
            "pasé-verb"
          ]
        },
        {
          "id": "5296433",
          "text": "Pasé algo por alto.",
          "translation": "Я что-то упустил.",
          "source": "Tatoeba #5296433 @baudelaire / #6324291 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5296433",
          "cefr_level": "A1",
          "word_slugs": [
            "pasé-verb"
          ]
        },
        {
          "id": "3850890",
          "text": "Pasé una tarde maravillosa.",
          "translation": "У меня был замечательный вечер.",
          "source": "Tatoeba #3850890 @cueyayotl / #7363296 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3850890",
          "cefr_level": "A1",
          "word_slugs": [
            "pasé-verb"
          ]
        },
        {
          "id": "5033286",
          "text": "Pasé la mañana con Tom.",
          "translation": "Я провела утро с Томом.",
          "source": "Tatoeba #5033286 @DarkHollow / #6806594 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5033286",
          "cefr_level": "A1",
          "word_slugs": [
            "pasé-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
