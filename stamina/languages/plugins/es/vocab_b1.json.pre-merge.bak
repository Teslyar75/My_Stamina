    {
      "slug": "pones-verb",
      "lemma": "pones",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2033,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular present indicative of poner"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5610882",
          "text": "Siempre te pones de su lado.",
          "translation": "Ты всегда встаёшь на её сторону.",
          "source": "Tatoeba #5610882 @baudelaire / #4737386 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5610882",
          "cefr_level": "A1",
          "word_slugs": [
            "pones-verb"
          ]
        },
        {
          "id": "867111",
          "text": "¿Por qué no te pones a dieta?",
          "translation": "Почему ты не сядешь на диету?",
          "source": "Tatoeba #867111 @felipeselles / #1678337 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/867111",
          "cefr_level": "A1",
          "word_slugs": [
            "pones-verb"
          ]
        },
        {
          "id": "4572351",
          "text": "¿Qué tal si te pones a dieta?",
          "translation": "Как насчёт того, чтобы сесть на диету?",
          "source": "Tatoeba #4572351 @cueyayotl / #3335839 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4572351",
          "cefr_level": "A1",
          "word_slugs": [
            "pones-verb"
          ]
        },
        {
          "id": "5610883",
          "text": "Siempre te pones del lado de ella.",
          "translation": "Ты всегда встаёшь на её сторону.",
          "source": "Tatoeba #5610883 @baudelaire / #4737386 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5610883",
          "cefr_level": "A1",
          "word_slugs": [
            "pones-verb"
          ]
        },
        {
          "id": "3900314",
          "text": "Si te pones enfermo, vete al médico.",
          "translation": "Если заболеешь — иди к врачу.",
          "source": "Tatoeba #3900314 @Shishir / #3900606 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3900314",
          "cefr_level": "A1",
          "word_slugs": [
            "pones-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
