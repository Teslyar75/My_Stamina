        "en": [
          "infinitive of ayudar combined with me"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5021827",
          "text": "¡Tenés que ayudarme!",
          "translation": "Ты должен мне помочь!",
          "source": "Tatoeba #5021827 @don_ramon / #5022024 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5021827",
          "cefr_level": "A1",
          "word_slugs": [
            "ayudarme-verb"
          ]
        },
        {
          "id": "502057",
          "text": "Nadie puede ayudarme.",
          "translation": "Мне никто не может помочь.",
          "source": "Tatoeba #502057 @Shishir / #5565208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/502057",
          "cefr_level": "A1",
          "word_slugs": [
            "ayudarme-verb"
          ]
        },
        {
          "id": "2996351",
          "text": "Gracias por ayudarme.",
          "translation": "Спасибо за оказание мне помощи.",
          "source": "Tatoeba #2996351 @hayastan / #2996371 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2996351",
          "cefr_level": "A1",
          "word_slugs": [
            "ayudarme-verb"
          ]
        },
        {
          "id": "434413",
          "text": "¿Puede usted ayudarme?",
          "translation": "Вы можете мне помочь?",
          "source": "Tatoeba #434413 @lukaszpp / #3886952 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/434413",
          "cefr_level": "A1",
          "word_slugs": [
            "ayudarme-verb"
          ]
        },
        {
          "id": "570551",
          "text": "¿Podría usted ayudarme?",
          "translation": "Вы не могли бы мне помочь?",
          "source": "Tatoeba #570551 @darinmex / #1369270 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/570551",
          "cefr_level": "A1",
          "word_slugs": [
            "ayudarme-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "ayudarme",
