            "llevado-verb"
          ]
        },
        {
          "id": "3836210",
          "text": "El hombre fue llevado en un patrullero.",
          "translation": "Мужчину посадили в полицейский автомобиль.",
          "source": "Tatoeba #3836210 @hayastan / #3836227 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3836210",
          "cefr_level": "A1",
          "word_slugs": [
            "llevado-verb"
          ]
        },
        {
          "id": "5233111",
          "text": "Lo debiste haber llevado a cabo hace mucho.",
