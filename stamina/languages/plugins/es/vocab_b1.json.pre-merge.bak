    {
      "slug": "miembro-noun",
      "lemma": "miembro",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1960,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "limb (a major appendage of a person or animal)",
          "penis"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3666908",
          "text": "No soy miembro del club.",
          "translation": "Я не член клуба.",
          "source": "Tatoeba #3666908 @Seael / #3667087 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3666908",
          "cefr_level": "A1",
          "word_slugs": [
            "miembro-noun"
          ]
        },
        {
          "id": "1335499",
          "text": "Soy miembro del consejo administrativo.",
          "translation": "Я член административного совета.",
          "source": "Tatoeba #1335499 @Shishir / #10301423 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1335499",
          "cefr_level": "A1",
          "word_slugs": [
            "miembro-noun"
          ]
        },
        {
          "id": "1426360",
          "text": "Él es un miembro del comité.",
          "translation": "Он член комитета.",
          "source": "Tatoeba #1426360 @marcelostockle / #414839 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1426360",
          "cefr_level": "A1",
          "word_slugs": [
            "miembro-noun"
          ]
        },
        {
          "id": "3591247",
          "text": "Soy miembro del club de música.",
          "translation": "Я член музыкального клуба.",
          "source": "Tatoeba #3591247 @cueyayotl / #6144403 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3591247",
          "cefr_level": "A1",
          "word_slugs": [
            "miembro-noun"
          ]
        },
        {
          "id": "424056",
          "text": "Soy miembro del club de natación.",
          "translation": "Я состою в клубе пловцов.",
          "source": "Tatoeba #424056 @jordi / #4004819 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/424056",
          "cefr_level": "A1",
          "word_slugs": [
            "miembro-noun"
          ]
        }
      ],
