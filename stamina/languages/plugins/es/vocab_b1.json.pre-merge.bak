    {
      "slug": "millón-noun",
      "lemma": "millón",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1550,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "million (10⁶)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "628675",
          "text": "Esto vale un millón de yenes.",
          "translation": "Это стоит миллион иен.",
          "source": "Tatoeba #628675 @Dejo / #2798176 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/628675",
          "cefr_level": "A1",
          "word_slugs": [
            "millón-noun"
          ]
        },
        {
          "id": "6865322",
          "text": "¿Cómo te gastarías un millón de dólares?",
          "translation": "Как бы ты потратил миллион долларов?",
          "source": "Tatoeba #6865322 @arh / #6865327 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6865322",
          "cefr_level": "A1",
          "word_slugs": [
            "millón-noun"
          ]
        },
        {
          "id": "1258099",
          "text": "Esta ciudad tiene un millón de habitantes.",
          "translation": "В этом городе миллион жителей.",
          "source": "Tatoeba #1258099 @hayastan / #5296265 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1258099",
          "cefr_level": "A1",
          "word_slugs": [
            "millón-noun"
          ]
        },
        {
          "id": "1181024",
          "text": "Si ganaras un millón de yenes, ¿qué harías?",
          "translation": "Если бы ты выиграл миллион иен, что бы ты сделал?",
          "source": "Tatoeba #1181024 @marcelostockle / #4568872 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1181024",
          "cefr_level": "A1",
          "word_slugs": [
            "millón-noun"
          ]
        },
        {
          "id": "989937",
          "text": "Un limón, mil limones, un millón de limones.",
          "translation": "Лимон, тысяча лимонов, миллион лимонов.",
          "source": "Tatoeba #989937 @Shishir / #7357333 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/989937",
          "cefr_level": "A1",
          "word_slugs": [
            "millón-noun"
          ]
        }
      ],
      "tags": [
