    {
      "slug": "preocupe-verb",
      "lemma": "preocupe",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1655,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of preocupar:",
          "first/third-person singular present subjunctive",
          "inflection of preocupar:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2880159",
          "text": "No se preocupe por mí.",
          "translation": "Не беспокойтесь обо мне.",
          "source": "Tatoeba #2880159 @cueyayotl / #5798255 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2880159",
          "cefr_level": "A1",
          "word_slugs": [
            "preocupe-verb"
          ]
        },
        {
          "id": "2902465",
          "text": "No se preocupe. Yo lo hago.",
          "translation": "Не волнуйтесь. Я это сделаю.",
          "source": "Tatoeba #2902465 @marcelostockle / #2903113 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2902465",
          "cefr_level": "A1",
          "word_slugs": [
            "preocupe-verb"
          ]
        },
        {
          "id": "2623597",
          "text": "Tengo un plan. No se preocupe.",
          "translation": "У меня есть план. Не беспокойтесь.",
          "source": "Tatoeba #2623597 @ramonj / #4284183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2623597",
          "cefr_level": "A1",
          "word_slugs": [
            "preocupe-verb"
          ]
        },
        {
          "id": "3762659",
          "text": "No se preocupe. Todo irá bien.",
          "translation": "Не беспокойтесь. Всё будет хорошо.",
          "source": "Tatoeba #3762659 @Seael / #11718285 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3762659",
          "cefr_level": "A1",
          "word_slugs": [
            "preocupe-verb"
          ]
        },
        {
          "id": "3762668",
          "text": "No se preocupe. Todo saldrá bien.",
          "translation": "Не беспокойтесь. Всё будет хорошо.",
          "source": "Tatoeba #3762668 @Seael / #11718285 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3762668",
          "cefr_level": "A1",
          "word_slugs": [
            "preocupe-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
