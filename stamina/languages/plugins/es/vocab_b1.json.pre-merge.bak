    {
      "slug": "disparar-verb",
      "lemma": "disparar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2028,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "выстрелить"
        ],
        "en": [
          "to shoot, to fire (e.g. a weapon, a rocket)",
          "to rise, to go up, to skyrocket",
          "to go off, to be suddenly jolted into action"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2102112",
          "text": "No quiero disparar.",
          "translation": "Я не хочу стрелять.",
          "source": "Tatoeba #2102112 @marcelostockle / #4479277 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2102112",
          "cefr_level": "A1",
          "word_slugs": [
            "disparar-verb"
          ]
        },
        {
          "id": "3076303",
          "text": "Te voy a disparar.",
          "translation": "Я в тебя выстрелю.",
          "source": "Tatoeba #3076303 @marcosruben / #6332691 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3076303",
          "cefr_level": "A1",
          "word_slugs": [
            "disparar-verb"
          ]
        },
        {
          "id": "5840349",
          "text": "Tom rehusó disparar al perro.",
          "translation": "Том отказался стрелять в собаку.",
          "source": "Tatoeba #5840349 @arh / #5879965 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5840349",
          "cefr_level": "A1",
          "word_slugs": [
            "disparar-verb"
          ]
        },
        {
          "id": "4286534",
          "text": "Tuve que disparar a mi caballo.",
          "translation": "Мне пришлось выстрелить в своего коня.",
          "source": "Tatoeba #4286534 @Shishir / #6932562 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4286534",
          "cefr_level": "A1",
          "word_slugs": [
            "disparar-verb"
          ]
        },
        {
          "id": "3531069",
          "text": "Acabo de disparar a alguien, creo.",
          "translation": "Кажется, я только что в кого-то выстрелил.",
          "source": "Tatoeba #3531069 @Aether / #5106462 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3531069",
          "cefr_level": "A1",
          "word_slugs": [
            "disparar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el disparar",
        "plural": "",
        "infinitive": "disparar"
      }
