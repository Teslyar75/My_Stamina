    {
      "slug": "echar-verb",
      "lemma": "echar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1677,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to throw, toss, cast, jettison (to release an object from one's grasp so that it moves through the air)",
          "to pour (to cause to flow in a stream from a container)",
          "to put in, add",
          "to let out"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5124500",
          "text": "Quiero echar panza.",
          "translation": "Я хочу отрастить живот.",
          "source": "Tatoeba #5124500 @ecorralest101 / #6732078 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5124500",
          "cefr_level": "A1",
          "word_slugs": [
            "echar-verb"
          ]
        },
        {
          "id": "5847584",
          "text": "Déjame echar un vistazo.",
          "translation": "Дай мне взглянуть.",
          "source": "Tatoeba #5847584 @albrusgher / #2368528 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5847584",
          "cefr_level": "A1",
          "word_slugs": [
            "echar-verb"
          ]
        },
        {
          "id": "576862",
          "text": "Echar sal en la herida.",
          "translation": "Сыпать соль на рану.",
          "source": "Tatoeba #576862 @Shishir / #381301 @Debor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/576862",
          "cefr_level": "A1",
          "word_slugs": [
            "echar-verb"
          ]
        },
        {
          "id": "4791973",
          "text": "Me gustaría echar un vistazo.",
          "translation": "Я бы хотел взглянуть.",
          "source": "Tatoeba #4791973 @alegarvid / #5684330 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4791973",
          "cefr_level": "A1",
          "word_slugs": [
            "echar-verb"
          ]
        },
        {
          "id": "2216606",
          "text": "¿Te gustaría echar un vistazo?",
          "translation": "Ты бы хотел взглянуть?",
          "source": "Tatoeba #2216606 @Shishir / #4861255 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2216606",
