      "gender": null,
      "examples": [
        {
          "id": "871573",
          "text": "Las damas primero.",
          "translation": "Сначала дамы.",
          "source": "Tatoeba #871573 @Kokoo / #489841 @dasUberDog (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/871573",
