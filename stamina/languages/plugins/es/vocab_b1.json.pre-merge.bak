    {
      "slug": "secundaria-noun",
      "lemma": "secundaria",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2482,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "secondary school, high school"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1041724",
          "text": "Mi hijo está en la secundaria ahora.",
          "translation": "Мой сын сейчас в старшей школе.",
          "source": "Tatoeba #1041724 @hayastan / #3855783 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1041724",
          "cefr_level": "A1",
          "word_slugs": [
            "secundaria-noun"
          ]
        },
        {
          "id": "5992630",
          "text": "Enseño francés a chicos de escuela secundaria.",
          "translation": "Я преподаю французский язык школьникам.",
          "source": "Tatoeba #5992630 @albrusgher / #6153963 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5992630",
          "cefr_level": "A1",
          "word_slugs": [
            "secundaria-noun"
          ]
        },
        {
          "id": "5706084",
          "text": "Abandoné la escuela secundaria a los dieciséis.",
          "translation": "Я бросил школу в шестнадцать лет.",
          "source": "Tatoeba #5706084 @arh / #5706599 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5706084",
          "cefr_level": "A1",
          "word_slugs": [
            "secundaria-noun"
          ]
        },
        {
          "id": "1266431",
          "text": "Estoy terminando la secundaria. Me faltan 2 meses.",
          "translation": "Я заканчиваю школу. Мне осталось два месяца.",
          "source": "Tatoeba #1266431 @wallebot / #7153396 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1266431",
          "cefr_level": "A1",
          "word_slugs": [
            "secundaria-noun"
          ]
        },
        {
          "id": "3070276",
          "text": "Cursé toda la secundaria en una escuela privada.",
          "translation": "Я изучил весь курс средней школы в частном учебном заведении.",
          "source": "Tatoeba #3070276 @hayastan / #3142302 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3070276",
          "cefr_level": "A1",
          "word_slugs": [
            "secundaria-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "secundaria",
        "plural": "",
        "infinitive": ""
      }
    },
