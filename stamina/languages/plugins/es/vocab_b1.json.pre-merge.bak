      },
      "gender": null,
      "examples": [
        {
          "id": "4503085",
          "text": "¿Quiénes son los testigos?",
          "translation": "Кто свидетели?",
          "source": "Tatoeba #4503085 @rsarias / #4509871 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4503085",
          "cefr_level": "A1",
          "word_slugs": [
            "testigos-noun"
          ]
        },
        {
          "id": "853255",
          "text": "Fuimos testigos del accidente.",
          "translation": "Мы были свидетелями аварии.",
          "source": "Tatoeba #853255 @Encanna / #4711885 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/853255",
          "cefr_level": "A1",
          "word_slugs": [
            "testigos-noun"
          ]
        },
        {
          "id": "2268661",
          "text": "Los testigos comparecieron ante el juez.",
