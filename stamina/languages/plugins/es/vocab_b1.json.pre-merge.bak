      },
      "gender": null,
      "examples": [
        {
          "id": "1989082",
          "text": "Hacia el sur.",
          "translation": "На юг.",
          "source": "Tatoeba #1989082 @marcelostockle / #1671415 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1989082",
          "cefr_level": "A1",
          "word_slugs": [
            "sur-noun"
          ]
        },
        {
          "id": "3481190",
          "text": "Él viene del sur.",
          "translation": "Он с юга.",
          "source": "Tatoeba #3481190 @marcelostockle / #6537545 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3481190",
