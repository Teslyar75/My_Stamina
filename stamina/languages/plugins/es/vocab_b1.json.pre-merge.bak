    {
      "slug": "tarjeta-noun",
      "lemma": "tarjeta",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1336,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "card (only sometimes, see carta)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1279968",
          "text": "Aquí está mi tarjeta.",
          "translation": "Вот моя карточка.",
          "source": "Tatoeba #1279968 @marcelostockle / #4669797 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1279968",
          "cefr_level": "A1",
          "word_slugs": [
            "tarjeta-noun"
          ]
        },
        {
          "id": "360366",
          "text": "¿Acepta tarjeta de crédito?",
          "translation": "Вы принимаете кредитные карты?",
          "source": "Tatoeba #360366 @tatoerique / #1709388 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/360366",
          "cefr_level": "A1",
          "word_slugs": [
            "tarjeta-noun"
          ]
        },
        {
