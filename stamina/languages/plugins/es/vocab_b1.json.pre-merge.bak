    {
      "slug": "dioses-noun",
      "lemma": "dioses",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2467,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of dios"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11568718",
          "text": "Creemos en dioses diferentes.",
          "translation": "Мы верим в разных богов.",
          "source": "Tatoeba #11568718 @carlosalberto / #11568760 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11568718",
          "cefr_level": "A1",
          "word_slugs": [
            "dioses-noun"
          ]
        },
        {
          "id": "1666964",
          "text": "Nuestros dioses están muertos.",
          "translation": "Наши боги мертвы.",
          "source": "Tatoeba #1666964 @alexmarcelo / #4999167 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1666964",
          "cefr_level": "A1",
          "word_slugs": [
            "dioses-noun"
          ]
        },
        {
          "id": "5186659",
          "text": "¡Que los dioses te bendigan!",
          "translation": "Да благословят тебя боги!",
          "source": "Tatoeba #5186659 @Leono / #5186701 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5186659",
          "cefr_level": "A1",
          "word_slugs": [
            "dioses-noun"
          ]
        },
        {
          "id": "2974726",
          "text": "Somos solo hombres, no dioses.",
          "translation": "Мы всего лишь люди, а не боги.",
          "source": "Tatoeba #2974726 @marcelostockle / #2976126 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2974726",
          "cefr_level": "A1",
          "word_slugs": [
            "dioses-noun"
          ]
        },
        {
          "id": "4567475",
          "text": "Los antiguos dioses están despertando.",
          "translation": "Древние боги просыпаются.",
          "source": "Tatoeba #4567475 @DarkHollow / #7262868 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4567475",
          "cefr_level": "A1",
          "word_slugs": [
            "dioses-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
