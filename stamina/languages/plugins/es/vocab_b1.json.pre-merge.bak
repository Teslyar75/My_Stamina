    {
      "slug": "gana-noun",
      "lemma": "gana",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1635,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "best translated with to feel like, to want",
          "urge, uses a \"tengo ganas de\" or \"me dan ganas de\" construction"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2386864",
          "text": "Gana mucho dinero.",
          "translation": "Он зарабатывает много денег.",
          "source": "Tatoeba #2386864 @Shishir / #10966767 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2386864",
          "cefr_level": "A1",
          "word_slugs": [
            "gana-noun"
          ]
        },
        {
          "id": "1901096",
          "text": "La confianza se gana.",
          "translation": "Доверие надо заслужить.",
          "source": "Tatoeba #1901096 @marcelostockle / #7108770 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1901096",
          "cefr_level": "A1",
          "word_slugs": [
            "gana-noun"
          ]
        },
        {
          "id": "12689786",
          "text": "El bien siempre gana.",
          "translation": "Добро всегда побеждает.",
          "source": "Tatoeba #12689786 @Adelpa / #12689787 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12689786",
          "cefr_level": "A1",
          "word_slugs": [
