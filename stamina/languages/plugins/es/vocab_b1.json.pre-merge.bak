    {
      "slug": "sobrevivir-verb",
      "lemma": "sobrevivir",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2134,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to survive"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5057105",
          "text": "Voy a sobrevivir.",
          "translation": "Я выживу.",
          "source": "Tatoeba #5057105 @don_ramon / #4112344 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5057105",
          "cefr_level": "A1",
          "word_slugs": [
            "sobrevivir-verb"
          ]
        },
        {
          "id": "6164621",
          "text": "Ninguno logró sobrevivir.",
          "translation": "Выжить никому не удалось.",
          "source": "Tatoeba #6164621 @baudelaire / #6487434 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6164621",
          "cefr_level": "A1",
          "word_slugs": [
            "sobrevivir-verb"
          ]
        },
        {
          "id": "1824976",
          "text": "No puedes sobrevivir sin dinero.",
          "translation": "Без денег не выживешь.",
          "source": "Tatoeba #1824976 @Shishir / #13564751 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1824976",
          "cefr_level": "A1",
          "word_slugs": [
            "sobrevivir-verb"
          ]
        },
        {
          "id": "1192171",
          "text": "No se puede sobrevivir sin dinero.",
          "translation": "Без денег нельзя выжить.",
          "source": "Tatoeba #1192171 @Shishir / #1467140 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1192171",
          "cefr_level": "A1",
          "word_slugs": [
            "sobrevivir-verb"
          ]
        },
        {
          "id": "1329963",
          "text": "La compañía está luchando para sobrevivir.",
          "translation": "Компания борется за выживание.",
          "source": "Tatoeba #1329963 @Kiraness / #1443690 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1329963",
          "cefr_level": "A1",
          "word_slugs": [
            "sobrevivir-verb"
          ]
        }
      ],
