    {
      "slug": "papa-noun",
      "lemma": "papa",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1594,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "very bland soup, or more broadly, food in general",
          "nonsense, trifle, rubbish"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3862386",
          "text": "No sé ni papa.",
          "translation": "Я не знаю ничего.",
          "source": "Tatoeba #3862386 @ManuelML / #3533800 @Mictlantecuhtli (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3862386",
          "cefr_level": "A1",
          "word_slugs": [
            "papa-noun"
          ]
        },
        {
          "id": "1108132",
          "text": "El Papa visitó Brasil.",
          "translation": "Папа Римский посетил Бразилию.",
