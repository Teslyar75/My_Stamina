    {
      "slug": "vea-verb",
      "lemma": "vea",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1268,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of ver:",
          "first/third-person singular present subjunctive",
          "inflection of ver:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4343829",
          "text": "¿Qué quieres que vea?",
          "translation": "Что ты хочешь, чтобы я увидел?",
          "source": "Tatoeba #4343829 @Shishir / #4343838 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4343829",
          "cefr_level": "A1",
          "word_slugs": [
            "vea-verb"
          ]
        },
        {
          "id": "3564769",
          "text": "Necesito que Tom vea esto.",
          "translation": "Мне нужно, чтобы Том это увидел.",
          "source": "Tatoeba #3564769 @ficion / #3566210 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3564769",
          "cefr_level": "A1",
          "word_slugs": [
            "vea-verb"
          ]
        },
        {
          "id": "6103618",
          "text": "No quiero que me vea así.",
          "translation": "Я не хочу, чтобы он видел меня таким.",
          "source": "Tatoeba #6103618 @Shishir / #11572270 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6103618",
          "cefr_level": "A1",
          "word_slugs": [
            "vea-verb"
          ]
        },
        {
          "id": "1654699",
          "text": "No dejes que nadie te vea.",
          "translation": "Не дай никому увидеть себя.",
          "source": "Tatoeba #1654699 @marcelostockle / #1537584 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1654699",
          "cefr_level": "A1",
          "word_slugs": [
            "vea-verb"
          ]
        },
        {
          "id": "2782029",
          "text": "No quiero que Tom vea esto.",
          "translation": "Я не хочу, чтобы Том это видел.",
          "source": "Tatoeba #2782029 @marcelostockle / #2782033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2782029",
          "cefr_level": "A1",
          "word_slugs": [
            "vea-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
