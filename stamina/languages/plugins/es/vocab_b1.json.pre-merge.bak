          "to fight for, to struggle against",
          "to mutually fight"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1522822",
          "text": "Tom sabe pelear.",
          "translation": "Том умеет драться.",
          "source": "Tatoeba #1522822 @marcelostockle / #5515352 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1522822",
          "cefr_level": "A1",
          "word_slugs": [
            "pelear-verb"
          ]
        },
        {
          "id": "1522821",
          "text": "Mary sabe pelear.",
          "translation": "Мэри умеет драться.",
          "source": "Tatoeba #1522821 @marcelostockle / #12974395 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1522821",
          "cefr_level": "A1",
          "word_slugs": [
            "pelear-verb"
          ]
        },
        {
          "id": "2102113",
          "text": "No quiero pelear.",
          "translation": "Я не хочу драться.",
          "source": "Tatoeba #2102113 @marcelostockle / #5927390 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2102113",
          "cefr_level": "A1",
          "word_slugs": [
            "pelear-verb"
          ]
        },
        {
          "id": "2595757",
          "text": "Ellos empezaron a pelear.",
          "translation": "Они начали ругаться.",
          "source": "Tatoeba #2595757 @hayastan / #2596391 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2595757",
          "cefr_level": "A1",
          "word_slugs": [
            "pelear-verb"
          ]
        },
        {
          "id": "3395986",
          "text": "No quiero pelear contigo.",
          "translation": "Я не хочу с тобой драться.",
          "source": "Tatoeba #3395986 @marcelostockle / #2561387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3395986",
          "cefr_level": "A1",
          "word_slugs": [
