      "gender": null,
      "examples": [
        {
          "id": "10797929",
          "text": "Dirígete hacia el oeste.",
          "translation": "Направляйся на запад.",
          "source": "Tatoeba #10797929 @Curro / #8994331 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10797929",
