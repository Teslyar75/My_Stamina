      "gender": null,
      "examples": [
        {
          "id": "7860126",
          "text": "Usa la llave.",
          "translation": "Воспользуйся ключом.",
          "source": "Tatoeba #7860126 @arh / #7860733 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7860126",
          "cefr_level": "A1",
