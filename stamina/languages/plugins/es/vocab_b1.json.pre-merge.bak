          "source": "Tatoeba #10545377 @carlosalberto / #1948044 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10545377",
          "cefr_level": "A1",
          "word_slugs": [
            "memoria-noun"
          ]
        },
        {
          "id": "1137031",
          "text": "Él perdió la memoria.",
          "translation": "Он потерял память.",
          "source": "Tatoeba #1137031 @marcelostockle / #2220739 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1137031",
          "cefr_level": "A1",
          "word_slugs": [
            "memoria-noun"
          ]
        },
        {
          "id": "1296945",
          "text": "Tom perdió la memoria.",
          "translation": "Том потерял память.",
          "source": "Tatoeba #1296945 @marcelostockle / #2983271 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1296945",
          "cefr_level": "A1",
          "word_slugs": [
