          ]
        },
        {
          "id": "1651249",
          "text": "Encantado de conocerlo, Ken.",
          "translation": "Рад с тобой познакомиться, Кен.",
          "source": "Tatoeba #1651249 @marcelostockle / #2157771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1651249",
