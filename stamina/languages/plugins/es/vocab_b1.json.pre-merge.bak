    {
      "slug": "sabéis-verb",
      "lemma": "sabéis",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2290,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person plural present indicative of saber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1287327",
          "text": "Como ya sabéis.",
          "translation": "Как вы уже знаете.",
          "source": "Tatoeba #1287327 @Shishir / #497510 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1287327",
          "cefr_level": "A1",
          "word_slugs": [
            "sabéis-verb"
          ]
        },
        {
          "id": "1238871",
          "text": "¿Cómo lo sabéis?",
          "translation": "Откуда вы знаете?",
          "source": "Tatoeba #1238871 @Shishir / #4507927 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1238871",
          "cefr_level": "A1",
          "word_slugs": [
            "sabéis-verb"
          ]
        },
        {
          "id": "5629638",
          "text": "¿No sabéis leer?",
          "translation": "Вы не умеете читать?",
          "source": "Tatoeba #5629638 @arh / #2589906 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629638",
          "cefr_level": "A1",
          "word_slugs": [
            "sabéis-verb"
          ]
        },
        {
          "id": "2720081",
          "text": "Sabéis quién soy.",
          "translation": "Вы знаете, кто я.",
          "source": "Tatoeba #2720081 @Shishir / #2718370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2720081",
          "cefr_level": "A1",
          "word_slugs": [
            "sabéis-verb"
          ]
        },
        {
          "id": "10106092",
          "text": "¿Sabéis quién soy?",
          "translation": "Вы знаете, кто я?",
          "source": "Tatoeba #10106092 @arh / #2727075 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10106092",
          "cefr_level": "A1",
