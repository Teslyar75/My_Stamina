    {
      "slug": "actuar-verb",
      "lemma": "actuar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1813,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to act, to behave",
          "to act, to perform",
          "to actuate",
          "to litigate, to sue"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5920600",
          "text": "¡Hay que actuar!",
          "translation": "Надо действовать!",
          "source": "Tatoeba #5920600 @baudelaire / #6489373 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5920600",
          "cefr_level": "A1",
          "word_slugs": [
            "actuar-verb"
          ]
        },
        {
          "id": "6814192",
          "text": "Tenemos que actuar.",
          "translation": "Нам надо действовать.",
          "source": "Tatoeba #6814192 @Adelpa / #6816582 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6814192",
          "cefr_level": "A1",
          "word_slugs": [
            "actuar-verb"
          ]
        },
        {
          "id": "2971685",
          "text": "Hay que actuar rápido.",
          "translation": "Надо действовать быстро.",
          "source": "Tatoeba #2971685 @hayastan / #2972922 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2971685",
          "cefr_level": "A1",
          "word_slugs": [
            "actuar-verb"
          ]
        },
        {
          "id": "597660",
          "text": "¡Piensa antes de actuar!",
          "translation": "Думай, прежде чем делать!",
          "source": "Tatoeba #597660 @Shishir / #2264020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/597660",
          "cefr_level": "A1",
          "word_slugs": [
            "actuar-verb"
          ]
        },
        {
          "id": "7451768",
          "text": "Reflexiona antes de actuar.",
          "translation": "Думай перед тем, как действовать.",
          "source": "Tatoeba #7451768 @arh / #7453760 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7451768",
          "cefr_level": "A1",
          "word_slugs": [
            "actuar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el actuar",
        "plural": "",
        "infinitive": "actuar"
      }
