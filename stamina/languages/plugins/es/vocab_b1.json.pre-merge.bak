    {
      "slug": "cura-noun",
      "lemma": "cura",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2204,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "кюре"
        ],
        "en": [
          "cure (something that restores good health)",
          "drunkenness"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2372675",
          "text": "No hay cura.",
          "translation": "Это не лечится.",
          "source": "Tatoeba #2372675 @hayastan / #4486098 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2372675",
          "cefr_level": "A1",
          "word_slugs": [
            "cura-noun"
          ]
        },
        {
          "id": "3567128",
          "text": "Esto se cura pronto.",
          "translation": "До свадьбы заживет.",
          "source": "Tatoeba #3567128 @carlosalberto / #3566288 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3567128",
          "cefr_level": "A1",
          "word_slugs": [
            "cura-noun"
          ]
        },
        {
          "id": "1296320",
          "text": "¿El daltonismo tiene cura?",
          "translation": "Дальтонизм излечим?",
          "source": "Tatoeba #1296320 @hayastan / #3161594 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1296320",
          "cefr_level": "A1",
          "word_slugs": [
            "cura-noun"
          ]
        },
        {
          "id": "1302840",
          "text": "El tiempo todo lo cura.",
          "translation": "Время всё лечит.",
          "source": "Tatoeba #1302840 @enteka / #2269393 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1302840",
          "cefr_level": "A1",
          "word_slugs": [
            "cura-noun"
          ]
        },
        {
          "id": "1175334",
          "text": "La calvicie no tiene cura.",
          "translation": "Плешивость неизлечима.",
          "source": "Tatoeba #1175334 @marcelostockle / #2689222 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1175334",
          "cefr_level": "A1",
