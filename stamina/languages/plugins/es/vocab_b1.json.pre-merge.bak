    {
      "slug": "espada-noun",
      "lemma": "espada",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1862,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "меч"
        ],
        "en": [
          "sword (a long bladed weapon with a grip and typically a pommel and crossguard (together forming a hilt), which is designed to cut, stab, slash and/or hack)",
          "spade (playing card marked with the symbol ♠)",
          "épée (fencing sword of a certain modern type)",
          "sword (the weapon used as a heraldic charge)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1078690",
          "text": "Dame mi espada.",
          "translation": "Дай мне мой меч.",
          "source": "Tatoeba #1078690 @hayastan / #4476111 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1078690",
          "cefr_level": "A1",
          "word_slugs": [
            "espada-noun"
          ]
        },
        {
          "id": "1492050",
          "text": "¡Quiero una espada!",
          "translation": "Я хочу меч!",
          "source": "Tatoeba #1492050 @marcelostockle / #1361998 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1492050",
          "cefr_level": "A1",
          "word_slugs": [
            "espada-noun"
          ]
        },
        {
          "id": "4505662",
          "text": "Comimos pez espada.",
          "translation": "Мы ели меч-рыбу.",
          "source": "Tatoeba #4505662 @cueyayotl / #7124544 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4505662",
          "cefr_level": "A1",
          "word_slugs": [
            "espada-noun"
          ]
        },
        {
          "id": "5019940",
          "text": "¡Quiero tener una espada!",
          "translation": "Я хочу себе меч!",
          "source": "Tatoeba #5019940 @Mavry / #6714778 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5019940",
          "cefr_level": "A1",
          "word_slugs": [
            "espada-noun"
          ]
        },
        {
          "id": "1362003",
          "text": "¡Quiero una espada como esta!",
          "translation": "Я хочу такую шпагу, как эта!",
