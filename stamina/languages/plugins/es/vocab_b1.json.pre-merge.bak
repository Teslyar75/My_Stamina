    {
      "slug": "pasan-verb",
      "lemma": "pasan",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2409,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural present indicative of pasar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5115309",
          "text": "Estas cosas pasan.",
          "translation": "Такие вещи случаются.",
          "source": "Tatoeba #5115309 @don_ramon / #4759023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5115309",
          "cefr_level": "A1",
          "word_slugs": [
            "pasan-verb"
          ]
        },
        {
          "id": "1401135",
          "text": "Los años pasan rápido.",
          "translation": "Годы проходят быстро.",
          "source": "Tatoeba #1401135 @marcelostockle / #12236476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1401135",
          "cefr_level": "A1",
          "word_slugs": [
            "pasan-verb"
          ]
        },
        {
          "id": "2982155",
          "text": "¿Por qué pasan cosas malas?",
          "translation": "Почему случаются плохие вещи?",
          "source": "Tatoeba #2982155 @hayastan / #4637203 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2982155",
          "cefr_level": "A1",
          "word_slugs": [
            "pasan-verb"
          ]
        },
        {
          "id": "5787605",
          "text": "Los días felices pasan rápido.",
          "translation": "Счастливые дни проходят быстро.",
          "source": "Tatoeba #5787605 @solmyrbcn / #7081462 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5787605",
          "cefr_level": "A1",
          "word_slugs": [
            "pasan-verb"
          ]
        },
        {
          "id": "3013943",
          "text": "Ellos pasan mucho tiempo juntos.",
          "translation": "Они проводят много времени вместе.",
          "source": "Tatoeba #3013943 @hayastan / #3013947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3013943",
          "cefr_level": "A1",
          "word_slugs": [
            "pasan-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "pasan",
        "plural": "",
        "infinitive": "pasan"
      }
