    {
      "slug": "encuentras-verb",
      "lemma": "encuentras",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2082,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular present indicative of encontrar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2639491",
          "text": "Si buscas, encuentras.",
          "translation": "Если ищешь - найдёшь.",
          "source": "Tatoeba #2639491 @Shishir / #2639499 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2639491",
          "cefr_level": "A1",
          "word_slugs": [
            "encuentras-verb"
          ]
        },
        {
          "id": "2175114",
          "text": "¿La encuentras atractiva?",
          "translation": "Ты считаешь её привлекательной?",
          "source": "Tatoeba #2175114 @marcelostockle / #2489626 @ichigo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2175114",
          "cefr_level": "A1",
          "word_slugs": [
            "encuentras-verb"
          ]
        },
        {
          "id": "1085426",
          "text": "Llámame si encuentras algo.",
          "translation": "Позвони мне, если найдёшь что-нибудь.",
          "source": "Tatoeba #1085426 @Shishir / #1772307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1085426",
          "cefr_level": "A1",
          "word_slugs": [
            "encuentras-verb"
          ]
        },
        {
          "id": "5543263",
          "text": "Si encuentras algo, llámame.",
          "translation": "Если что-нибудь найдёшь, позвони мне.",
          "source": "Tatoeba #5543263 @baudelaire / #6167709 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5543263",
          "cefr_level": "A1",
          "word_slugs": [
            "encuentras-verb"
          ]
        },
        {
          "id": "2671",
          "text": "¿Cómo encuentras comida en el espacio?",
          "translation": "Как ты найдешь еду в космосе?",
          "source": "Tatoeba #2671 @Shishir / #5598 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2671",
          "cefr_level": "A1",
          "word_slugs": [
            "encuentras-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "encuentras",
        "plural": "",
        "infinitive": "encuentras"
      }
