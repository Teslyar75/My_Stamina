          "superlative degree of joven: youngest"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2112139",
          "text": "Yo soy menor que él.",
          "translation": "Я моложе него.",
          "source": "Tatoeba #2112139 @marcelostockle / #3609265 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2112139",
          "cefr_level": "A1",
