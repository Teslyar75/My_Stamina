    {
      "slug": "gloria-noun",
      "lemma": "gloria",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2072,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "glory"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5089913",
          "text": "Nuestra gloria será eterna.",
          "translation": "Наша слава будет вечной.",
          "source": "Tatoeba #5089913 @alexmarcelo / #5090514 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5089913",
          "cefr_level": "A1",
          "word_slugs": [
            "gloria-noun"
          ]
        },
        {
          "id": "9571270",
          "text": "¡Honor y gloria a la URSS!",
          "translation": "Честь и слава СССР!",
          "source": "Tatoeba #9571270 @Ivanovb / #9572592 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9571270",
          "cefr_level": "A1",
          "word_slugs": [
            "gloria-noun"
          ]
        },
        {
          "id": "430434",
          "text": "Así pasa la gloria del mundo.",
          "translation": "Так проходит мирская слава.",
          "source": "Tatoeba #430434 @jerom / #637652 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/430434",
          "cefr_level": "A1",
          "word_slugs": [
            "gloria-noun"
          ]
        },
        {
          "id": "969760",
          "text": "La gloria de Cicerón empezó a crecer.",
          "translation": "Слава Цицерона начала расти.",
          "source": "Tatoeba #969760 @hundo / #2494406 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/969760",
          "cefr_level": "A1",
          "word_slugs": [
            "gloria-noun"
          ]
        },
        {
          "id": "2503336",
          "text": "Él aspiraba más al dinero que a la gloria.",
          "translation": "Он больше стремился к деньгам, чем к славе.",
          "source": "Tatoeba #2503336 @marcelostockle / #6462839 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2503336",
          "cefr_level": "A1",
          "word_slugs": [
            "gloria-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "gloria",
        "plural": "",
        "infinitive": ""
      }
