            "muere-verb"
          ]
        },
        {
          "id": "1386269",
          "text": "¡Hazlo o muere!",
          "translation": "Сделай это или умри!",
          "source": "Tatoeba #1386269 @marcelostockle / #9732326 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1386269",
          "cefr_level": "A1",
          "word_slugs": [
            "muere-verb"
          ]
        },
        {
          "id": "3116760",
          "text": "¡Compra o muere!",
          "translation": "Купи или умри!",
          "source": "Tatoeba #3116760 @marcelostockle / #3525800 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3116760",
          "cefr_level": "A1",
          "word_slugs": [
            "muere-verb"
          ]
        },
        {
          "id": "1469370",
          "text": "Globaliza o muere.",
          "translation": "Глобализируйся или умри.",
          "source": "Tatoeba #1469370 @marcelostockle / #14078306 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1469370",
          "cefr_level": "A1",
          "word_slugs": [
            "muere-verb"
          ]
        },
        {
          "id": "5497496",
          "text": "El amor no muere.",
          "translation": "Любовь не умирает.",
          "source": "Tatoeba #5497496 @Leono / #4253766 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497496",
          "cefr_level": "A1",
          "word_slugs": [
            "muere-verb"
          ]
        }
      ],
