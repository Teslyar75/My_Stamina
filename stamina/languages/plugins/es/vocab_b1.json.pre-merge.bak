          ]
        },
        {
          "id": "6313171",
          "text": "Yo quería conducir.",
          "translation": "Я хотел сесть за руль.",
          "source": "Tatoeba #6313171 @baudelaire / #6487315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6313171",
          "cefr_level": "A1",
