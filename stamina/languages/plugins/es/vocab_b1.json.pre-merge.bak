    {
      "slug": "perdiendo-verb",
      "lemma": "perdiendo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1961,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "gerund of perder"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2228323",
          "text": "Me estás perdiendo.",
          "translation": "Ты меня теряешь.",
          "source": "Tatoeba #2228323 @hayastan / #4930907 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2228323",
          "cefr_level": "A1",
          "word_slugs": [
            "perdiendo-verb"
          ]
        },
        {
          "id": "9858975",
          "text": "Tom está perdiendo.",
          "translation": "Том проигрывает.",
          "source": "Tatoeba #9858975 @DJ_Saidez / #5886981 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9858975",
          "cefr_level": "A1",
          "word_slugs": [
            "perdiendo-verb"
          ]
        },
        {
          "id": "2474722",
          "text": "Estoy perdiendo tiempo.",
          "translation": "Я теряю время.",
          "source": "Tatoeba #2474722 @hayastan / #3052698 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2474722",
          "cefr_level": "A1",
          "word_slugs": [
            "perdiendo-verb"
          ]
        },
        {
          "id": "3231914",
          "text": "Estás perdiendo sangre.",
          "translation": "Ты теряешь кровь.",
          "source": "Tatoeba #3231914 @Shishir / #3963408 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3231914",
          "cefr_level": "A1",
          "word_slugs": [
            "perdiendo-verb"
          ]
        },
        {
          "id": "2474729",
          "text": "Estoy perdiendo clientes.",
          "translation": "Я теряю клиентов.",
          "source": "Tatoeba #2474729 @hayastan / #3634831 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2474729",
          "cefr_level": "A1",
          "word_slugs": [
            "perdiendo-verb"
          ]
        }
