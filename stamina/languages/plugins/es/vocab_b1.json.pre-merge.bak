    {
      "slug": "dígame-verb",
      "lemma": "dígame",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1909,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular imperative of decir combined with me; tell me"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "571886",
          "text": "Dígame la verdad.",
          "translation": "Скажите мне правду!",
          "source": "Tatoeba #571886 @Shishir / #4209655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/571886",
          "cefr_level": "A1",
          "word_slugs": [
            "dígame-verb"
          ]
        },
        {
          "id": "1246362",
          "text": "Dígame su nombre.",
          "translation": "Скажите мне своё имя.",
          "source": "Tatoeba #1246362 @Shishir / #3006412 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246362",
          "cefr_level": "A1",
          "word_slugs": [
            "dígame-verb"
          ]
        },
        {
          "id": "855252",
          "text": "Dígame cómo se llama.",
          "translation": "Скажите мне, как Вас зовут.",
          "source": "Tatoeba #855252 @rafermom / #3006414 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/855252",
          "cefr_level": "A1",
          "word_slugs": [
            "dígame-verb"
          ]
        },
        {
          "id": "11829629",
          "text": "Dígame cuánto le debo.",
          "translation": "Скажите мне, сколько я Вам должен.",
          "source": "Tatoeba #11829629 @Seael / #11829781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11829629",
          "cefr_level": "A1",
          "word_slugs": [
            "dígame-verb"
          ]
        },
        {
          "id": "5782765",
          "text": "¡Sólo dígame qué hacer!",
          "translation": "Просто скажите мне, что делать!",
          "source": "Tatoeba #5782765 @MrMultilingual / #3002577 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5782765",
          "cefr_level": "A1",
          "word_slugs": [
            "dígame-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "dígame",
        "plural": "",
        "infinitive": "dígame"
      }
