    {
      "slug": "tuviera-verb",
      "lemma": "tuviera",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1329,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect subjunctive of tener"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1097094",
          "text": "Si tuviera tiempo, te ayudaría.",
          "translation": "Если бы у меня было время, я бы тебе помог.",
          "source": "Tatoeba #1097094 @Shishir / #2929547 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1097094",
          "cefr_level": "A1",
          "word_slugs": [
            "tuviera-verb"
          ]
        },
        {
          "id": "521119",
          "text": "Si tuviera tiempo, podría ayudarte.",
          "translation": "Если бы у меня было время, я бы мог тебе помочь.",
          "source": "Tatoeba #521119 @darinmex / #3246281 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/521119",
          "cefr_level": "A1",
          "word_slugs": [
            "tuviera-verb"
          ]
        },
        {
          "id": "844045",
          "text": "Si tuviera tiempo iría al cine.",
          "translation": "Будь у меня время, я бы пошёл в кино.",
          "source": "Tatoeba #844045 @Shishir / #3364817 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/844045",
          "cefr_level": "A1",
          "word_slugs": [
            "tuviera-verb"
          ]
        },
        {
          "id": "2323417",
          "text": "Puede que Tom no tuviera tiempo.",
          "translation": "Возможно, у Тома не было времени.",
          "source": "Tatoeba #2323417 @Shishir / #5215782 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2323417",
          "cefr_level": "A1",
          "word_slugs": [
            "tuviera-verb"
          ]
        },
        {
          "id": "669695",
          "text": "Si yo tuviera veinte, podría votar.",
          "translation": "Если бы мне было двадцать лет, я мог бы голосовать.",
          "source": "Tatoeba #669695 @leoruilova / #2173102 @Leonid204 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/669695",
          "cefr_level": "A1",
          "word_slugs": [
            "tuviera-verb"
          ]
        }
      ],
