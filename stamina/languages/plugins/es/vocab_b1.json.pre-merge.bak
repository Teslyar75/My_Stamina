          "caught up in"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1264417",
          "text": "El impostor fue atrapado.",
          "translation": "Самозванца поймали.",
          "source": "Tatoeba #1264417 @marcelostockle / #4989720 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1264417",
          "cefr_level": "A1",
          "word_slugs": [
            "atrapado-adj"
          ]
        },
        {
          "id": "5752605",
          "text": "Estoy atrapado en Boston.",
