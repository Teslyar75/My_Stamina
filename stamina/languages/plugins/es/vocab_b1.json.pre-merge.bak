          ]
        },
        {
          "id": "5038622",
          "text": "Primero las damas.",
          "translation": "Сначала дамы.",
          "source": "Tatoeba #5038622 @don_ramon / #489841 @dasUberDog (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5038622",
