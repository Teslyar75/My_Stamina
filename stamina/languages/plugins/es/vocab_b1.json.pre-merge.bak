      "gender": null,
      "examples": [
        {
          "id": "1451699",
          "text": "Iremos apenas él llegue.",
          "translation": "Пойдём, как только он приедет.",
          "source": "Tatoeba #1451699 @marcelostockle / #7761868 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1451699",
          "cefr_level": "A1",
          "word_slugs": [
            "llegue-noun"
          ]
        },
        {
          "id": "2950996",
          "text": "Ojalá que llegue mañana.",
          "translation": "Скорей бы настало завтра.",
          "source": "Tatoeba #2950996 @Tono / #2947262 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2950996",
          "cefr_level": "A1",
          "word_slugs": [
            "llegue-noun"
          ]
        },
        {
          "id": "1870431",
          "text": "Avísame apenas él llegue.",
          "translation": "Как только он вернётся, сообщи мне.",
          "source": "Tatoeba #1870431 @marcelostockle / #7244593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1870431",
          "cefr_level": "A1",
          "word_slugs": [
            "llegue-noun"
          ]
        },
        {
          "id": "1317282",
          "text": "¿Me avisás cuando él llegue?",
          "translation": "Ты сообщишь мне, когда он придёт?",
          "source": "Tatoeba #1317282 @hayastan / #4174703 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1317282",
          "cefr_level": "A1",
          "word_slugs": [
            "llegue-noun"
          ]
        },
        {
          "id": "1831953",
          "text": "Comeré cuando llegue a casa.",
          "translation": "Я поем, когда приду домой.",
          "source": "Tatoeba #1831953 @Shishir / #5715151 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1831953",
