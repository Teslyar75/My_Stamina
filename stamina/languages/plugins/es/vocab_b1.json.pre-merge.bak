          "word_slugs": [
            "sois-verb"
          ]
        },
        {
          "id": "9817407",
          "text": "Sois una amenaza.",
          "translation": "Вы представляете собой угрозу.",
          "source": "Tatoeba #9817407 @Shishir / #13118135 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9817407",
