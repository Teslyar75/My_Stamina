      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2093,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of escuchar:",
          "third-person plural present subjunctive",
          "inflection of escuchar:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "456314",
          "text": "Escuchen lo que dice el profesor.",
          "translation": "Слушайте, что говорит учитель.",
          "source": "Tatoeba #456314 @lukaszpp / #538261 @tirpitz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/456314",
          "cefr_level": "A1",
          "word_slugs": [
            "escuchen-verb"
          ]
        },
        {
          "id": "5016701",
          "text": "Quiero preguntarte algo sin que los demás escuchen.",
          "translation": "Я хочу у тебя кое-что спросить, только так, чтобы другие не слышали.",
          "source": "Tatoeba #5016701 @don_ramon / #5018711 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5016701",
          "cefr_level": "A1",
          "word_slugs": [
            "escuchen-verb"
          ]
        },
        {
          "id": "1554627",
          "text": "Ya no sé qué más hacer para que mis padres me escuchen.",
          "translation": "Я уже не знаю, что ещё сделать, чтобы родители меня услышали.",
          "source": "Tatoeba #1554627 @hayastan / #6292270 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1554627",
          "cefr_level": "A1",
          "word_slugs": [
            "escuchen-verb"
          ]
        }
