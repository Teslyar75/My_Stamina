    {
      "slug": "reglas-noun",
      "lemma": "reglas",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1250,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of regla"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1686973",
          "text": "No hay reglas.",
          "translation": "Правил не существует.",
          "source": "Tatoeba #1686973 @Shishir / #12130979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1686973",
          "cefr_level": "A1",
          "word_slugs": [
            "reglas-noun"
          ]
        },
        {
          "id": "3525179",
          "text": "Odio las reglas.",
          "translation": "Я ненавижу правила.",
          "source": "Tatoeba #3525179 @cueyayotl / #3525792 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3525179",
          "cefr_level": "A1",
          "word_slugs": [
            "reglas-noun"
          ]
        },
        {
          "id": "1674290",
          "text": "Rompiste las reglas.",
          "translation": "Ты нарушила правила.",
          "source": "Tatoeba #1674290 @termito2nd / #5054077 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1674290",
          "cefr_level": "A1",
          "word_slugs": [
            "reglas-noun"
          ]
        },
        {
          "id": "12159852",
          "text": "Seguimos las reglas.",
          "translation": "Мы следуем правилам.",
          "source": "Tatoeba #12159852 @Adelpa / #12160357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12159852",
          "cefr_level": "A1",
          "word_slugs": [
            "reglas-noun"
          ]
        },
        {
          "id": "5834140",
          "text": "Tenemos estrictas reglas.",
          "translation": "У нас строгие правила.",
          "source": "Tatoeba #5834140 @albrusgher / #4746425 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5834140",
