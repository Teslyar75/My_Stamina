          "cefr_level": "A1",
          "word_slugs": [
            "negra-noun"
          ]
        },
        {
          "id": "1556142",
          "text": "Tom practica magia negra.",
          "translation": "Том практикует чёрную магию.",
          "source": "Tatoeba #1556142 @hayastan / #3285705 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1556142",
          "cefr_level": "A1",
          "word_slugs": [
            "negra-noun"
          ]
        },
        {
          "id": "3033132",
          "text": "Tom solo usa ropa negra.",
          "translation": "Том носит только чёрную одежду.",
