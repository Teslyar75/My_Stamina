          "cefr_level": "A1",
          "word_slugs": [
            "siguen-verb"
          ]
        },
        {
          "id": "3302366",
          "text": "¿Aún siguen enojadas conmigo?",
          "translation": "Ты всё ещё на меня злишься?",
          "source": "Tatoeba #3302366 @marcelostockle / #5971213 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3302366",
          "cefr_level": "A1",
          "word_slugs": [
            "siguen-verb"
          ]
        },
        {
          "id": "7817561",
          "text": "Las cosas siguen mejorándose.",
          "translation": "Дела продолжают улучшаться.",
          "source": "Tatoeba #7817561 @gianich73 / #7816607 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7817561",
          "cefr_level": "A1",
          "word_slugs": [
            "siguen-verb"
          ]
        }
      ],
