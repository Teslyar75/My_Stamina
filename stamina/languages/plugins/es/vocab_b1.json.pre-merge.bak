    {
      "slug": "proteger-verb",
      "lemma": "proteger",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1748,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to protect, to defend"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3562841",
          "text": "Yo puedo proteger a Tom.",
          "translation": "Я могу защитить Тома.",
          "source": "Tatoeba #3562841 @ficion / #3566279 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3562841",
          "cefr_level": "A1",
          "word_slugs": [
            "proteger-verb"
          ]
        },
        {
          "id": "3564847",
          "text": "No puedo proteger a Tom.",
          "translation": "Я не могу защитить Тома.",
          "source": "Tatoeba #3564847 @ficion / #3566030 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3564847",
          "cefr_level": "A1",
          "word_slugs": [
            "proteger-verb"
          ]
        },
        {
          "id": "1655070",
          "text": "Debes proteger a tu familia.",
          "translation": "Ты должен защитить свою семью.",
          "source": "Tatoeba #1655070 @marcelostockle / #2171716 @Tretiz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1655070",
          "cefr_level": "A1",
          "word_slugs": [
            "proteger-verb"
          ]
        },
        {
          "id": "1687051",
          "text": "Debemos proteger a los niños.",
          "translation": "Мы должны защищать детей.",
          "source": "Tatoeba #1687051 @Shishir / #7342396 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1687051",
          "cefr_level": "A1",
          "word_slugs": [
            "proteger-verb"
          ]
        },
        {
          "id": "2313875",
          "text": "¿De qué nos quieres proteger?",
          "translation": "От чего ты хочешь нас защитить?",
          "source": "Tatoeba #2313875 @marcelostockle / #5280703 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2313875",
          "cefr_level": "A1",
          "word_slugs": [
            "proteger-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el proteger",
