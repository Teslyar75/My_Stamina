    {
      "slug": "oferta-noun",
      "lemma": "oferta",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1746,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "offer (a proposal that has been made)",
          "offer (something put forth, bid, proffered or tendered)",
          "supply",
          "deal, sale, bargain"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1367715",
          "text": "Declinó mi oferta.",
          "translation": "Он отклонил моё предложение.",
          "source": "Tatoeba #1367715 @Shishir / #2255108 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1367715",
          "cefr_level": "A1",
          "word_slugs": [
            "oferta-noun"
          ]
        },
        {
          "id": "822464",
          "text": "Ella rehusó mi oferta.",
          "translation": "Она отклонила моё предложение.",
          "source": "Tatoeba #822464 @Munia / #3399918 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/822464",
          "cefr_level": "A1",
          "word_slugs": [
            "oferta-noun"
          ]
        },
        {
          "id": "1296553",
          "text": "Deberías rechazar su oferta.",
          "translation": "Тебе стоит отклонить его предложение.",
          "source": "Tatoeba #1296553 @Shishir / #5285987 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1296553",
          "cefr_level": "A1",
          "word_slugs": [
            "oferta-noun"
          ]
        },
        {
          "id": "1684358",
          "text": "La oferta crea la demanda.",
          "translation": "Предложение рождает спрос.",
