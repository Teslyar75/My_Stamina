    {
      "slug": "cientos-noun",
      "lemma": "cientos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2150,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of ciento"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1503323",
          "text": "Tom ha escrito cientos de canciones.",
          "translation": "Том написал сотни песен.",
          "source": "Tatoeba #1503323 @marcelostockle / #4635062 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1503323",
          "cefr_level": "A1",
          "word_slugs": [
            "cientos-noun"
          ]
        },
        {
          "id": "1018660",
          "text": "Había cientos de pájaros en el lago.",
          "translation": "На озере были сотни птиц.",
          "source": "Tatoeba #1018660 @Shishir / #3359192 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1018660",
          "cefr_level": "A1",
          "word_slugs": [
            "cientos-noun"
          ]
        },
        {
          "id": "2825815",
          "text": "China estuvo aislada por cientos de años.",
          "translation": "Китай на протяжении сотен лет находился в изоляции.",
          "source": "Tatoeba #2825815 @marcelostockle / #4241324 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2825815",
          "cefr_level": "A1",
          "word_slugs": [
            "cientos-noun"
          ]
        },
        {
          "id": "5109669",
          "text": "Se quemaron las casas de cientos de familias.",
          "translation": "Дома сотен семей сгорели.",
          "source": "Tatoeba #5109669 @cueyayotl / #8163503 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5109669",
          "cefr_level": "A1",
          "word_slugs": [
            "cientos-noun"
          ]
        },
        {
          "id": "1192368",
          "text": "La iglesia fue construida hace cientos de años.",
          "translation": "Церковь была построена сотни лет назад.",
          "source": "Tatoeba #1192368 @marcelostockle / #470706 @timsa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1192368",
          "cefr_level": "A1",
          "word_slugs": [
            "cientos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "cientos",
        "plural": "",
        "infinitive": ""
      }
