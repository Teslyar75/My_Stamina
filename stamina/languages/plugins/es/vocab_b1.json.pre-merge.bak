      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "chicken (meat)",
          "young chicken (specially a male, or one of unspecified gender)",
          "fuss, scene",
          "twink (a young, attractive, slim man)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1258417",
          "text": "Me gusta el pollo.",
          "translation": "Я люблю курицу.",
          "source": "Tatoeba #1258417 @hayastan / #1391999 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1258417",
