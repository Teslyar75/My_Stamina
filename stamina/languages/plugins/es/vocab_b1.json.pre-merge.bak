    {
      "slug": "llevarte-verb",
      "lemma": "llevarte",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2391,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of llevar combined with te"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6861935",
          "text": "Déjame llevarte la maleta.",
          "translation": "Давай-ка я понесу твой чемодан.",
          "source": "Tatoeba #6861935 @arh / #12638658 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6861935",
          "cefr_level": "A1",
          "word_slugs": [
            "llevarte-verb"
          ]
        },
        {
          "id": "2405378",
          "text": "Tenemos que llevarte a un hospital.",
          "translation": "Нам надо отвезти тебя в больницу.",
          "source": "Tatoeba #2405378 @Shishir / #3554197 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2405378",
          "cefr_level": "A1",
          "word_slugs": [
            "llevarte-verb"
          ]
        },
        {
          "id": "1389949",
          "text": "Deberías llevarte un paraguas por si llueve.",
          "translation": "Тебе надо взять зонтик на случай дождя.",
          "source": "Tatoeba #1389949 @Shishir / #12135507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1389949",
          "cefr_level": "A1",
          "word_slugs": [
            "llevarte-verb"
          ]
        },
        {
          "id": "1821997",
          "text": "No puedes llevarte el gato a la escuela.",
          "translation": "Ты не можешь взять кота в школу.",
          "source": "Tatoeba #1821997 @Shishir / #4861195 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1821997",
          "cefr_level": "A1",
          "word_slugs": [
            "llevarte-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "llevarte",
        "plural": "",
        "infinitive": "llevarte"
      }
    },
    {
      "slug": "ted-name",
      "lemma": "Ted",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2392,
      "frequency_band": "cervantes-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1173903",
          "text": "Sus amigos le llamaban Ted.",
          "translation": "Друзья называли его Тедом.",
          "source": "Tatoeba #1173903 @Shishir / #3685278 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1173903",
          "cefr_level": "A1",
          "word_slugs": [
            "ted-name"
          ]
        },
        {
          "id": "6864241",
          "text": "Ella llamó Ted a su oso.",
          "translation": "Она назвала своего медведя Тедом.",
          "source": "Tatoeba #6864241 @albrusgher / #8234939 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6864241",
          "cefr_level": "A1",
          "word_slugs": [
            "ted-name"
          ]
        },
        {
          "id": "1713721",
          "text": "A Ted le gusta tocar la trompeta.",
          "translation": "Теду нравится играть на трубе.",
          "source": "Tatoeba #1713721 @hayastan / #4275757 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1713721",
          "cefr_level": "A1",
          "word_slugs": [
            "ted-name"
          ]
        },
        {
          "id": "336843",
          "text": "Si Ted estuviese aquí, podría ayudarnos a limpiar el cuarto.",
          "translation": "Если бы Тед был здесь, он помог бы убрать в комнате.",
          "source": "Tatoeba #336843 @kylecito / #1459612 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/336843",
          "cefr_level": "A1",
          "word_slugs": [
            "ted-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "Ted",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "combate-noun",
      "lemma": "combate",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
