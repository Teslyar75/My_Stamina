    {
      "slug": "americano-noun",
      "lemma": "americano",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2182,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "American (native or inhabitant of the Americas) (usually male)",
          "American, US-American (native or inhabitant of the United States) (usually male)",
          "someone who became rich in the Americas and returned to his country",
          "person born and/or raised in Spanish America who immigrated or visited the Spanish Colonial Philippines or Spanish East Indies in general"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "738626",
          "text": "Él no es americano.",
          "translation": "Он не американец.",
          "source": "Tatoeba #738626 @darinmex / #600501 @loins (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/738626",
          "cefr_level": "A1",
          "word_slugs": [
            "americano-noun"
          ]
        },
        {
          "id": "1190133",
          "text": "Chen no es americano.",
          "translation": "Чен не американец.",
          "source": "Tatoeba #1190133 @marcelostockle / #5313740 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1190133",
          "cefr_level": "A1",
          "word_slugs": [
            "americano-noun"
          ]
        },
        {
          "id": "1190130",
          "text": "¿Tu colega es americano?",
          "translation": "Твой коллега американец?",
          "source": "Tatoeba #1190130 @marcelostockle / #2197019 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1190130",
          "cefr_level": "A1",
          "word_slugs": [
            "americano-noun"
          ]
        },
        {
          "id": "10585761",
          "text": "Él habla inglés americano.",
          "translation": "Он говорит на американском английском.",
          "source": "Tatoeba #10585761 @DJ_Saidez / #12323883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10585761",
          "cefr_level": "A1",
          "word_slugs": [
            "americano-noun"
          ]
        },
        {
          "id": "3028054",
          "text": "Soy del consulado americano.",
          "translation": "Я из американского консульства.",
          "source": "Tatoeba #3028054 @alexmarcelo / #3174810 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3028054",
          "cefr_level": "A1",
          "word_slugs": [
            "americano-noun"
          ]
        }
      ],
