      },
      "gender": null,
      "examples": [
        {
          "id": "2114274",
          "text": "Espero que os guste.",
          "translation": "Надеюсь, вам это понравится.",
          "source": "Tatoeba #2114274 @Shishir / #2908218 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2114274",
