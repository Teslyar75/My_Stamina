        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2002643",
          "text": "El vaso está limpio.",
          "translation": "Стакан чистый.",
          "source": "Tatoeba #2002643 @bichodebola / #4256649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2002643",
          "cefr_level": "A1",
          "word_slugs": [
