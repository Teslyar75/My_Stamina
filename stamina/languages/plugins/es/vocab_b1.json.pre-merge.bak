    {
      "slug": "huellas-noun",
      "lemma": "huellas",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1626,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of huella"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1602183",
          "text": "El criminal dejó huellas.",
          "translation": "Преступник оставил следы.",
          "source": "Tatoeba #1602183 @marcelostockle / #5914403 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1602183",
          "cefr_level": "A1",
          "word_slugs": [
            "huellas-noun"
          ]
        },
        {
          "id": "355024",
          "text": "El cazador siguió las huellas del oso.",
          "translation": "Охотник шёл по следам медведя.",
          "source": "Tatoeba #355024 @tatoerique / #10164523 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/355024",
          "cefr_level": "A1",
          "word_slugs": [
            "huellas-noun"
          ]
        },
        {
          "id": "358654",
          "text": "Encontraron huellas de oso en la nieve.",
          "translation": "Они нашли медвежьи следы на снегу.",
          "source": "Tatoeba #358654 @tatoerique / #7885939 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/358654",
          "cefr_level": "A1",
          "word_slugs": [
            "huellas-noun"
          ]
        },
        {
          "id": "1277727",
          "text": "Había huellas de pingüinos en la arena.",
          "translation": "На песке были следы пингвинов.",
          "source": "Tatoeba #1277727 @hayastan / #5801564 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1277727",
          "cefr_level": "A1",
          "word_slugs": [
            "huellas-noun"
          ]
        },
        {
          "id": "10274462",
          "text": "Tus huellas dactilares están en el cuchillo.",
          "translation": "Твои отпечатки пальцев на ноже.",
          "source": "Tatoeba #10274462 @manufrutos / #11066653 @Almi92 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10274462",
          "cefr_level": "A1",
          "word_slugs": [
            "huellas-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
