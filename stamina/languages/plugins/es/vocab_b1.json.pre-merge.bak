          "worth",
          "courage"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7447478",
          "text": "Eso incrementa el valor.",
          "translation": "Это увеличивает стоимость.",
          "source": "Tatoeba #7447478 @arh / #7453849 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7447478",
          "cefr_level": "A1",
          "word_slugs": [
            "valor-noun"
          ]
        },
        {
          "id": "1853422",
          "text": "Tuvo el valor de decirlo.",
          "translation": "Ему хватило мужества это сказать.",
          "source": "Tatoeba #1853422 @Shishir / #5734261 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1853422",
          "cefr_level": "A1",
          "word_slugs": [
            "valor-noun"
          ]
        },
        {
          "id": "2269894",
          "text": "Parece no tener ningún valor.",
          "translation": "Это кажется бесполезным.",
          "source": "Tatoeba #2269894 @Shishir / #1566576 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2269894",
          "cefr_level": "A1",
          "word_slugs": [
            "valor-noun"
          ]
        },
        {
          "id": "609731",
          "text": "Este reloj es de gran valor.",
          "translation": "Это очень ценные часы.",
          "source": "Tatoeba #609731 @arashi_29 / #10323691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/609731",
          "cefr_level": "A1",
          "word_slugs": [
            "valor-noun"
          ]
        },
        {
          "id": "342749",
          "text": "Su valor es digno de admiración.",
          "translation": "Его мужество достойно восхищения.",
          "source": "Tatoeba #342749 @tatoerique / #5295282 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/342749",
          "cefr_level": "A1",
          "word_slugs": [
            "valor-noun"
          ]
        }
      ],
      "tags": [
