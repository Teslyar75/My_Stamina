      },
      "gender": null,
      "examples": [
        {
          "id": "7256724",
          "text": "A veces robo cosas.",
          "translation": "Я иногда подворовываю по мелочи.",
          "source": "Tatoeba #7256724 @arh / #8412042 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7256724",
          "cefr_level": "A1",
