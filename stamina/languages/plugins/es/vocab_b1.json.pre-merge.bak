          "cefr_level": "A1",
          "word_slugs": [
            "elegir-verb"
          ]
        },
        {
          "id": "1619924",
          "text": "Elegir significa renunciar.",
          "translation": "Выбирать — значит отказываться.",
          "source": "Tatoeba #1619924 @marcelostockle / #14107879 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1619924",
          "cefr_level": "A1",
          "word_slugs": [
            "elegir-verb"
          ]
        },
        {
          "id": "1344491",
          "text": "No sé cuál elegir.",
          "translation": "Я не знаю, какую выбрать.",
          "source": "Tatoeba #1344491 @marcelostockle / #2772136 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1344491",
          "cefr_level": "A1",
          "word_slugs": [
            "elegir-verb"
          ]
        }
