          ]
        },
        {
          "id": "2246765",
          "text": "No es solo una teoría.",
          "translation": "Это не просто теория.",
          "source": "Tatoeba #2246765 @Shishir / #3701927 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2246765",
          "cefr_level": "A1",
          "word_slugs": [
            "teoría-noun"
          ]
        },
        {
          "id": "2571766",
          "text": "Yo no entiendo su teoría.",
          "translation": "Я не понимаю Вашу теорию.",
          "source": "Tatoeba #2571766 @marcelostockle / #12914427 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2571766",
          "cefr_level": "A1",
          "word_slugs": [
            "teoría-noun"
          ]
        }
