        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1996081",
          "text": "Trae mi sombrero.",
          "translation": "Принеси мою шляпу.",
          "source": "Tatoeba #1996081 @marcelostockle / #2753690 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1996081",
