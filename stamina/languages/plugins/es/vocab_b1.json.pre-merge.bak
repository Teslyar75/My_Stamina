    {
      "slug": "show-noun",
      "lemma": "show",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1643,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "show, spectacle",
          "a scene, i.e. an exhibition of passionate or strong feeling before others, creating embarrassment or disruption"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1258378",
          "text": "El show se acabó.",
          "translation": "Шоу окончено.",
          "source": "Tatoeba #1258378 @marcelostockle / #638816 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1258378",
          "cefr_level": "A1",
          "word_slugs": [
            "show-noun"
          ]
        },
        {
          "id": "1278795",
          "text": "¿Quién vendrá al show?",
          "translation": "Кто придёт на шоу?",
          "source": "Tatoeba #1278795 @marcelostockle / #4960219 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1278795",
          "cefr_level": "A1",
          "word_slugs": [
            "show-noun"
          ]
        },
        {
          "id": "1172804",
          "text": "El show debe continuar.",
          "translation": "Шоу должно продолжаться.",
