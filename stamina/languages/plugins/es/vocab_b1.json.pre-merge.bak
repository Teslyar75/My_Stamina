    {
      "slug": "política-adj",
      "lemma": "política",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1602,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "feminine singular of político"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1173673",
          "text": "Odio la política.",
          "translation": "Я ненавижу политику.",
          "source": "Tatoeba #1173673 @Shishir / #1494810 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1173673",
          "cefr_level": "A1",
          "word_slugs": [
            "política-adj"
          ]
        },
        {
          "id": "1613063",
          "text": "De política no entiendo.",
          "translation": "В политике я не разбираюсь.",
          "source": "Tatoeba #1613063 @hayastan / #5547019 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1613063",
          "cefr_level": "A1",
          "word_slugs": [
            "política-adj"
          ]
        },
        {
          "id": "536482",
          "text": "¿Te interesa la política?",
          "translation": "Тебя интересует политика?",
          "source": "Tatoeba #536482 @Leono / #1438218 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/536482",
          "cefr_level": "A1",
          "word_slugs": [
            "política-adj"
          ]
        },
        {
          "id": "1123313",
          "text": "Comparto su posición política.",
          "translation": "Я разделяю его политические взгляды.",
          "source": "Tatoeba #1123313 @Ephraim / #8089924 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1123313",
          "cefr_level": "A1",
          "word_slugs": [
            "política-adj"
          ]
        },
        {
          "id": "1439328",
          "text": "La política es la vida.",
          "translation": "Политика — это жизнь.",
          "source": "Tatoeba #1439328 @marcelostockle / #5465079 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1439328",
          "cefr_level": "A1",
          "word_slugs": [
            "política-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
