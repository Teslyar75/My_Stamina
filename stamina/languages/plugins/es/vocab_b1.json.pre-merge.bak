    {
      "slug": "habíamos-verb",
      "lemma": "habíamos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2384,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person plural imperfect indicative of haber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2313056",
          "text": "¿Dónde nos habíamos quedado?",
          "translation": "На чём мы остановились?",
          "source": "Tatoeba #2313056 @Shishir / #1941716 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2313056",
          "cefr_level": "A1",
          "word_slugs": [
            "habíamos-verb"
          ]
        },
        {
          "id": "3983723",
          "text": "¿No la habíamos visto antes?",
          "translation": "Мы раньше не видели её?",
          "source": "Tatoeba #3983723 @senryakun / #4836480 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3983723",
          "cefr_level": "A1",
          "word_slugs": [
            "habíamos-verb"
          ]
        },
        {
          "id": "2944685",
          "text": "Jamás habíamos tenido tanta nieve.",
          "translation": "У нас никогда не было столько снега.",
          "source": "Tatoeba #2944685 @marcelostockle / #5364361 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2944685",
          "cefr_level": "A1",
          "word_slugs": [
            "habíamos-verb"
          ]
        },
        {
          "id": "2871450",
          "text": "Tom preguntó cuanto habíamos pagado.",
          "translation": "Том спросил, сколько мы заплатили.",
          "source": "Tatoeba #2871450 @nancy / #3764411 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2871450",
          "cefr_level": "A1",
          "word_slugs": [
            "habíamos-verb"
          ]
        },
        {
          "id": "5524183",
          "text": "Nunca habíamos tenido este problema.",
          "translation": "У нас никогда не было этой проблемы.",
          "source": "Tatoeba #5524183 @baudelaire / #5524188 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5524183",
          "cefr_level": "A1",
          "word_slugs": [
            "habíamos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "habíamos",
        "plural": "",
        "infinitive": "habíamos"
      }
    },
    {
