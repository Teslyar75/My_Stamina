    {
      "slug": "ayude-verb",
      "lemma": "ayude",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1761,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of ayudar:",
          "first/third-person singular present subjunctive",
          "inflection of ayudar:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4650042",
          "text": "Que Dios nos ayude.",
          "translation": "Да поможет нам Бог.",
          "source": "Tatoeba #4650042 @cueyayotl / #4650050 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4650042",
          "cefr_level": "A1",
          "word_slugs": [
            "ayude-verb"
          ]
        },
        {
          "id": "4692642",
          "text": "¡Que Dios te ayude!",
          "translation": "Да поможет тебе Бог!",
          "source": "Tatoeba #4692642 @cueyayotl / #6167555 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4692642",
          "cefr_level": "A1",
          "word_slugs": [
            "ayude-verb"
          ]
        },
        {
          "id": "1344698",
          "text": "¿Quiere que le ayude?",
          "translation": "Хотите, я вам помогу?",
          "source": "Tatoeba #1344698 @Shishir / #858426 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1344698",
          "cefr_level": "A1",
          "word_slugs": [
            "ayude-verb"
          ]
        },
        {
          "id": "4954956",
          "text": "¿Quieres que yo ayude?",
          "translation": "Хочешь, помогу?",
          "source": "Tatoeba #4954956 @DarkHollow / #4955174 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4954956",
          "cefr_level": "A1",
          "word_slugs": [
            "ayude-verb"
          ]
        },
        {
          "id": "2707242",
          "text": "Esperamos que nos ayude.",
          "translation": "Мы надеемся, что он нам поможет.",
          "source": "Tatoeba #2707242 @Shishir / #4287324 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2707242",
          "cefr_level": "A1",
          "word_slugs": [
            "ayude-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "ayude",
        "plural": "",
        "infinitive": "ayude"
      }
    },
    {
      "slug": "supe-verb",
      "lemma": "supe",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1762,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular preterite indicative of saber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1130409",
          "text": "Supe dónde buscar.",
          "translation": "Я знал, где искать.",
          "source": "Tatoeba #1130409 @cueyayotl / #5286072 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1130409",
          "cefr_level": "A1",
          "word_slugs": [
            "supe-verb"
          ]
        },
        {
          "id": "1752025",
          "text": "Lo supe desde el principio.",
          "translation": "Я знал это с самого начала.",
          "source": "Tatoeba #1752025 @Shishir / #2778466 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1752025",
          "cefr_level": "A1",
          "word_slugs": [
            "supe-verb"
          ]
        },
        {
          "id": "3772969",
          "text": "Hasta ayer no supe la verdad.",
          "translation": "Я не знал правды до вчерашнего дня.",
          "source": "Tatoeba #3772969 @Shishir / #3892762 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3772969",
          "cefr_level": "A1",
          "word_slugs": [
            "supe-verb"
          ]
        },
        {
          "id": "2395782",
          "text": "Siempre supe que lo podías hacer.",
          "translation": "Я всегда знал, что ты можешь это сделать.",
          "source": "Tatoeba #2395782 @kuma / #4483276 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2395782",
          "cefr_level": "A1",
          "word_slugs": [
            "supe-verb"
          ]
        },
        {
          "id": "6884172",
          "text": "Supe que podría suceder algo curioso.",
          "translation": "Я знал, что может случиться что-то удивительное.",
          "source": "Tatoeba #6884172 @HAYACH / #6977840 @Pereskaz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884172",
          "cefr_level": "A1",
          "word_slugs": [
