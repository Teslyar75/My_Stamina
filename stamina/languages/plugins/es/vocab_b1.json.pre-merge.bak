    {
      "slug": "rayos-intj",
      "lemma": "rayos",
      "pos": "intj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1847,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "dang it, goddammit, heck"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1667470",
          "text": "Los rayos catódicos son haces de electrones.",
          "translation": "Катодные лучи представляют из себя пучки электронов.",
          "source": "Tatoeba #1667470 @hayastan / #4328619 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1667470",
          "cefr_level": "A1",
          "word_slugs": [
            "rayos-intj"
          ]
        },
        {
          "id": "1031742",
          "text": "Estos rayos tienen diferentes longitudes de onda.",
          "translation": "У этих лучей разная длина волны.",
          "source": "Tatoeba #1031742 @hayastan / #5450495 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1031742",
          "cefr_level": "A1",
          "word_slugs": [
            "rayos-intj"
          ]
        },
        {
          "id": "1667472",
          "text": "Los rayos catódicos poseen carga eléctrica negativa.",
          "translation": "Катодные лучи переносят отрицательный электрический заряд.",
          "source": "Tatoeba #1667472 @hayastan / #4326851 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1667472",
          "cefr_level": "A1",
          "word_slugs": [
            "rayos-intj"
          ]
        },
        {
          "id": "2061991",
          "text": "El doctor usó rayos X para examinarme el estómago.",
          "translation": "Доктор прибегнул к рентгенографии, чтобы исследовать мой желудок.",
          "source": "Tatoeba #2061991 @lazarus1907 / #3451382 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2061991",
          "cefr_level": "A1",
          "word_slugs": [
            "rayos-intj"
          ]
        },
        {
          "id": "2025479",
          "text": "Buenos lentes de sol protegen a los ojos de los rayos ultravioleta.",
          "translation": "Хорошие солнцезащитные очки защищают глаза от ультрафиолетовых лучей.",
          "source": "Tatoeba #2025479 @marcelostockle / #6210711 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2025479",
          "cefr_level": "A1",
          "word_slugs": [
            "rayos-intj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "rayos",
        "plural": "",
        "infinitive": ""
      }
