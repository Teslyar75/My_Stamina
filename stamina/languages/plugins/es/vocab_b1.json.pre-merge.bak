          ]
        },
        {
          "id": "13894887",
          "text": "¿Te gustan sus canciones?",
          "translation": "Тебе нравятся его песни?",
          "source": "Tatoeba #13894887 @Tom9358 / #2776403 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13894887",
          "cefr_level": "A1",
          "word_slugs": [
            "canciones-noun"
          ]
        },
        {
          "id": "3063388",
          "text": "Cantamos canciones en coro.",
          "translation": "Мы распевали песни хором.",
