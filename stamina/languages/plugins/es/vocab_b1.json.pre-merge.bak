            "lunes-noun"
          ]
        },
        {
          "id": "5769363",
          "text": "Sólo es lunes.",
          "translation": "Сегодня только понедельник.",
          "source": "Tatoeba #5769363 @arh / #5769512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5769363",
          "cefr_level": "A1",
          "word_slugs": [
            "lunes-noun"
          ]
        },
        {
          "id": "576089",
          "text": "Odio los lunes.",
          "translation": "Я ненавижу понедельники.",
          "source": "Tatoeba #576089 @Shishir / #11144444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/576089",
          "cefr_level": "A1",
          "word_slugs": [
            "lunes-noun"
          ]
        },
        {
          "id": "5769359",
          "text": "Hazlo el lunes.",
          "translation": "Сделай это в понедельник.",
          "source": "Tatoeba #5769359 @arh / #3929190 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5769359",
          "cefr_level": "A1",
          "word_slugs": [
            "lunes-noun"
          ]
        }
