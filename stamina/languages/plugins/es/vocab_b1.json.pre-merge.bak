          "cute"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3802340",
          "text": "Estamos desperdiciando tiempo precioso.",
          "translation": "Мы теряем драгоценное время.",
          "source": "Tatoeba #3802340 @cueyayotl / #3802287 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3802340",
          "cefr_level": "A1",
