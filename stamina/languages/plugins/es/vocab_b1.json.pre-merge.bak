        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "984966",
          "text": "¿Puedo preguntarle su edad?",
          "translation": "Могу я спросить, сколько Вам лет?",
          "source": "Tatoeba #984966 @Shishir / #13246440 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/984966",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntarle-verb"
          ]
        },
        {
          "id": "4452160",
          "text": "Creo que deberías preguntarle.",
          "translation": "Думаю, ты должен спросить его.",
          "source": "Tatoeba #4452160 @Shishir / #5941105 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4452160",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntarle-verb"
          ]
        },
        {
          "id": "4426560",
          "text": "Quizá deberíamos preguntarle a Tom.",
          "translation": "Нам, наверное, надо спросить Тома.",
          "source": "Tatoeba #4426560 @Serafin / #6140943 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4426560",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntarle-verb"
          ]
        },
        {
          "id": "984969",
          "text": "¿Puedo preguntarle cuántos años tiene?",
          "translation": "Могу я спросить, сколько Вам лет?",
          "source": "Tatoeba #984969 @Shishir / #13246440 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/984969",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntarle-verb"
          ]
        },
        {
          "id": "436582",
          "text": "Me da cosa preguntarle de nuevo.",
          "translation": "Мне неловко снова его спрашивать.",
          "source": "Tatoeba #436582 @lukaszpp / #7749268 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/436582",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntarle-verb"
          ]
        }
      ],
      "tags": [
