    {
      "slug": "querían-verb",
      "lemma": "querían",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2083,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural imperfect indicative of querer"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4482734",
          "text": "Todos te querían.",
          "translation": "Тебя все любили.",
          "source": "Tatoeba #4482734 @cueyayotl / #4482762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4482734",
          "cefr_level": "A1",
          "word_slugs": [
            "querían-verb"
          ]
        },
        {
          "id": "13358435",
          "text": "Todos querían cantar.",
          "translation": "Все хотели петь.",
          "source": "Tatoeba #13358435 @Shishir / #6323819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13358435",
          "cefr_level": "A1",
          "word_slugs": [
            "querían-verb"
          ]
        },
        {
          "id": "4471793",
          "text": "Todos querían a Tom.",
          "translation": "Тома все любили.",
          "source": "Tatoeba #4471793 @cueyayotl / #4471876 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4471793",
          "cefr_level": "A1",
          "word_slugs": [
            "querían-verb"
          ]
        },
        {
          "id": "4510059",
          "text": "Querían robar el coche.",
          "translation": "Они хотели угнать машину.",
          "source": "Tatoeba #4510059 @rsarias / #4510984 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4510059",
          "cefr_level": "A1",
          "word_slugs": [
            "querían-verb"
          ]
        },
        {
          "id": "5022953",
          "text": "Los niños querían jugar.",
          "translation": "Дети хотели играть.",
          "source": "Tatoeba #5022953 @Shishir / #5059176 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5022953",
          "cefr_level": "A1",
          "word_slugs": [
            "querían-verb"
          ]
        }
      ],
      "tags": [
