    {
      "slug": "supiera-verb",
      "lemma": "supiera",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2457,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect subjunctive of saber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "981193",
          "text": "Ojalá supiera nadar.",
          "translation": "Хотел бы я уметь плавать.",
          "source": "Tatoeba #981193 @Shishir / #2671378 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/981193",
          "cefr_level": "A1",
          "word_slugs": [
            "supiera-verb"
          ]
        },
        {
          "id": "1037410",
          "text": "¡Ojalá supiera dónde está!",
          "translation": "Хотел бы я знать, где он!",
          "source": "Tatoeba #1037410 @Shishir / #2671349 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1037410",
          "cefr_level": "A1",
          "word_slugs": [
            "supiera-verb"
          ]
        },
        {
          "id": "10352341",
          "text": "Lo haría si supiera cómo.",
          "translation": "Я бы сделал это, если бы знал как.",
          "source": "Tatoeba #10352341 @DJ_Saidez / #6486146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10352341",
          "cefr_level": "A1",
          "word_slugs": [
            "supiera-verb"
          ]
        },
        {
          "id": "2671320",
          "text": "Ojalá supiera cantar como tú.",
          "translation": "Если бы я только умел петь, как ты.",
          "source": "Tatoeba #2671320 @Shishir / #2671394 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2671320",
          "cefr_level": "A1",
          "word_slugs": [
            "supiera-verb"
          ]
        },
        {
          "id": "1408050",
          "text": "¡Ojalá supiera la respuesta ahora!",
          "translation": "Если бы только я знал ответ сейчас!",
          "source": "Tatoeba #1408050 @darinmex / #2671357 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1408050",
          "cefr_level": "A1",
          "word_slugs": [
            "supiera-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "supiera",
        "plural": "",
        "infinitive": "supiera"
      }
