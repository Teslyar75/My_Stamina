    {
      "slug": "pan-name",
      "lemma": "PAN",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1549,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "initialism of Partido Acción Nacional: National Action Party, a conservative political party in Mexico"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3873486",
          "text": "No como pan.",
          "translation": "Я не ем хлеб.",
          "source": "Tatoeba #3873486 @Shishir / #3873480 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3873486",
          "cefr_level": "A1",
          "word_slugs": [
            "pan-name"
          ]
        },
        {
          "id": "2127149",
          "text": "Yo tengo pan.",
          "translation": "У меня есть хлеб.",
          "source": "Tatoeba #2127149 @marcelostockle / #5545610 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2127149",
          "cefr_level": "A1",
          "word_slugs": [
            "pan-name"
          ]
        },
        {
          "id": "2222911",
          "text": "Come más pan.",
          "translation": "Ешь больше хлеба.",
          "source": "Tatoeba #2222911 @Shishir / #6116758 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2222911",
          "cefr_level": "A1",
          "word_slugs": [
            "pan-name"
          ]
        },
        {
          "id": "1396490",
          "text": "Es pan comido.",
          "translation": "Это проще пареной репы.",
          "source": "Tatoeba #1396490 @marcelostockle / #3519435 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1396490",
          "cefr_level": "A1",
          "word_slugs": [
            "pan-name"
          ]
        },
        {
          "id": "3885064",
          "text": "Yo quiero pan.",
          "translation": "Я хочу хлеба.",
          "source": "Tatoeba #3885064 @cueyayotl / #3884861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3885064",
          "cefr_level": "A1",
