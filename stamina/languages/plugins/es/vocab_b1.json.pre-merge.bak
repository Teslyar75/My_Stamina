            "jugando-verb"
          ]
        },
        {
          "id": "1745876",
          "text": "Está jugando Tetris.",
          "translation": "Он играет в тетрис.",
          "source": "Tatoeba #1745876 @marcelostockle / #3156015 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1745876",
          "cefr_level": "A1",
          "word_slugs": [
            "jugando-verb"
          ]
        },
        {
          "id": "2074773",
          "text": "¿Dónde está jugando?",
          "translation": "Где он играет?",
