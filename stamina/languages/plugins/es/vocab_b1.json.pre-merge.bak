    {
      "slug": "piensan-verb",
      "lemma": "piensan",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1976,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural present indicative of pensar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1902140",
          "text": "¿Qué piensan realmente?",
          "translation": "Что они думают на самом деле?",
          "source": "Tatoeba #1902140 @alexmarcelo / #6800307 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1902140",
          "cefr_level": "A1",
          "word_slugs": [
            "piensan-verb"
          ]
        },
        {
          "id": "769705",
          "text": "Pocas personas piensan así.",
          "translation": "Мало кто так думает.",
          "source": "Tatoeba #769705 @Shishir / #2531285 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/769705",
          "cefr_level": "A1",
          "word_slugs": [
            "piensan-verb"
          ]
        },
        {
          "id": "2096657",
          "text": "Piensan que soy millonario.",
          "translation": "Они думают, что я миллионер.",
          "source": "Tatoeba #2096657 @marcelostockle / #4613241 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2096657",
          "cefr_level": "A1",
          "word_slugs": [
            "piensan-verb"
          ]
        },
        {
          "id": "2216655",
          "text": "Pocas personas piensan eso.",
          "translation": "Немногие люди так думают.",
          "source": "Tatoeba #2216655 @marcelostockle / #6926788 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2216655",
          "cefr_level": "A1",
          "word_slugs": [
            "piensan-verb"
          ]
        },
        {
          "id": "340299",
          "text": "Ellos piensan casarse mañana.",
