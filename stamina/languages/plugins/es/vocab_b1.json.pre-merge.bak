    {
      "slug": "recién-adv",
      "lemma": "recién",
      "pos": "adv",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2174,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "recently; new-, newly, freshly",
          "just now, recently",
          "only, just"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6819279",
          "text": "Ese pan está recién hecho.",
          "translation": "Это свежеиспечённый хлеб.",
          "source": "Tatoeba #6819279 @arh / #10619369 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6819279",
          "cefr_level": "A1",
          "word_slugs": [
            "recién-adv"
          ]
        },
        {
          "id": "6799914",
          "text": "La pared está recién pintada.",
          "translation": "Стена недавно покрашена.",
          "source": "Tatoeba #6799914 @diegohn / #6819689 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799914",
          "cefr_level": "A1",
          "word_slugs": [
            "recién-adv"
          ]
        },
        {
          "id": "3009863",
          "text": "Recién me doy cuenta del error.",
          "translation": "Я только что понял ошибку.",
          "source": "Tatoeba #3009863 @hayastan / #3010610 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3009863",
          "cefr_level": "A1",
          "word_slugs": [
            "recién-adv"
          ]
        },
        {
          "id": "1769209",
          "text": "Me siento como un recién nacido.",
          "translation": "Я чувствую себя так, будто заново родился.",
          "source": "Tatoeba #1769209 @marcelostockle / #10175684 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1769209",
          "cefr_level": "A1",
          "word_slugs": [
            "recién-adv"
          ]
        },
        {
          "id": "2795722",
          "text": "Recién empecé a usar este sitio.",
          "translation": "Недавно я начал пользоваться этим сайтом.",
          "source": "Tatoeba #2795722 @marcelostockle / #5253156 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2795722",
          "cefr_level": "A1",
          "word_slugs": [
            "recién-adv"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "recién",
