          "second-person singular future indicative of ser"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "949670",
          "text": "Serás mi yerno.",
          "translation": "Ты будешь моим зятем.",
          "source": "Tatoeba #949670 @riccioberto / #949674 @riccioberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/949670",
          "cefr_level": "A1",
