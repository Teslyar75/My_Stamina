    {
      "slug": "interior-adj",
      "lemma": "interior",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1266,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inner, interior"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5276984",
          "text": "¿Puedo ver el interior del coche?",
          "translation": "Могу я увидеть салон автомобиля?",
          "source": "Tatoeba #5276984 @wallebot / #7717085 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5276984",
          "cefr_level": "A1",
          "word_slugs": [
            "interior-adj"
          ]
        },
        {
          "id": "2769142",
          "text": "Ahora vemos el interior del castillo.",
          "translation": "Сейчас мы видим убранство замка.",
          "source": "Tatoeba #2769142 @marcelostockle / #3443658 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2769142",
          "cefr_level": "A1",
          "word_slugs": [
            "interior-adj"
          ]
        },
        {
          "id": "687669",
          "text": "¿Dónde está su sección de ropa interior?",
          "translation": "Где у вас отдел нижнего белья?",
          "source": "Tatoeba #687669 @lukaszpp / #11388785 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/687669",
          "cefr_level": "A1",
          "word_slugs": [
            "interior-adj"
          ]
        },
        {
          "id": "1285823",
          "text": "Está prohibido fumar en el interior del cine.",
          "translation": "В кинотеатре не разрешается курить.",
          "source": "Tatoeba #1285823 @marcelostockle / #3474767 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1285823",
          "cefr_level": "A1",
          "word_slugs": [
            "interior-adj"
          ]
        },
        {
          "id": "5018274",
          "text": "No llevaba nada puesto excepto su ropa interior.",
          "translation": "На ней не было ничего, кроме нижнего белья.",
          "source": "Tatoeba #5018274 @don_ramon / #4987617 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5018274",
          "cefr_level": "A1",
          "word_slugs": [
            "interior-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el interior",
        "plural": "",
        "infinitive": ""
      }
