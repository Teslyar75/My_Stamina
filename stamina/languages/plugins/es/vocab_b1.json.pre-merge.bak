    {
      "slug": "sigo-verb",
      "lemma": "sigo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1265,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular present indicative of seguir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6309001",
          "text": "Ahora sigo yo.",
          "translation": "Теперь я.",
          "source": "Tatoeba #6309001 @marcelostockle / #4596472 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6309001",
          "cefr_level": "A1",
          "word_slugs": [
            "sigo-verb"
          ]
        },
        {
          "id": "5716516",
          "text": "Sigo sin verlo.",
          "translation": "Я всё ещё его не вижу.",
          "source": "Tatoeba #5716516 @arh / #5997504 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5716516",
          "cefr_level": "A1",
          "word_slugs": [
            "sigo-verb"
          ]
        },
        {
          "id": "2206797",
          "text": "Sigo sin entender.",
          "translation": "Я по-прежнему не понимаю.",
          "source": "Tatoeba #2206797 @marcelostockle / #6140987 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2206797",
          "cefr_level": "A1",
          "word_slugs": [
            "sigo-verb"
          ]
        },
        {
          "id": "3270698",
          "text": "Sigo estudiando idiomas.",
          "translation": "Я продолжаю изучать языки.",
          "source": "Tatoeba #3270698 @cueyayotl / #3272434 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3270698",
          "cefr_level": "A1",
          "word_slugs": [
            "sigo-verb"
          ]
        },
        {
          "id": "7480819",
          "text": "Sigo teniendo pesadillas.",
          "translation": "Мне продолжают сниться кошмары.",
          "source": "Tatoeba #7480819 @arh / #11436468 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7480819",
          "cefr_level": "A1",
          "word_slugs": [
            "sigo-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "sigo",
        "plural": "",
        "infinitive": "sigo"
      }
