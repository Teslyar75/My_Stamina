          "cefr_level": "A1",
          "word_slugs": [
            "local-adj"
          ]
        },
        {
          "id": "1227232",
          "text": "Ella trabaja como enfermera en el hospital local.",
          "translation": "Она работает медсестрой в местной больнице.",
