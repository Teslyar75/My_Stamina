          "plural of archivo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1508811",
          "text": "Los archivos están perdidos.",
          "translation": "Файлы потеряны.",
          "source": "Tatoeba #1508811 @marcelostockle / #6159453 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1508811",
          "cefr_level": "A1",
          "word_slugs": [
            "archivos-noun"
          ]
        },
        {
          "id": "1704669",
          "text": "Estoy adjuntando tres archivos.",
          "translation": "Я прикрепляю три файла.",
          "source": "Tatoeba #1704669 @marcelostockle / #4614977 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1704669",
          "cefr_level": "A1",
          "word_slugs": [
            "archivos-noun"
          ]
        },
        {
          "id": "1201317",
          "text": "¿Dónde está el resto de los archivos?",
          "translation": "Где остальные файлы?",
          "source": "Tatoeba #1201317 @cariito / #4622627 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1201317",
          "cefr_level": "A1",
          "word_slugs": [
            "archivos-noun"
          ]
        },
        {
          "id": "1305511",
          "text": "No puedo averiguar cómo transferir archivos MP3 a mi iPod.",
          "translation": "Я не могу понять, как закачать MP3 файлы в мой iPod.",
          "source": "Tatoeba #1305511 @marcelostockle / #2013418 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1305511",
          "cefr_level": "A1",
          "word_slugs": [
            "archivos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "archivos",
        "plural": "",
        "infinitive": ""
      }
