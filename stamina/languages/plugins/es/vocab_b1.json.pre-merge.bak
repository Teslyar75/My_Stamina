          "word_slugs": [
            "veinte-num"
          ]
        },
        {
          "id": "1289004",
          "text": "Eran unos veinte dólares.",
          "translation": "Это было около двадцати долларов.",
          "source": "Tatoeba #1289004 @enteka / #12638861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1289004",
          "cefr_level": "A1",
