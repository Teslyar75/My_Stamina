          ]
        },
        {
          "id": "5996996",
          "text": "Enciende tus luces.",
          "translation": "Включи свои фары.",
          "source": "Tatoeba #5996996 @albrusgher / #9832589 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5996996",
          "cefr_level": "A1",
          "word_slugs": [
            "luces-verb"
          ]
        },
        {
          "id": "1287387",
          "text": "Me gusta cómo luces.",
          "translation": "Мне нравится, как ты выглядишь.",
          "source": "Tatoeba #1287387 @marcelostockle / #2819386 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1287387",
          "cefr_level": "A1",
          "word_slugs": [
