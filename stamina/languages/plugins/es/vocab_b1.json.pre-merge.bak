    {
      "slug": "aseguro-verb",
      "lemma": "aseguro",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2422,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular present indicative of asegurar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2314611",
          "text": "Te aseguro que es bastante innecesario.",
          "translation": "Уверяю тебя, в этом нет никакой необходимости.",
          "source": "Tatoeba #2314611 @marcelostockle / #7927680 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2314611",
          "cefr_level": "A1",
          "word_slugs": [
            "aseguro-verb"
          ]
        },
        {
          "id": "2314609",
          "text": "Te aseguro que eso no es necesario.",
          "translation": "Уверяю тебя, в этом нет необходимости.",
          "source": "Tatoeba #2314609 @marcelostockle / #8739316 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2314609",
          "cefr_level": "A1",
          "word_slugs": [
            "aseguro-verb"
          ]
        },
        {
          "id": "2314625",
          "text": "Te aseguro que esto no es una broma.",
          "translation": "Уверяю тебя, что это не шутка.",
          "source": "Tatoeba #2314625 @marcelostockle / #6148069 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2314625",
          "cefr_level": "A1",
          "word_slugs": [
            "aseguro-verb"
          ]
        },
        {
          "id": "2826600",
          "text": "Te aseguro que no lo hice a propósito.",
          "translation": "Уверяю тебя, что я сделал это не нарочно.",
          "source": "Tatoeba #2826600 @marcelostockle / #7901329 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2826600",
          "cefr_level": "A1",
          "word_slugs": [
            "aseguro-verb"
          ]
        },
        {
          "id": "3933707",
          "text": "Les aseguro que todo estará listo a tiempo.",
          "translation": "Уверяю вас, всё будет готово вовремя.",
          "source": "Tatoeba #3933707 @gianich73 / #3933629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3933707",
          "cefr_level": "A1",
          "word_slugs": [
            "aseguro-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "aseguro",
        "plural": "",
        "infinitive": "aseguro"
      }
