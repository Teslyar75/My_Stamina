          ]
        },
        {
          "id": "2269039",
          "text": "Tenga usted esto como modelo.",
          "translation": "Возьмите это за образец.",
          "source": "Tatoeba #2269039 @cueyayotl / #11314955 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2269039",
