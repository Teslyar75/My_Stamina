    {
      "slug": "superior-adj",
      "lemma": "superior",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2117,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "superior",
          "better",
          "upper, higher"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1006296",
          "text": "Quiero hablar con su superior.",
          "translation": "Я хочу поговорить с Вашим начальником.",
          "source": "Tatoeba #1006296 @Shishir / #1681633 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1006296",
          "cefr_level": "A1",
          "word_slugs": [
            "superior-adj"
          ]
        },
        {
          "id": "2656668",
          "text": "Esto es superior a mis fuerzas.",
          "translation": "Это выше моих сил.",
          "source": "Tatoeba #2656668 @Shishir / #2162801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2656668",
          "cefr_level": "A1",
          "word_slugs": [
            "superior-adj"
          ]
        },
        {
          "id": "863238",
          "text": "Él es superior a mí en inglés.",
          "translation": "Его английский лучше моего.",
          "source": "Tatoeba #863238 @japegon / #447515 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/863238",
          "cefr_level": "A1",
          "word_slugs": [
            "superior-adj"
          ]
        },
        {
          "id": "1005230",
          "text": "Se cortó el labio superior mientras se afeitaba.",
          "translation": "Он порезал себе верхнюю губу во время бритья.",
          "source": "Tatoeba #1005230 @hayastan / #3195843 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1005230",
          "cefr_level": "A1",
          "word_slugs": [
            "superior-adj"
          ]
        },
        {
          "id": "8339393",
          "text": "La temperatura es muy superior a la de ayer.",
          "translation": "Температура гораздо выше вчерашней.",
          "source": "Tatoeba #8339393 @arh / #8348859 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8339393",
          "cefr_level": "A1",
          "word_slugs": [
            "superior-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el superior",
        "plural": "",
        "infinitive": ""
      }
