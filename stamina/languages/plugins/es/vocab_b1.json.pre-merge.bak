      "translations": {
        "en": [
          "plural of familia"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6600559",
          "text": "Ellos tienen familias.",
          "translation": "У них семьи.",
          "source": "Tatoeba #6600559 @arh / #12642721 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6600559",
          "cefr_level": "A1",
          "word_slugs": [
            "familias-noun"
          ]
        },
        {
          "id": "1152379",
          "text": "Veinte familias viven aquí.",
          "translation": "Здесь живёт двадцать семей.",
          "source": "Tatoeba #1152379 @nancy / #4510479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1152379",
          "cefr_level": "A1",
          "word_slugs": [
            "familias-noun"
          ]
        },
        {
          "id": "3039316",
          "text": "Tenemos familias que debemos cuidar.",
          "translation": "У нас есть семьи, о которых мы должны заботиться.",
          "source": "Tatoeba #3039316 @marcelostockle / #3041000 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3039316",
          "cefr_level": "A1",
          "word_slugs": [
            "familias-noun"
          ]
        },
        {
          "id": "1075531",
          "text": "Dos familias viven en la casa.",
          "translation": "В доме живут две семьи.",
          "source": "Tatoeba #1075531 @hayastan / #2980290 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1075531",
          "cefr_level": "A1",
          "word_slugs": [
            "familias-noun"
          ]
        },
        {
          "id": "1358138",
          "text": "Dos familias viven en esa casa.",
          "translation": "Две семьи живут в том доме.",
          "source": "Tatoeba #1358138 @Shishir / #468260 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1358138",
          "cefr_level": "A1",
          "word_slugs": [
            "familias-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
