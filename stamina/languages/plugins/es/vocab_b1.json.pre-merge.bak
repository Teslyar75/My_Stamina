    {
      "slug": "oigan-intj",
      "lemma": "oigan",
      "pos": "intj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1633,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "hey, listen, excuse me (said as a request for a group's attention)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5940138",
          "text": "Evita que te oigan.",
          "translation": "Постарайся, чтобы тебя не услышали.",
          "source": "Tatoeba #5940138 @arh / #6138324 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5940138",
          "cefr_level": "A1",
          "word_slugs": [
            "oigan-intj"
          ]
        },
        {
          "id": "896754",
          "text": "He cerrado la puerta para que no nos oigan.",
          "translation": "Я закрыл дверь, чтобы нас не было слышно.",
          "source": "Tatoeba #896754 @Shishir / #2748934 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/896754",
          "cefr_level": "A1",
          "word_slugs": [
            "oigan-intj"
          ]
        },
        {
          "id": "2192420",
          "text": "Quiero que todos oigan lo que tengo que decir.",
          "translation": "Я хочу, чтобы все слышали то, что я сейчас скажу.",
          "source": "Tatoeba #2192420 @marcelostockle / #11260057 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2192420",
          "cefr_level": "A1",
          "word_slugs": [
            "oigan-intj"
          ]
        }
      ],
      "tags": [
