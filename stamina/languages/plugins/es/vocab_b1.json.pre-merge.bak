    {
      "slug": "jane-name",
      "lemma": "Jane",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1421,
      "frequency_band": "cervantes-b1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8054666",
          "text": "Peter amaba a Jane.",
          "translation": "Питер любил Джейн.",
          "source": "Tatoeba #8054666 @Lorenz / #4982784 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8054666",
          "cefr_level": "A1",
          "word_slugs": [
            "jane-name"
          ]
        },
        {
          "id": "1276107",
          "text": "Jane no puede nadar.",
          "translation": "Джейн не умеет плавать.",
          "source": "Tatoeba #1276107 @Coilet / #3260870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1276107",
