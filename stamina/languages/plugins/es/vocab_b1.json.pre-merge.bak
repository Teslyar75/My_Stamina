          "cefr_level": "A1",
          "word_slugs": [
            "visita-noun"
          ]
        },
        {
          "id": "5714827",
          "text": "A veces él me visita.",
          "translation": "Иногда он меня навещает.",
          "source": "Tatoeba #5714827 @Tono / #5688025 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5714827",
