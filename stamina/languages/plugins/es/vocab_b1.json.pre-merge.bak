      "lemma": "saldrá",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2282,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular future indicative of salir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1447912",
          "text": "El sol saldrá pronto.",
          "translation": "Солнце скоро встанет.",
          "source": "Tatoeba #1447912 @Espi / #12558121 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1447912",
          "cefr_level": "A1",
          "word_slugs": [
            "saldrá-verb"
          ]
        },
        {
          "id": "3924563",
          "text": "Esta mercancía saldrá cara.",
          "translation": "Этот товар дорого обойдётся.",
          "source": "Tatoeba #3924563 @gianich73 / #3924040 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3924563",
          "cefr_level": "A1",
          "word_slugs": [
            "saldrá-verb"
          ]
        },
        {
          "id": "743738",
          "text": "¿Saldrá el tren a tiempo?",
          "translation": "Поезд отправится вовремя?",
          "source": "Tatoeba #743738 @Shishir / #12958223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/743738",
          "cefr_level": "A1",
          "word_slugs": [
            "saldrá-verb"
          ]
        },
        {
          "id": "1901518",
          "text": "El bus saldrá en seguida.",
          "translation": "Автобус сейчас поедет.",
          "source": "Tatoeba #1901518 @marcelostockle / #10502807 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1901518",
          "cefr_level": "A1",
          "word_slugs": [
            "saldrá-verb"
          ]
        },
        {
          "id": "1361225",
          "text": "Ella saldrá pronto del hospital.",
          "translation": "Она скоро выйдет из больницы.",
          "source": "Tatoeba #1361225 @Shishir / #1797848 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1361225",
          "cefr_level": "A1",
          "word_slugs": [
            "saldrá-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
