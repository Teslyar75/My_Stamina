          ]
        },
        {
          "id": "797774",
          "text": "Me insultó sin ningún motivo.",
          "translation": "Он оскорбил меня безо всякой причины.",
          "source": "Tatoeba #797774 @Shishir / #8188867 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/797774",
          "cefr_level": "A1",
          "word_slugs": [
            "motivo-noun"
          ]
        },
        {
          "id": "1551171",
          "text": "¿Por qué motivo fui detenido?",
