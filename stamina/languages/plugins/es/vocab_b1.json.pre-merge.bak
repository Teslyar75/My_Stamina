      },
      "gender": null,
      "examples": [
        {
          "id": "7745768",
          "text": "Estamos en el tercer piso.",
          "translation": "Мы на третьем этаже.",
          "source": "Tatoeba #7745768 @arh / #7726968 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7745768",
          "cefr_level": "A1",
