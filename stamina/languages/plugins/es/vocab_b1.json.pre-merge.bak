          "cefr_level": "A1",
          "word_slugs": [
            "verla-verb"
          ]
        },
        {
          "id": "579813",
          "text": "Me gustaría verla.",
          "translation": "Я хотел бы её увидеть.",
          "source": "Tatoeba #579813 @darinmex / #8627801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/579813",
          "cefr_level": "A1",
          "word_slugs": [
            "verla-verb"
          ]
        },
        {
          "id": "1920624",
          "text": "¿Te gustaría verla?",
          "translation": "Ты бы хотел её увидеть?",
          "source": "Tatoeba #1920624 @hayastan / #4477373 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1920624",
