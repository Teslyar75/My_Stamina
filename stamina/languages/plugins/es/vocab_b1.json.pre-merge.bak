    {
      "slug": "encantado-adj",
      "lemma": "encantado",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1520,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "enchanted, charmed",
          "pleased, delighted",
          "thrilled, overjoyed",
          "bewitched, haunted"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "852990",
          "text": "Encantado de verte.",
          "translation": "Рад тебя видеть.",
          "source": "Tatoeba #852990 @artukai / #503423 @drnm2 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/852990",
          "cefr_level": "A1",
