    {
      "slug": "esperen-verb",
      "lemma": "esperen",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1415,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of esperar:",
          "third-person plural present subjunctive",
          "inflection of esperar:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7248382",
          "text": "Esperen aquí, regreso enseguida.",
          "translation": "Подождите здесь, я мигом.",
          "source": "Tatoeba #7248382 @gianich73 / #7248071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7248382",
          "cefr_level": "A1",
          "word_slugs": [
            "esperen-verb"
          ]
        },
        {
          "id": "2086620",
          "text": "No esperen demasiado de él.",
          "translation": "Не ждите от него слишком многого.",
          "source": "Tatoeba #2086620 @marcelostockle / #4348248 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2086620",
          "cefr_level": "A1",
          "word_slugs": [
            "esperen-verb"
          ]
        },
        {
          "id": "2253052",
          "text": "Esperen hasta que abran fuego.",
          "translation": "Подождите, пока они не откроют огонь.",
          "source": "Tatoeba #2253052 @cueyayotl / #7769414 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2253052",
          "cefr_level": "A1",
          "word_slugs": [
            "esperen-verb"
          ]
        },
        {
          "id": "1062779",
          "text": "Esperen a que se ponga verde el semáforo.",
          "translation": "Подождите, пока загорится зелёный.",
          "source": "Tatoeba #1062779 @Shishir / #6998051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1062779",
          "cefr_level": "A1",
          "word_slugs": [
            "esperen-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "esperen",
        "plural": "",
        "infinitive": "esperen"
      }
