        "en": [
          "local"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12856152",
          "text": "Disculpeme, ¿eres local?",
          "translation": "Прости, ты местный?",
          "source": "Tatoeba #12856152 @\\N / #13685027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12856152",
          "cefr_level": "A1",
          "word_slugs": [
            "local-adj"
          ]
        },
        {
          "id": "11398156",
          "text": "La hora local son las 10.",
          "translation": "Местное время - десять часов.",
          "source": "Tatoeba #11398156 @adaycito / #11436342 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11398156",
          "cefr_level": "A1",
