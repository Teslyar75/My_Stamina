          "cefr_level": "A1",
          "word_slugs": [
            "escuché-verb"
          ]
        },
        {
          "id": "2840869",
          "text": "Perdón, no te escuché.",
          "translation": "Прости, не расслышал.",
          "source": "Tatoeba #2840869 @APagano / #5880018 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2840869",
          "cefr_level": "A1",
