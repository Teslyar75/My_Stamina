          ]
        },
        {
          "id": "7135964",
          "text": "¿Nos damos un paseo?",
          "translation": "Пойдём прогуляемся?",
          "source": "Tatoeba #7135964 @arh / #3302822 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7135964",
