          "translation": "Она плохо себя чувствовала.",
          "source": "Tatoeba #5027110 @don_ramon / #2638502 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5027110",
          "cefr_level": "A1",
          "word_slugs": [
            "sentía-verb"
          ]
        },
        {
          "id": "1006848",
          "text": "Se sentía cansado.",
          "translation": "Он чувствовал себя уставшим.",
          "source": "Tatoeba #1006848 @Shishir / #4158607 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1006848",
          "cefr_level": "A1",
          "word_slugs": [
            "sentía-verb"
          ]
        },
        {
          "id": "2103201",
          "text": "No se sentía bien.",
          "translation": "Она не очень хорошо себя чувствовала.",
          "source": "Tatoeba #2103201 @Shishir / #10960006 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2103201",
          "cefr_level": "A1",
          "word_slugs": [
            "sentía-verb"
          ]
        },
        {
          "id": "1441952",
          "text": "Tom se sentía cansado.",
          "translation": "Том чувствовал себя уставшим.",
          "source": "Tatoeba #1441952 @marcelostockle / #2493240 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1441952",
          "cefr_level": "A1",
          "word_slugs": [
            "sentía-verb"
          ]
        },
        {
          "id": "6637160",
          "text": "No sentía las piernas.",
          "translation": "Я не чувствовал ног.",
          "source": "Tatoeba #6637160 @arh / #7241235 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6637160",
          "cefr_level": "A1",
          "word_slugs": [
            "sentía-verb"
          ]
        }
