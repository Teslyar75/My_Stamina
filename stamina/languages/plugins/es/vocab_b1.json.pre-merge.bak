    {
      "slug": "ángeles-noun",
      "lemma": "ángeles",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1796,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of ángel (“angel”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5237688",
          "text": "No somos ángeles.",
          "translation": "Мы не ангелы.",
          "source": "Tatoeba #5237688 @Adelpa / #5237685 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5237688",
          "cefr_level": "A1",
          "word_slugs": [
            "ángeles-noun"
          ]
        },
        {
          "id": "1001471",
          "text": "Prefiero Los Ángeles.",
          "translation": "Я предпочитаю Лос-Анджелес.",
          "source": "Tatoeba #1001471 @Shishir / #5142711 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1001471",
          "cefr_level": "A1",
          "word_slugs": [
            "ángeles-noun"
          ]
        },
        {
          "id": "7717650",
          "text": "Cuando los ángeles duermen.",
          "translation": "Когда ангелы спят.",
          "source": "Tatoeba #7717650 @ecorralest101 / #7720260 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7717650",
          "cefr_level": "A1",
          "word_slugs": [
            "ángeles-noun"
          ]
        },
        {
          "id": "4118538",
