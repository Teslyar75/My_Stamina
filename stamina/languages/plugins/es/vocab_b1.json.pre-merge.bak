        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2945788",
          "text": "Compra la versión completa.",
          "translation": "Купи полную версию.",
          "source": "Tatoeba #2945788 @marcelostockle / #5968954 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2945788",
          "cefr_level": "A1",
          "word_slugs": [
