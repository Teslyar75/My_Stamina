    {
      "slug": "material-adj",
      "lemma": "material",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2195,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "material"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2270086",
          "text": "Emplearemos otro material.",
          "translation": "Мы используем другой материал.",
          "source": "Tatoeba #2270086 @Shishir / #6146676 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2270086",
          "cefr_level": "A1",
          "word_slugs": [
            "material-adj"
          ]
        },
        {
          "id": "2917297",
          "text": "Este material es más seguro.",
          "translation": "Этот материал безопаснее.",
          "source": "Tatoeba #2917297 @hayastan / #6139328 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2917297",
          "cefr_level": "A1",
          "word_slugs": [
            "material-adj"
          ]
        },
        {
          "id": "2270088",
          "text": "Vamos a probar el nuevo material.",
          "translation": "Мы испробуем новый материал.",
          "source": "Tatoeba #2270088 @Shishir / #6391369 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2270088",
          "cefr_level": "A1",
          "word_slugs": [
            "material-adj"
          ]
        },
        {
          "id": "5022724",
          "text": "Este material no es lo suficientemente elástico.",
          "translation": "Этот материал недостаточно эластичный.",
          "source": "Tatoeba #5022724 @don_ramon / #5019636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5022724",
          "cefr_level": "A1",
          "word_slugs": [
            "material-adj"
          ]
        },
        {
          "id": "2259444",
          "text": "El traje está hecho de material muy basto.",
          "translation": "Костюм пошит из очень грубого материала.",
          "source": "Tatoeba #2259444 @cueyayotl / #4792164 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259444",
          "cefr_level": "A1",
          "word_slugs": [
            "material-adj"
          ]
        }
