      "translations": {
        "en": [
          "feminine plural of quedo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3280832",
          "text": "Si te quedas, me quedo.",
          "translation": "Если ты останешься, я останусь.",
          "source": "Tatoeba #3280832 @Shishir / #3281775 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3280832",
          "cefr_level": "A1",
          "word_slugs": [
            "quedas-adj"
          ]
        },
        {
          "id": "2292208",
          "text": "¿Te quedas aquí o te vas?",
          "translation": "Ты остаёшься здесь или идёшь?",
          "source": "Tatoeba #2292208 @Shishir / #5105901 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2292208",
          "cefr_level": "A1",
          "word_slugs": [
            "quedas-adj"
          ]
        },
        {
          "id": "2679773",
          "text": "¿Por qué no te quedas aquí?",
          "translation": "Почему ты не остаёшься здесь?",
          "source": "Tatoeba #2679773 @Shishir / #2679781 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2679773",
          "cefr_level": "A1",
          "word_slugs": [
            "quedas-adj"
          ]
        },
        {
          "id": "5897805",
          "text": "Me da igual si te vas o te quedas.",
          "translation": "Мне всё равно, уйдёшь ты или останешься.",
          "source": "Tatoeba #5897805 @baudelaire / #1728615 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5897805",
          "cefr_level": "A1",
          "word_slugs": [
            "quedas-adj"
          ]
        },
        {
          "id": "13914230",
          "text": "En cuanto te relajas, te quedas fuera de juego.",
          "translation": "Стоит расслабиться, как окажешься в аутсайдерах.",
