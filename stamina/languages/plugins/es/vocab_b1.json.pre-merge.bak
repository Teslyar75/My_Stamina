        "en": [
          "vengeance"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3073841",
          "text": "Tendré mi venganza.",
          "translation": "Я отомщу.",
          "source": "Tatoeba #3073841 @cueyayotl / #3662608 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3073841",
          "cefr_level": "A1",
          "word_slugs": [
            "venganza-noun"
          ]
        },
        {
          "id": "2166447",
          "text": "Tom quiere venganza.",
          "translation": "Том хочет отомстить.",
          "source": "Tatoeba #2166447 @hayastan / #2811132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2166447",
          "cefr_level": "A1",
          "word_slugs": [
            "venganza-noun"
          ]
        },
        {
          "id": "1478578",
          "text": "Tom quería la venganza.",
          "translation": "Том жаждал мести.",
          "source": "Tatoeba #1478578 @marcelostockle / #2749622 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1478578",
          "cefr_level": "A1",
          "word_slugs": [
            "venganza-noun"
          ]
        },
        {
          "id": "3235897",
          "text": "Él quiere ejercer venganza.",
          "translation": "Он хочет отомстить.",
          "source": "Tatoeba #3235897 @alicanto / #6088730 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3235897",
          "cefr_level": "A1",
          "word_slugs": [
            "venganza-noun"
          ]
        },
        {
          "id": "2045267",
          "text": "Estaban motivados por la venganza.",
          "translation": "Ими двигала месть.",
          "source": "Tatoeba #2045267 @wiichi / #3285405 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2045267",
          "cefr_level": "A1",
