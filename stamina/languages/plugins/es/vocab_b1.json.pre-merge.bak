    {
      "slug": "cortar-verb",
      "lemma": "cortar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2291,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to cut",
          "to cut off, cut out, cut through, cut down, cut up, to nip",
          "to chop, chop up, chop off",
          "to slice, to slit"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3676939",
          "text": "Odio cortar el césped.",
          "translation": "Терпеть не могу стричь газон.",
          "source": "Tatoeba #3676939 @Seael / #6926829 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3676939",
          "cefr_level": "A1",
          "word_slugs": [
            "cortar-verb"
          ]
        },
        {
          "id": "569565",
          "text": "Tenemos que cortar nuestros gastos.",
          "translation": "Мы должны урезать наши расходы.",
          "source": "Tatoeba #569565 @Leono / #1770093 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/569565",
          "cefr_level": "A1",
          "word_slugs": [
            "cortar-verb"
          ]
        },
        {
          "id": "1197506",
          "text": "Este cuchillo no va a cortar bien.",
          "translation": "Этот нож не будет хорошо резать.",
          "source": "Tatoeba #1197506 @Shishir / #3281946 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1197506",
          "cefr_level": "A1",
          "word_slugs": [
            "cortar-verb"
          ]
        },
        {
          "id": "1721519",
          "text": "Pásame algo con qué cortar la cuerda.",
          "translation": "Передай мне что-нибудь, чем можно перерезать веревку.",
          "source": "Tatoeba #1721519 @marcelostockle / #1721939 @drnm2 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1721519",
          "cefr_level": "A1",
          "word_slugs": [
            "cortar-verb"
          ]
        },
        {
          "id": "3192847",
          "text": "El jardinero acaba de cortar el seto.",
          "translation": "Садовник только что подстриг изгородь.",
          "source": "Tatoeba #3192847 @cueyayotl / #3206537 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3192847",
          "cefr_level": "A1",
          "word_slugs": [
            "cortar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el cortar",
        "plural": "",
        "infinitive": "cortar"
      }
    },
    {
      "slug": "seria-adj",
      "lemma": "seria",
      "pos": "adj",
      "language": "es",
