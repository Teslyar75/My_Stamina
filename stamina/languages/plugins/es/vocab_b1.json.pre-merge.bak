      "translations": {
        "en": [
          "will, wish, want, desire",
          "willpower"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11731095",
          "text": "Tiene una voluntad de acero.",
          "translation": "У него стальная воля.",
          "source": "Tatoeba #11731095 @Seael / #12804763 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11731095",
          "cefr_level": "A1",
          "word_slugs": [
            "voluntad-noun"
          ]
        },
        {
          "id": "1606287",
          "text": "No te opongas a su voluntad.",
          "translation": "Не противься его воле.",
          "source": "Tatoeba #1606287 @marcelostockle / #7858061 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1606287",
          "cefr_level": "A1",
          "word_slugs": [
            "voluntad-noun"
          ]
        },
        {
          "id": "11731096",
          "text": "Él tiene una voluntad de acero.",
          "translation": "У него стальная воля.",
          "source": "Tatoeba #11731096 @Seael / #12804763 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11731096",
          "cefr_level": "A1",
          "word_slugs": [
            "voluntad-noun"
          ]
        },
        {
          "id": "2556830",
          "text": "Ella lo hizo contra su voluntad.",
          "translation": "Она сделала это против своей воли.",
          "source": "Tatoeba #2556830 @wallebot / #3104268 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2556830",
          "cefr_level": "A1",
          "word_slugs": [
            "voluntad-noun"
          ]
        },
        {
          "id": "4082679",
          "text": "Tom perdió la voluntad de vivir.",
          "translation": "Том утратил волю к жизни.",
          "source": "Tatoeba #4082679 @gianich73 / #4082548 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4082679",
          "cefr_level": "A1",
          "word_slugs": [
            "voluntad-noun"
          ]
        }
      ],
