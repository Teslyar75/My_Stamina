    {
      "slug": "metros-noun",
      "lemma": "metros",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1446,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of metro"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5058762",
          "text": "Mil metros son un kilómetro.",
          "translation": "Тысяча метров - это километр.",
          "source": "Tatoeba #5058762 @don_ramon / #5059279 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5058762",
          "cefr_level": "A1",
          "word_slugs": [
            "metros-noun"
          ]
        },
        {
          "id": "5042558",
          "text": "Tiene treinta metros de largo.",
          "translation": "Он тридцать метров длиной.",
          "source": "Tatoeba #5042558 @don_ramon / #5051362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5042558",
          "cefr_level": "A1",
          "word_slugs": [
            "metros-noun"
          ]
        },
        {
          "id": "5058765",
          "text": "Un kilómetro tiene mil metros.",
          "translation": "В километре тысяча метров.",
          "source": "Tatoeba #5058765 @don_ramon / #3845726 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5058765",
          "cefr_level": "A1",
          "word_slugs": [
            "metros-noun"
          ]
        },
        {
          "id": "13148622",
          "text": "Una milla es aproximadamente 1600 metros.",
          "translation": "Миля - это около 1600 метров.",
          "source": "Tatoeba #13148622 @frpzzd / #8174462 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13148622",
          "cefr_level": "A1",
          "word_slugs": [
            "metros-noun"
          ]
        },
        {
          "id": "1941575",
          "text": "Él cortó dos metros de cuerda.",
          "translation": "Он отрезал два метра верёвки.",
          "source": "Tatoeba #1941575 @hayastan / #5143169 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1941575",
          "cefr_level": "A1",
          "word_slugs": [
            "metros-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "metros",
