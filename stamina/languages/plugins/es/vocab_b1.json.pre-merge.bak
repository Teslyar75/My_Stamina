    {
      "slug": "copa-noun",
      "lemma": "copa",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1464,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "stemmed glass, glass, goblet or its content",
          "cocktail, drink",
          "crown, treetop",
          "cup, trophy (prize in sports)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1715779",
          "text": "La copa se quebró.",
          "translation": "Чашка разбилась.",
          "source": "Tatoeba #1715779 @marcelostockle / #4483084 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1715779",
          "cefr_level": "A1",
          "word_slugs": [
            "copa-noun"
          ]
        },
        {
          "id": "1106088",
          "text": "Tomaré una copa de champaña.",
          "translation": "Я выпью бокал шампанского.",
          "source": "Tatoeba #1106088 @AgentGreen / #4973013 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1106088",
          "cefr_level": "A1",
          "word_slugs": [
            "copa-noun"
          ]
        },
        {
          "id": "3373871",
          "text": "Alemania ganó la copa mundial 2014.",
          "translation": "Германия выиграла чемпионат мира по футболу 2014 года.",
          "source": "Tatoeba #3373871 @cueyayotl / #5431337 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3373871",
          "cefr_level": "A1",
          "word_slugs": [
            "copa-noun"
          ]
        },
        {
          "id": "8825658",
          "text": "El champán burbujeaba en la copa.",
          "translation": "Шампанское играло в бокале.",
          "source": "Tatoeba #8825658 @Curro / #5094071 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8825658",
          "cefr_level": "A1",
          "word_slugs": [
            "copa-noun"
          ]
        },
        {
          "id": "602678",
          "text": "Él bebió una copa de vino tinto.",
          "translation": "Он выпил бокал красного вина.",
          "source": "Tatoeba #602678 @darinmex / #5224191 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/602678",
          "cefr_level": "A1",
          "word_slugs": [
            "copa-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
