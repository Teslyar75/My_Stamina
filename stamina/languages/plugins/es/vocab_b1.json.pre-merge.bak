    {
      "slug": "clave-noun",
      "lemma": "clave",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2343,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "key (to a problem or puzzle)",
          "password",
          "code",
          "clef"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "637456",
          "text": "Perdí mi clave.",
          "translation": "Я потеряла свой ключ.",
          "source": "Tatoeba #637456 @Leono / #2594152 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/637456",
          "cefr_level": "A1",
          "word_slugs": [
            "clave-noun"
          ]
        },
        {
          "id": "7815739",
          "text": "Para de hablar en clave.",
          "translation": "Хватит говорить загадками.",
          "source": "Tatoeba #7815739 @User83002 / #5362425 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7815739",
          "cefr_level": "A1",
          "word_slugs": [
            "clave-noun"
          ]
        },
        {
          "id": "5012018",
          "text": "La duda es la clave del conocimiento.",
          "translation": "Сомнение - ключ к знанию.",
          "source": "Tatoeba #5012018 @don_ramon / #5012074 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5012018",
          "cefr_level": "A1",
          "word_slugs": [
            "clave-noun"
          ]
        },
        {
          "id": "4395168",
          "text": "Tom quiere saber dónde escondiste la clave.",
          "translation": "Том хочет знать, где ты спрятал ключ.",
          "source": "Tatoeba #4395168 @ponisio7 / #2593728 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4395168",
          "cefr_level": "A1",
          "word_slugs": [
            "clave-noun"
          ]
        },
        {
          "id": "1104866",
          "text": "Es el momento clave. Es ahora o nunca.",
          "translation": "Это решающий момент. Сейчас или никогда.",
          "source": "Tatoeba #1104866 @Shishir / #2731234 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1104866",
          "cefr_level": "A1",
          "word_slugs": [
            "clave-noun"
          ]
        }
      ],
