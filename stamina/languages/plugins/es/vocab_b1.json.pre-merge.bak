            "fortuna-adj"
          ]
        },
        {
          "id": "2265966",
          "text": "Por fortuna pudieron escapar.",
          "translation": "К счастью, им удалось сбежать.",
          "source": "Tatoeba #2265966 @cueyayotl / #5083288 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2265966",
          "cefr_level": "A1",
          "word_slugs": [
            "fortuna-adj"
          ]
        },
        {
          "id": "6401178",
          "text": "No creo en la fortuna.",
          "translation": "Я не верю в удачу.",
          "source": "Tatoeba #6401178 @emigonza / #2826855 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6401178",
