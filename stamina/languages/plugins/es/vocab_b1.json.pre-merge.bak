    {
      "slug": "olvida-verb",
      "lemma": "olvida",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2481,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of olvidar:",
          "third-person singular present indicative",
          "inflection of olvidar:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4928065",
          "text": "Olvida que dije eso.",
          "translation": "Забудь, что я это сказал.",
          "source": "Tatoeba #4928065 @cueyayotl / #4928057 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4928065",
          "cefr_level": "A1",
          "word_slugs": [
            "olvida-verb"
          ]
        },
        {
          "id": "4371808",
          "text": "Siempre se me olvida.",
          "translation": "Я всегда забываю.",
          "source": "Tatoeba #4371808 @umano / #5430487 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4371808",
          "cefr_level": "A1",
          "word_slugs": [
            "olvida-verb"
          ]
        },
        {
          "id": "12786450",
          "text": "Olvida las virtudes prusianas.",
          "translation": "Забудь о прусских добродетелях.",
          "source": "Tatoeba #12786450 @adaycito / #14094176 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12786450",
          "cefr_level": "A1",
          "word_slugs": [
            "olvida-verb"
          ]
        },
        {
          "id": "867228",
          "text": "Mi padre se olvida de todo.",
          "translation": "Мой отец обо всем забывает.",
          "source": "Tatoeba #867228 @Tux / #2822737 @Netka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/867228",
          "cefr_level": "A1",
          "word_slugs": [
            "olvida-verb"
          ]
        },
        {
          "id": "3707729",
          "text": "Olvida lo que acabo de decir.",
          "translation": "Забудь то, что я только что сказал.",
          "source": "Tatoeba #3707729 @cueyayotl / #3707821 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3707729",
          "cefr_level": "A1",
          "word_slugs": [
            "olvida-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
