    {
      "slug": "camisa-noun",
      "lemma": "camisa",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2116,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "рубашка"
        ],
        "en": [
          "shirt",
          "gas mantle",
          "condom"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4770231",
          "text": "Dame tu camisa.",
          "translation": "Дай мне свою рубашку.",
          "source": "Tatoeba #4770231 @alegarvid / #3965771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4770231",
          "cefr_level": "A1",
          "word_slugs": [
            "camisa-noun"
          ]
        },
        {
          "id": "1704758",
          "text": "¡Qué linda camisa!",
          "translation": "Какая красивая рубашка!",
          "source": "Tatoeba #1704758 @marcelostockle / #7880328 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1704758",
          "cefr_level": "A1",
          "word_slugs": [
            "camisa-noun"
          ]
        },
        {
          "id": "5147704",
          "text": "Planchó su camisa.",
          "translation": "Он погладил свою рубашку.",
          "source": "Tatoeba #5147704 @don_ramon / #6380119 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5147704",
          "cefr_level": "A1",
          "word_slugs": [
            "camisa-noun"
          ]
        },
        {
          "id": "853725",
          "text": "Pruébate esa camisa.",
          "translation": "Примерь эту рубашку.",
          "source": "Tatoeba #853725 @Angel_VV / #3077031 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/853725",
          "cefr_level": "A1",
          "word_slugs": [
            "camisa-noun"
          ]
        },
        {
          "id": "5140950",
          "text": "¿No es tu camisa?",
          "translation": "Это не твоя рубашка?",
          "source": "Tatoeba #5140950 @don_ramon / #5140971 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5140950",
          "cefr_level": "A1",
          "word_slugs": [
            "camisa-noun"
          ]
        }
      ],
