          ]
        },
        {
          "id": "4541880",
          "text": "¿Cuándo comenzaste a robar?",
          "translation": "Когда ты начал воровать?",
          "source": "Tatoeba #4541880 @ecorralest101 / #4541887 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4541880",
          "cefr_level": "A1",
