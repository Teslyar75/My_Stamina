          ]
        },
        {
          "id": "8244572",
          "text": "Es una bruja buena",
          "translation": "Она добрая ведьма.",
          "source": "Tatoeba #8244572 @dimafernandez / #5853953 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8244572",
          "cefr_level": "A1",
          "word_slugs": [
            "bruja-noun"
          ]
        },
        {
          "id": "601169",
          "text": "¡Es una verdadera bruja!",
