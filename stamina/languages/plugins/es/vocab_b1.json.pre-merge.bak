      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2273,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of nevar:",
          "first/third-person singular present subjunctive",
          "inflection of nevar:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5228849",
          "text": "Es una nieve.",
          "translation": "Это мороженое.",
          "source": "Tatoeba #5228849 @cueyayotl / #5228541 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5228849",
          "cefr_level": "A1",
          "word_slugs": [
