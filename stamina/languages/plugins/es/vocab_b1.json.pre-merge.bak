          "gerund of caminar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "727797",
          "text": "Me iré caminando.",
          "translation": "Я пойду пешком.",
          "source": "Tatoeba #727797 @ventana / #872094 @chaos (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/727797",
          "cefr_level": "A1",
          "word_slugs": [
            "caminando-verb"
          ]
        },
        {
          "id": "9706892",
          "text": "Tom está caminando.",
          "translation": "Том шагает.",
          "source": "Tatoeba #9706892 @Shishir / #4483074 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9706892",
          "cefr_level": "A1",
