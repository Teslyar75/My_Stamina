    {
      "slug": "cuerpos-noun",
      "lemma": "cuerpos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2097,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of cuerpo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1698815",
          "text": "Se encontraron cuatro cuerpos entre los escombros.",
          "translation": "Среди обломков нашли четыре тела.",
          "source": "Tatoeba #1698815 @alexmarcelo / #5281790 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1698815",
          "cefr_level": "A1",
          "word_slugs": [
            "cuerpos-noun"
          ]
        },
        {
          "id": "2117533",
          "text": "Tres de los cuerpos tenían heridas de bala.",
          "translation": "На трёх телах были следы от огнестрельных ранений.",
          "source": "Tatoeba #2117533 @hayastan / #6388965 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2117533",
          "cefr_level": "A1",
          "word_slugs": [
            "cuerpos-noun"
          ]
        },
        {
          "id": "1407387",
          "text": "El cono y la pirámide son cuerpos geométricos.",
          "translation": "Конус и пирамида являются геометрическими фигурами.",
          "source": "Tatoeba #1407387 @marcelostockle / #3305486 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1407387",
          "cefr_level": "A1",
          "word_slugs": [
            "cuerpos-noun"
          ]
        },
        {
          "id": "1242625",
          "text": "Aristóteles intentó explicar el movimiento de los cuerpos.",
          "translation": "Аристотель попытался объяснить движение тел.",
          "source": "Tatoeba #1242625 @hayastan / #5211320 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1242625",
          "cefr_level": "A1",
          "word_slugs": [
            "cuerpos-noun"
          ]
        },
        {
          "id": "10987625",
          "text": "Los cuerpos de los reptiles están cubiertos por escamas.",
          "translation": "Тело рептилий покрыто чешуёй.",
          "source": "Tatoeba #10987625 @carlosalberto / #4423567 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10987625",
          "cefr_level": "A1",
          "word_slugs": [
            "cuerpos-noun"
