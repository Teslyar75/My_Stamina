        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "6206126",
          "text": "Tom contrató un asistente.",
          "translation": "Том нанял ассистента.",
          "source": "Tatoeba #6206126 @baudelaire / #4890730 @venticello (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6206126",
          "cefr_level": "A1",
