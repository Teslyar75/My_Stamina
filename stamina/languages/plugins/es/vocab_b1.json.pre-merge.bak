    {
      "slug": "paquete-noun",
      "lemma": "paquete",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2389,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "parcel",
          "package",
          "chump, useless, butterfingers (an incompetent person)",
          "lunchbox (male genitals enclosed in clothing)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1386527",
          "text": "¿Recibiste mi paquete?",
          "translation": "Ты получил мою посылку?",
          "source": "Tatoeba #1386527 @marcelostockle / #8300894 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1386527",
          "cefr_level": "A1",
          "word_slugs": [
            "paquete-noun"
          ]
        },
        {
          "id": "3711434",
          "text": "Tengo un paquete para Tom.",
          "translation": "У меня для Тома есть пакет.",
          "source": "Tatoeba #3711434 @Shishir / #3711443 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3711434",
          "cefr_level": "A1",
          "word_slugs": [
            "paquete-noun"
          ]
        },
        {
          "id": "330628",
          "text": "Él envió el paquete anteayer.",
          "translation": "Он отправил посылку позавчера.",
          "source": "Tatoeba #330628 @tatoerique / #1545781 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/330628",
          "cefr_level": "A1",
          "word_slugs": [
            "paquete-noun"
          ]
        },
        {
          "id": "4428625",
          "text": "¿Quién te ha dado ese paquete?",
          "translation": "Кто дал тебе этот пакет?",
          "source": "Tatoeba #4428625 @Shishir / #4333877 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4428625",
          "cefr_level": "A1",
          "word_slugs": [
            "paquete-noun"
          ]
        },
        {
          "id": "4784014",
          "text": "Tenemos aquí un paquete para Tomás.",
          "translation": "У нас тут пакет для Тома.",
          "source": "Tatoeba #4784014 @alegarvid / #8029324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4784014",
          "cefr_level": "A1",
          "word_slugs": [
            "paquete-noun"
          ]
        }
