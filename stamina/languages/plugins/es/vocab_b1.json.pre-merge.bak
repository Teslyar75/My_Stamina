          ]
        },
        {
          "id": "7366011",
          "text": "Me puse una camisa blanca.",
          "translation": "Я надел белую рубашку.",
          "source": "Tatoeba #7366011 @arh / #7370114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7366011",
          "cefr_level": "A1",
          "word_slugs": [
            "puse-verb"
          ]
        },
        {
          "id": "6329719",
          "text": "Olvidé dónde puse el sombrero.",
          "translation": "Я забыл, куда положил шляпу.",
          "source": "Tatoeba #6329719 @baudelaire / #6466936 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6329719",
          "cefr_level": "A1",
          "word_slugs": [
            "puse-verb"
          ]
        }
