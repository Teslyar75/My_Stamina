    {
      "slug": "tendrán-verb",
      "lemma": "tendrán",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2079,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural future indicative of tener"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7144902",
          "text": "Ellas tendrán suerte.",
          "translation": "Им повезёт.",
          "source": "Tatoeba #7144902 @arh / #7146082 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7144902",
          "cefr_level": "A1",
          "word_slugs": [
            "tendrán-verb"
          ]
        },
        {
          "id": "5198361",
          "text": "No tendrán ese problema.",
          "translation": "У вас не будет этой проблемы.",
          "source": "Tatoeba #5198361 @cueyayotl / #3885028 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5198361",
          "cefr_level": "A1",
          "word_slugs": [
            "tendrán-verb"
          ]
        },
        {
          "id": "602802",
          "text": "Tendrán una fiesta mañana.",
          "translation": "У них завтра будет вечеринка.",
          "source": "Tatoeba #602802 @Leono / #6819143 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/602802",
          "cefr_level": "A1",
          "word_slugs": [
            "tendrán-verb"
          ]
        },
        {
          "id": "3070267",
          "text": "Los alumnos estudiosos tendrán buenos resultados.",
          "translation": "Прилежные ученики добьются хороших результатов.",
          "source": "Tatoeba #3070267 @hayastan / #3073283 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3070267",
          "cefr_level": "A1",
          "word_slugs": [
            "tendrán-verb"
          ]
        },
        {
          "id": "3070268",
          "text": "Los alumnos que estudian tendrán buenos resultados.",
          "translation": "Те ученики, что учатся, добьются хороших результатов.",
          "source": "Tatoeba #3070268 @hayastan / #3073280 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3070268",
          "cefr_level": "A1",
          "word_slugs": [
            "tendrán-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "tendrán",
        "plural": "",
        "infinitive": "tendrán"
