          ]
        },
        {
          "id": "1545211",
          "text": "Esa tienda tiene muchos clientes.",
          "translation": "У этого магазина много клиентов.",
          "source": "Tatoeba #1545211 @marcelostockle / #6835004 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1545211",
