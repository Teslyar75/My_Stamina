    {
      "slug": "siguen-verb",
      "lemma": "siguen",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1825,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural present indicative of seguir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10357532",
          "text": "Ellos siguen llamando.",
          "translation": "Они продолжают звать.",
          "source": "Tatoeba #10357532 @gianich73 / #5617676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10357532",
          "cefr_level": "A1",
          "word_slugs": [
            "siguen-verb"
          ]
        },
        {
          "id": "10357533",
          "text": "Ellas siguen llamando.",
          "translation": "Они продолжают звать.",
          "source": "Tatoeba #10357533 @gianich73 / #5617676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10357533",
          "cefr_level": "A1",
          "word_slugs": [
            "siguen-verb"
          ]
        },
        {
          "id": "700179",
          "text": "Los precios siguen subiendo.",
          "translation": "Цены продолжают расти.",
