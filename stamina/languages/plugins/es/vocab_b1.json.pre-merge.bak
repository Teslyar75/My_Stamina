          "source": "Tatoeba #5633213 @albrusgher / #6153952 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5633213",
          "cefr_level": "A1",
          "word_slugs": [
            "tesoro-noun"
          ]
        },
        {
          "id": "1221941",
          "text": "Fueron en búsqueda de tesoro.",
