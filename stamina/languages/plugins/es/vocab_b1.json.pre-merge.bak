            "caminando-verb"
          ]
        },
        {
          "id": "1205434",
          "text": "Ella está caminando.",
          "translation": "Она идёт.",
          "source": "Tatoeba #1205434 @cueyayotl / #5794093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1205434",
          "cefr_level": "A1",
          "word_slugs": [
            "caminando-verb"
          ]
        },
        {
          "id": "2595758",
          "text": "Ellos siguieron caminando.",
          "translation": "Они продолжили идти.",
          "source": "Tatoeba #2595758 @hayastan / #2596393 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2595758",
          "cefr_level": "A1",
          "word_slugs": [
            "caminando-verb"
          ]
        },
        {
          "id": "13203517",
          "text": "A veces voy caminando.",
          "translation": "Иногда я выхожу погулять.",
          "source": "Tatoeba #13203517 @frpzzd / #6447624 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13203517",
          "cefr_level": "A1",
          "word_slugs": [
            "caminando-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "caminando",
        "plural": "",
        "infinitive": "caminando"
      }
