    {
      "slug": "llevado-verb",
      "lemma": "llevado",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1815,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "past participle of llevar"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12259994",
          "text": "Ha llevado una vida desordenada.",
          "translation": "Он вёл беспорядочную жизнь.",
          "source": "Tatoeba #12259994 @adaycito / #12259998 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12259994",
