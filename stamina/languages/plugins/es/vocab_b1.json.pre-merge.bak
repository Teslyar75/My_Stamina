          "id": "1449513",
          "text": "Nunca te dejaré.",
          "translation": "Я никогда тебя не покину.",
          "source": "Tatoeba #1449513 @peibolvig / #1449528 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1449513",
          "cefr_level": "A1",
          "word_slugs": [
            "dejaré-verb"
          ]
        },
        {
          "id": "8674293",
          "text": "Te dejaré elegir.",
          "translation": "Я дам тебе выбрать.",
          "source": "Tatoeba #8674293 @ajje / #8674527 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8674293",
          "cefr_level": "A1",
          "word_slugs": [
            "dejaré-verb"
          ]
        },
        {
          "id": "10799694",
          "text": "Dejaré un mensaje.",
          "translation": "Я оставлю сообщение.",
          "source": "Tatoeba #10799694 @Curro / #6383817 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10799694",
          "cefr_level": "A1",
          "word_slugs": [
            "dejaré-verb"
          ]
        },
        {
          "id": "1798066",
          "text": "Dejaré de escribir.",
          "translation": "Я перестану писать.",
          "source": "Tatoeba #1798066 @al_ex_an_der / #4899856 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1798066",
          "cefr_level": "A1",
          "word_slugs": [
            "dejaré-verb"
          ]
        },
        {
          "id": "3389881",
          "text": "No te dejaré ir.",
          "translation": "Я не пущу тебя.",
          "source": "Tatoeba #3389881 @marcelostockle / #4519960 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3389881",
          "cefr_level": "A1",
          "word_slugs": [
            "dejaré-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
