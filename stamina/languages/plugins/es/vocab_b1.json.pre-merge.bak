          ]
        },
        {
          "id": "1938682",
          "text": "Jimmy insistió en que yo lo llevara al zoo.",
          "translation": "Джимми настоял на том, чтобы я сводил его в зоопарк.",
          "source": "Tatoeba #1938682 @teskmon / #14070228 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1938682",
          "cefr_level": "A1",
          "word_slugs": [
            "jimmy-name"
          ]
        }
      ],
      "tags": [
