        },
        {
          "id": "4997855",
          "text": "Enciende las luces.",
          "translation": "Включи свет.",
          "source": "Tatoeba #4997855 @alexmarcelo / #6328983 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4997855",
          "cefr_level": "A1",
