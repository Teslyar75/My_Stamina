            "hables-verb"
          ]
        },
        {
          "id": "5015792",
          "text": "No hables pavadas.",
          "translation": "Не говори ерунды.",
          "source": "Tatoeba #5015792 @don_ramon / #1480953 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5015792",
          "cefr_level": "A1",
