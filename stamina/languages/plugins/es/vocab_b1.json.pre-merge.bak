    {
      "slug": "red-noun",
      "lemma": "red",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1498,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
