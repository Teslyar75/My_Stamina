          "cefr_level": "A1",
          "word_slugs": [
            "funcionar-verb"
          ]
        },
        {
          "id": "1066430",
          "text": "Mi mouse dejó de funcionar.",
          "translation": "Моя мышь вышла из строя.",
          "source": "Tatoeba #1066430 @hayastan / #5538445 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1066430",
          "cefr_level": "A1",
          "word_slugs": [
            "funcionar-verb"
          ]
        },
        {
          "id": "1703093",
          "text": "El freno dejó de funcionar.",
          "translation": "Тормоза отказали.",
          "source": "Tatoeba #1703093 @marcelostockle / #3065066 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1703093",
          "cefr_level": "A1",
          "word_slugs": [
            "funcionar-verb"
          ]
        }
