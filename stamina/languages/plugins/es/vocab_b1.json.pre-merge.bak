    {
      "slug": "humana-noun",
      "lemma": "humana",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1803,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "female equivalent of humano (“human”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4472877",
          "text": "La vida humana no es fácil.",
          "translation": "Жизнь человека нелегка.",
          "source": "Tatoeba #4472877 @cueyayotl / #2734125 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4472877",
          "cefr_level": "A1",
          "word_slugs": [
            "humana-noun"
          ]
        },
        {
          "id": "1156394",
          "text": "El alma humana anhela algo noble.",
          "translation": "Человеческая душа жаждет чего-то благородного.",
          "source": "Tatoeba #1156394 @marcelostockle / #9750584 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1156394",
          "cefr_level": "A1",
          "word_slugs": [
            "humana-noun"
          ]
        },
        {
          "id": "2947278",
          "text": "La idiotez humana no tiene límites.",
          "translation": "Человеческая глупость не знает границ.",
          "source": "Tatoeba #2947278 @hayastan / #2947391 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2947278",
          "cefr_level": "A1",
          "word_slugs": [
            "humana-noun"
          ]
        },
        {
          "id": "2778603",
          "text": "La crueldad humana no tiene límites.",
          "translation": "Человеческая жестокость не имеет границ.",
          "source": "Tatoeba #2778603 @nancy / #4068039 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2778603",
          "cefr_level": "A1",
          "word_slugs": [
            "humana-noun"
          ]
        },
        {
          "id": "2844341",
          "text": "¿Cuál es la verdadera naturaleza humana?",
          "translation": "Какова истинная природа человека?",
          "source": "Tatoeba #2844341 @nancy / #2849078 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2844341",
          "cefr_level": "A1",
          "word_slugs": [
            "humana-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
