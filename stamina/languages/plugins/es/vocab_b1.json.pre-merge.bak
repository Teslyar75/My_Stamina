      "translations": {
        "en": [
          "to detain",
          "to arrest",
          "to stop, halt, to pause",
          "to pull over"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2866844",
          "text": "Los voy a detener.",
          "translation": "Я собираюсь их остановить.",
          "source": "Tatoeba #2866844 @cueyayotl / #2867164 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2866844",
          "cefr_level": "A1",
          "word_slugs": [
            "detener-verb"
          ]
        },
        {
          "id": "3298455",
          "text": "¿Quieres detener a Tom?",
          "translation": "Хочешь остановить Тома?",
          "source": "Tatoeba #3298455 @gianich73 / #2524914 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3298455",
          "cefr_level": "A1",
          "word_slugs": [
            "detener-verb"
          ]
        },
        {
          "id": "1649131",
          "text": "Él no nos puede detener.",
          "translation": "Он не может нас остановить.",
          "source": "Tatoeba #1649131 @alexmarcelo / #5062572 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1649131",
          "cefr_level": "A1",
          "word_slugs": [
            "detener-verb"
          ]
        },
        {
          "id": "3410160",
          "text": "Tú no me puedes detener.",
          "translation": "Ты не можешь остановить нас.",
          "source": "Tatoeba #3410160 @gianich73 / #3410015 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3410160",
          "cefr_level": "A1",
          "word_slugs": [
            "detener-verb"
          ]
        },
        {
          "id": "1649247",
          "text": "Ella no me puede detener.",
          "translation": "Она не может меня остановить.",
          "source": "Tatoeba #1649247 @alexmarcelo / #5084681 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1649247",
          "cefr_level": "A1",
          "word_slugs": [
            "detener-verb"
          ]
        }
      ],
