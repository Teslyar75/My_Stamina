    {
      "slug": "contrario-adj",
      "lemma": "contrario",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1482,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "contrary, opposite",
          "opposed, against"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "9830434",
          "text": "Pienso lo contrario.",
          "translation": "Я думаю иначе.",
          "source": "Tatoeba #9830434 @Wilmer / #1800244 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9830434",
          "cefr_level": "A1",
          "word_slugs": [
            "contrario-adj"
          ]
        },
        {
          "id": "2380150",
          "text": "Lamentablemente no; al contrario.",
          "translation": "К сожалению, нет. Наоборот.",
          "source": "Tatoeba #2380150 @marcelostockle / #8021887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2380150",
          "cefr_level": "A1",
          "word_slugs": [
            "contrario-adj"
          ]
        },
        {
          "id": "4934754",
          "text": "Mi opinión es lo contrario.",
          "translation": "У меня противоположное мнение.",
          "source": "Tatoeba #4934754 @DarkHollow / #2340184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4934754",
          "cefr_level": "A1",
          "word_slugs": [
            "contrario-adj"
          ]
        },
        {
          "id": "449801",
          "text": "No puedo decir lo contrario.",
          "translation": "Не могу ничего возразить.",
          "source": "Tatoeba #449801 @Shishir / #3064303 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/449801",
          "cefr_level": "A1",
          "word_slugs": [
            "contrario-adj"
          ]
        },
        {
          "id": "9830436",
          "text": "La madre decidió lo contrario.",
          "translation": "Мать решила иначе.",
          "source": "Tatoeba #9830436 @Wilmer / #2661418 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9830436",
          "cefr_level": "A1",
          "word_slugs": [
            "contrario-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el contrario",
