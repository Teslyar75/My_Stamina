    {
      "slug": "ponga-verb",
      "lemma": "ponga",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1855,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of poner:",
          "first/third-person singular present subjunctive",
          "inflection of poner:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2081515",
          "text": "¿Qué quieres que me ponga?",
          "translation": "Что ты хочешь, чтобы я надела?",
          "source": "Tatoeba #2081515 @marcelostockle / #6594665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2081515",
          "cefr_level": "A1",
          "word_slugs": [
            "ponga-verb"
          ]
        },
        {
          "id": "2015670",
          "text": "¿Dónde quieres que ponga esto?",
          "translation": "Куда ты хочешь, чтобы я это положил?",
          "source": "Tatoeba #2015670 @marcelostockle / #6164267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2015670",
          "cefr_level": "A1",
          "word_slugs": [
            "ponga-verb"
          ]
        },
        {
          "id": "5494166",
          "text": "No ponga eso en la mesa.",
          "translation": "Не кладите это на стол.",
          "source": "Tatoeba #5494166 @baudelaire / #6535044 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494166",
          "cefr_level": "A1",
          "word_slugs": [
            "ponga-verb"
          ]
        },
        {
          "id": "2267690",
          "text": "Ponga dos frazadas en la cama.",
          "translation": "Положите на кровать два одеяла.",
          "source": "Tatoeba #2267690 @hayastan / #3703714 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2267690",
          "cefr_level": "A1",
          "word_slugs": [
            "ponga-verb"
          ]
        },
        {
          "id": "401206",
          "text": "Ponga el libro donde lo encontró.",
          "translation": "Положите книгу туда, где нашли.",
          "source": "Tatoeba #401206 @cueyayotl / #11155573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/401206",
          "cefr_level": "A1",
          "word_slugs": [
            "ponga-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "ponga",
        "plural": "",
        "infinitive": "ponga"
      }
