    {
      "slug": "aparte-adj",
      "lemma": "aparte",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2235,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "separate, apart",
          "unique, special"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2259250",
          "text": "Eso es cuestión aparte.",
          "translation": "Это отдельный вопрос.",
          "source": "Tatoeba #2259250 @cueyayotl / #4556819 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259250",
          "cefr_level": "A1",
          "word_slugs": [
            "aparte-adj"
          ]
        },
        {
          "id": "7447471",
          "text": "Los impuestos van aparte.",
          "translation": "Налоги учитываются отдельно.",
          "source": "Tatoeba #7447471 @arh / #7453854 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7447471",
          "cefr_level": "A1",
          "word_slugs": [
            "aparte-adj"
          ]
        },
        {
          "id": "8612577",
          "text": "Lavaré las sábanas aparte.",
          "translation": "Я постираю простыни отдельно.",
          "source": "Tatoeba #8612577 @arh / #8618107 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8612577",
          "cefr_level": "A1",
          "word_slugs": [
            "aparte-adj"
          ]
        },
        {
          "id": "5648809",
          "text": "Sé muy poco aparte de eso.",
          "translation": "Кроме этого я почти ничего не знаю.",
          "source": "Tatoeba #5648809 @arh / #6995673 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5648809",
          "cefr_level": "A1",
          "word_slugs": [
            "aparte-adj"
          ]
        },
        {
          "id": "1709701",
          "text": "Aparte de fumar, mi padre bebe.",
          "translation": "Мой отец не только курит, но и пьёт.",
          "source": "Tatoeba #1709701 @wallebot / #4359961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1709701",
          "cefr_level": "A1",
          "word_slugs": [
            "aparte-adj"
          ]
        }
      ],
