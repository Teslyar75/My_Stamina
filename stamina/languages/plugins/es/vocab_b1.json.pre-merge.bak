      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1138435",
          "text": "Me gusta Alex Marcelo.",
          "translation": "Мне нравится Алекс Марсело.",
          "source": "Tatoeba #1138435 @Shishir / #3843706 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1138435",
          "cefr_level": "A1",
          "word_slugs": [
            "alex-name"
          ]
        },
        {
          "id": "1433850",
          "text": "¿Cuántos autos tiene Alex?",
          "translation": "Сколько машин у Алекса?",
          "source": "Tatoeba #1433850 @marcelostockle / #1433981 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1433850",
          "cefr_level": "A1",
          "word_slugs": [
            "alex-name"
          ]
        },
        {
          "id": "2717837",
          "text": "¿Cuántos coches tiene Alex?",
          "translation": "Сколько машин у Алекса?",
          "source": "Tatoeba #2717837 @cueyayotl / #1433981 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2717837",
          "cefr_level": "A1",
          "word_slugs": [
            "alex-name"
          ]
        },
        {
          "id": "1116349",
          "text": "Me llamo Alex, pero prefiero que me llamen Augusto.",
          "translation": "Меня зовут Алекс, но я предпочитаю, чтобы меня звали Аугусто.",
          "source": "Tatoeba #1116349 @Shishir / #4156354 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1116349",
          "cefr_level": "A1",
          "word_slugs": [
            "alex-name"
          ]
        },
        {
          "id": "3183417",
          "text": "Alex encontró consuelo en las palabras de la amiga.",
          "translation": "Алекс нашёл утешение в словах подруги.",
          "source": "Tatoeba #3183417 @hayastan / #3184087 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3183417",
          "cefr_level": "A1",
          "word_slugs": [
            "alex-name"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
