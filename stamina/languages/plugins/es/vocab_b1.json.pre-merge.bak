    {
      "slug": "llevaron-verb",
      "lemma": "llevaron",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2380,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural preterite indicative of llevar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6771466",
          "text": "Me llevaron en camilla.",
          "translation": "Меня отнесли на носилках.",
          "source": "Tatoeba #6771466 @arh / #6775689 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6771466",
          "cefr_level": "A1",
          "word_slugs": [
            "llevaron-verb"
          ]
        },
        {
          "id": "8326799",
          "text": "Se lo llevaron en camilla.",
          "translation": "Его унесли на носилках.",
          "source": "Tatoeba #8326799 @arh / #9752131 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8326799",
          "cefr_level": "A1",
          "word_slugs": [
            "llevaron-verb"
          ]
        },
        {
          "id": "2087269",
          "text": "Los celos lo llevaron a eso.",
          "translation": "Ревность его до этого довела.",
          "source": "Tatoeba #2087269 @marcelostockle / #4004325 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2087269",
          "cefr_level": "A1",
          "word_slugs": [
            "llevaron-verb"
          ]
        },
        {
          "id": "4004350",
          "text": "Sus celos lo llevaron hasta esto.",
          "translation": "Ревность его до этого довела.",
          "source": "Tatoeba #4004350 @gianich73 / #4004325 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4004350",
          "cefr_level": "A1",
          "word_slugs": [
            "llevaron-verb"
          ]
        },
        {
          "id": "1901189",
          "text": "Se llevaron a Tom en una camilla.",
          "translation": "Они унесли Тома на носилках.",
          "source": "Tatoeba #1901189 @marcelostockle / #4853461 @venticello (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1901189",
          "cefr_level": "A1",
          "word_slugs": [
            "llevaron-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "llevaron",
        "plural": "",
        "infinitive": "llevaron"
      }
