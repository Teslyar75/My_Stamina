    {
      "slug": "pedí-verb",
      "lemma": "pedí",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1603,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of pedir:",
          "first-person singular preterite indicative",
          "inflection of pedir:",
          "second-person singular voseo imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5864166",
          "text": "Pedí un aumento.",
          "translation": "Я попросил прибавку к зарплате.",
          "source": "Tatoeba #5864166 @arh / #6285885 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5864166",
          "cefr_level": "A1",
          "word_slugs": [
            "pedí-verb"
          ]
        },
        {
          "id": "10695450",
          "text": "Les pedí consejo.",
          "translation": "Я попросил у них совета.",
          "source": "Tatoeba #10695450 @Ekim / #10695452 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10695450",
          "cefr_level": "A1",
          "word_slugs": [
            "pedí-verb"
          ]
        },
        {
          "id": "2314121",
          "text": "Tampoco te pedí eso.",
          "translation": "Я тоже тебя об этом не просил.",
          "source": "Tatoeba #2314121 @marcelostockle / #5593191 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2314121",
          "cefr_level": "A1",
          "word_slugs": [
            "pedí-verb"
          ]
        },
        {
          "id": "2568538",
          "text": "Le pedí una gauchada.",
          "translation": "Я попросил его об одолжении.",
          "source": "Tatoeba #2568538 @hayastan / #2700677 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2568538",
          "cefr_level": "A1",
          "word_slugs": [
            "pedí-verb"
          ]
        },
        {
          "id": "1908916",
          "text": "No pedí ninguna ayuda.",
          "translation": "Я не просил никакой помощи.",
          "source": "Tatoeba #1908916 @hayastan / #7730102 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1908916",
          "cefr_level": "A1",
          "word_slugs": [
            "pedí-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "pedí",
        "plural": "",
        "infinitive": "pedí"
      }
