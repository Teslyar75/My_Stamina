    {
      "slug": "trampa-noun",
      "lemma": "trampa",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1477,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "trap, snare",
          "cheating, cheat (violation of rules to gain an advantage)",
          "trapdoor (hinged or sliding door set into a floor)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1127995",
          "text": "¡Es una trampa!",
          "translation": "Это ловушка!",
          "source": "Tatoeba #1127995 @cueyayotl / #1671079 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1127995",
          "cefr_level": "A1",
          "word_slugs": [
            "trampa-noun"
          ]
        },
        {
          "id": "4523970",
          "text": "Él hace trampa.",
          "translation": "Он жульничает.",
          "source": "Tatoeba #4523970 @cueyayotl / #7551346 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4523970",
          "cefr_level": "A1",
          "word_slugs": [
            "trampa-noun"
          ]
        },
        {
          "id": "4873735",
          "text": "Fue una trampa.",
          "translation": "Это была ловушка.",
          "source": "Tatoeba #4873735 @gianich73 / #4873572 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4873735",
          "cefr_level": "A1",
          "word_slugs": [
            "trampa-noun"
          ]
        },
        {
          "id": "4050630",
          "text": "No es una trampa.",
          "translation": "Это не ловушка.",
          "source": "Tatoeba #4050630 @gianich73 / #4913335 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4050630",
          "cefr_level": "A1",
          "word_slugs": [
            "trampa-noun"
          ]
        },
        {
          "id": "2917095",
          "text": "Caí en una trampa.",
          "translation": "Я попался в ловушку.",
          "source": "Tatoeba #2917095 @hayastan / #3708685 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2917095",
          "cefr_level": "A1",
          "word_slugs": [
            "trampa-noun"
          ]
        }
