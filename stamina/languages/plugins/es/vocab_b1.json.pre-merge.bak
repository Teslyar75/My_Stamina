          "source": "Tatoeba #2789790 @nancy / #4070780 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2789790",
          "cefr_level": "A1",
          "word_slugs": [
            "sentimientos-noun"
          ]
        },
        {
          "id": "1297501",
          "text": "No muestra sus sentimientos.",
          "translation": "Он не показывает своих чувств.",
          "source": "Tatoeba #1297501 @enteka / #7826011 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1297501",
          "cefr_level": "A1",
          "word_slugs": [
            "sentimientos-noun"
          ]
        },
        {
          "id": "9684184",
          "text": "No entiendo mis sentimientos.",
          "translation": "Я не понимаю своих чувств.",
          "source": "Tatoeba #9684184 @Shishir / #4805927 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9684184",
          "cefr_level": "A1",
          "word_slugs": [
            "sentimientos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
