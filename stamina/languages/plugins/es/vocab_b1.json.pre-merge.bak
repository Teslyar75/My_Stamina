    {
      "slug": "teniendo-verb",
      "lemma": "teniendo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1255,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "gerund of tener"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7480819",
          "text": "Sigo teniendo pesadillas.",
          "translation": "Мне продолжают сниться кошмары.",
          "source": "Tatoeba #7480819 @arh / #11436468 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7480819",
          "cefr_level": "A1",
          "word_slugs": [
            "teniendo-verb"
          ]
        },
        {
          "id": "3148205",
          "text": "Estoy teniendo una semana difícil.",
          "translation": "У меня тяжелая неделя.",
          "source": "Tatoeba #3148205 @leoruilova / #3152976 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3148205",
          "cefr_level": "A1",
          "word_slugs": [
            "teniendo-verb"
          ]
        },
        {
          "id": "338620",
          "text": "Teniendo salud, todo es realizable.",
          "translation": "Обладая здоровьем, человек может сделать всё.",
          "source": "Tatoeba #338620 @tatoerique / #2928640 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/338620",
          "cefr_level": "A1",
          "word_slugs": [
            "teniendo-verb"
          ]
        },
        {
          "id": "2744041",
          "text": "Tom estaba teniendo un mal día.",
          "translation": "У Тома был плохой день.",
          "source": "Tatoeba #2744041 @Shishir / #5537385 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2744041",
          "cefr_level": "A1",
          "word_slugs": [
            "teniendo-verb"
          ]
        },
        {
          "id": "1626381",
          "text": "Quien calla aun teniendo razón, está casado.",
          "translation": "Кто замолкает даже в тех случаях, когда прав, тот женат.",
          "source": "Tatoeba #1626381 @Alba / #6391599 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1626381",
          "cefr_level": "A1",
          "word_slugs": [
            "teniendo-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
