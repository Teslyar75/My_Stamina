    {
      "slug": "curso-noun",
      "lemma": "curso",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2186,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "course, trajectory, route, direction",
          "class, course (learning program, as in a school)",
          "(US) grade, (UK) year",
          "diarrhea"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1506597",
          "text": "Está en el cuarto curso.",
          "translation": "Он на четвёртом курсе.",
          "source": "Tatoeba #1506597 @marco87 / #3708208 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1506597",
          "cefr_level": "A1",
          "word_slugs": [
            "curso-noun"
          ]
        },
        {
          "id": "4436958",
          "text": "¿Para quién es este curso?",
          "translation": "Для кого этот курс?",
          "source": "Tatoeba #4436958 @Shishir / #4436778 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4436958",
          "cefr_level": "A1",
          "word_slugs": [
            "curso-noun"
          ]
        },
        {
          "id": "6583237",
          "text": "Le tocará repetir el curso.",
          "translation": "Ему придётся заново пройти учебный курс.",
          "source": "Tatoeba #6583237 @arh / #6590445 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6583237",
          "cefr_level": "A1",
          "word_slugs": [
            "curso-noun"
          ]
        },
        {
          "id": "958261",
          "text": "Su curso nos ha decepcionado.",
          "translation": "Её курс нас разочаровал.",
          "source": "Tatoeba #958261 @hundo / #12838531 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/958261",
          "cefr_level": "A1",
          "word_slugs": [
            "curso-noun"
          ]
        },
        {
          "id": "2268520",
          "text": "La enfermedad sigue su curso.",
          "translation": "Болезнь идёт своим ходом.",
          "source": "Tatoeba #2268520 @cueyayotl / #3708204 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2268520",
          "cefr_level": "A1",
          "word_slugs": [
            "curso-noun"
          ]
        }
      ],
