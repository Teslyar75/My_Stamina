    {
      "slug": "termine-verb",
      "lemma": "termine",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2217,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of terminar:",
          "first/third-person singular present subjunctive",
          "inflection of terminar:",
          "third-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4555000",
          "text": "Deja que termine, ¿no?",
          "translation": "Дай я закончу, а?",
          "source": "Tatoeba #4555000 @swyter / #4556359 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4555000",
          "cefr_level": "A1",
          "word_slugs": [
            "termine-verb"
          ]
        },
        {
          "id": "2081563",
          "text": "No quiero que este día termine.",
          "translation": "Я не хочу, чтобы этот день заканчивался.",
          "source": "Tatoeba #2081563 @marcelostockle / #5415499 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2081563",
          "cefr_level": "A1",
          "word_slugs": [
            "termine-verb"
          ]
        },
        {
          "id": "723739",
          "text": "Cuando termine con lo que estoy haciendo vendré.",
          "translation": "Когда я закончу с тем, что делаю сейчас, я приду.",
          "source": "Tatoeba #723739 @Shishir / #4027445 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/723739",
          "cefr_level": "A1",
          "word_slugs": [
            "termine-verb"
          ]
        },
        {
          "id": "359001",
          "text": "Cuando termine este trabajo voy a leer un libro.",
          "translation": "Когда я закончу эту работу, я собираюсь прочитать книгу.",
          "source": "Tatoeba #359001 @tatoerique / #11030534 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/359001",
          "cefr_level": "A1",
          "word_slugs": [
            "termine-verb"
          ]
        },
        {
          "id": "1613029",
          "text": "Faltan solo dos capítulos para que termine el libro.",
          "translation": "Мне осталось всего две главы до конца книги.",
          "source": "Tatoeba #1613029 @hayastan / #5793272 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1613029",
          "cefr_level": "A1",
          "word_slugs": [
            "termine-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "termine",
        "plural": "",
        "infinitive": "termine"
      }
