          ]
        },
        {
          "id": "9462427",
          "text": "Odio el pescado.",
          "translation": "Я терпеть не могу рыбу.",
          "source": "Tatoeba #9462427 @ignacio / #10196315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9462427",
