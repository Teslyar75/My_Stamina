          "darkness",
          "obscurity"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1542383",
          "text": "Brilla en la oscuridad.",
          "translation": "Он светится в темноте.",
          "source": "Tatoeba #1542383 @marcelostockle / #3699113 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1542383",
          "cefr_level": "A1",
          "word_slugs": [
            "oscuridad-noun"
          ]
        },
        {
          "id": "1233182",
          "text": "¿Le temes a la oscuridad?",
          "translation": "Ты боишься темноты?",
          "source": "Tatoeba #1233182 @marcelostockle / #2454732 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1233182",
          "cefr_level": "A1",
          "word_slugs": [
            "oscuridad-noun"
          ]
        },
        {
          "id": "2676193",
          "text": "Le da miedo la oscuridad.",
          "translation": "Он боится темноты.",
          "source": "Tatoeba #2676193 @Shishir / #5058949 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2676193",
          "cefr_level": "A1",
          "word_slugs": [
            "oscuridad-noun"
          ]
        },
        {
          "id": "2676195",
          "text": "Tiene miedo a la oscuridad.",
          "translation": "Он боится темноты.",
          "source": "Tatoeba #2676195 @Shishir / #5058949 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2676195",
          "cefr_level": "A1",
          "word_slugs": [
            "oscuridad-noun"
          ]
        },
        {
          "id": "5439772",
          "text": "Nos besamos en la oscuridad.",
          "translation": "Мы целовались в темноте.",
          "source": "Tatoeba #5439772 @mferrer0000 / #5412115 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5439772",
          "cefr_level": "A1",
          "word_slugs": [
            "oscuridad-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
