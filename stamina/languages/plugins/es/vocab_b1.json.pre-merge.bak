    {
      "slug": "asiento-noun",
      "lemma": "asiento",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1568,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "seat",
          "sediment, deposit",
          "treaty, pact",
          "foundation"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4394642",
          "text": "Toma un asiento.",
          "translation": "Садись.",
          "source": "Tatoeba #4394642 @teskmon / #2013284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4394642",
          "cefr_level": "A1",
          "word_slugs": [
            "asiento-noun"
          ]
        },
        {
          "id": "1283001",
          "text": "Guárdame un asiento.",
          "translation": "Займи мне место.",
          "source": "Tatoeba #1283001 @marcelostockle / #1938698 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1283001",
          "cefr_level": "A1",
          "word_slugs": [
            "asiento-noun"
          ]
        },
        {
          "id": "2002274",
          "text": "Guardame el asiento.",
          "translation": "Займи мне место.",
          "source": "Tatoeba #2002274 @wallebot / #1938698 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2002274",
          "cefr_level": "A1",
          "word_slugs": [
            "asiento-noun"
          ]
        },
        {
          "id": "4917002",
          "text": "Ahí hay un asiento.",
          "translation": "Там есть место.",
          "source": "Tatoeba #4917002 @Shishir / #6001366 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4917002",
          "cefr_level": "A1",
          "word_slugs": [
            "asiento-noun"
          ]
        },
        {
          "id": "757030",
          "text": "Por favor tome asiento.",
          "translation": "Садитесь, пожалуйста!",
          "source": "Tatoeba #757030 @Shishir / #3988151 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/757030",
          "cefr_level": "A1",
          "word_slugs": [
            "asiento-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "asiento",
