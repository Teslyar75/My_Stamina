    {
      "slug": "estados-noun",
      "lemma": "estados",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1269,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of estado"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2135904",
          "text": "¿Eres de Estados Unidos?",
          "translation": "Ты из Соединённых Штатов?",
          "source": "Tatoeba #2135904 @marcelostockle / #3314919 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2135904",
          "cefr_level": "A1",
          "word_slugs": [
            "estados-noun"
          ]
        },
        {
          "id": "875180",
          "text": "Soy de los Estados Unidos.",
          "translation": "Я из Америки.",
          "source": "Tatoeba #875180 @Shishir / #2884052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/875180",
          "cefr_level": "A1",
          "word_slugs": [
            "estados-noun"
          ]
        },
        {
          "id": "1354772",
          "text": "Quiero ir a Estados Unidos.",
          "translation": "Я хочу поехать в Соединённые Штаты.",
          "source": "Tatoeba #1354772 @AMIKEMA / #1436828 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1354772",
          "cefr_level": "A1",
          "word_slugs": [
            "estados-noun"
          ]
        },
        {
          "id": "3288810",
          "text": "Él nació en Estados Unidos.",
          "translation": "Он родился в Соединённых Штатах.",
          "source": "Tatoeba #3288810 @marcelostockle / #3289505 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3288810",
          "cefr_level": "A1",
          "word_slugs": [
            "estados-noun"
          ]
        },
        {
          "id": "1354834",
          "text": "Voy a Estados Unidos mañana.",
          "translation": "Завтра я еду в США.",
          "source": "Tatoeba #1354834 @AMIKEMA / #2708689 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1354834",
          "cefr_level": "A1",
          "word_slugs": [
