          "hobby, interest (task or activity that is of interest for someone)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3295482",
          "text": "Es en tu interés.",
          "translation": "Это в твоих интересах.",
          "source": "Tatoeba #3295482 @gianich73 / #3295121 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3295482",
