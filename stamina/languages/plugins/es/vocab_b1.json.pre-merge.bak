      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2087,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of pertenecer:",
          "third-person singular present indicative",
          "inflection of pertenecer:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1963151",
          "text": "Eso me pertenece.",
          "translation": "Это принадлежит мне.",
          "source": "Tatoeba #1963151 @hayastan / #2600310 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1963151",
          "cefr_level": "A1",
          "word_slugs": [
            "pertenece-verb"
          ]
        },
        {
          "id": "9706648",
          "text": "Eso nos pertenece.",
          "translation": "Это принадлежит нам.",
          "source": "Tatoeba #9706648 @Shishir / #3623895 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9706648",
          "cefr_level": "A1",
          "word_slugs": [
            "pertenece-verb"
          ]
        },
        {
          "id": "1624718",
          "text": "Tu alma me pertenece.",
          "translation": "Твоя душа принадлежит мне.",
          "source": "Tatoeba #1624718 @marcelostockle / #2934082 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1624718",
          "cefr_level": "A1",
          "word_slugs": [
            "pertenece-verb"
          ]
        },
        {
          "id": "8807722",
          "text": "Eso no nos pertenece.",
          "translation": "Это нам не принадлежит.",
          "source": "Tatoeba #8807722 @adaycito / #11436369 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8807722",
          "cefr_level": "A1",
          "word_slugs": [
            "pertenece-verb"
          ]
        },
        {
          "id": "1086728",
          "text": "El coche me pertenece.",
          "translation": "Машина моя.",
          "source": "Tatoeba #1086728 @Shishir / #6167771 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1086728",
