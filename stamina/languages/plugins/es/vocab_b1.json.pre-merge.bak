    {
      "slug": "california-name",
      "lemma": "California",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2324,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "California (the most populous state of the United States)",
          "a town in Usulután department, El Salvador"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9792980",
          "text": "Iremos a California.",
          "translation": "Мы поедем в Калифорнию.",
          "source": "Tatoeba #9792980 @DJ_Saidez / #13733613 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9792980",
          "cefr_level": "A1",
          "word_slugs": [
            "california-name"
          ]
        },
        {
          "id": "9767277",
          "text": "Nos vamos a California.",
          "translation": "Мы едем в Калифорнию.",
