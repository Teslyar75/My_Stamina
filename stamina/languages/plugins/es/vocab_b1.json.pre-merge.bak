    {
      "slug": "bote-noun",
      "lemma": "bote",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2120,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "boat, dinghy",
          "vessel, can, canister, container, jar, tin",
          "jackpot, pot, pool (large cash prize)",
          "jail"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3009825",
          "text": "El bote se soltó.",
          "translation": "Лодка отвязалась.",
          "source": "Tatoeba #3009825 @hayastan / #3011408 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3009825",
          "cefr_level": "A1",
          "word_slugs": [
            "bote-noun"
          ]
        },
        {
          "id": "5521907",
          "text": "Tom tiene un bote.",
          "translation": "У Тома есть лодка.",
          "source": "Tatoeba #5521907 @baudelaire / #5530330 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5521907",
          "cefr_level": "A1",
          "word_slugs": [
            "bote-noun"
          ]
        },
        {
          "id": "7415184",
          "text": "Es un tonto del bote.",
          "translation": "Он тупой как бревно.",
          "source": "Tatoeba #7415184 @arh / #7454231 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7415184",
          "cefr_level": "A1",
          "word_slugs": [
            "bote-noun"
          ]
        },
        {
          "id": "1076373",
          "text": "Estamos en el mismo bote.",
          "translation": "Мы с вами в одной лодке.",
          "source": "Tatoeba #1076373 @hayastan / #3770957 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1076373",
          "cefr_level": "A1",
          "word_slugs": [
            "bote-noun"
          ]
        },
        {
          "id": "1386532",
          "text": "Fuimos en bote a la isla.",
          "translation": "Мы поплыли на лодке к острову.",
          "source": "Tatoeba #1386532 @marcelostockle / #3384271 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1386532",
          "cefr_level": "A1",
          "word_slugs": [
            "bote-noun"
          ]
        }
      ],
