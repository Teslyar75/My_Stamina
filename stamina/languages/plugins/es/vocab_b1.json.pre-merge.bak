    {
      "slug": "richard-name",
      "lemma": "Richard",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1506,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "a male given name from English"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5020737",
          "text": "¿Desde cuándo Richard está casado?",
          "translation": "Как давно Ричард женат?",
          "source": "Tatoeba #5020737 @don_ramon / #6458692 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5020737",
          "cefr_level": "A1",
          "word_slugs": [
            "richard-name"
          ]
        },
        {
          "id": "1565061",
          "text": "Confío en Richard; es un hombre de palabra.",
          "translation": "Я доверяю Ричарду. Он человек слова.",
          "source": "Tatoeba #1565061 @Alba / #597006 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1565061",
          "cefr_level": "A1",
          "word_slugs": [
            "richard-name"
          ]
        },
        {
          "id": "1297066",
          "text": "Richard dijo que su madre estaba enferma, lo que es una mentira.",
          "translation": "Ричард сказал, что его мать больна, что есть ложь.",
          "source": "Tatoeba #1297066 @marcelostockle / #4656175 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1297066",
          "cefr_level": "A1",
          "word_slugs": [
            "richard-name"
          ]
        }
      ],
