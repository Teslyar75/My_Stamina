          ]
        },
        {
          "id": "3677090",
          "text": "Tom viajó por Europa.",
          "translation": "Том совершил путешествие по Европе.",
          "source": "Tatoeba #3677090 @Seael / #3999444 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3677090",
          "cefr_level": "A1",
          "word_slugs": [
