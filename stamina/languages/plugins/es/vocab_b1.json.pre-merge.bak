    {
      "slug": "hacerle-verb",
      "lemma": "hacerle",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1302,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of hacer combined with le"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4708519",
          "text": "No quiero hacerle daño.",
          "translation": "Я не хочу ему навредить.",
          "source": "Tatoeba #4708519 @cueyayotl / #5408052 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4708519",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerle-verb"
          ]
        },
        {
          "id": "795577",
          "text": "¿Puedo hacerle una pregunta?",
          "translation": "Можно задать Вам один вопрос?",
          "source": "Tatoeba #795577 @Shishir / #8555799 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/795577",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerle-verb"
          ]
        },
        {
          "id": "1976904",
          "text": "Quisiera hacerle una propuesta.",
          "translation": "Я бы хотел сделать тебе предложение.",
          "source": "Tatoeba #1976904 @marcelostockle / #4019854 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1976904",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerle-verb"
          ]
        },
        {
          "id": "8808230",
          "text": "¿Me permite hacerle de guía?",
          "translation": "Вы позволите мне побыть вашим гидом?",
          "source": "Tatoeba #8808230 @adaycito / #11436347 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8808230",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerle-verb"
          ]
        },
        {
          "id": "2134502",
          "text": "¿Puedo hacerle unas preguntas más?",
          "translation": "Могу я задать тебе ещё несколько вопросов?",
          "source": "Tatoeba #2134502 @Shishir / #7042648 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2134502",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerle-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "hacerle",
