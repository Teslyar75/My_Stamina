      "cefr_level": "B1",
      "frequency_rank": 2086,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "delegate, envoy, emissary"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2675958",
          "text": "Fue enviado a Guantánamo.",
          "translation": "Его отправили в Гуантанамо.",
          "source": "Tatoeba #2675958 @Shishir / #4658464 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2675958",
          "cefr_level": "A1",
          "word_slugs": [
            "enviado-noun"
          ]
        },
        {
          "id": "2008563",
          "text": "Tom me ha enviado un SMS gracioso.",
          "translation": "Том отправил мне смешную эсэмэску.",
          "source": "Tatoeba #2008563 @topofabi / #3652990 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2008563",
          "cefr_level": "A1",
          "word_slugs": [
            "enviado-noun"
          ]
        },
        {
          "id": "1011082",
          "text": "¿Por qué me has enviado esta carta?",
          "translation": "Почему ты отправил мне это письмо?",
          "source": "Tatoeba #1011082 @hayastan / #6055193 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1011082",
          "cefr_level": "A1",
          "word_slugs": [
            "enviado-noun"
          ]
        },
        {
          "id": "10740891",
          "text": "El paquete está listo para ser enviado.",
          "translation": "Посылка готова к отправке.",
          "source": "Tatoeba #10740891 @megamanenm / #10978523 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10740891",
          "cefr_level": "A1",
          "word_slugs": [
            "enviado-noun"
          ]
        },
        {
          "id": "4708361",
          "text": "Fue enviado a la prisión por un crimen que no cometió.",
          "translation": "Его посадили в тюрьму за преступление, которого он не совершал.",
          "source": "Tatoeba #4708361 @DarkHollow / #5295266 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4708361",
          "cefr_level": "A1",
          "word_slugs": [
            "enviado-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
