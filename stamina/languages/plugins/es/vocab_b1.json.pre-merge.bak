    {
      "slug": "charles-noun",
      "lemma": "charles",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1784,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "hi-hat"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4979029",
          "text": "¿Dónde estás, Charles?",
          "translation": "Чарльз, ты где?",
          "source": "Tatoeba #4979029 @Shishir / #4939260 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4979029",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-noun"
          ]
        },
        {
          "id": "1698525",
          "text": "Ella le llamó Charles.",
          "translation": "Она назвала его Чарльзом.",
          "source": "Tatoeba #1698525 @teskmon / #2034999 @everlasting (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1698525",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-noun"
          ]
        },
        {
          "id": "3805682",
          "text": "No volveré a hablar contigo, Charles.",
          "translation": "Я больше не буду с тобой говорить, Чарльз.",
          "source": "Tatoeba #3805682 @Shishir / #5914600 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3805682",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-noun"
          ]
        },
        {
          "id": "3359194",
          "text": "He cambiado mucho, Charles, ¿no lo ves?",
          "translation": "Я сильно изменился, Чарльз, разве не видишь?",
          "source": "Tatoeba #3359194 @Shishir / #3364719 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3359194",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-noun"
          ]
        },
        {
          "id": "1973147",
          "text": "El Príncipe Charles será el siguiente rey de Inglaterra.",
          "translation": "Принц Чарльз станет следующим королём Англии.",
          "source": "Tatoeba #1973147 @marcelostockle / #4712004 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1973147",
          "cefr_level": "A1",
          "word_slugs": [
            "charles-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "charles",
