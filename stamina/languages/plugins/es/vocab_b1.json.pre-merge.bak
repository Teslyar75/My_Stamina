    {
      "slug": "hacerte-verb",
      "lemma": "hacerte",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1203,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of hacer combined with te"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4031625",
          "text": "No puedo hacerte feliz.",
          "translation": "Я не могу сделать тебя счастливой.",
          "source": "Tatoeba #4031625 @hayastan / #4060252 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4031625",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerte-verb"
          ]
        },
        {
          "id": "4952640",
          "text": "Perdón por hacerte esperar.",
          "translation": "Прости, что заставил тебя ждать.",
          "source": "Tatoeba #4952640 @cueyayotl / #2504483 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4952640",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerte-verb"
          ]
        },
        {
          "id": "1011420",
          "text": "¿Puedo hacerte una pregunta?",
          "translation": "Могу я задать тебе вопрос?",
          "source": "Tatoeba #1011420 @Shishir / #2574009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1011420",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerte-verb"
          ]
        },
        {
          "id": "2495475",
          "text": "Deja de hacerte el tonto.",
          "translation": "Перестань валять дурака.",
          "source": "Tatoeba #2495475 @Amastan / #3893633 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2495475",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerte-verb"
          ]
        },
        {
          "id": "2516659",
          "text": "Ya no pueden hacerte daño.",
          "translation": "Они уже не могут причинить тебе вред.",
          "source": "Tatoeba #2516659 @Shishir / #14101761 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2516659",
          "cefr_level": "A1",
          "word_slugs": [
            "hacerte-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "hacerte",
        "plural": "",
        "infinitive": "hacerte"
      }
