    {
      "slug": "demonio-noun",
      "lemma": "demonio",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1820,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "demon, devil"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5069229",
          "text": "Él es un demonio.",
          "translation": "Он демон.",
          "source": "Tatoeba #5069229 @cueyayotl / #5069466 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5069229",
          "cefr_level": "A1",
          "word_slugs": [
            "demonio-noun"
          ]
        },
        {
          "id": "3762248",
          "text": "El demonio está muerto.",
          "translation": "Демон мёртв.",
          "source": "Tatoeba #3762248 @marcelostockle / #6385398 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3762248",
          "cefr_level": "A1",
          "word_slugs": [
            "demonio-noun"
          ]
        },
        {
          "id": "1407289",
          "text": "¡No le temas al demonio!",
          "translation": "Не бойся демона!",
          "source": "Tatoeba #1407289 @marcelostockle / #5202971 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1407289",
          "cefr_level": "A1",
          "word_slugs": [
            "demonio-noun"
          ]
        },
        {
          "id": "1446848",
          "text": "¡Que te lleve el demonio!",
          "translation": "Чёрт тебя побери!",
          "source": "Tatoeba #1446848 @marcelostockle / #4525667 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1446848",
          "cefr_level": "A1",
          "word_slugs": [
            "demonio-noun"
          ]
        },
        {
          "id": "1783408",
          "text": "Él estaba poseído por el demonio.",
          "translation": "Он был одержим дьяволом.",
          "source": "Tatoeba #1783408 @marcelostockle / #5482474 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1783408",
          "cefr_level": "A1",
