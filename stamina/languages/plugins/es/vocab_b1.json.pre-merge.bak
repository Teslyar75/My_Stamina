          ]
        },
        {
          "id": "3843066",
          "text": "Tal vez nieve.",
          "translation": "Может быть, пойдёт снег.",
          "source": "Tatoeba #3843066 @cueyayotl / #2621574 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3843066",
          "cefr_level": "A1",
          "word_slugs": [
            "nieve-verb"
          ]
        },
        {
          "id": "3945929",
          "text": "La nieve paró.",
          "translation": "Снег перестал.",
          "source": "Tatoeba #3945929 @gianich73 / #3945853 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3945929",
          "cefr_level": "A1",
          "word_slugs": [
