    {
      "slug": "tumba-noun",
      "lemma": "tumba",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2237,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "grave, tomb"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "507349",
          "text": "Está cavando su propia tumba.",
          "translation": "Он роет свою собственную могилу.",
          "source": "Tatoeba #507349 @Shishir / #2729300 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/507349",
          "cefr_level": "A1",
          "word_slugs": [
            "tumba-noun"
          ]
        },
        {
          "id": "4432783",
          "text": "Está revolviéndose en su tumba.",
          "translation": "Он в гробу переворачивается.",
          "source": "Tatoeba #4432783 @Shishir / #4433598 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4432783",
          "cefr_level": "A1",
          "word_slugs": [
            "tumba-noun"
          ]
        },
        {
          "id": "2659737",
          "text": "Él estaba mudo como una tumba.",
          "translation": "Он был нем как могила.",
          "source": "Tatoeba #2659737 @marcelostockle / #2661090 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2659737",
          "cefr_level": "A1",
          "word_slugs": [
            "tumba-noun"
          ]
        },
        {
          "id": "1352484",
          "text": "Visitamos la tumba de nuestro padre.",
          "translation": "Мы посетили могилу нашего отца.",
          "source": "Tatoeba #1352484 @hayastan / #3336386 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1352484",
          "cefr_level": "A1",
          "word_slugs": [
            "tumba-noun"
          ]
        },
        {
          "id": "360016",
          "text": "¿Quién estará enterrado en aquella tumba?",
          "translation": "Кто может покоиться в этой могиле?",
          "source": "Tatoeba #360016 @tatoerique / #7038205 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/360016",
          "cefr_level": "A1",
          "word_slugs": [
            "tumba-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
