    {
      "slug": "aceptar-verb",
      "lemma": "aceptar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1720,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "принять",
          "акцептовать"
        ],
        "en": [
          "to accept, to take up, to take up on",
          "to agree",
          "to come to terms with"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2192375",
          "text": "No puedo aceptar tu dinero.",
          "translation": "Я не могу принять твои деньги.",
          "source": "Tatoeba #2192375 @Dejo / #13733148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2192375",
          "cefr_level": "A1",
          "word_slugs": [
            "aceptar-verb"
          ]
        },
        {
          "id": "1347493",
          "text": "No puedo aceptar ese regalo.",
          "translation": "Я не могу принять этот подарок.",
          "source": "Tatoeba #1347493 @Kiraness / #822220 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1347493",
          "cefr_level": "A1",
          "word_slugs": [
            "aceptar-verb"
          ]
        },
        {
          "id": "1408356",
          "text": "Tengo que aceptar su oferta.",
          "translation": "Я должен принять его предложение.",
          "source": "Tatoeba #1408356 @hayastan / #6804554 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1408356",
          "cefr_level": "A1",
          "word_slugs": [
            "aceptar-verb"
          ]
        },
        {
          "id": "536480",
          "text": "No puedo aceptar este regalo.",
          "translation": "Я не могу принять этот подарок.",
          "source": "Tatoeba #536480 @Leono / #822220 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/536480",
          "cefr_level": "A1",
          "word_slugs": [
            "aceptar-verb"
          ]
        },
        {
          "id": "2895402",
          "text": "Tuve que aceptar su propuesta.",
          "translation": "Я был вынужден принять его предложение.",
          "source": "Tatoeba #2895402 @cueyayotl / #1934668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2895402",
          "cefr_level": "A1",
          "word_slugs": [
            "aceptar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
