    {
      "slug": "seguimos-verb",
      "lemma": "seguimos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2238,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person plural present/preterite indicative of seguir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12159852",
          "text": "Seguimos las reglas.",
          "translation": "Мы следуем правилам.",
          "source": "Tatoeba #12159852 @Adelpa / #12160357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12159852",
          "cefr_level": "A1",
          "word_slugs": [
            "seguimos-verb"
          ]
        },
        {
          "id": "454615",
          "text": "Pero seguimos sin él.",
          "translation": "Но мы продолжили без него.",
          "source": "Tatoeba #454615 @Shishir / #788265 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454615",
          "cefr_level": "A1",
          "word_slugs": [
            "seguimos-verb"
          ]
        },
        {
          "id": "2185186",
          "text": "Seguimos una vieja costumbre.",
          "translation": "Мы следуем старому обычаю.",
          "source": "Tatoeba #2185186 @marcelostockle / #9821098 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2185186",
          "cefr_level": "A1",
          "word_slugs": [
            "seguimos-verb"
          ]
        },
        {
          "id": "2185187",
          "text": "Seguimos una vieja tradición.",
          "translation": "Мы следуем старой традиции.",
          "source": "Tatoeba #2185187 @marcelostockle / #3746277 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2185187",
          "cefr_level": "A1",
          "word_slugs": [
            "seguimos-verb"
          ]
        },
        {
          "id": "5716536",
          "text": "Seguimos manteniendo nuestra postura.",
          "translation": "Мы по-прежнему придерживаемся своей позиции.",
          "source": "Tatoeba #5716536 @arh / #9821100 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5716536",
          "cefr_level": "A1",
          "word_slugs": [
            "seguimos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "seguimos",
        "plural": "",
        "infinitive": "seguimos"
      }
