    {
      "slug": "dedo-noun",
      "lemma": "dedo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1889,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "digit: finger or toe, literally translated as \"finger\" and thought of that way by Spanish-speaking learners of English",
          "thimble (a small device to protect a thumb or finger during sewing)",
          "finger (the width of a finger as an approximate unit of length)",
          "dedo (a traditional Spanish unit of measurement about equal to 1.75 cm)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1836351",
          "text": "Fue mi dedo.",
          "translation": "Это был мой палец.",
          "source": "Tatoeba #1836351 @alexmarcelo / #4894331 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1836351",
          "cefr_level": "A1",
          "word_slugs": [
            "dedo-noun"
          ]
        },
        {
          "id": "816996",
          "text": "No te cortes el dedo.",
          "translation": "Не порежь себе палец.",
          "source": "Tatoeba #816996 @ltsiros / #1109731 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/816996",
          "cefr_level": "A1",
          "word_slugs": [
            "dedo-noun"
          ]
        },
        {
          "id": "9466117",
          "text": "Fue un error de dedo.",
          "translation": "Это была опечатка.",
          "source": "Tatoeba #9466117 @dpcossio / #9466118 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9466117",
          "cefr_level": "A1",
          "word_slugs": [
            "dedo-noun"
          ]
        },
        {
          "id": "1036071",
          "text": "Acabo de cortarme un dedo.",
          "translation": "Я только что порезал себе палец.",
          "source": "Tatoeba #1036071 @hayastan / #3841045 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1036071",
          "cefr_level": "A1",
          "word_slugs": [
            "dedo-noun"
          ]
        },
        {
          "id": "1445196",
          "text": "Me quemé la yema del dedo.",
          "translation": "Я обожгла кончик пальца.",
          "source": "Tatoeba #1445196 @marcelostockle / #13007892 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1445196",
          "cefr_level": "A1",
          "word_slugs": [
            "dedo-noun"
          ]
        }
      ],
