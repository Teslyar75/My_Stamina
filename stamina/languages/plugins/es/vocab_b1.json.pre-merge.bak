      "frequency_rank": 1660,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "female equivalent of extraño",
          "China aster; annual aster"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1275474",
          "text": "Ella lo extraña.",
          "translation": "Она скучает по нему.",
          "source": "Tatoeba #1275474 @hayastan / #1997139 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1275474",
          "cefr_level": "A1",
