    {
      "slug": "primeros-adj",
      "lemma": "primeros",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1993,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "masculine plural of primero"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13414670",
          "text": "Sois los primeros.",
          "translation": "Вы первые.",
          "source": "Tatoeba #13414670 @frpzzd / #8545958 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13414670",
          "cefr_level": "A1",
          "word_slugs": [
            "primeros-adj"
          ]
        },
        {
          "id": "1553055",
          "text": "Los primeros serán los últimos.",
          "translation": "Первые будут последними.",
          "source": "Tatoeba #1553055 @marcelostockle / #1554024 @BarinovDenis (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1553055",
          "cefr_level": "A1",
          "word_slugs": [
            "primeros-adj"
          ]
        },
        {
          "id": "12162623",
          "text": "Los últimos serán los primeros.",
          "translation": "Последние станут первыми.",
          "source": "Tatoeba #12162623 @Adelpa / #6210238 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12162623",
          "cefr_level": "A1",
          "word_slugs": [
            "primeros-adj"
          ]
        },
        {
          "id": "1711355",
          "text": "No todos pueden ser los primeros.",
          "translation": "Не все могут быть первыми.",
          "source": "Tatoeba #1711355 @marcelostockle / #5989919 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1711355",
          "cefr_level": "A1",
          "word_slugs": [
            "primeros-adj"
          ]
        },
        {
          "id": "3343727",
          "text": "Leí solamente los tres primeros capítulos.",
          "translation": "Я прочёл только первые три главы.",
