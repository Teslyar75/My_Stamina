    {
      "slug": "llegaron-verb",
      "lemma": "llegaron",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2401,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural preterite indicative of llegar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2268767",
          "text": "Llegaron al ocaso.",
          "translation": "Они прибыли на закате.",
          "source": "Tatoeba #2268767 @Shishir / #3227730 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2268767",
          "cefr_level": "A1",
          "word_slugs": [
            "llegaron-verb"
          ]
        },
        {
          "id": "1496980",
          "text": "¿Cómo llegaron ahí?",
          "translation": "Как вы туда попали?",
          "source": "Tatoeba #1496980 @marcelostockle / #4594891 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1496980",
          "cefr_level": "A1",
          "word_slugs": [
            "llegaron-verb"
          ]
        },
        {
          "id": "1657193",
          "text": "¿Ya llegaron todos?",
          "translation": "Уже все прибыли?",
          "source": "Tatoeba #1657193 @marcelostockle / #3894709 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1657193",
          "cefr_level": "A1",
          "word_slugs": [
            "llegaron-verb"
          ]
        },
        {
          "id": "2469333",
          "text": "¿Ya llegaron ellas?",
          "translation": "Они уже приехали?",
          "source": "Tatoeba #2469333 @marcelostockle / #2238014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2469333",
          "cefr_level": "A1",
          "word_slugs": [
            "llegaron-verb"
          ]
        },
        {
          "id": "9045484",
          "text": "Ellos llegaron ayer.",
          "translation": "Они вчера приехали.",
          "source": "Tatoeba #9045484 @carlosalberto / #9045495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9045484",
          "cefr_level": "A1",
          "word_slugs": [
            "llegaron-verb"
          ]
        }
      ],
