        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1683482",
          "text": "¿Cómo se llamaba el niño?",
          "translation": "Как звали мальчика?",
          "source": "Tatoeba #1683482 @marcelostockle / #2827135 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1683482",
          "cefr_level": "A1",
          "word_slugs": [
            "llamaba-verb"
          ]
        },
        {
          "id": "2036030",
          "text": "Su hijo se llamaba Eduardo.",
          "translation": "Его сына звали Эдуардо.",
          "source": "Tatoeba #2036030 @marcelostockle / #5295610 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2036030",
          "cefr_level": "A1",
          "word_slugs": [
            "llamaba-verb"
          ]
        },
        {
          "id": "3328263",
          "text": "Me preguntó cómo me llamaba.",
          "translation": "Он спросил, как меня зовут.",
          "source": "Tatoeba #3328263 @Shishir / #380028 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3328263",
          "cefr_level": "A1",
          "word_slugs": [
            "llamaba-verb"
          ]
        },
        {
          "id": "1143166",
          "text": "Me dijo que se llamaba Tom.",
          "translation": "Он сказал мне, что его зовут Том.",
          "source": "Tatoeba #1143166 @Shishir / #3251913 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1143166",
          "cefr_level": "A1",
          "word_slugs": [
            "llamaba-verb"
          ]
        },
        {
          "id": "1425664",
          "text": "Ella lo llamaba día por medio.",
          "translation": "Она звонила ему через день.",
          "source": "Tatoeba #1425664 @marcelostockle / #3286458 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1425664",
          "cefr_level": "A1",
          "word_slugs": [
            "llamaba-verb"
          ]
        }
      ],
