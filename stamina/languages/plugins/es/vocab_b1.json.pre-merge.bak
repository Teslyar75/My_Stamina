    {
      "slug": "asuntos-noun",
      "lemma": "asuntos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1474,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of asunto"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3026165",
          "text": "Charlamos sobre diferentes asuntos.",
          "translation": "Мы поболтали о разных вещах.",
          "source": "Tatoeba #3026165 @hayastan / #3026751 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3026165",
          "cefr_level": "A1",
          "word_slugs": [
            "asuntos-noun"
          ]
        },
        {
          "id": "574355",
          "text": "Son asuntos que necesitamos discutir.",
          "translation": "Это вопросы, которые нам нужно обсудить.",
          "source": "Tatoeba #574355 @darinmex / #10971159 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/574355",
          "cefr_level": "A1",
          "word_slugs": [
            "asuntos-noun"
          ]
        },
        {
          "id": "1132795",
          "text": "¡No te metas en mis asuntos!",
          "translation": "Не лезь в мои дела!",
          "source": "Tatoeba #1132795 @Shishir / #4550846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1132795",
          "cefr_level": "A1",
          "word_slugs": [
            "asuntos-noun"
          ]
        },
        {
          "id": "1366096",
          "text": "No me gusta dejar asuntos pendientes.",
          "translation": "Я не люблю оставлять дела незаконченными.",
          "source": "Tatoeba #1366096 @AMIKEMA / #1479067 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1366096",
          "cefr_level": "A1",
          "word_slugs": [
            "asuntos-noun"
          ]
        },
        {
          "id": "1854899",
          "text": "No te metas en mis asuntos personales.",
          "translation": "Не суй свой нос в мои личные дела.",
          "source": "Tatoeba #1854899 @marcelostockle / #6087909 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1854899",
          "cefr_level": "A1",
          "word_slugs": [
            "asuntos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "asuntos",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "fe-noun",
      "lemma": "fe",
      "pos": "noun",
