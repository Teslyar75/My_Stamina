    {
      "slug": "dejarlo-verb",
      "lemma": "dejarlo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1674,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of dejar combined with lo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "656229",
          "text": "¿Quieres dejarlo así?",
          "translation": "Ты хочешь это так оставить?",
          "source": "Tatoeba #656229 @Shishir / #2383727 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/656229",
          "cefr_level": "A1",
          "word_slugs": [
            "dejarlo-verb"
          ]
        },
        {
          "id": "574406",
          "text": "Lyusya decidió dejarlo todo e irse a Siberia.",
          "translation": "Люся решила бросить все и уехать в Сибирь.",
          "source": "Tatoeba #574406 @Shishir / #573734 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/574406",
          "cefr_level": "A1",
          "word_slugs": [
            "dejarlo-verb"
          ]
        },
        {
          "id": "1434012",
          "text": "Tom no sabía que Mary había decidido dejarlo.",
          "translation": "Том не знал, что Мэри решила его бросить.",
          "source": "Tatoeba #1434012 @marcelostockle / #4080775 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1434012",
          "cefr_level": "A1",
          "word_slugs": [
            "dejarlo-verb"
          ]
        },
        {
          "id": "13781800",
          "text": "Abrí el libro, comencé a leer y no pude dejarlo.",
          "translation": "Я открыл книгу, начал читать и не смог оторваться.",
          "source": "Tatoeba #13781800 @carlosalberto / #13781463 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13781800",
          "cefr_level": "A1",
          "word_slugs": [
            "dejarlo-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "dejarlo",
