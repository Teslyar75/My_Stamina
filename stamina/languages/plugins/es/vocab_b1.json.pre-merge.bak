          ]
        },
        {
          "id": "1519547",
          "text": "Valoramos a nuestros clientes.",
          "translation": "Мы ценим наших клиентов.",
          "source": "Tatoeba #1519547 @marcelostockle / #3938216 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1519547",
          "cefr_level": "A1",
          "word_slugs": [
