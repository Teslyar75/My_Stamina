          "id": "3860531",
          "text": "¡Crean en la ciencia!",
          "translation": "Верьте в науку!",
          "source": "Tatoeba #3860531 @gianich73 / #3860351 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3860531",
          "cefr_level": "A1",
          "word_slugs": [
            "ciencia-proverb"
          ]
        },
        {
          "id": "7745871",
          "text": "Me interesa la ciencia.",
          "translation": "Мне интересна наука.",
          "source": "Tatoeba #7745871 @arh / #7752937 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7745871",
          "cefr_level": "A1",
          "word_slugs": [
            "ciencia-proverb"
          ]
        },
        {
          "id": "1701496",
          "text": "La ciencia progresó mucho.",
          "translation": "Наука сильно продвинулась вперёд.",
          "source": "Tatoeba #1701496 @hayastan / #4513332 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1701496",
          "cefr_level": "A1",
          "word_slugs": [
            "ciencia-proverb"
          ]
        },
        {
          "id": "1958807",
          "text": "La ciencia es su religión.",
          "translation": "Наука - его религия.",
          "source": "Tatoeba #1958807 @wallebot / #12257976 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1958807",
          "cefr_level": "A1",
          "word_slugs": [
            "ciencia-proverb"
          ]
        },
        {
          "id": "3625274",
          "text": "Sin ciencia no hay futuro.",
          "translation": "Без науки нет будущего.",
          "source": "Tatoeba #3625274 @cueyayotl / #3634145 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3625274",
          "cefr_level": "A1",
          "word_slugs": [
            "ciencia-proverb"
          ]
        }
      ],
