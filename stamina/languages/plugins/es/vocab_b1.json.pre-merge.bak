    {
      "slug": "hablaba-verb",
      "lemma": "hablaba",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2239,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first/third-person singular imperfect indicative of hablar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1287750",
          "text": "Hablaba de ti.",
          "translation": "Он говорил о тебе.",
          "source": "Tatoeba #1287750 @Shishir / #7435402 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1287750",
          "cefr_level": "A1",
          "word_slugs": [
            "hablaba-verb"
          ]
        },
        {
          "id": "789614",
          "text": "Hablaba muy alto.",
          "translation": "Он говорил очень громко.",
          "source": "Tatoeba #789614 @chinopinyin / #417088 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/789614",
          "cefr_level": "A1",
          "word_slugs": [
            "hablaba-verb"
          ]
        },
        {
          "id": "11067630",
          "text": "Rara vez hablaba.",
          "translation": "Она редко говорила.",
          "source": "Tatoeba #11067630 @carlosalberto / #11591474 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11067630",
          "cefr_level": "A1",
          "word_slugs": [
            "hablaba-verb"
          ]
        },
        {
          "id": "5083715",
          "text": "¿Con quién hablaba?",
          "translation": "С кем Вы разговаривали?",
          "source": "Tatoeba #5083715 @cueyayotl / #13190905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5083715",
          "cefr_level": "A1",
          "word_slugs": [
            "hablaba-verb"
          ]
        },
        {
          "id": "2210021",
          "text": "Hablaba bien japonés.",
          "translation": "Она хорошо говорила по-японски.",
          "source": "Tatoeba #2210021 @Shishir / #1207754 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2210021",
          "cefr_level": "A1",
          "word_slugs": [
            "hablaba-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
