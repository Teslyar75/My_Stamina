      "gender": null,
      "examples": [
        {
          "id": "687387",
          "text": "¿Qué marca de coche es?",
          "translation": "Какая это марка машины?",
          "source": "Tatoeba #687387 @lukaszpp / #1486966 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/687387",
          "cefr_level": "A1",
