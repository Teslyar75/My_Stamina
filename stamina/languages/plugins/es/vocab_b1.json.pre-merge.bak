    {
      "slug": "evitar-verb",
      "lemma": "evitar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1319,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to avoid, to bypass, to evade, to circumvent, to dodge, to shun, to eschew (to steer clear of)",
          "to avoid, to prevent, to keep from, to stop from, to avert, to obviate, to deter",
          "to help (abstain from doing) (always in the negative)",
          "to spare, to save (to relieve someone having to experience something)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "640845",
          "text": "No pude evitar reírme.",
          "translation": "Я не мог не смеяться.",
          "source": "Tatoeba #640845 @clerval / #1479654 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/640845",
          "cefr_level": "A1",
          "word_slugs": [
            "evitar-verb"
          ]
        },
        {
          "id": "2158911",
          "text": "Quiero evitar riesgos innecesarios.",
          "translation": "Я хочу избежать ненужных рисков.",
          "source": "Tatoeba #2158911 @hayastan / #5359768 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2158911",
          "cefr_level": "A1",
          "word_slugs": [
            "evitar-verb"
          ]
        },
        {
          "id": "5217084",
          "text": "Creo que podemos evitar eso.",
          "translation": "Думаю, мы можем этого избежать.",
          "source": "Tatoeba #5217084 @Elyte / #5216782 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5217084",
          "cefr_level": "A1",
          "word_slugs": [
            "evitar-verb"
          ]
        },
        {
          "id": "1317381",
          "text": "No pude evitar quedarme dormido.",
          "translation": "Я не смог пересилить сон.",
          "source": "Tatoeba #1317381 @Shishir / #5332242 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1317381",
          "cefr_level": "A1",
          "word_slugs": [
            "evitar-verb"
          ]
        },
        {
          "id": "704313",
          "text": "No puedo evitar burlarme de él.",
          "translation": "Я не могу над ним не смеяться.",
          "source": "Tatoeba #704313 @Shishir / #6727054 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/704313",
          "cefr_level": "A1",
          "word_slugs": [
            "evitar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el evitar",
        "plural": "",
        "infinitive": "evitar"
      }
    },
    {
      "slug": "máquina-noun",
      "lemma": "máquina",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1320,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "A person who is outstanding or very good at something."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5129993",
          "text": "¡Qué máquina maravillosa!",
          "translation": "Какая чудесная машина!",
          "source": "Tatoeba #5129993 @don_ramon / #5130001 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5129993",
          "cefr_level": "A1",
          "word_slugs": [
            "máquina-noun"
          ]
        },
        {
          "id": "3430524",
          "text": "¿Sabes usar esta máquina?",
          "translation": "Ты знаешь, как пользоваться этой машиной?",
          "source": "Tatoeba #3430524 @gianich73 / #471919 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3430524",
          "cefr_level": "A1",
          "word_slugs": [
            "máquina-noun"
          ]
        },
        {
          "id": "3393572",
          "text": "¡No trabajes como máquina!",
          "translation": "Не работай как машина!",
          "source": "Tatoeba #3393572 @marcelostockle / #3401080 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3393572",
          "cefr_level": "A1",
          "word_slugs": [
            "máquina-noun"
          ]
        },
        {
          "id": "7592653",
          "text": "La máquina la maneja Mary.",
          "translation": "Машину ведёт Мэри.",
          "source": "Tatoeba #7592653 @gianich73 / #7591853 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7592653",
          "cefr_level": "A1",
          "word_slugs": [
            "máquina-noun"
          ]
        },
        {
          "id": "7592651",
          "text": "La máquina la conduce ella.",
          "translation": "Машину ведёт она.",
          "source": "Tatoeba #7592651 @gianich73 / #7591850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7592651",
          "cefr_level": "A1",
          "word_slugs": [
