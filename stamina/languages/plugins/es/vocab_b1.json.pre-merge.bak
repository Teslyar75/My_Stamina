    {
      "slug": "contado-adj",
      "lemma": "contado",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2148,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "counted",
          "few"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "7145019",
          "text": "Los he contado todos.",
          "translation": "Я их все посчитал.",
          "source": "Tatoeba #7145019 @arh / #13404594 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7145019",
          "cefr_level": "A1",
          "word_slugs": [
            "contado-adj"
          ]
        },
        {
          "id": "7145020",
          "text": "Los hemos contado todos.",
          "translation": "Мы их всех посчитали.",
          "source": "Tatoeba #7145020 @arh / #9712994 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7145020",
          "cefr_level": "A1",
          "word_slugs": [
            "contado-adj"
          ]
        },
        {
          "id": "4927124",
          "text": "No nos habéis contado nada.",
          "translation": "Вы ничего нам не рассказали.",
          "source": "Tatoeba #4927124 @Shishir / #4924989 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4927124",
          "cefr_level": "A1",
          "word_slugs": [
            "contado-adj"
          ]
        },
        {
          "id": "2132064",
          "text": "No debería haberte contado nada.",
          "translation": "Мне не надо было ничего тебе рассказывать.",
          "source": "Tatoeba #2132064 @Shishir / #6167953 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2132064",
          "cefr_level": "A1",
          "word_slugs": [
            "contado-adj"
          ]
        },
        {
          "id": "2391530",
          "text": "Debería habértelo contado todo antes.",
          "translation": "Надо было мне тебе всё раньше рассказать.",
          "source": "Tatoeba #2391530 @Shishir / #8018112 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2391530",
          "cefr_level": "A1",
          "word_slugs": [
            "contado-adj"
          ]
        }
      ],
