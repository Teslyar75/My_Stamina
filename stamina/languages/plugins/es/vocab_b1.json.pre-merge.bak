    {
      "slug": "nota-noun",
      "lemma": "nota",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1304,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "note, memo",
          "note",
          "mark, academic score"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2392836",
          "text": "Me dejó una nota.",
          "translation": "Она оставила мне записку.",
          "source": "Tatoeba #2392836 @Shishir / #5207578 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2392836",
          "cefr_level": "A1",
          "word_slugs": [
            "nota-noun"
          ]
        },
        {
          "id": "5781876",
          "text": "Debí dejarle una nota.",
          "translation": "Мне надо было оставить ему записку.",
          "source": "Tatoeba #5781876 @MrMultilingual / #5782879 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5781876",
          "cefr_level": "A1",
          "word_slugs": [
            "nota-noun"
          ]
        },
        {
          "id": "2702669",
          "text": "Os he dejado una nota.",
          "translation": "Я оставил вам записку.",
          "source": "Tatoeba #2702669 @Shishir / #5692158 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2702669",
          "cefr_level": "A1",
          "word_slugs": [
            "nota-noun"
          ]
        },
        {
          "id": "6147076",
          "text": "Me he sacado una mala nota.",
          "translation": "Я получил плохую оценку.",
          "source": "Tatoeba #6147076 @Shishir / #6149319 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6147076",
          "cefr_level": "A1",
          "word_slugs": [
            "nota-noun"
          ]
        },
        {
          "id": "2099794",
          "text": "Tuve una buena nota en inglés.",
          "translation": "Я получил хорошую оценку по английскому.",
          "source": "Tatoeba #2099794 @marcelostockle / #5129591 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2099794",
          "cefr_level": "A1",
          "word_slugs": [
            "nota-noun"
          ]
        }
      ],
