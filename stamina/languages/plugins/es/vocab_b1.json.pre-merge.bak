    {
      "slug": "refiero-verb",
      "lemma": "refiero",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1371,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular present indicative of referir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3562833",
          "text": "A eso me refiero.",
          "translation": "Это я и имею в виду.",
          "source": "Tatoeba #3562833 @ficion / #3566324 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3562833",
          "cefr_level": "A1",
          "word_slugs": [
            "refiero-verb"
          ]
        },
        {
          "id": "1715880",
          "text": "Creo que sabes a qué me refiero.",
          "translation": "Думаю, ты знаешь, что я имею в виду.",
          "source": "Tatoeba #1715880 @marcelostockle / #2746585 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1715880",
          "cefr_level": "A1",
          "word_slugs": [
            "refiero-verb"
          ]
        },
        {
          "id": "2086550",
          "text": "Sabes muy bien a quién me refiero.",
          "translation": "Ты прекрасно знаешь, кого я имею в виду.",
          "source": "Tatoeba #2086550 @marcelostockle / #2711230 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2086550",
          "cefr_level": "A1",
          "word_slugs": [
            "refiero-verb"
          ]
        },
        {
          "id": "2812553",
          "text": "Me refiero a los estudiantes en general, no a uno en particular.",
          "translation": "Я имею в виду студентов в общем, а не кого-то конкретного.",
          "source": "Tatoeba #2812553 @marcelostockle / #6103898 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2812553",
          "cefr_level": "A1",
          "word_slugs": [
            "refiero-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
