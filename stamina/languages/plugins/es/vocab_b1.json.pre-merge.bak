          ]
        },
        {
          "id": "620206",
          "text": "Me encanta el pollo.",
          "translation": "Я люблю курицу.",
          "source": "Tatoeba #620206 @Shishir / #1391999 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/620206",
          "cefr_level": "A1",
          "word_slugs": [
