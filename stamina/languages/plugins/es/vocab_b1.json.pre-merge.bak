      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "gerund of pedir"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7872755",
          "text": "Grité pidiendo ayuda.",
          "translation": "Я криком позвал на помощь.",
          "source": "Tatoeba #7872755 @arh / #7873856 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7872755",
          "cefr_level": "A1",
          "word_slugs": [
            "pidiendo-verb"
          ]
        },
        {
          "id": "7872756",
          "text": "Grité pidiendo socorro.",
          "translation": "Я криком позвал на помощь.",
          "source": "Tatoeba #7872756 @arh / #7873856 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7872756",
          "cefr_level": "A1",
          "word_slugs": [
            "pidiendo-verb"
          ]
        },
        {
          "id": "5130657",
          "text": "Me sigue pidiendo dinero.",
          "translation": "Он продолжает просить у меня деньги.",
          "source": "Tatoeba #5130657 @don_ramon / #5546951 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5130657",
          "cefr_level": "A1",
          "word_slugs": [
            "pidiendo-verb"
          ]
        },
        {
          "id": "1544039",
          "text": "Está pidiendo lo imposible.",
          "translation": "Она просит невозможного.",
          "source": "Tatoeba #1544039 @alexmarcelo / #10360042 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1544039",
          "cefr_level": "A1",
          "word_slugs": [
            "pidiendo-verb"
          ]
        },
        {
          "id": "5567240",
          "text": "Tom terminó pidiendo perdón.",
          "translation": "Том в конце концов попросил прощения.",
          "source": "Tatoeba #5567240 @swyter / #7040347 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5567240",
          "cefr_level": "A1",
          "word_slugs": [
            "pidiendo-verb"
          ]
        }
      ],
      "tags": [
