          ]
        },
        {
          "id": "1784971",
          "text": "Allí antes no había libertad de prensa.",
          "translation": "Раньше там не было свободы печати.",
          "source": "Tatoeba #1784971 @Shishir / #2468566 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1784971",
