    {
      "slug": "ruido-noun",
      "lemma": "ruido",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1527,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "noise, racket, rattle, clatter, sound (various sounds, usually unwanted)",
          "noise (unwanted part of a signal)",
          "uproar, talk, fuss"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6168508",
          "text": "No hagan ruido.",
          "translation": "Не шумите.",
          "source": "Tatoeba #6168508 @cueyayotl / #478941 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6168508",
          "cefr_level": "A1",
          "word_slugs": [
            "ruido-noun"
          ]
        },
        {
          "id": "7814027",
          "text": "¡Deja el ruido!",
          "translation": "Уймись!",
          "source": "Tatoeba #7814027 @User83002 / #573489 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7814027",
          "cefr_level": "A1",
          "word_slugs": [
            "ruido-noun"
          ]
        },
        {
          "id": "7860017",
          "text": "Odio ese ruido.",
          "translation": "Терпеть не могу этот шум.",
          "source": "Tatoeba #7860017 @Seael / #7860794 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7860017",
          "cefr_level": "A1",
          "word_slugs": [
            "ruido-noun"
          ]
        },
        {
          "id": "854654",
          "text": "¡No hagas ruido!",
          "translation": "Не шуми!",
          "source": "Tatoeba #854654 @P_Scipio / #4662514 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/854654",
          "cefr_level": "A1",
          "word_slugs": [
            "ruido-noun"
          ]
        },
        {
          "id": "2462741",
          "text": "Escuché un ruido.",
          "translation": "Я слышал шум.",
          "source": "Tatoeba #2462741 @hayastan / #2799285 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2462741",
          "cefr_level": "A1",
          "word_slugs": [
            "ruido-noun"
          ]
        }
      ],
