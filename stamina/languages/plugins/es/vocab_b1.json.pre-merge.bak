    {
      "slug": "compañeros-noun",
      "lemma": "compañeros",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1807,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of compañero"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "751940",
          "text": "Son mis compañeros de clase.",
          "translation": "Они мои одноклассники.",
          "source": "Tatoeba #751940 @Shishir / #1835012 @Tavat (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/751940",
          "cefr_level": "A1",
          "word_slugs": [
            "compañeros-noun"
          ]
        },
        {
          "id": "1276100",
          "text": "No hables mal de tus compañeros.",
          "translation": "Не говори плохо о твоих одноклассниках.",
          "source": "Tatoeba #1276100 @Coilet / #3126735 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1276100",
          "cefr_level": "A1",
          "word_slugs": [
            "compañeros-noun"
          ]
        },
        {
          "id": "2438283",
          "text": "Se lleva bien con todos sus compañeros.",
          "translation": "Он в хороших отношениях со всеми одноклассниками.",
          "source": "Tatoeba #2438283 @fgreco / #995291 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2438283",
          "cefr_level": "A1",
          "word_slugs": [
            "compañeros-noun"
          ]
        },
        {
          "id": "1004101",
          "text": "¿Hablaste ayer con tus compañeros de clase?",
          "translation": "Ты говорил вчера со своими одноклассниками?",
          "source": "Tatoeba #1004101 @hundo / #4447086 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1004101",
          "cefr_level": "A1",
          "word_slugs": [
            "compañeros-noun"
          ]
        },
        {
          "id": "842029",
          "text": "Intenté hacerme amigo de los compañeros de clase.",
          "translation": "Я пытался подружиться с одноклассниками.",
          "source": "Tatoeba #842029 @LugoIlmer / #4000340 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/842029",
          "cefr_level": "A1",
          "word_slugs": [
            "compañeros-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "compañeros",
        "plural": "",
        "infinitive": ""
      }
