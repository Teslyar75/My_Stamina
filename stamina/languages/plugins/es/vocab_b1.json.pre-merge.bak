    {
      "slug": "crea-verb",
      "lemma": "crea",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2450,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of crear:",
          "third-person singular present indicative",
          "inflection of crear:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3352798",
          "text": "Dios crea el mundo.",
          "translation": "Бог создаёт мир.",
          "source": "Tatoeba #3352798 @marcelostockle / #6167552 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3352798",
          "cefr_level": "A1",
          "word_slugs": [
            "crea-verb"
          ]
        },
        {
          "id": "1684358",
          "text": "La oferta crea la demanda.",
          "translation": "Предложение рождает спрос.",
          "source": "Tatoeba #1684358 @marcelostockle / #2383010 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684358",
          "cefr_level": "A1",
          "word_slugs": [
            "crea-verb"
          ]
        },
        {
          "id": "8005227",
          "text": "La demanda crea la oferta.",
          "translation": "Спрос рождает предложение.",
          "source": "Tatoeba #8005227 @Seael / #2343479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8005227",
          "cefr_level": "A1",
          "word_slugs": [
            "crea-verb"
          ]
        },
        {
          "id": "979487",
          "text": "Un buen ejemplo crea escuela.",
          "translation": "Хороший пример порождает школу.",
          "source": "Tatoeba #979487 @hundo / #5105772 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/979487",
          "cefr_level": "A1",
          "word_slugs": [
            "crea-verb"
          ]
        },
        {
          "id": "3033201",
          "text": "No estoy seguro de que te crea.",
          "translation": "Не уверен, что верю тебе.",
          "source": "Tatoeba #3033201 @marcelostockle / #2809903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3033201",
          "cefr_level": "A1",
          "word_slugs": [
