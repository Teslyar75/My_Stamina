          ]
        },
        {
          "id": "2232617",
          "text": "¿Qué películas están dando ahora?",
          "translation": "Какие фильмы сейчас показывают?",
          "source": "Tatoeba #2232617 @marcelostockle / #5314251 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2232617",
