          "source": "Tatoeba #1596580 @teskmon / #2659273 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1596580",
          "cefr_level": "A1",
          "word_slugs": [
            "serás-verb"
          ]
        },
        {
          "id": "2674710",
          "text": "¿Serás idiota o qué?",
          "translation": "Ты что, идиот?",
          "source": "Tatoeba #2674710 @cueyayotl / #2674711 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2674710",
          "cefr_level": "A1",
