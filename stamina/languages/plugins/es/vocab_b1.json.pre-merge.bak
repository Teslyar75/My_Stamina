    {
      "slug": "aquella-det",
      "lemma": "aquella",
      "pos": "det",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1662,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "feminine singular of aquel"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1516536",
          "text": "Mira aquella casa.",
          "translation": "Взгляни на тот дом.",
          "source": "Tatoeba #1516536 @Cainntear / #5256064 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1516536",
          "cefr_level": "A1",
          "word_slugs": [
            "aquella-det"
          ]
        },
        {
          "id": "3666634",
          "text": "Cerraron aquella escuela.",
          "translation": "Ту школу закрыли.",
          "source": "Tatoeba #3666634 @Seael / #6087937 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3666634",
