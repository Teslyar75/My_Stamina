      },
      "gender": null,
      "examples": [
        {
          "id": "1888716",
          "text": "Encontré un tesoro.",
          "translation": "Я нашёл сокровище.",
          "source": "Tatoeba #1888716 @marcelostockle / #5364677 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1888716",
          "cefr_level": "A1",
          "word_slugs": [
            "tesoro-noun"
          ]
        },
        {
          "id": "5633213",
          "text": "Tom encontró un tesoro.",
