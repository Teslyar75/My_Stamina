        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4372271",
          "text": "Bájese los pantalones.",
          "translation": "Спускайте штаны.",
          "source": "Tatoeba #4372271 @umano / #5435149 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4372271",
          "cefr_level": "A1",
          "word_slugs": [
