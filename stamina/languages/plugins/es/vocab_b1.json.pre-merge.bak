    {
      "slug": "chicago-name",
      "lemma": "Chicago",
      "pos": "name",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2350,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "Chicago (a large city, the county seat of Cook County, in northeastern Illinois, United States, located on Lake Michigan)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "605987",
          "text": "Carol vive en Chicago.",
          "translation": "Кэрол живет в Чикаго.",
          "source": "Tatoeba #605987 @Shishir / #895505 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/605987",
          "cefr_level": "A1",
          "word_slugs": [
            "chicago-name"
          ]
        },
        {
          "id": "4884016",
          "text": "Necesito ir a Chicago.",
          "translation": "Мне надо в Чикаго.",
          "source": "Tatoeba #4884016 @zvzuibqx / #4884022 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4884016",
          "cefr_level": "A1",
          "word_slugs": [
            "chicago-name"
          ]
        },
        {
          "id": "346570",
          "text": "La semana próxima voy a Chicago.",
          "translation": "На следующей неделе я еду в Чикаго.",
          "source": "Tatoeba #346570 @tatoerique / #8138431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/346570",
          "cefr_level": "A1",
          "word_slugs": [
            "chicago-name"
          ]
        },
        {
          "id": "3805340",
          "text": "Llovía en los alrededores de Chicago.",
          "translation": "В окрестностях Чикаго шёл дождь.",
          "source": "Tatoeba #3805340 @cueyayotl / #7108780 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3805340",
