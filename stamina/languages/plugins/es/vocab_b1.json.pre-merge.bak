    {
      "slug": "puntos-noun",
      "lemma": "puntos",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1717,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of punto"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3302484",
          "text": "¿Cuáles son tus puntos fuertes?",
          "translation": "В чём Ваши сильные стороны?",
          "source": "Tatoeba #3302484 @gianich73 / #2171852 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3302484",
          "cefr_level": "A1",
          "word_slugs": [
            "puntos-noun"
          ]
        },
        {
          "id": "981692",
          "text": "Así no vas a ganar puntos conmigo.",
          "translation": "Так ты не добьёшься моего расположения.",
          "source": "Tatoeba #981692 @Shishir / #5665725 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/981692",
          "cefr_level": "A1",
          "word_slugs": [
            "puntos-noun"
          ]
        },
        {
          "id": "2623640",
          "text": "¿Qué significan esos puntos en el mapa?",
          "translation": "Что означают эти точки на карте?",
          "source": "Tatoeba #2623640 @nancy / #3988248 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2623640",
          "cefr_level": "A1",
          "word_slugs": [
            "puntos-noun"
          ]
        },
        {
          "id": "1988531",
          "text": "Nuestro equipo tiene dos puntos de ventaja.",
          "translation": "Наша команда на два очка впереди.",
          "source": "Tatoeba #1988531 @marilia / #7954657 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1988531",
          "cefr_level": "A1",
          "word_slugs": [
            "puntos-noun"
          ]
        },
        {
          "id": "2259816",
          "text": "Hemos pasado por alto muchos puntos importantes.",
          "translation": "Мы упустили из виду многие важные моменты.",
          "source": "Tatoeba #2259816 @cueyayotl / #9735156 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259816",
          "cefr_level": "A1",
          "word_slugs": [
            "puntos-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
