          ]
        },
        {
          "id": "6633350",
          "text": "Ella es una bruja loca.",
          "translation": "Она сумасшедшая ведьма.",
          "source": "Tatoeba #6633350 @Joffrey / #7806584 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6633350",
