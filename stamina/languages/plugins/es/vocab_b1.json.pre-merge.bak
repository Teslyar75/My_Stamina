    {
      "slug": "colegio-noun",
      "lemma": "colegio",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1539,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "school",
          "school before secondary school"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3091008",
          "text": "Volví del colegio.",
          "translation": "Я вернулся из школы.",
          "source": "Tatoeba #3091008 @marcelostockle / #2652520 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3091008",
          "cefr_level": "A1",
          "word_slugs": [
            "colegio-noun"
          ]
        },
        {
          "id": "2486814",
          "text": "Llamaron del colegio.",
          "translation": "Из школы звонили.",
          "source": "Tatoeba #2486814 @marcelostockle / #2478960 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2486814",
          "cefr_level": "A1",
          "word_slugs": [
            "colegio-noun"
          ]
        },
        {
          "id": "743340",
          "text": "Ese es mi colegio.",
          "translation": "Это моя школа.",
          "source": "Tatoeba #743340 @chinopinyin / #467097 @Fuzzyakin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/743340",
          "cefr_level": "A1",
          "word_slugs": [
            "colegio-noun"
          ]
        },
        {
          "id": "1623189",
          "text": "No vayas al colegio.",
          "translation": "Не ходи в школу.",
          "source": "Tatoeba #1623189 @marcelostockle / #12456190 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1623189",
          "cefr_level": "A1",
          "word_slugs": [
            "colegio-noun"
          ]
        },
        {
          "id": "538855",
          "text": "Deberíais ir al colegio.",
          "translation": "Вы должны ходить в школу.",
          "source": "Tatoeba #538855 @Shishir / #2553404 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/538855",
          "cefr_level": "A1",
          "word_slugs": [
            "colegio-noun"
          ]
        }
      ],
