      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person plural conditional of deber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3370501",
          "text": "Todos deberían irse.",
          "translation": "Всем следует уйти.",
          "source": "Tatoeba #3370501 @Shishir / #6299770 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3370501",
          "cefr_level": "A1",
          "word_slugs": [
            "deberían-verb"
          ]
        },
        {
          "id": "1418720",
          "text": "Ellos deberían saberlo.",
          "translation": "Им следовало бы это знать.",
          "source": "Tatoeba #1418720 @marcelostockle / #3537440 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1418720",
          "cefr_level": "A1",
          "word_slugs": [
            "deberían-verb"
          ]
        },
        {
          "id": "2285802",
          "text": "Deberían pedir disculpas.",
          "translation": "Вам надо бы попросить прощения.",
          "source": "Tatoeba #2285802 @marcelostockle / #3928561 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2285802",
          "cefr_level": "A1",
          "word_slugs": [
            "deberían-verb"
          ]
        },
        {
          "id": "1854920",
          "text": "Ya deberían estar acá.",
          "translation": "Они уже должны быть здесь.",
          "source": "Tatoeba #1854920 @marcelostockle / #7841899 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1854920",
          "cefr_level": "A1",
          "word_slugs": [
            "deberían-verb"
          ]
        },
        {
          "id": "1342258",
          "text": "Ellos no deberían salir.",
          "translation": "Им не стоит выходить.",
          "source": "Tatoeba #1342258 @Shishir / #8056765 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1342258",
          "cefr_level": "A1",
          "word_slugs": [
            "deberían-verb"
          ]
        }
