    {
      "slug": "pedazo-noun",
      "lemma": "pedazo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2156,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "piece, chunk, hunk, bit, bite (a part of a larger whole)",
          "patch (e.g. of sky, cloth, skin, space)",
          "scrap (e.g. of paper, information)",
          "lump (e.g. of metal, rock, clay, wood)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5041194",
          "text": "¡Pedazo de idiota!",
          "translation": "Идиота кусок!",
          "source": "Tatoeba #5041194 @don_ramon / #5615885 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5041194",
          "cefr_level": "A1",
          "word_slugs": [
            "pedazo-noun"
          ]
        },
        {
          "id": "5035699",
          "text": "Comió un pedazo de torta.",
          "translation": "Он съел кусок торта.",
          "source": "Tatoeba #5035699 @don_ramon / #4317602 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5035699",
          "cefr_level": "A1",
          "word_slugs": [
            "pedazo-noun"
          ]
        },
        {
          "id": "2254598",
          "text": "Me corté con un pedazo de vidrio.",
          "translation": "Я порезался осколком стекла.",
          "source": "Tatoeba #2254598 @cueyayotl / #3555852 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2254598",
          "cefr_level": "A1",
          "word_slugs": [
            "pedazo-noun"
          ]
        },
        {
          "id": "3300279",
          "text": "¿Queréis un pedazo de torta de calabaza?",
          "translation": "Хочешь кусочек тыквенного торта?",
          "source": "Tatoeba #3300279 @gianich73 / #3300426 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3300279",
          "cefr_level": "A1",
          "word_slugs": [
            "pedazo-noun"
          ]
        },
        {
          "id": "9594275",
          "text": "Tom me dio el último pedazo de pastel.",
          "translation": "Том дал мне последний кусочек пирога.",
          "source": "Tatoeba #9594275 @dpcossio / #9632773 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9594275",
          "cefr_level": "A1",
          "word_slugs": [
            "pedazo-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "pedazo",
        "plural": "",
        "infinitive": ""
      }
