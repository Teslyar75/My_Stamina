      "translations": {
        "en": [
          "to fight, to battle, to do battle",
          "to struggle, to strive, to contend, to grapple",
          "to wrestle"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2836781",
          "text": "Vivir significa luchar.",
          "translation": "Жить - значит бороться.",
          "source": "Tatoeba #2836781 @Tono / #2836779 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2836781",
          "cefr_level": "A1",
          "word_slugs": [
            "luchar-verb"
          ]
        },
        {
          "id": "1165939",
          "text": "Nada se consigue sin luchar.",
          "translation": "Ничего не достигается без борьбы.",
          "source": "Tatoeba #1165939 @nancy / #4069605 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1165939",
          "cefr_level": "A1",
          "word_slugs": [
            "luchar-verb"
          ]
        },
        {
          "id": "726747",
          "text": "Debemos luchar por nuestra democracia.",
          "translation": "Мы должны бороться за нашу демократию.",
          "source": "Tatoeba #726747 @Shishir / #12093631 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/726747",
          "cefr_level": "A1",
          "word_slugs": [
            "luchar-verb"
          ]
        },
        {
          "id": "1342276",
          "text": "Los americanos simplemente no querían luchar.",
          "translation": "Американцы просто не хотели бороться.",
          "source": "Tatoeba #1342276 @Shishir / #7575343 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1342276",
          "cefr_level": "A1",
          "word_slugs": [
            "luchar-verb"
          ]
        },
        {
          "id": "894253",
          "text": "Es algo por lo que vale la pena luchar.",
          "translation": "Это то, за что стоит бороться.",
          "source": "Tatoeba #894253 @Shishir / #4996135 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/894253",
          "cefr_level": "A1",
          "word_slugs": [
            "luchar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el luchar",
        "plural": "",
        "infinitive": "luchar"
      }
    },
    {
      "slug": "cabo-noun",
      "lemma": "cabo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1526,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "end, edge, extremity (furthest or terminal point of something)",
          "end, finish, conclusion (terminal point of something in time)",
          "stub, butt, stump (something blunted, stunted, burnt to a stub, or cut short)",
          "cable, rope (strong rope or chain, especially used to moor or anchor a ship)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2258384",
          "text": "Tiene galones de cabo.",
          "translation": "У него есть шевроны капрала.",
          "source": "Tatoeba #2258384 @carlosalberto / #2597150 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2258384",
          "cefr_level": "A1",
          "word_slugs": [
            "cabo-noun"
          ]
        },
        {
          "id": "855607",
          "text": "¿Llevaste a cabo tu plan?",
          "translation": "Ты осуществил свой план?",
          "source": "Tatoeba #855607 @Angfarmar / #14053208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/855607",
          "cefr_level": "A1",
          "word_slugs": [
            "cabo-noun"
          ]
        },
        {
          "id": "2268073",
          "text": "El cabo está con licencia.",
          "translation": "Капрал сейчас в увольнении.",
          "source": "Tatoeba #2268073 @cueyayotl / #5787817 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2268073",
          "cefr_level": "A1",
          "word_slugs": [
            "cabo-noun"
          ]
        },
        {
          "id": "2259600",
          "text": "Pasaron el cabo de Buena Esperanza.",
          "translation": "Они миновали мыс Доброй Надежды.",
          "source": "Tatoeba #2259600 @cueyayotl / #5211232 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259600",
          "cefr_level": "A1",
          "word_slugs": [
            "cabo-noun"
          ]
        },
        {
          "id": "1367294",
          "text": "Al fin y al cabo, tienes razón.",
          "translation": "В конце концов, ты прав.",
          "source": "Tatoeba #1367294 @marcelostockle / #9821143 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1367294",
          "cefr_level": "A1",
          "word_slugs": [
            "cabo-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
