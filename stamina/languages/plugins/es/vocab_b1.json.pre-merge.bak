      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2488,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "talk, chat"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5880451",
          "text": "Di una breve charla.",
          "translation": "Я произнёс небольшую речь.",
          "source": "Tatoeba #5880451 @arh / #7892897 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5880451",
          "cefr_level": "A1",
          "word_slugs": [
            "charla-noun"
          ]
        },
        {
          "id": "1520568",
          "text": "Tuve una charla con Tom.",
          "translation": "У меня был разговор с Томом.",
          "source": "Tatoeba #1520568 @marcelostockle / #5925071 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1520568",
          "cefr_level": "A1",
          "word_slugs": [
            "charla-noun"
          ]
        },
        {
          "id": "1296992",
          "text": "Tom dio una charla breve.",
          "translation": "Том сказал небольшую речь.",
          "source": "Tatoeba #1296992 @marcelostockle / #7892900 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1296992",
          "cefr_level": "A1",
          "word_slugs": [
            "charla-noun"
          ]
        },
        {
          "id": "3666563",
          "text": "Debemos tener una charla, Tom.",
          "translation": "Мы должны поговорить, Том.",
          "source": "Tatoeba #3666563 @Seael / #6115953 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3666563",
          "cefr_level": "A1",
          "word_slugs": [
            "charla-noun"
          ]
        },
        {
          "id": "2150982",
          "text": "La charla se alargó hasta las tres.",
          "translation": "Разговор затянулся до трёх часов.",
          "source": "Tatoeba #2150982 @marcelostockle / #7864159 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2150982",
          "cefr_level": "A1",
          "word_slugs": [
            "charla-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
