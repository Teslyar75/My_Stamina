    {
      "slug": "ganas-noun",
      "lemma": "ganas",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1234,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of gana",
          "desire, wish, want",
          "enthusiasm",
          "lust (chiefly when preceded by compound verb traerle o tener)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1556153",
          "text": "No tengo ganas.",
          "translation": "У меня нет желания.",
          "source": "Tatoeba #1556153 @hayastan / #4894125 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1556153",
          "cefr_level": "A1",
          "word_slugs": [
            "ganas-noun"
          ]
        },
        {
          "id": "7181426",
          "text": "No tiene ganas.",
          "translation": "Ему не хочется.",
          "source": "Tatoeba #7181426 @arh / #7575320 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7181426",
          "cefr_level": "A1",
          "word_slugs": [
            "ganas-noun"
          ]
        },
        {
          "id": "1413545",
          "text": "¿Cuánto ganas diariamente?",
          "translation": "Сколько ты зарабатываешь в день?",
          "source": "Tatoeba #1413545 @marcelostockle / #6957217 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1413545",
          "cefr_level": "A1",
          "word_slugs": [
            "ganas-noun"
          ]
        },
        {
          "id": "1873190",
          "text": "Me muero de ganas.",
          "translation": "Умираю от желания.",
          "source": "Tatoeba #1873190 @al_ex_an_der / #4989509 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1873190",
          "cefr_level": "A1",
          "word_slugs": [
            "ganas-noun"
          ]
        },
        {
          "id": "5069815",
          "text": "Tengo ganas de ti.",
          "translation": "Я хочу тебя.",
          "source": "Tatoeba #5069815 @carenas / #1729531 @naXa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5069815",
          "cefr_level": "A1",
          "word_slugs": [
            "ganas-noun"
          ]
        }
      ],
