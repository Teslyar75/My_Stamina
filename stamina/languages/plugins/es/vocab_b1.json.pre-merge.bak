          ]
        },
        {
          "id": "1704776",
          "text": "Él disfruta dar vueltas por el bosque en su tiempo libre.",
          "translation": "В свободное время он любит побродить по лесу.",
          "source": "Tatoeba #1704776 @ecorralest101 / #1994823 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1704776",
