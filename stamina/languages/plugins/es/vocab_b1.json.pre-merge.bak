      "frequency_rank": 1818,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "private, privy (e.g. a privy council)",
          "deprived, deprived of, denied, bereft (usually followed by de)",
          "unlisted (e.g. phone number)",
          "excited, ecstatic"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5804281",
          "text": "Tiene un avión privado.",
          "translation": "У него есть личный самолёт.",
