          ]
        },
        {
          "id": "2065692",
          "text": "Tengo que preguntarte algo.",
          "translation": "Я должен тебя кое о чём спросить.",
          "source": "Tatoeba #2065692 @marcelostockle / #5062477 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2065692",
          "cefr_level": "A1",
          "word_slugs": [
            "preguntarte-verb"
          ]
        },
        {
          "id": "2120879",
          "text": "¿Puedo preguntarte una cosa?",
