    {
      "slug": "intentar-verb",
      "lemma": "intentar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1347,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to try, to attempt; especially: to strain or put forth effort in so doing"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3778455",
          "text": "¡Vamos a intentar!",
          "translation": "Давайте попробуем!",
          "source": "Tatoeba #3778455 @cueyayotl / #505372 @thane (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3778455",
          "cefr_level": "A1",
          "word_slugs": [
            "intentar-verb"
          ]
        },
        {
          "id": "2087325",
          "text": "Quiero intentar ayudarte.",
          "translation": "Я хочу попробовать помочь тебе.",
          "source": "Tatoeba #2087325 @hayastan / #4930932 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2087325",
          "cefr_level": "A1",
          "word_slugs": [
            "intentar-verb"
          ]
        },
        {
          "id": "4353365",
          "text": "Van a intentar atacar.",
          "translation": "Они попытаются напасть.",
          "source": "Tatoeba #4353365 @umano / #4354768 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4353365",
          "cefr_level": "A1",
          "word_slugs": [
            "intentar-verb"
          ]
        },
        {
          "id": "3052956",
          "text": "Voy a intentar cocinar.",
          "translation": "Я попробую готовить.",
          "source": "Tatoeba #3052956 @marcelostockle / #3056844 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3052956",
          "cefr_level": "A1",
          "word_slugs": [
            "intentar-verb"
          ]
        },
        {
          "id": "2880187",
          "text": "No intentar es fracasar.",
          "translation": "Не пытаться - потерпеть неудачу.",
          "source": "Tatoeba #2880187 @cueyayotl / #2880631 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2880187",
          "cefr_level": "A1",
          "word_slugs": [
            "intentar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el intentar",
        "plural": "",
        "infinitive": "intentar"
      }
