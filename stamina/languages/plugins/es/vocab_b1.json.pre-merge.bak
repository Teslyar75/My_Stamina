          ]
        },
        {
          "id": "1784847",
          "text": "No hables conmigo.",
          "translation": "Не говори со мной.",
          "source": "Tatoeba #1784847 @Shishir / #2497996 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1784847",
          "cefr_level": "A1",
