    {
      "slug": "diablo-noun",
      "lemma": "diablo",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1223,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "devil",
          "crowbar, wrecking bar, jemmy, jimmy, prybar, pinchbar, nail bar"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "11546833",
          "text": "¡No hay diablo!",
          "translation": "Дьявола не существует!",
          "source": "Tatoeba #11546833 @Adelpa / #11546844 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11546833",
          "cefr_level": "A1",
