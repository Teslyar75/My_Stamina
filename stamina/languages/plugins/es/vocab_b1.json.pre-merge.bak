      },
      "gender": null,
      "examples": [
        {
          "id": "1301814",
          "text": "Ella pesa 120 libras.",
          "translation": "Она весит 120 фунтов.",
          "source": "Tatoeba #1301814 @darinmex / #5280498 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1301814",
          "cefr_level": "A1",
          "word_slugs": [
            "libras-noun"
          ]
        },
        {
          "id": "1279863",
          "text": "Él pesa cerca de 300 libras.",
          "translation": "Он весит около трёхсот фунтов.",
          "source": "Tatoeba #1279863 @marcelostockle / #5524592 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1279863",
          "cefr_level": "A1",
          "word_slugs": [
            "libras-noun"
          ]
        },
        {
          "id": "462583",
          "text": "La camisa cuesta doce libras.",
