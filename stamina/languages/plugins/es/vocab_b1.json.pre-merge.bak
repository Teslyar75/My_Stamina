    {
      "slug": "pensamos-verb",
      "lemma": "pensamos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2109,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person plural present/preterite indicative of pensar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6035931",
          "text": "Pensamos, luego existimos.",
          "translation": "Мы мыслим, следовательно, мы существуем.",
          "source": "Tatoeba #6035931 @Adelpa / #13079359 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6035931",
          "cefr_level": "A1",
          "word_slugs": [
            "pensamos-verb"
          ]
        },
        {
          "id": "1726823",
          "text": "Somos lo que pensamos.",
          "translation": "Мы — это то, что мы думаем.",
          "source": "Tatoeba #1726823 @hayastan / #4135612 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1726823",
          "cefr_level": "A1",
          "word_slugs": [
            "pensamos-verb"
          ]
        },
        {
          "id": "1702908",
          "text": "Pensamos que eras casado.",
          "translation": "Мы думали, ты женат.",
          "source": "Tatoeba #1702908 @marcelostockle / #12963840 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1702908",
          "cefr_level": "A1",
          "word_slugs": [
            "pensamos-verb"
          ]
        },
        {
          "id": "1702911",
          "text": "Pensamos que eras casada.",
          "translation": "Мы думали, что ты замужем.",
          "source": "Tatoeba #1702911 @marcelostockle / #3689300 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1702911",
          "cefr_level": "A1",
          "word_slugs": [
            "pensamos-verb"
          ]
        },
        {
          "id": "738759",
          "text": "No pensamos en el precio.",
          "translation": "Мы не думаем о цене.",
          "source": "Tatoeba #738759 @darinmex / #5104013 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/738759",
          "cefr_level": "A1",
          "word_slugs": [
            "pensamos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "pensamos",
        "plural": "",
        "infinitive": "pensamos"
