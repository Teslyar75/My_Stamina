    {
      "slug": "entrevista-noun",
      "lemma": "entrevista",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2218,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "interview"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "844018",
          "text": "La entrevista comenzó a las 10.",
          "translation": "Интервью началось в 10 часов.",
          "source": "Tatoeba #844018 @Shishir / #3163510 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/844018",
          "cefr_level": "A1",
          "word_slugs": [
            "entrevista-noun"
          ]
        },
        {
          "id": "1535563",
          "text": "¡Aquí está la última entrevista!",
          "translation": "Вот последнее интервью!",
          "source": "Tatoeba #1535563 @marcelostockle / #5265963 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1535563",
          "cefr_level": "A1",
          "word_slugs": [
            "entrevista-noun"
          ]
        },
        {
          "id": "4476980",
          "text": "Gracias por aceptar esta entrevista.",
          "translation": "Спасибо, что согласились на это интервью.",
          "source": "Tatoeba #4476980 @cueyayotl / #4476985 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4476980",
          "cefr_level": "A1",
          "word_slugs": [
            "entrevista-noun"
          ]
        },
        {
          "id": "5651135",
          "text": "Daremos una entrevista por la tarde.",
          "translation": "После обеда мы дадим интервью.",
          "source": "Tatoeba #5651135 @baudelaire / #5651722 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5651135",
          "cefr_level": "A1",
          "word_slugs": [
            "entrevista-noun"
          ]
        },
        {
          "id": "8309416",
          "text": "Tomás tiene una entrevista de trabajo el lunes.",
          "translation": "У Тома в понедельник собеседование.",
          "source": "Tatoeba #8309416 @emigonza / #8309417 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8309416",
          "cefr_level": "A1",
          "word_slugs": [
            "entrevista-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
