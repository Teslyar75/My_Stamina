          ]
        },
        {
          "id": "1597421",
          "text": "¡El show debe continuar!",
          "translation": "Шоу должно продолжаться!",
          "source": "Tatoeba #1597421 @hayastan / #5076283 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1597421",
