          "plural of joven"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1651114",
          "text": "Todavía son jóvenes.",
          "translation": "Вы ещё молоды.",
          "source": "Tatoeba #1651114 @Shishir / #2832928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1651114",
          "cefr_level": "A1",
          "word_slugs": [
            "jóvenes-adj"
          ]
        },
        {
          "id": "1516024",
          "text": "Ya no son jóvenes.",
          "translation": "Вы уже не молоды.",
          "source": "Tatoeba #1516024 @marcelostockle / #2821797 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1516024",
          "cefr_level": "A1",
          "word_slugs": [
            "jóvenes-adj"
          ]
        },
        {
          "id": "1698589",
          "text": "Ya no somos jóvenes.",
          "translation": "Мы уже не молодые.",
          "source": "Tatoeba #1698589 @marcelostockle / #4209701 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1698589",
          "cefr_level": "A1",
          "word_slugs": [
            "jóvenes-adj"
          ]
        },
        {
          "id": "1553046",
