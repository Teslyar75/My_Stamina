    {
      "slug": "haberte-verb",
      "lemma": "haberte",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1627,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of haber combined with te",
          "second-person singular infinitive of haberse"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5432502",
          "text": "Debería haberte escuchado.",
          "translation": "Надо было мне тебя послушать.",
          "source": "Tatoeba #5432502 @Seael / #2782864 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5432502",
          "cefr_level": "A1",
          "word_slugs": [
            "haberte-verb"
          ]
        },
        {
          "id": "3866952",
          "text": "Deberías haberte presentado.",
          "translation": "Тебе следовало представиться.",
          "source": "Tatoeba #3866952 @cueyayotl / #3552158 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3866952",
          "cefr_level": "A1",
          "word_slugs": [
            "haberte-verb"
          ]
        },
        {
          "id": "1502207",
          "text": "Espero no haberte ofendido.",
          "translation": "Надеюсь, я тебя не обидел.",
          "source": "Tatoeba #1502207 @marcelostockle / #4211657 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1502207",
          "cefr_level": "A1",
          "word_slugs": [
            "haberte-verb"
          ]
        },
        {
          "id": "9014984",
          "text": "No debería haberte elogiado.",
          "translation": "Зря я тебя хвалил.",
          "source": "Tatoeba #9014984 @carlosalberto / #7453109 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9014984",
          "cefr_level": "A1",
          "word_slugs": [
            "haberte-verb"
          ]
        },
        {
          "id": "496100",
          "text": "Nunca olvidaré haberte visto.",
          "translation": "Я никогда не забуду нашей встречи.",
          "source": "Tatoeba #496100 @garazinm / #2404096 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/496100",
          "cefr_level": "A1",
          "word_slugs": [
            "haberte-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "haberte",
        "plural": "",
        "infinitive": "haberte"
      }
