    {
      "slug": "cinta-noun",
      "lemma": "cinta",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1907,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "ribbon, worn by girls in the hair",
          "tape",
          "ellipsis of cinta de correr or cinta para correr; treadmill",
          "ellipsis of cinta cinematográfica; film"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5864187",
          "text": "Desaté la cinta.",
          "translation": "Я развязал ленту.",
          "source": "Tatoeba #5864187 @arh / #5879926 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5864187",
          "cefr_level": "A1",
          "word_slugs": [
            "cinta-noun"
          ]
        },
        {
          "id": "7645441",
          "text": "Tengo cinta aislante de colores diferentes.",
          "translation": "У меня есть изолента разных цветов.",
          "source": "Tatoeba #7645441 @arh / #7666790 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7645441",
          "cefr_level": "A1",
          "word_slugs": [
            "cinta-noun"
          ]
        },
        {
          "id": "7645440",
          "text": "Los cables se pueden empalmar con cinta aislante.",
          "translation": "Провода можно соединить с помощью изоленты.",
          "source": "Tatoeba #7645440 @arh / #7666789 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7645440",
          "cefr_level": "A1",
          "word_slugs": [
            "cinta-noun"
          ]
        },
        {
          "id": "331739",
          "text": "Ella amarró una cinta roja en su sombrilla como distintivo.",
          "translation": "Она привязала к зонту красную ленту в качестве знака.",
          "source": "Tatoeba #331739 @danilo / #1209041 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/331739",
          "cefr_level": "A1",
          "word_slugs": [
            "cinta-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
