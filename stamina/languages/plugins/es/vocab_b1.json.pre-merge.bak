    {
      "slug": "lisa-noun",
      "lemma": "lisa",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2107,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "mullet, white mullet"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13373240",
          "text": "¡Te amo, Lisa!",
          "translation": "Я люблю тебя, Лиза!",
          "source": "Tatoeba #13373240 @Adelpa / #8736988 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13373240",
          "cefr_level": "A1",
          "word_slugs": [
            "lisa-noun"
          ]
        },
        {
          "id": "1387455",
          "text": "Su verdadero nombre es Lisa.",
          "translation": "Её настоящее имя - Лиза.",
          "source": "Tatoeba #1387455 @enteka / #2362276 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1387455",
          "cefr_level": "A1",
          "word_slugs": [
            "lisa-noun"
          ]
        },
        {
          "id": "10085242",
          "text": "El cumpleaños de Lisa es en dos meses.",
          "translation": "День рождения Лизы через два месяца.",
          "source": "Tatoeba #10085242 @DJ_Saidez / #11960019 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10085242",
          "cefr_level": "A1",
          "word_slugs": [
            "lisa-noun"
          ]
        },
        {
          "id": "10768793",
          "text": "Lisa estudia todos los días de la semana.",
          "translation": "Лиза учится каждый день недели.",
          "source": "Tatoeba #10768793 @Shishir / #10771255 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10768793",
          "cefr_level": "A1",
          "word_slugs": [
            "lisa-noun"
          ]
        },
        {
          "id": "10113026",
          "text": "Quedan dos meses para el cumpleaños de Lisa.",
          "translation": "До Лизиного дня рождения осталось два месяца.",
          "source": "Tatoeba #10113026 @DJ_Saidez / #11960021 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10113026",
          "cefr_level": "A1",
          "word_slugs": [
            "lisa-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
