          ]
        },
        {
          "id": "2665200",
          "text": "No hablé con Tom.",
          "translation": "Я не говорил с Томом.",
          "source": "Tatoeba #2665200 @nancy / #2665293 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2665200",
