    {
      "slug": "apareció-verb",
      "lemma": "apareció",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2418,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular preterite indicative of aparecer"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "358619",
          "text": "¿Cuándo apareció la vida?",
          "translation": "Когда появилась жизнь?",
          "source": "Tatoeba #358619 @tatoerique / #2761190 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/358619",
          "cefr_level": "A1",
          "word_slugs": [
            "apareció-verb"
          ]
        },
        {
          "id": "4995558",
          "text": "Finalmente, una ambulancia apareció.",
          "translation": "Наконец приехала скорая.",
          "source": "Tatoeba #4995558 @albrusgher / #4995595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4995558",
          "cefr_level": "A1",
          "word_slugs": [
            "apareció-verb"
          ]
        },
        {
          "id": "1511104",
          "text": "Una chica apareció ante mí.",
          "translation": "Передо мной появилась девушка.",
          "source": "Tatoeba #1511104 @Shishir / #2832591 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1511104",
          "cefr_level": "A1",
          "word_slugs": [
            "apareció-verb"
          ]
        },
        {
          "id": "1165831",
          "text": "Tom apareció justo a tiempo.",
          "translation": "Том появился как раз вовремя.",
          "source": "Tatoeba #1165831 @marcelostockle / #4923005 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1165831",
          "cefr_level": "A1",
          "word_slugs": [
            "apareció-verb"
          ]
        },
        {
          "id": "1387813",
          "text": "Él apareció en muchas películas.",
          "translation": "Он отметился во многих фильмах.",
          "source": "Tatoeba #1387813 @marcelostockle / #4416815 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1387813",
          "cefr_level": "A1",
          "word_slugs": [
            "apareció-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "apareció",
