    {
      "slug": "toque-noun",
      "lemma": "toque",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2047,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "a touch",
          "a strum",
          "a toll (musical sound used to announce something)",
          "assay by touchstone"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1070115",
          "text": "No toque las flores.",
          "translation": "Не трогай цветы.",
          "source": "Tatoeba #1070115 @hayastan / #1058895 @vmel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1070115",
          "cefr_level": "A1",
          "word_slugs": [
            "toque-noun"
          ]
        },
        {
          "id": "990498",
          "text": "¡No toque la mercancía!",
          "translation": "Не трогайте товары руками!",
          "source": "Tatoeba #990498 @Shishir / #2620711 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/990498",
          "cefr_level": "A1",
          "word_slugs": [
            "toque-noun"
          ]
        },
        {
          "id": "4935347",
          "text": "Por favor no me toque.",
          "translation": "Пожалуйста, не прикасайтесь ко мне.",
          "source": "Tatoeba #4935347 @Ricardo14 / #4942472 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4935347",
          "cefr_level": "A1",
          "word_slugs": [
            "toque-noun"
          ]
        },
        {
          "id": "2219504",
          "text": "Quiero que toque la guitarra.",
          "translation": "Я хочу, чтобы он сыграл на гитаре.",
          "source": "Tatoeba #2219504 @Shishir / #5124288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2219504",
          "cefr_level": "A1",
          "word_slugs": [
            "toque-noun"
          ]
        },
        {
          "id": "703139",
          "text": "Esta toalla es áspera al toque.",
          "translation": "На ощупь это полотенце грубое.",
          "source": "Tatoeba #703139 @andresevargas / #6761693 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/703139",
          "cefr_level": "A1",
          "word_slugs": [
            "toque-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
