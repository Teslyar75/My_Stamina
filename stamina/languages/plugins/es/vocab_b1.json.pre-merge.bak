          ]
        },
        {
          "id": "1703192",
          "text": "¿Puedes limpiar tu habitación?",
          "translation": "Ты можешь убрать у себя в комнате?",
          "source": "Tatoeba #1703192 @marcelostockle / #3473155 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1703192",
