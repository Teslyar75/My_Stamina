          "cefr_level": "A1",
          "word_slugs": [
            "francia-name"
          ]
        },
        {
          "id": "6316580",
          "text": "¡Francia, te amo!",
          "translation": "Франция, я люблю тебя!",
          "source": "Tatoeba #6316580 @Adelpa / #6316431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6316580",
          "cefr_level": "A1",
          "word_slugs": [
            "francia-name"
          ]
        },
        {
          "id": "2903864",
          "text": "Viajamos a Francia.",
          "translation": "Мы ездили во Францию.",
          "source": "Tatoeba #2903864 @hayastan / #2903901 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2903864",
          "cefr_level": "A1",
          "word_slugs": [
            "francia-name"
          ]
        }
      ],
