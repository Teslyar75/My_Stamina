          ]
        },
        {
          "id": "8172621",
          "text": "El monstruo me persiguió.",
          "translation": "Чудовище меня преследовало.",
          "source": "Tatoeba #8172621 @Seael / #8181677 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8172621",
          "cefr_level": "A1",
          "word_slugs": [
            "monstruo-noun"
          ]
        },
        {
          "id": "7933663",
          "text": "El monstruo aulló de rabia.",
          "translation": "Монстр взвыл от ярости.",
          "source": "Tatoeba #7933663 @Seael / #10264682 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7933663",
          "cefr_level": "A1",
          "word_slugs": [
            "monstruo-noun"
          ]
        }
