          "second-person singular voseo present indicative of ser; you are"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1786903",
          "text": "Sois sus hijas.",
          "translation": "Вы её дочери.",
          "source": "Tatoeba #1786903 @Shishir / #8765237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1786903",
          "cefr_level": "A1",
          "word_slugs": [
            "sois-verb"
          ]
        },
        {
          "id": "2715117",
          "text": "Sois mis amigos.",
          "translation": "Вы мои друзья.",
