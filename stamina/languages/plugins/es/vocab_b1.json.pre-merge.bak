            "claramente-adv"
          ]
        },
        {
          "id": "3515599",
          "text": "Es claramente inevitable.",
          "translation": "Это, очевидно, неизбежно.",
          "source": "Tatoeba #3515599 @Aether / #3688607 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3515599",
          "cefr_level": "A1",
