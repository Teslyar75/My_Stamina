    {
      "slug": "podías-verb",
      "lemma": "podías",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2228,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "second-person singular imperfect indicative of poder"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10741756",
          "text": "¿Sabías que podías hacerlo?",
          "translation": "Ты знал, что можешь это сделать?",
          "source": "Tatoeba #10741756 @megamanenm / #10979625 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10741756",
          "cefr_level": "A1",
          "word_slugs": [
            "podías-verb"
          ]
        },
        {
          "id": "4610949",
          "text": "Sabía que no podías esperar.",
          "translation": "Я знал, что ты не можешь ждать.",
          "source": "Tatoeba #4610949 @DarkHollow / #7145631 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4610949",
          "cefr_level": "A1",
          "word_slugs": [
            "podías-verb"
          ]
        },
        {
          "id": "4589442",
          "text": "¿Quién dijo que podías dormir?",
          "translation": "Кто сказал, что ты можешь спать?",
          "source": "Tatoeba #4589442 @DarkHollow / #11701387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4589442",
          "cefr_level": "A1",
          "word_slugs": [
            "podías-verb"
          ]
        },
        {
          "id": "3121754",
          "text": "¿Cómo podías ser tan irresponsable?",
          "translation": "Как ты мог быть таким безответственным?",
          "source": "Tatoeba #3121754 @wallebot / #3096934 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3121754",
          "cefr_level": "A1",
          "word_slugs": [
            "podías-verb"
          ]
        },
        {
          "id": "6148726",
          "text": "No sabía que podías hacer eso.",
          "translation": "Я не знал, что ты можешь это сделать.",
          "source": "Tatoeba #6148726 @Shishir / #6148907 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6148726",
          "cefr_level": "A1",
          "word_slugs": [
            "podías-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
