    {
      "slug": "podremos-verb",
      "lemma": "podremos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1839,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person plural future indicative of poder"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6634346",
          "text": "No podremos escapar.",
          "translation": "Мы не сможем сбежать.",
          "source": "Tatoeba #6634346 @UsuarioX / #6634692 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6634346",
          "cefr_level": "A1",
          "word_slugs": [
            "podremos-verb"
          ]
        },
        {
          "id": "6634349",
          "text": "No podremos ayudar a Tom.",
          "translation": "Мы не сможем помочь Тому.",
          "source": "Tatoeba #6634349 @UsuarioX / #3947467 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6634349",
          "cefr_level": "A1",
          "word_slugs": [
            "podremos-verb"
          ]
        },
        {
          "id": "4047950",
          "text": "No sé si podremos hacerlo.",
          "translation": "Не знаю, сможем ли мы это сделать.",
          "source": "Tatoeba #4047950 @gianich73 / #4047784 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4047950",
          "cefr_level": "A1",
          "word_slugs": [
            "podremos-verb"
          ]
        },
        {
          "id": "460907",
          "text": "Pronto podremos mandarte a la cárcel.",
          "translation": "Мы скоро сможем отправить тебя в тюрьму.",
          "source": "Tatoeba #460907 @Shishir / #13950895 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/460907",
          "cefr_level": "A1",
          "word_slugs": [
            "podremos-verb"
          ]
        },
        {
          "id": "10628332",
          "text": "Nunca podremos entender a las mujeres.",
          "translation": "Мы никогда не сможем понять женщин.",
          "source": "Tatoeba #10628332 @DJ_Saidez / #10628338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10628332",
          "cefr_level": "A1",
          "word_slugs": [
            "podremos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "podremos",
        "plural": "",
        "infinitive": "podremos"
      }
