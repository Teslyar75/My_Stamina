            "encantado-adj"
          ]
        },
        {
          "id": "456640",
          "text": "Encantado de conocerlo.",
          "translation": "Я рад с вами познакомиться.",
          "source": "Tatoeba #456640 @lukaszpp / #1438225 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/456640",
