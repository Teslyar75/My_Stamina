    {
      "slug": "gay-adj",
      "lemma": "gay",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1386,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "gay, homosexual"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2996393",
          "text": "Lo amo, pero él es gay.",
          "translation": "Я люблю его, но он гей.",
          "source": "Tatoeba #2996393 @hayastan / #2997230 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2996393",
          "cefr_level": "A1",
          "word_slugs": [
            "gay-adj"
          ]
        },
        {
          "id": "858868",
          "text": "¿Cómo puedo encontrar un club gay?",
          "translation": "Как мне найти гей-клуб?",
          "source": "Tatoeba #858868 @sharin / #5431268 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/858868",
          "cefr_level": "A1",
          "word_slugs": [
            "gay-adj"
          ]
        },
        {
          "id": "3664333",
          "text": "El matrimonio gay debería ser legal.",
          "translation": "Однополые браки должны быть легализованы.",
          "source": "Tatoeba #3664333 @hayastan / #4059923 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3664333",
          "cefr_level": "A1",
          "word_slugs": [
            "gay-adj"
          ]
        },
        {
          "id": "3788593",
          "text": "¡Mario, dejá de llamarme gay! ¡Soy heterosexual!",
          "translation": "Марио, хватит обзывать меня геем! Натурал я!",
          "source": "Tatoeba #3788593 @hayastan / #3788444 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3788593",
          "cefr_level": "A1",
          "word_slugs": [
            "gay-adj"
          ]
        },
        {
          "id": "12674893",
          "text": "No deberías usar la palabra «gay» como insulto.",
          "translation": "Не стоит использовать слово \"гей\" в качестве оскорбления.",
          "source": "Tatoeba #12674893 @urro / #12674941 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12674893",
          "cefr_level": "A1",
          "word_slugs": [
            "gay-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el gay",
