      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1709,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "walk, stroll",
          "outing, excursion",
          "promenade (place where one takes a walk for leisure)",
          "vacation, holiday"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "536854",
          "text": "¿Damos un paseo?",
          "translation": "Может, прогуляемся?",
          "source": "Tatoeba #536854 @joshitobuba / #4814052 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/536854",
          "cefr_level": "A1",
