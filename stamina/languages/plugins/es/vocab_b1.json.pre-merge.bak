      },
      "gender": "m",
      "examples": [
        {
          "id": "6945503",
          "text": "Debo limpiar el baño.",
          "translation": "Я должен убраться в ванной.",
          "source": "Tatoeba #6945503 @arh / #6977482 @Pereskaz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6945503",
          "cefr_level": "A1",
