      "gender": null,
      "examples": [
        {
          "id": "743579",
          "text": "¿Quieren hacerse ricos?",
          "translation": "Вы хотите разбогатеть?",
          "source": "Tatoeba #743579 @Shishir / #4638402 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/743579",
          "cefr_level": "A1",
