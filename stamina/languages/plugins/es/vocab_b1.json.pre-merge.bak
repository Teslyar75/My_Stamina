    {
      "slug": "resulta-verb",
      "lemma": "resulta",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1428,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of resultar:",
          "third-person singular present indicative",
          "inflection of resultar:",
          "second-person singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7108860",
          "text": "Me resulta difícil creerlo.",
          "translation": "Мне трудно в это поверить.",
          "source": "Tatoeba #7108860 @arh / #558033 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7108860",
          "cefr_level": "A1",
          "word_slugs": [
            "resulta-verb"
          ]
        },
        {
          "id": "7741717",
          "text": "El francés no nos resulta fácil.",
          "translation": "Для нас французский сложен.",
          "source": "Tatoeba #7741717 @arh / #7743263 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7741717",
          "cefr_level": "A1",
          "word_slugs": [
            "resulta-verb"
          ]
        },
        {
          "id": "3762766",
          "text": "Le resulta imposible dejar de fumar.",
          "translation": "Он не в состоянии бросить курить.",
          "source": "Tatoeba #3762766 @Seael / #5510590 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3762766",
          "cefr_level": "A1",
          "word_slugs": [
            "resulta-verb"
          ]
        },
        {
          "id": "7862050",
          "text": "Vuestro afán de notoriedad me resulta insoportable.",
          "translation": "Ваше стремление быть в центре внимания я нахожу невыносимым.",
          "source": "Tatoeba #7862050 @Seael / #7862259 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7862050",
          "cefr_level": "A1",
          "word_slugs": [
            "resulta-verb"
          ]
        },
        {
          "id": "1393855",
          "text": "Me resulta muy amargo el té de boldo.",
          "translation": "Чай из листьев больдо очень горький для меня.",
          "source": "Tatoeba #1393855 @hayastan / #5604918 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1393855",
          "cefr_level": "A1",
          "word_slugs": [
            "resulta-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
