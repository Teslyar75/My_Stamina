    {
      "slug": "espíritu-noun",
      "lemma": "espíritu",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1467,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "spirit, soul",
          "mind"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1002822",
          "text": "Debemos invocar a un espíritu.",
          "translation": "Мы должны вызвать дух.",
          "source": "Tatoeba #1002822 @hayastan / #3332994 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1002822",
          "cefr_level": "A1",
          "word_slugs": [
            "espíritu-noun"
          ]
        },
        {
          "id": "1671177",
          "text": "Dichosos los pobres de espíritu.",
          "translation": "Блаженны нищие духом.",
          "source": "Tatoeba #1671177 @termito2nd / #856707 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1671177",
          "cefr_level": "A1",
          "word_slugs": [
            "espíritu-noun"
          ]
        },
        {
          "id": "3724709",
          "text": "Que Dios el Espíritu Santo sea contigo siempre.",
          "translation": "Да пребудет с тобой Святой Дух отныне и вовеки веков.",
          "source": "Tatoeba #3724709 @cueyayotl / #6144759 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3724709",
          "cefr_level": "A1",
          "word_slugs": [
            "espíritu-noun"
          ]
        },
        {
          "id": "1880240",
          "text": "La materia, veis, desaparece, sólo el espíritu queda.",
          "translation": "Материя, видите ли, исчезает, остается один дух.",
          "source": "Tatoeba #1880240 @sixtynine / #1880223 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1880240",
          "cefr_level": "A1",
          "word_slugs": [
            "espíritu-noun"
          ]
        },
        {
          "id": "710918",
          "text": "Mi cuerpo es viejo pero mi espíritu es joven.",
          "translation": "Тело моё старо, но дух мой молод.",
          "source": "Tatoeba #710918 @darinmex / #5453259 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/710918",
          "cefr_level": "A1",
          "word_slugs": [
            "espíritu-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "espíritu",
        "plural": "",
        "infinitive": ""
      }
