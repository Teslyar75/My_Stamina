    {
      "slug": "corriente-adj",
      "lemma": "corriente",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2368,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "flowing, running",
          "current (existing or occurring at the moment)",
          "common, usual",
          "ordinary, normal"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6616263",
          "text": "Una pila da corriente continua.",
          "translation": "Батарейка даёт постоянный ток.",
          "source": "Tatoeba #6616263 @arh / #7754365 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6616263",
          "cefr_level": "A1",
          "word_slugs": [
            "corriente-adj"
          ]
        },
        {
          "id": "1387080",
          "text": "¡Cierra la puerta, hay corriente!",
          "translation": "Закрой дверь - сквозняк!",
          "source": "Tatoeba #1387080 @enteka / #1387202 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1387080",
          "cefr_level": "A1",
          "word_slugs": [
            "corriente-adj"
          ]
        },
        {
          "id": "2253908",
          "text": "Remaba contra una corriente suave.",
          "translation": "Он грёб против слабого течения.",
          "source": "Tatoeba #2253908 @cueyayotl / #3555928 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2253908",
          "cefr_level": "A1",
          "word_slugs": [
            "corriente-adj"
          ]
        },
        {
          "id": "2138000",
          "text": "Nadar contra la corriente exige coraje.",
          "translation": "Плавание против течения требует мужества.",
          "source": "Tatoeba #2138000 @marcelostockle / #6550163 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2138000",
          "cefr_level": "A1",
          "word_slugs": [
            "corriente-adj"
          ]
        },
        {
          "id": "1131259",
          "text": "Una corriente eléctrica puede generar magnetismo.",
          "translation": "Электрический ток может генерировать магнитное поле.",
          "source": "Tatoeba #1131259 @nancy / #4616457 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1131259",
          "cefr_level": "A1",
          "word_slugs": [
            "corriente-adj"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el corriente",
        "plural": "",
        "infinitive": ""
      }
    },
