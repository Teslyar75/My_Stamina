    {
      "slug": "estén-verb",
      "lemma": "estén",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1502,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of estar:",
          "third-person plural present subjunctive",
          "inflection of estar:",
          "third-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5319958",
          "text": "No creo que estén casados.",
          "translation": "Не думаю, что они женаты.",
          "source": "Tatoeba #5319958 @mervert1 / #7372887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5319958",
          "cefr_level": "A1",
          "word_slugs": [
            "estén-verb"
          ]
        },
        {
          "id": "5130031",
          "text": "Los voy a extrañar cuando no estén.",
          "translation": "Я буду скучать по вам, когда вас не будет.",
          "source": "Tatoeba #5130031 @don_ramon / #5130018 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5130031",
          "cefr_level": "A1",
          "word_slugs": [
            "estén-verb"
          ]
        },
        {
          "id": "6823831",
          "text": "Espero que no estén hablando de mí.",
          "translation": "Надеюсь, они не обо мне говорят.",
          "source": "Tatoeba #6823831 @arh / #7995261 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6823831",
          "cefr_level": "A1",
          "word_slugs": [
            "estén-verb"
          ]
        },
        {
          "id": "5360078",
          "text": "Me alegra que todos ustedes estén acá.",
          "translation": "Я рад, что вы все здесь.",
          "source": "Tatoeba #5360078 @baudelaire / #5530781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5360078",
          "cefr_level": "A1",
          "word_slugs": [
            "estén-verb"
          ]
        },
        {
          "id": "9694732",
          "text": "Es extraño que tus amigos no estén aquí.",
          "translation": "Странно, что ваших друзей нет.",
          "source": "Tatoeba #9694732 @carlosalberto / #4049708 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9694732",
          "cefr_level": "A1",
          "word_slugs": [
            "estén-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "estén",
        "plural": "",
        "infinitive": "estén"
      }
    },
    {
      "slug": "cuentas-noun",
      "lemma": "cuentas",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1503,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "plural of cuenta"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1862046",
          "text": "Nunca me cuentas nada.",
          "translation": "Ты никогда ничего мне не рассказываешь.",
          "source": "Tatoeba #1862046 @Shishir / #2345302 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1862046",
          "cefr_level": "A1",
          "word_slugs": [
            "cuentas-noun"
          ]
        },
        {
          "id": "12316247",
          "text": "¿Cuentas ovejas para dormir?",
          "translation": "Ты считаешь овец, чтобы заснуть?",
          "source": "Tatoeba #12316247 @Serrot / #12317175 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12316247",
          "cefr_level": "A1",
          "word_slugs": [
            "cuentas-noun"
          ]
        },
        {
          "id": "3899449",
          "text": "¿Quiénes son a fin de cuentas?",
          "translation": "Кто они на самом деле?",
          "source": "Tatoeba #3899449 @gianich73 / #3898832 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3899449",
          "cefr_level": "A1",
          "word_slugs": [
            "cuentas-noun"
          ]
        },
        {
          "id": "2150446",
          "text": "Luego me cuentas cómo acaba la película.",
          "translation": "Потом расскажешь мне, чем фильм заканчивается.",
          "source": "Tatoeba #2150446 @wallebot / #11781693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2150446",
          "cefr_level": "A1",
          "word_slugs": [
            "cuentas-noun"
          ]
        },
        {
          "id": "7780251",
          "text": "Sami tiene seis diferentes cuentas de Facebook.",
          "translation": "У Сами шесть разных аккаунтов в Фейсбуке.",
          "source": "Tatoeba #7780251 @alejandra__ / #7819714 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7780251",
          "cefr_level": "A1",
          "word_slugs": [
            "cuentas-noun"
          ]
        }
      ],
