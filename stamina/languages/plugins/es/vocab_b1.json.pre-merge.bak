          ]
        },
        {
          "id": "4781523",
          "text": "Tal vez deberías intentarlo.",
          "translation": "Может быть, тебе стоит попробовать.",
          "source": "Tatoeba #4781523 @alegarvid / #8029404 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4781523",
          "cefr_level": "A1",
          "word_slugs": [
            "intentarlo-verb"
          ]
        },
        {
          "id": "9998952",
          "text": "Por favor, vuelve a intentarlo.",
          "translation": "Попробуй ещё раз, пожалуйста.",
          "source": "Tatoeba #9998952 @Shishir / #5381018 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9998952",
          "cefr_level": "A1",
          "word_slugs": [
            "intentarlo-verb"
          ]
        },
        {
          "id": "2671675",
          "text": "Podrías intentarlo por lo menos.",
          "translation": "Ты мог бы по-крайней мере попробовать.",
          "source": "Tatoeba #2671675 @Shishir / #5607791 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2671675",
          "cefr_level": "A1",
          "word_slugs": [
            "intentarlo-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "intentarlo",
        "plural": "",
        "infinitive": "intentarlo"
      }
