        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1120251",
          "text": "Está jugando fuera.",
          "translation": "Он играет на улице.",
          "source": "Tatoeba #1120251 @Shishir / #4287358 @dreamer (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1120251",
          "cefr_level": "A1",
