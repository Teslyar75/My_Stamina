      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "reason, ground, motive"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1909710",
          "text": "No hay motivo para risa.",
          "translation": "Нет причин для смеха.",
          "source": "Tatoeba #1909710 @hayastan / #6786361 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1909710",
          "cefr_level": "A1",
