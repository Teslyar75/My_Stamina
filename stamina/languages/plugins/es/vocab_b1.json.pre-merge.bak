      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "initialism of ácido desoxirribonucleico DNA (deoxyribonucleic acid)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1001765",
          "text": "La molécula de ADN se puede duplicar.",
          "translation": "Молекула ДНК может удваиваться.",
          "source": "Tatoeba #1001765 @hayastan / #6391530 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1001765",
          "cefr_level": "A1",
          "word_slugs": [
            "adn-noun"
          ]
        },
        {
          "id": "2900993",
          "text": "El ADN y el ARN son ácidos nucleicos.",
          "translation": "ДНК и РНК — нуклеиновые кислоты.",
          "source": "Tatoeba #2900993 @alexmarcelo / #3882622 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2900993",
          "cefr_level": "A1",
          "word_slugs": [
            "adn-noun"
          ]
        },
        {
          "id": "4116537",
          "text": "Los ácidos nucleicos incluyen el ADN y el ARN.",
          "translation": "Нуклеиновые кислоты включают ДНК и РНК.",
          "source": "Tatoeba #4116537 @hayastan / #4239718 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4116537",
          "cefr_level": "A1",
