          "cefr_level": "A1",
          "word_slugs": [
            "california-name"
          ]
        },
        {
          "id": "1387961",
          "text": "Nixon nació en California.",
          "translation": "Никсон родился в Калифорнии.",
          "source": "Tatoeba #1387961 @marcelostockle / #4416875 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1387961",
          "cefr_level": "A1",
          "word_slugs": [
            "california-name"
          ]
        },
        {
          "id": "876985",
          "text": "Cultivan naranjas en California.",
          "translation": "В Калифорнии выращивают апельсины.",
          "source": "Tatoeba #876985 @pisclis / #4372144 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/876985",
          "cefr_level": "A1",
          "word_slugs": [
            "california-name"
          ]
        },
        {
          "id": "2421371",
          "text": "Su esposa es de California.",
          "translation": "Ваша жена из Калифорнии.",
          "source": "Tatoeba #2421371 @Shishir / #4604047 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2421371",
