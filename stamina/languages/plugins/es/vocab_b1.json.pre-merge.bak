    {
      "slug": "instituto-noun",
      "lemma": "instituto",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2080,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "institute",
          "secondary school, senior school"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2140238",
          "text": "Tom dejó el instituto.",
          "translation": "Том бросил учёбу в институте.",
          "source": "Tatoeba #2140238 @Shishir / #2990277 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2140238",
          "cefr_level": "A1",
          "word_slugs": [
            "instituto-noun"
          ]
        },
        {
          "id": "6621949",
          "text": "Es un instituto bonito.",
          "translation": "Это красивый институт.",
          "source": "Tatoeba #6621949 @HAYACH / #6624748 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6621949",
          "cefr_level": "A1",
          "word_slugs": [
            "instituto-noun"
          ]
        },
        {
          "id": "4001347",
          "text": "Fui con él al instituto.",
          "translation": "Мы с ним вместе учились в институте.",
          "source": "Tatoeba #4001347 @Shishir / #4001359 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4001347",
          "cefr_level": "A1",
          "word_slugs": [
            "instituto-noun"
          ]
        },
        {
          "id": "4001348",
          "text": "Fui con ella al instituto.",
          "translation": "Мы с ней вместе учились в институте.",
          "source": "Tatoeba #4001348 @Shishir / #4001358 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4001348",
          "cefr_level": "A1",
          "word_slugs": [
            "instituto-noun"
          ]
        },
        {
          "id": "1686313",
          "text": "Eran novios en el instituto.",
          "translation": "В институтские годы они встречались.",
          "source": "Tatoeba #1686313 @Shishir / #5118270 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1686313",
          "cefr_level": "A1",
          "word_slugs": [
            "instituto-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "instituto",
        "plural": "",
        "infinitive": ""
      }
