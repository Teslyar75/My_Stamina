        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9936722",
          "text": "Instalan cámaras por todas partes.",
          "translation": "Они везде устанавливают камеры.",
          "source": "Tatoeba #9936722 @Shishir / #10368119 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936722",
          "cefr_level": "A1",
          "word_slugs": [
            "cámaras-noun"
          ]
        },
        {
          "id": "1279020",
          "text": "Yo tengo tres cámaras fotográficas.",
          "translation": "У меня три фотоаппарата.",
          "source": "Tatoeba #1279020 @marcelostockle / #550964 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1279020",
          "cefr_level": "A1",
          "word_slugs": [
            "cámaras-noun"
          ]
        },
        {
          "id": "1140369",
          "text": "Las cámaras no suelen captar la realidad.",
          "translation": "Камеры обычно не отражают реальность.",
          "source": "Tatoeba #1140369 @marcelostockle / #9767377 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1140369",
          "cefr_level": "A1",
          "word_slugs": [
            "cámaras-noun"
          ]
        }
      ],
