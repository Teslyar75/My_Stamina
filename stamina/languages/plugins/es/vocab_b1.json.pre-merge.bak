      "translations": {
        "en": [
          "social"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1476236",
          "text": "El hombre es un ser social.",
          "translation": "Человек - существо социальное.",
          "source": "Tatoeba #1476236 @marcelostockle / #2909306 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1476236",
          "cefr_level": "A1",
          "word_slugs": [
            "social-adj"
          ]
        },
        {
          "id": "4571213",
          "text": "Tatoeba no es una red social.",
