    {
      "slug": "haberlo-verb",
      "lemma": "haberlo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1344,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of haber combined with lo",
          "alternative form of habérselas"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1492055",
          "text": "Recuerdo haberlo visto.",
          "translation": "Я помню, что видел его.",
          "source": "Tatoeba #1492055 @marcelostockle / #3659445 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1492055",
          "cefr_level": "A1",
          "word_slugs": [
            "haberlo-verb"
          ]
        },
        {
          "id": "2754640",
          "text": "Recuerdo haberlo dicho.",
          "translation": "Я помню, что сказал это.",
          "source": "Tatoeba #2754640 @Shishir / #3640221 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2754640",
          "cefr_level": "A1",
          "word_slugs": [
            "haberlo-verb"
          ]
        },
        {
          "id": "1171024",
          "text": "Tom negó haberlo hecho.",
          "translation": "Том отрицал, что сделал это.",
          "source": "Tatoeba #1171024 @nancy / #3522158 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1171024",
          "cefr_level": "A1",
          "word_slugs": [
            "haberlo-verb"
          ]
        },
        {
          "id": "6670364",
          "text": "No debía haberlo hecho.",
          "translation": "Мне не следовало этого делать.",
          "source": "Tatoeba #6670364 @arh / #8776315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6670364",
          "cefr_level": "A1",
          "word_slugs": [
            "haberlo-verb"
          ]
        },
        {
          "id": "8026722",
          "text": "Fingiré no haberlo oído.",
          "translation": "Я сделаю вид, что этого не слышала.",
          "source": "Tatoeba #8026722 @Seael / #4971344 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8026722",
          "cefr_level": "A1",
          "word_slugs": [
            "haberlo-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
