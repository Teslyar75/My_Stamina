      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to walk",
          "to stroll",
          "to travel, to trek",
          "to go on"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "727833",
          "text": "Me gusta caminar.",
          "translation": "Мне нравится ходить пешком.",
          "source": "Tatoeba #727833 @Fanki / #6396027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/727833",
          "cefr_level": "A1",
          "word_slugs": [
            "caminar-verb"
          ]
        },
        {
          "id": "1955458",
          "text": "No puedo caminar.",
          "translation": "Я не могу ходить.",
          "source": "Tatoeba #1955458 @Shishir / #5286025 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1955458",
          "cefr_level": "A1",
          "word_slugs": [
            "caminar-verb"
          ]
        },
        {
          "id": "4009576",
          "text": "Empezamos a caminar.",
          "translation": "Мы зашагали.",
          "source": "Tatoeba #4009576 @alexmarcelo / #4171929 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4009576",
          "cefr_level": "A1",
          "word_slugs": [
            "caminar-verb"
          ]
        },
        {
          "id": "10738606",
          "text": "Tendremos que caminar.",
          "translation": "Нам придётся идти пешком.",
          "source": "Tatoeba #10738606 @megamanenm / #10738661 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10738606",
          "cefr_level": "A1",
          "word_slugs": [
            "caminar-verb"
          ]
        },
        {
          "id": "5036541",
          "text": "No puede caminar más.",
          "translation": "Он не может больше идти.",
          "source": "Tatoeba #5036541 @don_ramon / #5048238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5036541",
          "cefr_level": "A1",
          "word_slugs": [
            "caminar-verb"
          ]
        }
