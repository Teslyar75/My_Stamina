    {
      "slug": "sociedad-noun",
      "lemma": "sociedad",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1733,
      "frequency_band": "cervantes-b1",
      "translations": {
        "ru": [
          "общество"
        ],
        "en": [
          "society, social order",
          "high society",
          "community",
          "company, firm, corporation"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "9658487",
          "text": "Vivimos en una sociedad.",
          "translation": "Мы живём в обществе.",
          "source": "Tatoeba #9658487 @stormy_clau / #7958059 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9658487",
          "cefr_level": "A1",
          "word_slugs": [
            "sociedad-noun"
          ]
        },
        {
          "id": "1197365",
          "text": "Lo excluyeron de la sociedad.",
          "translation": "Его исключили из общества.",
          "source": "Tatoeba #1197365 @cariito / #4683879 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1197365",
          "cefr_level": "A1",
          "word_slugs": [
            "sociedad-noun"
          ]
        },
        {
          "id": "7556801",
          "text": "Los hombres forman una sociedad.",
          "translation": "Общество формируют люди.",
          "source": "Tatoeba #7556801 @ecorralest101 / #7528633 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7556801",
          "cefr_level": "A1",
          "word_slugs": [
            "sociedad-noun"
          ]
        },
        {
          "id": "610740",
          "text": "Vivimos en una sociedad civilizada.",
          "translation": "Мы живём в цивилизованном обществе.",
          "source": "Tatoeba #610740 @darinmex / #4661436 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/610740",
          "cefr_level": "A1",
          "word_slugs": [
            "sociedad-noun"
          ]
        },
        {
          "id": "855995",
          "text": "Vivimos en una sociedad democrática.",
          "translation": "Мы живём в демократическом обществе.",
          "source": "Tatoeba #855995 @opor / #1883491 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/855995",
          "cefr_level": "A1",
          "word_slugs": [
            "sociedad-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
