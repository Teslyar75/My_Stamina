    {
      "slug": "ira-noun",
      "lemma": "ira",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2423,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "initialism of insuficiencia renal aguda (“acute renal failure”): ARF"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1281493",
          "text": "Él temblaba de ira.",
          "translation": "Его трясло от гнева.",
          "source": "Tatoeba #1281493 @Shishir / #4003883 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1281493",
          "cefr_level": "A1",
          "word_slugs": [
            "ira-noun"
          ]
        },
        {
          "id": "584055",
          "text": "Él temblaba con ira.",
          "translation": "Его трясло от ярости.",
          "source": "Tatoeba #584055 @darinmex / #3651995 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/584055",
          "cefr_level": "A1",
          "word_slugs": [
            "ira-noun"
          ]
        },
        {
          "id": "3995556",
          "text": "Es difícil contener la ira.",
          "translation": "Трудно сдерживать гнев.",
          "source": "Tatoeba #3995556 @alexmarcelo / #3995742 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3995556",
          "cefr_level": "A1",
          "word_slugs": [
            "ira-noun"
          ]
        },
        {
          "id": "1160598",
          "text": "Él no podía hablar por la ira.",
          "translation": "От ярости он не мог говорить.",
          "source": "Tatoeba #1160598 @marcelostockle / #5956105 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1160598",
          "cefr_level": "A1",
          "word_slugs": [
            "ira-noun"
          ]
        },
        {
          "id": "1296654",
          "text": "Está decidido que él ira a América.",
          "translation": "Решено, что он поедет в Америку.",
          "source": "Tatoeba #1296654 @marcelostockle / #3267548 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1296654",
          "cefr_level": "A1",
          "word_slugs": [
            "ira-noun"
          ]
        }
      ],
