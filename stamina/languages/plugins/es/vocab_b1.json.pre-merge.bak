    {
      "slug": "dejamos-verb",
      "lemma": "dejamos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2340,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person plural present/preterite indicative of dejar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5051299",
          "text": "Les dejamos ganar.",
          "translation": "Мы дали им выиграть.",
          "source": "Tatoeba #5051299 @Shishir / #5286543 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5051299",
          "cefr_level": "A1",
          "word_slugs": [
            "dejamos-verb"
          ]
        },
        {
          "id": "1710966",
          "text": "Dejamos la puerta abierta.",
          "translation": "Мы оставили дверь открытой.",
          "source": "Tatoeba #1710966 @marcelostockle / #3661457 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1710966",
          "cefr_level": "A1",
          "word_slugs": [
            "dejamos-verb"
          ]
        },
        {
          "id": "3797354",
          "text": "Dejamos África para siempre.",
          "translation": "Мы навсегда уехали из Африки.",
          "source": "Tatoeba #3797354 @Seael / #3684527 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3797354",
          "cefr_level": "A1",
          "word_slugs": [
            "dejamos-verb"
          ]
        },
        {
          "id": "1193338",
          "text": "Si lo dejamos, morirá desangrado.",
          "translation": "Если мы его оставим, он умрёт от потери крови.",
          "source": "Tatoeba #1193338 @marcelostockle / #5173560 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1193338",
          "cefr_level": "A1",
          "word_slugs": [
            "dejamos-verb"
          ]
        },
        {
          "id": "1702000",
          "text": "Dejamos de amarnos a nosotros mismos cuando nadie nos ama.",
          "translation": "Мы перестаём любить себя, когда никто нас не любит.",
          "source": "Tatoeba #1702000 @teskmon / #3040956 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1702000",
          "cefr_level": "A1",
          "word_slugs": [
            "dejamos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "dejamos",
        "plural": "",
        "infinitive": "dejamos"
      }
