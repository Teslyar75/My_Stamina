          "word_slugs": [
            "jane-name"
          ]
        },
        {
          "id": "1207416",
          "text": "Ellos la llamaron Jane.",
          "translation": "Они назвали её Джейн.",
          "source": "Tatoeba #1207416 @marcelostockle / #2068604 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1207416",
          "cefr_level": "A1",
