        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3115461",
          "text": "Estaba dando un paseo.",
          "translation": "Я прогуливался.",
          "source": "Tatoeba #3115461 @Darukeru / #4149307 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3115461",
          "cefr_level": "A1",
