    {
      "slug": "debí-verb",
      "lemma": "debí",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1628,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "first-person singular preterite indicative of deber"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6670363",
          "text": "No debí hacerlo.",
          "translation": "Мне не стоило этого делать.",
          "source": "Tatoeba #6670363 @arh / #5408406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6670363",
          "cefr_level": "A1",
          "word_slugs": [
            "debí-verb"
          ]
        },
        {
          "id": "6670379",
          "text": "Nunca debí hacerlo.",
          "translation": "Мне вообще не стоило этого делать.",
          "source": "Tatoeba #6670379 @arh / #6366092 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6670379",
          "cefr_level": "A1",
          "word_slugs": [
            "debí-verb"
          ]
        },
        {
          "id": "581065",
          "text": "No debí estudiar ayer.",
          "translation": "Я не должен был учиться вчера.",
          "source": "Tatoeba #581065 @Eckhardtgabriel / #1436738 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/581065",
          "cefr_level": "A1",
          "word_slugs": [
            "debí-verb"
          ]
        },
        {
          "id": "5781876",
          "text": "Debí dejarle una nota.",
          "translation": "Мне надо было оставить ему записку.",
          "source": "Tatoeba #5781876 @MrMultilingual / #5782879 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5781876",
          "cefr_level": "A1",
          "word_slugs": [
            "debí-verb"
          ]
        },
        {
          "id": "5036509",
          "text": "Quizás no debí hacerlo.",
          "translation": "Наверное, мне не надо было этого делать.",
          "source": "Tatoeba #5036509 @don_ramon / #5048223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5036509",
          "cefr_level": "A1",
          "word_slugs": [
            "debí-verb"
          ]
        }
      ],
