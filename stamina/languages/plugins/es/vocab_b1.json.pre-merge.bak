    {
      "slug": "confiar-verb",
      "lemma": "confiar",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1202,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to reassure",
          "to be certain",
          "to trust",
          "to confide"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1935422",
          "text": "Podés confiar en mí.",
          "translation": "Можешь мне доверять.",
          "source": "Tatoeba #1935422 @hayastan / #4300409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1935422",
          "cefr_level": "A1",
          "word_slugs": [
            "confiar-verb"
          ]
        },
        {
          "id": "663654",
          "text": "Puedes confiar en él.",
          "translation": "Ты можешь ему доверять.",
          "source": "Tatoeba #663654 @darinmex / #1513636 @Aj (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/663654",
          "cefr_level": "A1",
          "word_slugs": [
            "confiar-verb"
          ]
        },
        {
          "id": "3195312",
          "text": "¿Puedo confiar en él?",
          "translation": "Я могу ему доверять?",
          "source": "Tatoeba #3195312 @Shishir / #3763214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3195312",
          "cefr_level": "A1",
          "word_slugs": [
            "confiar-verb"
          ]
        },
        {
          "id": "4558739",
          "text": "¿Podemos confiar en él?",
          "translation": "Мы можем ему доверять?",
          "source": "Tatoeba #4558739 @Shishir / #3066370 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4558739",
          "cefr_level": "A1",
          "word_slugs": [
            "confiar-verb"
          ]
        },
        {
          "id": "1917734",
          "text": "¿Podemos confiar en Tom?",
          "translation": "Мы можем доверять Тому?",
          "source": "Tatoeba #1917734 @Shishir / #5510343 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1917734",
          "cefr_level": "A1",
          "word_slugs": [
            "confiar-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el confiar",
