    {
      "slug": "romper-verb",
      "lemma": "romper",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1826,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to break",
          "to break up, terminate (a relationship, friendship etc.)",
          "to begin to do something; to break into",
          "to rupture"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1717409",
          "text": "Gracias por romper mi teléfono.",
          "translation": "Спасибо, что сломал мой телефон.",
          "source": "Tatoeba #1717409 @marcelostockle / #4865375 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1717409",
          "cefr_level": "A1",
          "word_slugs": [
            "romper-verb"
          ]
        },
        {
          "id": "542863",
          "text": "No debemos romper nuestra promesa.",
          "translation": "Мы не должны нарушать своего обещания.",
          "source": "Tatoeba #542863 @Shishir / #11556384 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/542863",
          "cefr_level": "A1",
          "word_slugs": [
            "romper-verb"
          ]
        },
        {
          "id": "12931060",
          "text": "No debemos romper nuestras promesas.",
          "translation": "Мы не должны нарушать своих обещаний.",
          "source": "Tatoeba #12931060 @samir_t / #12931068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12931060",
          "cefr_level": "A1",
          "word_slugs": [
            "romper-verb"
          ]
        },
        {
          "id": "1344777",
          "text": "¡Te vas a romper el cuello!",
          "translation": "Ты себе шею сломаешь!",
          "source": "Tatoeba #1344777 @Shishir / #6285873 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1344777",
          "cefr_level": "A1",
          "word_slugs": [
            "romper-verb"
          ]
        },
        {
          "id": "1330667",
          "text": "Ella le vio romper la ventana.",
          "translation": "Она видела, как он разбивает окно.",
          "source": "Tatoeba #1330667 @Shishir / #2659127 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1330667",
          "cefr_level": "A1",
          "word_slugs": [
            "romper-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el romper",
        "plural": "",
        "infinitive": "romper"
      }
