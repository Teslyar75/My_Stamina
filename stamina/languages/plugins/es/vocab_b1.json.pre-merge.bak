            "estupendo-adj"
          ]
        },
        {
          "id": "6766779",
          "text": "He pasado un día estupendo.",
          "translation": "У меня был отличный день.",
          "source": "Tatoeba #6766779 @arh / #6775781 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6766779",
