    {
      "slug": "complicado-adj",
      "lemma": "complicado",
      "pos": "adj",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2176,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "complicated, complex, convoluted, involved, tricky, difficult, elaborate, cumbersome",
          "messy, sticky, awkward (e.g. a messy breakup or divorce, a messy political dispute, an awkward or sticky situation)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2414115",
          "text": "No es complicado.",
          "translation": "Это не сложно.",
          "source": "Tatoeba #2414115 @hayastan / #4486647 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2414115",
          "cefr_level": "A1",
          "word_slugs": [
            "complicado-adj"
          ]
        },
        {
          "id": "2349277",
          "text": "Es muy complicado.",
          "translation": "Это очень сложно.",
          "source": "Tatoeba #2349277 @hayastan / #2824210 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2349277",
          "cefr_level": "A1",
          "word_slugs": [
            "complicado-adj"
          ]
        },
        {
          "id": "7682842",
          "text": "No parece complicado.",
          "translation": "Это вроде не сложно.",
          "source": "Tatoeba #7682842 @arh / #12914451 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7682842",
