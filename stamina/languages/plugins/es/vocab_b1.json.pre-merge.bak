    {
      "slug": "decírselo-verb",
      "lemma": "decírselo",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2425,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "infinitive of decir combined with indirect object le/les and direct object lo"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1974036",
          "text": "No podemos decírselo a Tom.",
          "translation": "Мы не можем сказать Тому.",
          "source": "Tatoeba #1974036 @marcelostockle / #3544769 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1974036",
          "cefr_level": "A1",
          "word_slugs": [
            "decírselo-verb"
          ]
        },
        {
          "id": "2129759",
          "text": "Prometió no decírselo a nadie.",
          "translation": "Он пообещал никому этого не говорить.",
          "source": "Tatoeba #2129759 @Shishir / #3892722 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2129759",
          "cefr_level": "A1",
          "word_slugs": [
            "decírselo-verb"
          ]
        },
        {
          "id": "3279155",
          "text": "Alguien debería decírselo a Tom.",
          "translation": "Кто-то должен рассказать Тому.",
          "source": "Tatoeba #3279155 @Shishir / #3701629 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3279155",
          "cefr_level": "A1",
          "word_slugs": [
            "decírselo-verb"
          ]
        },
        {
          "id": "2230111",
          "text": "Tom planeaba decírselo todo a Mary.",
          "translation": "Том планировал рассказать всё Мэри.",
          "source": "Tatoeba #2230111 @Shishir / #6933537 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2230111",
          "cefr_level": "A1",
          "word_slugs": [
            "decírselo-verb"
          ]
        },
        {
          "id": "834539",
          "text": "No tienes que decírselo a tus padres.",
          "translation": "Тебе необязательно говорить об этом родителям.",
          "source": "Tatoeba #834539 @LugoIlmer / #10606814 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/834539",
          "cefr_level": "A1",
          "word_slugs": [
            "decírselo-verb"
          ]
        }
      ],
