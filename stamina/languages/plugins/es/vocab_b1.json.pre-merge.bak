          "cefr_level": "A1",
          "word_slugs": [
            "techo-verb"
          ]
        },
        {
          "id": "3881523",
          "text": "Miles quedaron sin techo.",
          "translation": "Тысячи остались без крова.",
          "source": "Tatoeba #3881523 @cueyayotl / #2191602 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3881523",
          "cefr_level": "A1",
          "word_slugs": [
            "techo-verb"
          ]
        },
        {
          "id": "1718195",
          "text": "Tom se bajó del techo.",
          "translation": "Том спустился с крыши.",
          "source": "Tatoeba #1718195 @marcelostockle / #4992509 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1718195",
          "cefr_level": "A1",
