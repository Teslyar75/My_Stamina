    {
      "slug": "tengamos-verb",
      "lemma": "tengamos",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2149,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "inflection of tener:",
          "first-person plural present subjunctive",
          "inflection of tener:",
          "first-person plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8075872",
          "text": "No creo que tengamos opción.",
          "translation": "Не думаю, что у нас есть выбор.",
          "source": "Tatoeba #8075872 @Goatstein / #12107917 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8075872",
          "cefr_level": "A1",
          "word_slugs": [
            "tengamos-verb"
          ]
        },
        {
          "id": "13660174",
          "text": "Tal vez no tengamos elección.",
          "translation": "У нас, может быть, не будет выбора.",
          "source": "Tatoeba #13660174 @Seael / #13660194 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13660174",
          "cefr_level": "A1",
          "word_slugs": [
            "tengamos-verb"
          ]
        },
        {
          "id": "13660175",
          "text": "Puede que no tengamos elección.",
          "translation": "У нас может не быть выбора.",
          "source": "Tatoeba #13660175 @Seael / #13660193 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13660175",
          "cefr_level": "A1",
          "word_slugs": [
            "tengamos-verb"
          ]
        },
        {
          "id": "2943246",
          "text": "No creo que tengamos mucho tiempo.",
          "translation": "Я не думаю, что у нас много времени.",
          "source": "Tatoeba #2943246 @hayastan / #4925154 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2943246",
          "cefr_level": "A1",
          "word_slugs": [
            "tengamos-verb"
          ]
        },
        {
          "id": "6843406",
          "text": "Espero que tengamos buen tiempo mañana.",
          "translation": "Надеюсь, завтра нас ждёт хорошая погода.",
          "source": "Tatoeba #6843406 @arh / #8095155 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843406",
          "cefr_level": "A1",
          "word_slugs": [
            "tengamos-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "tengamos",
        "plural": "",
        "infinitive": "tengamos"
      }
