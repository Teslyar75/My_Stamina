        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2253467",
          "text": "Tengo una sensación rara.",
          "translation": "У меня странное чувство.",
          "source": "Tatoeba #2253467 @carlosalberto / #13381689 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2253467",
          "cefr_level": "A1",
          "word_slugs": [
            "sensación-noun"
          ]
        },
        {
          "id": "7872826",
          "text": "Yo también tengo esa sensación.",
          "translation": "У меня тоже такое чувство.",
          "source": "Tatoeba #7872826 @arh / #3175701 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7872826",
          "cefr_level": "A1",
          "word_slugs": [
            "sensación-noun"
          ]
        },
        {
          "id": "3885677",
          "text": "Me sobrecogió una sensación extraña.",
          "translation": "Меня охватило странное чувство.",
          "source": "Tatoeba #3885677 @gianich73 / #3885666 @bijin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3885677",
          "cefr_level": "A1",
          "word_slugs": [
            "sensación-noun"
          ]
        },
        {
          "id": "6862097",
          "text": "Yo también tengo una sensación similar.",
          "translation": "У меня такое же чувство.",
          "source": "Tatoeba #6862097 @arh / #6880359 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6862097",
          "cefr_level": "A1",
          "word_slugs": [
            "sensación-noun"
          ]
        },
        {
          "id": "3098744",
          "text": "La sensación de seguridad es el peor enemigo.",
          "translation": "Ощущение безопасности — самый худший враг.",
          "source": "Tatoeba #3098744 @marcelostockle / #5640783 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3098744",
          "cefr_level": "A1",
          "word_slugs": [
            "sensación-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
