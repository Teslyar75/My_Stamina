        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5157400",
          "text": "Mirá mis dedos.",
          "translation": "Смотри на мои пальцы.",
          "source": "Tatoeba #5157400 @don_ramon / #13878485 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5157400",
