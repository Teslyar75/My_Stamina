      "gender": null,
      "examples": [
        {
          "id": "1468366",
          "text": "Trata de encontrarlo.",
          "translation": "Постарайся найти его.",
          "source": "Tatoeba #1468366 @marcelostockle / #5601272 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1468366",
