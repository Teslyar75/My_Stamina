    {
      "slug": "habló-verb",
      "lemma": "habló",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1783,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "third-person singular preterite indicative of hablar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4364131",
          "text": "¿Te habló Tom?",
          "translation": "Том говорил с тобой?",
          "source": "Tatoeba #4364131 @pchamorro / #3988132 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4364131",
          "cefr_level": "A1",
          "word_slugs": [
            "habló-verb"
          ]
        },
        {
          "id": "2258460",
          "text": "Habló muy bien.",
          "translation": "Он очень хорошо говорил.",
          "source": "Tatoeba #2258460 @carlosalberto / #5556950 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2258460",
          "cefr_level": "A1",
          "word_slugs": [
            "habló-verb"
          ]
        },
        {
          "id": "6056853",
          "text": "Habló de música.",
          "translation": "Он говорил о музыке.",
          "source": "Tatoeba #6056853 @Ricardo14 / #3258495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6056853",
          "cefr_level": "A1",
          "word_slugs": [
            "habló-verb"
          ]
        },
        {
          "id": "2077814",
          "text": "Así habló Zarathustra.",
          "translation": "Так говорил Заратустра.",
          "source": "Tatoeba #2077814 @marcelostockle / #430531 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2077814",
          "cefr_level": "A1",
          "word_slugs": [
            "habló-verb"
          ]
        },
        {
          "id": "2002598",
          "text": "Él habló de paz.",
          "translation": "Он говорил о мире.",
          "source": "Tatoeba #2002598 @marcelostockle / #5472543 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2002598",
          "cefr_level": "A1",
          "word_slugs": [
            "habló-verb"
          ]
        }
      ],
