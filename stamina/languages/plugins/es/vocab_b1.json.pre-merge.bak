    {
      "slug": "compartir-verb",
      "lemma": "compartir",
      "pos": "verb",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2137,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "to share",
          "to split, to divide (in order to share)",
          "to pool (e.g. resources)",
          "to compartmentalize"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4951352",
          "text": "Gracias por compartir.",
          "translation": "Спасибо, что поделились.",
          "source": "Tatoeba #4951352 @DarkHollow / #5341696 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4951352",
          "cefr_level": "A1",
          "word_slugs": [
            "compartir-verb"
          ]
        },
        {
          "id": "4506672",
          "text": "Gracias por compartir esto conmigo.",
          "translation": "Спасибо, что поделились этим со мной.",
          "source": "Tatoeba #4506672 @marcelostockle / #4506676 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4506672",
          "cefr_level": "A1",
          "word_slugs": [
            "compartir-verb"
          ]
        },
        {
          "id": "13495967",
          "text": "Mary rechazó compartir la habitación con Tom.",
          "translation": "Мэри отказалась жить в одной комнате с Томом.",
          "source": "Tatoeba #13495967 @Shishir / #13495987 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495967",
          "cefr_level": "A1",
          "word_slugs": [
            "compartir-verb"
          ]
        },
        {
          "id": "10544288",
          "text": "No me gusta compartir mis recetas con nadie.",
          "translation": "Я не люблю ни с кем делиться своими рецептами.",
          "source": "Tatoeba #10544288 @Seael / #12918422 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10544288",
          "cefr_level": "A1",
          "word_slugs": [
            "compartir-verb"
          ]
        },
        {
          "id": "1904260",
          "text": "Tuvo que compartir una habitación con su hermana.",
          "translation": "Ей пришлось делить комнату с сестрой.",
          "source": "Tatoeba #1904260 @Shishir / #3543264 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1904260",
          "cefr_level": "A1",
          "word_slugs": [
            "compartir-verb"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": "m",
        "singular": "el compartir",
        "plural": "",
        "infinitive": "compartir"
      }
    },
    {
      "slug": "saca-noun",
      "lemma": "saca",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2138,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "removal, extraction",
          "exportation",
          "certified or notarized copy of a document"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7654401",
          "text": "Saca la basura.",
          "translation": "Вынеси мусор.",
          "source": "Tatoeba #7654401 @Shishir / #3694490 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7654401",
          "cefr_level": "A1",
          "word_slugs": [
            "saca-noun"
          ]
        },
        {
          "id": "5375103",
          "text": "Saca el vendaje.",
          "translation": "Снимите повязку.",
          "source": "Tatoeba #5375103 @albrusgher / #894829 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5375103",
          "cefr_level": "A1",
          "word_slugs": [
            "saca-noun"
          ]
        },
        {
          "id": "6814623",
          "text": "Saca esa silla plegable.",
          "translation": "Вытащи этот складной стул.",
          "source": "Tatoeba #6814623 @arh / #6814774 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6814623",
          "cefr_level": "A1",
          "word_slugs": [
            "saca-noun"
          ]
        },
        {
          "id": "13485153",
          "text": "Un clavo saca otro clavo.",
          "translation": "Клин клином выбивают.",
          "source": "Tatoeba #13485153 @Seael / #404661 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13485153",
          "cefr_level": "A1",
          "word_slugs": [
            "saca-noun"
          ]
        },
        {
          "id": "3666594",
          "text": "Por favor, saca la lengua.",
          "translation": "Покажи язык, пожалуйста.",
          "source": "Tatoeba #3666594 @Seael / #14058405 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3666594",
          "cefr_level": "A1",
          "word_slugs": [
            "saca-noun"
          ]
        }
      ],
      "tags": [
