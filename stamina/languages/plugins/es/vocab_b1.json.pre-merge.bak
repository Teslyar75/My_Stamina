    {
      "slug": "vos-pron",
      "lemma": "vos",
      "pos": "pron",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 1351,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "you, familiar form of the second-person singular pronoun"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1769201",
          "text": "Voy con vos.",
          "translation": "Я иду с тобой.",
          "source": "Tatoeba #1769201 @hayastan / #1866654 @estong (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1769201",
          "cefr_level": "A1",
          "word_slugs": [
            "vos-pron"
          ]
        },
        {
          "id": "1649298",
          "text": "¿Vos sos árabe?",
          "translation": "Ты араб?",
          "source": "Tatoeba #1649298 @alexmarcelo / #2943392 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1649298",
          "cefr_level": "A1",
          "word_slugs": [
            "vos-pron"
          ]
        },
        {
          "id": "2108903",
          "text": "Depende de vos.",
          "translation": "Зависит от тебя.",
          "source": "Tatoeba #2108903 @hayastan / #4477581 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2108903",
          "cefr_level": "A1",
          "word_slugs": [
            "vos-pron"
          ]
        },
        {
          "id": "5138798",
          "text": "Vos sabés cómo.",
          "translation": "Ты знаешь как.",
          "source": "Tatoeba #5138798 @don_ramon / #2521291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5138798",
          "cefr_level": "A1",
          "word_slugs": [
            "vos-pron"
          ]
        },
        {
          "id": "1058213",
          "text": "Moriría por vos.",
          "translation": "Я бы умер за тебя.",
          "source": "Tatoeba #1058213 @hayastan / #2934416 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1058213",
          "cefr_level": "A1",
          "word_slugs": [
