    {
      "slug": "inteligencia-noun",
      "lemma": "inteligencia",
      "pos": "noun",
      "language": "es",
      "cefr_level": "B1",
      "frequency_rank": 2225,
      "frequency_band": "cervantes-b1",
      "translations": {
        "en": [
          "intelligence"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2259133",
          "text": "Tiene una inteligencia muy ágil.",
          "translation": "У неё очень быстрый интеллект.",
          "source": "Tatoeba #2259133 @cueyayotl / #2746601 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259133",
          "cefr_level": "A1",
          "word_slugs": [
            "inteligencia-noun"
          ]
        },
        {
          "id": "576663",
          "text": "IA quiere decir Inteligencia Artificial.",
          "translation": "ИИ означает \"искусственный интеллект\".",
          "source": "Tatoeba #576663 @Shishir / #2150745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/576663",
          "cefr_level": "A1",
          "word_slugs": [
            "inteligencia-noun"
          ]
        },
        {
          "id": "5560307",
          "text": "La estupidez es una falta de inteligencia.",
          "translation": "Глупость — это нехватка ума.",
          "source": "Tatoeba #5560307 @albrusgher / #5504292 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5560307",
          "cefr_level": "A1",
          "word_slugs": [
            "inteligencia-noun"
          ]
        },
        {
          "id": "3983283",
          "text": "Nunca ha brillado por su inteligencia, digámoslo.",
          "translation": "Он, так скажем, никогда не блистал умом.",
          "source": "Tatoeba #3983283 @gianich73 / #3983287 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3983283",
          "cefr_level": "A1",
          "word_slugs": [
            "inteligencia-noun"
          ]
        },
        {
          "id": "864807",
          "text": "La creencia es la muerte de la inteligencia.",
          "translation": "Вера — это смерть разума.",
          "source": "Tatoeba #864807 @Dasmandr / #5063836 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/864807",
          "cefr_level": "A1",
          "word_slugs": [
            "inteligencia-noun"
          ]
        }
      ],
      "tags": [
        "B1"
      ],
      "source": "Kaikki es (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "spanish": {
        "gender": null,
        "singular": "inteligencia",
        "plural": "",
        "infinitive": ""
      }
