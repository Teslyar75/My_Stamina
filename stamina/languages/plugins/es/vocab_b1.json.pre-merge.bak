      },
      "gender": null,
      "examples": [
        {
          "id": "1165774",
          "text": "Tome esta aspirina.",
          "translation": "Примите этот аспирин.",
          "source": "Tatoeba #1165774 @marcelostockle / #9965109 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1165774",
