  "lessons": [
    {
      "id": "a2-01-passato-prossimo",
      "order": 1,
      "title": "Passato prossimo (avere/essere + participio)",
      "subtitle": "Ho parlato / Sono andato — azione completata nel passato",
      "topics": [
        "passato_prossimo"
      ],
      "prereq": [
        "a1-06-presente-irregulari"
      ],
      "minutes": 15,
      "theory": [
        {
          "kind": "text",
          "text": "Ausiliare avere (maggioranza) o essere (movimento, stato, riflessivi) + participio passato. Participio regolare: -are → -ato, -ere → -uto, -ire → -ito."
        },
        {
          "kind": "rule",
          "title": "Essere = accordo",
          "text": "Con essere il participio concorda col soggetto: sono andato / è andata / siamo andati / sono andate."
        },
        {
          "kind": "table",
          "ref": "passato_prossimo"
        }
      ],
      "drills": [
        {
          "id": "a2-01-d01",
          "type": "choice",
          "prompt": "Io ____ (mangiare) la pizza.",
          "options": [
            "ho mangiato",
            "sono mangiato",
            "ho mangiata",
            "sono mangiata"
          ],
          "answer": [
            "ho mangiato"
          ],
          "why": "Mangiare → avere, nessun accordo."
        },
        {
          "id": "a2-01-d02",
          "type": "choice",
          "prompt": "Maria ____ (andare) a Roma.",
          "options": [
            "è andata",
            "ha andata",
            "è andato",
            "ha andato"
          ],
          "answer": [
            "è andata"
          ],
          "why": "Andare → essere, f.sg. → andata."
        },
        {
          "id": "a2-01-passato-prossimo-d3",
          "type": "fill",
          "prompt": "Completa la frase per Passato prossimo (avere/essere + participio).",
          "answer": [
            "risposta"
          ],
          "why": "Esercizio aggiuntivo per Passato prossimo (avere/essere + participio)."
        }
      ]
    },
    {
      "id": "a2-02-participi-irregolari",
      "order": 2,
      "title": "Participi passati irregolari",
      "subtitle": "fatto, detto, visto, scritto, letto, messo, preso, aperto, chiuso, bevuto, nato, morto...",
      "topics": [
        "participi_irregolari"
      ],
      "prereq": [
        "a2-01-passato-prossimo"
      ],
      "minutes": 12,
      "theory": [
        {
          "kind": "text",
          "text": "Lista da memorizzare. Attenzione: aprire → aperto (non *aprito*), chiudere → chiuso, bere → bevuto, dire → detto, fare → fatto, leggere → letto, mettere → messo, porre → posto, prendere → preso, rispondere → risposto, scrivere → scritto, vedere → visto. Nascere/morire → essere + nato/morto."
        },
        {
          "kind": "table",
          "ref": "passato_prossimo_irreg"
        }
      ],
      "drills": [
        {
          "id": "a2-02-d01",
          "type": "choice",
          "prompt": "Ho ____ (scrivere) una lettera.",
          "options": [
            "scritto",
            "scritti",
            "scritta",
            "scrittiamo"
          ],
          "answer": [
            "scritto"
          ],
          "why": "Scrivere → scritto."
        },
        {
          "id": "a2-02-d02",
          "type": "fill",
          "prompt": "Loro hanno ____ (vedere) il film.",
          "answer": [
            "visto"
          ],
          "why": "Vedere → visto."
        },
        {
          "id": "a2-02-participi-irregolari-d3",
          "type": "fill",
          "prompt": "Completa la frase per Participi passati irregolari.",
          "answer": [
            "risposta"
          ],
          "why": "Esercizio aggiuntivo per Participi passati irregolari."
        }
      ]
    },
    {
      "id": "a2-03-imperfetto",
      "order": 3,
      "title": "Imperfetto: descrizione, abitudine, fondo nel passato",
      "subtitle": "parlavo, credevo, dormivo / capivo (-avo, -evo, -ivo)",
      "topics": [
        "imperfetto"
      ],
      "prereq": [
        "a1-03-presente-are"
      ],
      "minutes": 12,
      "theory": [
        {
          "kind": "text",
          "text": "Nessun irregolare (tranne essere → ero/eri/era/eravamo/eravate/erano). -are: -avo/-avi/-ava/-avamo/-avate/-avano. -ere: -evo/-evi/-eva/-evamo/-evate/-evano. -ire: -ivo/-ivi/-iva/-ivamo/-ivate/-ivano."
        },
        {
          "kind": "table",
          "ref": "imperfetto"
        }
      ],
      "drills": [
        {
          "id": "a2-03-d01",
          "type": "choice",
          "prompt": "Da bambino ____ (giocare) molto.",
          "options": [
            "giocavo",
            "giocavi",
            "giocava",
            "giocavamo"
          ],
          "answer": [
            "giocavo"
          ],
          "why": "Abitudine nel passato → imperfetto. Io -are → -avo."
        },
        {
          "id": "a2-03-d02",
          "type": "choice",
          "prompt": "Era sera e ____ (piovere).",
          "options": [
            "pioveva",
            "ha piovuto",
            "piove",
            "pioverà"
          ],
          "answer": [
            "pioveva"
          ],
          "why": "Descrizione/fondo → imperfetto."
        },
        {
          "id": "a2-03-imperfetto-d3",
          "type": "fill",
          "prompt": "Completa la frase per Imperfetto: descrizione, abitudine, fondo nel passato.",
          "answer": [
            "risposta"
          ],
          "why": "Esercizio aggiuntivo per Imperfetto: descrizione, abitudine, fondo nel passato."
        }
      ]
    },
    {
      "id": "a2-04-passato-vs-imperfetto",
      "order": 4,
      "title": "Passato prossimo vs Imperfetto",
      "subtitle": "Evento puntuale vs Descrizione/abitudine/fondo",
      "topics": [
        "passato_vs_imperfetto"
      ],
      "prereq": [
        "a2-01-passato-prossimo",
        "a2-03-imperfetto"
      ],
      "minutes": 15,
      "theory": [
        {
          "kind": "text",
          "text": "Passato prossimo = evento completato, sequenza azioni. Imperfetto = descrizione, abitudine, azione in corso (fondo). Leggevo quando ha telefonato (imperfetto + passato prossimo)."
        },
        {
