    {
      "id": "a2-07-pronomi-oggetto",
      "order": 7,
      "title": "Pronomi oggetto: COD, CI, CIO, ne, ci",
      "subtitle": "lo/la/li/le, mi/ti/ci/vi, gli/le, ne, ci — ordine e glielo",
      "topics": [
        "pronomi_oggetto"
      ],
      "prereq": [
        "a1-02-essere-avere"
      ],
      "minutes": 15,
      "theory": [
        {
          "kind": "text",
          "text": "COD (lo/la/li/le) prima del verbo. CI (mi/ti/ci/vi). CIO (gli/le). gli/le + lo/la/li/le → glielo/gliela/glieli/gliele (MAI *gli lo*). Ne = partitivo (ne ho due). Ci = locativo (ci vado)."
        },
        {
          "kind": "rule",
          "title": "Ordine (negativo)",
          "text": "non + mi/ti/ci/vi → gli/le → lo/la/li/le → ne/ci + verbo. Non me lo dai. Non glielo dare."
        },
        {
          "kind": "rule",
          "title": "Ordine (affermativo imperativo)",
          "text": "Verbo + pronomi (connessi): Dammi! Daglielo! Dammelo!"
        },
        {
          "kind": "table",
          "ref": "pronomi_oggetto"
        }
      ],
      "drills": [
        {
          "id": "a2-07-d01",
          "type": "choice",
          "prompt": "Il libro? Marco ____ (dare) a Lucia.",
          "options": [
            "glielo dà",
            "gli lo dà",
            "lo gli dà",
            "lo dà"
          ],
          "answer": [
            "glielo dà"
          ],
          "why": "Gli (CI) + lo (COD) → glielo."
        },
        {
          "id": "a2-07-d02",
          "type": "fill",
          "prompt": "____ (dare + mi + lo)!",
          "answer": [
            "Dammelo"
          ],
          "why": "Imperativo affermativo: verbo + pronomi."
        },
        {
          "id": "a2-07-pronomi-oggetto-d3",
          "type": "fill",
          "prompt": "Completa la frase per Pronomi oggetto: COD, CI, CIO, ne, ci.",
          "answer": [
            "risposta"
          ],
          "why": "Esercizio aggiuntivo per Pronomi oggetto: COD, CI, CIO, ne, ci."
        }
      ]
    },
