{
  "version": 1,
  "level": "A1",
  "lessons": [
    {
      "id": "a1-01-articoli",
      "order": 1,
      "title": "Articoli determinativi e indeterminativi",
      "subtitle": "il, lo, la, l', i, gli, le / un, uno, una, un'",
      "topics": [
        "articoli"
      ],
      "prereq": [],
      "minutes": 12,
      "theory": [
        {
          "kind": "text",
          "text": "Determinativo: il (m.sg. cons.), lo (m.sg. s+cons/z/gn/ps/pn/x/y), la (f.sg. cons.), l' (vocale). Plurale: i, gli, le."
        },
        {
          "kind": "rule",
          "title": "Indeterminativo",
          "text": "un (m.sg. cons.), uno (m.sg. s+cons/z/gn/ps/pn/x/y), una (f.sg. cons.), un' (f.sg. vocale)."
        },
        {
          "kind": "table",
          "ref": "articles_definite"
        },
        {
          "kind": "table",
          "ref": "articles_indefinite"
        }
      ],
      "drills": [
        {
          "id": "a1-01-d01",
          "type": "choice",
          "prompt": "____ zaino è rosso.",
          "options": [
            "Lo",
            "Il",
            "La",
            "L'"
          ],
          "answer": [
            "Lo"
          ],
          "why": "zaino = m.sg. con s+cons → lo."
        },
        {
          "id": "a1-01-d02",
          "type": "choice",
          "prompt": "Ho comprato ____ libro.",
          "options": [
            "un",
            "uno",
            "una",
            "un'"
          ],
          "answer": [
            "un"
          ],
          "why": "libro = m.sg. cons. → un."
        },
        {
          "id": "a1-01-d03",
          "type": "fill",
          "prompt": "____ amica è simpatica.",
          "answer": [
            "L'"
          ],
          "why": "amica = f.sg. vocale → l'."
        }
      ]
    },
    {
      "id": "a1-02-essere-avere",
      "order": 2,
      "title": "Essere e Avere",
      "subtitle": "Due verbi fondamentali",
      "topics": [
        "essere_avere"
      ],
      "prereq": [
        "a1-01-articoli"
      ],
      "minutes": 12,
      "theory": [
        {
          "kind": "text",
          "text": "Essere = identità, stato, descrizione. Avere = possesso, età, sensazioni fisiche (ho fame, ho sonno)."
        },
        {
          "kind": "table",
          "ref": "essere_avere_present"
        }
      ],
      "drills": [
        {
          "id": "a1-02-d01",
          "type": "choice",
          "prompt": "Io ____ 25 anni.",
          "options": [
            "ho",
            "sono",
            "hai",
            "sei"
          ],
          "answer": [
            "ho"
          ],
          "why": "Età → avere (ho 25 anni)."
        },
        {
          "id": "a1-02-d02",
          "type": "choice",
          "prompt": "Maria ____ italiana.",
          "options": [
            "è",
            "ha",
            "siamo",
            "siete"
          ],
          "answer": [
            "è"
          ],
          "why": "Nazionalità → essere."
        },
        {
          "id": "a1-02-d03",
          "type": "fill",
          "prompt": "Noi ____ studenti. (essere)",
          "answer": [
            "siamo"
          ],
          "why": "Noi siamo = мы есть/являемся. Глагол essere для идентификации."
        }
      ]
    },
    {
      "id": "a1-03-presente-are",
      "order": 3,
      "title": "Presente: verbi in -are (parlare)",
      "subtitle": "parlo, parli, parla, parliamo, parlate, parlano",
      "topics": [
        "presente_are"
      ],
      "prereq": [
        "a1-02-essere-avere"
      ],
      "minutes": 10,
      "theory": [
        {
          "kind": "text",
          "text": "Radice parl- + desinenze: -o, -i, -a, -iamo, -ate, -ano. Nessuna irregolarità."
        },
        {
          "kind": "table",
          "ref": "present_are"
        }
      ],
      "drills": [
        {
          "id": "a1-03-d01",
          "type": "choice",
          "prompt": "Noi ____ (parlare) italiano.",
          "options": [
            "parliamo",
            "parlate",
            "parlano",
            "parlo"
          ],
          "answer": [
            "parliamo"
          ],
          "why": "Noi → -iamo."
        },
        {
          "id": "a1-03-d02",
          "type": "fill",
          "prompt": "Loro ____ (studiare) molto.",
          "answer": [
            "studiano"
          ],
          "why": "Loro studiano - 3-е лицо множественное число -are."
        },
        {
          "id": "a1-03-d03",
          "type": "choice",
          "prompt": "Io ____ (lavorare) qui.",
          "options": [
            "lavoro",
            "lavori",
            "lavora",
            "lavorano"
          ],
          "answer": [
            "lavoro"
          ],
          "why": "Io lavoro - 1-е лицо единственного числа -are."
        }
      ]
    },
    {
      "id": "a1-04-presente-ere",
      "order": 4,
      "title": "Presente: verbi in -ere (credere, temere)",
      "subtitle": "credo, credi, crede, crediamo, credete, credono",
      "topics": [
        "presente_ere"
      ],
      "prereq": [
        "a1-03-presente-are"
      ],
      "minutes": 10,
      "theory": [
        {
          "kind": "text",
          "text": "Radice cred- + desinenze: -o, -i, -e, -iamo, -ete, -ono. Attenzione: 1ª sg. credo (non *creddo*)."
        },
        {
          "kind": "table",
          "ref": "present_ere"
        }
      ],
      "drills": [
        {
          "id": "a1-04-d01",
          "type": "choice",
          "prompt": "Loro ____ (credere) in te.",
          "options": [
            "credono",
            "credete",
            "credi",
            "credo"
          ],
          "answer": [
            "credono"
          ],
          "why": "Loro → -ono."
        },
        {
          "id": "a1-04-d02",
          "type": "fill",
          "prompt": "Io ____ (leggere) un libro.",
          "answer": [
            "leggo"
          ],
          "why": "Io leggo - 1-е лицо единственного числа -ere (исключение: leggere -> leggo)."
        },
        {
          "id": "a1-04-d03",
          "type": "choice",
          "prompt": "Voi ____ (scrivere) una lettera.",
          "options": [
            "scrivete",
            "scrivono",
            "scrive",
            "scrivo"
          ],
          "answer": [
            "scrivete"
          ],
          "why": "Voi scrivete - 2-е лицо множественного числа -ere."
        }
      ]
    },
    {
      "id": "a1-05-presente-ire",
      "order": 5,
      "title": "Presente: verbi in -ire (dormire vs capire)",
      "subtitle": "dormo/dormi/dorme vs capisco/capisci/capisce",
      "topics": [
        "presente_ire"
      ],
      "prereq": [
        "a1-04-presente-ere"
      ],
      "minutes": 12,
      "theory": [
        {
          "kind": "text",
          "text": "Due gruppi: 1) dormire → dormo, dormi, dorme, dormiamo, dormite, dormono. 2) capire (e finire, preferire, pulire...) → capisco, capisci, capisce, capiamo, capite, capiscono (-isc- in 1/2/3 sg e 3 pl)."
        },
        {
          "kind": "table",
          "ref": "present_ire"
        }
      ],
      "drills": [
        {
          "id": "a1-05-d01",
          "type": "choice",
          "prompt": "Tu ____ (capire) l'italiano.",
          "options": [
            "capisci",
            "capisco",
            "capisce",
            "capite"
          ],
          "answer": [
            "capisci"
          ],
          "why": "Tu → -isci (gruppo -isc-)."
        },
        {
          "id": "a1-05-d02",
          "type": "choice",
          "prompt": "Noi ____ (dormire) bene.",
          "options": [
            "dormiamo",
            "dormite",
            "dormono",
            "dormisco"
          ],
          "answer": [
            "dormiamo"
          ],
          "why": "Noi → -iamo (gruppo senza -isc-)."
        },
        {
          "id": "a1-05-d3",
          "type": "choice",
          "prompt": "Noi ____ (dormire) bene.",
          "options": [
            "dormiamo",
            "dormite",
            "dormono",
            "dormi"
          ],
          "answer": [
            "dormiamo"
          ],
          "why": "Noi dormiamo - 1-е лицо множественного числа -ire."
        }
      ]
    },
    {
