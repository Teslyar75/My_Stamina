    {
      "slug": "baffi-noun",
      "lemma": "baffi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5592,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11530683",
          "text": "I baffi ti donano.",
          "translation": "Тебе идут усы.",
          "source": "Tatoeba #11530683 @dnnywld / #10776133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11530683",
          "cefr_level": "A1",
          "word_slugs": [
            "baffi-noun"
          ]
        },
        {
          "id": "11530688",
          "text": "I baffi mi donano?",
          "translation": "Мне идут усы?",
          "source": "Tatoeba #11530688 @dnnywld / #10776138 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11530688",
          "cefr_level": "A1",
          "word_slugs": [
            "baffi-noun"
          ]
        },
        {
          "id": "11530682",
          "text": "I baffi ti stanno bene.",
          "translation": "Тебе идут усы.",
          "source": "Tatoeba #11530682 @dnnywld / #10776133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11530682",
          "cefr_level": "A1",
          "word_slugs": [
            "baffi-noun"
          ]
        },
        {
          "id": "11530686",
          "text": "Le stanno bene i baffi.",
          "translation": "Вам идут усы.",
          "source": "Tatoeba #11530686 @dnnywld / #10776134 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11530686",
          "cefr_level": "A1",
          "word_slugs": [
            "baffi-noun"
          ]
        },
        {
          "id": "5527632",
          "text": "Lui si fa crescere i baffi.",
          "translation": "Он отращивает усы.",
          "source": "Tatoeba #5527632 @dnnywld / #5527492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527632",
          "cefr_level": "A1",
          "word_slugs": [
            "baffi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
