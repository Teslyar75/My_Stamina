      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10867106",
          "text": "Guarda di non organizzare fuochi.",
          "translation": "Смотри пожар не устрой.",
          "source": "Tatoeba #10867106 @dnnywld / #10865274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10867106",
          "cefr_level": "A1",
