    {
      "slug": "inevitabile-adj",
      "lemma": "inevitabile",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6811,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6891174",
          "text": "Temo che sia inevitabile.",
          "translation": "Боюсь, это неизбежно.",
          "source": "Tatoeba #6891174 @dnnywld / #4308040 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891174",
          "cefr_level": "A1",
          "word_slugs": [
            "inevitabile-adj"
          ]
        },
        {
          "id": "2604843",
          "text": "Il progresso è inevitabile.",
          "translation": "Прогресс неизбежен.",
          "source": "Tatoeba #2604843 @Guybrush88 / #2604852 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2604843",
          "cefr_level": "A1",
          "word_slugs": [
            "inevitabile-adj"
          ]
        },
        {
          "id": "1645428",
          "text": "La guerra non è inevitabile.",
          "translation": "Война не является неизбежностью.",
          "source": "Tatoeba #1645428 @Guybrush88 / #701646 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1645428",
          "cefr_level": "A1",
          "word_slugs": [
            "inevitabile-adj"
          ]
        },
        {
          "id": "14053037",
          "text": "Vuoi dire che è inevitabile?",
          "translation": "Ты хочешь сказать, что это неизбежно?",
          "source": "Tatoeba #14053037 @dnnywld / #14052826 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14053037",
          "cefr_level": "A1",
          "word_slugs": [
            "inevitabile-adj"
          ]
        },
        {
          "id": "10851636",
          "text": "Di fatto, la bancarotta è inevitabile.",
          "translation": "Фактически, банкротство неизбежно.",
          "source": "Tatoeba #10851636 @dnnywld / #4542517 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851636",
          "cefr_level": "A1",
          "word_slugs": [
            "inevitabile-adj"
          ]
        }
