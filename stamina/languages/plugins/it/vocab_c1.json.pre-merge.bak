    {
      "slug": "cercherò-verb",
      "lemma": "cercherò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5886,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10881937",
          "text": "Cercherò di proteggervi.",
          "translation": "Я постараюсь вас защитить.",
          "source": "Tatoeba #10881937 @dnnywld / #8043387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10881937",
          "cefr_level": "A1",
          "word_slugs": [
            "cercherò-verb"
          ]
        },
        {
          "id": "10881938",
          "text": "Cercherò di proteggerti.",
          "translation": "Я постараюсь тебя защитить.",
          "source": "Tatoeba #10881938 @dnnywld / #8043385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10881938",
          "cefr_level": "A1",
          "word_slugs": [
            "cercherò-verb"
          ]
        },
        {
          "id": "5831088",
          "text": "Cercherò di fare qualcosa.",
          "translation": "Я попробую что-нибудь сделать.",
          "source": "Tatoeba #5831088 @Guybrush88 / #11339669 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5831088",
          "cefr_level": "A1",
          "word_slugs": [
            "cercherò-verb"
          ]
        },
        {
          "id": "5706873",
          "text": "Cercherò di spiegare tutto.",
          "translation": "Я попробую всё объяснить.",
          "source": "Tatoeba #5706873 @dnnywld / #5705575 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5706873",
          "cefr_level": "A1",
          "word_slugs": [
            "cercherò-verb"
          ]
        },
        {
          "id": "5477119",
          "text": "Non cercherò di convincervi.",
          "translation": "Я не буду пытаться вас убедить.",
          "source": "Tatoeba #5477119 @dnnywld / #5476895 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5477119",
          "cefr_level": "A1",
          "word_slugs": [
            "cercherò-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cercherò",
        "plural": "",
        "infinitive": "cercherò"
      }
