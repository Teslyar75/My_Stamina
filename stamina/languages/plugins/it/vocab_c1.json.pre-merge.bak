    {
      "slug": "seta-noun",
      "lemma": "seta",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7318,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6950645",
          "text": "I bachi da seta intrecciano i bozzoli.",
          "translation": "Шелкопряды плетут коконы.",
          "source": "Tatoeba #6950645 @dnnywld / #805860 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950645",
          "cefr_level": "A1",
          "word_slugs": [
            "seta-noun"
          ]
        },
        {
          "id": "5730226",
          "text": "Tom di solito indossa un pigiama di seta.",
          "translation": "Том обычно носит шёлковую пижаму.",
          "source": "Tatoeba #5730226 @dnnywld / #5728200 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5730226",
          "cefr_level": "A1",
          "word_slugs": [
            "seta-noun"
          ]
        },
        {
          "id": "10773760",
          "text": "I capelli delle ragazze sono simili alla seta.",
          "translation": "Волосы девушки подобны шёлку.",
          "source": "Tatoeba #10773760 @dnnywld / #1566475 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10773760",
          "cefr_level": "A1",
          "word_slugs": [
            "seta-noun"
          ]
        },
        {
          "id": "4296764",
          "text": "Quel cane ha il pelo che sembra di seta.",
          "translation": "У той собаки шерсть как будто шёлковая.",
          "source": "Tatoeba #4296764 @aldolit58 / #4296833 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4296764",
          "cefr_level": "A1",
          "word_slugs": [
            "seta-noun"
          ]
        },
        {
          "id": "5675898",
          "text": "Lei legò i capelli con una sciarpa di seta.",
          "translation": "Волосы она обвязала шёлковым шарфом.",
          "source": "Tatoeba #5675898 @dnnywld / #5675349 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5675898",
          "cefr_level": "A1",
          "word_slugs": [
            "seta-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la seta",
        "plural": "",
        "infinitive": ""
      }
    },
