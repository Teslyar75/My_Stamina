    {
      "slug": "esatta-adj",
      "lemma": "esatta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6712,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5451430",
          "text": "Non ricordo la data esatta.",
          "translation": "Я не помню точную дату.",
          "source": "Tatoeba #5451430 @dnnywld / #5450995 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5451430",
          "cefr_level": "A1",
          "word_slugs": [
            "esatta-adj"
          ]
        },
        {
          "id": "5452710",
          "text": "C'è voluta un'ora esatta.",
          "translation": "Это заняло ровно час.",
          "source": "Tatoeba #5452710 @dnnywld / #2197525 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452710",
          "cefr_level": "A1",
          "word_slugs": [
            "esatta-adj"
          ]
        },
        {
          "id": "5706022",
          "text": "Tom è arrivato all'ora esatta.",
          "translation": "Том приехал точно в назначенный час.",
          "source": "Tatoeba #5706022 @dnnywld / #5705634 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5706022",
          "cefr_level": "A1",
          "word_slugs": [
            "esatta-adj"
          ]
        },
        {
          "id": "5694423",
          "text": "Non posso fornirvi la cifra esatta.",
          "translation": "Я не могу предоставить вам точных цифр.",
          "source": "Tatoeba #5694423 @dnnywld / #5693089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5694423",
          "cefr_level": "A1",
          "word_slugs": [
            "esatta-adj"
          ]
        },
        {
          "id": "5385568",
          "text": "Garantisco che questa informazione è esatta.",
          "translation": "Я ручаюсь, что эта информация правдива.",
          "source": "Tatoeba #5385568 @dnnywld / #5385528 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385568",
          "cefr_level": "A1",
          "word_slugs": [
            "esatta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il esatta",
        "plural": "",
        "infinitive": ""
      }
