    {
      "slug": "sufficienti-adj",
      "lemma": "sufficienti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8110,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5625983",
          "text": "Questi soldi sono sufficienti?",
          "translation": "Этих денег достаточно?",
          "source": "Tatoeba #5625983 @dnnywld / #2551956 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5625983",
          "cefr_level": "A1",
          "word_slugs": [
            "sufficienti-adj"
          ]
        },
        {
          "id": "4963596",
          "text": "Due grammi di pepe sono sufficienti.",
          "translation": "Два грамма перца достаточно.",
          "source": "Tatoeba #4963596 @Guybrush88 / #4963605 @russica (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4963596",
          "cefr_level": "A1",
          "word_slugs": [
            "sufficienti-adj"
          ]
        },
        {
          "id": "5997551",
          "text": "Pensi che tre ore saranno sufficienti?",
          "translation": "Думаешь, трёх часов будет достаточно?",
          "source": "Tatoeba #5997551 @dnnywld / #5996321 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997551",
          "cefr_level": "A1",
          "word_slugs": [
            "sufficienti-adj"
          ]
        },
        {
          "id": "5997553",
          "text": "Pensate che tre ore saranno sufficienti?",
          "translation": "Думаете, трёх часов будет достаточно?",
          "source": "Tatoeba #5997553 @dnnywld / #5996320 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997553",
          "cefr_level": "A1",
          "word_slugs": [
            "sufficienti-adj"
          ]
        },
        {
          "id": "6922841",
          "text": "La corte non aveva prove sufficienti per condannarlo.",
          "translation": "Суд не имел достаточных доказательств, чтобы осудить его.",
          "source": "Tatoeba #6922841 @dnnywld / #6922799 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6922841",
          "cefr_level": "A1",
          "word_slugs": [
            "sufficienti-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il sufficienti",
        "plural": "",
        "infinitive": ""
      }
