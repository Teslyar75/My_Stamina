    {
      "slug": "maiali-noun",
      "lemma": "maiali",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6124,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5686046",
          "text": "Mangiano come maiali.",
          "translation": "Они едят как свиньи.",
          "source": "Tatoeba #5686046 @dnnywld / #5684353 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686046",
          "cefr_level": "A1",
          "word_slugs": [
            "maiali-noun"
          ]
        },
        {
          "id": "5385356",
          "text": "Dai gli avanzi ai maiali.",
          "translation": "Отдай объедки свиньям.",
          "source": "Tatoeba #5385356 @dnnywld / #5385324 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385356",
          "cefr_level": "A1",
          "word_slugs": [
            "maiali-noun"
          ]
        },
        {
          "id": "5227967",
          "text": "I maiali non sanno volare.",
          "translation": "Свиньи не умеют летать.",
          "source": "Tatoeba #5227967 @Guybrush88 / #3991862 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5227967",
          "cefr_level": "A1",
          "word_slugs": [
            "maiali-noun"
          ]
        },
        {
          "id": "13788419",
          "text": "I maiali mangiano le uova?",
          "translation": "Едят ли свиньи яйца?",
          "source": "Tatoeba #13788419 @dnnywld / #13788342 @Just_Balls (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13788419",
          "cefr_level": "A1",
          "word_slugs": [
            "maiali-noun"
          ]
        },
        {
          "id": "5227965",
          "text": "I maiali non possono volare.",
          "translation": "Свиньи не могут летать.",
          "source": "Tatoeba #5227965 @Guybrush88 / #5227977 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5227965",
          "cefr_level": "A1",
          "word_slugs": [
            "maiali-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il maiali",
        "plural": "",
        "infinitive": ""
      }
    },
