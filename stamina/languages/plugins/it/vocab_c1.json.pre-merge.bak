    {
      "slug": "hawaii-name",
      "lemma": "Hawaii",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6519,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5652611",
          "text": "Voglio andare alle Hawaii.",
          "translation": "Я хочу на Гавайи.",
          "source": "Tatoeba #5652611 @dnnywld / #5652409 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652611",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        },
        {
          "id": "348913",
          "text": "Chi è stato allo Hawaii?",
          "translation": "Кто был на Гавайях?",
          "source": "Tatoeba #348913 @grantortino / #469866 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/348913",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        },
        {
          "id": "5401168",
          "text": "Perché ti piacciono le Hawaii?",
          "translation": "Почему тебе нравятся Гавайи?",
          "source": "Tatoeba #5401168 @dnnywld / #2254364 @DiePain (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5401168",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        },
        {
          "id": "348910",
          "text": "La prossima estate voglio andare alle Hawaii.",
          "translation": "Следующим летом я хочу поехать на Гавайи.",
          "source": "Tatoeba #348910 @grantortino / #469865 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/348910",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        },
        {
          "id": "348919",
          "text": "Anch'io vorrei provare ad andare alle Hawaii.",
          "translation": "Я тоже хочу попробовать поехать на Гавайи.",
          "source": "Tatoeba #348919 @grantortino / #4662356 @yura798261 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/348919",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "Hawaii",
        "plural": "",
        "infinitive": ""
      }
    },
