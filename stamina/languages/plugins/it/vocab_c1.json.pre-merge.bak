    {
      "slug": "turisti-noun",
      "lemma": "turisti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7671,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4150324",
          "text": "È per turisti.",
          "translation": "Это для туристов.",
          "source": "Tatoeba #4150324 @Guybrush88 / #4596235 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4150324",
          "cefr_level": "A1",
          "word_slugs": [
            "turisti-noun"
          ]
        },
        {
          "id": "7065302",
          "text": "Molti di loro non erano turisti.",
          "translation": "Многие из них не были туристами.",
          "source": "Tatoeba #7065302 @dnnywld / #7065131 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7065302",
          "cefr_level": "A1",
          "word_slugs": [
            "turisti-noun"
          ]
        },
        {
          "id": "6484834",
          "text": "Il numero dei turisti è aumentato.",
          "translation": "Число туристов возросло.",
          "source": "Tatoeba #6484834 @dnnywld / #6484778 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6484834",
          "cefr_level": "A1",
          "word_slugs": [
            "turisti-noun"
          ]
        },
        {
          "id": "341638",
          "text": "A Venezia ci sono sempre tanti turisti.",
          "translation": "В Венеции всегда много туристов.",
          "source": "Tatoeba #341638 @MUIRIEL / #469834 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341638",
          "cefr_level": "A1",
          "word_slugs": [
            "turisti-noun"
          ]
        },
        {
          "id": "7000413",
          "text": "In Portogallo ci sono sempre più turisti.",
          "translation": "В Португалии с каждым разом всё больше туристов.",
          "source": "Tatoeba #7000413 @dnnywld / #7000071 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7000413",
          "cefr_level": "A1",
          "word_slugs": [
            "turisti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
