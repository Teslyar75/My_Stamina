          ]
        },
        {
          "id": "3071164",
          "text": "Lui si è divertito.",
          "translation": "Он хорошо провёл время.",
          "source": "Tatoeba #3071164 @Guybrush88 / #4951712 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3071164",
          "cefr_level": "A1",
          "word_slugs": [
            "divertito-adj"
          ]
        },
        {
          "id": "5616398",
          "text": "Mi sono divertito tanto.",
          "translation": "Я очень хорошо провёл время.",
          "source": "Tatoeba #5616398 @dnnywld / #5571571 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616398",
          "cefr_level": "A1",
          "word_slugs": [
