    {
      "slug": "commento-noun",
      "lemma": "commento",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7036,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2833220",
          "text": "Lascia un commento.",
          "translation": "Оставь комментарий.",
          "source": "Tatoeba #2833220 @Guybrush88 / #5697960 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2833220",
          "cefr_level": "A1",
          "word_slugs": [
            "commento-noun"
          ]
        },
        {
          "id": "3457624",
          "text": "Che commento stupido!",
          "translation": "Какой глупый комментарий!",
          "source": "Tatoeba #3457624 @Guybrush88 / #3464277 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3457624",
          "cefr_level": "A1",
          "word_slugs": [
            "commento-noun"
          ]
        },
        {
          "id": "5506740",
          "text": "Che commento maleducato!",
          "translation": "Какой грубый комментарий!",
          "source": "Tatoeba #5506740 @dnnywld / #5506225 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506740",
          "cefr_level": "A1",
          "word_slugs": [
            "commento-noun"
          ]
        },
        {
          "id": "5433972",
          "text": "Cancella questo commento.",
          "translation": "Удали этот комментарий.",
          "source": "Tatoeba #5433972 @dnnywld / #5433947 @sikmir (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433972",
          "cefr_level": "A1",
          "word_slugs": [
            "commento-noun"
          ]
        },
        {
          "id": "5409201",
          "text": "Grazie per il commento.",
          "translation": "Благодарю за комментарий.",
          "source": "Tatoeba #5409201 @dnnywld / #3013756 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409201",
          "cefr_level": "A1",
          "word_slugs": [
            "commento-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
