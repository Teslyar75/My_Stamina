          ]
        },
        {
          "id": "10836655",
          "text": "La stampa ha approvato questa iniziativa.",
          "translation": "Пресса одобрила эту инициативу.",
          "source": "Tatoeba #10836655 @dnnywld / #10836649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10836655",
          "cefr_level": "A1",
          "word_slugs": [
            "approvato-verb"
          ]
        },
        {
          "id": "6940778",
          "text": "Il progetto del nuovo stadio è approvato dagli sponsor.",
          "translation": "Проект нового стадиона одобрен спонсорами.",
          "source": "Tatoeba #6940778 @dnnywld / #6940401 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6940778",
          "cefr_level": "A1",
          "word_slugs": [
            "approvato-verb"
          ]
        },
        {
          "id": "5429053",
          "text": "Mi dispiace, ma il Vostro progetto non è stato approvato.",
          "translation": "Сожалею, но Ваш проект не утвержден.",
          "source": "Tatoeba #5429053 @dnnywld / #5420303 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5429053",
          "cefr_level": "A1",
          "word_slugs": [
            "approvato-verb"
          ]
        }
      ],
      "tags": [
