    {
      "slug": "prometti-verb",
      "lemma": "prometti",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5359,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3577670",
          "text": "\"Lo prometti?\" \"Sì.\"",
          "translation": "\"Обещаешь?\" - \"Да\".",
          "source": "Tatoeba #3577670 @Guybrush88 / #3874481 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3577670",
          "cefr_level": "A1",
          "word_slugs": [
            "prometti-verb"
          ]
        },
        {
          "id": "5688930",
          "text": "Prometti che lo farai?",
          "translation": "Обещаешь, что сделаешь это?",
          "source": "Tatoeba #5688930 @dnnywld / #2742203 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688930",
          "cefr_level": "A1",
          "word_slugs": [
            "prometti-verb"
          ]
        },
        {
          "id": "6878063",
          "text": "Prometti di non mentire più?",
          "translation": "Обещаешь больше никогда не врать?",
          "source": "Tatoeba #6878063 @dnnywld / #6877913 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6878063",
          "cefr_level": "A1",
          "word_slugs": [
            "prometti-verb"
          ]
        },
        {
          "id": "5688902",
          "text": "Prometti di mantenere le promesse.",
          "translation": "Обещай сдержать обещание.",
          "source": "Tatoeba #5688902 @dnnywld / #1951252 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688902",
          "cefr_level": "A1",
          "word_slugs": [
            "prometti-verb"
          ]
        },
        {
          "id": "2995378",
          "text": "Prometti di non dirlo a nessuno.",
          "translation": "Обещай никому не говорить.",
          "source": "Tatoeba #2995378 @Guybrush88 / #3875817 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2995378",
          "cefr_level": "A1",
          "word_slugs": [
            "prometti-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "prometti",
        "plural": "",
        "infinitive": "prometti"
      }
