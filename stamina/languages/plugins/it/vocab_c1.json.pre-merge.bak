    {
      "slug": "rispettato-adj",
      "lemma": "rispettato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8250,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5502952",
          "text": "Ho sempre rispettato Tom.",
          "translation": "Я всегда уважала Тома.",
          "source": "Tatoeba #5502952 @dnnywld / #5502936 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5502952",
          "cefr_level": "A1",
          "word_slugs": [
            "rispettato-adj"
          ]
        },
        {
          "id": "5803945",
          "text": "Tom è rispettato da tutti.",
          "translation": "Том всеми уважаем.",
          "source": "Tatoeba #5803945 @dnnywld / #5803600 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5803945",
          "cefr_level": "A1",
          "word_slugs": [
            "rispettato-adj"
          ]
        },
        {
          "id": "6981859",
          "text": "Fadel era molto rispettato tra i residenti del quartiere.",
          "translation": "Фадель был очень уважаем среди жителей района.",
          "source": "Tatoeba #6981859 @dnnywld / #6981348 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6981859",
          "cefr_level": "A1",
          "word_slugs": [
            "rispettato-adj"
          ]
        },
        {
          "id": "5502383",
          "text": "Il presidente sfortunatamente non ha rispettato le sue promesse elettorali.",
          "translation": "Президент, к сожалению, не выполнил своих предвыборных обещаний.",
          "source": "Tatoeba #5502383 @dnnywld / #5502076 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5502383",
          "cefr_level": "A1",
          "word_slugs": [
            "rispettato-adj"
          ]
        },
        {
          "id": "6871610",
          "text": "Non avete rispettato i termini del contratto. Perché? Per quale motivo?",
          "translation": "Вы не выполнили условия договора. Почему? По какой причине?",
          "source": "Tatoeba #6871610 @dnnywld / #6871555 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871610",
          "cefr_level": "A1",
          "word_slugs": [
            "rispettato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il rispettato",
        "plural": "",
        "infinitive": ""
      }
