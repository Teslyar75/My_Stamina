          "text": "Sei un musicista?",
          "translation": "Ты музыкант?",
          "source": "Tatoeba #5550345 @dnnywld / #5550031 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5550345",
          "cefr_level": "A1",
          "word_slugs": [
            "musicista-noun"
          ]
        },
        {
          "id": "5927223",
          "text": "Sei un buon musicista.",
          "translation": "Ты хороший музыкант.",
          "source": "Tatoeba #5927223 @dnnywld / #5926450 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5927223",
          "cefr_level": "A1",
          "word_slugs": [
            "musicista-noun"
          ]
        },
        {
          "id": "947668",
          "text": "Ha sposato un musicista.",
          "translation": "Она вышла замуж за музыканта.",
          "source": "Tatoeba #947668 @riccioberto / #433038 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/947668",
          "cefr_level": "A1",
          "word_slugs": [
            "musicista-noun"
          ]
        },
        {
          "id": "5927822",
          "text": "Suona più forte, musicista!",
          "translation": "Громче играй, музыкант!",
          "source": "Tatoeba #5927822 @dnnywld / #5927798 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5927822",
          "cefr_level": "A1",
          "word_slugs": [
            "musicista-noun"
          ]
        },
        {
          "id": "5818003",
          "text": "Tom è un musicista eccellente.",
          "translation": "Том - превосходный музыкант.",
          "source": "Tatoeba #5818003 @Guybrush88 / #5818339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5818003",
          "cefr_level": "A1",
          "word_slugs": [
            "musicista-noun"
          ]
        }
      ],
