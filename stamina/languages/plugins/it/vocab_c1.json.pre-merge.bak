    {
      "slug": "tacere-verb",
      "lemma": "tacere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6157,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5613822",
          "text": "Non potresti tacere?",
          "translation": "Ты бы не мог заткнуться?",
          "source": "Tatoeba #5613822 @dnnywld / #3963237 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5613822",
          "cefr_level": "A1",
          "word_slugs": [
            "tacere-verb"
          ]
        },
        {
          "id": "5434444",
          "text": "Tom non intendeva tacere.",
          "translation": "Том не собирался молчать.",
          "source": "Tatoeba #5434444 @dnnywld / #4037550 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5434444",
          "cefr_level": "A1",
          "word_slugs": [
            "tacere-verb"
          ]
        },
        {
          "id": "5812698",
          "text": "Ti ho detto di tacere.",
          "translation": "Я же сказал тебе заткнуться.",
          "source": "Tatoeba #5812698 @dnnywld / #5812476 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5812698",
          "cefr_level": "A1",
          "word_slugs": [
            "tacere-verb"
          ]
        },
        {
          "id": "5973525",
          "text": "Le ho detto di tacere.",
          "translation": "Я сказал ей замолчать.",
          "source": "Tatoeba #5973525 @dnnywld / #5973198 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5973525",
          "cefr_level": "A1",
          "word_slugs": [
            "tacere-verb"
          ]
        },
        {
          "id": "5973524",
          "text": "Gli ho detto di tacere.",
          "translation": "Я сказал ему замолчать.",
          "source": "Tatoeba #5973524 @dnnywld / #5973197 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5973524",
          "cefr_level": "A1",
          "word_slugs": [
