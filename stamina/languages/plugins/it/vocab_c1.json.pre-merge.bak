    {
      "slug": "bolle-noun",
      "lemma": "bolle",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9114,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5861627",
          "text": "L'acqua bolle.",
          "translation": "Вода кипит.",
          "source": "Tatoeba #5861627 @dnnywld / #2366952 @yosik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5861627",
          "cefr_level": "A1",
          "word_slugs": [
            "bolle-noun"
          ]
        },
        {
          "id": "5427762",
          "text": "La pasta bolle in pentola.",
          "translation": "В кастрюле варятся макароны.",
          "source": "Tatoeba #5427762 @dnnywld / #2238638 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5427762",
          "cefr_level": "A1",
          "word_slugs": [
            "bolle-noun"
          ]
        },
        {
          "id": "6942756",
          "text": "Tom fa le bolle di sapone.",
          "translation": "Том пускает мыльные пузыри.",
          "source": "Tatoeba #6942756 @dnnywld / #6941843 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6942756",
          "cefr_level": "A1",
          "word_slugs": [
            "bolle-noun"
          ]
        },
        {
          "id": "2687784",
          "text": "L'acqua bolle a cento gradi.",
          "translation": "Вода закипает при ста градусах.",
          "source": "Tatoeba #2687784 @Guybrush88 / #2752848 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2687784",
          "cefr_level": "A1",
          "word_slugs": [
            "bolle-noun"
          ]
        },
        {
          "id": "5652250",
          "text": "Quando l'acqua bolle, la verso nella tazza.",
          "translation": "Когда вода закипает, я наливаю её в чашку.",
          "source": "Tatoeba #5652250 @dnnywld / #5651564 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652250",
          "cefr_level": "A1",
          "word_slugs": [
            "bolle-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
