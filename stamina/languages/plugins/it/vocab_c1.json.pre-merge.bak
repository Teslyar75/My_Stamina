      "frequency_rank": 6312,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5624287",
          "text": "Il bagaglio è assicurato.",
          "translation": "Багаж застрахован.",
          "source": "Tatoeba #5624287 @dnnywld / #5623636 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624287",
          "cefr_level": "A1",
          "word_slugs": [
            "assicurato-adj"
          ]
        },
        {
          "id": "5996997",
          "text": "Il mio bagaglio era assicurato.",
          "translation": "Мой багаж был застрахован.",
          "source": "Tatoeba #5996997 @dnnywld / #474564 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5996997",
          "cefr_level": "A1",
          "word_slugs": [
            "assicurato-adj"
          ]
        },
        {
          "id": "6009777",
          "text": "Tom avrà un successo assicurato.",
          "translation": "У Тома наверняка получится.",
          "source": "Tatoeba #6009777 @dnnywld / #6009284 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009777",
          "cefr_level": "A1",
          "word_slugs": [
            "assicurato-adj"
          ]
        },
        {
          "id": "5622193",
          "text": "Lui mi ha assicurato che questo non succeda.",
          "translation": "Он заверил меня, что этого не случится.",
          "source": "Tatoeba #5622193 @dnnywld / #5622129 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5622193",
          "cefr_level": "A1",
          "word_slugs": [
            "assicurato-adj"
          ]
        }
      ],
      "tags": [
