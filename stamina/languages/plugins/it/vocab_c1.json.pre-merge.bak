    {
      "slug": "ponti-noun",
      "lemma": "ponti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8582,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5443835",
          "text": "I ponti sono bruciati.",
          "translation": "Мосты сожжены.",
          "source": "Tatoeba #5443835 @dnnywld / #4740076 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5443835",
          "cefr_level": "A1",
          "word_slugs": [
            "ponti-noun"
          ]
        },
        {
          "id": "5688926",
          "text": "Lui ha promesso ponti d'oro.",
          "translation": "Он обещал золотые горы.",
          "source": "Tatoeba #5688926 @dnnywld / #2570427 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688926",
          "cefr_level": "A1",
          "word_slugs": [
            "ponti-noun"
          ]
        },
        {
          "id": "7613481",
          "text": "Non vai a costruire ponti in Italia.",
          "translation": "Ты не собираешься строить мосты в Италии.",
          "source": "Tatoeba #7613481 @Guybrush88 / #10028328 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7613481",
          "cefr_level": "A1",
          "word_slugs": [
            "ponti-noun"
          ]
        },
        {
          "id": "5512158",
          "text": "È passata molta acqua sotto i ponti da allora.",
          "translation": "С тех пор много воды утекло.",
          "source": "Tatoeba #5512158 @dnnywld / #2704152 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512158",
          "cefr_level": "A1",
          "word_slugs": [
            "ponti-noun"
          ]
        },
        {
          "id": "6856281",
          "text": "Da allora ne è passata di acqua sotto ai ponti.",
          "translation": "С тех пор столько воды утекло.",
          "source": "Tatoeba #6856281 @dnnywld / #6856146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6856281",
          "cefr_level": "A1",
          "word_slugs": [
            "ponti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ponti",
        "plural": "",
        "infinitive": ""
      }
    },
    {
