    {
      "slug": "disponibili-adj",
      "lemma": "disponibili",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7500,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5836076",
          "text": "I libri sono diventati più disponibili.",
          "translation": "Книги стали доступнее.",
          "source": "Tatoeba #5836076 @dnnywld / #4561458 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5836076",
          "cefr_level": "A1",
          "word_slugs": [
            "disponibili-adj"
          ]
        },
        {
          "id": "5494344",
          "text": "Maggiori informazioni sono disponibili presso il nostro sito internet.",
          "translation": "Больше информации можно найти на нашем сайте.",
          "source": "Tatoeba #5494344 @dnnywld / #5494262 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494344",
          "cefr_level": "A1",
          "word_slugs": [
            "disponibili-adj"
          ]
        },
        {
          "id": "5184733",
          "text": "Non ha senso stare in piedi quando ci sono posti disponibili.",
          "translation": "Нет смысла стоять, когда есть свободные места.",
          "source": "Tatoeba #5184733 @Guybrush88 / #2651193 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5184733",
          "cefr_level": "A1",
          "word_slugs": [
            "disponibili-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il disponibili",
        "plural": "",
        "infinitive": ""
      }
