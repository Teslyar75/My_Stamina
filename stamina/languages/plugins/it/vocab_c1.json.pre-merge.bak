          ]
        },
        {
          "id": "5655433",
          "text": "Non voglio alcuna compassione.",
          "translation": "Я не хочу никакой жалости.",
          "source": "Tatoeba #5655433 @dnnywld / #5655108 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5655433",
          "cefr_level": "A1",
          "word_slugs": [
            "compassione-noun"
          ]
        },
        {
          "id": "738658",
          "text": "Ha sentito dolore e compassione.",
          "translation": "Он испытывал боль и сострадание.",
          "source": "Tatoeba #738658 @DeSha / #738646 @DeSha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/738658",
