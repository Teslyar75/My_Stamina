    {
      "slug": "dimenticherò-verb",
      "lemma": "dimenticherò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8327,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "410260",
          "text": "Non ti dimenticherò mai.",
          "translation": "Я никогда тебя не забуду.",
          "source": "Tatoeba #410260 @shoras / #6046839 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/410260",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticherò-verb"
          ]
        },
        {
          "id": "4421177",
          "text": "Non li dimenticherò mai.",
          "translation": "Я их не забуду никогда.",
          "source": "Tatoeba #4421177 @valealb / #4421749 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4421177",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticherò-verb"
          ]
        },
        {
          "id": "3533152",
          "text": "Non dimenticherò mai Tom.",
          "translation": "Я никогда не забуду Тома.",
          "source": "Tatoeba #3533152 @Vallysing / #4065481 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3533152",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticherò-verb"
          ]
        },
        {
          "id": "5614011",
          "text": "Non dimenticherò mai questo spettacolo.",
          "translation": "Я никогда не забуду этот спектакль.",
          "source": "Tatoeba #5614011 @dnnywld / #5613811 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614011",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticherò-verb"
          ]
        },
        {
          "id": "10841246",
          "text": "Ho bisogno di annotarlo, altrimenti lo dimenticherò.",
          "translation": "Мне нужно это записать, иначе я забуду.",
          "source": "Tatoeba #10841246 @dnnywld / #9469966 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10841246",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticherò-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
