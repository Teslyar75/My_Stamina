    {
      "slug": "vicine-adj",
      "lemma": "vicine",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7724,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6361531",
          "text": "Le possibilità di vincita sono vicine allo zero.",
          "translation": "Шансы на победу близки к нулю.",
          "source": "Tatoeba #6361531 @dnnywld / #6361313 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361531",
          "cefr_level": "A1",
          "word_slugs": [
            "vicine-adj"
          ]
        },
        {
          "id": "6749363",
          "text": "\"Di che nazionalità sono le tue vicine?\" \"Russa.\"",
          "translation": "«Кто по национальности ваши соседи?» — «Русские».",
          "source": "Tatoeba #6749363 @Guybrush88 / #12011771 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6749363",
          "cefr_level": "A1",
          "word_slugs": [
            "vicine-adj"
          ]
        },
        {
          "id": "5491413",
          "text": "Al funerale c'erano solo solo le persone più vicine.",
          "translation": "На похоронах были только самые близкие.",
          "source": "Tatoeba #5491413 @dnnywld / #5490950 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5491413",
          "cefr_level": "A1",
          "word_slugs": [
            "vicine-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il vicine",
        "plural": "",
        "infinitive": ""
      }
