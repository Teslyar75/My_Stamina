    {
      "slug": "ruba-noun",
      "lemma": "ruba",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6497,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6883008",
          "text": "Chi ruba si merita una punizione.",
          "translation": "Тот, кто ворует, заслуживает наказания.",
          "source": "Tatoeba #6883008 @dnnywld / #6882327 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883008",
          "cefr_level": "A1",
          "word_slugs": [
            "ruba-noun"
          ]
        },
        {
          "id": "1799145",
          "text": "Un uomo affamato non ruba merendine.",
          "translation": "Голодный человек не ворует закуски.",
          "source": "Tatoeba #1799145 @Guybrush88 / #1799167 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1799145",
          "cefr_level": "A1",
          "word_slugs": [
            "ruba-noun"
          ]
        },
        {
          "id": "2302205",
          "text": "Una persona che ruba si merita una punizione.",
          "translation": "Человек, который ворует, заслуживает наказания.",
          "source": "Tatoeba #2302205 @Guybrush88 / #6882338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2302205",
          "cefr_level": "A1",
          "word_slugs": [
            "ruba-noun"
          ]
        },
        {
          "id": "6854477",
          "text": "Chiunque sia il lavoratore, chi ruba i soldi deve essere licenziato.",
          "translation": "Кто бы ни был работник, укравший деньги, он должен быть уволен.",
          "source": "Tatoeba #6854477 @dnnywld / #6853457 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6854477",
          "cefr_level": "A1",
          "word_slugs": [
            "ruba-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la ruba",
        "plural": "",
        "infinitive": ""
      }
    },
