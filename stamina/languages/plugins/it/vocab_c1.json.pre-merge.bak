        },
        {
          "id": "4206351",
          "text": "Provavano compassione per lei.",
          "translation": "Они ей сочувствовали.",
          "source": "Tatoeba #4206351 @Guybrush88 / #5386046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4206351",
