    {
      "slug": "causare-verb",
      "lemma": "causare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5366,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10849715",
          "text": "Lo stress può causare l'aggressività.",
          "translation": "Стресс может вызвать агрессию.",
          "source": "Tatoeba #10849715 @dnnywld / #10576233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849715",
          "cefr_level": "A1",
          "word_slugs": [
            "causare-verb"
          ]
        },
        {
          "id": "6877705",
          "text": "L'abbronzatura può causare un cancro alla pelle.",
          "translation": "Загорание может вызвать рак кожи.",
          "source": "Tatoeba #6877705 @dnnywld / #6877070 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6877705",
          "cefr_level": "A1",
          "word_slugs": [
            "causare-verb"
          ]
        },
        {
          "id": "6871857",
          "text": "I bambini che gridano possono causare il mal di testa a chiunque.",
          "translation": "Кричащие дети могут у кого угодно вызвать головную боль.",
          "source": "Tatoeba #6871857 @dnnywld / #3152120 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871857",
          "cefr_level": "A1",
          "word_slugs": [
            "causare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "causare",
        "plural": "",
        "infinitive": "causare"
      }
