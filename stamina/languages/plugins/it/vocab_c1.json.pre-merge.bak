    {
      "slug": "disposti-adj",
      "lemma": "disposti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7578,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12439717",
          "text": "Noi siamo ben disposti verso di lei.",
          "translation": "Мы хорошо к ней относимся.",
          "source": "Tatoeba #12439717 @dnnywld / #12439677 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12439717",
          "cefr_level": "A1",
          "word_slugs": [
            "disposti-adj"
          ]
        },
        {
          "id": "12439719",
          "text": "Noi siamo ben disposti verso di lui.",
          "translation": "Мы хорошо к нему относимся.",
          "source": "Tatoeba #12439719 @dnnywld / #12439676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12439719",
          "cefr_level": "A1",
          "word_slugs": [
            "disposti-adj"
          ]
        },
        {
          "id": "2501704",
          "text": "I libri sono stati disposti in ordine alfabetico.",
          "translation": "Книги были расставлены в алфавитном порядке.",
          "source": "Tatoeba #2501704 @al_ex_an_der / #2501662 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2501704",
          "cefr_level": "A1",
          "word_slugs": [
            "disposti-adj"
          ]
        },
        {
          "id": "6213803",
          "text": "Molto dipende da quanto siamo disposti ad imparare.",
          "translation": "Многое зависит и от того, насколько мы готовы учиться.",
          "source": "Tatoeba #6213803 @dnnywld / #6213092 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6213803",
          "cefr_level": "A1",
          "word_slugs": [
            "disposti-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
