    {
      "slug": "gallo-adj",
      "lemma": "gallo",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8942,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4538422",
          "text": "Il gallo canta.",
          "translation": "Петух поёт.",
          "source": "Tatoeba #4538422 @Guybrush88 / #3512618 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538422",
          "cefr_level": "A1",
          "word_slugs": [
            "gallo-adj"
          ]
        },
        {
          "id": "5973621",
          "text": "Il gallo canta all'alba.",
          "translation": "Петух поёт на рассвете.",
          "source": "Tatoeba #5973621 @dnnywld / #5972714 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5973621",
          "cefr_level": "A1",
          "word_slugs": [
            "gallo-adj"
          ]
        },
        {
          "id": "6799464",
          "text": "Ho molte galline, ma nessun gallo.",
          "translation": "У меня много кур, но нет петуха.",
          "source": "Tatoeba #6799464 @dnnywld / #6798792 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799464",
          "cefr_level": "A1",
          "word_slugs": [
            "gallo-adj"
          ]
        },
        {
          "id": "6031759",
          "text": "Ogni mattina ci svegliava il gallo del vicino.",
          "translation": "Каждое утро нас будил соседский петух.",
          "source": "Tatoeba #6031759 @dnnywld / #6031375 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6031759",
          "cefr_level": "A1",
          "word_slugs": [
            "gallo-adj"
          ]
        }
      ],
