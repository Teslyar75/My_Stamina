    {
      "slug": "fuggito-adj",
      "lemma": "fuggito",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5813,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10878713",
          "text": "Il rapinatore è fuggito.",
          "translation": "Грабитель скрылся.",
          "source": "Tatoeba #10878713 @dnnywld / #7097360 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878713",
          "cefr_level": "A1",
          "word_slugs": [
            "fuggito-adj"
          ]
        },
        {
          "id": "6835119",
          "text": "Un prigioniero è fuggito dal tribunale.",
          "translation": "Из суда сбежал заключённый.",
          "source": "Tatoeba #6835119 @dnnywld / #6835021 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6835119",
          "cefr_level": "A1",
          "word_slugs": [
            "fuggito-adj"
          ]
        },
        {
          "id": "5266881",
          "text": "Un prigioniero è fuggito dalla prigione.",
          "translation": "Из тюрьмы сбежал заключённый.",
          "source": "Tatoeba #5266881 @Guybrush88 / #2777668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5266881",
          "cefr_level": "A1",
          "word_slugs": [
            "fuggito-adj"
          ]
        },
        {
          "id": "6853043",
          "text": "A tredici anni Tom è fuggito di casa.",
          "translation": "В тринадцать лет Том сбежал из дома.",
          "source": "Tatoeba #6853043 @dnnywld / #6851932 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853043",
          "cefr_level": "A1",
          "word_slugs": [
            "fuggito-adj"
          ]
        },
        {
          "id": "6853042",
          "text": "Tom è fuggito di casa quando aveva tredici anni.",
          "translation": "Том сбежал из дома, когда ему было тринадцать.",
          "source": "Tatoeba #6853042 @dnnywld / #6851928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853042",
          "cefr_level": "A1",
          "word_slugs": [
            "fuggito-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
