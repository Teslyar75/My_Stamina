    {
      "slug": "alzi-verb",
      "lemma": "alzi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5251,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1555894",
          "text": "È ora che ti alzi.",
          "translation": "Тебе пора вставать.",
          "source": "Tatoeba #1555894 @Guybrush88 / #438848 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1555894",
          "cefr_level": "A1",
          "word_slugs": [
            "alzi-verb"
          ]
        },
        {
          "id": "5828066",
          "text": "Perché non alzi la cornetta?",
          "translation": "Почему ты не берёшь трубку?",
          "source": "Tatoeba #5828066 @dnnywld / #3889268 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5828066",
          "cefr_level": "A1",
          "word_slugs": [
            "alzi-verb"
          ]
        },
        {
          "id": "5507061",
          "text": "Chi non mi sente alzi la mano.",
          "translation": "Кто меня не слышит, поднимите руку.",
          "source": "Tatoeba #5507061 @dnnywld / #3604165 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507061",
          "cefr_level": "A1",
          "word_slugs": [
            "alzi-verb"
          ]
        },
        {
          "id": "5598946",
          "text": "A che ora ti alzi il sabato di solito?",
          "translation": "Во сколько ты обычно встаёшь в субботу?",
          "source": "Tatoeba #5598946 @dnnywld / #5598609 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5598946",
          "cefr_level": "A1",
          "word_slugs": [
            "alzi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "alzi",
        "plural": "",
        "infinitive": "alzi"
      }
    },
    {
