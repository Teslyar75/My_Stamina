      "frequency_rank": 6552,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2420801",
          "text": "Ordino piuttosto una birra.",
          "translation": "Я лучше закажу пиво.",
          "source": "Tatoeba #2420801 @ACB / #1682103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2420801",
          "cefr_level": "A1",
          "word_slugs": [
            "ordino-verb"
          ]
        },
        {
          "id": "7036252",
          "text": "\"Cosa ordino per te?\" - \"Solo una macedonia di frutta\".",
          "translation": "\"Что тебе заказать?\" — \"Только фруктовый салат\".",
          "source": "Tatoeba #7036252 @dnnywld / #7035778 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7036252",
          "cefr_level": "A1",
          "word_slugs": [
            "ordino-verb"
          ]
        },
        {
          "id": "7036253",
          "text": "\"Cosa ordino per te?\" - \"Una macedonia di frutta e nient'altro\".",
          "translation": "\"Что тебе заказать?\" — \"Фруктовый салат и больше ничего\".",
          "source": "Tatoeba #7036253 @dnnywld / #7035777 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7036253",
          "cefr_level": "A1",
