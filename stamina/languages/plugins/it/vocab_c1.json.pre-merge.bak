    {
      "slug": "bestiame-noun",
      "lemma": "bestiame",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7426,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "700434",
          "text": "Il bestiame si nutre d'erba.",
          "translation": "Скот пасется на траве.",
          "source": "Tatoeba #700434 @Guybrush88 / #467690 @piksel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/700434",
          "cefr_level": "A1",
          "word_slugs": [
            "bestiame-noun"
          ]
        },
        {
          "id": "14082742",
          "text": "Gli schiavi venivano scambiati e venduti come bestiame.",
          "translation": "Рабов меняли и продавали как скот.",
          "source": "Tatoeba #14082742 @carlosalberto / #14082644 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14082742",
          "cefr_level": "A1",
          "word_slugs": [
            "bestiame-noun"
          ]
        },
        {
          "id": "7023888",
          "text": "L'afta epizootica è una grave malattia del bestiame.",
          "translation": "Ящур – тяжёлая болезнь скота.",
          "source": "Tatoeba #7023888 @dnnywld / #7022940 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7023888",
          "cefr_level": "A1",
          "word_slugs": [
            "bestiame-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il bestiame",
        "plural": "",
        "infinitive": ""
      }
