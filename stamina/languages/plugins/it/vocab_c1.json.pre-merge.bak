    {
      "slug": "chiare-adj",
      "lemma": "chiare",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9274,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10885766",
          "text": "Le prove sono chiare.",
          "translation": "Доказательства очевидны.",
          "source": "Tatoeba #10885766 @dnnywld / #4588820 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885766",
          "cefr_level": "A1",
          "word_slugs": [
            "chiare-adj"
          ]
        },
        {
          "id": "5646635",
          "text": "Le regole sono molto chiare.",
          "translation": "Правила очень чёткие.",
          "source": "Tatoeba #5646635 @dnnywld / #5646533 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646635",
          "cefr_level": "A1",
          "word_slugs": [
            "chiare-adj"
          ]
        },
        {
          "id": "5501526",
          "text": "Le sue intenzioni non erano chiare.",
          "translation": "Его намерения были неясными.",
          "source": "Tatoeba #5501526 @dnnywld / #5501109 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5501526",
          "cefr_level": "A1",
          "word_slugs": [
            "chiare-adj"
          ]
        },
        {
          "id": "3507004",
          "text": "Perché le donne parlano per enigmi ma vogliono risposte chiare?",
          "translation": "Почему женщины говорят загадками, но ожидают чётких ответов на вопросы?",
          "source": "Tatoeba #3507004 @al_ex_an_der / #3507011 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3507004",
          "cefr_level": "A1",
          "word_slugs": [
            "chiare-adj"
          ]
        },
        {
          "id": "5899937",
          "text": "Il testo non era comprensibile, molte parole mi erano poco chiare.",
          "translation": "Текст был непонятный, многие слова были мне неясны.",
          "source": "Tatoeba #5899937 @dnnywld / #5899717 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5899937",
          "cefr_level": "A1",
          "word_slugs": [
            "chiare-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il chiare",
        "plural": "",
        "infinitive": ""
      }
    },
