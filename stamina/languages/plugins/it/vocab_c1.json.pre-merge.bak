          ]
        },
        {
          "id": "6324957",
          "text": "A volte lui guardava il cielo.",
          "translation": "Иногда он смотрел на небо.",
          "source": "Tatoeba #6324957 @dnnywld / #6324312 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6324957",
          "cefr_level": "A1",
          "word_slugs": [
            "guardava-verb"
          ]
        },
        {
          "id": "3348942",
          "text": "Mentre suonava, lei guardava le sue mani.",
