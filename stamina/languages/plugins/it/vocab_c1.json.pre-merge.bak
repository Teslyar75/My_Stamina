          ]
        },
        {
          "id": "3218924",
          "text": "Porta a spasso il suo cane ogni mattina.",
          "translation": "Он выгуливает собаку каждое утро.",
          "source": "Tatoeba #3218924 @Guybrush88 / #1939679 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3218924",
          "cefr_level": "A1",
          "word_slugs": [
            "spasso-noun"
          ]
        },
        {
          "id": "2416793",
          "text": "Dopo cena Maria ha portato a spasso il suo cane.",
          "translation": "После ужина Мэри выгуливала свою собаку.",
          "source": "Tatoeba #2416793 @al_ex_an_der / #2416779 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2416793",
          "cefr_level": "A1",
          "word_slugs": [
            "spasso-noun"
          ]
        }
