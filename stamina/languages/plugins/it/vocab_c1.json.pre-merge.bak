    {
      "slug": "quantità-noun",
      "lemma": "quantità",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6106,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5392888",
          "text": "Questa è una grande quantità.",
          "translation": "Это большое количество.",
          "source": "Tatoeba #5392888 @dnnywld / #2674054 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5392888",
          "cefr_level": "A1",
          "word_slugs": [
            "quantità-noun"
          ]
        },
        {
          "id": "5542514",
          "text": "Costa una quantità folle di denaro.",
          "translation": "Это стоит баснословных денег.",
          "source": "Tatoeba #5542514 @dnnywld / #5542305 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5542514",
          "cefr_level": "A1",
          "word_slugs": [
            "quantità-noun"
          ]
        },
        {
          "id": "2334292",
          "text": "La quantità dice nulla sulla qualità.",
          "translation": "Количество ничего не говорит о качестве.",
          "source": "Tatoeba #2334292 @al_ex_an_der / #2334283 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2334292",
          "cefr_level": "A1",
          "word_slugs": [
            "quantità-noun"
          ]
        },
        {
          "id": "12580956",
          "text": "Come limitare la quantità di traduzioni visibili?",
          "translation": "Как ограничить количество отображающихся переводов?",
          "source": "Tatoeba #12580956 @dnnywld / #8083860 @cykel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12580956",
          "cefr_level": "A1",
          "word_slugs": [
            "quantità-noun"
          ]
        },
        {
          "id": "5981432",
          "text": "È la qualità che conta, non la quantità.",
          "translation": "Именно качество, а не количество имеет значение.",
          "source": "Tatoeba #5981432 @dnnywld / #3092072 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5981432",
          "cefr_level": "A1",
          "word_slugs": [
            "quantità-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la quantità",
        "plural": "",
        "infinitive": ""
      }
    },
