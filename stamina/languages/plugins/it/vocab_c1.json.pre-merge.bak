    {
      "slug": "vulcano-noun",
      "lemma": "vulcano",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9230,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5429692",
          "text": "Voglio vedere un vulcano.",
          "translation": "Я хочу увидеть вулкан.",
          "source": "Tatoeba #5429692 @dnnywld / #2656282 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5429692",
          "cefr_level": "A1",
          "word_slugs": [
            "vulcano-noun"
          ]
        },
        {
          "id": "5509712",
          "text": "È pericoloso vivere vicino al vulcano.",
          "translation": "Жить рядом с вулканом опасно.",
          "source": "Tatoeba #5509712 @dnnywld / #5508864 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5509712",
          "cefr_level": "A1",
          "word_slugs": [
            "vulcano-noun"
          ]
        },
        {
          "id": "500253",
          "text": "Il vulcano eruttò improvvisamente uccidendo molte persone.",
          "translation": "Извержение вулкана началось внезапно, унеся жизни многих людей.",
          "source": "Tatoeba #500253 @Pharamp / #4931021 @r381318 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/500253",
          "cefr_level": "A1",
          "word_slugs": [
            "vulcano-noun"
          ]
        },
        {
          "id": "5573551",
          "text": "Il vulcano non è attivo da tanto tempo.",
          "translation": "Вулкан уже давно неактивен.",
          "source": "Tatoeba #5573551 @dnnywld / #5365044 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5573551",
          "cefr_level": "A1",
          "word_slugs": [
            "vulcano-noun"
          ]
        },
        {
          "id": "3272097",
          "text": "Il vulcano Puyehue continua ad eruttare della lava.",
          "translation": "Вулкан Пуеуэ продолжает извергать лаву.",
          "source": "Tatoeba #3272097 @Guybrush88 / #3700639 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3272097",
          "cefr_level": "A1",
          "word_slugs": [
            "vulcano-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il vulcano",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "soffitta-noun",
