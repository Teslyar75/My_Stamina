    {
      "slug": "giornate-noun",
      "lemma": "giornate",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7862,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3531653",
          "text": "Le giornate si stanno allungando.",
          "translation": "Дни становятся длиннее.",
          "source": "Tatoeba #3531653 @Guybrush88 / #536906 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3531653",
          "cefr_level": "A1",
          "word_slugs": [
            "giornate-noun"
          ]
        },
        {
          "id": "5480234",
          "text": "Le giornate si stanno accorciando.",
          "translation": "Дни становятся короче.",
          "source": "Tatoeba #5480234 @dnnywld / #1494819 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5480234",
          "cefr_level": "A1",
          "word_slugs": [
            "giornate-noun"
          ]
        },
        {
          "id": "5692311",
          "text": "Le giornate ricominciarono ad accorciarsi.",
          "translation": "Дни снова становятся короче.",
          "source": "Tatoeba #5692311 @dnnywld / #5691657 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5692311",
          "cefr_level": "A1",
          "word_slugs": [
            "giornate-noun"
          ]
        },
        {
          "id": "5419289",
          "text": "In primavera le giornate si allungano.",
          "translation": "Весной дни становятся длиннее.",
          "source": "Tatoeba #5419289 @dnnywld / #1826675 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419289",
          "cefr_level": "A1",
          "word_slugs": [
            "giornate-noun"
          ]
        },
        {
          "id": "5662561",
          "text": "Anche in autunno ci sono giornate calde.",
          "translation": "Осенью тоже бывают тёплые дни.",
          "source": "Tatoeba #5662561 @dnnywld / #5660668 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662561",
          "cefr_level": "A1",
          "word_slugs": [
            "giornate-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
