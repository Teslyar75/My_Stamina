          ]
        },
        {
          "id": "3383993",
          "text": "Io odio i film dell'orrore.",
          "translation": "Я ненавижу фильмы ужасов.",
          "source": "Tatoeba #3383993 @Guybrush88 / #3384116 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3383993",
          "cefr_level": "A1",
          "word_slugs": [
