    {
      "slug": "seri-adj",
      "lemma": "seri",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5699,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5566097",
          "text": "Sono nei guai seri.",
          "translation": "У меня большие неприятности.",
          "source": "Tatoeba #5566097 @dnnywld / #5564643 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5566097",
          "cefr_level": "A1",
          "word_slugs": [
            "seri-adj"
          ]
        },
        {
          "id": "5605077",
          "text": "Abbiamo dei seri problemi.",
          "translation": "У нас серьёзные проблемы.",
          "source": "Tatoeba #5605077 @dnnywld / #5605073 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5605077",
          "cefr_level": "A1",
          "word_slugs": [
            "seri-adj"
          ]
        },
        {
          "id": "6009755",
          "text": "Perché siete sempre così seri?",
          "translation": "Почему вы всегда такие серьёзные?",
          "source": "Tatoeba #6009755 @dnnywld / #6009718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009755",
          "cefr_level": "A1",
          "word_slugs": [
            "seri-adj"
          ]
        },
        {
          "id": "10787965",
          "text": "Siete incapaci di restare seri.",
          "translation": "Вы не в состоянии быть серьёзным.",
          "source": "Tatoeba #10787965 @dnnywld / #3512205 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10787965",
          "cefr_level": "A1",
          "word_slugs": [
            "seri-adj"
          ]
        },
        {
          "id": "6905004",
          "text": "Questo può portare a guai seri.",
          "translation": "Это может привести к большим неприятностям.",
          "source": "Tatoeba #6905004 @dnnywld / #3358396 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6905004",
          "cefr_level": "A1",
          "word_slugs": [
            "seri-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il seri",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "andavano-verb",
