    {
      "slug": "singola-adj",
      "lemma": "singola",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5715,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5589195",
          "text": "Vorrei una camera singola.",
          "translation": "Я хотел бы одноместный номер.",
          "source": "Tatoeba #5589195 @dnnywld / #5588380 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589195",
          "cefr_level": "A1",
          "word_slugs": [
            "singola-adj"
          ]
        },
        {
          "id": "10754304",
          "text": "Non rispose una singola parola.",
          "translation": "Он не ответил ни слова.",
          "source": "Tatoeba #10754304 @dnnywld / #659825 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754304",
          "cefr_level": "A1",
          "word_slugs": [
            "singola-adj"
          ]
        },
        {
          "id": "6770290",
          "text": "Non verserò una singola lacrima.",
          "translation": "Я и слезинки не пролью.",
          "source": "Tatoeba #6770290 @dnnywld / #6769076 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770290",
          "cefr_level": "A1",
          "word_slugs": [
            "singola-adj"
          ]
        },
        {
          "id": "5635685",
          "text": "Io abito in una camera singola.",
          "translation": "Я живу в одноместном номере.",
          "source": "Tatoeba #5635685 @dnnywld / #5635652 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635685",
          "cefr_level": "A1",
          "word_slugs": [
            "singola-adj"
          ]
        },
        {
          "id": "5512965",
          "text": "Non ho capito una singola parola.",
          "translation": "Я не понял ни единого слова.",
          "source": "Tatoeba #5512965 @dnnywld / #5512525 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512965",
          "cefr_level": "A1",
          "word_slugs": [
            "singola-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il singola",
        "plural": "",
        "infinitive": ""
      }
