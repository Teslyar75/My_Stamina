    {
      "slug": "venticinque-adj",
      "lemma": "venticinque",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9811,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4275312",
          "text": "Cinque per cinque fa venticinque.",
          "translation": "Пятью пять двадцать пять.",
          "source": "Tatoeba #4275312 @Guybrush88 / #4275323 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4275312",
          "cefr_level": "A1",
          "word_slugs": [
            "venticinque-adj"
          ]
        },
        {
          "id": "6857247",
          "text": "Hai una monetina da venticinque centesimi?",
          "translation": "У тебя есть двадцатипятицентовые монеты?",
          "source": "Tatoeba #6857247 @dnnywld / #6856654 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857247",
          "cefr_level": "A1",
          "word_slugs": [
            "venticinque-adj"
          ]
        },
        {
          "id": "6001561",
          "text": "Abito in questa casa già da venticinque anni.",
          "translation": "Я живу в этом доме уже двадцать пять лет.",
          "source": "Tatoeba #6001561 @dnnywld / #6001501 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6001561",
          "cefr_level": "A1",
          "word_slugs": [
            "venticinque-adj"
          ]
        },
        {
          "id": "6019374",
          "text": "Verrò in maggio, il venticinque o il ventotto.",
          "translation": "Я приеду в мае, двадцать пятого или двадцать шестого.",
          "source": "Tatoeba #6019374 @dnnywld / #6019225 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6019374",
          "cefr_level": "A1",
          "word_slugs": [
            "venticinque-adj"
          ]
        },
        {
          "id": "5634777",
          "text": "La pista di pattinaggio apre il venticinque novembre.",
          "translation": "Каток откроется двадцать пятого ноября.",
          "source": "Tatoeba #5634777 @dnnywld / #5633353 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5634777",
          "cefr_level": "A1",
          "word_slugs": [
            "venticinque-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "venticinque",
        "plural": "",
        "infinitive": ""
      }
    },
