    {
      "slug": "costruendo-verb",
      "lemma": "costruendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6876,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1662828",
          "text": "Tom sta costruendo un muro.",
          "translation": "Том строит стену.",
          "source": "Tatoeba #1662828 @Guybrush88 / #3554531 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1662828",
          "cefr_level": "A1",
          "word_slugs": [
            "costruendo-verb"
          ]
        },
        {
          "id": "6893787",
          "text": "Nel terreno abbandonato stanno costruendo qualcosa.",
          "translation": "На месте пустыря что-то строят.",
          "source": "Tatoeba #6893787 @dnnywld / #6893228 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893787",
          "cefr_level": "A1",
          "word_slugs": [
            "costruendo-verb"
          ]
        },
        {
          "id": "6786106",
          "text": "Tom sta costruendo una casa di fiammiferi.",
          "translation": "Том строит домик из спичек.",
          "source": "Tatoeba #6786106 @dnnywld / #6785749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786106",
          "cefr_level": "A1",
          "word_slugs": [
            "costruendo-verb"
          ]
        },
        {
          "id": "6786107",
          "text": "Tom sta costruendo un pozzo con i fiammiferi.",
          "translation": "Том строит колодец из спичек.",
          "source": "Tatoeba #6786107 @dnnywld / #6785748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786107",
          "cefr_level": "A1",
          "word_slugs": [
            "costruendo-verb"
          ]
        },
        {
          "id": "5708306",
          "text": "I bambini stanno costruendo dei castelli di sabbia sulla spiaggia.",
          "translation": "Дети строят на пляже замки из песка.",
          "source": "Tatoeba #5708306 @Guybrush88 / #1838627 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5708306",
          "cefr_level": "A1",
          "word_slugs": [
            "costruendo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "costruendo",
        "plural": "",
        "infinitive": "costruendo"
      }
