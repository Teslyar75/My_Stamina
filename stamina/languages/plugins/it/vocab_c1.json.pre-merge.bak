          "word_slugs": [
            "tacchi-noun"
          ]
        },
        {
          "id": "5913971",
          "text": "La mamma non mi permette di mettermi i tacchi.",
          "translation": "Мама не разрешает мне ходить на каблуках.",
          "source": "Tatoeba #5913971 @dnnywld / #4138980 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913971",
