          ]
        },
        {
          "id": "6368442",
          "text": "Non ti permetterò mai di andare.",
          "translation": "Я никогда не разрешу тебе поехать.",
          "source": "Tatoeba #6368442 @dnnywld / #6360700 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6368442",
          "cefr_level": "A1",
          "word_slugs": [
            "permetterò-verb"
          ]
        },
        {
          "id": "6833344",
          "text": "Non vi permetterò di farlo in nessun modo.",
          "translation": "Я ни в коем случае не позволю вам это сделать.",
