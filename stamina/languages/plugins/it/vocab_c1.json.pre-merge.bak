      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6874520",
          "text": "Io e Mary siamo fidanzati.",
          "translation": "Мы с Мэри обручены.",
          "source": "Tatoeba #6874520 @dnnywld / #6862465 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6874520",
          "cefr_level": "A1",
          "word_slugs": [
