    {
      "slug": "pianoforte-noun",
      "lemma": "pianoforte",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6525,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "фортепиано"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6718473",
          "text": "Hai un pianoforte?",
          "translation": "У тебя есть пианино?",
          "source": "Tatoeba #6718473 @dnnywld / #6718111 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6718473",
          "cefr_level": "A1",
          "word_slugs": [
            "pianoforte-noun"
          ]
        },
        {
          "id": "6718472",
          "text": "Avete un pianoforte?",
          "translation": "У вас есть пианино?",
          "source": "Tatoeba #6718472 @dnnywld / #6718112 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6718472",
          "cefr_level": "A1",
          "word_slugs": [
            "pianoforte-noun"
          ]
        },
        {
          "id": "5662175",
          "text": "Che pianoforte costoso!",
          "translation": "Какое дорогое пианино!",
          "source": "Tatoeba #5662175 @dnnywld / #5661312 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662175",
          "cefr_level": "A1",
          "word_slugs": [
            "pianoforte-noun"
          ]
        },
        {
          "id": "7947585",
          "text": "Sapete suonare bene il pianoforte?",
          "translation": "Вы хорошо играете на пианино?",
          "source": "Tatoeba #7947585 @Guybrush88 / #7948974 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7947585",
          "cefr_level": "A1",
          "word_slugs": [
            "pianoforte-noun"
          ]
        },
        {
          "id": "373822",
          "text": "Qualcuno sta suonando il pianoforte.",
          "translation": "Кто-то играет на фортепьяно.",
          "source": "Tatoeba #373822 @Pharamp / #2576980 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/373822",
          "cefr_level": "A1",
          "word_slugs": [
            "pianoforte-noun"
          ]
        }
      ],
