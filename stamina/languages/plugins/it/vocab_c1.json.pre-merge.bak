    {
      "slug": "considerata-adj",
      "lemma": "considerata",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8504,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6784196",
          "text": "Wellington è considerata la città più ventosa al mondo.",
          "translation": "Веллингтон считается самым ветреным городом в мире.",
          "source": "Tatoeba #6784196 @dnnywld / #6783949 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6784196",
          "cefr_level": "A1",
          "word_slugs": [
            "considerata-adj"
          ]
        },
        {
          "id": "5544886",
          "text": "In questo caso questa parola deve essere considerata come un sostantivo.",
          "translation": "В данном случае это слово надо расценивать как существительное.",
          "source": "Tatoeba #5544886 @dnnywld / #5544807 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5544886",
          "cefr_level": "A1",
          "word_slugs": [
            "considerata-adj"
          ]
        },
        {
          "id": "2437098",
          "text": "Questa piazza una volta veniva considerata la piazza più trafficata d’Europa.",
          "translation": "Эта площадь когда-то считалась самой оживленной площадью Европы.",
          "source": "Tatoeba #2437098 @al_ex_an_der / #2437099 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2437098",
          "cefr_level": "A1",
          "word_slugs": [
            "considerata-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il considerata",
        "plural": "",
        "infinitive": ""
      }
    },
