          "cefr_level": "A1",
          "word_slugs": [
            "comprata-verb"
          ]
        },
        {
          "id": "715705",
          "text": "L'ho comprata ieri.",
          "translation": "Я купил её вчера.",
          "source": "Tatoeba #715705 @Guybrush88 / #3180544 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/715705",
          "cefr_level": "A1",
          "word_slugs": [
            "comprata-verb"
          ]
        },
        {
          "id": "5555743",
          "text": "Quando l'avete comprata?",
          "translation": "Когда Вы её купили?",
          "source": "Tatoeba #5555743 @dnnywld / #5554930 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5555743",
          "cefr_level": "A1",
          "word_slugs": [
