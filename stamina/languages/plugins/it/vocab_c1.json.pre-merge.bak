    {
      "slug": "esperimenti-noun",
      "lemma": "esperimenti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5620,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10814883",
          "text": "Nei suoi esperimenti lei utilizzava i piccioni.",
          "translation": "В своих экспериментах она использовала голубей.",
          "source": "Tatoeba #10814883 @dnnywld / #10814795 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10814883",
          "cefr_level": "A1",
          "word_slugs": [
            "esperimenti-noun"
          ]
        },
        {
          "id": "6961305",
          "text": "Conducete esperimenti durante le lezioni di fisica?",
          "translation": "Вы проводите опыты на уроках физики?",
          "source": "Tatoeba #6961305 @dnnywld / #6960487 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961305",
          "cefr_level": "A1",
          "word_slugs": [
            "esperimenti-noun"
          ]
        },
        {
          "id": "6961306",
          "text": "Conducete esperimenti durante le lezioni di chimica?",
          "translation": "Вы проводите опыты на уроках химии?",
          "source": "Tatoeba #6961306 @dnnywld / #6960486 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961306",
          "cefr_level": "A1",
          "word_slugs": [
            "esperimenti-noun"
          ]
        },
        {
          "id": "5589424",
          "text": "Gli esperimenti sono stati condotti a partire dall'anno 1997.",
          "translation": "Эксперименты проводились начиная с 1997 года.",
          "source": "Tatoeba #5589424 @dnnywld / #3049524 @oxioxigen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589424",
          "cefr_level": "A1",
          "word_slugs": [
            "esperimenti-noun"
          ]
        },
        {
          "id": "5481759",
          "text": "Cerco un articolo su degli esperimenti di un nuovo vaccino.",
          "translation": "Я ищу статью об экспериментах с новой вакциной.",
          "source": "Tatoeba #5481759 @dnnywld / #5480609 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5481759",
