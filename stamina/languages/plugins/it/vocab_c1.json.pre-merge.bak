    {
      "slug": "tasche-noun",
      "lemma": "Tasche",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5563,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5642333",
          "text": "Ho frugato nelle tasche.",
          "translation": "Я пошарился по карманам.",
          "source": "Tatoeba #5642333 @dnnywld / #5642056 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642333",
          "cefr_level": "A1",
          "word_slugs": [
            "tasche-noun"
          ]
        },
        {
          "id": "11372174",
          "text": "Nel suo vestito rosso ci sono delle tasche.",
          "translation": "На её красном платье есть карманы.",
          "source": "Tatoeba #11372174 @dnnywld / #11371774 @Txoria (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11372174",
          "cefr_level": "A1",
          "word_slugs": [
            "tasche-noun"
          ]
        },
        {
          "id": "6764579",
          "text": "Tirate fuori tutto dalle tasche, e mettete sul tavolo.",
          "translation": "Выкладывайте всё из карманов сюда, на стол.",
          "source": "Tatoeba #6764579 @dnnywld / #6764536 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6764579",
          "cefr_level": "A1",
          "word_slugs": [
            "tasche-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
