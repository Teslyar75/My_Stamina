    {
      "slug": "giocano-verb",
      "lemma": "giocano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7357,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "9045214",
          "text": "Oggi i nostri non giocano.",
          "translation": "Сегодня наши не играют.",
          "source": "Tatoeba #9045214 @Valdast / #6143355 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9045214",
          "cefr_level": "A1",
          "word_slugs": [
            "giocano-verb"
          ]
        },
        {
          "id": "6909191",
          "text": "Tom e Mary giocano insieme.",
          "translation": "Том и Мэри играют вместе.",
          "source": "Tatoeba #6909191 @dnnywld / #6909114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6909191",
          "cefr_level": "A1",
          "word_slugs": [
            "giocano-verb"
          ]
        },
        {
          "id": "5642433",
          "text": "Tom e Mary giocano a scacchi.",
          "translation": "Том и Мэри играют в шахматы.",
          "source": "Tatoeba #5642433 @dnnywld / #5641881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642433",
          "cefr_level": "A1",
          "word_slugs": [
            "giocano-verb"
          ]
        },
        {
          "id": "1089389",
          "text": "Ragazzi e ragazze giocano nel giardino.",
          "translation": "Мальчики и девочки играют в саду.",
          "source": "Tatoeba #1089389 @riccioberto / #2765722 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1089389",
          "cefr_level": "A1",
          "word_slugs": [
            "giocano-verb"
          ]
        },
        {
          "id": "3774394",
          "text": "Tom e Mary giocano a un videogioco.",
          "translation": "Том и Мария играют в видеоигру.",
          "source": "Tatoeba #3774394 @valealb / #3774403 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3774394",
          "cefr_level": "A1",
          "word_slugs": [
            "giocano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "giocano",
        "plural": "",
        "infinitive": "giocano"
      }
    },
    {
      "slug": "deriva-noun",
      "lemma": "deriva",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7358,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "379749",
          "text": "Questa parola deriva dal tedesco.",
          "translation": "Это слово происходит из немецкого.",
          "source": "Tatoeba #379749 @Pharamp / #10162748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379749",
          "cefr_level": "A1",
          "word_slugs": [
            "deriva-noun"
          ]
        },
        {
          "id": "5494368",
          "text": "Dall'esperienza deriva la saggezza.",
          "translation": "С опытом приходит мудрость.",
          "source": "Tatoeba #5494368 @dnnywld / #3882625 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494368",
          "cefr_level": "A1",
          "word_slugs": [
            "deriva-noun"
          ]
        },
        {
          "id": "10762275",
          "text": "Questa parola deriva dalla lingua tedesca.",
          "translation": "Это слово происходит из немецкого языка.",
          "source": "Tatoeba #10762275 @dnnywld / #10162749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10762275",
          "cefr_level": "A1",
          "word_slugs": [
            "deriva-noun"
          ]
        },
        {
          "id": "1005932",
          "text": "La lettera A deriva da un antichissimo pittogramma raffigurante un toro.",
          "translation": "Буква А развилась из древнейшей пиктограммы, обозначавшей быка.",
          "source": "Tatoeba #1005932 @riccioberto / #1005938 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1005932",
          "cefr_level": "A1",
          "word_slugs": [
            "deriva-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la deriva",
        "plural": "",
        "infinitive": ""
      }
