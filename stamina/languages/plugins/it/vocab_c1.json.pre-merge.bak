    {
      "slug": "uva-noun",
      "lemma": "uva",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7986,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10864714",
          "text": "Vuoi dell'uva?",
          "translation": "Хочешь винограда?",
          "source": "Tatoeba #10864714 @dnnywld / #2874404 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10864714",
          "cefr_level": "A1",
          "word_slugs": [
            "uva-noun"
          ]
        },
        {
          "id": "10864713",
          "text": "L'uva è acida.",
          "translation": "Виноград кислый.",
          "source": "Tatoeba #10864713 @dnnywld / #447715 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10864713",
          "cefr_level": "A1",
          "word_slugs": [
            "uva-noun"
          ]
        },
        {
          "id": "6609475",
          "text": "Mi piace l'uva.",
          "translation": "Я люблю виноград.",
          "source": "Tatoeba #6609475 @Guybrush88 / #6893194 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6609475",
          "cefr_level": "A1",
          "word_slugs": [
            "uva-noun"
          ]
        },
        {
          "id": "10864716",
          "text": "L'uva cresce nella vigna.",
          "translation": "Виноград растёт на виноградниках.",
          "source": "Tatoeba #10864716 @dnnywld / #10564882 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10864716",
          "cefr_level": "A1",
          "word_slugs": [
            "uva-noun"
          ]
        },
        {
          "id": "1091090",
          "text": "Il mio cane mangia l'uva.",
          "translation": "Моя собака ест виноград.",
          "source": "Tatoeba #1091090 @Guybrush88 / #2675419 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1091090",
          "cefr_level": "A1",
          "word_slugs": [
            "uva-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la uva",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "curiosità-noun",
      "lemma": "curiosità",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7987,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "4651267",
          "text": "La curiosità vince la paura.",
          "translation": "Любопытство побеждает страх.",
          "source": "Tatoeba #4651267 @ianna / #5478696 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4651267",
          "cefr_level": "A1",
          "word_slugs": [
            "curiosità-noun"
          ]
        },
        {
          "id": "440010",
          "text": "Lo chiedo per pura curiosità.",
          "translation": "Спрашиваю об этом из праздного любопытства.",
          "source": "Tatoeba #440010 @Pharamp / #3109603 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/440010",
          "cefr_level": "A1",
          "word_slugs": [
            "curiosità-noun"
          ]
        },
        {
          "id": "3257962",
          "text": "Io non dormirò dalla curiosità!",
          "translation": "Я не буду спать от любопытства!",
          "source": "Tatoeba #3257962 @Guybrush88 / #5634416 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3257962",
          "cefr_level": "A1",
          "word_slugs": [
            "curiosità-noun"
          ]
        },
        {
          "id": "10865234",
          "text": "Questo suscita la mia curiosità.",
          "translation": "Это возбуждает моё любопытство.",
          "source": "Tatoeba #10865234 @dnnywld / #4438781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10865234",
          "cefr_level": "A1",
          "word_slugs": [
            "curiosità-noun"
          ]
        },
        {
          "id": "10865236",
          "text": "Tutto questo suscita la mia curiosità.",
          "translation": "Всё это возбуждает моё любопытство.",
          "source": "Tatoeba #10865236 @dnnywld / #2503191 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10865236",
          "cefr_level": "A1",
          "word_slugs": [
            "curiosità-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la curiosità",
        "plural": "",
        "infinitive": ""
      }
    },
