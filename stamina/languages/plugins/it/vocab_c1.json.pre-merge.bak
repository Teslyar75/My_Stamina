    {
      "slug": "sposarsi-verb",
      "lemma": "sposarsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5155,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10772617",
          "text": "È tempo di sposarsi!",
          "translation": "Пора жениться!",
          "source": "Tatoeba #10772617 @dnnywld / #3189804 @averoes (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10772617",
          "cefr_level": "A1",
          "word_slugs": [
            "sposarsi-verb"
          ]
        },
        {
          "id": "5472278",
          "text": "Lui non vuole sposarsi.",
          "translation": "Он не хочет жениться.",
          "source": "Tatoeba #5472278 @dnnywld / #4604082 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472278",
          "cefr_level": "A1",
          "word_slugs": [
            "sposarsi-verb"
          ]
        },
        {
          "id": "1107371",
          "text": "Fidanzarsi non è sposarsi.",
          "translation": "Обручение — ещё не свадьба.",
          "source": "Tatoeba #1107371 @riccioberto / #663212 @salikh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1107371",
          "cefr_level": "A1",
          "word_slugs": [
            "sposarsi-verb"
          ]
        },
        {
          "id": "6557300",
          "text": "So che Tom vuole sposarsi.",
          "translation": "Я знаю, что Том хочет жениться.",
          "source": "Tatoeba #6557300 @Guybrush88 / #6797483 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6557300",
          "cefr_level": "A1",
          "word_slugs": [
            "sposarsi-verb"
          ]
        },
        {
          "id": "5487638",
          "text": "Tom non vuole nemmeno sposarsi.",
          "translation": "Том даже не хочет жениться.",
          "source": "Tatoeba #5487638 @dnnywld / #4740226 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5487638",
          "cefr_level": "A1",
          "word_slugs": [
            "sposarsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sposarsi",
        "plural": "",
        "infinitive": "sposarsi"
      }
