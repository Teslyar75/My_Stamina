    {
      "slug": "contano-verb",
      "lemma": "contano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6438,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2841278",
          "text": "Contano di tornare.",
          "translation": "Они рассчитывают вернуться.",
          "source": "Tatoeba #2841278 @Guybrush88 / #3864466 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2841278",
          "cefr_level": "A1",
          "word_slugs": [
            "contano-verb"
          ]
        },
        {
          "id": "5981114",
          "text": "Le dimensioni contano.",
          "translation": "Размер имеет значение.",
          "source": "Tatoeba #5981114 @dnnywld / #3537104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5981114",
          "cefr_level": "A1",
          "word_slugs": [
            "contano-verb"
          ]
        },
        {
          "id": "8808704",
          "text": "Le vite nere contano.",
          "translation": "Черные жизни важны.",
          "source": "Tatoeba #8808704 @Guybrush88 / #8809518 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8808704",
          "cefr_level": "A1",
          "word_slugs": [
            "contano-verb"
          ]
        },
        {
          "id": "4260433",
          "text": "Le dimensioni non contano.",
          "translation": "Размер не имеет значения.",
          "source": "Tatoeba #4260433 @Guybrush88 / #1655013 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4260433",
          "cefr_level": "A1",
          "word_slugs": [
            "contano-verb"
          ]
        },
        {
          "id": "6141133",
          "text": "Tutti contano su di te.",
          "translation": "Все рассчитывают на тебя.",
          "source": "Tatoeba #6141133 @dnnywld / #3309778 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6141133",
          "cefr_level": "A1",
          "word_slugs": [
            "contano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "contano",
