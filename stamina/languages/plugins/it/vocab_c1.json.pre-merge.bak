    {
      "slug": "somma-adj",
      "lemma": "somma",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5060,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5514438",
          "text": "Su quale somma fate conto?",
          "translation": "На какую сумму вы рассчитываете?",
          "source": "Tatoeba #5514438 @dnnywld / #5513179 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514438",
          "cefr_level": "A1",
          "word_slugs": [
            "somma-adj"
          ]
        },
        {
          "id": "6163489",
          "text": "Che somma verserete come prima rata?",
          "translation": "Какую сумму Вы внесёте в качестве первого взноса?",
          "source": "Tatoeba #6163489 @dnnywld / #6163352 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6163489",
          "cefr_level": "A1",
          "word_slugs": [
            "somma-adj"
          ]
        },
        {
          "id": "6879438",
          "text": "Si tratta di una somma di mille dollari.",
          "translation": "Речь идёт о сумме в тысячу долларов.",
          "source": "Tatoeba #6879438 @dnnywld / #2671133 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879438",
          "cefr_level": "A1",
          "word_slugs": [
            "somma-adj"
          ]
        },
        {
          "id": "5397733",
          "text": "Tom ha vinto alla lotteria una somma piuttosto grossa.",
          "translation": "Том выиграл в лотерею довольно крупную сумму.",
          "source": "Tatoeba #5397733 @dnnywld / #5397691 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5397733",
          "cefr_level": "A1",
          "word_slugs": [
            "somma-adj"
          ]
        },
        {
          "id": "10970746",
          "text": "Una lingua è molto più della somma delle sue parole.",
          "translation": "Язык - нечто гораздо большее, чем сумма его слов.",
          "source": "Tatoeba #10970746 @Adelpa / #10970750 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10970746",
          "cefr_level": "A1",
          "word_slugs": [
            "somma-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
