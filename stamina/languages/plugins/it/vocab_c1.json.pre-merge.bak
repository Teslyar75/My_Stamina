          "id": "8078857",
          "text": "Va bene commettere errori.",
          "translation": "Совершать ошибки — это нормально.",
          "source": "Tatoeba #8078857 @Guybrush88 / #2934581 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8078857",
          "cefr_level": "A1",
          "word_slugs": [
            "commettere-verb"
          ]
        },
        {
          "id": "5448013",
          "text": "È normale commettere errori.",
          "translation": "Делать ошибки - это нормально.",
          "source": "Tatoeba #5448013 @dnnywld / #2929399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5448013",
          "cefr_level": "A1",
          "word_slugs": [
            "commettere-verb"
          ]
        },
        {
          "id": "7060279",
          "text": "Non voglio commettere errori.",
          "translation": "Я не хочу ошибиться.",
          "source": "Tatoeba #7060279 @dnnywld / #7059271 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7060279",
          "cefr_level": "A1",
          "word_slugs": [
            "commettere-verb"
          ]
        },
        {
          "id": "5448032",
          "text": "Non ho paura di commettere errori.",
          "translation": "Я не боюсь делать ошибки.",
          "source": "Tatoeba #5448032 @dnnywld / #1487011 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5448032",
          "cefr_level": "A1",
