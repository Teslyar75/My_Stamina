          ]
        },
        {
          "id": "5500354",
          "text": "Quante fermate ci sono per la stazione?",
          "translation": "Сколько остановок до вокзала?",
          "source": "Tatoeba #5500354 @dnnywld / #5500223 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500354",
