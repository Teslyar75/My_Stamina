      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6795959",
          "text": "Indovinate dov'ero!",
          "translation": "Угадайте, где я был!",
          "source": "Tatoeba #6795959 @dnnywld / #6794105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6795959",
          "cefr_level": "A1",
          "word_slugs": [
            "indovinate-verb"
          ]
        },
        {
          "id": "5626763",
          "text": "Indovinate quanto sono alto.",
          "translation": "Угадайте, какой у меня рост.",
          "source": "Tatoeba #5626763 @dnnywld / #5626294 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626763",
          "cefr_level": "A1",
          "word_slugs": [
            "indovinate-verb"
          ]
        },
        {
          "id": "5624200",
          "text": "Indovinate cosa ho con me.",
          "translation": "Угадайте, что у меня есть.",
          "source": "Tatoeba #5624200 @dnnywld / #5623997 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624200",
          "cefr_level": "A1",
          "word_slugs": [
            "indovinate-verb"
          ]
        },
        {
          "id": "5624202",
          "text": "Indovinate cosa ho per voi.",
          "translation": "Угадайте, что у меня для вас есть.",
          "source": "Tatoeba #5624202 @dnnywld / #5623999 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624202",
          "cefr_level": "A1",
          "word_slugs": [
            "indovinate-verb"
          ]
        },
        {
          "id": "3354466",
          "text": "Indovinate chi ho visto oggi.",
          "translation": "Угадайте, кого я сегодня видел.",
          "source": "Tatoeba #3354466 @Guybrush88 / #6166933 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3354466",
          "cefr_level": "A1",
