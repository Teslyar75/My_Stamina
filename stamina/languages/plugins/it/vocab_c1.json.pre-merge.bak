      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2190559",
          "text": "Tom è amichevole.",
          "translation": "Том дружелюбный.",
          "source": "Tatoeba #2190559 @Guybrush88 / #5512172 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2190559",
          "cefr_level": "A1",
          "word_slugs": [
            "amichevole-adj"
          ]
        },
        {
          "id": "5693162",
          "text": "L'ho trovato amichevole.",
          "translation": "Мне он показался дружелюбным.",
          "source": "Tatoeba #5693162 @dnnywld / #5693131 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5693162",
          "cefr_level": "A1",
          "word_slugs": [
            "amichevole-adj"
          ]
        },
        {
          "id": "5693161",
          "text": "Mi è sembrato amichevole.",
          "translation": "Мне он показался дружелюбным.",
          "source": "Tatoeba #5693161 @dnnywld / #5693131 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5693161",
          "cefr_level": "A1",
          "word_slugs": [
            "amichevole-adj"
          ]
        },
        {
          "id": "6361913",
          "text": "Tom non era molto amichevole.",
          "translation": "Том был не очень дружелюбен.",
          "source": "Tatoeba #6361913 @dnnywld / #6361184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361913",
          "cefr_level": "A1",
          "word_slugs": [
            "amichevole-adj"
          ]
        },
        {
          "id": "5387732",
          "text": "La gente qui è molto amichevole.",
          "translation": "Народ здесь очень дружелюбный.",
          "source": "Tatoeba #5387732 @dnnywld / #5387282 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387732",
