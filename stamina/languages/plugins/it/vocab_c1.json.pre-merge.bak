    {
      "slug": "venditore-adj",
      "lemma": "venditore",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6709,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5418961",
          "text": "Anche lui è un venditore.",
          "translation": "Он тоже продавец.",
          "source": "Tatoeba #5418961 @dnnywld / #5418893 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5418961",
          "cefr_level": "A1",
          "word_slugs": [
            "venditore-adj"
          ]
        },
        {
          "id": "5576902",
          "text": "Tom è un abile venditore.",
          "translation": "Том ловкий продавец.",
          "source": "Tatoeba #5576902 @dnnywld / #3022274 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5576902",
          "cefr_level": "A1",
          "word_slugs": [
            "venditore-adj"
          ]
        },
        {
          "id": "7124393",
          "text": "Tom è un venditore di automobili.",
          "translation": "Том — продавец автомобилей.",
          "source": "Tatoeba #7124393 @dnnywld / #6170094 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7124393",
          "cefr_level": "A1",
          "word_slugs": [
            "venditore-adj"
          ]
        },
        {
          "id": "6809345",
          "text": "L'ho comprato da un venditore ambulante.",
          "translation": "Я купил это у уличного торговца.",
          "source": "Tatoeba #6809345 @dnnywld / #6808911 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6809345",
          "cefr_level": "A1",
          "word_slugs": [
            "venditore-adj"
          ]
        },
        {
          "id": "5652161",
          "text": "\"Posso esserVi di aiuto?\" - chiese il venditore.",
          "translation": "\"Я могу Вам помочь?\" - спросил продавец.",
          "source": "Tatoeba #5652161 @dnnywld / #5651637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652161",
          "cefr_level": "A1",
          "word_slugs": [
            "venditore-adj"
          ]
        }
