    {
      "slug": "nuziale-adj",
      "lemma": "nuziale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9916,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6833567",
          "text": "Tom non indossa la fede nuziale.",
          "translation": "Том не носит обручальное кольцо.",
          "source": "Tatoeba #6833567 @dnnywld / #6832769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833567",
          "cefr_level": "A1",
          "word_slugs": [
            "nuziale-adj"
          ]
        },
        {
          "id": "3539652",
          "text": "Tom non indossa una fede nuziale.",
          "translation": "Том не носит обручальное кольцо.",
          "source": "Tatoeba #3539652 @Guybrush88 / #6832769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3539652",
          "cefr_level": "A1",
          "word_slugs": [
            "nuziale-adj"
          ]
        },
        {
          "id": "5653654",
          "text": "Ti piace la nostra torta nuziale?",
          "translation": "Тебе нравится наш свадебный торт?",
          "source": "Tatoeba #5653654 @dnnywld / #5653631 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5653654",
          "cefr_level": "A1",
          "word_slugs": [
            "nuziale-adj"
          ]
        },
        {
          "id": "12383835",
          "text": "La cerimonia nuziale ha avuto luogo ieri sera.",
          "translation": "Церемония бракосочетания состоялась вчера вечером.",
          "source": "Tatoeba #12383835 @Bernie75 / #12383834 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12383835",
          "cefr_level": "A1",
          "word_slugs": [
            "nuziale-adj"
          ]
        },
        {
          "id": "5549651",
          "text": "Non vedo l'ora di vederti nell'abito nuziale.",
          "translation": "Жду не дождусь, когда увижу тебя в свадебном платье.",
          "source": "Tatoeba #5549651 @dnnywld / #4472692 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549651",
          "cefr_level": "A1",
          "word_slugs": [
            "nuziale-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "nuziale",
        "plural": "",
        "infinitive": ""
      }
    },
