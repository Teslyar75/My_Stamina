          ]
        },
        {
          "id": "5982397",
          "text": "Quanti politici conoscete di persona?",
          "translation": "Со сколькими политиками Вы знакомы лично?",
          "source": "Tatoeba #5982397 @dnnywld / #5982186 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5982397",
          "cefr_level": "A1",
          "word_slugs": [
            "politici-noun"
          ]
        },
        {
          "id": "12994946",
          "text": "I politici non sono amici vostri.",
          "translation": "Политики вам не друзья.",
          "source": "Tatoeba #12994946 @dnnywld / #12994233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12994946",
          "cefr_level": "A1",
          "word_slugs": [
            "politici-noun"
          ]
        },
        {
          "id": "5397244",
          "text": "I politici non dicono mail il vero.",
          "translation": "Политики не всегда говорят правду.",
          "source": "Tatoeba #5397244 @dnnywld / #5397238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5397244",
          "cefr_level": "A1",
          "word_slugs": [
            "politici-noun"
          ]
        }
      ],
