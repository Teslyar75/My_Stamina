    {
      "slug": "mazza-noun",
      "lemma": "mazza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5339,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5409088",
          "text": "Lui ha colpito la palla con la mazza.",
          "translation": "Он ударил по мячу битой.",
          "source": "Tatoeba #5409088 @dnnywld / #4515012 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409088",
          "cefr_level": "A1",
          "word_slugs": [
            "mazza-noun"
          ]
        },
        {
          "id": "5693172",
          "text": "Tom colpì Mary con una mazza da baseball.",
          "translation": "Том ударил Мэри бейсбольной битой.",
          "source": "Tatoeba #5693172 @dnnywld / #5693094 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5693172",
          "cefr_level": "A1",
          "word_slugs": [
            "mazza-noun"
          ]
        },
        {
          "id": "5409114",
          "text": "Ieri hanno rubato la mazza, assieme alle palle.",
          "translation": "Биту украли вчера, как и мячи.",
          "source": "Tatoeba #5409114 @dnnywld / #4515019 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409114",
          "cefr_level": "A1",
          "word_slugs": [
            "mazza-noun"
          ]
        },
        {
          "id": "4821139",
          "text": "Lei lo ha attaccato con una mazza da baseball.",
          "translation": "Она напала на него с бейсбольной битой.",
          "source": "Tatoeba #4821139 @Guybrush88 / #1797850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4821139",
          "cefr_level": "A1",
          "word_slugs": [
            "mazza-noun"
          ]
        },
        {
          "id": "5409161",
          "text": "Non solo le palle, ieri hanno rubato anche la mazza.",
          "translation": "Не только мячи, вчера украли даже биту.",
          "source": "Tatoeba #5409161 @dnnywld / #1039906 @Vixen96 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409161",
          "cefr_level": "A1",
          "word_slugs": [
            "mazza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la mazza",
        "plural": "",
        "infinitive": ""
      }
    },
    {
