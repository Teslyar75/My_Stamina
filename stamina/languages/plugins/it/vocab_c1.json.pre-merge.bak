    {
      "slug": "orecchini-noun",
      "lemma": "orecchini",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9134,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5589152",
          "text": "Quanto costano questi orecchini?",
          "translation": "Сколько стоят эти серьги?",
          "source": "Tatoeba #5589152 @dnnywld / #5588444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589152",
          "cefr_level": "A1",
          "word_slugs": [
            "orecchini-noun"
          ]
        },
        {
          "id": "6892389",
          "text": "\"Di chi sono questi orecchini?\" - \"Di Tania\".",
          "translation": "- Чьи это серёжки? - Танины.",
          "source": "Tatoeba #6892389 @dnnywld / #1743725 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6892389",
          "cefr_level": "A1",
          "word_slugs": [
            "orecchini-noun"
          ]
        },
        {
          "id": "5691423",
          "text": "Mary si mise i suoi orecchini d'oro.",
          "translation": "Мэри надела свои золотые серьги.",
          "source": "Tatoeba #5691423 @dnnywld / #5086114 @Desoxyribose (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5691423",
          "cefr_level": "A1",
          "word_slugs": [
            "orecchini-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il orecchini",
        "plural": "",
        "infinitive": ""
      }
