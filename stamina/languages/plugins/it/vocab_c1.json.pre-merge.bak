      "frequency_rank": 6850,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7587845",
          "text": "Questa firma non è valida.",
          "translation": "Эта подпись недействительна.",
          "source": "Tatoeba #7587845 @dnnywld / #7587543 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7587845",
          "cefr_level": "A1",
          "word_slugs": [
            "valida-adj"
          ]
        },
        {
          "id": "3863165",
          "text": "La tua offerta è ancora valida?",
          "translation": "Твоё предложение ещё в силе?",
          "source": "Tatoeba #3863165 @Guybrush88 / #6050403 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3863165",
          "cefr_level": "A1",
          "word_slugs": [
            "valida-adj"
          ]
        },
        {
          "id": "5565806",
          "text": "Tom ha imparato una valida lezione.",
          "translation": "Том усвоил ценный урок.",
          "source": "Tatoeba #5565806 @dnnywld / #5565173 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5565806",
          "cefr_level": "A1",
          "word_slugs": [
            "valida-adj"
          ]
        },
        {
          "id": "11862394",
          "text": "Questa carta era valida nel gennaio 2006.",
          "translation": "Эта карта была действительна до января 2006 года.",
          "source": "Tatoeba #11862394 @dnnywld / #11861128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11862394",
          "cefr_level": "A1",
          "word_slugs": [
            "valida-adj"
          ]
        },
        {
          "id": "5509530",
          "text": "La registrazione è valida solo dopo il pagamento anticipato.",
          "translation": "Регистрация действительна только после предоплаты.",
          "source": "Tatoeba #5509530 @dnnywld / #5509206 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5509530",
          "cefr_level": "A1",
          "word_slugs": [
            "valida-adj"
          ]
        }
