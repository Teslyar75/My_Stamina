    {
      "slug": "perdona-verb",
      "lemma": "perdona",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9071,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5616131",
          "text": "Perdona i miei peccati!",
          "translation": "Прости мои грехи!",
          "source": "Tatoeba #5616131 @dnnywld / #5615872 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616131",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        },
        {
          "id": "5435062",
          "text": "Maria non perdona l'infedeltà.",
          "translation": "Мария не прощает измен.",
          "source": "Tatoeba #5435062 @ianna / #5554061 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5435062",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        },
        {
          "id": "10849575",
          "text": "L'aviazione non perdona gli errori.",
          "translation": "Авиация ошибок не прощает.",
          "source": "Tatoeba #10849575 @dnnywld / #4302784 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849575",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        },
        {
          "id": "1244931",
          "text": "\"Romanzi? Io odio i romanzi.\" Oh musa, perdona la sua blasfemia.",
          "translation": "\"Романы? Ненавижу романы\". О муза, прости ей кощунство.",
          "source": "Tatoeba #1244931 @Guybrush88 / #1322027 @beshine (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1244931",
          "cefr_level": "A1",
          "word_slugs": [
            "perdona-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "perdona",
        "plural": "",
        "infinitive": "perdona"
      }
