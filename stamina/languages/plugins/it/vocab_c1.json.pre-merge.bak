      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5836047",
          "text": "Le ragazze sono diventate amiche.",
          "translation": "Девчата стали подругами.",
          "source": "Tatoeba #5836047 @dnnywld / #4143344 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5836047",
          "cefr_level": "A1",
          "word_slugs": [
            "diventate-verb"
          ]
        },
        {
          "id": "5767888",
          "text": "Più cioccolato mangiate, più grassi diventate.",
          "translation": "Чем больше шоколада Вы едите, тем толще становитесь.",
          "source": "Tatoeba #5767888 @dnnywld / #5767858 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5767888",
          "cefr_level": "A1",
          "word_slugs": [
            "diventate-verb"
          ]
        },
        {
          "id": "3409843",
