          ]
        },
        {
          "id": "5500220",
          "text": "Si è staccato lo specchietto retrovisore.",
          "translation": "Зеркало заднего вида отвалилось.",
          "source": "Tatoeba #5500220 @dnnywld / #2585005 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500220",
