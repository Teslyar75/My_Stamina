    {
      "slug": "trasferiti-verb",
      "lemma": "trasferiti",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6890,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6367448",
          "text": "Ci siamo trasferiti a Boston tre anni fa.",
          "translation": "Мы переехали в Бостон три года назад.",
          "source": "Tatoeba #6367448 @dnnywld / #6366952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367448",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferiti-verb"
          ]
        },
        {
          "id": "5610513",
          "text": "Ci siamo trasferiti a Boston quando avevo tre anni.",
          "translation": "Мы переехали в Бостон, когда мне было три года.",
          "source": "Tatoeba #5610513 @dnnywld / #5609704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5610513",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferiti-verb"
          ]
        },
        {
          "id": "5512276",
          "text": "Sono passati tre anni da quando ci siamo trasferiti qui.",
          "translation": "Прошло три года с тех пор, как мы сюда переехали.",
          "source": "Tatoeba #5512276 @dnnywld / #556073 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512276",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferiti-verb"
          ]
        },
        {
          "id": "7610937",
          "text": "Tom e Mary si sono trasferiti a Boston tre anni fa.",
          "translation": "Том и Мэри переехали в Бостон три года назад.",
          "source": "Tatoeba #7610937 @dnnywld / #7610400 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7610937",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferiti-verb"
          ]
        },
        {
          "id": "7610938",
          "text": "Tom e Mary si sono sposati e si sono trasferiti a Boston.",
          "translation": "Том и Мэри поженились и переехали в Бостон.",
          "source": "Tatoeba #7610938 @dnnywld / #7610399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7610938",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferiti-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "trasferiti",
        "plural": "",
        "infinitive": "trasferiti"
      }
