      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6018627",
          "text": "Di solito mi alzo tardi.",
          "translation": "Обычно я встаю поздно.",
          "source": "Tatoeba #6018627 @dnnywld / #6018037 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6018627",
          "cefr_level": "A1",
          "word_slugs": [
            "alzo-noun"
          ]
        },
        {
          "id": "6809504",
          "text": "Di solito mi alzo presto.",
          "translation": "Обычно я встаю рано.",
          "source": "Tatoeba #6809504 @dnnywld / #6808481 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6809504",
          "cefr_level": "A1",
          "word_slugs": [
            "alzo-noun"
          ]
        },
        {
          "id": "6830270",
          "text": "Mi alzo presto per abitudine.",
          "translation": "Я по привычке встаю рано.",
          "source": "Tatoeba #6830270 @dnnywld / #6142634 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6830270",
          "cefr_level": "A1",
          "word_slugs": [
            "alzo-noun"
          ]
        },
        {
          "id": "666747",
          "text": "Di solito mi alzo alle sei.",
          "translation": "Обычно я встаю в шесть.",
          "source": "Tatoeba #666747 @Guybrush88 / #610825 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/666747",
          "cefr_level": "A1",
          "word_slugs": [
            "alzo-noun"
          ]
        },
        {
          "id": "6587141",
          "text": "Ogni giorno mi alzo alle sette.",
          "translation": "Я каждый день встаю в семь.",
          "source": "Tatoeba #6587141 @dnnywld / #6584587 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6587141",
          "cefr_level": "A1",
