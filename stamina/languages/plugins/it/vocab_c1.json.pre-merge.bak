    {
      "slug": "espresso-verb",
      "lemma": "espresso",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6392,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6316010",
          "text": "Devo essermi espresso male.",
          "translation": "Я, должно быть, плохо выразился.",
          "source": "Tatoeba #6316010 @dnnywld / #3467844 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6316010",
          "cefr_level": "A1",
          "word_slugs": [
            "espresso-verb"
          ]
        },
        {
          "id": "6950276",
          "text": "Lui ha espresso dei dubbi.",
          "translation": "Он выразил сомнение.",
          "source": "Tatoeba #6950276 @dnnywld / #6911404 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950276",
          "cefr_level": "A1",
          "word_slugs": [
            "espresso-verb"
          ]
        },
        {
          "id": "6924242",
          "text": "Posso avere un doppio espresso?",
