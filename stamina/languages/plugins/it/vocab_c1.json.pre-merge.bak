    {
      "slug": "terrà-verb",
      "lemma": "terrà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8805,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5388453",
          "text": "Stasera lui terrà una conferenza.",
          "translation": "Сегодня вечером он даст конференцию.",
          "source": "Tatoeba #5388453 @dnnywld / #5388443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388453",
          "cefr_level": "A1",
          "word_slugs": [
            "terrà-verb"
          ]
        },
        {
          "id": "5388454",
          "text": "Stasera Tom terrà una conferenza.",
          "translation": "Сегодня вечером Том даст конференцию.",
          "source": "Tatoeba #5388454 @dnnywld / #5388442 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388454",
          "cefr_level": "A1",
          "word_slugs": [
            "terrà-verb"
          ]
        },
        {
          "id": "5388456",
          "text": "Stasera lei terrà una conferenza.",
          "translation": "Сегодня вечером она даст конференцию.",
          "source": "Tatoeba #5388456 @dnnywld / #5388441 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388456",
          "cefr_level": "A1",
          "word_slugs": [
            "terrà-verb"
          ]
        },
        {
          "id": "5388446",
          "text": "Stasera Mary terrà una conferenza.",
          "translation": "Сегодня вечером Мэри даст конференцию.",
          "source": "Tatoeba #5388446 @dnnywld / #5388438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388446",
          "cefr_level": "A1",
          "word_slugs": [
            "terrà-verb"
          ]
        },
        {
          "id": "6956526",
          "text": "La festa si terrà di sabato.",
          "translation": "Вечеринка состоится в субботу.",
          "source": "Tatoeba #6956526 @dnnywld / #6956340 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6956526",
          "cefr_level": "A1",
          "word_slugs": [
            "terrà-verb"
          ]
        }
      ],
      "tags": [
