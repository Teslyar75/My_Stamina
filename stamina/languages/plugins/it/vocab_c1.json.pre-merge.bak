    {
      "slug": "lettura-noun",
      "lemma": "lettura",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5647,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5827127",
          "text": "Continuate la lettura.",
          "translation": "Продолжайте чтение.",
          "source": "Tatoeba #5827127 @dnnywld / #2668647 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5827127",
          "cefr_level": "A1",
          "word_slugs": [
            "lettura-noun"
          ]
        },
        {
          "id": "5827979",
          "text": "Tom continuò la lettura.",
          "translation": "Том продолжил чтение.",
          "source": "Tatoeba #5827979 @dnnywld / #3924900 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5827979",
          "cefr_level": "A1",
          "word_slugs": [
            "lettura-noun"
          ]
        },
        {
          "id": "5827274",
          "text": "Ho continuato la lettura.",
          "translation": "Я продолжил чтение.",
          "source": "Tatoeba #5827274 @dnnywld / #2112321 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5827274",
          "cefr_level": "A1",
          "word_slugs": [
            "lettura-noun"
          ]
        },
        {
          "id": "5827987",
          "text": "Continuai la mia lettura.",
          "translation": "Я продолжил своё чтение.",
          "source": "Tatoeba #5827987 @dnnywld / #425445 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5827987",
          "cefr_level": "A1",
          "word_slugs": [
            "lettura-noun"
          ]
        },
        {
          "id": "5857000",
          "text": "Fai una lettura del contatore.",
          "translation": "Сними показания счётчика.",
