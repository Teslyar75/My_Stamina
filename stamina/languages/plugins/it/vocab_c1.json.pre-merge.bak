    {
      "slug": "reception-noun",
      "lemma": "reception",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9751,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7870161",
          "text": "La chiave viene ritirata alla reception.",
          "translation": "Ключ берут на ресепшене.",
          "source": "Tatoeba #7870161 @dnnywld / #7869753 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7870161",
          "cefr_level": "A1",
          "word_slugs": [
            "reception-noun"
          ]
        },
        {
          "id": "7870162",
          "text": "La chiave viene lasciata alla reception.",
          "translation": "Ключ оставляют на ресепшене.",
          "source": "Tatoeba #7870162 @dnnywld / #7869750 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7870162",
          "cefr_level": "A1",
          "word_slugs": [
            "reception-noun"
          ]
        },
        {
          "id": "5626808",
          "text": "Chiediamo alla reception di chiamarci un taxi?",
          "translation": "Попросить портье вызвать нам такси?",
          "source": "Tatoeba #5626808 @dnnywld / #5626144 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626808",
          "cefr_level": "A1",
          "word_slugs": [
            "reception-noun"
          ]
        },
        {
          "id": "5626810",
          "text": "Vuoi che chieda alla reception di chiamarti un taxi?",
          "translation": "Хочешь, я попрошу портье вызвать тебе такси?",
          "source": "Tatoeba #5626810 @dnnywld / #5626147 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626810",
          "cefr_level": "A1",
          "word_slugs": [
            "reception-noun"
          ]
        },
        {
          "id": "5626804",
          "text": "Telefonerò alla reception e chiederò di chiamare un taxi.",
          "translation": "Я позвоню портье и попрошу вызвать такси.",
          "source": "Tatoeba #5626804 @dnnywld / #5626137 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626804",
          "cefr_level": "A1",
          "word_slugs": [
            "reception-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
