    {
      "slug": "ricevi-verb",
      "lemma": "ricevi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6780,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7427659",
          "text": "Non ricevi ospiti.",
          "translation": "Ты не встречаешь гостей.",
          "source": "Tatoeba #7427659 @dnnywld / #7427176 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7427659",
          "cefr_level": "A1",
          "word_slugs": [
            "ricevi-verb"
          ]
        },
        {
          "id": "845396",
          "text": "Quello che vedi ricevi.",
          "translation": "Что видишь, то и получишь.",
          "source": "Tatoeba #845396 @riccioberto / #644225 @ant_katcin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/845396",
          "cefr_level": "A1",
          "word_slugs": [
            "ricevi-verb"
          ]
        },
        {
          "id": "6917818",
          "text": "Prima ricevi un'istruzione superiore e poi fai quello che vuoi.",
          "translation": "Сначала получи высшее образование, а потом делай что хочешь.",
          "source": "Tatoeba #6917818 @dnnywld / #6917742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917818",
          "cefr_level": "A1",
          "word_slugs": [
            "ricevi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ricevi",
        "plural": "",
        "infinitive": "ricevi"
      }
    },
    {
      "slug": "ridono-verb",
      "lemma": "ridono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6781,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5652158",
          "text": "Ridono di noi.",
          "translation": "Над нами смеются.",
          "source": "Tatoeba #5652158 @dnnywld / #5651639 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652158",
          "cefr_level": "A1",
          "word_slugs": [
            "ridono-verb"
          ]
        },
        {
          "id": "1589292",
          "text": "Tutti ridono di me!",
          "translation": "Все смеются надо мной!",
          "source": "Tatoeba #1589292 @bjoky / #3151746 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1589292",
          "cefr_level": "A1",
          "word_slugs": [
            "ridono-verb"
          ]
        },
        {
          "id": "5644793",
          "text": "Tutti ridono di noi.",
          "translation": "Все над нами смеются.",
          "source": "Tatoeba #5644793 @dnnywld / #5644642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5644793",
          "cefr_level": "A1",
          "word_slugs": [
            "ridono-verb"
          ]
        },
        {
          "id": "12821884",
          "text": "Perché le iene ridono?",
          "translation": "Почему гиены смеются?",
          "source": "Tatoeba #12821884 @Adelpa / #12821875 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12821884",
          "cefr_level": "A1",
          "word_slugs": [
            "ridono-verb"
          ]
        },
        {
          "id": "5499657",
          "text": "Odio quando ridono di me.",
          "translation": "Терпеть не могу, когда надо мной смеются.",
          "source": "Tatoeba #5499657 @dnnywld / #5499056 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499657",
          "cefr_level": "A1",
          "word_slugs": [
            "ridono-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ridono",
