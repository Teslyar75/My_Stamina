      "examples": [
        {
          "id": "5508591",
          "text": "Eravamo molto affamati.",
          "translation": "Мы очень хотели есть.",
          "source": "Tatoeba #5508591 @dnnywld / #5508343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5508591",
          "cefr_level": "A1",
