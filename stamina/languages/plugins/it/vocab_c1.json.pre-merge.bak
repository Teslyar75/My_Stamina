            "seguite-verb"
          ]
        },
        {
          "id": "1300765",
          "text": "Seguite quell'automobile.",
          "translation": "Следуй за той машиной.",
          "source": "Tatoeba #1300765 @Guybrush88 / #2418396 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1300765",
          "cefr_level": "A1",
          "word_slugs": [
            "seguite-verb"
          ]
        },
        {
          "id": "5476262",
          "text": "Seguite semplicemente il mio esempio.",
          "translation": "Просто следуйте моему примеру.",
          "source": "Tatoeba #5476262 @dnnywld / #2036103 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476262",
