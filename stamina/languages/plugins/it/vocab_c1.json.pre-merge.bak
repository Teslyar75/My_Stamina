          ]
        },
        {
          "id": "5690436",
          "text": "Conosco questa barzelletta.",
          "translation": "Я этот анекдот знаю.",
          "source": "Tatoeba #5690436 @dnnywld / #5690151 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690436",
          "cefr_level": "A1",
          "word_slugs": [
