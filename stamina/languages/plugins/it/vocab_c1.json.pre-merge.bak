    {
      "slug": "animo-noun",
      "lemma": "animo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6226,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6774997",
          "text": "La musica è un moto dell'animo.",
          "translation": "Музыка - это порыв души.",
          "source": "Tatoeba #6774997 @dnnywld / #6774322 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6774997",
          "cefr_level": "A1",
          "word_slugs": [
            "animo-noun"
          ]
        },
        {
          "id": "5586540",
          "text": "Non so. Dipende dal mio stato d'animo.",
          "translation": "Не знаю. Зависит от настроения.",
          "source": "Tatoeba #5586540 @dnnywld / #5586146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586540",
          "cefr_level": "A1",
          "word_slugs": [
            "animo-noun"
          ]
        },
        {
          "id": "6828299",
          "text": "Tom è una persona adulta con l'animo di un bambino.",
          "translation": "Том - взрослый человек с душой ребёнка.",
