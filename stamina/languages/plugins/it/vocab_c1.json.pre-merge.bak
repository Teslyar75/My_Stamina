    {
      "slug": "avvisato-adj",
      "lemma": "avvisato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6383,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2005211",
          "text": "Avete avvisato Tom?",
          "translation": "Вы известили Тома?",
          "source": "Tatoeba #2005211 @Guybrush88 / #5675254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2005211",
          "cefr_level": "A1",
          "word_slugs": [
            "avvisato-adj"
          ]
        },
        {
          "id": "5596090",
          "text": "Non ti avevo avvisato?",
          "translation": "Разве я тебя не предупреждал?",
          "source": "Tatoeba #5596090 @dnnywld / #5595961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5596090",
          "cefr_level": "A1",
          "word_slugs": [
            "avvisato-adj"
          ]
        },
        {
          "id": "4580",
          "text": "Uomo avvisato, mezzo salvato.",
          "translation": "Предупреждён — значит вооружён.",
          "source": "Tatoeba #4580 @Guybrush88 / #381316 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4580",
          "cefr_level": "A1",
          "word_slugs": [
            "avvisato-adj"
          ]
        },
        {
          "id": "5616136",
          "text": "Lei ha avvisato che sarebbe arrivata tardi.",
          "translation": "Она предупредила, что вернётся поздно.",
          "source": "Tatoeba #5616136 @dnnywld / #5615867 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616136",
          "cefr_level": "A1",
          "word_slugs": [
            "avvisato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
