      "examples": [
        {
          "id": "5497671",
          "text": "Esistono angurie senza semi?",
          "translation": "Арбузы без семечек бывают?",
          "source": "Tatoeba #5497671 @dnnywld / #5497637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497671",
          "cefr_level": "A1",
