      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3695180",
          "text": "Peso oltre duecento chili.",
          "translation": "Я вешу больше двухсот килограмм.",
          "source": "Tatoeba #3695180 @Guybrush88 / #3695370 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3695180",
