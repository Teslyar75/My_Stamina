    {
      "slug": "scienziati-noun",
      "lemma": "scienziati",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5086,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7271059",
          "text": "Gli scienziati hanno raccolto dei dati.",
          "translation": "Учёные собрали данные.",
          "source": "Tatoeba #7271059 @Guybrush88 / #7274314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7271059",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziati-noun"
          ]
        },
        {
          "id": "6866902",
          "text": "La Germania ha prodotto molti scienziati.",
          "translation": "Германия произвела множество учёных.",
          "source": "Tatoeba #6866902 @dnnywld / #2836517 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866902",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziati-noun"
          ]
        },
        {
          "id": "6810650",
          "text": "Gli scienziati lo interpretano in un altro modo.",
          "translation": "Ученые объясняют это иначе.",
          "source": "Tatoeba #6810650 @dnnywld / #1385738 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6810650",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziati-noun"
          ]
        },
        {
          "id": "7063487",
          "text": "È dimostrato dagli scienziati e verificato dagli ingegneri.",
          "translation": "Это доказано учёными и проверено инженерами.",
          "source": "Tatoeba #7063487 @dnnywld / #7062927 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7063487",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziati-noun"
          ]
        },
        {
          "id": "2434724",
          "text": "Questo è un paradosso. Ma gli scienziati hanno certamente una spiegazione.",
          "translation": "Это парадокс. Но у учёных наверняка есть для этого объяснение.",
          "source": "Tatoeba #2434724 @al_ex_an_der / #2434720 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2434724",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziati-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il scienziati",
        "plural": "",
        "infinitive": ""
      }
    },
