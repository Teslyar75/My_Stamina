          "source": "Tatoeba #2417373 @al_ex_an_der / #2417364 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2417373",
          "cefr_level": "A1",
          "word_slugs": [
