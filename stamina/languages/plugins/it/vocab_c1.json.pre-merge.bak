    {
      "slug": "andò-verb",
      "lemma": "andò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5853,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3743124",
          "text": "Tom andò in pensione.",
          "translation": "Том ушел на пенсию.",
          "source": "Tatoeba #3743124 @Guybrush88 / #3743116 @zwhzwh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3743124",
          "cefr_level": "A1",
          "word_slugs": [
            "andò-verb"
          ]
        },
        {
          "id": "5592368",
          "text": "Tom andò in camera sua.",
          "translation": "Том пошёл к себе в комнату.",
          "source": "Tatoeba #5592368 @dnnywld / #5591793 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5592368",
          "cefr_level": "A1",
          "word_slugs": [
            "andò-verb"
          ]
        },
        {
          "id": "5338973",
          "text": "Tom andò a caccia di anatre.",
          "translation": "Том ходил охотиться на уток.",
          "source": "Tatoeba #5338973 @Guybrush88 / #5339025 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5338973",
          "cefr_level": "A1",
          "word_slugs": [
            "andò-verb"
          ]
        },
        {
          "id": "5527167",
          "text": "Jim andò a pescare sul molo.",
          "translation": "Джим пошёл ловить рыбу на молу.",
          "source": "Tatoeba #5527167 @dnnywld / #374664 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527167",
          "cefr_level": "A1",
          "word_slugs": [
            "andò-verb"
          ]
        },
        {
          "id": "2188891",
          "text": "Lui andò a Boston in macchina.",
          "translation": "Он ездил в Бостон на машине.",
          "source": "Tatoeba #2188891 @Guybrush88 / #3270944 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2188891",
          "cefr_level": "A1",
          "word_slugs": [
            "andò-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "andò",
        "plural": "",
        "infinitive": "andò"
      }
