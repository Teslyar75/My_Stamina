      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6488910",
          "text": "Preferiresti del tè?",
          "translation": "Ты бы предпочёл чай?",
          "source": "Tatoeba #6488910 @dnnywld / #6488665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6488910",
          "cefr_level": "A1",
          "word_slugs": [
            "preferiresti-verb"
          ]
        },
        {
          "id": "5966005",
          "text": "Preferiresti essere sano o ricco?",
          "translation": "Ты бы больше хотел быть здоровым или богатым?",
          "source": "Tatoeba #5966005 @dnnywld / #5965542 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5966005",
          "cefr_level": "A1",
          "word_slugs": [
            "preferiresti-verb"
          ]
        },
        {
          "id": "6919158",
          "text": "Preferiresti vivere in una grande città o in una piccola cittadina?",
          "translation": "Ты бы предпочёл жить в большом городе или в маленьком городке?",
          "source": "Tatoeba #6919158 @dnnywld / #6918361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919158",
          "cefr_level": "A1",
          "word_slugs": [
            "preferiresti-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
