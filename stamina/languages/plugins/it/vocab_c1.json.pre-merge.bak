    {
      "slug": "andiate-verb",
      "lemma": "andiate",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9829,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5644990",
          "text": "È quasi ora che andiate.",
          "translation": "Вам уже почти пора ехать.",
          "source": "Tatoeba #5644990 @dnnywld / #5644923 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5644990",
          "cefr_level": "A1",
          "word_slugs": [
            "andiate-verb"
          ]
        },
        {
          "id": "10755258",
          "text": "Bisogna che ve ne andiate.",
          "translation": "Вам нужно уехать.",
          "source": "Tatoeba #10755258 @dnnywld / #5606979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10755258",
          "cefr_level": "A1",
          "word_slugs": [
            "andiate-verb"
          ]
        },
        {
          "id": "6786079",
          "text": "È ora che andiate a casa.",
          "translation": "Вам пора быть дома.",
          "source": "Tatoeba #6786079 @dnnywld / #6785757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786079",
          "cefr_level": "A1",
          "word_slugs": [
            "andiate-verb"
          ]
        },
        {
          "id": "5840076",
          "text": "È meglio che ve ne andiate.",
          "translation": "Лучше уходите.",
          "source": "Tatoeba #5840076 @dnnywld / #3925725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5840076",
          "cefr_level": "A1",
          "word_slugs": [
            "andiate-verb"
          ]
        },
        {
          "id": "5625450",
          "text": "È ora che andiate a dormire.",
          "translation": "Вам пора спать.",
          "source": "Tatoeba #5625450 @dnnywld / #5625390 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5625450",
          "cefr_level": "A1",
          "word_slugs": [
            "andiate-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "andiate",
        "plural": "",
        "infinitive": "andiate"
