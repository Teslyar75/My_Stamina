          ]
        },
        {
          "id": "5489694",
          "text": "Tom si è meritato tutto questo.",
          "translation": "Том всё это заслуживает.",
          "source": "Tatoeba #5489694 @dnnywld / #5489495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489694",
