    {
      "slug": "svegliarmi-verb",
      "lemma": "svegliarmi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9020,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6312579",
          "text": "Avreste dovuto svegliarmi.",
          "translation": "Вам надо было меня разбудить.",
          "source": "Tatoeba #6312579 @dnnywld / #6312113 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6312579",
          "cefr_level": "A1",
          "word_slugs": [
            "svegliarmi-verb"
          ]
        },
        {
          "id": "5652239",
          "text": "Faccio fatica a svegliarmi.",
          "translation": "Я просыпаюсь с трудом.",
          "source": "Tatoeba #5652239 @dnnywld / #5651570 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652239",
          "cefr_level": "A1",
          "word_slugs": [
            "svegliarmi-verb"
          ]
        },
        {
          "id": "6939395",
          "text": "Sto cercando di svegliarmi.",
          "translation": "Я пытаюсь проснуться.",
          "source": "Tatoeba #6939395 @dnnywld / #6938282 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6939395",
          "cefr_level": "A1",
          "word_slugs": [
            "svegliarmi-verb"
          ]
        },
        {
          "id": "5629665",
          "text": "È stato Tom a svegliarmi.",
          "translation": "Это Том меня разбудил.",
          "source": "Tatoeba #5629665 @dnnywld / #5629064 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629665",
          "cefr_level": "A1",
          "word_slugs": [
            "svegliarmi-verb"
          ]
        },
        {
          "id": "5419328",
          "text": "Faccio la regola di svegliarmi presto.",
          "translation": "Я возьму за правило просыпаться рано.",
          "source": "Tatoeba #5419328 @dnnywld / #645239 @nami (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419328",
          "cefr_level": "A1",
          "word_slugs": [
            "svegliarmi-verb"
          ]
        }
      ],
