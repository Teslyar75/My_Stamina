    {
      "slug": "quaranta-adj",
      "lemma": "quaranta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7809,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "сорок"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6845396",
          "text": "Lei non ne ha meno di quaranta.",
          "translation": "Ей не меньше сорока.",
          "source": "Tatoeba #6845396 @dnnywld / #6844740 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845396",
          "cefr_level": "A1",
          "word_slugs": [
            "quaranta-adj"
          ]
        },
        {
          "id": "6845397",
          "text": "Lui non ne ha meno di quaranta.",
          "translation": "Ему не меньше сорока.",
          "source": "Tatoeba #6845397 @dnnywld / #6844738 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845397",
          "cefr_level": "A1",
          "word_slugs": [
            "quaranta-adj"
          ]
        },
        {
          "id": "13631280",
          "text": "Il valore del pacco è di quaranta rubli.",
          "translation": "Ценность посылки — сорок рублей.",
          "source": "Tatoeba #13631280 @dnnywld / #13626660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13631280",
          "cefr_level": "A1",
          "word_slugs": [
            "quaranta-adj"
          ]
        },
        {
          "id": "10754302",
          "text": "Nella classe del signor Kato ci sono quaranta ragazzi.",
          "translation": "В классе господина Като сорок ребят.",
          "source": "Tatoeba #10754302 @dnnywld / #659821 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754302",
          "cefr_level": "A1",
          "word_slugs": [
            "quaranta-adj"
          ]
        },
        {
          "id": "5560134",
          "text": "Un uomo a quaranta o cinquanta anni è ancora un ragazzo.",
          "translation": "Мужчина и в сорок и в пятьдесят лет все ещё мальчик.",
          "source": "Tatoeba #5560134 @dnnywld / #370890 @reiji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5560134",
          "cefr_level": "A1",
          "word_slugs": [
            "quaranta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "quaranta",
        "plural": "",
        "infinitive": ""
      }
