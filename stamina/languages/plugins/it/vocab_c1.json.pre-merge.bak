        {
          "id": "5971335",
          "text": "Pulite la finestra.",
          "translation": "Помойте окно.",
          "source": "Tatoeba #5971335 @dnnywld / #5969835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971335",
