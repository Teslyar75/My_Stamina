          "cefr_level": "A1",
          "word_slugs": [
            "nazioni-noun"
          ]
        },
        {
          "id": "10843920",
          "text": "Lo statuto delle Nazioni Unite fu sottoscritto nel 1945.",
          "translation": "Устав ООН был подписан в 1945 году.",
          "source": "Tatoeba #10843920 @dnnywld / #10171797 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10843920",
          "cefr_level": "A1",
          "word_slugs": [
            "nazioni-noun"
          ]
        },
        {
          "id": "5589451",
          "text": "L'Ungheria è un membro delle Nazioni Unite dal 1955.",
          "translation": "Венгрия является членом ООН с 1955 года.",
          "source": "Tatoeba #5589451 @dnnywld / #1561581 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589451",
          "cefr_level": "A1",
          "word_slugs": [
            "nazioni-noun"
          ]
        }
