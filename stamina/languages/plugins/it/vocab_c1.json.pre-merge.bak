    {
      "slug": "aiutano-verb",
      "lemma": "aiutano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8290,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10917135",
          "text": "I volontari aiutano i professionisti.",
          "translation": "Профессионалам помогают добровольцы.",
          "source": "Tatoeba #10917135 @dnnywld / #6571984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10917135",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutano-verb"
          ]
        },
        {
          "id": "6367181",
          "text": "I cani guida aiutano i ciechi.",
          "translation": "Собаки-поводыри помогают незрячим людям.",
          "source": "Tatoeba #6367181 @dnnywld / #6367178 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367181",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutano-verb"
          ]
        },
        {
          "id": "3254379",
          "text": "Tom e Maria spesso si aiutano a vicenda.",
          "translation": "Том и Мария часто помогают друг другу.",
          "source": "Tatoeba #3254379 @al_ex_an_der / #3254365 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3254379",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutano-verb"
          ]
        },
        {
          "id": "2055951",
          "text": "Il tè e il caffè aiutano a iniziare la giornata.",
          "translation": "Чай и кофе помогают начать день.",
          "source": "Tatoeba #2055951 @Sirio60 / #498706 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2055951",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutano-verb"
          ]
        },
        {
          "id": "3307963",
          "text": "Il the e il caffè aiutano a iniziare la giornata.",
          "translation": "Чай и кофе помогают начать день.",
          "source": "Tatoeba #3307963 @Sirio60 / #498706 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3307963",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "aiutano",
        "plural": "",
        "infinitive": "aiutano"
      }
