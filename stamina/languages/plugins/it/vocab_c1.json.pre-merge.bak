          "cefr_level": "A1",
          "word_slugs": [
            "provate-adj"
          ]
        },
        {
          "id": "12464924",
          "text": "Provate a restare uniti.",
          "translation": "Старайтесь держаться вместе.",
          "source": "Tatoeba #12464924 @dnnywld / #12464549 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12464924",
          "cefr_level": "A1",
          "word_slugs": [
            "provate-adj"
          ]
        },
        {
          "id": "6326288",
          "text": "Provate una volta ancora.",
          "translation": "Попробуете ещё раз.",
          "source": "Tatoeba #6326288 @dnnywld / #6325706 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326288",
          "cefr_level": "A1",
          "word_slugs": [
