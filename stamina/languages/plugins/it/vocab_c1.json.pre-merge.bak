    {
      "slug": "scacchi-noun",
      "lemma": "scacchi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6305,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5507537",
          "text": "Giochiamo a scacchi?",
          "translation": "Сыграем в шахматы?",
          "source": "Tatoeba #5507537 @dnnywld / #5507031 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507537",
          "cefr_level": "A1",
          "word_slugs": [
            "scacchi-noun"
          ]
        },
        {
          "id": "631599",
          "text": "Sai giocare a scacchi?",
          "translation": "Ты умеешь играть в шахматы?",
          "source": "Tatoeba #631599 @Guybrush88 / #4938848 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/631599",
          "cefr_level": "A1",
          "word_slugs": [
            "scacchi-noun"
          ]
        },
        {
          "id": "5586972",
          "text": "Tom è forte a scacchi.",
          "translation": "Том силён в шахматах.",
          "source": "Tatoeba #5586972 @dnnywld / #5586847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586972",
          "cefr_level": "A1",
          "word_slugs": [
            "scacchi-noun"
          ]
        },
        {
          "id": "5642433",
          "text": "Tom e Mary giocano a scacchi.",
          "translation": "Том и Мэри играют в шахматы.",
          "source": "Tatoeba #5642433 @dnnywld / #5641881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642433",
          "cefr_level": "A1",
          "word_slugs": [
            "scacchi-noun"
          ]
        },
        {
          "id": "395468",
          "text": "Ti insegnerò a giocare a scacchi.",
          "translation": "Я научу тебя играть в шахматы.",
          "source": "Tatoeba #395468 @Pharamp / #1577868 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/395468",
          "cefr_level": "A1",
          "word_slugs": [
            "scacchi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il scacchi",
