    {
      "slug": "marzo-noun",
      "lemma": "marzo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5970,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3471398",
          "text": "Sono nata il 22 marzo 1962.",
          "translation": "Я родилась 22 марта 1962 года.",
          "source": "Tatoeba #3471398 @Guybrush88 / #6894577 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3471398",
          "cefr_level": "A1",
          "word_slugs": [
            "marzo-noun"
          ]
        },
        {
          "id": "4272743",
          "text": "Sono nato il 18 marzo 1994.",
          "translation": "Я родился 18 марта 1994 года.",
          "source": "Tatoeba #4272743 @BEASY8 / #4284382 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4272743",
          "cefr_level": "A1",
          "word_slugs": [
            "marzo-noun"
          ]
        },
        {
          "id": "5571637",
          "text": "Ci sposeremo alla fine di marzo.",
          "translation": "Мы поженимся в конце марта.",
          "source": "Tatoeba #5571637 @dnnywld / #2569957 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571637",
          "cefr_level": "A1",
          "word_slugs": [
            "marzo-noun"
          ]
        },
        {
          "id": "5571641",
          "text": "Alla fine di marzo ci sposeremo.",
          "translation": "В конце марта мы поженимся.",
          "source": "Tatoeba #5571641 @dnnywld / #2916973 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571641",
          "cefr_level": "A1",
          "word_slugs": [
            "marzo-noun"
          ]
        },
        {
          "id": "6853140",
          "text": "Il suo compleanno non è né questo marzo né questo aprile.",
          "translation": "День рождения у него не то в марте, не то в апреле.",
          "source": "Tatoeba #6853140 @dnnywld / #6850306 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853140",
          "cefr_level": "A1",
          "word_slugs": [
            "marzo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il marzo",
        "plural": "",
        "infinitive": ""
      }
