    {
      "slug": "aiuterai-verb",
      "lemma": "aiuterai",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6718,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5517897",
          "text": "Tu aiuterai, vero?",
          "translation": "Ты ведь поможешь?",
          "source": "Tatoeba #5517897 @dnnywld / #3626195 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5517897",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterai-verb"
          ]
        },
        {
          "id": "7677230",
          "text": "Come aiuterai Tom?",
          "translation": "Как ты будешь помогать Тому?",
          "source": "Tatoeba #7677230 @dnnywld / #7676861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7677230",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterai-verb"
          ]
        },
        {
          "id": "2899868",
          "text": "Ci aiuterai o no?",
          "translation": "Ты будешь нам помогать или нет?",
          "source": "Tatoeba #2899868 @Guybrush88 / #6635548 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2899868",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterai-verb"
          ]
        },
        {
          "id": "3635558",
          "text": "Spero che mi aiuterai.",
          "translation": "Я надеюсь, ты мне поможешь.",
          "source": "Tatoeba #3635558 @Guybrush88 / #2027953 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3635558",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterai-verb"
          ]
        },
        {
          "id": "2960285",
          "text": "Tu ci aiuterai domattina?",
          "translation": "Ты поможешь нам завтра утром?",
          "source": "Tatoeba #2960285 @Guybrush88 / #3142107 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2960285",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterai-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "aiuterai",
        "plural": "",
        "infinitive": "aiuterai"
      }
