    {
      "slug": "principali-adj",
      "lemma": "principali",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6362,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10875618",
          "text": "Lo stemma è uno dei principali simboli dello Stato.",
          "translation": "Герб – один из главных символов государства.",
          "source": "Tatoeba #10875618 @dnnywld / #2844356 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10875618",
          "cefr_level": "A1",
          "word_slugs": [
            "principali-adj"
          ]
        },
        {
          "id": "350344",
          "text": "L'industria automobilistica è una delle industrie principali in Giappone.",
          "translation": "Автомобильная промышленность - одна из основных в Японии.",
          "source": "Tatoeba #350344 @martin / #469959 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350344",
          "cefr_level": "A1",
          "word_slugs": [
            "principali-adj"
          ]
        },
        {
          "id": "6790806",
          "text": "I grandi cancelli erano una volta gli ingressi principali della città.",
          "translation": "Большие ворота когда-то были главным входом в город.",
          "source": "Tatoeba #6790806 @dnnywld / #6566937 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790806",
          "cefr_level": "A1",
          "word_slugs": [
            "principali-adj"
          ]
        },
        {
          "id": "5672638",
          "text": "Il tuorlo d'uovo è una delle principali fonti della vitamina A.",
          "translation": "Яичный желток — один из основных источников витамина А.",
          "source": "Tatoeba #5672638 @dnnywld / #5672527 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672638",
          "cefr_level": "A1",
          "word_slugs": [
            "principali-adj"
          ]
        },
        {
          "id": "3364216",
          "text": "L'omosessualità è una delle principali cause di suicidio tra gli adolescenti.",
          "translation": "Гомосексуальность — одна из основных причин самоубийств среди подростков.",
          "source": "Tatoeba #3364216 @Guybrush88 / #4945284 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3364216",
          "cefr_level": "A1",
          "word_slugs": [
            "principali-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il principali",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "terrò-verb",
      "lemma": "terrò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6363,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6919167",
          "text": "Ne terrò conto.",
          "translation": "Я буду им дорожить.",
          "source": "Tatoeba #6919167 @dnnywld / #6918348 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919167",
          "cefr_level": "A1",
          "word_slugs": [
            "terrò-verb"
          ]
        },
        {
          "id": "5388459",
          "text": "Stasera terrò una conferenza.",
          "translation": "Сегодня вечером я дам конференцию.",
          "source": "Tatoeba #5388459 @dnnywld / #5388455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388459",
          "cefr_level": "A1",
          "word_slugs": [
            "terrò-verb"
          ]
        },
        {
          "id": "6764660",
          "text": "Verrò e ti terrò compagnia.",
          "translation": "Я приду и составлю тебе компанию.",
          "source": "Tatoeba #6764660 @dnnywld / #6764591 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6764660",
          "cefr_level": "A1",
          "word_slugs": [
            "terrò-verb"
          ]
        },
        {
          "id": "6853125",
          "text": "Mi fermerò e li terrò d'occhio.",
          "translation": "Я останусь и присмотрю за ними.",
          "source": "Tatoeba #6853125 @dnnywld / #6850335 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853125",
          "cefr_level": "A1",
          "word_slugs": [
            "terrò-verb"
          ]
        },
        {
          "id": "6853126",
          "text": "Mi fermerò e lo terrò d'occhio.",
          "translation": "Я останусь и присмотрю за ним.",
          "source": "Tatoeba #6853126 @dnnywld / #6850336 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853126",
          "cefr_level": "A1",
          "word_slugs": [
            "terrò-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
