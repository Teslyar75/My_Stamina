      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7224431",
          "text": "Non è molto educato.",
          "translation": "Это не очень-то вежливо.",
          "source": "Tatoeba #7224431 @dnnywld / #7221980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7224431",
          "cefr_level": "A1",
          "word_slugs": [
            "educato-adj"
          ]
        },
        {
          "id": "5863283",
          "text": "Tu sei troppo educato.",
          "translation": "Ты чересчур воспитанный.",
          "source": "Tatoeba #5863283 @Guybrush88 / #6962868 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5863283",
          "cefr_level": "A1",
          "word_slugs": [
            "educato-adj"
          ]
        },
        {
          "id": "375672",
          "text": "Tony è un ragazzo educato.",
          "translation": "Тони - воспитанный мальчик.",
          "source": "Tatoeba #375672 @Pharamp / #573996 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/375672",
          "cefr_level": "A1",
          "word_slugs": [
            "educato-adj"
          ]
        },
        {
          "id": "5396255",
          "text": "Penso che Tom sia educato.",
          "translation": "Я думаю, что Том вежлив.",
          "source": "Tatoeba #5396255 @Guybrush88 / #5562877 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5396255",
          "cefr_level": "A1",
          "word_slugs": [
            "educato-adj"
          ]
        },
        {
          "id": "5563877",
          "text": "Tom è un giovanotto educato.",
          "translation": "Том - благовоспитанный молодой человек.",
          "source": "Tatoeba #5563877 @dnnywld / #5563841 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5563877",
