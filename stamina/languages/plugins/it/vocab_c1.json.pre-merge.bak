    {
      "slug": "nuovamente-adv",
      "lemma": "nuovamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5924,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5429642",
          "text": "Sono contento di vedervi nuovamente.",
          "translation": "Рад вновь увидеть вас.",
          "source": "Tatoeba #5429642 @dnnywld / #1109116 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5429642",
          "cefr_level": "A1",
          "word_slugs": [
            "nuovamente-adv"
          ]
        },
        {
          "id": "5404551",
          "text": "Tom è salito nuovamente in macchina.",
          "translation": "Том снова сел в машину.",
          "source": "Tatoeba #5404551 @dnnywld / #5404512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5404551",
          "cefr_level": "A1",
          "word_slugs": [
            "nuovamente-adv"
          ]
        },
        {
          "id": "12783475",
          "text": "Tom dice che decisamente non lo farà nuovamente.",
          "translation": "Том говорит, что определённо не будет делать это снова.",
          "source": "Tatoeba #12783475 @dnnywld / #12783162 @LanguagesLover (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12783475",
          "cefr_level": "A1",
          "word_slugs": [
            "nuovamente-adv"
          ]
        },
        {
          "id": "10911215",
          "text": "Penso che Tom sta nuovamente preparando qualche porcheria.",
          "translation": "Я думаю, Том снова готовит какую-нибудь пакость.",
          "source": "Tatoeba #10911215 @dnnywld / #10910876 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10911215",
          "cefr_level": "A1",
          "word_slugs": [
            "nuovamente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "nuovamente",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "bassi-adj",
      "lemma": "bassi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5925,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6950576",
          "text": "Sua nipote vive nei Paesi Bassi.",
          "translation": "Её внук живёт в Нидерландах.",
          "source": "Tatoeba #6950576 @dnnywld / #6021898 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950576",
          "cefr_level": "A1",
          "word_slugs": [
            "bassi-adj"
          ]
        },
        {
          "id": "1083356",
          "text": "In febbraio i prezzi sono più bassi.",
          "translation": "В феврале самые низкие цены.",
          "source": "Tatoeba #1083356 @Guybrush88 / #4537014 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1083356",
          "cefr_level": "A1",
          "word_slugs": [
            "bassi-adj"
          ]
        },
        {
          "id": "10865321",
          "text": "In che lingue parlano nei Paesi Bassi?",
          "translation": "На каких языках говорят в Нидерландах?",
          "source": "Tatoeba #10865321 @dnnywld / #10864890 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10865321",
          "cefr_level": "A1",
          "word_slugs": [
            "bassi-adj"
          ]
        },
        {
          "id": "2193133",
          "text": "La capitale dei Paesi Bassi è Amsterdam.",
          "translation": "Столица Нидерландов - Амстердам.",
          "source": "Tatoeba #2193133 @graphite / #2496172 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2193133",
          "cefr_level": "A1",
          "word_slugs": [
            "bassi-adj"
          ]
        },
        {
          "id": "5812577",
          "text": "I Paesi Bassi e la Spagna sono regni.",
          "translation": "Нидерланды и Испания — королевства.",
          "source": "Tatoeba #5812577 @dnnywld / #5812535 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5812577",
          "cefr_level": "A1",
          "word_slugs": [
            "bassi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il bassi",
        "plural": "",
        "infinitive": ""
      }
    },
