      "frequency_rank": 6351,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5537077",
          "text": "Sognare fa bene.",
          "translation": "Мечтать хорошо.",
          "source": "Tatoeba #5537077 @dnnywld / #5536897 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5537077",
          "cefr_level": "A1",
          "word_slugs": [
            "sognare-verb"
          ]
        },
        {
          "id": "5705999",
          "text": "Mi piace sognare.",
          "translation": "Я люблю помечтать.",
          "source": "Tatoeba #5705999 @dnnywld / #5705667 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5705999",
          "cefr_level": "A1",
          "word_slugs": [
            "sognare-verb"
          ]
        },
        {
          "id": "5827147",
          "text": "Continua a sognare!",
          "translation": "Продолжай мечтать!",
          "source": "Tatoeba #5827147 @dnnywld / #4837977 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5827147",
          "cefr_level": "A1",
          "word_slugs": [
            "sognare-verb"
          ]
        },
        {
          "id": "4569694",
          "text": "Smettila di sognare.",
          "translation": "Хватит мечтать.",
          "source": "Tatoeba #4569694 @Guybrush88 / #6473869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4569694",
          "cefr_level": "A1",
          "word_slugs": [
            "sognare-verb"
          ]
        },
        {
          "id": "5553124",
          "text": "Ho molto di cui sognare.",
          "translation": "Я много о чём мечтаю.",
          "source": "Tatoeba #5553124 @dnnywld / #5553115 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5553124",
          "cefr_level": "A1",
          "word_slugs": [
            "sognare-verb"
          ]
        }
      ],
      "tags": [
