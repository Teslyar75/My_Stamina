    {
      "slug": "tolgo-verb",
      "lemma": "tolgo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6596,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5846778",
          "text": "Mi tolgo il cappello!",
          "translation": "Снимаю шляпу!",
          "source": "Tatoeba #5846778 @dnnywld / #2047904 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846778",
          "cefr_level": "A1",
          "word_slugs": [
            "tolgo-verb"
          ]
        },
        {
          "id": "5846789",
          "text": "Mi tolgo il cappello.",
          "translation": "Я снимаю шляпу.",
          "source": "Tatoeba #5846789 @dnnywld / #2751209 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846789",
          "cefr_level": "A1",
          "word_slugs": [
            "tolgo-verb"
          ]
        },
        {
          "id": "5433557",
          "text": "Mi tolgo il cappello davanti a te.",
          "translation": "Снимаю перед тобой шляпу.",
          "source": "Tatoeba #5433557 @dnnywld / #5431480 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433557",
          "cefr_level": "A1",
          "word_slugs": [
            "tolgo-verb"
          ]
        },
        {
          "id": "5433558",
          "text": "Mi tolgo il cappello al tuo cospetto.",
          "translation": "Снимаю перед тобой шляпу.",
          "source": "Tatoeba #5433558 @dnnywld / #5431480 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433558",
          "cefr_level": "A1",
          "word_slugs": [
            "tolgo-verb"
          ]
        },
        {
          "id": "5846818",
          "text": "Mi tolgo il cappello di fronte a te!",
          "translation": "Снимаю перед тобой шляпу!",
          "source": "Tatoeba #5846818 @dnnywld / #1829265 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846818",
          "cefr_level": "A1",
          "word_slugs": [
            "tolgo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
