    {
      "slug": "amanti-noun",
      "lemma": "amanti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5536,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5835647",
          "text": "Sono diventati amanti.",
          "translation": "Они стали любовниками.",
          "source": "Tatoeba #5835647 @dnnywld / #2568563 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5835647",
          "cefr_level": "A1",
          "word_slugs": [
            "amanti-noun"
          ]
        },
        {
          "id": "3399486",
          "text": "Non sono compagni di stanza. Sono amanti.",
          "translation": "Они не соседи по комнате, они любовники.",
          "source": "Tatoeba #3399486 @Guybrush88 / #3540249 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3399486",
          "cefr_level": "A1",
          "word_slugs": [
            "amanti-noun"
          ]
        },
        {
          "id": "3399487",
          "text": "Loro non sono compagni di stanza. Sono amanti.",
          "translation": "Они не соседи по комнате, они любовники.",
          "source": "Tatoeba #3399487 @Guybrush88 / #3540249 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3399487",
          "cefr_level": "A1",
          "word_slugs": [
            "amanti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
