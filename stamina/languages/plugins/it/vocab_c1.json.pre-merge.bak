    {
      "slug": "commedia-noun",
      "lemma": "commedia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6302,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6777963",
          "text": "Smettila di recitare la commedia.",
          "translation": "Хватит ломать комедию.",
          "source": "Tatoeba #6777963 @dnnywld / #6777819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6777963",
          "cefr_level": "A1",
          "word_slugs": [
            "commedia-noun"
          ]
        },
        {
          "id": "6934072",
          "text": "La sua commedia è stata un successo.",
          "translation": "Его пьеса была успехом.",
          "source": "Tatoeba #6934072 @dnnywld / #1601549 @mutternoise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6934072",
          "cefr_level": "A1",
          "word_slugs": [
            "commedia-noun"
          ]
        },
        {
          "id": "6023459",
          "text": "Ho letto il libro \"La Divina Commedia\".",
          "translation": "Я прочитал книгу \"Божественная комедия\".",
          "source": "Tatoeba #6023459 @dnnywld / #6023136 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6023459",
          "cefr_level": "A1",
          "word_slugs": [
            "commedia-noun"
          ]
        },
        {
          "id": "6893471",
          "text": "È stato difficile per voi capire la trama di questa commedia?",
          "translation": "Вам было трудно понять сюжет этой пьесы?",
          "source": "Tatoeba #6893471 @dnnywld / #2890129 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893471",
          "cefr_level": "A1",
          "word_slugs": [
            "commedia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la commedia",
        "plural": "",
        "infinitive": ""
      }
