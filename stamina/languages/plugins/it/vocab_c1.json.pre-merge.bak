    {
      "slug": "lavato-adj",
      "lemma": "lavato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8472,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6312549",
          "text": "Ti sei lavato.",
          "translation": "Ты помылся.",
          "source": "Tatoeba #6312549 @dnnywld / #6312134 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6312549",
          "cefr_level": "A1",
          "word_slugs": [
            "lavato-adj"
          ]
        },
        {
          "id": "5810274",
          "text": "Non l'ho lavato.",
          "translation": "Я его не помыл.",
          "source": "Tatoeba #5810274 @dnnywld / #4479779 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5810274",
          "cefr_level": "A1",
          "word_slugs": [
            "lavato-adj"
          ]
        },
        {
          "id": "6853011",
          "text": "Hai lavato le mani?",
          "translation": "Ты руки мыл?",
          "source": "Tatoeba #6853011 @dnnywld / #6852251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853011",
          "cefr_level": "A1",
          "word_slugs": [
            "lavato-adj"
          ]
        },
        {
          "id": "6853012",
          "text": "Avete lavato le mani?",
          "translation": "Вы руки мыли?",
          "source": "Tatoeba #6853012 @dnnywld / #6852252 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853012",
          "cefr_level": "A1",
          "word_slugs": [
            "lavato-adj"
          ]
        },
        {
          "id": "5431782",
          "text": "Avete già lavato le mani?",
          "translation": "Вы уже вымыли руки?",
          "source": "Tatoeba #5431782 @dnnywld / #5431533 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5431782",
