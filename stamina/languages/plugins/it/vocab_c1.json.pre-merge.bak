    {
      "slug": "accadrà-verb",
      "lemma": "accadrà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5090,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5913027",
          "text": "Accadrà di nuovo?",
          "translation": "Это снова произойдёт?",
          "source": "Tatoeba #5913027 @dnnywld / #5911360 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913027",
          "cefr_level": "A1",
          "word_slugs": [
            "accadrà-verb"
          ]
        },
        {
          "id": "6714295",
          "text": "Sono curioso di cosa accadrà.",
          "translation": "Мне интересно, что произойдёт.",
          "source": "Tatoeba #6714295 @dnnywld / #6712708 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6714295",
          "cefr_level": "A1",
          "word_slugs": [
            "accadrà-verb"
          ]
        },
        {
          "id": "6917305",
          "text": "Tom vuole sapere cosa accadrà.",
          "translation": "Том хочет знать, что будет.",
          "source": "Tatoeba #6917305 @dnnywld / #6916825 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917305",
          "cefr_level": "A1",
          "word_slugs": [
            "accadrà-verb"
          ]
        },
        {
          "id": "6858802",
          "text": "Non posso garantire che accadrà.",
          "translation": "Я не могу гарантировать, что это произойдёт.",
          "source": "Tatoeba #6858802 @dnnywld / #6858736 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6858802",
          "cefr_level": "A1",
          "word_slugs": [
            "accadrà-verb"
          ]
        },
        {
          "id": "5684154",
          "text": "Non possiamo prevedere cosa accadrà.",
          "translation": "Мы не можем предсказать, что будет.",
          "source": "Tatoeba #5684154 @dnnywld / #5683824 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5684154",
          "cefr_level": "A1",
          "word_slugs": [
            "accadrà-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "accadrà",
