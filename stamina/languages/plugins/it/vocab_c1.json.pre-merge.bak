    {
      "slug": "spaghetti-noun",
      "lemma": "spaghetti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7114,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5683686",
          "text": "Per cena cucinerò spaghetti.",
          "translation": "На ужин я приготовлю спагетти.",
          "source": "Tatoeba #5683686 @dnnywld / #5679944 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683686",
          "cefr_level": "A1",
          "word_slugs": [
            "spaghetti-noun"
          ]
        },
        {
          "id": "5680946",
          "text": "Preparerò gli spaghetti per cena.",
          "translation": "На ужин я сделаю спагетти.",
          "source": "Tatoeba #5680946 @dnnywld / #5679943 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5680946",
          "cefr_level": "A1",
          "word_slugs": [
            "spaghetti-noun"
          ]
        },
        {
          "id": "5613833",
          "text": "Non potresti passare gli spaghetti?",
          "translation": "Ты не мог бы передать спагетти?",
          "source": "Tatoeba #5613833 @dnnywld / #4311196 @whatnot (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5613833",
          "cefr_level": "A1",
          "word_slugs": [
            "spaghetti-noun"
          ]
        },
        {
          "id": "719251",
          "text": "Gli italiani mangiano sempre spaghetti.",
          "translation": "Итальянцы всегда едят спагетти.",
          "source": "Tatoeba #719251 @Guybrush88 / #2652501 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/719251",
          "cefr_level": "A1",
          "word_slugs": [
            "spaghetti-noun"
          ]
        },
        {
          "id": "7015691",
          "text": "A Tom non piacciono gli spaghetti.",
          "translation": "Том не любит спагетти.",
          "source": "Tatoeba #7015691 @dnnywld / #7015111 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7015691",
          "cefr_level": "A1",
          "word_slugs": [
            "spaghetti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il spaghetti",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "annullato-adj",
      "lemma": "annullato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7115,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6845713",
          "text": "Tom ha annullato il viaggio.",
          "translation": "Том отменил поездку.",
          "source": "Tatoeba #6845713 @dnnywld / #6845619 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845713",
          "cefr_level": "A1",
          "word_slugs": [
            "annullato-adj"
          ]
        },
        {
          "id": "8998399",
          "text": "Hanno annullato la loro visita a Londra.",
          "translation": "Они отменили свой визит в Лондон.",
          "source": "Tatoeba #8998399 @Valdast / #7783007 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8998399",
          "cefr_level": "A1",
          "word_slugs": [
            "annullato-adj"
          ]
        },
        {
          "id": "999540",
          "text": "Il concerto rock fu annullato perché il cantante si ammalò.",
          "translation": "Рок-концерт отменили из-за болезни певца.",
          "source": "Tatoeba #999540 @riccioberto / #814291 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/999540",
          "cefr_level": "A1",
          "word_slugs": [
            "annullato-adj"
          ]
        },
        {
          "id": "657049",
          "text": "Il viaggio è stato annullato a causa di una terribile tempesta.",
          "translation": "Из-за ужасной бури путешествие отменили.",
          "source": "Tatoeba #657049 @Pharamp / #4388928 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/657049",
          "cefr_level": "A1",
          "word_slugs": [
            "annullato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il annullato",
        "plural": "",
        "infinitive": ""
      }
