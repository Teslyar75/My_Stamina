    {
      "slug": "immortale-adj",
      "lemma": "immortale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8387,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5985783",
          "text": "Tom è immortale.",
          "translation": "Том бессмертен.",
          "source": "Tatoeba #5985783 @Guybrush88 / #3281796 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5985783",
          "cefr_level": "A1",
          "word_slugs": [
            "immortale-adj"
          ]
        },
        {
          "id": "10852060",
          "text": "L'anima è immortale.",
          "translation": "Душа бессмертна.",
          "source": "Tatoeba #10852060 @dnnywld / #3459458 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10852060",
          "cefr_level": "A1",
          "word_slugs": [
            "immortale-adj"
          ]
        },
        {
          "id": "1409507",
          "text": "La marmotta è immortale.",
          "translation": "Сурок бессмертен.",
          "source": "Tatoeba #1409507 @Guybrush88 / #2314160 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1409507",
          "cefr_level": "A1",
          "word_slugs": [
            "immortale-adj"
          ]
        },
        {
          "id": "1869090",
          "text": "Il corpo è mortale, l'anima immortale.",
          "translation": "Тело смертно, душа бессмертна.",
