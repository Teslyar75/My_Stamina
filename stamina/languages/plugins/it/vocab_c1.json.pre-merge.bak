      "gender": "m",
      "examples": [
        {
          "id": "4411226",
          "text": "Il latte è acido.",
          "translation": "Молоко кислое.",
          "source": "Tatoeba #4411226 @Guybrush88 / #3141431 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4411226",
