      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6332114",
          "text": "In questo era un asso.",
          "translation": "В этом ему не было равных.",
          "source": "Tatoeba #6332114 @dnnywld / #6331874 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6332114",
          "cefr_level": "A1",
          "word_slugs": [
            "asso-noun"
          ]
        },
        {
          "id": "6904629",
          "text": "Ti ho mai piantato in asso?",
          "translation": "Я тебя когда-нибудь подводил?",
          "source": "Tatoeba #6904629 @dnnywld / #6560350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904629",
          "cefr_level": "A1",
