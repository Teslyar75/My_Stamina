      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6587209",
          "text": "La costruzione è instabile.",
          "translation": "Постройка ненадёжна.",
          "source": "Tatoeba #6587209 @dnnywld / #6584560 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6587209",
          "cefr_level": "A1",
          "word_slugs": [
            "costruzione-noun"
          ]
        },
        {
          "id": "5668947",
          "text": "La costruzione è stata bloccata.",
          "translation": "Строительство было заморожено.",
          "source": "Tatoeba #5668947 @dnnywld / #5668918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5668947",
          "cefr_level": "A1",
          "word_slugs": [
            "costruzione-noun"
          ]
        },
        {
          "id": "3703799",
          "text": "Questa costruzione richiede molta manodopera.",
          "translation": "Это строительство требует много рабочей силы.",
          "source": "Tatoeba #3703799 @Guybrush88 / #6550172 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3703799",
          "cefr_level": "A1",
          "word_slugs": [
            "costruzione-noun"
          ]
        },
        {
          "id": "5137534",
          "text": "Una nuova scuola è in costruzione.",
          "translation": "Строится новая школа.",
          "source": "Tatoeba #5137534 @Guybrush88 / #12980790 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5137534",
          "cefr_level": "A1",
          "word_slugs": [
            "costruzione-noun"
          ]
        },
        {
          "id": "6973565",
          "text": "La costruzione dell'ospedale terminerà presto.",
          "translation": "Строительство больницы скоро закончится.",
          "source": "Tatoeba #6973565 @dnnywld / #6972994 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6973565",
          "cefr_level": "A1",
          "word_slugs": [
            "costruzione-noun"
          ]
        }
      ],
