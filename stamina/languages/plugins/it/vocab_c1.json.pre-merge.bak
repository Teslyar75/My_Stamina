    {
      "slug": "vivendo-verb",
      "lemma": "vivendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5702,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6040701",
          "text": "A quel tempo stavo ancora vivendo a Boston.",
          "translation": "Я тогда ещё в Бостоне жил.",
          "source": "Tatoeba #6040701 @dnnywld / #6039806 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6040701",
          "cefr_level": "A1",
          "word_slugs": [
            "vivendo-verb"
          ]
        },
        {
          "id": "10993295",
          "text": "Vivendo qui ci siamo abituati a rispettare i costrumi locali.",
          "translation": "Живя здесь, мы привыкли чтить местные обычаи.",
          "source": "Tatoeba #10993295 @dnnywld / #10993175 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10993295",
          "cefr_level": "A1",
          "word_slugs": [
            "vivendo-verb"
          ]
        },
        {
          "id": "4985308",
          "text": "Il Brasile sta vivendo la più grande crisi morale della sua storia.",
          "translation": "Бразилия переживает самый серьёзный нравственный кризис в своей истории.",
          "source": "Tatoeba #4985308 @ianna / #4985528 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4985308",
          "cefr_level": "A1",
          "word_slugs": [
            "vivendo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "vivendo",
        "plural": "",
        "infinitive": "vivendo"
      }
    },
    {
      "slug": "chiarire-verb",
      "lemma": "chiarire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5703,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5403902",
          "text": "Dobbiamo chiarire alcuni dettagli.",
          "translation": "Нам нужно прояснить кое-какие детали.",
          "source": "Tatoeba #5403902 @dnnywld / #5403844 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5403902",
          "cefr_level": "A1",
          "word_slugs": [
            "chiarire-verb"
          ]
        },
        {
          "id": "5621047",
          "text": "Dobbiamo chiarire cosa sta succedendo qui.",
          "translation": "Нам надо выяснить, что тут происходит.",
          "source": "Tatoeba #5621047 @dnnywld / #5620982 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5621047",
          "cefr_level": "A1",
          "word_slugs": [
            "chiarire-verb"
          ]
        },
        {
          "id": "5753500",
          "text": "\"Vorrei chiarire alcuni dettagli\", - disse il giornalista.",
          "translation": "«Я хотел бы уточнить некоторые детали», — сказал журналист.",
          "source": "Tatoeba #5753500 @dnnywld / #5750101 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5753500",
          "cefr_level": "A1",
          "word_slugs": [
            "chiarire-verb"
          ]
        },
        {
          "id": "5624307",
          "text": "Dobbiamo chiarire perché loro vogliono che noi facciamo questo.",
          "translation": "Нам надо выяснить, почему они хотят, чтобы мы это сделали.",
          "source": "Tatoeba #5624307 @dnnywld / #5623478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624307",
          "cefr_level": "A1",
          "word_slugs": [
            "chiarire-verb"
          ]
        },
        {
          "id": "5774738",
          "text": "Potevamo parlare e chiarire tutto, ma lui non ha voluto.",
          "translation": "Мы могли поговорить и всё уладить, но он не захотел.",
          "source": "Tatoeba #5774738 @dnnywld / #5774341 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5774738",
          "cefr_level": "A1",
          "word_slugs": [
            "chiarire-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
