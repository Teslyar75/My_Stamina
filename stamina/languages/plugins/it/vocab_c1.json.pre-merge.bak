      },
      "gender": "m",
      "examples": [
        {
          "id": "10851646",
          "text": "Ho visto un tasso.",
          "translation": "Я видел барсука.",
          "source": "Tatoeba #10851646 @dnnywld / #10355759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851646",
          "cefr_level": "A1",
