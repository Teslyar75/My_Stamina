    {
      "slug": "apparentemente-adv",
      "lemma": "apparentemente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6752,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10861621",
          "text": "Apparentemente ha funzionato.",
          "translation": "Видимо, это сработало.",
          "source": "Tatoeba #10861621 @dnnywld / #3055571 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10861621",
          "cefr_level": "A1",
          "word_slugs": [
            "apparentemente-adv"
          ]
        },
        {
          "id": "12469699",
          "text": "Apparentemente non differiscono.",
          "translation": "Внешне они почти не отличаются.",
          "source": "Tatoeba #12469699 @dnnywld / #12469149 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12469699",
          "cefr_level": "A1",
          "word_slugs": [
            "apparentemente-adv"
          ]
        },
        {
          "id": "5506788",
          "text": "Tom, apparentemente, conosce Mary.",
          "translation": "Том, видимо, знаком с Мэри.",
          "source": "Tatoeba #5506788 @dnnywld / #5505768 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506788",
          "cefr_level": "A1",
          "word_slugs": [
            "apparentemente-adv"
          ]
        },
        {
          "id": "6729009",
          "text": "Apparentemente, io non devo farlo.",
          "translation": "Я, видимо, не должен этого делать.",
          "source": "Tatoeba #6729009 @dnnywld / #6728753 @max635866 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6729009",
          "cefr_level": "A1",
          "word_slugs": [
            "apparentemente-adv"
          ]
        },
        {
          "id": "5703103",
          "text": "Tom apparentemente è un camionista.",
          "translation": "Том, видимо, водитель грузовика.",
          "source": "Tatoeba #5703103 @dnnywld / #5702912 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5703103",
          "cefr_level": "A1",
          "word_slugs": [
            "apparentemente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
