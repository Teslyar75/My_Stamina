          ]
        },
        {
          "id": "6062598",
          "text": "Siete a favore della legalizzazione dell'aborto, Mary?",
          "translation": "Вы выступаете за легализацию абортов, Мэри?",
          "source": "Tatoeba #6062598 @dnnywld / #6061514 @sergiomelo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6062598",
          "cefr_level": "A1",
          "word_slugs": [
            "aborto-noun"
          ]
        },
        {
          "id": "5478677",
          "text": "Mary ha avuto il suo primo aborto a quindici anni.",
          "translation": "Свой первый аборт Мэри сделала в пятнадцать лет.",
          "source": "Tatoeba #5478677 @dnnywld / #5478399 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5478677",
          "cefr_level": "A1",
          "word_slugs": [
            "aborto-noun"
          ]
        }
