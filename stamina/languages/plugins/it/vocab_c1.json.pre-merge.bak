      "examples": [
        {
          "id": "4286084",
          "text": "Roma ha molti edifici antichi.",
          "translation": "В Риме много старинных зданий.",
          "source": "Tatoeba #4286084 @bailujia / #4286297 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4286084",
          "cefr_level": "A1",
          "word_slugs": [
            "edifici-noun"
          ]
        },
        {
          "id": "7611656",
          "text": "Vai a costruire edifici in Francia.",
          "translation": "Ты собираешься строить здания во Франции.",
          "source": "Tatoeba #7611656 @Guybrush88 / #10624225 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7611656",
          "cefr_level": "A1",
          "word_slugs": [
            "edifici-noun"
          ]
        },
        {
          "id": "7611948",
          "text": "Vanno a costruire edifici in Uruguay.",
          "translation": "Они едут строить здания в Уругвае.",
          "source": "Tatoeba #7611948 @Guybrush88 / #10136495 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7611948",
          "cefr_level": "A1",
          "word_slugs": [
            "edifici-noun"
          ]
        },
        {
          "id": "3412380",
          "text": "È uno degli edifici più antichi di Boston.",
          "translation": "Это одно из старейших зданий в Бостоне.",
          "source": "Tatoeba #3412380 @Guybrush88 / #3344994 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3412380",
          "cefr_level": "A1",
          "word_slugs": [
            "edifici-noun"
          ]
        },
        {
          "id": "9000402",
          "text": "L'incendio è arrivato molto vicino agli edifici residenziali.",
          "translation": "Огонь вплотную подступил к жилым домам.",
