    {
      "slug": "metterei-verb",
      "lemma": "metterei",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9266,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6797659",
          "text": "Non mi metterei a farlo.",
          "translation": "Я бы не стал этого делать.",
          "source": "Tatoeba #6797659 @dnnywld / #3297907 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797659",
          "cefr_level": "A1",
          "word_slugs": [
            "metterei-verb"
          ]
        },
        {
          "id": "6797673",
          "text": "Non mi metterei a discuterne ora.",
          "translation": "Я бы не стал обсуждать это сейчас.",
          "source": "Tatoeba #6797673 @dnnywld / #2626985 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797673",
          "cefr_level": "A1",
          "word_slugs": [
            "metterei-verb"
          ]
        },
        {
          "id": "742779",
          "text": "Se fossi in te metterei i soldi in una banca.",
          "translation": "На твоём месте я бы положил деньги в банк.",
          "source": "Tatoeba #742779 @Guybrush88 / #3302865 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/742779",
          "cefr_level": "A1",
          "word_slugs": [
            "metterei-verb"
          ]
        },
        {
          "id": "11499951",
          "text": "Come puoi biasimarmi? Non metterei mai una mano su mio figlio.",
          "translation": "Как ты можешь меня в таком обвинять? Я бы никогда не поднял руку на сына.",
          "source": "Tatoeba #11499951 @Bernie75 / #3105671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11499951",
          "cefr_level": "A1",
          "word_slugs": [
            "metterei-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "metterei",
        "plural": "",
        "infinitive": "metterei"
      }
    },
    {
      "slug": "vetri-noun",
      "lemma": "vetri",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9267,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5409068",
          "text": "Non calpestare i vetri rotti.",
          "translation": "Не наступай на битое стекло.",
          "source": "Tatoeba #5409068 @dnnywld / #2497977 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409068",
          "cefr_level": "A1",
          "word_slugs": [
            "vetri-noun"
          ]
        },
        {
          "id": "7430879",
          "text": "La pioggia tamburellava sui vetri.",
          "translation": "По стёклам барабанил дождь.",
          "source": "Tatoeba #7430879 @dnnywld / #7430544 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7430879",
          "cefr_level": "A1",
          "word_slugs": [
            "vetri-noun"
          ]
        },
        {
          "id": "5409150",
          "text": "C'erano ovunque vetri rotti per terra.",
          "translation": "Повсюду на земле было битое стекло.",
          "source": "Tatoeba #5409150 @dnnywld / #5282213 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409150",
          "cefr_level": "A1",
          "word_slugs": [
            "vetri-noun"
          ]
        },
        {
          "id": "7745140",
          "text": "Tom si alzò e vide che i vetri delle finestre erano congelati.",
          "translation": "Том встал и увидел, что стёкла на окнах замёрзли.",
          "source": "Tatoeba #7745140 @dnnywld / #7745115 @Dogukhan48 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7745140",
          "cefr_level": "A1",
          "word_slugs": [
            "vetri-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il vetri",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "stupidaggine-noun",
      "lemma": "stupidaggine",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9268,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5389913",
          "text": "Non fare nessuna stupidaggine.",
          "translation": "Не делай никаких глупостей.",
          "source": "Tatoeba #5389913 @dnnywld / #5389907 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389913",
          "cefr_level": "A1",
          "word_slugs": [
            "stupidaggine-noun"
          ]
        },
        {
          "id": "6692867",
          "text": "Secondo me è una stupidaggine.",
          "translation": "По-моему, это глупо.",
          "source": "Tatoeba #6692867 @dnnywld / #6692824 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6692867",
          "cefr_level": "A1",
          "word_slugs": [
            "stupidaggine-noun"
          ]
        },
        {
          "id": "3764309",
          "text": "Il poliziotto ha detto una stupidaggine?",
          "translation": "Полицейский сказал глупость?",
          "source": "Tatoeba #3764309 @Guybrush88 / #5853907 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3764309",
          "cefr_level": "A1",
          "word_slugs": [
            "stupidaggine-noun"
          ]
        },
        {
          "id": "12376018",
          "text": "Non ci scalderemo per una stupidaggine simile.",
          "translation": "Не будем горячиться из-за такой ерунды.",
          "source": "Tatoeba #12376018 @dnnywld / #12374899 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12376018",
          "cefr_level": "A1",
          "word_slugs": [
            "stupidaggine-noun"
          ]
        },
        {
          "id": "5447489",
          "text": "Gli imbroglioni guadagnano con la stupidaggine delle persone.",
          "translation": "Мошенники зарабатывают на человеческой глупости.",
          "source": "Tatoeba #5447489 @dnnywld / #5446715 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5447489",
          "cefr_level": "A1",
          "word_slugs": [
            "stupidaggine-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la stupidaggine",
        "plural": "",
        "infinitive": ""
      }
    },
