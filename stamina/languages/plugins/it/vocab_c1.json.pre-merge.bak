    {
      "slug": "infinito-adj",
      "lemma": "infinito",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6406,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5606648",
          "text": "Lo spazio è infinito?",
          "translation": "Бесконечен ли космос?",
          "source": "Tatoeba #5606648 @dnnywld / #4806308 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5606648",
          "cefr_level": "A1",
          "word_slugs": [
            "infinito-adj"
          ]
        },
        {
          "id": "813998",
          "text": "L'universo è infinito.",
          "translation": "Вселенная бесконечна.",
          "source": "Tatoeba #813998 @shoras / #1223357 @poji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/813998",
          "cefr_level": "A1",
          "word_slugs": [
            "infinito-adj"
          ]
        },
        {
          "id": "12371052",
          "text": "Né gioia eterna né dolore infinito.",
          "translation": "Ни радости вечной, ни печали бесконечной.",
          "source": "Tatoeba #12371052 @Bernie75 / #2760081 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12371052",
          "cefr_level": "A1",
          "word_slugs": [
            "infinito-adj"
          ]
        },
        {
          "id": "4412",
          "text": "Non c'è dubbio che il tutto è infinito.",
          "translation": "Нет сомненья: вселенная бесконечна.",
          "source": "Tatoeba #4412 @Pharamp / #5629 @Dorenda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4412",
          "cefr_level": "A1",
          "word_slugs": [
            "infinito-adj"
          ]
        },
        {
          "id": "5486322",
          "text": "Sembrava che il cielo blu si estendesse all'infinito.",
          "translation": "Синее небо, казалось, простирается бесконечно.",
          "source": "Tatoeba #5486322 @dnnywld / #5485433 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5486322",
          "cefr_level": "A1",
          "word_slugs": [
            "infinito-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
