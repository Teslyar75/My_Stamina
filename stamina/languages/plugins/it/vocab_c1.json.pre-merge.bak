    {
      "slug": "comprendere-verb",
      "lemma": "comprendere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6042,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6939394",
          "text": "Si può comprendere?",
          "translation": "Это можно понять?",
          "source": "Tatoeba #6939394 @dnnywld / #6938283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6939394",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendere-verb"
          ]
        },
        {
          "id": "5443908",
          "text": "Comprendere vuol dire perdonare.",
          "translation": "Понять — значит простить.",
          "source": "Tatoeba #5443908 @dnnywld / #3087963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5443908",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendere-verb"
          ]
        },
        {
          "id": "5492323",
          "text": "Non riesco a comprendere Tom.",
          "translation": "Я никак не могу раскусить Тома.",
          "source": "Tatoeba #5492323 @dnnywld / #2649877 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5492323",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendere-verb"
          ]
        },
        {
          "id": "5624324",
          "text": "Stiamo cercando di comprendere cosa bisogna fare.",
          "translation": "Мы пытаемся сообразить, что нужно сделать.",
          "source": "Tatoeba #5624324 @dnnywld / #5623425 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624324",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendere-verb"
          ]
        },
        {
          "id": "6160872",
          "text": "Vorrei comprendere questo argomento in maniera più dettagliata.",
          "translation": "Мне хотелось бы изучить эту тему поподробнее.",
          "source": "Tatoeba #6160872 @dnnywld / #6160800 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6160872",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "comprendere",
        "plural": "",
        "infinitive": "comprendere"
      }
    },
    {
      "slug": "martedì-noun",
      "lemma": "martedì",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6043,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3256499",
          "text": "Oggi è martedì.",
          "translation": "Сегодня вторник.",
          "source": "Tatoeba #3256499 @Guybrush88 / #3313440 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3256499",
          "cefr_level": "A1",
          "word_slugs": [
            "martedì-noun"
          ]
        },
        {
          "id": "5500086",
          "text": "Domani è martedì.",
          "translation": "Завтра вторник.",
          "source": "Tatoeba #5500086 @dnnywld / #5500023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500086",
          "cefr_level": "A1",
          "word_slugs": [
            "martedì-noun"
          ]
        },
        {
          "id": "6315735",
          "text": "Ieri era martedì.",
          "translation": "Вчера был вторник.",
          "source": "Tatoeba #6315735 @Guybrush88 / #6305900 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6315735",
          "cefr_level": "A1",
          "word_slugs": [
            "martedì-noun"
          ]
        },
        {
          "id": "5500081",
          "text": "Dopodomani è martedì.",
          "translation": "Послезавтра вторник.",
          "source": "Tatoeba #5500081 @dnnywld / #5500028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500081",
          "cefr_level": "A1",
          "word_slugs": [
            "martedì-noun"
          ]
        },
        {
          "id": "3406943",
          "text": "Ed è solo martedì!",
          "translation": "Ещё только вторник!",
          "source": "Tatoeba #3406943 @Guybrush88 / #3789407 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3406943",
          "cefr_level": "A1",
          "word_slugs": [
            "martedì-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il martedì",
        "plural": "",
