    {
      "slug": "abituata-adj",
      "lemma": "abituata",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6154,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2709130",
          "text": "Ci sono abituata.",
          "translation": "Я к этому привыкла.",
          "source": "Tatoeba #2709130 @Guybrush88 / #660042 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2709130",
          "cefr_level": "A1",
          "word_slugs": [
            "abituata-adj"
          ]
        },
        {
          "id": "3673545",
          "text": "Lei è abituata a viaggiare.",
          "translation": "Она привыкла путешествовать.",
          "source": "Tatoeba #3673545 @Guybrush88 / #5549385 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3673545",
          "cefr_level": "A1",
          "word_slugs": [
            "abituata-adj"
          ]
        },
        {
          "id": "5889531",
          "text": "Sono già abituata al dolore.",
          "translation": "Я уже привыкла к боли.",
          "source": "Tatoeba #5889531 @dnnywld / #5208916 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889531",
          "cefr_level": "A1",
          "word_slugs": [
            "abituata-adj"
          ]
        },
        {
          "id": "5889501",
          "text": "Sono abituata a questa situazione.",
          "translation": "Я привыкла к этой ситуации.",
          "source": "Tatoeba #5889501 @dnnywld / #2562550 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889501",
          "cefr_level": "A1",
          "word_slugs": [
            "abituata-adj"
          ]
        },
        {
          "id": "1863862",
          "text": "Lei è abituata ad alzarsi presto.",
          "translation": "Она привыкла вставать рано.",
          "source": "Tatoeba #1863862 @hitori37 / #1525440 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1863862",
          "cefr_level": "A1",
          "word_slugs": [
            "abituata-adj"
          ]
        }
