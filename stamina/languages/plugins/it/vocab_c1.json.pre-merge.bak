      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6344,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5310359",
          "text": "È la mia professoressa.",
          "translation": "Это моя учительница.",
          "source": "Tatoeba #5310359 @Guybrush88 / #5310378 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5310359",
          "cefr_level": "A1",
          "word_slugs": [
            "professoressa-noun"
          ]
        },
        {
          "id": "2521143",
          "text": "Eleni è una professoressa.",
          "translation": "Элени - учительница.",
          "source": "Tatoeba #2521143 @Guybrush88 / #4402434 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2521143",
          "cefr_level": "A1",
          "word_slugs": [
            "professoressa-noun"
          ]
        },
        {
          "id": "5835609",
          "text": "Lei è diventata professoressa.",
          "translation": "Она стала учительницей.",
          "source": "Tatoeba #5835609 @dnnywld / #1629265 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5835609",
          "cefr_level": "A1",
          "word_slugs": [
            "professoressa-noun"
          ]
        },
        {
          "id": "3440638",
          "text": "La professoressa legge il libro.",
          "translation": "Учительница читает книгу.",
          "source": "Tatoeba #3440638 @Guybrush88 / #3440649 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3440638",
          "cefr_level": "A1",
          "word_slugs": [
            "professoressa-noun"
          ]
        },
        {
          "id": "3049874",
          "text": "La professoressa scrive sulla lavagna.",
          "translation": "Учительница пишет на доске.",
          "source": "Tatoeba #3049874 @Guybrush88 / #3049950 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3049874",
          "cefr_level": "A1",
          "word_slugs": [
            "professoressa-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
