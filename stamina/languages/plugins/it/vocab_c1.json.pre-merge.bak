    {
      "slug": "istruttore-noun",
      "lemma": "istruttore",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9920,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6160878",
          "text": "Tom è istruttore subacqueo.",
          "translation": "Том — инструктор по дайвингу.",
          "source": "Tatoeba #6160878 @dnnywld / #6160794 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6160878",
          "cefr_level": "A1",
          "word_slugs": [
            "istruttore-noun"
          ]
        },
        {
          "id": "6160880",
          "text": "Tom è istruttore di guida.",
          "translation": "Том — инструктор по вождению.",
          "source": "Tatoeba #6160880 @dnnywld / #6160793 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6160880",
          "cefr_level": "A1",
          "word_slugs": [
            "istruttore-noun"
          ]
        },
        {
          "id": "5482151",
          "text": "Tom è un istruttore di fitness.",
          "translation": "Том - фитнес-тренер.",
          "source": "Tatoeba #5482151 @dnnywld / #5481943 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5482151",
          "cefr_level": "A1",
          "word_slugs": [
            "istruttore-noun"
          ]
        },
        {
          "id": "6160877",
          "text": "Tom è un istruttore di paracadutismo.",
          "translation": "Том — инструктор парашютного спорта.",
          "source": "Tatoeba #6160877 @dnnywld / #6160795 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6160877",
          "cefr_level": "A1",
          "word_slugs": [
            "istruttore-noun"
          ]
        },
        {
          "id": "10849297",
          "text": "Se volete prolungare l'abbonamento avvicinatevi all'istruttore.",
          "translation": "Если Вы хотите продлить абонемент, подойдите к инструктору.",
          "source": "Tatoeba #10849297 @dnnywld / #6797702 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849297",
          "cefr_level": "A1",
          "word_slugs": [
            "istruttore-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
