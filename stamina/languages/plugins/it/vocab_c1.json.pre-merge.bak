    {
      "slug": "depresso-adj",
      "lemma": "depresso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7582,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3653670",
          "text": "Tom è depresso.",
          "translation": "Том подавлен.",
          "source": "Tatoeba #3653670 @Guybrush88 / #5681274 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3653670",
          "cefr_level": "A1",
