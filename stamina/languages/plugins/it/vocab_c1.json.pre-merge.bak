      "examples": [
        {
          "id": "6685747",
          "text": "Non voglio essere arrestata.",
          "translation": "Я не хочу быть арестованной.",
          "source": "Tatoeba #6685747 @Guybrush88 / #6685827 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6685747",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestata-verb"
          ]
        },
        {
          "id": "5571261",
          "text": "Sono stata arrestata per averlo aiutato nella fuga.",
          "translation": "Я была арестована за то, что помогла ему при побеге.",
          "source": "Tatoeba #5571261 @dnnywld / #5570393 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571261",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestata-verb"
          ]
        },
        {
          "id": "5620713",
          "text": "Per errore è stata arrestata una persona innocente.",
          "translation": "По ошибке был задержан невинный человек.",
          "source": "Tatoeba #5620713 @dnnywld / #2916683 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5620713",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestata-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "arrestata",
        "plural": "",
        "infinitive": "arrestata"
      }
