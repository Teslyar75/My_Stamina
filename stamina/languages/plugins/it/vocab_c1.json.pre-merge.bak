      "examples": [
        {
          "id": "5678593",
          "text": "Hai nostalgia di Boston?",
          "translation": "Скучаешь по Бостону?",
          "source": "Tatoeba #5678593 @dnnywld / #5678325 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5678593",
          "cefr_level": "A1",
