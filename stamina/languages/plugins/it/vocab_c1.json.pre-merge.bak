    {
      "slug": "rimase-verb",
      "lemma": "rimase",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8149,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5686067",
          "text": "Tom rimase sorpreso.",
          "translation": "Том удивился.",
          "source": "Tatoeba #5686067 @dnnywld / #2160889 @Leonid204 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686067",
          "cefr_level": "A1",
          "word_slugs": [
            "rimase-verb"
          ]
        },
        {
          "id": "5686069",
          "text": "Hasan rimase sorpreso.",
          "translation": "Хасан удивился.",
          "source": "Tatoeba #5686069 @dnnywld / #4131111 @allasobirova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686069",
          "cefr_level": "A1",
          "word_slugs": [
            "rimase-verb"
          ]
        },
        {
          "id": "5686117",
          "text": "Nessuno rimase sorpreso.",
          "translation": "Никто не удивился.",
          "source": "Tatoeba #5686117 @dnnywld / #4744780 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686117",
          "cefr_level": "A1",
          "word_slugs": [
            "rimase-verb"
          ]
        },
        {
          "id": "5553502",
          "text": "Tom rimase in piedi.",
          "translation": "Том остался стоять.",
          "source": "Tatoeba #5553502 @dnnywld / #5552973 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5553502",
          "cefr_level": "A1",
          "word_slugs": [
            "rimase-verb"
          ]
        },
        {
          "id": "5691106",
          "text": "Tom rimase a guardare.",
          "translation": "Том стоял и смотрел.",
          "source": "Tatoeba #5691106 @dnnywld / #5690910 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5691106",
          "cefr_level": "A1",
          "word_slugs": [
            "rimase-verb"
          ]
        }
      ],
      "tags": [
