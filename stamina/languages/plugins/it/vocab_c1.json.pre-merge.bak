    {
      "slug": "vendono-verb",
      "lemma": "vendono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7337,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1273324",
          "text": "Vendono pesce e carne.",
          "translation": "Они продают рыбу и мясо.",
          "source": "Tatoeba #1273324 @Guybrush88 / #667361 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1273324",
          "cefr_level": "A1",
          "word_slugs": [
            "vendono-verb"
          ]
        },
        {
          "id": "6138184",
          "text": "Vendono uova al supermercato.",
          "translation": "В супермаркете продают яйца.",
          "source": "Tatoeba #6138184 @dnnywld / #6137455 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6138184",
          "cefr_level": "A1",
          "word_slugs": [
            "vendono-verb"
          ]
        },
        {
          "id": "1273325",
          "text": "Loro vendono pesce e carne.",
          "translation": "Они продают рыбу и мясо.",
          "source": "Tatoeba #1273325 @Guybrush88 / #667361 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1273325",
          "cefr_level": "A1",
          "word_slugs": [
            "vendono-verb"
          ]
        },
        {
          "id": "5662170",
          "text": "Questi libri si vendono male.",
          "translation": "Эти книги плохо продаются.",
          "source": "Tatoeba #5662170 @dnnywld / #5661327 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662170",
          "cefr_level": "A1",
          "word_slugs": [
            "vendono-verb"
          ]
        },
        {
          "id": "5980601",
          "text": "Gli ombrelli si vendono bene.",
          "translation": "Зонты хорошо продаются.",
          "source": "Tatoeba #5980601 @dnnywld / #3936161 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980601",
          "cefr_level": "A1",
          "word_slugs": [
            "vendono-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "vendono",
        "plural": "",
        "infinitive": "vendono"
      }
