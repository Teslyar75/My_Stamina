          ]
        },
        {
          "id": "5672446",
          "text": "Ieri sera lavoravo io.",
          "translation": "Вчера вечером работал я.",
          "source": "Tatoeba #5672446 @dnnywld / #5672024 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672446",
          "cefr_level": "A1",
          "word_slugs": [
            "lavoravo-verb"
          ]
        },
        {
          "id": "6587139",
          "text": "Lavoravo tutto il giorno.",
          "translation": "Я весь день работал.",
          "source": "Tatoeba #6587139 @dnnywld / #6584590 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6587139",
          "cefr_level": "A1",
          "word_slugs": [
