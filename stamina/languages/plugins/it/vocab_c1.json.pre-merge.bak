          ]
        },
        {
          "id": "3333192",
          "text": "Questa giornata è cominciata bene.",
          "translation": "Этот день начался хорошо.",
          "source": "Tatoeba #3333192 @bailujia / #3333201 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3333192",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciata-verb"
          ]
        },
        {
          "id": "6950306",
          "text": "La caccia alle streghe è cominciata.",
          "translation": "Охота на ведьм началась.",
          "source": "Tatoeba #6950306 @dnnywld / #2522104 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950306",
