      "frequency_rank": 5039,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3584026",
          "text": "Guardiamo un film?",
          "translation": "Давай посмотрим какой-нибудь фильм.",
          "source": "Tatoeba #3584026 @Guybrush88 / #3584031 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584026",
          "cefr_level": "A1",
          "word_slugs": [
            "guardiamo-verb"
          ]
        },
        {
          "id": "5616447",
          "text": "Dai, guardiamo un film.",
          "translation": "Давай посмотрим какой-нибудь фильм.",
          "source": "Tatoeba #5616447 @dnnywld / #3584031 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616447",
          "cefr_level": "A1",
          "word_slugs": [
            "guardiamo-verb"
          ]
        },
        {
          "id": "5521873",
          "text": "Guardiamo come Tom fa questo.",
          "translation": "Давайте посмотрим, как Том это делает.",
          "source": "Tatoeba #5521873 @dnnywld / #5520963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5521873",
          "cefr_level": "A1",
          "word_slugs": [
            "guardiamo-verb"
          ]
        },
        {
          "id": "2872499",
          "text": "Guardiamo in faccia la realtà.",
          "translation": "Давайте посмотрим правде в глаза.",
          "source": "Tatoeba #2872499 @Guybrush88 / #7913071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2872499",
          "cefr_level": "A1",
          "word_slugs": [
            "guardiamo-verb"
          ]
        },
        {
          "id": "5507175",
          "text": "Ogni giorno guardiamo la televisione.",
          "translation": "Мы каждый день смотрим телевизор.",
          "source": "Tatoeba #5507175 @dnnywld / #381240 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507175",
          "cefr_level": "A1",
          "word_slugs": [
            "guardiamo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
