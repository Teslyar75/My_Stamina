    {
      "slug": "accadendo-verb",
      "lemma": "accadendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5365,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5643928",
          "text": "Non mi piace quello che sta accadendo.",
          "translation": "Мне не нравится то, что происходит.",
          "source": "Tatoeba #5643928 @dnnywld / #5642267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643928",
          "cefr_level": "A1",
          "word_slugs": [
            "accadendo-verb"
          ]
        },
        {
          "id": "6985274",
          "text": "Cosa ti sta accadendo negli ultimi tempi?",
          "translation": "Что с тобой происходит в последнее время?",
          "source": "Tatoeba #6985274 @dnnywld / #6985003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6985274",
          "cefr_level": "A1",
          "word_slugs": [
            "accadendo-verb"
          ]
        },
        {
          "id": "5913078",
          "text": "Non capisco perché mi stia accadendo questo.",
          "translation": "Я не понимаю, почему это со мной происходит.",
          "source": "Tatoeba #5913078 @dnnywld / #5911171 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913078",
          "cefr_level": "A1",
          "word_slugs": [
            "accadendo-verb"
          ]
        },
        {
          "id": "5470470",
          "text": "Riesci credere che questo stia veramente accadendo?",
          "translation": "Ты можешь поверить, что это действительно происходит?",
          "source": "Tatoeba #5470470 @dnnywld / #5470409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5470470",
          "cefr_level": "A1",
          "word_slugs": [
            "accadendo-verb"
          ]
        },
        {
          "id": "5470477",
          "text": "Riuscite a credere che questo stia veramente accadendo?",
          "translation": "Вы можете поверить, что это действительно происходит?",
          "source": "Tatoeba #5470477 @dnnywld / #5470408 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5470477",
          "cefr_level": "A1",
          "word_slugs": [
            "accadendo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "accadendo",
