    {
      "slug": "impara-verb",
      "lemma": "impara",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5080,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2480412",
          "text": "Impara l'uiguro!",
          "translation": "Учи уйгурский!",
          "source": "Tatoeba #2480412 @Guybrush88 / #3682655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2480412",
          "cefr_level": "A1",
          "word_slugs": [
            "impara-verb"
          ]
        },
        {
          "id": "1136053",
          "text": "Impara l'italiano.",
          "translation": "Учи итальянский.",
          "source": "Tatoeba #1136053 @Guybrush88 / #1136068 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1136053",
          "cefr_level": "A1",
          "word_slugs": [
            "impara-verb"
          ]
        },
        {
          "id": "10996322",
          "text": "Impara a trattenerti.",
          "translation": "Учись сдерживаться.",
          "source": "Tatoeba #10996322 @dnnywld / #10996288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10996322",
          "cefr_level": "A1",
          "word_slugs": [
            "impara-verb"
          ]
        },
        {
          "id": "14069605",
          "text": "Tom impara il turco.",
          "translation": "Том учит турецкий.",
          "source": "Tatoeba #14069605 @Guybrush88 / #14069745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14069605",
          "cefr_level": "A1",
          "word_slugs": [
            "impara-verb"
          ]
        },
        {
          "id": "6940739",
          "text": "Monica impara a fatica.",
          "translation": "Моника учится с трудом.",
          "source": "Tatoeba #6940739 @dnnywld / #6940430 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6940739",
          "cefr_level": "A1",
          "word_slugs": [
            "impara-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
