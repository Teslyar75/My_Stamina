    {
      "slug": "diede-verb",
      "lemma": "diede",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5368,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3568264",
          "text": "Mi diede una mela.",
          "translation": "Он мне дал яблоко.",
          "source": "Tatoeba #3568264 @Guybrush88 / #1575402 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3568264",
          "cefr_level": "A1",
          "word_slugs": [
            "diede-verb"
          ]
        },
        {
          "id": "3049170",
          "text": "Mi diede diversi libri.",
          "translation": "Он дал мне несколько книг.",
          "source": "Tatoeba #3049170 @Guybrush88 / #4762811 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3049170",
          "cefr_level": "A1",
          "word_slugs": [
            "diede-verb"
          ]
        },
        {
          "id": "890921",
          "text": "Diede un osso al cane.",
          "translation": "Он дал собаке кость.",
          "source": "Tatoeba #890921 @Guybrush88 / #902740 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/890921",
          "cefr_level": "A1",
          "word_slugs": [
            "diede-verb"
          ]
        },
        {
          "id": "3568265",
          "text": "Lui mi diede una mela.",
          "translation": "Он мне дал яблоко.",
          "source": "Tatoeba #3568265 @Guybrush88 / #1575402 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3568265",
          "cefr_level": "A1",
          "word_slugs": [
            "diede-verb"
          ]
        },
        {
          "id": "6902925",
          "text": "Lui mi diede un viatico.",
          "translation": "Он дал мне путёвку в жизнь.",
          "source": "Tatoeba #6902925 @dnnywld / #6902783 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6902925",
          "cefr_level": "A1",
          "word_slugs": [
            "diede-verb"
          ]
        }
      ],
      "tags": [
