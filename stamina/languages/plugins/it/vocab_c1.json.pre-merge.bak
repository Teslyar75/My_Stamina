      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4974471",
          "text": "Ha un preservativo?",
          "translation": "У тебя есть презерватив?",
          "source": "Tatoeba #4974471 @Guybrush88 / #594645 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4974471",
          "cefr_level": "A1",
          "word_slugs": [
            "preservativo-adj"
          ]
        },
        {
          "id": "4409",
          "text": "Hai un preservativo?",
          "translation": "У тебя есть презерватив?",
          "source": "Tatoeba #4409 @Guybrush88 / #594645 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4409",
          "cefr_level": "A1",
          "word_slugs": [
            "preservativo-adj"
          ]
        },
        {
          "id": "5269401",
          "text": "Ho bisogno di un preservativo.",
          "translation": "Мне нужен презерватив.",
          "source": "Tatoeba #5269401 @WM3DAS / #5269661 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5269401",
          "cefr_level": "A1",
          "word_slugs": [
            "preservativo-adj"
          ]
        },
        {
          "id": "5845116",
          "text": "Tom usa sempre il preservativo.",
          "translation": "Том всегда использует презерватив.",
          "source": "Tatoeba #5845116 @dnnywld / #2230004 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845116",
          "cefr_level": "A1",
          "word_slugs": [
            "preservativo-adj"
          ]
        },
        {
          "id": "5530467",
          "text": "Tirate indietro il prepuzio prima di infilare il preservativo.",
          "translation": "Оттяните крайнюю плоть, перед тем как надевать презерватив.",
          "source": "Tatoeba #5530467 @dnnywld / #1533497 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5530467",
          "cefr_level": "A1",
