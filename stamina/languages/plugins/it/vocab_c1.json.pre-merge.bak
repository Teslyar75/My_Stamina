    {
      "slug": "ospedali-noun",
      "lemma": "ospedali",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6651,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6947918",
          "text": "Ho paura degli ospedali.",
          "translation": "Я боюсь больниц.",
          "source": "Tatoeba #6947918 @dnnywld / #6946953 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6947918",
          "cefr_level": "A1",
          "word_slugs": [
            "ospedali-noun"
          ]
        },
        {
          "id": "1536639",
          "text": "Gli ospedali sono molto costosi.",
          "translation": "Больницы очень дорогие.",
          "source": "Tatoeba #1536639 @Guybrush88 / #2382529 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1536639",
          "cefr_level": "A1",
          "word_slugs": [
            "ospedali-noun"
          ]
        },
        {
          "id": "7497291",
          "text": "Quanti ospedali ci sono a Boston?",
          "translation": "Сколько в Бостоне больниц?",
          "source": "Tatoeba #7497291 @dnnywld / #7497069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7497291",
          "cefr_level": "A1",
          "word_slugs": [
            "ospedali-noun"
          ]
        },
        {
          "id": "7614727",
          "text": "Andiamo a costruire ospedali in Romania.",
          "translation": "Мы едем строить больницы в Румынии.",
          "source": "Tatoeba #7614727 @Guybrush88 / #10136428 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7614727",
          "cefr_level": "A1",
          "word_slugs": [
            "ospedali-noun"
          ]
        },
        {
          "id": "7615202",
          "text": "Non vanno a costruire ospedali in Libia.",
          "translation": "Они не собираются строить больницы в Ливии.",
          "source": "Tatoeba #7615202 @Guybrush88 / #8374384 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7615202",
          "cefr_level": "A1",
          "word_slugs": [
            "ospedali-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
