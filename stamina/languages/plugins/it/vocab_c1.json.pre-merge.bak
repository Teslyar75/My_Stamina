    {
      "slug": "comportato-verb",
      "lemma": "comportato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6090,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2512462",
          "text": "Lui come si è comportato?",
          "translation": "Как он себя повёл?",
          "source": "Tatoeba #2512462 @Guybrush88 / #3394970 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2512462",
          "cefr_level": "A1",
          "word_slugs": [
            "comportato-verb"
          ]
        },
        {
          "id": "5464586",
          "text": "Tom si è comportato male.",
          "translation": "Том плохо себя повёл.",
          "source": "Tatoeba #5464586 @dnnywld / #5464088 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5464586",
          "cefr_level": "A1",
          "word_slugs": [
            "comportato-verb"
          ]
        },
        {
          "id": "6904562",
          "text": "Lui si è comportato stupidamente.",
          "translation": "Он повёл себя глупо.",
          "source": "Tatoeba #6904562 @dnnywld / #4797754 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904562",
          "cefr_level": "A1",
          "word_slugs": [
            "comportato-verb"
          ]
        },
        {
          "id": "6904568",
          "text": "Tom si è comportato scorrettamente.",
          "translation": "Том повёл себя неэтично.",
          "source": "Tatoeba #6904568 @dnnywld / #5682607 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904568",
          "cefr_level": "A1",
          "word_slugs": [
            "comportato-verb"
          ]
        },
        {
          "id": "683415",
          "text": "Si è comportato come un maniaco.",
          "translation": "Он вёл себя как маньяк.",
          "source": "Tatoeba #683415 @BraveSentry / #10136245 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/683415",
          "cefr_level": "A1",
          "word_slugs": [
            "comportato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "comportato",
        "plural": "",
        "infinitive": "comportato"
      }
