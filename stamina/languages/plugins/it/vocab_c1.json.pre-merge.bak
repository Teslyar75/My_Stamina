    {
      "slug": "dedicato-adj",
      "lemma": "dedicato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6183,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10754353",
          "text": "Lui ha dedicato la propria vita alla pace.",
          "translation": "Он посвятил свою жизнь миру.",
          "source": "Tatoeba #10754353 @dnnywld / #659928 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754353",
          "cefr_level": "A1",
          "word_slugs": [
            "dedicato-adj"
          ]
        },
        {
          "id": "1275378",
          "text": "Suo padre ha dedicato la sua vita alla scienza.",
          "translation": "Его отец посвятил свою жизнь науке.",
          "source": "Tatoeba #1275378 @Guybrush88 / #1949577 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1275378",
          "cefr_level": "A1",
          "word_slugs": [
            "dedicato-adj"
          ]
        },
        {
          "id": "967384",
          "text": "Ha dedicato la sua vita allo studio della scienza.",
          "translation": "Она посвятила свою жизнь изучению науки.",
          "source": "Tatoeba #967384 @riccioberto / #446657 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/967384",
          "cefr_level": "A1",
          "word_slugs": [
            "dedicato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
