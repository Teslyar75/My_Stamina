    {
      "slug": "soffia-verb",
      "lemma": "soffia",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9578,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4278230",
          "text": "Oggi soffia un vento freddo.",
          "translation": "Сегодня дует холодный ветер.",
          "source": "Tatoeba #4278230 @bailujia / #4278275 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4278230",
          "cefr_level": "A1",
          "word_slugs": [
            "soffia-verb"
          ]
        },
        {
          "id": "5384963",
          "text": "Questa mattina soffia una leggera brezza.",
          "translation": "Сегодня с утра дует лёгкий бриз.",
          "source": "Tatoeba #5384963 @dnnywld / #5384765 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384963",
          "cefr_level": "A1",
          "word_slugs": [
            "soffia-verb"
          ]
        },
        {
          "id": "5444855",
          "text": "Il vento soffia ad un'incredibile velocità.",
          "translation": "Ветер дует с невероятной скоростью.",
          "source": "Tatoeba #5444855 @dnnywld / #5444832 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5444855",
          "cefr_level": "A1",
          "word_slugs": [
            "soffia-verb"
          ]
        },
        {
          "id": "2885656",
          "text": "Chi è scottato una volta, l'altra vi soffia su.",
          "translation": "Пуганая ворона куста боится.",
          "source": "Tatoeba #2885656 @Guybrush88 / #1728358 @naXa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2885656",
          "cefr_level": "A1",
          "word_slugs": [
            "soffia-verb"
          ]
        },
        {
          "id": "2885659",
          "text": "Chi si scotta con la minestra bollente soffia anche su quella fredda.",
          "translation": "Пуганая ворона куста боится.",
          "source": "Tatoeba #2885659 @Guybrush88 / #1728358 @naXa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2885659",
          "cefr_level": "A1",
          "word_slugs": [
            "soffia-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "soffia",
        "plural": "",
        "infinitive": "soffia"
      }
