    {
      "slug": "righe-noun",
      "lemma": "righe",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8647,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5749474",
          "text": "Non so leggere tra le righe.",
          "translation": "Я не умею читать между строк.",
          "source": "Tatoeba #5749474 @dnnywld / #1521383 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5749474",
          "cefr_level": "A1",
          "word_slugs": [
            "righe-noun"
          ]
        },
        {
          "id": "6203819",
          "text": "Citerò alcune righe della sua lettera.",
          "translation": "Я процитирую несколько строк из его письма.",
          "source": "Tatoeba #6203819 @dnnywld / #6203769 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6203819",
          "cefr_level": "A1",
          "word_slugs": [
            "righe-noun"
          ]
        },
        {
          "id": "2454143",
          "text": "Non tutti capiscono il significato segreto che è nascosto tra le righe.",
          "translation": "Не каждый понимает тайный смысл, который скрыт между строк.",
          "source": "Tatoeba #2454143 @al_ex_an_der / #2454115 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2454143",
          "cefr_level": "A1",
          "word_slugs": [
            "righe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la righe",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "solitamente-adv",
      "lemma": "solitamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8648,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2449789",
          "text": "I gatti solitamente miagolano.",
          "translation": "Кошки обычно мяукают.",
          "source": "Tatoeba #2449789 @Guybrush88 / #3267527 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2449789",
          "cefr_level": "A1",
          "word_slugs": [
            "solitamente-adv"
          ]
        },
        {
          "id": "6009295",
          "text": "Quanto veloce guidi solitamente?",
          "translation": "Как быстро ты обычно водишь?",
          "source": "Tatoeba #6009295 @dnnywld / #6009142 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009295",
          "cefr_level": "A1",
          "word_slugs": [
            "solitamente-adv"
          ]
        },
        {
          "id": "5828201",
          "text": "Solitamente non prendono ostaggi.",
          "translation": "Обычно они не берут заложников.",
          "source": "Tatoeba #5828201 @dnnywld / #4906248 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5828201",
          "cefr_level": "A1",
          "word_slugs": [
            "solitamente-adv"
          ]
        },
        {
          "id": "5507555",
          "text": "Tom solitamente dà buoni consigli.",
          "translation": "Том обычно даёт хорошие советы.",
          "source": "Tatoeba #5507555 @dnnywld / #5507015 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507555",
          "cefr_level": "A1",
          "word_slugs": [
            "solitamente-adv"
          ]
        },
        {
          "id": "5646811",
          "text": "Di sera, solitamente, riposiamo a casa.",
          "translation": "Вечером мы обычно отдыхаем дома.",
          "source": "Tatoeba #5646811 @dnnywld / #5646810 @juliastef (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646811",
          "cefr_level": "A1",
          "word_slugs": [
            "solitamente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "solitamente",
        "plural": "",
        "infinitive": ""
      }
