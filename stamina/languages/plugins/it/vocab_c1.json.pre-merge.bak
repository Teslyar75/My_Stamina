      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2215604",
          "text": "Sono un ingegnere.",
          "translation": "Я инженер.",
          "source": "Tatoeba #2215604 @Guybrush88 / #397587 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2215604",
