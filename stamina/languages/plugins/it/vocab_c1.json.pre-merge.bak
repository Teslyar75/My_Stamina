      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6795262",
          "text": "Quante nazioni ci sono in Asia?",
          "translation": "Сколько стран в Азии?",
          "source": "Tatoeba #6795262 @dnnywld / #6795243 @Annushka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6795262",
          "cefr_level": "A1",
          "word_slugs": [
            "nazioni-noun"
          ]
        },
        {
          "id": "6361944",
          "text": "Emily ha amici da diverse nazioni.",
          "translation": "У Эмили есть друзья из разных стран.",
          "source": "Tatoeba #6361944 @dnnywld / #2535847 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361944",
          "cefr_level": "A1",
          "word_slugs": [
            "nazioni-noun"
          ]
        },
        {
          "id": "10865300",
          "text": "Quali nazioni fanno parte del Benelux?",
          "translation": "Какие страны входят в Бенилюкс?",
