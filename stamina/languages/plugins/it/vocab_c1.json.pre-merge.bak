    {
      "slug": "fama-noun",
      "lemma": "fama",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6064,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5487669",
          "text": "Non inseguire la fama.",
          "translation": "Не гоняйся за славой.",
          "source": "Tatoeba #5487669 @dnnywld / #1863326 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5487669",
          "cefr_level": "A1",
          "word_slugs": [
            "fama-noun"
          ]
        },
        {
          "id": "5628442",
          "text": "Non mi importa della fama.",
          "translation": "Меня не волнует слава.",
          "source": "Tatoeba #5628442 @dnnywld / #2661359 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5628442",
          "cefr_level": "A1",
          "word_slugs": [
            "fama-noun"
          ]
        },
        {
          "id": "3036528",
          "text": "Mio cugino è un karateka di fama internazionale.",
          "translation": "Мой кузен — известный во всём мире каратист.",
          "source": "Tatoeba #3036528 @Guybrush88 / #3804043 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3036528",
          "cefr_level": "A1",
          "word_slugs": [
            "fama-noun"
          ]
        },
        {
          "id": "12016325",
          "text": "Né il denaro né la fama lo hanno reso felice.",
