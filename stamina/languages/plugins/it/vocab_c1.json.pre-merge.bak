    {
      "slug": "razzo-noun",
      "lemma": "razzo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7644,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5472066",
          "text": "Il razzo è esploso sulla rampa di lancio.",
          "translation": "Ракета взорвалась на стартовой площадке.",
          "source": "Tatoeba #5472066 @dnnywld / #5391678 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472066",
          "cefr_level": "A1",
          "word_slugs": [
            "razzo-noun"
          ]
        },
        {
          "id": "9857288",
          "text": "Il razzo atterrò in modo abbastanza delicato, in modo da non rompersi.",
          "translation": "Ракета приземлилась достаточно мягко, чтобы не поломаться.",
          "source": "Tatoeba #9857288 @marioparcia / #467219 @timsa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9857288",
          "cefr_level": "A1",
          "word_slugs": [
            "razzo-noun"
          ]
        },
        {
          "id": "5637237",
          "text": "Il razzo richiede circa dieci minuti per entrare nell'orbita della Terra.",
          "translation": "Чтобы выйти на орбиту Земли, ракете требуется примерно десять минут.",
          "source": "Tatoeba #5637237 @dnnywld / #5637232 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5637237",
          "cefr_level": "A1",
          "word_slugs": [
            "razzo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il razzo",
        "plural": "",
        "infinitive": ""
      }
    },
    {
