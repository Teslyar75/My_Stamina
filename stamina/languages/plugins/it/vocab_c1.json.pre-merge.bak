    {
      "slug": "procede-verb",
      "lemma": "procede",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6410,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5401105",
          "text": "La vita procede.",
          "translation": "Жизнь проходит.",
          "source": "Tatoeba #5401105 @dnnywld / #5401052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5401105",
          "cefr_level": "A1",
          "word_slugs": [
            "procede-verb"
          ]
        },
        {
          "id": "6326327",
          "text": "Tutto procede ottimamente.",
          "translation": "Всё идёт прекрасно.",
          "source": "Tatoeba #6326327 @dnnywld / #6325694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326327",
          "cefr_level": "A1",
          "word_slugs": [
            "procede-verb"
          ]
        },
        {
          "id": "11386295",
          "text": "Il caso procede rapidamente.",
          "translation": "Дело идёт полным ходом.",
          "source": "Tatoeba #11386295 @Bernie75 / #3164924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11386295",
          "cefr_level": "A1",
          "word_slugs": [
            "procede-verb"
          ]
        },
        {
          "id": "5668614",
          "text": "Come procede col nuovo ruolo?",
          "translation": "Как успехи на новом поприще?",
          "source": "Tatoeba #5668614 @dnnywld / #5666796 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5668614",
          "cefr_level": "A1",
          "word_slugs": [
            "procede-verb"
          ]
        },
        {
          "id": "5637439",
          "text": "Il lavoro procede col contagocce.",
          "translation": "Работа продвигается в час по чайной ложке.",
          "source": "Tatoeba #5637439 @dnnywld / #5637260 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5637439",
          "cefr_level": "A1",
          "word_slugs": [
            "procede-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
