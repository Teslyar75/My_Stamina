      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5479317",
          "text": "Tom è una normale adolescente medio.",
          "translation": "Том обычный среднестатистический подросток.",
          "source": "Tatoeba #5479317 @dnnywld / #5479202 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479317",
          "cefr_level": "A1",
          "word_slugs": [
            "medio-adj"
          ]
        },
        {
          "id": "5389640",
          "text": "Lei gli ha mostrato il dito medio.",
          "translation": "Она показала ему средний палец.",
          "source": "Tatoeba #5389640 @dnnywld / #5389065 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389640",
          "cefr_level": "A1",
          "word_slugs": [
            "medio-adj"
          ]
        },
        {
          "id": "651039",
          "text": "La mano ha cinque dita: pollice, indice, medio, anulare, mignolo.",
          "translation": "На руке пять пальцев: большой, указательный, средний, безымянный, мизинец.",
          "source": "Tatoeba #651039 @rado / #6107528 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/651039",
          "cefr_level": "A1",
          "word_slugs": [
