    {
      "slug": "ottiene-verb",
      "lemma": "ottiene",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6592,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5845255",
          "text": "Tom ottiene un biglietto.",
          "translation": "Том получает билет.",
          "source": "Tatoeba #5845255 @dnnywld / #5830636 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845255",
          "cefr_level": "A1",
          "word_slugs": [
            "ottiene-verb"
          ]
        },
        {
          "id": "7047623",
          "text": "Chi non chiede non ottiene.",
          "translation": "Кто не просит, тот не получает.",
          "source": "Tatoeba #7047623 @dnnywld / #7047112 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7047623",
          "cefr_level": "A1",
          "word_slugs": [
            "ottiene-verb"
          ]
        },
        {
          "id": "5845502",
          "text": "Chi troppo vuole, nulla ottiene.",
          "translation": "Слишком разборчивый ничего не получает.",
          "source": "Tatoeba #5845502 @dnnywld / #823752 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845502",
          "cefr_level": "A1",
          "word_slugs": [
            "ottiene-verb"
          ]
        },
        {
          "id": "5845492",
          "text": "Dalla farina si ottiene il pane.",
          "translation": "Из муки получается хлеб.",
          "source": "Tatoeba #5845492 @dnnywld / #5180179 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845492",
          "cefr_level": "A1",
          "word_slugs": [
            "ottiene-verb"
          ]
        },
        {
          "id": "5846001",
          "text": "Tom ottiene tutto quello che vuole.",
          "translation": "Том получает всё, чего захочет.",
          "source": "Tatoeba #5846001 @dnnywld / #4936670 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846001",
          "cefr_level": "A1",
          "word_slugs": [
            "ottiene-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ottiene",
        "plural": "",
