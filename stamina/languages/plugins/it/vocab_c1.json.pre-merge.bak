    {
      "slug": "sudore-noun",
      "lemma": "sudore",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7416,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12302650",
          "text": "Niente dolci senza sudore.",
          "translation": "Вслед за горем приходит радость.",
          "source": "Tatoeba #12302650 @Bernie75 / #3447450 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12302650",
          "cefr_level": "A1",
          "word_slugs": [
            "sudore-noun"
          ]
        },
        {
          "id": "7807913",
          "text": "Lui si asciugò il sudore dal viso.",
          "translation": "Он вытер пот с лица.",
          "source": "Tatoeba #7807913 @dnnywld / #594639 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7807913",
          "cefr_level": "A1",
          "word_slugs": [
            "sudore-noun"
          ]
        },
        {
          "id": "6775063",
          "text": "Il sudore corse giù sulla schiena di Tom.",
          "translation": "Пот сбежал у Тома по спине.",
          "source": "Tatoeba #6775063 @dnnywld / #6774302 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6775063",
          "cefr_level": "A1",
          "word_slugs": [
            "sudore-noun"
          ]
        },
        {
          "id": "5445983",
          "text": "Mi tolgo i vestiti perché sono impregnati di sudore.",
          "translation": "Я сниму одежду, потому что она пропитана потом.",
          "source": "Tatoeba #5445983 @dnnywld / #5445779 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5445983",
          "cefr_level": "A1",
          "word_slugs": [
            "sudore-noun"
          ]
        },
        {
          "id": "5661247",
          "text": "Io lavoro con il sudore nella fronte e lui si riposa.",
          "translation": "Я работаю в поте лица, а он отдыхает.",
          "source": "Tatoeba #5661247 @dnnywld / #5661203 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5661247",
          "cefr_level": "A1",
          "word_slugs": [
            "sudore-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il sudore",
        "plural": "",
        "infinitive": ""
      }
    },
