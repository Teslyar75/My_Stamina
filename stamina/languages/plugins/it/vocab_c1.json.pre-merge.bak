    {
      "slug": "sperando-verb",
      "lemma": "sperando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5470,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4953516",
          "text": "Stiamo sperando che non sia vero.",
          "translation": "Мы надеемся, что это неправда.",
          "source": "Tatoeba #4953516 @Guybrush88 / #4955168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4953516",
          "cefr_level": "A1",
          "word_slugs": [
            "sperando-verb"
          ]
        },
        {
          "id": "4953517",
          "text": "Noi stiamo sperando che non sia vero.",
          "translation": "Мы надеемся, что это неправда.",
          "source": "Tatoeba #4953517 @Guybrush88 / #4955168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4953517",
          "cefr_level": "A1",
          "word_slugs": [
            "sperando-verb"
          ]
        },
        {
          "id": "6883175",
          "text": "Stavi sperando di vincere, non è vero?",
          "translation": "Ты ведь надеялся победить?",
          "source": "Tatoeba #6883175 @dnnywld / #6882262 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883175",
          "cefr_level": "A1",
          "word_slugs": [
            "sperando-verb"
          ]
        },
        {
          "id": "5624366",
          "text": "Sono venuto qui sperando di vedere Tom.",
          "translation": "Я пришёл сюда, надеясь увидеть Тома.",
          "source": "Tatoeba #5624366 @dnnywld / #5622814 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624366",
          "cefr_level": "A1",
          "word_slugs": [
            "sperando-verb"
          ]
        },
        {
          "id": "6883176",
          "text": "Stavate sperando di vincere, non è vero?",
          "translation": "Вы ведь надеялись победить?",
          "source": "Tatoeba #6883176 @dnnywld / #6882261 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883176",
          "cefr_level": "A1",
          "word_slugs": [
            "sperando-verb"
          ]
        }
