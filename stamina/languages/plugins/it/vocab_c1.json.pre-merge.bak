    {
      "slug": "chimico-adj",
      "lemma": "chimico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8940,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "химик"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5491934",
          "text": "Il boro è un elemento chimico contrassegnato dal simbolo B.",
          "translation": "Бор — химический элемент, который обозначается символом B.",
          "source": "Tatoeba #5491934 @dnnywld / #5491840 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5491934",
          "cefr_level": "A1",
          "word_slugs": [
            "chimico-adj"
          ]
        },
        {
          "id": "5492181",
          "text": "L'azoto è un elemento chimico contrassegnato dal simbolo N.",
          "translation": "Азот — химический элемент, который обозначается символом N.",
          "source": "Tatoeba #5492181 @dnnywld / #5491875 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5492181",
          "cefr_level": "A1",
          "word_slugs": [
            "chimico-adj"
          ]
        },
        {
          "id": "5491958",
          "text": "L'argon è un elemento chimico contrassegnato dal simbolo Ar.",
          "translation": "Аргон — химический элемент, который обозначается символом Ar.",
          "source": "Tatoeba #5491958 @dnnywld / #5491823 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5491958",
          "cefr_level": "A1",
          "word_slugs": [
            "chimico-adj"
          ]
        },
        {
          "id": "5492176",
          "text": "L'osmio è un elemento chimico contrassegnato dal simbolo Os.",
          "translation": "Осмий — химический элемент, который обозначается символом Os.",
          "source": "Tatoeba #5492176 @dnnywld / #5491879 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5492176",
          "cefr_level": "A1",
          "word_slugs": [
            "chimico-adj"
          ]
        },
        {
          "id": "5491940",
          "text": "Il bario è un elemento chimico contrassegnato dal simbolo Ba.",
          "translation": "Барий — химический элемент, который обозначается символом Ba.",
          "source": "Tatoeba #5491940 @dnnywld / #5491833 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5491940",
          "cefr_level": "A1",
          "word_slugs": [
            "chimico-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
