      "examples": [
        {
          "id": "7015484",
          "text": "Credo alla sua innocenza.",
          "translation": "Я верю в её невиновность.",
          "source": "Tatoeba #7015484 @dnnywld / #7015190 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7015484",
          "cefr_level": "A1",
          "word_slugs": [
            "innocenza-name"
          ]
        },
        {
          "id": "935001",
          "text": "Insisteva sulla sua innocenza.",
          "translation": "Он настаивал на своей невиновности.",
          "source": "Tatoeba #935001 @Guybrush88 / #1792761 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/935001",
