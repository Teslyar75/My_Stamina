    {
      "slug": "farmacia-noun",
      "lemma": "farmacia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7520,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "4347230",
          "text": "Dov´è la farmacia?",
          "translation": "Где аптека?",
          "source": "Tatoeba #4347230 @saverius / #4099563 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4347230",
          "cefr_level": "A1",
          "word_slugs": [
            "farmacia-noun"
          ]
        },
        {
          "id": "2847651",
          "text": "Dov'è la farmacia più vicina?",
          "translation": "Где ближайшая аптека?",
          "source": "Tatoeba #2847651 @Guybrush88 / #548608 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2847651",
          "cefr_level": "A1",
          "word_slugs": [
            "farmacia-noun"
          ]
        },
        {
          "id": "6163477",
          "text": "Questo non si vende in farmacia.",
          "translation": "Это не продаётся в аптеке.",
          "source": "Tatoeba #6163477 @dnnywld / #6163371 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6163477",
          "cefr_level": "A1",
          "word_slugs": [
            "farmacia-noun"
          ]
        },
        {
          "id": "6163476",
          "text": "Questo si vende in qualsiasi farmacia.",
          "translation": "Это продаётся в любой аптеке.",
          "source": "Tatoeba #6163476 @dnnywld / #6163372 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6163476",
          "cefr_level": "A1",
          "word_slugs": [
            "farmacia-noun"
          ]
        },
        {
          "id": "2855518",
          "text": "Qual è il nome della tua farmacia?",
          "translation": "Как называется твоя аптека?",
          "source": "Tatoeba #2855518 @Guybrush88 / #3855833 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2855518",
          "cefr_level": "A1",
          "word_slugs": [
            "farmacia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la farmacia",
        "plural": "",
        "infinitive": ""
      }
