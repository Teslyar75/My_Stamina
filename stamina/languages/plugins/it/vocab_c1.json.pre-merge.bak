    {
      "slug": "spedire-verb",
      "lemma": "spedire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9545,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3339169",
          "text": "Posso spedire questa cartolina esagonale?",
          "translation": "Я могу отправить эту шестиугольную открытку?",
          "source": "Tatoeba #3339169 @bailujia / #3339174 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3339169",
          "cefr_level": "A1",
          "word_slugs": [
            "spedire-verb"
          ]
        },
        {
          "id": "5489164",
          "text": "A chi dovrei spedire la lettera?",
          "translation": "Кому мне следует адресовать письмо?",
          "source": "Tatoeba #5489164 @dnnywld / #5488859 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489164",
          "cefr_level": "A1",
          "word_slugs": [
            "spedire-verb"
          ]
        },
        {
          "id": "6804420",
          "text": "Ho scordato di spedire la lettera.",
          "translation": "Я забыл отправить письмо.",
          "source": "Tatoeba #6804420 @dnnywld / #2740467 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804420",
          "cefr_level": "A1",
          "word_slugs": [
            "spedire-verb"
          ]
        },
        {
          "id": "350311",
          "text": "Puoi spedire questa lettera per me?",
          "translation": "Можешь отправить это письмо для меня?",
          "source": "Tatoeba #350311 @martin / #4667521 @yura798261 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350311",
          "cefr_level": "A1",
          "word_slugs": [
            "spedire-verb"
          ]
        },
        {
          "id": "5680868",
          "text": "Vorrei spedire questa lettera in Giappone.",
          "translation": "Я хотел бы отправить это письмо в Японию.",
          "source": "Tatoeba #5680868 @dnnywld / #5680369 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5680868",
          "cefr_level": "A1",
          "word_slugs": [
            "spedire-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "spedire",
