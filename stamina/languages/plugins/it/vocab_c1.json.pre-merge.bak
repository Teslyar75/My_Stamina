          "cefr_level": "A1",
          "word_slugs": [
            "manica-noun"
          ]
        },
        {
          "id": "7063476",
          "text": "L'ho preso per la manica.",
          "translation": "Я схватил его за рукав.",
          "source": "Tatoeba #7063476 @dnnywld / #7063448 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7063476",
          "cefr_level": "A1",
          "word_slugs": [
            "manica-noun"
          ]
        },
        {
          "id": "12995044",
          "text": "La buona memoria è il suo asso nella manica.",
          "translation": "Хорошая память - её козырь.",
          "source": "Tatoeba #12995044 @dnnywld / #12994106 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12995044",
          "cefr_level": "A1",
          "word_slugs": [
            "manica-noun"
          ]
        }
      ],
