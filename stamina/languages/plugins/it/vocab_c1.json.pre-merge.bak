    {
      "slug": "pecore-noun",
      "lemma": "pecore",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7461,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5496986",
          "text": "Stavo contando le pecore.",
          "translation": "Я считал овец.",
          "source": "Tatoeba #5496986 @dnnywld / #3471343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5496986",
          "cefr_level": "A1",
          "word_slugs": [
            "pecore-noun"
          ]
        },
        {
          "id": "6678908",
          "text": "Tom non tiene le pecore.",
          "translation": "Том не держит овец.",
          "source": "Tatoeba #6678908 @dnnywld / #6678802 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6678908",
          "cefr_level": "A1",
          "word_slugs": [
            "pecore-noun"
          ]
        },
        {
          "id": "5251897",
          "text": "Le pecore mangiano l'erba.",
          "translation": "Овцы едят траву.",
          "source": "Tatoeba #5251897 @Guybrush88 / #4491620 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5251897",
          "cefr_level": "A1",
          "word_slugs": [
            "pecore-noun"
          ]
        },
        {
          "id": "763066",
          "text": "Le pecore si cibano di erba.",
          "translation": "Овцы едят траву.",
          "source": "Tatoeba #763066 @Pharamp / #4491620 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/763066",
          "cefr_level": "A1",
          "word_slugs": [
            "pecore-noun"
          ]
        },
        {
          "id": "6678910",
          "text": "Tom non ha capre, solo pecore.",
          "translation": "У Тома нет коз, только овцы.",
          "source": "Tatoeba #6678910 @dnnywld / #6678801 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6678910",
          "cefr_level": "A1",
          "word_slugs": [
            "pecore-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
