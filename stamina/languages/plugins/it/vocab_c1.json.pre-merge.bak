          ]
        },
        {
          "id": "388065",
          "text": "Il mio tasso di colesterolo è alto.",
          "translation": "У меня высокий уровень холестерина.",
          "source": "Tatoeba #388065 @Pharamp / #3286776 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/388065",
          "cefr_level": "A1",
          "word_slugs": [
            "tasso-noun"
          ]
        },
        {
          "id": "7023870",
          "text": "Il tasso di disoccupazione è diminuito del 15%.",
          "translation": "Уровень безработицы снизился на 15%.",
