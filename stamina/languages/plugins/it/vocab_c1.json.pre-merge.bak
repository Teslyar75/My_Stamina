    {
      "slug": "arriveremo-verb",
      "lemma": "arriveremo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5427,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6893448",
          "text": "Come ci arriveremo?",
          "translation": "Как мы туда доберёмся?",
          "source": "Tatoeba #6893448 @dnnywld / #6893423 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893448",
          "cefr_level": "A1",
          "word_slugs": [
            "arriveremo-verb"
          ]
        },
        {
          "id": "6947751",
          "text": "Arriveremo in tempo.",
          "translation": "Мы придём вовремя.",
          "source": "Tatoeba #6947751 @dnnywld / #6947092 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6947751",
          "cefr_level": "A1",
          "word_slugs": [
            "arriveremo-verb"
          ]
        },
        {
          "id": "6785625",
          "text": "Ci arriveremo in tempo.",
          "translation": "Мы доберёмся туда вовремя.",
          "source": "Tatoeba #6785625 @dnnywld / #3965400 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6785625",
          "cefr_level": "A1",
          "word_slugs": [
            "arriveremo-verb"
          ]
        },
        {
          "id": "2262575",
          "text": "A che ora arriveremo a Boston?",
          "translation": "Во сколько мы попадём в Бостон?",
          "source": "Tatoeba #2262575 @Guybrush88 / #5536640 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2262575",
          "cefr_level": "A1",
          "word_slugs": [
            "arriveremo-verb"
          ]
        },
        {
          "id": "5506791",
          "text": "Quando arriveremo a Boston troveremo buio.",
          "translation": "К тому времени как мы доберёмся до Бостона, стемнеет.",
          "source": "Tatoeba #5506791 @dnnywld / #5505759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506791",
          "cefr_level": "A1",
          "word_slugs": [
            "arriveremo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "arriveremo",
        "plural": "",
        "infinitive": "arriveremo"
      }
    },
    {
      "slug": "preoccupazione-noun",
      "lemma": "preoccupazione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5429,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2988604",
          "text": "Capisco la tua preoccupazione.",
          "translation": "Твоя озабоченность мне понятна.",
          "source": "Tatoeba #2988604 @Guybrush88 / #5384629 @lemeoejubsmgt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2988604",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupazione-noun"
          ]
        },
        {
          "id": "5528823",
          "text": "La loro preoccupazione è comprensibile.",
          "translation": "Их беспокойство понятно.",
          "source": "Tatoeba #5528823 @dnnywld / #4748082 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5528823",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupazione-noun"
          ]
        },
        {
          "id": "6944380",
          "text": "Comprendo perfettamente la vostra preoccupazione.",
          "translation": "Я прекрасно понимаю вашу обеспокоенность.",
          "source": "Tatoeba #6944380 @dnnywld / #6943819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944380",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupazione-noun"
          ]
        },
        {
          "id": "5588964",
          "text": "Questa è la mia unica preoccupazione.",
          "translation": "Это единственная моя забота.",
          "source": "Tatoeba #5588964 @dnnywld / #5588933 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5588964",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupazione-noun"
          ]
        },
        {
          "id": "5692280",
          "text": "Il suo comportamento è la mia principale preoccupazione.",
          "translation": "Её поведение - это моя главная забота.",
          "source": "Tatoeba #5692280 @dnnywld / #5691924 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5692280",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupazione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la preoccupazione",
        "plural": "",
        "infinitive": ""
      }
    },
