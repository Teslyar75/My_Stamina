    {
      "slug": "punteggio-noun",
      "lemma": "punteggio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7496,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "счет"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6953530",
          "text": "Ho intenzione di ottenere un punteggio elevato.",
          "translation": "Я намерен получить высокий балл.",
          "source": "Tatoeba #6953530 @dnnywld / #2903949 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953530",
          "cefr_level": "A1",
          "word_slugs": [
            "punteggio-noun"
          ]
        },
        {
          "id": "1108891",
          "text": "Il punteggio finale fu di due a zero.",
          "translation": "Итоговый счет был два - ноль.",
          "source": "Tatoeba #1108891 @riccioberto / #2841608 @izdaleka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1108891",
          "cefr_level": "A1",
          "word_slugs": [
            "punteggio-noun"
          ]
        },
        {
          "id": "10803846",
          "text": "Tom non può avere un punteggio così alto.",
          "translation": "У Тома не может быть такой высокий рейтинг.",
          "source": "Tatoeba #10803846 @dnnywld / #7092165 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10803846",
          "cefr_level": "A1",
          "word_slugs": [
            "punteggio-noun"
          ]
        },
        {
          "id": "5443069",
          "text": "Il \"Lokomotiv\" ha perso con la \"Dinamo\" col punteggio di 1:2.",
          "translation": "\"Локомотив\" уступил \"Динамо\" со счётом 1:2.",
          "source": "Tatoeba #5443069 @dnnywld / #5442567 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5443069",
          "cefr_level": "A1",
          "word_slugs": [
            "punteggio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
