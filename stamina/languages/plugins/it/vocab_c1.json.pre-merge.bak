      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4538384",
          "text": "Il cervo bramisce.",
          "translation": "Олень ревёт.",
          "source": "Tatoeba #4538384 @Guybrush88 / #4539241 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538384",
          "cefr_level": "A1",
          "word_slugs": [
            "cervo-noun"
          ]
        },
        {
          "id": "5868584",
          "text": "Abbiamo abbattuto un cervo.",
          "translation": "Мы сбили оленя.",
          "source": "Tatoeba #5868584 @dnnywld / #5783786 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868584",
          "cefr_level": "A1",
          "word_slugs": [
            "cervo-noun"
          ]
        },
        {
          "id": "13136172",
          "text": "Lui ha visto un cervo.",
          "translation": "Он видел оленя.",
          "source": "Tatoeba #13136172 @dnnywld / #13134577 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13136172",
          "cefr_level": "A1",
          "word_slugs": [
            "cervo-noun"
          ]
        },
        {
          "id": "1007448",
          "text": "Il cervo correva da solo.",
          "translation": "Олень бежал сам по себе.",
          "source": "Tatoeba #1007448 @Guybrush88 / #4131191 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1007448",
          "cefr_level": "A1",
          "word_slugs": [
            "cervo-noun"
          ]
        },
        {
          "id": "6858808",
          "text": "MI sono imbattuto in un cervo.",
          "translation": "Я встретил оленя.",
          "source": "Tatoeba #6858808 @dnnywld / #6858723 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6858808",
          "cefr_level": "A1",
          "word_slugs": [
            "cervo-noun"
          ]
        }
