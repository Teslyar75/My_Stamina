    {
      "slug": "cause-noun",
      "lemma": "cause",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5182,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7215772",
          "text": "Tom è morto nel 2013 di cause naturali.",
          "translation": "Том умер в 2013 году от естественных причин.",
          "source": "Tatoeba #7215772 @dnnywld / #7215458 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7215772",
          "cefr_level": "A1",
          "word_slugs": [
            "cause-noun"
          ]
        },
        {
          "id": "13495349",
          "text": "Le cause dell'emicrania sono ancora sconosciute.",
          "translation": "Причины мигрени до сих пор неизвестны.",
          "source": "Tatoeba #13495349 @dnnywld / #11339420 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495349",
          "cefr_level": "A1",
          "word_slugs": [
            "cause-noun"
          ]
        },
        {
          "id": "759950",
          "text": "Il loro nazionalismo fu una delle cause della guerra.",
          "translation": "Их национализм был одной из причин войны.",
          "source": "Tatoeba #759950 @Guybrush88 / #3173682 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/759950",
          "cefr_level": "A1",
          "word_slugs": [
            "cause-noun"
          ]
        },
        {
          "id": "3364216",
          "text": "L'omosessualità è una delle principali cause di suicidio tra gli adolescenti.",
          "translation": "Гомосексуальность — одна из основных причин самоубийств среди подростков.",
          "source": "Tatoeba #3364216 @Guybrush88 / #4945284 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3364216",
          "cefr_level": "A1",
          "word_slugs": [
            "cause-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la cause",
