    {
      "slug": "ciascuno-adj",
      "lemma": "ciascuno",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6062,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6978313",
          "text": "Ciascuno porti il suo fardello.",
          "translation": "Каждый понесет свою ношу.",
          "source": "Tatoeba #6978313 @dnnywld / #3325098 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6978313",
          "cefr_level": "A1",
          "word_slugs": [
            "ciascuno-adj"
          ]
        },
        {
          "id": "12433635",
          "text": "Ciascuno conosce il proprio compito.",
          "translation": "Каждый знает свою задачу.",
          "source": "Tatoeba #12433635 @dnnywld / #12433390 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12433635",
          "cefr_level": "A1",
          "word_slugs": [
            "ciascuno-adj"
          ]
        },
        {
          "id": "6790587",
          "text": "Per ciascuno è una questione personale.",
          "translation": "Это личное дело каждого.",
          "source": "Tatoeba #6790587 @dnnywld / #5198206 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790587",
          "cefr_level": "A1",
          "word_slugs": [
            "ciascuno-adj"
          ]
        },
        {
          "id": "6891408",
          "text": "Ciascuno può dare il proprio contributo.",
          "translation": "Каждый может внести свой вклад.",
          "source": "Tatoeba #6891408 @dnnywld / #2197014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891408",
          "cefr_level": "A1",
          "word_slugs": [
            "ciascuno-adj"
          ]
        },
        {
          "id": "6891410",
          "text": "Ciascuno deve dare il proprio contributo.",
          "translation": "Каждый должен внести свою лепту.",
          "source": "Tatoeba #6891410 @dnnywld / #4317526 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891410",
          "cefr_level": "A1",
          "word_slugs": [
            "ciascuno-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
