    {
      "slug": "effettivamente-adv",
      "lemma": "effettivamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5566,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10793253",
          "text": "Effettivamente è un problema.",
          "translation": "Это действительно проблема.",
          "source": "Tatoeba #10793253 @dnnywld / #3540143 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10793253",
          "cefr_level": "A1",
          "word_slugs": [
            "effettivamente-adv"
          ]
        },
        {
          "id": "3302622",
          "text": "Effettivamente siamo un po' stanchini.",
          "translation": "Мы правда немного подустали.",
          "source": "Tatoeba #3302622 @Guybrush88 / #3801860 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3302622",
          "cefr_level": "A1",
          "word_slugs": [
            "effettivamente-adv"
          ]
        },
        {
          "id": "6326098",
          "text": "Si, effettivamente era qualcosa di simile.",
          "translation": "Да, действительно, что-то такое было.",
          "source": "Tatoeba #6326098 @dnnywld / #6325725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326098",
          "cefr_level": "A1",
          "word_slugs": [
            "effettivamente-adv"
          ]
        },
        {
          "id": "5985616",
          "text": "Effettivamente, questa non è una brutta idea.",
          "translation": "Вообще-то, это неплохая идея.",
          "source": "Tatoeba #5985616 @dnnywld / #4022622 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5985616",
          "cefr_level": "A1",
          "word_slugs": [
            "effettivamente-adv"
          ]
        },
        {
          "id": "6005639",
          "text": "Tom ha detto che aveva effettivamente visto un fantasma.",
          "translation": "Том сказал, что он действительно видел призрака.",
          "source": "Tatoeba #6005639 @dnnywld / #6005182 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6005639",
          "cefr_level": "A1",
          "word_slugs": [
            "effettivamente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "effettivamente",
        "plural": "",
        "infinitive": ""
      }
