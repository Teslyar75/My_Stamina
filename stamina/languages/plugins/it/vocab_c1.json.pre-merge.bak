    {
      "slug": "congelato-adj",
      "lemma": "congelato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9931,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "мороженый",
          "замороженый"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5692905",
          "text": "Il fiume è congelato.",
          "translation": "Река замёрзла.",
          "source": "Tatoeba #5692905 @dnnywld / #5692676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5692905",
          "cefr_level": "A1",
          "word_slugs": [
            "congelato-adj"
          ]
        },
        {
          "id": "5529743",
          "text": "Lo stagno è congelato.",
          "translation": "Пруд замёрз.",
          "source": "Tatoeba #5529743 @dnnywld / #1271288 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5529743",
          "cefr_level": "A1",
          "word_slugs": [
            "congelato-adj"
          ]
        },
        {
          "id": "5529744",
          "text": "Lo stagno si è congelato.",
          "translation": "Пруд покрылся льдом.",
          "source": "Tatoeba #5529744 @dnnywld / #1271287 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5529744",
          "cefr_level": "A1",
          "word_slugs": [
            "congelato-adj"
          ]
        },
        {
          "id": "6810232",
          "text": "Facendo attenzione, Maria pose il coniglio congelato nel microonde.",
          "translation": "Мария осторожно положила глубоко замороженного зайца в микроволновку.",
          "source": "Tatoeba #6810232 @dnnywld / #6807685 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6810232",
          "cefr_level": "A1",
          "word_slugs": [
            "congelato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
