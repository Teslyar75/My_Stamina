    {
      "slug": "comprensione-noun",
      "lemma": "comprensione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6907,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1018002",
          "text": "Grazie per la tua comprensione.",
          "translation": "Благодарю за понимание.",
          "source": "Tatoeba #1018002 @Guybrush88 / #2080866 @Lathean (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1018002",
          "cefr_level": "A1",
          "word_slugs": [
            "comprensione-noun"
          ]
        },
        {
          "id": "11396562",
          "text": "Grazie per la vostra comprensione",
          "translation": "Спасибо вам за понимание.",
          "source": "Tatoeba #11396562 @Bernie75 / #2994058 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11396562",
          "cefr_level": "A1",
          "word_slugs": [
            "comprensione-noun"
          ]
        },
        {
          "id": "1659857",
          "text": "Grazie a tutti per la comprensione!",
          "translation": "Всем спасибо за понимание!",
          "source": "Tatoeba #1659857 @Guybrush88 / #5409933 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1659857",
          "cefr_level": "A1",
          "word_slugs": [
            "comprensione-noun"
          ]
        },
        {
          "id": "11396570",
          "text": "Vi ringrazio per la vostra comprensione.",
          "translation": "Спасибо вам за понимание.",
          "source": "Tatoeba #11396570 @Bernie75 / #2994058 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11396570",
          "cefr_level": "A1",
          "word_slugs": [
            "comprensione-noun"
          ]
        },
        {
          "id": "5652169",
          "text": "Questo è assolutamente sopra la mia comprensione.",
          "translation": "Это абсолютно выше моего понимания.",
