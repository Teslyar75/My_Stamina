    {
      "slug": "ottimi-adj",
      "lemma": "ottimi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6232,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5626757",
          "text": "\"I risultati sono buoni?\" - \"Si, ottimi\".",
          "translation": "\"Результаты хорошие?\" — \"Да, отличные\".",
          "source": "Tatoeba #5626757 @dnnywld / #5626310 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626757",
          "cefr_level": "A1",
          "word_slugs": [
            "ottimi-adj"
          ]
        },
        {
          "id": "5465004",
          "text": "Tom e Mary sono in ottimi rapporti.",
          "translation": "У Тома и Мэри прекрасные отношения.",
          "source": "Tatoeba #5465004 @dnnywld / #5464810 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5465004",
          "cefr_level": "A1",
          "word_slugs": [
            "ottimi-adj"
          ]
        },
        {
          "id": "6799713",
          "text": "Lui ha superato l'esame con ottimi voti.",
          "translation": "Он сдал экзамен на отлично.",
          "source": "Tatoeba #6799713 @dnnywld / #2074746 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799713",
          "cefr_level": "A1",
          "word_slugs": [
            "ottimi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
