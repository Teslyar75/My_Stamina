    {
      "slug": "lavoratori-noun",
      "lemma": "lavoratori",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5881,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10851654",
          "text": "Perché questi lavoratori stavano scioperando?",
          "translation": "Почему эти рабочие бастовали?",
          "source": "Tatoeba #10851654 @dnnywld / #3060925 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851654",
          "cefr_level": "A1",
          "word_slugs": [
            "lavoratori-noun"
          ]
        },
        {
          "id": "10854265",
          "text": "I castori sono animali lavoratori instancabili.",
          "translation": "Бобры — трудолюбивые животные.",
          "source": "Tatoeba #10854265 @dnnywld / #4545542 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854265",
          "cefr_level": "A1",
          "word_slugs": [
            "lavoratori-noun"
          ]
        },
        {
          "id": "5987236",
          "text": "I lavoratori chiedono un aumento dello stipendio.",
          "translation": "Работники требуют повышения зарплаты.",
          "source": "Tatoeba #5987236 @dnnywld / #5986597 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5987236",
          "cefr_level": "A1",
          "word_slugs": [
            "lavoratori-noun"
          ]
        },
        {
          "id": "6788928",
          "text": "Generalmente parlando, i Giapponesi sono dei lavoratori.",
          "translation": "Вообще говоря, японцы работящие.",
          "source": "Tatoeba #6788928 @dnnywld / #4689657 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6788928",
          "cefr_level": "A1",
          "word_slugs": [
            "lavoratori-noun"
          ]
        },
        {
          "id": "5510942",
          "text": "Si dice che i tedeschi siano grandi lavoratori.",
          "translation": "Про немцев говорят, что они работяги.",
          "source": "Tatoeba #5510942 @dnnywld / #5510670 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510942",
          "cefr_level": "A1",
          "word_slugs": [
            "lavoratori-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il lavoratori",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "quota-noun",
      "lemma": "quota",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5882,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7036112",
          "text": "L'aereo sta prendendo quota.",
          "translation": "Самолёт набирает высоту.",
          "source": "Tatoeba #7036112 @dnnywld / #7035803 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7036112",
          "cefr_level": "A1",
          "word_slugs": [
            "quota-noun"
          ]
        },
        {
          "id": "10861438",
          "text": "Non è prevista la quota di iscrizione.",
          "translation": "Вступительного взноса нет.",
          "source": "Tatoeba #10861438 @dnnywld / #4781319 @stifler86 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10861438",
          "cefr_level": "A1",
          "word_slugs": [
            "quota-noun"
          ]
        },
        {
          "id": "6893499",
          "text": "L'aereo cominciò velocemente a prendere quota.",
          "translation": "Самолёт начал быстро набирать высоту.",
          "source": "Tatoeba #6893499 @dnnywld / #2481214 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893499",
          "cefr_level": "A1",
          "word_slugs": [
            "quota-noun"
          ]
        },
        {
          "id": "6698392",
          "text": "A chi appartiene la quota azionaria di maggioranza?",
          "translation": "Кому принадлежит контрольный пакет акций?",
          "source": "Tatoeba #6698392 @dnnywld / #6697403 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698392",
          "cefr_level": "A1",
          "word_slugs": [
            "quota-noun"
          ]
        },
        {
          "id": "5619879",
          "text": "L'aereo volava a bassa quota e a bassa velocità.",
          "translation": "Самолёт двигался на малой высоте и с небольшой скоростью.",
          "source": "Tatoeba #5619879 @dnnywld / #5619801 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619879",
          "cefr_level": "A1",
          "word_slugs": [
            "quota-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la quota",
        "plural": "",
        "infinitive": ""
      }
    },
