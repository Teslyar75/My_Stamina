    {
      "slug": "disturbare-verb",
      "lemma": "disturbare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6626,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1539268",
          "text": "Non mi disturbare.",
          "translation": "Не тревожь меня.",
          "source": "Tatoeba #1539268 @Guybrush88 / #1784416 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1539268",
          "cefr_level": "A1",
          "word_slugs": [
            "disturbare-verb"
          ]
        },
        {
          "id": "521196",
          "text": "Non mi disturbare quando sto studiando.",
          "translation": "Не беспокой меня, когда я занимаюсь.",
          "source": "Tatoeba #521196 @Pharamp / #573603 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/521196",
          "cefr_level": "A1",
          "word_slugs": [
            "disturbare-verb"
          ]
        },
        {
          "id": "6940808",
          "text": "Non disturbare, Tom. Mi stai distraendo dal caso.",
          "translation": "Не мешай, Том. Ты отрываешь меня от дела.",
          "source": "Tatoeba #6940808 @dnnywld / #6940390 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6940808",
          "cefr_level": "A1",
          "word_slugs": [
            "disturbare-verb"
          ]
        }
      ],
      "tags": [
