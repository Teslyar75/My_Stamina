    {
      "slug": "vitale-adj",
      "lemma": "vitale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5947,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13630339",
          "text": "Il denaro è la linfa vitale dell'economia.",
          "translation": "Деньги являются кровью экономики.",
          "source": "Tatoeba #13630339 @carlosalberto / #3566538 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13630339",
          "cefr_level": "A1",
          "word_slugs": [
            "vitale-adj"
          ]
        },
        {
          "id": "2206038",
          "text": "Per qualche motivo, mi sento più vitale la notte.",
          "translation": "Почему-то по ночам я бодрее.",
          "source": "Tatoeba #2206038 @miccap / #5466 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2206038",
          "cefr_level": "A1",
          "word_slugs": [
            "vitale-adj"
          ]
        },
        {
          "id": "5643954",
          "text": "Hanno spento la macchina di supporto vitale di Tom.",
          "translation": "Они отключили Тома от аппарата жизнеобеспечения.",
          "source": "Tatoeba #5643954 @dnnywld / #5642237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643954",
          "cefr_level": "A1",
          "word_slugs": [
            "vitale-adj"
          ]
        },
        {
          "id": "5674215",
          "text": "Tom è stato scollegato dalla macchina di supporto vitale.",
          "translation": "Том был отключён от аппарата жизнеобеспечения.",
          "source": "Tatoeba #5674215 @dnnywld / #5673932 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5674215",
          "cefr_level": "A1",
          "word_slugs": [
            "vitale-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
