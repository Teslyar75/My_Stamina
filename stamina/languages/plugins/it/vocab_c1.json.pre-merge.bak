    {
      "slug": "occorre-verb",
      "lemma": "occorre",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6599,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10812641",
          "text": "Occorre mantenere una promessa.",
          "translation": "Следует выполнять обещания.",
          "source": "Tatoeba #10812641 @dnnywld / #3494176 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10812641",
          "cefr_level": "A1",
          "word_slugs": [
            "occorre-verb"
          ]
        },
        {
          "id": "6905434",
          "text": "Occorre che tu lo faccia.",
          "translation": "Тебе необходимо это сделать.",
          "source": "Tatoeba #6905434 @dnnywld / #3644184 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6905434",
          "cefr_level": "A1",
          "word_slugs": [
            "occorre-verb"
          ]
        },
        {
          "id": "5393803",
          "text": "Per questo occorre qualche tempo.",
          "translation": "На это потребуется какое-то время.",
          "source": "Tatoeba #5393803 @dnnywld / #3251367 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5393803",
          "cefr_level": "A1",
          "word_slugs": [
            "occorre-verb"
          ]
        },
        {
          "id": "5516516",
          "text": "Non occorre fare scenate davanti a tutti.",
          "translation": "Не нужно устраивать сцены на виду у всех.",
          "source": "Tatoeba #5516516 @dnnywld / #5018513 @kukla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5516516",
          "cefr_level": "A1",
          "word_slugs": [
            "occorre-verb"
          ]
        },
        {
          "id": "7036106",
          "text": "Non occorre prendere appunti, basta che ascoltiate.",
          "translation": "Записывать не надо, просто слушайте.",
          "source": "Tatoeba #7036106 @dnnywld / #7035821 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7036106",
          "cefr_level": "A1",
          "word_slugs": [
            "occorre-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "occorre",
        "plural": "",
        "infinitive": "occorre"
      }
    },
