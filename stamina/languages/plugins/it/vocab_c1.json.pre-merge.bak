    {
      "slug": "sedici-adj",
      "lemma": "sedici",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6490,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "шестнадцать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6908096",
          "text": "Addio al duemila e sedici.",
          "translation": "Прощай, две тысячи шестнадцатый.",
          "source": "Tatoeba #6908096 @dnnywld / #6908069 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908096",
          "cefr_level": "A1",
          "word_slugs": [
            "sedici-adj"
          ]
        },
        {
          "id": "1710233",
          "text": "L'anno prossimo avrò sedici anni.",
          "translation": "В следующем году мне будет шестнадцать.",
          "source": "Tatoeba #1710233 @alexmarcelo / #5475389 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1710233",
          "cefr_level": "A1",
          "word_slugs": [
            "sedici-adj"
          ]
        },
        {
          "id": "5501573",
          "text": "Due elevato alla quarta fa sedici.",
          "translation": "Два в четвёртой степени — шестнадцать.",
          "source": "Tatoeba #5501573 @dnnywld / #5501047 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5501573",
          "cefr_level": "A1",
          "word_slugs": [
            "sedici-adj"
          ]
        },
        {
          "id": "758861",
          "text": "\"Quanti anni hai?\" \"Ho sedici anni.\"",
          "translation": "\"Сколько тебе лет?\" - \"Мне 16 лет\".",
          "source": "Tatoeba #758861 @Guybrush88 / #1560495 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/758861",
          "cefr_level": "A1",
          "word_slugs": [
            "sedici-adj"
          ]
        },
        {
          "id": "2790799",
          "text": "La mia sorella maggiore Angelina ha sedici anni.",
          "translation": "Моей старшей сестре Ангелине шестнадцать лет.",
          "source": "Tatoeba #2790799 @Guybrush88 / #2790803 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2790799",
          "cefr_level": "A1",
          "word_slugs": [
            "sedici-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sedici",
        "plural": "",
        "infinitive": ""
      }
