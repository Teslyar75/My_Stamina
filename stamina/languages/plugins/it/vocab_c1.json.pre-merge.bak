      "cefr_level": "C1",
      "frequency_rank": 5073,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8919615",
          "text": "Hanno quattro figli: tre maschi e una femmina.",
          "translation": "У них четверо детей: три мальчика и девочка.",
          "source": "Tatoeba #8919615 @carlosalberto / #7448196 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8919615",
          "cefr_level": "A1",
          "word_slugs": [
            "maschi-noun"
          ]
        },
        {
          "id": "7590426",
          "text": "Una donna daltonica avrà sempre figli maschi daltonici.",
          "translation": "У женщины-дальтоника дети мужского пола всегда будут дальтониками.",
          "source": "Tatoeba #7590426 @dnnywld / #7590394 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7590426",
          "cefr_level": "A1",
          "word_slugs": [
            "maschi-noun"
          ]
        },
        {
          "id": "5605678",
          "text": "Le femmine dei ragni sono più grandi dei maschi.",
          "translation": "Самки пауков крупнее самцов.",
          "source": "Tatoeba #5605678 @dnnywld / #5605357 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5605678",
          "cefr_level": "A1",
          "word_slugs": [
            "maschi-noun"
          ]
        },
        {
          "id": "5980935",
          "text": "Due studenti maschi sotto un solo ombrello? Che strano.",
          "translation": "Два школьника под одним зонтом? Как странно.",
          "source": "Tatoeba #5980935 @dnnywld / #2866047 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980935",
          "cefr_level": "A1",
          "word_slugs": [
            "maschi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
