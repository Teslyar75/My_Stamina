    {
      "slug": "concordo-verb",
      "lemma": "concordo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5940,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3189548",
          "text": "Concordo in toto.",
          "translation": "Полностью согласен.",
          "source": "Tatoeba #3189548 @Guybrush88 / #2145634 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3189548",
          "cefr_level": "A1",
          "word_slugs": [
            "concordo-verb"
          ]
        },
        {
          "id": "1697966",
          "text": "Concordo in pieno!",
          "translation": "Я полностью согласен.",
          "source": "Tatoeba #1697966 @Guybrush88 / #3057162 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1697966",
          "cefr_level": "A1",
          "word_slugs": [
            "concordo-verb"
          ]
        },
        {
          "id": "5486557",
          "text": "Concordo con l'opinione di Tom.",
          "translation": "Я согласна с мнением Тома.",
          "source": "Tatoeba #5486557 @dnnywld / #5485106 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5486557",
          "cefr_level": "A1",
          "word_slugs": [
            "concordo-verb"
          ]
        },
        {
          "id": "5454115",
          "text": "Concordo al cento per cento con Tom.",
          "translation": "Я согласен с Томом на сто процентов.",
          "source": "Tatoeba #5454115 @dnnywld / #5454048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5454115",
          "cefr_level": "A1",
          "word_slugs": [
            "concordo-verb"
          ]
        },
        {
          "id": "6832261",
          "text": "Concordo con te fino ad un certo punto.",
          "translation": "В какой-то степени я с тобой согласен.",
          "source": "Tatoeba #6832261 @dnnywld / #3605350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6832261",
          "cefr_level": "A1",
          "word_slugs": [
            "concordo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
