    {
      "slug": "compro-verb",
      "lemma": "compro",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5387,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3857879",
          "text": "Non li compro.",
          "translation": "Я их не покупаю.",
          "source": "Tatoeba #3857879 @Guybrush88 / #2759467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3857879",
          "cefr_level": "A1",
          "word_slugs": [
            "compro-verb"
          ]
        },
        {
          "id": "3156354",
          "text": "Compro questi pantaloni.",
          "translation": "Покупаю эти брюки.",
          "source": "Tatoeba #3156354 @Guybrush88 / #5709091 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3156354",
          "cefr_level": "A1",
          "word_slugs": [
            "compro-verb"
          ]
        },
        {
          "id": "3857882",
          "text": "Io non le compro.",
          "translation": "Я их не покупаю.",
          "source": "Tatoeba #3857882 @Guybrush88 / #2759467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3857882",
          "cefr_level": "A1",
          "word_slugs": [
            "compro-verb"
          ]
        },
        {
          "id": "6764613",
          "text": "Non compro cose così.",
          "translation": "Я такие не покупаю.",
          "source": "Tatoeba #6764613 @dnnywld / #6764408 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6764613",
          "cefr_level": "A1",
          "word_slugs": [
            "compro-verb"
          ]
        },
        {
          "id": "6023209",
          "text": "MI compro un nuovo ombrello.",
          "translation": "Я покупаю себе новый зонт.",
          "source": "Tatoeba #6023209 @dnnywld / #6023153 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6023209",
          "cefr_level": "A1",
          "word_slugs": [
            "compro-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
