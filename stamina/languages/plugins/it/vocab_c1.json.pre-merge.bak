    {
      "slug": "definito-verb",
      "lemma": "definito",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8154,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5451581",
          "text": "Ci hanno definito ignoranti.",
          "translation": "Они называют нас невежественными.",
          "source": "Tatoeba #5451581 @dnnywld / #2324276 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5451581",
          "cefr_level": "A1",
          "word_slugs": [
            "definito-verb"
          ]
        },
        {
          "id": "4671598",
          "text": "Schopenauer ha definito l'architettura \"musica congelata\".",
          "translation": "Шопенгауэр определил архитектуру как \"застывшую музыку\".",
          "source": "Tatoeba #4671598 @madriot / #5205080 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4671598",
          "cefr_level": "A1",
          "word_slugs": [
            "definito-verb"
          ]
        },
        {
          "id": "10941092",
          "text": "L'esito dei negoziati non è ancora definito.",
          "translation": "Исход переговоров ещё не определён.",
          "source": "Tatoeba #10941092 @dnnywld / #10940916 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10941092",
          "cefr_level": "A1",
          "word_slugs": [
            "definito-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il definito",
        "plural": "",
        "infinitive": "definito"
      }
