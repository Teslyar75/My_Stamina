      "gender": "m",
      "examples": [
        {
          "id": "4162061",
          "text": "Ti serve un asciugamano.",
          "translation": "Тебе нужно полотенце.",
          "source": "Tatoeba #4162061 @Guybrush88 / #5403158 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4162061",
          "cefr_level": "A1",
