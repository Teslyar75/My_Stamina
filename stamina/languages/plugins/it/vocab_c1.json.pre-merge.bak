    {
      "slug": "dieta-noun",
      "lemma": "dieta",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5490,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5634768",
          "text": "Siete in dieta?",
          "translation": "Вы на диете?",
          "source": "Tatoeba #5634768 @dnnywld / #5633379 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5634768",
          "cefr_level": "A1",
          "word_slugs": [
            "dieta-noun"
          ]
        },
        {
          "id": "3528758",
          "text": "Io sono a dieta.",
          "translation": "Я на диете.",
          "source": "Tatoeba #3528758 @Guybrush88 / #3176403 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3528758",
          "cefr_level": "A1",
          "word_slugs": [
            "dieta-noun"
          ]
        },
        {
          "id": "5484139",
          "text": "Devi osservare la dieta.",
          "translation": "Тебе нужно соблюдать диету.",
          "source": "Tatoeba #5484139 @dnnywld / #5483926 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5484139",
          "cefr_level": "A1",
          "word_slugs": [
            "dieta-noun"
          ]
        },
        {
          "id": "7764124",
          "text": "Seguo una dieta rigorosa.",
          "translation": "Я соблюдаю строгую диету.",
          "source": "Tatoeba #7764124 @dnnywld / #7763834 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7764124",
          "cefr_level": "A1",
          "word_slugs": [
            "dieta-noun"
          ]
        },
        {
          "id": "5481360",
          "text": "Tom deve mettersi a dieta.",
          "translation": "Тому надо сесть на диету.",
          "source": "Tatoeba #5481360 @dnnywld / #5480911 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5481360",
          "cefr_level": "A1",
          "word_slugs": [
            "dieta-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
