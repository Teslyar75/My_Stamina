    {
      "slug": "acquisto-noun",
      "lemma": "acquisto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7245,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7949498",
          "text": "Ho un buono acquisto.",
          "translation": "У меня есть скидочный купон.",
          "source": "Tatoeba #7949498 @dnnywld / #7949487 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7949498",
          "cefr_level": "A1",
          "word_slugs": [
            "acquisto-noun"
          ]
        },
        {
          "id": "6463131",
          "text": "Grazie molte a voi per l'acquisto.",
          "translation": "Большое спасибо вам за покупку.",
          "source": "Tatoeba #6463131 @dnnywld / #6462848 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6463131",
          "cefr_level": "A1",
          "word_slugs": [
            "acquisto-noun"
          ]
        },
        {
          "id": "6162652",
          "text": "Sono contrario all'acquisto di una motocicletta.",
          "translation": "Я против покупки мотоцикла.",
          "source": "Tatoeba #6162652 @dnnywld / #6162542 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6162652",
          "cefr_level": "A1",
          "word_slugs": [
            "acquisto-noun"
          ]
        },
        {
          "id": "7312796",
          "text": "Bisogna festeggiare l'acquisto della tua nuova macchina.",
          "translation": "Надо обмыть твою новую машину.",
          "source": "Tatoeba #7312796 @dnnywld / #7311696 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7312796",
          "cefr_level": "A1",
          "word_slugs": [
            "acquisto-noun"
          ]
        },
        {
          "id": "5497665",
          "text": "Volete fare un prestito per l'acquisto della casa?",
          "translation": "Вы хотите взять кредит на покупку дома?",
          "source": "Tatoeba #5497665 @dnnywld / #5497642 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497665",
          "cefr_level": "A1",
          "word_slugs": [
            "acquisto-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il acquisto",
        "plural": "",
        "infinitive": ""
      }
