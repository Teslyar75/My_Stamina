    {
      "slug": "inviti-noun",
      "lemma": "inviti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7739,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10888341",
          "text": "Ieri abbiamo spedito gli inviti.",
          "translation": "Мы вчера разослали приглашения.",
          "source": "Tatoeba #10888341 @dnnywld / #10888297 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10888341",
          "cefr_level": "A1",
          "word_slugs": [
            "inviti-noun"
          ]
        },
        {
          "id": "6400020",
          "text": "Non ci inviti a casa tua?",
          "translation": "Ты не пригласишь нас в дом?",
          "source": "Tatoeba #6400020 @dnnywld / #6399767 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6400020",
          "cefr_level": "A1",
          "word_slugs": [
            "inviti-noun"
          ]
        },
        {
          "id": "6367822",
          "text": "Se tu li inviti, io non verrò.",
          "translation": "Если ты их пригласишь, я не приду.",
          "source": "Tatoeba #6367822 @dnnywld / #6366906 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367822",
          "cefr_level": "A1",
          "word_slugs": [
            "inviti-noun"
          ]
        },
        {
          "id": "6367825",
          "text": "Se tu la inviti, io non verrò.",
          "translation": "Если ты её пригласишь, я не приду.",
          "source": "Tatoeba #6367825 @dnnywld / #6366905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367825",
          "cefr_level": "A1",
          "word_slugs": [
            "inviti-noun"
          ]
        },
        {
          "id": "6367826",
          "text": "Se tu lo inviti, io non verrò.",
          "translation": "Если ты его пригласишь, я не приду.",
          "source": "Tatoeba #6367826 @dnnywld / #6366904 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367826",
          "cefr_level": "A1",
          "word_slugs": [
            "inviti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
