    {
      "slug": "comprendo-verb",
      "lemma": "comprendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9148,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2960756",
          "text": "Non comprendo le donne.",
          "translation": "Я не понимаю женщин.",
          "source": "Tatoeba #2960756 @Guybrush88 / #2407249 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2960756",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendo-verb"
          ]
        },
        {
          "id": "2960757",
          "text": "Io non comprendo le donne.",
          "translation": "Я не понимаю женщин.",
          "source": "Tatoeba #2960757 @Guybrush88 / #2407249 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2960757",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendo-verb"
          ]
        },
        {
          "id": "6944382",
          "text": "Comprendo perfettamente la tua inquietudine.",
          "translation": "Я прекрасно понимаю твоё беспокойство.",
          "source": "Tatoeba #6944382 @dnnywld / #6943817 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944382",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendo-verb"
          ]
        },
        {
          "id": "6944381",
          "text": "Comprendo perfettamente la Vostra inquietudine.",
          "translation": "Я прекрасно понимаю Ваше беспокойство.",
          "source": "Tatoeba #6944381 @dnnywld / #6943818 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944381",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendo-verb"
          ]
        },
        {
          "id": "6944380",
          "text": "Comprendo perfettamente la vostra preoccupazione.",
          "translation": "Я прекрасно понимаю вашу обеспокоенность.",
          "source": "Tatoeba #6944380 @dnnywld / #6943819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944380",
          "cefr_level": "A1",
          "word_slugs": [
            "comprendo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
