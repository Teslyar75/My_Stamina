    {
      "slug": "strappato-adj",
      "lemma": "strappato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6000,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5527739",
          "text": "Mary ha strappato i collant.",
          "translation": "Мэри порвала колготки.",
          "source": "Tatoeba #5527739 @dnnywld / #5527359 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527739",
          "cefr_level": "A1",
          "word_slugs": [
            "strappato-adj"
          ]
        },
        {
          "id": "7047621",
          "text": "Chi ha strappato la mia camicia?",
          "translation": "Кто порвал мою рубашку?",
          "source": "Tatoeba #7047621 @dnnywld / #7047554 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7047621",
          "cefr_level": "A1",
          "word_slugs": [
            "strappato-adj"
          ]
        },
        {
          "id": "6790491",
          "text": "Lei ha strappato accidentalmente una pagina.",
          "translation": "Она случайно порвала страницу.",
          "source": "Tatoeba #6790491 @dnnywld / #3143329 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790491",
          "cefr_level": "A1",
          "word_slugs": [
            "strappato-adj"
          ]
        },
        {
          "id": "5532941",
          "text": "Tom ha strappato la lettera in pezzettini.",
          "translation": "Том разорвал письмо на кусочки.",
          "source": "Tatoeba #5532941 @dnnywld / #5532883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5532941",
          "cefr_level": "A1",
          "word_slugs": [
            "strappato-adj"
          ]
        },
        {
          "id": "7036123",
          "text": "Tom stesso ha cucito un bottone strappato.",
          "translation": "Том сам пришил оторванную пуговицу.",
          "source": "Tatoeba #7036123 @dnnywld / #7035793 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7036123",
          "cefr_level": "A1",
          "word_slugs": [
            "strappato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
