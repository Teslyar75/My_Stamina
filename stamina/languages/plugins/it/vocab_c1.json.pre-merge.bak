          ]
        },
        {
          "id": "6883440",
          "text": "Potresti metterti qualcosa di decente.",
          "translation": "Ты мог бы и поприличнее одеться.",
          "source": "Tatoeba #6883440 @dnnywld / #6883324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883440",
          "cefr_level": "A1",
          "word_slugs": [
            "decente-adj"
          ]
        },
        {
          "id": "6883445",
          "text": "Potrebbero mettersi qualcosa di decente.",
          "translation": "Мог бы и поприличнее одеться.",
          "source": "Tatoeba #6883445 @dnnywld / #6883322 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883445",
          "cefr_level": "A1",
          "word_slugs": [
            "decente-adj"
          ]
        },
        {
          "id": "6883447",
          "text": "Avreste potuto mettervi qualcosa di decente.",
          "translation": "Могли бы и поприличнее одеться.",
          "source": "Tatoeba #6883447 @dnnywld / #6883323 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883447",
          "cefr_level": "A1",
          "word_slugs": [
            "decente-adj"
          ]
        }
      ],
