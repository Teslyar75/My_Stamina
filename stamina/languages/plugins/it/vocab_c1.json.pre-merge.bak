      "frequency_rank": 5534,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2396683",
          "text": "La partita è noiosa.",
          "translation": "Игра скучная.",
          "source": "Tatoeba #2396683 @Guybrush88 / #3332289 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2396683",
          "cefr_level": "A1",
          "word_slugs": [
            "noiosa-adj"
          ]
        },
        {
          "id": "4377533",
          "text": "È una parola noiosa.",
          "translation": "Это скучное слово.",
          "source": "Tatoeba #4377533 @Guybrush88 / #4377539 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4377533",
          "cefr_level": "A1",
          "word_slugs": [
            "noiosa-adj"
          ]
        },
        {
          "id": "1226028",
          "text": "La California è noiosa.",
          "translation": "Калифорния скучная.",
          "source": "Tatoeba #1226028 @Guybrush88 / #3238220 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1226028",
          "cefr_level": "A1",
          "word_slugs": [
            "noiosa-adj"
          ]
        },
        {
          "id": "6628457",
          "text": "Questa riunione è noiosa.",
          "translation": "Это собрание скучное.",
          "source": "Tatoeba #6628457 @dnnywld / #6628049 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6628457",
          "cefr_level": "A1",
          "word_slugs": [
            "noiosa-adj"
          ]
        },
        {
          "id": "4387316",
          "text": "La mia vita è noiosa.",
          "translation": "Моя жизнь скучна.",
          "source": "Tatoeba #4387316 @Guybrush88 / #4814051 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4387316",
          "cefr_level": "A1",
