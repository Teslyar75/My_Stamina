          "cefr_level": "A1",
          "word_slugs": [
            "camere-noun"
          ]
        },
        {
          "id": "6829942",
          "text": "Lei ha affittato un appartamento di quattro camere.",
          "translation": "Она сняла четырёхкомнатную квартиру.",
          "source": "Tatoeba #6829942 @dnnywld / #6829804 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6829942",
          "cefr_level": "A1",
          "word_slugs": [
            "camere-noun"
          ]
        },
        {
          "id": "4533048",
          "text": "La casa di Tom ha tre camere da letto.",
          "translation": "В доме у Тома три спальни.",
          "source": "Tatoeba #4533048 @Guybrush88 / #5688988 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4533048",
          "cefr_level": "A1",
          "word_slugs": [
            "camere-noun"
          ]
        }
      ],
