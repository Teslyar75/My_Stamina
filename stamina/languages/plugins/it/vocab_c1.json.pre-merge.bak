    {
      "slug": "lotteria-noun",
      "lemma": "lotteria",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6619,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "4503059",
          "text": "Ha vinto la lotteria.",
          "translation": "Он сорвал большой куш.",
          "source": "Tatoeba #4503059 @Guybrush88 / #2704071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4503059",
          "cefr_level": "A1",
          "word_slugs": [
            "lotteria-noun"
          ]
        },
        {
          "id": "6785628",
          "text": "Abbiamo vinto alla lotteria.",
          "translation": "Мы выиграли в лотерею.",
          "source": "Tatoeba #6785628 @dnnywld / #3965116 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6785628",
          "cefr_level": "A1",
          "word_slugs": [
            "lotteria-noun"
          ]
        },
        {
          "id": "4955614",
          "text": "Il matrimonio è una lotteria.",
          "translation": "Брак - это лотерея.",
          "source": "Tatoeba #4955614 @Guybrush88 / #2970224 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4955614",
          "cefr_level": "A1",
          "word_slugs": [
            "lotteria-noun"
          ]
        },
        {
          "id": "5968709",
          "text": "Ho appena vinto alla lotteria.",
          "translation": "Я только что выиграл в лотерею.",
          "source": "Tatoeba #5968709 @dnnywld / #5968094 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968709",
          "cefr_level": "A1",
          "word_slugs": [
            "lotteria-noun"
          ]
        },
        {
          "id": "6083532",
          "text": "Immaginate di aver vinto alla lotteria!",
          "translation": "Представьте, что вы выиграли в лотерею!",
          "source": "Tatoeba #6083532 @dnnywld / #6082660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6083532",
          "cefr_level": "A1",
          "word_slugs": [
            "lotteria-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la lotteria",
        "plural": "",
