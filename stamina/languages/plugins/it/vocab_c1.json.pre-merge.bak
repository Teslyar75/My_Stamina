    {
      "slug": "volontario-adj",
      "lemma": "volontario",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6341,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3846438",
          "text": "È un volontario.",
          "translation": "Он волонтёр.",
          "source": "Tatoeba #3846438 @Guybrush88 / #4429096 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3846438",
          "cefr_level": "A1",
          "word_slugs": [
            "volontario-adj"
          ]
        },
        {
          "id": "5660582",
          "text": "Stiamo cercando un volontario.",
          "translation": "Мы ищем добровольца.",
          "source": "Tatoeba #5660582 @dnnywld / #5660216 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5660582",
          "cefr_level": "A1",
          "word_slugs": [
            "volontario-adj"
          ]
        },
        {
          "id": "11862368",
          "text": "Pensi che qualcuno si farà volontario?",
          "translation": "Думаешь, кто-нибудь пойдёт добровольно?",
          "source": "Tatoeba #11862368 @dnnywld / #11861134 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11862368",
          "cefr_level": "A1",
          "word_slugs": [
            "volontario-adj"
          ]
        },
        {
          "id": "5489547",
          "text": "Tom si è offerto volontario per andare a Boston.",
          "translation": "Том вызвался съездить в Бостон.",
          "source": "Tatoeba #5489547 @dnnywld / #5488353 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489547",
          "cefr_level": "A1",
          "word_slugs": [
            "volontario-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
