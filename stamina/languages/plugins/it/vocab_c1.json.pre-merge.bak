          ]
        },
        {
          "id": "5540578",
          "text": "Ho già fatto questi esercizi.",
          "translation": "Я уже сделал эти упражнения.",
          "source": "Tatoeba #5540578 @dnnywld / #5540366 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5540578",
          "cefr_level": "A1",
          "word_slugs": [
            "esercizi-noun"
          ]
        },
        {
          "id": "6003326",
          "text": "Ho risolto tutti i 48 esercizi.",
          "translation": "Я решил все 48 упражнений.",
          "source": "Tatoeba #6003326 @dnnywld / #6002764 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6003326",
          "cefr_level": "A1",
          "word_slugs": [
            "esercizi-noun"
          ]
        },
        {
          "id": "6857238",
          "text": "Oggi non ho esercizi per casa.",
          "translation": "Сегодня у меня нет домашней работы.",
          "source": "Tatoeba #6857238 @dnnywld / #6856778 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857238",
          "cefr_level": "A1",
          "word_slugs": [
            "esercizi-noun"
          ]
        },
        {
          "id": "5510035",
          "text": "Nel libro ci sono dieci esercizi.",
          "translation": "В книге десять упражнений.",
          "source": "Tatoeba #5510035 @dnnywld / #5509651 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510035",
          "cefr_level": "A1",
