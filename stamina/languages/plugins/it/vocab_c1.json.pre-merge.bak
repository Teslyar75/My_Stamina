      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3965720",
          "text": "Sono un meccanico.",
          "translation": "Я механик.",
          "source": "Tatoeba #3965720 @Guybrush88 / #3486076 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3965720",
          "cefr_level": "A1",
          "word_slugs": [
            "meccanico-adj"
          ]
        },
        {
          "id": "5487964",
          "text": "Mio marito fa il meccanico.",
          "translation": "Мой муж работает механиком.",
          "source": "Tatoeba #5487964 @dnnywld / #5487437 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5487964",
          "cefr_level": "A1",
          "word_slugs": [
            "meccanico-adj"
          ]
        },
        {
          "id": "6854839",
          "text": "Portalo dal meccanico in riparazione.",
          "translation": "Отнеси его к механику на починку.",
          "source": "Tatoeba #6854839 @dnnywld / #3365542 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6854839",
          "cefr_level": "A1",
          "word_slugs": [
            "meccanico-adj"
          ]
        },
        {
          "id": "10844056",
          "text": "Tom fa il meccanico nel parco macchine.",
          "translation": "Том работает механиком в автопарке.",
          "source": "Tatoeba #10844056 @dnnywld / #10841832 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844056",
          "cefr_level": "A1",
          "word_slugs": [
            "meccanico-adj"
          ]
        },
        {
          "id": "5487974",
          "text": "Mio marito di professione fa l'ingegnere meccanico.",
