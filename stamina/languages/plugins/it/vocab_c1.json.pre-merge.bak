    {
      "slug": "sana-adj",
      "lemma": "sana",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5247,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6788249",
          "text": "Sei assolutamente sana.",
          "translation": "Ты абсолютно здорова.",
          "source": "Tatoeba #6788249 @dnnywld / #4021433 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6788249",
          "cefr_level": "A1",
          "word_slugs": [
            "sana-adj"
          ]
        },
        {
          "id": "5480291",
          "text": "La paziente sembrava sana.",
          "translation": "Пациентка казалась здоровой.",
          "source": "Tatoeba #5480291 @dnnywld / #2843337 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5480291",
          "cefr_level": "A1",
          "word_slugs": [
            "sana-adj"
          ]
        },
        {
          "id": "6214828",
          "text": "Mens sana in corpore sano.",
          "translation": "Психическое здоровье так же важно, как и физическое.",
          "source": "Tatoeba #6214828 @dnnywld / #6214626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6214828",
          "cefr_level": "A1",
          "word_slugs": [
            "sana-adj"
          ]
        },
        {
          "id": "10953885",
          "text": "Cosa definiamo una alimentazione sana?",
          "translation": "Что мы называем здоровым питанием?",
          "source": "Tatoeba #10953885 @dnnywld / #10952245 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10953885",
          "cefr_level": "A1",
          "word_slugs": [
            "sana-adj"
          ]
        },
        {
          "id": "13477675",
          "text": "Sana'a è la capitale dello Yemen.",
          "translation": "Сана - столица Йемена.",
          "source": "Tatoeba #13477675 @Guybrush88 / #12787880 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13477675",
          "cefr_level": "A1",
          "word_slugs": [
            "sana-adj"
          ]
        }
