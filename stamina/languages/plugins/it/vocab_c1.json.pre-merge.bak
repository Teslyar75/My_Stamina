      "lemma": "corro",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9516,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "707353",
          "text": "Corro ogni giorno.",
          "translation": "Я бегаю каждый день.",
          "source": "Tatoeba #707353 @Guybrush88 / #527094 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/707353",
          "cefr_level": "A1",
          "word_slugs": [
            "corro-verb"
          ]
        },
        {
          "id": "1653632",
          "text": "Corro al botteghino.",
          "translation": "Я бегу к кассе.",
          "source": "Tatoeba #1653632 @Guybrush88 / #3139835 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1653632",
          "cefr_level": "A1",
          "word_slugs": [
            "corro-verb"
          ]
        },
        {
          "id": "6944331",
          "text": "Non corro alcun rischio.",
          "translation": "Я ничем не рискую.",
          "source": "Tatoeba #6944331 @dnnywld / #6943846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944331",
          "cefr_level": "A1",
          "word_slugs": [
            "corro-verb"
          ]
        },
        {
          "id": "6877768",
          "text": "Corro regolarmente nel parco.",
          "translation": "Я регулярно бегаю в парке.",
          "source": "Tatoeba #6877768 @dnnywld / #6091105 @Tatjana (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6877768",
          "cefr_level": "A1",
          "word_slugs": [
            "corro-verb"
          ]
        },
        {
          "id": "3670374",
          "text": "Corro in bagno a vomitare.",
          "translation": "Я сбегаю в ванную поблевать.",
          "source": "Tatoeba #3670374 @Guybrush88 / #3670385 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3670374",
          "cefr_level": "A1",
          "word_slugs": [
