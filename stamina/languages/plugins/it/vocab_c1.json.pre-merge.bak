    {
      "slug": "estratto-adj",
      "lemma": "estratto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6881,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6055559",
          "text": "È stato estratto dal contesto.",
          "translation": "Это было выдернуто из контекста.",
          "source": "Tatoeba #6055559 @dnnywld / #6055233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6055559",
          "cefr_level": "A1",
          "word_slugs": [
            "estratto-adj"
          ]
        },
        {
          "id": "6785978",
          "text": "Ieri mi hanno estratto un dente.",
          "translation": "Мне вчера вырвали зуб.",
          "source": "Tatoeba #6785978 @dnnywld / #6785798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6785978",
          "cefr_level": "A1",
          "word_slugs": [
            "estratto-adj"
          ]
        },
        {
          "id": "7764169",
          "text": "L'oro viene estratto nei giacimenti auriferi.",
          "translation": "Золото добывают на золотых приисках.",
          "source": "Tatoeba #7764169 @dnnywld / #7763723 @Wayawa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7764169",
          "cefr_level": "A1",
          "word_slugs": [
            "estratto-adj"
          ]
        },
        {
          "id": "6691613",
          "text": "Lui ha estratto l'unità flash dal computer.",
          "translation": "Он вынул флешку с компьютера.",
          "source": "Tatoeba #6691613 @dnnywld / #6691195 @lingvokrolik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6691613",
          "cefr_level": "A1",
          "word_slugs": [
            "estratto-adj"
          ]
        }
      ],
      "tags": [
        "C1"
