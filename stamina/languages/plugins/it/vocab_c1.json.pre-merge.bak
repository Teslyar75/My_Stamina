    {
      "slug": "conduce-verb",
      "lemma": "conduce",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7708,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5650164",
          "text": "Questa strada conduce al lago.",
          "translation": "Эта дорога ведёт к озеру.",
          "source": "Tatoeba #5650164 @dnnywld / #5648933 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650164",
          "cefr_level": "A1",
          "word_slugs": [
            "conduce-verb"
          ]
        },
        {
          "id": "6034756",
          "text": "L'acqua conduce l'elettricità.",
          "translation": "Вода проводит электричество.",
          "source": "Tatoeba #6034756 @Guybrush88 / #5258697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6034756",
          "cefr_level": "A1",
          "word_slugs": [
            "conduce-verb"
          ]
        },
        {
          "id": "5923280",
          "text": "Il direttore conduce l'orchestra.",
          "translation": "Дирижёр руководит оркестром.",
          "source": "Tatoeba #5923280 @dnnywld / #5829390 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5923280",
          "cefr_level": "A1",
          "word_slugs": [
            "conduce-verb"
          ]
        },
        {
          "id": "6444254",
          "text": "L'invidia conduce alla sofferenza.",
          "translation": "Зависть ведёт к страданию.",
          "source": "Tatoeba #6444254 @dnnywld / #6443834 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6444254",
          "cefr_level": "A1",
          "word_slugs": [
            "conduce-verb"
          ]
        },
        {
          "id": "2577380",
          "text": "Il rame conduce bene l'elettricità.",
          "translation": "Медь хорошо проводит электричество.",
          "source": "Tatoeba #2577380 @Guybrush88 / #4951980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2577380",
          "cefr_level": "A1",
          "word_slugs": [
            "conduce-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
