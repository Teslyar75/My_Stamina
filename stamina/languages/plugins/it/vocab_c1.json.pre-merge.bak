    {
      "slug": "mucca-noun",
      "lemma": "mucca",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5522,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "корова"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4538446",
          "text": "La mucca muggisce.",
          "translation": "Корова мычит.",
          "source": "Tatoeba #4538446 @Guybrush88 / #4539150 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538446",
          "cefr_level": "A1",
          "word_slugs": [
            "mucca-noun"
          ]
        },
        {
          "id": "5416902",
          "text": "Quanti denti ha la mucca?",
          "translation": "Сколько зубов у коровы?",
          "source": "Tatoeba #5416902 @dnnywld / #5416820 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5416902",
          "cefr_level": "A1",
          "word_slugs": [
            "mucca-noun"
          ]
        },
        {
          "id": "5671313",
          "text": "Mucca nera fa latte bianco.",
          "translation": "Черна корова, да бело молоко.",
          "source": "Tatoeba #5671313 @dnnywld / #5670269 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5671313",
          "cefr_level": "A1",
          "word_slugs": [
            "mucca-noun"
          ]
        },
        {
          "id": "5704057",
          "text": "È una mucca o un bufalo?",
          "translation": "Это корова или буйвол?",
          "source": "Tatoeba #5704057 @Guybrush88 / #10899433 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5704057",
          "cefr_level": "A1",
          "word_slugs": [
            "mucca-noun"
          ]
        },
        {
          "id": "6878999",
          "text": "È latte di capra o di mucca?",
          "translation": "Это козье молоко или коровье?",
          "source": "Tatoeba #6878999 @dnnywld / #6878580 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6878999",
          "cefr_level": "A1",
          "word_slugs": [
            "mucca-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la mucca",
        "plural": "",
