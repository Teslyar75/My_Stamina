    {
      "slug": "panni-noun",
      "lemma": "panni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6506,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "666634",
          "text": "Non vorrei essere nei suoi panni.",
          "translation": "Не хотел бы я оказаться в его шкуре.",
          "source": "Tatoeba #666634 @Guybrush88 / #3576830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/666634",
          "cefr_level": "A1",
          "word_slugs": [
            "panni-noun"
          ]
        },
        {
          "id": "11502834",
          "text": "Non voglio essere nei suoi panni.",
          "translation": "Не хотел бы я оказаться в его шкуре.",
          "source": "Tatoeba #11502834 @Bernie75 / #3576830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11502834",
          "cefr_level": "A1",
          "word_slugs": [
            "panni-noun"
          ]
        },
        {
          "id": "1586308",
          "text": "I panni sporchi si lavano in famiglia.",
          "translation": "Сор из избы не выносят.",
          "source": "Tatoeba #1586308 @Guybrush88 / #3192325 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1586308",
          "cefr_level": "A1",
          "word_slugs": [
            "panni-noun"
          ]
        },
        {
          "id": "5586980",
          "text": "Cosa fareste se vi trovaste nei miei panni?",
          "translation": "Что бы вы сделали, окажись вы в моей шкуре?",
          "source": "Tatoeba #5586980 @dnnywld / #5586838 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586980",
          "cefr_level": "A1",
          "word_slugs": [
            "panni-noun"
          ]
        },
        {
          "id": "5586981",
          "text": "Cosa faresti se ti trovassi nei miei panni?",
          "translation": "Что бы ты сделал, окажись ты в моей шкуре?",
          "source": "Tatoeba #5586981 @dnnywld / #5586837 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586981",
          "cefr_level": "A1",
          "word_slugs": [
            "panni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il panni",
        "plural": "",
        "infinitive": ""
      }
