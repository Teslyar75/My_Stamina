    {
      "slug": "pietro-name",
      "lemma": "Pietro",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7978,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3605781",
          "text": "Mi chiamo Pietro.",
          "translation": "Меня зовут Пётр.",
          "source": "Tatoeba #3605781 @masaragiovanni / #3691295 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3605781",
          "cefr_level": "A1",
          "word_slugs": [
            "pietro-name"
          ]
        },
        {
          "id": "3221696",
          "text": "Pietro non parla russo.",
          "translation": "Пётр не говорит по-русски.",
          "source": "Tatoeba #3221696 @Selena777 / #3228613 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3221696",
          "cefr_level": "A1",
          "word_slugs": [
            "pietro-name"
          ]
        },
        {
          "id": "3585775",
          "text": "Il gatto di Pietro mangia.",
          "translation": "Кот Петра ест.",
          "source": "Tatoeba #3585775 @Guybrush88 / #3585890 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3585775",
          "cefr_level": "A1",
          "word_slugs": [
            "pietro-name"
          ]
        },
        {
          "id": "3221235",
          "text": "Quella macchina è di Pietro.",
          "translation": "Та машина принадлежит Петру.",
          "source": "Tatoeba #3221235 @Selena777 / #3228657 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3221235",
          "cefr_level": "A1",
          "word_slugs": [
            "pietro-name"
          ]
        },
        {
          "id": "3221695",
          "text": "Pietro non capisce il russo.",
          "translation": "Пётр не понимает по-русски.",
          "source": "Tatoeba #3221695 @Selena777 / #3228610 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3221695",
          "cefr_level": "A1",
          "word_slugs": [
            "pietro-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il Pietro",
