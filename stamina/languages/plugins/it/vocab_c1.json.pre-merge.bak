    {
      "slug": "suonato-adj",
      "lemma": "suonato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6004,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10875675",
          "text": "È suonato l'inno.",
          "translation": "Заиграл гимн.",
          "source": "Tatoeba #10875675 @dnnywld / #7934380 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10875675",
          "cefr_level": "A1",
          "word_slugs": [
            "suonato-adj"
          ]
        },
        {
          "id": "4404282",
          "text": "Lei ha suonato una sonata.",
          "translation": "Она сыграла сонату.",
          "source": "Tatoeba #4404282 @Guybrush88 / #1536032 @Anne_Paen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4404282",
          "cefr_level": "A1",
          "word_slugs": [
            "suonato-adj"
          ]
        },
        {
          "id": "10875676",
          "text": "È suonato l'inno nazionale.",
          "translation": "Прозвучал государственный гимн.",
          "source": "Tatoeba #10875676 @dnnywld / #7926100 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10875676",
          "cefr_level": "A1",
          "word_slugs": [
            "suonato-adj"
          ]
        },
        {
          "id": "5562873",
          "text": "Qualcuno ha suonato alla porta.",
          "translation": "Кто-то позвонил в дверь.",
          "source": "Tatoeba #5562873 @dnnywld / #5561870 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5562873",
          "cefr_level": "A1",
          "word_slugs": [
            "suonato-adj"
          ]
        },
        {
          "id": "5614549",
          "text": "Stavo giusto uscendo quando è suonato il telefono.",
          "translation": "Я как раз выходил, когда зазвонил телефон.",
          "source": "Tatoeba #5614549 @dnnywld / #4951594 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614549",
          "cefr_level": "A1",
          "word_slugs": [
            "suonato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
