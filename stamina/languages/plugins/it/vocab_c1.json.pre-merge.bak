    {
      "slug": "curato-adj",
      "lemma": "curato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6684,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10868338",
          "text": "Mi hanno curato.",
          "translation": "Меня вылечили.",
          "source": "Tatoeba #10868338 @dnnywld / #5927487 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10868338",
          "cefr_level": "A1",
          "word_slugs": [
            "curato-adj"
          ]
        },
        {
          "id": "1246365",
          "text": "Ha curato la mia malattia.",
          "translation": "Он излечил мою болезнь.",
          "source": "Tatoeba #1246365 @Guybrush88 / #1525497 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246365",
          "cefr_level": "A1",
          "word_slugs": [
            "curato-adj"
          ]
        },
        {
          "id": "5530189",
          "text": "Il paziente va curato elettricamente.",
          "translation": "Пациента придётся лечить электричеством.",
