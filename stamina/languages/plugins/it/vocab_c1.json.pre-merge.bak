    {
      "slug": "palude-noun",
      "lemma": "palude",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7835,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10854347",
          "text": "La palude gorgoglia.",
          "translation": "Болото булькает.",
          "source": "Tatoeba #10854347 @dnnywld / #5367746 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854347",
          "cefr_level": "A1",
          "word_slugs": [
            "palude-noun"
          ]
        },
        {
          "id": "2445689",
          "text": "Si prevede che il grattacielo affondi nella palude.",
          "translation": "Ожидается, что небоскрёб будет погружаться в болото.",
          "source": "Tatoeba #2445689 @al_ex_an_der / #2445694 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2445689",
          "cefr_level": "A1",
          "word_slugs": [
            "palude-noun"
          ]
        },
        {
          "id": "5897362",
          "text": "Il cadavere di Tom è stato trovato in una palude.",
          "translation": "Труп Тома был найден в болоте.",
          "source": "Tatoeba #5897362 @dnnywld / #5897175 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5897362",
          "cefr_level": "A1",
          "word_slugs": [
            "palude-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
