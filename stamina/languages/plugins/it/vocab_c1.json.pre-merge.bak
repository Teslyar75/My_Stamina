    {
      "slug": "approccio-noun",
      "lemma": "approccio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6955,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5525393",
          "text": "Mi piace il tuo approccio agli affari.",
          "translation": "Мне нравится твой подход к делу.",
          "source": "Tatoeba #5525393 @dnnywld / #5523844 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5525393",
          "cefr_level": "A1",
          "word_slugs": [
            "approccio-noun"
          ]
        },
        {
          "id": "10873248",
          "text": "Qui c'è bisogno di un approccio sensato.",
          "translation": "Тут нужен здравый подход.",
          "source": "Tatoeba #10873248 @dnnywld / #10871703 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10873248",
          "cefr_level": "A1",
          "word_slugs": [
            "approccio-noun"
          ]
        },
        {
          "id": "10873247",
          "text": "Qui c'è bisogno di un approccio particolare.",
          "translation": "Тут нужен особый подход.",
          "source": "Tatoeba #10873247 @dnnywld / #10871705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10873247",
          "cefr_level": "A1",
          "word_slugs": [
            "approccio-noun"
          ]
        },
        {
          "id": "5868577",
          "text": "Tom non riesce a decidere quale approccio prendere.",
          "translation": "Том не может определиться, какой подход применить.",
          "source": "Tatoeba #5868577 @dnnywld / #5783797 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868577",
          "cefr_level": "A1",
          "word_slugs": [
            "approccio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
