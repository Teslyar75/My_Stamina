    {
      "slug": "mario-name",
      "lemma": "Mario",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5015,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4727258",
          "text": "Mario comprò un microscopio.",
          "translation": "Марио купил микроскоп.",
          "source": "Tatoeba #4727258 @Guybrush88 / #4435063 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4727258",
          "cefr_level": "A1",
          "word_slugs": [
            "mario-name"
          ]
        },
        {
          "id": "6609050",
          "text": "Mario e Luigi sono fratelli.",
          "translation": "Марио и Луиджи — братья.",
          "source": "Tatoeba #6609050 @dnnywld / #4975593 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6609050",
          "cefr_level": "A1",
          "word_slugs": [
            "mario-name"
          ]
        },
        {
          "id": "4727257",
          "text": "Mario ha comprato un microscopio.",
          "translation": "Марио купил микроскоп.",
          "source": "Tatoeba #4727257 @Guybrush88 / #4435063 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4727257",
          "cefr_level": "A1",
          "word_slugs": [
            "mario-name"
          ]
        },
        {
          "id": "5660257",
          "text": "Mario parla fluentemente l'inglese.",
          "translation": "Марио свободно говорит на английском.",
          "source": "Tatoeba #5660257 @dnnywld / #5659307 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5660257",
          "cefr_level": "A1",
          "word_slugs": [
            "mario-name"
          ]
        },
        {
          "id": "1308294",
          "text": "Mario finirà di studiare quest'anno?",
          "translation": "Марио закончит учёбу в этом году?",
          "source": "Tatoeba #1308294 @Guybrush88 / #3090465 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1308294",
          "cefr_level": "A1",
          "word_slugs": [
            "mario-name"
          ]
        }
      ],
