          "id": "5415190",
          "text": "Cosa state vendendo?",
          "translation": "Что Вы продаёте?",
          "source": "Tatoeba #5415190 @Guybrush88 / #1366129 @kotoenok15 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415190",
          "cefr_level": "A1",
          "word_slugs": [
            "vendendo-verb"
          ]
        },
        {
          "id": "6018674",
          "text": "A chi stai vendendo la tua automobile?",
          "translation": "Кому ты продаёшь свой автомобиль?",
          "source": "Tatoeba #6018674 @dnnywld / #6017862 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6018674",
          "cefr_level": "A1",
          "word_slugs": [
            "vendendo-verb"
          ]
        },
        {
          "id": "6018675",
          "text": "A chi state vendendo la vostra automobile?",
          "translation": "Кому вы продаёте свой автомобиль?",
