    {
      "slug": "assegnato-adj",
      "lemma": "assegnato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5485,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5974819",
          "text": "Mi hanno assegnato una medaglia.",
          "translation": "Мне вручили медаль.",
          "source": "Tatoeba #5974819 @dnnywld / #5974489 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5974819",
          "cefr_level": "A1",
          "word_slugs": [
            "assegnato-adj"
          ]
        },
        {
          "id": "5728148",
          "text": "Mi hanno assegnato molti compiti.",
          "translation": "Мне задали много уроков.",
          "source": "Tatoeba #5728148 @dnnywld / #3319009 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5728148",
          "cefr_level": "A1",
          "word_slugs": [
            "assegnato-adj"
          ]
        },
        {
          "id": "10851530",
          "text": "L'arbitro ha assegnato un calcio di rigore.",
          "translation": "Арбитр назначил пенальти.",
          "source": "Tatoeba #10851530 @dnnywld / #6996762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851530",
          "cefr_level": "A1",
          "word_slugs": [
            "assegnato-adj"
          ]
        },
        {
          "id": "5648500",
          "text": "L'insegnante mi ha assegnato un lungo capitolo.",
          "translation": "Учитель дал мне самую длинную главу.",
          "source": "Tatoeba #5648500 @dnnywld / #570873 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5648500",
          "cefr_level": "A1",
          "word_slugs": [
            "assegnato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
