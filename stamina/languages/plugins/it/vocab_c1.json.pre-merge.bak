    {
      "slug": "perderemo-verb",
      "lemma": "perderemo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7026,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6891162",
          "text": "Ho paura che perderemo.",
          "translation": "Боюсь, мы проиграем.",
          "source": "Tatoeba #6891162 @dnnywld / #3571313 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891162",
          "cefr_level": "A1",
          "word_slugs": [
            "perderemo-verb"
          ]
        },
        {
          "id": "6361907",
          "text": "Spero che non si perderemo.",
          "translation": "Надеюсь, мы не заблудимся.",
          "source": "Tatoeba #6361907 @dnnywld / #6361193 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361907",
          "cefr_level": "A1",
          "word_slugs": [
            "perderemo-verb"
          ]
        },
        {
          "id": "6841375",
          "text": "Lei teme che noi ci perderemo.",
          "translation": "Она боится, что мы потеряемся.",
          "source": "Tatoeba #6841375 @dnnywld / #5165561 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841375",
          "cefr_level": "A1",
          "word_slugs": [
            "perderemo-verb"
          ]
        },
        {
          "id": "6881551",
          "text": "Non perderemo più tempo l'uno con l'altro.",
          "translation": "Не будем больше тратить время друг друга!",
          "source": "Tatoeba #6881551 @dnnywld / #5143807 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881551",
          "cefr_level": "A1",
          "word_slugs": [
            "perderemo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "perderemo",
        "plural": "",
        "infinitive": "perderemo"
      }
    },
