    {
      "slug": "impiego-noun",
      "lemma": "impiego",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9241,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3371061",
          "text": "Mio padre ha un buon impiego.",
          "translation": "У моего отца хорошая работа.",
          "source": "Tatoeba #3371061 @Guybrush88 / #3371055 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3371061",
          "cefr_level": "A1",
          "word_slugs": [
            "impiego-noun"
          ]
        },
        {
          "id": "1417962",
          "text": "Per fare la doccia impiego più tempo!",
          "translation": "Чтобы принять душ, мне требуется больше времени!",
          "source": "Tatoeba #1417962 @Guybrush88 / #3664114 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1417962",
          "cefr_level": "A1",
          "word_slugs": [
            "impiego-noun"
          ]
        },
        {
          "id": "4397705",
          "text": "Tutti i miei fratelli hanno un impiego.",
          "translation": "У всех моих братьев есть работа.",
          "source": "Tatoeba #4397705 @Guybrush88 / #6027396 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4397705",
          "cefr_level": "A1",
          "word_slugs": [
            "impiego-noun"
          ]
        },
        {
          "id": "3139224",
          "text": "Milioni di operai hanno perso il loro impiego.",
          "translation": "Миллионы рабочих потеряли свои рабочие места.",
          "source": "Tatoeba #3139224 @Guybrush88 / #6556448 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3139224",
          "cefr_level": "A1",
          "word_slugs": [
            "impiego-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "impiego",
        "plural": "",
        "infinitive": ""
      }
