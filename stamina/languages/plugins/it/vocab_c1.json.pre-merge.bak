    {
      "slug": "tessuto-adj",
      "lemma": "tessuto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5021,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5559823",
          "text": "Il cotone è un tessuto naturale.",
          "translation": "Хлопок — натуральная ткань.",
          "source": "Tatoeba #5559823 @dnnywld / #5559783 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5559823",
          "cefr_level": "A1",
          "word_slugs": [
            "tessuto-adj"
          ]
        },
        {
          "id": "497670",
          "text": "Queste mutande sono fatte di tessuto robusto.",
          "translation": "Эти трусы сделаны из прочной ткани.",
          "source": "Tatoeba #497670 @giok / #468059 @timsa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/497670",
          "cefr_level": "A1",
          "word_slugs": [
            "tessuto-adj"
          ]
        },
        {
          "id": "6770367",
          "text": "Il tessuto in seta era sottile come una ragnatela.",
          "translation": "Шёлковая ткань была тонкой, как паутина.",
          "source": "Tatoeba #6770367 @dnnywld / #6769056 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770367",
          "cefr_level": "A1",
          "word_slugs": [
            "tessuto-adj"
          ]
        },
        {
          "id": "895281",
          "text": "Perché hai strappato il tessuto, invece di tagliarlo con le forbici?",
          "translation": "Почему ты разорвал ткань, а не разрезал ее ножницами?",
          "source": "Tatoeba #895281 @riccioberto / #721141 @JeNNeR (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/895281",
          "cefr_level": "A1",
          "word_slugs": [
            "tessuto-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tessuto",
        "plural": "",
        "infinitive": ""
      }
