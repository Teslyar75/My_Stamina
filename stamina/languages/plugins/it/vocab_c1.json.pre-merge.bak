    {
      "slug": "mucche-noun",
      "lemma": "mucche",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8570,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "379738",
          "text": "Ha dieci mucche.",
          "translation": "У него десять коров.",
          "source": "Tatoeba #379738 @Pharamp / #2730816 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379738",
          "cefr_level": "A1",
          "word_slugs": [
            "mucche-noun"
          ]
        },
        {
          "id": "5433975",
          "text": "Tom ha tre mucche.",
          "translation": "У Тома три коровы.",
          "source": "Tatoeba #5433975 @dnnywld / #5433940 @sikmir (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433975",
          "cefr_level": "A1",
          "word_slugs": [
            "mucche-noun"
          ]
        },
        {
          "id": "7275415",
          "text": "A Sami piacciono le mucche.",
          "translation": "Сами любит коров.",
          "source": "Tatoeba #7275415 @dnnywld / #7275286 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275415",
          "cefr_level": "A1",
          "word_slugs": [
            "mucche-noun"
          ]
        },
        {
          "id": "2578713",
          "text": "Le mucche producono il latte.",
          "translation": "Коровы дают молоко.",
          "source": "Tatoeba #2578713 @Guybrush88 / #644101 @ant_katcin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2578713",
          "cefr_level": "A1",
          "word_slugs": [
            "mucche-noun"
          ]
        },
        {
          "id": "5678557",
          "text": "Tom non sa mungere le mucche.",
          "translation": "Том не умеет доить корову.",
          "source": "Tatoeba #5678557 @dnnywld / #5678537 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5678557",
          "cefr_level": "A1",
          "word_slugs": [
            "mucche-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la mucche",
