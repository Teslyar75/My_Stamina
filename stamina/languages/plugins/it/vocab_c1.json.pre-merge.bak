    {
      "slug": "colonna-noun",
      "lemma": "colonna",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6361,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "колонна"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "10905172",
          "text": "La scoliosi è una curvatura della colonna vertebrale.",
          "translation": "Сколиоз - это искривление позвоночника.",
          "source": "Tatoeba #10905172 @dnnywld / #10903339 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10905172",
          "cefr_level": "A1",
          "word_slugs": [
            "colonna-noun"
          ]
        },
        {
          "id": "2263490",
          "text": "La colonna vertebrale è costituita da ventiquattro ossa.",
          "translation": "Позвоночник состоит из двадцати четырех костей.",
          "source": "Tatoeba #2263490 @al_ex_an_der / #2263492 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2263490",
          "cefr_level": "A1",
          "word_slugs": [
            "colonna-noun"
          ]
        },
        {
          "id": "5644171",
          "text": "La libertà di parola è la colonna portante della democrazia.",
          "translation": "Свобода слова - это краеугольный камень демократии.",
          "source": "Tatoeba #5644171 @dnnywld / #5643961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5644171",
          "cefr_level": "A1",
          "word_slugs": [
            "colonna-noun"
          ]
        },
        {
          "id": "5635278",
          "text": "Una colonna di motociclette si sta dirigendo lungo la strada.",
          "translation": "По дороге движется колонна мотоциклов.",
          "source": "Tatoeba #5635278 @dnnywld / #5634968 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635278",
          "cefr_level": "A1",
          "word_slugs": [
            "colonna-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la colonna",
        "plural": "",
        "infinitive": ""
      }
