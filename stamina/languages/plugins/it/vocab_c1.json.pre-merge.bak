    {
      "slug": "facciate-noun",
      "lemma": "facciate",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7946,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5498252",
          "text": "Voglio che facciate così.",
          "translation": "Я хочу, чтобы вы так сделали.",
          "source": "Tatoeba #5498252 @dnnywld / #5498101 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5498252",
          "cefr_level": "A1",
          "word_slugs": [
            "facciate-noun"
          ]
        },
        {
          "id": "5506813",
          "text": "Vogliamo che facciate questo.",
          "translation": "Мы хотим, чтобы вы это сделали.",
          "source": "Tatoeba #5506813 @dnnywld / #5506183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506813",
          "cefr_level": "A1",
          "word_slugs": [
            "facciate-noun"
          ]
        },
        {
          "id": "6623047",
          "text": "È meglio che lo facciate immediatamente.",
          "translation": "Вам лучше сделать это прямо сейчас.",
          "source": "Tatoeba #6623047 @dnnywld / #6622720 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6623047",
          "cefr_level": "A1",
          "word_slugs": [
            "facciate-noun"
          ]
        },
        {
          "id": "6906166",
          "text": "Ho bisogno che lo facciate immediatamente.",
          "translation": "Мне нужно, чтобы вы сделали это немедленно.",
          "source": "Tatoeba #6906166 @dnnywld / #6905730 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6906166",
          "cefr_level": "A1",
          "word_slugs": [
            "facciate-noun"
          ]
        },
        {
          "id": "6829960",
          "text": "È meglio che facciate un passo indietro.",
          "translation": "Лучше отойдите.",
          "source": "Tatoeba #6829960 @dnnywld / #6829677 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6829960",
          "cefr_level": "A1",
          "word_slugs": [
            "facciate-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
