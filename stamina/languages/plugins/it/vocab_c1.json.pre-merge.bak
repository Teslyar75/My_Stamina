    {
      "slug": "brave-adj",
      "lemma": "brave",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5547,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3852598",
          "text": "Voi siete brave in matematica?",
          "translation": "Вы сильны в математике?",
          "source": "Tatoeba #3852598 @Guybrush88 / #3852617 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3852598",
          "cefr_level": "A1",
          "word_slugs": [
            "brave-adj"
          ]
        },
        {
          "id": "10895243",
          "text": "Non tutte le brave persone prospereranno",
          "translation": "Не все хорошие люди будут благоденствовать.",
          "source": "Tatoeba #10895243 @dnnywld / #446930 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10895243",
          "cefr_level": "A1",
          "word_slugs": [
            "brave-adj"
          ]
        },
        {
          "id": "5968754",
          "text": "I miei genitori sono delle brave persone.",
          "translation": "Мои родители - хорошие люди.",
          "source": "Tatoeba #5968754 @dnnywld / #5967883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968754",
          "cefr_level": "A1",
          "word_slugs": [
            "brave-adj"
          ]
        },
        {
          "id": "5968760",
          "text": "I miei genitori erano delle brave persone.",
          "translation": "Мои родители были хорошими людьми.",
          "source": "Tatoeba #5968760 @dnnywld / #5967840 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968760",
          "cefr_level": "A1",
          "word_slugs": [
            "brave-adj"
          ]
        },
        {
          "id": "5968755",
          "text": "I miei genitori non erano delle brave persone.",
          "translation": "Мои родители не были хорошими людьми.",
          "source": "Tatoeba #5968755 @dnnywld / #5967884 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968755",
          "cefr_level": "A1",
          "word_slugs": [
            "brave-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
