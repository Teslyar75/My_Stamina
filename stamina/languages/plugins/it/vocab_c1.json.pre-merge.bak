    {
      "slug": "bianche-adj",
      "lemma": "bianche",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6482,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2430142",
          "text": "Le pareti sono bianche.",
          "translation": "Стены белые.",
          "source": "Tatoeba #2430142 @al_ex_an_der / #2430144 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430142",
          "cefr_level": "A1",
          "word_slugs": [
            "bianche-adj"
          ]
        },
        {
          "id": "5030427",
          "text": "Le termiti sono a volte chiamate formiche bianche.",
          "translation": "Термитов иногда называют белыми муравьями.",
          "source": "Tatoeba #5030427 @Guybrush88 / #5030443 @Imperia (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5030427",
          "cefr_level": "A1",
          "word_slugs": [
            "bianche-adj"
          ]
        },
        {
          "id": "6163750",
          "text": "Mi piacciono più le rose bianche di quelle rosse.",
          "translation": "Белые розы мне нравятся больше, чем красные.",
          "source": "Tatoeba #6163750 @dnnywld / #6163239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6163750",
          "cefr_level": "A1",
          "word_slugs": [
            "bianche-adj"
          ]
        },
        {
          "id": "6964949",
          "text": "Tom di solito porta delle scarpe da tennis bianche.",
          "translation": "Том обычно ходит в белых кроссовках.",
          "source": "Tatoeba #6964949 @dnnywld / #6964527 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6964949",
          "cefr_level": "A1",
          "word_slugs": [
            "bianche-adj"
          ]
        },
        {
          "id": "6964947",
          "text": "Tom cammina abitualmente che delle scarpe da tennis bianche.",
          "translation": "Том обычно ходит в белых кроссовках.",
          "source": "Tatoeba #6964947 @dnnywld / #6964527 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6964947",
          "cefr_level": "A1",
          "word_slugs": [
            "bianche-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il bianche",
