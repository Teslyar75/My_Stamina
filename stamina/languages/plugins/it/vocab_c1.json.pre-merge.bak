          "cefr_level": "A1",
          "word_slugs": [
            "elefante-noun"
          ]
        },
        {
          "id": "11554007",
          "text": "L'elefante è grande.",
          "translation": "Слон большой.",
          "source": "Tatoeba #11554007 @megamanenm / #11554002 @megamanenm (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11554007",
          "cefr_level": "A1",
          "word_slugs": [
            "elefante-noun"
          ]
        },
        {
          "id": "4573671",
          "text": "L'elefante beve dell'acqua.",
          "translation": "Слон пьёт воду.",
          "source": "Tatoeba #4573671 @Guybrush88 / #4578194 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4573671",
          "cefr_level": "A1",
          "word_slugs": [
            "elefante-noun"
          ]
        }
