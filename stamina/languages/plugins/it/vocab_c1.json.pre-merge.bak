      "cefr_level": "C1",
      "frequency_rank": 5041,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5555337",
          "text": "Suggerisco di affrettarci.",
          "translation": "Предлагаю нам поторопиться.",
          "source": "Tatoeba #5555337 @dnnywld / #5555148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5555337",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerisco-verb"
          ]
        },
        {
          "id": "6793781",
          "text": "Ti suggerisco di studiare.",
          "translation": "Я советую тебе поучиться.",
          "source": "Tatoeba #6793781 @Guybrush88 / #6793879 @Annushka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6793781",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerisco-verb"
          ]
        },
        {
          "id": "7275394",
          "text": "Vi suggerisco di tenervelo.",
          "translation": "Предлагаю вам оставить это себе.",
          "source": "Tatoeba #7275394 @dnnywld / #7275305 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275394",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerisco-verb"
          ]
        },
        {
          "id": "7275396",
          "text": "Ti suggerisco di tenertelo.",
          "translation": "Предлагаю тебе оставить это себе.",
          "source": "Tatoeba #7275396 @dnnywld / #7275304 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275396",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerisco-verb"
          ]
        },
        {
          "id": "5544934",
          "text": "Vi suggerisco di nascondervi.",
          "translation": "Предлагаю вам спрятаться.",
          "source": "Tatoeba #5544934 @dnnywld / #5543690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5544934",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerisco-verb"
          ]
        }
      ],
      "tags": [
