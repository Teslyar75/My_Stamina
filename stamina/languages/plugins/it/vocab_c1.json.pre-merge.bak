      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6764569",
          "text": "Desiderate ancora rischiare?",
          "translation": "Всё ещё желаете рискнуть?",
          "source": "Tatoeba #6764569 @dnnywld / #6764538 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6764569",
          "cefr_level": "A1",
          "word_slugs": [
            "desiderate-adj"
          ]
        },
        {
          "id": "7145433",
          "text": "Cosa desiderate per pranzo?",
          "translation": "Что вы хотите на обед?",
          "source": "Tatoeba #7145433 @dnnywld / #4589656 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7145433",
          "cefr_level": "A1",
          "word_slugs": [
            "desiderate-adj"
          ]
        },
        {
          "id": "5547610",
          "text": "Desiderate lasciare un messaggio?",
