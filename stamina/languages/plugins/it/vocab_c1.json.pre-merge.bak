    {
      "slug": "fienile-noun",
      "lemma": "fienile",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8092,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6873650",
          "text": "Tom dormiva nel fienile.",
          "translation": "Том спал на сеновале.",
          "source": "Tatoeba #6873650 @dnnywld / #6872616 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6873650",
          "cefr_level": "A1",
          "word_slugs": [
