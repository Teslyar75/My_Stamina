      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5394009",
          "text": "Riferirete tutto correttamente?",
          "translation": "Вы сообщите всё правдиво?",
          "source": "Tatoeba #5394009 @dnnywld / #1590020 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5394009",
          "cefr_level": "A1",
          "word_slugs": [
            "correttamente-adv"
          ]
        },
        {
          "id": "5523163",
          "text": "Tom fa questo correttamente.",
          "translation": "Том делает это правильно.",
          "source": "Tatoeba #5523163 @dnnywld / #5523146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5523163",
          "cefr_level": "A1",
