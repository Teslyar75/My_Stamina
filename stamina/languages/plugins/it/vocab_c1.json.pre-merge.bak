    {
      "slug": "dipingere-verb",
      "lemma": "dipingere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6901,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10849765",
          "text": "Adoro dipingere con gli acquarelli.",
          "translation": "Обожаю рисовать акварелью.",
          "source": "Tatoeba #10849765 @dnnywld / #6391605 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849765",
          "cefr_level": "A1",
          "word_slugs": [
            "dipingere-verb"
          ]
        },
        {
          "id": "5965937",
          "text": "Ho appena finito di dipingere casa.",
          "translation": "Я только что докрасил дом.",
          "source": "Tatoeba #5965937 @dnnywld / #5965607 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5965937",
          "cefr_level": "A1",
          "word_slugs": [
            "dipingere-verb"
          ]
        },
        {
          "id": "5828107",
          "text": "Quanto prendete per dipingere la casa?",
          "translation": "Сколько вы берёте за покраску дома?",
          "source": "Tatoeba #5828107 @dnnywld / #2912668 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5828107",
          "cefr_level": "A1",
          "word_slugs": [
            "dipingere-verb"
          ]
        },
        {
          "id": "5557931",
          "text": "È divertente dipingere le uova di Pasqua.",
          "translation": "Красить яйца на Пасху - весело.",
          "source": "Tatoeba #5557931 @dnnywld / #5557323 @clayrat (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5557931",
          "cefr_level": "A1",
          "word_slugs": [
            "dipingere-verb"
          ]
        },
        {
          "id": "7327012",
          "text": "Mi hanno aiutato a dipingere la recinzione.",
          "translation": "Мне помогли покрасить забор.",
          "source": "Tatoeba #7327012 @dnnywld / #7326114 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7327012",
          "cefr_level": "A1",
          "word_slugs": [
            "dipingere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "dipingere",
        "plural": "",
        "infinitive": "dipingere"
      }
    },
    {
      "slug": "potuta-verb",
      "lemma": "potuta",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6902,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5402249",
          "text": "Lei non è potuta venire perché era ammalata.",
          "translation": "Она не смогла прийти, потому что была больна.",
          "source": "Tatoeba #5402249 @dnnywld / #4310544 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5402249",
          "cefr_level": "A1",
          "word_slugs": [
            "potuta-verb"
          ]
        },
        {
          "id": "5481835",
          "text": "Ero malata, perciò non sono potuta venire da te.",
          "translation": "Я была больна, поэтому не смогла к тебе прийти.",
          "source": "Tatoeba #5481835 @dnnywld / #2417203 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5481835",
          "cefr_level": "A1",
          "word_slugs": [
            "potuta-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "potuta",
        "plural": "",
        "infinitive": "potuta"
      }
    },
    {
      "slug": "impari-adj",
      "lemma": "impari",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6903,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2480415",
          "text": "Impari l'uiguro!",
          "translation": "Учите уйгурский!",
          "source": "Tatoeba #2480415 @Guybrush88 / #1186785 @Imp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2480415",
          "cefr_level": "A1",
          "word_slugs": [
            "impari-adj"
          ]
        },
        {
          "id": "7321108",
          "text": "Perché impari una lingua straniera?",
          "translation": "Почему ты учишь иностранный язык?",
          "source": "Tatoeba #7321108 @Valdast / #7320800 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7321108",
          "cefr_level": "A1",
          "word_slugs": [
            "impari-adj"
          ]
        },
        {
          "id": "5686968",
          "text": "Più diligentemente tu studi, più impari.",
          "translation": "Чем прилежнее ты учишься, тем больше ты узнаёшь.",
          "source": "Tatoeba #5686968 @dnnywld / #2623232 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686968",
          "cefr_level": "A1",
          "word_slugs": [
            "impari-adj"
          ]
        },
        {
          "id": "5671085",
          "text": "Non è necessario che impari tutto a memoria.",
          "translation": "Тебе необязательно учить всё наизусть.",
          "source": "Tatoeba #5671085 @dnnywld / #5670337 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5671085",
          "cefr_level": "A1",
          "word_slugs": [
            "impari-adj"
          ]
        },
        {
          "id": "5649445",
          "text": "Se impari andare in bicicletta, non lo disimparerai mai.",
          "translation": "Если ты умеешь ездить на велосипеде, то уже никогда не разучишься.",
          "source": "Tatoeba #5649445 @dnnywld / #5649224 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5649445",
          "cefr_level": "A1",
          "word_slugs": [
            "impari-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "impari",
        "plural": "",
        "infinitive": ""
      }
    },
