    {
      "slug": "costato-adj",
      "lemma": "costato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6309,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11378454",
          "text": "Deve essergli costato una fortuna.",
          "translation": "Это, должно быть, стоило ему целое состояние.",
          "source": "Tatoeba #11378454 @Bernie75 / #4332622 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11378454",
          "cefr_level": "A1",
          "word_slugs": [
            "costato-adj"
          ]
        },
        {
          "id": "383917",
          "text": "Questo lavoro è costato 100 dollari.",
          "translation": "Эта работа стоила 100 долларов.",
          "source": "Tatoeba #383917 @Pharamp / #573763 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/383917",
          "cefr_level": "A1",
          "word_slugs": [
            "costato-adj"
          ]
        },
        {
          "id": "3357280",
          "text": "Non avete detto quant'è costato.",
          "translation": "Вы не сказали, сколько это стоит.",
          "source": "Tatoeba #3357280 @Guybrush88 / #3507122 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3357280",
          "cefr_level": "A1",
          "word_slugs": [
            "costato-adj"
          ]
        },
        {
          "id": "6146487",
          "text": "Quanto è costato il tuo elicottero?",
          "translation": "Сколько стоил твой вертолёт?",
          "source": "Tatoeba #6146487 @dnnywld / #6145723 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6146487",
          "cefr_level": "A1",
          "word_slugs": [
            "costato-adj"
          ]
        },
        {
          "id": "6000634",
          "text": "Quanto vi è costato questo computer?",
          "translation": "Сколько вы заплатили за этот компьютер?",
          "source": "Tatoeba #6000634 @dnnywld / #5999994 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6000634",
          "cefr_level": "A1",
          "word_slugs": [
            "costato-adj"
          ]
        }
