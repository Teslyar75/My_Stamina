    {
      "slug": "fragile-adj",
      "lemma": "fragile",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7024,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7748501",
          "text": "Lui è molto fragile.",
          "translation": "Он очень хрупкий.",
          "source": "Tatoeba #7748501 @dnnywld / #7748371 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7748501",
          "cefr_level": "A1",
          "word_slugs": [
            "fragile-adj"
          ]
        },
        {
          "id": "5504159",
          "text": "La vita degli uomini è molto fragile.",
          "translation": "Человеческая жизнь очень хрупка.",
          "source": "Tatoeba #5504159 @dnnywld / #5503978 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504159",
          "cefr_level": "A1",
          "word_slugs": [
            "fragile-adj"
          ]
        },
        {
          "id": "10754272",
          "text": "Sembra che da piccolo lui fosse di fragile costituzione.",
          "translation": "В молодости он, кажется, был хилым.",
          "source": "Tatoeba #10754272 @dnnywld / #4632068 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754272",
          "cefr_level": "A1",
          "word_slugs": [
            "fragile-adj"
          ]
        },
        {
          "id": "6539243",
          "text": "Perché mai più una cosa è bella, più è fragile?",
          "translation": "Почему же чем вещь красивее, тем она более хрупкая?",
          "source": "Tatoeba #6539243 @dnnywld / #3349652 @dmishin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6539243",
          "cefr_level": "A1",
          "word_slugs": [
            "fragile-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il fragile",
        "plural": "",
        "infinitive": ""
      }
    },
    {
