    {
      "slug": "tirate-adj",
      "lemma": "tirate",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7253,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5677790",
          "text": "Tirate una linea qui.",
          "translation": "Нарисуйте здесь линию.",
          "source": "Tatoeba #5677790 @dnnywld / #5677444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677790",
          "cefr_level": "A1",
          "word_slugs": [
            "tirate-adj"
          ]
        },
        {
          "id": "5604288",
          "text": "Tirate su il coltello.",
          "translation": "Поднимите нож.",
          "source": "Tatoeba #5604288 @dnnywld / #5604254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5604288",
          "cefr_level": "A1",
          "word_slugs": [
            "tirate-adj"
          ]
        },
        {
          "id": "5479351",
          "text": "Tirate su la corda, per favore.",
          "translation": "Потяните за верёвку, пожалуйста.",
          "source": "Tatoeba #5479351 @dnnywld / #5479141 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479351",
          "cefr_level": "A1",
          "word_slugs": [
            "tirate-adj"
          ]
        },
        {
          "id": "6764579",
          "text": "Tirate fuori tutto dalle tasche, e mettete sul tavolo.",
          "translation": "Выкладывайте всё из карманов сюда, на стол.",
          "source": "Tatoeba #6764579 @dnnywld / #6764536 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6764579",
          "cefr_level": "A1",
          "word_slugs": [
            "tirate-adj"
          ]
        },
        {
          "id": "5530467",
          "text": "Tirate indietro il prepuzio prima di infilare il preservativo.",
          "translation": "Оттяните крайнюю плоть, перед тем как надевать презерватив.",
          "source": "Tatoeba #5530467 @dnnywld / #1533497 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5530467",
          "cefr_level": "A1",
          "word_slugs": [
            "tirate-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tirate",
        "plural": "",
        "infinitive": ""
      }
    },
