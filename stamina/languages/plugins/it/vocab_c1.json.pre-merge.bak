    {
      "slug": "guadagno-noun",
      "lemma": "guadagno",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5082,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "375090",
          "text": "Guadagno 100 euro al giorno.",
          "translation": "Я зарабатываю сто евро в день.",
          "source": "Tatoeba #375090 @kar1j / #5433 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/375090",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagno-noun"
          ]
        },
        {
          "id": "2515979",
          "text": "Purtroppo non guadagno soldi.",
          "translation": "К сожалению, я не зарабатываю на этом денег.",
          "source": "Tatoeba #2515979 @al_ex_an_der / #2515981 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2515979",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagno-noun"
          ]
        },
        {
          "id": "5399158",
          "text": "Nessun dolore, nessun guadagno.",
          "translation": "Без боли нет доли.",
          "source": "Tatoeba #5399158 @dnnywld / #1645074 @Hayabusa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5399158",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagno-noun"
          ]
        },
        {
          "id": "5389542",
          "text": "Guadagno cinque franchi al giorno.",
          "translation": "Я получаю пять франков в день.",
          "source": "Tatoeba #5389542 @dnnywld / #5389440 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389542",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagno-noun"
          ]
        },
        {
          "id": "2516017",
          "text": "Purtroppo non guadagno molto denaro.",
          "translation": "К сожалению, я не зарабатываю много денег.",
          "source": "Tatoeba #2516017 @al_ex_an_der / #2515998 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2516017",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagno-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il guadagno",
        "plural": "",
        "infinitive": ""
      }
