    {
      "slug": "centimetri-noun",
      "lemma": "centimetri",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5138,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5387744",
          "text": "Il mio è lungo 20 centimetri.",
          "translation": "У моего длина 20 сантиметров.",
          "source": "Tatoeba #5387744 @dnnywld / #5387274 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387744",
          "cefr_level": "A1",
          "word_slugs": [
            "centimetri-noun"
          ]
        },
        {
          "id": "5672402",
          "text": "Ha uno spessore di quattro centimetri.",
          "translation": "Она четыре сантиметра толщиной.",
          "source": "Tatoeba #5672402 @dnnywld / #5672124 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672402",
          "cefr_level": "A1",
          "word_slugs": [
            "centimetri-noun"
          ]
        },
        {
          "id": "7738091",
          "text": "Tom è venti centimetri più alto di Mary.",
          "translation": "Том на двадцать сантиметров выше Мэри.",
          "source": "Tatoeba #7738091 @dnnywld / #7731267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7738091",
          "cefr_level": "A1",
          "word_slugs": [
            "centimetri-noun"
          ]
        },
        {
          "id": "7738096",
          "text": "Tom è otto centimetri più basso di Mary.",
          "translation": "Том на восемь сантиметров ниже Мэри.",
          "source": "Tatoeba #7738096 @dnnywld / #7731257 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7738096",
          "cefr_level": "A1",
          "word_slugs": [
            "centimetri-noun"
          ]
        },
        {
          "id": "7738090",
          "text": "Sono circa otto centimetri più alto di Mary.",
          "translation": "Я сантиметров на восемь выше Тома.",
          "source": "Tatoeba #7738090 @dnnywld / #7731268 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7738090",
          "cefr_level": "A1",
          "word_slugs": [
            "centimetri-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
