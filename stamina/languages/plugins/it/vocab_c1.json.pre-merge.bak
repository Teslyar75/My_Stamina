    {
      "slug": "proviene-verb",
      "lemma": "proviene",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6017,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5653032",
          "text": "Tom proviene da una famiglia ricca.",
          "translation": "Том происходит из богатой семьи.",
          "source": "Tatoeba #5653032 @dnnywld / #5652904 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5653032",
          "cefr_level": "A1",
          "word_slugs": [
            "proviene-verb"
          ]
        },
        {
          "id": "5902160",
          "text": "Questo stivale fa schifo perché proviene dalla Cina.",
          "translation": "Этот ботинок дерьмовый, потому что он из Китая.",
          "source": "Tatoeba #5902160 @dnnywld / #5902112 @Smoky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5902160",
          "cefr_level": "A1",
          "word_slugs": [
            "proviene-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "proviene",
        "plural": "",
        "infinitive": "proviene"
      }
    },
    {
      "slug": "favola-noun",
      "lemma": "favola",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6018,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5394177",
          "text": "Raccontami una favola.",
          "translation": "Расскажи мне сказку.",
          "source": "Tatoeba #5394177 @dnnywld / #4862306 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5394177",
          "cefr_level": "A1",
          "word_slugs": [
            "favola-noun"
          ]
        },
        {
          "id": "11396095",
          "text": "Era come una favola.",
          "translation": "Это было похоже на сказку.",
          "source": "Tatoeba #11396095 @Bernie75 / #4546061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11396095",
          "cefr_level": "A1",
          "word_slugs": [
            "favola-noun"
          ]
        },
        {
          "id": "11446046",
          "text": "Raccontami una favola della buonanotte.",
          "translation": "Расскажи мне сказку на ночь.",
          "source": "Tatoeba #11446046 @Bernie75 / #3683290 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11446046",
          "cefr_level": "A1",
          "word_slugs": [
            "favola-noun"
          ]
        },
        {
          "id": "3516843",
          "text": "Qual è la morale di questa favola?",
          "translation": "В чём мораль этой басни?",
          "source": "Tatoeba #3516843 @Guybrush88 / #6734430 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3516843",
          "cefr_level": "A1",
          "word_slugs": [
            "favola-noun"
          ]
        },
        {
          "id": "5536052",
          "text": "Talvolta sento male. Hai detto \"Si, come una favola\" oppure \"Nel Caucaso?\"",
          "translation": "Иногда я плохо слышу. Ты сказала \"Да, как в сказке\" или \"На Кавказе\"?",
          "source": "Tatoeba #5536052 @dnnywld / #2313515 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5536052",
          "cefr_level": "A1",
          "word_slugs": [
            "favola-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la favola",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "torte-adj",
      "lemma": "torte",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6019,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6323050",
          "text": "Preferisco le torte col cavolo.",
          "translation": "Я больше люблю пироги с капустой.",
          "source": "Tatoeba #6323050 @dnnywld / #6322969 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6323050",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-adj"
          ]
        },
        {
          "id": "5524668",
          "text": "Loro preparano delle buone torte.",
          "translation": "Они делают хорошие торты.",
          "source": "Tatoeba #5524668 @dnnywld / #5524411 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5524668",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-adj"
          ]
        },
        {
          "id": "5479815",
          "text": "Chi ha mangiato tutte le torte?",
          "translation": "Кто съел все пироги?",
          "source": "Tatoeba #5479815 @dnnywld / #5479764 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479815",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-adj"
          ]
        },
        {
          "id": "6323051",
          "text": "Mi piacciono le torte col cavolo.",
          "translation": "Я люблю пироги с капустой.",
          "source": "Tatoeba #6323051 @dnnywld / #6322968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6323051",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-adj"
          ]
        },
        {
          "id": "6866504",
          "text": "Lei ha cotto in forno tre torte.",
          "translation": "Она испекла три кекса.",
          "source": "Tatoeba #6866504 @dnnywld / #6865815 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866504",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-adj"
          ]
        }
