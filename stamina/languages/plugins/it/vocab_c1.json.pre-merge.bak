    {
      "slug": "fenomeno-noun",
      "lemma": "fenomeno",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6493,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1847636",
          "text": "Questo fenomeno è molto semplice di spiegare.",
          "translation": "Это явление очень легко объяснить.",
          "source": "Tatoeba #1847636 @al_ex_an_der / #1847647 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1847636",
          "cefr_level": "A1",
          "word_slugs": [
            "fenomeno-noun"
          ]
        },
        {
          "id": "4262186",
          "text": "Le piogge acide non sono un fenomeno meteorologico naturale.",
          "translation": "Кислотные дожди не являются естественным метеорологическим явлением.",
          "source": "Tatoeba #4262186 @bailujia / #4262208 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4262186",
          "cefr_level": "A1",
          "word_slugs": [
            "fenomeno-noun"
          ]
        },
        {
          "id": "1846945",
          "text": "Probabilmente ogni ricercatore svilupperà la sua teoria per spiegare questo fenomeno.",
          "translation": "Наверное, каждый исследователь будет развивать свою собственную теорию для объяснения этого явления.",
          "source": "Tatoeba #1846945 @al_ex_an_der / #1846897 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1846945",
          "cefr_level": "A1",
          "word_slugs": [
            "fenomeno-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il fenomeno",
        "plural": "",
        "infinitive": ""
      }
    },
