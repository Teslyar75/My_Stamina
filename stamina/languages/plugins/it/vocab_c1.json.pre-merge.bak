      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5621079",
          "text": "Sei tedesca, vero?",
          "translation": "Ты немка, правда?",
          "source": "Tatoeba #5621079 @dnnywld / #5621058 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5621079",
          "cefr_level": "A1",
          "word_slugs": [
            "tedesca-adj"
          ]
        },
        {
          "id": "2159929",
          "text": "Dov'è l'ambasciata tedesca?",
          "translation": "Где немецкое посольство?",
          "source": "Tatoeba #2159929 @Guybrush88 / #6583832 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2159929",
          "cefr_level": "A1",
          "word_slugs": [
            "tedesca-adj"
          ]
        },
        {
          "id": "5421873",
          "text": "Io guido una macchina tedesca.",
          "translation": "Я езжу на немецкой машине.",
          "source": "Tatoeba #5421873 @dnnywld / #2896393 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5421873",
          "cefr_level": "A1",
          "word_slugs": [
            "tedesca-adj"
          ]
        },
        {
          "id": "7065356",
          "text": "Amo moltissimo la lingua tedesca.",
          "translation": "Жутко люблю немецкий язык.",
          "source": "Tatoeba #7065356 @dnnywld / #7064399 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7065356",
          "cefr_level": "A1",
          "word_slugs": [
            "tedesca-adj"
          ]
        },
        {
          "id": "10762275",
          "text": "Questa parola deriva dalla lingua tedesca.",
          "translation": "Это слово происходит из немецкого языка.",
          "source": "Tatoeba #10762275 @dnnywld / #10162749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10762275",
          "cefr_level": "A1",
          "word_slugs": [
