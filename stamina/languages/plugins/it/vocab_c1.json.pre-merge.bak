      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5419437",
          "text": "Cosa comprende la colazione?",
          "translation": "Что включает завтрак?",
          "source": "Tatoeba #5419437 @dnnywld / #2044096 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419437",
          "cefr_level": "A1",
          "word_slugs": [
            "comprende-verb"
          ]
        },
        {
          "id": "5419438",
          "text": "Il prezzo comprende l'IVA.",
          "translation": "Цена включает НДС.",
          "source": "Tatoeba #5419438 @dnnywld / #3895287 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419438",
          "cefr_level": "A1",
          "word_slugs": [
