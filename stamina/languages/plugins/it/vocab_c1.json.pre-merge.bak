      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "нефть"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13474814",
          "text": "L'Algeria è ricca di petrolio.",
          "translation": "Алжир богат нефтью.",
          "source": "Tatoeba #13474814 @Guybrush88 / #7861247 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13474814",
          "cefr_level": "A1",
          "word_slugs": [
            "petrolio-noun"
          ]
        },
        {
          "id": "5452315",
          "text": "Gli USA sono ricchi di petrolio.",
          "translation": "США богаты нефтью.",
          "source": "Tatoeba #5452315 @dnnywld / #5452121 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452315",
          "cefr_level": "A1",
          "word_slugs": [
            "petrolio-noun"
          ]
        },
        {
          "id": "5512455",
          "text": "Il prezzo del petrolio sta crollando.",
          "translation": "Цена нефти падает.",
          "source": "Tatoeba #5512455 @dnnywld / #4856316 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512455",
          "cefr_level": "A1",
          "word_slugs": [
            "petrolio-noun"
          ]
        },
        {
          "id": "6363412",
          "text": "Il petrolio non si produce, si estrae.",
          "translation": "Нефть не производят, её выкачивают.",
          "source": "Tatoeba #6363412 @dnnywld / #6363366 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6363412",
          "cefr_level": "A1",
          "word_slugs": [
            "petrolio-noun"
          ]
        },
        {
          "id": "10846782",
          "text": "Il prezzo del petrolio continua a salire.",
          "translation": "Цена на нефть продолжает расти.",
          "source": "Tatoeba #10846782 @dnnywld / #10846637 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846782",
          "cefr_level": "A1",
          "word_slugs": [
            "petrolio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
