    {
      "slug": "azzardo-noun",
      "lemma": "azzardo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5659,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5653668",
          "text": "Ti piace il gioco d'azzardo?",
          "translation": "Ты любишь азартные игры?",
          "source": "Tatoeba #5653668 @dnnywld / #5653615 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5653668",
          "cefr_level": "A1",
          "word_slugs": [
            "azzardo-noun"
          ]
        },
        {
          "id": "5680909",
          "text": "Tom è un fan del gioco d'azzardo.",
          "translation": "Том — азартный болельщик.",
          "source": "Tatoeba #5680909 @dnnywld / #5680127 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5680909",
          "cefr_level": "A1",
          "word_slugs": [
            "azzardo-noun"
          ]
        },
        {
          "id": "3668593",
          "text": "Il gioco d'azzardo è legale in Nevada.",
          "translation": "В Неваде азартные игры разрешены.",
          "source": "Tatoeba #3668593 @Guybrush88 / #3668634 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3668593",
          "cefr_level": "A1",
          "word_slugs": [
            "azzardo-noun"
          ]
        },
        {
          "id": "5512239",
          "text": "Da allora ho giurato di non giocare più d'azzardo.",
          "translation": "С тех пор я зарёкся играть в азартные игры.",
          "source": "Tatoeba #5512239 @dnnywld / #4324865 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512239",
          "cefr_level": "A1",
          "word_slugs": [
            "azzardo-noun"
          ]
        },
        {
          "id": "5614012",
          "text": "Lui ha perso tutti i suoi soldi al gioco d'azzardo.",
          "translation": "Он потерял все свои деньги в азартных играх.",
          "source": "Tatoeba #5614012 @dnnywld / #5613759 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614012",
          "cefr_level": "A1",
          "word_slugs": [
            "azzardo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
