    {
      "slug": "pasqua-noun",
      "lemma": "Pasqua",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8359,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3193035",
          "text": "Avete passato bene la Pasqua?",
          "translation": "Вы хорошо провели Пасху?",
          "source": "Tatoeba #3193035 @Guybrush88 / #3267024 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3193035",
          "cefr_level": "A1",
          "word_slugs": [
            "pasqua-noun"
          ]
        },
        {
          "id": "5557931",
          "text": "È divertente dipingere le uova di Pasqua.",
          "translation": "Красить яйца на Пасху - весело.",
          "source": "Tatoeba #5557931 @dnnywld / #5557323 @clayrat (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5557931",
          "cefr_level": "A1",
          "word_slugs": [
            "pasqua-noun"
          ]
        },
        {
          "id": "7146124",
          "text": "A Natale e Pasqua la chiesa è gremita.",
          "translation": "В Рождество и Пасху церковь переполнена.",
          "source": "Tatoeba #7146124 @dnnywld / #7146087 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7146124",
          "cefr_level": "A1",
          "word_slugs": [
            "pasqua-noun"
          ]
        },
        {
          "id": "6806386",
          "text": "Auguro a tutti i miei amici una felice e benedetta Pasqua.",
          "translation": "Желаю всем моим друзьям радостной и благословенной Пасхи.",
          "source": "Tatoeba #6806386 @dnnywld / #6805627 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6806386",
          "cefr_level": "A1",
          "word_slugs": [
            "pasqua-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la Pasqua",
        "plural": "",
        "infinitive": ""
      }
    },
