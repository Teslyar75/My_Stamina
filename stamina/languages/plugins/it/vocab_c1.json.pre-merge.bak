      "slug": "mantieni-verb",
      "lemma": "mantieni",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8159,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5512781",
          "text": "Mantieni la calma!",
          "translation": "Да стой ты спокойно!",
          "source": "Tatoeba #5512781 @dnnywld / #5512687 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512781",
          "cefr_level": "A1",
          "word_slugs": [
            "mantieni-verb"
          ]
        },
        {
          "id": "2143301",
          "text": "Per favore mantieni il segreto.",
          "translation": "Держи это в тайне, пожалуйста.",
          "source": "Tatoeba #2143301 @hitori37 / #4429263 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2143301",
          "cefr_level": "A1",
          "word_slugs": [
            "mantieni-verb"
          ]
        },
        {
          "id": "6594859",
          "text": "Ti mantieni sempre in contatto con lui?",
          "translation": "Ты всё ещё поддерживаешь с ним контакт?",
          "source": "Tatoeba #6594859 @dnnywld / #6594809 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6594859",
          "cefr_level": "A1",
          "word_slugs": [
            "mantieni-verb"
          ]
        },
        {
          "id": "5993890",
          "text": "Mantieni gli amici vicino, e i nemici ancora di più.",
          "translation": "Держи друзей близко, а врагов ещё ближе.",
          "source": "Tatoeba #5993890 @dnnywld / #5993199 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5993890",
          "cefr_level": "A1",
          "word_slugs": [
            "mantieni-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "mantieni",
        "plural": "",
        "infinitive": "mantieni"
      }
