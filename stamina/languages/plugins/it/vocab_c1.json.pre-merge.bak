    {
      "slug": "permettersi-verb",
      "lemma": "permettersi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7678,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6927577",
          "text": "Lui non può permettersi di sposarsi.",
          "translation": "Он не может позволить себе жениться.",
          "source": "Tatoeba #6927577 @dnnywld / #6927238 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6927577",
          "cefr_level": "A1",
          "word_slugs": [
            "permettersi-verb"
          ]
        },
        {
          "id": "5543414",
          "text": "Tom non può permettersi né questo né quello.",
          "translation": "Том не может себе позволить ни того, ни другого.",
          "source": "Tatoeba #5543414 @dnnywld / #5543285 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5543414",
          "cefr_level": "A1",
          "word_slugs": [
            "permettersi-verb"
          ]
        },
        {
          "id": "5424964",
          "text": "Tom non voleva permettersi un atto di debolezza.",
          "translation": "Том не мог позволить себе дать слабину.",
          "source": "Tatoeba #5424964 @dnnywld / #5424873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5424964",
          "cefr_level": "A1",
          "word_slugs": [
            "permettersi-verb"
          ]
        },
        {
          "id": "5514349",
          "text": "Forse lui può permettersi qualsiasi donna che desidera.",
          "translation": "Он, пожалуй, может позволить себе любую женщину, какую пожелает.",
          "source": "Tatoeba #5514349 @dnnywld / #5513473 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514349",
          "cefr_level": "A1",
          "word_slugs": [
            "permettersi-verb"
          ]
        },
        {
          "id": "6806314",
          "text": "Tom non poteva permettersi di assumere attori professionisti.",
          "translation": "Том не мог себе позволить нанять профессиональных актёров.",
          "source": "Tatoeba #6806314 @dnnywld / #6805684 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6806314",
          "cefr_level": "A1",
          "word_slugs": [
            "permettersi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "permettersi",
        "plural": "",
        "infinitive": "permettersi"
      }
