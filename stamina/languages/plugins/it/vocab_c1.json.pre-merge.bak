    {
      "slug": "tubi-noun",
      "lemma": "tubi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8100,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7312064",
          "text": "I tubi andavano cambiati secoli fa.",
          "translation": "Трубы надо было давным-давно поменять.",
          "source": "Tatoeba #7312064 @dnnywld / #7311803 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7312064",
          "cefr_level": "A1",
          "word_slugs": [
            "tubi-noun"
          ]
        },
        {
          "id": "7312078",
          "text": "Era ora che si cambiassero i tubi.",
          "translation": "Трубы давно пора менять.",
          "source": "Tatoeba #7312078 @dnnywld / #7311798 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7312078",
          "cefr_level": "A1",
          "word_slugs": [
            "tubi-noun"
          ]
        },
        {
          "id": "6139844",
          "text": "Questi tubi sono rimasti nel porto per quasi venti anni.",
          "translation": "Эти трубы пролежали в порту почти двадцать лет.",
          "source": "Tatoeba #6139844 @dnnywld / #1942284 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6139844",
          "cefr_level": "A1",
          "word_slugs": [
            "tubi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tubi",
        "plural": "",
        "infinitive": ""
      }
