    {
      "slug": "rifare-verb",
      "lemma": "rifare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7321,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10899010",
          "text": "Tutto da rifare!",
          "translation": "Всё переделать!",
          "source": "Tatoeba #10899010 @dnnywld / #10898943 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10899010",
          "cefr_level": "A1",
          "word_slugs": [
            "rifare-verb"
          ]
        },
        {
          "id": "5889088",
          "text": "Oh, bene, ora bisogna rifare tutto.",
          "translation": "Ну вот, теперь придётся всё переделывать.",
          "source": "Tatoeba #5889088 @dnnywld / #5888983 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889088",
          "cefr_level": "A1",
          "word_slugs": [
            "rifare-verb"
          ]
        },
        {
          "id": "5889089",
          "text": "Per colpa tua bisogna rifare tutto.",
          "translation": "Из-за тебя всё придётся переделывать.",
          "source": "Tatoeba #5889089 @dnnywld / #5888982 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889089",
          "cefr_level": "A1",
          "word_slugs": [
            "rifare-verb"
          ]
        },
        {
          "id": "5451211",
          "text": "Bisogna rifare il letto ogni mattina?",
          "translation": "Постель надо каждый день заправлять?",
          "source": "Tatoeba #5451211 @dnnywld / #5451197 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5451211",
          "cefr_level": "A1",
          "word_slugs": [
            "rifare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "rifare",
        "plural": "",
        "infinitive": "rifare"
      }
    },
    {
      "slug": "abitudini-noun",
      "lemma": "abitudini",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7322,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5653578",
          "text": "Tom non ha cattive abitudini.",
          "translation": "У Тома нет плохих привычек.",
          "source": "Tatoeba #5653578 @dnnywld / #5653225 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5653578",
          "cefr_level": "A1",
          "word_slugs": [
            "abitudini-noun"
          ]
        },
        {
          "id": "6623015",
          "text": "È facile prendere brutte abitudini.",
          "translation": "Вредные привычки легко приобретаются.",
          "source": "Tatoeba #6623015 @dnnywld / #6622924 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6623015",
          "cefr_level": "A1",
          "word_slugs": [
            "abitudini-noun"
          ]
        },
        {
          "id": "5810276",
          "text": "Le vecchie abitudini gradualmente scompaiono.",
          "translation": "Старинные обычаи постепенно уничтожаются.",
          "source": "Tatoeba #5810276 @dnnywld / #5770042 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5810276",
          "cefr_level": "A1",
          "word_slugs": [
            "abitudini-noun"
          ]
        },
        {
          "id": "6957511",
          "text": "Conosco tutte le abitudini di Tom.",
          "translation": "Я знаю все привычки Тома.",
          "source": "Tatoeba #6957511 @dnnywld / #6957039 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6957511",
          "cefr_level": "A1",
          "word_slugs": [
            "abitudini-noun"
          ]
        },
        {
          "id": "643170",
          "text": "Le abitudini sono difficili da rompere.",
          "translation": "Ломать привычки трудно.",
          "source": "Tatoeba #643170 @Guybrush88 / #1346879 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/643170",
          "cefr_level": "A1",
          "word_slugs": [
            "abitudini-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la abitudini",
        "plural": "",
        "infinitive": ""
      }
    },
