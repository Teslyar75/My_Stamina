          ]
        },
        {
          "id": "10840874",
          "text": "Ho fissato un appuntamento dal dottore.",
          "translation": "Я записался на приём к врачу.",
          "source": "Tatoeba #10840874 @dnnywld / #6286726 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10840874",
