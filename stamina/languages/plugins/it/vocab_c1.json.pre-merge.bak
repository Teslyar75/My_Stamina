    {
      "slug": "teme-verb",
      "lemma": "teme",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8988,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6361788",
          "text": "Tom teme di farlo.",
          "translation": "Том боится это делать.",
          "source": "Tatoeba #6361788 @dnnywld / #6361236 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361788",
          "cefr_level": "A1",
          "word_slugs": [
            "teme-verb"
          ]
        },
        {
          "id": "6449485",
          "text": "Tom teme di andarsene.",
          "translation": "Том боится уходить.",
          "source": "Tatoeba #6449485 @dnnywld / #6449303 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6449485",
          "cefr_level": "A1",
          "word_slugs": [
            "teme-verb"
          ]
        },
        {
          "id": "5384219",
          "text": "Il marinaio teme il naufragio.",
          "translation": "Моряк боится кораблекрушения.",
          "source": "Tatoeba #5384219 @dnnywld / #5384169 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384219",
          "cefr_level": "A1",
          "word_slugs": [
            "teme-verb"
          ]
        },
        {
          "id": "5727224",
          "text": "Tom teme di essere licenziato.",
          "translation": "Том боится, что его могут уволить.",
          "source": "Tatoeba #5727224 @dnnywld / #5726983 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5727224",
          "cefr_level": "A1",
          "word_slugs": [
            "teme-verb"
          ]
        },
        {
          "id": "5599014",
          "text": "Lei teme per la sua vita.",
          "translation": "Она боится за свою жизнь.",
          "source": "Tatoeba #5599014 @dnnywld / #5598796 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5599014",
          "cefr_level": "A1",
          "word_slugs": [
            "teme-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "teme",
