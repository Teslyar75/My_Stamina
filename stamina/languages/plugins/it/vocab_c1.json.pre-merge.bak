    {
      "slug": "solare-adj",
      "lemma": "solare",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5142,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5631943",
          "text": "Ho preso una scottatura solare.",
          "translation": "Я загорел.",
          "source": "Tatoeba #5631943 @dnnywld / #2252081 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5631943",
          "cefr_level": "A1",
          "word_slugs": [
            "solare-adj"
          ]
        },
        {
          "id": "5826667",
          "text": "Spiegami come avviene l'eclissi solare.",
          "translation": "Объясни мне, как происходит солнечное затмение.",
          "source": "Tatoeba #5826667 @dnnywld / #5825982 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5826667",
          "cefr_level": "A1",
          "word_slugs": [
            "solare-adj"
          ]
        },
        {
          "id": "6606471",
          "text": "Tom legge un articolo sul sistema solare.",
          "translation": "Том читает статью о Солнечной системе.",
          "source": "Tatoeba #6606471 @Guybrush88 / #6563292 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6606471",
          "cefr_level": "A1",
          "word_slugs": [
            "solare-adj"
          ]
        },
        {
          "id": "6018671",
          "text": "Il costo dell'energia solare continua a scendere.",
          "translation": "Стоимость солнечной энергии постоянно снижается.",
          "source": "Tatoeba #6018671 @dnnywld / #6017863 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6018671",
          "cefr_level": "A1",
          "word_slugs": [
            "solare-adj"
          ]
        },
        {
          "id": "5589351",
          "text": "Inoltre, in questo periodo diminuisce l'attività solare.",
          "translation": "Кроме того, в этот период снизится солнечная активность.",
          "source": "Tatoeba #5589351 @dnnywld / #2748172 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589351",
          "cefr_level": "A1",
          "word_slugs": [
            "solare-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "solare",
        "plural": "",
