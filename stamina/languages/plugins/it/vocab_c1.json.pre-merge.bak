      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2819359",
          "text": "Possiedi un animale domestico?",
          "translation": "Ты держишь какое-нибудь домашнее животное?",
          "source": "Tatoeba #2819359 @Guybrush88 / #4425803 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2819359",
          "cefr_level": "A1",
          "word_slugs": [
            "domestico-adj"
          ]
        },
        {
          "id": "5617307",
          "text": "Hai qualche animale domestico?",
          "translation": "У тебя есть какие-нибудь домашние животные?",
          "source": "Tatoeba #5617307 @dnnywld / #2470015 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5617307",
          "cefr_level": "A1",
          "word_slugs": [
            "domestico-adj"
          ]
        },
        {
          "id": "5624227",
          "text": "Tom ha qualche animale domestico?",
          "translation": "У Тома есть какое-нибудь домашнее животное?",
          "source": "Tatoeba #5624227 @dnnywld / #5623964 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624227",
          "cefr_level": "A1",
          "word_slugs": [
            "domestico-adj"
          ]
        },
        {
          "id": "711482",
          "text": "Era occupata col lavoro domestico.",
          "translation": "Она была занята работой по дому.",
          "source": "Tatoeba #711482 @Heracleum / #3075424 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/711482",
          "cefr_level": "A1",
          "word_slugs": [
            "domestico-adj"
          ]
        },
        {
          "id": "5617538",
          "text": "Ho sempre voluto un animale domestico.",
          "translation": "Я всегда хотел какое-нибудь домашнее животное.",
          "source": "Tatoeba #5617538 @dnnywld / #5199942 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5617538",
          "cefr_level": "A1",
          "word_slugs": [
            "domestico-adj"
          ]
        }
      ],
      "tags": [
