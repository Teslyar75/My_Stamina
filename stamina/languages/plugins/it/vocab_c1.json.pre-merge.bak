      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6954874",
          "text": "Sto cominciando a mangiare.",
          "translation": "Я начинаю есть.",
          "source": "Tatoeba #6954874 @dnnywld / #6954371 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6954874",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciando-verb"
          ]
        },
        {
          "id": "5495051",
          "text": "Tom sta cominciando a piangere.",
          "translation": "Том начинает плакать.",
          "source": "Tatoeba #5495051 @dnnywld / #5494988 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5495051",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciando-verb"
          ]
        },
        {
          "id": "5586963",
          "text": "Tom sta cominciando ad invecchiare.",
          "translation": "Том становится старше.",
          "source": "Tatoeba #5586963 @dnnywld / #5586873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586963",
          "cefr_level": "A1",
