      "cefr_level": "C1",
      "frequency_rank": 6725,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2018922",
          "text": "Non volevo ferire i vostri sentimenti.",
          "translation": "Я не хотел задеть ваши чувства.",
          "source": "Tatoeba #2018922 @Guybrush88 / #4303750 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2018922",
          "cefr_level": "A1",
