    {
      "slug": "forbici-noun",
      "lemma": "forbici",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7823,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5666602",
          "text": "Hai delle forbici.",
          "translation": "У тебя есть ножницы?",
          "source": "Tatoeba #5666602 @dnnywld / #5666524 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5666602",
          "cefr_level": "A1",
          "word_slugs": [
            "forbici-noun"
          ]
        },
        {
          "id": "6886316",
          "text": "Dove sono le forbici?",
          "translation": "Где ножницы?",
          "source": "Tatoeba #6886316 @dnnywld / #6885878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886316",
          "cefr_level": "A1",
          "word_slugs": [
            "forbici-noun"
          ]
        },
        {
          "id": "5422344",
          "text": "Per favore, dammi le forbici.",
          "translation": "Дай мне, пожалуйста, ножницы.",
          "source": "Tatoeba #5422344 @dnnywld / #820923 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5422344",
          "cefr_level": "A1",
          "word_slugs": [
            "forbici-noun"
          ]
        },
        {
          "id": "6886313",
          "text": "Chi ha preso le mie forbici?",
          "translation": "Кто брал мои ножницы?",
          "source": "Tatoeba #6886313 @dnnywld / #6885881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886313",
          "cefr_level": "A1",
          "word_slugs": [
            "forbici-noun"
          ]
        },
        {
          "id": "6886265",
          "text": "Perché hai preso le mie forbici?",
          "translation": "Зачем ты брал мои ножницы?",
          "source": "Tatoeba #6886265 @dnnywld / #6885927 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886265",
          "cefr_level": "A1",
          "word_slugs": [
            "forbici-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
