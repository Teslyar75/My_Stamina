      "examples": [
        {
          "id": "4724753",
          "text": "Ho partecipato al seminario.",
          "translation": "Я посетил семинар.",
          "source": "Tatoeba #4724753 @Guybrush88 / #3938785 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4724753",
