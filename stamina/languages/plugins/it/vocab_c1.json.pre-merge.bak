    {
      "slug": "conclusione-noun",
      "lemma": "conclusione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5294,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "9039895",
          "text": "A quale conclusione siete giunti?",
          "translation": "Какой вывод вы сделали?",
          "source": "Tatoeba #9039895 @Valdast / #8281297 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9039895",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusione-noun"
          ]
        },
        {
          "id": "5616538",
          "text": "Si è arrivati a qualche conclusione?",
          "translation": "Пришли к какому-нибудь выводу?",
          "source": "Tatoeba #5616538 @dnnywld / #4712032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616538",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusione-noun"
          ]
        },
        {
          "id": "2279029",
          "text": "Come sono arrivato a questa conclusione?",
          "translation": "Как я пришёл к этому выводу?",
          "source": "Tatoeba #2279029 @al_ex_an_der / #2279021 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2279029",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusione-noun"
          ]
        },
        {
          "id": "5627954",
          "text": "Non siamo arrivati ad alcuna conclusione.",
          "translation": "Мы не пришли ни к какому выводу.",
          "source": "Tatoeba #5627954 @dnnywld / #5627886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627954",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusione-noun"
          ]
        },
        {
          "id": "7748491",
          "text": "Sono arrivato alla conclusione che lui è colpevole.",
          "translation": "Я пришёл к заключению, что он виновен.",
          "source": "Tatoeba #7748491 @dnnywld / #7748450 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7748491",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la conclusione",
        "plural": "",
        "infinitive": ""
      }
