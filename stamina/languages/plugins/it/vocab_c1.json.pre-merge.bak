    {
      "slug": "sasso-noun",
      "lemma": "sasso",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7501,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6786983",
          "text": "Non lanciare il sasso al cane.",
          "translation": "Не бросай в собаку камень.",
          "source": "Tatoeba #6786983 @dnnywld / #2694739 @entoursis (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786983",
          "cefr_level": "A1",
          "word_slugs": [
            "sasso-noun"
          ]
        },
        {
          "id": "6786975",
          "text": "Non lanciare il sasso al gatto.",
          "translation": "Не бросай камень в кошку.",
          "source": "Tatoeba #6786975 @dnnywld / #2358128 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786975",
          "cefr_level": "A1",
          "word_slugs": [
            "sasso-noun"
          ]
        },
        {
          "id": "5529794",
          "text": "Hai tirato un sasso nello stagno.",
          "translation": "Ты бросил камень в пруд.",
          "source": "Tatoeba #5529794 @dnnywld / #3578611 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5529794",
          "cefr_level": "A1",
          "word_slugs": [
            "sasso-noun"
          ]
        },
        {
          "id": "5987150",
          "text": "Stai gettando un sasso nell'acqua.",
          "translation": "Ты бросаешь в воду камень.",
          "source": "Tatoeba #5987150 @dnnywld / #5986714 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5987150",
          "cefr_level": "A1",
          "word_slugs": [
            "sasso-noun"
          ]
        },
        {
          "id": "5419724",
          "text": "Il ragazzo tirò un sasso al cane.",
          "translation": "Мальчик бросил в собаку камень.",
          "source": "Tatoeba #5419724 @dnnywld / #1012623 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419724",
          "cefr_level": "A1",
          "word_slugs": [
            "sasso-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il sasso",
