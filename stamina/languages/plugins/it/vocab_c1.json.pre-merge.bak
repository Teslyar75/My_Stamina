    {
      "slug": "cadono-verb",
      "lemma": "cadono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8949,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5512443",
          "text": "I bambini cadono spesso.",
          "translation": "Дети часто падают.",
          "source": "Tatoeba #5512443 @dnnywld / #2894311 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512443",
          "cefr_level": "A1",
          "word_slugs": [
            "cadono-verb"
          ]
        },
        {
          "id": "380921",
          "text": "Le foglie cadono lentamente.",
          "translation": "Листья медленно опадают.",
          "source": "Tatoeba #380921 @ver / #412173 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/380921",
          "cefr_level": "A1",
          "word_slugs": [
            "cadono-verb"
          ]
        },
        {
          "id": "5512464",
          "text": "Le foglie cadono per terra.",
          "translation": "Листья падали на землю.",
          "source": "Tatoeba #5512464 @dnnywld / #1507518 @tengo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512464",
          "cefr_level": "A1",
          "word_slugs": [
            "cadono-verb"
          ]
        },
        {
          "id": "411818",
          "text": "In autunno cadono le foglie.",
          "translation": "Осенью падает листва.",
          "source": "Tatoeba #411818 @shoras / #4127139 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/411818",
          "cefr_level": "A1",
          "word_slugs": [
            "cadono-verb"
          ]
        },
        {
          "id": "5512473",
          "text": "Le stelle rosse non cadono mai.",
          "translation": "Красные звезды не падают.",
          "source": "Tatoeba #5512473 @dnnywld / #2217777 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512473",
          "cefr_level": "A1",
          "word_slugs": [
            "cadono-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cadono",
