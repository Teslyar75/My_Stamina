    {
      "slug": "infranto-adj",
      "lemma": "infranto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5991,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5516426",
          "text": "Avete infranto le regole.",
          "translation": "Вы нарушили правила.",
          "source": "Tatoeba #5516426 @dnnywld / #5516231 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5516426",
          "cefr_level": "A1",
          "word_slugs": [
            "infranto-adj"
          ]
        },
        {
          "id": "6771238",
          "text": "Il mio cuore è infranto.",
          "translation": "Моё сердце разбито.",
          "source": "Tatoeba #6771238 @Guybrush88 / #3853156 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6771238",
          "cefr_level": "A1",
          "word_slugs": [
            "infranto-adj"
          ]
        },
        {
          "id": "5973829",
          "text": "Tom ha infranto la legge.",
          "translation": "Том преступил закон.",
          "source": "Tatoeba #5973829 @Guybrush88 / #4447133 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5973829",
          "cefr_level": "A1",
          "word_slugs": [
            "infranto-adj"
          ]
        },
        {
          "id": "6203816",
          "text": "Lui ha infranto molti cuori.",
          "translation": "Он разбил немало сердец.",
          "source": "Tatoeba #6203816 @dnnywld / #6203774 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6203816",
