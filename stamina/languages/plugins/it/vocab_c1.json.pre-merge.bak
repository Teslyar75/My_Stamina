          "cefr_level": "A1",
          "word_slugs": [
            "lava-noun"
          ]
        },
        {
          "id": "5419343",
          "text": "Papà si lava il viso.",
          "translation": "Отец умывается.",
          "source": "Tatoeba #5419343 @dnnywld / #5252220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419343",
          "cefr_level": "A1",
          "word_slugs": [
            "lava-noun"
          ]
        },
        {
          "id": "607500",
          "text": "Una mano lava l'altra.",
          "translation": "Услуга за услугу.",
