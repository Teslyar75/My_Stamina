    {
      "slug": "imparando-verb",
      "lemma": "imparando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7551,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7894130",
          "text": "Mary sta imparando.",
          "translation": "Мэри учится.",
          "source": "Tatoeba #7894130 @dnnywld / #7893926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7894130",
          "cefr_level": "A1",
          "word_slugs": [
            "imparando-verb"
          ]
        },
        {
          "id": "5563898",
          "text": "Sto imparando molto.",
          "translation": "Я многое узнаю.",
          "source": "Tatoeba #5563898 @dnnywld / #5563777 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5563898",
          "cefr_level": "A1",
          "word_slugs": [
            "imparando-verb"
          ]
        },
        {
          "id": "2285433",
          "text": "Sta imparando l'arabo.",
          "translation": "Вы учите арабский.",
          "source": "Tatoeba #2285433 @Guybrush88 / #3455696 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2285433",
          "cefr_level": "A1",
          "word_slugs": [
            "imparando-verb"
          ]
        },
        {
          "id": "4791277",
          "text": "Sto imparando a guidare.",
          "translation": "Я учусь водить.",
          "source": "Tatoeba #4791277 @Guybrush88 / #2903677 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4791277",
          "cefr_level": "A1",
          "word_slugs": [
            "imparando-verb"
          ]
        },
        {
          "id": "2703976",
          "text": "Sto imparando il francese.",
          "translation": "Я учу французский.",
          "source": "Tatoeba #2703976 @Guybrush88 / #2493995 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2703976",
          "cefr_level": "A1",
          "word_slugs": [
            "imparando-verb"
          ]
        }
      ],
