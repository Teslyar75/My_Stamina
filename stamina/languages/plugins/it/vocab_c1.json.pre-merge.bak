    {
      "slug": "votare-verb",
      "lemma": "votare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6115,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5931728",
          "text": "Semplicemente non votare per Tom.",
          "translation": "Просто не голосуй за Тома.",
          "source": "Tatoeba #5931728 @dnnywld / #5929748 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5931728",
          "cefr_level": "A1",
          "word_slugs": [
            "votare-verb"
          ]
        },
        {
          "id": "5690531",
          "text": "Ho deciso di non votare più.",
          "translation": "Я принял решение больше никогда не голосовать.",
          "source": "Tatoeba #5690531 @dnnywld / #5689840 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690531",
          "cefr_level": "A1",
          "word_slugs": [
            "votare-verb"
          ]
        },
        {
          "id": "3268474",
          "text": "Domenica è importante andare a votare.",
          "translation": "В воскресенье важно пойти голосовать.",
          "source": "Tatoeba #3268474 @Guybrush88 / #3268479 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3268474",
          "cefr_level": "A1",
          "word_slugs": [
            "votare-verb"
          ]
        },
        {
          "id": "5692436",
          "text": "Ho deciso di non votare mai più.",
          "translation": "Я решил больше никогда не голосовать.",
          "source": "Tatoeba #5692436 @dnnywld / #5689608 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5692436",
          "cefr_level": "A1",
          "word_slugs": [
            "votare-verb"
          ]
        },
        {
          "id": "5394711",
          "text": "La nostra gioventù non va a votare.",
          "translation": "Наша молодежь не ходит на выборы.",
          "source": "Tatoeba #5394711 @dnnywld / #5394548 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5394711",
          "cefr_level": "A1",
          "word_slugs": [
            "votare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "votare",
        "plural": "",
        "infinitive": "votare"
      }
    },
    {
