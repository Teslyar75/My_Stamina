    {
      "slug": "menzogna-noun",
      "lemma": "menzogna",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6730,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "11527682",
          "text": "Era tutta una menzogna.",
          "translation": "Это всё враньё!",
          "source": "Tatoeba #11527682 @Bernie75 / #3178261 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11527682",
          "cefr_level": "A1",
          "word_slugs": [
            "menzogna-noun"
          ]
        },
        {
          "id": "3282637",
          "text": "È una menzogna assoluta.",
          "translation": "Это абсолютная ложь.",
          "source": "Tatoeba #3282637 @Guybrush88 / #3757477 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3282637",
          "cefr_level": "A1",
          "word_slugs": [
            "menzogna-noun"
          ]
        },
        {
          "id": "12383799",
          "text": "Quello che ha detto era una menzogna.",
          "translation": "То, что она сказала, оказалось ложью.",
          "source": "Tatoeba #12383799 @Bernie75 / #473153 @Xitsa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12383799",
          "cefr_level": "A1",
          "word_slugs": [
            "menzogna-noun"
          ]
        },
        {
          "id": "5513886",
          "text": "Ora sappiamo che questa era una menzogna.",
          "translation": "Теперь мы знаем, что это была неправда.",
          "source": "Tatoeba #5513886 @dnnywld / #5513884 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513886",
          "cefr_level": "A1",
          "word_slugs": [
            "menzogna-noun"
          ]
        },
        {
          "id": "7053273",
          "text": "È difficile distinguere la verità dalla menzogna.",
          "translation": "Трудно отличить истину от лжи.",
          "source": "Tatoeba #7053273 @dnnywld / #7053121 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7053273",
          "cefr_level": "A1",
          "word_slugs": [
            "menzogna-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la menzogna",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "domando-verb",
      "lemma": "domando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6731,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6477832",
          "text": "Mi domando a cosa serva.",
          "translation": "Интересно, для чего это.",
          "source": "Tatoeba #6477832 @dnnywld / #6477711 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6477832",
          "cefr_level": "A1",
          "word_slugs": [
            "domando-verb"
          ]
        },
        {
          "id": "10780999",
          "text": "Mi domando quando verrà Anna.",
          "translation": "Интересно, когда приедет Анна.",
          "source": "Tatoeba #10780999 @dnnywld / #6741889 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10780999",
          "cefr_level": "A1",
          "word_slugs": [
            "domando-verb"
          ]
        },
        {
          "id": "10780969",
          "text": "Mi domando quando arriverà Tom.",
          "translation": "Интересно, когда приедет Том.",
          "source": "Tatoeba #10780969 @dnnywld / #5136567 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10780969",
          "cefr_level": "A1",
          "word_slugs": [
            "domando-verb"
          ]
        },
        {
          "id": "10755853",
          "text": "Mi domando se piaci a Tom.",
          "translation": "Интересно, нравишься ли ты Тому.",
          "source": "Tatoeba #10755853 @dnnywld / #6622638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10755853",
          "cefr_level": "A1",
          "word_slugs": [
            "domando-verb"
          ]
        },
        {
          "id": "10755852",
          "text": "Mi domando se piacete a Tom.",
          "translation": "Интересно, нравитесь ли вы Тому.",
          "source": "Tatoeba #10755852 @dnnywld / #6622639 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10755852",
          "cefr_level": "A1",
          "word_slugs": [
            "domando-verb"
          ]
        }
