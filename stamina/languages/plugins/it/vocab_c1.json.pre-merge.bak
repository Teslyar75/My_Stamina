    {
      "slug": "arbitro-noun",
      "lemma": "arbitro",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9604,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6924181",
          "text": "Sul campo non c'è l'arbitro.",
          "translation": "На поле нет судьи.",
          "source": "Tatoeba #6924181 @dnnywld / #6923904 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6924181",
          "cefr_level": "A1",
          "word_slugs": [
            "arbitro-noun"
          ]
        },
        {
          "id": "6924180",
          "text": "Sul campo non c'era l'arbitro.",
          "translation": "На поле не было судьи.",
          "source": "Tatoeba #6924180 @dnnywld / #6923905 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6924180",
          "cefr_level": "A1",
          "word_slugs": [
            "arbitro-noun"
          ]
        },
        {
          "id": "10851529",
          "text": "L'arbitro assegna un calcio di rigore.",
          "translation": "Арбитр назначает пенальти.",
          "source": "Tatoeba #10851529 @dnnywld / #6996760 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851529",
          "cefr_level": "A1",
          "word_slugs": [
            "arbitro-noun"
          ]
        },
        {
          "id": "3359289",
          "text": "L'arbitro ha preso la decisione giusta.",
          "translation": "Арбитр принял верное решение.",
          "source": "Tatoeba #3359289 @Guybrush88 / #3359389 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3359289",
          "cefr_level": "A1",
          "word_slugs": [
