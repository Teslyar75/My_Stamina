    {
      "slug": "fritte-adj",
      "lemma": "fritte",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 10000,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6943271",
          "text": "Voglio mangiare patatine fritte.",
          "translation": "Я хочу поесть картошки фри.",
          "source": "Tatoeba #6943271 @dnnywld / #6942840 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6943271",
          "cefr_level": "A1",
          "word_slugs": [
            "fritte-adj"
          ]
        },
        {
          "id": "10870939",
          "text": "Per contorno verdure e patate fritte.",
          "translation": "На гарнир овощи и жареная картошка.",
          "source": "Tatoeba #10870939 @dnnywld / #6773374 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10870939",
          "cefr_level": "A1",
          "word_slugs": [
            "fritte-adj"
          ]
        },
        {
          "id": "5899962",
          "text": "Ho ordinato Wiener Schnitzel con patate fritte.",
          "translation": "Я заказал венский шницель с жареной картошкой.",
          "source": "Tatoeba #5899962 @dnnywld / #5899220 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5899962",
          "cefr_level": "A1",
          "word_slugs": [
            "fritte-adj"
          ]
        },
        {
          "id": "2728997",
          "text": "Tom ama la pizza e le patatine fritte.",
          "translation": "Том любит пиццу и картофель фри.",
          "source": "Tatoeba #2728997 @Tambons / #4340183 @savella (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2728997",
          "cefr_level": "A1",
          "word_slugs": [
            "fritte-adj"
          ]
        },
        {
          "id": "5458590",
          "text": "Tom ha ordinato un hamburger con patate fritte.",
          "translation": "Том заказал гамбургер с картошкой фри.",
          "source": "Tatoeba #5458590 @dnnywld / #5458563 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5458590",
          "cefr_level": "A1",
          "word_slugs": [
            "fritte-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la fritte",
        "plural": "",
        "infinitive": ""
      }
