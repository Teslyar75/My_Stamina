    {
      "slug": "crescendo-noun",
      "lemma": "crescendo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5543,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7962541",
          "text": "Lei sta crescendo.",
          "translation": "Она увеличивается.",
          "source": "Tatoeba #7962541 @dnnywld / #7962309 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7962541",
          "cefr_level": "A1",
          "word_slugs": [
            "crescendo-noun"
          ]
        },
        {
          "id": "7962542",
          "text": "Lui sta crescendo.",
          "translation": "Он становится больше.",
          "source": "Tatoeba #7962542 @dnnywld / #7962306 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7962542",
          "cefr_level": "A1",
          "word_slugs": [
            "crescendo-noun"
          ]
        },
        {
          "id": "6910793",
          "text": "Sto crescendo velocemente.",
          "translation": "Я быстро расту.",
          "source": "Tatoeba #6910793 @dnnywld / #6909493 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6910793",
          "cefr_level": "A1",
          "word_slugs": [
            "crescendo-noun"
          ]
        },
        {
          "id": "2701965",
          "text": "La disoccupazione sta crescendo.",
          "translation": "Безработица растёт.",
          "source": "Tatoeba #2701965 @Guybrush88 / #1626629 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2701965",
          "cefr_level": "A1",
          "word_slugs": [
            "crescendo-noun"
          ]
        },
        {
          "id": "11828576",
          "text": "Il progetto sta lentamente crescendo.",
          "translation": "Проект потихоньку растёт.",
          "source": "Tatoeba #11828576 @dnnywld / #11827873 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11828576",
          "cefr_level": "A1",
          "word_slugs": [
            "crescendo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
