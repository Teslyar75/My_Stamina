    {
      "slug": "preziosa-adj",
      "lemma": "preziosa",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6429,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10888380",
          "text": "La vita è preziosa.",
          "translation": "Жизнь драгоценна.",
          "source": "Tatoeba #10888380 @dnnywld / #10184844 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10888380",
          "cefr_level": "A1",
          "word_slugs": [
            "preziosa-adj"
          ]
        },
        {
          "id": "692214",
          "text": "Il diamante è una pietra preziosa.",
          "translation": "Алмаз - драгоценный камень.",
          "source": "Tatoeba #692214 @Pharamp / #6594664 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/692214",
          "cefr_level": "A1",
          "word_slugs": [
            "preziosa-adj"
          ]
        },
        {
          "id": "2431194",
          "text": "Oggi ho imparato una lezione preziosa.",
          "translation": "Сегодня я получил ценный урок.",
          "source": "Tatoeba #2431194 @al_ex_an_der / #2431195 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2431194",
          "cefr_level": "A1",
          "word_slugs": [
            "preziosa-adj"
          ]
        },
        {
          "id": "6956674",
          "text": "La pazienza è la virtù più preziosa.",
          "translation": "Терпение — самая прекрасная добродетель.",
          "source": "Tatoeba #6956674 @dnnywld / #6956142 @kruvez (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6956674",
          "cefr_level": "A1",
          "word_slugs": [
            "preziosa-adj"
          ]
        },
        {
          "id": "6367809",
          "text": "Lei è la cosa più preziosa che ho.",
          "translation": "Она самое дорогое, что у меня есть.",
          "source": "Tatoeba #6367809 @dnnywld / #6366911 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367809",
          "cefr_level": "A1",
          "word_slugs": [
            "preziosa-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il preziosa",
        "plural": "",
        "infinitive": ""
      }
