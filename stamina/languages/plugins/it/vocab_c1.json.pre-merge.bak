      "frequency_rank": 5832,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "997810",
          "text": "Devo andare all'obitorio.",
          "translation": "Я должен идти в морг.",
          "source": "Tatoeba #997810 @Guybrush88 / #3250333 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/997810",
          "cefr_level": "A1",
          "word_slugs": [
            "obitorio-noun"
          ]
        },
        {
          "id": "3233325",
          "text": "Voglio lavorare in un obitorio.",
          "translation": "Хочу работать в морге.",
          "source": "Tatoeba #3233325 @Guybrush88 / #3234153 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3233325",
          "cefr_level": "A1",
          "word_slugs": [
            "obitorio-noun"
          ]
        },
        {
          "id": "3233327",
          "text": "Il mio sogno è di lavorare in un obitorio.",
          "translation": "Моя мечта - работать в морге.",
          "source": "Tatoeba #3233327 @Guybrush88 / #3234144 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3233327",
          "cefr_level": "A1",
          "word_slugs": [
            "obitorio-noun"
          ]
        },
        {
          "id": "3233328",
          "text": "Il suo sogno è di lavorare in un obitorio.",
          "translation": "Его мечта - работать в морге.",
          "source": "Tatoeba #3233328 @Guybrush88 / #3234145 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3233328",
          "cefr_level": "A1",
          "word_slugs": [
            "obitorio-noun"
          ]
        },
        {
          "id": "3233322",
          "text": "Ci sono un sacco di cadaveri in questo obitorio!",
          "translation": "В этом морге полно трупов!",
          "source": "Tatoeba #3233322 @Guybrush88 / #3234151 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3233322",
          "cefr_level": "A1",
          "word_slugs": [
            "obitorio-noun"
          ]
        }
      ],
