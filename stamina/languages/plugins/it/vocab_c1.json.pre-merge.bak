    {
      "slug": "costante-name",
      "lemma": "Costante",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6238,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3027891",
          "text": "Io sono in pericolo costante.",
          "translation": "Я в постоянной опасности.",
          "source": "Tatoeba #3027891 @Guybrush88 / #4439690 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3027891",
          "cefr_level": "A1",
          "word_slugs": [
            "costante-name"
          ]
        },
        {
          "id": "5650412",
          "text": "Ho integrato, ma ho dimenticato la costante di integrazione.",
          "translation": "Я проинтегрировал, но забыл постоянную интегрирования.",
          "source": "Tatoeba #5650412 @dnnywld / #5650367 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650412",
          "cefr_level": "A1",
          "word_slugs": [
            "costante-name"
          ]
        },
        {
          "id": "3013261",
          "text": "L'unica cosa costante in questo mondo è il cambiamento.",
