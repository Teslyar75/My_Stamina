    {
      "slug": "balli-verb",
      "lemma": "balli",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7720,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7275381",
          "text": "A Fadil piacciono i balli.",
          "translation": "Фадель любил танцы.",
          "source": "Tatoeba #7275381 @dnnywld / #7275319 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275381",
          "cefr_level": "A1",
          "word_slugs": [
            "balli-verb"
          ]
        },
        {
          "id": "6312479",
          "text": "Non mi piace che balli con Tom.",
          "translation": "Мне не нравится, что ты танцуешь с Томом.",
          "source": "Tatoeba #6312479 @dnnywld / #6312223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6312479",
          "cefr_level": "A1",
          "word_slugs": [
            "balli-verb"
          ]
        },
        {
          "id": "10856655",
          "text": "Il valzer e la samba sono balli.",
          "translation": "Вальс и самба - это танцы.",
          "source": "Tatoeba #10856655 @dnnywld / #6860797 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10856655",
          "cefr_level": "A1",
          "word_slugs": [
            "balli-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
