    {
      "slug": "adolescente-adj",
      "lemma": "adolescente",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5454,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6374195",
          "text": "Tom è un adolescente magrolino.",
          "translation": "Том - худощавый подросток.",
          "source": "Tatoeba #6374195 @dnnywld / #6373445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6374195",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescente-adj"
          ]
        },
        {
          "id": "5479317",
          "text": "Tom è una normale adolescente medio.",
          "translation": "Том обычный среднестатистический подросток.",
          "source": "Tatoeba #5479317 @dnnywld / #5479202 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479317",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescente-adj"
          ]
        },
        {
          "id": "5387726",
          "text": "Tom e Mary hanno una figlia adolescente.",
          "translation": "У Тома с Мэри есть дочь-подросток.",
          "source": "Tatoeba #5387726 @Guybrush88 / #5387725 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387726",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescente-adj"
          ]
        },
        {
          "id": "6874522",
          "text": "Ero un adolescente quando mio padre è morto.",
          "translation": "Я был подростком, когда умер отец.",
          "source": "Tatoeba #6874522 @dnnywld / #6862458 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6874522",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescente-adj"
          ]
        },
        {
          "id": "5690662",
          "text": "Mi sento come se fossi ancora un adolescente.",
          "translation": "Я чувствую себя так, будто я опять подросток.",
          "source": "Tatoeba #5690662 @dnnywld / #5689695 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690662",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescente-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il adolescente",
        "plural": "",
        "infinitive": ""
