          ]
        },
        {
          "id": "5597931",
          "text": "Guarda, uno scoiattolo.",
          "translation": "Смотри, белка.",
          "source": "Tatoeba #5597931 @dnnywld / #5597866 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5597931",
          "cefr_level": "A1",
          "word_slugs": [
