    {
      "slug": "lati-adj",
      "lemma": "lati",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6384,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "786672",
          "text": "Un esagono ha sei lati.",
          "translation": "У шестиугольника шесть сторон.",
          "source": "Tatoeba #786672 @Guybrush88 / #1575929 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/786672",
          "cefr_level": "A1",
          "word_slugs": [
            "lati-adj"
          ]
        },
        {
          "id": "10916208",
          "text": "In un quadrato tutti i lati sono uguali.",
          "translation": "У квадрата все стороны равны.",
          "source": "Tatoeba #10916208 @dnnywld / #10915691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10916208",
          "cefr_level": "A1",
          "word_slugs": [
            "lati-adj"
          ]
        },
        {
          "id": "10916200",
          "text": "In un triangolo isoscele due lati sono uguali.",
          "translation": "У равнобедренного треугольника две стороны равны.",
          "source": "Tatoeba #10916200 @dnnywld / #10915695 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10916200",
          "cefr_level": "A1",
          "word_slugs": [
            "lati-adj"
          ]
        },
        {
          "id": "10916204",
          "text": "In un triangolo equilatero tutti i lati sono uguali.",
          "translation": "У равностороннего треугольника все стороны равны.",
          "source": "Tatoeba #10916204 @dnnywld / #10915693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10916204",
          "cefr_level": "A1",
          "word_slugs": [
            "lati-adj"
          ]
        },
        {
          "id": "10807668",
          "text": "Il forte è circondato dall'acqua su tutti i lati.",
          "translation": "Форт со всех сторон окружён водой.",
          "source": "Tatoeba #10807668 @dnnywld / #10806993 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10807668",
          "cefr_level": "A1",
          "word_slugs": [
            "lati-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il lati",
        "plural": "",
        "infinitive": ""
      }
    },
