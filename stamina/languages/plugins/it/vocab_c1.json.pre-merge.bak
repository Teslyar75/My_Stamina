    {
      "slug": "cacciare-verb",
      "lemma": "cacciare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5603,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5968775",
          "text": "Non so come cacciare.",
          "translation": "Я не умею охотиться.",
          "source": "Tatoeba #5968775 @dnnywld / #5967663 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968775",
          "cefr_level": "A1",
          "word_slugs": [
            "cacciare-verb"
          ]
        },
        {
          "id": "5968776",
          "text": "Sei capace di cacciare?",
          "translation": "Ты умеешь охотиться?",
          "source": "Tatoeba #5968776 @dnnywld / #5967664 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968776",
          "cefr_level": "A1",
          "word_slugs": [
            "cacciare-verb"
          ]
        },
        {
          "id": "5968777",
          "text": "Siete capaci di cacciare?",
          "translation": "Вы умеете охотиться?",
          "source": "Tatoeba #5968777 @dnnywld / #5967665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968777",
          "cefr_level": "A1",
          "word_slugs": [
            "cacciare-verb"
          ]
        },
        {
          "id": "868129",
          "text": "Cacciare di frodo è illegale.",
          "translation": "Браконьерство незаконно.",
          "source": "Tatoeba #868129 @Guybrush88 / #3144849 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/868129",
          "cefr_level": "A1",
          "word_slugs": [
            "cacciare-verb"
          ]
        },
        {
          "id": "5402683",
          "text": "Al gatto del mio vicino piace cacciare il mio geco.",
          "translation": "Соседский кот любит гоняться за моим гекконом.",
          "source": "Tatoeba #5402683 @Sciuro_Kvar / #5402743 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5402683",
          "cefr_level": "A1",
          "word_slugs": [
            "cacciare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cacciare",
        "plural": "",
        "infinitive": "cacciare"
      }
