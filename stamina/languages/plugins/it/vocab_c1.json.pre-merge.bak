    {
      "slug": "durerà-verb",
      "lemma": "durerà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9416,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3646812",
          "text": "Quanto durerà la riunione?",
          "translation": "Как долго продлится встреча?",
          "source": "Tatoeba #3646812 @Guybrush88 / #5705665 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3646812",
          "cefr_level": "A1",
          "word_slugs": [
            "durerà-verb"
          ]
        },
        {
          "id": "13495372",
          "text": "Quanto durerà questo bel tempo?",
          "translation": "Как долго продержится эта хорошая погода?",
          "source": "Tatoeba #13495372 @dnnywld / #11339407 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495372",
          "cefr_level": "A1",
          "word_slugs": [
            "durerà-verb"
          ]
        },
        {
          "id": "1943761",
          "text": "Per quanto durerà questo freddo?",
          "translation": "Этот холод надолго?",
          "source": "Tatoeba #1943761 @Guybrush88 / #1982331 @Kikka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1943761",
          "cefr_level": "A1",
          "word_slugs": [
            "durerà-verb"
          ]
        },
        {
          "id": "3774538",
          "text": "Non ho idea di quanto durerà.",
          "translation": "Я понятия не имею, сколько это продлится.",
          "source": "Tatoeba #3774538 @valealb / #5416779 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3774538",
          "cefr_level": "A1",
          "word_slugs": [
            "durerà-verb"
          ]
        },
        {
          "id": "5502786",
          "text": "Non durerà più di tre minuti.",
          "translation": "Это продлится не дольше трёх минут.",
          "source": "Tatoeba #5502786 @dnnywld / #5501842 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5502786",
          "cefr_level": "A1",
          "word_slugs": [
            "durerà-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
