      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12374869",
          "text": "Ho qualche capello bianco.",
          "translation": "У меня есть несколько седых волос.",
          "source": "Tatoeba #12374869 @dnnywld / #12374775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12374869",
          "cefr_level": "A1",
          "word_slugs": [
            "capello-noun"
          ]
        },
        {
          "id": "6841308",
          "text": "Spacchi il capello su ogni mia parola.",
          "translation": "Ты придираешься к каждому моему слову.",
          "source": "Tatoeba #6841308 @dnnywld / #6841049 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841308",
          "cefr_level": "A1",
          "word_slugs": [
            "capello-noun"
          ]
        },
        {
          "id": "6841307",
          "text": "Spaccate il capello su ogni mia parola.",
          "translation": "Вы придираетесь к каждому моему слову.",
          "source": "Tatoeba #6841307 @dnnywld / #6841050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841307",
          "cefr_level": "A1",
          "word_slugs": [
            "capello-noun"
          ]
        },
        {
          "id": "6841304",
          "text": "Tom spacca il capello sulle cose che dico.",
          "translation": "Том придирается ко всему, что я говорю.",
          "source": "Tatoeba #6841304 @dnnywld / #6841061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841304",
          "cefr_level": "A1",
