    {
      "slug": "scoperte-adj",
      "lemma": "scoperte",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9273,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5767918",
          "text": "Abbiamo fatto delle scioccanti scoperte.",
          "translation": "Мы сделали шокирующее открытие.",
          "source": "Tatoeba #5767918 @dnnywld / #5767800 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5767918",
          "cefr_level": "A1",
          "word_slugs": [
            "scoperte-adj"
          ]
        },
        {
          "id": "6843308",
          "text": "Queste scoperte rimarranno nella storia.",
