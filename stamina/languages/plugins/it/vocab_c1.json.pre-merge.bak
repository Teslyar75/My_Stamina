      "examples": [
        {
          "id": "10825623",
          "text": "Qualcuno ha lasciato la borsa sulla panchina.",
          "translation": "Кто-то оставил на скамейке сумку.",
          "source": "Tatoeba #10825623 @dnnywld / #7249514 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10825623",
          "cefr_level": "A1",
          "word_slugs": [
            "panchina-noun"
          ]
        },
        {
          "id": "1004007",
          "text": "Qualcuno ha lasciato una borsa sulla panchina.",
          "translation": "Кто-то оставил сумку на скамейке.",
          "source": "Tatoeba #1004007 @Guybrush88 / #471956 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1004007",
          "cefr_level": "A1",
          "word_slugs": [
            "panchina-noun"
          ]
        },
        {
          "id": "5683539",
          "text": "Ci sedemmo su una panchina vicino al portico.",
          "translation": "Мы сели на скамейку возле крыльца.",
          "source": "Tatoeba #5683539 @dnnywld / #5682732 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683539",
          "cefr_level": "A1",
          "word_slugs": [
            "panchina-noun"
          ]
        },
        {
          "id": "5423586",
          "text": "Chi è quella persona che siede sulla panchina?",
          "translation": "Что это за человек сидит на скамейке?",
          "source": "Tatoeba #5423586 @dnnywld / #5423579 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5423586",
          "cefr_level": "A1",
          "word_slugs": [
            "panchina-noun"
          ]
        },
        {
          "id": "5470406",
          "text": "Tom si è seduto in una panchina del parco.",
          "translation": "Том сидел на скамейке в парке.",
          "source": "Tatoeba #5470406 @dnnywld / #5470329 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5470406",
          "cefr_level": "A1",
          "word_slugs": [
            "panchina-noun"
          ]
        }
