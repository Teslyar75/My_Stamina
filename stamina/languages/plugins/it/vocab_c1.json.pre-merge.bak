    {
      "slug": "silenziosa-adj",
      "lemma": "silenziosa",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9818,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5503151",
          "text": "Ieri lei era pensierosa e silenziosa.",
          "translation": "Вчера она была задумчива и молчалива.",
          "source": "Tatoeba #5503151 @dnnywld / #5503048 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5503151",
          "cefr_level": "A1",
          "word_slugs": [
            "silenziosa-adj"
          ]
        },
        {
          "id": "10758813",
          "text": "Cessarono i discorsi, spensero la musica. La stanza si fece silenziosa.",
          "translation": "Разговоры умолкли, музыку выключили. В комнате стало тихо.",
          "source": "Tatoeba #10758813 @dnnywld / #5804214 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10758813",
          "cefr_level": "A1",
          "word_slugs": [
            "silenziosa-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
