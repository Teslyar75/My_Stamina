    {
      "slug": "ritardato-adj",
      "lemma": "ritardato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7328,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5889112",
          "text": "Tom ha ritardato.",
          "translation": "Том опоздал.",
          "source": "Tatoeba #5889112 @dnnywld / #5888936 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889112",
          "cefr_level": "A1",
          "word_slugs": [
            "ritardato-adj"
          ]
        },
        {
          "id": "5987665",
          "text": "Voglio sapere perché avete ritardato.",
          "translation": "Я хочу знать, почему вы опоздали.",
          "source": "Tatoeba #5987665 @dnnywld / #5987134 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5987665",
          "cefr_level": "A1",
          "word_slugs": [
            "ritardato-adj"
          ]
        },
        {
          "id": "5398862",
          "text": "Lei ha ritardato al lavoro, perché ha dormito troppo.",
          "translation": "Она опоздала на работу, потому что проспала.",
          "source": "Tatoeba #5398862 @dnnywld / #3326313 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5398862",
          "cefr_level": "A1",
          "word_slugs": [
            "ritardato-adj"
          ]
        }
      ],
