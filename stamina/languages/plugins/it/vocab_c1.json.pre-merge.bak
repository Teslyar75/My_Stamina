      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3642601",
          "text": "L'ho comprata.",
          "translation": "Я её купил.",
          "source": "Tatoeba #3642601 @Guybrush88 / #5888921 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3642601",
          "cefr_level": "A1",
          "word_slugs": [
            "comprata-verb"
          ]
        },
        {
          "id": "5523479",
          "text": "L'ho già comprata.",
          "translation": "Я её уже купил.",
          "source": "Tatoeba #5523479 @dnnywld / #5523234 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5523479",
          "cefr_level": "A1",
          "word_slugs": [
            "comprata-verb"
          ]
        },
        {
          "id": "5875495",
          "text": "Tom l'ha comprata?",
          "translation": "Том её купил?",
