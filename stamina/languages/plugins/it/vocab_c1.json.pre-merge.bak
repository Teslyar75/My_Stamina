    {
      "slug": "pepe-noun",
      "lemma": "pepe",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8229,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10798385",
          "text": "Aggiungi il pepe.",
          "translation": "Добавь перца.",
          "source": "Tatoeba #10798385 @dnnywld / #10501144 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10798385",
          "cefr_level": "A1",
          "word_slugs": [
            "pepe-noun"
          ]
        },
        {
          "id": "5995567",
          "text": "Stai mettendo troppo pepe.",
          "translation": "Ты кладёшь слишком много перца.",
          "source": "Tatoeba #5995567 @dnnywld / #5995221 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5995567",
          "cefr_level": "A1",
          "word_slugs": [
            "pepe-noun"
          ]
        },
        {
          "id": "7740006",
          "text": "Vuoi un po' di pepe?",
          "translation": "Хочешь перца?",
          "source": "Tatoeba #7740006 @Guybrush88 / #10031916 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7740006",
          "cefr_level": "A1",
          "word_slugs": [
            "pepe-noun"
          ]
        },
        {
          "id": "4963596",
          "text": "Due grammi di pepe sono sufficienti.",
          "translation": "Два грамма перца достаточно.",
          "source": "Tatoeba #4963596 @Guybrush88 / #4963605 @russica (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4963596",
          "cefr_level": "A1",
          "word_slugs": [
            "pepe-noun"
          ]
        },
        {
          "id": "5414913",
          "text": "Scusate, non potreste passarmi sale e pepe?",
          "translation": "Извините, не могли бы Вы передать мне соль и перец?",
          "source": "Tatoeba #5414913 @dnnywld / #500513 @drewhka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5414913",
          "cefr_level": "A1",
          "word_slugs": [
            "pepe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il pepe",
        "plural": "",
        "infinitive": ""
      }
