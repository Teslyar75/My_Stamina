    {
      "slug": "morì-verb",
      "lemma": "morì",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5964,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2622196",
          "text": "Tom morì nel 2009.",
          "translation": "Том умер в 2009 году.",
          "source": "Tatoeba #2622196 @Guybrush88 / #3267975 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2622196",
          "cefr_level": "A1",
          "word_slugs": [
            "morì-verb"
          ]
        },
        {
          "id": "388771",
          "text": "Morì molto anziano.",
          "translation": "Он умер в глубокой старости.",
          "source": "Tatoeba #388771 @Pharamp / #1614196 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/388771",
          "cefr_level": "A1",
          "word_slugs": [
            "morì-verb"
          ]
        },
        {
          "id": "1246724",
          "text": "Lincoln morì nel 1865.",
          "translation": "Линкольн умер в 1865.",
          "source": "Tatoeba #1246724 @Guybrush88 / #425230 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246724",
          "cefr_level": "A1",
          "word_slugs": [
            "morì-verb"
          ]
        },
        {
          "id": "1608687",
          "text": "Mozart morì 200 anni fa.",
          "translation": "Моцарт умер двести лет назад.",
          "source": "Tatoeba #1608687 @skywatcher / #2751500 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1608687",
          "cefr_level": "A1",
          "word_slugs": [
            "morì-verb"
          ]
        },
        {
          "id": "1217584",
          "text": "Morì prima di essere diventata adulta.",
          "translation": "Она умерла несовершеннолетней.",
          "source": "Tatoeba #1217584 @riccioberto / #4386887 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1217584",
          "cefr_level": "A1",
          "word_slugs": [
            "morì-verb"
          ]
        }
      ],
