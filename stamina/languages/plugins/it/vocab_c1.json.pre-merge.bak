      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "377732",
          "text": "Vengo dal Brasile.",
          "translation": "Я приехал из Бразилии.",
          "source": "Tatoeba #377732 @Pharamp / #4703273 @yura798261 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/377732",
          "cefr_level": "A1",
          "word_slugs": [
            "brasile-name"
          ]
        },
        {
          "id": "10781043",
          "text": "Verrete in Brasile?",
          "translation": "Вы приедете в Бразилию?",
          "source": "Tatoeba #10781043 @dnnywld / #10708514 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10781043",
          "cefr_level": "A1",
          "word_slugs": [
            "brasile-name"
          ]
        },
        {
          "id": "5580241",
          "text": "Sono nata in Brasile.",
          "translation": "Я родилась в Бразилии.",
          "source": "Tatoeba #5580241 @dnnywld / #5579516 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5580241",
          "cefr_level": "A1",
          "word_slugs": [
            "brasile-name"
          ]
        },
        {
          "id": "5580247",
          "text": "Sono nato in Brasile.",
          "translation": "Я родился в Бразилии.",
          "source": "Tatoeba #5580247 @dnnywld / #5579515 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5580247",
          "cefr_level": "A1",
          "word_slugs": [
            "brasile-name"
          ]
        },
        {
          "id": "3188607",
          "text": "Voglio vivere in Brasile.",
          "translation": "Хочу жить в Бразилии.",
          "source": "Tatoeba #3188607 @Guybrush88 / #3214745 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3188607",
