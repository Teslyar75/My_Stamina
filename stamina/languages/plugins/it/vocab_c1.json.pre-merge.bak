    {
      "slug": "aziende-noun",
      "lemma": "aziende",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7675,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2970428",
          "text": "La maggior parte delle grandi aziende giapponesi dipendono dalle esportazioni.",
          "translation": "Большинство крупных японских компаний зависят от экспорта.",
          "source": "Tatoeba #2970428 @Guybrush88 / #3112692 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2970428",
          "cefr_level": "A1",
          "word_slugs": [
            "aziende-noun"
          ]
        },
        {
          "id": "5504872",
          "text": "Le aziende giapponesi solitamente forniscono un uniforme ai propri lavoratori.",
          "translation": "Японские компании обычно предоставляют своим работникам униформу.",
          "source": "Tatoeba #5504872 @dnnywld / #5504791 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504872",
          "cefr_level": "A1",
