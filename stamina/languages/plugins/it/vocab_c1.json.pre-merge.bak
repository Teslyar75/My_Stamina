    {
      "slug": "scrittura-noun",
      "lemma": "scrittura",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7546,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6856211",
          "text": "La Vostra scrittura è orrenda.",
          "translation": "У Вас ужасный почерк.",
          "source": "Tatoeba #6856211 @dnnywld / #6856169 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6856211",
          "cefr_level": "A1",
          "word_slugs": [
            "scrittura-noun"
          ]
        },
        {
          "id": "6856212",
          "text": "La sua scrittura è molto bella.",
          "translation": "У неё очень хороший почерк.",
          "source": "Tatoeba #6856212 @dnnywld / #6856165 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6856212",
          "cefr_level": "A1",
          "word_slugs": [
            "scrittura-noun"
          ]
        },
        {
          "id": "6950713",
          "text": "Non riesco a leggere la scrittura di Tom.",
          "translation": "Я не могу разобрать почерк Тома.",
          "source": "Tatoeba #6950713 @dnnywld / #6950702 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950713",
          "cefr_level": "A1",
          "word_slugs": [
            "scrittura-noun"
          ]
        },
        {
          "id": "5478391",
          "text": "Mary ha una bella scrittura con inclinazione a destra.",
          "translation": "У Марии красивый почерк с наклоном букв вправо.",
          "source": "Tatoeba #5478391 @dnnywld / #5478286 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5478391",
          "cefr_level": "A1",
          "word_slugs": [
            "scrittura-noun"
          ]
        },
        {
          "id": "2151454",
          "text": "Tutti i sistemi di scrittura hanno vantaggi e svantaggi.",
          "translation": "Все системы письма имеют свои преимущества и недостатки.",
          "source": "Tatoeba #2151454 @al_ex_an_der / #2151464 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2151454",
          "cefr_level": "A1",
          "word_slugs": [
            "scrittura-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la scrittura",
        "plural": "",
        "infinitive": ""
      }
