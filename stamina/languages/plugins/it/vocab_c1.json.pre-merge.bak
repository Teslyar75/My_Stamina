    {
      "slug": "dimissioni-noun",
      "lemma": "dimissioni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6280,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5422358",
          "text": "Il presidente rassegna le dimissioni.",
          "translation": "Президент уйдёт в отставку.",
          "source": "Tatoeba #5422358 @dnnywld / #5422224 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5422358",
          "cefr_level": "A1",
          "word_slugs": [
            "dimissioni-noun"
          ]
        },
        {
          "id": "3525787",
          "text": "Tom ha deciso di dare le dimissioni.",
          "translation": "Том решил уйти в отставку.",
          "source": "Tatoeba #3525787 @Guybrush88 / #5986930 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3525787",
          "cefr_level": "A1",
          "word_slugs": [
            "dimissioni-noun"
          ]
        },
        {
          "id": "6833544",
          "text": "Il primo ministro ha rassegnato le dimissioni.",
          "translation": "Премьер-министр подала в отставку.",
          "source": "Tatoeba #6833544 @dnnywld / #6832775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833544",
          "cefr_level": "A1",
          "word_slugs": [
            "dimissioni-noun"
          ]
        },
        {
          "id": "5839754",
          "text": "Sono venuto a dirvi che do le dimissioni.",
          "translation": "Я пришел сказать вам, что ухожу в отставку.",
          "source": "Tatoeba #5839754 @dnnywld / #4696776 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5839754",
          "cefr_level": "A1",
          "word_slugs": [
            "dimissioni-noun"
          ]
        },
        {
          "id": "7278154",
          "text": "Appena in tempo hai scritto la lettera di dimissioni.",
          "translation": "Ты очень вовремя написал заявление об уходе.",
          "source": "Tatoeba #7278154 @dnnywld / #7277709 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7278154",
          "cefr_level": "A1",
          "word_slugs": [
            "dimissioni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la dimissioni",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "spedizione-noun",
      "lemma": "spedizione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6281,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5591924",
          "text": "Offriamo la spedizione gratuita.",
          "translation": "Мы предлагаем бесплатную доставку.",
          "source": "Tatoeba #5591924 @dnnywld / #5591285 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591924",
          "cefr_level": "A1",
          "word_slugs": [
            "spedizione-noun"
          ]
        },
        {
          "id": "5419441",
          "text": "Il prezzo comprende le spese di spedizione.",
          "translation": "Цена включает почтовые расходы.",
          "source": "Tatoeba #5419441 @dnnywld / #4650615 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419441",
          "cefr_level": "A1",
          "word_slugs": [
            "spedizione-noun"
          ]
        },
        {
          "id": "6961740",
          "text": "Prima della spedizione assicuratevi che la scatola sia accuratamente sigillata.",
          "translation": "Перед отправкой убедитесь, что коробка тщательно запечатана.",
          "source": "Tatoeba #6961740 @dnnywld / #6960070 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961740",
          "cefr_level": "A1",
          "word_slugs": [
            "spedizione-noun"
          ]
        },
        {
          "id": "5402358",
          "text": "È stato un membro della spedizione che ha scalato l'Everest.",
          "translation": "Он был членом экспедиции, что покорила Эверест.",
          "source": "Tatoeba #5402358 @dnnywld / #1643924 @Hayabusa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5402358",
          "cefr_level": "A1",
          "word_slugs": [
            "spedizione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la spedizione",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "rispondete-verb",
      "lemma": "rispondete",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6282,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2966149",
          "text": "Rispondete a Tom.",
          "translation": "Отвечайте Тому.",
          "source": "Tatoeba #2966149 @Guybrush88 / #5897135 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2966149",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondete-verb"
          ]
        },
        {
          "id": "395961",
          "text": "Rispondete al telefono.",
          "translation": "Ответьте на телефонный звонок.",
          "source": "Tatoeba #395961 @Pharamp / #573703 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/395961",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondete-verb"
          ]
        },
        {
          "id": "6951723",
          "text": "Voi perché non rispondete?",
          "translation": "Вы почему не отвечаете?",
          "source": "Tatoeba #6951723 @dnnywld / #6951176 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6951723",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondete-verb"
          ]
        },
        {
          "id": "1246460",
          "text": "Rispondete alle mie domande.",
          "translation": "Отвечайте на мои вопросы.",
          "source": "Tatoeba #1246460 @Guybrush88 / #5523858 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246460",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondete-verb"
          ]
        },
        {
          "id": "6828525",
          "text": "Penso di aver posto una domanda. Rispondete.",
          "translation": "Я, кажется, задал вопрос. Отвечайте.",
          "source": "Tatoeba #6828525 @dnnywld / #6827875 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6828525",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondete-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "rispondete",
        "plural": "",
        "infinitive": "rispondete"
      }
    },
    {
      "slug": "multa-noun",
      "lemma": "multa",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6283,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "12465070",
          "text": "Mi sono beccato una multa.",
          "translation": "Я схлопотал штраф.",
          "source": "Tatoeba #12465070 @dnnywld / #12464490 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12465070",
          "cefr_level": "A1",
          "word_slugs": [
            "multa-noun"
          ]
        },
        {
          "id": "6953501",
          "text": "La multa non è così alta.",
          "translation": "Штраф не такой высокий.",
          "source": "Tatoeba #6953501 @dnnywld / #5321464 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953501",
          "cefr_level": "A1",
          "word_slugs": [
            "multa-noun"
          ]
        },
        {
          "id": "6953490",
          "text": "La multa non è molto alta.",
          "translation": "Штраф не очень высокий.",
          "source": "Tatoeba #6953490 @dnnywld / #2886562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953490",
          "cefr_level": "A1",
          "word_slugs": [
            "multa-noun"
          ]
        },
        {
          "id": "1743204",
          "text": "Tom non ha ancora pagato la multa.",
          "translation": "Том ещё не оплатил штраф.",
          "source": "Tatoeba #1743204 @Guybrush88 / #3519663 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1743204",
          "cefr_level": "A1",
          "word_slugs": [
            "multa-noun"
          ]
        },
        {
          "id": "6843287",
          "text": "Il poliziotto fece una multa a Tom.",
          "translation": "Полицейский выписал Тому штраф.",
          "source": "Tatoeba #6843287 @dnnywld / #5128120 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843287",
          "cefr_level": "A1",
          "word_slugs": [
            "multa-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
