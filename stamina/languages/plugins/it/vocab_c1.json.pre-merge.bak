    {
      "slug": "prudente-adj",
      "lemma": "prudente",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6670,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5768165",
          "text": "Cerca di essere prudente.",
          "translation": "Постарайся быть благоразумным.",
          "source": "Tatoeba #5768165 @dnnywld / #3081029 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5768165",
          "cefr_level": "A1",
          "word_slugs": [
            "prudente-adj"
          ]
        },
        {
          "id": "5654811",
          "text": "Sono una persona prudente.",
          "translation": "Я осторожный человек.",
          "source": "Tatoeba #5654811 @dnnywld / #5654433 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5654811",
          "cefr_level": "A1",
          "word_slugs": [
            "prudente-adj"
          ]
        },
        {
          "id": "8604247",
          "text": "So che Tom è prudente.",
          "translation": "Я знаю, что Том осторожен.",
          "source": "Tatoeba #8604247 @dnnywld / #7109170 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8604247",
          "cefr_level": "A1",
          "word_slugs": [
            "prudente-adj"
          ]
        },
        {
          "id": "6388770",
          "text": "Tom dice che sono prudente.",
          "translation": "Том говорит, что я ханжа.",
          "source": "Tatoeba #6388770 @dnnywld / #6388587 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6388770",
          "cefr_level": "A1",
          "word_slugs": [
            "prudente-adj"
          ]
        },
        {
          "id": "5560126",
          "text": "Sii prudente sulla via di casa.",
          "translation": "Будь осторожен по дороге домой.",
          "source": "Tatoeba #5560126 @dnnywld / #380983 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5560126",
          "cefr_level": "A1",
          "word_slugs": [
            "prudente-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il prudente",
        "plural": "",
        "infinitive": ""
      }
