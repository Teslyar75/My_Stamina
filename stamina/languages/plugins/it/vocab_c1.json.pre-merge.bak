    {
      "slug": "ferie-noun",
      "lemma": "ferie",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7801,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6217037",
          "text": "Non ho mai ferie.",
          "translation": "У меня не бывает выходных.",
          "source": "Tatoeba #6217037 @dnnywld / #6216067 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6217037",
          "cefr_level": "A1",
          "word_slugs": [
            "ferie-noun"
          ]
        },
        {
          "id": "3320061",
          "text": "Ho bisogno di ferie.",
          "translation": "Мне нужен отгул.",
          "source": "Tatoeba #3320061 @Guybrush88 / #5691475 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3320061",
          "cefr_level": "A1",
          "word_slugs": [
            "ferie-noun"
          ]
        },
        {
          "id": "6360282",
          "text": "Oggi siamo in ferie.",
          "translation": "У нас сегодня выходной.",
          "source": "Tatoeba #6360282 @dnnywld / #6359602 @yatomoya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6360282",
          "cefr_level": "A1",
          "word_slugs": [
            "ferie-noun"
          ]
        },
        {
          "id": "6488878",
          "text": "Quando avrai le ferie?",
          "translation": "Когда у тебя будут каникулы?",
          "source": "Tatoeba #6488878 @dnnywld / #6488696 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6488878",
          "cefr_level": "A1",
          "word_slugs": [
            "ferie-noun"
          ]
        },
        {
          "id": "6924227",
          "text": "Lei è tornata dalle ferie.",
          "translation": "Она вернулась из отпуска.",
          "source": "Tatoeba #6924227 @dnnywld / #2970178 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6924227",
          "cefr_level": "A1",
          "word_slugs": [
            "ferie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
