    {
      "slug": "provate-adj",
      "lemma": "provate",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5553,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5510775",
          "text": "Provate solo invidia.",
          "translation": "Вы просто завидуете.",
          "source": "Tatoeba #5510775 @dnnywld / #5510748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510775",
          "cefr_level": "A1",
          "word_slugs": [
            "provate-adj"
          ]
        },
        {
          "id": "10462338",
          "text": "Provate a descriverlo.",
          "translation": "Попробуйте его описать.",
          "source": "Tatoeba #10462338 @Guybrush88 / #8151244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10462338",
          "cefr_level": "A1",
          "word_slugs": [
