    {
      "slug": "esagerare-verb",
      "lemma": "esagerare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7014,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "11363203",
          "text": "Va bene, non esagerare!",
          "translation": "Да ладно, не преувеличивай!",
          "source": "Tatoeba #11363203 @Bernie75 / #1873801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11363203",
          "cefr_level": "A1",
          "word_slugs": [
            "esagerare-verb"
          ]
        },
        {
          "id": "6857272",
          "text": "Vedete di non esagerare.",
          "translation": "Смотрите не перестарайтесь.",
          "source": "Tatoeba #6857272 @dnnywld / #6856350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857272",
          "cefr_level": "A1",
          "word_slugs": [
            "esagerare-verb"
          ]
        },
        {
          "id": "11534094",
          "text": "Beh, non esagerare troppo.",
          "translation": "Ну не преувеличивай.",
          "source": "Tatoeba #11534094 @Bernie75 / #2835410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11534094",
          "cefr_level": "A1",
          "word_slugs": [
            "esagerare-verb"
          ]
        },
        {
          "id": "11534095",
          "text": "Adesso, non esagerare troppo.",
          "translation": "Ну не преувеличивай.",
          "source": "Tatoeba #11534095 @Bernie75 / #2835410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11534095",
          "cefr_level": "A1",
          "word_slugs": [
            "esagerare-verb"
          ]
        },
        {
          "id": "2904828",
          "text": "Non c'è bisogno di esagerare.",
          "translation": "Нет необходимости преувеличивать.",
          "source": "Tatoeba #2904828 @Guybrush88 / #5347101 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2904828",
          "cefr_level": "A1",
          "word_slugs": [
            "esagerare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "esagerare",
