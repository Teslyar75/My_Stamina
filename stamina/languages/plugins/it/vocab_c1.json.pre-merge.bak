        {
          "id": "6055477",
          "text": "Si può rimandare a domani?",
          "translation": "Можно перенести на завтра?",
          "source": "Tatoeba #6055477 @dnnywld / #6055369 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6055477",
          "cefr_level": "A1",
          "word_slugs": [
            "rimandare-verb"
          ]
        },
        {
          "id": "12388805",
          "text": "Non puoi continuare a rimandare.",
          "translation": "Ты не можешь больше это откладывать.",
          "source": "Tatoeba #12388805 @Bernie75 / #4367338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12388805",
          "cefr_level": "A1",
          "word_slugs": [
            "rimandare-verb"
          ]
        },
        {
          "id": "6950117",
          "text": "Non rimandare il lavoro a domani.",
          "translation": "Не откладывай работу на завтра.",
          "source": "Tatoeba #6950117 @dnnywld / #1450922 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950117",
          "cefr_level": "A1",
          "word_slugs": [
            "rimandare-verb"
          ]
        },
        {
          "id": "6809616",
          "text": "Non rimandare tutto all'ultimo minuto.",
          "translation": "Не оставляй всё на последний момент.",
          "source": "Tatoeba #6809616 @dnnywld / #6808378 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6809616",
          "cefr_level": "A1",
          "word_slugs": [
            "rimandare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "rimandare",
        "plural": "",
        "infinitive": "rimandare"
      }
