    {
      "slug": "temevo-verb",
      "lemma": "temevo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5900,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5670899",
          "text": "È quello che temevo.",
          "translation": "Этого я и боялся.",
          "source": "Tatoeba #5670899 @dnnywld / #5670552 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5670899",
          "cefr_level": "A1",
          "word_slugs": [
            "temevo-verb"
          ]
        },
        {
          "id": "10916324",
          "text": "È successo ciò che più temevo.",
          "translation": "Случилось то, чего я боялся больше всего.",
          "source": "Tatoeba #10916324 @dnnywld / #10915659 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10916324",
          "cefr_level": "A1",
          "word_slugs": [
            "temevo-verb"
          ]
        },
        {
          "id": "5411574",
          "text": "Temevo così tanto che nessuno mi invitasse al ballo.",
          "translation": "Я так боялась, что меня никто не пригласит на танец.",
          "source": "Tatoeba #5411574 @dnnywld / #3565324 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5411574",
          "cefr_level": "A1",
          "word_slugs": [
            "temevo-verb"
          ]
        },
        {
          "id": "5910243",
          "text": "Non temevo i proiettili, ma la velocità alla quale viaggiavano.",
          "translation": "Я боялся не пуль, а скорости, с которой они летели.",
          "source": "Tatoeba #5910243 @dnnywld / #5907419 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5910243",
          "cefr_level": "A1",
          "word_slugs": [
            "temevo-verb"
          ]
        },
        {
          "id": "5411473",
          "text": "Non le ho detto la verità, perché temevo che si sarebbe arrabbiata.",
          "translation": "Я не сказал ей правду, потому что боялся, что она рассердится.",
          "source": "Tatoeba #5411473 @dnnywld / #4673764 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5411473",
          "cefr_level": "A1",
          "word_slugs": [
            "temevo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "temevo",
        "plural": "",
        "infinitive": "temevo"
      }
    },
