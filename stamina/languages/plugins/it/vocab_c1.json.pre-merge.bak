          ]
        },
        {
          "id": "5411687",
          "text": "Non scrivere con l'inchiostro.",
          "translation": "Не пиши чернилами.",
          "source": "Tatoeba #5411687 @Guybrush88 / #2619298 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5411687",
          "cefr_level": "A1",
          "word_slugs": [
