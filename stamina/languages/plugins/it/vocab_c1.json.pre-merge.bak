            "costano-verb"
          ]
        },
        {
          "id": "3075030",
          "text": "Quanto costano questi occhiali?",
          "translation": "Сколько стоят эти очки?",
          "source": "Tatoeba #3075030 @Guybrush88 / #3596615 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3075030",
          "cefr_level": "A1",
          "word_slugs": [
            "costano-verb"
          ]
        },
        {
          "id": "5589152",
          "text": "Quanto costano questi orecchini?",
          "translation": "Сколько стоят эти серьги?",
          "source": "Tatoeba #5589152 @dnnywld / #5588444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589152",
          "cefr_level": "A1",
          "word_slugs": [
            "costano-verb"
          ]
        }
      ],
