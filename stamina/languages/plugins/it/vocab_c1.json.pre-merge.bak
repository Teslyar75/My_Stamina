    {
      "slug": "unito-adj",
      "lemma": "unito",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5582,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3244931",
          "text": "Com'è la vita nel Regno Unito?",
          "translation": "Как жизнь в Соединённом Королевстве?",
          "source": "Tatoeba #3244931 @Guybrush88 / #3244922 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3244931",
          "cefr_level": "A1",
          "word_slugs": [
            "unito-adj"
          ]
        },
        {
          "id": "5424734",
          "text": "Tom si è unito al nostro gruppo.",
          "translation": "Том присоединился к нашей группе.",
          "source": "Tatoeba #5424734 @dnnywld / #5424694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5424734",
          "cefr_level": "A1",
          "word_slugs": [
            "unito-adj"
          ]
        },
        {
          "id": "7856369",
          "text": "Solo ieri mi sono unito alla squadra.",
          "translation": "Я лишь вчера присоединился к команде.",
          "source": "Tatoeba #7856369 @dnnywld / #7856270 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7856369",
          "cefr_level": "A1",
          "word_slugs": [
            "unito-adj"
          ]
        },
        {
          "id": "5476290",
          "text": "La guerra ha unito il popolo americano.",
          "translation": "Война объединила американский народ.",
          "source": "Tatoeba #5476290 @dnnywld / #2036070 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476290",
          "cefr_level": "A1",
          "word_slugs": [
            "unito-adj"
          ]
        },
        {
          "id": "10772258",
          "text": "Il popolo unito non sarà mai sconfitto.",
          "translation": "Объединённый народ никогда не будет повержен.",
          "source": "Tatoeba #10772258 @Rovo / #10772248 @Rovo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10772258",
          "cefr_level": "A1",
          "word_slugs": [
            "unito-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il unito",
        "plural": "",
        "infinitive": ""
      }
