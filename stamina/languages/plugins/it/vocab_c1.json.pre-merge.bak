    {
      "slug": "stufa-noun",
      "lemma": "stufa",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5278,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6797255",
          "text": "Sono stufa di tutto.",
          "translation": "Я всем сыта по горло.",
          "source": "Tatoeba #6797255 @dnnywld / #4780203 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797255",
          "cefr_level": "A1",
          "word_slugs": [
            "stufa-noun"
          ]
        },
        {
          "id": "6797249",
          "text": "Sono stufa di questo.",
          "translation": "Я сыта этим по горло.",
          "source": "Tatoeba #6797249 @dnnywld / #3448277 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797249",
          "cefr_level": "A1",
          "word_slugs": [
            "stufa-noun"
          ]
        },
        {
          "id": "6797278",
          "text": "Sono stufa delle tue scuse.",
          "translation": "Я сыта по горло твоими оправданиями.",
          "source": "Tatoeba #6797278 @dnnywld / #5016041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797278",
          "cefr_level": "A1",
          "word_slugs": [
            "stufa-noun"
          ]
        },
        {
          "id": "6879078",
          "text": "Ero stufa e me ne sono andata.",
          "translation": "Мне стало скучно, и я ушла.",
          "source": "Tatoeba #6879078 @dnnywld / #6878489 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879078",
          "cefr_level": "A1",
          "word_slugs": [
            "stufa-noun"
          ]
        },
        {
          "id": "6879083",
          "text": "Ero stufa, perciò me ne sono andata.",
          "translation": "Мне было скучно, вот я и уехала.",
          "source": "Tatoeba #6879083 @dnnywld / #6878486 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879083",
          "cefr_level": "A1",
          "word_slugs": [
            "stufa-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
