    {
      "slug": "nausea-noun",
      "lemma": "nausea",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6196,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "тошнота"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3814478",
          "text": "Non abbiamo la nausea.",
          "translation": "У нас нет тошноты.",
          "source": "Tatoeba #3814478 @Guybrush88 / #7704905 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3814478",
          "cefr_level": "A1",
          "word_slugs": [
            "nausea-noun"
          ]
        },
        {
          "id": "6917874",
          "text": "Tom aveva la nausea da viaggio.",
          "translation": "Тома укачало.",
          "source": "Tatoeba #6917874 @dnnywld / #6917868 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917874",
          "cefr_level": "A1",
          "word_slugs": [
            "nausea-noun"
          ]
        },
        {
          "id": "5512072",
          "text": "Hai mai avuto la nausea in treno?",
          "translation": "Тебя когда-нибудь тошнило в поезде?",
          "source": "Tatoeba #5512072 @dnnywld / #5511539 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512072",
          "cefr_level": "A1",
          "word_slugs": [
            "nausea-noun"
          ]
        },
        {
          "id": "13633173",
          "text": "Mi viene già la nausea a forza di leggere.",
          "translation": "Меня уже тошнит от чтения.",
          "source": "Tatoeba #13633173 @dnnywld / #8496285 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13633173",
          "cefr_level": "A1",
          "word_slugs": [
            "nausea-noun"
          ]
        },
        {
          "id": "538998",
          "text": "Ho la nausea, quindi non mi parlare di cibo.",
          "translation": "Меня тошнит, так что не говори мне про еду.",
          "source": "Tatoeba #538998 @Pharamp / #3321635 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/538998",
          "cefr_level": "A1",
          "word_slugs": [
            "nausea-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la nausea",
        "plural": "",
        "infinitive": ""
      }
    },
