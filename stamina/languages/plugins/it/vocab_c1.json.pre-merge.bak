    {
      "slug": "solitudine-noun",
      "lemma": "solitudine",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6287,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10875628",
          "text": "L'egoismo è solitudine.",
          "translation": "Эгоизм — это одиночество.",
          "source": "Tatoeba #10875628 @dnnywld / #5348397 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10875628",
          "cefr_level": "A1",
          "word_slugs": [
            "solitudine-noun"
          ]
        },
        {
          "id": "10875623",
          "text": "La solitudine è tremenda.",
          "translation": "Одиночество ужасно.",
          "source": "Tatoeba #10875623 @dnnywld / #3374287 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10875623",
          "cefr_level": "A1",
          "word_slugs": [
            "solitudine-noun"
          ]
        },
        {
          "id": "6789128",
          "text": "Che solitudine viver soli.",
          "translation": "Жить одному одиноко.",
          "source": "Tatoeba #6789128 @dnnywld / #4851293 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6789128",
          "cefr_level": "A1",
          "word_slugs": [
            "solitudine-noun"
          ]
        },
        {
          "id": "6891191",
          "text": "Ho paura della solitudine.",
          "translation": "Я боюсь одиночества.",
          "source": "Tatoeba #6891191 @dnnywld / #5377109 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891191",
          "cefr_level": "A1",
          "word_slugs": [
            "solitudine-noun"
          ]
        },
        {
          "id": "10875625",
          "text": "La solitudine è indipendenza.",
          "translation": "Одиночество — это независимость.",
          "source": "Tatoeba #10875625 @dnnywld / #3843996 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10875625",
          "cefr_level": "A1",
          "word_slugs": [
            "solitudine-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
