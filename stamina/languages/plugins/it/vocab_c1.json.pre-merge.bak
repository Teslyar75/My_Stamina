    {
      "slug": "cristiani-adj",
      "lemma": "cristiani",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8581,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6919067",
          "text": "Luterani e calvinisti sono cristiani.",
          "translation": "Лютеране и кальвинисты — христиане.",
          "source": "Tatoeba #6919067 @dnnywld / #6918599 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919067",
          "cefr_level": "A1",
          "word_slugs": [
            "cristiani-adj"
          ]
        },
        {
          "id": "5679356",
          "text": "Anche molti non Cristiani festeggiano il Natale.",
          "translation": "Многие люди, не являющиеся христианами, тоже празднуют Рождество.",
          "source": "Tatoeba #5679356 @Guybrush88 / #5679366 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5679356",
          "cefr_level": "A1",
          "word_slugs": [
            "cristiani-adj"
          ]
        },
        {
          "id": "2985140",
          "text": "Chi non ama le bestie, non ama i cristiani.",
          "translation": "Кто не любит животных, тот не любит христиан.",
          "source": "Tatoeba #2985140 @Guybrush88 / #3351036 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2985140",
          "cefr_level": "A1",
          "word_slugs": [
            "cristiani-adj"
          ]
        },
        {
          "id": "5555829",
          "text": "Non mi trovo d'accordo con l'interpretazione di molti dogmi cristiani.",
          "translation": "Я не согласен с трактовкой многих христианских догм.",
          "source": "Tatoeba #5555829 @dnnywld / #5554663 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5555829",
          "cefr_level": "A1",
          "word_slugs": [
            "cristiani-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il cristiani",
        "plural": "",
        "infinitive": ""
      }
    },
