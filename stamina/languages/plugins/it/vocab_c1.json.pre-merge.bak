    {
      "slug": "verdure-noun",
      "lemma": "verdure",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8028,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "4473725",
          "text": "Lei vende verdure.",
          "translation": "Она продаёт овощи.",
          "source": "Tatoeba #4473725 @Guybrush88 / #530063 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4473725",
          "cefr_level": "A1",
          "word_slugs": [
            "verdure-noun"
          ]
        },
        {
          "id": "3855996",
          "text": "Mangiate molte verdure.",
          "translation": "Ешьте много овощей.",
          "source": "Tatoeba #3855996 @Guybrush88 / #5324427 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3855996",
          "cefr_level": "A1",
          "word_slugs": [
            "verdure-noun"
          ]
        },
        {
          "id": "6961335",
          "text": "Hanno coltivato molte verdure.",
          "translation": "Они вырастили много овощей.",
          "source": "Tatoeba #6961335 @dnnywld / #6960156 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961335",
          "cefr_level": "A1",
          "word_slugs": [
            "verdure-noun"
          ]
        },
        {
          "id": "10870939",
          "text": "Per contorno verdure e patate fritte.",
          "translation": "На гарнир овощи и жареная картошка.",
          "source": "Tatoeba #10870939 @dnnywld / #6773374 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10870939",
          "cefr_level": "A1",
          "word_slugs": [
            "verdure-noun"
          ]
        },
        {
          "id": "5554500",
          "text": "Oggi ho pranzato con riso e verdure.",
          "translation": "Сегодня на обед у меня был рис с овощами.",
          "source": "Tatoeba #5554500 @dnnywld / #5554483 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5554500",
          "cefr_level": "A1",
          "word_slugs": [
            "verdure-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la verdure",
        "plural": "",
        "infinitive": ""
      }
    },
