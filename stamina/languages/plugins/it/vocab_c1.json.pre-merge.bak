    {
      "slug": "cicatrice-noun",
      "lemma": "cicatrice",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6202,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5429844",
          "text": "Vuoi vedere la mia cicatrice?",
          "translation": "Хочешь увидеть мой шрам?",
          "source": "Tatoeba #5429844 @dnnywld / #4917989 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5429844",
          "cefr_level": "A1",
          "word_slugs": [
            "cicatrice-noun"
          ]
        },
        {
          "id": "8994497",
          "text": "Ha una cicatrice sulla guancia.",
          "translation": "У него шрам на щеке.",
          "source": "Tatoeba #8994497 @Guybrush88 / #7950586 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8994497",
          "cefr_level": "A1",
          "word_slugs": [
            "cicatrice-noun"
          ]
        },
        {
          "id": "6327561",
          "text": "Come ti è venuta quella cicatrice sulla guancia?",
          "translation": "Откуда у тебя этот шрам на щеке?",
          "source": "Tatoeba #6327561 @dnnywld / #6327268 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6327561",
          "cefr_level": "A1",
          "word_slugs": [
            "cicatrice-noun"
          ]
        },
        {
          "id": "12634456",
          "text": "La cicatrice sulla sua fronte era visibile quanto basta.",
          "translation": "Шрам у неё на лбу довольно заметен.",
          "source": "Tatoeba #12634456 @dnnywld / #12634337 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12634456",
          "cefr_level": "A1",
          "word_slugs": [
            "cicatrice-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la cicatrice",
        "plural": "",
        "infinitive": ""
      }
