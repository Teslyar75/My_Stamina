    {
      "slug": "bagnato-adj",
      "lemma": "bagnato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6479,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "497679",
          "text": "Sono bagnato fradicio.",
          "translation": "Я промок до нитки.",
          "source": "Tatoeba #497679 @giok / #418196 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/497679",
          "cefr_level": "A1",
          "word_slugs": [
            "bagnato-adj"
          ]
        },
        {
          "id": "13140311",
          "text": "Ero completamente bagnato.",
          "translation": "Я был насквозь мокрый.",
          "source": "Tatoeba #13140311 @dnnywld / #13139203 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13140311",
          "cefr_level": "A1",
          "word_slugs": [
            "bagnato-adj"
          ]
        },
        {
          "id": "819750",
          "text": "Ha bagnato il suo asciugamano con dell'acqua.",
          "translation": "Он намочил своё полотенце водой.",
          "source": "Tatoeba #819750 @Guybrush88 / #3174975 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/819750",
          "cefr_level": "A1",
          "word_slugs": [
            "bagnato-adj"
          ]
        },
        {
          "id": "5995612",
          "text": "Il prato è ancora troppo bagnato per falciarlo.",
          "translation": "Газон ещё слишком влажный, чтобы его косить.",
          "source": "Tatoeba #5995612 @dnnywld / #5995043 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5995612",
          "cefr_level": "A1",
          "word_slugs": [
            "bagnato-adj"
          ]
        },
        {
          "id": "5980938",
          "text": "Per favore, mettete l'ombrello bagnato in questa borsa.",
          "translation": "Мокрый зонт, пожалуйста, поместите в эту сумку.",
          "source": "Tatoeba #5980938 @dnnywld / #3604587 @Korvin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980938",
          "cefr_level": "A1",
          "word_slugs": [
            "bagnato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il bagnato",
        "plural": "",
        "infinitive": ""
      }
