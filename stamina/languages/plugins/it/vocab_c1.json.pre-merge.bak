    {
      "slug": "dissero-verb",
      "lemma": "dissero",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6258,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6921518",
          "text": "Così dissero negli anni sessanta.",
          "translation": "Так в шестидесятые годы говорили.",
          "source": "Tatoeba #6921518 @dnnywld / #6921271 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6921518",
          "cefr_level": "A1",
          "word_slugs": [
            "dissero-verb"
          ]
        },
        {
          "id": "6589275",
          "text": "Tom e Mary dissero di essere eccitati.",
          "translation": "Том и Мэри сказали, что они были взволнованы.",
          "source": "Tatoeba #6589275 @dnnywld / #6588629 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6589275",
          "cefr_level": "A1",
          "word_slugs": [
            "dissero-verb"
          ]
        },
        {
          "id": "6833436",
          "text": "Tom e Mary dissero di essere ottimisti.",
          "translation": "Том и Мэри сказали, что настроены оптимистично.",
          "source": "Tatoeba #6833436 @dnnywld / #6832904 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833436",
          "cefr_level": "A1",
          "word_slugs": [
            "dissero-verb"
          ]
        },
        {
          "id": "6573682",
          "text": "Tom e Mary dissero che avrebbero provato.",
          "translation": "Том и Мэри сказали, что попробуют.",
          "source": "Tatoeba #6573682 @Guybrush88 / #6832949 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6573682",
          "cefr_level": "A1",
          "word_slugs": [
            "dissero-verb"
          ]
        },
        {
          "id": "6833439",
          "text": "Tom e Mary dissero di non saper nuotare.",
          "translation": "Том и Мэри сказали, что не умеют плавать.",
          "source": "Tatoeba #6833439 @dnnywld / #6832902 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833439",
          "cefr_level": "A1",
          "word_slugs": [
            "dissero-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "dissero",
