    {
      "slug": "smette-verb",
      "lemma": "smette",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6527,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3676963",
          "text": "Non smette di piovere.",
          "translation": "Дождь не перестаёт.",
          "source": "Tatoeba #3676963 @Guybrush88 / #2650630 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3676963",
          "cefr_level": "A1",
          "word_slugs": [
            "smette-verb"
          ]
        },
        {
          "id": "6716819",
          "text": "Lui non smette di parlare.",
          "translation": "Он не перестаёт говорить.",
          "source": "Tatoeba #6716819 @dnnywld / #6712642 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6716819",
          "cefr_level": "A1",
          "word_slugs": [
            "smette-verb"
          ]
        },
        {
          "id": "5546349",
          "text": "Tom non smette mai di lamentarsi.",
          "translation": "Том не перестаёт жаловаться.",
          "source": "Tatoeba #5546349 @dnnywld / #5546267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5546349",
          "cefr_level": "A1",
          "word_slugs": [
            "smette-verb"
          ]
        },
        {
          "id": "6911243",
          "text": "Il gatto non smette di dialogare.",
          "translation": "Кот не перестаёт мяукать.",
          "source": "Tatoeba #6911243 @dnnywld / #6910828 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6911243",
          "cefr_level": "A1",
          "word_slugs": [
            "smette-verb"
          ]
        },
        {
          "id": "2218573",
          "text": "Giochiamo a baseball quando smette di piovere.",
          "translation": "Давай поиграем в бейсбол, когда дождь кончится.",
          "source": "Tatoeba #2218573 @Guybrush88 / #3631937 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2218573",
          "cefr_level": "A1",
          "word_slugs": [
            "smette-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "smette",
        "plural": "",
        "infinitive": "smette"
      }
