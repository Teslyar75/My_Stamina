    {
      "slug": "suggerimento-noun",
      "lemma": "suggerimento",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8086,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1264106",
          "text": "Ho un suggerimento.",
          "translation": "У меня есть предложение.",
          "source": "Tatoeba #1264106 @Guybrush88 / #819192 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1264106",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerimento-noun"
          ]
        },
        {
          "id": "6891398",
          "text": "Posso dare un suggerimento?",
          "translation": "Я могу внести предложение?",
          "source": "Tatoeba #6891398 @dnnywld / #2905793 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891398",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerimento-noun"
          ]
        },
        {
          "id": "6147299",
          "text": "Vorrei fare un suggerimento.",
          "translation": "Я хотел бы внести предложение.",
          "source": "Tatoeba #6147299 @Guybrush88 / #4159403 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6147299",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerimento-noun"
          ]
        },
        {
          "id": "5617478",
          "text": "Avete qualche altro suggerimento?",
          "translation": "У вас есть какие-нибудь другие предложения?",
          "source": "Tatoeba #5617478 @dnnywld / #4136028 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5617478",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerimento-noun"
          ]
        },
        {
          "id": "5617508",
          "text": "Qualcuno ha qualche suggerimento?",
          "translation": "У кого-нибудь есть какие-нибудь предложения?",
          "source": "Tatoeba #5617508 @dnnywld / #4766864 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5617508",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerimento-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
