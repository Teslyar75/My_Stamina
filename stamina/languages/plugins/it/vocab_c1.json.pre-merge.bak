    {
      "slug": "venivano-verb",
      "lemma": "venivano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5503,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "14082742",
          "text": "Gli schiavi venivano scambiati e venduti come bestiame.",
          "translation": "Рабов меняли и продавали как скот.",
          "source": "Tatoeba #14082742 @carlosalberto / #14082644 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14082742",
          "cefr_level": "A1",
          "word_slugs": [
            "venivano-verb"
          ]
        },
        {
          "id": "6845385",
          "text": "I miei genitori venivano costantemente convocati a scuola.",
          "translation": "Моих родителей постоянно вызывали в школу.",
          "source": "Tatoeba #6845385 @dnnywld / #6844750 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845385",
          "cefr_level": "A1",
          "word_slugs": [
            "venivano-verb"
          ]
        },
        {
          "id": "6843040",
          "text": "Loro mi venivano a trovare di tanto in tanto.",
          "translation": "Они навещали меня время от времени.",
          "source": "Tatoeba #6843040 @dnnywld / #4056391 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843040",
          "cefr_level": "A1",
          "word_slugs": [
            "venivano-verb"
          ]
        },
        {
          "id": "14082701",
          "text": "Gli schiavi venivano puniti con estrema severità per la minima infrazione.",
          "translation": "Рабов жестоко наказывали за малейшую провинность.",
          "source": "Tatoeba #14082701 @carlosalberto / #14082645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14082701",
          "cefr_level": "A1",
          "word_slugs": [
            "venivano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "venivano",
        "plural": "",
        "infinitive": "venivano"
      }
    },
