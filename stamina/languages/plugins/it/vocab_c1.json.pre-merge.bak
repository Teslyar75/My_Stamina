          ]
        },
        {
          "id": "5845235",
          "text": "Utilizza correttamente il tuo tempo.",
          "translation": "Используй своё время правильно.",
          "source": "Tatoeba #5845235 @dnnywld / #4552501 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845235",
