    {
      "slug": "vergogno-verb",
      "lemma": "vergogno",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6379,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1441541",
          "text": "Mi vergogno troppo.",
          "translation": "Мне слишком стыдно.",
          "source": "Tatoeba #1441541 @Guybrush88 / #3241085 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1441541",
          "cefr_level": "A1",
          "word_slugs": [
            "vergogno-verb"
          ]
        },
        {
          "id": "7490537",
          "text": "Mi vergogno di mio figlio.",
          "translation": "Мне стыдно за своего сына.",
          "source": "Tatoeba #7490537 @dnnywld / #7490347 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7490537",
          "cefr_level": "A1",
          "word_slugs": [
            "vergogno-verb"
          ]
        },
        {
          "id": "5569745",
          "text": "Non mi vergogno della povertà di mio padre.",
          "translation": "Я не стыжусь бедности своего отца.",
          "source": "Tatoeba #5569745 @dnnywld / #5569688 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5569745",
          "cefr_level": "A1",
          "word_slugs": [
            "vergogno-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "vergogno",
        "plural": "",
        "infinitive": "vergogno"
      }
