    {
      "slug": "degno-adj",
      "lemma": "degno",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5950,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6790738",
          "text": "Tuttavia, l'argomento è degno di una discussione.",
          "translation": "Тем не менее, тема достойна обсуждения.",
          "source": "Tatoeba #6790738 @dnnywld / #1573969 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790738",
          "cefr_level": "A1",
          "word_slugs": [
            "degno-adj"
          ]
        },
        {
          "id": "6894263",
          "text": "Tom è l'unico degno candidato per questo posto.",
          "translation": "Том — единственный достойный кандидат на эту должность.",
          "source": "Tatoeba #6894263 @dnnywld / #6893692 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6894263",
          "cefr_level": "A1",
          "word_slugs": [
            "degno-adj"
          ]
        },
        {
          "id": "10790840",
          "text": "Niente di ciò che va dicendo è degno di attenzione.",
          "translation": "Ничего из того, что он говорит, не стоит внимания.",
          "source": "Tatoeba #10790840 @dnnywld / #10790635 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790840",
          "cefr_level": "A1",
          "word_slugs": [
            "degno-adj"
          ]
        }
      ],
      "tags": [
