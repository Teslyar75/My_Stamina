      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4173566",
          "text": "Internet è un labirinto.",
          "translation": "Интернет - это лабиринт.",
          "source": "Tatoeba #4173566 @Guybrush88 / #4173572 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4173566",
          "cefr_level": "A1",
          "word_slugs": [
            "labirinto-noun"
          ]
        },
        {
          "id": "4802970",
          "text": "Mi sono perso nel labirinto.",
          "translation": "Я заблудился в лабиринте.",
          "source": "Tatoeba #4802970 @Guybrush88 / #6927221 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4802970",
          "cefr_level": "A1",
          "word_slugs": [
            "labirinto-noun"
          ]
        },
        {
          "id": "4802972",
          "text": "Mi sono persa nel labirinto.",
          "translation": "Я заблудилась в лабиринте.",
          "source": "Tatoeba #4802972 @Guybrush88 / #6927222 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4802972",
          "cefr_level": "A1",
          "word_slugs": [
            "labirinto-noun"
          ]
        },
        {
          "id": "10870880",
          "text": "Per una persona esperta un labirinto è come una galleria.",
          "translation": "Для опытного человека и лабиринт - как галерея.",
          "source": "Tatoeba #10870880 @dnnywld / #3262980 @Abeotat1948 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10870880",
          "cefr_level": "A1",
          "word_slugs": [
            "labirinto-noun"
          ]
        },
        {
          "id": "10801709",
          "text": "L'uscita del labirinto è lì dove c'è l'entrata.",
          "translation": "Выход из лабиринта там же, где вход.",
          "source": "Tatoeba #10801709 @dnnywld / #10801595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10801709",
          "cefr_level": "A1",
          "word_slugs": [
            "labirinto-noun"
          ]
        }
      ],
      "tags": [
