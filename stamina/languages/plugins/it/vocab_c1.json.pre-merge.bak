          ]
        },
        {
          "id": "5555742",
          "text": "Quando li avete comprati?",
          "translation": "Когда Вы их купили?",
          "source": "Tatoeba #5555742 @dnnywld / #5554931 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5555742",
          "cefr_level": "A1",
