    {
      "slug": "liquido-adj",
      "lemma": "liquido",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5731,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7748497",
          "text": "Lui beve molto liquido.",
          "translation": "Он пьёт много жидкости.",
          "source": "Tatoeba #7748497 @dnnywld / #7748376 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7748497",
          "cefr_level": "A1",
          "word_slugs": [
            "liquido-adj"
          ]
        },
        {
          "id": "379648",
          "text": "L'acqua è un liquido.",
          "translation": "Вода — это жидкость.",
          "source": "Tatoeba #379648 @Pharamp / #744516 @jonnywalker (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379648",
          "cefr_level": "A1",
          "word_slugs": [
            "liquido-adj"
          ]
        },
        {
          "id": "1827103",
          "text": "La benzina è un liquido infiammabile.",
          "translation": "Бензин - горючая жидкость.",
          "source": "Tatoeba #1827103 @rado / #1827105 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1827103",
          "cefr_level": "A1",
          "word_slugs": [
            "liquido-adj"
          ]
        },
        {
          "id": "6219062",
          "text": "Questa sostanza sta passando dallo stato liquido a quello gassoso.",
          "translation": "Это вещество переходит из жидкого состояния в газообразное.",
          "source": "Tatoeba #6219062 @dnnywld / #6218703 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6219062",
          "cefr_level": "A1",
          "word_slugs": [
            "liquido-adj"
          ]
        },
        {
          "id": "6033782",
          "text": "Al posto dell'inchiostro, nel flacone c'era uno strano liquido.",
          "translation": "Вместо туши во флаконе была какая-то странная жидкость.",
          "source": "Tatoeba #6033782 @dnnywld / #1337138 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6033782",
          "cefr_level": "A1",
          "word_slugs": [
            "liquido-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il liquido",
        "plural": "",
