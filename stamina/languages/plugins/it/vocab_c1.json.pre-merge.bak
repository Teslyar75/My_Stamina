    {
      "slug": "addormentata-verb",
      "lemma": "addormentata",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6587,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2455520",
          "text": "Mi sono addormentata?",
          "translation": "Я заснула?",
          "source": "Tatoeba #2455520 @Guybrush88 / #2798945 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2455520",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentata-verb"
          ]
        },
        {
          "id": "3659478",
          "text": "Mi sono addormentata sulla sua spalla.",
          "translation": "Я уснула у него на плече.",
          "source": "Tatoeba #3659478 @Guybrush88 / #4956410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3659478",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentata-verb"
          ]
        },
        {
          "id": "5389015",
          "text": "Mary si è addormentata a metà film.",
          "translation": "Мэри уснула на середине фильма.",
          "source": "Tatoeba #5389015 @dnnywld / #5388987 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389015",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentata-verb"
          ]
        },
        {
          "id": "2155794",
          "text": "Appena arrivata a casa mi sono addormentata.",
          "translation": "Сразу после возвращения домой я заснула.",
          "source": "Tatoeba #2155794 @marioparcia / #2083567 @sinichka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2155794",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentata-verb"
          ]
        },
        {
          "id": "5614114",
          "text": "Mi si è addormentata la mano. Sai come rivitalizzarla?",
          "translation": "У меня рука затекла. Не знаешь, как её расшевелить?",
          "source": "Tatoeba #5614114 @dnnywld / #5612867 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614114",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentata-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il addormentata",
        "plural": "",
        "infinitive": "addormentata"
      }
    },
