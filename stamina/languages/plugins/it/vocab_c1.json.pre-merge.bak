      "frequency_rank": 7945,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5506740",
          "text": "Che commento maleducato!",
          "translation": "Какой грубый комментарий!",
          "source": "Tatoeba #5506740 @dnnywld / #5506225 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506740",
          "cefr_level": "A1",
          "word_slugs": [
            "maleducato-adj"
          ]
        },
        {
          "id": "6904566",
          "text": "Tom si è comportato da maleducato.",
          "translation": "Том повёл себя бестактно.",
          "source": "Tatoeba #6904566 @dnnywld / #5682606 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904566",
          "cefr_level": "A1",
          "word_slugs": [
            "maleducato-adj"
          ]
        },
        {
          "id": "5495878",
          "text": "Questo maleducato non ha nemmeno salutato.",
          "translation": "Этот невежа даже не поздоровался.",
          "source": "Tatoeba #5495878 @dnnywld / #5495666 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5495878",
          "cefr_level": "A1",
          "word_slugs": [
            "maleducato-adj"
          ]
        },
        {
          "id": "5811558",
          "text": "Lui è un maleducato, per non dire grezzo.",
          "translation": "Он невоспитанный, если не сказать грубый.",
          "source": "Tatoeba #5811558 @dnnywld / #5811410 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5811558",
          "cefr_level": "A1",
          "word_slugs": [
            "maleducato-adj"
          ]
        }
      ],
      "tags": [
