    {
      "slug": "israele-name",
      "lemma": "Israele",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7343,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "Израиль"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2573704",
          "text": "Vengo da Israele.",
          "translation": "Я из Израиля.",
          "source": "Tatoeba #2573704 @Guybrush88 / #3421018 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2573704",
          "cefr_level": "A1",
          "word_slugs": [
            "israele-name"
          ]
        },
        {
          "id": "2573705",
          "text": "Io vengo da Israele.",
          "translation": "Я из Израиля.",
          "source": "Tatoeba #2573705 @Guybrush88 / #3421018 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2573705",
          "cefr_level": "A1",
          "word_slugs": [
            "israele-name"
          ]
        },
        {
          "id": "3249178",
          "text": "Sono nato in Israele.",
          "translation": "Я родился в Израиле.",
          "source": "Tatoeba #3249178 @Ricardo14 / #3249183 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3249178",
          "cefr_level": "A1",
          "word_slugs": [
            "israele-name"
          ]
        },
        {
          "id": "3003881",
          "text": "L'Iran attaccherà Israele?",
          "translation": "Иран нападёт на Израиль?",
          "source": "Tatoeba #3003881 @Guybrush88 / #3620613 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3003881",
          "cefr_level": "A1",
          "word_slugs": [
            "israele-name"
          ]
        },
        {
          "id": "3545553",
          "text": "Gerusalemme è la capitale di Israele.",
          "translation": "Иерусалим - это столица Израиля.",
          "source": "Tatoeba #3545553 @Guybrush88 / #2638916 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3545553",
          "cefr_level": "A1",
          "word_slugs": [
            "israele-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il Israele",
        "plural": "",
