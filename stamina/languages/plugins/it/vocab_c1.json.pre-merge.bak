      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10798389",
          "text": "Hai aggiunto il sale?",
          "translation": "Ты добавил соль?",
          "source": "Tatoeba #10798389 @dnnywld / #4587078 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10798389",
          "cefr_level": "A1",
