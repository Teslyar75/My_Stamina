          ]
        },
        {
          "id": "6874516",
          "text": "Io e Mary ci siamo fidanzati.",
          "translation": "Мы с Мэри обручились.",
          "source": "Tatoeba #6874516 @dnnywld / #6862466 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6874516",
          "cefr_level": "A1",
          "word_slugs": [
            "fidanzati-adj"
          ]
        },
        {
          "id": "6906079",
          "text": "Tom e Mary sono già fidanzati.",
