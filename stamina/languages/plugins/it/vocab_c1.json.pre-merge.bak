    {
      "slug": "fossa-noun",
      "lemma": "fossa",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5786,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10993203",
          "text": "La fossa era riempita a metà.",
          "translation": "Траншея была наполовину засыпана.",
          "source": "Tatoeba #10993203 @dnnywld / #10993185 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10993203",
          "cefr_level": "A1",
          "word_slugs": [
            "fossa-noun"
          ]
        },
        {
          "id": "6100620",
          "text": "Voglio che tu scavi una fossa.",
          "translation": "Я хочу, чтобы ты выкопал яму.",
          "source": "Tatoeba #6100620 @dnnywld / #6100615 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6100620",
          "cefr_level": "A1",
          "word_slugs": [
            "fossa-noun"
          ]
        },
        {
          "id": "6829930",
          "text": "Il ragazzino scavò una fossa per l'animale morto.",
          "translation": "Мальчик выкопал могилу для мёртвого животного.",
          "source": "Tatoeba #6829930 @dnnywld / #6829818 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6829930",
          "cefr_level": "A1",
          "word_slugs": [
            "fossa-noun"
          ]
        },
        {
          "id": "5402121",
          "text": "Anche un cieco non cade due volte nella stessa fossa.",
          "translation": "Даже слепой два раза в одну и ту же яму не падает.",
          "source": "Tatoeba #5402121 @dnnywld / #5401276 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5402121",
          "cefr_level": "A1",
          "word_slugs": [
            "fossa-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la fossa",
        "plural": "",
        "infinitive": ""
      }
    },
