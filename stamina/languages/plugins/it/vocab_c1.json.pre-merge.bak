    {
      "slug": "depressione-noun",
      "lemma": "depressione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5919,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6795725",
          "text": "Ho la depressione.",
          "translation": "У меня депрессия.",
          "source": "Tatoeba #6795725 @dnnywld / #6794132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6795725",
          "cefr_level": "A1",
          "word_slugs": [
            "depressione-noun"
          ]
        },
        {
          "id": "5482270",
          "text": "Tom soffre di depressione.",
          "translation": "Том страдал депрессией.",
          "source": "Tatoeba #5482270 @dnnywld / #5481828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5482270",
          "cefr_level": "A1",
          "word_slugs": [
            "depressione-noun"
          ]
        },
        {
          "id": "6361561",
          "text": "Tom dice di avere la depressione.",
          "translation": "Том говорит, что у него депрессия.",
          "source": "Tatoeba #6361561 @dnnywld / #6361294 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361561",
          "cefr_level": "A1",
          "word_slugs": [
            "depressione-noun"
          ]
        },
        {
          "id": "653669",
          "text": "Soffro di depressione durante l'inverno.",
          "translation": "Зимой я страдаю от депрессии.",
          "source": "Tatoeba #653669 @Guybrush88 / #1835018 @Tavat (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/653669",
          "cefr_level": "A1",
          "word_slugs": [
            "depressione-noun"
          ]
        },
        {
          "id": "5591159",
          "text": "Ogni tanto lei viene colta dalla depressione.",
          "translation": "На неё иногда находит депрессия.",
          "source": "Tatoeba #5591159 @dnnywld / #5590924 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591159",
          "cefr_level": "A1",
          "word_slugs": [
            "depressione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la depressione",
        "plural": "",
        "infinitive": ""
      }
