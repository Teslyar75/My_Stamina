    {
      "slug": "ristoranti-noun",
      "lemma": "ristoranti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7755,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6176743",
          "text": "Ci sono molti ristoranti cinesi a Boston?",
          "translation": "В Бостоне много китайских ресторанов?",
          "source": "Tatoeba #6176743 @Guybrush88 / #6176784 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6176743",
          "cefr_level": "A1",
          "word_slugs": [
            "ristoranti-noun"
          ]
        },
        {
          "id": "7639828",
          "text": "Non va a costruire ristoranti in Romania.",
          "translation": "Он не едет строить рестораны в Румынии.",
          "source": "Tatoeba #7639828 @Guybrush88 / #11604070 @tart_tatten (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7639828",
          "cefr_level": "A1",
          "word_slugs": [
            "ristoranti-noun"
          ]
        },
        {
          "id": "5624318",
          "text": "Qui a Boston abbiamo molti buoni ristoranti.",
          "translation": "У нас здесь в Бостоне много хороших ресторанов.",
          "source": "Tatoeba #5624318 @dnnywld / #5623450 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624318",
          "cefr_level": "A1",
          "word_slugs": [
            "ristoranti-noun"
          ]
        },
        {
          "id": "6883019",
          "text": "Tom lavora in uno dei ristoranti più famosi della città.",
          "translation": "Том работает в одном из самых известных ресторанов города.",
          "source": "Tatoeba #6883019 @dnnywld / #6882318 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883019",
          "cefr_level": "A1",
          "word_slugs": [
            "ristoranti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ristoranti",
        "plural": "",
        "infinitive": ""
      }
