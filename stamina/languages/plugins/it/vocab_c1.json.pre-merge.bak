    {
      "slug": "sorprendente-adj",
      "lemma": "sorprendente",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5798,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "удивляет"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2687009",
          "text": "Quello è sorprendente.",
          "translation": "Это удивительно.",
          "source": "Tatoeba #2687009 @Guybrush88 / #567336 @Disconnect (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2687009",
          "cefr_level": "A1",
          "word_slugs": [
            "sorprendente-adj"
          ]
        },
        {
          "id": "6853196",
          "text": "La somiglianza era sorprendente.",
          "translation": "Сходство было разительное.",
          "source": "Tatoeba #6853196 @dnnywld / #6850166 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853196",
          "cefr_level": "A1",
          "word_slugs": [
            "sorprendente-adj"
          ]
        },
        {
          "id": "5663813",
          "text": "Questo non è affatto sorprendente.",
          "translation": "Это совсем не удивительно.",
          "source": "Tatoeba #5663813 @dnnywld / #5663743 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5663813",
          "cefr_level": "A1",
          "word_slugs": [
            "sorprendente-adj"
          ]
        },
        {
          "id": "6023529",
          "text": "L'attendeva una scoperta sorprendente.",
          "translation": "Его ждало удивительное открытие.",
          "source": "Tatoeba #6023529 @dnnywld / #6021947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6023529",
