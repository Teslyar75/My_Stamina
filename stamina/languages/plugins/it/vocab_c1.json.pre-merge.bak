    {
      "slug": "nido-noun",
      "lemma": "nido",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5803,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10876152",
          "text": "Questo è un nido.",
          "translation": "Это гнездо.",
          "source": "Tatoeba #10876152 @dnnywld / #9184720 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10876152",
          "cefr_level": "A1",
          "word_slugs": [
            "nido-noun"
          ]
        },
        {
          "id": "5628798",
          "text": "Il nido è caduto dall'albero.",
          "translation": "Гнездо упало с дерева.",
          "source": "Tatoeba #5628798 @dnnywld / #5628735 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5628798",
          "cefr_level": "A1",
          "word_slugs": [
            "nido-noun"
          ]
        },
        {
          "id": "6786372",
          "text": "Tutti i bambini un giorno lasciano il nido.",
          "translation": "Все дети однажды покидают гнездо.",
          "source": "Tatoeba #6786372 @dnnywld / #3989791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786372",
          "cefr_level": "A1",
          "word_slugs": [
            "nido-noun"
          ]
        },
        {
          "id": "6062606",
          "text": "Penso che questo uccellino sia caduto dal nido.",
          "translation": "Я думаю, что эта птичка упала из гнезда.",
          "source": "Tatoeba #6062606 @dnnywld / #6061424 @sergiomelo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6062606",
          "cefr_level": "A1",
          "word_slugs": [
            "nido-noun"
          ]
        },
        {
          "id": "5781230",
          "text": "Tom ha salvato il pulcino che era caduto dal nido.",
          "translation": "Том спас птенца, который выпал из гнезда.",
          "source": "Tatoeba #5781230 @dnnywld / #5781223 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5781230",
          "cefr_level": "A1",
          "word_slugs": [
            "nido-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il nido",
        "plural": "",
        "infinitive": ""
      }
    },
