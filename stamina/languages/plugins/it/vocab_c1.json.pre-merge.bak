    {
      "slug": "alimentare-adj",
      "lemma": "alimentare",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7268,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6484892",
          "text": "Tom tiene un diario alimentare.",
          "translation": "Том ведёт дневник питания.",
          "source": "Tatoeba #6484892 @dnnywld / #6484638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6484892",
          "cefr_level": "A1",
          "word_slugs": [
            "alimentare-adj"
          ]
        },
        {
          "id": "6886144",
          "text": "Tom è morto per un'intossicazione alimentare.",
          "translation": "Том умер от пищевого отравления.",
          "source": "Tatoeba #6886144 @dnnywld / #6886036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886144",
          "cefr_level": "A1",
          "word_slugs": [
            "alimentare-adj"
          ]
        },
        {
          "id": "6949968",
          "text": "Alghe e plancton sono alla base della catena alimentare.",
          "translation": "Водоросли и планктон находятся на дне пищевой цепи.",
          "source": "Tatoeba #6949968 @dnnywld / #5324462 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6949968",
          "cefr_level": "A1",
          "word_slugs": [
            "alimentare-adj"
          ]
        }
      ],
