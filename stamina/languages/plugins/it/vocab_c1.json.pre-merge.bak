          ]
        },
        {
          "id": "7247058",
          "text": "Nessuno li ha chiamati qui.",
          "translation": "Их сюда никто не звал.",
          "source": "Tatoeba #7247058 @dnnywld / #7245023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7247058",
          "cefr_level": "A1",
          "word_slugs": [
            "chiamati-verb"
          ]
        },
        {
          "id": "7247056",
          "text": "E voi chi vi ha chiamati?",
