    {
      "slug": "cifre-noun",
      "lemma": "cifre",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6944,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5649499",
          "text": "Queste cifre mi fanno dubitare.",
          "translation": "Эти цифры вызывают у меня сомнения.",
          "source": "Tatoeba #5649499 @dnnywld / #5649144 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5649499",
          "cefr_level": "A1",
          "word_slugs": [
            "cifre-noun"
          ]
        },
        {
          "id": "6904978",
          "text": "Puoi portare delle cifre certe?",
          "translation": "Можешь привести конкретные цифры?",
          "source": "Tatoeba #6904978 @dnnywld / #6878408 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904978",
          "cefr_level": "A1",
          "word_slugs": [
            "cifre-noun"
          ]
        },
        {
          "id": "7453683",
          "text": "Questo è un numero di sei cifre.",
          "translation": "Это шестизначное число.",
          "source": "Tatoeba #7453683 @dnnywld / #7453609 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7453683",
          "cefr_level": "A1",
          "word_slugs": [
            "cifre-noun"
          ]
        },
        {
          "id": "10802527",
          "text": "Lui prende uno stipendio a sei cifre.",
          "translation": "Он получает шестизначную зарплату.",
          "source": "Tatoeba #10802527 @dnnywld / #10802045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10802527",
          "cefr_level": "A1",
          "word_slugs": [
            "cifre-noun"
          ]
        },
        {
          "id": "6904995",
          "text": "Potete portare delle prove, delle cifre e degli esempi?",
          "translation": "Можете привести доказательства, цифры, примеры?",
          "source": "Tatoeba #6904995 @dnnywld / #6878409 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904995",
          "cefr_level": "A1",
          "word_slugs": [
            "cifre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la cifre",
        "plural": "",
        "infinitive": ""
      }
