    {
      "slug": "colonia-noun",
      "lemma": "colonia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6489,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "12559820",
          "text": "Il Niger è un'ex colonia francese.",
          "translation": "Нигер - бывшая французская колония.",
          "source": "Tatoeba #12559820 @Guybrush88 / #4567423 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12559820",
          "cefr_level": "A1",
          "word_slugs": [
            "colonia-noun"
          ]
        },
        {
          "id": "5771258",
          "text": "In questa colonia lui dispone della vita e della morte.",
          "translation": "В этой колонии он распоряжается жизнью и смертью.",
          "source": "Tatoeba #5771258 @dnnywld / #5771020 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5771258",
          "cefr_level": "A1",
          "word_slugs": [
            "colonia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la colonia",
        "plural": "",
        "infinitive": ""
      }
    },
