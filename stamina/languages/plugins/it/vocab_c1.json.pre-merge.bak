      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "Венера"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5616139",
          "text": "Venere è un pianeta.",
          "translation": "Венера — планета.",
          "source": "Tatoeba #5616139 @dnnywld / #5615865 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616139",
          "cefr_level": "A1",
          "word_slugs": [
            "venere-name"
          ]
        },
        {
          "id": "1547022",
          "text": "È possibile vedere Venere stanotte?",
          "translation": "Можно ли сегодня ночью увидеть Венеру?",
          "source": "Tatoeba #1547022 @chinro / #500668 @drnm2 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1547022",
          "cefr_level": "A1",
          "word_slugs": [
            "venere-name"
          ]
        },
        {
          "id": "5426815",
          "text": "Venere è più luminoso di Giove.",
          "translation": "Венера ярче Юпитера.",
          "source": "Tatoeba #5426815 @dnnywld / #4318209 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5426815",
          "cefr_level": "A1",
          "word_slugs": [
            "venere-name"
          ]
        },
        {
          "id": "5597941",
          "text": "Venere è il secondo pianeta a partire dal sole.",
          "translation": "Венера — вторая по счёту планета от Солнца.",
          "source": "Tatoeba #5597941 @dnnywld / #5597865 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5597941",
          "cefr_level": "A1",
          "word_slugs": [
            "venere-name"
          ]
        }
      ],
