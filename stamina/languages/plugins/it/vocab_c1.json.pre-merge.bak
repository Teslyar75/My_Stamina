    {
      "slug": "prossime-adj",
      "lemma": "prossime",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5644,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5655370",
          "text": "Probabilmente lui vincerà la prossime elezioni.",
          "translation": "Он, вероятно, выиграет следующие выборы.",
          "source": "Tatoeba #5655370 @dnnywld / #5655159 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5655370",
          "cefr_level": "A1",
          "word_slugs": [
            "prossime-adj"
          ]
        },
        {
          "id": "13071001",
          "text": "Dove e quando si terranno le prossime prove?",
          "translation": "Где и когда пройдут следующие испытания?",
          "source": "Tatoeba #13071001 @dnnywld / #13070894 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13071001",
          "cefr_level": "A1",
          "word_slugs": [
            "prossime-adj"
          ]
        },
        {
          "id": "5591882",
          "text": "Chi secondo te vincerà le prossime elezioni presidenziali negli USA?",
          "translation": "Кто, по-твоему, победит на следующих президентских выборах в США?",
          "source": "Tatoeba #5591882 @dnnywld / #5591447 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591882",
          "cefr_level": "A1",
          "word_slugs": [
            "prossime-adj"
          ]
        },
        {
          "id": "5591867",
          "text": "Chi secondo voi vincerà le prossime elezioni presidenziali negli USA?",
          "translation": "Кто, по-вашему, победит на следующих президентских выборах в США?",
          "source": "Tatoeba #5591867 @dnnywld / #5591446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591867",
          "cefr_level": "A1",
          "word_slugs": [
            "prossime-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il prossime",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "muri-noun",
      "lemma": "muri",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5645,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6841562",
          "text": "È come se stessi parlando ai muri.",
          "translation": "Я как будто со стеной разговариваю.",
          "source": "Tatoeba #6841562 @dnnywld / #3710283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841562",
          "cefr_level": "A1",
          "word_slugs": [
            "muri-noun"
          ]
        },
        {
          "id": "7774270",
          "text": "Dal russare di Tom tremavano i muri.",
          "translation": "От храпа Тома дрожали стены.",
          "source": "Tatoeba #7774270 @dnnywld / #7774181 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7774270",
          "cefr_level": "A1",
          "word_slugs": [
            "muri-noun"
          ]
        },
        {
          "id": "7774269",
          "text": "Tom russava talmente che i muri tremavano.",
          "translation": "Том храпел так, что стены дрожали.",
          "source": "Tatoeba #7774269 @dnnywld / #7774182 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7774269",
          "cefr_level": "A1",
          "word_slugs": [
            "muri-noun"
          ]
        },
        {
          "id": "6967485",
          "text": "I muri hanno orecchi e gli shōji occhi.",
          "translation": "Стены имеют уши, а сёдзи - глаза.",
          "source": "Tatoeba #6967485 @dnnywld / #370853 @reiji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6967485",
          "cefr_level": "A1",
          "word_slugs": [
            "muri-noun"
          ]
        },
        {
          "id": "6864154",
          "text": "Il gigante dormiva e russava così tanto che tremavano i muri.",
          "translation": "Великан спал и храпел так, что стены тряслись.",
          "source": "Tatoeba #6864154 @dnnywld / #6863509 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6864154",
          "cefr_level": "A1",
          "word_slugs": [
            "muri-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il muri",
        "plural": "",
        "infinitive": ""
      }
    },
