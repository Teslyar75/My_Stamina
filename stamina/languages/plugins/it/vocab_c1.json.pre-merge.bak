    {
      "slug": "disperazione-noun",
      "lemma": "disperazione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7141,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7583648",
          "text": "Era un atto di disperazione.",
          "translation": "Это был акт отчаяния.",
          "source": "Tatoeba #7583648 @Guybrush88 / #4597485 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7583648",
          "cefr_level": "A1",
          "word_slugs": [
            "disperazione-noun"
          ]
        },
        {
          "id": "6895041",
          "text": "L'alcool mi ha portato alla disperazione assoluta.",
          "translation": "Алкоголь довёл меня до крайнего отчаяния.",
          "source": "Tatoeba #6895041 @dnnywld / #2937619 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6895041",
          "cefr_level": "A1",
          "word_slugs": [
            "disperazione-noun"
          ]
        },
        {
          "id": "5420806",
          "text": "Tom era nella più cupa disperazione quando il suo cane è scappato.",
          "translation": "Том был в полном отчаянии, когда его собака сбежала.",
          "source": "Tatoeba #5420806 @dnnywld / #2771426 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5420806",
          "cefr_level": "A1",
          "word_slugs": [
            "disperazione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
