    {
      "slug": "vernice-noun",
      "lemma": "vernice",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6079,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "4582564",
          "text": "Usa la vernice acrilica.",
          "translation": "Используй акриловую краску.",
          "source": "Tatoeba #4582564 @Guybrush88 / #5639317 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4582564",
          "cefr_level": "A1",
          "word_slugs": [
            "vernice-noun"
          ]
        },
        {
          "id": "4582565",
          "text": "Usate la vernice acrilica.",
          "translation": "Используйте акриловую краску.",
          "source": "Tatoeba #4582565 @Guybrush88 / #5639316 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4582565",
          "cefr_level": "A1",
          "word_slugs": [
            "vernice-noun"
          ]
        },
        {
          "id": "5412105",
          "text": "Hai della vernice addosso.",
          "translation": "Тут на тебе краска.",
          "source": "Tatoeba #5412105 @dnnywld / #3664348 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5412105",
          "cefr_level": "A1",
          "word_slugs": [
            "vernice-noun"
          ]
        },
        {
          "id": "5675964",
          "text": "Hai della vernice sul naso.",
          "translation": "У тебя на носу краска.",
          "source": "Tatoeba #5675964 @dnnywld / #5675267 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5675964",
          "cefr_level": "A1",
          "word_slugs": [
            "vernice-noun"
          ]
        },
        {
          "id": "5560179",
          "text": "Mescola la vernice con un bastone.",
