    {
      "slug": "ritengo-verb",
      "lemma": "ritengo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6217,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5646239",
          "text": "Faccio quello che ritengo giusto.",
          "translation": "Я сделаю то, что считаю правильным.",
          "source": "Tatoeba #5646239 @dnnywld / #5646200 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646239",
          "cefr_level": "A1",
          "word_slugs": [
            "ritengo-verb"
          ]
        },
        {
          "id": "5439431",
          "text": "Personalmente non ritengo questo un problema.",
          "translation": "Лично я не считаю это проблемой.",
          "source": "Tatoeba #5439431 @dnnywld / #5439352 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5439431",
          "cefr_level": "A1",
          "word_slugs": [
            "ritengo-verb"
          ]
        },
        {
          "id": "10754504",
          "text": "Ritengo che così la frase risuoni più naturale.",
          "translation": "Я считаю, предложение так будет звучать натуральнее.",
          "source": "Tatoeba #10754504 @dnnywld / #990009 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754504",
          "cefr_level": "A1",
          "word_slugs": [
            "ritengo-verb"
          ]
        },
        {
          "id": "5437521",
          "text": "Personalmente ritengo che assumere Tom sarebbe un errore.",
          "translation": "Лично я считаю, что брать на работу Тома было бы ошибкой.",
          "source": "Tatoeba #5437521 @dnnywld / #5436422 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5437521",
          "cefr_level": "A1",
          "word_slugs": [
            "ritengo-verb"
          ]
        },
        {
          "id": "10797251",
          "text": "Lo ritengo un buon sviluppatore, ma un cattivo supervisore.",
          "translation": "Я считаю, что он хороший разработчик, но плохой руководитель проекта.",
          "source": "Tatoeba #10797251 @dnnywld / #8151137 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10797251",
          "cefr_level": "A1",
          "word_slugs": [
            "ritengo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ritengo",
        "plural": "",
        "infinitive": "ritengo"
      }
    },
    {
