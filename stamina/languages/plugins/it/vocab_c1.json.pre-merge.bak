          "word_slugs": [
            "meritava-verb"
          ]
        },
        {
          "id": "12381356",
          "text": "Non meritava di morire.",
          "translation": "Он не заслуживал смерти.",
          "source": "Tatoeba #12381356 @Guybrush88 / #3928729 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12381356",
          "cefr_level": "A1",
          "word_slugs": [
            "meritava-verb"
          ]
        },
        {
          "id": "5800647",
          "text": "E allora lui avuto quello che si meritava!",
          "translation": "Ну и досталось же ему тогда на орехи!",
          "source": "Tatoeba #5800647 @dnnywld / #5800345 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5800647",
          "cefr_level": "A1",
          "word_slugs": [
            "meritava-verb"
          ]
        }
