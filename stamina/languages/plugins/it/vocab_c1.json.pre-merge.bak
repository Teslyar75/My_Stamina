      "examples": [
        {
          "id": "1455652",
          "text": "Sono un monaco.",
          "translation": "Я монах.",
          "source": "Tatoeba #1455652 @Guybrush88 / #1456498 @Pikkolo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1455652",
          "cefr_level": "A1",
