    {
      "slug": "pregato-adj",
      "lemma": "pregato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6304,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5766112",
          "text": "Ho pregato per te.",
          "translation": "Я молился за тебя.",
          "source": "Tatoeba #5766112 @Guybrush88 / #11827543 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5766112",
          "cefr_level": "A1",
          "word_slugs": [
            "pregato-adj"
          ]
        },
        {
          "id": "4556321",
          "text": "Tom non ha pregato.",
          "translation": "Том не молился.",
          "source": "Tatoeba #4556321 @Guybrush88 / #6009113 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4556321",
          "cefr_level": "A1",
          "word_slugs": [
            "pregato-adj"
          ]
        },
        {
          "id": "5766115",
          "text": "Ho pregato per voi.",
          "translation": "Я за вас молился.",
          "source": "Tatoeba #5766115 @Guybrush88 / #11827541 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5766115",
          "cefr_level": "A1",
          "word_slugs": [
            "pregato-adj"
          ]
        },
        {
          "id": "10832000",
          "text": "Abbiamo pregato Tom di non andarci.",
          "translation": "Мы умоляли Тома не ходить туда.",
          "source": "Tatoeba #10832000 @dnnywld / #2890333 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10832000",
          "cefr_level": "A1",
          "word_slugs": [
            "pregato-adj"
          ]
        },
        {
          "id": "5487385",
          "text": "Tom ha pregato perché Mary stesse meglio.",
          "translation": "Том молился о выздоровлении Мэри.",
          "source": "Tatoeba #5487385 @dnnywld / #5487212 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5487385",
          "cefr_level": "A1",
          "word_slugs": [
            "pregato-adj"
          ]
        }
      ],
