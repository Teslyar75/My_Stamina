          ]
        },
        {
          "id": "1688766",
          "text": "Sto cantando in berbero.",
          "translation": "Я пою на берберском языке.",
          "source": "Tatoeba #1688766 @Guybrush88 / #4753295 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1688766",
          "cefr_level": "A1",
          "word_slugs": [
