    {
      "slug": "scolastico-name",
      "lemma": "Scolastico",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6473,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10849682",
          "text": "L'autore critica il metodo scolastico.",
          "translation": "Автор критикует школьную систему.",
          "source": "Tatoeba #10849682 @dnnywld / #2985191 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849682",
          "cefr_level": "A1",
          "word_slugs": [
            "scolastico-name"
          ]
        },
        {
          "id": "749837",
          "text": "L'anno scolastico comincia il 10 aprile.",
          "translation": "Учебный год начинается 10 апреля.",
          "source": "Tatoeba #749837 @Guybrush88 / #614506 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/749837",
          "cefr_level": "A1",
          "word_slugs": [
            "scolastico-name"
          ]
        },
        {
          "id": "5921247",
          "text": "Oggi ho comprato un nuovo zainetto scolastico.",
          "translation": "Сегодня я купил новый школьный рюкзак.",
          "source": "Tatoeba #5921247 @dnnywld / #5920811 @AHuMELLIHuK (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5921247",
          "cefr_level": "A1",
          "word_slugs": [
            "scolastico-name"
          ]
        },
        {
          "id": "653791",
          "text": "In Giappone il nuovo anno scolastico comincia ad aprile.",
          "translation": "В Японии новый учебный год начинается в апреле.",
          "source": "Tatoeba #653791 @Guybrush88 / #446099 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/653791",
          "cefr_level": "A1",
          "word_slugs": [
            "scolastico-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
