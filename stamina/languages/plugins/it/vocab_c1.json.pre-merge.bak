    {
      "slug": "corsi-adj",
      "lemma": "corsi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5840,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5512106",
          "text": "Sono corsi nudi per strada.",
          "translation": "Они пробежали по улицам голышом.",
          "source": "Tatoeba #5512106 @dnnywld / #5511122 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512106",
          "cefr_level": "A1",
          "word_slugs": [
            "corsi-adj"
          ]
        },
        {
          "id": "6477869",
          "text": "Perché non siete corsi via?",
          "translation": "Что же вы не убежали?",
          "source": "Tatoeba #6477869 @dnnywld / #6477660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6477869",
          "cefr_level": "A1",
          "word_slugs": [
            "corsi-adj"
          ]
        },
        {
          "id": "896798",
          "text": "Tutti i ragazzi sono corsi via.",
          "translation": "Все мальчики убежали.",
          "source": "Tatoeba #896798 @matsuteo / #7610366 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/896798",
          "cefr_level": "A1",
          "word_slugs": [
            "corsi-adj"
          ]
        },
        {
          "id": "10852157",
          "text": "I corsi in Borsa sono caduti rapidamente.",
          "translation": "Цены на бирже резко упали.",
          "source": "Tatoeba #10852157 @dnnywld / #1476029 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10852157",
          "cefr_level": "A1",
          "word_slugs": [
            "corsi-adj"
          ]
        },
        {
          "id": "6955129",
          "text": "Perché mollti corsi di lingua sono inefficaci?",
          "translation": "Почему многие языковые курсы неэффективны?",
          "source": "Tatoeba #6955129 @dnnywld / #1908865 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6955129",
          "cefr_level": "A1",
          "word_slugs": [
            "corsi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
