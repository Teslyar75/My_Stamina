          ]
        },
        {
          "id": "6302265",
          "text": "Sta scendendo la nebbia.",
          "translation": "Туман опускается.",
          "source": "Tatoeba #6302265 @dnnywld / #4864935 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6302265",
          "cefr_level": "A1",
          "word_slugs": [
            "nebbia-noun"
          ]
        },
        {
          "id": "6167297",
          "text": "Laggiù, è nebbia o fumo?",
          "translation": "Там, внизу, туман или дым?",
          "source": "Tatoeba #6167297 @dnnywld / #6166831 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6167297",
          "cefr_level": "A1",
          "word_slugs": [
            "nebbia-noun"
          ]
        },
        {
          "id": "6714309",
          "text": "La nebbia non sta salendo.",
          "translation": "Туман не поднимается.",
          "source": "Tatoeba #6714309 @dnnywld / #6712685 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6714309",
          "cefr_level": "A1",
          "word_slugs": [
            "nebbia-noun"
          ]
        }
      ],
