          ]
        },
        {
          "id": "6917685",
          "text": "Tom si congratulò con Mary per il ricevimento del diploma.",
          "translation": "Том поздравил Мэри с получением диплома.",
          "source": "Tatoeba #6917685 @dnnywld / #4476486 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917685",
          "cefr_level": "A1",
          "word_slugs": [
            "diploma-noun"
          ]
        },
        {
          "id": "5495906",
          "text": "Il diplomante è una persona che viene premiata con un diploma.",
          "translation": "Дипломант — лицо, награжденное дипломом.",
          "source": "Tatoeba #5495906 @dnnywld / #5495661 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5495906",
          "cefr_level": "A1",
          "word_slugs": [
            "diploma-noun"
          ]
        }
      ],
