    {
      "slug": "ignorato-adj",
      "lemma": "ignorato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8762,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5884571",
          "text": "Ho ignorato Tom.",
          "translation": "Я проигнорировал Тома.",
          "source": "Tatoeba #5884571 @dnnywld / #5883872 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5884571",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorato-adj"
          ]
        },
        {
          "id": "5566486",
          "text": "Tom oggi mi ha ignorato.",
          "translation": "Том сегодня не обращал на меня внимания.",
          "source": "Tatoeba #5566486 @dnnywld / #5566355 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5566486",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorato-adj"
          ]
        },
        {
          "id": "3541489",
          "text": "Sono abituato ad essere ignorato.",
          "translation": "Я привык, что меня игнорируют.",
          "source": "Tatoeba #3541489 @Guybrush88 / #4920643 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3541489",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorato-adj"
          ]
        },
        {
          "id": "7764119",
          "text": "Lui mi ha completamente ignorato.",
          "translation": "Он меня полностью игнорировал.",
          "source": "Tatoeba #7764119 @dnnywld / #7764070 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7764119",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorato-adj"
          ]
        },
        {
          "id": "5385127",
          "text": "Lui ha ignorato tutti i rischi.",
          "translation": "Он пренебрёг всеми опасностями.",
          "source": "Tatoeba #5385127 @dnnywld / #5385097 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385127",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorato-adj"
          ]
        }
      ],
