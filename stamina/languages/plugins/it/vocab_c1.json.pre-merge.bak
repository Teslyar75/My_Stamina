    {
      "slug": "grido-noun",
      "lemma": "grido",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8725,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5566100",
          "text": "Tom sentì un grido.",
          "translation": "Том услышал крик.",
          "source": "Tatoeba #5566100 @dnnywld / #5564572 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5566100",
          "cefr_level": "A1",
          "word_slugs": [
            "grido-noun"
          ]
        },
        {
          "id": "5444777",
          "text": "Ho sentito un grido d'aiuto.",
          "translation": "Я услышал крик о помощи.",
          "source": "Tatoeba #5444777 @dnnywld / #5444698 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5444777",
          "cefr_level": "A1",
          "word_slugs": [
            "grido-noun"
          ]
        },
        {
          "id": "5444774",
          "text": "Ho sentito un grido di aiuto.",
          "translation": "Я слышал крик о помощи.",
          "source": "Tatoeba #5444774 @dnnywld / #5444700 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5444774",
          "cefr_level": "A1",
          "word_slugs": [
            "grido-noun"
          ]
        },
        {
          "id": "5557887",
          "text": "Dalla folla si levò un grido.",
          "translation": "Из толпы раздался крик.",
          "source": "Tatoeba #5557887 @dnnywld / #5557346 @clayrat (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5557887",
          "cefr_level": "A1",
          "word_slugs": [
            "grido-noun"
          ]
        },
        {
          "id": "7764185",
          "text": "L'asino ha un grido forte e sgradevole.",
          "translation": "У ишака громкий и неприятный крик.",
          "source": "Tatoeba #7764185 @dnnywld / #7763689 @Wayawa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7764185",
          "cefr_level": "A1",
          "word_slugs": [
            "grido-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
