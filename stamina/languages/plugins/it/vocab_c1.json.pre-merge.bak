    {
      "slug": "costosa-adj",
      "lemma": "costosa",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8642,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2714664",
          "text": "È molto costosa.",
          "translation": "Она очень дорогая.",
          "source": "Tatoeba #2714664 @Guybrush88 / #3415544 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2714664",
          "cefr_level": "A1",
          "word_slugs": [
            "costosa-adj"
          ]
        },
        {
          "id": "5964792",
          "text": "È piuttosta costosa.",
          "translation": "Она довольно дорогая.",
          "source": "Tatoeba #5964792 @dnnywld / #5964740 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964792",
          "cefr_level": "A1",
          "word_slugs": [
            "costosa-adj"
          ]
        },
        {
          "id": "2488218",
          "text": "La carne è costosa.",
          "translation": "Мясо дорогое.",
          "source": "Tatoeba #2488218 @Guybrush88 / #3492929 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2488218",
          "cefr_level": "A1",
          "word_slugs": [
            "costosa-adj"
          ]
        },
        {
          "id": "5964791",
          "text": "È una lampada piuttosto costosa.",
          "translation": "Это довольно дорогая лампа.",
          "source": "Tatoeba #5964791 @dnnywld / #5964741 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964791",
          "cefr_level": "A1",
          "word_slugs": [
            "costosa-adj"
          ]
        },
        {
          "id": "2260011",
          "text": "La vita è sempre più costosa.",
          "translation": "Жизнь всё дорожает.",
          "source": "Tatoeba #2260011 @Guybrush88 / #3505808 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2260011",
          "cefr_level": "A1",
          "word_slugs": [
            "costosa-adj"
          ]
        }
      ],
