    {
      "slug": "volato-verb",
      "lemma": "volato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8386,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3293841",
          "text": "Sono volato sopra le nuvole.",
          "translation": "Я летел над облаками.",
          "source": "Tatoeba #3293841 @Guybrush88 / #920050 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3293841",
          "cefr_level": "A1",
          "word_slugs": [
            "volato-verb"
          ]
        },
        {
          "id": "6378052",
          "text": "Fortunatamente abbiamo volato senza incidenti.",
          "translation": "К счастью, мы долетели без приключений.",
          "source": "Tatoeba #6378052 @dnnywld / #1758239 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6378052",
          "cefr_level": "A1",
          "word_slugs": [
            "volato-verb"
          ]
        },
        {
          "id": "1123977",
          "text": "Tom è volato a Boston ieri.",
          "translation": "Том вчера полетел в Бостон.",
          "source": "Tatoeba #1123977 @riccioberto / #5827811 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1123977",
          "cefr_level": "A1",
          "word_slugs": [
            "volato-verb"
          ]
        },
        {
          "id": "8984902",
          "text": "Hanno volato per l'intera galassia.",
          "translation": "Они облетели всю Галактику.",
          "source": "Tatoeba #8984902 @carlosalberto / #4513846 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8984902",
          "cefr_level": "A1",
          "word_slugs": [
            "volato-verb"
          ]
        },
        {
          "id": "5241987",
          "text": "Non ho mai volato in prima classe.",
          "translation": "Я никогда не летал первым классом.",
          "source": "Tatoeba #5241987 @Guybrush88 / #5242659 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5241987",
          "cefr_level": "A1",
          "word_slugs": [
            "volato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il volato",
