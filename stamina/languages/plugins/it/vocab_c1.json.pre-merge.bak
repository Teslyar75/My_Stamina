      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5396200",
          "text": "Le matite si vendono a dozzine.",
          "translation": "Карандаши продаются дюжинами.",
          "source": "Tatoeba #5396200 @dnnywld / #5396160 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5396200",
          "cefr_level": "A1",
          "word_slugs": [
            "dozzine-noun"
          ]
        },
        {
          "id": "10890187",
          "text": "Ordinare a dozzine è più economico.",
          "translation": "Дешевле заказывать дюжинами.",
          "source": "Tatoeba #10890187 @dnnywld / #1118385 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10890187",
          "cefr_level": "A1",
          "word_slugs": [
            "dozzine-noun"
          ]
        },
        {
          "id": "5494924",
          "text": "In Russia le uova sono vendute a decine a non a dozzine.",
          "translation": "В России яйца продаются десятками, а не дюжинами.",
          "source": "Tatoeba #5494924 @dnnywld / #5494468 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494924",
          "cefr_level": "A1",
          "word_slugs": [
            "dozzine-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
