    {
      "slug": "necessaria-adj",
      "lemma": "necessaria",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6179,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2350460",
          "text": "È necessaria un'amputazione.",
          "translation": "Требуется ампутация.",
          "source": "Tatoeba #2350460 @Guybrush88 / #886808 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2350460",
          "cefr_level": "A1",
          "word_slugs": [
            "necessaria-adj"
          ]
        },
        {
          "id": "1849089",
          "text": "Qui una mente vigile è necessaria.",
          "translation": "Здесь требуется живой ум.",
          "source": "Tatoeba #1849089 @al_ex_an_der / #1849088 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1849089",
          "cefr_level": "A1",
          "word_slugs": [
            "necessaria-adj"
          ]
        },
        {
          "id": "6390630",
          "text": "È necessaria una trasfusione di sangue.",
          "translation": "Требуется переливание крови.",
          "source": "Tatoeba #6390630 @Guybrush88 / #2569025 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6390630",
          "cefr_level": "A1",
          "word_slugs": [
            "necessaria-adj"
          ]
        },
        {
          "id": "3218440",
          "text": "La luce non è meno necessaria alle piante dell'acqua.",
          "translation": "Свет необходим растениям не меньше, чем вода.",
          "source": "Tatoeba #3218440 @Guybrush88 / #3216690 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3218440",
          "cefr_level": "A1",
          "word_slugs": [
            "necessaria-adj"
          ]
        },
        {
          "id": "7764180",
          "text": "In molti tipi di sport è necessaria una buona resistenza.",
          "translation": "Во многих видах спорта нужна хорошая выносливость.",
          "source": "Tatoeba #7764180 @dnnywld / #7763693 @Wayawa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7764180",
          "cefr_level": "A1",
          "word_slugs": [
            "necessaria-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il necessaria",
        "plural": "",
        "infinitive": ""
      }
