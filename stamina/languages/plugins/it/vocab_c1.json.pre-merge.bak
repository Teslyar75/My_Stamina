    {
      "slug": "guardaroba-noun",
      "lemma": "guardaroba",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9980,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5650113",
          "text": "Devo prima andare nel guardaroba.",
          "translation": "Я должен сначала пойти в гардероб.",
          "source": "Tatoeba #5650113 @dnnywld / #5649010 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650113",
          "cefr_level": "A1",
          "word_slugs": [
            "guardaroba-noun"
          ]
        },
        {
          "id": "6961222",
          "text": "Ho messo il soprabito nel guardaroba.",
          "translation": "Я сдала верхнюю одежду в гардероб.",
          "source": "Tatoeba #6961222 @dnnywld / #6960542 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961222",
          "cefr_level": "A1",
          "word_slugs": [
            "guardaroba-noun"
          ]
        },
        {
          "id": "5435752",
          "text": "Molti elementi del guardaroba maschile erano inizialmente usati dai militari.",
          "translation": "Многие элементы мужского гардероба первоначально использовались военными.",
          "source": "Tatoeba #5435752 @dnnywld / #4506915 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5435752",
          "cefr_level": "A1",
          "word_slugs": [
            "guardaroba-noun"
          ]
        }
      ],
