    {
      "slug": "filosofia-noun",
      "lemma": "filosofia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7156,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "13767591",
          "text": "Cos'è la filosofia?",
          "translation": "Что такое философия?",
          "source": "Tatoeba #13767591 @Adelpa / #3217135 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13767591",
          "cefr_level": "A1",
          "word_slugs": [
            "filosofia-noun"
          ]
        },
        {
          "id": "2450358",
          "text": "L'ideologia è l'ombra della filosofia.",
          "translation": "Идеология — это тень философии.",
          "source": "Tatoeba #2450358 @al_ex_an_der / #2450335 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2450358",
          "cefr_level": "A1",
          "word_slugs": [
            "filosofia-noun"
          ]
        },
        {
          "id": "5564176",
          "text": "La vostra filosofia spicciola mi ha nauseato.",
          "translation": "Меня тошнит от вашей грошовой философии.",
          "source": "Tatoeba #5564176 @dnnywld / #5563978 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5564176",
          "cefr_level": "A1",
          "word_slugs": [
            "filosofia-noun"
          ]
        },
        {
          "id": "1082285",
          "text": "La tua filosofia di vita è diversa dalla mia.",
          "translation": "Твоя жизненная философия отличается от моей.",
          "source": "Tatoeba #1082285 @Guybrush88 / #1222992 @poji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1082285",
          "cefr_level": "A1",
          "word_slugs": [
            "filosofia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la filosofia",
        "plural": "",
        "infinitive": ""
      }
