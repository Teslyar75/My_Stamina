      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7713752",
          "text": "Scrivi frasi brevi.",
          "translation": "Напиши короткие фразы.",
          "source": "Tatoeba #7713752 @Valdast / #6151350 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7713752",
          "cefr_level": "A1",
          "word_slugs": [
            "frasi-noun"
          ]
        },
        {
          "id": "10849525",
          "text": "Amo le frasi assurde.",
          "translation": "Люблю абсурдные предложения.",
          "source": "Tatoeba #10849525 @dnnywld / #4543685 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849525",
          "cefr_level": "A1",
          "word_slugs": [
            "frasi-noun"
          ]
        },
        {
          "id": "1217914",
          "text": "Devo tradurre le frasi.",
          "translation": "Я должен перевести эти предложения.",
          "source": "Tatoeba #1217914 @Guybrush88 / #1623571 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1217914",
          "cefr_level": "A1",
          "word_slugs": [
            "frasi-noun"
          ]
        },
        {
          "id": "5286700",
          "text": "Lui copiava delle frasi.",
          "translation": "Он переписывал предложения.",
          "source": "Tatoeba #5286700 @Guybrush88 / #8444309 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5286700",
          "cefr_level": "A1",
          "word_slugs": [
