    {
      "slug": "anatra-noun",
      "lemma": "anatra",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8186,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "утка"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4538341",
          "text": "L'anatra starnazza.",
          "translation": "Утка крякает.",
          "source": "Tatoeba #4538341 @Guybrush88 / #4282351 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538341",
          "cefr_level": "A1",
          "word_slugs": [
            "anatra-noun"
          ]
        },
        {
          "id": "5419747",
          "text": "Vuoi l'anatra alla pechinese?",
          "translation": "Хочешь утку по-пекински?",
          "source": "Tatoeba #5419747 @dnnywld / #5419709 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419747",
          "cefr_level": "A1",
          "word_slugs": [
            "anatra-noun"
          ]
        },
        {
          "id": "4383847",
          "text": "Dov'è l'anatra di gomma?",
          "translation": "Где резиновая утка?",
          "source": "Tatoeba #4383847 @Guybrush88 / #4384314 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4383847",
          "cefr_level": "A1",
          "word_slugs": [
            "anatra-noun"
          ]
        },
        {
          "id": "5489193",
          "text": "In questa immagine si può simultaneamete vedere un'anatra e un coniglio.",
          "translation": "На этом изображении можно увидеть одновременно и утку и кролика.",
          "source": "Tatoeba #5489193 @dnnywld / #5488777 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489193",
          "cefr_level": "A1",
          "word_slugs": [
            "anatra-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la anatra",
        "plural": "",
        "infinitive": ""
      }
    },
    {
