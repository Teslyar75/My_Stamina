          "source": "Tatoeba #6871420 @dnnywld / #6866852 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871420",
          "cefr_level": "A1",
          "word_slugs": [
            "salotto-noun"
          ]
        }
      ],
