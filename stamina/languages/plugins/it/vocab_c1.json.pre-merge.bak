    {
      "slug": "frutti-noun",
      "lemma": "frutti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7473,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3145849",
          "text": "Buon seme dà buoni frutti.",
          "translation": "Доброе семя приносит хорошие плоды.",
          "source": "Tatoeba #3145849 @Guybrush88 / #3400780 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3145849",
          "cefr_level": "A1",
          "word_slugs": [
            "frutti-noun"
          ]
        },
        {
          "id": "1647800",
          "text": "I frutti contengono dei semi.",
          "translation": "В плодах находятся семена.",
          "source": "Tatoeba #1647800 @Guybrush88 / #3565533 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1647800",
          "cefr_level": "A1",
          "word_slugs": [
            "frutti-noun"
          ]
        },
        {
          "id": "2433436",
          "text": "Mi piacciono i frutti di mare.",
          "translation": "Люблю морепродукты.",
          "source": "Tatoeba #2433436 @Guybrush88 / #13862686 @Adelpa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2433436",
          "cefr_level": "A1",
          "word_slugs": [
            "frutti-noun"
          ]
        },
        {
          "id": "3021813",
          "text": "L'albero si riconosce dai frutti.",
          "translation": "Дерево узнают по плодам.",
          "source": "Tatoeba #3021813 @Guybrush88 / #4814272 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3021813",
          "cefr_level": "A1",
          "word_slugs": [
            "frutti-noun"
          ]
        },
        {
          "id": "5453963",
          "text": "La diligenza porta i suoi frutti.",
          "translation": "Усердие приносит плоды.",
          "source": "Tatoeba #5453963 @dnnywld / #3027881 @Snark (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5453963",
          "cefr_level": "A1",
          "word_slugs": [
            "frutti-noun"
          ]
        }
      ],
