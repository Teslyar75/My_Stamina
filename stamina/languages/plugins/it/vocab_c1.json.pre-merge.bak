      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3397213",
          "text": "C'era una cabina telefonica lì.",
          "translation": "Там была телефонная будка.",
          "source": "Tatoeba #3397213 @Guybrush88 / #3661879 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3397213",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonica-adj"
          ]
        },
        {
          "id": "955459",
          "text": "Dove posso trovare una cabina telefonica?",
          "translation": "Где я могу найти телефонную будку?",
          "source": "Tatoeba #955459 @Guybrush88 / #2363902 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/955459",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonica-adj"
          ]
        },
        {
          "id": "1550344",
          "text": "È possibile chiudere il contratto con una compagnia telefonica?",
          "translation": "Возможно ли разорвать договор с телефонной компанией?",
          "source": "Tatoeba #1550344 @Guybrush88 / #3109664 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1550344",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonica-adj"
          ]
        },
        {
          "id": "6847468",
          "text": "Mi riferisco alla nostra conversazione telefonica del quattro dicembre.",
          "translation": "Я имею в виду наш телефонный разговор от четвёртого декабря.",
          "source": "Tatoeba #6847468 @dnnywld / #3761345 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6847468",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonica-adj"
          ]
        }
      ],
      "tags": [
