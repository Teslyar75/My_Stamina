    {
      "slug": "veste-noun",
      "lemma": "veste",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7365,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5527730",
          "text": "Lei veste alla moda.",
          "translation": "Она модно одевается.",
          "source": "Tatoeba #5527730 @dnnywld / #5527365 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527730",
          "cefr_level": "A1",
          "word_slugs": [
            "veste-noun"
          ]
        },
        {
          "id": "5474277",
          "text": "Tom di solito veste i jeans.",
          "translation": "Том обычно носит джинсы.",
          "source": "Tatoeba #5474277 @dnnywld / #5473901 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5474277",
          "cefr_level": "A1",
          "word_slugs": [
            "veste-noun"
          ]
        },
        {
          "id": "10113824",
          "text": "Non mi importa come si veste.",
          "translation": "Мне всё равно, как он одевается.",
          "source": "Tatoeba #10113824 @Guybrush88 / #10168834 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10113824",
          "cefr_level": "A1",
          "word_slugs": [
            "veste-noun"
          ]
        },
        {
          "id": "2467865",
          "text": "Tom si veste come una ragazza.",
          "translation": "Том одевается как девочка.",
          "source": "Tatoeba #2467865 @Guybrush88 / #4059938 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2467865",
          "cefr_level": "A1",
          "word_slugs": [
            "veste-noun"
          ]
        },
        {
          "id": "5441218",
          "text": "Lui veste sempre tutto di nero.",
          "translation": "Он всегда одевается во всё чёрное.",
          "source": "Tatoeba #5441218 @dnnywld / #5440645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5441218",
          "cefr_level": "A1",
          "word_slugs": [
            "veste-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la veste",
        "plural": "",
        "infinitive": ""
      }
    },
