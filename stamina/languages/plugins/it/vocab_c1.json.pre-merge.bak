    {
      "slug": "pagamento-noun",
      "lemma": "pagamento",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5062,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "оплата",
          "платёж",
          "уплата"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "10766371",
          "text": "Il pagamento è passato?",
          "translation": "Платёж прошёл?",
          "source": "Tatoeba #10766371 @dnnywld / #10159586 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10766371",
          "cefr_level": "A1",
          "word_slugs": [
            "pagamento-noun"
          ]
        },
        {
          "id": "10766297",
          "text": "Il pagamento non è passato.",
          "translation": "Платёж не прошёл.",
          "source": "Tatoeba #10766297 @dnnywld / #5482363 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10766297",
          "cefr_level": "A1",
          "word_slugs": [
            "pagamento-noun"
          ]
        },
        {
          "id": "6843069",
          "text": "Si richiede un pagamento anticipato.",
          "translation": "Требуется предоплата.",
          "source": "Tatoeba #6843069 @dnnywld / #5604521 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843069",
          "cefr_level": "A1",
          "word_slugs": [
            "pagamento-noun"
          ]
        },
        {
          "id": "6832082",
          "text": "Finora non è pervenuto nessun pagamento.",
          "translation": "Пока что оплаты не поступило.",
          "source": "Tatoeba #6832082 @dnnywld / #6141367 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6832082",
          "cefr_level": "A1",
          "word_slugs": [
            "pagamento-noun"
          ]
        },
        {
          "id": "10766935",
          "text": "Riesci a mettere insieme abbastanza soldi per il pagamento?",
          "translation": "Ты можешь собрать достаточно денег для платежа?",
          "source": "Tatoeba #10766935 @dnnywld / #438829 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10766935",
          "cefr_level": "A1",
          "word_slugs": [
            "pagamento-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il pagamento",
        "plural": "",
