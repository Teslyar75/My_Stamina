    {
      "slug": "diciassette-adj",
      "lemma": "diciassette",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9418,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "семнадцать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6330910",
          "text": "Ciao due mila diciassette.",
          "translation": "Привет две тысячи семнадцатому году.",
          "source": "Tatoeba #6330910 @dnnywld / #6330814 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6330910",
          "cefr_level": "A1",
          "word_slugs": [
            "diciassette-adj"
          ]
        },
        {
          "id": "3254615",
          "text": "Il mio amico ha diciassette anni.",
          "translation": "Моему другу семнадцать лет.",
          "source": "Tatoeba #3254615 @Guybrush88 / #1880927 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3254615",
          "cefr_level": "A1",
          "word_slugs": [
            "diciassette-adj"
          ]
        },
        {
          "id": "3254616",
          "text": "La mia amica ha diciassette anni.",
          "translation": "Моей подруге семнадцать лет.",
          "source": "Tatoeba #3254616 @Guybrush88 / #2766297 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3254616",
          "cefr_level": "A1",
          "word_slugs": [
            "diciassette-adj"
          ]
        },
        {
          "id": "910579",
          "text": "Lei avrà diciassette anni a febbraio.",
          "translation": "Ей будет семнадцать в феврале.",
          "source": "Tatoeba #910579 @riccioberto / #4537010 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/910579",
          "cefr_level": "A1",
          "word_slugs": [
            "diciassette-adj"
          ]
        },
        {
          "id": "1418245",
          "text": "Lei si è sposata a diciassette anni.",
          "translation": "Она вышла замуж в семнадцать.",
          "source": "Tatoeba #1418245 @Guybrush88 / #6604141 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1418245",
          "cefr_level": "A1",
          "word_slugs": [
            "diciassette-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "diciassette",
