          "календарь"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2999346",
          "text": "Hai un calendario?",
          "translation": "У тебя есть календарь?",
          "source": "Tatoeba #2999346 @Guybrush88 / #5986629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2999346",
          "cefr_level": "A1",
          "word_slugs": [
            "calendario-noun"
          ]
        },
        {
          "id": "5433531",
          "text": "C'è un calendario?",
          "translation": "Расписание есть?",
          "source": "Tatoeba #5433531 @dnnywld / #5431514 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433531",
          "cefr_level": "A1",
          "word_slugs": [
            "calendario-noun"
          ]
        },
        {
          "id": "5910780",
          "text": "Avete il calendario dell'anno 2018?",
          "translation": "У вас есть календарь на 2018 год?",
          "source": "Tatoeba #5910780 @dnnywld / #5910355 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5910780",
          "cefr_level": "A1",
          "word_slugs": [
            "calendario-noun"
          ]
        },
        {
          "id": "5910783",
          "text": "Dove posso appendere questo calendario?",
          "translation": "Где бы мне повесить этот календарь?",
          "source": "Tatoeba #5910783 @dnnywld / #5910353 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5910783",
          "cefr_level": "A1",
          "word_slugs": [
            "calendario-noun"
          ]
        },
        {
          "id": "348003",
          "text": "Ah, poi ho ricevuto il calendario!",
          "translation": "Ах, я получил календарь!",
          "source": "Tatoeba #348003 @grantortino / #4662350 @yura798261 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/348003",
          "cefr_level": "A1",
          "word_slugs": [
            "calendario-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il calendario",
        "plural": "",
        "infinitive": ""
      }
