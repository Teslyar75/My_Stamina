    {
      "slug": "orlo-noun",
      "lemma": "orlo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8692,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12469705",
          "text": "L'orlo è troppo alto.",
          "translation": "Бордюр слишком высокий.",
          "source": "Tatoeba #12469705 @dnnywld / #12469142 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12469705",
          "cefr_level": "A1",
          "word_slugs": [
            "orlo-noun"
          ]
        },
        {
          "id": "10878764",
          "text": "Siamo sull'orlo del fallimento.",
          "translation": "Мы на грани банкротства.",
          "source": "Tatoeba #10878764 @dnnywld / #2345019 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878764",
          "cefr_level": "A1",
          "word_slugs": [
            "orlo-noun"
          ]
        },
        {
          "id": "10878767",
          "text": "Siamo sull'orlo di una guerra.",
          "translation": "Мы на грани войны.",
          "source": "Tatoeba #10878767 @dnnywld / #5174121 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878767",
          "cefr_level": "A1",
          "word_slugs": [
            "orlo-noun"
          ]
        },
        {
          "id": "10878762",
          "text": "La compagnia è sull'orlo del fallimento.",
          "translation": "Компания на грани банкротства.",
          "source": "Tatoeba #10878762 @dnnywld / #1465846 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878762",
          "cefr_level": "A1",
          "word_slugs": [
            "orlo-noun"
          ]
        }
      ],
      "tags": [
