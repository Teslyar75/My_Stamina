    {
      "slug": "corrispondenza-noun",
      "lemma": "corrispondenza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7749,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10841640",
          "text": "Siamo in corrispondenza.",
          "translation": "Мы переписываемся.",
          "source": "Tatoeba #10841640 @dnnywld / #8043117 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10841640",
          "cefr_level": "A1",
          "word_slugs": [
            "corrispondenza-noun"
          ]
        },
        {
          "id": "10841641",
          "text": "Loro sono in corrispondenza.",
          "translation": "Они переписываются.",
          "source": "Tatoeba #10841641 @dnnywld / #8193756 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10841641",
          "cefr_level": "A1",
          "word_slugs": [
            "corrispondenza-noun"
          ]
        },
        {
          "id": "10841642",
          "text": "Loro sono regolarmente in corrispondenza.",
          "translation": "Они регулярно переписываются.",
          "source": "Tatoeba #10841642 @dnnywld / #2397150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10841642",
          "cefr_level": "A1",
          "word_slugs": [
            "corrispondenza-noun"
          ]
        },
        {
          "id": "10883082",
          "text": "Ho corrispondenza con i miei amici.",
          "translation": "Я переписываюсь с друзьями.",
          "source": "Tatoeba #10883082 @carlosalberto / #10883061 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10883082",
          "cefr_level": "A1",
          "word_slugs": [
            "corrispondenza-noun"
          ]
        },
        {
          "id": "7137848",
          "text": "Io e lei teniamo una corrispondenza.",
          "translation": "Мы с ней переписываемся.",
          "source": "Tatoeba #7137848 @dnnywld / #7133440 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7137848",
          "cefr_level": "A1",
          "word_slugs": [
            "corrispondenza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
