    {
      "slug": "tagliata-adj",
      "lemma": "tagliata",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6058,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3430190",
          "text": "Mi sono tagliata la gengiva.",
          "translation": "Я порезала десну.",
          "source": "Tatoeba #3430190 @Guybrush88 / #3430197 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3430190",
          "cefr_level": "A1",
          "word_slugs": [
            "tagliata-adj"
          ]
        },
        {
          "id": "5534203",
          "text": "Mi sono tagliata i capelli prima di partire.",
          "translation": "Я постригся перед поездкой.",
          "source": "Tatoeba #5534203 @dnnywld / #5533974 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5534203",
          "cefr_level": "A1",
          "word_slugs": [
            "tagliata-adj"
          ]
        },
        {
          "id": "5409169",
          "text": "Lei si è tagliata il dito con un vetro rotto.",
          "translation": "Она порезала свой палец о битое стекло.",
          "source": "Tatoeba #5409169 @dnnywld / #2664930 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409169",
          "cefr_level": "A1",
          "word_slugs": [
            "tagliata-adj"
          ]
        },
        {
          "id": "5643574",
          "text": "La Copra è la polpa tagliata e lasciata ad essicare del cocco.",
          "translation": "Копра — это разрезанные и высушенные кокосовые орехи.",
          "source": "Tatoeba #5643574 @dnnywld / #5643075 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643574",
          "cefr_level": "A1",
          "word_slugs": [
            "tagliata-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tagliata",
        "plural": "",
        "infinitive": ""
      }
    },
