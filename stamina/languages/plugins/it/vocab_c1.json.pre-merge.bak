    {
      "slug": "leggermente-adv",
      "lemma": "leggermente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5955,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1266015",
          "text": "Sono leggermente affamato.",
          "translation": "Я слегка голоден.",
          "source": "Tatoeba #1266015 @Guybrush88 / #2419444 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1266015",
          "cefr_level": "A1",
          "word_slugs": [
            "leggermente-adv"
          ]
        },
        {
          "id": "5679694",
          "text": "Tom sta zoppicando leggermente.",
          "translation": "Том слегка прихрамывает.",
          "source": "Tatoeba #5679694 @dnnywld / #5679517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5679694",
          "cefr_level": "A1",
          "word_slugs": [
            "leggermente-adv"
          ]
        },
        {
          "id": "5393462",
          "text": "Io e Tom siamo leggermente occupati.",
          "translation": "Мы с Томом немного заняты.",
          "source": "Tatoeba #5393462 @dnnywld / #5393423 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5393462",
          "cefr_level": "A1",
          "word_slugs": [
            "leggermente-adv"
          ]
        },
        {
          "id": "1894945",
          "text": "La mia opinione è leggermente diversa dalla tua.",
          "translation": "Мое мнение слегка отличается от твоего.",
          "source": "Tatoeba #1894945 @sixtynine / #1894890 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1894945",
          "cefr_level": "A1",
          "word_slugs": [
            "leggermente-adv"
          ]
        },
        {
          "id": "11525245",
          "text": "I prezzi del latte variano leggermente a seconda del negozio.",
          "translation": "Цены на молоко немного отличаются в зависимости от магазина.",
          "source": "Tatoeba #11525245 @dnnywld / #11525064 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11525245",
          "cefr_level": "A1",
          "word_slugs": [
            "leggermente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "leggermente",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "fermarsi-verb",
      "lemma": "fermarsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5956,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6872042",
          "text": "Fermarsi qui non ha senso.",
          "translation": "Оставаться здесь нет никакого смысла.",
          "source": "Tatoeba #6872042 @dnnywld / #4237174 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6872042",
          "cefr_level": "A1",
          "word_slugs": [
            "fermarsi-verb"
          ]
        },
        {
          "id": "1225081",
          "text": "Tom voleva fermarsi e riflettere.",
          "translation": "Тому захотелось остановиться и подумать.",
          "source": "Tatoeba #1225081 @Guybrush88 / #1219236 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1225081",
          "cefr_level": "A1",
          "word_slugs": [
            "fermarsi-verb"
          ]
        },
        {
          "id": "5539586",
          "text": "Quanto a lungo Tom può fermarsi?",
          "translation": "На сколько Том может остаться?",
          "source": "Tatoeba #5539586 @dnnywld / #5539551 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5539586",
          "cefr_level": "A1",
          "word_slugs": [
            "fermarsi-verb"
          ]
        },
        {
          "id": "5599067",
          "text": "Lui deve fermarsi ad ogni costo.",
          "translation": "Его надо задержать во что бы то ни стало.",
          "source": "Tatoeba #5599067 @dnnywld / #2382758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5599067",
          "cefr_level": "A1",
          "word_slugs": [
            "fermarsi-verb"
          ]
        },
        {
          "id": "5886446",
          "text": "Tom è passato davanti senza fermarsi.",
          "translation": "Том прошёл мимо.",
          "source": "Tatoeba #5886446 @dnnywld / #5885579 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5886446",
          "cefr_level": "A1",
          "word_slugs": [
            "fermarsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "fermarsi",
        "plural": "",
        "infinitive": "fermarsi"
      }
    },
    {
      "slug": "potessero-verb",
      "lemma": "potessero",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5957,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5415798",
          "text": "Nessuno si aspettava che potessero vincere.",
          "translation": "Никто не ожидал, что они выиграют.",
          "source": "Tatoeba #5415798 @dnnywld / #4189371 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415798",
          "cefr_level": "A1",
          "word_slugs": [
            "potessero-verb"
          ]
        },
        {
          "id": "2212330",
          "text": "Era assolutamente ovvio che cinque persone non potessero scomparire senza lasciare traccia.",
          "translation": "Было совершенно очевидно, что пять человек не могут исчезнуть бесследно.",
          "source": "Tatoeba #2212330 @al_ex_an_der / #2212299 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2212330",
          "cefr_level": "A1",
          "word_slugs": [
            "potessero-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "potessero",
