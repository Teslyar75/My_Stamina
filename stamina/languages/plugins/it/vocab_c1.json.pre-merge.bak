    {
      "slug": "finisco-verb",
      "lemma": "finisco",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5807,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6853120",
          "text": "Mettiti a tuo agio. Finisco in un minuto.",
          "translation": "Располагайся. Я через минутку закончу.",
          "source": "Tatoeba #6853120 @dnnywld / #6850347 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853120",
          "cefr_level": "A1",
          "word_slugs": [
            "finisco-verb"
          ]
        },
        {
          "id": "5540397",
          "text": "Puoi aspettare cinque minuti? Adesso finisco e arrivo.",
          "translation": "Ты пять минут можешь подождать? Сейчас закончу и приду.",
          "source": "Tatoeba #5540397 @dnnywld / #5540198 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5540397",
          "cefr_level": "A1",
          "word_slugs": [
            "finisco-verb"
          ]
        },
        {
          "id": "5484125",
          "text": "Appena finisco il rapporto, te lo spedisco immediatamente.",
          "translation": "Я сразу отправлю тебе отчёт, как только его закончу.",
          "source": "Tatoeba #5484125 @dnnywld / #5483953 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5484125",
          "cefr_level": "A1",
          "word_slugs": [
            "finisco-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "finisco",
        "plural": "",
        "infinitive": "finisco"
      }
    },
    {
      "slug": "esperti-adj",
      "lemma": "esperti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5808,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8816896",
          "text": "Gli esperti potrebbero sbagliarsi.",
          "translation": "Эксперты могут ошибаться.",
          "source": "Tatoeba #8816896 @carlosalberto / #8816292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8816896",
          "cefr_level": "A1",
          "word_slugs": [
            "esperti-adj"
          ]
        },
        {
          "id": "6951813",
          "text": "Ecco l'opinione degli esperti.",
          "translation": "Вот заключение экспертов.",
          "source": "Tatoeba #6951813 @dnnywld / #6950757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6951813",
          "cefr_level": "A1",
          "word_slugs": [
            "esperti-adj"
          ]
        },
        {
          "id": "5663228",
          "text": "Perfino gli autisti esperti possono sbagliare.",
          "translation": "Даже опытные водители могут ошибаться.",
          "source": "Tatoeba #5663228 @dnnywld / #5661361 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5663228",
          "cefr_level": "A1",
          "word_slugs": [
            "esperti-adj"
          ]
        },
        {
          "id": "6952055",
          "text": "Gli esperti sono rimasti soddisfatti dei risultati.",
          "translation": "Эксперты остались довольны результатами.",
          "source": "Tatoeba #6952055 @dnnywld / #4093380 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952055",
          "cefr_level": "A1",
          "word_slugs": [
            "esperti-adj"
          ]
        },
        {
          "id": "6951816",
          "text": "Prendete conoscenza, per favore, dell'opinione degli esperti.",
          "translation": "Ознакомьтесь, пожалуйста, с заключением экспертизы.",
          "source": "Tatoeba #6951816 @dnnywld / #6950755 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6951816",
          "cefr_level": "A1",
          "word_slugs": [
            "esperti-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il esperti",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "prestato-adj",
      "lemma": "prestato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5809,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5513051",
          "text": "Lui mi ha prestato trenta pesos.",
          "translation": "Он одолжил мне тридцать песо.",
          "source": "Tatoeba #5513051 @dnnywld / #5512885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513051",
          "cefr_level": "A1",
          "word_slugs": [
            "prestato-adj"
          ]
        },
        {
          "id": "7788443",
          "text": "Vika mi ha prestato cento rubli.",
          "translation": "Вика одолжила мне сто рублей.",
          "source": "Tatoeba #7788443 @dnnywld / #7788377 @User55521 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7788443",
          "cefr_level": "A1",
          "word_slugs": [
            "prestato-adj"
          ]
        },
        {
          "id": "5884736",
          "text": "Non ho prestato attenzione a Tom.",
          "translation": "Я не обратил на Тома внимания.",
          "source": "Tatoeba #5884736 @dnnywld / #5883869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5884736",
          "cefr_level": "A1",
          "word_slugs": [
            "prestato-adj"
          ]
        },
        {
          "id": "5631958",
          "text": "Ho prestato 1000 yen a mio cugino.",
          "translation": "Я занял 1000 иен у моего кузена.",
          "source": "Tatoeba #5631958 @dnnywld / #1424303 @Snark (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5631958",
          "cefr_level": "A1",
          "word_slugs": [
            "prestato-adj"
          ]
        },
        {
          "id": "13071021",
          "text": "Lui non ci ha prestato attenzione.",
          "translation": "Он не обращал на это внимания.",
          "source": "Tatoeba #13071021 @dnnywld / #13070860 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13071021",
          "cefr_level": "A1",
          "word_slugs": [
            "prestato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
