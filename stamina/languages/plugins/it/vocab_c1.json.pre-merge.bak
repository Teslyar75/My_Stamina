    {
      "slug": "dir-pron",
      "lemma": "dir",
      "pos": "pron",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5025,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6623040",
          "text": "Cosa devo dir loro?",
          "translation": "Что мне им передать?",
          "source": "Tatoeba #6623040 @dnnywld / #6622730 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6623040",
          "cefr_level": "A1",
          "word_slugs": [
            "dir-pron"
          ]
        },
        {
          "id": "6702630",
          "text": "Abituati a dir di no.",
          "translation": "Привыкай говорить нет.",
          "source": "Tatoeba #6702630 @dnnywld / #6700881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6702630",
          "cefr_level": "A1",
          "word_slugs": [
            "dir-pron"
          ]
        },
        {
          "id": "5586714",
          "text": "Non dir loro che vado via.",
          "translation": "Не говори им, что я уезжаю.",
          "source": "Tatoeba #5586714 @dnnywld / #5584919 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586714",
          "cefr_level": "A1",
          "word_slugs": [
            "dir-pron"
          ]
        },
        {
          "id": "5432887",
          "text": "Consiglio di non dir loro niente.",
          "translation": "Советую ничего им не говорить.",
          "source": "Tatoeba #5432887 @dnnywld / #5432427 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5432887",
          "cefr_level": "A1",
          "word_slugs": [
            "dir-pron"
          ]
        },
        {
          "id": "5516815",
          "text": "A dir la verità, non sono andato lì.",
          "translation": "Честно говоря, я туда не ходил.",
          "source": "Tatoeba #5516815 @dnnywld / #5516805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5516815",
          "cefr_level": "A1",
          "word_slugs": [
            "dir-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
