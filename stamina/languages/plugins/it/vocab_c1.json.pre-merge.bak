    {
      "slug": "giocava-verb",
      "lemma": "giocava",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9875,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5387038",
          "text": "Tom giocava a tennis ogni lunedì.",
          "translation": "Том играл в теннис каждый понедельник.",
          "source": "Tatoeba #5387038 @dnnywld / #5387036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387038",
          "cefr_level": "A1",
          "word_slugs": [
            "giocava-verb"
          ]
        },
        {
          "id": "883309",
          "text": "Lei giocava a tennis ogni domenica.",
          "translation": "Она играла в теннис каждое воскресенье.",
          "source": "Tatoeba #883309 @Guybrush88 / #5673980 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/883309",
          "cefr_level": "A1",
          "word_slugs": [
            "giocava-verb"
          ]
        },
        {
          "id": "5549539",
          "text": "Lei una volta giocava a pallacanestro.",
          "translation": "Она когда-то играла в баскетбол.",
          "source": "Tatoeba #5549539 @dnnywld / #5549384 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549539",
          "cefr_level": "A1",
          "word_slugs": [
            "giocava-verb"
          ]
        },
        {
          "id": "2701608",
          "text": "Lui giocava a tennis tutto il giorno.",
          "translation": "Он целый день играл в теннис.",
          "source": "Tatoeba #2701608 @Guybrush88 / #3339689 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2701608",
          "cefr_level": "A1",
          "word_slugs": [
            "giocava-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "giocava",
        "plural": "",
        "infinitive": "giocava"
      }
