    {
      "slug": "rifiutata-adj",
      "lemma": "rifiutata",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9836,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6372268",
          "text": "La mia offerta è stata rifiutata.",
          "translation": "Моё предложение было отклонено.",
          "source": "Tatoeba #6372268 @dnnywld / #6371934 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6372268",
          "cefr_level": "A1",
          "word_slugs": [
