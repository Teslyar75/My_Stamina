          ]
        },
        {
          "id": "2828693",
          "text": "Lei ebbe un crollo nervoso.",
          "translation": "У неё был нервный срыв.",
          "source": "Tatoeba #2828693 @Guybrush88 / #3290223 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2828693",
