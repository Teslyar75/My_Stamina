          ]
        },
        {
          "id": "5678595",
          "text": "Avete nostalgia di Boston?",
          "translation": "Скучаете по Бостону?",
          "source": "Tatoeba #5678595 @dnnywld / #5678321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5678595",
          "cefr_level": "A1",
          "word_slugs": [
            "nostalgia-noun"
          ]
        },
        {
          "id": "5481380",
          "text": "Tom sente nostalgia della figlia.",
          "translation": "Том скучает по дочери.",
