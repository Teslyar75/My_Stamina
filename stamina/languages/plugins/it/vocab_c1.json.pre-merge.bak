      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6378692",
          "text": "Adoro fare shopping!",
          "translation": "Обожаю ходить по магазинам!",
          "source": "Tatoeba #6378692 @dnnywld / #3520455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6378692",
          "cefr_level": "A1",
          "word_slugs": [
