      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6847429",
          "text": "Sai perfettamente a chi mi riferisco.",
          "translation": "Ты прекрасно знаешь, кого я имею в виду.",
          "source": "Tatoeba #6847429 @dnnywld / #2711230 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6847429",
          "cefr_level": "A1",
          "word_slugs": [
