    {
      "slug": "iniziativa-noun",
      "lemma": "iniziativa",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7261,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10836653",
          "text": "La stampa ha sostenuto questa iniziativa.",
          "translation": "Пресса поддержала эту инициативу.",
          "source": "Tatoeba #10836653 @dnnywld / #10836651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10836653",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziativa-noun"
          ]
        },
        {
          "id": "10836655",
          "text": "La stampa ha approvato questa iniziativa.",
          "translation": "Пресса одобрила эту инициативу.",
          "source": "Tatoeba #10836655 @dnnywld / #10836649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10836655",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziativa-noun"
          ]
        },
        {
          "id": "5980023",
          "text": "Da questa iniziativa non scaturirà niente.",
          "translation": "Из этой затеи ничего не выйдет.",
          "source": "Tatoeba #5980023 @dnnywld / #5966562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980023",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziativa-noun"
          ]
        },
        {
          "id": "5607440",
          "text": "Tom è un giovanotto pieno di iniziativa.",
          "translation": "Том - предприимчивый молодой человек.",
          "source": "Tatoeba #5607440 @dnnywld / #5607149 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607440",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziativa-noun"
          ]
        },
        {
          "id": "5980025",
          "text": "Da questa iniziativa non è scaturito niente.",
          "translation": "Из этой затеи ничего не вышло.",
          "source": "Tatoeba #5980025 @dnnywld / #5966563 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980025",
          "cefr_level": "A1",
          "word_slugs": [
