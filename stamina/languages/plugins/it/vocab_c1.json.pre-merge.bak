    {
      "slug": "saprò-verb",
      "lemma": "saprò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9288,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12470651",
          "text": "Appena lo saprò, vi telefonerò.",
          "translation": "Я позвоню вам, как только узнаю.",
          "source": "Tatoeba #12470651 @dnnywld / #12470478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12470651",
          "cefr_level": "A1",
          "word_slugs": [
