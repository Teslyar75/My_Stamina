    {
      "slug": "cuscino-noun",
      "lemma": "cuscino",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5179,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8032289",
          "text": "Lei gettai un cuscino.",
          "translation": "Я бросил ей подушку.",
          "source": "Tatoeba #8032289 @dnnywld / #8032156 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8032289",
          "cefr_level": "A1",
          "word_slugs": [
            "cuscino-noun"
          ]
        },
        {
          "id": "1704279",
          "text": "Il cuscino rosa è pulito.",
          "translation": "Розовая подушка чистая.",
          "source": "Tatoeba #1704279 @Guybrush88 / #3350269 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1704279",
          "cefr_level": "A1",
          "word_slugs": [
            "cuscino-noun"
          ]
        },
        {
          "id": "5879244",
          "text": "Questo cuscino è troppo morbido per me.",
          "translation": "Для меня эта подушка слишком мягкая.",
          "source": "Tatoeba #5879244 @dnnywld / #3030943 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5879244",
          "cefr_level": "A1",
          "word_slugs": [
            "cuscino-noun"
          ]
        },
        {
          "id": "5398828",
          "text": "Tom ha messo un cuscino sotto la testa di Mary.",
          "translation": "Том подложил подушку Мэри под голову.",
          "source": "Tatoeba #5398828 @dnnywld / #3101673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5398828",
          "cefr_level": "A1",
          "word_slugs": [
            "cuscino-noun"
          ]
        },
        {
          "id": "5389043",
          "text": "Tom si è addormentato appena la sua testa ha toccato il cuscino.",
          "translation": "Том уснул, как только его голова коснулась подушки.",
          "source": "Tatoeba #5389043 @dnnywld / #5389019 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389043",
          "cefr_level": "A1",
          "word_slugs": [
            "cuscino-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il cuscino",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "piante-noun",
      "lemma": "piante",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5180,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5672347",
          "text": "Le piante possono parlare?",
          "translation": "Растения могут разговаривать?",
          "source": "Tatoeba #5672347 @dnnywld / #5672284 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672347",
          "cefr_level": "A1",
          "word_slugs": [
            "piante-noun"
          ]
        },
        {
          "id": "5985179",
          "text": "Le piante sentono il dolore?",
          "translation": "Растения чувствуют боль?",
          "source": "Tatoeba #5985179 @dnnywld / #3041029 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5985179",
          "cefr_level": "A1",
          "word_slugs": [
            "piante-noun"
          ]
        },
        {
          "id": "13954806",
          "text": "Perché le piante sono verdi?",
          "translation": "Почему растения зелёные?",
          "source": "Tatoeba #13954806 @Adelpa / #9202331 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13954806",
          "cefr_level": "A1",
          "word_slugs": [
            "piante-noun"
          ]
        },
        {
          "id": "6702302",
          "text": "Pensi che le piante provino dolore?",
          "translation": "Думаешь, растения чувствуют боль?",
          "source": "Tatoeba #6702302 @Guybrush88 / #6702434 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6702302",
          "cefr_level": "A1",
          "word_slugs": [
            "piante-noun"
          ]
        },
        {
          "id": "6702307",
          "text": "Pensate che le piante provino dolore?",
          "translation": "Думаете, растения чувствуют боль?",
          "source": "Tatoeba #6702307 @Guybrush88 / #6702435 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6702307",
          "cefr_level": "A1",
          "word_slugs": [
            "piante-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
