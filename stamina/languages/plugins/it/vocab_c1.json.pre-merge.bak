      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6367873",
          "text": "Non vi permetterò mai di farlo.",
          "translation": "Я никогда не позволю вам это сделать.",
          "source": "Tatoeba #6367873 @dnnywld / #6366887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367873",
          "cefr_level": "A1",
          "word_slugs": [
            "permetterò-verb"
          ]
        },
        {
          "id": "6367875",
          "text": "Non ti permetterò mai di farlo.",
          "translation": "Я никогда не позволю тебе это сделать.",
          "source": "Tatoeba #6367875 @dnnywld / #6366886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367875",
          "cefr_level": "A1",
          "word_slugs": [
            "permetterò-verb"
          ]
        },
        {
          "id": "6368441",
          "text": "Non vi permetterò mai di andare.",
          "translation": "Я никогда не разрешу вам поехать.",
          "source": "Tatoeba #6368441 @dnnywld / #6360701 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6368441",
          "cefr_level": "A1",
          "word_slugs": [
