    {
      "slug": "parcheggiato-adj",
      "lemma": "parcheggiato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8247,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7525115",
          "text": "Dove ha parcheggiato il suo camion?",
          "translation": "Где она припарковала свой грузовик?",
          "source": "Tatoeba #7525115 @Guybrush88 / #7954820 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7525115",
          "cefr_level": "A1",
          "word_slugs": [
            "parcheggiato-adj"
          ]
        },
        {
          "id": "5668466",
          "text": "Tom sapeva dove Mary aveva parcheggiato.",
          "translation": "Том знал, где Мэри припарковалась.",
          "source": "Tatoeba #5668466 @dnnywld / #5667620 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5668466",
          "cefr_level": "A1",
          "word_slugs": [
            "parcheggiato-adj"
          ]
        },
        {
          "id": "6375283",
          "text": "Ho parcheggiato nei pressi del cancello.",
          "translation": "Я припарковался у ворот.",
          "source": "Tatoeba #6375283 @dnnywld / #6375217 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6375283",
          "cefr_level": "A1",
          "word_slugs": [
            "parcheggiato-adj"
          ]
        },
        {
          "id": "5662343",
          "text": "Tom non sa dove Mary ha parcheggiato.",
          "translation": "Том не знает, где Мэри припарковалась.",
          "source": "Tatoeba #5662343 @dnnywld / #5660986 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662343",
          "cefr_level": "A1",
          "word_slugs": [
            "parcheggiato-adj"
          ]
        },
        {
          "id": "5668471",
          "text": "Tom sapeva dove Mary aveva parcheggiato la macchina.",
          "translation": "Том знал, где Мэри припарковала машину.",
