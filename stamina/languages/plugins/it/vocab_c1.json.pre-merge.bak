    {
      "slug": "frainteso-verb",
      "lemma": "frainteso",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9495,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3211171",
          "text": "Hai frainteso tutto.",
          "translation": "Ты всё неправильно понял.",
          "source": "Tatoeba #3211171 @Guybrush88 / #5673011 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3211171",
          "cefr_level": "A1",
          "word_slugs": [
            "frainteso-verb"
          ]
        },
        {
          "id": "5673245",
          "text": "Avete frainteso tutto.",
          "translation": "Вы всё неправильно поняли.",
          "source": "Tatoeba #5673245 @dnnywld / #5673010 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5673245",
          "cefr_level": "A1",
          "word_slugs": [
            "frainteso-verb"
          ]
        },
        {
          "id": "2970147",
          "text": "Ha frainteso la frase.",
          "translation": "Ты неверно понял предложение.",
          "source": "Tatoeba #2970147 @Guybrush88 / #2970220 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2970147",
          "cefr_level": "A1",
          "word_slugs": [
            "frainteso-verb"
          ]
        },
        {
          "id": "2970127",
          "text": "Avete frainteso la frase.",
          "translation": "Вы неправильно поняли предложение.",
          "source": "Tatoeba #2970127 @Guybrush88 / #2970218 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2970127",
          "cefr_level": "A1",
          "word_slugs": [
            "frainteso-verb"
          ]
        },
        {
          "id": "6893490",
          "text": "Hai di nuovo frainteso tutto.",
          "translation": "Ты опять всё не так понял.",
          "source": "Tatoeba #6893490 @dnnywld / #6893408 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893490",
          "cefr_level": "A1",
          "word_slugs": [
            "frainteso-verb"
          ]
        }
      ],
      "tags": [
