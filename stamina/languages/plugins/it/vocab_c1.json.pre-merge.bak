    {
      "slug": "riceve-verb",
      "lemma": "riceve",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5712,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5845249",
          "text": "Lui riceve le chiavi.",
          "translation": "Он получает ключи.",
          "source": "Tatoeba #5845249 @dnnywld / #4035078 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845249",
          "cefr_level": "A1",
          "word_slugs": [
            "riceve-verb"
          ]
        },
        {
          "id": "6961202",
          "text": "Quando riceve il dottore?",
          "translation": "Когда доктор принимает?",
          "source": "Tatoeba #6961202 @dnnywld / #6960588 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961202",
          "cefr_level": "A1",
          "word_slugs": [
            "riceve-verb"
          ]
        },
        {
          "id": "1339858",
          "text": "Lui riceve un salario alto.",
          "translation": "Он получает большую зарплату.",
          "source": "Tatoeba #1339858 @Guybrush88 / #3286175 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1339858",
          "cefr_level": "A1",
          "word_slugs": [
            "riceve-verb"
          ]
        },
        {
          "id": "5520804",
          "text": "Lui riceve un buon salario.",
          "translation": "Он получает хорошую зарплату.",
          "source": "Tatoeba #5520804 @Guybrush88 / #3301344 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5520804",
          "cefr_level": "A1",
          "word_slugs": [
            "riceve-verb"
          ]
        },
        {
          "id": "5552110",
          "text": "Tom riceve uno stipendio alto.",
          "translation": "Том получает высокую зарплату.",
          "source": "Tatoeba #5552110 @dnnywld / #5551904 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5552110",
          "cefr_level": "A1",
          "word_slugs": [
            "riceve-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "riceve",
