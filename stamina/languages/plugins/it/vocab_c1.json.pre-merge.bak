    {
      "slug": "richiamare-verb",
      "lemma": "richiamare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7885,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5677874",
          "text": "Posso richiamare più tardi?",
          "translation": "Я могу перезвонить позже?",
          "source": "Tatoeba #5677874 @dnnywld / #5677066 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677874",
          "cefr_level": "A1",
          "word_slugs": [
            "richiamare-verb"
          ]
        },
        {
          "id": "12963322",
          "text": "Proverò a richiamare più tardi.",
          "translation": "Я попозже ещё раз попробую набрать.",
          "source": "Tatoeba #12963322 @dnnywld / #12962395 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12963322",
          "cefr_level": "A1",
          "word_slugs": [
            "richiamare-verb"
          ]
        },
        {
          "id": "5613762",
          "text": "Non potresti richiamare più tardi?",
          "translation": "Не мог бы ты перезвонить позже?",
          "source": "Tatoeba #5613762 @dnnywld / #2500005 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5613762",
          "cefr_level": "A1",
          "word_slugs": [
            "richiamare-verb"
          ]
        },
        {
          "id": "6918376",
          "text": "Adesso sono impegnato. Non potresti richiamare più tardi?",
          "translation": "Я сейчас занят. Ты не мог бы перезвонить позже?",
          "source": "Tatoeba #6918376 @dnnywld / #6918337 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6918376",
          "cefr_level": "A1",
          "word_slugs": [
            "richiamare-verb"
          ]
        },
        {
          "id": "6918379",
          "text": "Adesso sono impegnato. Non potreste richiamare più tardi?",
          "translation": "Я сейчас занят. Вы не могли бы перезвонить позже?",
          "source": "Tatoeba #6918379 @dnnywld / #6918336 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6918379",
          "cefr_level": "A1",
          "word_slugs": [
            "richiamare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
