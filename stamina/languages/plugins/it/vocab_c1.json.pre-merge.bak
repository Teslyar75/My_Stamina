    {
      "slug": "allegro-name",
      "lemma": "Allegro",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8379,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10854315",
          "text": "Tom è sempre allegro.",
          "translation": "Том всегда бодр.",
          "source": "Tatoeba #10854315 @dnnywld / #3533424 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854315",
          "cefr_level": "A1",
          "word_slugs": [
            "allegro-name"
          ]
        },
        {
          "id": "6442923",
          "text": "Lei ha un carattere allegro.",
          "translation": "У неё весёлый характер.",
          "source": "Tatoeba #6442923 @dnnywld / #6442315 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6442923",
          "cefr_level": "A1",
          "word_slugs": [
            "allegro-name"
          ]
        },
        {
          "id": "1480747",
          "text": "Sono un tipo allegro e simpatico.",
          "translation": "Парень я весёлый и симпатичный.",
          "source": "Tatoeba #1480747 @Guybrush88 / #4387211 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1480747",
          "cefr_level": "A1",
          "word_slugs": [
            "allegro-name"
          ]
        },
        {
          "id": "6920938",
          "text": "L'uccello canta allegro nella gabbia.",
          "translation": "Птица в клетке весело поёт.",
          "source": "Tatoeba #6920938 @dnnywld / #6920494 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6920938",
          "cefr_level": "A1",
          "word_slugs": [
            "allegro-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
