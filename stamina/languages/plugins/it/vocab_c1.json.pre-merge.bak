    {
      "slug": "canti-noun",
      "lemma": "canti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6828,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5868587",
          "text": "Vuoi che canti?",
          "translation": "Хочешь, чтобы я спел?",
          "source": "Tatoeba #5868587 @dnnywld / #5783776 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868587",
          "cefr_level": "A1",
          "word_slugs": [
            "canti-noun"
          ]
        },
        {
          "id": "5868586",
          "text": "Volete che canti?",
          "translation": "Хотите, чтобы я спел?",
          "source": "Tatoeba #5868586 @dnnywld / #5783778 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868586",
          "cefr_level": "A1",
          "word_slugs": [
            "canti-noun"
          ]
        },
        {
          "id": "7712851",
          "text": "Quanto bene canti?",
          "translation": "Насколько хорошо ты поёшь?",
          "source": "Tatoeba #7712851 @dnnywld / #7712666 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7712851",
          "cefr_level": "A1",
          "word_slugs": [
            "canti-noun"
          ]
        },
        {
          "id": "5604054",
          "text": "Mi piace come canti.",
          "translation": "Мне нравится то, как ты поешь.",
          "source": "Tatoeba #5604054 @dnnywld / #2519368 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5604054",
          "cefr_level": "A1",
          "word_slugs": [
            "canti-noun"
          ]
        },
        {
          "id": "10881860",
          "text": "Voglio che canti con Tom.",
          "translation": "Я хочу, чтобы ты спел с Томом.",
          "source": "Tatoeba #10881860 @dnnywld / #8043588 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10881860",
          "cefr_level": "A1",
          "word_slugs": [
            "canti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
