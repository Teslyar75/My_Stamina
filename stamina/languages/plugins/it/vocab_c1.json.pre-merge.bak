      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5681101",
          "text": "È molto raro.",
          "translation": "Это большая редкость.",
          "source": "Tatoeba #5681101 @dnnywld / #5678662 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5681101",
          "cefr_level": "A1",
          "word_slugs": [
            "raro-adj"
          ]
        },
        {
          "id": "10917149",
          "text": "È un talento raro.",
          "translation": "Это редкий талант.",
          "source": "Tatoeba #10917149 @dnnywld / #10590589 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10917149",
          "cefr_level": "A1",
          "word_slugs": [
            "raro-adj"
          ]
        },
        {
          "id": "5681100",
          "text": "Questo è molto raro.",
          "translation": "Это большая редкость.",
          "source": "Tatoeba #5681100 @dnnywld / #5678662 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5681100",
          "cefr_level": "A1",
          "word_slugs": [
            "raro-adj"
          ]
        },
        {
          "id": "1006622",
          "text": "Questo è un caso molto raro.",
          "translation": "Это очень редкий случай.",
          "source": "Tatoeba #1006622 @riccioberto / #411370 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1006622",
          "cefr_level": "A1",
          "word_slugs": [
