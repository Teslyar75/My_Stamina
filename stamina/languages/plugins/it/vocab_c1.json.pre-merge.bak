    {
      "slug": "cinquanta-adj",
      "lemma": "cinquanta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5304,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3518122",
          "text": "Sono cinquanta yen.",
          "translation": "Пятьдесят иен.",
          "source": "Tatoeba #3518122 @Guybrush88 / #5888924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3518122",
          "cefr_level": "A1",
          "word_slugs": [
            "cinquanta-adj"
          ]
        },
        {
          "id": "666736",
          "text": "Aveva cinquanta dollari.",
          "translation": "У него было пятьдесят долларов.",
          "source": "Tatoeba #666736 @Guybrush88 / #2283573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/666736",
          "cefr_level": "A1",
          "word_slugs": [
            "cinquanta-adj"
          ]
        },
        {
          "id": "733687",
          "text": "Lui aveva cinquanta dollari.",
          "translation": "У него было пятьдесят долларов.",
          "source": "Tatoeba #733687 @Guybrush88 / #2283573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/733687",
          "cefr_level": "A1",
