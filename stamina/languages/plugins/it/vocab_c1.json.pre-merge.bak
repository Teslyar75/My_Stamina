    {
      "slug": "cresce-verb",
      "lemma": "cresce",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6016,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10864716",
          "text": "L'uva cresce nella vigna.",
          "translation": "Виноград растёт на виноградниках.",
          "source": "Tatoeba #10864716 @dnnywld / #10564882 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10864716",
          "cefr_level": "A1",
          "word_slugs": [
            "cresce-verb"
          ]
        },
        {
          "id": "5589363",
          "text": "L'abitudine cresce con gli anni.",
          "translation": "Привычка растет с годами.",
          "source": "Tatoeba #5589363 @dnnywld / #4821805 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589363",
          "cefr_level": "A1",
          "word_slugs": [
            "cresce-verb"
          ]
        },
        {
          "id": "1246535",
          "text": "Su Marte non cresce alcun albero.",
          "translation": "На Марсе деревья не растут.",
          "source": "Tatoeba #1246535 @Guybrush88 / #3521077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246535",
          "cefr_level": "A1",
          "word_slugs": [
            "cresce-verb"
          ]
        },
        {
          "id": "1246534",
          "text": "Su Marte non cresce nessun albero.",
          "translation": "На Марсе деревья не растут.",
          "source": "Tatoeba #1246534 @Guybrush88 / #3521077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246534",
          "cefr_level": "A1",
          "word_slugs": [
            "cresce-verb"
          ]
        },
        {
          "id": "7274600",
          "text": "Davanti alla casa cresce un albero.",
          "translation": "Перед домом растёт дерево.",
          "source": "Tatoeba #7274600 @dnnywld / #7274307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7274600",
          "cefr_level": "A1",
          "word_slugs": [
            "cresce-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cresce",
        "plural": "",
        "infinitive": "cresce"
      }
