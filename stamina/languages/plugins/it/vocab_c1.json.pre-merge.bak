    {
      "slug": "camminato-verb",
      "lemma": "camminato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8724,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5453991",
          "text": "Ho camminato da solo.",
          "translation": "Я шёл один.",
          "source": "Tatoeba #5453991 @dnnywld / #3295199 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5453991",
          "cefr_level": "A1",
          "word_slugs": [
            "camminato-verb"
          ]
        },
        {
          "id": "3528570",
          "text": "Abbiamo camminato fino al fiume.",
          "translation": "Мы дошли до реки.",
          "source": "Tatoeba #3528570 @Guybrush88 / #3482813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3528570",
          "cefr_level": "A1",
          "word_slugs": [
            "camminato-verb"
          ]
        },
        {
          "id": "5467842",
          "text": "Hanno camminato fianco a fianco.",
          "translation": "Они шли плечом к плечу.",
          "source": "Tatoeba #5467842 @dnnywld / #5467545 @yatomoya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5467842",
          "cefr_level": "A1",
          "word_slugs": [
            "camminato-verb"
          ]
        },
        {
          "id": "6952336",
          "text": "Abbiamo camminato fino alla mia camera.",
          "translation": "Мы дошли до моей комнаты.",
          "source": "Tatoeba #6952336 @dnnywld / #4576822 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952336",
          "cefr_level": "A1",
          "word_slugs": [
            "camminato-verb"
          ]
        },
        {
          "id": "6885177",
          "text": "Ho camminato a occhio e croce un miglio.",
          "translation": "Я прошёл примерно милю.",
          "source": "Tatoeba #6885177 @dnnywld / #4685716 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6885177",
          "cefr_level": "A1",
          "word_slugs": [
            "camminato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "camminato",
        "plural": "",
        "infinitive": "camminato"
      }
