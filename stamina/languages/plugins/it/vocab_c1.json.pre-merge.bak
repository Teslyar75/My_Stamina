    {
      "slug": "irlandese-adj",
      "lemma": "irlandese",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5878,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5971375",
          "text": "È un nome irlandese.",
          "translation": "Это ирландское имя.",
          "source": "Tatoeba #5971375 @dnnywld / #5969587 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971375",
          "cefr_level": "A1",
          "word_slugs": [
            "irlandese-adj"
          ]
        },
        {
          "id": "6452974",
          "text": "La ragazza è irlandese.",
          "translation": "Девушка - ирландка.",
          "source": "Tatoeba #6452974 @Guybrush88 / #4079384 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6452974",
          "cefr_level": "A1",
          "word_slugs": [
            "irlandese-adj"
          ]
        },
        {
          "id": "5676715",
          "text": "Tom va nella scuola locale di lingua irlandese.",
          "translation": "Том ходит в местную школу с ирландским языком обучения.",
          "source": "Tatoeba #5676715 @dnnywld / #5676661 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5676715",
          "cefr_level": "A1",
          "word_slugs": [
            "irlandese-adj"
          ]
        },
        {
          "id": "5399074",
          "text": "Chissà perché io parlo ai miei cani con l'accento irlandese.",
          "translation": "Я почему-то разговариваю со своими собаками с ирландским акцентом.",
          "source": "Tatoeba #5399074 @dnnywld / #4520000 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5399074",
          "cefr_level": "A1",
          "word_slugs": [
            "irlandese-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
