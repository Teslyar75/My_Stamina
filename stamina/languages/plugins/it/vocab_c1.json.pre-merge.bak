    {
      "slug": "aggressivo-adj",
      "lemma": "aggressivo",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8141,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4395364",
          "text": "Tom era aggressivo.",
          "translation": "Том был агрессивен.",
          "source": "Tatoeba #4395364 @Guybrush88 / #5677160 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4395364",
          "cefr_level": "A1",
          "word_slugs": [
            "aggressivo-adj"
          ]
        },
        {
          "id": "5506836",
          "text": "Tom è sempre molto aggressivo.",
          "translation": "Том всегда очень агрессивен.",
          "source": "Tatoeba #5506836 @dnnywld / #5505724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506836",
          "cefr_level": "A1",
          "word_slugs": [
            "aggressivo-adj"
          ]
        },
        {
          "id": "3557203",
          "text": "Penso che Tom sia troppo aggressivo.",
          "translation": "Думаю, Том слишком агрессивен.",
          "source": "Tatoeba #3557203 @Guybrush88 / #3663012 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3557203",
          "cefr_level": "A1",
          "word_slugs": [
            "aggressivo-adj"
          ]
        },
        {
          "id": "3557204",
          "text": "Io penso che Tom sia troppo aggressivo.",
          "translation": "Я думаю, что Том слишком агрессивен.",
          "source": "Tatoeba #3557204 @Guybrush88 / #3330809 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3557204",
          "cefr_level": "A1",
          "word_slugs": [
            "aggressivo-adj"
          ]
        },
        {
          "id": "5669305",
          "text": "Vedo che sei molto più aggressivo di quanto immaginassi.",
          "translation": "Вижу, ты гораздо агрессивнее, чем я себе представлял.",
          "source": "Tatoeba #5669305 @dnnywld / #5668680 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5669305",
          "cefr_level": "A1",
          "word_slugs": [
