    {
      "slug": "avvicinando-verb",
      "lemma": "avvicinando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6053,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6041735",
          "text": "Ti stai avvicinando.",
          "translation": "Ты приближаешься.",
          "source": "Tatoeba #6041735 @Guybrush88 / #6227037 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6041735",
          "cefr_level": "A1",
          "word_slugs": [
            "avvicinando-verb"
          ]
        },
        {
          "id": "10756984",
          "text": "Lui si stava avvicinando.",
          "translation": "Он приближался.",
          "source": "Tatoeba #10756984 @dnnywld / #4429298 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10756984",
          "cefr_level": "A1",
          "word_slugs": [
            "avvicinando-verb"
          ]
        },
        {
          "id": "5683039",
          "text": "Ci stiamo avvicinando a casa.",
          "translation": "Мы приближаемся к дому.",
          "source": "Tatoeba #5683039 @dnnywld / #5683029 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683039",
          "cefr_level": "A1",
          "word_slugs": [
            "avvicinando-verb"
          ]
        },
        {
          "id": "10766283",
          "text": "Il termine ultimo si sta avvicinando.",
          "translation": "Крайний срок приближается.",
          "source": "Tatoeba #10766283 @dnnywld / #3507140 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10766283",
          "cefr_level": "A1",
          "word_slugs": [
            "avvicinando-verb"
          ]
        },
        {
          "id": "6143547",
          "text": "Un fronte temporalesco si sta avvicinando alla capitale.",
          "translation": "К столице приближается грозовой фронт.",
          "source": "Tatoeba #6143547 @dnnywld / #6143307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6143547",
          "cefr_level": "A1",
          "word_slugs": [
            "avvicinando-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "avvicinando",
        "plural": "",
        "infinitive": "avvicinando"
      }
