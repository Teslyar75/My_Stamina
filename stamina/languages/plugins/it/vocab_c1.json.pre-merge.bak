      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7611581",
          "text": "Prego di inviare il libro per posta.",
          "translation": "Прошу выслать книгу почтой.",
          "source": "Tatoeba #7611581 @dnnywld / #7610260 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7611581",
          "cefr_level": "A1",
          "word_slugs": [
