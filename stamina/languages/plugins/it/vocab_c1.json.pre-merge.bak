          "source": "Tatoeba #7911002 @dnnywld / #7910715 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7911002",
          "cefr_level": "A1",
          "word_slugs": [
            "proibito-noun"
          ]
        },
        {
          "id": "6484907",
          "text": "Qui è proibito pescare.",
          "translation": "Здесь запрещено рыбачить.",
          "source": "Tatoeba #6484907 @dnnywld / #6484600 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6484907",
          "cefr_level": "A1",
          "word_slugs": [
            "proibito-noun"
          ]
        },
        {
          "id": "3048845",
          "text": "Frutto proibito, più saporito.",
          "translation": "Запретный плод сладок.",
          "source": "Tatoeba #3048845 @Guybrush88 / #3283038 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3048845",
          "cefr_level": "A1",
          "word_slugs": [
            "proibito-noun"
          ]
        },
        {
          "id": "4274590",
          "text": "Fumare nel ristorante era proibito.",
          "translation": "В ресторане было запрещено курить.",
          "source": "Tatoeba #4274590 @Guybrush88 / #4445684 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4274590",
          "cefr_level": "A1",
          "word_slugs": [
            "proibito-noun"
          ]
        },
        {
          "id": "5646708",
          "text": "È proibito nuotare in questo lago.",
          "translation": "Купаться в этом озере запрещено.",
          "source": "Tatoeba #5646708 @dnnywld / #5646434 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646708",
          "cefr_level": "A1",
