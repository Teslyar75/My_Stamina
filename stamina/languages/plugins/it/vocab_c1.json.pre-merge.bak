    {
      "slug": "cola-noun",
      "lemma": "cola",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9658,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5614130",
          "text": "Una Cola, per favore.",
          "translation": "Колу, пожалуйста.",
          "source": "Tatoeba #5614130 @dnnywld / #5612800 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614130",
          "cefr_level": "A1",
          "word_slugs": [
            "cola-noun"
          ]
        },
        {
          "id": "4262157",
          "text": "Loro bevono la Coca-Cola.",
          "translation": "Они пьют кока-колу.",
          "source": "Tatoeba #4262157 @bailujia / #4262193 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4262157",
          "cefr_level": "A1",
          "word_slugs": [
            "cola-noun"
          ]
        },
        {
          "id": "5394495",
          "text": "Prendimi solo la coca cola.",
          "translation": "Мне возьми только колу.",
          "source": "Tatoeba #5394495 @dnnywld / #5394469 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5394495",
          "cefr_level": "A1",
          "word_slugs": [
            "cola-noun"
          ]
        },
        {
          "id": "6942981",
          "text": "Ho mal di gola e il naso che cola.",
          "translation": "У меня болит горло и насморк.",
          "source": "Tatoeba #6942981 @dnnywld / #6941817 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6942981",
          "cefr_level": "A1",
          "word_slugs": [
            "cola-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
