      "cefr_level": "C1",
      "frequency_rank": 9237,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2834930",
          "text": "Tom iniziò a urlare.",
          "translation": "Том начал орать.",
          "source": "Tatoeba #2834930 @Guybrush88 / #5908778 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2834930",
          "cefr_level": "A1",
          "word_slugs": [
