      "examples": [
        {
          "id": "5856693",
          "text": "Hai degli incubi.",
          "translation": "Тебе снятся кошмары.",
          "source": "Tatoeba #5856693 @dnnywld / #3130754 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5856693",
