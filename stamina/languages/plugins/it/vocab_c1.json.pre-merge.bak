    {
      "slug": "cinture-noun",
      "lemma": "cinture",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8611,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6488927",
          "text": "Nessuno indossava le cinture di sicurezza.",
          "translation": "Ни один не был пристёгнут.",
          "source": "Tatoeba #6488927 @dnnywld / #6488640 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6488927",
          "cefr_level": "A1",
          "word_slugs": [
            "cinture-noun"
          ]
        },
        {
          "id": "6890139",
          "text": "Quando guido mi allaccio sempre le cinture.",
          "translation": "Я всегда пристёгиваюсь, когда веду машину.",
          "source": "Tatoeba #6890139 @dnnywld / #5701250 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890139",
          "cefr_level": "A1",
          "word_slugs": [
            "cinture-noun"
          ]
        },
        {
          "id": "6852858",
          "text": "Vi preghiamo di allacciare le cinture di sicurezza!",
          "translation": "Просим вас пристегнуть ремни!",
          "source": "Tatoeba #6852858 @dnnywld / #6852545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6852858",
          "cefr_level": "A1",
          "word_slugs": [
            "cinture-noun"
          ]
        },
        {
          "id": "7433505",
          "text": "I conducenti devono mettersi le cinture di sicurezza.",
          "translation": "Водители должны пристегиваться ремнём безопасности.",
          "source": "Tatoeba #7433505 @dnnywld / #7432202 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7433505",
          "cefr_level": "A1",
          "word_slugs": [
            "cinture-noun"
          ]
        },
        {
          "id": "5968607",
          "text": "Non dimenticarti di allacciare le cinture di sicurezza.",
          "translation": "Не забудь пристегнуть ремень безопасности.",
          "source": "Tatoeba #5968607 @dnnywld / #5968530 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968607",
          "cefr_level": "A1",
          "word_slugs": [
            "cinture-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la cinture",
        "plural": "",
        "infinitive": ""
      }
    },
