    {
      "slug": "desiderare-verb",
      "lemma": "desiderare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6805,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "желать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6786720",
          "text": "Questo lascia molto a desiderare.",
          "translation": "Это оставляет желать лучшего.",
          "source": "Tatoeba #6786720 @dnnywld / #6054694 @sergiomelo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786720",
          "cefr_level": "A1",
          "word_slugs": [
            "desiderare-verb"
          ]
        },
        {
          "id": "6786624",
          "text": "La qualità lascia molto a desiderare.",
          "translation": "Качество оставляет желать лучшего.",
          "source": "Tatoeba #6786624 @dnnywld / #4984075 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786624",
          "cefr_level": "A1",
          "word_slugs": [
            "desiderare-verb"
          ]
        },
        {
          "id": "6786737",
          "text": "Questo risultato lascia molto a desiderare.",
          "translation": "Этот результат оставляет желать лучшего.",
          "source": "Tatoeba #6786737 @dnnywld / #468054 @sh0gg0th (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786737",
          "cefr_level": "A1",
          "word_slugs": [
            "desiderare-verb"
          ]
        },
        {
          "id": "4441",
          "text": "Non desiderare è lo stesso che avere.",
          "translation": "Не желать обладать - всё равно что обладать.",
          "source": "Tatoeba #4441 @Guybrush88 / #5637 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4441",
          "cefr_level": "A1",
          "word_slugs": [
            "desiderare-verb"
          ]
        },
        {
          "id": "1539404",
          "text": "Il suo piano lascia molto a desiderare.",
          "translation": "Его план оставляет желать лучшего.",
          "source": "Tatoeba #1539404 @Guybrush88 / #1465890 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1539404",
          "cefr_level": "A1",
          "word_slugs": [
            "desiderare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "desiderare",
        "plural": "",
        "infinitive": "desiderare"
      }
    },
    {
      "slug": "prepararsi-verb",
      "lemma": "prepararsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6806,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10844049",
          "text": "Ho aiutato Tom a prepararsi.",
          "translation": "Я помогла Тому подготовиться.",
          "source": "Tatoeba #10844049 @dnnywld / #10841863 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844049",
          "cefr_level": "A1",
          "word_slugs": [
            "prepararsi-verb"
          ]
        },
        {
          "id": "5517847",
          "text": "Tom deve prepararsi per la scuola.",
          "translation": "Тому нужно готовиться к школе.",
          "source": "Tatoeba #5517847 @dnnywld / #5517069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5517847",
          "cefr_level": "A1",
          "word_slugs": [
            "prepararsi-verb"
          ]
        },
        {
          "id": "3516822",
          "text": "Lei è impegnata a prepararsi per il viaggio.",
          "translation": "Она занята подготовкой к путешествию.",
          "source": "Tatoeba #3516822 @Guybrush88 / #500644 @drnm2 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3516822",
          "cefr_level": "A1",
          "word_slugs": [
            "prepararsi-verb"
          ]
        },
        {
          "id": "6691622",
          "text": "Per prepararsi all'esame occorrono più o meno cinque giorni.",
          "translation": "Чтобы более-менее подготовиться к экзамену, нужно дней пять.",
          "source": "Tatoeba #6691622 @dnnywld / #6690711 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6691622",
          "cefr_level": "A1",
          "word_slugs": [
            "prepararsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "prepararsi",
        "plural": "",
        "infinitive": "prepararsi"
      }
    },
