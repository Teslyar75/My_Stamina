      "examples": [
        {
          "id": "7949507",
          "text": "Dammi la tua freccia.",
          "translation": "Дай мне свою стрелу.",
          "source": "Tatoeba #7949507 @dnnywld / #7949468 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7949507",
          "cefr_level": "A1",
