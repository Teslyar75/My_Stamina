    {
      "slug": "escono-verb",
      "lemma": "escono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5871,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5474244",
          "text": "Tom e Mary escono insieme.",
          "translation": "Том и Мэри встречаются.",
          "source": "Tatoeba #5474244 @dnnywld / #5473946 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5474244",
          "cefr_level": "A1",
          "word_slugs": [
