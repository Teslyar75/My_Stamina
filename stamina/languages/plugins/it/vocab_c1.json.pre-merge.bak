    {
      "slug": "versato-adj",
      "lemma": "versato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6893,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6025158",
          "text": "Cos'hai versato?",
          "translation": "Что ты пролил?",
          "source": "Tatoeba #6025158 @dnnywld / #6024536 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6025158",
          "cefr_level": "A1",
          "word_slugs": [
            "versato-adj"
          ]
        },
        {
          "id": "6949119",
          "text": "Ho versato dell'acqua.",
          "translation": "Я долил воды.",
          "source": "Tatoeba #6949119 @dnnywld / #6388535 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6949119",
          "cefr_level": "A1",
          "word_slugs": [
            "versato-adj"
          ]
        },
        {
          "id": "5897398",
          "text": "Lei ha versato lacrime amare.",
          "translation": "Она плакала горькими слезами.",
          "source": "Tatoeba #5897398 @dnnywld / #5897070 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5897398",
          "cefr_level": "A1",
          "word_slugs": [
            "versato-adj"
          ]
        },
        {
          "id": "5908157",
          "text": "Tom ha versato di nuovo qualcosa?",
          "translation": "Том снова что-то разлил?",
          "source": "Tatoeba #5908157 @dnnywld / #5907613 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5908157",
          "cefr_level": "A1",
          "word_slugs": [
            "versato-adj"
          ]
        },
        {
          "id": "5494196",
          "text": "Lui si è versato del latte nel caffè.",
          "translation": "Он налил себе в кофе молока.",
          "source": "Tatoeba #5494196 @dnnywld / #5493625 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494196",
          "cefr_level": "A1",
          "word_slugs": [
