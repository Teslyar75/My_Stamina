    {
      "slug": "senno-noun",
      "lemma": "senno",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7559,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6024992",
          "text": "Siete usciti di senno!",
          "translation": "Да вы с ума сошли!",
          "source": "Tatoeba #6024992 @dnnywld / #6024595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6024992",
          "cefr_level": "A1",
          "word_slugs": [
            "senno-noun"
          ]
        },
        {
          "id": "6939320",
          "text": "Non ho ancora perso il senno.",
          "translation": "Я ещё из ума не выжил.",
          "source": "Tatoeba #6939320 @dnnywld / #6938391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6939320",
          "cefr_level": "A1",
          "word_slugs": [
            "senno-noun"
          ]
        },
        {
          "id": "5551328",
          "text": "Voi ragazzi, siete usciti di senno?",
          "translation": "Вы, ребята, сошли с ума?",
          "source": "Tatoeba #5551328 @dnnywld / #5551188 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551328",
          "cefr_level": "A1",
          "word_slugs": [
            "senno-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
