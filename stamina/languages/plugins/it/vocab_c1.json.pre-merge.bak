      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5070249",
          "text": "La tua approvazione non è richiesta.",
          "translation": "Твоё одобрение не требуется.",
          "source": "Tatoeba #5070249 @Guybrush88 / #5179846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5070249",
          "cefr_level": "A1",
          "word_slugs": [
