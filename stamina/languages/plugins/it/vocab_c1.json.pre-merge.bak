    {
      "slug": "autorizzato-adj",
      "lemma": "autorizzato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5213,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4166910",
          "text": "Chi ha autorizzato questo?",
          "translation": "Кто дал на это согласие?",
          "source": "Tatoeba #4166910 @Guybrush88 / #5516062 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4166910",
          "cefr_level": "A1",
          "word_slugs": [
            "autorizzato-adj"
          ]
        },
        {
          "id": "7587860",
          "text": "Non sono autorizzato a deliberarlo.",
          "translation": "Я не уполномочен это обсуждать.",
          "source": "Tatoeba #7587860 @dnnywld / #7587522 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7587860",
          "cefr_level": "A1",
          "word_slugs": [
            "autorizzato-adj"
          ]
        },
        {
          "id": "10844409",
          "text": "Deve essere autorizzato dalla costituzione.",
          "translation": "Это должно быть прописано в конституции.",
          "source": "Tatoeba #10844409 @dnnywld / #7276760 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844409",
          "cefr_level": "A1",
          "word_slugs": [
            "autorizzato-adj"
          ]
        },
        {
          "id": "2815978",
          "text": "Non è autorizzato ad andare lì dentro!",
          "translation": "Вы не можете пойти туда!",
          "source": "Tatoeba #2815978 @Guybrush88 / #3509641 @Dark_Messiah (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2815978",
          "cefr_level": "A1",
          "word_slugs": [
            "autorizzato-adj"
          ]
        },
        {
          "id": "5532907",
          "text": "Non hanno autorizzato Tom a fare questo.",
          "translation": "Тому не разрешили это сделать.",
          "source": "Tatoeba #5532907 @dnnywld / #5532891 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5532907",
          "cefr_level": "A1",
          "word_slugs": [
            "autorizzato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il autorizzato",
        "plural": "",
        "infinitive": ""
      }
