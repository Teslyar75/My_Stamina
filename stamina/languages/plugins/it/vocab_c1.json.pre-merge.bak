    {
      "slug": "distinguere-verb",
      "lemma": "distinguere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9438,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10825695",
          "text": "Come distinguere la lingua dal dialetto?",
          "translation": "Как отличить язык от диалекта?",
          "source": "Tatoeba #10825695 @dnnywld / #10825684 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10825695",
          "cefr_level": "A1",
          "word_slugs": [
            "distinguere-verb"
          ]
        },
        {
          "id": "5579954",
          "text": "È impossibile distinguere uno dall'altro.",
          "translation": "Невозможно отличить один от другого.",
          "source": "Tatoeba #5579954 @dnnywld / #5579624 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5579954",
          "cefr_level": "A1",
          "word_slugs": [
            "distinguere-verb"
          ]
        },
        {
          "id": "704976",
          "text": "Riesci a distinguere l'argento dallo stagno?",
          "translation": "Ты можешь отличить серебро от олова?",
          "source": "Tatoeba #704976 @Heracleum / #3232366 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/704976",
          "cefr_level": "A1",
          "word_slugs": [
            "distinguere-verb"
          ]
        },
        {
          "id": "5491515",
          "text": "Potete distinguere un cinese da un giapponese?",
          "translation": "Вы можете отличить китайца от японца?",
          "source": "Tatoeba #5491515 @dnnywld / #5491021 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5491515",
          "cefr_level": "A1",
          "word_slugs": [
            "distinguere-verb"
          ]
        },
        {
          "id": "7053273",
          "text": "È difficile distinguere la verità dalla menzogna.",
          "translation": "Трудно отличить истину от лжи.",
          "source": "Tatoeba #7053273 @dnnywld / #7053121 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7053273",
          "cefr_level": "A1",
          "word_slugs": [
            "distinguere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "distinguere",
        "plural": "",
        "infinitive": "distinguere"
      }
