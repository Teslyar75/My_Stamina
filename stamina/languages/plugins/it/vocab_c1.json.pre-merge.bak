    {
      "slug": "terremo-verb",
      "lemma": "terremo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7116,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5454023",
          "text": "Vi terremo informati.",
          "translation": "Мы будем держать вас в курсе.",
          "source": "Tatoeba #5454023 @dnnywld / #5453942 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5454023",
          "cefr_level": "A1",
          "word_slugs": [
            "terremo-verb"
          ]
        },
        {
          "id": "5454024",
          "text": "Ti terremo informato.",
          "translation": "Мы будем держать тебя в курсе.",
          "source": "Tatoeba #5454024 @dnnywld / #5453941 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5454024",
          "cefr_level": "A1",
          "word_slugs": [
            "terremo-verb"
          ]
        },
        {
          "id": "5576124",
          "text": "Terremo d'occhio Tom.",
          "translation": "Мы присмотрим за Томом.",
          "source": "Tatoeba #5576124 @dnnywld / #5576114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5576124",
          "cefr_level": "A1",
          "word_slugs": [
            "terremo-verb"
          ]
        },
        {
          "id": "4213903",
          "text": "Stasera terremo una conferenza.",
          "translation": "Сегодня вечером мы дадим конференцию.",
          "source": "Tatoeba #4213903 @Guybrush88 / #5388437 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4213903",
          "cefr_level": "A1",
          "word_slugs": [
            "terremo-verb"
          ]
        },
        {
          "id": "5985219",
