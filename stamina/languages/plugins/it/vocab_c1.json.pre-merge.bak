    {
      "slug": "verdetto-adj",
      "lemma": "verdetto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6159,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6292329",
          "text": "La diagnosi suonava come un verdetto.",
          "translation": "Диагноз звучал как приговор.",
          "source": "Tatoeba #6292329 @dnnywld / #6292045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6292329",
          "cefr_level": "A1",
          "word_slugs": [
            "verdetto-adj"
          ]
        },
        {
          "id": "5800751",
          "text": "La giuria non ha ancora emesso il verdetto.",
          "translation": "Присяжные ещё не вынесли вердикт.",
          "source": "Tatoeba #5800751 @dnnywld / #5800336 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5800751",
          "cefr_level": "A1",
          "word_slugs": [
            "verdetto-adj"
          ]
        },
        {
          "id": "6738825",
          "text": "Il verdetto è definitivo e non può essere impugnato.",
          "translation": "Приговор окончательный и обжалованию не подлежит.",
          "source": "Tatoeba #6738825 @dnnywld / #6738661 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6738825",
          "cefr_level": "A1",
          "word_slugs": [
            "verdetto-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
