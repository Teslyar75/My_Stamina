      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13495343",
          "text": "Cercheremo di fare qualcosa.",
          "translation": "Мы попробуем что-нибудь сделать.",
          "source": "Tatoeba #13495343 @dnnywld / #11339671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495343",
          "cefr_level": "A1",
          "word_slugs": [
