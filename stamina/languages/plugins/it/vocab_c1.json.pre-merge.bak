        },
        {
          "id": "4698961",
          "text": "Non ha senso dell'umorismo.",
          "translation": "У неё нет чувства юмора.",
          "source": "Tatoeba #4698961 @Guybrush88 / #4705646 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4698961",
          "cefr_level": "A1",
          "word_slugs": [
            "umorismo-noun"
          ]
        },
        {
          "id": "1655392",
          "text": "Non capisce l'umorismo britannico.",
          "translation": "Он не понимает английский юмор.",
          "source": "Tatoeba #1655392 @Guybrush88 / #2128187 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1655392",
          "cefr_level": "A1",
          "word_slugs": [
            "umorismo-noun"
          ]
        },
        {
          "id": "5415719",
          "text": "Non mi piace il tuo umorismo.",
          "translation": "Не нравится мне твой юмор.",
          "source": "Tatoeba #5415719 @dnnywld / #5415674 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415719",
          "cefr_level": "A1",
          "word_slugs": [
            "umorismo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
