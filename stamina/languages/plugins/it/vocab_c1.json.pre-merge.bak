    {
      "slug": "sottile-adj",
      "lemma": "sottile",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6623,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5429532",
          "text": "Raccontare frottole alle persone è un'arte sottile.",
          "translation": "Вешать людям лапшу на уши — дело тонкое.",
          "source": "Tatoeba #5429532 @dnnywld / #2533047 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5429532",
          "cefr_level": "A1",
          "word_slugs": [
            "sottile-adj"
          ]
        },
        {
          "id": "6770367",
          "text": "Il tessuto in seta era sottile come una ragnatela.",
          "translation": "Шёлковая ткань была тонкой, как паутина.",
          "source": "Tatoeba #6770367 @dnnywld / #6769056 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770367",
          "cefr_level": "A1",
          "word_slugs": [
            "sottile-adj"
          ]
        },
        {
          "id": "2762346",
          "text": "Questo bambù è troppo sottile per sopportare molto peso.",
          "translation": "Этот бамбук слишком тонкий, чтобы выдержать большой вес.",
          "source": "Tatoeba #2762346 @Guybrush88 / #3089940 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2762346",
