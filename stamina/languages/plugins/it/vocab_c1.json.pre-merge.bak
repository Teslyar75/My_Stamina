      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5486473",
          "text": "Con chi andrete?",
          "translation": "С кем вы пойдёте?",
          "source": "Tatoeba #5486473 @dnnywld / #5485339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5486473",
          "cefr_level": "A1",
          "word_slugs": [
            "andrete-verb"
          ]
        },
        {
          "id": "5569788",
          "text": "Andrete a scuola.",
          "translation": "Вы пойдёте в школу.",
          "source": "Tatoeba #5569788 @dnnywld / #5569658 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5569788",
          "cefr_level": "A1",
          "word_slugs": [
            "andrete-verb"
          ]
        },
        {
          "id": "5672439",
          "text": "Andrete al ballo?",
          "translation": "Вы поедете на бал?",
          "source": "Tatoeba #5672439 @dnnywld / #5672034 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672439",
          "cefr_level": "A1",
          "word_slugs": [
            "andrete-verb"
          ]
        },
        {
          "id": "7137878",
          "text": "Non so dove andrete.",
          "translation": "Я не знаю, куда вы пойдёте.",
          "source": "Tatoeba #7137878 @dnnywld / #7133404 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7137878",
          "cefr_level": "A1",
          "word_slugs": [
            "andrete-verb"
          ]
        },
        {
          "id": "6365456",
          "text": "Ve ne andrete presto?",
          "translation": "Вы скоро уедете?",
          "source": "Tatoeba #6365456 @dnnywld / #6179077 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6365456",
          "cefr_level": "A1",
