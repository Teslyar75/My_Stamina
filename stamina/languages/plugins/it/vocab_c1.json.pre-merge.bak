          ]
        },
        {
          "id": "6857649",
          "text": "L'esibizione è già cominciata?",
          "translation": "Представление уже началось?",
          "source": "Tatoeba #6857649 @dnnywld / #3045838 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857649",
