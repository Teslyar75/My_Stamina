          ]
        },
        {
          "id": "5749038",
          "text": "La sicurezza è un'illusione.",
          "translation": "Безопасность — это иллюзия.",
          "source": "Tatoeba #5749038 @Guybrush88 / #5979068 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5749038",
          "cefr_level": "A1",
          "word_slugs": [
