    {
      "slug": "trattenere-verb",
      "lemma": "trattenere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8935,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5727219",
          "text": "Non ho potuto trattenere le lacrime.",
          "translation": "Я не смогла удержаться от слёз.",
          "source": "Tatoeba #5727219 @dnnywld / #5726985 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5727219",
          "cefr_level": "A1",
          "word_slugs": [
            "trattenere-verb"
          ]
        },
        {
          "id": "5554544",
          "text": "Non riuscivamo a trattenere le lacrime.",
          "translation": "Мы не могли сдержать слёз.",
          "source": "Tatoeba #5554544 @dnnywld / #5554151 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5554544",
          "cefr_level": "A1",
          "word_slugs": [
            "trattenere-verb"
          ]
        },
        {
          "id": "5629669",
          "text": "Tom non riuscì a trattenere la rabbia.",
          "translation": "Том не мог сдержать гнева.",
          "source": "Tatoeba #5629669 @dnnywld / #5629060 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629669",
          "cefr_level": "A1",
          "word_slugs": [
            "trattenere-verb"
          ]
        },
        {
          "id": "5403819",
          "text": "Lei non ha potuto trattenere le emozioni.",
          "translation": "Она не смогла сдержать эмоций.",
          "source": "Tatoeba #5403819 @dnnywld / #5191924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5403819",
          "cefr_level": "A1",
          "word_slugs": [
            "trattenere-verb"
          ]
        },
        {
          "id": "5453989",
          "text": "A volte non riesco a trattenere le emozioni.",
          "translation": "Иногда я не могу сдержать эмоций.",
          "source": "Tatoeba #5453989 @dnnywld / #5483 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5453989",
          "cefr_level": "A1",
          "word_slugs": [
            "trattenere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "trattenere",
        "plural": "",
        "infinitive": "trattenere"
      }
    },
