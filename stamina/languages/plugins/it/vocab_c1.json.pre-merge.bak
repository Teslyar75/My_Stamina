    {
      "slug": "innamorati-adj",
      "lemma": "innamorati",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5107,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4406661",
          "text": "Voi due sembrate innamorati.",
          "translation": "Вы двое кажетесь влюблёнными.",
          "source": "Tatoeba #4406661 @valealb / #4406698 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4406661",
          "cefr_level": "A1",
          "word_slugs": [
            "innamorati-adj"
          ]
        },
        {
          "id": "1130724",
          "text": "Gli innamorati si tengono per mano.",
          "translation": "Влюблённые держатся за руки.",
          "source": "Tatoeba #1130724 @Guybrush88 / #3882122 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1130724",
          "cefr_level": "A1",
          "word_slugs": [
            "innamorati-adj"
          ]
        },
        {
          "id": "5482240",
          "text": "Tom e Mary sono veramente innamorati.",
          "translation": "Том и Мэри сильно влюблены.",
          "source": "Tatoeba #5482240 @dnnywld / #5481878 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5482240",
          "cefr_level": "A1",
          "word_slugs": [
            "innamorati-adj"
          ]
        },
        {
          "id": "5533397",
          "text": "Siamo tutte femmine quando siamo innamorati.",
          "translation": "Все мы — женщины, когда влюблены.",
          "source": "Tatoeba #5533397 @dnnywld / #5533318 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5533397",
          "cefr_level": "A1",
          "word_slugs": [
            "innamorati-adj"
          ]
        },
        {
          "id": "5570945",
          "text": "Sono innamorati perdutamente l'uno dell'altro.",
          "translation": "Они любят друг друга без памяти.",
          "source": "Tatoeba #5570945 @dnnywld / #5570858 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5570945",
          "cefr_level": "A1",
          "word_slugs": [
            "innamorati-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
