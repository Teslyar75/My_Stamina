    {
      "slug": "responsabili-adj",
      "lemma": "responsabili",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5077,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6950266",
          "text": "Siamo responsabili per i danni.",
          "translation": "Мы несём ответственность за убытки.",
          "source": "Tatoeba #6950266 @dnnywld / #1800146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950266",
          "cefr_level": "A1",
          "word_slugs": [
            "responsabili-adj"
          ]
        },
        {
          "id": "5611976",
          "text": "So che non siete responsabili di questo.",
          "translation": "Я знаю, что вы несёте за это ответственность.",
          "source": "Tatoeba #5611976 @dnnywld / #5611954 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5611976",
          "cefr_level": "A1",
          "word_slugs": [
            "responsabili-adj"
          ]
        },
        {
          "id": "12016245",
          "text": "I genitori sono responsabili dei figli minorenni.",
          "translation": "Родители несут ответственность за несовершеннолетних детей.",
          "source": "Tatoeba #12016245 @carlosalberto / #11516162 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12016245",
          "cefr_level": "A1",
          "word_slugs": [
            "responsabili-adj"
          ]
        },
        {
          "id": "5495453",
          "text": "Le persone sono responsabili delle proprie azioni.",
          "translation": "Люди несут ответственность за свои действия.",
          "source": "Tatoeba #5495453 @dnnywld / #5495364 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5495453",
          "cefr_level": "A1",
          "word_slugs": [
            "responsabili-adj"
          ]
        },
        {
          "id": "5532025",
          "text": "I ribosomi sono organelli responsabili della sintesi delle proteine.",
          "translation": "Рибосомы — это органеллы, которые отвечают за синтез белков.",
          "source": "Tatoeba #5532025 @dnnywld / #5530945 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5532025",
          "cefr_level": "A1",
          "word_slugs": [
            "responsabili-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il responsabili",
