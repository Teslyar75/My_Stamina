    {
      "slug": "server-noun",
      "lemma": "server",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6023,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5392854",
          "text": "Il server è sovraccarico.",
          "translation": "Сервер перегружен.",
          "source": "Tatoeba #5392854 @dnnywld / #3567703 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5392854",
          "cefr_level": "A1",
          "word_slugs": [
            "server-noun"
          ]
        },
        {
          "id": "6843013",
          "text": "Di tanto in tanto il server cade.",
          "translation": "Время от времени сервер падает.",
          "source": "Tatoeba #6843013 @dnnywld / #3567705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843013",
          "cefr_level": "A1",
          "word_slugs": [
            "server-noun"
          ]
        },
        {
          "id": "7712913",
          "text": "Impossibile connettersi al server. Controllate le impostazioni di rete.",
          "translation": "Не удалось подключиться к серверу. Проверьте настройки сети.",
          "source": "Tatoeba #7712913 @dnnywld / #7709231 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7712913",
          "cefr_level": "A1",
          "word_slugs": [
            "server-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il server",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "diamante-noun",
      "lemma": "diamante",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6025,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5676755",
          "text": "Tom è un diamante grezzo.",
          "translation": "Том — неогранённый алмаз.",
          "source": "Tatoeba #5676755 @dnnywld / #5676584 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5676755",
          "cefr_level": "A1",
          "word_slugs": [
            "diamante-noun"
          ]
        },
        {
          "id": "6916331",
          "text": "Tom ha rubato il diamante.",
          "translation": "Том украл алмаз.",
          "source": "Tatoeba #6916331 @Guybrush88 / #5077383 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6916331",
          "cefr_level": "A1",
          "word_slugs": [
            "diamante-noun"
          ]
        },
        {
          "id": "10851068",
          "text": "Il diamante taglia il diamante.",
          "translation": "Алмаз режет алмаз.",
          "source": "Tatoeba #10851068 @dnnywld / #445238 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851068",
          "cefr_level": "A1",
          "word_slugs": [
            "diamante-noun"
          ]
        },
        {
          "id": "692214",
          "text": "Il diamante è una pietra preziosa.",
          "translation": "Алмаз - драгоценный камень.",
          "source": "Tatoeba #692214 @Pharamp / #6594664 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/692214",
          "cefr_level": "A1",
          "word_slugs": [
            "diamante-noun"
          ]
        },
        {
          "id": "6018631",
          "text": "È un diamante vero o un falso?",
          "translation": "Это настоящий бриллиант или подделка?",
          "source": "Tatoeba #6018631 @dnnywld / #6018029 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6018631",
          "cefr_level": "A1",
          "word_slugs": [
            "diamante-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il diamante",
        "plural": "",
        "infinitive": ""
      }
