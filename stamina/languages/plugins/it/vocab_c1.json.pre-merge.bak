    {
      "slug": "accompagna-verb",
      "lemma": "accompagna",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9682,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13601849",
          "text": "Ti accompagna lui?",
          "translation": "Он тебя проводит?",
          "source": "Tatoeba #13601849 @dnnywld / #13601684 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13601849",
          "cefr_level": "A1",
          "word_slugs": [
            "accompagna-verb"
          ]
        },
        {
          "id": "10851069",
          "text": "Il padre accompagna Mary all'altare.",
          "translation": "Отец ведёт Марию к алтарю.",
          "source": "Tatoeba #10851069 @dnnywld / #6175504 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851069",
          "cefr_level": "A1",
          "word_slugs": [
            "accompagna-verb"
          ]
        },
        {
          "id": "10760084",
          "text": "L'importante è che lei mi accompagna.",
          "translation": "Важно, чтобы она пошла со мной.",
          "source": "Tatoeba #10760084 @dnnywld / #10162384 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10760084",
          "cefr_level": "A1",
          "word_slugs": [
            "accompagna-verb"
          ]
        },
        {
          "id": "10760087",
          "text": "L'importante è che lui mi accompagna.",
          "translation": "Важно, чтобы он пошёл со мной.",
          "source": "Tatoeba #10760087 @dnnywld / #10162386 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10760087",
          "cefr_level": "A1",
          "word_slugs": [
            "accompagna-verb"
          ]
        },
        {
          "id": "381915",
          "text": "Anche se nessuno mi accompagna, andrò comunque a vedere questo film.",
          "translation": "Даже если никто не составит мне компанию, я всё равно пойду на этот фильм.",
          "source": "Tatoeba #381915 @Pharamp / #4225751 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/381915",
          "cefr_level": "A1",
          "word_slugs": [
            "accompagna-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
