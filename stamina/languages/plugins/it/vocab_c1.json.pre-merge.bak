    {
      "slug": "sembrate-verb",
      "lemma": "sembrate",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6013,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5514346",
          "text": "Sembrate in forma.",
          "translation": "Хорошо выглядите.",
          "source": "Tatoeba #5514346 @dnnywld / #5513479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514346",
          "cefr_level": "A1",
          "word_slugs": [
            "sembrate-verb"
          ]
        },
        {
          "id": "6005791",
          "text": "Sembrate un turista.",
          "translation": "Вы похожи на туриста.",
          "source": "Tatoeba #6005791 @dnnywld / #4177529 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6005791",
          "cefr_level": "A1",
          "word_slugs": [
            "sembrate-verb"
          ]
        },
        {
          "id": "5635612",
          "text": "Sembrate un giapponese.",
          "translation": "Вы похожи на японцев.",
          "source": "Tatoeba #5635612 @dnnywld / #4427521 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635612",
          "cefr_level": "A1",
          "word_slugs": [
            "sembrate-verb"
          ]
        },
        {
          "id": "6598223",
          "text": "Sembrate dei senzatetto.",
          "translation": "Вы похожи на бездомного.",
          "source": "Tatoeba #6598223 @dnnywld / #6597869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6598223",
          "cefr_level": "A1",
          "word_slugs": [
            "sembrate-verb"
          ]
        },
        {
          "id": "6702547",
          "text": "Sembrate esattamente lui.",
          "translation": "Вы выглядите в точности как он.",
          "source": "Tatoeba #6702547 @dnnywld / #6701292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6702547",
          "cefr_level": "A1",
          "word_slugs": [
            "sembrate-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sembrate",
        "plural": "",
        "infinitive": "sembrate"
      }
