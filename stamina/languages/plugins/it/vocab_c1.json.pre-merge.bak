          ]
        },
        {
          "id": "5474789",
          "text": "Noi non perdiamo spesso.",
          "translation": "Мы не часто проигрываем.",
          "source": "Tatoeba #5474789 @dnnywld / #5474771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5474789",
          "cefr_level": "A1",
          "word_slugs": [
            "perdiamo-verb"
          ]
        },
        {
          "id": "6811231",
          "text": "Sbrigati, altrimenti perdiamo il treno.",
          "translation": "Поторопись, иначе мы опоздаем на поезд.",
          "source": "Tatoeba #6811231 @dnnywld / #2278580 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6811231",
          "cefr_level": "A1",
          "word_slugs": [
            "perdiamo-verb"
          ]
        }
      ],
      "tags": [
