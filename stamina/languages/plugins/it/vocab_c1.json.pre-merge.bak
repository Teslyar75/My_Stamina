    {
      "slug": "occupando-verb",
      "lemma": "occupando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5686,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5456653",
          "text": "Me ne sto già occupando io.",
          "translation": "Это уже моя забота.",
          "source": "Tatoeba #5456653 @dnnywld / #5456505 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5456653",
          "cefr_level": "A1",
          "word_slugs": [
            "occupando-verb"
          ]
        },
        {
          "id": "5521869",
          "text": "Tom se ne sta occupando adesso.",
          "translation": "Том этим сейчас занимается.",
          "source": "Tatoeba #5521869 @dnnywld / #5520968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5521869",
          "cefr_level": "A1",
          "word_slugs": [
            "occupando-verb"
          ]
        },
        {
          "id": "6160146",
          "text": "Di cosa vi state occupando qui?",
          "translation": "Чем вы здесь занимаетесь?",
          "source": "Tatoeba #6160146 @dnnywld / #6159744 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6160146",
          "cefr_level": "A1",
          "word_slugs": [
            "occupando-verb"
          ]
        },
        {
          "id": "10817282",
          "text": "Mi sto occupando dei miei affari.",
          "translation": "Я занимаюсь своим делом.",
          "source": "Tatoeba #10817282 @dnnywld / #10817251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10817282",
          "cefr_level": "A1",
          "word_slugs": [
            "occupando-verb"
          ]
        },
        {
          "id": "5452743",
          "text": "Sembra che ti stia occupando del problema.",
          "translation": "Кажется, ты занялся проблемой.",
          "source": "Tatoeba #5452743 @dnnywld / #4012466 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452743",
          "cefr_level": "A1",
          "word_slugs": [
            "occupando-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
