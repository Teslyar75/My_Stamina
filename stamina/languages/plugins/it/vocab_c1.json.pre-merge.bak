    {
      "slug": "darei-verb",
      "lemma": "darei",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5722,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5642319",
          "text": "Vi darei di più, se potessi.",
          "translation": "Я бы вам больше дал, если бы мог.",
          "source": "Tatoeba #5642319 @dnnywld / #5642081 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642319",
          "cefr_level": "A1",
          "word_slugs": [
            "darei-verb"
          ]
        },
        {
          "id": "5642320",
          "text": "Ti darei di più, se potessi.",
          "translation": "Я бы дал тебе больше, если бы мог.",
          "source": "Tatoeba #5642320 @dnnywld / #5642080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642320",
          "cefr_level": "A1",
          "word_slugs": [
            "darei-verb"
          ]
        },
        {
          "id": "6873646",
          "text": "Darei tante cose per vederti di nuovo.",
          "translation": "Я многое бы отдал, чтобы увидеть тебя снова.",
          "source": "Tatoeba #6873646 @dnnywld / #6872620 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6873646",
          "cefr_level": "A1",
          "word_slugs": [
            "darei-verb"
          ]
        },
        {
          "id": "13818251",
          "text": "Lo darei ma ne ho bisogno io stesso.",
          "translation": "Я бы отдал, но мне самому нужно.",
          "source": "Tatoeba #13818251 @dnnywld / #6675674 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13818251",
          "cefr_level": "A1",
          "word_slugs": [
            "darei-verb"
          ]
        },
        {
          "id": "13818253",
          "text": "Li darei ma ne ho bisogno io stesso.",
          "translation": "Я бы отдал, но мне они самому нужны.",
          "source": "Tatoeba #13818253 @dnnywld / #6675673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13818253",
          "cefr_level": "A1",
          "word_slugs": [
            "darei-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
