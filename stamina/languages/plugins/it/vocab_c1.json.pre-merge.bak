    {
      "slug": "esaminato-verb",
      "lemma": "esaminato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6717,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7587867",
          "text": "Firmerò questo contratto non appena l'avrò esaminato.",
          "translation": "Я подпишу этот договор, как только изучу его.",
          "source": "Tatoeba #7587867 @dnnywld / #7587515 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7587867",
          "cefr_level": "A1",
          "word_slugs": [
            "esaminato-verb"
          ]
        },
        {
          "id": "5660572",
          "text": "Ho esaminato il paziente. Non è poi così grave.",
          "translation": "Я осмотрел пациента. Всё не так уж страшно.",
          "source": "Tatoeba #5660572 @dnnywld / #5660218 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5660572",
          "cefr_level": "A1",
          "word_slugs": [
            "esaminato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il esaminato",
        "plural": "",
        "infinitive": "esaminato"
