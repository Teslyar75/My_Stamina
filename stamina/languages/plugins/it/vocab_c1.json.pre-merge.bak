    {
      "slug": "appartengono-verb",
      "lemma": "appartengono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8000,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8177222",
          "text": "Appartengono tutti a Tom.",
          "translation": "Они все принадлежат Тому.",
          "source": "Tatoeba #8177222 @dnnywld / #8176953 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8177222",
          "cefr_level": "A1",
          "word_slugs": [
            "appartengono-verb"
          ]
        },
        {
          "id": "5899921",
          "text": "I cani appartengono a lei.",
          "translation": "Собаки принадлежат ей.",
          "source": "Tatoeba #5899921 @dnnywld / #5899817 @Ivanovich (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5899921",
          "cefr_level": "A1",
          "word_slugs": [
            "appartengono-verb"
          ]
        },
        {
          "id": "1923158",
          "text": "Queste scarpe appartengono a Tom.",
          "translation": "Эта обувь принадлежит Тому.",
          "source": "Tatoeba #1923158 @Guybrush88 / #3989327 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1923158",
          "cefr_level": "A1",
          "word_slugs": [
            "appartengono-verb"
          ]
        },
        {
          "id": "6764629",
          "text": "Questi libri appartengono a loro.",
          "translation": "Эти книги принадлежат им.",
          "source": "Tatoeba #6764629 @dnnywld / #6764318 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6764629",
          "cefr_level": "A1",
          "word_slugs": [
            "appartengono-verb"
          ]
        },
        {
          "id": "13818261",
          "text": "Appartengono a questo club scacchistico.",
          "translation": "Они состоят в этом шахматном клубе.",
          "source": "Tatoeba #13818261 @dnnywld / #4563762 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13818261",
          "cefr_level": "A1",
          "word_slugs": [
