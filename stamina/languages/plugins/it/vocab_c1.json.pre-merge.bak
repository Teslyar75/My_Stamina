    {
      "slug": "cartolina-noun",
      "lemma": "cartolina",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9795,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7646632",
          "text": "Spedite questa cartolina senza indugio.",
          "translation": "Обязательно отправьте эту открытку.",
          "source": "Tatoeba #7646632 @dnnywld / #7646281 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7646632",
          "cefr_level": "A1",
          "word_slugs": [
            "cartolina-noun"
          ]
        },
        {
          "id": "7646631",
          "text": "Spedisci questa cartolina senza indugio.",
          "translation": "Обязательно отправь эту открытку.",
          "source": "Tatoeba #7646631 @dnnywld / #7646282 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7646631",
          "cefr_level": "A1",
          "word_slugs": [
            "cartolina-noun"
          ]
        },
        {
          "id": "3339169",
          "text": "Posso spedire questa cartolina esagonale?",
          "translation": "Я могу отправить эту шестиугольную открытку?",
          "source": "Tatoeba #3339169 @bailujia / #3339174 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3339169",
          "cefr_level": "A1",
          "word_slugs": [
            "cartolina-noun"
          ]
        },
        {
          "id": "1467319",
          "text": "George mi ha mandato una cartolina di compleanno.",
          "translation": "Джордж послал мне открытку ко дню рождения.",
          "source": "Tatoeba #1467319 @Guybrush88 / #1839332 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1467319",
          "cefr_level": "A1",
          "word_slugs": [
            "cartolina-noun"
          ]
        },
        {
          "id": "3339168",
          "text": "Posso spedire questa cartolina o è troppo grande?",
          "translation": "Я могу отправить эту открытку, или она слишком большая?",
          "source": "Tatoeba #3339168 @bailujia / #3339170 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3339168",
          "cefr_level": "A1",
          "word_slugs": [
            "cartolina-noun"
          ]
        }
