    {
      "slug": "insegnanti-noun",
      "lemma": "insegnanti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5432,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6000744",
          "text": "Quanti insegnanti conosci?",
          "translation": "Сколько учителей ты знаешь?",
          "source": "Tatoeba #6000744 @dnnywld / #5999822 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6000744",
          "cefr_level": "A1",
          "word_slugs": [
            "insegnanti-noun"
          ]
        },
        {
          "id": "6000743",
          "text": "Quanti insegnanti conoscete?",
          "translation": "Сколько учителей вы знаете?",
          "source": "Tatoeba #6000743 @dnnywld / #5999821 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6000743",
          "cefr_level": "A1",
          "word_slugs": [
            "insegnanti-noun"
          ]
        },
        {
          "id": "5968638",
          "text": "Abbiamo degli insegnanti severi.",
          "translation": "У нас строгие учителя.",
          "source": "Tatoeba #5968638 @dnnywld / #5968207 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968638",
          "cefr_level": "A1",
          "word_slugs": [
            "insegnanti-noun"
          ]
        },
        {
          "id": "6576452",
          "text": "Tom e Mary sono insegnanti.",
