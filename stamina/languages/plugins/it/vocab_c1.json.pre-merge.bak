    {
      "slug": "malinteso-adj",
      "lemma": "malinteso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7362,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3764219",
          "text": "Questo è un malinteso.",
          "translation": "Это недоразумение.",
          "source": "Tatoeba #3764219 @Guybrush88 / #963118 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3764219",
          "cefr_level": "A1",
          "word_slugs": [
            "malinteso-adj"
          ]
        },
        {
          "id": "6879443",
          "text": "Sono certa che si tratta di un malinteso.",
          "translation": "Я убеждена, что речь идёт о недоразумении.",
          "source": "Tatoeba #6879443 @dnnywld / #5263261 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879443",
          "cefr_level": "A1",
          "word_slugs": [
            "malinteso-adj"
          ]
        },
        {
          "id": "6879447",
          "text": "Sono certo che si tratta di un malinteso.",
          "translation": "Я убеждён, что речь идёт о недоразумении.",
          "source": "Tatoeba #6879447 @dnnywld / #5263266 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879447",
          "cefr_level": "A1",
          "word_slugs": [
            "malinteso-adj"
          ]
        },
        {
          "id": "6764665",
          "text": "L'interprete tradusse erroneamente, e si verificò un malinteso.",
          "translation": "Переводчик перевёл неправильно, и вышло недоразумение.",
          "source": "Tatoeba #6764665 @dnnywld / #6764580 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6764665",
