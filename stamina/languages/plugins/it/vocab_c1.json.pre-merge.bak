    {
      "slug": "principi-noun",
      "lemma": "principi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5346,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5553579",
          "text": "Ho alcuni principi.",
          "translation": "У меня есть некоторые принципы.",
          "source": "Tatoeba #5553579 @dnnywld / #5552895 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5553579",
          "cefr_level": "A1",
          "word_slugs": [
            "principi-noun"
          ]
        },
        {
          "id": "1817853",
          "text": "È un uomo senza principi.",
          "translation": "Он беспринципный человек.",
          "source": "Tatoeba #1817853 @al_ex_an_der / #1817852 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1817853",
          "cefr_level": "A1",
          "word_slugs": [
            "principi-noun"
          ]
        },
        {
          "id": "10933157",
          "text": "Sono rimasto fedele ai miei principi.",
          "translation": "Я остался верен своим принципам.",
          "source": "Tatoeba #10933157 @dnnywld / #10933130 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10933157",
          "cefr_level": "A1",
          "word_slugs": [
            "principi-noun"
          ]
        },
        {
          "id": "5479185",
          "text": "I suoi principi sono contrari ai miei.",
          "translation": "Его принципы противоречат моим.",
          "source": "Tatoeba #5479185 @dnnywld / #5478783 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479185",
          "cefr_level": "A1",
          "word_slugs": [
            "principi-noun"
          ]
        },
        {
          "id": "5474626",
          "text": "Questo è uno dei miei principi fondamentali.",
          "translation": "Это один из моих жизненных принципов.",
          "source": "Tatoeba #5474626 @dnnywld / #5355212 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5474626",
          "cefr_level": "A1",
          "word_slugs": [
            "principi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
