    {
      "slug": "ginocchia-noun",
      "lemma": "ginocchia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5597,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3860920",
          "text": "Tom si sta massaggiando le ginocchia.",
          "translation": "Том массирует свои колени.",
          "source": "Tatoeba #3860920 @Guybrush88 / #6089312 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3860920",
          "cefr_level": "A1",
          "word_slugs": [
            "ginocchia-noun"
          ]
        },
        {
          "id": "6953087",
          "text": "Mary premette le ginocchia sul petto.",
          "translation": "Мэри поджала коленки к груди.",
          "source": "Tatoeba #6953087 @dnnywld / #6952865 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953087",
          "cefr_level": "A1",
          "word_slugs": [
            "ginocchia-noun"
          ]
        },
        {
          "id": "6856332",
          "text": "Questa è nonna da piccola sulle ginocchia di sua madre.",
          "translation": "Это бабушка маленькая на коленях у своей мамы.",
          "source": "Tatoeba #6856332 @dnnywld / #6856085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6856332",
          "cefr_level": "A1",
          "word_slugs": [
            "ginocchia-noun"
          ]
        }
      ],
      "tags": [
