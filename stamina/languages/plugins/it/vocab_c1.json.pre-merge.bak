    {
      "slug": "perderai-verb",
      "lemma": "perderai",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6242,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3898761",
          "text": "Tu perderai tempo.",
          "translation": "Ты потеряешь время.",
          "source": "Tatoeba #3898761 @Guybrush88 / #2760100 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3898761",
          "cefr_level": "A1",
          "word_slugs": [
            "perderai-verb"
          ]
        },
        {
          "id": "350907",
          "text": "Sbrigati, o perderai il treno.",
          "translation": "Поспеши, иначе опоздаешь на поезд.",
          "source": "Tatoeba #350907 @martin / #400484 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350907",
          "cefr_level": "A1",
          "word_slugs": [
            "perderai-verb"
          ]
        },
        {
          "id": "6841376",
          "text": "Lei teme che tu ti perderai.",
          "translation": "Она боится, что ты потеряешься.",
          "source": "Tatoeba #6841376 @dnnywld / #4175748 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841376",
          "cefr_level": "A1",
          "word_slugs": [
            "perderai-verb"
          ]
        },
        {
          "id": "6811218",
          "text": "Corri veloce, altrimenti perderai il treno.",
          "translation": "Беги быстро, иначе опоздаешь на автобус.",
          "source": "Tatoeba #6811218 @dnnywld / #2040978 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6811218",
          "cefr_level": "A1",
          "word_slugs": [
            "perderai-verb"
          ]
        },
        {
          "id": "6811210",
          "text": "Vai più veloce, altrimenti perderai il treno.",
          "translation": "Иди быстрее, иначе опоздаешь на поезд.",
          "source": "Tatoeba #6811210 @dnnywld / #1968028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6811210",
          "cefr_level": "A1",
          "word_slugs": [
            "perderai-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "perderai",
        "plural": "",
        "infinitive": "perderai"
      }
