    {
      "slug": "ugualmente-adv",
      "lemma": "ugualmente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9045,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6788603",
          "text": "Tom verrà ugualmente.",
          "translation": "Том всё равно придёт.",
          "source": "Tatoeba #6788603 @dnnywld / #4002580 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6788603",
          "cefr_level": "A1",
          "word_slugs": [
            "ugualmente-adv"
          ]
        },
        {
          "id": "5616362",
          "text": "Lo mangeremo ugualmente.",
          "translation": "Мы его всё равно съедим.",
          "source": "Tatoeba #5616362 @dnnywld / #5615573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616362",
          "cefr_level": "A1",
          "word_slugs": [
            "ugualmente-adv"
          ]
        },
        {
          "id": "6788660",
          "text": "Piove, ma verrò ugualmente.",
          "translation": "Пойдёт дождь, всё равно приду.",
          "source": "Tatoeba #6788660 @dnnywld / #2808777 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6788660",
          "cefr_level": "A1",
          "word_slugs": [
            "ugualmente-adv"
          ]
        },
        {
          "id": "1679246",
          "text": "È stato ugualmente sorpreso.",
          "translation": "Он также был удивлён.",
          "source": "Tatoeba #1679246 @Guybrush88 / #10136242 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1679246",
          "cefr_level": "A1",
          "word_slugs": [
            "ugualmente-adv"
          ]
        },
        {
          "id": "5584357",
          "text": "Nessuno ugualmente ti crederà.",
          "translation": "Тебе всё равно никто не поверит.",
          "source": "Tatoeba #5584357 @dnnywld / #5584334 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5584357",
          "cefr_level": "A1",
          "word_slugs": [
            "ugualmente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ugualmente",
        "plural": "",
        "infinitive": ""
      }
