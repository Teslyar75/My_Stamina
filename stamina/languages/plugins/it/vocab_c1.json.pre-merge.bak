    {
      "slug": "abbracci-noun",
      "lemma": "abbracci",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8932,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5999044",
          "text": "Non mi abbracci?",
          "translation": "А обнять?",
          "source": "Tatoeba #5999044 @dnnywld / #5548944 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5999044",
          "cefr_level": "A1",
          "word_slugs": [
            "abbracci-noun"
          ]
        },
        {
          "id": "5999081",
          "text": "Lasciate che Vi abbracci.",
          "translation": "Позвольте мне Вас обнять.",
          "source": "Tatoeba #5999081 @dnnywld / #2804750 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5999081",
          "cefr_level": "A1",
          "word_slugs": [
            "abbracci-noun"
          ]
        },
        {
          "id": "5530732",
          "text": "Tu abbracci i tuoi figli?",
          "translation": "Ты обнимаешь своих детей?",
          "source": "Tatoeba #5530732 @dnnywld / #5530639 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5530732",
          "cefr_level": "A1",
          "word_slugs": [
            "abbracci-noun"
          ]
        },
        {
          "id": "5999115",
          "text": "Ho bisogno che mi abbracci.",
          "translation": "Мне нужно, чтобы меня обняли.",
          "source": "Tatoeba #5999115 @dnnywld / #2927256 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5999115",
          "cefr_level": "A1",
          "word_slugs": [
            "abbracci-noun"
          ]
        },
        {
          "id": "8677707",
          "text": "Si sono scambiati baci e abbracci.",
          "translation": "Они обменялись поцелуями и объятиями.",
          "source": "Tatoeba #8677707 @Guybrush88 / #10185067 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8677707",
          "cefr_level": "A1",
          "word_slugs": [
            "abbracci-noun"
          ]
