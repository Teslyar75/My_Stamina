    {
      "slug": "cuba-name",
      "lemma": "Cuba",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7506,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3203043",
          "text": "Ricordate i missili russi a Cuba?",
          "translation": "Вы помните русские ракеты на Кубе?",
          "source": "Tatoeba #3203043 @Guybrush88 / #3375189 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3203043",
          "cefr_level": "A1",
          "word_slugs": [
            "cuba-name"
          ]
        },
        {
          "id": "1285222",
          "text": "Cuba si trova in America Centrale.",
          "translation": "Куба находится в Центральной Америке.",
          "source": "Tatoeba #1285222 @riccioberto / #3163383 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1285222",
          "cefr_level": "A1",
          "word_slugs": [
            "cuba-name"
          ]
        },
        {
          "id": "5398855",
          "text": "Cuba è la più grande tra le Antille.",
          "translation": "Куба — самый большой из Антильских островов.",
          "source": "Tatoeba #5398855 @dnnywld / #4844034 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5398855",
          "cefr_level": "A1",
          "word_slugs": [
            "cuba-name"
          ]
        },
        {
          "id": "5551303",
          "text": "A Cuba si coltiva molta canna da zucchero.",
          "translation": "На Кубе выращивают много сахарного тростника.",
          "source": "Tatoeba #5551303 @dnnywld / #5551296 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551303",
          "cefr_level": "A1",
          "word_slugs": [
            "cuba-name"
          ]
        },
        {
          "id": "5551302",
          "text": "È stato un piacere andare a Cuba e incontrare i miei parenti.",
          "translation": "Мне было приятно съездить на Кубу и встретиться с родственниками.",
          "source": "Tatoeba #5551302 @dnnywld / #5551301 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551302",
          "cefr_level": "A1",
          "word_slugs": [
            "cuba-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "Cuba",
        "plural": "",
        "infinitive": ""
      }
    },
