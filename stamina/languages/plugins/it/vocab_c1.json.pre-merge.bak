      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7065357",
          "text": "Mary è una lesbica mascolina.",
          "translation": "Мэри мужеподобная лесбиянка.",
          "source": "Tatoeba #7065357 @dnnywld / #7064398 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7065357",
          "cefr_level": "A1",
          "word_slugs": [
            "lesbica-noun"
          ]
        },
        {
          "id": "3794988",
          "text": "La amo, però lei è lesbica.",
          "translation": "Я люблю её, но она - лесбиянка.",
          "source": "Tatoeba #3794988 @Guybrush88 / #2997240 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3794988",
          "cefr_level": "A1",
          "word_slugs": [
            "lesbica-noun"
          ]
        },
        {
          "id": "6832318",
          "text": "A dire il vero lei è lesbica.",
          "translation": "По правде говоря, она лесбиянка.",
          "source": "Tatoeba #6832318 @dnnywld / #6158971 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6832318",
          "cefr_level": "A1",
          "word_slugs": [
