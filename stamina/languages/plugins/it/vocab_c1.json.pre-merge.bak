    {
      "slug": "dormiva-verb",
      "lemma": "dormiva",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9172,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6873650",
          "text": "Tom dormiva nel fienile.",
          "translation": "Том спал на сеновале.",
          "source": "Tatoeba #6873650 @dnnywld / #6872616 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6873650",
          "cefr_level": "A1",
          "word_slugs": [
            "dormiva-verb"
          ]
        },
        {
          "id": "4286508",
          "text": "Ho visto un cane che dormiva.",
          "translation": "Я видел спящую собаку.",
          "source": "Tatoeba #4286508 @Guybrush88 / #813119 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4286508",
          "cefr_level": "A1",
          "word_slugs": [
            "dormiva-verb"
          ]
        },
        {
          "id": "4188194",
          "text": "Tom dormiva con la finestra aperta.",
          "translation": "Том спал с открытым окном.",
          "source": "Tatoeba #4188194 @Guybrush88 / #5199222 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4188194",
          "cefr_level": "A1",
          "word_slugs": [
            "dormiva-verb"
          ]
        },
        {
          "id": "6917883",
          "text": "Quando siamo arrivati a casa Tom dormiva.",
