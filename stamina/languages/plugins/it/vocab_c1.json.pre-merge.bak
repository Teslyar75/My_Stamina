    {
      "slug": "consiste-verb",
      "lemma": "consiste",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9542,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1512817",
          "text": "Il cranio umano consiste di 23 ossa.",
          "translation": "Череп человека состоит из двадцати трёх костей.",
          "source": "Tatoeba #1512817 @Guybrush88 / #1511995 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1512817",
          "cefr_level": "A1",
          "word_slugs": [
            "consiste-verb"
          ]
        },
        {
          "id": "12433634",
          "text": "Il nostro compito consiste in questo.",
          "translation": "Наша задача в этом и состоит.",
          "source": "Tatoeba #12433634 @dnnywld / #12433391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12433634",
          "cefr_level": "A1",
          "word_slugs": [
            "consiste-verb"
          ]
        },
        {
          "id": "6005719",
          "text": "Consiste in una scatola di legno con fori.",
          "translation": "Он представляет собой деревянный ящик с отверстиями.",
          "source": "Tatoeba #6005719 @dnnywld / #5516594 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6005719",
          "cefr_level": "A1",
          "word_slugs": [
            "consiste-verb"
          ]
        },
        {
          "id": "742056",
          "text": "Il sistema centrale nervoso consiste di quattro organi.",
          "translation": "Центральная нервная система состоит из четырёх органов.",
          "source": "Tatoeba #742056 @Guybrush88 / #5351734 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/742056",
          "cefr_level": "A1",
          "word_slugs": [
            "consiste-verb"
          ]
        },
        {
          "id": "1979244",
          "text": "L'aria che respiriamo consiste di ossigeno e azoto.",
          "translation": "Воздух, которым мы дышим, состоит из кислорода и азота.",
          "source": "Tatoeba #1979244 @Guybrush88 / #2283416 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1979244",
          "cefr_level": "A1",
          "word_slugs": [
            "consiste-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "consiste",
        "plural": "",
        "infinitive": "consiste"
      }
