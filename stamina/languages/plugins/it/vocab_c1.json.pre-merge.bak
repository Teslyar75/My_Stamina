    {
      "slug": "basi-noun",
      "lemma": "basi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5716,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6830142",
          "text": "Su che basi?",
          "translation": "На каком основании?",
          "source": "Tatoeba #6830142 @dnnywld / #6829394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6830142",
          "cefr_level": "A1",
          "word_slugs": [
            "basi-noun"
          ]
        },
        {
          "id": "10790785",
          "text": "Sono le basi.",
          "translation": "Это же азы.",
          "source": "Tatoeba #10790785 @dnnywld / #10790728 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790785",
          "cefr_level": "A1",
          "word_slugs": [
            "basi-noun"
          ]
        },
        {
          "id": "6831964",
          "text": "Che basi avete per dirlo?",
          "translation": "На каком основании вы это говорите?",
          "source": "Tatoeba #6831964 @dnnywld / #2459516 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6831964",
          "cefr_level": "A1",
          "word_slugs": [
            "basi-noun"
          ]
        },
        {
          "id": "6830141",
          "text": "Vorrei sapere su che basi.",
          "translation": "Хотелось бы знать, на каком основании.",
          "source": "Tatoeba #6830141 @dnnywld / #6829396 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6830141",
          "cefr_level": "A1",
          "word_slugs": [
            "basi-noun"
          ]
        },
        {
          "id": "10790784",
          "text": "Sono le basi sulla sicurezza.",
          "translation": "Это же азы безопасности.",
          "source": "Tatoeba #10790784 @dnnywld / #10790736 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790784",
          "cefr_level": "A1",
          "word_slugs": [
            "basi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la basi",
        "plural": "",
        "infinitive": ""
      }
    },
