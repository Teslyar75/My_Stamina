      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2167558",
          "text": "È un frutto.",
          "translation": "Это плод.",
          "source": "Tatoeba #2167558 @al_ex_an_der / #2167570 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2167558",
