    {
      "slug": "fisso-adj",
      "lemma": "fisso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6390,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5928031",
          "text": "Non ho il posto fisso.",
          "translation": "Я временный работник.",
          "source": "Tatoeba #5928031 @dnnywld / #5927556 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5928031",
          "cefr_level": "A1",
          "word_slugs": [
            "fisso-adj"
          ]
        },
        {
          "id": "5676839",
          "text": "Non ho il telefono fisso, solo il cellulare.",
          "translation": "У меня нет стационарного телефона, только мобильный.",
          "source": "Tatoeba #5676839 @dnnywld / #5676407 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5676839",
          "cefr_level": "A1",
          "word_slugs": [
            "fisso-adj"
          ]
        },
        {
          "id": "12197647",
          "text": "Non ho né un alloggio né un lavoro fisso.",
          "translation": "У меня нет ни жилья, ни постоянной работы.",
          "source": "Tatoeba #12197647 @dnnywld / #12197532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12197647",
          "cefr_level": "A1",
          "word_slugs": [
            "fisso-adj"
          ]
        },
        {
          "id": "5384725",
          "text": "Gli scrittori di professione non hanno uno stipendio fisso.",
          "translation": "Профессиональные писатели не имеют постоянного дохода.",
          "source": "Tatoeba #5384725 @dnnywld / #5384697 @lemeoejubsmgt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384725",
          "cefr_level": "A1",
          "word_slugs": [
            "fisso-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il fisso",
        "plural": "",
        "infinitive": ""
      }
    },
