    {
      "slug": "crescono-verb",
      "lemma": "crescono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7857,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5902179",
          "text": "Sul melo crescono le mele.",
          "translation": "На яблоне растут яблоки.",
          "source": "Tatoeba #5902179 @dnnywld / #5902050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5902179",
          "cefr_level": "A1",
          "word_slugs": [
            "crescono-verb"
          ]
        },
        {
          "id": "5902182",
          "text": "Sul pesco crescono le pesche.",
          "translation": "На персиковом дереве растут персики.",
          "source": "Tatoeba #5902182 @dnnywld / #5902046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5902182",
          "cefr_level": "A1",
          "word_slugs": [
            "crescono-verb"
          ]
        },
        {
          "id": "5902180",
          "text": "Sul prugno crescono le prugne.",
          "translation": "На сливе растут сливы.",
          "source": "Tatoeba #5902180 @dnnywld / #5902048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5902180",
          "cefr_level": "A1",
          "word_slugs": [
            "crescono-verb"
          ]
        },
        {
          "id": "10849328",
          "text": "Le albicocche crescono sugli albicocchi.",
          "translation": "Абрикосы растут на абрикосовых деревьях.",
          "source": "Tatoeba #10849328 @dnnywld / #6554937 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849328",
          "cefr_level": "A1",
          "word_slugs": [
            "crescono-verb"
          ]
        },
        {
          "id": "6389987",
          "text": "Crescono lentamente, ma muoiono velocemente.",
          "translation": "Растут медленно, зато умирают быстро.",
          "source": "Tatoeba #6389987 @dnnywld / #6389215 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6389987",
          "cefr_level": "A1",
          "word_slugs": [
            "crescono-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "crescono",
        "plural": "",
        "infinitive": "crescono"
      }
    },
    {
      "slug": "conclusioni-noun",
      "lemma": "conclusioni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7858,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6866915",
          "text": "Trai le tue conclusioni.",
          "translation": "Сделай вывод.",
          "source": "Tatoeba #6866915 @dnnywld / #1864021 @estong (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866915",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusioni-noun"
          ]
        },
        {
          "id": "11052121",
          "text": "Non saltare mai alle conclusioni.",
          "translation": "Никогда не делай поспешных выводов.",
          "source": "Tatoeba #11052121 @carlosalberto / #11051988 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11052121",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusioni-noun"
          ]
        },
        {
          "id": "10844076",
          "text": "Se fossi al tuo posto non salterei subito alle conclusioni.",
          "translation": "Я бы на твоём месте не спешил с выводами.",
          "source": "Tatoeba #10844076 @dnnywld / #10841731 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844076",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusioni-noun"
          ]
        },
        {
          "id": "10844077",
          "text": "Se fossi al vostro posto non salterei subito alle conclusioni.",
          "translation": "Я бы на вашем месте не спешил с выводами.",
          "source": "Tatoeba #10844077 @dnnywld / #10841730 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844077",
          "cefr_level": "A1",
          "word_slugs": [
            "conclusioni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la conclusioni",
        "plural": "",
        "infinitive": ""
      }
    },
    {
