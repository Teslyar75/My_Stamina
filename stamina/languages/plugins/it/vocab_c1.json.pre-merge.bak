    {
      "slug": "grassi-adj",
      "lemma": "grassi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8564,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3213375",
          "text": "Sono troppo grassi.",
          "translation": "Они слишком толстые.",
          "source": "Tatoeba #3213375 @Guybrush88 / #3213389 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3213375",
          "cefr_level": "A1",
          "word_slugs": [
            "grassi-adj"
          ]
        },
        {
          "id": "5654016",
          "text": "Ho i capelli grassi.",
          "translation": "У меня жирные волосы.",
          "source": "Tatoeba #5654016 @dnnywld / #5653804 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5654016",
          "cefr_level": "A1",
          "word_slugs": [
            "grassi-adj"
          ]
        },
        {
          "id": "4981458",
          "text": "Voi non siete grassi.",
          "translation": "Вы не толстые.",
          "source": "Tatoeba #4981458 @Guybrush88 / #10801616 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4981458",
          "cefr_level": "A1",
          "word_slugs": [
            "grassi-adj"
          ]
        },
        {
          "id": "3213376",
          "text": "Loro sono troppo grassi.",
          "translation": "Они слишком толстые.",
          "source": "Tatoeba #3213376 @Guybrush88 / #3213389 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3213376",
          "cefr_level": "A1",
          "word_slugs": [
            "grassi-adj"
          ]
        },
        {
          "id": "5767888",
          "text": "Più cioccolato mangiate, più grassi diventate.",
          "translation": "Чем больше шоколада Вы едите, тем толще становитесь.",
          "source": "Tatoeba #5767888 @dnnywld / #5767858 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5767888",
          "cefr_level": "A1",
          "word_slugs": [
            "grassi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il grassi",
        "plural": "",
        "infinitive": ""
      }
