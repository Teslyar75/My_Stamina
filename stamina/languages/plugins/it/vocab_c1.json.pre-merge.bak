    {
      "slug": "contributo-noun",
      "lemma": "contributo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8551,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10864802",
          "text": "Chi ha dato un contributo?",
          "translation": "Кто сделал вклад?",
          "source": "Tatoeba #10864802 @dnnywld / #4483019 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10864802",
          "cefr_level": "A1",
          "word_slugs": [
            "contributo-noun"
          ]
        },
        {
          "id": "5509531",
          "text": "Grazie per il tuo contributo.",
          "translation": "Спасибо за твой вклад.",
          "source": "Tatoeba #5509531 @dnnywld / #5509196 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5509531",
          "cefr_level": "A1",
          "word_slugs": [
            "contributo-noun"
          ]
        },
        {
          "id": "6891412",
          "text": "Vogliamo portare il nostro contributo.",
          "translation": "Мы хотим внести свой вклад.",
          "source": "Tatoeba #6891412 @dnnywld / #5760103 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891412",
          "cefr_level": "A1",
          "word_slugs": [
            "contributo-noun"
          ]
        },
        {
          "id": "6891408",
          "text": "Ciascuno può dare il proprio contributo.",
          "translation": "Каждый может внести свой вклад.",
          "source": "Tatoeba #6891408 @dnnywld / #2197014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891408",
          "cefr_level": "A1",
          "word_slugs": [
            "contributo-noun"
          ]
        },
        {
          "id": "6891410",
          "text": "Ciascuno deve dare il proprio contributo.",
          "translation": "Каждый должен внести свою лепту.",
          "source": "Tatoeba #6891410 @dnnywld / #4317526 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891410",
          "cefr_level": "A1",
          "word_slugs": [
            "contributo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
