    {
      "slug": "prestare-verb",
      "lemma": "prestare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8076,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1607048",
          "text": "Mi puoi prestare la tua bicicletta?",
          "translation": "Можешь одолжить мне твой велосипед?",
          "source": "Tatoeba #1607048 @Guybrush88 / #594640 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1607048",
          "cefr_level": "A1",
          "word_slugs": [
            "prestare-verb"
          ]
        },
        {
          "id": "5670942",
          "text": "Ho detto di non prestare attenzione.",
          "translation": "Я сказал, не обращайте внимания.",
          "source": "Tatoeba #5670942 @dnnywld / #5670517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5670942",
          "cefr_level": "A1",
          "word_slugs": [
            "prestare-verb"
          ]
        },
        {
          "id": "5448126",
          "text": "Sei in grado di prestare il primo soccorso?",
          "translation": "Ты умеешь оказывать первую помощь?",
          "source": "Tatoeba #5448126 @dnnywld / #4211581 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5448126",
          "cefr_level": "A1",
          "word_slugs": [
            "prestare-verb"
          ]
        },
        {
          "id": "5448131",
          "text": "Siete in grado di prestare il primo soccorso?",
          "translation": "Вы умеете оказывать первую помощь?",
          "source": "Tatoeba #5448131 @dnnywld / #4211582 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5448131",
          "cefr_level": "A1",
          "word_slugs": [
            "prestare-verb"
          ]
        },
        {
          "id": "6025006",
          "text": "Non prestare attenzione a quello che si dice.",
          "translation": "Не обращай внимания на то, что говорят.",
          "source": "Tatoeba #6025006 @dnnywld / #6024587 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6025006",
          "cefr_level": "A1",
          "word_slugs": [
            "prestare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "prestare",
        "plural": "",
        "infinitive": "prestare"
      }
