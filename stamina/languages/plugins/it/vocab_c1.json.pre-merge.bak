    {
      "slug": "assurda-adj",
      "lemma": "assurda",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5617,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4507480",
          "text": "Che domanda assurda!",
          "translation": "Какой абсурдный вопрос!",
          "source": "Tatoeba #4507480 @Guybrush88 / #5817901 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4507480",
          "cefr_level": "A1",
          "word_slugs": [
            "assurda-adj"
          ]
        },
        {
          "id": "10849529",
          "text": "Che assurda dichiarazione!",
          "translation": "Какое абсурдное заявление!",
          "source": "Tatoeba #10849529 @dnnywld / #5795988 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849529",
          "cefr_level": "A1",
          "word_slugs": [
            "assurda-adj"
          ]
        },
        {
          "id": "5734187",
          "text": "È un'accusa assurda.",
          "translation": "Это абсурдное обвинение.",
          "source": "Tatoeba #5734187 @Guybrush88 / #5912980 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5734187",
          "cefr_level": "A1",
          "word_slugs": [
            "assurda-adj"
          ]
        },
        {
          "id": "10849526",
          "text": "È una assurda definizione.",
          "translation": "Это абсурдное определение.",
          "source": "Tatoeba #10849526 @dnnywld / #5235293 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849526",
          "cefr_level": "A1",
          "word_slugs": [
            "assurda-adj"
          ]
        },
        {
          "id": "3292466",
          "text": "La sua opinione è assurda.",
          "translation": "Его мнение абсурдно.",
          "source": "Tatoeba #3292466 @Guybrush88 / #3295700 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3292466",
          "cefr_level": "A1",
          "word_slugs": [
            "assurda-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
