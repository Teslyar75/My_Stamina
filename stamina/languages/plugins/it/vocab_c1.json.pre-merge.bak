      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5487398",
          "text": "Dai non perdiamo tempo.",
          "translation": "Давай не будем зря тратить время.",
          "source": "Tatoeba #5487398 @dnnywld / #5487153 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5487398",
          "cefr_level": "A1",
          "word_slugs": [
