      "examples": [
        {
          "id": "6773989",
          "text": "Mi hai pestato il piede.",
          "translation": "Ты наступил мне на ногу.",
          "source": "Tatoeba #6773989 @dnnywld / #6773976 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6773989",
          "cefr_level": "A1",
          "word_slugs": [
            "pestato-verb"
          ]
        },
        {
          "id": "503588",
          "text": "Quando ero piccola ho pestato per sbaglio un lombrico.",
          "translation": "Когда я была маленькой, я нечаянно наступила на дождевого червя.",
          "source": "Tatoeba #503588 @Pharamp / #3566018 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/503588",
          "cefr_level": "A1",
          "word_slugs": [
            "pestato-verb"
          ]
        },
        {
          "id": "6454679",
          "text": "Nell'autobus affollato qualcuno mi ha pestato un piede.",
          "translation": "В переполненном автобусе кто-то наступил мне на ногу.",
          "source": "Tatoeba #6454679 @dnnywld / #6454676 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6454679",
          "cefr_level": "A1",
          "word_slugs": [
            "pestato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il pestato",
        "plural": "",
        "infinitive": "pestato"
      }
