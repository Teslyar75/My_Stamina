    {
      "slug": "scusarsi-verb",
      "lemma": "scusarsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9232,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5637233",
          "text": "Tom potrebbe almeno scusarsi.",
          "translation": "Том мог бы хотя бы извиниться.",
          "source": "Tatoeba #5637233 @dnnywld / #4651884 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5637233",
          "cefr_level": "A1",
          "word_slugs": [
            "scusarsi-verb"
          ]
        },
        {
          "id": "10787807",
          "text": "Tom dovrebbe almeno scusarsi.",
          "translation": "Тому надо хотя бы извиниться.",
          "source": "Tatoeba #10787807 @dnnywld / #8443593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10787807",
          "cefr_level": "A1",
          "word_slugs": [
            "scusarsi-verb"
          ]
        },
        {
          "id": "5522667",
          "text": "Tom voleva scusarsi con Mary.",
          "translation": "Том хотел извиниться перед Мэри.",
          "source": "Tatoeba #5522667 @dnnywld / #5522487 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5522667",
          "cefr_level": "A1",
          "word_slugs": [
            "scusarsi-verb"
          ]
        },
        {
          "id": "6742051",
          "text": "Mary sapeva di dover scusarsi.",
          "translation": "Мэри знала, что ей надо извиниться.",
          "source": "Tatoeba #6742051 @dnnywld / #6740865 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6742051",
          "cefr_level": "A1",
          "word_slugs": [
            "scusarsi-verb"
          ]
        },
        {
          "id": "3336454",
          "text": "Sono io quello che deve scusarsi.",
          "translation": "Это я должен извиниться.",
          "source": "Tatoeba #3336454 @Guybrush88 / #4780225 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3336454",
          "cefr_level": "A1",
          "word_slugs": [
            "scusarsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "scusarsi",
        "plural": "",
        "infinitive": "scusarsi"
      }
    },
    {
