    {
      "slug": "voluta-verb",
      "lemma": "voluta",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7545,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5452678",
          "text": "C'è voluta un'ora.",
          "translation": "Это заняло час.",
          "source": "Tatoeba #5452678 @dnnywld / #5373995 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452678",
          "cefr_level": "A1",
          "word_slugs": [
            "voluta-verb"
          ]
        },
        {
          "id": "5452680",
          "text": "C'è voluta tutta la sera.",
          "translation": "Это заняло весь вечер.",
          "source": "Tatoeba #5452680 @dnnywld / #408646 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452680",
          "cefr_level": "A1",
          "word_slugs": [
            "voluta-verb"
          ]
        },
        {
          "id": "5452710",
          "text": "C'è voluta un'ora esatta.",
          "translation": "Это заняло ровно час.",
          "source": "Tatoeba #5452710 @dnnywld / #2197525 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452710",
          "cefr_level": "A1",
          "word_slugs": [
            "voluta-verb"
          ]
        },
        {
          "id": "5452749",
          "text": "Ci è voluta quasi un'ora per scendere.",
          "translation": "Спуск занял почти час.",
          "source": "Tatoeba #5452749 @dnnywld / #4039917 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452749",
          "cefr_level": "A1",
          "word_slugs": [
            "voluta-verb"
          ]
        },
        {
          "id": "5571139",
          "text": "Mi ci è voluta una settimana per guarire dal raffreddore.",
          "translation": "Мне потребовалась неделя, чтобы вылечиться от простуды.",
          "source": "Tatoeba #5571139 @dnnywld / #5570722 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571139",
          "cefr_level": "A1",
          "word_slugs": [
            "voluta-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
