      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5469,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1397480",
          "text": "Che treno prenderà?",
          "translation": "На каком поезде Вы поедете?",
          "source": "Tatoeba #1397480 @Guybrush88 / #6055530 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1397480",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderà-verb"
          ]
        },
        {
          "id": "4384624",
          "text": "Non mi prenderà mai vivo!",
          "translation": "Живым я не сдамся!",
          "source": "Tatoeba #4384624 @Guybrush88 / #4387543 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4384624",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderà-verb"
          ]
        },
        {
          "id": "13136174",
          "text": "Chi si prenderà cura di lui?",
          "translation": "Кто о нём позаботится?",
          "source": "Tatoeba #13136174 @dnnywld / #13134543 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13136174",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderà-verb"
          ]
        },
        {
          "id": "6719561",
          "text": "Tom si prenderà cura di Mary.",
          "translation": "Том присмотрит за Мэри.",
          "source": "Tatoeba #6719561 @Guybrush88 / #6902645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6719561",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderà-verb"
          ]
        },
        {
          "id": "6803406",
          "text": "Tom prenderà i bambini a scuola.",
          "translation": "Том заберёт детей после школы.",
          "source": "Tatoeba #6803406 @dnnywld / #6803306 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6803406",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderà-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
