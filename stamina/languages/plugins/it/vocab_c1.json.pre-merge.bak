    {
      "slug": "parecchi-adj",
      "lemma": "parecchi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5308,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5405621",
          "text": "Sono stati cancellati parecchi voli.",
          "translation": "Было отменено несколько рейсов.",
          "source": "Tatoeba #5405621 @dnnywld / #5404823 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5405621",
          "cefr_level": "A1",
          "word_slugs": [
            "parecchi-adj"
          ]
        },
        {
          "id": "5539300",
          "text": "Il mio capo beve parecchi caffè.",
          "translation": "Мой начальник пьёт очень много кофе.",
          "source": "Tatoeba #5539300 @dnnywld / #5538847 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5539300",
          "cefr_level": "A1",
          "word_slugs": [
            "parecchi-adj"
          ]
        },
        {
          "id": "417493",
          "text": "La temperatura scese di parecchi gradi.",
          "translation": "Температура опустилась на несколько градусов.",
          "source": "Tatoeba #417493 @meursault / #2503208 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/417493",
          "cefr_level": "A1",
          "word_slugs": [
            "parecchi-adj"
          ]
        },
        {
          "id": "5512227",
          "text": "Sono passati parecchi giorni da quando Tom se n'è andato.",
          "translation": "Прошло немало дней, с тех пор как Том ушел.",
          "source": "Tatoeba #5512227 @dnnywld / #3512189 @awiz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512227",
          "cefr_level": "A1",
          "word_slugs": [
            "parecchi-adj"
          ]
        },
        {
          "id": "6883267",
          "text": "Sono passati parecchi anni, e ormai è poco quel che ricordo.",
          "translation": "Прошло столько лет, я уже мало что помню.",
          "source": "Tatoeba #6883267 @dnnywld / #6882240 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883267",
          "cefr_level": "A1",
          "word_slugs": [
            "parecchi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il parecchi",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "aprile-noun",
