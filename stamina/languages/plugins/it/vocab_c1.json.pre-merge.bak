    {
      "slug": "prezzi-noun",
      "lemma": "prezzi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7059,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5512432",
          "text": "I prezzi crollano!",
          "translation": "Цены падают!",
          "source": "Tatoeba #5512432 @dnnywld / #2154980 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512432",
          "cefr_level": "A1",
          "word_slugs": [
            "prezzi-noun"
          ]
        },
        {
          "id": "10836828",
          "text": "Hanno prezzi inaccessibili.",
          "translation": "Цены на них кусаются.",
          "source": "Tatoeba #10836828 @dnnywld / #10836664 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10836828",
          "cefr_level": "A1",
          "word_slugs": [
            "prezzi-noun"
          ]
        },
        {
          "id": "5052247",
          "text": "Dobbiamo aumentare i prezzi.",
          "translation": "Мы должны поднять цены.",
          "source": "Tatoeba #5052247 @Guybrush88 / #6109441 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5052247",
          "cefr_level": "A1",
          "word_slugs": [
            "prezzi-noun"
          ]
        },
        {
          "id": "5464616",
          "text": "I prezzi certamente aumenteranno.",
          "translation": "Цены несомненно вырастут.",
          "source": "Tatoeba #5464616 @dnnywld / #5464001 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5464616",
          "cefr_level": "A1",
          "word_slugs": [
            "prezzi-noun"
          ]
        },
        {
          "id": "6861912",
          "text": "Non abbiamo alzato i prezzi.",
          "translation": "Мы не стали поднимать цены.",
          "source": "Tatoeba #6861912 @dnnywld / #5546407 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6861912",
          "cefr_level": "A1",
          "word_slugs": [
            "prezzi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il prezzi",
        "plural": "",
