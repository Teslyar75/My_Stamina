    {
      "slug": "fianchi-noun",
      "lemma": "fianchi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9070,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7451002",
          "text": "Lei ha i fianchi larghi.",
          "translation": "У неё широкие бёдра.",
          "source": "Tatoeba #7451002 @Guybrush88 / #4505442 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7451002",
          "cefr_level": "A1",
          "word_slugs": [
            "fianchi-noun"
          ]
        },
        {
          "id": "5733638",
          "text": "Tom avvolse l'asciugamano intorno ai fianchi.",
          "translation": "Том обернул вокруг талии полотенце.",
          "source": "Tatoeba #5733638 @dnnywld / #5732286 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5733638",
          "cefr_level": "A1",
          "word_slugs": [
            "fianchi-noun"
          ]
        },
        {
          "id": "5733632",
          "text": "Tom uscì dal bagno con un asciugamano intorno ai fianchi.",
          "translation": "Том вышел из ванной с полотенцем вокруг бёдер.",
          "source": "Tatoeba #5733632 @dnnywld / #5732291 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5733632",
          "cefr_level": "A1",
          "word_slugs": [
            "fianchi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il fianchi",
        "plural": "",
        "infinitive": ""
      }
