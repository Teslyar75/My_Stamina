    {
      "slug": "frequentare-verb",
      "lemma": "frequentare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6481,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5651424",
          "text": "Ho cominciato recentemente a frequentare un uomo.",
          "translation": "Я недавно стала встречаться с мужчиной.",
          "source": "Tatoeba #5651424 @dnnywld / #5651329 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5651424",
          "cefr_level": "A1",
          "word_slugs": [
            "frequentare-verb"
          ]
        },
        {
          "id": "6961287",
          "text": "Gli studenti devono frequentare tutte le lezioni e esercitazioni pratiche.",
          "translation": "Студенты должны присутствовать на всех лекциях и практических занятиях.",
          "source": "Tatoeba #6961287 @dnnywld / #6960504 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961287",
          "cefr_level": "A1",
          "word_slugs": [
            "frequentare-verb"
          ]
        },
        {
          "id": "6961288",
          "text": "Tutti gli studenti devono frequentare tutte le lezioni e le esercitazioni pratiche.",
          "translation": "Все студенты должны присутствовать на лекциях и практических занятиях.",
          "source": "Tatoeba #6961288 @dnnywld / #6960503 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961288",
          "cefr_level": "A1",
          "word_slugs": [
            "frequentare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "frequentare",
        "plural": "",
        "infinitive": "frequentare"
      }
