    {
      "slug": "solletico-noun",
      "lemma": "solletico",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8954,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5283089",
          "text": "Soffro il solletico.",
          "translation": "Я боюсь щекотки.",
          "source": "Tatoeba #5283089 @Guybrush88 / #5948539 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5283089",
          "cefr_level": "A1",
          "word_slugs": [
            "solletico-noun"
          ]
        },
        {
          "id": "10817277",
          "text": "Soffro il solletico sin da bambino.",
          "translation": "Я с детства щекотки боюсь.",
          "source": "Tatoeba #10817277 @dnnywld / #10817255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10817277",
          "cefr_level": "A1",
          "word_slugs": [
            "solletico-noun"
          ]
        },
        {
          "id": "6729065",
          "text": "Mary mi ha detto che soffriva il solletico.",
          "translation": "Мэри сказала мне, что боится щекотки.",
          "source": "Tatoeba #6729065 @dnnywld / #6728277 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6729065",
          "cefr_level": "A1",
          "word_slugs": [
            "solletico-noun"
          ]
        },
        {
          "id": "6921477",
          "text": "Tom ha detto che Mary non soffriva il solletico.",
          "translation": "Том сказал, что Мэри не боится щекотки.",
          "source": "Tatoeba #6921477 @dnnywld / #6921392 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6921477",
          "cefr_level": "A1",
          "word_slugs": [
            "solletico-noun"
          ]
        },
        {
          "id": "5570939",
          "text": "Di solito i bambini ridono quando gli si fa il solletico.",
          "translation": "Обычно люди смеются, когда их щекочут.",
          "source": "Tatoeba #5570939 @dnnywld / #5570870 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5570939",
          "cefr_level": "A1",
          "word_slugs": [
            "solletico-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
