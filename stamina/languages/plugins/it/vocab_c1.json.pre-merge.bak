      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5459604",
          "text": "Quante sedie mancano?",
          "translation": "Сколько стульев не хватает?",
          "source": "Tatoeba #5459604 @dnnywld / #5459434 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5459604",
          "cefr_level": "A1",
          "word_slugs": [
            "sedie-noun"
          ]
        },
        {
          "id": "5432036",
          "text": "Vi bastano le sedie?",
          "translation": "У нас хватает стульев?",
          "source": "Tatoeba #5432036 @dnnywld / #5431911 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5432036",
          "cefr_level": "A1",
          "word_slugs": [
            "sedie-noun"
          ]
        },
        {
          "id": "6484905",
          "text": "Quante sono le sedie?",
          "translation": "Сколько всего стульев?",
          "source": "Tatoeba #6484905 @dnnywld / #6484623 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6484905",
          "cefr_level": "A1",
          "word_slugs": [
            "sedie-noun"
          ]
        },
        {
          "id": "3221728",
          "text": "Una delle sedie è rotta.",
          "translation": "Один из стульев сломан.",
          "source": "Tatoeba #3221728 @Selena777 / #3228591 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3221728",
          "cefr_level": "A1",
          "word_slugs": [
            "sedie-noun"
          ]
        },
        {
          "id": "6045825",
          "text": "Porta le sedie in veranda.",
          "translation": "Перенеси стулья на веранду.",
          "source": "Tatoeba #6045825 @dnnywld / #6045035 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6045825",
          "cefr_level": "A1",
          "word_slugs": [
            "sedie-noun"
          ]
        }
      ],
