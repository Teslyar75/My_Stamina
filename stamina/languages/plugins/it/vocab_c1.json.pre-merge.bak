    {
      "slug": "completato-adj",
      "lemma": "completato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7625,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4571494",
          "text": "Tom ha completato il puzzle.",
          "translation": "Том закончил пазл.",
          "source": "Tatoeba #4571494 @Guybrush88 / #6027288 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4571494",
          "cefr_level": "A1",
          "word_slugs": [
            "completato-adj"
          ]
        },
        {
          "id": "5661950",
          "text": "Hanno completato la loro missione.",
          "translation": "Они выполнили свою миссию.",
          "source": "Tatoeba #5661950 @dnnywld / #5661438 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5661950",
          "cefr_level": "A1",
          "word_slugs": [
            "completato-adj"
          ]
        },
        {
          "id": "5400530",
          "text": "Finalmente ha completato il lavoro.",
          "translation": "Наконец он завершил работу.",
          "source": "Tatoeba #5400530 @dnnywld / #5399371 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5400530",
          "cefr_level": "A1",
          "word_slugs": [
            "completato-adj"
          ]
        },
        {
          "id": "6804242",
          "text": "Lei ha completato il lavoro con facilità.",
          "translation": "Она с лёгкостью выполнила работу.",
          "source": "Tatoeba #6804242 @dnnywld / #5169505 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804242",
          "cefr_level": "A1",
          "word_slugs": [
            "completato-adj"
          ]
        },
        {
          "id": "5889128",
          "text": "Finalmente ho completato gli esercizi, ora posso andare a dormire.",
          "translation": "Я наконец-то доделал уроки, теперь могу идти спать.",
          "source": "Tatoeba #5889128 @dnnywld / #5888915 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889128",
          "cefr_level": "A1",
          "word_slugs": [
            "completato-adj"
          ]
        }
      ],
