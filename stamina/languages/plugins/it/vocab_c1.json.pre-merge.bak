          ]
        },
        {
          "id": "5826653",
          "text": "Io e lui siamo nati lo stesso giorno.",
          "translation": "Мы с ним родились в один день.",
          "source": "Tatoeba #5826653 @dnnywld / #5825992 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5826653",
          "cefr_level": "A1",
          "word_slugs": [
            "nati-adj"
          ]
        },
        {
          "id": "1816574",
          "text": "Tutti i loro figli sono nati in Malesia.",
          "translation": "Все их дети родились в Малайзии.",
          "source": "Tatoeba #1816574 @Guybrush88 / #5866576 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1816574",
          "cefr_level": "A1",
