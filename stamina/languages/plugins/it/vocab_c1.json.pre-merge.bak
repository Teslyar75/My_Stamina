    {
      "slug": "misero-adj",
      "lemma": "misero",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8862,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10928798",
          "text": "Di colpo tutti si misero a correre.",
          "translation": "Все сразу забегали.",
          "source": "Tatoeba #10928798 @dnnywld / #10928567 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10928798",
          "cefr_level": "A1",
          "word_slugs": [
            "misero-adj"
          ]
        },
        {
          "id": "7528735",
          "text": "Si misero tutti a ridere per questo errore.",
          "translation": "Все засмеялись над этой ошибкой.",
          "source": "Tatoeba #7528735 @dnnywld / #7528592 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7528735",
          "cefr_level": "A1",
          "word_slugs": [
            "misero-adj"
          ]
        },
        {
          "id": "6007352",
          "text": "Di colpo tutti si misero a correre, compreso io.",
          "translation": "Все сразу побежали, и я тоже.",
          "source": "Tatoeba #6007352 @dnnywld / #6006843 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6007352",
          "cefr_level": "A1",
          "word_slugs": [
            "misero-adj"
          ]
        },
        {
          "id": "11456004",
          "text": "Oggi è l'inizio, dopo le cose si misero male.",
          "translation": "Сегодня всё с самого начала пошло наперекосяк.",
          "source": "Tatoeba #11456004 @Bernie75 / #2284442 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11456004",
          "cefr_level": "A1",
          "word_slugs": [
            "misero-adj"
          ]
        },
        {
          "id": "10928793",
          "text": "Di colpo tutti si misero a correre e si agitarono.",
          "translation": "Все сразу забегали и засуетились.",
          "source": "Tatoeba #10928793 @dnnywld / #10928569 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10928793",
          "cefr_level": "A1",
          "word_slugs": [
            "misero-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il misero",
        "plural": "",
        "infinitive": ""
      }
