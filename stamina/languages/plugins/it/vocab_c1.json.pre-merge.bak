    {
      "slug": "metodi-noun",
      "lemma": "metodi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5661,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5843676",
          "text": "Ha usato dei metodi disonesti.",
          "translation": "Он использовал нечестные методы.",
          "source": "Tatoeba #5843676 @dnnywld / #2735813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843676",
          "cefr_level": "A1",
          "word_slugs": [
            "metodi-noun"
          ]
        },
        {
          "id": "5843891",
          "text": "Potete utilizzare i metodi più differenti.",
          "translation": "Можно использовать самые разные методы.",
          "source": "Tatoeba #5843891 @dnnywld / #1971533 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843891",
          "cefr_level": "A1",
          "word_slugs": [
            "metodi-noun"
          ]
        },
        {
          "id": "10753619",
          "text": "Lei ha provato diversi metodi per perdere peso.",
          "translation": "Она перепробовала разные способы снижения веса.",
          "source": "Tatoeba #10753619 @dnnywld / #4631989 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10753619",
          "cefr_level": "A1",
          "word_slugs": [
            "metodi-noun"
          ]
        },
        {
          "id": "1911305",
          "text": "Quali metodi di insegnamento sono utilizzati nel corso?",
          "translation": "Какие педагогические приёмы использованы в курсе?",
          "source": "Tatoeba #1911305 @al_ex_an_der / #1911280 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1911305",
          "cefr_level": "A1",
          "word_slugs": [
            "metodi-noun"
          ]
        },
        {
          "id": "2430368",
          "text": "I metodi del pensiero positivo sono semplici da imparare.",
          "translation": "Методы позитивного мышления учатся легко.",
          "source": "Tatoeba #2430368 @al_ex_an_der / #2430382 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430368",
          "cefr_level": "A1",
          "word_slugs": [
            "metodi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
