          ]
        },
        {
          "id": "10888388",
          "text": "C'è stata una rissa.",
          "translation": "Была драка.",
          "source": "Tatoeba #10888388 @dnnywld / #5597773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10888388",
          "cefr_level": "A1",
          "word_slugs": [
            "rissa-noun"
          ]
        },
        {
          "id": "10888390",
          "text": "La discussione finì in rissa.",
          "translation": "Спор окончился дракой.",
