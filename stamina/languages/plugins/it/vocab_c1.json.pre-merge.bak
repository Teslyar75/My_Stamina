    {
      "slug": "insetti-noun",
      "lemma": "insetti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5243,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6891260",
          "text": "Hai paura degli insetti?",
          "translation": "Ты боишься насекомых?",
          "source": "Tatoeba #6891260 @dnnywld / #5749846 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891260",
          "cefr_level": "A1",
          "word_slugs": [
            "insetti-noun"
          ]
        },
        {
          "id": "3234525",
          "text": "Ti piacciono gli insetti?",
          "translation": "Ты любишь букашек?",
          "source": "Tatoeba #3234525 @Guybrush88 / #5653560 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3234525",
          "cefr_level": "A1",
          "word_slugs": [
            "insetti-noun"
          ]
        },
        {
          "id": "3234528",
          "text": "Vi piacciono gli insetti?",
          "translation": "Вам нравятся насекомые?",
          "source": "Tatoeba #3234528 @Guybrush88 / #3235303 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3234528",
          "cefr_level": "A1",
          "word_slugs": [
            "insetti-noun"
          ]
        },
        {
          "id": "3234530",
          "text": "Le piacciono gli insetti?",
          "translation": "Вам нравятся насекомые?",
          "source": "Tatoeba #3234530 @Guybrush88 / #3235303 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3234530",
          "cefr_level": "A1",
          "word_slugs": [
            "insetti-noun"
          ]
        },
        {
          "id": "13138018",
          "text": "Non sopportano gli insetti.",
          "translation": "Они терпеть не могут насекомых.",
          "source": "Tatoeba #13138018 @dnnywld / #13137619 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13138018",
          "cefr_level": "A1",
          "word_slugs": [
            "insetti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il insetti",
        "plural": "",
        "infinitive": ""
      }
