    {
      "slug": "attendere-verb",
      "lemma": "attendere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6072,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5625456",
          "text": "Ti ho fatto attendere?",
          "translation": "Я заставил тебя ждать?",
          "source": "Tatoeba #5625456 @dnnywld / #5625351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5625456",
          "cefr_level": "A1",
          "word_slugs": [
            "attendere-verb"
          ]
        },
        {
          "id": "5627256",
          "text": "Per favore, ditegli di attendere.",
          "translation": "Пожалуйста, скажите ему, чтобы он подождал.",
          "source": "Tatoeba #5627256 @dnnywld / #1869395 @sixtynine (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627256",
          "cefr_level": "A1",
          "word_slugs": [
            "attendere-verb"
          ]
        },
        {
          "id": "10790448",
          "text": "Non puoi attendere altri 10 minuti?",
          "translation": "Ты не можешь подождать ещё 10 минут?",
          "source": "Tatoeba #10790448 @dnnywld / #1513649 @Aj (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790448",
          "cefr_level": "A1",
          "word_slugs": [
            "attendere-verb"
          ]
        },
        {
          "id": "6886252",
          "text": "Da lei ci si può attendere di tutto.",
          "translation": "От неё чего угодно можно ожидать.",
          "source": "Tatoeba #6886252 @dnnywld / #6885941 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886252",
          "cefr_level": "A1",
          "word_slugs": [
            "attendere-verb"
          ]
        },
        {
          "id": "6886253",
          "text": "Da lui ci si può attendere di tutto.",
          "translation": "От него чего угодно можно ожидать.",
          "source": "Tatoeba #6886253 @dnnywld / #6885940 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886253",
          "cefr_level": "A1",
          "word_slugs": [
            "attendere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
