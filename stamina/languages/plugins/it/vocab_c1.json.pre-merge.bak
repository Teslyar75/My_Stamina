    {
      "slug": "diventerò-verb",
      "lemma": "diventerò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8993,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5836104",
          "text": "Diventerò più forte.",
          "translation": "Я стану сильнее.",
          "source": "Tatoeba #5836104 @dnnywld / #4190646 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5836104",
          "cefr_level": "A1",
          "word_slugs": [
            "diventerò-verb"
          ]
        },
        {
          "id": "5836155",
          "text": "Sembra che diventerò padre.",
          "translation": "Похоже, я стану отцом.",
          "source": "Tatoeba #5836155 @dnnywld / #4606319 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5836155",
          "cefr_level": "A1",
          "word_slugs": [
            "diventerò-verb"
          ]
        },
        {
          "id": "5836169",
          "text": "Un giorno diventerò famoso.",
          "translation": "Когда-нибудь я стану знаменитым.",
          "source": "Tatoeba #5836169 @dnnywld / #4442700 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5836169",
          "cefr_level": "A1",
          "word_slugs": [
            "diventerò-verb"
          ]
        },
        {
          "id": "7712870",
          "text": "Credimi, diventerò un'altra persona.",
          "translation": "Поверь мне, я стану другим человеком.",
          "source": "Tatoeba #7712870 @dnnywld / #7712020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7712870",
          "cefr_level": "A1",
          "word_slugs": [
            "diventerò-verb"
          ]
        },
        {
          "id": "636332",
          "text": "Diventerò il dio del nuovo mondo.",
          "translation": "Я стану богом нового мира.",
          "source": "Tatoeba #636332 @Guybrush88 / #2815420 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/636332",
          "cefr_level": "A1",
          "word_slugs": [
            "diventerò-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
