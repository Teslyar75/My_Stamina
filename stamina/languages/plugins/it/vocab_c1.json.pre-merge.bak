          ]
        },
        {
          "id": "1246366",
          "text": "Lui ha curato la mia malattia.",
          "translation": "Он излечил мою болезнь.",
          "source": "Tatoeba #1246366 @Guybrush88 / #1525497 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246366",
