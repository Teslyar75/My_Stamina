      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5846872",
          "text": "È vietato fare riprese nella metropolitana.",
          "translation": "Снимать в метро запрещено.",
          "source": "Tatoeba #5846872 @dnnywld / #4711051 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846872",
          "cefr_level": "A1",
          "word_slugs": [
            "metropolitana-adj"
          ]
        },
        {
          "id": "1708397",
          "text": "La metropolitana è più veloce dal tram.",
