    {
      "slug": "consigliato-adj",
      "lemma": "consigliato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9228,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5626726",
          "text": "Ho fatto come ha consigliato Tom.",
          "translation": "Я сделала так, как посоветовал Том.",
          "source": "Tatoeba #5626726 @dnnywld / #5626328 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626726",
          "cefr_level": "A1",
          "word_slugs": [
            "consigliato-adj"
          ]
        },
        {
          "id": "6963787",
          "text": "Ho consigliato a Tom di riposare.",
          "translation": "Я посоветовал Тому отдохнуть.",
          "source": "Tatoeba #6963787 @dnnywld / #6963028 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6963787",
          "cefr_level": "A1",
          "word_slugs": [
            "consigliato-adj"
          ]
        },
        {
          "id": "6886171",
          "text": "Mi chiedo chi l'abbia consigliato.",
          "translation": "Интересно, кто его надоумил.",
          "source": "Tatoeba #6886171 @dnnywld / #6885998 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886171",
          "cefr_level": "A1",
          "word_slugs": [
            "consigliato-adj"
          ]
        },
        {
          "id": "1559252",
          "text": "Gli ha consigliato di leggere quei libri.",
          "translation": "Он посоветовал ему почитать эти книги.",
          "source": "Tatoeba #1559252 @Guybrush88 / #4387154 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1559252",
          "cefr_level": "A1",
          "word_slugs": [
            "consigliato-adj"
          ]
        },
        {
          "id": "3328572",
          "text": "L'insegnante ci ha consigliato questo dizionario.",
          "translation": "Учитель посоветовал нам этот словарь.",
          "source": "Tatoeba #3328572 @Guybrush88 / #3328598 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3328572",
          "cefr_level": "A1",
          "word_slugs": [
            "consigliato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il consigliato",
        "plural": "",
        "infinitive": ""
      }
