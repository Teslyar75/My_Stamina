    {
      "slug": "regolarmente-adv",
      "lemma": "regolarmente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8772,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6877768",
          "text": "Corro regolarmente nel parco.",
          "translation": "Я регулярно бегаю в парке.",
          "source": "Tatoeba #6877768 @dnnywld / #6091105 @Tatjana (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6877768",
          "cefr_level": "A1",
          "word_slugs": [
            "regolarmente-adv"
          ]
        },
        {
          "id": "6790984",
          "text": "Assumete regolarmente le medicine!",
          "translation": "Принимайте лекарство регулярно!",
          "source": "Tatoeba #6790984 @dnnywld / #2403744 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790984",
          "cefr_level": "A1",
          "word_slugs": [
            "regolarmente-adv"
          ]
        },
        {
          "id": "10841642",
          "text": "Loro sono regolarmente in corrispondenza.",
          "translation": "Они регулярно переписываются.",
          "source": "Tatoeba #10841642 @dnnywld / #2397150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10841642",
          "cefr_level": "A1",
          "word_slugs": [
            "regolarmente-adv"
          ]
        },
        {
          "id": "5433608",
          "text": "Lui respirava profondamente e regolarmente.",
          "translation": "Он глубоко и ровно дышал.",
          "source": "Tatoeba #5433608 @dnnywld / #4039880 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433608",
          "cefr_level": "A1",
          "word_slugs": [
            "regolarmente-adv"
          ]
        },
        {
          "id": "5454652",
          "text": "Il prato va falciato regolarmente e correttamente.",
          "translation": "Газон надо стричь и регулярно, и правильно.",
          "source": "Tatoeba #5454652 @dnnywld / #5454605 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5454652",
          "cefr_level": "A1",
          "word_slugs": [
            "regolarmente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
