      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2004950",
          "text": "Ti sei divertito?",
          "translation": "Тебе весело было?",
          "source": "Tatoeba #2004950 @Guybrush88 / #5533536 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2004950",
          "cefr_level": "A1",
          "word_slugs": [
            "divertito-adj"
          ]
        },
        {
          "id": "2557203",
          "text": "Mi sono divertito.",
          "translation": "Я хорошо провёл время.",
          "source": "Tatoeba #2557203 @Guybrush88 / #2041014 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2557203",
          "cefr_level": "A1",
          "word_slugs": [
            "divertito-adj"
          ]
        },
        {
          "id": "2846577",
          "text": "Tom si è divertito.",
          "translation": "Фома хорошо провёл время.",
          "source": "Tatoeba #2846577 @Guybrush88 / #2737965 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2846577",
