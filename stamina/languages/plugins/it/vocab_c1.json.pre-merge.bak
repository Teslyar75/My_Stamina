    {
      "slug": "spera-verb",
      "lemma": "spera",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5837,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6782501",
          "text": "Tom spera che lo assumeranno.",
          "translation": "Том надеется, что они возьмут его на работу.",
          "source": "Tatoeba #6782501 @dnnywld / #6780336 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6782501",
          "cefr_level": "A1",
          "word_slugs": [
            "spera-verb"
          ]
        },
        {
          "id": "5524497",
          "text": "Lui spera nell'aiuto di Mary.",
          "translation": "Он надеется на помощь Мэри.",
          "source": "Tatoeba #5524497 @dnnywld / #5524161 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5524497",
          "cefr_level": "A1",
          "word_slugs": [
            "spera-verb"
          ]
        },
        {
          "id": "1217447",
          "text": "Tom spera di vederti a ottobre.",
          "translation": "Том надеется увидеть тебя в октябре.",
          "source": "Tatoeba #1217447 @Guybrush88 / #2615100 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1217447",
          "cefr_level": "A1",
          "word_slugs": [
            "spera-verb"
          ]
        },
        {
          "id": "6536946",
          "text": "Tom spera che Mary dirà di sì.",
          "translation": "Том надеется, что Мэри согласится.",
          "source": "Tatoeba #6536946 @Guybrush88 / #6902657 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6536946",
          "cefr_level": "A1",
          "word_slugs": [
            "spera-verb"
          ]
        },
        {
          "id": "6902998",
          "text": "Tom spera che Mary sia d'accordo.",
          "translation": "Том надеется, что Мэри согласится.",
          "source": "Tatoeba #6902998 @dnnywld / #6902657 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6902998",
          "cefr_level": "A1",
          "word_slugs": [
            "spera-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "spera",
        "plural": "",
        "infinitive": "spera"
      }
    },
    {
      "slug": "pianificato-adj",
      "lemma": "pianificato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5838,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4338432",
          "text": "L'hai pianificato con Tom?",
          "translation": "Ты спланировал это с Томом?",
          "source": "Tatoeba #4338432 @Guybrush88 / #5907581 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4338432",
          "cefr_level": "A1",
          "word_slugs": [
            "pianificato-adj"
          ]
        },
        {
          "id": "6809734",
          "text": "L'itinerario era pianificato al minuto.",
          "translation": "План путешествия был расписан по минутам.",
          "source": "Tatoeba #6809734 @dnnywld / #6808203 @Swetlanaw (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6809734",
          "cefr_level": "A1",
          "word_slugs": [
            "pianificato-adj"
          ]
        },
        {
          "id": "6797671",
          "text": "Ho pianificato di diventare un insegnante, ma non lo sono diventato.",
          "translation": "Я планировал стать учителем, но не стал.",
          "source": "Tatoeba #6797671 @dnnywld / #1393687 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797671",
          "cefr_level": "A1",
          "word_slugs": [
            "pianificato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
