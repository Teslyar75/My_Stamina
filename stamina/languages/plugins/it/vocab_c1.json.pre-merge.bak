    {
      "slug": "democrazia-noun",
      "lemma": "democrazia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7184,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "демократия"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "14097287",
          "text": "Amo la democrazia.",
          "translation": "Я люблю демократию.",
          "source": "Tatoeba #14097287 @Adelpa / #14097004 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14097287",
          "cefr_level": "A1",
          "word_slugs": [
            "democrazia-noun"
          ]
        },
        {
          "id": "3173071",
          "text": "Evviva la democrazia!",
          "translation": "Да здравствует демократия!",
          "source": "Tatoeba #3173071 @Guybrush88 / #3173157 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3173071",
          "cefr_level": "A1",
          "word_slugs": [
            "democrazia-noun"
          ]
        },
        {
          "id": "10885063",
          "text": "Quando è sorta la democrazia?",
          "translation": "Когда возникла демократия?",
          "source": "Tatoeba #10885063 @dnnywld / #509134 @Kostia (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885063",
          "cefr_level": "A1",
          "word_slugs": [
            "democrazia-noun"
          ]
        },
        {
          "id": "5646679",
          "text": "Viva il Brasile! Viva la democrazia!",
          "translation": "Да здравствует Бразилия! Да здравствует демократия!",
          "source": "Tatoeba #5646679 @dnnywld / #5646477 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646679",
          "cefr_level": "A1",
          "word_slugs": [
            "democrazia-noun"
          ]
        },
        {
          "id": "10885065",
          "text": "La Germania è ua democrazia parlametare.",
          "translation": "Германия - парламентская демократия.",
          "source": "Tatoeba #10885065 @dnnywld / #1436109 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885065",
          "cefr_level": "A1",
          "word_slugs": [
            "democrazia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la democrazia",
        "plural": "",
        "infinitive": ""
      }
