    {
      "slug": "lento-adj",
      "lemma": "lento",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5004,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5680961",
          "text": "Lui va lento.",
          "translation": "Он идёт медленно.",
          "source": "Tatoeba #5680961 @dnnywld / #5679852 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5680961",
          "cefr_level": "A1",
          "word_slugs": [
            "lento-adj"
          ]
        },
        {
          "id": "5580163",
          "text": "Tom è molto lento.",
          "translation": "Том очень медленный.",
          "source": "Tatoeba #5580163 @dnnywld / #5579531 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5580163",
          "cefr_level": "A1",
          "word_slugs": [
            "lento-adj"
          ]
        },
        {
          "id": "7326915",
          "text": "Sono il più lento.",
          "translation": "Я самый медленный.",
