    {
      "slug": "tredici-adj",
      "lemma": "tredici",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7402,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "тринадцать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10719368",
          "text": "La conosco da tredici anni.",
          "translation": "Я знаю её тринадцать лет.",
          "source": "Tatoeba #10719368 @Guybrush88 / #6684114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10719368",
          "cefr_level": "A1",
          "word_slugs": [
            "tredici-adj"
          ]
        },
        {
          "id": "5567787",
          "text": "Tom ha compiuto tredici anni.",
          "translation": "Тому исполнилось тринадцать лет.",
          "source": "Tatoeba #5567787 @dnnywld / #5567324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5567787",
          "cefr_level": "A1",
          "word_slugs": [
            "tredici-adj"
          ]
        },
        {
          "id": "5514336",
          "text": "Siamo qui dal duemila tredici.",
          "translation": "Мы здесь с две тысячи тринадцатого года.",
          "source": "Tatoeba #5514336 @dnnywld / #5513716 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514336",
          "cefr_level": "A1",
          "word_slugs": [
            "tredici-adj"
          ]
        },
        {
          "id": "6004616",
          "text": "Tredici persone sono rimaste ferite.",
          "translation": "Тринадцать человек получили ранения.",
          "source": "Tatoeba #6004616 @dnnywld / #6004297 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6004616",
          "cefr_level": "A1",
          "word_slugs": [
            "tredici-adj"
          ]
        },
        {
          "id": "3462837",
          "text": "So che Tom ha tredici anni.",
          "translation": "Я знаю, что Тому тринадцать.",
          "source": "Tatoeba #3462837 @Guybrush88 / #5705693 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3462837",
          "cefr_level": "A1",
          "word_slugs": [
            "tredici-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "tredici",
        "plural": "",
        "infinitive": ""
      }
