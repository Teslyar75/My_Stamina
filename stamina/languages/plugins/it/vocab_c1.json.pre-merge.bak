    {
      "slug": "libreria-noun",
      "lemma": "libreria",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8138,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6893803",
          "text": "Lì una volta c'era una libreria.",
          "translation": "Там раньше был книжный магазин.",
          "source": "Tatoeba #6893803 @dnnywld / #6893223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893803",
          "cefr_level": "A1",
          "word_slugs": [
            "libreria-noun"
          ]
        },
        {
          "id": "3387723",
          "text": "Qual è l'indirizzo della nuova libreria?",
          "translation": "Какой адрес у нового книжного?",
          "source": "Tatoeba #3387723 @Guybrush88 / #5654445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3387723",
          "cefr_level": "A1",
          "word_slugs": [
            "libreria-noun"
          ]
        },
        {
          "id": "11706738",
          "text": "Ho comprato questo libro in quella libreria.",
          "translation": "Я купил эту книгу в том книжном магазине.",
          "source": "Tatoeba #11706738 @Guybrush88 / #11339418 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11706738",
          "cefr_level": "A1",
          "word_slugs": [
            "libreria-noun"
          ]
        },
        {
          "id": "6893792",
          "text": "A quanto ricordo, lì c'era una libreria.",
          "translation": "Сколько я себя помню, там был книжный.",
          "source": "Tatoeba #6893792 @dnnywld / #6893226 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893792",
          "cefr_level": "A1",
          "word_slugs": [
            "libreria-noun"
          ]
        },
        {
          "id": "6893806",
          "text": "Dietro l'alto edificio c'è una libreria.",
          "translation": "За высоким зданием - книжный магазин.",
          "source": "Tatoeba #6893806 @dnnywld / #6893221 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893806",
          "cefr_level": "A1",
          "word_slugs": [
            "libreria-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la libreria",
        "plural": "",
        "infinitive": ""
      }
    },
