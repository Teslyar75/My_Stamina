          "cefr_level": "A1",
          "word_slugs": [
            "adatta-verb"
          ]
        },
        {
          "id": "7047620",
          "text": "Non riesco a trovare la parola adatta.",
          "translation": "Я не могу подобрать подходящее слово.",
          "source": "Tatoeba #7047620 @dnnywld / #7047555 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7047620",
          "cefr_level": "A1",
          "word_slugs": [
            "adatta-verb"
          ]
        },
        {
          "id": "6799374",
          "text": "Questa non è affatto una parola adatta.",
          "translation": "Это не совсем подходящее слово.",
          "source": "Tatoeba #6799374 @dnnywld / #6798951 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799374",
