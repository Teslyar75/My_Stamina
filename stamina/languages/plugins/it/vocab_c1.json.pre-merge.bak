            "punito-verb"
          ]
        },
        {
          "id": "5592336",
          "text": "Tom verrà punito.",
          "translation": "Тома накажут.",
          "source": "Tatoeba #5592336 @dnnywld / #5591801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5592336",
