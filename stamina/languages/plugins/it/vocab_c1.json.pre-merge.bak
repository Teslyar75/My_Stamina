    {
      "slug": "premere-verb",
      "lemma": "premere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5794,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6892091",
          "text": "Tom non sa quale pulsante premere.",
          "translation": "Том не знает, на какую кнопку нажать.",
          "source": "Tatoeba #6892091 @dnnywld / #1795722 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6892091",
          "cefr_level": "A1",
          "word_slugs": [
            "premere-verb"
          ]
        },
        {
          "id": "4484293",
          "text": "Premere un tasto qualsiasi per continuare.",
          "translation": "Нажмите любую клавишу, чтобы продолжить.",
          "source": "Tatoeba #4484293 @Sirio60 / #4469154 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4484293",
          "cefr_level": "A1",
          "word_slugs": [
            "premere-verb"
          ]
        },
        {
          "id": "4484292",
          "text": "Per continuare, premere un tasto qualsiasi.",
          "translation": "Нажмите любую клавишу, чтобы продолжить.",
          "source": "Tatoeba #4484292 @Sirio60 / #4469154 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4484292",
          "cefr_level": "A1",
          "word_slugs": [
            "premere-verb"
          ]
        },
        {
          "id": "7311272",
          "text": "Qualsiasi cosa tu stia facendo, non premere questo pulsante.",
          "translation": "Что бы ты ни делал, не нажимай эту кнопку.",
          "source": "Tatoeba #7311272 @dnnywld / #7310412 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7311272",
          "cefr_level": "A1",
          "word_slugs": [
            "premere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "premere",
        "plural": "",
        "infinitive": "premere"
      }
