    {
      "slug": "compiere-verb",
      "lemma": "compiere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6246,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6556325",
          "text": "Ho una missione da compiere.",
          "translation": "Мне нужно выполнить одно поручение.",
          "source": "Tatoeba #6556325 @dnnywld / #6556292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6556325",
          "cefr_level": "A1",
          "word_slugs": [
            "compiere-verb"
          ]
        },
        {
          "id": "6944316",
          "text": "Devi compiere il tuo dovere.",
          "translation": "Ты должен выполнять свой долг.",
          "source": "Tatoeba #6944316 @dnnywld / #6943884 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944316",
          "cefr_level": "A1",
          "word_slugs": [
            "compiere-verb"
          ]
        },
        {
          "id": "5433563",
          "text": "Permettetemi di compiere questo lavoro.",
          "translation": "Позвольте мне выполнить эту работу.",
          "source": "Tatoeba #5433563 @dnnywld / #5431456 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433563",
          "cefr_level": "A1",
          "word_slugs": [
            "compiere-verb"
          ]
        },
        {
          "id": "6893465",
          "text": "Per voi è molto difficile compiere questo lavoro.",
          "translation": "Вам очень трудно выполнять эту работу.",
          "source": "Tatoeba #6893465 @dnnywld / #2619933 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893465",
          "cefr_level": "A1",
          "word_slugs": [
            "compiere-verb"
          ]
        },
        {
          "id": "6910661",
          "text": "Non sono in grado di compiere un altro lavoro.",
          "translation": "Я не способен выполнять другую работу.",
          "source": "Tatoeba #6910661 @dnnywld / #6909543 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6910661",
          "cefr_level": "A1",
          "word_slugs": [
            "compiere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "compiere",
        "plural": "",
        "infinitive": "compiere"
      }
    },
    {
      "slug": "intervenire-verb",
      "lemma": "intervenire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6247,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6860627",
          "text": "Mary pensò bene di non intervenire.",
          "translation": "Мэри не стала вмешиваться.",
          "source": "Tatoeba #6860627 @dnnywld / #4040465 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6860627",
          "cefr_level": "A1",
          "word_slugs": [
            "intervenire-verb"
          ]
        },
        {
          "id": "10996317",
          "text": "Le forze dell'ordine sono dovute intervenire.",
          "translation": "Стражам порядка пришлось вмешаться.",
          "source": "Tatoeba #10996317 @dnnywld / #10996293 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10996317",
          "cefr_level": "A1",
          "word_slugs": [
            "intervenire-verb"
          ]
        }
      ],
      "tags": [
