    {
      "slug": "orribili-adj",
      "lemma": "orribili",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5022,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7275154",
          "text": "Come puoi dire cose così orribili?",
          "translation": "Как у тебя язык поворачивается говорить такие ужасные вещи?",
          "source": "Tatoeba #7275154 @dnnywld / #7274277 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275154",
          "cefr_level": "A1",
          "word_slugs": [
            "orribili-adj"
          ]
        },
        {
          "id": "7275155",
          "text": "Come potete dire cose così orribili?",
          "translation": "Как у вас язык поворачивается говорить такие ужасные вещи?",
          "source": "Tatoeba #7275155 @dnnywld / #7274278 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275155",
          "cefr_level": "A1",
          "word_slugs": [
            "orribili-adj"
          ]
        },
        {
          "id": "6787011",
          "text": "Smettila di dire cose orribili di Tom!",
          "translation": "Бросай говорить о Томе гадости!",
          "source": "Tatoeba #6787011 @dnnywld / #4878970 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6787011",
          "cefr_level": "A1",
          "word_slugs": [
            "orribili-adj"
          ]
        },
        {
          "id": "7275152",
          "text": "Non vi si storce la lingua a dire cose così orribili?",
          "translation": "Как у вас язык поворачивается говорить такие ужасные вещи?",
          "source": "Tatoeba #7275152 @dnnywld / #7274278 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275152",
          "cefr_level": "A1",
          "word_slugs": [
            "orribili-adj"
          ]
        },
        {
          "id": "7275153",
          "text": "Non ti si storce la lingua a dire cose così orribili?",
          "translation": "Как у тебя язык поворачивается говорить такие ужасные вещи?",
          "source": "Tatoeba #7275153 @dnnywld / #7274277 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275153",
          "cefr_level": "A1",
          "word_slugs": [
            "orribili-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il orribili",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "francamente-adv",
      "lemma": "francamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5023,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5437931",
          "text": "Ci parliamo francamente?",
          "translation": "Поговорим начистоту?",
          "source": "Tatoeba #5437931 @dnnywld / #2481944 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5437931",
          "cefr_level": "A1",
          "word_slugs": [
            "francamente-adv"
          ]
        },
        {
          "id": "5925002",
          "text": "Qualcuno dovrebbe parlargli francamente.",
          "translation": "Кто-то должен поговорить с ним начистоту.",
          "source": "Tatoeba #5925002 @dnnywld / #5924965 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5925002",
          "cefr_level": "A1",
          "word_slugs": [
            "francamente-adv"
          ]
        },
        {
          "id": "6788852",
          "text": "Francamente, per me fa lo stesso.",
          "translation": "Если честно, мне всё равно.",
          "source": "Tatoeba #6788852 @dnnywld / #4727780 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6788852",
          "cefr_level": "A1",
          "word_slugs": [
            "francamente-adv"
          ]
        },
        {
          "id": "6312473",
          "text": "Parlando francamente, Tom non mi piace.",
          "translation": "По правде говоря, Том мне не нравится.",
          "source": "Tatoeba #6312473 @dnnywld / #6312234 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6312473",
          "cefr_level": "A1",
          "word_slugs": [
            "francamente-adv"
          ]
        },
        {
          "id": "2432834",
          "text": "Tutto questo, francamente, non mi piace.",
          "translation": "Всё это, честно говоря, мне не нравится.",
          "source": "Tatoeba #2432834 @al_ex_an_der / #2432830 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2432834",
          "cefr_level": "A1",
          "word_slugs": [
            "francamente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "francamente",
        "plural": "",
        "infinitive": ""
      }
    },
