    {
      "slug": "incidenti-verb",
      "lemma": "incidenti",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5436,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5652321",
          "text": "Gli incidenti mortali sono frequenti.",
          "translation": "Часты смертельные случаи.",
          "source": "Tatoeba #5652321 @dnnywld / #5651534 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652321",
          "cefr_level": "A1",
          "word_slugs": [
            "incidenti-verb"
          ]
        },
        {
          "id": "6378052",
          "text": "Fortunatamente abbiamo volato senza incidenti.",
          "translation": "К счастью, мы долетели без приключений.",
          "source": "Tatoeba #6378052 @dnnywld / #1758239 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6378052",
          "cefr_level": "A1",
          "word_slugs": [
            "incidenti-verb"
          ]
        },
        {
          "id": "6843028",
          "text": "Simili incidenti accadono di tanto in tanto.",
          "translation": "Такие происшествия случаются время от времени.",
          "source": "Tatoeba #6843028 @dnnywld / #2679278 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843028",
          "cefr_level": "A1",
          "word_slugs": [
            "incidenti-verb"
          ]
        },
        {
          "id": "5569478",
          "text": "La disattenzione diventa spesso la causa degli incidenti.",
          "translation": "Невнимательность часто становится причиной несчастных случаев.",
          "source": "Tatoeba #5569478 @dnnywld / #5569265 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5569478",
          "cefr_level": "A1",
          "word_slugs": [
            "incidenti-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "incidenti",
        "plural": "",
        "infinitive": "incidenti"
      }
    },
