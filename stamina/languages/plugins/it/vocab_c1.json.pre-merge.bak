          "cefr_level": "A1",
          "word_slugs": [
            "corea-noun"
          ]
        },
        {
          "id": "5653527",
          "text": "Vorrei visitare la Corea del Sud.",
          "translation": "Я хотел бы съездить в Южную Корею.",
          "source": "Tatoeba #5653527 @dnnywld / #5653357 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5653527",
          "cefr_level": "A1",
          "word_slugs": [
            "corea-noun"
          ]
        },
        {
          "id": "5514639",
          "text": "Mio padre ha intenzione di visitare la Corea la prossima settimana.",
          "translation": "Мой отец планирует на следующей неделе посетить Корею.",
          "source": "Tatoeba #5514639 @dnnywld / #5514615 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514639",
          "cefr_level": "A1",
          "word_slugs": [
            "corea-noun"
          ]
        }
