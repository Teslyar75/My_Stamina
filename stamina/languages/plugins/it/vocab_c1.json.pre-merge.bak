    {
      "slug": "cuoco-noun",
      "lemma": "cuoco",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6502,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5464718",
          "text": "Tu sei il cuoco.",
          "translation": "Ты повар.",
          "source": "Tatoeba #5464718 @dnnywld / #3388490 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5464718",
          "cefr_level": "A1",
          "word_slugs": [
            "cuoco-noun"
          ]
        },
        {
          "id": "1494098",
          "text": "Cerco lavoro come cuoco.",
          "translation": "Ищу работу повара.",
          "source": "Tatoeba #1494098 @Guybrush88 / #3111022 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1494098",
          "cefr_level": "A1",
          "word_slugs": [
            "cuoco-noun"
          ]
        },
        {
          "id": "5509783",
          "text": "Lui è un cuoco molto bravo.",
          "translation": "Он очень хороший повар.",
          "source": "Tatoeba #5509783 @dnnywld / #5508746 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5509783",
          "cefr_level": "A1",
          "word_slugs": [
            "cuoco-noun"
          ]
        },
        {
          "id": "6841943",
          "text": "Al cuoco serve il sale di sicuro.",
          "translation": "Повару непременно нужна соль.",
          "source": "Tatoeba #6841943 @dnnywld / #5970383 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841943",
          "cefr_level": "A1",
          "word_slugs": [
            "cuoco-noun"
          ]
        },
        {
          "id": "5482304",
          "text": "Il cuoco si stupì del suo terribile appetito.",
          "translation": "Повар удивился его ужасному аппетиту.",
          "source": "Tatoeba #5482304 @dnnywld / #580310 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5482304",
          "cefr_level": "A1",
          "word_slugs": [
            "cuoco-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il cuoco",
        "plural": "",
        "infinitive": ""
      }
    },
    {
