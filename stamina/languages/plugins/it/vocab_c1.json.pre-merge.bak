    {
      "slug": "capiscono-verb",
      "lemma": "capiscono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6716,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4994083",
          "text": "Non capiscono chi eleggono.",
          "translation": "Они не понимают, кого выбирают.",
          "source": "Tatoeba #4994083 @Guybrush88 / #10179891 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4994083",
          "cefr_level": "A1",
          "word_slugs": [
            "capiscono-verb"
          ]
        },
        {
          "id": "6004594",
          "text": "Gli uomini questo non lo capiscono.",
          "translation": "Мужчины этого не понимают.",
          "source": "Tatoeba #6004594 @dnnywld / #6004542 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6004594",
          "cefr_level": "A1",
          "word_slugs": [
            "capiscono-verb"
          ]
        },
        {
          "id": "3582376",
          "text": "Loro non capiscono per niente l'inglese.",
          "translation": "Они совершенно не понимают по-английски.",
          "source": "Tatoeba #3582376 @Guybrush88 / #3639156 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3582376",
          "cefr_level": "A1",
          "word_slugs": [
            "capiscono-verb"
          ]
        },
        {
          "id": "6940773",
          "text": "Loro sono stranieri e non capiscono il russo.",
          "translation": "Они иностранцы и не понимают по-русски.",
          "source": "Tatoeba #6940773 @dnnywld / #6940406 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6940773",
          "cefr_level": "A1",
          "word_slugs": [
            "capiscono-verb"
          ]
        },
        {
          "id": "3541342",
          "text": "La violenza è l'unico linguaggio che capiscono.",
          "translation": "Насилие — единственный язык, который они понимают.",
          "source": "Tatoeba #3541342 @Guybrush88 / #3546448 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3541342",
          "cefr_level": "A1",
          "word_slugs": [
            "capiscono-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "capiscono",
        "plural": "",
        "infinitive": "capiscono"
      }
