    {
      "slug": "forme-noun",
      "lemma": "forme",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5880,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3020825",
          "text": "Il parlato utilizza le forme più usate.",
          "translation": "В речи используют наиболее распространённые формы.",
          "source": "Tatoeba #3020825 @Guybrush88 / #4387104 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3020825",
          "cefr_level": "A1",
          "word_slugs": [
            "forme-noun"
          ]
        },
        {
          "id": "5597352",
          "text": "Rompere le finestre dei negozi è una delle forme di vandalismo.",
          "translation": "Бить окна магазинов является одним из проявлений вандализма.",
          "source": "Tatoeba #5597352 @dnnywld / #5596687 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5597352",
          "cefr_level": "A1",
          "word_slugs": [
            "forme-noun"
          ]
        }
      ],
