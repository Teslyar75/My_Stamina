    {
      "slug": "proposto-noun",
      "lemma": "proposto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6953,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5476449",
          "text": "L'ho proposto a Tom.",
          "translation": "Я предложил это Тому.",
          "source": "Tatoeba #5476449 @dnnywld / #5476129 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476449",
          "cefr_level": "A1",
          "word_slugs": [
            "proposto-noun"
          ]
        },
        {
          "id": "13612739",
          "text": "Non lo avrei mai proposto.",
          "translation": "Я бы никогда не предложил этого.",
          "source": "Tatoeba #13612739 @dnnywld / #2633029 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13612739",
          "cefr_level": "A1",
          "word_slugs": [
            "proposto-noun"
          ]
        },
        {
          "id": "6378011",
          "text": "Tom ci ha proposto di farlo.",
          "translation": "Том предложил нам это сделать.",
          "source": "Tatoeba #6378011 @dnnywld / #6377873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6378011",
          "cefr_level": "A1",
          "word_slugs": [
            "proposto-noun"
          ]
        },
        {
          "id": "6826496",
          "text": "Ho proposto di andare a pesca.",
          "translation": "Я предложил пойти на рыбалку.",
          "source": "Tatoeba #6826496 @dnnywld / #6817735 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6826496",
          "cefr_level": "A1",
          "word_slugs": [
            "proposto-noun"
          ]
        },
        {
          "id": "8735000",
          "text": "Ho proposto a Tom di andare al cinema.",
          "translation": "Я предложил Тому сходить в кино.",
          "source": "Tatoeba #8735000 @Valdast / #7067924 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8735000",
          "cefr_level": "A1",
          "word_slugs": [
            "proposto-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il proposto",
        "plural": "",
        "infinitive": ""
      }
