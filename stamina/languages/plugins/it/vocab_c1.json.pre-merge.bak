    {
      "slug": "dormitorio-adj",
      "lemma": "dormitorio",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8893,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5907145",
          "text": "Nel nuovo dormitorio vivono solo gli studenti stranieri.",
          "translation": "В новом общежитии живут только иностранные студенты.",
          "source": "Tatoeba #5907145 @dnnywld / #5905800 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907145",
          "cefr_level": "A1",
          "word_slugs": [
            "dormitorio-adj"
          ]
        },
        {
          "id": "5907144",
          "text": "Nel nuovo dormitorio vivono solo gli studenti degli altri paesi.",
          "translation": "В новом общежитии живут только студенты из других стран.",
          "source": "Tatoeba #5907144 @dnnywld / #5905802 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907144",
          "cefr_level": "A1",
          "word_slugs": [
            "dormitorio-adj"
          ]
        },
        {
          "id": "5907143",
          "text": "Gli studenti della Facoltà delle Lingue Straniere vivono nel vecchio dormitorio.",
          "translation": "Студенты факультета иностранных языков живут в старом общежитии.",
          "source": "Tatoeba #5907143 @dnnywld / #5905803 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907143",
          "cefr_level": "A1",
          "word_slugs": [
            "dormitorio-adj"
          ]
        },
        {
          "id": "5907141",
          "text": "Gli studenti della Facoltà di Lingue Straniere non vivono nel nuovo dormitorio.",
          "translation": "Студенты факультета иностранных языков не живут в новом общежитии.",
          "source": "Tatoeba #5907141 @dnnywld / #5905804 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907141",
          "cefr_level": "A1",
          "word_slugs": [
            "dormitorio-adj"
          ]
        }
