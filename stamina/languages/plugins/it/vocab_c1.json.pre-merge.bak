    {
      "slug": "fili-noun",
      "lemma": "fili",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6237,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "440386",
          "text": "Lui ha tre fili.",
          "translation": "У него три сына.",
          "source": "Tatoeba #440386 @Pharamp / #3879175 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/440386",
          "cefr_level": "A1",
          "word_slugs": [
            "fili-noun"
          ]
        },
        {
          "id": "5429578",
          "text": "Perché le persone appendono le scarpe ai fili elettrici?",
          "translation": "Зачем люди вешают кроссовки на провода?",
          "source": "Tatoeba #5429578 @dnnywld / #3828075 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5429578",
          "cefr_level": "A1",
          "word_slugs": [
            "fili-noun"
          ]
        },
        {
          "id": "6691614",
          "text": "A volte nel vomito del mio gatto noto dei fili d'erba.",
          "translation": "Иногда в блевотине моей кошки я замечаю травинки.",
          "source": "Tatoeba #6691614 @dnnywld / #6690932 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6691614",
          "cefr_level": "A1",
          "word_slugs": [
            "fili-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il fili",
        "plural": "",
        "infinitive": ""
      }
