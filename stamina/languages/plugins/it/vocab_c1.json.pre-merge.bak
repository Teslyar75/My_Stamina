    {
      "slug": "statua-noun",
      "lemma": "statua",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5719,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "статуя"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5384858",
          "text": "Questa è la statua di Giove.",
          "translation": "Это статуя Юпитера.",
          "source": "Tatoeba #5384858 @dnnywld / #5384853 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384858",
          "cefr_level": "A1",
          "word_slugs": [
            "statua-noun"
          ]
        },
        {
          "id": "5509557",
          "text": "Questa è la statua di Nettuno.",
          "translation": "Это статуя Нептуна.",
          "source": "Tatoeba #5509557 @dnnywld / #5509096 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5509557",
          "cefr_level": "A1",
          "word_slugs": [
            "statua-noun"
          ]
        },
        {
          "id": "5415978",
          "text": "Hanno scolpito una statua di marmo.",
          "translation": "Они высекают статую из мрамора.",
          "source": "Tatoeba #5415978 @dnnywld / #4063338 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415978",
          "cefr_level": "A1",
          "word_slugs": [
            "statua-noun"
          ]
        },
        {
          "id": "10849214",
          "text": "Accanto al duomo c'è una statua.",
          "translation": "Рядом с собором стоит статуя.",
          "source": "Tatoeba #10849214 @dnnywld / #10849026 @maaster (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849214",
          "cefr_level": "A1",
          "word_slugs": [
            "statua-noun"
          ]
        },
        {
          "id": "5980574",
          "text": "Mi sembra che questa statua ci stia guardando.",
          "translation": "Мне кажется, что эта статуя на нас смотрит.",
          "source": "Tatoeba #5980574 @dnnywld / #5980568 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980574",
          "cefr_level": "A1",
          "word_slugs": [
            "statua-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la statua",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "confini-noun",
      "lemma": "confini",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5720,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10878769",
          "text": "Fanculo i confini.",
          "translation": "Нахуй границы.",
          "source": "Tatoeba #10878769 @dnnywld / #9478102 @Katie_Yves (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878769",
          "cefr_level": "A1",
          "word_slugs": [
            "confini-noun"
          ]
        },
        {
          "id": "13873164",
          "text": "Shakespeare non uscì mai dai confini dell'Inghilterra.",
          "translation": "Шекспир никогда не выезжал за пределы Англии.",
          "source": "Tatoeba #13873164 @dnnywld / #13872386 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13873164",
          "cefr_level": "A1",
          "word_slugs": [
            "confini-noun"
          ]
        },
        {
          "id": "5624190",
          "text": "Sei a favore o contrario all'apertura dei confini?",
          "translation": "Ты \"за\" или \"против\" открытых границ?",
          "source": "Tatoeba #5624190 @dnnywld / #5624019 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624190",
          "cefr_level": "A1",
          "word_slugs": [
            "confini-noun"
          ]
        },
        {
          "id": "13873163",
          "text": "Puškin non uscì mai dai confini dell'Impero Russo.",
          "translation": "Пушкин никогда не выезжал за пределы Российской империи.",
          "source": "Tatoeba #13873163 @dnnywld / #13872387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13873163",
          "cefr_level": "A1",
          "word_slugs": [
            "confini-noun"
          ]
        },
        {
          "id": "5624191",
          "text": "Siete a favore o contrari all'apertura dei confini?",
          "translation": "Вы \"за\" или \"против\" открытых границ?",
          "source": "Tatoeba #5624191 @dnnywld / #5624020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624191",
          "cefr_level": "A1",
          "word_slugs": [
            "confini-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il confini",
        "plural": "",
        "infinitive": ""
      }
