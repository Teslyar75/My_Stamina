            "cinquanta-adj"
          ]
        },
        {
          "id": "6942641",
          "text": "La benzina basterà per cinquanta chilometri.",
          "translation": "Бензина хватит километров на пятьдесят.",
          "source": "Tatoeba #6942641 @dnnywld / #6942036 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6942641",
          "cefr_level": "A1",
          "word_slugs": [
            "cinquanta-adj"
          ]
        },
        {
          "id": "11445529",
          "text": "Hanno contato monotonamente fino a cinquanta.",
          "translation": "Они монотонно считали до пятидесяти.",
          "source": "Tatoeba #11445529 @Valdast / #1559835 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11445529",
          "cefr_level": "A1",
          "word_slugs": [
            "cinquanta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
