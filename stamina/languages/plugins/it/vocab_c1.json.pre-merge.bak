    {
      "slug": "bottone-noun",
      "lemma": "bottone",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6620,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5634826",
          "text": "Sei senza un bottone.",
          "translation": "У тебя одной пуговицы не хватает.",
          "source": "Tatoeba #5634826 @dnnywld / #5533115 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5634826",
          "cefr_level": "A1",
          "word_slugs": [
            "bottone-noun"
          ]
        },
        {
          "id": "5465418",
          "text": "Tom ha cucito il bottone al contrario.",
          "translation": "Том пришил пуговицу обратно.",
          "source": "Tatoeba #5465418 @dnnywld / #5465044 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5465418",
          "cefr_level": "A1",
          "word_slugs": [
            "bottone-noun"
          ]
        },
        {
          "id": "7036123",
          "text": "Tom stesso ha cucito un bottone strappato.",
          "translation": "Том сам пришил оторванную пуговицу.",
          "source": "Tatoeba #7036123 @dnnywld / #7035793 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7036123",
          "cefr_level": "A1",
          "word_slugs": [
            "bottone-noun"
          ]
        },
        {
          "id": "5516030",
          "text": "Hai ago e filo bianco? Devo attaccare un bottone.",
          "translation": "У тебя есть иголка и белые нитки? Мне надо пришить пуговицу.",
          "source": "Tatoeba #5516030 @dnnywld / #5516024 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5516030",
          "cefr_level": "A1",
          "word_slugs": [
            "bottone-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il bottone",
        "plural": "",
        "infinitive": ""
      }
