    {
      "slug": "probabilità-noun",
      "lemma": "probabilità",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6439,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1720490",
          "text": "La probabilità non esiste.",
          "translation": "Вероятность не существует.",
          "source": "Tatoeba #1720490 @Guybrush88 / #1720500 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1720490",
          "cefr_level": "A1",
          "word_slugs": [
            "probabilità-noun"
          ]
        },
        {
          "id": "1927969",
          "text": "Comunque tu la veda, le probabilità sono contro di noi.",
          "translation": "Как на это ни смотри, шансы против нас.",
          "source": "Tatoeba #1927969 @Shadd / #4225753 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1927969",
          "cefr_level": "A1",
          "word_slugs": [
            "probabilità-noun"
          ]
        },
        {
          "id": "1479971",
          "text": "Nel gioco d'azzardo è molto importante conoscere le probabilità degli eventi.",
          "translation": "В азартной игре очень важно знать вероятности событий.",
          "source": "Tatoeba #1479971 @rado / #3682008 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1479971",
          "cefr_level": "A1",
          "word_slugs": [
            "probabilità-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la probabilità",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "comportando-verb",
      "lemma": "comportando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6440,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6890161",
          "text": "Non ti stai comportando bene.",
          "translation": "Ты некрасиво себя ведёшь.",
          "source": "Tatoeba #6890161 @dnnywld / #5087618 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890161",
          "cefr_level": "A1",
          "word_slugs": [
            "comportando-verb"
          ]
        },
        {
          "id": "6890164",
          "text": "Ti stai comportando da stupido.",
          "translation": "Ты ведёшь себя глупо.",
          "source": "Tatoeba #6890164 @dnnywld / #6305889 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890164",
          "cefr_level": "A1",
          "word_slugs": [
            "comportando-verb"
          ]
        },
        {
          "id": "3659198",
          "text": "Perché ti stai comportando così?",
          "translation": "Почему ты так себя ведёшь?",
          "source": "Tatoeba #3659198 @Guybrush88 / #5792123 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3659198",
          "cefr_level": "A1",
          "word_slugs": [
            "comportando-verb"
          ]
        },
        {
          "id": "5595747",
          "text": "Ti stai comportando come un'idiota.",
          "translation": "Ты ведёшь себя как дура.",
          "source": "Tatoeba #5595747 @dnnywld / #5595662 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5595747",
          "cefr_level": "A1",
          "word_slugs": [
            "comportando-verb"
          ]
        },
        {
          "id": "6890167",
          "text": "Ti stai comportando come un idiota.",
          "translation": "Ты ведёшь себя как дурак.",
          "source": "Tatoeba #6890167 @dnnywld / #3539897 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890167",
          "cefr_level": "A1",
          "word_slugs": [
            "comportando-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "comportando",
