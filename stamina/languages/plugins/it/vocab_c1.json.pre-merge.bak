    {
      "slug": "viaggia-verb",
      "lemma": "viaggia",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8332,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5393631",
          "text": "Tom viaggia in autostop.",
          "translation": "Том путешествует автостопом.",
          "source": "Tatoeba #5393631 @dnnywld / #5393593 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5393631",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggia-verb"
          ]
        },
        {
          "id": "5522650",
          "text": "Tom viaggia meno di Mary.",
          "translation": "Том путешествует меньше Мэри.",
          "source": "Tatoeba #5522650 @dnnywld / #5522503 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5522650",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggia-verb"
          ]
        },
        {
          "id": "6904617",
          "text": "Devi reimpostare l'orologio. Viaggia in ritardo.",
          "translation": "Тебе надо подвести часы. Они отстают.",
          "source": "Tatoeba #6904617 @dnnywld / #4436101 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904617",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggia-verb"
          ]
        },
        {
          "id": "6830024",
          "text": "Mary viaggia sempre con la sua valigetta nera.",
          "translation": "Мэри всегда путешествует со своим чёрным чемоданчиком.",
          "source": "Tatoeba #6830024 @dnnywld / #6829551 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6830024",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggia-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "viaggia",
        "plural": "",
        "infinitive": "viaggia"
      }
