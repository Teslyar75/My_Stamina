    {
      "slug": "sollevare-verb",
      "lemma": "sollevare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8976,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5766613",
          "text": "Non mi puoi sollevare?",
          "translation": "Ты не можешь поднять меня?",
          "source": "Tatoeba #5766613 @Guybrush88 / #6793888 @Annushka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5766613",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevare-verb"
          ]
        },
        {
          "id": "5499227",
          "text": "Aiutami a sollevare questo.",
          "translation": "Помоги мне это поднять.",
          "source": "Tatoeba #5499227 @dnnywld / #5499150 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499227",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevare-verb"
          ]
        },
        {
          "id": "5590502",
          "text": "Aiutatemi a sollevare questo.",
          "translation": "Помогите мне это поднять.",
          "source": "Tatoeba #5590502 @dnnywld / #5590224 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5590502",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevare-verb"
          ]
        },
        {
          "id": "5610402",
          "text": "Non riesco a sollevare questo.",
          "translation": "Я не могу это поднять.",
          "source": "Tatoeba #5610402 @dnnywld / #5609906 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5610402",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevare-verb"
          ]
        },
        {
          "id": "7325538",
          "text": "Non riesco a sollevare questa cassa da solo.",
          "translation": "Я не могу поднять этот ящик один.",
          "source": "Tatoeba #7325538 @dnnywld / #7325040 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7325538",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevare-verb"
          ]
        }
      ],
