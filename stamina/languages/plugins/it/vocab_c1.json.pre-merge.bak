          ]
        },
        {
          "id": "6316055",
          "text": "È vietato manipolare la costituzione per propri scopi.",
          "translation": "Нельзя подминать под себя конституцию.",
          "source": "Tatoeba #6316055 @dnnywld / #6315959 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6316055",
          "cefr_level": "A1",
          "word_slugs": [
            "scopi-noun"
          ]
        },
        {
          "id": "3236392",
          "text": "L'energia atomica può essere utilizzata per degli scopi pacifici.",
          "translation": "Атомная энергия может использоваться в мирных целях.",
          "source": "Tatoeba #3236392 @Guybrush88 / #3262917 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3236392",
          "cefr_level": "A1",
          "word_slugs": [
            "scopi-noun"
          ]
        },
        {
          "id": "11396001",
          "text": "Lo stato del Colorado permette l'uso di marijuana per scopi medici.",
          "translation": "Штат Колорадо разрешает употребление марихуаны в медицинских целях.",
          "source": "Tatoeba #11396001 @Bernie75 / #3301919 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11396001",
          "cefr_level": "A1",
          "word_slugs": [
            "scopi-noun"
          ]
        }
      ],
