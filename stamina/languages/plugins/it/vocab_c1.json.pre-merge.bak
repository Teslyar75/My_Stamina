    {
      "slug": "tentativi-noun",
      "lemma": "tentativi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9497,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6324972",
          "text": "Tutti i miei tentativi sono falliti.",
          "translation": "Все мои попытки были неудачными.",
          "source": "Tatoeba #6324972 @dnnywld / #6324305 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6324972",
          "cefr_level": "A1",
          "word_slugs": [
            "tentativi-noun"
          ]
        },
        {
          "id": "1525307",
          "text": "Tutti i nostri tentativi furono vani.",
          "translation": "Все наши попытки были впустую.",
          "source": "Tatoeba #1525307 @riccioberto / #1525302 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1525307",
          "cefr_level": "A1",
          "word_slugs": [
            "tentativi-noun"
          ]
        },
        {
          "id": "5980581",
          "text": "Tutti i suoi tentativi sono finiti male.",
          "translation": "Все её попытки закончились неудачей.",
          "source": "Tatoeba #5980581 @dnnywld / #5980562 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980581",
          "cefr_level": "A1",
          "word_slugs": [
            "tentativi-noun"
          ]
        },
        {
          "id": "6832105",
          "text": "I miei tentativi sono stati vani finora.",
          "translation": "Мои попытки пока что были напрасны.",
          "source": "Tatoeba #6832105 @dnnywld / #4370839 @User55521 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6832105",
          "cefr_level": "A1",
          "word_slugs": [
            "tentativi-noun"
          ]
        },
        {
          "id": "12580960",
          "text": "I tentativi di limitare Internet conducono al risultato opposto.",
          "translation": "Попытки ограничить интернет приводят к обратному результату.",
          "source": "Tatoeba #12580960 @dnnywld / #7529360 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12580960",
          "cefr_level": "A1",
          "word_slugs": [
            "tentativi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tentativi",
        "plural": "",
        "infinitive": ""
      }
