      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12043798",
          "text": "Non farò gli esercizi.",
          "translation": "Я не буду делать упражнения.",
          "source": "Tatoeba #12043798 @dnnywld / #12043498 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12043798",
          "cefr_level": "A1",
          "word_slugs": [
