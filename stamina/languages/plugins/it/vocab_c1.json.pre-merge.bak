    {
      "slug": "difetti-noun",
      "lemma": "difetti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8107,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5872724",
          "text": "Nonostante tutti i suoi difetti, lui mi piace.",
          "translation": "Несмотря на все его недостатки, он мне нравится.",
          "source": "Tatoeba #5872724 @dnnywld / #4177561 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5872724",
          "cefr_level": "A1",
          "word_slugs": [
            "difetti-noun"
          ]
        },
        {
          "id": "2205752",
          "text": "Ho un grande difetto: trovare difetti negli altri.",
          "translation": "У меня есть один большой недостаток: находить недостатки в других.",
          "source": "Tatoeba #2205752 @miccap / #2507298 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2205752",
          "cefr_level": "A1",
          "word_slugs": [
            "difetti-noun"
          ]
        },
        {
          "id": "7023890",
          "text": "Colui cerca un amico senza difetti resta senza amici.",
          "translation": "Кто ищет друга без недостатков, тот остаётся без друзей.",
          "source": "Tatoeba #7023890 @dnnywld / #7022866 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7023890",
          "cefr_level": "A1",
          "word_slugs": [
            "difetti-noun"
          ]
        },
        {
          "id": "5629719",
          "text": "Forse proprio i tuoi difetti ti rendono così attraente.",
          "translation": "Возможно, именно твои недостатки делают тебя таким привлекательным.",
          "source": "Tatoeba #5629719 @dnnywld / #5628992 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629719",
          "cefr_level": "A1",
          "word_slugs": [
            "difetti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il difetti",
        "plural": "",
        "infinitive": ""
      }
