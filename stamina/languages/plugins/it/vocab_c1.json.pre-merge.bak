    {
      "slug": "trascorrere-verb",
      "lemma": "trascorrere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8575,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6866814",
          "text": "Puoi trascorrere qui la notte.",
          "translation": "Ты можешь переночевать здесь.",
          "source": "Tatoeba #6866814 @dnnywld / #6863199 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866814",
          "cefr_level": "A1",
          "word_slugs": [
