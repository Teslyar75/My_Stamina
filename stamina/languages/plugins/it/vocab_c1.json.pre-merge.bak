    {
      "slug": "indicare-verb",
      "lemma": "indicare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9994,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6944344",
          "text": "Puoi indicare il percorso?",
          "translation": "Покажешь, как ехать?",
          "source": "Tatoeba #6944344 @dnnywld / #6943835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944344",
          "cefr_level": "A1",
          "word_slugs": [
            "indicare-verb"
          ]
        },
        {
          "id": "6944341",
          "text": "Potete indicare il percorso?",
          "translation": "Покажете, как ехать?",
          "source": "Tatoeba #6944341 @dnnywld / #6943836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944341",
          "cefr_level": "A1",
          "word_slugs": [
            "indicare-verb"
          ]
        },
        {
          "id": "5472786",
          "text": "L'abbreviazione \"USA\" sta ad indicare \"Stati Uniti d'America\".",
          "translation": "Сокращение «США» означает «Соединённые Штаты Америки».",
          "source": "Tatoeba #5472786 @dnnywld / #425262 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472786",
          "cefr_level": "A1",
          "word_slugs": [
            "indicare-verb"
          ]
        },
        {
          "id": "5411997",
          "text": "Mi sono persa. Mi sapreste indicare la strada per la stazione?",
          "translation": "Я потерялся. Не могли бы вы указать мне дорогу на вокзал?",
          "source": "Tatoeba #5411997 @dnnywld / #4734626 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5411997",
          "cefr_level": "A1",
          "word_slugs": [
            "indicare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "indicare",
        "plural": "",
        "infinitive": "indicare"
      }
