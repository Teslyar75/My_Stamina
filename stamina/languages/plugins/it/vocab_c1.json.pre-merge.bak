      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2008505",
          "text": "Io sono in soffitta.",
          "translation": "Я на чердаке.",
          "source": "Tatoeba #2008505 @Guybrush88 / #3270150 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2008505",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitta-noun"
          ]
        },
        {
          "id": "6799472",
          "text": "Cosa faceva Tom in soffitta?",
          "translation": "Что Том делал на чердаке?",
          "source": "Tatoeba #6799472 @dnnywld / #6798718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799472",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitta-noun"
          ]
        },
        {
          "id": "5902824",
          "text": "Mi sono nascosto in soffitta.",
          "translation": "Я спрятался на чердаке.",
          "source": "Tatoeba #5902824 @dnnywld / #5902817 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5902824",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitta-noun"
          ]
        },
        {
          "id": "6799473",
          "text": "Cosa ci faceva Tom in soffitta?",
          "translation": "Что Том делал на чердаке?",
          "source": "Tatoeba #6799473 @dnnywld / #6798718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799473",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitta-noun"
          ]
        },
        {
          "id": "5562874",
          "text": "Il gatto sta miagolando in soffitta.",
          "translation": "Кошка мяукает на чердаке.",
          "source": "Tatoeba #5562874 @dnnywld / #5561863 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5562874",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitta-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
