    {
      "slug": "voli-noun",
      "lemma": "voli",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7910,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5405621",
          "text": "Sono stati cancellati parecchi voli.",
          "translation": "Было отменено несколько рейсов.",
          "source": "Tatoeba #5405621 @dnnywld / #5404823 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5405621",
          "cefr_level": "A1",
          "word_slugs": [
            "voli-noun"
          ]
        },
        {
          "id": "3235117",
          "text": "È un film che parla dei voli transcontinentali.",
          "translation": "Это фильм, который рассказывает о трансконтинентальных перелётах.",
          "source": "Tatoeba #3235117 @Guybrush88 / #3235255 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3235117",
          "cefr_level": "A1",
          "word_slugs": [
            "voli-noun"
          ]
        },
        {
          "id": "5455678",
          "text": "Mi interessano solo i voli senza scali intermedi.",
          "translation": "Меня интересуют только беспосадочные рейсы.",
          "source": "Tatoeba #5455678 @dnnywld / #5455129 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5455678",
