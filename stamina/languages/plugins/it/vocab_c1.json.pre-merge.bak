    {
      "slug": "perse-adj",
      "lemma": "perse",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5875,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5624354",
          "text": "Molte vite sono state perse.",
          "translation": "Много жизней оборвалось.",
          "source": "Tatoeba #5624354 @dnnywld / #5622995 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624354",
          "cefr_level": "A1",
          "word_slugs": [
            "perse-adj"
          ]
        },
        {
          "id": "6919537",
          "text": "Tom ci perse velocemente interesse.",
          "translation": "Том быстро потерял к этому интерес.",
          "source": "Tatoeba #6919537 @dnnywld / #6919492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919537",
          "cefr_level": "A1",
          "word_slugs": [
            "perse-adj"
          ]
        },
        {
          "id": "432997",
          "text": "L'uomo perse tutta la speranza.",
          "translation": "Человек потерял всякую надежду.",
          "source": "Tatoeba #432997 @Pharamp / #1678816 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/432997",
          "cefr_level": "A1",
          "word_slugs": [
            "perse-adj"
          ]
        },
        {
          "id": "5607708",
          "text": "Così lui perse tutti i suoi soldi.",
          "translation": "Так он потерял все свои деньги.",
          "source": "Tatoeba #5607708 @dnnywld / #5605989 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607708",
          "cefr_level": "A1",
          "word_slugs": [
            "perse-adj"
          ]
        },
        {
          "id": "5607712",
          "text": "Così lei perse tutti i suoi soldi.",
          "translation": "Так она потеряла все свои деньги.",
          "source": "Tatoeba #5607712 @dnnywld / #5605991 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607712",
          "cefr_level": "A1",
          "word_slugs": [
            "perse-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il perse",
        "plural": "",
        "infinitive": ""
      }
