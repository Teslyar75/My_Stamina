      "frequency_rank": 6578,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5558827",
          "text": "Erano tutti tesi.",
          "translation": "Все были напряжены.",
          "source": "Tatoeba #5558827 @dnnywld / #5558560 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5558827",
          "cefr_level": "A1",
          "word_slugs": [
            "tesi-adj"
          ]
        },
        {
          "id": "10885226",
          "text": "Devo scrivere la tesi.",
          "translation": "Мне надо писать диссертацию.",
          "source": "Tatoeba #10885226 @dnnywld / #5399136 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885226",
          "cefr_level": "A1",
          "word_slugs": [
            "tesi-adj"
          ]
        },
        {
          "id": "5838539",
          "text": "Questo rafforza la mia tesi.",
          "translation": "Это подкрепляет мои доводы.",
          "source": "Tatoeba #5838539 @dnnywld / #3060787 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5838539",
          "cefr_level": "A1",
          "word_slugs": [
            "tesi-adj"
          ]
        },
        {
          "id": "5412725",
          "text": "Tom scrive una tesi di scienze.",
          "translation": "Том пишет дипломную работу по естественным наукам.",
          "source": "Tatoeba #5412725 @dnnywld / #2711602 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5412725",
          "cefr_level": "A1",
          "word_slugs": [
            "tesi-adj"
          ]
        },
        {
          "id": "10885224",
          "text": "A quanto pare, sta scrivendo la tesi.",
          "translation": "Оказалось, он пишет диссертацию.",
          "source": "Tatoeba #10885224 @dnnywld / #540751 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885224",
          "cefr_level": "A1",
          "word_slugs": [
            "tesi-adj"
          ]
        }
      ],
