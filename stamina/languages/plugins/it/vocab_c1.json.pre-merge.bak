        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "570444",
          "text": "Lavare è il mio lavoro.",
          "translation": "Стирка - это моя работа.",
          "source": "Tatoeba #570444 @bruno_b / #2128221 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/570444",
          "cefr_level": "A1",
          "word_slugs": [
            "lavare-verb"
          ]
        },
        {
          "id": "5431758",
          "text": "Dovete ancora lavare i denti!",
          "translation": "Вы должны еще почистить зубы!",
          "source": "Tatoeba #5431758 @dnnywld / #5431610 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5431758",
          "cefr_level": "A1",
          "word_slugs": [
            "lavare-verb"
          ]
        },
        {
          "id": "11402439",
          "text": "Tom si voleva lavare le mani.",
          "translation": "Том хотел помыть руки.",
          "source": "Tatoeba #11402439 @Guybrush88 / #3546605 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11402439",
          "cefr_level": "A1",
          "word_slugs": [
            "lavare-verb"
          ]
        },
        {
          "id": "5632893",
          "text": "Chi vuole lavare la mia macchina?",
          "translation": "Кто хочет помыть мою машину?",
          "source": "Tatoeba #5632893 @dnnywld / #5632842 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632893",
          "cefr_level": "A1",
          "word_slugs": [
            "lavare-verb"
          ]
        },
        {
          "id": "5677878",
          "text": "Dove ci si può lavare le mani?",
          "translation": "Где можно помыть руки?",
          "source": "Tatoeba #5677878 @dnnywld / #5677052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677878",
          "cefr_level": "A1",
          "word_slugs": [
            "lavare-verb"
          ]
        }
      ],
