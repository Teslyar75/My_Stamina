    {
      "slug": "espresso-adj",
      "lemma": "espresso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6392,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6316010",
          "text": "Devo essermi espresso male.",
          "translation": "Я, должно быть, плохо выразился.",
          "source": "Tatoeba #6316010 @dnnywld / #3467844 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6316010",
          "cefr_level": "A1",
          "word_slugs": [
            "espresso-adj"
          ]
        },
        {
          "id": "6950276",
          "text": "Lui ha espresso dei dubbi.",
          "translation": "Он выразил сомнение.",
          "source": "Tatoeba #6950276 @dnnywld / #6911404 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950276",
          "cefr_level": "A1",
          "word_slugs": [
            "espresso-adj"
          ]
        },
        {
          "id": "6924242",
          "text": "Posso avere un doppio espresso?",
          "translation": "Можно мне двойной эспрессо?",
          "source": "Tatoeba #6924242 @dnnywld / #5639184 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6924242",
          "cefr_level": "A1",
          "word_slugs": [
            "espresso-adj"
          ]
        },
        {
          "id": "5528820",
          "text": "Mi sono espresso in modo chiaro?",
          "translation": "Я понятно выразился?",
          "source": "Tatoeba #5528820 @dnnywld / #3985780 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5528820",
          "cefr_level": "A1",
          "word_slugs": [
            "espresso-adj"
          ]
        },
        {
          "id": "12426145",
          "text": "Tom si è espresso in modo fumoso.",
          "translation": "Том выражался туманно.",
          "source": "Tatoeba #12426145 @dnnywld / #4641461 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12426145",
          "cefr_level": "A1",
          "word_slugs": [
            "espresso-adj"
          ]
        }
      ],
      "tags": [
