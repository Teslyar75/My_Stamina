    {
      "slug": "cugini-noun",
      "lemma": "cugini",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8232,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1634327",
          "text": "Noi siamo cugini.",
          "translation": "Мы двоюродные братья.",
          "source": "Tatoeba #1634327 @Guybrush88 / #2753374 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1634327",
          "cefr_level": "A1",
          "word_slugs": [
            "cugini-noun"
          ]
        },
        {
          "id": "5526834",
          "text": "Tu e Tom siete cugini?",
          "translation": "Вы с Томом двоюродные братья?",
          "source": "Tatoeba #5526834 @dnnywld / #5525896 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5526834",
          "cefr_level": "A1",
          "word_slugs": [
            "cugini-noun"
          ]
        },
        {
          "id": "5526835",
          "text": "Io e Tom siamo cugini.",
          "translation": "Мы с Томом двоюродные братья.",
          "source": "Tatoeba #5526835 @dnnywld / #5525879 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5526835",
          "cefr_level": "A1",
          "word_slugs": [
            "cugini-noun"
          ]
        },
        {
          "id": "5512777",
          "text": "Se ricordo bene, loro sono cugini.",
          "translation": "Если я правильно помню, они двоюродные братья.",
          "source": "Tatoeba #5512777 @dnnywld / #5512696 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512777",
          "cefr_level": "A1",
          "word_slugs": [
            "cugini-noun"
          ]
        },
        {
          "id": "399821",
          "text": "Ho tre cugini da parte di mia madre.",
          "translation": "У меня есть три двоюродных брата по материнской линии.",
          "source": "Tatoeba #399821 @Pharamp / #1336723 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399821",
          "cefr_level": "A1",
          "word_slugs": [
            "cugini-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
