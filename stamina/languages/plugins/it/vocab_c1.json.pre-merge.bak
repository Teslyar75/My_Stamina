    {
      "slug": "critico-adj",
      "lemma": "critico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8046,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5624319",
          "text": "Prova a guardarti con spirito critico.",
          "translation": "Попытайся взглянуть на себя критически.",
          "source": "Tatoeba #5624319 @dnnywld / #5623458 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624319",
          "cefr_level": "A1",
          "word_slugs": [
            "critico-adj"
          ]
        },
        {
          "id": "2452516",
