    {
      "slug": "avvertire-verb",
      "lemma": "avvertire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7364,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5494142",
          "text": "È andato via senza avvertire nessuno.",
          "translation": "Он уехал, никого не предупредив.",
          "source": "Tatoeba #5494142 @dnnywld / #5493831 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494142",
          "cefr_level": "A1",
          "word_slugs": [
            "avvertire-verb"
          ]
        },
        {
          "id": "5494143",
          "text": "È andato via senza avvertire i genitori.",
          "translation": "Он уехал, не предупредив родителей.",
          "source": "Tatoeba #5494143 @dnnywld / #5493830 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494143",
          "cefr_level": "A1",
          "word_slugs": [
            "avvertire-verb"
          ]
        },
        {
          "id": "5419455",
          "text": "Gli squali possono avvertire l'odore del sangue.",
          "translation": "Акулы могут чувствовать кровь.",
          "source": "Tatoeba #5419455 @dnnywld / #2493887 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419455",
          "cefr_level": "A1",
          "word_slugs": [
            "avvertire-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "avvertire",
        "plural": "",
        "infinitive": "avvertire"
      }
