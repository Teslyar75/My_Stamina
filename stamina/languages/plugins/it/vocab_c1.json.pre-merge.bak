          ]
        },
        {
          "id": "5529733",
          "text": "So che Tom sente nostalgia per voi.",
          "translation": "Я знаю, что Том по вам скучает.",
          "source": "Tatoeba #5529733 @dnnywld / #5529067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5529733",
          "cefr_level": "A1",
          "word_slugs": [
            "nostalgia-noun"
          ]
        },
        {
          "id": "10792347",
          "text": "Dev'essere che senti nostalgia di casa.",
          "translation": "Ты, должно быть, скучаешь по дому.",
          "source": "Tatoeba #10792347 @dnnywld / #8139819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10792347",
          "cefr_level": "A1",
