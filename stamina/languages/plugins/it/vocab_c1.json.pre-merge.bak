      "frequency_rank": 5610,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5614083",
          "text": "L'ho incontrata.",
          "translation": "Я встретил ее.",
          "source": "Tatoeba #5614083 @dnnywld / #5612997 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614083",
          "cefr_level": "A1",
          "word_slugs": [
            "incontrata-verb"
          ]
        },
        {
          "id": "984072",
          "text": "Quando l'hai incontrata?",
          "translation": "Когда ты его встретила?",
          "source": "Tatoeba #984072 @Guybrush88 / #6941683 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/984072",
          "cefr_level": "A1",
          "word_slugs": [
            "incontrata-verb"
          ]
        },
        {
          "id": "806742",
          "text": "L'ho incontrata per caso.",
          "translation": "Я встретил её случайно.",
          "source": "Tatoeba #806742 @Guybrush88 / #2318674 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/806742",
          "cefr_level": "A1",
          "word_slugs": [
            "incontrata-verb"
          ]
        },
        {
          "id": "2059909",
          "text": "Forse l'hai incontrata lì?",
          "translation": "Может быть, вы встречали ее там?",
          "source": "Tatoeba #2059909 @al_ex_an_der / #2059904 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2059909",
          "cefr_level": "A1",
          "word_slugs": [
            "incontrata-verb"
          ]
        },
        {
          "id": "10685863",
          "text": "Un giorno l'ho incontrata.",
          "translation": "Однажды я её встретил.",
          "source": "Tatoeba #10685863 @carlosalberto / #10684654 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10685863",
          "cefr_level": "A1",
          "word_slugs": [
            "incontrata-verb"
          ]
        }
      ],
