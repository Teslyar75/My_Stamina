            "ebbe-verb"
          ]
        },
        {
          "id": "2823109",
          "text": "Tom ebbe un crollo nervoso.",
          "translation": "У Тома был нервный срыв.",
          "source": "Tatoeba #2823109 @Guybrush88 / #3290222 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2823109",
          "cefr_level": "A1",
          "word_slugs": [
