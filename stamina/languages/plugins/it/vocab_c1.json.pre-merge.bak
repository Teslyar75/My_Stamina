    {
      "slug": "altrui-adj",
      "lemma": "altrui",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8875,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5688464",
          "text": "Rispettate il sonno altrui.",
          "translation": "Уважайте чужой сон.",
          "source": "Tatoeba #5688464 @dnnywld / #4633634 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688464",
          "cefr_level": "A1",
          "word_slugs": [
            "altrui-adj"
          ]
        },
        {
          "id": "11463008",
          "text": "Non mettere il naso nei pettegolezzi altrui.",
          "translation": "Не суй свой нос в чужие дела.",
          "source": "Tatoeba #11463008 @Bernie75 / #3945920 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11463008",
          "cefr_level": "A1",
          "word_slugs": [
            "altrui-adj"
          ]
        },
        {
          "id": "6951766",
          "text": "Pensi che riusciremo a farlo senza aiuto altrui?",
          "translation": "Думаешь, мы сможем это сделать без посторонней помощи?",
          "source": "Tatoeba #6951766 @dnnywld / #6950892 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6951766",
          "cefr_level": "A1",
          "word_slugs": [
            "altrui-adj"
          ]
        },
        {
          "id": "6951764",
          "text": "Pensate che riusciremo a farlo senza aiuto altrui?",
          "translation": "Думаете, мы сможем это сделать без посторонней помощи?",
          "source": "Tatoeba #6951764 @dnnywld / #6950893 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6951764",
          "cefr_level": "A1",
          "word_slugs": [
