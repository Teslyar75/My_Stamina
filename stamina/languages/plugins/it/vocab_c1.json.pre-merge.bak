          "word_slugs": [
            "chilo-noun"
          ]
        },
        {
          "id": "5673347",
          "text": "Quanto costa un chilo di mele?",
          "translation": "Почём кило яблок?",
          "source": "Tatoeba #5673347 @dnnywld / #5672760 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5673347",
          "cefr_level": "A1",
          "word_slugs": [
            "chilo-noun"
          ]
        },
        {
          "id": "5486512",
          "text": "Tom pesa qualche chilo più di Mary.",
          "translation": "Том на несколько фунтов тяжелее Мэри.",
          "source": "Tatoeba #5486512 @dnnywld / #5485120 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5486512",
          "cefr_level": "A1",
          "word_slugs": [
            "chilo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
