    {
      "slug": "rimaste-verb",
      "lemma": "rimaste",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7612,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6952003",
          "text": "Sono rimaste le formalità.",
          "translation": "Остались формальности.",
          "source": "Tatoeba #6952003 @dnnywld / #6706321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952003",
          "cefr_level": "A1",
          "word_slugs": [
            "rimaste-verb"
          ]
        },
        {
          "id": "6952162",
          "text": "Ve ne sono rimaste così?",
          "translation": "У вас такие ещё остались?",
          "source": "Tatoeba #6952162 @dnnywld / #4989435 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952162",
          "cefr_level": "A1",
          "word_slugs": [
            "rimaste-verb"
          ]
        },
        {
          "id": "6004616",
          "text": "Tredici persone sono rimaste ferite.",
          "translation": "Тринадцать человек получили ранения.",
          "source": "Tatoeba #6004616 @dnnywld / #6004297 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6004616",
          "cefr_level": "A1",
          "word_slugs": [
            "rimaste-verb"
          ]
        },
        {
          "id": "6952043",
          "text": "A Tom sono rimaste delle domande.",
          "translation": "У Тома остались вопросы.",
          "source": "Tatoeba #6952043 @dnnywld / #4748182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952043",
          "cefr_level": "A1",
          "word_slugs": [
            "rimaste-verb"
          ]
        },
        {
          "id": "5474878",
          "text": "Sono rimaste ferite soltanto tre persone.",
          "translation": "Пострадало только три человека.",
          "source": "Tatoeba #5474878 @dnnywld / #5474747 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5474878",
          "cefr_level": "A1",
          "word_slugs": [
            "rimaste-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
