      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5637447",
          "text": "Fermate il treno.",
          "translation": "Остановите поезд.",
          "source": "Tatoeba #5637447 @dnnywld / #5637234 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5637447",
          "cefr_level": "A1",
