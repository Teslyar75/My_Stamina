    {
      "slug": "artificio-noun",
      "lemma": "artificio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8221,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5419201",
          "text": "Andiamo a vedere i fuochi d'artificio?",
          "translation": "Салют смотреть пойдём?",
          "source": "Tatoeba #5419201 @dnnywld / #4447041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419201",
          "cefr_level": "A1",
          "word_slugs": [
            "artificio-noun"
          ]
        },
        {
          "id": "5512998",
          "text": "I fuochi d'artificio sono stati grandiosi.",
          "translation": "Салют был грандиозный.",
          "source": "Tatoeba #5512998 @dnnywld / #5512505 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512998",
          "cefr_level": "A1",
          "word_slugs": [
            "artificio-noun"
          ]
        },
        {
          "id": "11011744",
          "text": "Il 4 luglio abbiamo visto i fuochi di artificio.",
          "translation": "Четвёртого июля мы смотрели салют.",
          "source": "Tatoeba #11011744 @dnnywld / #11011679 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11011744",
          "cefr_level": "A1",
          "word_slugs": [
            "artificio-noun"
          ]
        },
        {
          "id": "6879397",
          "text": "Tom e Mary hanno guardato i fuochi d'artificio insieme.",
          "translation": "Том и Мэри вместе смотрели салют.",
          "source": "Tatoeba #6879397 @dnnywld / #6879056 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879397",
          "cefr_level": "A1",
          "word_slugs": [
            "artificio-noun"
          ]
        },
        {
          "id": "7610936",
          "text": "Tom e Mary sono usciti a vedere i fuochi d'artificio.",
          "translation": "Том и Мэри вышли посмотреть фейерверк.",
          "source": "Tatoeba #7610936 @dnnywld / #7610424 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7610936",
          "cefr_level": "A1",
          "word_slugs": [
            "artificio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
