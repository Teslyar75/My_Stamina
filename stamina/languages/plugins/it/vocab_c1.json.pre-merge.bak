    {
      "slug": "sentiero-noun",
      "lemma": "sentiero",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5426,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5734593",
          "text": "Tom vide un serpente strisciare sul sentiero.",
          "translation": "Том увидел, как тропинку переползает змея.",
          "source": "Tatoeba #5734593 @dnnywld / #5732156 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5734593",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiero-noun"
          ]
        },
        {
          "id": "10878730",
          "text": "Il sentiero per il giardino è cosparso di sabbia.",
          "translation": "Дорожка в сад посыпана гравием.",
          "source": "Tatoeba #10878730 @dnnywld / #6771775 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878730",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiero-noun"
          ]
        },
        {
          "id": "2435851",
          "text": "Il sentiero nella foresta era completamente coperto di neve.",
          "translation": "Лесная дорога была сплошь покрыта снегом.",
          "source": "Tatoeba #2435851 @al_ex_an_der / #2410997 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2435851",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiero-noun"
          ]
        },
        {
          "id": "2435170",
          "text": "Il sentiero della foresta è stato completamente coperto di neve.",
          "translation": "Лесная тропинка была полностью покрыта снегом.",
          "source": "Tatoeba #2435170 @al_ex_an_der / #2435160 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2435170",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiero-noun"
          ]
        },
        {
          "id": "10752139",
          "text": "Questo sentiero dopo la pioggia normalmente è ricoperto di fango.",
          "translation": "Этот путь после дождя обычно в грязи.",
          "source": "Tatoeba #10752139 @dnnywld / #445818 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10752139",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiero-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il sentiero",
        "plural": "",
        "infinitive": ""
      }
