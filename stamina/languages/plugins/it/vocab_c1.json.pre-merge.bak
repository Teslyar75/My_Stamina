    {
      "slug": "aiuterò-verb",
      "lemma": "aiuterò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6928,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5974471",
          "text": "Aiuterò i miei amici.",
          "translation": "Я помогу своим друзьям.",
          "source": "Tatoeba #5974471 @dnnywld / #4439275 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5974471",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterò-verb"
          ]
        },
        {
          "id": "1949039",
          "text": "Prometto che ti aiuterò.",
          "translation": "Обещаю, что помогу тебе.",
          "source": "Tatoeba #1949039 @Guybrush88 / #2112920 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1949039",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterò-verb"
          ]
        },
        {
          "id": "5549111",
          "text": "Aiuterò come meglio potrò.",
          "translation": "Я буду помогать изо всех сил.",
          "source": "Tatoeba #5549111 @dnnywld / #1383543 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549111",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterò-verb"
          ]
        },
        {
          "id": "6680226",
          "text": "Aiuterò, se Tom lo vorrà.",
          "translation": "Я бы помог, если бы Том этого захотел.",
          "source": "Tatoeba #6680226 @dnnywld / #6680211 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6680226",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterò-verb"
          ]
        },
        {
          "id": "5527014",
          "text": "Rimarrò qui e aiuterò Tom.",
          "translation": "Я останусь здесь и помогу Тому.",
          "source": "Tatoeba #5527014 @dnnywld / #3476212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527014",
          "cefr_level": "A1",
          "word_slugs": [
            "aiuterò-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "aiuterò",
        "plural": "",
        "infinitive": "aiuterò"
      }
    },
    {
      "slug": "finendo-verb",
