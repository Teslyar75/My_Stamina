      "examples": [
        {
          "id": "2211367",
          "text": "Lava la macchina.",
          "translation": "Помой машину.",
          "source": "Tatoeba #2211367 @Guybrush88 / #3211429 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2211367",
          "cefr_level": "A1",
