    {
      "slug": "sostituito-adj",
      "lemma": "sostituito",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9443,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6923244",
          "text": "Per qualche motivo non l'hanno sostituito subito.",
          "translation": "Почему-то его заметили не сразу.",
          "source": "Tatoeba #6923244 @dnnywld / #6923135 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6923244",
          "cefr_level": "A1",
          "word_slugs": [
            "sostituito-adj"
          ]
        },
        {
          "id": "6923242",
          "text": "Perché non hanno sostituito subito la parte difettosa?",
          "translation": "Почему неисправную деталь сразу не заменили?",
          "source": "Tatoeba #6923242 @dnnywld / #6923139 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6923242",
          "cefr_level": "A1",
          "word_slugs": [
            "sostituito-adj"
          ]
        },
        {
          "id": "10885163",
          "text": "Hanno sostituito il televisore difettoso con uno nuovo.",
          "translation": "Они заменили дефектный телевизор новым.",
          "source": "Tatoeba #10885163 @dnnywld / #3685260 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885163",
          "cefr_level": "A1",
          "word_slugs": [
            "sostituito-adj"
          ]
        },
        {
          "id": "5476890",
          "text": "Bene, come sarebbe? Tom è malato, chi lo ha sostituito?",
          "translation": "Ну, как теперь быть? Том заболел, кто его заменит?",
          "source": "Tatoeba #5476890 @dnnywld / #5475792 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476890",
          "cefr_level": "A1",
          "word_slugs": [
            "sostituito-adj"
          ]
        },
        {
          "id": "6923241",
          "text": "Non è chiaro il motivo per cui non è stato subito sostituito.",
          "translation": "Непонятно, почему его сразу не заменили.",
          "source": "Tatoeba #6923241 @dnnywld / #6923140 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6923241",
          "cefr_level": "A1",
          "word_slugs": [
            "sostituito-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il sostituito",
        "plural": "",
        "infinitive": ""
      }
    },
