            "cercheremo-verb"
          ]
        },
        {
          "id": "6892049",
          "text": "Cercheremo di fare una buona impressione.",
          "translation": "Мы постараемся произвести хорошее впечатление.",
          "source": "Tatoeba #6892049 @dnnywld / #6031907 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6892049",
          "cefr_level": "A1",
          "word_slugs": [
            "cercheremo-verb"
          ]
        },
        {
          "id": "7451749",
          "text": "Cercheremo di rispondere alle domande successive.",
          "translation": "Мы постараемся ответить на следующие вопросы.",
          "source": "Tatoeba #7451749 @dnnywld / #7451371 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7451749",
