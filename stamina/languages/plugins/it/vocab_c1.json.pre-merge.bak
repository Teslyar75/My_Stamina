    {
      "slug": "finite-adj",
      "lemma": "finite",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5546,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1546530",
          "text": "Le mele sono finite.",
          "translation": "Яблоки закончились.",
          "source": "Tatoeba #1546530 @Vy / #3121040 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1546530",
          "cefr_level": "A1",
          "word_slugs": [
            "finite-adj"
          ]
        },
        {
          "id": "10805523",
          "text": "Le cose sono finite in rissa.",
          "translation": "Дело дошло до драки.",
          "source": "Tatoeba #10805523 @dnnywld / #6175940 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10805523",
          "cefr_level": "A1",
          "word_slugs": [
            "finite-adj"
          ]
        },
        {
          "id": "6866894",
          "text": "Finite di fare colazione velocemente, forza.",
          "translation": "Давайте быстрей доедайте завтрак.",
          "source": "Tatoeba #6866894 @dnnywld / #6570957 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866894",
          "cefr_level": "A1",
          "word_slugs": [
            "finite-adj"
          ]
        },
        {
          "id": "6883396",
          "text": "Finite di scrivere e consegnate il lavoro.",
          "translation": "Дописывайте и сдавайте работы.",
          "source": "Tatoeba #6883396 @dnnywld / #6883360 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883396",
          "cefr_level": "A1",
          "word_slugs": [
            "finite-adj"
          ]
        },
        {
          "id": "6853084",
          "text": "Finite i compiti nel mentre che loro ritornano.",
          "translation": "Доделайте уроки к тому времени, как они вернутся.",
          "source": "Tatoeba #6853084 @dnnywld / #6851886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853084",
          "cefr_level": "A1",
          "word_slugs": [
            "finite-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il finite",
        "plural": "",
        "infinitive": ""
      }
    },
