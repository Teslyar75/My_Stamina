      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5662283",
          "text": "Tom lavora nell'archivio della città.",
          "translation": "Том работает в городском архиве.",
          "source": "Tatoeba #5662283 @dnnywld / #5661051 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662283",
          "cefr_level": "A1",
          "word_slugs": [
            "archivio-noun"
          ]
        },
        {
          "id": "5662265",
          "text": "Tom passava il giorno in archivio, e la sera scriveva articoli.",
          "translation": "Том проводил дни в архиве, а вечерами писал статьи.",
          "source": "Tatoeba #5662265 @dnnywld / #5661110 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662265",
