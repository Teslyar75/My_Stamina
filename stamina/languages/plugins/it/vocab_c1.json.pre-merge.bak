          "cefr_level": "A1",
          "word_slugs": [
            "aspetterò-verb"
          ]
        },
        {
          "id": "8254132",
          "text": "Vi aspetterò di spora.",
          "translation": "Я вас внизу подожду.",
          "source": "Tatoeba #8254132 @dnnywld / #7778654 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8254132",
          "cefr_level": "A1",
          "word_slugs": [
            "aspetterò-verb"
          ]
        },
        {
          "id": "5388159",
          "text": "Ti aspetterò in macchina.",
          "translation": "Я тебя в машине подожду.",
          "source": "Tatoeba #5388159 @dnnywld / #5387906 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388159",
          "cefr_level": "A1",
