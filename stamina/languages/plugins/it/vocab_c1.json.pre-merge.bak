    {
      "slug": "costoso-adj",
      "lemma": "costoso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5484,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2714663",
          "text": "È molto costoso.",
          "translation": "Это очень дорого.",
          "source": "Tatoeba #2714663 @Guybrush88 / #1561612 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2714663",
          "cefr_level": "A1",
          "word_slugs": [
            "costoso-adj"
          ]
        },
        {
          "id": "2052946",
          "text": "È troppo costoso!",
          "translation": "Это слишком дорого!",
          "source": "Tatoeba #2052946 @Guybrush88 / #5641 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2052946",
          "cefr_level": "A1",
          "word_slugs": [
            "costoso-adj"
          ]
        },
        {
          "id": "5964793",
          "text": "È piuttosto costoso.",
          "translation": "Он довольно дорогой.",
          "source": "Tatoeba #5964793 @dnnywld / #5964739 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964793",
          "cefr_level": "A1",
          "word_slugs": [
            "costoso-adj"
          ]
        },
        {
          "id": "5662175",
          "text": "Che pianoforte costoso!",
          "translation": "Какое дорогое пианино!",
          "source": "Tatoeba #5662175 @dnnywld / #5661312 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662175",
          "cefr_level": "A1",
          "word_slugs": [
            "costoso-adj"
          ]
        },
        {
          "id": "2486123",
          "text": "È terribilmente costoso.",
          "translation": "Это ужасно дорого.",
          "source": "Tatoeba #2486123 @Guybrush88 / #2526215 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2486123",
          "cefr_level": "A1",
          "word_slugs": [
            "costoso-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il costoso",
        "plural": "",
        "infinitive": ""
      }
