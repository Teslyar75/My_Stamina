    {
      "slug": "abituati-verb",
      "lemma": "abituati",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9445,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5926343",
          "text": "Abituati a questo, Tom.",
          "translation": "Привыкай к этому, Том.",
          "source": "Tatoeba #5926343 @dnnywld / #3603174 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5926343",
          "cefr_level": "A1",
          "word_slugs": [
            "abituati-verb"
          ]
        },
        {
          "id": "6702630",
          "text": "Abituati a dir di no.",
          "translation": "Привыкай говорить нет.",
          "source": "Tatoeba #6702630 @dnnywld / #6700881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6702630",
          "cefr_level": "A1",
          "word_slugs": [
            "abituati-verb"
          ]
        },
        {
          "id": "6841335",
          "text": "Noi non ci siamo abituati.",
          "translation": "Мы к такому не привыкли.",
          "source": "Tatoeba #6841335 @dnnywld / #6840905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841335",
          "cefr_level": "A1",
          "word_slugs": [
            "abituati-verb"
          ]
        },
        {
          "id": "5926341",
          "text": "La vita è ingiusta. Abituati.",
          "translation": "Жизнь несправедлива. Привыкай.",
          "source": "Tatoeba #5926341 @dnnywld / #4960476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5926341",
          "cefr_level": "A1",
          "word_slugs": [
            "abituati-verb"
          ]
        },
        {
          "id": "6841333",
          "text": "Ci siamo a abituati a tutto.",
          "translation": "Мы ко всему привыкли.",
          "source": "Tatoeba #6841333 @dnnywld / #6840907 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841333",
          "cefr_level": "A1",
          "word_slugs": [
            "abituati-verb"
          ]
        }
      ],
      "tags": [
