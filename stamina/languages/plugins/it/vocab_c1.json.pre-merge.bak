    {
      "slug": "considera-verb",
      "lemma": "considera",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6633,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8868548",
          "text": "Considera questo un ordine.",
          "translation": "Считай, что это приказ.",
          "source": "Tatoeba #8868548 @carlosalberto / #8867977 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8868548",
          "cefr_level": "A1",
          "word_slugs": [
            "considera-verb"
          ]
        },
        {
          "id": "6953716",
          "text": "Lui si considera un grande poeta.",
          "translation": "Он считает себя большим поэтом.",
          "source": "Tatoeba #6953716 @dnnywld / #3533743 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953716",
          "cefr_level": "A1",
          "word_slugs": [
            "considera-verb"
          ]
        },
        {
          "id": "6947372",
          "text": "Tom dice che considera Mary bella.",
          "translation": "Том говорит, что считает Мэри красивой.",
          "source": "Tatoeba #6947372 @dnnywld / #6947253 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6947372",
          "cefr_level": "A1",
          "word_slugs": [
            "considera-verb"
          ]
        },
        {
          "id": "6924146",
          "text": "Mia madre mi considera un bugiardo.",
          "translation": "Мать считает меня лжецом.",
          "source": "Tatoeba #6924146 @dnnywld / #6923976 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6924146",
          "cefr_level": "A1",
          "word_slugs": [
            "considera-verb"
          ]
        },
        {
          "id": "6946047",
          "text": "Tom si considera meglio degli altri.",
          "translation": "Том считает себя лучше других.",
          "source": "Tatoeba #6946047 @dnnywld / #6945409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6946047",
          "cefr_level": "A1",
          "word_slugs": [
            "considera-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
