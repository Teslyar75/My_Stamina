      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5529696",
          "text": "Sei un profeta?",
          "translation": "Ты пророк?",
          "source": "Tatoeba #5529696 @dnnywld / #5529350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5529696",
          "cefr_level": "A1",
          "word_slugs": [
            "profeta-noun"
          ]
        },
        {
          "id": "5529695",
          "text": "Siete un profeta?",
          "translation": "Вы пророк?",
          "source": "Tatoeba #5529695 @dnnywld / #5529351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5529695",
          "cefr_level": "A1",
          "word_slugs": [
            "profeta-noun"
          ]
        },
        {
          "id": "5402398",
          "text": "Se la montagna non va dal profeta, il profeta va alla montagna.",
          "translation": "Если гора не идёт к пророку, пророк идёт к горе.",
          "source": "Tatoeba #5402398 @dnnywld / #2983860 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5402398",
          "cefr_level": "A1",
          "word_slugs": [
            "profeta-noun"
          ]
        },
        {
          "id": "5591812",
          "text": "I musulmani considerano Allah l'unico Dio, e Maometto l'ultimo profeta.",
          "translation": "Мусульмане считают Аллаха единственным Богом, а Мухаммеда — последним пророком.",
          "source": "Tatoeba #5591812 @dnnywld / #5591528 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591812",
          "cefr_level": "A1",
          "word_slugs": [
            "profeta-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
