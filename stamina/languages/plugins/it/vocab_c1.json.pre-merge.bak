    {
      "slug": "giugno-noun",
      "lemma": "giugno",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5192,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "июнь"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "10814750",
          "text": "Partiamo l'undici giugno.",
          "translation": "Мы уезжаем одиннадцатого июня.",
          "source": "Tatoeba #10814750 @carlosalberto / #10814823 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10814750",
          "cefr_level": "A1",
          "word_slugs": [
            "giugno-noun"
          ]
        },
        {
          "id": "3664046",
          "text": "Lui arriverà il 24 giugno.",
          "translation": "Он приедет двадцать четвёртого июня.",
          "source": "Tatoeba #3664046 @Guybrush88 / #2448322 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3664046",
          "cefr_level": "A1",
          "word_slugs": [
            "giugno-noun"
          ]
        },
        {
          "id": "5661234",
          "text": "Torneremo in Europa in giugno!",
          "translation": "Мы вернёмся в Европу в июне!",
          "source": "Tatoeba #5661234 @dnnywld / #5661219 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5661234",
          "cefr_level": "A1",
          "word_slugs": [
            "giugno-noun"
          ]
        },
        {
          "id": "4667288",
          "text": "Generalmente in giugno qui piove poco.",
          "translation": "Обычно в июне здесь бывает мало дождей.",
          "source": "Tatoeba #4667288 @madriot / #5205211 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4667288",
          "cefr_level": "A1",
          "word_slugs": [
            "giugno-noun"
          ]
        },
        {
          "id": "10812191",
          "text": "I primi giorni di giugno sono stati caldi.",
          "translation": "Первые дни июня были жаркими.",
          "source": "Tatoeba #10812191 @dnnywld / #6549924 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10812191",
          "cefr_level": "A1",
          "word_slugs": [
            "giugno-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il giugno",
        "plural": "",
        "infinitive": ""
      }
