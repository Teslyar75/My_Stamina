    {
      "slug": "civiltà-noun",
      "lemma": "civiltà",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8474,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6051726",
          "text": "Si tratta di una civiltà altamente sviluppata.",
          "translation": "Это высокоразвитая цивилизация.",
          "source": "Tatoeba #6051726 @dnnywld / #6050960 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6051726",
          "cefr_level": "A1",
          "word_slugs": [
            "civiltà-noun"
          ]
        },
        {
          "id": "5622307",
          "text": "Gli antichi egizi erano molto saggi e crearono una civiltà.",
          "translation": "Древние египтяне были очень мудрыми и создали цивилизацию.",
          "source": "Tatoeba #5622307 @dnnywld / #5622105 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5622307",
          "cefr_level": "A1",
          "word_slugs": [
            "civiltà-noun"
          ]
        },
        {
          "id": "6943113",
          "text": "Chi non sa cosa sia la civiltà deve necessariamente leggere questo libro.",
          "translation": "Кто не знает, что такое цивилизация, должен обязательно прочитать эту книгу.",
          "source": "Tatoeba #6943113 @dnnywld / #6941750 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6943113",
          "cefr_level": "A1",
          "word_slugs": [
            "civiltà-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la civiltà",
        "plural": "",
        "infinitive": ""
      }
    },
