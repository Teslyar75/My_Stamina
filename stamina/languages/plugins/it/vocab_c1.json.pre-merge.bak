          ]
        },
        {
          "id": "6067356",
          "text": "Tom ha disegnato un cane.",
          "translation": "Том нарисовал собаку.",
          "source": "Tatoeba #6067356 @dnnywld / #6067168 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6067356",
