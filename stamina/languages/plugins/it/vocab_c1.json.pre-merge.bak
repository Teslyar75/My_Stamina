    {
      "slug": "conoscenze-noun",
      "lemma": "conoscenze",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6586,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5536722",
          "text": "Nessuno ha conoscenze in Australia?",
          "translation": "Ни у кого нет знакомых в Австралии?",
          "source": "Tatoeba #5536722 @dnnywld / #5536704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5536722",
          "cefr_level": "A1",
          "word_slugs": [
            "conoscenze-noun"
          ]
        },
        {
          "id": "5705973",
          "text": "Non mi piace fare nuove conoscenze.",
          "translation": "Я не люблю заводить новые знакомства.",
          "source": "Tatoeba #5705973 @dnnywld / #5705707 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5705973",
          "cefr_level": "A1",
          "word_slugs": [
            "conoscenze-noun"
          ]
        },
        {
          "id": "6872177",
          "text": "Lui non ha conoscenze e tanto meno esperienza.",
          "translation": "У него нет знаний, тем более, нет опыта.",
          "source": "Tatoeba #6872177 @dnnywld / #1807749 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6872177",
          "cefr_level": "A1",
          "word_slugs": [
            "conoscenze-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la conoscenze",
        "plural": "",
        "infinitive": ""
      }
