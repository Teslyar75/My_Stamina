    {
      "slug": "intendete-verb",
      "lemma": "intendete",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9276,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6795947",
          "text": "Cosa intendete dire?",
          "translation": "Что вы имеете в виду?",
          "source": "Tatoeba #6795947 @dnnywld / #6794110 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6795947",
          "cefr_level": "A1",
          "word_slugs": [
            "intendete-verb"
          ]
        },
        {
          "id": "6009565",
          "text": "Come intendete dimostrarlo?",
          "translation": "Как вы собираетесь это доказывать?",
          "source": "Tatoeba #6009565 @dnnywld / #6007569 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009565",
          "cefr_level": "A1",
          "word_slugs": [
            "intendete-verb"
          ]
        },
        {
          "id": "6847415",
          "text": "Dite loro cosa intendete.",
          "translation": "Скажите им, что вы имеете в виду.",
          "source": "Tatoeba #6847415 @dnnywld / #4838607 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6847415",
          "cefr_level": "A1",
          "word_slugs": [
            "intendete-verb"
          ]
        },
        {
          "id": "5668425",
          "text": "Cosa intendete per libertà?",
          "translation": "Что вы понимаете под свободой?",
          "source": "Tatoeba #5668425 @dnnywld / #5667814 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5668425",
          "cefr_level": "A1",
          "word_slugs": [
            "intendete-verb"
          ]
        },
        {
          "id": "5499577",
          "text": "Cosa intendete fare con lei?",
          "translation": "Что вы намереваетесь с ней делать?",
          "source": "Tatoeba #5499577 @dnnywld / #3501078 @awiz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499577",
          "cefr_level": "A1",
          "word_slugs": [
            "intendete-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "intendete",
        "plural": "",
        "infinitive": "intendete"
      }
    },
