    },
    {
      "slug": "aspettavamo-verb",
      "lemma": "aspettavamo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8414,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5612003",
          "text": "Non ci aspettavamo che questo accadesse.",
          "translation": "Мы не ожидали, что это случится.",
          "source": "Tatoeba #5612003 @dnnywld / #5611841 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5612003",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettavamo-verb"
          ]
        },
        {
          "id": "5462145",
          "text": "Non ci aspettavamo che comprassero una nuova macchina.",
          "translation": "Мы не ожидали, что они купят новую машину.",
          "source": "Tatoeba #5462145 @dnnywld / #5461323 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5462145",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettavamo-verb"
          ]
        },
        {
          "id": "5665328",
          "text": "Tom ha fatto quello che non ci aspettavamo da lui.",
          "translation": "Том сделал то, что мы от него ожидали.",
          "source": "Tatoeba #5665328 @dnnywld / #5664691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5665328",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettavamo-verb"
          ]
        },
        {
          "id": "6882736",
          "text": "Lui è arrivato ieri, ma noi lo aspettavamo soltanto oggi.",
          "translation": "Он приехал вчера, а мы ждали его только сегодня.",
          "source": "Tatoeba #6882736 @dnnywld / #6882733 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6882736",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettavamo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "aspettavamo",
        "plural": "",
        "infinitive": "aspettavamo"
      }
