    {
      "slug": "novembre-noun",
      "lemma": "novembre",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5738,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "ноябрь"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6894790",
          "text": "Sono nata il 22 novembre del 1948.",
          "translation": "Я родилась 22 ноября 1948 года.",
          "source": "Tatoeba #6894790 @dnnywld / #6894611 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6894790",
          "cefr_level": "A1",
          "word_slugs": [
            "novembre-noun"
          ]
        },
        {
          "id": "374043",
          "text": "Il mio compleanno è in novembre.",
          "translation": "Мой день рождения в ноябре.",
          "source": "Tatoeba #374043 @Pharamp / #3632253 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/374043",
          "cefr_level": "A1",
          "word_slugs": [
            "novembre-noun"
          ]
        },
        {
          "id": "10843905",
          "text": "Il trattato fu firmato il 18 Novembre 1903.",
          "translation": "Договор был подписан 18 ноября 1903 года.",
          "source": "Tatoeba #10843905 @dnnywld / #7094097 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10843905",
          "cefr_level": "A1",
          "word_slugs": [
            "novembre-noun"
          ]
        },
        {
          "id": "5777550",
          "text": "È meglio viaggiare in giugno che in novembre.",
          "translation": "В июне путешествовать лучше, чем в ноябре.",
          "source": "Tatoeba #5777550 @dnnywld / #5777516 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5777550",
          "cefr_level": "A1",
          "word_slugs": [
            "novembre-noun"
          ]
        },
        {
          "id": "5634777",
          "text": "La pista di pattinaggio apre il venticinque novembre.",
          "translation": "Каток откроется двадцать пятого ноября.",
          "source": "Tatoeba #5634777 @dnnywld / #5633353 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5634777",
          "cefr_level": "A1",
          "word_slugs": [
            "novembre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il novembre",
        "plural": "",
        "infinitive": ""
      }
