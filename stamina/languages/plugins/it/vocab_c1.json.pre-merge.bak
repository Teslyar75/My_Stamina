    {
      "slug": "andavamo-verb",
      "lemma": "andavamo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6262,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5548943",
          "text": "Andavamo molto d'accordo.",
          "translation": "Мы прекрасно поладили.",
          "source": "Tatoeba #5548943 @dnnywld / #5547762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5548943",
          "cefr_level": "A1",
          "word_slugs": [
            "andavamo-verb"
          ]
        },
        {
          "id": "5543002",
          "text": "Andavamo in chiesa ogni domenica.",
          "translation": "Мы ходили в церковь каждое воскресенье.",
          "source": "Tatoeba #5543002 @dnnywld / #5542941 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5543002",
          "cefr_level": "A1",
          "word_slugs": [
            "andavamo-verb"
          ]
        },
        {
          "id": "6856288",
          "text": "Andavamo in giro fino al mattino.",
          "translation": "Мы до утра бродили по улицам.",
          "source": "Tatoeba #6856288 @dnnywld / #6856132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6856288",
          "cefr_level": "A1",
          "word_slugs": [
            "andavamo-verb"
          ]
        },
        {
          "id": "6903583",
          "text": "Una volta andavamo a scuola insieme.",
          "translation": "Мы раньше вместе ходили в школу.",
          "source": "Tatoeba #6903583 @dnnywld / #6903451 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6903583",
          "cefr_level": "A1",
          "word_slugs": [
            "andavamo-verb"
          ]
        },
