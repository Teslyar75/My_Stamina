    {
      "slug": "canada-name",
      "lemma": "Canada",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5533,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3069701",
          "text": "Il Canada è magnifico!",
          "translation": "Канада великолепна!",
          "source": "Tatoeba #3069701 @Guybrush88 / #3069764 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3069701",
          "cefr_level": "A1",
          "word_slugs": [
            "canada-name"
          ]
        },
        {
          "id": "3486542",
          "text": "Sei mai stato in Canada?",
          "translation": "Ты когда-нибудь был в Канаде?",
          "source": "Tatoeba #3486542 @Guybrush88 / #4407787 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3486542",
          "cefr_level": "A1",
          "word_slugs": [
            "canada-name"
          ]
        },
        {
          "id": "6882800",
          "text": "Questa lettera è dal Canada.",
          "translation": "Это письмо из Канады.",
          "source": "Tatoeba #6882800 @dnnywld / #6882518 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6882800",
          "cefr_level": "A1",
          "word_slugs": [
            "canada-name"
          ]
        },
        {
          "id": "3668574",
          "text": "Il Montana confina col Canada.",
          "translation": "Монтана граничит с Канадой.",
          "source": "Tatoeba #3668574 @Guybrush88 / #3668636 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3668574",
          "cefr_level": "A1",
          "word_slugs": [
            "canada-name"
          ]
        },
        {
          "id": "5509532",
          "text": "Abbiamo molti clienti dal Canada.",
          "translation": "У нас много клиентов из Канады.",
          "source": "Tatoeba #5509532 @dnnywld / #5509195 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5509532",
          "cefr_level": "A1",
          "word_slugs": [
            "canada-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "Canada",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "noiosa-adj",
