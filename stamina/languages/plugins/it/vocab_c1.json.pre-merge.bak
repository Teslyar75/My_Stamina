        {
          "id": "6940780",
          "text": "Gli sponsor hanno approvato il progetto.",
          "translation": "Спонсоры одобрили проект.",
          "source": "Tatoeba #6940780 @dnnywld / #6940399 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6940780",
          "cefr_level": "A1",
          "word_slugs": [
