          ]
        },
        {
          "id": "5910170",
          "text": "Li hai comprati per Tom?",
          "translation": "Ты купил их для Тома?",
          "source": "Tatoeba #5910170 @dnnywld / #5907574 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5910170",
          "cefr_level": "A1",
