    {
      "slug": "rapidamente-adv",
      "lemma": "rapidamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5730,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2468586",
          "text": "Dobbiamo reagire rapidamente.",
          "translation": "Мы должны реагировать быстро.",
          "source": "Tatoeba #2468586 @al_ex_an_der / #2468578 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2468586",
          "cefr_level": "A1",
          "word_slugs": [
            "rapidamente-adv"
          ]
        },
        {
          "id": "11386295",
          "text": "Il caso procede rapidamente.",
          "translation": "Дело идёт полным ходом.",
          "source": "Tatoeba #11386295 @Bernie75 / #3164924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11386295",
          "cefr_level": "A1",
          "word_slugs": [
            "rapidamente-adv"
          ]
        },
        {
          "id": "2468554",
          "text": "Dobbiamo reagire più rapidamente.",
          "translation": "Мы должны реагировать быстрее.",
          "source": "Tatoeba #2468554 @al_ex_an_der / #2468564 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2468554",
          "cefr_level": "A1",
          "word_slugs": [
            "rapidamente-adv"
          ]
        },
        {
          "id": "5557868",
          "text": "Spero che recuperiate rapidamente.",
          "translation": "Надеюсь, Вы скоро поправитесь.",
          "source": "Tatoeba #5557868 @dnnywld / #5557545 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5557868",
          "cefr_level": "A1",
          "word_slugs": [
            "rapidamente-adv"
          ]
        },
        {
          "id": "5645187",
          "text": "Dobbiamo muoverci molto rapidamente.",
          "translation": "Мы должны двигаться очень быстро.",
          "source": "Tatoeba #5645187 @Guybrush88 / #6892413 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5645187",
          "cefr_level": "A1",
          "word_slugs": [
            "rapidamente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "rapidamente",
        "plural": "",
