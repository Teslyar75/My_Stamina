    {
      "slug": "decidi-verb",
      "lemma": "decidi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5513,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6785643",
          "text": "Decidi tu stesso.",
          "translation": "Решай сам.",
          "source": "Tatoeba #6785643 @dnnywld / #3517456 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6785643",
          "cefr_level": "A1",
          "word_slugs": [
            "decidi-verb"
          ]
        },
        {
          "id": "6893718",
          "text": "Decidi da che parte stare.",
          "translation": "Ты уж реши, на чьей ты стороне.",
          "source": "Tatoeba #6893718 @dnnywld / #6893251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893718",
          "cefr_level": "A1",
          "word_slugs": [
            "decidi-verb"
          ]
        },
        {
          "id": "13824085",
          "text": "Ti decidi una buona volta o no?",
          "translation": "Так, ты реши уже, чего хочешь, а?",
          "source": "Tatoeba #13824085 @dnnywld / #13823800 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13824085",
          "cefr_level": "A1",
          "word_slugs": [
            "decidi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "decidi",
        "plural": "",
        "infinitive": "decidi"
      }
    },
    {
      "slug": "metteremo-verb",
      "lemma": "metteremo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5514,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5427207",
          "text": "Finisci di giocare e poi ci metteremo a studiare.",
          "translation": "Доиграй, а потом будем учиться.",
          "source": "Tatoeba #5427207 @dnnywld / #4396650 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5427207",
          "cefr_level": "A1",
          "word_slugs": [
            "metteremo-verb"
          ]
        },
        {
          "id": "10916233",
          "text": "Con questo traffico ci metteremo due ore ad arrivare.",
          "translation": "По таким пробкам мы туда часа два будем ехать.",
          "source": "Tatoeba #10916233 @dnnywld / #10915674 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10916233",
          "cefr_level": "A1",
          "word_slugs": [
            "metteremo-verb"
          ]
        },
        {
          "id": "7955103",
          "text": "La prossima volta ci metteremo d'accordo su un punto di incontro.",
          "translation": "В следующий раз мы договоримся о месте встречи.",
          "source": "Tatoeba #7955103 @dnnywld / #7954811 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7955103",
          "cefr_level": "A1",
          "word_slugs": [
            "metteremo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "metteremo",
        "plural": "",
        "infinitive": "metteremo"
      }
    },
