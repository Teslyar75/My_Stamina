      "examples": [
        {
          "id": "7870156",
          "text": "Le camere singole sono terminate.",
          "translation": "Одноместные номера закончились.",
          "source": "Tatoeba #7870156 @dnnywld / #7869759 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7870156",
          "cefr_level": "A1",
          "word_slugs": [
