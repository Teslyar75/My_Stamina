    {
      "slug": "rosse-adj",
      "lemma": "rosse",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5819,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "430078",
          "text": "Le mele sono rosse.",
          "translation": "Яблоки красные.",
          "source": "Tatoeba #430078 @Pharamp / #3337920 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/430078",
          "cefr_level": "A1",
          "word_slugs": [
            "rosse-adj"
          ]
        },
        {
          "id": "635269",
          "text": "Le ciliegie sono rosse.",
          "translation": "Вишни красные.",
          "source": "Tatoeba #635269 @Guybrush88 / #1194276 @Imp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/635269",
          "cefr_level": "A1",
          "word_slugs": [
            "rosse-adj"
          ]
        },
        {
          "id": "378148",
          "text": "Mi piacciono le rose rosse.",
          "translation": "Мне нравятся красные розы.",
          "source": "Tatoeba #378148 @Pharamp / #1570370 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/378148",
          "cefr_level": "A1",
          "word_slugs": [
            "rosse-adj"
          ]
        },
        {
          "id": "5512473",
          "text": "Le stelle rosse non cadono mai.",
          "translation": "Красные звезды не падают.",
          "source": "Tatoeba #5512473 @dnnywld / #2217777 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512473",
          "cefr_level": "A1",
          "word_slugs": [
            "rosse-adj"
          ]
        },
        {
          "id": "3409843",
          "text": "Le foglie dell'albero sono diventate rosse.",
          "translation": "Листья на дереве покраснели.",
          "source": "Tatoeba #3409843 @Guybrush88 / #3072407 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3409843",
          "cefr_level": "A1",
