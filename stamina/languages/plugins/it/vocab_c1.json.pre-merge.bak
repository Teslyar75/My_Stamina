      "frequency_rank": 7694,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6301961",
          "text": "Mi hanno punito.",
          "translation": "Меня наказали.",
          "source": "Tatoeba #6301961 @dnnywld / #6301559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6301961",
          "cefr_level": "A1",
