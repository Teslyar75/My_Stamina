      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4240967",
          "text": "Finalmente un commento decente!",
          "translation": "Ну наконец-то приличный коммент!",
          "source": "Tatoeba #4240967 @Guybrush88 / #4997318 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4240967",
          "cefr_level": "A1",
          "word_slugs": [
            "decente-adj"
          ]
        },
        {
          "id": "6883437",
          "text": "Potreste mettervi qualcosa di decente.",
          "translation": "Вы могли бы и поприличнее одеться.",
          "source": "Tatoeba #6883437 @dnnywld / #6883325 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883437",
          "cefr_level": "A1",
          "word_slugs": [
