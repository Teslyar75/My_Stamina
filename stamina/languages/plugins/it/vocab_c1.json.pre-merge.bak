      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5478695",
          "text": "Non serve gridare. E non sbattere la porta.",
          "translation": "Не надо кричать. И дверью хлопать не стоит.",
          "source": "Tatoeba #5478695 @dnnywld / #5478649 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5478695",
          "cefr_level": "A1",
