    {
      "slug": "circolo-noun",
      "lemma": "circolo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5149,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5650406",
          "text": "Tom non è più membro di questo circolo.",
          "translation": "Том больше не член этого клуба.",
          "source": "Tatoeba #5650406 @dnnywld / #5144273 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650406",
          "cefr_level": "A1",
          "word_slugs": [
            "circolo-noun"
          ]
        },
        {
          "id": "5556615",
          "text": "La risposta ci conduce in un circolo vizioso.",
          "translation": "Ответ приводит нас к порочному кругу.",
          "source": "Tatoeba #5556615 @dnnywld / #5556305 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5556615",
          "cefr_level": "A1",
          "word_slugs": [
            "circolo-noun"
          ]
        },
        {
          "id": "10840805",
          "text": "Tom si è iscritto al circolo di aeromodellismo.",
          "translation": "Том записался в кружок авиамоделирования.",
          "source": "Tatoeba #10840805 @dnnywld / #6742649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10840805",
          "cefr_level": "A1",
          "word_slugs": [
            "circolo-noun"
          ]
        },
        {
          "id": "7033656",
          "text": "Mary ha chiesto a Tom di unirsi al circolo letterario.",
          "translation": "Мэри попросила Тома вступить в литературный кружок.",
          "source": "Tatoeba #7033656 @dnnywld / #7033652 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7033656",
          "cefr_level": "A1",
          "word_slugs": [
            "circolo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
