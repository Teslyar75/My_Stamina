      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1510619",
          "text": "Il sito web è offline.",
          "translation": "Сайт недоступен.",
          "source": "Tatoeba #1510619 @Shadd / #1510142 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1510619",
          "cefr_level": "A1",
          "word_slugs": [
            "web-noun"
          ]
        },
        {
          "id": "2178114",
          "text": "Mi piace il tuo sito web.",
          "translation": "Мне нравится твой сайт.",
          "source": "Tatoeba #2178114 @Guybrush88 / #6941701 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2178114",
          "cefr_level": "A1",
          "word_slugs": [
            "web-noun"
          ]
        },
        {
          "id": "5519155",
          "text": "Ti dò il collegamento al sito web.",
          "translation": "Я дам тебе ссылку на сайт.",
          "source": "Tatoeba #5519155 @dnnywld / #5518861 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5519155",
          "cefr_level": "A1",
          "word_slugs": [
            "web-noun"
          ]
        },
        {
          "id": "5514359",
          "text": "Tom non è riuscito a craccare questo sito web.",
          "translation": "Том не смог взломать этот сайт.",
          "source": "Tatoeba #5514359 @dnnywld / #5513293 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514359",
          "cefr_level": "A1",
          "word_slugs": [
            "web-noun"
          ]
        },
        {
          "id": "5398170",
          "text": "Cosa ci trovi di così interessante in questo sito web?",
          "translation": "Что такого интересного ты находишь в этом веб-сайте?",
          "source": "Tatoeba #5398170 @dnnywld / #5397965 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5398170",
          "cefr_level": "A1",
          "word_slugs": [
            "web-noun"
          ]
        }
