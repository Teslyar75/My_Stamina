      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5395579",
          "text": "Come si dice \"ratto\" in inglese?",
          "translation": "Как будет \"крыса\" по-английски?",
          "source": "Tatoeba #5395579 @dnnywld / #5395468 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5395579",
          "cefr_level": "A1",
