    {
      "slug": "condurre-verb",
      "lemma": "condurre",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6329,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6839507",
          "text": "Preferisco condurre le mie indagini.",
          "translation": "Я предпочитаю провести собственное расследование.",
          "source": "Tatoeba #6839507 @dnnywld / #5652763 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6839507",
          "cefr_level": "A1",
          "word_slugs": [
            "condurre-verb"
          ]
        },
        {
          "id": "6890101",
          "text": "Non sono capace di condurre i negoziati.",
          "translation": "Я не умею вести переговоры.",
          "source": "Tatoeba #6890101 @dnnywld / #5368056 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890101",
          "cefr_level": "A1",
          "word_slugs": [
            "condurre-verb"
          ]
        },
        {
          "id": "6890041",
          "text": "Il comandante rifiutò di condurre i negoziati.",
          "translation": "Командующий отказался вести переговоры.",
          "source": "Tatoeba #6890041 @dnnywld / #4458394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890041",
          "cefr_level": "A1",
          "word_slugs": [
            "condurre-verb"
          ]
        },
        {
          "id": "6890083",
          "text": "Non sono autorizzato a condurre dei negoziati.",
          "translation": "Я не уполномочен вести переговоры.",
          "source": "Tatoeba #6890083 @dnnywld / #4160411 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890083",
          "cefr_level": "A1",
          "word_slugs": [
            "condurre-verb"
          ]
        },
        {
          "id": "6890088",
          "text": "Non si possono condurre negoziati con i terroristi.",
          "translation": "Нельзя вести переговоры с террористами.",
          "source": "Tatoeba #6890088 @dnnywld / #4749682 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890088",
          "cefr_level": "A1",
          "word_slugs": [
            "condurre-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "condurre",
        "plural": "",
        "infinitive": "condurre"
      }
