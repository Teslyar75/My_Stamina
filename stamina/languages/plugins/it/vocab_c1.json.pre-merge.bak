    {
      "slug": "maggioranza-noun",
      "lemma": "maggioranza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8160,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5451575",
          "text": "Non siamo la maggioranza.",
          "translation": "Мы не большинство.",
          "source": "Tatoeba #5451575 @dnnywld / #5451293 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5451575",
          "cefr_level": "A1",
          "word_slugs": [
            "maggioranza-noun"
          ]
        },
        {
          "id": "6698392",
          "text": "A chi appartiene la quota azionaria di maggioranza?",
          "translation": "Кому принадлежит контрольный пакет акций?",
          "source": "Tatoeba #6698392 @dnnywld / #6697403 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698392",
          "cefr_level": "A1",
          "word_slugs": [
            "maggioranza-noun"
          ]
        },
        {
          "id": "5598354",
          "text": "L'opinione della maggioranza non coincide con la tua.",
          "translation": "Мнение большинства не совпадает с твоим.",
          "source": "Tatoeba #5598354 @dnnywld / #5597964 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5598354",
          "cefr_level": "A1",
          "word_slugs": [
            "maggioranza-noun"
          ]
        },
        {
          "id": "1020262",
          "text": "Il governo ha avuto la maggioranza alle ultime elezioni.",
          "translation": "Правительство добилось большинства на прошлых выборах.",
          "source": "Tatoeba #1020262 @riccioberto / #444085 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1020262",
          "cefr_level": "A1",
          "word_slugs": [
            "maggioranza-noun"
          ]
        },
        {
          "id": "6922706",
          "text": "Questa è l'opinione della stragrande maggioranza degli intervistati.",
          "translation": "Так считает подавляющее большинство опрошенных.",
          "source": "Tatoeba #6922706 @dnnywld / #6922356 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6922706",
          "cefr_level": "A1",
          "word_slugs": [
            "maggioranza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la maggioranza",
        "plural": "",
        "infinitive": ""
      }
    },
