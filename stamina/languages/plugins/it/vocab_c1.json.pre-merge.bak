    {
      "slug": "considero-verb",
      "lemma": "considero",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8244,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5640159",
          "text": "Non ti considero grassa.",
          "translation": "Я не считаю тебя толстой.",
          "source": "Tatoeba #5640159 @dnnywld / #5640031 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5640159",
          "cefr_level": "A1",
          "word_slugs": [
            "considero-verb"
          ]
        },
        {
          "id": "5640211",
          "text": "Non ti considero grasso.",
          "translation": "Я не считаю тебя толстым.",
          "source": "Tatoeba #5640211 @dnnywld / #5640030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5640211",
          "cefr_level": "A1",
          "word_slugs": [
            "considero-verb"
          ]
        },
        {
          "id": "5872765",
          "text": "Non considero questo utile.",
          "translation": "Я не считаю это полезным.",
          "source": "Tatoeba #5872765 @dnnywld / #4177533 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5872765",
          "cefr_level": "A1",
          "word_slugs": [
            "considero-verb"
          ]
        },
        {
          "id": "5392638",
          "text": "Non considero questo sicuro.",
          "translation": "Я не считаю это безопасным.",
          "source": "Tatoeba #5392638 @dnnywld / #5392393 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5392638",
          "cefr_level": "A1",
          "word_slugs": [
            "considero-verb"
          ]
        },
        {
          "id": "5497021",
          "text": "Considero chiusa la questione.",
          "translation": "Считаю вопрос закрытым.",
          "source": "Tatoeba #5497021 @dnnywld / #3878374 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497021",
          "cefr_level": "A1",
          "word_slugs": [
            "considero-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "considero",
        "plural": "",
        "infinitive": "considero"
