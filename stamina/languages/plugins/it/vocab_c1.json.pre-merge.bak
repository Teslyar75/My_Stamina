    {
      "slug": "diecimila-adj",
      "lemma": "diecimila",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7974,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "341646",
          "text": "Diecimila più cinquemilacinquecento fa quindicimilacinquecento.",
          "translation": "Десять тысяч плюс пять тысяч пятьсот будет пятнадцать тысяч пятьсот.",
          "source": "Tatoeba #341646 @MUIRIEL / #611494 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341646",
          "cefr_level": "A1",
          "word_slugs": [
