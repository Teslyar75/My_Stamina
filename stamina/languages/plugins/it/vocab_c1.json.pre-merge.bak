          "word_slugs": [
            "preferiti-adj"
          ]
        },
        {
          "id": "6142870",
          "text": "Quali sono i tuoi fiori preferiti?",
          "translation": "Какие твои любимые цветы?",
          "source": "Tatoeba #6142870 @Guybrush88 / #7011543 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6142870",
