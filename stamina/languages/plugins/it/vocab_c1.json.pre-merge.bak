    {
      "slug": "utilizzare-verb",
      "lemma": "utilizzare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7941,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "702855",
          "text": "Quale letto vuoi utilizzare?",
          "translation": "Какую кровать ты хочешь использовать?",
          "source": "Tatoeba #702855 @Heracleum / #2731137 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/702855",
          "cefr_level": "A1",
          "word_slugs": [
            "utilizzare-verb"
          ]
        },
        {
          "id": "5843672",
          "text": "Devi utilizzare gli strumenti.",
          "translation": "Ты должен использовать инструменты.",
          "source": "Tatoeba #5843672 @dnnywld / #2494914 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843672",
          "cefr_level": "A1",
          "word_slugs": [
            "utilizzare-verb"
          ]
        },
        {
          "id": "5423787",
          "text": "Potete utilizzare il mio yacht.",
          "translation": "Вы можете воспользоваться моей яхтой.",
          "source": "Tatoeba #5423787 @dnnywld / #605729 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5423787",
          "cefr_level": "A1",
          "word_slugs": [
            "utilizzare-verb"
          ]
        },
        {
          "id": "5843666",
          "text": "È necessario utilizzare i sottotitoli.",
          "translation": "Необходимо использовать подзаголовки.",
          "source": "Tatoeba #5843666 @dnnywld / #4658801 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843666",
          "cefr_level": "A1",
          "word_slugs": [
            "utilizzare-verb"
          ]
        },
        {
          "id": "5843891",
          "text": "Potete utilizzare i metodi più differenti.",
          "translation": "Можно использовать самые разные методы.",
          "source": "Tatoeba #5843891 @dnnywld / #1971533 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843891",
          "cefr_level": "A1",
          "word_slugs": [
            "utilizzare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
