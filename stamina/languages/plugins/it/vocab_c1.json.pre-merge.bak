    {
      "slug": "poltrona-adj",
      "lemma": "poltrona",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7397,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4903498",
          "text": "Di quale poltrona parli?",
          "translation": "О каком кресле ты говоришь?",
          "source": "Tatoeba #4903498 @Guybrush88 / #13653892 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4903498",
          "cefr_level": "A1",
          "word_slugs": [
            "poltrona-adj"
          ]
        },
        {
          "id": "5998815",
          "text": "Tom sprofondò in poltrona.",
          "translation": "Том опустился в кресло.",
          "source": "Tatoeba #5998815 @dnnywld / #4019722 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5998815",
          "cefr_level": "A1",
          "word_slugs": [
            "poltrona-adj"
          ]
        },
        {
          "id": "5998843",
          "text": "Tom sprofondò goffamente in poltrona.",
          "translation": "Том грузно опустился в кресло.",
          "source": "Tatoeba #5998843 @dnnywld / #4754060 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5998843",
          "cefr_level": "A1",
          "word_slugs": [
            "poltrona-adj"
          ]
        },
        {
          "id": "5980034",
          "text": "Arriviamo a teatro, attraversiamo la sala e ci sediamo in poltrona.",
          "translation": "Мы приезжаем в театр, проходим в зал, садимся в кресла.",
          "source": "Tatoeba #5980034 @dnnywld / #5966162 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980034",
          "cefr_level": "A1",
          "word_slugs": [
            "poltrona-adj"
          ]
        },
        {
          "id": "5510304",
          "text": "Prima la poltrona stava nell'angolo, ma adesso è vicino alla finestra.",
          "translation": "Раньше кресло стояло в углу, а теперь оно возле окна.",
          "source": "Tatoeba #5510304 @dnnywld / #5510181 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510304",
          "cefr_level": "A1",
          "word_slugs": [
            "poltrona-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il poltrona",
        "plural": "",
        "infinitive": ""
      }
    },
