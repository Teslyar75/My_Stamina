          "cefr_level": "A1",
          "word_slugs": [
            "operai-adj"
          ]
        },
        {
          "id": "11530693",
          "text": "Gli operai vengono dalla fabbrica.",
          "translation": "Рабочие идут с завода.",
          "source": "Tatoeba #11530693 @dnnywld / #1559059 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11530693",
          "cefr_level": "A1",
          "word_slugs": [
            "operai-adj"
          ]
        },
        {
          "id": "3139224",
          "text": "Milioni di operai hanno perso il loro impiego.",
          "translation": "Миллионы рабочих потеряли свои рабочие места.",
          "source": "Tatoeba #3139224 @Guybrush88 / #6556448 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3139224",
          "cefr_level": "A1",
          "word_slugs": [
            "operai-adj"
          ]
        },
        {
          "id": "5402146",
          "text": "Gli operai ricevono il salario ogni due settimane.",
          "translation": "Рабочие получают зарплату раз в две недели.",
          "source": "Tatoeba #5402146 @dnnywld / #5401250 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5402146",
          "cefr_level": "A1",
          "word_slugs": [
            "operai-adj"
          ]
        }
      ],
