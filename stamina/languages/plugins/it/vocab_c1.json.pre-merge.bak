    {
      "slug": "vaccino-adj",
      "lemma": "vaccino",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7825,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5433003",
          "text": "Avete il vaccino?",
          "translation": "У вас есть вакцина?",
          "source": "Tatoeba #5433003 @dnnywld / #5432094 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433003",
          "cefr_level": "A1",
          "word_slugs": [
            "vaccino-adj"
          ]
        },
        {
          "id": "10142133",
          "text": "Questo vaccino è efficace?",
          "translation": "Эта вакцина эффективна?",
          "source": "Tatoeba #10142133 @Guybrush88 / #10140321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10142133",
          "cefr_level": "A1",
          "word_slugs": [
            "vaccino-adj"
          ]
        },
        {
          "id": "6833433",
          "text": "È troppo tardi per fare un vaccino antinfluenzale.",
          "translation": "Делать прививку от гриппа уже поздно.",
          "source": "Tatoeba #6833433 @dnnywld / #6832930 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833433",
          "cefr_level": "A1",
          "word_slugs": [
            "vaccino-adj"
          ]
        },
        {
          "id": "5481759",
          "text": "Cerco un articolo su degli esperimenti di un nuovo vaccino.",
          "translation": "Я ищу статью об экспериментах с новой вакциной.",
          "source": "Tatoeba #5481759 @dnnywld / #5480609 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5481759",
          "cefr_level": "A1",
          "word_slugs": [
            "vaccino-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il vaccino",
        "plural": "",
        "infinitive": ""
      }
