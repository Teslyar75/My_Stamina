    {
      "slug": "autentico-adj",
      "lemma": "autentico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8572,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5474276",
          "text": "È un autentico spagnolo.",
          "translation": "Он настоящий испанец.",
          "source": "Tatoeba #5474276 @dnnywld / #5473902 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5474276",
          "cefr_level": "A1",
          "word_slugs": [
            "autentico-adj"
          ]
        },
        {
          "id": "5646204",
          "text": "Nel nostro soggiorno c'è un autentico camino.",
          "translation": "У нас в гостиной настоящий камин.",
          "source": "Tatoeba #5646204 @dnnywld / #3604693 @Shady_arc (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646204",
          "cefr_level": "A1",
          "word_slugs": [
            "autentico-adj"
          ]
        },
        {
          "id": "5987636",
          "text": "Non penso che questo sia un autentico diamante.",
          "translation": "Я не думаю, что это настоящий бриллиант.",
          "source": "Tatoeba #5987636 @dnnywld / #5987307 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5987636",
          "cefr_level": "A1",
          "word_slugs": [
            "autentico-adj"
          ]
        },
        {
          "id": "1299245",
          "text": "Questo è turchese autentico? A questo prezzo? Suvvia!",
          "translation": "Это настоящая бирюза? По такой цене? Да ну!",
          "source": "Tatoeba #1299245 @Guybrush88 / #1579494 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1299245",
          "cefr_level": "A1",
          "word_slugs": [
            "autentico-adj"
          ]
        },
        {
          "id": "6872185",
          "text": "Non si poteva dire chi di loro fosse autentico.",
          "translation": "Нельзя было сказать, кто из них настоящий.",
          "source": "Tatoeba #6872185 @dnnywld / #6859252 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6872185",
          "cefr_level": "A1",
          "word_slugs": [
            "autentico-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il autentico",
        "plural": "",
        "infinitive": ""
      }
