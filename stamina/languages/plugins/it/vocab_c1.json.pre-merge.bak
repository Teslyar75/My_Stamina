    {
      "slug": "vaso-noun",
      "lemma": "vaso",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5656,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "612486",
          "text": "Chi ha rotto il vaso?",
          "translation": "Кто разбил вазу?",
          "source": "Tatoeba #612486 @rado / #612471 @Aleksej (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/612486",
          "cefr_level": "A1",
          "word_slugs": [
            "vaso-noun"
          ]
        },
        {
          "id": "1074539",
          "text": "I fiori nel vaso sono rose.",
          "translation": "Цветы в вазе - розы.",
          "source": "Tatoeba #1074539 @Guybrush88 / #3308519 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1074539",
          "cefr_level": "A1",
          "word_slugs": [
            "vaso-noun"
          ]
        },
        {
          "id": "6772515",
          "text": "Il fiore nel vaso è giallo.",
          "translation": "Цветок в вазе жёлтый.",
          "source": "Tatoeba #6772515 @dnnywld / #6772036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6772515",
          "cefr_level": "A1",
          "word_slugs": [
            "vaso-noun"
          ]
        },
        {
          "id": "6790474",
          "text": "Lei ha rotto accidentalmente un vaso.",
          "translation": "Она случайно разбила вазу.",
          "source": "Tatoeba #6790474 @dnnywld / #439161 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790474",
          "cefr_level": "A1",
          "word_slugs": [
            "vaso-noun"
          ]
        },
        {
          "id": "12464223",
          "text": "Versate un po' d'acqua nel vaso.",
          "translation": "Налейте в вазу немного воды.",
          "source": "Tatoeba #12464223 @dnnywld / #4754834 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12464223",
          "cefr_level": "A1",
          "word_slugs": [
            "vaso-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il vaso",
