          "cefr_level": "A1",
          "word_slugs": [
            "ratto-noun"
          ]
        },
        {
          "id": "3313660",
          "text": "Thomas uccise il ratto con un bastone.",
          "translation": "Томас убил крысу палкой.",
          "source": "Tatoeba #3313660 @Guybrush88 / #3313702 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3313660",
          "cefr_level": "A1",
          "word_slugs": [
