      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10908054",
          "text": "Ti sta raccontando una bugia.",
          "translation": "Он говорит тебе неправду.",
          "source": "Tatoeba #10908054 @dnnywld / #10905991 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10908054",
          "cefr_level": "A1",
