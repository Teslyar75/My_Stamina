    {
      "slug": "conflitto-noun",
      "lemma": "conflitto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5539,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2421085",
          "text": "Si intensifica il conflitto tra Israele e Siria.",
          "translation": "Конфликт между Израилем и Сирией обострился.",
          "source": "Tatoeba #2421085 @al_ex_an_der / #2421077 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2421085",
          "cefr_level": "A1",
          "word_slugs": [
            "conflitto-noun"
          ]
        },
        {
          "id": "6892412",
          "text": "Dobbiamo fare di tutto per evitare un conflitto.",
          "translation": "Мы должны сделать всё, чтобы избежать конфликта.",
          "source": "Tatoeba #6892412 @dnnywld / #1742707 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6892412",
          "cefr_level": "A1",
          "word_slugs": [
            "conflitto-noun"
          ]
        },
        {
          "id": "2144743",
          "text": "Perché la Francia è intervenuta nel conflitto adesso?",
          "translation": "Почему Франция теперь вмешивается в конфликт?",
          "source": "Tatoeba #2144743 @al_ex_an_der / #2144746 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2144743",
          "cefr_level": "A1",
          "word_slugs": [
            "conflitto-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il conflitto",
        "plural": "",
        "infinitive": ""
      }
    },
