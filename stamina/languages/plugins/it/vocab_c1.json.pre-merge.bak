    {
      "slug": "seguente-adj",
      "lemma": "seguente",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7195,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5661945",
          "text": "Il giorno seguente lui andò dal medico.",
          "translation": "На следующий день он пошёл к врачу.",
          "source": "Tatoeba #5661945 @dnnywld / #5661586 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5661945",
          "cefr_level": "A1",
          "word_slugs": [
            "seguente-adj"
          ]
        },
        {
          "id": "5596211",
          "text": "Il giorno seguente lui si sentì un po' meglio.",
          "translation": "На следующий день он чувствовал себя немного лучше.",
          "source": "Tatoeba #5596211 @dnnywld / #5595892 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5596211",
          "cefr_level": "A1",
          "word_slugs": [
            "seguente-adj"
          ]
        },
        {
          "id": "5627361",
          "text": "Determinate i punti di massimo e di minimo della seguente funzione.",
          "translation": "Найдите наибольшее и наименьшее значение следующей функции.",
          "source": "Tatoeba #5627361 @dnnywld / #3563670 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627361",
          "cefr_level": "A1",
          "word_slugs": [
            "seguente-adj"
          ]
        }
