    {
      "slug": "bambole-noun",
      "lemma": "bambole",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7568,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3230973",
          "text": "Martina amava molto le bambole.",
          "translation": "Мартина очень любила кукол.",
          "source": "Tatoeba #3230973 @carlosalberto / #3349564 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3230973",
          "cefr_level": "A1",
          "word_slugs": [
            "bambole-noun"
          ]
        },
        {
          "id": "6385562",
          "text": "Quante bambole avevi quando eri piccola?",
          "translation": "Сколько у тебя было кукол, когда ты была маленькой?",
          "source": "Tatoeba #6385562 @dnnywld / #6385348 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6385562",
          "cefr_level": "A1",
          "word_slugs": [
            "bambole-noun"
          ]
        },
        {
          "id": "6833275",
          "text": "Pensi che io giochi ancora con le bambole?",
          "translation": "Ты думаешь, я до сих пор играю в куклы?",
          "source": "Tatoeba #6833275 @dnnywld / #6833116 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833275",
          "cefr_level": "A1",
          "word_slugs": [
            "bambole-noun"
          ]
        },
        {
          "id": "6385570",
          "text": "Quante bambole avevi quando eri una bambina piccola?",
          "translation": "Сколько у тебя было кукол, когда ты была маленькой девочкой?",
          "source": "Tatoeba #6385570 @dnnywld / #6385346 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6385570",
          "cefr_level": "A1",
          "word_slugs": [
            "bambole-noun"
          ]
        },
        {
          "id": "7085019",
          "text": "Le bambole alle ragazzine e il pallone ai ragazzini.",
          "translation": "Куклы девочкам, а мяч - мальчикам.",
          "source": "Tatoeba #7085019 @dnnywld / #7083624 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7085019",
          "cefr_level": "A1",
          "word_slugs": [
            "bambole-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la bambole",
        "plural": "",
        "infinitive": ""
      }
