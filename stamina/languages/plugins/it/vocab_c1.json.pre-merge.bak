    {
      "slug": "venissi-verb",
      "lemma": "venissi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5063,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5687490",
          "text": "Tom voleva che venissi.",
          "translation": "Том хотел, чтобы я пришла.",
          "source": "Tatoeba #5687490 @dnnywld / #4595205 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5687490",
          "cefr_level": "A1",
          "word_slugs": [
            "venissi-verb"
          ]
        },
        {
          "id": "5585131",
          "text": "Vorresti che venissi con te?",
          "translation": "Ты бы хотел, чтобы я пошёл с тобой?",
          "source": "Tatoeba #5585131 @dnnywld / #5585123 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5585131",
          "cefr_level": "A1",
          "word_slugs": [
            "venissi-verb"
          ]
        },
        {
          "id": "5585149",
          "text": "Vorreste che venissi con voi?",
          "translation": "Вы бы хотели, чтобы я пошёл с вами?",
          "source": "Tatoeba #5585149 @dnnywld / #5585117 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5585149",
          "cefr_level": "A1",
          "word_slugs": [
            "venissi-verb"
          ]
        },
        {
          "id": "10753043",
          "text": "Pensavamo che venissi con noi.",
          "translation": "Мы думали, ты идёшь с нами.",
          "source": "Tatoeba #10753043 @dnnywld / #4631926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10753043",
          "cefr_level": "A1",
          "word_slugs": [
            "venissi-verb"
          ]
        },
        {
          "id": "5585145",
          "text": "Vorresti che venissi lì con te?",
          "translation": "Ты бы хотел, чтобы я пошёл туда с тобой?",
          "source": "Tatoeba #5585145 @dnnywld / #5585118 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5585145",
          "cefr_level": "A1",
          "word_slugs": [
            "venissi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
