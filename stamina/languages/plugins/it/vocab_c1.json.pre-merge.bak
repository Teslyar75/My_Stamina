    {
      "slug": "poiché-conj",
      "lemma": "poiché",
      "pos": "conj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5709,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5968716",
          "text": "Tom non è stanco poiché lo sta portando il cavallo.",
          "translation": "Том не устал, потому что его везёт конь.",
          "source": "Tatoeba #5968716 @dnnywld / #3678420 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968716",
          "cefr_level": "A1",
          "word_slugs": [
            "poiché-conj"
          ]
        },
        {
          "id": "861881",
          "text": "Poiché l'oratore aveva detto cose gravi, tutti temevano la guerra.",
          "translation": "Поскольку оратор говорил серьёзные вещи, все боялись войны.",
          "source": "Tatoeba #861881 @Guybrush88 / #8025116 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/861881",
          "cefr_level": "A1",
          "word_slugs": [
            "poiché-conj"
          ]
        },
        {
          "id": "5527771",
          "text": "Mary rimase offesa poiché Tom non aveva capito che lei era offesa.",
          "translation": "Мэри обиделась, что Том не понял, что она обиделась.",
          "source": "Tatoeba #5527771 @dnnywld / #5527222 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527771",
          "cefr_level": "A1",
          "word_slugs": [
            "poiché-conj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "poiché",
        "plural": "",
        "infinitive": ""
      }
    },
