    {
      "slug": "comunicato-adj",
      "lemma": "comunicato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7252,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6162587",
          "text": "Hai scritto un comunicato?",
          "translation": "Ты написала заявление?",
          "source": "Tatoeba #6162587 @dnnywld / #6162508 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6162587",
          "cefr_level": "A1",
          "word_slugs": [
            "comunicato-adj"
          ]
        },
        {
          "id": "3190750",
          "text": "Purtroppo ha solo comunicato che resterà a Gragnano.",
          "translation": "К сожалению, она лишь сказала, что останется в Граньяно.",
          "source": "Tatoeba #3190750 @Guybrush88 / #3801256 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3190750",
          "cefr_level": "A1",
          "word_slugs": [
            "comunicato-adj"
          ]
        },
        {
          "id": "6955553",
          "text": "Tom volutamente non mi ha comunicato alcuni dettagli.",
          "translation": "Том намеренно не сообщил мне некоторые подробности.",
          "source": "Tatoeba #6955553 @dnnywld / #6955526 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6955553",
          "cefr_level": "A1",
          "word_slugs": [
            "comunicato-adj"
          ]
        },
        {
          "id": "5459983",
          "text": "L'agenzia d'informazioni ha trasmesso un comunicato urgente.",
          "translation": "Информационное агентство передало срочное сообщение.",
          "source": "Tatoeba #5459983 @dnnywld / #5459920 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5459983",
          "cefr_level": "A1",
          "word_slugs": [
            "comunicato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il comunicato",
        "plural": "",
        "infinitive": ""
      }
    },
