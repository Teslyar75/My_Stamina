      "frequency_rank": 5569,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "350347",
          "text": "Lascerai un messaggio?",
          "translation": "Ты оставишь сообщение?",
          "source": "Tatoeba #350347 @martin / #4667742 @yura798261 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350347",
          "cefr_level": "A1",
          "word_slugs": [
            "lascerai-verb"
          ]
        },
        {
          "id": "5683478",
          "text": "Sicuro che non mi lascerai?",
          "translation": "Ты точно меня не бросишь?",
          "source": "Tatoeba #5683478 @dnnywld / #5683098 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683478",
          "cefr_level": "A1",
          "word_slugs": [
            "lascerai-verb"
          ]
        },
        {
          "id": "10825697",
          "text": "Spero che non mi lascerai aspettare.",
          "translation": "Надеюсь, ты не заставишь меня ждать.",
          "source": "Tatoeba #10825697 @dnnywld / #6603459 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10825697",
          "cefr_level": "A1",
          "word_slugs": [
            "lascerai-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
