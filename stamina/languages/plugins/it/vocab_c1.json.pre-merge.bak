    {
      "slug": "iniziano-verb",
      "lemma": "iniziano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5836,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "568622",
          "text": "I bambini iniziano ad andare a scuola a sei anni.",
          "translation": "Дети начинают ходить в школу в шесть лет.",
          "source": "Tatoeba #568622 @bruno_b / #3270157 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/568622",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziano-verb"
          ]
        },
        {
          "id": "11486700",
          "text": "Le fiabe iniziano sempre allo stesso modo: C'era una volta.",
          "translation": "Сказки всегда начинаются одинаково: жили-были.",
          "source": "Tatoeba #11486700 @Bernie75 / #2811095 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11486700",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "iniziano",
        "plural": "",
        "infinitive": "iniziano"
      }
