    {
      "slug": "giovanni-name",
      "lemma": "Giovanni",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5560,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3408592",
          "text": "Giovanni ha ragione.",
          "translation": "Джованни прав.",
          "source": "Tatoeba #3408592 @Guybrush88 / #4226608 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3408592",
          "cefr_level": "A1",
          "word_slugs": [
            "giovanni-name"
          ]
        },
        {
          "id": "5438667",
          "text": "Tom ha un figlio di nome Giovanni.",
          "translation": "У Тома есть сын Джон.",
          "source": "Tatoeba #5438667 @dnnywld / #5438540 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5438667",
          "cefr_level": "A1",
          "word_slugs": [
            "giovanni-name"
          ]
        },
        {
          "id": "5690430",
          "text": "Il principe Giovanni fu sepolto con tutti gli onori.",
          "translation": "Принц Иоанн был похоронен со всеми почестями.",
          "source": "Tatoeba #5690430 @dnnywld / #5690294 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690430",
          "cefr_level": "A1",
          "word_slugs": [
            "giovanni-name"
          ]
        },
        {
          "id": "6939071",
          "text": "Giovanni Battista nacque sei mesi prima della nascita di Gesù.",
          "translation": "Иоанн Креститель родился за полгода до рождения Иисуса.",
          "source": "Tatoeba #6939071 @dnnywld / #6938434 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6939071",
          "cefr_level": "A1",
          "word_slugs": [
            "giovanni-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il Giovanni",
        "plural": "",
        "infinitive": ""
      }
    },
