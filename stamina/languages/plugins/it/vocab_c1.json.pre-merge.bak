    {
      "slug": "tali-adj",
      "lemma": "tali",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5907,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3221236",
          "text": "Tali errori non sono rari.",
          "translation": "Такие ошибки не редки.",
          "source": "Tatoeba #3221236 @Selena777 / #3228660 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3221236",
          "cefr_level": "A1",
          "word_slugs": [
            "tali-adj"
          ]
        },
        {
          "id": "5786354",
          "text": "Non risponderò a tali domande.",
          "translation": "Я не буду отвечать на такие вопросы.",
          "source": "Tatoeba #5786354 @dnnywld / #5781856 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5786354",
          "cefr_level": "A1",
          "word_slugs": [
            "tali-adj"
          ]
        },
        {
          "id": "5569467",
          "text": "Tale l'abate, tali i monaci.",
          "translation": "Каков поп, таков приход.",
          "source": "Tatoeba #5569467 @dnnywld / #5569274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5569467",
          "cefr_level": "A1",
          "word_slugs": [
            "tali-adj"
          ]
        },
        {
          "id": "10762803",
          "text": "Non so cosa farei in tali circostanze.",
          "translation": "Не знаю, как бы я поступил в подобных обстоятельствах.",
          "source": "Tatoeba #10762803 @carlosalberto / #10761904 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10762803",
          "cefr_level": "A1",
          "word_slugs": [
            "tali-adj"
          ]
        },
        {
          "id": "5981261",
          "text": "I soldi, come tali, non hanno importanza.",
          "translation": "Деньги как таковые не имеют значения.",
          "source": "Tatoeba #5981261 @dnnywld / #2012777 @safetango (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5981261",
          "cefr_level": "A1",
          "word_slugs": [
            "tali-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tali",
        "plural": "",
        "infinitive": ""
      }
    },
