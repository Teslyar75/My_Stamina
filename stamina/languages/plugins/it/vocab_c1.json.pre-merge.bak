      "examples": [
        {
          "id": "5397282",
          "text": "Ci sono due possibili spiegazioni.",
          "translation": "Есть два возможных объяснения.",
          "source": "Tatoeba #5397282 @dnnywld / #5397262 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5397282",
          "cefr_level": "A1",
          "word_slugs": [
            "spiegazioni-noun"
          ]
        },
        {
          "id": "5492225",
          "text": "Tom ha rifiutato di dare spiegazioni.",
          "translation": "Том отказался давать объяснения.",
          "source": "Tatoeba #5492225 @dnnywld / #5492049 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5492225",
          "cefr_level": "A1",
          "word_slugs": [
            "spiegazioni-noun"
          ]
        },
        {
          "id": "5401107",
          "text": "Se non ti è chiaro chiedi spiegazioni.",
          "translation": "Если тебе непонятно, попроси объяснить.",
          "source": "Tatoeba #5401107 @dnnywld / #5401104 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5401107",
          "cefr_level": "A1",
          "word_slugs": [
            "spiegazioni-noun"
          ]
        },
        {
          "id": "5911406",
          "text": "Non ho spiegazioni per il suo comportamento.",
          "translation": "У меня нет объяснения её поведению.",
          "source": "Tatoeba #5911406 @dnnywld / #5911391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5911406",
          "cefr_level": "A1",
          "word_slugs": [
            "spiegazioni-noun"
          ]
        },
        {
          "id": "5911404",
          "text": "Non ho spiegazioni per il Vostro comportamento.",
          "translation": "У меня нет объяснения Вашему поведению.",
          "source": "Tatoeba #5911404 @dnnywld / #5911392 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5911404",
          "cefr_level": "A1",
          "word_slugs": [
            "spiegazioni-noun"
          ]
        }
