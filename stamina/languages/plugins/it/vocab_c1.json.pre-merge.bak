      "examples": [
        {
          "id": "6484910",
          "text": "Lei studia intensamente.",
          "translation": "Она усердно учится.",
          "source": "Tatoeba #6484910 @dnnywld / #6484597 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6484910",
