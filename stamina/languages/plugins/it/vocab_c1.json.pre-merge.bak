    {
      "slug": "vinceremo-verb",
      "lemma": "vinceremo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9659,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6841919",
          "text": "Vinceremo di sicuro.",
          "translation": "Мы непременно выиграем.",
          "source": "Tatoeba #6841919 @dnnywld / #5077395 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841919",
          "cefr_level": "A1",
