    {
      "slug": "prepari-verb",
      "lemma": "prepari",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6335,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6360588",
          "text": "Ci prepari dei panini?",
          "translation": "Ты делаешь нам бутерброды?",
          "source": "Tatoeba #6360588 @dnnywld / #6333829 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6360588",
          "cefr_level": "A1",
          "word_slugs": [
            "prepari-verb"
          ]
        },
        {
          "id": "6919673",
          "text": "Voglio che stasera prepari tu la cena.",
          "translation": "Я хочу, чтобы ты сегодня вечером приготовил ужин.",
          "source": "Tatoeba #6919673 @dnnywld / #6919642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919673",
          "cefr_level": "A1",
          "word_slugs": [
            "prepari-verb"
          ]
        },
        {
          "id": "6893950",
          "text": "Il primo è andato, il secondo si prepari!",
          "translation": "Первый пошёл, второй - приготовиться!",
          "source": "Tatoeba #6893950 @dnnywld / #6893162 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893950",
          "cefr_level": "A1",
          "word_slugs": [
            "prepari-verb"
          ]
        },
        {
          "id": "6843313",
          "text": "Sembra che si prepari a piovere. Meglio portare i panni dentro.",
          "translation": "Кажется, дождь собирается. Лучше занести бельё внутрь.",
          "source": "Tatoeba #6843313 @dnnywld / #1001533 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843313",
          "cefr_level": "A1",
          "word_slugs": [
            "prepari-verb"
          ]
        },
        {
          "id": "6853245",
          "text": "OH, sembra che se prepari a piovere... E io sono senza ombrello.",
          "translation": "Ой, кажется, дождь собирается... А я без зонтика.",
          "source": "Tatoeba #6853245 @dnnywld / #6849809 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853245",
          "cefr_level": "A1",
          "word_slugs": [
            "prepari-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "prepari",
        "plural": "",
        "infinitive": "prepari"
      }
    },
