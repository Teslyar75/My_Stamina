    {
      "slug": "perfezione-noun",
      "lemma": "perfezione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5667,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7004807",
          "text": "È lungi dalla perfezione.",
          "translation": "Это далеко не идеально.",
          "source": "Tatoeba #7004807 @dnnywld / #7002324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7004807",
          "cefr_level": "A1",
          "word_slugs": [
            "perfezione-noun"
          ]
        },
        {
          "id": "7278105",
          "text": "Faremo tutto alla perfezione.",
          "translation": "Мы всё сделаем так, что комар носа не подточит.",
          "source": "Tatoeba #7278105 @dnnywld / #7277716 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7278105",
          "cefr_level": "A1",
          "word_slugs": [
            "perfezione-noun"
          ]
        },
        {
          "id": "7278109",
          "text": "Tutto va fatto alla perfezione.",
          "translation": "Всё должно быть сделано так, чтобы комар носа не подточил.",
          "source": "Tatoeba #7278109 @dnnywld / #7277714 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7278109",
          "cefr_level": "A1",
          "word_slugs": [
            "perfezione-noun"
          ]
        },
        {
          "id": "1867345",
          "text": "Quanto avete provato per raggiungere una simile perfezione?",
          "translation": "Сколько времени вы репетировали, чтобы достичь такого совершенства?",
          "source": "Tatoeba #1867345 @sixtynine / #1866691 @estong (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1867345",
          "cefr_level": "A1",
          "word_slugs": [
            "perfezione-noun"
          ]
        },
        {
          "id": "2279149",
          "text": "Come sappiamo tutti, non ci sono limiti alla perfezione.",
          "translation": "Для совершенства, как известно, нет предела.",
          "source": "Tatoeba #2279149 @al_ex_an_der / #2279127 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2279149",
          "cefr_level": "A1",
          "word_slugs": [
            "perfezione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la perfezione",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "opere-noun",
      "lemma": "opere",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5668,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2201332",
          "text": "Possono i computer tradurre opere letterarie?",
          "translation": "Могут ли компьютеры переводить литературные произведения?",
          "source": "Tatoeba #2201332 @miccap / #6535219 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2201332",
          "cefr_level": "A1",
          "word_slugs": [
            "opere-noun"
          ]
        },
        {
          "id": "7326886",
          "text": "Sono un grande ammiratore delle vostre opere.",
          "translation": "Я большой почитатель вашего творчества.",
          "source": "Tatoeba #7326886 @dnnywld / #7326179 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7326886",
          "cefr_level": "A1",
          "word_slugs": [
            "opere-noun"
          ]
        },
        {
          "id": "2514720",
          "text": "Questo romanzo fu una delle sue ultime opere.",
          "translation": "Этот роман был одним из её последних произведений.",
          "source": "Tatoeba #2514720 @al_ex_an_der / #2514750 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2514720",
          "cefr_level": "A1",
          "word_slugs": [
            "opere-noun"
          ]
        },
        {
          "id": "2514783",
          "text": "Questo romanzo fu una delle loro ultime opere.",
          "translation": "Этот роман был одним из их последних произведений.",
          "source": "Tatoeba #2514783 @al_ex_an_der / #2514760 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2514783",
          "cefr_level": "A1",
          "word_slugs": [
            "opere-noun"
          ]
        },
        {
          "id": "5520420",
          "text": "Tra questi libri ho visto le grandi opere di poeti e pensatori.",
          "translation": "Среди этих книг я увидел произведения великих поэтов и мыслителей.",
          "source": "Tatoeba #5520420 @dnnywld / #2501860 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5520420",
          "cefr_level": "A1",
          "word_slugs": [
            "opere-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la opere",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "soggiorno-noun",
      "lemma": "soggiorno",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5669,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5551333",
          "text": "Ritornammo nel soggiorno.",
          "translation": "Мы пошли обратно в гостиную.",
          "source": "Tatoeba #5551333 @dnnywld / #5550978 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551333",
          "cefr_level": "A1",
          "word_slugs": [
            "soggiorno-noun"
          ]
        },
        {
          "id": "891008",
          "text": "Posso estendere il mio soggiorno?",
          "translation": "Можно ли продлить моё пребывание?",
          "source": "Tatoeba #891008 @Guybrush88 / #3567322 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/891008",
          "cefr_level": "A1",
          "word_slugs": [
            "soggiorno-noun"
          ]
        },
        {
          "id": "2233818",
          "text": "Posso prolungare il mio soggiorno?",
          "translation": "Можно ли продлить моё пребывание?",
          "source": "Tatoeba #2233818 @Guybrush88 / #3567322 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2233818",
          "cefr_level": "A1",
          "word_slugs": [
            "soggiorno-noun"
          ]
        },
        {
          "id": "7326976",
          "text": "Voglio prender soggiorno all'hotel \"Hilton\".",
          "translation": "Я хочу остановиться в отеле «Хилтон».",
