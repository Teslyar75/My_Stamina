    {
      "slug": "sfuggito-adj",
      "lemma": "sfuggito",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7001,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6790473",
          "text": "Scusa, mi è sfuggito involontariamente.",
          "translation": "Прости, случайно вырвалось.",
          "source": "Tatoeba #6790473 @dnnywld / #6561026 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790473",
          "cefr_level": "A1",
          "word_slugs": [
            "sfuggito-adj"
          ]
        },
        {
          "id": "11438146",
          "text": "Nessuno è mai sfuggito al destino.",
          "translation": "Никому ещё не удавалось убежать от судьбы.",
          "source": "Tatoeba #11438146 @Bernie75 / #2029754 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11438146",
          "cefr_level": "A1",
          "word_slugs": [
            "sfuggito-adj"
          ]
        },
        {
          "id": "6804030",
          "text": "Lui a malapena è sfuggito alla morte.",
          "translation": "Он едва избежал смерти.",
          "source": "Tatoeba #6804030 @dnnywld / #1745308 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804030",
          "cefr_level": "A1",
          "word_slugs": [
            "sfuggito-adj"
          ]
        },
        {
          "id": "6804034",
          "text": "Lui è malapena sfuggito ad un omicidio.",
          "translation": "Он едва избежал гибели.",
          "source": "Tatoeba #6804034 @dnnywld / #1966719 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804034",
          "cefr_level": "A1",
          "word_slugs": [
            "sfuggito-adj"
          ]
        },
        {
          "id": "5424688",
          "text": "Il senso della sua frase mi è sfuggito.",
          "translation": "Смысл его фраз от меня ускользнул.",
          "source": "Tatoeba #5424688 @dnnywld / #4729551 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5424688",
          "cefr_level": "A1",
          "word_slugs": [
            "sfuggito-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
