    {
      "slug": "disegnare-verb",
      "lemma": "disegnare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7495,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5680878",
          "text": "Voglio disegnare un tramonto.",
          "translation": "Я хочу нарисовать закат.",
          "source": "Tatoeba #5680878 @dnnywld / #5680190 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5680878",
          "cefr_level": "A1",
          "word_slugs": [
            "disegnare-verb"
          ]
        },
        {
          "id": "5489655",
          "text": "Non so assolutamente disegnare.",
          "translation": "Я совсем не умею рисовать.",
          "source": "Tatoeba #5489655 @dnnywld / #5488268 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489655",
          "cefr_level": "A1",
          "word_slugs": [
            "disegnare-verb"
          ]
        },
        {
          "id": "13649017",
          "text": "Non so disegnare a memoria.",
          "translation": "Я не умею рисовать по памяти.",
          "source": "Tatoeba #13649017 @carlosalberto / #13648957 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13649017",
          "cefr_level": "A1",
          "word_slugs": [
            "disegnare-verb"
          ]
        },
        {
          "id": "5476923",
          "text": "A Mary piace disegnare piccoli gattini.",
          "translation": "Мэри любит рисовать маленьких котят.",
          "source": "Tatoeba #5476923 @dnnywld / #5475721 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476923",
          "cefr_level": "A1",
          "word_slugs": [
            "disegnare-verb"
          ]
        },
        {
          "id": "10758746",
          "text": "Non sono capace di disegnare un uccello.",
          "translation": "Я не умею рисовать птиц.",
          "source": "Tatoeba #10758746 @dnnywld / #5804208 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10758746",
          "cefr_level": "A1",
          "word_slugs": [
            "disegnare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
