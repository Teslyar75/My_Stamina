    {
      "slug": "amate-adj",
      "lemma": "amate",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9057,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "916307",
          "text": "Amate il caffè.",
          "translation": "Вы любите кофе.",
          "source": "Tatoeba #916307 @Guybrush88 / #3220081 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/916307",
          "cefr_level": "A1",
          "word_slugs": [
            "amate-adj"
          ]
        },
        {
          "id": "5694340",
          "text": "Amate ancora Tom?",
          "translation": "Вы всё ещё любите Тома?",
          "source": "Tatoeba #5694340 @dnnywld / #5693743 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5694340",
          "cefr_level": "A1",
          "word_slugs": [
            "amate-adj"
          ]
        },
        {
          "id": "5804458",
          "text": "Mi amate davvero?",
          "translation": "Вы меня правда любите?",
          "source": "Tatoeba #5804458 @Guybrush88 / #6680138 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5804458",
          "cefr_level": "A1",
          "word_slugs": [
            "amate-adj"
          ]
        },
        {
          "id": "2510501",
          "text": "Non mi amate più?",
          "translation": "Разве вы больше меня не любите?",
          "source": "Tatoeba #2510501 @Guybrush88 / #6954401 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2510501",
          "cefr_level": "A1",
          "word_slugs": [
            "amate-adj"
          ]
        },
