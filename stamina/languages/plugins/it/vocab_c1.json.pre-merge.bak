          "cefr_level": "A1",
          "word_slugs": [
            "riservato-verb"
          ]
        },
        {
          "id": "5199874",
          "text": "Lui è molto riservato.",
          "translation": "Он очень скрытный.",
          "source": "Tatoeba #5199874 @Guybrush88 / #5143734 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5199874",
          "cefr_level": "A1",
          "word_slugs": [
            "riservato-verb"
          ]
        },
        {
          "id": "5964419",
          "text": "Ho riservato un posto.",
          "translation": "Я забронировала место.",
          "source": "Tatoeba #5964419 @dnnywld / #5963169 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964419",
          "cefr_level": "A1",
          "word_slugs": [
            "riservato-verb"
          ]
        },
        {
          "id": "5666980",
          "text": "Hai riservato un tavolo?",
          "translation": "Ты забронировал столик?",
          "source": "Tatoeba #5666980 @dnnywld / #5666536 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5666980",
          "cefr_level": "A1",
          "word_slugs": [
            "riservato-verb"
          ]
        },
        {
          "id": "10918334",
          "text": "Questo tavolo è riservato.",
          "translation": "Этот столик занят.",
          "source": "Tatoeba #10918334 @dnnywld / #8056687 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10918334",
          "cefr_level": "A1",
          "word_slugs": [
            "riservato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
