    {
      "slug": "verificare-verb",
      "lemma": "verificare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6358,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "11460590",
          "text": "Fidarsi... ma verificare.",
          "translation": "Доверяй, но проверяй.",
          "source": "Tatoeba #11460590 @Bernie75 / #1745041 @zalaim (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11460590",
          "cefr_level": "A1",
          "word_slugs": [
            "verificare-verb"
          ]
        },
        {
          "id": "5598534",
          "text": "Dovremo verificare questo.",
          "translation": "Нам надо будет это проверить.",
          "source": "Tatoeba #5598534 @dnnywld / #5598501 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5598534",
          "cefr_level": "A1",
          "word_slugs": [
            "verificare-verb"
          ]
        },
        {
          "id": "6375277",
          "text": "È facile da verificare.",
          "translation": "Это несложно проверить.",
          "source": "Tatoeba #6375277 @dnnywld / #6375222 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6375277",
          "cefr_level": "A1",
          "word_slugs": [
            "verificare-verb"
          ]
        },
        {
          "id": "6375276",
          "text": "Ci vuole poco per verificare.",
          "translation": "Это недолго проверить.",
          "source": "Tatoeba #6375276 @dnnywld / #6375223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6375276",
          "cefr_level": "A1",
          "word_slugs": [
            "verificare-verb"
          ]
        },
        {
          "id": "5594288",
          "text": "È necessario verificare se tutte le condizioni sono soddisfatte.",
          "translation": "Нужно выяснить, все ли условия выполнены.",
          "source": "Tatoeba #5594288 @dnnywld / #5594026 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5594288",
          "cefr_level": "A1",
          "word_slugs": [
            "verificare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "verificare",
        "plural": "",
        "infinitive": "verificare"
      }
