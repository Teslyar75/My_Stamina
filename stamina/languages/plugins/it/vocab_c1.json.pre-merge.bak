    {
      "slug": "fulmine-noun",
      "lemma": "fulmine",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6734,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5519111",
          "text": "Un fulmine illuminò il cielo.",
          "translation": "Молния осветила небо.",
          "source": "Tatoeba #5519111 @dnnywld / #5518878 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5519111",
          "cefr_level": "A1",
          "word_slugs": [
            "fulmine-noun"
          ]
        },
        {
          "id": "7554319",
          "text": "Un fulmine ha colpito la casa.",
          "translation": "В дом попала молния.",
          "source": "Tatoeba #7554319 @dnnywld / #7553878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7554319",
          "cefr_level": "A1",
          "word_slugs": [
            "fulmine-noun"
          ]
        },
        {
          "id": "7554320",
          "text": "Un fulmine ha colpito l'albero.",
          "translation": "В дерево попала молния.",
          "source": "Tatoeba #7554320 @dnnywld / #7553877 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7554320",
          "cefr_level": "A1",
          "word_slugs": [
            "fulmine-noun"
          ]
        },
        {
          "id": "4102387",
          "text": "Sono stato colpito da un fulmine.",
          "translation": "В меня ударила молния.",
          "source": "Tatoeba #4102387 @valealb / #4102548 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4102387",
          "cefr_level": "A1",
          "word_slugs": [
            "fulmine-noun"
          ]
        },
        {
          "id": "6083535",
          "text": "Un fulmine si è schiantato sull'albero.",
          "translation": "Молния ударила в дерево.",
          "source": "Tatoeba #6083535 @dnnywld / #6082640 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6083535",
          "cefr_level": "A1",
          "word_slugs": [
            "fulmine-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il fulmine",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "centinaio-noun",
      "lemma": "centinaio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6735,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5462090",
          "text": "Finora ho letto un centinaio di libri.",
          "translation": "Пока я прочитала около сотни книг.",
          "source": "Tatoeba #5462090 @dnnywld / #5461389 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5462090",
          "cefr_level": "A1",
          "word_slugs": [
            "centinaio-noun"
          ]
        },
        {
          "id": "10817271",
          "text": "Lui ha raccolto un centinaio di lumache.",
          "translation": "Он набрал сотню улиток.",
          "source": "Tatoeba #10817271 @dnnywld / #10817265 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10817271",
          "cefr_level": "A1",
          "word_slugs": [
            "centinaio-noun"
          ]
        },
        {
          "id": "5534337",
          "text": "Nel computer ho un centinaio di cartelle musicali.",
          "translation": "У меня на компьютере сотни папок с музыкой.",
          "source": "Tatoeba #5534337 @dnnywld / #5533581 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5534337",
          "cefr_level": "A1",
          "word_slugs": [
            "centinaio-noun"
          ]
        },
        {
          "id": "5683648",
          "text": "Sono venute qui più di un centinaio di persone.",
          "translation": "Сюда пришли более ста человек.",
          "source": "Tatoeba #5683648 @dnnywld / #5682237 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683648",
          "cefr_level": "A1",
          "word_slugs": [
            "centinaio-noun"
          ]
        },
        {
          "id": "3214524",
          "text": "Lui bacia suo figlio un centinaio di volte al giorno.",
          "translation": "Он целует своего сына сотню раз за день.",
          "source": "Tatoeba #3214524 @Guybrush88 / #3214534 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3214524",
          "cefr_level": "A1",
          "word_slugs": [
            "centinaio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il centinaio",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "corse-adj",
      "lemma": "corse",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6736,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3674274",
          "text": "Il soldato corse.",
          "translation": "Солдат бежал.",
          "source": "Tatoeba #3674274 @Guybrush88 / #5699976 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3674274",
          "cefr_level": "A1",
          "word_slugs": [
            "corse-adj"
          ]
        },
        {
          "id": "5677876",
          "text": "Tom corse di sotto.",
          "translation": "Том побежал вниз.",
          "source": "Tatoeba #5677876 @dnnywld / #5677062 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677876",
          "cefr_level": "A1",
          "word_slugs": [
            "corse-adj"
          ]
        },
        {
          "id": "6468818",
          "text": "Vedendomi, lei corse via.",
          "translation": "Увидев меня, она убежала.",
          "source": "Tatoeba #6468818 @dnnywld / #3406408 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6468818",
          "cefr_level": "A1",
          "word_slugs": [
            "corse-adj"
          ]
        },
        {
          "id": "908842",
          "text": "Corse via con le uova.",
          "translation": "Она убежала с яйцами.",
          "source": "Tatoeba #908842 @Guybrush88 / #3198319 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/908842",
          "cefr_level": "A1",
          "word_slugs": [
            "corse-adj"
          ]
        },
        {
          "id": "5606783",
          "text": "Tom ha vinto tre corse.",
          "translation": "Том выиграл три гонки.",
          "source": "Tatoeba #5606783 @dnnywld / #5606735 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5606783",
          "cefr_level": "A1",
          "word_slugs": [
