          ]
        },
        {
          "id": "10484543",
          "text": "Ciò richiede un'abilità speciale.",
          "translation": "Здесь нужен особый навык.",
          "source": "Tatoeba #10484543 @carlosalberto / #4238633 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10484543",
          "cefr_level": "A1",
          "word_slugs": [
            "abilità-noun"
          ]
        },
        {
          "id": "5658777",
          "text": "Tom ha delle abilità musicali uniche.",
          "translation": "У Тома уникальные музыкальные способности.",
          "source": "Tatoeba #5658777 @dnnywld / #5658747 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5658777",
          "cefr_level": "A1",
          "word_slugs": [
            "abilità-noun"
          ]
        },
        {
          "id": "5650041",
          "text": "Il nuoto è un'abilità molto utile.",
          "translation": "Плавание — очень полезный навык.",
          "source": "Tatoeba #5650041 @dnnywld / #5649052 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650041",
          "cefr_level": "A1",
          "word_slugs": [
            "abilità-noun"
          ]
        },
        {
          "id": "5589460",
          "text": "Ho sviluppato questa abilità col passare degli anni.",
          "translation": "Это умение развивалось у меня с годами.",
          "source": "Tatoeba #5589460 @dnnywld / #2322127 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589460",
          "cefr_level": "A1",
          "word_slugs": [
            "abilità-noun"
          ]
        }
