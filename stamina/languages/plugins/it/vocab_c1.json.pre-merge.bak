      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2780100",
          "text": "La sua testa era grigia.",
          "translation": "Его голова была седой.",
          "source": "Tatoeba #2780100 @Guybrush88 / #3305071 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2780100",
          "cefr_level": "A1",
          "word_slugs": [
            "grigia-adj"
          ]
        },
        {
          "id": "6881718",
          "text": "La strada era grigia di polvere.",
          "translation": "Дорога была серой от пыли.",
          "source": "Tatoeba #6881718 @dnnywld / #6881314 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881718",
          "cefr_level": "A1",
          "word_slugs": [
            "grigia-adj"
          ]
        },
        {
          "id": "5507165",
          "text": "Mio padre ha una cravatta azzurra e grigia.",
          "translation": "Мой отец имеет галстук, голубой с серым.",
          "source": "Tatoeba #5507165 @dnnywld / #1431058 @Snark (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507165",
          "cefr_level": "A1",
          "word_slugs": [
            "grigia-adj"
          ]
        },
        {
          "id": "5424700",
          "text": "Tom ha dato a Mary una grossa busta grigia.",
          "translation": "Том передал Мэри толстый серый конверт.",
          "source": "Tatoeba #5424700 @dnnywld / #4810084 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5424700",
          "cefr_level": "A1",
          "word_slugs": [
            "grigia-adj"
          ]
        },
        {
          "id": "6149881",
          "text": "C'era una volta dalla nonna una capra grigia...",
          "translation": "Жил-был у бабушки серенький козлик...",
          "source": "Tatoeba #6149881 @dnnywld / #5354795 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6149881",
