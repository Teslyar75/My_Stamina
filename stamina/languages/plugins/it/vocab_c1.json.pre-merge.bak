    {
      "slug": "visitatori-noun",
      "lemma": "visitatori",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7896,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3640920",
          "text": "I visitatori non possono dare da mangiare agli animali.",
          "translation": "Посетители не могут кормить животных.",
          "source": "Tatoeba #3640920 @Guybrush88 / #3640923 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3640920",
          "cefr_level": "A1",
          "word_slugs": [
            "visitatori-noun"
          ]
        },
        {
          "id": "5714019",
          "text": "Ogni anno mille visitatori da tutto il mondo arrivano a Kioto.",
          "translation": "Каждый год тысячи посетителей со всего мира приезжают в Киото.",
          "source": "Tatoeba #5714019 @michelangelo / #2774443 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5714019",
          "cefr_level": "A1",
          "word_slugs": [
            "visitatori-noun"
          ]
        },
        {
          "id": "7003066",
          "text": "A giudicare dalle opinioni dei visitatori questo è un ottimo ristorante.",
          "translation": "Судя по отзывам посетителей, это очень хороший ресторан.",
          "source": "Tatoeba #7003066 @dnnywld / #6331196 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7003066",
          "cefr_level": "A1",
          "word_slugs": [
            "visitatori-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il visitatori",
        "plural": "",
        "infinitive": ""
      }
    },
