          ]
        },
        {
          "id": "5483037",
          "text": "La vulva è la parte esterna della vagina.",
          "translation": "Вульва — наружная часть влагалища.",
          "source": "Tatoeba #5483037 @dnnywld / #5482960 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5483037",
          "cefr_level": "A1",
          "word_slugs": [
            "vagina-noun"
          ]
        },
        {
          "id": "6138149",
          "text": "Tom non conosce la differenza tra un vagone e una vagina.",
          "translation": "Том не знает разницы между вагоном и вагиной.",
          "source": "Tatoeba #6138149 @dnnywld / #6137472 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6138149",
          "cefr_level": "A1",
          "word_slugs": [
            "vagina-noun"
          ]
        }
      ],
