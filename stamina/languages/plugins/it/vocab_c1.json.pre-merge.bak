    {
      "slug": "agosto-adj",
      "lemma": "agosto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5877,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3398251",
          "text": "È già agosto.",
          "translation": "Уже август.",
          "source": "Tatoeba #3398251 @Guybrush88 / #3786917 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3398251",
          "cefr_level": "A1",
          "word_slugs": [
            "agosto-adj"
          ]
        },
        {
          "id": "2416861",
          "text": "Era una bella sera d'agosto.",
          "translation": "Был прекрасный августовский вечер.",
          "source": "Tatoeba #2416861 @al_ex_an_der / #2416852 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2416861",
          "cefr_level": "A1",
          "word_slugs": [
            "agosto-adj"
          ]
        },
        {
          "id": "383745",
          "text": "In agosto non ci sono lezioni.",
          "translation": "В августе занятий нет.",
          "source": "Tatoeba #383745 @Pharamp / #574005 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/383745",
          "cefr_level": "A1",
          "word_slugs": [
            "agosto-adj"
          ]
        },
        {
          "id": "5577242",
          "text": "In agosto sono stato in campeggio.",
          "translation": "В августе я ходил в поход.",
          "source": "Tatoeba #5577242 @dnnywld / #5577118 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5577242",
          "cefr_level": "A1",
          "word_slugs": [
            "agosto-adj"
          ]
        },
        {
          "id": "3633453",
          "text": "Agosto è l'ottavo mese dell'anno.",
          "translation": "Август - восьмой месяц года.",
          "source": "Tatoeba #3633453 @Tradukero / #5161610 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3633453",
          "cefr_level": "A1",
          "word_slugs": [
            "agosto-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "agosto",
        "plural": "",
        "infinitive": ""
      }
