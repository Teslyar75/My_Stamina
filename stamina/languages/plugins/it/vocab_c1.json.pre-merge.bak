      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5477423",
          "text": "Il cibo sta finendo.",
          "translation": "Еда кончается.",
          "source": "Tatoeba #5477423 @dnnywld / #5477325 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5477423",
          "cefr_level": "A1",
          "word_slugs": [
            "finendo-verb"
          ]
        },
        {
          "id": "6714322",
          "text": "L'acqua sta finendo.",
          "translation": "Вода заканчивается.",
          "source": "Tatoeba #6714322 @dnnywld / #6712660 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6714322",
