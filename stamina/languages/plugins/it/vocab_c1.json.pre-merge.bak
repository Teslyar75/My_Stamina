    {
      "slug": "negozi-noun",
      "lemma": "negozi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5226,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5973579",
          "text": "I negozi sono aperti!",
          "translation": "Магазины закрыты!",
          "source": "Tatoeba #5973579 @dnnywld / #5973033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5973579",
          "cefr_level": "A1",
          "word_slugs": [
            "negozi-noun"
          ]
        },
        {
          "id": "6823191",
          "text": "Quando aprono i negozi?",
          "translation": "Когда открываются магазины?",
          "source": "Tatoeba #6823191 @Guybrush88 / #2318177 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6823191",
          "cefr_level": "A1",
          "word_slugs": [
            "negozi-noun"
          ]
        },
        {
          "id": "6007326",
          "text": "La domenica i negozi sono chiusi.",
          "translation": "В воскресенье магазины закрыты.",
          "source": "Tatoeba #6007326 @dnnywld / #6006855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6007326",
          "cefr_level": "A1",
          "word_slugs": [
            "negozi-noun"
          ]
        },
        {
          "id": "5565781",
          "text": "I negozi hanno chiuso alle cinque.",
          "translation": "Магазин закрыли в пять.",
          "source": "Tatoeba #5565781 @dnnywld / #5565276 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5565781",
          "cefr_level": "A1",
          "word_slugs": [
            "negozi-noun"
          ]
        },
        {
          "id": "6007327",
          "text": "La domenica i negozi non lavorano.",
          "translation": "В воскресенье магазины не работают.",
          "source": "Tatoeba #6007327 @dnnywld / #6006854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6007327",
          "cefr_level": "A1",
          "word_slugs": [
            "negozi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il negozi",
        "plural": "",
        "infinitive": ""
      }
