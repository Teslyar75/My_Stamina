    {
      "slug": "guaio-noun",
      "lemma": "guaio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5576,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5557817",
          "text": "Questo è il guaio.",
          "translation": "В этом и беда.",
          "source": "Tatoeba #5557817 @dnnywld / #5557791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5557817",
          "cefr_level": "A1",
          "word_slugs": [
            "guaio-noun"
          ]
        },
        {
          "id": "5543252",
          "text": "Ho avuto qualche guaio.",
          "translation": "У меня были кое-какие неприятности.",
          "source": "Tatoeba #5543252 @dnnywld / #5542554 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5543252",
          "cefr_level": "A1",
          "word_slugs": [
            "guaio-noun"
          ]
        },
        {
          "id": "5614456",
          "text": "È soltanto un piccolo guaio.",
          "translation": "Это всего лишь мелкая неудача.",
          "source": "Tatoeba #5614456 @dnnywld / #2528433 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614456",
          "cefr_level": "A1",
          "word_slugs": [
            "guaio-noun"
          ]
        },
        {
          "id": "5619557",
          "text": "Se qualche guaio può succedere, succede.",
          "translation": "Ежели какая-нибудь неприятность может случиться, она случается.",
          "source": "Tatoeba #5619557 @dnnywld / #4883691 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619557",
          "cefr_level": "A1",
          "word_slugs": [
            "guaio-noun"
          ]
        },
        {
          "id": "5766758",
          "text": "Alcuni ritengono che di venerdì tredici accada necessariamente qualche guaio.",
          "translation": "Некоторые верят, что в пятницу тринадцатого числа обязательно случаются какие-то неприятности.",
          "source": "Tatoeba #5766758 @dnnywld / #5766740 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5766758",
          "cefr_level": "A1",
          "word_slugs": [
            "guaio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il guaio",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "romantica-adj",
      "lemma": "romantica",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5577,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6141858",
          "text": "Questo ristorante italiano ha un'atmosfera romantica.",
          "translation": "В этом итальянском ресторане романтичная атмосфера.",
          "source": "Tatoeba #6141858 @Guybrush88 / #11120113 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6141858",
          "cefr_level": "A1",
          "word_slugs": [
            "romantica-adj"
          ]
        },
        {
          "id": "10844075",
          "text": "Togliti dalla testa tutta questa romantica farneticazione.",
          "translation": "Выбрось из головы весь этот романтический бред.",
