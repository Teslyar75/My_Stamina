    {
      "slug": "pancake-noun",
      "lemma": "pancake",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7421,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6852818",
          "text": "Gira il pancake.",
          "translation": "Переверни блин.",
          "source": "Tatoeba #6852818 @dnnywld / #6852590 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6852818",
          "cefr_level": "A1",
          "word_slugs": [
            "pancake-noun"
          ]
        },
        {
          "id": "6852817",
          "text": "Tom ha bruciato i pancake.",
          "translation": "У Тома блины подгорели.",
          "source": "Tatoeba #6852817 @dnnywld / #6852591 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6852817",
          "cefr_level": "A1",
          "word_slugs": [
            "pancake-noun"
          ]
        },
        {
          "id": "5560160",
          "text": "Vieni da me a mangiare i pancake?",
          "translation": "Придёшь ко мне есть блинчики?",
          "source": "Tatoeba #5560160 @dnnywld / #378251 @Dorenda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5560160",
          "cefr_level": "A1",
          "word_slugs": [
            "pancake-noun"
          ]
        },
        {
          "id": "5619571",
          "text": "Avete mai visto come l'ingegnere cuoce i pancake?",
          "translation": "Вы когда-нибудь видели, как инженер печёт блины?",
          "source": "Tatoeba #5619571 @dnnywld / #5372046 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619571",
          "cefr_level": "A1",
          "word_slugs": [
            "pancake-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il pancake",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "gelosia-noun",
      "lemma": "gelosia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7423,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6804202",
          "text": "Mary a fatica nascose la gelosia.",
          "translation": "Мэри с трудом скрывала ревность.",
          "source": "Tatoeba #6804202 @dnnywld / #3018091 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804202",
          "cefr_level": "A1",
          "word_slugs": [
            "gelosia-noun"
          ]
        },
        {
          "id": "5985191",
          "text": "La gelosia è il sentimento più distruttivo.",
          "translation": "Зависть - разрушающее чувство.",
          "source": "Tatoeba #5985191 @dnnywld / #4957214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5985191",
          "cefr_level": "A1",
          "word_slugs": [
            "gelosia-noun"
          ]
        },
        {
          "id": "5532315",
          "text": "La gelosia lo ha portato ad agire così.",
          "translation": "Ревность его до этого довела.",
          "source": "Tatoeba #5532315 @dnnywld / #4004325 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5532315",
          "cefr_level": "A1",
          "word_slugs": [
            "gelosia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la gelosia",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "gallina-noun",
      "lemma": "gallina",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7424,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "4538419",
          "text": "La gallina chioccia.",
          "translation": "Курица квохчет.",
          "source": "Tatoeba #4538419 @Guybrush88 / #4539190 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538419",
          "cefr_level": "A1",
          "word_slugs": [
            "gallina-noun"
          ]
        },
        {
          "id": "4538420",
          "text": "La gallina schiamazza.",
          "translation": "Курица кудахчет.",
          "source": "Tatoeba #4538420 @Guybrush88 / #2529256 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538420",
          "cefr_level": "A1",
          "word_slugs": [
            "gallina-noun"
          ]
        },
        {
          "id": "5812578",
          "text": "Stamattina la gallina ha deposto un uovo.",
          "translation": "Сегодня утром курица снесла яйцо.",
          "source": "Tatoeba #5812578 @dnnywld / #5812531 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5812578",
          "cefr_level": "A1",
          "word_slugs": [
            "gallina-noun"
          ]
        },
        {
          "id": "6736673",
          "text": "Quante uova alla settimana depone questa gallina?",
          "translation": "Сколько яиц в неделю откладывает эта курица?",
          "source": "Tatoeba #6736673 @dnnywld / #6735979 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6736673",
          "cefr_level": "A1",
          "word_slugs": [
            "gallina-noun"
          ]
        },
        {
          "id": "631240",
          "text": "È nato prima l'uovo o la gallina?",
          "translation": "Что было раньше — курица или яйцо?",
          "source": "Tatoeba #631240 @Guybrush88 / #3165851 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/631240",
          "cefr_level": "A1",
          "word_slugs": [
            "gallina-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la gallina",
        "plural": "",
        "infinitive": ""
      }
    },
