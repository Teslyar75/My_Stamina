    {
      "slug": "funghi-noun",
      "lemma": "funghi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7000,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5676773",
          "text": "I funghi disperdono spore.",
          "translation": "Грибы распространяют споры.",
          "source": "Tatoeba #5676773 @dnnywld / #5676521 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5676773",
          "cefr_level": "A1",
          "word_slugs": [
            "funghi-noun"
          ]
        },
        {
          "id": "7554327",
          "text": "Abbiamo raccolto dei funghi.",
          "translation": "Мы собрали грибы.",
          "source": "Tatoeba #7554327 @dnnywld / #7553868 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7554327",
          "cefr_level": "A1",
          "word_slugs": [
            "funghi-noun"
          ]
        },
        {
          "id": "5472310",
          "text": "Non mi piacciono i funghi.",
          "translation": "Я не люблю грибы.",
          "source": "Tatoeba #5472310 @dnnywld / #5360889 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472310",
          "cefr_level": "A1",
          "word_slugs": [
            "funghi-noun"
          ]
        },
        {
          "id": "12863244",
          "text": "Ho preparato della zuppa ai funghi.",
          "translation": "Я приготовил грибной суп.",
          "source": "Tatoeba #12863244 @Guybrush88 / #14099605 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12863244",
          "cefr_level": "A1",
          "word_slugs": [
            "funghi-noun"
          ]
        },
        {
          "id": "5513000",
          "text": "Non mi sento bene dopo questi funghi.",
          "translation": "Что-то мне после этих грибов нехорошо.",
          "source": "Tatoeba #5513000 @dnnywld / #5512497 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513000",
          "cefr_level": "A1",
          "word_slugs": [
            "funghi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il funghi",
        "plural": "",
        "infinitive": ""
      }
