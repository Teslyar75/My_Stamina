    {
      "slug": "verrebbe-verb",
      "lemma": "verrebbe",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6751,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6727087",
          "text": "Mary ha detto che domani verrebbe.",
          "translation": "Мэри сказала, что завтра придёт.",
          "source": "Tatoeba #6727087 @dnnywld / #6726769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6727087",
          "cefr_level": "A1",
          "word_slugs": [
            "verrebbe-verb"
          ]
        },
        {
          "id": "7633823",
          "text": "Tom non verrebbe con me in Australia.",
          "translation": "Том не поехал бы со мной в Австралию.",
          "source": "Tatoeba #7633823 @dnnywld / #7633523 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7633823",
          "cefr_level": "A1",
          "word_slugs": [
            "verrebbe-verb"
          ]
        },
        {
          "id": "6956521",
          "text": "Tom verrebbe con noi a Boston se avesse tempo.",
          "translation": "Том бы поехал с нами в Бостон, если бы у него было время.",
          "source": "Tatoeba #6956521 @dnnywld / #6956345 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6956521",
          "cefr_level": "A1",
          "word_slugs": [
            "verrebbe-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "verrebbe",
        "plural": "",
        "infinitive": "verrebbe"
      }
