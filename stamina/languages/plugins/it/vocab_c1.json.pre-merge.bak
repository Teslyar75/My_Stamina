      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5508567",
          "text": "Il clown ha paura del buio.",
          "translation": "Клоун боится темноты.",
          "source": "Tatoeba #5508567 @dnnywld / #5508551 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5508567",
          "cefr_level": "A1",
          "word_slugs": [
            "clown-noun"
          ]
        },
        {
          "id": "5635121",
          "text": "Il clown fece una smorfia, e tutti risero.",
          "translation": "Клоун скорчил рожу, и все захохотали.",
          "source": "Tatoeba #5635121 @dnnywld / #5635101 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635121",
          "cefr_level": "A1",
          "word_slugs": [
            "clown-noun"
          ]
        },
        {
          "id": "6952171",
          "text": "Il circo se ne andò, ma i clown rimasero.",
          "translation": "Цирк уехал, а клоуны остались.",
          "source": "Tatoeba #6952171 @dnnywld / #5795388 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952171",
          "cefr_level": "A1",
          "word_slugs": [
            "clown-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
