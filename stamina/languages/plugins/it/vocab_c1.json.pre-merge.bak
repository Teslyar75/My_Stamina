    {
      "slug": "difetto-noun",
      "lemma": "difetto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8334,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3077642",
          "text": "Hai solo un difetto.",
          "translation": "У тебя только один недостаток.",
          "source": "Tatoeba #3077642 @Guybrush88 / #3077650 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3077642",
          "cefr_level": "A1",
          "word_slugs": [
            "difetto-noun"
          ]
        },
        {
          "id": "5616620",
          "text": "Ognuno ha qualche difetto.",
          "translation": "У каждого есть какой-нибудь недостаток.",
          "source": "Tatoeba #5616620 @dnnywld / #2513531 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616620",
          "cefr_level": "A1",
          "word_slugs": [
            "difetto-noun"
          ]
        },
        {
          "id": "5619391",
          "text": "Trovi in me sempre qualche difetto.",
          "translation": "Ты всегда находишь во мне какой-нибудь недостаток.",
          "source": "Tatoeba #5619391 @dnnywld / #2650482 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619391",
          "cefr_level": "A1",
          "word_slugs": [
            "difetto-noun"
          ]
        },
        {
          "id": "2486281",
          "text": "Ha qualche difetto, però mi piace comunque.",
          "translation": "У него есть некоторые недостатки, но все же он мне нравится.",
          "source": "Tatoeba #2486281 @Guybrush88 / #2210250 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2486281",
          "cefr_level": "A1",
          "word_slugs": [
            "difetto-noun"
          ]
        },
        {
          "id": "2486282",
          "text": "Lui ha qualche difetto, però mi piace comunque.",
          "translation": "У него есть некоторые недостатки, но все же он мне нравится.",
