      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10881671",
          "text": "La pressione è nella norma.",
          "translation": "Давление в норме.",
          "source": "Tatoeba #10881671 @dnnywld / #6949073 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10881671",
          "cefr_level": "A1",
          "word_slugs": [
            "norma-name"
          ]
        },
        {
          "id": "5836042",
          "text": "La follia è diventata la norma.",
