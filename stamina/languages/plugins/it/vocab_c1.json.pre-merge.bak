    {
      "slug": "economico-adj",
      "lemma": "economico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6463,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10933227",
          "text": "È ancora più economico.",
          "translation": "Это ещё дешевле.",
          "source": "Tatoeba #10933227 @dnnywld / #10933090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10933227",
          "cefr_level": "A1",
          "word_slugs": [
            "economico-adj"
          ]
        },
        {
          "id": "5463236",
          "text": "Quel vestito è economico.",
          "translation": "То платье дешёвое.",
          "source": "Tatoeba #5463236 @dnnywld / #5462605 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5463236",
          "cefr_level": "A1",
          "word_slugs": [
            "economico-adj"
          ]
        },
        {
          "id": "10793234",
          "text": "È tutto veramente economico.",
          "translation": "Всё действительно дёшево.",
          "source": "Tatoeba #10793234 @dnnywld / #2937596 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10793234",
          "cefr_level": "A1",
          "word_slugs": [
            "economico-adj"
          ]
        },
        {
          "id": "5624661",
          "text": "Più è economico, meglio è.",
          "translation": "Самая дешёвая — самая лучшая.",
          "source": "Tatoeba #5624661 @dnnywld / #4269138 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624661",
          "cefr_level": "A1",
          "word_slugs": [
            "economico-adj"
          ]
        },
        {
          "id": "5384578",
          "text": "In autobus è più economico.",
          "translation": "На автобусе дешевле.",
          "source": "Tatoeba #5384578 @dnnywld / #5384211 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384578",
          "cefr_level": "A1",
          "word_slugs": [
            "economico-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
