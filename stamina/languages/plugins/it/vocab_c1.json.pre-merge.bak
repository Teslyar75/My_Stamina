    {
      "slug": "viventi-adj",
      "lemma": "viventi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9911,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1083886",
          "text": "Ci sono degli esseri viventi su Marte?",
          "translation": "Есть ли на Марсе живые существа?",
          "source": "Tatoeba #1083886 @Guybrush88 / #6887595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1083886",
          "cefr_level": "A1",
          "word_slugs": [
            "viventi-adj"
          ]
        },
        {
          "id": "7976105",
          "text": "Tutte le cose viventi un giorno moriranno.",
          "translation": "Всё живое однажды умрёт.",
          "source": "Tatoeba #7976105 @dnnywld / #953030 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7976105",
          "cefr_level": "A1",
          "word_slugs": [
            "viventi-adj"
          ]
        },
        {
          "id": "5930302",
          "text": "Non devi uccidere creature viventi per il puro divertimento.",
          "translation": "Ты не должен убивать живых существ для развлечения.",
          "source": "Tatoeba #5930302 @dnnywld / #5930293 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5930302",
          "cefr_level": "A1",
          "word_slugs": [
            "viventi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
