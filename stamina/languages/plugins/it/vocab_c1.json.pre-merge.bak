    {
      "slug": "scomparire-verb",
      "lemma": "scomparire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7576,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6885182",
          "text": "Voglio scomparire da questo mondo.",
          "translation": "Я хочу исчезнуть из этого мира.",
          "source": "Tatoeba #6885182 @dnnywld / #4685701 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6885182",
          "cefr_level": "A1",
          "word_slugs": [
            "scomparire-verb"
          ]
        },
        {
          "id": "5527269",
          "text": "Ti do tre giorni per scomparire dalla mia vista.",
          "translation": "Даю тебе три дня, чтобы скрыться с глаз долой.",
          "source": "Tatoeba #5527269 @dnnywld / #4149150 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527269",
          "cefr_level": "A1",
          "word_slugs": [
            "scomparire-verb"
          ]
        },
        {
          "id": "2212330",
          "text": "Era assolutamente ovvio che cinque persone non potessero scomparire senza lasciare traccia.",
          "translation": "Было совершенно очевидно, что пять человек не могут исчезнуть бесследно.",
          "source": "Tatoeba #2212330 @al_ex_an_der / #2212299 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2212330",
          "cefr_level": "A1",
          "word_slugs": [
            "scomparire-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "scomparire",
        "plural": "",
        "infinitive": "scomparire"
      }
