      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "379523",
          "text": "Buon San Valentino!",
          "translation": "С Днем Святого Валентина!",
          "source": "Tatoeba #379523 @Pharamp / #1430448 @tania_soleil (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379523",
          "cefr_level": "A1",
          "word_slugs": [
            "valentino-name"
          ]
        },
        {
          "id": "5549627",
          "text": "Non vedo l'ora del giorno di San Valentino.",
          "translation": "Жду не дождусь Валентинова дня!",
          "source": "Tatoeba #5549627 @dnnywld / #2805564 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549627",
          "cefr_level": "A1",
          "word_slugs": [
            "valentino-name"
          ]
        },
        {
          "id": "1158659",
          "text": "Il 14 febbraio gli americani festeggiano il giorno di San Valentino.",
          "translation": "14 февраля американцы празднуют День святого Валентина.",
          "source": "Tatoeba #1158659 @riccioberto / #649848 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1158659",
          "cefr_level": "A1",
          "word_slugs": [
            "valentino-name"
          ]
        }
      ],
