    {
      "slug": "distributore-noun",
      "lemma": "distributore",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8671,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10849593",
          "text": "Questo distributore automatico non funziona.",
          "translation": "Этот автомат не работает.",
          "source": "Tatoeba #10849593 @dnnywld / #569788 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849593",
          "cefr_level": "A1",
          "word_slugs": [
            "distributore-noun"
          ]
        },
        {
          "id": "10849592",
          "text": "Il distributore automatico è fuori servizio.",
          "translation": "Торговый автомат неисправен.",
          "source": "Tatoeba #10849592 @dnnywld / #2420441 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849592",
          "cefr_level": "A1",
          "word_slugs": [
            "distributore-noun"
          ]
        },
        {
          "id": "6950113",
          "text": "Hanno installato un distributore automatico al lavoro.",
          "translation": "На работе поставили торговый автомат.",
          "source": "Tatoeba #6950113 @dnnywld / #438195 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950113",
          "cefr_level": "A1",
          "word_slugs": [
            "distributore-noun"
          ]
        },
        {
          "id": "10851847",
          "text": "Una volta qui c'era un distributore di benzina.",
          "translation": "Раньше здесь была бензоколонка.",
          "source": "Tatoeba #10851847 @dnnywld / #9509281 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851847",
          "cefr_level": "A1",
          "word_slugs": [
            "distributore-noun"
          ]
        },
        {
          "id": "5542498",
          "text": "Mi hanno aiutato a spingere la macchina fino al distributore.",
          "translation": "Они помогли мне дотолкать машину до заправки.",
          "source": "Tatoeba #5542498 @dnnywld / #5542455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5542498",
          "cefr_level": "A1",
          "word_slugs": [
            "distributore-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "distributore",
        "plural": "",
        "infinitive": ""
      }
