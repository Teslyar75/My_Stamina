          ]
        },
        {
          "id": "7277992",
          "text": "Vi assicuro che saprò difendermi da solo.",
          "translation": "Уверяю вас, я смогу за себя постоять.",
          "source": "Tatoeba #7277992 @dnnywld / #4238898 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7277992",
          "cefr_level": "A1",
          "word_slugs": [
            "saprò-verb"
          ]
        }
      ],
      "tags": [
