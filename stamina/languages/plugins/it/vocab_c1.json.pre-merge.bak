    {
      "slug": "comodi-adj",
      "lemma": "comodi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9589,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10755692",
          "text": "Qui starete comodi.",
          "translation": "Здесь вам будет удобно.",
          "source": "Tatoeba #10755692 @dnnywld / #10755636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10755692",
          "cefr_level": "A1",
          "word_slugs": [
            "comodi-adj"
          ]
        },
        {
          "id": "5643876",
          "text": "Spero che starete comodi.",
          "translation": "Надеюсь, вам будет удобно.",
          "source": "Tatoeba #5643876 @dnnywld / #5642438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643876",
          "cefr_level": "A1",
          "word_slugs": [
            "comodi-adj"
          ]
        },
        {
          "id": "10916384",
          "text": "I dizionari elettronici sono più comodi da utilizzare.",
          "translation": "Электронными словарями пользоваться удобнее.",
          "source": "Tatoeba #10916384 @dnnywld / #10915635 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10916384",
          "cefr_level": "A1",
          "word_slugs": [
            "comodi-adj"
          ]
        },
        {
          "id": "10916395",
          "text": "I dizionari elettronici sono più comodi di quelli cartacei.",
          "translation": "Электронные словари удобнее бумажных.",
          "source": "Tatoeba #10916395 @dnnywld / #10915629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10916395",
          "cefr_level": "A1",
          "word_slugs": [
            "comodi-adj"
          ]
        },
        {
          "id": "10916391",
          "text": "I dizionari elettronici sono più comodi da utilizzare rispetto a quelli cartacei.",
          "translation": "Электронными словарями пользоваться удобнее, чем бумажными.",
          "source": "Tatoeba #10916391 @dnnywld / #10915631 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10916391",
          "cefr_level": "A1",
          "word_slugs": [
            "comodi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
