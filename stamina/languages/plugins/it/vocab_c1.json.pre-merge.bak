    {
      "slug": "antenati-noun",
      "lemma": "antenati",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7008,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6162634",
          "text": "Conosci i tuoi antenati?",
          "translation": "Ты знаешь свою родословную?",
          "source": "Tatoeba #6162634 @dnnywld / #6162563 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6162634",
          "cefr_level": "A1",
          "word_slugs": [
            "antenati-noun"
          ]
        },
        {
          "id": "10224086",
          "text": "Questa è la terra dei nostri antenati.",
          "translation": "Это земля наших предков.",
          "source": "Tatoeba #10224086 @carlosalberto / #6539027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10224086",
          "cefr_level": "A1",
          "word_slugs": [
            "antenati-noun"
          ]
        },
        {
          "id": "10905147",
          "text": "A quale classe sociale appartenevano i tuoi antenati?",
          "translation": "К какому сословию принадлежали твои предки?",
          "source": "Tatoeba #10905147 @dnnywld / #10903345 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10905147",
          "cefr_level": "A1",
          "word_slugs": [
            "antenati-noun"
          ]
        },
        {
          "id": "2420398",
          "text": "Chi di noi vuole lanciare pietre contro i propri antenati?",
          "translation": "Кто из нас хочет бросать камни в своих предков?",
          "source": "Tatoeba #2420398 @al_ex_an_der / #2420397 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2420398",
          "cefr_level": "A1",
          "word_slugs": [
            "antenati-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il antenati",
        "plural": "",
        "infinitive": ""
      }
