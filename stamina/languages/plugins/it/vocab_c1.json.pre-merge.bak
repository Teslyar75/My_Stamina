    {
      "slug": "diagnosi-noun",
      "lemma": "diagnosi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6129,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5649573",
          "text": "Entrambi hanno la medesima diagnosi.",
          "translation": "У них обоих одинаковый диагноз.",
          "source": "Tatoeba #5649573 @dnnywld / #5649111 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5649573",
          "cefr_level": "A1",
          "word_slugs": [
            "diagnosi-noun"
          ]
        },
        {
          "id": "6292329",
          "text": "La diagnosi suonava come un verdetto.",
          "translation": "Диагноз звучал как приговор.",
          "source": "Tatoeba #6292329 @dnnywld / #6292045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6292329",
          "cefr_level": "A1",
          "word_slugs": [
            "diagnosi-noun"
          ]
        },
        {
          "id": "5649569",
          "text": "Tutti loro hanno la medesima diagnosi.",
          "translation": "У них у всех одинаковый диагноз.",
          "source": "Tatoeba #5649569 @dnnywld / #5649113 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5649569",
          "cefr_level": "A1",
          "word_slugs": [
            "diagnosi-noun"
          ]
        },
        {
