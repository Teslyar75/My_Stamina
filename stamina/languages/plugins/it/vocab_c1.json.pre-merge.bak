    {
      "slug": "impedisce-verb",
      "lemma": "impedisce",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7288,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5494170",
          "text": "Questo mi impedisce di vivere.",
          "translation": "Это мешает мне жить.",
          "source": "Tatoeba #5494170 @dnnywld / #5493637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494170",
          "cefr_level": "A1",
          "word_slugs": [
            "impedisce-verb"
          ]
        },
        {
          "id": "10881949",
          "text": "La spazzatura cosmica mi impedisce di ammirare lo spazio.",
          "translation": "Космический мусор мешает мне любоваться космосом.",
          "source": "Tatoeba #10881949 @dnnywld / #10344935 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10881949",
          "cefr_level": "A1",
          "word_slugs": [
            "impedisce-verb"
          ]
        },
        {
          "id": "10838943",
          "text": "La foresta trattiene l'acqua ed impedisce la siccità dei fiumi.",
          "translation": "Лес удерживает воду и не даёт реке омелеть.",
          "source": "Tatoeba #10838943 @dnnywld / #10838885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10838943",
          "cefr_level": "A1",
          "word_slugs": [
            "impedisce-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "impedisce",
        "plural": "",
        "infinitive": "impedisce"
      }
    },
