    {
      "slug": "incirca-adv",
      "lemma": "incirca",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9040,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6881785",
          "text": "All'incirca così.",
          "translation": "Примерно так.",
          "source": "Tatoeba #6881785 @dnnywld / #3545621 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881785",
          "cefr_level": "A1",
          "word_slugs": [
            "incirca-adv"
          ]
        },
        {
          "id": "6881789",
          "text": "Tutto era all'incirca così.",
          "translation": "Всё примерно так и было.",
          "source": "Tatoeba #6881789 @dnnywld / #6540944 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881789",
          "cefr_level": "A1",
          "word_slugs": [
            "incirca-adv"
          ]
        },
        {
          "id": "6881800",
          "text": "Sono alto all'incirca come Tom.",
          "translation": "Я примерно такого же роста, что и Том.",
          "source": "Tatoeba #6881800 @dnnywld / #6608234 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881800",
          "cefr_level": "A1",
          "word_slugs": [
            "incirca-adv"
          ]
        },
        {
          "id": "6881796",
          "text": "Lei è all'incirca alta come me.",
          "translation": "Она примерно такого же роста, что и я.",
          "source": "Tatoeba #6881796 @dnnywld / #2021507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881796",
          "cefr_level": "A1",
          "word_slugs": [
            "incirca-adv"
          ]
        },
        {
          "id": "6881798",
          "text": "Lei è all'incirca alta come te.",
          "translation": "Она примерно такого же роста, что и ты.",
          "source": "Tatoeba #6881798 @dnnywld / #3894682 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881798",
          "cefr_level": "A1",
          "word_slugs": [
            "incirca-adv"
          ]
        }
      ],
