    {
      "slug": "prega-verb",
      "lemma": "prega",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5463,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5974419",
          "text": "Prega per Tom.",
          "translation": "Молись за Тома.",
          "source": "Tatoeba #5974419 @dnnywld / #5974134 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5974419",
          "cefr_level": "A1",
          "word_slugs": [
            "prega-verb"
          ]
        },
        {
          "id": "8334136",
          "text": "Si prega di passare dalla cassa.",
          "translation": "Пройдите, пожалуйста, на кассу.",
          "source": "Tatoeba #8334136 @dnnywld / #7216584 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8334136",
          "cefr_level": "A1",
          "word_slugs": [
            "prega-verb"
          ]
        },
        {
          "id": "5647227",
          "text": "Dan prega prorpio in questa moschea.",
          "translation": "Дэн молится именно в этой мечети.",
          "source": "Tatoeba #5647227 @dnnywld / #5647076 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647227",
          "cefr_level": "A1",
          "word_slugs": [
            "prega-verb"
          ]
        },
        {
          "id": "5415828",
          "text": "Si prega di uscire di qui immediatamente.",
          "translation": "Сию же минуту извольте выйти отсюда.",
          "source": "Tatoeba #5415828 @dnnywld / #2625722 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415828",
          "cefr_level": "A1",
          "word_slugs": [
            "prega-verb"
          ]
        },
        {
          "id": "5530443",
          "text": "Si prega di bussare prima di entrare in bagno.",
          "translation": "Просьба стучать, перед тем как войти в туалет.",
          "source": "Tatoeba #5530443 @dnnywld / #1109163 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5530443",
          "cefr_level": "A1",
          "word_slugs": [
            "prega-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "prega",
        "plural": "",
        "infinitive": "prega"
      }
    },
