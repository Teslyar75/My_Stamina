          ]
        },
        {
          "id": "535862",
          "text": "La tua risposta è corretta.",
          "translation": "Твой ответ правилен.",
          "source": "Tatoeba #535862 @Pharamp / #475328 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/535862",
          "cefr_level": "A1",
          "word_slugs": [
            "corretta-adj"
          ]
        },
        {
          "id": "12994955",
          "text": "Nemmeno una risposta è corretta.",
          "translation": "Ни один из ответов не является правильным.",
          "source": "Tatoeba #12994955 @dnnywld / #12994215 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12994955",
          "cefr_level": "A1",
          "word_slugs": [
