      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3477402",
          "text": "Non promettere niente.",
          "translation": "Ничего не обещай.",
          "source": "Tatoeba #3477402 @Guybrush88 / #3541313 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3477402",
          "cefr_level": "A1",
          "word_slugs": [
            "promettere-verb"
          ]
        },
        {
          "id": "6727408",
          "text": "Sapete solo promettere.",
          "translation": "Вы только обещаете.",
          "source": "Tatoeba #6727408 @dnnywld / #6726771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6727408",
          "cefr_level": "A1",
          "word_slugs": [
            "promettere-verb"
          ]
        },
        {
          "id": "6726942",
          "text": "Sai soltanto promettere.",
