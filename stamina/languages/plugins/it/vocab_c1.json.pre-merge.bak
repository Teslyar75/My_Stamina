    {
      "slug": "avvicinato-verb",
      "lemma": "avvicinato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8382,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6361547",
          "text": "Ti sei avvicinato a Mary.",
          "translation": "Том подвинулся поближе к Мэри.",
          "source": "Tatoeba #6361547 @dnnywld / #6361305 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361547",
          "cefr_level": "A1",
          "word_slugs": [
            "avvicinato-verb"
          ]
        },
        {
          "id": "6909257",
          "text": "Tom si è parecchio avvicinato alla soluzione del problema.",
          "translation": "Том основательно подошёл к решению проблемы.",
          "source": "Tatoeba #6909257 @dnnywld / #6908881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6909257",
          "cefr_level": "A1",
          "word_slugs": [
            "avvicinato-verb"
          ]
        },
        {
          "id": "6909252",
          "text": "Vedo che ti sei parecchio avvicinato alla soluzione del problema.",
          "translation": "Я вижу, ты основательно подошёл к решению проблемы.",
          "source": "Tatoeba #6909252 @dnnywld / #6908889 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6909252",
          "cefr_level": "A1",
          "word_slugs": [
            "avvicinato-verb"
          ]
        }
      ],
      "tags": [
