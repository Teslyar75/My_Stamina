    {
      "slug": "salita-adj",
      "lemma": "salita",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6860,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "подъём"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4140106",
          "text": "Dov'è salita sul treno?",
          "translation": "Где ты села на поезд?",
          "source": "Tatoeba #4140106 @Guybrush88 / #4140218 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4140106",
          "cefr_level": "A1",
          "word_slugs": [
            "salita-adj"
          ]
        },
        {
          "id": "11460887",
          "text": "È un po' pesante lungo la salita.",
          "translation": "Он немного тяжёлый на подъём.",
          "source": "Tatoeba #11460887 @Bernie75 / #383548 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11460887",
          "cefr_level": "A1",
          "word_slugs": [
            "salita-adj"
          ]
        },
        {
          "id": "3224784",
          "text": "La temperatura dell'olio è salita a 165 gradi Celsius.",
          "translation": "Температура масла поднялась до 165 градусов Цельсия.",
          "source": "Tatoeba #3224784 @Guybrush88 / #3261631 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3224784",
          "cefr_level": "A1",
          "word_slugs": [
            "salita-adj"
          ]
        },
        {
          "id": "5469592",
          "text": "La salita sulla cima della collina ha richiesto mezz'ora.",
          "translation": "Подъём на вершину холма занял полтора часа.",
          "source": "Tatoeba #5469592 @dnnywld / #5469486 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5469592",
          "cefr_level": "A1",
          "word_slugs": [
            "salita-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
