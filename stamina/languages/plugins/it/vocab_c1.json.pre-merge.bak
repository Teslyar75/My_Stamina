          ]
        },
        {
          "id": "6136473",
          "text": "Potete aggiustare la mia bicicletta?",
          "translation": "Можете починить мой велосипед?",
          "source": "Tatoeba #6136473 @dnnywld / #6136334 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6136473",
          "cefr_level": "A1",
          "word_slugs": [
            "aggiustare-verb"
          ]
        },
        {
          "id": "3327692",
          "text": "Aggiustare la bicicletta mi è costato 5000 yen.",
          "translation": "Ремонт велосипеда стоил мне 5000 иен.",
          "source": "Tatoeba #3327692 @bailujia / #4411564 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3327692",
          "cefr_level": "A1",
