    {
      "slug": "parete-noun",
      "lemma": "parete",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5516,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3860788",
          "text": "Tom sta trapanando la parete.",
          "translation": "Том сверлит стену.",
          "source": "Tatoeba #3860788 @Guybrush88 / #3860804 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3860788",
          "cefr_level": "A1",
          "word_slugs": [
            "parete-noun"
          ]
        },
        {
          "id": "5904626",
          "text": "L'orologio è appeso alla parete.",
          "translation": "Часы висят на стене.",
          "source": "Tatoeba #5904626 @dnnywld / #5903450 @Catamenia321 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5904626",
          "cefr_level": "A1",
          "word_slugs": [
            "parete-noun"
          ]
        },
        {
          "id": "5738844",
          "text": "Tom attaccò un calendario alla parete.",
          "translation": "Том повесил на стену календарь.",
          "source": "Tatoeba #5738844 @dnnywld / #2597100 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5738844",
          "cefr_level": "A1",
          "word_slugs": [
            "parete-noun"
          ]
        },
        {
          "id": "5546306",
          "text": "Tom ha dipinto la parete di bianco.",
          "translation": "Том покрасил стены в белый.",
          "source": "Tatoeba #5546306 @dnnywld / #5546277 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5546306",
          "cefr_level": "A1",
          "word_slugs": [
            "parete-noun"
          ]
        },
        {
          "id": "5499832",
          "text": "Lungo la parete sono allineate le sedie.",
          "translation": "Вдоль стены в ряд стоят стулья.",
          "source": "Tatoeba #5499832 @dnnywld / #5499762 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499832",
          "cefr_level": "A1",
          "word_slugs": [
            "parete-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la parete",
        "plural": "",
        "infinitive": ""
      }
    },
