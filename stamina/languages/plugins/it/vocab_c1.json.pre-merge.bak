    {
      "slug": "sbagliando-verb",
      "lemma": "sbagliando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6997,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6891164",
          "text": "Temo che stiate sbagliando.",
          "translation": "Боюсь, вы ошибаетесь.",
          "source": "Tatoeba #6891164 @dnnywld / #3699027 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891164",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliando-verb"
          ]
        },
        {
          "id": "6951712",
          "text": "Eppure, ti stavi sbagliando.",
          "translation": "Всё-таки ты ошибался.",
          "source": "Tatoeba #6951712 @dnnywld / #6951206 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6951712",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliando-verb"
          ]
        },
        {
          "id": "6635998",
          "text": "Sembrava che steste sbagliando.",
          "translation": "Вы, похоже, ошибались.",
          "source": "Tatoeba #6635998 @dnnywld / #6635610 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6635998",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliando-verb"
          ]
        },
        {
          "id": "5423480",
          "text": "Penso che tutti stiate sbagliando.",
          "translation": "Я думаю, вы все ошибаетесь.",
          "source": "Tatoeba #5423480 @dnnywld / #5422792 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5423480",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliando-verb"
          ]
        },
        {
          "id": "6635999",
          "text": "Sembrava che tu stessi sbagliando.",
          "translation": "Ты, похоже, ошибался.",
          "source": "Tatoeba #6635999 @dnnywld / #6635608 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6635999",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliando-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
