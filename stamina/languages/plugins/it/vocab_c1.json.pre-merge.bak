          "cefr_level": "A1",
          "word_slugs": [
            "asciugamano-noun"
          ]
        },
        {
          "id": "3347207",
          "text": "Mary si avvolse in un asciugamano.",
          "translation": "Мэри завернулась в полотенце.",
          "source": "Tatoeba #3347207 @Guybrush88 / #3620611 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3347207",
          "cefr_level": "A1",
          "word_slugs": [
            "asciugamano-noun"
          ]
        },
        {
          "id": "6958971",
          "text": "Tom stese l'asciugamano per terra.",
          "translation": "Том расстелил полотенце на земле.",
          "source": "Tatoeba #6958971 @dnnywld / #6958239 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6958971",
          "cefr_level": "A1",
          "word_slugs": [
            "asciugamano-noun"
          ]
        },
        {
          "id": "3347208",
          "text": "Mary si è avvolta in un asciugamano.",
          "translation": "Мэри завернулась в полотенце.",
          "source": "Tatoeba #3347208 @Guybrush88 / #3620611 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3347208",
          "cefr_level": "A1",
          "word_slugs": [
            "asciugamano-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il asciugamano",
