    {
      "slug": "altamente-adv",
      "lemma": "altamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7192,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "высоко"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5202678",
          "text": "Me ne frego altamente.",
          "translation": "А там хоть трава не расти.",
          "source": "Tatoeba #5202678 @Guybrush88 / #6856033 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5202678",
          "cefr_level": "A1",
          "word_slugs": [
            "altamente-adv"
          ]
        },
        {
          "id": "2213894",
          "text": "La logica è altamente sopravvalutata.",
          "translation": "Логику сильно переоценивают.",
          "source": "Tatoeba #2213894 @al_ex_an_der / #2213898 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2213894",
          "cefr_level": "A1",
          "word_slugs": [
            "altamente-adv"
          ]
        },
        {
          "id": "5820200",
          "text": "Tom è una persona altamente istruita.",
          "translation": "Том - высокообразованный человек.",
          "source": "Tatoeba #5820200 @dnnywld / #5818215 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5820200",
          "cefr_level": "A1",
          "word_slugs": [
            "altamente-adv"
          ]
        },
        {
          "id": "6051726",
          "text": "Si tratta di una civiltà altamente sviluppata.",
          "translation": "Это высокоразвитая цивилизация.",
          "source": "Tatoeba #6051726 @dnnywld / #6050960 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6051726",
          "cefr_level": "A1",
          "word_slugs": [
            "altamente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
