    {
      "slug": "respinto-adj",
      "lemma": "respinto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9049,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5504328",
          "text": "Hanno respinto il mio progetto.",
          "translation": "Мой проект завернули.",
          "source": "Tatoeba #5504328 @dnnywld / #5503681 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504328",
          "cefr_level": "A1",
          "word_slugs": [
            "respinto-adj"
          ]
        },
        {
          "id": "5491363",
          "text": "Tom ha respinto questo progetto.",
          "translation": "Том забраковал этот план.",
          "source": "Tatoeba #5491363 @dnnywld / #5491063 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5491363",
          "cefr_level": "A1",
          "word_slugs": [
            "respinto-adj"
          ]
        },
        {
          "id": "5904194",
          "text": "Lui ha respinto categoricamente tutte le accuse.",
          "translation": "Он категорически открестился от всех обвинений.",
          "source": "Tatoeba #5904194 @dnnywld / #5903972 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5904194",
          "cefr_level": "A1",
          "word_slugs": [
            "respinto-adj"
          ]
        },
        {
          "id": "5993968",
          "text": "Lei ha respinto la nostra proposta d'aiuto.",
          "translation": "Она отвергла наше предложение о помощи.",
          "source": "Tatoeba #5993968 @dnnywld / #5992386 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5993968",
          "cefr_level": "A1",
          "word_slugs": [
            "respinto-adj"
          ]
        }
      ],
