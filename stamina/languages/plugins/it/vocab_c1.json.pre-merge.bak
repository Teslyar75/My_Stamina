          ]
        },
        {
          "id": "3585763",
          "text": "Leopardi era un poeta?",
          "translation": "Леопарди был поэтом?",
          "source": "Tatoeba #3585763 @Guybrush88 / #3585901 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3585763",
          "cefr_level": "A1",
          "word_slugs": [
            "poeta-noun"
          ]
        },
        {
          "id": "6668456",
          "text": "Voglio essere un poeta.",
          "translation": "Я хочу быть поэтом.",
