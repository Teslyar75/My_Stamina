    {
      "slug": "sollevato-adj",
      "lemma": "sollevato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6823,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2925382",
          "text": "Mi sento sollevato.",
          "translation": "Я чувствую облегчение.",
          "source": "Tatoeba #2925382 @Guybrush88 / #5716853 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2925382",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevato-adj"
          ]
        },
        {
          "id": "5677851",
          "text": "Tom ha sollevato la scatola.",
          "translation": "Том поднял ящик.",
          "source": "Tatoeba #5677851 @dnnywld / #5677143 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677851",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevato-adj"
          ]
        },
        {
          "id": "5399034",
          "text": "Il soldato ha sollevato la bandiera.",
          "translation": "Солдат поднял флаг.",
          "source": "Tatoeba #5399034 @dnnywld / #2959126 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5399034",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevato-adj"
          ]
        },
        {
          "id": "8872684",
          "text": "Tom ha sollevato le cose da terra.",
          "translation": "Том поднял вещи с пола.",
          "source": "Tatoeba #8872684 @Valdast / #2099041 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8872684",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevato-adj"
          ]
        },
        {
          "id": "7911032",
          "text": "Lui ha detto che si sentiva sollevato.",
          "translation": "Он сказал, что чувствует облегчение.",
          "source": "Tatoeba #7911032 @dnnywld / #7910646 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7911032",
          "cefr_level": "A1",
          "word_slugs": [
            "sollevato-adj"
          ]
        }
