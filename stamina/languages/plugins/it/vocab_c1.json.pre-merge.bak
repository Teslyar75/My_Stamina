    {
      "slug": "degna-adj",
      "lemma": "degna",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8693,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "4969478",
          "text": "Lui ha una memoria degna di nota.",
          "translation": "У него замечательная память.",
          "source": "Tatoeba #4969478 @Guybrush88 / #1517419 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4969478",
          "cefr_level": "A1",
          "word_slugs": [
            "degna-adj"
          ]
        },
        {
          "id": "10790842",
          "text": "Nessuna sua parola è degna di attenzione.",
          "translation": "Ни одно его слово не стоит внимания.",
          "source": "Tatoeba #10790842 @dnnywld / #10790634 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790842",
          "cefr_level": "A1",
          "word_slugs": [
            "degna-adj"
          ]
        },
        {
          "id": "7299433",
          "text": "Nessuno pensava che Mary fosse degna di lode.",
          "translation": "Никто не думал, что Мэри заслуживает похвалы.",
          "source": "Tatoeba #7299433 @dnnywld / #7299065 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7299433",
          "cefr_level": "A1",
          "word_slugs": [
            "degna-adj"
          ]
        },
        {
          "id": "7495146",
          "text": "Ho la sensazione che questa opinione sia degna di attenzione.",
          "translation": "По моим ощущениям, это мнение достойно внимания.",
          "source": "Tatoeba #7495146 @dnnywld / #7494540 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7495146",
          "cefr_level": "A1",
          "word_slugs": [
            "degna-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la degna",
        "plural": "",
        "infinitive": ""
      }
