    {
      "slug": "straniero-adj",
      "lemma": "straniero",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5323,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3307976",
          "text": "Tu sei mai stato in un paese straniero?",
          "translation": "Ты когда-нибудь был в другой стране?",
          "source": "Tatoeba #3307976 @Guybrush88 / #4532957 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3307976",
          "cefr_level": "A1",
          "word_slugs": [
            "straniero-adj"
          ]
        },
        {
          "id": "6940772",
          "text": "Lui è straniero e non capisce il russo.",
          "translation": "Он иностранец и не понимает по-русски.",
          "source": "Tatoeba #6940772 @dnnywld / #6940407 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6940772",
          "cefr_level": "A1",
          "word_slugs": [
            "straniero-adj"
          ]
        },
        {
          "id": "12392766",
          "text": "Mi sento come uno straniero nel proprio Paese.",
          "translation": "Я чувствую себя иностранцем в своей стране.",
          "source": "Tatoeba #12392766 @dnnywld / #12251020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12392766",
          "cefr_level": "A1",
          "word_slugs": [
            "straniero-adj"
          ]
        },
        {
          "id": "4737499",
          "text": "Lo straniero non sapeva per niente il giapponese.",
          "translation": "Иностранец совсем не знал японского.",
          "source": "Tatoeba #4737499 @mervert1 / #4741624 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4737499",
          "cefr_level": "A1",
          "word_slugs": [
            "straniero-adj"
          ]
        },
        {
          "id": "5610868",
          "text": "Fossi stato uno straniero, probabilmente non avrei mangiato pesce crudo.",
          "translation": "Будь я иностранцем, я бы, наверное, не смог есть сырую рыбу.",
          "source": "Tatoeba #5610868 @dnnywld / #1972368 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5610868",
          "cefr_level": "A1",
          "word_slugs": [
            "straniero-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il straniero",
        "plural": "",
        "infinitive": ""
      }
    },
