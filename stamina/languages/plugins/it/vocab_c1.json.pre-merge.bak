      "lemma": "attratto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9260,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5385105",
          "text": "Sei attratto da lui?",
          "translation": "Тебя к нему тянет?",
          "source": "Tatoeba #5385105 @dnnywld / #5385074 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385105",
          "cefr_level": "A1",
          "word_slugs": [
            "attratto-adj"
          ]
        },
        {
          "id": "5385110",
          "text": "Sei attratto da lei?",
          "translation": "Тебя к ней тянет?",
          "source": "Tatoeba #5385110 @dnnywld / #5385064 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385110",
          "cefr_level": "A1",
          "word_slugs": [
            "attratto-adj"
          ]
        },
        {
          "id": "7459119",
          "text": "Sono attratto dall'avventura.",
          "translation": "Меня тянет на приключения.",
          "source": "Tatoeba #7459119 @dnnywld / #7457008 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7459119",
          "cefr_level": "A1",
          "word_slugs": [
            "attratto-adj"
          ]
        },
        {
          "id": "2282128",
          "text": "È attratto dalle ragazze asiatiche.",
          "translation": "Ему нравятся девчонки-азиатки.",
          "source": "Tatoeba #2282128 @Guybrush88 / #2282146 @loSqual (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2282128",
          "cefr_level": "A1",
          "word_slugs": [
            "attratto-adj"
          ]
        },
        {
          "id": "5738849",
          "text": "Non sono più attratto da te.",
          "translation": "Ты меня больше не привлекаешь.",
          "source": "Tatoeba #5738849 @dnnywld / #5738767 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5738849",
          "cefr_level": "A1",
          "word_slugs": [
            "attratto-adj"
          ]
        }
