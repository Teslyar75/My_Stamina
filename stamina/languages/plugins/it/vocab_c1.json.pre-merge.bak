    {
      "slug": "restituire-verb",
      "lemma": "restituire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6388,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3475632",
          "text": "Vorrei restituire questo.",
          "translation": "Я бы хотел это вернуть.",
          "source": "Tatoeba #3475632 @Guybrush88 / #3800778 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3475632",
          "cefr_level": "A1",
          "word_slugs": [
            "restituire-verb"
          ]
        },
        {
          "id": "10954631",
          "text": "Non me lo vuole restituire.",
          "translation": "Он не хочет мне его отдавать.",
          "source": "Tatoeba #10954631 @dnnywld / #8718531 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10954631",
          "cefr_level": "A1",
          "word_slugs": [
            "restituire-verb"
          ]
        },
        {
          "id": "5833204",
          "text": "Quando bisogna restituire il libro?",
          "translation": "Когда книгу нужно вернуть?",
          "source": "Tatoeba #5833204 @dnnywld / #4955695 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5833204",
          "cefr_level": "A1",
          "word_slugs": [
            "restituire-verb"
          ]
        },
        {
          "id": "6587222",
          "text": "Devo restituire alcuni libri alla biblioteca.",
          "translation": "Мне нужно вернуть в библиотеку кое-какие книги.",
          "source": "Tatoeba #6587222 @dnnywld / #6584116 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6587222",
          "cefr_level": "A1",
          "word_slugs": [
            "restituire-verb"
          ]
        },
        {
          "id": "5514389",
          "text": "Ho bisogno di restituire il libro domani.",
          "translation": "Мне нужно отдать книгу завтра.",
          "source": "Tatoeba #5514389 @dnnywld / #5513264 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514389",
          "cefr_level": "A1",
          "word_slugs": [
            "restituire-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "restituire",
        "plural": "",
        "infinitive": "restituire"
      }
