      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6903277",
          "text": "Stai guidando lentamente.",
          "translation": "Ты медленно водишь.",
          "source": "Tatoeba #6903277 @dnnywld / #3631999 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6903277",
          "cefr_level": "A1",
          "word_slugs": [
            "guidando-verb"
          ]
        },
        {
          "id": "3860656",
          "text": "Sto guidando un camion.",
          "translation": "Я веду грузовик.",
          "source": "Tatoeba #3860656 @Guybrush88 / #3030650 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3860656",
          "cefr_level": "A1",
