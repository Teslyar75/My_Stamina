    {
      "slug": "provoca-verb",
      "lemma": "provoca",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9796,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10791129",
          "text": "Cosa lo provoca?",
          "translation": "Что вызывает это?",
          "source": "Tatoeba #10791129 @dnnywld / #7938880 @Colbo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10791129",
          "cefr_level": "A1",
          "word_slugs": [
            "provoca-verb"
          ]
        },
        {
          "id": "10791122",
          "text": "L'alcol provoca insonnia.",
          "translation": "Алкоголь вызывает бессонницу.",
          "source": "Tatoeba #10791122 @dnnywld / #7013706 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10791122",
          "cefr_level": "A1",
          "word_slugs": [
            "provoca-verb"
          ]
        },
        {
          "id": "10791131",
          "text": "Il tabacco provoca assuefazione.",
          "translation": "Табак вызывает привыкание.",
          "source": "Tatoeba #10791131 @dnnywld / #8413392 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10791131",
          "cefr_level": "A1",
          "word_slugs": [
            "provoca-verb"
          ]
        },
        {
          "id": "10791086",
          "text": "La caffeina provoca assuefazione.",
          "translation": "Кофеин вызывает привыкание.",
          "source": "Tatoeba #10791086 @dnnywld / #4776122 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10791086",
          "cefr_level": "A1",
          "word_slugs": [
            "provoca-verb"
          ]
        },
        {
          "id": "10791087",
          "text": "Il vento provoca le onde.",
          "translation": "Ветер вызывает волны.",
          "source": "Tatoeba #10791087 @dnnywld / #4979962 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10791087",
          "cefr_level": "A1",
          "word_slugs": [
            "provoca-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "provoca",
        "plural": "",
        "infinitive": "provoca"
      }
