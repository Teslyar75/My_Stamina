    {
      "slug": "aiutiamo-verb",
      "lemma": "aiutiamo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9776,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5494856",
          "text": "Perché aiutiamo Tom?",
          "translation": "Зачем мы помогаем Тому?",
          "source": "Tatoeba #5494856 @dnnywld / #5494516 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494856",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutiamo-verb"
          ]
        },
        {
          "id": "5465326",
          "text": "Aiutiamo come possiamo.",
          "translation": "Мы помогаем, чем можем.",
          "source": "Tatoeba #5465326 @dnnywld / #5465064 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5465326",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutiamo-verb"
          ]
        },
        {
          "id": "6031745",
          "text": "Dovresti lasciare che ti aiutiamo.",
          "translation": "Ты должна позволить нам помочь тебе.",
          "source": "Tatoeba #6031745 @dnnywld / #6031450 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6031745",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutiamo-verb"
          ]
        },
        {
          "id": "5703092",
          "text": "Penso che sia meglio che aiutiamo Tom.",
          "translation": "Думаю, нам лучше помочь Тому.",
          "source": "Tatoeba #5703092 @dnnywld / #5702915 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5703092",
          "cefr_level": "A1",
          "word_slugs": [
            "aiutiamo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "aiutiamo",
