    {
      "slug": "frequenta-verb",
      "lemma": "frequenta",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9290,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5647702",
          "text": "Che posti frequenta Mary la sera?",
          "translation": "Где Мэри бывает по вечерам?",
          "source": "Tatoeba #5647702 @dnnywld / #5647555 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647702",
          "cefr_level": "A1",
          "word_slugs": [
            "frequenta-verb"
          ]
        },
        {
          "id": "5489171",
          "text": "Tom frequenta la stessa vostra scuola?",
          "translation": "Том ходит в ту же школу, что и вы?",
          "source": "Tatoeba #5489171 @dnnywld / #5488842 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489171",
          "cefr_level": "A1",
          "word_slugs": [
            "frequenta-verb"
          ]
        },
        {
          "id": "5647700",
          "text": "Sai che posti frequenta Tom la sera?",
          "translation": "Ты знаешь, где Том бывает по вечерам?",
          "source": "Tatoeba #5647700 @dnnywld / #5647557 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647700",
          "cefr_level": "A1",
          "word_slugs": [
            "frequenta-verb"
          ]
        },
        {
          "id": "5647701",
          "text": "Tom sa che posti frequenta Mary la sera?",
          "translation": "Том знает, где Мэри бывает по вечерам?",
          "source": "Tatoeba #5647701 @dnnywld / #5647556 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647701",
          "cefr_level": "A1",
          "word_slugs": [
            "frequenta-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
