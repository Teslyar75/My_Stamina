    {
      "slug": "pacifico-adj",
      "lemma": "pacifico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7443,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3244291",
          "text": "Noi possiamo fare uso pacifico dell'energia atomica.",
          "translation": "Мы можем использовать атомную энергию в мирных целях.",
          "source": "Tatoeba #3244291 @Guybrush88 / #3368536 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3244291",
          "cefr_level": "A1",
          "word_slugs": [
            "pacifico-adj"
          ]
        },
        {
          "id": "5391372",
          "text": "L'Oceano Atlantico è più salato di quello Pacifico.",
          "translation": "Атлантический океан солонее, чем Тихий.",
          "source": "Tatoeba #5391372 @dnnywld / #5391150 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5391372",
          "cefr_level": "A1",
          "word_slugs": [
            "pacifico-adj"
          ]
        },
        {
          "id": "377643",
          "text": "Il nostro aereo stava volando sopra l'oceano Pacifico.",
          "translation": "Наш самолёт пролетал над Тихим океаном.",
          "source": "Tatoeba #377643 @Pharamp / #3313449 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/377643",
          "cefr_level": "A1",
          "word_slugs": [
            "pacifico-adj"
          ]
        },
        {
          "id": "4861400",
          "text": "L'Oceano Pacifico è il più grande oceano del mondo.",
          "translation": "Тихий океан — самый большой океан в мире.",
          "source": "Tatoeba #4861400 @ianna / #2204374 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4861400",
          "cefr_level": "A1",
          "word_slugs": [
            "pacifico-adj"
          ]
        },
        {
          "id": "6943231",
          "text": "Per raggiungere l'Asia dall'America bisogna attraversare l'Oceano Pacifico.",
          "translation": "Чтобы попасть из Америки в Азию, нужно пересечь Тихий океан.",
          "source": "Tatoeba #6943231 @dnnywld / #6941414 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6943231",
          "cefr_level": "A1",
          "word_slugs": [
            "pacifico-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il pacifico",
        "plural": "",
        "infinitive": ""
      }
    },
