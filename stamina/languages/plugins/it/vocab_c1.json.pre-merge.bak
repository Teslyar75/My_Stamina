      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6967921",
          "text": "Quanto spesso ci capiti?",
          "translation": "Как часто ты там бываешь?",
          "source": "Tatoeba #6967921 @dnnywld / #5930745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6967921",
          "cefr_level": "A1",
          "word_slugs": [
            "capiti-verb"
          ]
        },
        {
          "id": "6967923",
          "text": "Quanto spesso capiti qui?",
          "translation": "Как часто ты здесь бываешь?",
          "source": "Tatoeba #6967923 @dnnywld / #6377608 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6967923",
          "cefr_level": "A1",
          "word_slugs": [
            "capiti-verb"
          ]
        },
        {
          "id": "10796987",
          "text": "Si sono capiti a vicenda.",
