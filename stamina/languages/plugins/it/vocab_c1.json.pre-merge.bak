    {
      "slug": "abbattuto-adj",
      "lemma": "abbattuto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9141,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5868584",
          "text": "Abbiamo abbattuto un cervo.",
          "translation": "Мы сбили оленя.",
          "source": "Tatoeba #5868584 @dnnywld / #5783786 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868584",
          "cefr_level": "A1",
          "word_slugs": [
            "abbattuto-adj"
          ]
        },
        {
          "id": "5591101",
          "text": "Hanno abbattuto molti alberi.",
          "translation": "Много деревьев срубили.",
          "source": "Tatoeba #5591101 @dnnywld / #5590965 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591101",
          "cefr_level": "A1",
          "word_slugs": [
            "abbattuto-adj"
          ]
        },
        {
          "id": "5997386",
          "text": "Uno dei tori ha abbattuto lo steccato.",
          "translation": "Один из быков повалил забор.",
          "source": "Tatoeba #5997386 @Guybrush88 / #8120766 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997386",
          "cefr_level": "A1",
          "word_slugs": [
            "abbattuto-adj"
          ]
        },
        {
          "id": "1068040",
          "text": "Ha abbattuto un albero nel suo giardino.",
          "translation": "Он срубил дерево в своём саду.",
          "source": "Tatoeba #1068040 @Guybrush88 / #3061756 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1068040",
          "cefr_level": "A1",
          "word_slugs": [
            "abbattuto-adj"
          ]
        },
        {
          "id": "409473",
          "text": "Lui ha abbattuto quell'albero di ciliegio.",
          "translation": "Он срубил это вишнёвое дерево.",
          "source": "Tatoeba #409473 @shoras / #2734127 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/409473",
          "cefr_level": "A1",
          "word_slugs": [
            "abbattuto-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il abbattuto",
        "plural": "",
        "infinitive": ""
      }
