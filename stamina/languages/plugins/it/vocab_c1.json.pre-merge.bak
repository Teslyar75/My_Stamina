    {
      "slug": "sfera-noun",
      "lemma": "sfera",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8397,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6843139",
          "text": "Scrivi con la penna a sfera.",
          "translation": "Пиши шариковой ручкой.",
          "source": "Tatoeba #6843139 @dnnywld / #627804 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843139",
          "cefr_level": "A1",
          "word_slugs": [
            "sfera-noun"
          ]
        },
        {
          "id": "10928659",
          "text": "Quante penne a sfera ha lei?",
          "translation": "Сколько у неё шариковых ручек?",
          "source": "Tatoeba #10928659 @dnnywld / #10928626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10928659",
          "cefr_level": "A1",
          "word_slugs": [
            "sfera-noun"
          ]
        },
        {
          "id": "3958315",
          "text": "La Terra non è una sfera perfetta.",
          "translation": "Земля - не идеальный шар.",
          "source": "Tatoeba #3958315 @Vittorio / #4474230 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3958315",
          "cefr_level": "A1",
          "word_slugs": [
            "sfera-noun"
          ]
        },
        {
          "id": "1642441",
          "text": "La terra ha la forma di una sfera.",
          "translation": "Земля имеет форму шара.",
          "source": "Tatoeba #1642441 @Guybrush88 / #3148616 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1642441",
          "cefr_level": "A1",
          "word_slugs": [
            "sfera-noun"
          ]
        },
        {
          "id": "6843200",
          "text": "Scrivete con la penna a sfera, per favore.",
          "translation": "Пишите шариковой ручкой, пожалуйста.",
          "source": "Tatoeba #6843200 @dnnywld / #2143942 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843200",
          "cefr_level": "A1",
          "word_slugs": [
            "sfera-noun"
          ]
        }
      ],
