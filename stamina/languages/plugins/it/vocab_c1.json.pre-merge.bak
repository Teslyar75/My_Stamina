      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6316036",
          "text": "Deve essere stato doloroso.",
          "translation": "Должно быть, было больно.",
          "source": "Tatoeba #6316036 @dnnywld / #6316002 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6316036",
          "cefr_level": "A1",
          "word_slugs": [
            "doloroso-adj"
          ]
        },
        {
          "id": "5642508",
          "text": "Sapevo che questo sarebbe stato doloroso.",
          "translation": "Я знал, что это будет болезненно.",
          "source": "Tatoeba #5642508 @dnnywld / #5641635 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642508",
          "cefr_level": "A1",
          "word_slugs": [
            "doloroso-adj"
          ]
        },
        {
          "id": "5472299",
          "text": "Non puoi nemmeno immaginarti quanto per me sia doloroso parlartene.",
          "translation": "Ты даже не представляешь, как мне больно тебе это говорить.",
          "source": "Tatoeba #5472299 @dnnywld / #4998716 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472299",
          "cefr_level": "A1",
          "word_slugs": [
