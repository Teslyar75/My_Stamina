    {
      "slug": "ciechi-adj",
      "lemma": "ciechi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9587,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5560600",
          "text": "Sia Tom che Mary sono ciechi.",
          "translation": "И Том, и Мэри слепые.",
          "source": "Tatoeba #5560600 @dnnywld / #5560388 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5560600",
          "cefr_level": "A1",
          "word_slugs": [
            "ciechi-adj"
          ]
        },
        {
          "id": "6367181",
          "text": "I cani guida aiutano i ciechi.",
          "translation": "Собаки-поводыри помогают незрячим людям.",
          "source": "Tatoeba #6367181 @dnnywld / #6367178 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367181",
          "cefr_level": "A1",
          "word_slugs": [
            "ciechi-adj"
          ]
        },
        {
          "id": "11904867",
          "text": "In terra di ciechi, l'orbo è re.",
          "translation": "В царстве слепых одноглазый — король.",
          "source": "Tatoeba #11904867 @Bernie75 / #3841819 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11904867",
          "cefr_level": "A1",
          "word_slugs": [
            "ciechi-adj"
          ]
        },
        {
          "id": "5597630",
          "text": "I ciechi non credono all'amore a prima vista.",
          "translation": "Слепые не верят в любовь с первого взгляда.",
          "source": "Tatoeba #5597630 @dnnywld / #5022711 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5597630",
          "cefr_level": "A1",
          "word_slugs": [
            "ciechi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ciechi",
        "plural": "",
        "infinitive": ""
      }
    },
