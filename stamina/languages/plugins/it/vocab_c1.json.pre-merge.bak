    {
      "slug": "confessare-verb",
      "lemma": "confessare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5115,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "11376426",
          "text": "Dovrai confessare questo.",
          "translation": "Тебе придётся это признать.",
          "source": "Tatoeba #11376426 @Bernie75 / #2761367 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11376426",
          "cefr_level": "A1",
          "word_slugs": [
            "confessare-verb"
          ]
        },
        {
          "id": "4450",
          "text": "Vi devo confessare che russo.",
          "translation": "Я должен признаться, что храплю.",
          "source": "Tatoeba #4450 @Guybrush88 / #407393 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4450",
          "cefr_level": "A1",
          "word_slugs": [
            "confessare-verb"
          ]
        },
        {
          "id": "5573504",
          "text": "Temo di dover confessare qualcosa.",
          "translation": "Боюсь, мне надо кое в чём признаться.",
          "source": "Tatoeba #5573504 @dnnywld / #3970644 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5573504",
          "cefr_level": "A1",
          "word_slugs": [
            "confessare-verb"
          ]
        },
        {
          "id": "7581441",
          "text": "Tom ha detto che aveva bisogno di confessare qualcosa.",
          "translation": "Том сказал, что ему нужно кое в чём признаться.",
          "source": "Tatoeba #7581441 @dnnywld / #7581012 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7581441",
          "cefr_level": "A1",
          "word_slugs": [
            "confessare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "confessare",
        "plural": "",
        "infinitive": "confessare"
      }
    },
    {
      "slug": "chiamerò-verb",
      "lemma": "chiamerò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5116,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3868051",
          "text": "Ti chiamerò domani.",
          "translation": "Я позвоню тебе завтра.",
          "source": "Tatoeba #3868051 @Guybrush88 / #1618354 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3868051",
          "cefr_level": "A1",
          "word_slugs": [
            "chiamerò-verb"
          ]
        },
        {
          "id": "2023227",
          "text": "Vi chiamerò un taxi.",
          "translation": "Я вызову Вам такси.",
          "source": "Tatoeba #2023227 @Guybrush88 / #5491034 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2023227",
          "cefr_level": "A1",
          "word_slugs": [
            "chiamerò-verb"
          ]
        },
        {
          "id": "5619493",
          "text": "Ti chiamerò appena so qualcosa.",
          "translation": "Я позвоню тебе, как только что-нибудь узнаю.",
          "source": "Tatoeba #5619493 @dnnywld / #4092572 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619493",
          "cefr_level": "A1",
          "word_slugs": [
            "chiamerò-verb"
          ]
        },
        {
          "id": "6893506",
          "text": "Appena sarò libero, ti chiamerò.",
          "translation": "Я, как освобожусь, наберу тебе.",
          "source": "Tatoeba #6893506 @dnnywld / #6893402 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893506",
          "cefr_level": "A1",
          "word_slugs": [
            "chiamerò-verb"
          ]
        },
        {
          "id": "11281257",
          "text": "Ti chiamerò quando finirò il lavoro.",
          "translation": "Я тебя позову, когда закончу работу.",
          "source": "Tatoeba #11281257 @dnnywld / #8654947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11281257",
          "cefr_level": "A1",
          "word_slugs": [
            "chiamerò-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "chiamerò",
        "plural": "",
        "infinitive": "chiamerò"
      }
