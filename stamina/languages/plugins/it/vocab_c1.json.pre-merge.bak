    {
      "slug": "bicchieri-noun",
      "lemma": "bicchieri",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5581,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6952042",
          "text": "Entrambi i bicchieri rimasero intatti.",
          "translation": "Оба стакана остались нетронутыми.",
          "source": "Tatoeba #6952042 @dnnywld / #4479693 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952042",
          "cefr_level": "A1",
          "word_slugs": [
            "bicchieri-noun"
          ]
        },
        {
          "id": "6585516",
          "text": "Sul tavolo c'erano dei bicchieri?",
          "translation": "На столе были какие-нибудь стаканы?",
          "source": "Tatoeba #6585516 @dnnywld / #6584849 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6585516",
          "cefr_level": "A1",
          "word_slugs": [
            "bicchieri-noun"
          ]
        },
        {
          "id": "10754634",
          "text": "Lei versò la vodka nei bicchieri.",
          "translation": "Она разлила водку в стаканы.",
          "source": "Tatoeba #10754634 @dnnywld / #991475 @Vanjatko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754634",
          "cefr_level": "A1",
          "word_slugs": [
            "bicchieri-noun"
          ]
        },
        {
          "id": "7084995",
          "text": "Riempii entrambi i bicchieri di vino.",
          "translation": "Я наполнил оба бокала вином.",
          "source": "Tatoeba #7084995 @dnnywld / #7084027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7084995",
          "cefr_level": "A1",
          "word_slugs": [
            "bicchieri-noun"
          ]
        },
        {
          "id": "5403015",
          "text": "Lui ha riempito i bicchieri col vino.",
          "translation": "Он наполнил бокалы вином.",
          "source": "Tatoeba #5403015 @dnnywld / #2309216 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5403015",
          "cefr_level": "A1",
          "word_slugs": [
            "bicchieri-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il bicchieri",
