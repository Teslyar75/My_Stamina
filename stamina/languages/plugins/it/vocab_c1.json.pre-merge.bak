    {
      "slug": "misteriosa-adj",
      "lemma": "misteriosa",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7745,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1199392",
          "text": "Sei così misteriosa.",
          "translation": "Ты такая таинственная.",
          "source": "Tatoeba #1199392 @Guybrush88 / #8178324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1199392",
          "cefr_level": "A1",
          "word_slugs": [
            "misteriosa-adj"
          ]
        },
        {
          "id": "3862359",
          "text": "Re John morì di una malattia misteriosa.",
          "translation": "Король Джон умер от загадочной болезни.",
          "source": "Tatoeba #3862359 @Guybrush88 / #4783440 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3862359",
          "cefr_level": "A1",
          "word_slugs": [
            "misteriosa-adj"
          ]
        },
        {
          "id": "10911259",
          "text": "Dentro la piramide è stata scoperta una stanza misteriosa.",
          "translation": "Внутри пирамиды была найдена загадочная камера.",
          "source": "Tatoeba #10911259 @dnnywld / #10911073 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10911259",
          "cefr_level": "A1",
          "word_slugs": [
            "misteriosa-adj"
          ]
        },
        {
          "id": "5865937",
          "text": "La morte è una dama misteriosa che non conosce misericordia.",
          "translation": "Смерть — таинственная дама, не знающая пощады.",
          "source": "Tatoeba #5865937 @dnnywld / #5865581 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5865937",
          "cefr_level": "A1",
          "word_slugs": [
            "misteriosa-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il misteriosa",
        "plural": "",
        "infinitive": ""
      }
    },
