    {
      "slug": "vedendo-verb",
      "lemma": "vedendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5083,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6130100",
          "text": "Li sto vedendo.",
          "translation": "Я вижу их.",
          "source": "Tatoeba #6130100 @dnnywld / #6129999 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6130100",
          "cefr_level": "A1",
          "word_slugs": [
            "vedendo-verb"
          ]
        },
        {
          "id": "5899953",
          "text": "Chi stai vedendo?",
          "translation": "Кого ты видишь?",
          "source": "Tatoeba #5899953 @dnnywld / #5899689 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5899953",
          "cefr_level": "A1",
          "word_slugs": [
            "vedendo-verb"
          ]
        },
        {
          "id": "5927839",
          "text": "Tom ci sta vedendo?",
          "translation": "Том нас видит?",
          "source": "Tatoeba #5927839 @dnnywld / #5927600 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5927839",
          "cefr_level": "A1",
          "word_slugs": [
            "vedendo-verb"
          ]
        },
        {
          "id": "6130096",
          "text": "La sto già vedendo.",
          "translation": "Я уже её вижу.",
          "source": "Tatoeba #6130096 @dnnywld / #6130010 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6130096",
          "cefr_level": "A1",
          "word_slugs": [
            "vedendo-verb"
          ]
        },
        {
          "id": "6167207",
          "text": "Sto vedendo un film.",
          "translation": "Я смотрю кино.",
          "source": "Tatoeba #6167207 @dnnywld / #6167196 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6167207",
          "cefr_level": "A1",
          "word_slugs": [
            "vedendo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
