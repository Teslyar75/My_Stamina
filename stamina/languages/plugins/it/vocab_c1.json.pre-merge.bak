    {
      "slug": "ratti-noun",
      "lemma": "ratti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8391,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6891258",
          "text": "Hai paura dei ratti?",
          "translation": "Ты боишься крыс?",
          "source": "Tatoeba #6891258 @dnnywld / #5011572 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891258",
          "cefr_level": "A1",
          "word_slugs": [
            "ratti-noun"
          ]
        },
        {
          "id": "5480156",
          "text": "A nessuno piacciono i ratti.",
          "translation": "Никому не нравятся крысы.",
          "source": "Tatoeba #5480156 @Guybrush88 / #2517743 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5480156",
          "cefr_level": "A1",
          "word_slugs": [
            "ratti-noun"
          ]
        },
        {
          "id": "5395578",
          "text": "La spazzatura è piena di ratti.",
          "translation": "Помойка кишит крысами.",
          "source": "Tatoeba #5395578 @dnnywld / #5395471 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5395578",
          "cefr_level": "A1",
          "word_slugs": [
            "ratti-noun"
          ]
        },
        {
          "id": "5395600",
          "text": "Abbiamo la cantina piena di ratti.",
          "translation": "У нас в подвале полно крыс.",
          "source": "Tatoeba #5395600 @dnnywld / #5395455 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5395600",
          "cefr_level": "A1",
          "word_slugs": [
            "ratti-noun"
          ]
        },
        {
          "id": "5662166",
          "text": "I ratti sono vettori di infezione.",
          "translation": "Крысы — переносчики заразы.",
          "source": "Tatoeba #5662166 @dnnywld / #5661375 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662166",
          "cefr_level": "A1",
          "word_slugs": [
            "ratti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ratti",
