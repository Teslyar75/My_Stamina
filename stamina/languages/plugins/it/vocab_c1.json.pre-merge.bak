    {
      "slug": "precedenza-noun",
      "lemma": "precedenza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8806,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5513037",
          "text": "Cos'è successo in precedenza?",
          "translation": "Что было сначала?",
          "source": "Tatoeba #5513037 @dnnywld / #5512964 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513037",
          "cefr_level": "A1",
          "word_slugs": [
            "precedenza-noun"
          ]
        },
        {
          "id": "6958960",
          "text": "Dando la precedenza a Maria, Tom le spalancò la porta davanti.",
          "translation": "Пропуская Марию вперёд, Том распахнул перед ней дверь.",
