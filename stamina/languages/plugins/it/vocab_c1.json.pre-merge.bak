      "examples": [
        {
          "id": "5524466",
          "text": "Si interessano di politica.",
          "translation": "Они интересуются политикой.",
          "source": "Tatoeba #5524466 @dnnywld / #5524200 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5524466",
          "cefr_level": "A1",
          "word_slugs": [
