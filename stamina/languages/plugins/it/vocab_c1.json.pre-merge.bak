    {
      "slug": "ballando-verb",
      "lemma": "ballando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9579,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5635240",
          "text": "Adesso stiamo ballando.",
          "translation": "Сейчас мы танцуем.",
          "source": "Tatoeba #5635240 @dnnywld / #5635078 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635240",
          "cefr_level": "A1",
          "word_slugs": [
            "ballando-verb"
          ]
        },
        {
          "id": "1900771",
          "text": "Tutti i ragazzi stavano ballando.",
          "translation": "Все парни танцевали.",
          "source": "Tatoeba #1900771 @Guybrush88 / #3141398 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1900771",
          "cefr_level": "A1",
          "word_slugs": [
            "ballando-verb"
          ]
        },
        {
          "id": "3399450",
          "text": "Tom e Mary stavano ballando sulla musica.",
          "translation": "Том и Мэри танцевали под музыку.",
          "source": "Tatoeba #3399450 @Guybrush88 / #2986420 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3399450",
          "cefr_level": "A1",
          "word_slugs": [
            "ballando-verb"
          ]
        },
        {
          "id": "6009526",
          "text": "Chi è quel ragazzo che sta ballando con Mary?",
          "translation": "Что это за мальчик с Мэри танцует?",
          "source": "Tatoeba #6009526 @dnnywld / #6008040 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009526",
          "cefr_level": "A1",
          "word_slugs": [
            "ballando-verb"
          ]
        }
      ],
