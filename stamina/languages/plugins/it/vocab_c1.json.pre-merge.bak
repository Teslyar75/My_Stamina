            "scappati-adj"
          ]
        },
        {
          "id": "5504460",
          "text": "Come siete scappati?",
          "translation": "Как вы сбежите?",
          "source": "Tatoeba #5504460 @dnnywld / #5504296 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504460",
          "cefr_level": "A1",
          "word_slugs": [
            "scappati-adj"
          ]
        },
        {
          "id": "5387665",
          "text": "Perché siete scappati?",
          "translation": "Почему вы убежали?",
          "source": "Tatoeba #5387665 @dnnywld / #5387662 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387665",
          "cefr_level": "A1",
          "word_slugs": [
            "scappati-adj"
          ]
        },
        {
          "id": "6062600",
          "text": "Siamo scappati dal cane.",
          "translation": "Мы убежали от собаки.",
          "source": "Tatoeba #6062600 @dnnywld / #6061437 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6062600",
          "cefr_level": "A1",
          "word_slugs": [
