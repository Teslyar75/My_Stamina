          "cefr_level": "A1",
          "word_slugs": [
            "rissa-noun"
          ]
        },
        {
          "id": "6954846",
          "text": "Hai visto la rissa al parco?",
          "translation": "Ты видел драку в парке?",
          "source": "Tatoeba #6954846 @dnnywld / #6954402 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6954846",
          "cefr_level": "A1",
          "word_slugs": [
            "rissa-noun"
          ]
        },
        {
          "id": "10805523",
          "text": "Le cose sono finite in rissa.",
          "translation": "Дело дошло до драки.",
          "source": "Tatoeba #10805523 @dnnywld / #6175940 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10805523",
          "cefr_level": "A1",
          "word_slugs": [
            "rissa-noun"
          ]
        }
