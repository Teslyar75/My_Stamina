          ]
        },
        {
          "id": "5672482",
          "text": "Posso mangiare questa arancia?",
          "translation": "Мне можно съесть этот апельсин?",
          "source": "Tatoeba #5672482 @dnnywld / #5672458 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672482",
          "cefr_level": "A1",
          "word_slugs": [
