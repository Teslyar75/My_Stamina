      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "380430",
          "text": "La volpe è un animale selvaggio.",
          "translation": "Лиса - дикое животное.",
          "source": "Tatoeba #380430 @Pharamp / #3160567 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/380430",
          "cefr_level": "A1",
          "word_slugs": [
            "volpe-noun"
          ]
        },
        {
          "id": "6160331",
          "text": "I cani da caccia seguirono l'odore della volpe.",
          "translation": "Охотничьи собаки пошли на запах лисы.",
          "source": "Tatoeba #6160331 @dnnywld / #5742873 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6160331",
          "cefr_level": "A1",
          "word_slugs": [
            "volpe-noun"
          ]
        },
        {
          "id": "3137142",
          "text": "Quando la volpe non arriva all’uva dice che è acerba.",
          "translation": "Когда лиса не может достать виноград, она говорит, что он ещё зелёный.",
          "source": "Tatoeba #3137142 @Guybrush88 / #3137354 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3137142",
          "cefr_level": "A1",
          "word_slugs": [
            "volpe-noun"
          ]
        },
        {
          "id": "5499676",
          "text": "Tom non conosce la differenza tra un lupo e una volpe.",
          "translation": "Том не знает, какая разница между волком и лисой.",
          "source": "Tatoeba #5499676 @dnnywld / #5499010 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499676",
          "cefr_level": "A1",
          "word_slugs": [
            "volpe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la volpe",
        "plural": "",
        "infinitive": ""
      }
