    {
      "slug": "arrivate-adj",
      "lemma": "arrivate",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5257,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7633692",
          "text": "Non ci arrivate?",
          "translation": "Вы не въезжаете?",
          "source": "Tatoeba #7633692 @dnnywld / #7633636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7633692",
          "cefr_level": "A1",
          "word_slugs": [
            "arrivate-adj"
          ]
        },
        {
          "id": "6857126",
          "text": "Scrivetemi quando arrivate.",
          "translation": "Напишите мне, когда приедете.",
          "source": "Tatoeba #6857126 @dnnywld / #6856975 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857126",
          "cefr_level": "A1",
          "word_slugs": [
            "arrivate-adj"
          ]
        },
        {
          "id": "7015493",
          "text": "Appena arrivate, telefonate.",
          "translation": "Как подъедете, позвоните.",
          "source": "Tatoeba #7015493 @dnnywld / #7015145 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7015493",
          "cefr_level": "A1",
          "word_slugs": [
            "arrivate-adj"
          ]
        },
        {
          "id": "10780957",
          "text": "Telefonateci quando arrivate.",
          "translation": "Позвоните нам, когда приедете.",
          "source": "Tatoeba #10780957 @dnnywld / #4094854 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10780957",
          "cefr_level": "A1",
          "word_slugs": [
            "arrivate-adj"
          ]
        },
        {
          "id": "6904505",
          "text": "Appena arrivate, comunicatemelo.",
          "translation": "Как только приедете, сообщите мне.",
          "source": "Tatoeba #6904505 @dnnywld / #6903926 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904505",
          "cefr_level": "A1",
          "word_slugs": [
            "arrivate-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
