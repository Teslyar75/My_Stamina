          ]
        },
        {
          "id": "5454529",
          "text": "Eravamo tutti molto affamati.",
          "translation": "Мы все были очень голодные.",
          "source": "Tatoeba #5454529 @dnnywld / #5454038 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5454529",
          "cefr_level": "A1",
          "word_slugs": [
