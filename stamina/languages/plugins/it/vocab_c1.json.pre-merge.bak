    {
      "slug": "competere-verb",
      "lemma": "competere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8093,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5930879",
          "text": "Non puoi competere con Tom.",
          "translation": "Ты Тому не чета.",
          "source": "Tatoeba #5930879 @dnnywld / #5929755 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5930879",
          "cefr_level": "A1",
          "word_slugs": [
            "competere-verb"
          ]
        },
        {
          "id": "6944618",
          "text": "Con questo non possiamo competere.",
          "translation": "В этом мы не можем составить конкуренцию.",
          "source": "Tatoeba #6944618 @dnnywld / #2477383 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944618",
          "cefr_level": "A1",
          "word_slugs": [
            "competere-verb"
          ]
        },
        {
          "id": "7303100",
          "text": "In tali condizioni è molto difficile competere.",
          "translation": "В таких условиях конкурировать очень сложно.",
          "source": "Tatoeba #7303100 @dnnywld / #7302859 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7303100",
          "cefr_level": "A1",
          "word_slugs": [
            "competere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "competere",
        "plural": "",
        "infinitive": "competere"
      }
