      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8791,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6302261",
          "text": "Lei guidava la macchina.",
          "translation": "Она вела машину.",
          "source": "Tatoeba #6302261 @dnnywld / #3068011 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6302261",
          "cefr_level": "A1",
          "word_slugs": [
            "guidava-verb"
          ]
        },
        {
          "id": "6302260",
          "text": "Mary guidava la macchina.",
          "translation": "Мэри вела машину.",
          "source": "Tatoeba #6302260 @dnnywld / #3068009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6302260",
          "cefr_level": "A1",
          "word_slugs": [
            "guidava-verb"
          ]
        },
        {
          "id": "6883169",
          "text": "Lui guidava la macchina ascoltando la musica alla radio.",
          "translation": "Он вёл машину, слушая музыку по радио.",
          "source": "Tatoeba #6883169 @dnnywld / #6882280 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883169",
          "cefr_level": "A1",
          "word_slugs": [
            "guidava-verb"
          ]
        },
        {
          "id": "6883170",
          "text": "Lui guidava la macchina mentre ascoltava musica per radio.",
          "translation": "Он вёл машину, слушая музыку по радио.",
          "source": "Tatoeba #6883170 @dnnywld / #6882280 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883170",
          "cefr_level": "A1",
          "word_slugs": [
            "guidava-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
