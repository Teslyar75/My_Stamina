    {
      "slug": "tartaruga-noun",
      "lemma": "tartaruga",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7963,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6879091",
          "text": "La tartaruga è morta.",
          "translation": "Черепаха умерла.",
          "source": "Tatoeba #6879091 @dnnywld / #6878463 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879091",
          "cefr_level": "A1",
          "word_slugs": [
            "tartaruga-noun"
          ]
        },
        {
          "id": "6025745",
          "text": "Hai comprato una tartaruga?",
          "translation": "Ты купил черепаху?",
          "source": "Tatoeba #6025745 @dnnywld / #6025634 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6025745",
          "cefr_level": "A1",
          "word_slugs": [
            "tartaruga-noun"
          ]
        },
        {
          "id": "5549015",
          "text": "Lui è lento come una tartaruga.",
          "translation": "Он медленный как черепаха.",
          "source": "Tatoeba #5549015 @dnnywld / #5547672 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549015",
          "cefr_level": "A1",
          "word_slugs": [
            "tartaruga-noun"
          ]
        },
        {
          "id": "6920987",
          "text": "Cos'hai da trascinarti come una tartaruga?",
          "translation": "Что ты тащишься как черепаха?",
          "source": "Tatoeba #6920987 @dnnywld / #6919955 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6920987",
          "cefr_level": "A1",
          "word_slugs": [
            "tartaruga-noun"
          ]
        },
        {
          "id": "3139349",
          "text": "Volevo donarti anche la tartaruga, ma è scappata.",
          "translation": "Я хотел подарить тебе ещё и черепаху, но она убежала.",
          "source": "Tatoeba #3139349 @Guybrush88 / #3139396 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3139349",
          "cefr_level": "A1",
          "word_slugs": [
            "tartaruga-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la tartaruga",
        "plural": "",
        "infinitive": ""
      }
    },
