    {
      "slug": "disperatamente-adv",
      "lemma": "disperatamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7511,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2997641",
          "text": "Lui è disperatamente romantico.",
          "translation": "Он безнадёжный романтик.",
          "source": "Tatoeba #2997641 @al_ex_an_der / #2997636 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2997641",
          "cefr_level": "A1",
          "word_slugs": [
            "disperatamente-adv"
          ]
        },
        {
          "id": "5387831",
          "text": "Tom si è innamorato di lei disperatamente.",
          "translation": "Том отчаянно в неё влюбился.",
          "source": "Tatoeba #5387831 @dnnywld / #5387820 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387831",
          "cefr_level": "A1",
          "word_slugs": [
            "disperatamente-adv"
          ]
        },
        {
          "id": "6004607",
          "text": "Lei si sforzava disperatamente di perdere peso.",
          "translation": "Она отчаянно стремилась похудеть.",
          "source": "Tatoeba #6004607 @dnnywld / #6004493 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6004607",
          "cefr_level": "A1",
          "word_slugs": [
            "disperatamente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "disperatamente",
        "plural": "",
        "infinitive": ""
      }
