    {
      "slug": "occidentale-adj",
      "lemma": "occidentale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7112,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5616226",
          "text": "Tom viveva nella costa occidentale.",
          "translation": "Том жил на западном побережье.",
          "source": "Tatoeba #5616226 @dnnywld / #5615814 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5616226",
          "cefr_level": "A1",
          "word_slugs": [
            "occidentale-adj"
          ]
        },
        {
          "id": "882478",
          "text": "Niente di nuovo sul fronte occidentale.",
          "translation": "На западном фронте без перемен.",
          "source": "Tatoeba #882478 @Hans07 / #895098 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/882478",
          "cefr_level": "A1",
          "word_slugs": [
            "occidentale-adj"
          ]
        },
        {
          "id": "12755403",
          "text": "Lo slovacco è una lingua slava occidentale.",
          "translation": "Словацкий - западнославянский язык.",
          "source": "Tatoeba #12755403 @Adelpa / #11671131 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12755403",
          "cefr_level": "A1",
          "word_slugs": [
            "occidentale-adj"
          ]
        },
        {
          "id": "7000410",
          "text": "Il Portogallo è il paese più occidentale del continente europeo.",
          "translation": "Португалия — самая западная страна европейского континента.",
          "source": "Tatoeba #7000410 @dnnywld / #7000078 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7000410",
          "cefr_level": "A1",
          "word_slugs": [
            "occidentale-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il occidentale",
        "plural": "",
        "infinitive": ""
      }
    },
