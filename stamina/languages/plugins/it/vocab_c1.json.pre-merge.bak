    {
      "slug": "vena-noun",
      "lemma": "vena",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6057,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5603931",
          "text": "Non sono in vena di leggere.",
          "translation": "Мне что-то неохота читать.",
          "source": "Tatoeba #5603931 @dnnywld / #4463142 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5603931",
          "cefr_level": "A1",
          "word_slugs": [
            "vena-noun"
          ]
        },
        {
          "id": "5603889",
          "text": "Non mi sento in vena di ridere.",
          "translation": "Мне что-то не смешно.",
          "source": "Tatoeba #5603889 @dnnywld / #3039635 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5603889",
          "cefr_level": "A1",
          "word_slugs": [
            "vena-noun"
          ]
        },
        {
          "id": "5632482",
          "text": "Semplicemente non sono in vena di questo.",
          "translation": "Я просто не в настроении для этого.",
          "source": "Tatoeba #5632482 @dnnywld / #3105102 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632482",
          "cefr_level": "A1",
          "word_slugs": [
            "vena-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la vena",
        "plural": "",
        "infinitive": ""
      }
