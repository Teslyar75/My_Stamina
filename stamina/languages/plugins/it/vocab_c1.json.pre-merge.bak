    {
      "slug": "ricchezza-noun",
      "lemma": "ricchezza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7661,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5549660",
          "text": "Non ho sete di ricchezza.",
          "translation": "Я не жажду богатства.",
          "source": "Tatoeba #5549660 @dnnywld / #426978 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549660",
          "cefr_level": "A1",
          "word_slugs": [
            "ricchezza-noun"
          ]
        },
        {
          "id": "10854268",
          "text": "La salute è meglio della ricchezza.",
          "translation": "Здоровье лучше богатства.",
          "source": "Tatoeba #10854268 @dnnywld / #710782 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854268",
          "cefr_level": "A1",
          "word_slugs": [
            "ricchezza-noun"
          ]
        },
        {
          "id": "5965998",
          "text": "Preferisco la conoscenza rispetto alla ricchezza.",
          "translation": "Я предпочитаю знания богатству.",
          "source": "Tatoeba #5965998 @dnnywld / #5965559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5965998",
          "cefr_level": "A1",
          "word_slugs": [
            "ricchezza-noun"
          ]
        },
        {
          "id": "6950682",
          "text": "Lui ha lasciato al figlio un enorme ricchezza.",
          "translation": "Он оставил сыну огромное состояние.",
          "source": "Tatoeba #6950682 @dnnywld / #4447121 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950682",
          "cefr_level": "A1",
          "word_slugs": [
            "ricchezza-noun"
          ]
        },
        {
          "id": "5966002",
          "text": "La ricchezza e la salute vanno di pari passo.",
          "translation": "Богатство и здоровье идут рука об руку.",
          "source": "Tatoeba #5966002 @dnnywld / #5965556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5966002",
          "cefr_level": "A1",
          "word_slugs": [
            "ricchezza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la ricchezza",
        "plural": "",
        "infinitive": ""
      }
