    {
      "slug": "resterà-verb",
      "lemma": "resterà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6636,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1999811",
          "text": "Tom non resterà.",
          "translation": "Том не останется.",
          "source": "Tatoeba #1999811 @Guybrush88 / #2001523 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1999811",
          "cefr_level": "A1",
          "word_slugs": [
            "resterà-verb"
          ]
        },
        {
          "id": "2959829",
          "text": "Tom resterà a casa.",
          "translation": "Том останется дома.",
          "source": "Tatoeba #2959829 @Guybrush88 / #2968825 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2959829",
          "cefr_level": "A1",
          "word_slugs": [
            "resterà-verb"
          ]
        },
        {
          "id": "4741623",
          "text": "La Siria resterà unita.",
          "translation": "Сирия останется единой.",
          "source": "Tatoeba #4741623 @Guybrush88 / #4741642 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4741623",
          "cefr_level": "A1",
          "word_slugs": [
            "resterà-verb"
          ]
        },
        {
          "id": "5438444",
          "text": "E chi resterà in negozio?",
          "translation": "А кто в лавке останется?",
          "source": "Tatoeba #5438444 @dnnywld / #5438239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5438444",
          "cefr_level": "A1",
          "word_slugs": [
            "resterà-verb"
          ]
        },
        {
          "id": "4741621",
          "text": "La Russia resterà sempre unita.",
          "translation": "Россия всегда будет оставаться единой.",
          "source": "Tatoeba #4741621 @Guybrush88 / #4741647 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4741621",
          "cefr_level": "A1",
          "word_slugs": [
            "resterà-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
