      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6425,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5456606",
          "text": "Proverò a convincerlo.",
          "translation": "Я попробую его уговорить.",
          "source": "Tatoeba #5456606 @dnnywld / #5456591 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5456606",
          "cefr_level": "A1",
          "word_slugs": [
            "proverò-verb"
          ]
        },
        {
          "id": "5590454",
          "text": "Proverò a trovare Tom.",
          "translation": "Я попробую найти Тома.",
          "source": "Tatoeba #5590454 @dnnywld / #5590227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5590454",
          "cefr_level": "A1",
          "word_slugs": [
            "proverò-verb"
          ]
        },
        {
          "id": "5688911",
          "text": "Prometto che ci proverò.",
          "translation": "Обещаю, что попробую.",
          "source": "Tatoeba #5688911 @dnnywld / #4567536 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688911",
          "cefr_level": "A1",
          "word_slugs": [
            "proverò-verb"
          ]
        },
        {
          "id": "2398660",
          "text": "Non proverò a descriverlo.",
          "translation": "Не буду пытаться это описать.",
          "source": "Tatoeba #2398660 @Guybrush88 / #4542765 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2398660",
          "cefr_level": "A1",
          "word_slugs": [
            "proverò-verb"
          ]
        },
        {
          "id": "7739432",
          "text": "Proverò a farlo nel weekend.",
          "translation": "Я постараюсь сделать это в выходные.",
          "source": "Tatoeba #7739432 @Valdast / #6405244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7739432",
          "cefr_level": "A1",
          "word_slugs": [
            "proverò-verb"
          ]
        }
      ],
