      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "719251",
          "text": "Gli italiani mangiano sempre spaghetti.",
          "translation": "Итальянцы всегда едят спагетти.",
          "source": "Tatoeba #719251 @Guybrush88 / #2652501 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/719251",
          "cefr_level": "A1",
          "word_slugs": [
            "italiani-adj"
          ]
        },
        {
          "id": "719226",
          "text": "Gli italiani non bevono mai caffè.",
          "translation": "Итальянцы никогда не пьют кофе.",
          "source": "Tatoeba #719226 @Guybrush88 / #1746131 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/719226",
          "cefr_level": "A1",
          "word_slugs": [
            "italiani-adj"
          ]
        },
        {
          "id": "5247652",
          "text": "Gli Italiani sono un popolo tenace.",
          "translation": "Итальянцы - упорный народ.",
          "source": "Tatoeba #5247652 @Adelpa / #5247705 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5247652",
          "cefr_level": "A1",
          "word_slugs": [
            "italiani-adj"
          ]
        },
        {
          "id": "719247",
          "text": "Gli italiani parlano raramente di politica.",
          "translation": "Итальянцы редко говорят о политике.",
          "source": "Tatoeba #719247 @Guybrush88 / #1569941 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/719247",
          "cefr_level": "A1",
          "word_slugs": [
