    {
      "slug": "venivo-verb",
      "lemma": "venivo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7883,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6146475",
          "text": "Da bambino venivo spesso qui.",
          "translation": "Ребёнком я часто сюда приходил.",
          "source": "Tatoeba #6146475 @dnnywld / #6145738 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6146475",
          "cefr_level": "A1",
          "word_slugs": [
            "venivo-verb"
          ]
        },
        {
          "id": "2062997",
          "text": "Nella mia infanzia venivo spesso qui. Mi guardavo intorno e pensavo.",
          "translation": "В детстве я часто приходил сюда, смотрел вокруг и думал.",
          "source": "Tatoeba #2062997 @al_ex_an_der / #2062989 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2062997",
          "cefr_level": "A1",
          "word_slugs": [
            "venivo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "venivo",
        "plural": "",
        "infinitive": "venivo"
      }
