    {
      "slug": "pedro-name",
      "lemma": "Pedro",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8661,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7146130",
          "text": "Pedro è sopravvissuto.",
          "translation": "Педро выжил.",
          "source": "Tatoeba #7146130 @dnnywld / #7146081 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7146130",
          "cefr_level": "A1",
          "word_slugs": [
            "pedro-name"
          ]
        },
        {
          "id": "5986974",
          "text": "Posso parlare con Pedro?",
          "translation": "Можно поговорить с Педро?",
          "source": "Tatoeba #5986974 @dnnywld / #5986774 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5986974",
          "cefr_level": "A1",
          "word_slugs": [
            "pedro-name"
          ]
        },
        {
          "id": "7146132",
          "text": "Pedro è morto dopo un'infermità prolungata.",
          "translation": "Педро умер после продолжительной болезни.",
          "source": "Tatoeba #7146132 @dnnywld / #7146079 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7146132",
          "cefr_level": "A1",
          "word_slugs": [
            "pedro-name"
          ]
        },
        {
          "id": "6000614",
          "text": "Tutti, eccetto Pedro, erano d'accordo con questa idea.",
          "translation": "Все, кроме Педро, были согласны с этой идеей.",
          "source": "Tatoeba #6000614 @dnnywld / #6000444 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6000614",
          "cefr_level": "A1",
          "word_slugs": [
            "pedro-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il Pedro",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "vicinato-noun",
      "lemma": "vicinato",
      "pos": "noun",
