          "cefr_level": "A1",
          "word_slugs": [
            "registrare-verb"
          ]
        },
        {
          "id": "10840904",
          "text": "Vorrei scoprire come registrare un DVD.",
          "translation": "Я хотел бы выяснить, как записать DVD.",
          "source": "Tatoeba #10840904 @dnnywld / #4320493 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10840904",
          "cefr_level": "A1",
          "word_slugs": [
            "registrare-verb"
          ]
        }
