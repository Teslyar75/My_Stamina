    {
      "slug": "azzurro-adj",
      "lemma": "azzurro",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8400,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5942466",
          "text": "Che cielo azzurro!",
          "translation": "Какое голубое небо!",
          "source": "Tatoeba #5942466 @dnnywld / #5942206 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5942466",
          "cefr_level": "A1",
          "word_slugs": [
            "azzurro-adj"
          ]
        },
        {
          "id": "6908149",
          "text": "Ho un occhio verde e l'altro azzurro.",
          "translation": "Один глаз у меня зелёный, а другой — голубой.",
          "source": "Tatoeba #6908149 @dnnywld / #6908024 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908149",
          "cefr_level": "A1",
          "word_slugs": [
            "azzurro-adj"
          ]
        },
        {
          "id": "5609105",
          "text": "L'azzurro del cielo si riflette sul mare.",
          "translation": "Небесная лазурь отражается в море.",
          "source": "Tatoeba #5609105 @dnnywld / #5608825 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5609105",
          "cefr_level": "A1",
          "word_slugs": [
            "azzurro-adj"
          ]
        },
        {
          "id": "5507476",
          "text": "Il vestito azzurro ti sta meglio di quello giallo.",
          "translation": "Голубое платье тебе идёт больше, чем жёлтое.",
          "source": "Tatoeba #5507476 @dnnywld / #5507064 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507476",
          "cefr_level": "A1",
          "word_slugs": [
            "azzurro-adj"
          ]
        },
        {
          "id": "6782439",
          "text": "Il cielo è azzurro, ma il mare ancora di più.",
          "translation": "Небо синее, а море ещё синее.",
          "source": "Tatoeba #6782439 @dnnywld / #6780461 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6782439",
          "cefr_level": "A1",
          "word_slugs": [
            "azzurro-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
