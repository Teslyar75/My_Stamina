    {
      "slug": "pc-abbrev",
      "lemma": "PC",
      "pos": "abbrev",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9928,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2579573",
          "text": "Stai pensando di cambiare PC?",
          "translation": "Думаешь поменять компьютер?",
          "source": "Tatoeba #2579573 @Guybrush88 / #3232361 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2579573",
          "cefr_level": "A1",
          "word_slugs": [
            "pc-abbrev"
          ]
        },
        {
          "id": "2588040",
          "text": "Spegni il PC e comincia a studiare.",
          "translation": "Выключи компьютер и начни учиться.",
          "source": "Tatoeba #2588040 @Guybrush88 / #4387179 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2588040",
          "cefr_level": "A1",
          "word_slugs": [
            "pc-abbrev"
          ]
        },
        {
          "id": "7490539",
          "text": "Mio figlio resta tutto il tempo attaccato al pc.",
          "translation": "Мой сын всё время сидит за компьютером.",
          "source": "Tatoeba #7490539 @dnnywld / #7490346 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7490539",
          "cefr_level": "A1",
          "word_slugs": [
            "pc-abbrev"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "PC",
        "plural": "",
        "infinitive": ""
      }
    },
    {
