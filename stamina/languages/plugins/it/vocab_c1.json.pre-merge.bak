    {
      "slug": "tranquillamente-adv",
      "lemma": "tranquillamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7921,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6890094",
          "text": "Puoi comportarti tranquillamente?",
          "translation": "Ты можешь вести себя тихо?",
          "source": "Tatoeba #6890094 @dnnywld / #5195324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890094",
          "cefr_level": "A1",
          "word_slugs": [
            "tranquillamente-adv"
          ]
        },
        {
          "id": "6890095",
          "text": "Potete comportarvi tranquillamente?",
          "translation": "Вы можете вести себя тихо?",
          "source": "Tatoeba #6890095 @dnnywld / #5195325 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890095",
          "cefr_level": "A1",
          "word_slugs": [
            "tranquillamente-adv"
          ]
        },
        {
          "id": "6890081",
          "text": "Dobbiamo comportarci tranquillamente.",
          "translation": "Мы должны вести себя тихо.",
          "source": "Tatoeba #6890081 @dnnywld / #4127271 @dan1ruusianspanish (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890081",
          "cefr_level": "A1",
          "word_slugs": [
            "tranquillamente-adv"
          ]
        },
        {
          "id": "6890056",
          "text": "Tom dovrebbe comportarsi più tranquillamente.",
          "translation": "Ты должен вести себя спокойнее.",
          "source": "Tatoeba #6890056 @dnnywld / #412217 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890056",
          "cefr_level": "A1",
          "word_slugs": [
            "tranquillamente-adv"
          ]
        },
        {
          "id": "6372276",
          "text": "Tom ed io abbiamo parlato tranquillamente.",
          "translation": "Мы с Томом спокойно поговорили.",
          "source": "Tatoeba #6372276 @dnnywld / #6371928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6372276",
          "cefr_level": "A1",
          "word_slugs": [
            "tranquillamente-adv"
          ]
        }
      ],
      "tags": [
