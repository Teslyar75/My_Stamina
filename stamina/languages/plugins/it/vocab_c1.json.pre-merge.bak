          ]
        },
        {
          "id": "5571261",
          "text": "Sono stata arrestata per averlo aiutato nella fuga.",
          "translation": "Я была арестована за то, что помогла ему при побеге.",
          "source": "Tatoeba #5571261 @dnnywld / #5570393 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571261",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestata-adj"
          ]
        },
        {
          "id": "5620713",
          "text": "Per errore è stata arrestata una persona innocente.",
          "translation": "По ошибке был задержан невинный человек.",
          "source": "Tatoeba #5620713 @dnnywld / #2916683 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5620713",
          "cefr_level": "A1",
          "word_slugs": [
            "arrestata-adj"
          ]
        }
      ],
