    {
      "slug": "microfono-noun",
      "lemma": "microfono",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5401,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "микрофон"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5440372",
          "text": "Il microfono gracchia.",
          "translation": "Микрофон трещит.",
          "source": "Tatoeba #5440372 @dnnywld / #5440109 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5440372",
          "cefr_level": "A1",
          "word_slugs": [
            "microfono-noun"
          ]
        },
        {
          "id": "10772627",
          "text": "Il microfono è tuo.",
          "translation": "Микрофон твой.",
          "source": "Tatoeba #10772627 @dnnywld / #2857444 @Shady_arc (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10772627",
          "cefr_level": "A1",
          "word_slugs": [
            "microfono-noun"
          ]
        },
        {
          "id": "5596427",
          "text": "Per qualche motivo prima il microfono non funzionava.",
          "translation": "По какой-то причине раньше не работал микрофон.",
          "source": "Tatoeba #5596427 @dnnywld / #2241803 @KatrinI (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5596427",
          "cefr_level": "A1",
          "word_slugs": [
            "microfono-noun"
          ]
        },
        {
          "id": "2194124",
          "text": "Il microfono, per qualche motivo, fino a quel momento non aveva funzionato.",
          "translation": "Микрофон по какой-то причине до этого не работал.",
          "source": "Tatoeba #2194124 @graphite / #5426 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2194124",
          "cefr_level": "A1",
          "word_slugs": [
            "microfono-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il microfono",
        "plural": "",
        "infinitive": ""
      }
