    {
      "slug": "cagnolino-noun",
      "lemma": "cagnolino",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7807,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5601823",
          "text": "Voglio questo cagnolino.",
          "translation": "Я хочу этого щенка.",
          "source": "Tatoeba #5601823 @dnnywld / #5601771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5601823",
          "cefr_level": "A1",
          "word_slugs": [
            "cagnolino-noun"
          ]
        },
        {
          "id": "5804190",
          "text": "Hanno regalato un cagnolino a Tom.",
          "translation": "Тому подарили щенка.",
          "source": "Tatoeba #5804190 @dnnywld / #5803589 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5804190",
          "cefr_level": "A1",
          "word_slugs": [
            "cagnolino-noun"
          ]
        },
        {
          "id": "5632294",
          "text": "Il cagnolino la guardò molto tristemente.",
          "translation": "Пёсик посмотрел на неё очень грустно.",
          "source": "Tatoeba #5632294 @dnnywld / #379115 @Dorenda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632294",
          "cefr_level": "A1",
          "word_slugs": [
            "cagnolino-noun"
          ]
        },
        {
          "id": "894765",
          "text": "C'è un cagnolino marrone sotto quel tavolo.",
          "translation": "Под тем столом маленький коричневый щенок.",
          "source": "Tatoeba #894765 @riccioberto / #2158081 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/894765",
          "cefr_level": "A1",
          "word_slugs": [
            "cagnolino-noun"
          ]
        },
        {
          "id": "6587131",
          "text": "Possiamo usare la gabbia del gatto anche per un cagnolino.",
          "translation": "Кошачью переноску мы можем использовать и для маленькой собачки.",
          "source": "Tatoeba #6587131 @dnnywld / #6584675 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6587131",
          "cefr_level": "A1",
          "word_slugs": [
            "cagnolino-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il cagnolino",
        "plural": "",
        "infinitive": ""
      }
