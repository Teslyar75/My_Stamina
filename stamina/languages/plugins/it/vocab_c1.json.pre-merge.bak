      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "373754",
          "text": "Mi piace il jazz.",
          "translation": "Мне нравится джаз.",
          "source": "Tatoeba #373754 @Pharamp / #407619 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/373754",
          "cefr_level": "A1",
