    {
      "slug": "guidi-verb",
      "lemma": "guidi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5805,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6903284",
          "text": "Guidi molto bene.",
          "translation": "Ты очень хорошо водишь.",
          "source": "Tatoeba #6903284 @dnnywld / #4265125 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6903284",
          "cefr_level": "A1",
          "word_slugs": [
            "guidi-verb"
          ]
        },
        {
          "id": "6903283",
          "text": "Che macchina guidi?",
          "translation": "Какую машину ты водишь?",
          "source": "Tatoeba #6903283 @dnnywld / #3753861 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6903283",
          "cefr_level": "A1",
          "word_slugs": [
            "guidi-verb"
          ]
        },
        {
          "id": "6890160",
          "text": "Guidi troppo veloce.",
          "translation": "Ты ведёшь слишком быстро.",
          "source": "Tatoeba #6890160 @dnnywld / #4245499 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890160",
          "cefr_level": "A1",
          "word_slugs": [
            "guidi-verb"
          ]
        },
        {
          "id": "6901882",
          "text": "Vuoi che guidi io?",
          "translation": "Хочешь, я поведу?",
          "source": "Tatoeba #6901882 @dnnywld / #3517553 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6901882",
          "cefr_level": "A1",
          "word_slugs": [
            "guidi-verb"
          ]
        },
        {
          "id": "10881908",
          "text": "Voglio che guidi tu.",
          "translation": "Я хочу, чтобы вёл машину.",
          "source": "Tatoeba #10881908 @dnnywld / #8043471 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10881908",
          "cefr_level": "A1",
          "word_slugs": [
            "guidi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "guidi",
        "plural": "",
        "infinitive": "guidi"
      }
