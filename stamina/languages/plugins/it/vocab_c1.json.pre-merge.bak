    {
      "slug": "occuparsi-verb",
      "lemma": "occuparsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5336,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5452715",
          "text": "Lei vuole occuparsi dell'insegnamento.",
          "translation": "Она хочет заняться преподаванием.",
          "source": "Tatoeba #5452715 @dnnywld / #2468709 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452715",
          "cefr_level": "A1",
          "word_slugs": [
            "occuparsi-verb"
          ]
        },
        {
          "id": "6007239",
          "text": "Tom voleva occuparsi di qualcos'altro.",
          "translation": "Том хотел заняться чем-то ещё.",
          "source": "Tatoeba #6007239 @dnnywld / #6006884 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6007239",
          "cefr_level": "A1",
          "word_slugs": [
            "occuparsi-verb"
          ]
        },
        {
          "id": "6723470",
          "text": "Chiedi a Mary di cosa vuole occuparsi.",
          "translation": "Спроси Мэри, чем она хочет заняться.",
          "source": "Tatoeba #6723470 @dnnywld / #6719244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6723470",
          "cefr_level": "A1",
          "word_slugs": [
            "occuparsi-verb"
          ]
        },
        {
          "id": "6723351",
          "text": "Chiedete a Mary di cosa vuole occuparsi.",
          "translation": "Спросите Мэри, чем она хочет заняться.",
          "source": "Tatoeba #6723351 @dnnywld / #6719245 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6723351",
          "cefr_level": "A1",
          "word_slugs": [
            "occuparsi-verb"
          ]
        },
        {
          "id": "6893683",
          "text": "Sarebbe meglio occuparsi di qualcosa di utile.",
          "translation": "Лучше бы чем-нибудь полезным занялся.",
          "source": "Tatoeba #6893683 @dnnywld / #6893274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893683",
          "cefr_level": "A1",
          "word_slugs": [
            "occuparsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "occuparsi",
        "plural": "",
        "infinitive": "occuparsi"
      }
