    {
      "slug": "gocce-noun",
      "lemma": "gocce",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9012,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5483222",
          "text": "Sembrate due gocce d'acqua.",
          "translation": "Вы похожи друг на друга.",
          "source": "Tatoeba #5483222 @dnnywld / #5482775 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5483222",
          "cefr_level": "A1",
