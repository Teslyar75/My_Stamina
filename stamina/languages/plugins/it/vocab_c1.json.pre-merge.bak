    {
      "slug": "candele-noun",
      "lemma": "candele",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6174,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5671009",
          "text": "Mary accese le candele.",
          "translation": "Мэри зажгла свечи.",
          "source": "Tatoeba #5671009 @dnnywld / #5670416 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5671009",
          "cefr_level": "A1",
          "word_slugs": [
            "candele-noun"
          ]
        },
        {
          "id": "1106806",
          "text": "Le candele rischiaravano la stanza.",
          "translation": "Свечи осветили комнату.",
          "source": "Tatoeba #1106806 @riccioberto / #598438 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1106806",
          "cefr_level": "A1",
          "word_slugs": [
            "candele-noun"
          ]
        },
        {
          "id": "3830384",
          "text": "Accenderanno delle candele nella loro camera.",
          "translation": "Они зажгут свечи у себя в комнате.",
          "source": "Tatoeba #3830384 @Guybrush88 / #4532027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3830384",
          "cefr_level": "A1",
          "word_slugs": [
            "candele-noun"
          ]
        },
        {
          "id": "3830379",
          "text": "Lei accenderà delle candele nella sua camera.",
          "translation": "Она зажжёт свечи у себя в комнате.",
          "source": "Tatoeba #3830379 @Guybrush88 / #4532036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3830379",
          "cefr_level": "A1",
          "word_slugs": [
            "candele-noun"
          ]
        },
        {
          "id": "6874282",
          "text": "Tom spense le luci dappertutto e accese le candele.",
          "translation": "Том выключил везде свет и зажёг свечи.",
          "source": "Tatoeba #6874282 @dnnywld / #6863017 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6874282",
          "cefr_level": "A1",
          "word_slugs": [
            "candele-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
