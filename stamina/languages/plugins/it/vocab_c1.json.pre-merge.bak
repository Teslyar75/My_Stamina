    {
      "slug": "gentilezza-noun",
      "lemma": "gentilezza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6082,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5486192",
          "text": "La gentilezza è una virtù.",
          "translation": "Доброта - это добродетель.",
          "source": "Tatoeba #5486192 @dnnywld / #5485489 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5486192",
          "cefr_level": "A1",
          "word_slugs": [
            "gentilezza-noun"
          ]
        },
        {
          "id": "10885683",
          "text": "La gentilezza non ha prezzo.",
          "translation": "Доброта бесценна.",
          "source": "Tatoeba #10885683 @dnnywld / #3874932 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885683",
          "cefr_level": "A1",
          "word_slugs": [
            "gentilezza-noun"
          ]
        },
        {
          "id": "1217382",
          "text": "Vorrei ripagarlo per la sua gentilezza.",
          "translation": "Я бы хотел отплатить ему за его доброту.",
          "source": "Tatoeba #1217382 @Guybrush88 / #1643720 @Hayabusa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1217382",
          "cefr_level": "A1",
          "word_slugs": [
            "gentilezza-noun"
          ]
        },
        {
          "id": "612087",
          "text": "Non posso dimenticare la sua gentilezza.",
          "translation": "Я не могу забыть её доброту.",
          "source": "Tatoeba #612087 @Guybrush88 / #5812475 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/612087",
          "cefr_level": "A1",
          "word_slugs": [
            "gentilezza-noun"
          ]
        },
        {
          "id": "11353537",
          "text": "Tom non sa cosa sia la gentilezza.",
          "translation": "Том не знает, что такое вежливость.",
          "source": "Tatoeba #11353537 @Valdast / #9929112 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11353537",
          "cefr_level": "A1",
          "word_slugs": [
            "gentilezza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la gentilezza",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "rispondo-verb",
      "lemma": "rispondo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6083,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10854132",
          "text": "Rispondo a tutti.",
          "translation": "Я всем отвечаю.",
          "source": "Tatoeba #10854132 @dnnywld / #10854102 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854132",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondo-verb"
          ]
        },
        {
          "id": "3363230",
          "text": "Rispondo alla domanda.",
          "translation": "Я отвечаю на вопрос.",
          "source": "Tatoeba #3363230 @Guybrush88 / #5679857 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3363230",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondo-verb"
          ]
        },
        {
          "id": "5683695",
          "text": "Rispondo alle domande.",
          "translation": "Я отвечаю на вопросы.",
          "source": "Tatoeba #5683695 @dnnywld / #5679860 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683695",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondo-verb"
          ]
        },
        {
          "id": "5419416",
          "text": "Rispondo io per loro.",
          "translation": "Я отвечаю за них.",
          "source": "Tatoeba #5419416 @dnnywld / #4809706 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419416",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondo-verb"
          ]
        },
        {
          "id": "10854131",
          "text": "Rispondo sempre a tutti.",
          "translation": "Я всегда всем отвечаю.",
          "source": "Tatoeba #10854131 @dnnywld / #10854103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854131",
          "cefr_level": "A1",
          "word_slugs": [
            "rispondo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "rispondo",
        "plural": "",
        "infinitive": "rispondo"
      }
