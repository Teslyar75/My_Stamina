    {
      "slug": "soffrendo-verb",
      "lemma": "soffrendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6478,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8010252",
          "text": "Perché stiamo soffrendo?",
          "translation": "Почему мы страдаем?",
          "source": "Tatoeba #8010252 @Guybrush88 / #9038970 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8010252",
          "cefr_level": "A1",
          "word_slugs": [
            "soffrendo-verb"
          ]
        },
        {
          "id": "10793243",
          "text": "Sto veramente soffrendo.",
          "translation": "Я действительно страдаю.",
          "source": "Tatoeba #10793243 @dnnywld / #3232997 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10793243",
          "cefr_level": "A1",
          "word_slugs": [
            "soffrendo-verb"
          ]
        },
        {
          "id": "5447077",
          "text": "Sappiamo che stai soffrendo.",
          "translation": "Мы знаем, что тебе больно.",
          "source": "Tatoeba #5447077 @dnnywld / #5446868 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5447077",
          "cefr_level": "A1",
          "word_slugs": [
            "soffrendo-verb"
          ]
        },
        {
          "id": "5907037",
          "text": "Sto soffrendo per causa Vostra.",
          "translation": "Из-за Вас я страдаю.",
          "source": "Tatoeba #5907037 @dnnywld / #5906050 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907037",
          "cefr_level": "A1",
          "word_slugs": [
            "soffrendo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "soffrendo",
        "plural": "",
        "infinitive": "soffrendo"
      }
