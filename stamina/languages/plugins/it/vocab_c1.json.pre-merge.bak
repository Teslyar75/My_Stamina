    {
      "slug": "canali-noun",
      "lemma": "canali",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8469,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5128923",
          "text": "Amsterdam è famosa per suoi canali.",
          "translation": "Амстердам знаменит своими каналами.",
          "source": "Tatoeba #5128923 @Guybrush88 / #5119803 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5128923",
          "cefr_level": "A1",
          "word_slugs": [
            "canali-noun"
          ]
        },
        {
          "id": "6829899",
          "text": "Trasmettono calcio quasi in tutti i canali.",
          "translation": "Почти по всем каналам показывают футбол.",
          "source": "Tatoeba #6829899 @dnnywld / #6829846 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6829899",
          "cefr_level": "A1",
          "word_slugs": [
            "canali-noun"
          ]
        },
        {
          "id": "6139850",
          "text": "Era necessario costruire condutture dell'acqua e canali di scolo.",
          "translation": "Нужно было соорудить водопровод и канализацию.",
          "source": "Tatoeba #6139850 @dnnywld / #1942239 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6139850",
          "cefr_level": "A1",
          "word_slugs": [
            "canali-noun"
          ]
        }
      ],
