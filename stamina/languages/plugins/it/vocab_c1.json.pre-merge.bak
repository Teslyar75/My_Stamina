    {
      "slug": "quattordici-adj",
      "lemma": "quattordici",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8742,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "четырнадцать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5870005",
          "text": "Mio figlio ha quattordici mesi.",
          "translation": "Моему сыну год и два.",
          "source": "Tatoeba #5870005 @dnnywld / #5869971 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5870005",
          "cefr_level": "A1",
          "word_slugs": [
            "quattordici-adj"
          ]
        },
        {
          "id": "6025320",
          "text": "A tavola eravamo in quattordici.",
          "translation": "За столом нас было четырнадцать.",
          "source": "Tatoeba #6025320 @dnnywld / #6024492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6025320",
          "cefr_level": "A1",
          "word_slugs": [
            "quattordici-adj"
          ]
        },
        {
          "id": "5484962",
          "text": "Tom ha perso quattordici chilogrammi.",
          "translation": "Том похудел на четырнадцать килограмм.",
          "source": "Tatoeba #5484962 @dnnywld / #5484950 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5484962",
          "cefr_level": "A1",
          "word_slugs": [
            "quattordici-adj"
          ]
        },
        {
          "id": "5437836",
          "text": "Tom ha perso quasi quattordici chilogrammi.",
          "translation": "Том похудел почти на четырнадцать килограмм.",
          "source": "Tatoeba #5437836 @dnnywld / #5437748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5437836",
          "cefr_level": "A1",
          "word_slugs": [
            "quattordici-adj"
          ]
        },
        {
          "id": "12392078",
          "text": "Due moltiplicato per sette uguale quattordici.",
          "translation": "Два умножить на семь будет четырнадцать.",
          "source": "Tatoeba #12392078 @Bernie75 / #12392347 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12392078",
          "cefr_level": "A1",
          "word_slugs": [
            "quattordici-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "quattordici",
        "plural": "",
        "infinitive": ""
      }
    },
