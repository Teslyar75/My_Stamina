    {
      "slug": "differenti-adj",
      "lemma": "differenti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7616,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6964923",
          "text": "Abbiamo priorità differenti.",
          "translation": "У нас разные приоритеты.",
          "source": "Tatoeba #6964923 @dnnywld / #6964552 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6964923",
          "cefr_level": "A1",
          "word_slugs": [
            "differenti-adj"
          ]
        },
        {
          "id": "7298928",
          "text": "Prima ed adesso sono cose differenti.",
          "translation": "Раньше и теперь - это разные вещи.",
          "source": "Tatoeba #7298928 @dnnywld / #7298349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7298928",
          "cefr_level": "A1",
          "word_slugs": [
            "differenti-adj"
          ]
        },
        {
          "id": "5843891",
          "text": "Potete utilizzare i metodi più differenti.",
          "translation": "Можно использовать самые разные методы.",
          "source": "Tatoeba #5843891 @dnnywld / #1971533 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843891",
          "cefr_level": "A1",
          "word_slugs": [
            "differenti-adj"
          ]
        },
        {
          "id": "6460629",
          "text": "Le nostre opinioni sono piuttosto differenti.",
          "translation": "Наши мнения отличаются.",
          "source": "Tatoeba #6460629 @Guybrush88 / #6460872 @ViolettaKoriagina (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6460629",
          "cefr_level": "A1",
          "word_slugs": [
            "differenti-adj"
          ]
        },
        {
          "id": "5981173",
          "text": "A colori differenti corrispondono diversi significati.",
          "translation": "Разным цветам соответствуют разные значения.",
          "source": "Tatoeba #5981173 @dnnywld / #598590 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5981173",
          "cefr_level": "A1",
          "word_slugs": [
            "differenti-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il differenti",
        "plural": "",
        "infinitive": ""
      }
