    {
      "slug": "riconosci-verb",
      "lemma": "riconosci",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5625,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6000734",
          "text": "Riconosci questo ragazzo?",
          "translation": "Ты узнаёшь этого парня?",
          "source": "Tatoeba #6000734 @dnnywld / #5999828 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6000734",
          "cefr_level": "A1",
          "word_slugs": [
            "riconosci-verb"
          ]
        },
        {
          "id": "6856315",
          "text": "Sono io. Non mi riconosci?",
          "translation": "Это я. Не узнаёшь?",
          "source": "Tatoeba #6856315 @dnnywld / #6856088 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6856315",
          "cefr_level": "A1",
          "word_slugs": [
            "riconosci-verb"
          ]
        },
        {
          "id": "6775125",
          "text": "Embè, non riconosci tuo padre?",
          "translation": "Что, родного отца не узнаёшь?",
          "source": "Tatoeba #6775125 @dnnywld / #6774276 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6775125",
          "cefr_level": "A1",
          "word_slugs": [
            "riconosci-verb"
          ]
        },
        {
          "id": "6775126",
          "text": "Embè, non riconosci tuo figlio?",
          "translation": "Что, родного сына не узнаёшь?",
          "source": "Tatoeba #6775126 @dnnywld / #6774274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6775126",
          "cefr_level": "A1",
          "word_slugs": [
            "riconosci-verb"
          ]
        },
        {
          "id": "1699894",
          "text": "Riconosci l'uomo in questa fotografia?",
          "translation": "Узнаёшь мужчину на этой фотографии?",
          "source": "Tatoeba #1699894 @Guybrush88 / #10179963 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1699894",
          "cefr_level": "A1",
          "word_slugs": [
            "riconosci-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "riconosci",
        "plural": "",
        "infinitive": "riconosci"
      }
