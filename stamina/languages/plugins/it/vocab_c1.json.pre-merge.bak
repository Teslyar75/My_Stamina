          ]
        },
        {
          "id": "5514445",
          "text": "Tom guardava con ammirazione.",
          "translation": "Том смотрел с восхищением.",
          "source": "Tatoeba #5514445 @dnnywld / #5513139 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514445",
          "cefr_level": "A1",
          "word_slugs": [
            "guardava-verb"
          ]
        },
        {
          "id": "6324955",
          "text": "A volte lei guardava il cielo.",
          "translation": "Иногда она смотрела на небо.",
          "source": "Tatoeba #6324955 @dnnywld / #6324313 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6324955",
          "cefr_level": "A1",
