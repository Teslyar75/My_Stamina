    {
      "slug": "provocato-verb",
      "lemma": "provocato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6883,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6594891",
          "text": "L'incidente ha provocato un ingorgo.",
          "translation": "Авария спровоцировала пробку.",
          "source": "Tatoeba #6594891 @dnnywld / #6594776 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6594891",
          "cefr_level": "A1",
          "word_slugs": [
            "provocato-verb"
          ]
        },
        {
          "id": "5649546",
          "text": "Il vostro malessere è provocato dallo stress.",
          "translation": "Ваша болезнь вызвана стрессом.",
          "source": "Tatoeba #5649546 @dnnywld / #5649128 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5649546",
          "cefr_level": "A1",
          "word_slugs": [
            "provocato-verb"
          ]
        },
        {
          "id": "5594649",
          "text": "La nevicata ha provocato grossi ingorghi stradali a Mosca.",
          "translation": "Снегопад в Москве спровоцировал огромные пробки.",
          "source": "Tatoeba #5594649 @dnnywld / #5594575 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5594649",
          "cefr_level": "A1",
          "word_slugs": [
            "provocato-verb"
          ]
        },
        {
          "id": "6866707",
          "text": "Tom si è addormentato al volante e ha provocato un incidente.",
          "translation": "Том заснул за рулём и совершил ДТП.",
          "source": "Tatoeba #6866707 @dnnywld / #6864652 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866707",
          "cefr_level": "A1",
          "word_slugs": [
            "provocato-verb"
          ]
        },
        {
          "id": "5907046",
          "text": "L'arrivo di Tom a casa nostra ha provocato un autentico subbuglio.",
          "translation": "Приезд Тома вызвал в нашем доме настоящий переполох.",
          "source": "Tatoeba #5907046 @dnnywld / #5905946 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907046",
          "cefr_level": "A1",
          "word_slugs": [
            "provocato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il provocato",
        "plural": "",
        "infinitive": "provocato"
      }
    },
