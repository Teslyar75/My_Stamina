    {
      "slug": "patria-noun",
      "lemma": "patria",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5496,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5885003",
          "text": "La patria non si sceglie.",
          "translation": "Родину не выбирают.",
          "source": "Tatoeba #5885003 @dnnywld / #4106377 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885003",
          "cefr_level": "A1",
          "word_slugs": [
            "patria-noun"
          ]
        },
        {
          "id": "6866634",
          "text": "Ho dovuto lasciare la patria.",
          "translation": "Мне пришлось покинуть родную землю.",
          "source": "Tatoeba #6866634 @dnnywld / #6865348 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866634",
          "cefr_level": "A1",
          "word_slugs": [
            "patria-noun"
          ]
        },
        {
          "id": "5942852",
          "text": "Hanno combattuto per la patria.",
          "translation": "Они сражались за свою страну.",
          "source": "Tatoeba #5942852 @dnnywld / #5942013 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5942852",
          "cefr_level": "A1",
          "word_slugs": [
            "patria-noun"
          ]
        },
        {
          "id": "5647647",
          "text": "Noi difendiamo la nostra Patria.",
          "translation": "Мы защищаем нашу Родину.",
          "source": "Tatoeba #5647647 @dnnywld / #3575089 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647647",
          "cefr_level": "A1",
          "word_slugs": [
            "patria-noun"
          ]
        },
        {
          "id": "5433585",
          "text": "La patria è orgogliosa di te.",
          "translation": "Родина тобой гордится.",
          "source": "Tatoeba #5433585 @dnnywld / #2198357 @vinkara (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433585",
          "cefr_level": "A1",
          "word_slugs": [
            "patria-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
