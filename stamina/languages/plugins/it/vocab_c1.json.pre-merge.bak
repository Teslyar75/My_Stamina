      "examples": [
        {
          "id": "5604311",
          "text": "C'è stata una rissa?",
          "translation": "Была драка?",
          "source": "Tatoeba #5604311 @dnnywld / #5604218 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5604311",
          "cefr_level": "A1",
          "word_slugs": [
