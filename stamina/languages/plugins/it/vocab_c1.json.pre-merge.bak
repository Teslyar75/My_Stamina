    {
      "slug": "corea-noun",
      "lemma": "corea",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5494,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "824223",
          "text": "Voglio visitare la Corea del Sud.",
          "translation": "Я хочу съездить в Южную Корею.",
