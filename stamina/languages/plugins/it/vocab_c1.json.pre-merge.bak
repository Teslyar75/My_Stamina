    {
      "slug": "trucchi-noun",
      "lemma": "trucchi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6518,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10846786",
          "text": "Conosciamo i vostri trucchi.",
          "translation": "Мы знаем ваши уловки.",
          "source": "Tatoeba #10846786 @dnnywld / #10846634 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846786",
          "cefr_level": "A1",
          "word_slugs": [
            "trucchi-noun"
          ]
        },
        {
          "id": "5435719",
          "text": "Ho utilizzato tutti i trucchi che conoscevo.",
          "translation": "Он использовал все уловки, которые знал.",
          "source": "Tatoeba #5435719 @dnnywld / #4138686 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5435719",
          "cefr_level": "A1",
          "word_slugs": [
            "trucchi-noun"
          ]
        },
        {
          "id": "5558738",
          "text": "Per tutti i tuoi \"trucchi\" ti attende una padella all'inferno.",
          "translation": "За все твои \"фокусы\" тебя ждёт сковородка в аду.",
          "source": "Tatoeba #5558738 @dnnywld / #5558635 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5558738",
          "cefr_level": "A1",
          "word_slugs": [
            "trucchi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il trucchi",
        "plural": "",
        "infinitive": ""
      }
    },
