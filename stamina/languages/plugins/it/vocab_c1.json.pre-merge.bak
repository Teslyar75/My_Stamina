      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "8895891",
          "text": "Dieci persone sono venute alla lezione.",
          "translation": "На лекцию пришло десять человек.",
          "source": "Tatoeba #8895891 @carlosalberto / #8895782 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8895891",
          "cefr_level": "A1",
          "word_slugs": [
            "venute-noun"
          ]
        },
        {
          "id": "7073363",
          "text": "Mary, le amiche sono venute per te.",
          "translation": "Мэри, к тебе подруги пришли.",
          "source": "Tatoeba #7073363 @dnnywld / #7072876 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7073363",
          "cefr_level": "A1",
          "word_slugs": [
            "venute-noun"
          ]
        },
        {
          "id": "7073364",
          "text": "Mary, le amiche sono venute a trovarti.",
          "translation": "Мэри, к тебе подруги пришли.",
          "source": "Tatoeba #7073364 @dnnywld / #7072876 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7073364",
          "cefr_level": "A1",
          "word_slugs": [
            "venute-noun"
          ]
        },
        {
          "id": "5683648",
          "text": "Sono venute qui più di un centinaio di persone.",
          "translation": "Сюда пришли более ста человек.",
          "source": "Tatoeba #5683648 @dnnywld / #5682237 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683648",
          "cefr_level": "A1",
          "word_slugs": [
            "venute-noun"
          ]
        }
      ],
