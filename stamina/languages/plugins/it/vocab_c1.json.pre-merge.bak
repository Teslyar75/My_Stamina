          ]
        },
        {
          "id": "4516882",
          "text": "Chi è l'architetto?",
          "translation": "Кто архитектор?",
          "source": "Tatoeba #4516882 @Guybrush88 / #4932352 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4516882",
          "cefr_level": "A1",
