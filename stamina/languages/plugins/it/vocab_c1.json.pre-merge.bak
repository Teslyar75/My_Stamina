    {
      "slug": "cantato-verb",
      "lemma": "cantato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8471,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3347321",
          "text": "Tom ha cantato stonato.",
          "translation": "Том пел фальшиво.",
          "source": "Tatoeba #3347321 @Guybrush88 / #3347327 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3347321",
          "cefr_level": "A1",
          "word_slugs": [
            "cantato-verb"
          ]
        },
        {
          "id": "11862396",
          "text": "Hanno cantato e ballato.",
          "translation": "Они пели и танцевали.",
          "source": "Tatoeba #11862396 @dnnywld / #11861125 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11862396",
          "cefr_level": "A1",
          "word_slugs": [
            "cantato-verb"
          ]
        },
        {
          "id": "5650414",
          "text": "Pua ha cantato in chiesa.",
          "translation": "Пуа пел в церкви.",
          "source": "Tatoeba #5650414 @dnnywld / #5650341 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650414",
          "cefr_level": "A1",
          "word_slugs": [
            "cantato-verb"
          ]
        },
        {
          "id": "5868583",
          "text": "Abbiamo cantato intorno al fuoco.",
          "translation": "Мы пели у костра.",
          "source": "Tatoeba #5868583 @dnnywld / #5783787 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868583",
          "cefr_level": "A1",
          "word_slugs": [
            "cantato-verb"
          ]
        },
        {
          "id": "5767916",
          "text": "Non hai mai cantato con Tom?",
          "translation": "Ты когда-нибудь пел с Томом?",
          "source": "Tatoeba #5767916 @dnnywld / #5767801 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5767916",
          "cefr_level": "A1",
          "word_slugs": [
            "cantato-verb"
          ]
        }
