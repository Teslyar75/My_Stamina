      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5701,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7312064",
          "text": "I tubi andavano cambiati secoli fa.",
          "translation": "Трубы надо было давным-давно поменять.",
          "source": "Tatoeba #7312064 @dnnywld / #7311803 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7312064",
          "cefr_level": "A1",
          "word_slugs": [
            "andavano-verb"
          ]
        },
        {
          "id": "2603422",
          "text": "Tom e Mary andavano nella stessa scuola.",
          "translation": "Том и Мэри ходили в одну и ту же школу.",
          "source": "Tatoeba #2603422 @Guybrush88 / #5137325 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2603422",
          "cefr_level": "A1",
          "word_slugs": [
            "andavano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
