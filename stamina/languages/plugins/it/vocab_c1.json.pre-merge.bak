    {
      "slug": "lontanamente-adv",
      "lemma": "lontanamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9292,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6163715",
          "text": "Non riesco nemmeno lontanamente ad immaginare quanto questo possa costare.",
