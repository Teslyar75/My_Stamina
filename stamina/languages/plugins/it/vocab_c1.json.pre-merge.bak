    {
      "slug": "allah-name",
      "lemma": "Allah",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6306,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1074898",
          "text": "Allah è grande!",
          "translation": "Аллах велик!",
          "source": "Tatoeba #1074898 @Guybrush88 / #477440 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1074898",
          "cefr_level": "A1",
          "word_slugs": [
            "allah-name"
          ]
        },
        {
          "id": "6788139",
          "text": "Allah è ovunque.",
          "translation": "Аллах везде.",
          "source": "Tatoeba #6788139 @dnnywld / #3297806 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6788139",
          "cefr_level": "A1",
          "word_slugs": [
            "allah-name"
          ]
        },
        {
          "id": "6891169",
          "text": "Ho paura di Allah.",
          "translation": "Я боюсь Аллаха.",
          "source": "Tatoeba #6891169 @dnnywld / #3855053 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891169",
          "cefr_level": "A1",
          "word_slugs": [
            "allah-name"
          ]
        },
        {
          "id": "5591812",
          "text": "I musulmani considerano Allah l'unico Dio, e Maometto l'ultimo profeta.",
          "translation": "Мусульмане считают Аллаха единственным Богом, а Мухаммеда — последним пророком.",
          "source": "Tatoeba #5591812 @dnnywld / #5591528 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591812",
          "cefr_level": "A1",
          "word_slugs": [
            "allah-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "Allah",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "compiuto-adj",
      "lemma": "compiuto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6307,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5567787",
          "text": "Tom ha compiuto tredici anni.",
          "translation": "Тому исполнилось тринадцать лет.",
          "source": "Tatoeba #5567787 @dnnywld / #5567324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5567787",
          "cefr_level": "A1",
          "word_slugs": [
            "compiuto-adj"
          ]
        },
        {
          "id": "6051356",
          "text": "L'atleta ha compiuto una capriola.",
          "translation": "Спортсмен сделал сальто.",
          "source": "Tatoeba #6051356 @dnnywld / #6051351 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6051356",
          "cefr_level": "A1",
          "word_slugs": [
            "compiuto-adj"
          ]
        },
        {
          "id": "5964321",
          "text": "Ha compiuto un impresa. Siamo orgogliosi di Tom.",
          "translation": "Он совершил подвиг. Мы гордимся Томом.",
          "source": "Tatoeba #5964321 @dnnywld / #5963201 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964321",
          "cefr_level": "A1",
          "word_slugs": [
            "compiuto-adj"
          ]
        },
        {
          "id": "10846260",
          "text": "Quando mio bisnonno ha compiuto 99 anni, gli abbiamo regalato una pipa.",
          "translation": "Когда моему прадеду исполнилось 99 лет, мы подарили ему трубку.",
          "source": "Tatoeba #10846260 @dnnywld / #5537225 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846260",
          "cefr_level": "A1",
          "word_slugs": [
            "compiuto-adj"
          ]
        }
      ],
