    {
      "slug": "particolari-adj",
      "lemma": "particolari",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6356,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6590614",
          "text": "Come mai tutti questi particolari?",
          "translation": "Откуда столько подробностей?",
          "source": "Tatoeba #6590614 @dnnywld / #6588456 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6590614",
          "cefr_level": "A1",
          "word_slugs": [
            "particolari-adj"
          ]
        },
        {
          "id": "6590610",
          "text": "Da dove vengono questi particolari?",
          "translation": "Откуда такие подробности?",
          "source": "Tatoeba #6590610 @dnnywld / #6588457 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6590610",
          "cefr_level": "A1",
          "word_slugs": [
            "particolari-adj"
          ]
        },
        {
          "id": "6953117",
          "text": "Tom non voleva scendere nei particolari.",
          "translation": "Том не хотел вдаваться в подробности.",
          "source": "Tatoeba #6953117 @dnnywld / #6952829 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953117",
          "cefr_level": "A1",
          "word_slugs": [
            "particolari-adj"
          ]
        },
        {
          "id": "6963748",
          "text": "I suoi dipinti non hanno prezzi particolari.",
          "translation": "Его картины не имеют особой цены.",
          "source": "Tatoeba #6963748 @dnnywld / #6963163 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6963748",
          "cefr_level": "A1",
          "word_slugs": [
            "particolari-adj"
          ]
        },
        {
          "id": "11242318",
          "text": "Non potreste raccontare con più dovizia di particolari?",
          "translation": "Вы не могли бы рассказать поподробнее?",
          "source": "Tatoeba #11242318 @dnnywld / #11242304 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11242318",
          "cefr_level": "A1",
          "word_slugs": [
            "particolari-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il particolari",
