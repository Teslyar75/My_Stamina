    {
      "slug": "vivevo-verb",
      "lemma": "vivevo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8811,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6173208",
          "text": "Vivevo a Boston.",
          "translation": "Я жил в Бостоне.",
          "source": "Tatoeba #6173208 @Guybrush88 / #3549806 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6173208",
          "cefr_level": "A1",
          "word_slugs": [
            "vivevo-verb"
          ]
        },
        {
          "id": "5232740",
          "text": "Vivevo nella povertà.",
          "translation": "Я жил в бедности.",
          "source": "Tatoeba #5232740 @Guybrush88 / #3668110 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5232740",
          "cefr_level": "A1",
          "word_slugs": [
            "vivevo-verb"
          ]
        },
        {
          "id": "5557866",
          "text": "Vivevo con mia zia.",
          "translation": "Я жил со своей тётей.",
          "source": "Tatoeba #5557866 @dnnywld / #5557549 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5557866",
          "cefr_level": "A1",
          "word_slugs": [
            "vivevo-verb"
          ]
        },
        {
          "id": "6061538",
          "text": "Quando ero uno studente, vivevo a Parigi.",
          "translation": "Когда я был студентом, я жил в Париже.",
          "source": "Tatoeba #6061538 @Sonny / #6061669 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6061538",
          "cefr_level": "A1",
          "word_slugs": [
            "vivevo-verb"
          ]
        },
        {
          "id": "6857299",
          "text": "Quando vivevo in riva al mare, nuovato molto.",
          "translation": "Когда я жил на берегу моря, я много купался.",
          "source": "Tatoeba #6857299 @dnnywld / #6810155 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857299",
          "cefr_level": "A1",
          "word_slugs": [
            "vivevo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
