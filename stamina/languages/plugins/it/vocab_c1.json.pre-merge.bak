    {
      "slug": "scorre-verb",
      "lemma": "scorre",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6757,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "350392",
          "text": "Il fiume scorre verso il mare.",
          "translation": "Река впадает в море.",
          "source": "Tatoeba #350392 @martin / #3082808 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350392",
          "cefr_level": "A1",
          "word_slugs": [
            "scorre-verb"
          ]
        },
        {
          "id": "5650428",
          "text": "Attorno alla città scorre un fiume.",
          "translation": "Вокруг города течёт река.",
          "source": "Tatoeba #5650428 @dnnywld / #5650250 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650428",
          "cefr_level": "A1",
          "word_slugs": [
            "scorre-verb"
          ]
        },
        {
          "id": "5523488",
          "text": "Il tempo scorre ad una velocità pazzesca.",
          "translation": "Время несётся с бешеной скоростью.",
          "source": "Tatoeba #5523488 @dnnywld / #5523206 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5523488",
          "cefr_level": "A1",
          "word_slugs": [
            "scorre-verb"
          ]
        },
        {
          "id": "3122689",
          "text": "Il fiume scorre parallelo alla via principale.",
          "translation": "Река течёт параллельно главной улице.",
          "source": "Tatoeba #3122689 @Guybrush88 / #3122698 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3122689",
          "cefr_level": "A1",
          "word_slugs": [
            "scorre-verb"
          ]
        },
        {
          "id": "6884978",
          "text": "L'acqua piovana scorre dal tubo di scarico.",
          "translation": "Из водосточной трубы течёт дождевая вода.",
          "source": "Tatoeba #6884978 @dnnywld / #6884049 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884978",
          "cefr_level": "A1",
          "word_slugs": [
            "scorre-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "scorre",
        "plural": "",
        "infinitive": "scorre"
      }
    },
