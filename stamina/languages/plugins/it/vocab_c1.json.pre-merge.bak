    {
      "slug": "ebbe-verb",
      "lemma": "ebbe",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5916,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2515067",
          "text": "Ebbe successo nella vita.",
          "translation": "Он преуспел в жизни.",
          "source": "Tatoeba #2515067 @Guybrush88 / #2355988 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2515067",
          "cefr_level": "A1",
          "word_slugs": [
            "ebbe-verb"
          ]
        },
        {
          "id": "2947964",
          "text": "Ebbe un'esperienza amara.",
          "translation": "У него был горький опыт.",
          "source": "Tatoeba #2947964 @Guybrush88 / #3280220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2947964",
          "cefr_level": "A1",
          "word_slugs": [
            "ebbe-verb"
          ]
        },
        {
          "id": "2181580",
          "text": "Tom ebbe un jet lag.",
