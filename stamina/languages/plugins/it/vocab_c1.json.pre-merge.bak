          "cefr_level": "A1",
          "word_slugs": [
            "lento-adj"
          ]
        },
        {
          "id": "6536650",
          "text": "Perché sei così lento?",
          "translation": "Почему ты такой медлительный?",
          "source": "Tatoeba #6536650 @Guybrush88 / #6671008 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6536650",
          "cefr_level": "A1",
          "word_slugs": [
            "lento-adj"
          ]
        },
        {
          "id": "5966031",
          "text": "Questo computer è così lento!",
          "translation": "Этот компьютер так тормозит!",
          "source": "Tatoeba #5966031 @dnnywld / #5965300 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5966031",
