          ]
        },
        {
          "id": "2811601",
          "text": "Le vostre vene contengono acqua.",
          "translation": "Ваши вены содержат воду.",
          "source": "Tatoeba #2811601 @Guybrush88 / #8783926 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2811601",
          "cefr_level": "A1",
          "word_slugs": [
            "vene-noun"
          ]
        },
        {
          "id": "3376115",
          "text": "Il cuore fa circolare il sangue nelle arterie e nelle vene.",
          "translation": "Сердце заставляет кровь циркулировать по артериям и венам.",
          "source": "Tatoeba #3376115 @rado / #3376272 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3376115",
          "cefr_level": "A1",
          "word_slugs": [
            "vene-noun"
          ]
        }
      ],
