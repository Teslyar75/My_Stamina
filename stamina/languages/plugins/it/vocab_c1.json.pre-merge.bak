    {
      "slug": "restituito-adj",
      "lemma": "restituito",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9026,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4618848",
          "text": "L'ho restituito.",
          "translation": "Я его вернул.",
          "source": "Tatoeba #4618848 @Guybrush88 / #3678963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4618848",
          "cefr_level": "A1",
          "word_slugs": [
            "restituito-adj"
          ]
        },
        {
          "id": "5602633",
          "text": "L'hanno restituito.",
          "translation": "Они вернули его.",
          "source": "Tatoeba #5602633 @dnnywld / #5602254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5602633",
          "cefr_level": "A1",
          "word_slugs": [
            "restituito-adj"
          ]
        },
        {
          "id": "6214028",
          "text": "Questo va restituito.",
          "translation": "Это надо вернуть.",
          "source": "Tatoeba #6214028 @dnnywld / #6213030 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6214028",
          "cefr_level": "A1",
          "word_slugs": [
            "restituito-adj"
          ]
        },
        {
          "id": "5833244",
          "text": "Hai restituito i libri?",
          "translation": "Ты вернул книги?",
          "source": "Tatoeba #5833244 @dnnywld / #1442285 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5833244",
          "cefr_level": "A1",
          "word_slugs": [
            "restituito-adj"
          ]
        },
        {
          "id": "5833277",
          "text": "Abbiamo restituito i soldi.",
          "translation": "Мы вернули деньги.",
          "source": "Tatoeba #5833277 @dnnywld / #4240271 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5833277",
          "cefr_level": "A1",
