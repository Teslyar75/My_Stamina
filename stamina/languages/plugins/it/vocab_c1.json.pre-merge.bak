    {
      "slug": "procurato-verb",
      "lemma": "procurato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7570,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5543159",
          "text": "Come te lo sei procurato?",
          "translation": "Где ты это достал?",
          "source": "Tatoeba #5543159 @dnnywld / #5542713 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5543159",
          "cefr_level": "A1",
          "word_slugs": [
            "procurato-verb"
          ]
        },
        {
          "id": "5543164",
          "text": "Come ve lo siete procurato?",
          "translation": "Откуда это у вас?",
          "source": "Tatoeba #5543164 @dnnywld / #5542710 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5543164",
          "cefr_level": "A1",
          "word_slugs": [
            "procurato-verb"
          ]
        },
        {
          "id": "5556611",
          "text": "Mi sono procurato un biglietto omaggio.",
          "translation": "Я раздобыл бесплатный билет.",
          "source": "Tatoeba #5556611 @dnnywld / #5556318 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5556611",
          "cefr_level": "A1",
          "word_slugs": [
            "procurato-verb"
          ]
        },
        {
          "id": "7457488",
          "text": "Forse questo avrebbe procurato piacere a Tom.",
          "translation": "Возможно, это могло бы доставить удовольствие Тому.",
          "source": "Tatoeba #7457488 @dnnywld / #7457067 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7457488",
          "cefr_level": "A1",
          "word_slugs": [
            "procurato-verb"
          ]
        },
        {
          "id": "6375432",
          "text": "Mi chiedo come ti sia procurato quei soldi.",
          "translation": "Интересно, откуда у тебя деньги.",
          "source": "Tatoeba #6375432 @dnnywld / #6375180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6375432",
          "cefr_level": "A1",
          "word_slugs": [
            "procurato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il procurato",
        "plural": "",
        "infinitive": "procurato"
      }
