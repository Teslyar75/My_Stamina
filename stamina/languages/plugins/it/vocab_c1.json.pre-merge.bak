      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5889101",
          "text": "Andate piano che vi raggiungo.",
          "translation": "Идите не спеша, я вас догоню.",
          "source": "Tatoeba #5889101 @dnnywld / #5888969 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889101",
          "cefr_level": "A1",
