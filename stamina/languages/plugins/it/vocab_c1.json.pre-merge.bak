    {
      "slug": "scendendo-verb",
      "lemma": "scendendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8850,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10795175",
          "text": "Sto scendendo le scale.",
          "translation": "Я спускаюсь по лестнице.",
          "source": "Tatoeba #10795175 @dnnywld / #4918130 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10795175",
          "cefr_level": "A1",
          "word_slugs": [
            "scendendo-verb"
          ]
        },
        {
          "id": "6302265",
          "text": "Sta scendendo la nebbia.",
          "translation": "Туман опускается.",
          "source": "Tatoeba #6302265 @dnnywld / #4864935 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6302265",
          "cefr_level": "A1",
          "word_slugs": [
            "scendendo-verb"
          ]
        },
        {
          "id": "6787018",
          "text": "Stava scendendo la notte.",
          "translation": "Опускалась ночь.",
          "source": "Tatoeba #6787018 @dnnywld / #6487468 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6787018",
          "cefr_level": "A1",
          "word_slugs": [
            "scendendo-verb"
          ]
        },
        {
          "id": "10795176",
          "text": "Stiamo scendendo le scale.",
          "translation": "Мы спускаемся по лестнице.",
          "source": "Tatoeba #10795176 @dnnywld / #6161248 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10795176",
          "cefr_level": "A1",
          "word_slugs": [
            "scendendo-verb"
          ]
        },
        {
          "id": "10795171",
