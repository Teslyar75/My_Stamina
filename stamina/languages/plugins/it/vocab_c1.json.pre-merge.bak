    {
      "slug": "apro-verb",
      "lemma": "apro",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6211,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "903676",
          "text": "Ti dispiace se apro la porta?",
          "translation": "Ты не возражаешь, если я открою дверь?",
          "source": "Tatoeba #903676 @Guybrush88 / #476108 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/903676",
          "cefr_level": "A1",
          "word_slugs": [
            "apro-verb"
          ]
        },
        {
          "id": "897505",
          "text": "Ti dispiace se apro la finestra?",
          "translation": "Не возражаешь, если я окно открою?",
          "source": "Tatoeba #897505 @Guybrush88 / #3060216 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/897505",
          "cefr_level": "A1",
          "word_slugs": [
            "apro-verb"
          ]
        },
        {
          "id": "7073407",
          "text": "Non vi dispiace se apro la finestra?",
          "translation": "Вы не против, если я открою окно?",
          "source": "Tatoeba #7073407 @dnnywld / #7072694 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7073407",
          "cefr_level": "A1",
          "word_slugs": [
            "apro-verb"
          ]
        },
        {
          "id": "3036588",
          "text": "Apri la porta? — No, non apro la porta, ma la finestra.",
          "translation": "«Ты дверь открываешь?» — «Нет, не дверь, а окно».",
          "source": "Tatoeba #3036588 @rado / #3804030 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3036588",
          "cefr_level": "A1",
          "word_slugs": [
            "apro-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "apro",
