    {
      "slug": "scossa-adj",
      "lemma": "scossa",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7139,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6803396",
          "text": "So che sei scossa.",
          "translation": "Я знаю, что ты потрясена.",
          "source": "Tatoeba #6803396 @dnnywld / #6803312 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6803396",
          "cefr_level": "A1",
          "word_slugs": [
            "scossa-adj"
          ]
        },
        {
          "id": "10849694",
          "text": "La sua autorità è stata scossa.",
          "translation": "Его авторитет пошатнулся.",
          "source": "Tatoeba #10849694 @dnnywld / #9119642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849694",
          "cefr_level": "A1",
          "word_slugs": [
            "scossa-adj"
          ]
        },
        {
          "id": "6866832",
          "text": "Mary era troppo scossa per dire qualcosa.",
          "translation": "Мэри была слишком потрясена, чтобы что-то сказать.",
          "source": "Tatoeba #6866832 @dnnywld / #6863160 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866832",
          "cefr_level": "A1",
          "word_slugs": [
            "scossa-adj"
          ]
        },
        {
          "id": "5601500",
          "text": "Se toccherai questo cavo prenderai la scossa.",
          "translation": "Если тронешь этот кабель, тебя током ударит.",
          "source": "Tatoeba #5601500 @dnnywld / #5601304 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5601500",
          "cefr_level": "A1",
          "word_slugs": [
            "scossa-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il scossa",
        "plural": "",
        "infinitive": ""
      }
