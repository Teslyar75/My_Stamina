    {
      "slug": "adatta-adj",
      "lemma": "adatta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5281,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6851865",
          "text": "Chi si adatta a questa descrizione?",
          "translation": "Кто подходит под это описание?",
          "source": "Tatoeba #6851865 @dnnywld / #6851729 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6851865",
          "cefr_level": "A1",
          "word_slugs": [
            "adatta-adj"
          ]
        },
        {
          "id": "6851867",
          "text": "Lui si adatta a questa descrizione.",
          "translation": "Он подходит под это описание.",
          "source": "Tatoeba #6851867 @dnnywld / #6851728 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6851867",
          "cefr_level": "A1",
          "word_slugs": [
            "adatta-adj"
          ]
        },
        {
          "id": "10870869",
          "text": "Questa vite si adatta a questo dado.",
          "translation": "Этот болт подходит к этой гайке.",
          "source": "Tatoeba #10870869 @dnnywld / #3798339 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10870869",
          "cefr_level": "A1",
          "word_slugs": [
            "adatta-adj"
          ]
        },
        {
          "id": "7047620",
          "text": "Non riesco a trovare la parola adatta.",
          "translation": "Я не могу подобрать подходящее слово.",
          "source": "Tatoeba #7047620 @dnnywld / #7047555 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7047620",
          "cefr_level": "A1",
          "word_slugs": [
            "adatta-adj"
          ]
        },
        {
          "id": "6799374",
          "text": "Questa non è affatto una parola adatta.",
          "translation": "Это не совсем подходящее слово.",
          "source": "Tatoeba #6799374 @dnnywld / #6798951 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799374",
          "cefr_level": "A1",
          "word_slugs": [
            "adatta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
