    {
      "slug": "vietnam-name",
      "lemma": "Vietnam",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5854,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6725708",
          "text": "Abbiamo visitato il Vietnam.",
          "translation": "Мы посетим Вьетнам.",
          "source": "Tatoeba #6725708 @Guybrush88 / #8819175 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6725708",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        },
        {
          "id": "6988805",
          "text": "Non vogliamo andare in Vietnam.",
          "translation": "Мы не хотим ехать во Вьетнам.",
          "source": "Tatoeba #6988805 @Guybrush88 / #7037012 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6988805",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        },
        {
          "id": "5128967",
          "text": "Tom è un veterano del Vietnam.",
          "translation": "Том — ветеран Вьетнама.",
          "source": "Tatoeba #5128967 @Guybrush88 / #5085384 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5128967",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        },
        {
          "id": "7607368",
          "text": "Andate a fare amicizie in Vietnam?",
          "translation": "Собираетесь ли вы найти друзей во Вьетнаме?",
          "source": "Tatoeba #7607368 @Guybrush88 / #8949840 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7607368",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        },
        {
          "id": "7599064",
          "text": "Andiamo a insegnare qualcosa in Vietnam.",
          "translation": "Давайте научим чему-нибудь во Вьетнаме.",
          "source": "Tatoeba #7599064 @Guybrush88 / #8427393 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7599064",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "Vietnam",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "certificato-noun",
      "lemma": "certificato",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5856,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5578998",
          "text": "Ho perso il mio certificato di pensione.",
          "translation": "Я потерял пенсионное удостоверение.",
          "source": "Tatoeba #5578998 @dnnywld / #5574814 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5578998",
          "cefr_level": "A1",
          "word_slugs": [
            "certificato-noun"
          ]
        },
        {
          "id": "6939312",
          "text": "Tom fece una copia del suo certificato di nascita.",
          "translation": "Том сделал копию своего свидетельства о рождении.",
          "source": "Tatoeba #6939312 @dnnywld / #6938419 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6939312",
          "cefr_level": "A1",
          "word_slugs": [
            "certificato-noun"
          ]
        },
        {
          "id": "5479112",
          "text": "Tom e Mary hanno apposto la loro firma nel certificato di matrimonio.",
          "translation": "Том и Мэри поставили свои подписи в свидетельстве о регистрации брака.",
          "source": "Tatoeba #5479112 @dnnywld / #5478907 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479112",
          "cefr_level": "A1",
          "word_slugs": [
            "certificato-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
