      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3463056",
          "text": "Meglio due birre!",
          "translation": "А лучше - два пива!",
          "source": "Tatoeba #3463056 @Guybrush88 / #4387404 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3463056",
          "cefr_level": "A1",
          "word_slugs": [
            "birre-noun"
          ]
        },
        {
          "id": "5891783",
          "text": "Quante birre ti sei fatta?",
          "translation": "Сколько бутылок пива ты выпила?",
          "source": "Tatoeba #5891783 @dnnywld / #5891603 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5891783",
          "cefr_level": "A1",
