    {
      "slug": "recinto-noun",
      "lemma": "recinto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9031,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5596112",
          "text": "Tingeremo il recinto domani.",
          "translation": "Мы покрасим ограду завтра.",
          "source": "Tatoeba #5596112 @dnnywld / #5595930 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5596112",
          "cefr_level": "A1",
          "word_slugs": [
            "recinto-noun"
          ]
        },
        {
          "id": "5519295",
          "text": "Tom gettò la borsa oltre il recinto.",
          "translation": "Том перебросил сумку через забор.",
          "source": "Tatoeba #5519295 @dnnywld / #5518731 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5519295",
          "cefr_level": "A1",
          "word_slugs": [
            "recinto-noun"
          ]
        },
        {
          "id": "6009545",
          "text": "Tom voleva pitturare il recinto di bianco.",
          "translation": "Том хотел покрасить забор в белый цвет.",
          "source": "Tatoeba #6009545 @dnnywld / #6007674 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009545",
          "cefr_level": "A1",
          "word_slugs": [
            "recinto-noun"
          ]
        },
        {
          "id": "5409166",
          "text": "Con un colpo di mazza Tom spedì la palla oltre il recinto.",
          "translation": "Ударом биты Том отправил мяч через забор.",
          "source": "Tatoeba #5409166 @dnnywld / #2459502 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409166",
          "cefr_level": "A1",
          "word_slugs": [
            "recinto-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
