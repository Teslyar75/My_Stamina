    {
      "slug": "corta-adj",
      "lemma": "corta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9641,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2713876",
          "text": "È molto corta.",
          "translation": "Она очень короткая.",
          "source": "Tatoeba #2713876 @Guybrush88 / #3311649 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2713876",
          "cefr_level": "A1",
          "word_slugs": [
            "corta-adj"
          ]
        },
        {
          "id": "2395796",
          "text": "È troppo corta.",
          "translation": "Она слишком короткая.",
          "source": "Tatoeba #2395796 @Guybrush88 / #3708837 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2395796",
          "cefr_level": "A1",
          "word_slugs": [
            "corta-adj"
          ]
        },
        {
          "id": "3558732",
          "text": "Hanno la memoria corta?",
          "translation": "У них короткая память?",
          "source": "Tatoeba #3558732 @Guybrush88 / #5247680 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3558732",
          "cefr_level": "A1",
          "word_slugs": [
            "corta-adj"
          ]
        },
        {
          "id": "5523316",
          "text": "Questa prolunga è troppo corta.",
          "translation": "Этот удлинитель слишком короткий.",
          "source": "Tatoeba #5523316 @dnnywld / #3965412 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5523316",
          "cefr_level": "A1",
          "word_slugs": [
            "corta-adj"
          ]
        },
        {
          "id": "4468373",
          "text": "L'orso ha una coda corta.",
          "translation": "У медведя короткий хвост.",
          "source": "Tatoeba #4468373 @fekundulo / #4468704 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4468373",
          "cefr_level": "A1",
          "word_slugs": [
            "corta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
