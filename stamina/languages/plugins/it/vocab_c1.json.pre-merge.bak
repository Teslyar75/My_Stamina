      "examples": [
        {
          "id": "6790471",
          "text": "Tutto è avvenuto per caso.",
          "translation": "Всё вышло случайно.",
          "source": "Tatoeba #6790471 @dnnywld / #6150167 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790471",
          "cefr_level": "A1",
