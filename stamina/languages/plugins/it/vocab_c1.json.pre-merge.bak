    {
      "slug": "spreco-noun",
      "lemma": "spreco",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6084,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1578335",
          "text": "Non spreco munizioni.",
          "translation": "Я не разбазариваю патроны.",
          "source": "Tatoeba #1578335 @Guybrush88 / #1576635 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1578335",
          "cefr_level": "A1",
          "word_slugs": [
            "spreco-noun"
          ]
        },
        {
          "id": "1578336",
          "text": "Io non spreco munizioni.",
          "translation": "Я не разбазариваю патроны.",
          "source": "Tatoeba #1578336 @Guybrush88 / #1576635 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1578336",
          "cefr_level": "A1",
          "word_slugs": [
            "spreco-noun"
          ]
        },
        {
          "id": "5400521",
          "text": "Quanto più guadagno, tanto più spreco.",
          "translation": "Чем больше я зарабатываю, тем больше трачу.",
          "source": "Tatoeba #5400521 @dnnywld / #5399384 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5400521",
          "cefr_level": "A1",
          "word_slugs": [
            "spreco-noun"
          ]
        },
        {
          "id": "5464562",
          "text": "È uno spreco dei soldi dei contribuenti.",
          "translation": "Это растрата денег налогоплательщиков.",
          "source": "Tatoeba #5464562 @dnnywld / #5464129 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5464562",
          "cefr_level": "A1",
          "word_slugs": [
            "spreco-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il spreco",
        "plural": "",
        "infinitive": ""
      }
