    {
      "slug": "invitata-verb",
      "lemma": "invitata",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5237,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5677753",
          "text": "Tu eri invitata.",
          "translation": "Ты была приглашена.",
          "source": "Tatoeba #5677753 @dnnywld / #5677533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677753",
          "cefr_level": "A1",
          "word_slugs": [
            "invitata-verb"
          ]
        },
        {
          "id": "6018087",
          "text": "Non l'ho invitata.",
          "translation": "Я её не приглашал.",
          "source": "Tatoeba #6018087 @Guybrush88 / #7583827 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6018087",
          "cefr_level": "A1",
          "word_slugs": [
            "invitata-verb"
          ]
        },
        {
          "id": "5910849",
          "text": "Sono stata invitata a cena.",
          "translation": "Я была приглашена на ужин.",
          "source": "Tatoeba #5910849 @dnnywld / #5910282 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5910849",
          "cefr_level": "A1",
          "word_slugs": [
            "invitata-verb"
          ]
        },
        {
          "id": "5206844",
          "text": "Lui mi ha invitata a pranzo.",
          "translation": "Он пригласил меня на обед.",
          "source": "Tatoeba #5206844 @madriot / #5204566 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5206844",
          "cefr_level": "A1",
          "word_slugs": [
            "invitata-verb"
          ]
        },
        {
          "id": "4473789",
          "text": "Lei mi ha invitata a casa sua.",
          "translation": "Она пригласила меня к себе домой.",
          "source": "Tatoeba #4473789 @Guybrush88 / #4378285 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4473789",
          "cefr_level": "A1",
          "word_slugs": [
            "invitata-verb"
          ]
        }
      ],
