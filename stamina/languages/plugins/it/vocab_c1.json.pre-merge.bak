    {
      "slug": "y-character",
      "lemma": "y",
      "pos": "character",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7194,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5591834",
          "text": "Y è l'asse delle ordinate.",
          "translation": "Y — ось координат.",
          "source": "Tatoeba #5591834 @dnnywld / #5591508 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591834",
          "cefr_level": "A1",
          "word_slugs": [
            "y-character"
          ]
        },
        {
          "id": "5536515",
          "text": "Disegnate il grafico della funzione y = 2x + 3.",
          "translation": "Постройте график функции y = 2x + 3.",
          "source": "Tatoeba #5536515 @dnnywld / #5535657 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5536515",
          "cefr_level": "A1",
          "word_slugs": [
            "y-character"
          ]
        },
        {
          "id": "13619533",
          "text": "Nessun problema. Se succederà X, abbiamo ancora l'opzione Y.",
          "translation": "Нет проблем. Если случится X, у нас есть ещё Y.",
          "source": "Tatoeba #13619533 @dnnywld / #6391363 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13619533",
          "cefr_level": "A1",
          "word_slugs": [
            "y-character"
          ]
        },
        {
          "id": "5510058",
          "text": "L'asse delle X è orizzontale, e l'asse delle Y verticale.",
          "translation": "Ось X — горизонтальная, а ось Y — вертикальная.",
          "source": "Tatoeba #5510058 @dnnywld / #5509594 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510058",
          "cefr_level": "A1",
          "word_slugs": [
            "y-character"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "y",
        "plural": "",
        "infinitive": ""
      }
    },
