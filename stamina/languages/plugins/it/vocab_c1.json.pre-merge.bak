      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5964877",
          "text": "L'hanno operato.",
          "translation": "Его прооперировали.",
          "source": "Tatoeba #5964877 @dnnywld / #5964696 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964877",
          "cefr_level": "A1",
          "word_slugs": [
            "operato-adj"
          ]
        },
        {
          "id": "5964873",
          "text": "Mi hanno operato.",
          "translation": "Меня прооперировали.",
          "source": "Tatoeba #5964873 @dnnywld / #5964698 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964873",
