    {
      "slug": "ritratto-noun",
      "lemma": "ritratto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6162,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6900487",
          "text": "Di chi è questo ritratto?",
          "translation": "Чей это портрет?",
          "source": "Tatoeba #6900487 @dnnywld / #6899778 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6900487",
          "cefr_level": "A1",
          "word_slugs": [
            "ritratto-noun"
          ]
        },
        {
          "id": "5925893",
          "text": "Mi sono ritratto con orrore.",
          "translation": "Я в ужасе отпрянул.",
          "source": "Tatoeba #5925893 @dnnywld / #5925874 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5925893",
          "cefr_level": "A1",
          "word_slugs": [
            "ritratto-noun"
          ]
        },
        {
          "id": "6900485",
          "text": "Il ritratto è appeso al muro.",
          "translation": "Портрет висит на стене.",
          "source": "Tatoeba #6900485 @dnnywld / #6899782 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6900485",
          "cefr_level": "A1",
          "word_slugs": [
            "ritratto-noun"
          ]
        },
        {
          "id": "5614479",
          "text": "Lui è il ritratto di suo padre.",
          "translation": "Он весь в отца.",
          "source": "Tatoeba #5614479 @dnnywld / #2925588 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614479",
          "cefr_level": "A1",
          "word_slugs": [
            "ritratto-noun"
          ]
        },
        {
          "id": "5570981",
          "text": "Un pittore mi ha fatto il ritratto.",
          "translation": "Художник написал мой портрет.",
          "source": "Tatoeba #5570981 @dnnywld / #5570776 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5570981",
          "cefr_level": "A1",
          "word_slugs": [
            "ritratto-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
