    {
      "slug": "realizzare-verb",
      "lemma": "realizzare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5548,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2443843",
          "text": "Continuerò a realizzare il mio sogno.",
          "translation": "Я буду продолжать осуществлять свою мечту.",
          "source": "Tatoeba #2443843 @al_ex_an_der / #2443838 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2443843",
          "cefr_level": "A1",
          "word_slugs": [
            "realizzare-verb"
          ]
        },
        {
          "id": "6895201",
          "text": "Voglio realizzare il piano a tutti i costi.",
          "translation": "Я хочу выполнить план любой ценой.",
          "source": "Tatoeba #6895201 @dnnywld / #3228517 @anutakay (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6895201",
          "cefr_level": "A1",
          "word_slugs": [
            "realizzare-verb"
          ]
        },
        {
          "id": "10788005",
          "text": "Lui non sarà capace di realizzare il lavoro.",
          "translation": "Он будет не в состоянии выполнить работу.",
          "source": "Tatoeba #10788005 @dnnywld / #469487 @Kryaka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10788005",
          "cefr_level": "A1",
          "word_slugs": [
            "realizzare-verb"
          ]
        },
        {
          "id": "10788041",
          "text": "Lui non sarà in grado di realizzare il lavoro.",
          "translation": "Он будет не в состоянии выполнять работу.",
          "source": "Tatoeba #10788041 @dnnywld / #2639504 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10788041",
          "cefr_level": "A1",
          "word_slugs": [
            "realizzare-verb"
          ]
        },
        {
          "id": "2444703",
          "text": "Finché mia moglie mi sopporta, continuerò a realizzare il mio sogno.",
          "translation": "Пока моя жена меня поддерживает, я буду продолжать осуществлять свою мечту.",
          "source": "Tatoeba #2444703 @al_ex_an_der / #2444730 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2444703",
          "cefr_level": "A1",
          "word_slugs": [
            "realizzare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "realizzare",
        "plural": "",
        "infinitive": "realizzare"
      }
    },
