    {
      "slug": "igienica-adj",
      "lemma": "igienica",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9922,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3256496",
          "text": "Non c'è carta igienica.",
          "translation": "Нет туалетной бумаги.",
          "source": "Tatoeba #3256496 @Guybrush88 / #659951 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3256496",
          "cefr_level": "A1",
          "word_slugs": [
            "igienica-adj"
          ]
        },
        {
          "id": "3087133",
          "text": "La carta igienica è finita.",
          "translation": "Туалетная бумага закончилась.",
          "source": "Tatoeba #3087133 @Guybrush88 / #3087165 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3087133",
          "cefr_level": "A1",
          "word_slugs": [
            "igienica-adj"
          ]
        },
        {
          "id": "10766073",
          "text": "Abbiamo finito la carta igienica.",
          "translation": "У нас закончилась туалетная бумага.",
          "source": "Tatoeba #10766073 @dnnywld / #7009393 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10766073",
          "cefr_level": "A1",
          "word_slugs": [
            "igienica-adj"
          ]
        },
        {
          "id": "996466",
          "text": "Passami un rotolo di carta igienica.",
          "translation": "Передай мне рулон туалетной бумаги.",
          "source": "Tatoeba #996466 @Guybrush88 / #3245181 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/996466",
          "cefr_level": "A1",
          "word_slugs": [
            "igienica-adj"
          ]
        },
        {
          "id": "2470391",
          "text": "Questa carta igienica sembra carta vetrata.",
          "translation": "Эта туалетная бумага похожа на наждачную.",
          "source": "Tatoeba #2470391 @Guybrush88 / #3245158 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2470391",
          "cefr_level": "A1",
          "word_slugs": [
            "igienica-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
