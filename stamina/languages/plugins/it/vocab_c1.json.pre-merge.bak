    {
      "slug": "zaino-adj",
      "lemma": "zaino",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5394,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5497492",
          "text": "Tom aprì il suo zaino.",
          "translation": "Том открыл свой рюкзак.",
          "source": "Tatoeba #5497492 @dnnywld / #5497182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497492",
          "cefr_level": "A1",
          "word_slugs": [
            "zaino-adj"
          ]
        },
        {
          "id": "5999080",
          "text": "Hai abbracciato il tuo zaino.",
          "translation": "Ты обнял свой рюкзак.",
          "source": "Tatoeba #5999080 @dnnywld / #2765712 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5999080",
          "cefr_level": "A1",
          "word_slugs": [
            "zaino-adj"
          ]
        },
        {
          "id": "5478418",
          "text": "Tom portava uno zaino pesante.",
          "translation": "Том нёс тяжёлый рюкзак.",
          "source": "Tatoeba #5478418 @dnnywld / #5478098 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5478418",
          "cefr_level": "A1",
          "word_slugs": [
            "zaino-adj"
          ]
        },
        {
          "id": "5398116",
          "text": "Tom ha ficcato i libri nello zaino.",
          "translation": "Том затолкал книги в рюкзак.",
          "source": "Tatoeba #5398116 @dnnywld / #5397980 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5398116",
          "cefr_level": "A1",
          "word_slugs": [
            "zaino-adj"
          ]
        },
        {
          "id": "5398069",
          "text": "E ti ho detto di comprare uno zaino più grande.",
          "translation": "А я тебе говорил покупать рюкзак побольше.",
          "source": "Tatoeba #5398069 @dnnywld / #5397984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5398069",
          "cefr_level": "A1",
          "word_slugs": [
            "zaino-adj"
          ]
        }
