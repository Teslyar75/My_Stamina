    {
      "slug": "occupazione-noun",
      "lemma": "occupazione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9766,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7140040",
          "text": "Non sapevo vi piacesse questa occupazione.",
          "translation": "Я не знал, что вам нравится это занятие.",
          "source": "Tatoeba #7140040 @dnnywld / #7139954 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7140040",
          "cefr_level": "A1",
          "word_slugs": [
            "occupazione-noun"
          ]
        },
        {
          "id": "7140041",
          "text": "Non sapevo ti piacesse questa occupazione.",
          "translation": "Я не знал, что тебе нравится это занятие.",
          "source": "Tatoeba #7140041 @dnnywld / #7139953 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7140041",
          "cefr_level": "A1",
          "word_slugs": [
            "occupazione-noun"
          ]
        },
        {
          "id": "5523629",
          "text": "La Germania era divisa in zone di occupazione.",
          "translation": "Германия была разделена на оккупационные зоны.",
          "source": "Tatoeba #5523629 @dnnywld / #5523509 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5523629",
          "cefr_level": "A1",
          "word_slugs": [
            "occupazione-noun"
          ]
        },
        {
          "id": "5691561",
          "text": "Suonare il pianoforte è la sua occupazione preferita.",
          "translation": "Играть на пианино - его любимое занятие.",
          "source": "Tatoeba #5691561 @dnnywld / #5691510 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5691561",
          "cefr_level": "A1",
          "word_slugs": [
            "occupazione-noun"
          ]
        },
        {
          "id": "5635280",
          "text": "Dopotutto, questa è la sua occupazione. Deve decidere da solo.",
          "translation": "В конце концов, это его дело. Он сам должен выбрать.",
          "source": "Tatoeba #5635280 @dnnywld / #5634929 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635280",
          "cefr_level": "A1",
          "word_slugs": [
            "occupazione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la occupazione",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "domestico-adj",
      "lemma": "domestico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
