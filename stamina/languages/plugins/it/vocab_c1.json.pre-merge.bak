    {
      "slug": "vendo-verb",
      "lemma": "vendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6908,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3857875",
          "text": "Non li vendo.",
          "translation": "Я их не продаю.",
          "source": "Tatoeba #3857875 @Guybrush88 / #2759466 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3857875",
          "cefr_level": "A1",
          "word_slugs": [
            "vendo-verb"
          ]
        },
        {
          "id": "2448402",
          "text": "Io vendo scarpe.",
          "translation": "Я продаю туфли.",
          "source": "Tatoeba #2448402 @Guybrush88 / #3603637 @Khvalovsky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2448402",
          "cefr_level": "A1",
          "word_slugs": [
            "vendo-verb"
          ]
        },
        {
          "id": "5658779",
          "text": "Vendo da Trondheim.",
          "translation": "Я из Тронхейма.",
          "source": "Tatoeba #5658779 @dnnywld / #5658740 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5658779",
          "cefr_level": "A1",
          "word_slugs": [
            "vendo-verb"
          ]
        },
        {
          "id": "5433551",
          "text": "Vendo la mia casa.",
          "translation": "Я продаю свой дом.",
          "source": "Tatoeba #5433551 @dnnywld / #5432889 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433551",
          "cefr_level": "A1",
          "word_slugs": [
            "vendo-verb"
          ]
        },
        {
          "id": "730030",
          "text": "Vendo un nuovo ombrello.",
          "translation": "Я продаю новый зонт.",
          "source": "Tatoeba #730030 @Guybrush88 / #1602061 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/730030",
          "cefr_level": "A1",
          "word_slugs": [
            "vendo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
