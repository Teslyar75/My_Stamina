    {
      "slug": "ritiene-verb",
      "lemma": "ritiene",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6728,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6372205",
          "text": "Tom ritiene che sia giusto.",
          "translation": "Том считает, что это правда.",
          "source": "Tatoeba #6372205 @dnnywld / #6371949 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6372205",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiene-verb"
          ]
        },
        {
          "id": "13788443",
          "text": "Tom ci ritiene molto stupidi.",
          "translation": "Том считает нас очень глупыми.",
          "source": "Tatoeba #13788443 @dnnywld / #13788394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13788443",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiene-verb"
          ]
        },
        {
          "id": "6163485",
          "text": "Mia mamma mi ritiene intelligente.",
          "translation": "Моя мама считает меня умной.",
          "source": "Tatoeba #6163485 @dnnywld / #6163361 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6163485",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiene-verb"
          ]
        },
        {
          "id": "5642354",
          "text": "Tom ritiene che Mary sia stata uccisa.",
          "translation": "Том считает, что Мэри была убита.",
          "source": "Tatoeba #5642354 @dnnywld / #5642020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642354",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiene-verb"
          ]
        },
        {
          "id": "6876908",
          "text": "Tom ritiene che io debba aiutare Mary.",
          "translation": "Том считает, что мне нужно помочь Мэри.",
          "source": "Tatoeba #6876908 @dnnywld / #6875619 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6876908",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiene-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ritiene",
        "plural": "",
        "infinitive": "ritiene"
