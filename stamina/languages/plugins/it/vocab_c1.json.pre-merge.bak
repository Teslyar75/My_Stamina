    {
      "slug": "agito-verb",
      "lemma": "agito",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5756,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6361909",
          "text": "Avete agito sconsideratamente.",
          "translation": "Вы поступили опрометчиво.",
          "source": "Tatoeba #6361909 @dnnywld / #6361191 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361909",
          "cefr_level": "A1",
          "word_slugs": [
            "agito-verb"
          ]
        },
        {
          "id": "6949117",
          "text": "Ho agito da solo.",
          "translation": "Я действовал в одиночку.",
          "source": "Tatoeba #6949117 @dnnywld / #6388536 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6949117",
          "cefr_level": "A1",
          "word_slugs": [
            "agito-verb"
          ]
        },
        {
          "id": "5529726",
          "text": "Lui ha agito da uomo.",
          "translation": "Он поступил по-мужски.",
          "source": "Tatoeba #5529726 @dnnywld / #5529229 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5529726",
          "cefr_level": "A1",
          "word_slugs": [
            "agito-verb"
          ]
        },
        {
          "id": "5563902",
          "text": "Tom non ha agito da solo.",
          "translation": "Том действовал не один.",
          "source": "Tatoeba #5563902 @dnnywld / #5563771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5563902",
          "cefr_level": "A1",
          "word_slugs": [
            "agito-verb"
          ]
        },
        {
          "id": "5727196",
          "text": "Un vero amico avrebbe agito diversamente.",
          "translation": "Настоящий друг поступил бы по-другому.",
          "source": "Tatoeba #5727196 @dnnywld / #5727108 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5727196",
          "cefr_level": "A1",
          "word_slugs": [
            "agito-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "agito",
        "plural": "",
