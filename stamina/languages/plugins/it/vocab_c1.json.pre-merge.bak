      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5505832",
          "text": "Siamo così grati.",
          "translation": "Мы так благодарны.",
          "source": "Tatoeba #5505832 @dnnywld / #5505461 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5505832",
          "cefr_level": "A1",
          "word_slugs": [
            "grati-verb"
          ]
        },
        {
          "id": "5586976",
          "text": "Vi siamo grati per il sostegno.",
