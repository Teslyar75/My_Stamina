          ]
        },
        {
          "id": "10878724",
          "text": "Il rastrello è nel fienile.",
          "translation": "Грабли в сарае.",
          "source": "Tatoeba #10878724 @dnnywld / #2958837 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878724",
          "cefr_level": "A1",
          "word_slugs": [
            "fienile-noun"
          ]
        },
        {
          "id": "6873649",
          "text": "Tom dormiva su un mucchio di paglia in un fienile.",
          "translation": "Том спал на ворохе соломы в сарае.",
          "source": "Tatoeba #6873649 @dnnywld / #6872615 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6873649",
          "cefr_level": "A1",
          "word_slugs": [
