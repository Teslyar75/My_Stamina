    {
      "slug": "esista-verb",
      "lemma": "esista",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6785,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5624183",
          "text": "Credo che l'amore esista.",
          "translation": "Я верю, что любовь существует.",
          "source": "Tatoeba #5624183 @dnnywld / #5624084 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624183",
          "cefr_level": "A1",
          "word_slugs": [
            "esista-verb"
          ]
        },
        {
          "id": "1927660",
          "text": "Credo che l'amore non esista.",
          "translation": "Я считаю, что любви нет.",
          "source": "Tatoeba #1927660 @Shadd / #1927487 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1927660",
          "cefr_level": "A1",
          "word_slugs": [
            "esista-verb"
          ]
        },
        {
          "id": "3131936",
          "text": "Penso che l'amore non esista.",
          "translation": "Я думаю, что любви не существует.",
          "source": "Tatoeba #3131936 @Guybrush88 / #6774290 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3131936",
          "cefr_level": "A1",
          "word_slugs": [
            "esista-verb"
          ]
        },
        {
          "id": "5598898",
          "text": "Non sono sicura che Dio esista.",
          "translation": "Я не уверена, что Бог существует.",
          "source": "Tatoeba #5598898 @dnnywld / #5598693 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5598898",
          "cefr_level": "A1",
          "word_slugs": [
            "esista-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
