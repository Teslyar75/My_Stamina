          "cefr_level": "A1",
          "word_slugs": [
            "arrivino-verb"
          ]
        },
        {
          "id": "6375430",
          "text": "Mi chiedo da dove ti arrivino quei soldi.",
          "translation": "Интересно, откуда у тебя деньги.",
          "source": "Tatoeba #6375430 @dnnywld / #6375180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6375430",
