    {
      "slug": "giurare-verb",
      "lemma": "giurare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8889,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6871978",
          "text": "Potrei giurare di aver visto qualcuno.",
          "translation": "Я мог бы поклясться, что кого-то видел.",
          "source": "Tatoeba #6871978 @dnnywld / #3682689 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871978",
          "cefr_level": "A1",
          "word_slugs": [
            "giurare-verb"
          ]
        },
        {
          "id": "6871965",
          "text": "Potrei giurare di aver visto lì Tom.",
          "translation": "Я мог бы поклясться, что видел там Тома.",
          "source": "Tatoeba #6871965 @dnnywld / #6871918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871965",
          "cefr_level": "A1",
          "word_slugs": [
            "giurare-verb"
          ]
        },
        {
          "id": "6871980",
          "text": "Potrei giurare di essere già stato qui.",
          "translation": "Я мог бы поклясться, что уже бывал здесь раньше.",
          "source": "Tatoeba #6871980 @dnnywld / #5294176 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871980",
          "cefr_level": "A1",
          "word_slugs": [
            "giurare-verb"
          ]
        },
        {
          "id": "7715670",
          "text": "Mi costrinse a giurare che non l'avrei detto a nessuno.",
          "translation": "Она заставила меня поклясться, что я ничего не скажу.",
          "source": "Tatoeba #7715670 @Valdast / #3538357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7715670",
          "cefr_level": "A1",
          "word_slugs": [
            "giurare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "giurare",
        "plural": "",
        "infinitive": "giurare"
      }
