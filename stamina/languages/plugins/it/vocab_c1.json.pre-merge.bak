          "cefr_level": "A1",
          "word_slugs": [
            "spedito-adj"
          ]
        },
        {
          "id": "10864740",
          "text": "Il colpevole fu spedito alla forca.",
          "translation": "Преступника отправили на виселицу.",
          "source": "Tatoeba #10864740 @dnnywld / #5072132 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10864740",
          "cefr_level": "A1",
          "word_slugs": [
            "spedito-adj"
          ]
        },
        {
          "id": "6569555",
          "text": "Quante cartoline di Natale hai spedito?",
          "translation": "Сколько рождественских открыток ты отправил?",
