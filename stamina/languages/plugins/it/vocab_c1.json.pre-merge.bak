    {
      "slug": "disturbato-verb",
      "lemma": "disturbato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8427,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6884993",
          "text": "Nessuno vi ha disturbato?",
          "translation": "Вас никто не беспокоил?",
          "source": "Tatoeba #6884993 @dnnywld / #6884037 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884993",
          "cefr_level": "A1",
          "word_slugs": [
            "disturbato-verb"
          ]
        },
        {
          "id": "10844131",
          "text": "Non voglio essere disturbato!",
          "translation": "Пусть меня не беспокоят!",
          "source": "Tatoeba #10844131 @dnnywld / #10841574 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844131",
          "cefr_level": "A1",
          "word_slugs": [
            "disturbato-verb"
          ]
        },
        {
          "id": "2872639",
          "text": "Mi dispiace di averti disturbato.",
          "translation": "Прости, что побеспокоила тебя.",
          "source": "Tatoeba #2872639 @Guybrush88 / #10754787 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2872639",
          "cefr_level": "A1",
          "word_slugs": [
            "disturbato-verb"
          ]
        },
        {
          "id": "10755294",
          "text": "Sono desolata di aver disturbato.",
          "translation": "Прошу прощения, что побеспокоила.",
          "source": "Tatoeba #10755294 @dnnywld / #10754790 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10755294",
          "cefr_level": "A1",
          "word_slugs": [
            "disturbato-verb"
          ]
        },
        {
