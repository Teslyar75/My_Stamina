      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6843189",
          "text": "Scrivi sul foglio.",
          "translation": "Пиши на бумаге.",
          "source": "Tatoeba #6843189 @dnnywld / #6537073 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843189",
          "cefr_level": "A1",
          "word_slugs": [
            "foglio-noun"
          ]
        },
        {
          "id": "5587206",
          "text": "Tom piegò il foglio.",
          "translation": "Том сложил бумагу.",
          "source": "Tatoeba #5587206 @dnnywld / #5587032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5587206",
          "cefr_level": "A1",
          "word_slugs": [
            "foglio-noun"
          ]
        },
        {
          "id": "5968759",
          "text": "Ho stracciato il foglio.",
          "translation": "Я разорвал бумагу.",
          "source": "Tatoeba #5968759 @dnnywld / #5967865 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5968759",
          "cefr_level": "A1",
          "word_slugs": [
            "foglio-noun"
          ]
        },
        {
          "id": "1016563",
          "text": "Dammi un foglio di carta.",
          "translation": "Дай мне лист бумаги.",
          "source": "Tatoeba #1016563 @Guybrush88 / #2224830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1016563",
          "cefr_level": "A1",
          "word_slugs": [
            "foglio-noun"
          ]
        },
        {
          "id": "613815",
          "text": "Prendi un foglio e scrivi!",
          "translation": "Возьми бумагу и пиши!",
          "source": "Tatoeba #613815 @Guybrush88 / #1276215 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/613815",
          "cefr_level": "A1",
          "word_slugs": [
            "foglio-noun"
          ]
        }
