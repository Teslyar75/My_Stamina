          ]
        },
        {
          "id": "5681046",
          "text": "È così improbabile...",
          "translation": "Это настолько маловероятно...",
          "source": "Tatoeba #5681046 @dnnywld / #5679410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5681046",
          "cefr_level": "A1",
          "word_slugs": [
            "improbabile-adj"
          ]
        },
        {
          "id": "6819633",
          "text": "Penso che sia improbabile.",
