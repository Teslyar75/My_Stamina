    {
      "slug": "sbagliare-verb",
      "lemma": "sbagliare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7331,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7060280",
          "text": "Non voglio sbagliare.",
          "translation": "Я не хочу ошибиться.",
          "source": "Tatoeba #7060280 @dnnywld / #7059271 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7060280",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliare-verb"
          ]
        },
        {
          "id": "5663228",
          "text": "Perfino gli autisti esperti possono sbagliare.",
          "translation": "Даже опытные водители могут ошибаться.",
          "source": "Tatoeba #5663228 @dnnywld / #5661361 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5663228",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliare-verb"
          ]
        },
        {
          "id": "11084778",
          "text": "La maggioranza può sbagliare anche più spesso di un individuo.",
          "translation": "Большинство может ошибаться даже чаще одного индивида.",
          "source": "Tatoeba #11084778 @carlosalberto / #11084724 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11084778",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliare-verb"
          ]
        },
        {
          "id": "5411595",
          "text": "A lezione James era terrorizzato di sbagliare e di ricevere una nota.",
          "translation": "На уроке Джеймс ужасно боялся ошибиться и получить замечание.",
          "source": "Tatoeba #5411595 @dnnywld / #611050 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5411595",
          "cefr_level": "A1",
          "word_slugs": [
            "sbagliare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sbagliare",
        "plural": "",
        "infinitive": "sbagliare"
      }
