            "colto-verb"
          ]
        },
        {
          "id": "5636868",
          "text": "Vi ho colto di sorpresa?",
          "translation": "Я застал вас врасплох?",
          "source": "Tatoeba #5636868 @dnnywld / #4652038 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5636868",
          "cefr_level": "A1",
          "word_slugs": [
