    {
      "slug": "alzarsi-verb",
      "lemma": "alzarsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7418,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3437654",
          "text": "Tom non riesce ad alzarsi.",
          "translation": "Том не может подняться.",
          "source": "Tatoeba #3437654 @Guybrush88 / #5668144 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3437654",
          "cefr_level": "A1",
          "word_slugs": [
            "alzarsi-verb"
          ]
        },
        {
          "id": "3101744",
          "text": "È troppo presto per alzarsi.",
          "translation": "Слишком рано, чтобы вставать.",
          "source": "Tatoeba #3101744 @Guybrush88 / #990023 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3101744",
          "cefr_level": "A1",
          "word_slugs": [
            "alzarsi-verb"
          ]
        },
        {
          "id": "7434299",
          "text": "Lei faceva fatica ad alzarsi.",
          "translation": "Ей было трудно встать.",
          "source": "Tatoeba #7434299 @dnnywld / #7433901 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7434299",
          "cefr_level": "A1",
          "word_slugs": [
            "alzarsi-verb"
          ]
        },
        {
          "id": "5668263",
          "text": "Tom costrinse Mary ad alzarsi.",
          "translation": "Том заставил Мэри подняться.",
          "source": "Tatoeba #5668263 @dnnywld / #5668141 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5668263",
          "cefr_level": "A1",
          "word_slugs": [
            "alzarsi-verb"
          ]
        },
        {
          "id": "1863862",
          "text": "Lei è abituata ad alzarsi presto.",
          "translation": "Она привыкла вставать рано.",
