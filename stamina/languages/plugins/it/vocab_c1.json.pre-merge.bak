    {
      "slug": "compenso-noun",
      "lemma": "compenso",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9289,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3690535",
          "text": "Desiderava un massaggio come compenso per i suoi massaggi.",
          "translation": "Бетти обожает танцевать.",
          "source": "Tatoeba #3690535 @Guybrush88 / #1668184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3690535",
          "cefr_level": "A1",
          "word_slugs": [
            "compenso-noun"
          ]
        },
        {
          "id": "10790809",
          "text": "Non mi hanno ancora pagato il compenso per il libro.",
          "translation": "Мне до сих пор не выплатили гонорар за книгу.",
          "source": "Tatoeba #10790809 @dnnywld / #10790695 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790809",
          "cefr_level": "A1",
          "word_slugs": [
            "compenso-noun"
          ]
        },
        {
          "id": "6852979",
          "text": "Poco male se non corro veloce. In compenso sono resistente.",
          "translation": "Не беда, что я не быстро бегаю. Зато я выносливый.",
          "source": "Tatoeba #6852979 @dnnywld / #6852502 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6852979",
          "cefr_level": "A1",
          "word_slugs": [
            "compenso-noun"
          ]
        },
        {
          "id": "10790811",
          "text": "Il compenso per l'articolo ha superato tutte le mie aspettative.",
          "translation": "Гонорар за статью превысил все мои ожидания.",
          "source": "Tatoeba #10790811 @dnnywld / #10790694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790811",
          "cefr_level": "A1",
          "word_slugs": [
            "compenso-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il compenso",
        "plural": "",
        "infinitive": ""
      }
    },
