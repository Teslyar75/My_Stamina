    {
      "slug": "portiere-noun",
      "lemma": "portiere",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7011,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5424916",
          "text": "Tom è un portiere di calcio.",
          "translation": "Том - вратарь.",
          "source": "Tatoeba #5424916 @dnnywld / #5424788 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5424916",
          "cefr_level": "A1",
          "word_slugs": [
