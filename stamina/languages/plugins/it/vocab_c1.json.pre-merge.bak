          ]
        },
        {
          "id": "5449763",
          "text": "Tom ha sentito bussare alla porta.",
          "translation": "Том услышал стук в дверь.",
          "source": "Tatoeba #5449763 @dnnywld / #5449449 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5449763",
          "cefr_level": "A1",
          "word_slugs": [
            "bussare-verb"
          ]
        },
        {
          "id": "7846210",
          "text": "Tom entrò in camera senza bussare.",
          "translation": "Том вошёл в комнату без стука.",
          "source": "Tatoeba #7846210 @dnnywld / #7846151 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7846210",
          "cefr_level": "A1",
          "word_slugs": [
            "bussare-verb"
          ]
        },
        {
          "id": "5530443",
          "text": "Si prega di bussare prima di entrare in bagno.",
          "translation": "Просьба стучать, перед тем как войти в туалет.",
          "source": "Tatoeba #5530443 @dnnywld / #1109163 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5530443",
          "cefr_level": "A1",
          "word_slugs": [
            "bussare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
