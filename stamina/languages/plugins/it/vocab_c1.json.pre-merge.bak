    {
      "slug": "manderò-verb",
      "lemma": "manderò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8090,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5596302",
          "text": "Lo manderò per te.",
          "translation": "Я пошлю за тобой.",
          "source": "Tatoeba #5596302 @dnnywld / #5596070 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5596302",
          "cefr_level": "A1",
          "word_slugs": [
            "manderò-verb"
          ]
        },
        {
          "id": "5596298",
          "text": "Lo manderò per voi.",
          "translation": "Я пошлю за вами.",
          "source": "Tatoeba #5596298 @dnnywld / #5596071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5596298",
          "cefr_level": "A1",
          "word_slugs": [
            "manderò-verb"
          ]
        },
        {
          "id": "3998238",
          "text": "Ti manderò il conto.",
          "translation": "Я пришлю тебе счёт.",
          "source": "Tatoeba #3998238 @Guybrush88 / #2633202 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3998238",
          "cefr_level": "A1",
          "word_slugs": [
            "manderò-verb"
          ]
        },
        {
          "id": "3998239",
          "text": "Vi manderò il conto.",
          "translation": "Я пришлю вам счёт.",
          "source": "Tatoeba #3998239 @Guybrush88 / #2633203 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3998239",
          "cefr_level": "A1",
          "word_slugs": [
            "manderò-verb"
          ]
        },
        {
          "id": "5394058",
          "text": "Manderò subito qualcuno da te.",
