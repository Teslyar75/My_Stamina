    {
      "slug": "pubblicato-adj",
      "lemma": "pubblicato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6528,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10849580",
          "text": "Lui ha pubblicato la sua autobiografia.",
          "translation": "Он опубликовал свою автобиографию.",
          "source": "Tatoeba #10849580 @dnnywld / #2370687 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849580",
          "cefr_level": "A1",
          "word_slugs": [
            "pubblicato-adj"
          ]
        },
        {
          "id": "13619540",
          "text": "Sui giornali non hanno pubblicato niente.",
          "translation": "В газетах ничего не опубликовали.",
          "source": "Tatoeba #13619540 @dnnywld / #6391359 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13619540",
          "cefr_level": "A1",
          "word_slugs": [
            "pubblicato-adj"
          ]
        },
        {
          "id": "6587257",
          "text": "Questo libro sarà pubblicato l'anno prossimo.",
          "translation": "Эта книга будет опубликована в следующем году.",
          "source": "Tatoeba #6587257 @dnnywld / #6583725 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6587257",
          "cefr_level": "A1",
          "word_slugs": [
            "pubblicato-adj"
          ]
        },
        {
          "id": "2349325",
          "text": "Abbiamo parlato di un articolo che avevo pubblicato.",
          "translation": "Мы обсуждали статью, которую я опубликовал.",
          "source": "Tatoeba #2349325 @al_ex_an_der / #2349319 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2349325",
          "cefr_level": "A1",
          "word_slugs": [
            "pubblicato-adj"
          ]
        },
        {
          "id": "6961748",
          "text": "In questo stato l'articolo non può essere pubblicato.",
          "translation": "В таком виде статью публиковать нельзя.",
          "source": "Tatoeba #6961748 @dnnywld / #6961712 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961748",
          "cefr_level": "A1",
          "word_slugs": [
            "pubblicato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il pubblicato",
        "plural": "",
        "infinitive": ""
      }
    },
