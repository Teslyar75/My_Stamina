          ]
        },
        {
          "id": "3570960",
          "text": "Tom è stato punto da un'ape.",
          "translation": "Тома укусила пчела.",
          "source": "Tatoeba #3570960 @Guybrush88 / #3542646 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3570960",
          "cefr_level": "A1",
