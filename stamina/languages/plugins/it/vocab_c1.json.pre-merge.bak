      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4195648",
          "text": "Quanto costano le arance?",
          "translation": "Почём апельсины?",
          "source": "Tatoeba #4195648 @Guybrush88 / #2784333 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4195648",
          "cefr_level": "A1",
          "word_slugs": [
            "costano-verb"
          ]
        },
        {
          "id": "10854319",
          "text": "Le munizioni costano care.",
          "translation": "Боеприпасы дорого стоят.",
          "source": "Tatoeba #10854319 @dnnywld / #4122845 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854319",
          "cefr_level": "A1",
          "word_slugs": [
            "costano-verb"
          ]
        },
        {
          "id": "5019392",
          "text": "A proposito, quanto costano?",
          "translation": "Кстати, сколько они стоят?",
