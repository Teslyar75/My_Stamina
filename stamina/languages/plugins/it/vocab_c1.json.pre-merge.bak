    {
      "slug": "espulso-adj",
      "lemma": "espulso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9284,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "373769",
          "text": "Suo figlio è stato espulso da scuola.",
          "translation": "Его сына выгнали из школы.",
          "source": "Tatoeba #373769 @Pharamp / #469105 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/373769",
          "cefr_level": "A1",
          "word_slugs": [
            "espulso-adj"
          ]
        },
        {
          "id": "5643673",
          "text": "Ho sentito che Tom è stato espulso dalla scuola.",
          "translation": "Я слышал, Тома исключили из школы.",
          "source": "Tatoeba #5643673 @dnnywld / #5642695 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643673",
          "cefr_level": "A1",
          "word_slugs": [
            "espulso-adj"
          ]
        },
        {
          "id": "5672478",
          "text": "Era così rumoroso che l'hanno espulso dalla biblioteca.",
          "translation": "Он так шумел, что его выгнали из библиотеки.",
          "source": "Tatoeba #5672478 @dnnywld / #5672461 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672478",
          "cefr_level": "A1",
          "word_slugs": [
            "espulso-adj"
          ]
        }
      ],
