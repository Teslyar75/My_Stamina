    {
      "slug": "scelgo-verb",
      "lemma": "scelgo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7150,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5884999",
          "text": "Io non scelgo.",
          "translation": "Я не выбираю.",
          "source": "Tatoeba #5884999 @dnnywld / #3308161 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5884999",
          "cefr_level": "A1",
          "word_slugs": [
            "scelgo-verb"
          ]
        },
        {
          "id": "5885072",
          "text": "Tom, ti scelgo!",
          "translation": "Том, я выбираю тебя!",
          "source": "Tatoeba #5885072 @dnnywld / #4812782 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885072",
          "cefr_level": "A1",
          "word_slugs": [
            "scelgo-verb"
          ]
        },
        {
          "id": "5885084",
          "text": "Non scelgo lei.",
          "translation": "Я её не выбираю.",
          "source": "Tatoeba #5885084 @dnnywld / #5167220 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885084",
          "cefr_level": "A1",
          "word_slugs": [
            "scelgo-verb"
          ]
        },
        {
          "id": "5885081",
          "text": "Non scelgo loro.",
          "translation": "Я их не выбираю.",
          "source": "Tatoeba #5885081 @dnnywld / #5165511 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885081",
          "cefr_level": "A1",
          "word_slugs": [
            "scelgo-verb"
          ]
        },
        {
          "id": "5885197",
          "text": "Scelgo tra due opzioni.",
          "translation": "Я выбираю между двумя вариантами.",
          "source": "Tatoeba #5885197 @dnnywld / #4161210 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885197",
          "cefr_level": "A1",
          "word_slugs": [
            "scelgo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
