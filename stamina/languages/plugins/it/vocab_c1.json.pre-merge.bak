          ]
        },
        {
          "id": "5584170",
          "text": "È dura essere intelligenti.",
          "translation": "Трудно быть умным.",
          "source": "Tatoeba #5584170 @dnnywld / #2330746 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5584170",
          "cefr_level": "A1",
          "word_slugs": [
            "intelligenti-adj"
          ]
        },
        {
          "id": "5504162",
          "text": "Siete più intelligenti di lei.",
          "translation": "Вы умнее, чем она.",
          "source": "Tatoeba #5504162 @dnnywld / #5503973 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504162",
