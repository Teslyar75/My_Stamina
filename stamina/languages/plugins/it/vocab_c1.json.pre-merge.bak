    {
      "slug": "odiare-verb",
      "lemma": "odiare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7521,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6833423",
          "text": "Tom mi disse di odiare quell'uomo.",
          "translation": "Том сказал мне, что ненавидит этого человека.",
          "source": "Tatoeba #6833423 @dnnywld / #6832955 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833423",
          "cefr_level": "A1",
          "word_slugs": [
            "odiare-verb"
          ]
        },
        {
          "id": "5465365",
          "text": "Tom non ha mai detto di odiare Mary.",
          "translation": "Том никогда не говорил, что ненавидит Мэри.",
          "source": "Tatoeba #5465365 @dnnywld / #5465057 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5465365",
          "cefr_level": "A1",
          "word_slugs": [
            "odiare-verb"
          ]
        },
        {
          "id": "5892691",
          "text": "Perché odiare è così facile, e amare così difficile?",
          "translation": "Почему ненавидеть так легко, а любить так трудно?",
          "source": "Tatoeba #5892691 @dnnywld / #5891239 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5892691",
          "cefr_level": "A1",
          "word_slugs": [
            "odiare-verb"
          ]
        },
        {
          "id": "2838582",
          "text": "Tom si è trovato a cominciare a odiare sua moglie.",
          "translation": "Том почувствовал, что начинает ненавидеть свою жену.",
          "source": "Tatoeba #2838582 @Guybrush88 / #4534292 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2838582",
          "cefr_level": "A1",
          "word_slugs": [
            "odiare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "odiare",
        "plural": "",
        "infinitive": "odiare"
      }
    },
    {
      "slug": "determinato-adj",
      "lemma": "determinato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7522,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5651442",
          "text": "Come l'hai determinato?",
          "translation": "Как ты это определил?",
          "source": "Tatoeba #5651442 @dnnywld / #5651265 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5651442",
          "cefr_level": "A1",
          "word_slugs": [
            "determinato-adj"
          ]
        },
        {
          "id": "1111438",
          "text": "Sono determinato a smettere di fumare.",
          "translation": "Я решительно настроен бросить курить.",
          "source": "Tatoeba #1111438 @riccioberto / #10940978 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1111438",
          "cefr_level": "A1",
          "word_slugs": [
            "determinato-adj"
          ]
        },
        {
          "id": "6680345",
          "text": "Lui era determinato a conquistare il suo cuore.",
          "translation": "Он был полон решимости завоевать её сердце.",
          "source": "Tatoeba #6680345 @dnnywld / #6680182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6680345",
          "cefr_level": "A1",
          "word_slugs": [
            "determinato-adj"
          ]
        },
        {
          "id": "6680415",
          "text": "Lui era determinato a conquistare il suo amore.",
          "translation": "Он был полон решимости завоевать её любовь.",
          "source": "Tatoeba #6680415 @dnnywld / #6680168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6680415",
          "cefr_level": "A1",
          "word_slugs": [
            "determinato-adj"
          ]
        },
        {
          "id": "6680351",
          "text": "Tom era determinato a conquistare il cuore di Mary.",
          "translation": "Том был полон решимости завоевать сердце Мэри.",
          "source": "Tatoeba #6680351 @dnnywld / #6680181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6680351",
          "cefr_level": "A1",
          "word_slugs": [
            "determinato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
