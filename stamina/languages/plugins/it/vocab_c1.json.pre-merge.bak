    {
      "slug": "pittore-noun",
      "lemma": "pittore",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9253,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5521936",
          "text": "Lui è un pittore nato.",
          "translation": "Он прирождённый художник.",
          "source": "Tatoeba #5521936 @dnnywld / #5520905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5521936",
          "cefr_level": "A1",
          "word_slugs": [
            "pittore-noun"
          ]
        },
        {
          "id": "5627766",
          "text": "Questo pittore è morto giovane.",
          "translation": "Этот художник умер молодым.",
          "source": "Tatoeba #5627766 @dnnywld / #622055 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627766",
          "cefr_level": "A1",
          "word_slugs": [
            "pittore-noun"
          ]
        },
        {
          "id": "5820161",
          "text": "Tom è un pittore molto famoso.",
          "translation": "Том очень известный художник.",
          "source": "Tatoeba #5820161 @dnnywld / #5818314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5820161",
          "cefr_level": "A1",
          "word_slugs": [
            "pittore-noun"
          ]
        },
        {
          "id": "5570981",
          "text": "Un pittore mi ha fatto il ritratto.",
          "translation": "Художник написал мой портрет.",
          "source": "Tatoeba #5570981 @dnnywld / #5570776 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5570981",
          "cefr_level": "A1",
          "word_slugs": [
            "pittore-noun"
          ]
        },
        {
          "id": "5669233",
          "text": "Tom spera di diventare un pittore famoso.",
          "translation": "Том надеется стать знаменитым художником.",
          "source": "Tatoeba #5669233 @dnnywld / #5669056 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5669233",
          "cefr_level": "A1",
          "word_slugs": [
            "pittore-noun"
          ]
        }
      ],
