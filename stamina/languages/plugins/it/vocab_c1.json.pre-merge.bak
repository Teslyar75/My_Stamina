          ]
        },
        {
          "id": "6636038",
          "text": "Cosa devo fare in simili situazioni?",
          "translation": "Что я должен делать в таких ситуациях?",
          "source": "Tatoeba #6636038 @dnnywld / #6634710 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6636038",
          "cefr_level": "A1",
          "word_slugs": [
            "situazioni-noun"
          ]
        },
        {
          "id": "5792024",
          "text": "Tom in queste situazioni non è di alcun aiuto.",
          "translation": "От Тома в таких ситуациях всегда никакой пользы.",
          "source": "Tatoeba #5792024 @dnnywld / #5791200 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5792024",
          "cefr_level": "A1",
          "word_slugs": [
            "situazioni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la situazioni",
        "plural": "",
        "infinitive": ""
      }
