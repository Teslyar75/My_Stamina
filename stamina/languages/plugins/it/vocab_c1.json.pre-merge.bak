      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "осёл"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4538346",
          "text": "L'asino raglia.",
          "translation": "Осёл ревёт.",
          "source": "Tatoeba #4538346 @Guybrush88 / #4539286 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538346",
          "cefr_level": "A1",
          "word_slugs": [
            "asino-noun"
          ]
        },
        {
          "id": "5694310",
          "text": "Disegnami un asino.",
          "translation": "Нарисуй мне ослика.",
          "source": "Tatoeba #5694310 @dnnywld / #5693851 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5694310",
          "cefr_level": "A1",
          "word_slugs": [
            "asino-noun"
          ]
        },
        {
          "id": "3219081",
          "text": "Sei veramente un asino.",
          "translation": "Ты действительно осёл.",
          "source": "Tatoeba #3219081 @Guybrush88 / #3219536 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3219081",
          "cefr_level": "A1",
          "word_slugs": [
            "asino-noun"
          ]
        },
        {
          "id": "385343",
          "text": "Quello non è un cavallo, ma un asino.",
          "translation": "Это не лошадь, а осёл.",
          "source": "Tatoeba #385343 @Pharamp / #4353811 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/385343",
          "cefr_level": "A1",
          "word_slugs": [
            "asino-noun"
          ]
        },
        {
          "id": "7764185",
          "text": "L'asino ha un grido forte e sgradevole.",
          "translation": "У ишака громкий и неприятный крик.",
          "source": "Tatoeba #7764185 @dnnywld / #7763689 @Wayawa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7764185",
          "cefr_level": "A1",
          "word_slugs": [
            "asino-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
