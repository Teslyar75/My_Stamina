    {
      "slug": "reggiseno-noun",
      "lemma": "reggiseno",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6604,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10856346",
          "text": "Ti si vede il reggiseno.",
          "translation": "У тебя бюстгальтер виден.",
          "source": "Tatoeba #10856346 @dnnywld / #5038628 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10856346",
          "cefr_level": "A1",
          "word_slugs": [
            "reggiseno-noun"
          ]
        },
        {
          "id": "2624057",
          "text": "Mary non sta indossando un reggiseno.",
          "translation": "Мэри не носит бюстгальтер.",
          "source": "Tatoeba #2624057 @Guybrush88 / #2398498 @L7ar18 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2624057",
          "cefr_level": "A1",
          "word_slugs": [
            "reggiseno-noun"
          ]
        },
        {
          "id": "10856347",
          "text": "Alcune donne non portano in reggiseno.",
          "translation": "Некоторые женщины не носят бюстгальтер.",
          "source": "Tatoeba #10856347 @dnnywld / #3938077 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10856347",
          "cefr_level": "A1",
          "word_slugs": [
            "reggiseno-noun"
          ]
        },
        {
          "id": "1335454",
          "text": "Il ragazzino non sa come si toglie un reggiseno.",
          "translation": "Ребёнок не знает, как снимается бюстгальтер.",
          "source": "Tatoeba #1335454 @marco87 / #4629946 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1335454",
          "cefr_level": "A1",
          "word_slugs": [
            "reggiseno-noun"
          ]
        }
      ],
      "tags": [
