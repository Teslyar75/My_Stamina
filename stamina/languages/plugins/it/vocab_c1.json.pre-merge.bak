    {
      "slug": "scherza-verb",
      "lemma": "scherza",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7554,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7023880",
          "text": "In amore non si scherza.",
          "translation": "С любовью не шутят.",
          "source": "Tatoeba #7023880 @dnnywld / #7023009 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7023880",
          "cefr_level": "A1",
          "word_slugs": [
            "scherza-verb"
          ]
        },
        {
          "id": "4226818",
          "text": "Non si scherza sulla morte.",
          "translation": "О смерти не шутят.",
          "source": "Tatoeba #4226818 @Guybrush88 / #4391047 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4226818",
          "cefr_level": "A1",
          "word_slugs": [
            "scherza-verb"
          ]
        },
        {
          "id": "6698387",
          "text": "Quando Tom scherza, nessuno intorno ride.",
          "translation": "Когда Том шутит, никто вокруг не смеётся.",
          "source": "Tatoeba #6698387 @dnnywld / #6697408 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698387",
          "cefr_level": "A1",
          "word_slugs": [
            "scherza-verb"
          ]
        },
        {
          "id": "12995045",
          "text": "Non si scherza con parole del genere.",
          "translation": "Такими словами не разбрасываются.",
          "source": "Tatoeba #12995045 @dnnywld / #12994098 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12995045",
          "cefr_level": "A1",
          "word_slugs": [
            "scherza-verb"
          ]
        },
        {
          "id": "5472764",
          "text": "Tom non scherza mai riguardo al suo lavoro.",
          "translation": "Том никогда не шутит про свою работу.",
          "source": "Tatoeba #5472764 @dnnywld / #1424310 @Snark (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472764",
          "cefr_level": "A1",
          "word_slugs": [
            "scherza-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "scherza",
        "plural": "",
        "infinitive": "scherza"
      }
