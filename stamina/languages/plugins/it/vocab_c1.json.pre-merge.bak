    {
      "slug": "riempito-adj",
      "lemma": "riempito",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7567,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10853802",
          "text": "Ho riempito il formulario.",
          "translation": "Я заполнил бланки.",
          "source": "Tatoeba #10853802 @dnnywld / #3670560 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10853802",
          "cefr_level": "A1",
          "word_slugs": [
            "riempito-adj"
          ]
        },
        {
          "id": "838296",
          "text": "Ha riempito la bottiglia d'acqua.",
          "translation": "Он наполнил бутылку водой.",
          "source": "Tatoeba #838296 @Guybrush88 / #561740 @pandabear (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/838296",
          "cefr_level": "A1",
          "word_slugs": [
            "riempito-adj"
          ]
        },
        {
          "id": "5403015",
          "text": "Lui ha riempito i bicchieri col vino.",
          "translation": "Он наполнил бокалы вином.",
          "source": "Tatoeba #5403015 @dnnywld / #2309216 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5403015",
          "cefr_level": "A1",
          "word_slugs": [
            "riempito-adj"
          ]
        },
        {
          "id": "643179",
          "text": "Ha riempito il bicchiere con del vino.",
          "translation": "Он наполнил бокал вином.",
          "source": "Tatoeba #643179 @Guybrush88 / #647293 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/643179",
          "cefr_level": "A1",
          "word_slugs": [
            "riempito-adj"
          ]
        },
        {
          "id": "5635264",
          "text": "L'intero tavolo era riempito di piatti da mangiare.",
          "translation": "Весь стол уставлен тарелками с едой.",
          "source": "Tatoeba #5635264 @dnnywld / #5635014 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635264",
          "cefr_level": "A1",
