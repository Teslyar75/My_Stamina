      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2556149",
          "text": "Io viaggio leggera.",
          "translation": "Я путешествую налегке.",
          "source": "Tatoeba #2556149 @Guybrush88 / #2606981 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2556149",
          "cefr_level": "A1",
          "word_slugs": [
            "leggera-adj"
          ]
        },
        {
          "id": "6589306",
          "text": "Tom pratica l'atletica leggera?",
          "translation": "Том занимается лёгкой атлетикой?",
          "source": "Tatoeba #6589306 @dnnywld / #6588479 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6589306",
          "cefr_level": "A1",
          "word_slugs": [
            "leggera-adj"
          ]
        },
        {
          "id": "5512529",
          "text": "Cadeva una fitta, pioggia leggera.",
          "translation": "Падал плотный, тяжелый дождь.",
          "source": "Tatoeba #5512529 @dnnywld / #4006138 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512529",
          "cefr_level": "A1",
          "word_slugs": [
            "leggera-adj"
          ]
        },
        {
          "id": "858523",
          "text": "Di solito faccio una colazione leggera.",
          "translation": "У меня обычно лёгкий завтрак.",
          "source": "Tatoeba #858523 @riccioberto / #2479537 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/858523",
          "cefr_level": "A1",
          "word_slugs": [
            "leggera-adj"
          ]
        },
        {
          "id": "5384963",
          "text": "Questa mattina soffia una leggera brezza.",
          "translation": "Сегодня с утра дует лёгкий бриз.",
          "source": "Tatoeba #5384963 @dnnywld / #5384765 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384963",
          "cefr_level": "A1",
          "word_slugs": [
            "leggera-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
