    {
      "slug": "chiari-adj",
      "lemma": "chiari",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6198,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5528814",
          "text": "I motivi sono chiari.",
          "translation": "Причины понятны.",
          "source": "Tatoeba #5528814 @dnnywld / #4748074 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5528814",
          "cefr_level": "A1",
          "word_slugs": [
            "chiari-adj"
          ]
        },
        {
          "id": "5497389",
          "text": "Siete stati molto chiari.",
          "translation": "Вы очень ясно выразились.",
          "source": "Tatoeba #5497389 @dnnywld / #5497291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497389",
          "cefr_level": "A1",
          "word_slugs": [
            "chiari-adj"
          ]
        },
        {
          "id": "1151679",
          "text": "Patti chiari amicizia lunga.",
          "translation": "Счёт дружбе не помеха.",
          "source": "Tatoeba #1151679 @xicotenga / #5512683 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1151679",
          "cefr_level": "A1",
          "word_slugs": [
            "chiari-adj"
          ]
        },
        {
          "id": "2430419",
          "text": "I tuoi articoli sono sempre molto chiari e piacevoli da leggere.",
          "translation": "Твои статьи всегда очень ясно написаны и приятны для чтения.",
          "source": "Tatoeba #2430419 @al_ex_an_der / #2430423 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430419",
          "cefr_level": "A1",
          "word_slugs": [
            "chiari-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il chiari",
        "plural": "",
        "infinitive": ""
      }
    },
