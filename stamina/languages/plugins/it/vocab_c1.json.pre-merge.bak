    {
      "slug": "disprezzo-noun",
      "lemma": "disprezzo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9077,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5664120",
          "text": "Io lo disprezzo.",
          "translation": "Я его презираю.",
          "source": "Tatoeba #5664120 @dnnywld / #5664071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5664120",
          "cefr_level": "A1",
          "word_slugs": [
            "disprezzo-noun"
          ]
        },
        {
          "id": "5433544",
          "text": "Disprezzo questa musica.",
          "translation": "Я презираю эту музыку.",
          "source": "Tatoeba #5433544 @dnnywld / #5432994 @sikmir (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433544",
          "cefr_level": "A1",
          "word_slugs": [
            "disprezzo-noun"
          ]
        },
        {
          "id": "3146589",
          "text": "Troppa familiarità genera disprezzo.",
          "translation": "Излишняя фамильярность порождает презрение.",
          "source": "Tatoeba #3146589 @Guybrush88 / #10674197 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3146589",
          "cefr_level": "A1",
          "word_slugs": [
            "disprezzo-noun"
          ]
        },
        {
          "id": "6832334",
          "text": "A dire il vero, lo disprezzo.",
          "translation": "По правде говоря, я его презираю.",
          "source": "Tatoeba #6832334 @dnnywld / #5144074 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6832334",
          "cefr_level": "A1",
          "word_slugs": [
            "disprezzo-noun"
          ]
        },
        {
          "id": "5512095",
          "text": "Diverse volte lei mi ha guardato con disprezzo.",
          "translation": "Несколько раз она посмотрела на меня с презрением.",
          "source": "Tatoeba #5512095 @dnnywld / #5511183 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512095",
          "cefr_level": "A1",
          "word_slugs": [
            "disprezzo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
