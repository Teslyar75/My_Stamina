    {
      "slug": "preferite-adj",
      "lemma": "preferite",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6365,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6324977",
          "text": "Preferite del tè?",
          "translation": "Вы предпочитаете чай?",
          "source": "Tatoeba #6324977 @dnnywld / #6324295 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6324977",
          "cefr_level": "A1",
          "word_slugs": [
            "preferite-adj"
          ]
        },
        {
          "id": "6919062",
          "text": "Quale tè preferite?",
          "translation": "Какой чай вы предпочитаете?",
          "source": "Tatoeba #6919062 @dnnywld / #6918734 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919062",
          "cefr_level": "A1",
          "word_slugs": [
            "preferite-adj"
          ]
        },
        {
          "id": "5974804",
          "text": "Che sport preferite?",
          "translation": "Какой вид спорта вы предпочитаете?",
          "source": "Tatoeba #5974804 @dnnywld / #5974557 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5974804",
          "cefr_level": "A1",
          "word_slugs": [
            "preferite-adj"
          ]
        },
        {
          "id": "6829940",
          "text": "Siate lì, dove preferite.",
          "translation": "Будьте там, где вам больше нравится.",
          "source": "Tatoeba #6829940 @dnnywld / #6829805 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6829940",
          "cefr_level": "A1",
          "word_slugs": [
            "preferite-adj"
          ]
        },
        {
          "id": "5554600",
          "text": "Potete cominciare quando preferite.",
          "translation": "Можете начать когда угодно.",
          "source": "Tatoeba #5554600 @dnnywld / #4300406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5554600",
          "cefr_level": "A1",
          "word_slugs": [
            "preferite-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
