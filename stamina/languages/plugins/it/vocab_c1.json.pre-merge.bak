            "birre-noun"
          ]
        },
        {
          "id": "5891784",
          "text": "Quante birre ti sei scolata?",
          "translation": "Сколько бутылок пива ты выпила?",
          "source": "Tatoeba #5891784 @dnnywld / #5891603 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5891784",
          "cefr_level": "A1",
          "word_slugs": [
            "birre-noun"
          ]
        },
        {
          "id": "856967",
          "text": "Tre birre e una tequila, per piacere.",
          "translation": "Три пива и одну текилу, пожалуйста.",
          "source": "Tatoeba #856967 @Guybrush88 / #11371788 @Txoria (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/856967",
          "cefr_level": "A1",
          "word_slugs": [
            "birre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
