    {
      "slug": "negato-adj",
      "lemma": "negato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6827,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5546159",
          "text": "L'ho negato.",
          "translation": "Я это отрицал.",
          "source": "Tatoeba #5546159 @dnnywld / #5545657 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5546159",
          "cefr_level": "A1",
          "word_slugs": [
            "negato-adj"
          ]
        },
        {
          "id": "5676739",
          "text": "Tom non ha negato nulla.",
          "translation": "Том ничего не отрицал.",
          "source": "Tatoeba #5676739 @dnnywld / #5676605 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5676739",
          "cefr_level": "A1",
          "word_slugs": [
            "negato-adj"
          ]
        },
        {
          "id": "11498311",
          "text": "Questo non può più essere negato.",
          "translation": "Этого уже нельзя отрицать.",
          "source": "Tatoeba #11498311 @Bernie75 / #2765005 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11498311",
          "cefr_level": "A1",
          "word_slugs": [
            "negato-adj"
          ]
        },
        {
          "id": "2030895",
          "text": "Ha negato di aver rubato i soldi.",
          "translation": "Он отрицал обвинения в краже денег.",
          "source": "Tatoeba #2030895 @Sirio60 / #1397994 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2030895",
          "cefr_level": "A1",
          "word_slugs": [
            "negato-adj"
          ]
        },
        {
          "id": "5625609",
          "text": "Tom ha negato di aver incontrato Mary.",
          "translation": "Том отрицал, что встречал Мэри.",
          "source": "Tatoeba #5625609 @dnnywld / #5621507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5625609",
          "cefr_level": "A1",
          "word_slugs": [
            "negato-adj"
          ]
        }
