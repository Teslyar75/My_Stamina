    {
      "slug": "divenne-verb",
      "lemma": "divenne",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6214,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12769998",
          "text": "Tom divenne rosso come un pomodoro.",
          "translation": "Том стал красный как помидор.",
          "source": "Tatoeba #12769998 @Adelpa / #12452402 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12769998",
          "cefr_level": "A1",
          "word_slugs": [
            "divenne-verb"
          ]
        },
        {
          "id": "12770026",
          "text": "Maria divenne rossa come un pomodoro.",
          "translation": "Мэри стала красная как помидор.",
          "source": "Tatoeba #12770026 @Adelpa / #7308786 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12770026",
          "cefr_level": "A1",
          "word_slugs": [
            "divenne-verb"
          ]
        },
        {
          "id": "6885199",
          "text": "Il rumore divenne gradualmente più forte.",
          "translation": "Шум постепенно стал громче.",
          "source": "Tatoeba #6885199 @dnnywld / #4685615 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6885199",
          "cefr_level": "A1",
          "word_slugs": [
            "divenne-verb"
          ]
        },
        {
          "id": "10799917",
          "text": "Cercò di sembrare serio, ma divenne divertente.",
          "translation": "Он постарался придать себе серьёзный вид, но получилось потешно.",
          "source": "Tatoeba #10799917 @carlosalberto / #5671277 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10799917",
          "cefr_level": "A1",
          "word_slugs": [
            "divenne-verb"
          ]
        },
        {
          "id": "6943255",
          "text": "Nel giro di pochi minuti lei divenne di nuovo seria.",
          "translation": "Уже через несколько минут она опять стала серьёзной.",
          "source": "Tatoeba #6943255 @dnnywld / #5584877 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6943255",
          "cefr_level": "A1",
          "word_slugs": [
            "divenne-verb"
          ]
        }
      ],
