      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5406,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1204352",
          "text": "Gli ha telefonato?",
          "translation": "Вы звонили ему?",
          "source": "Tatoeba #1204352 @Guybrush88 / #2463749 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1204352",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonato-verb"
          ]
        },
        {
          "id": "10852210",
          "text": "Ha telefonato papà.",
          "translation": "Папа звонил.",
          "source": "Tatoeba #10852210 @dnnywld / #10852020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10852210",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonato-verb"
          ]
        },
        {
          "id": "10852211",
          "text": "Ha telefonato mamma.",
          "translation": "Мама звонила.",
          "source": "Tatoeba #10852211 @dnnywld / #10852019 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10852211",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonato-verb"
          ]
        },
        {
          "id": "1204353",
          "text": "Gli avete telefonato?",
          "translation": "Вы звонили ему?",
          "source": "Tatoeba #1204353 @Guybrush88 / #2463749 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1204353",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonato-verb"
          ]
        },
        {
          "id": "5610408",
          "text": "Non ti ho telefonato.",
          "translation": "Я тебе не звонил.",
          "source": "Tatoeba #5610408 @dnnywld / #5609858 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5610408",
          "cefr_level": "A1",
          "word_slugs": [
            "telefonato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
