    {
      "slug": "gorilla-noun",
      "lemma": "gorilla",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8238,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5897349",
          "text": "I gorilla molto raramente si arrampicano sugli alberi.",
          "translation": "Гориллы очень редко взбираются на деревья.",
          "source": "Tatoeba #5897349 @dnnywld / #5897227 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5897349",
          "cefr_level": "A1",
          "word_slugs": [
            "gorilla-noun"
          ]
        },
        {
          "id": "6866666",
          "text": "Il maschio del gorilla può pesare più di duecento settanta chilogrammi.",
          "translation": "Самец гориллы может весить более двухсот семидесяти килограммов.",
          "source": "Tatoeba #6866666 @dnnywld / #6865206 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866666",
          "cefr_level": "A1",
          "word_slugs": [
            "gorilla-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il gorilla",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "vicinanze-noun",
      "lemma": "vicinanze",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8240,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5694553",
          "text": "Tom sarà nelle vicinanze.",
          "translation": "Том будет поблизости.",
          "source": "Tatoeba #5694553 @dnnywld / #5691680 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5694553",
          "cefr_level": "A1",
          "word_slugs": [
            "vicinanze-noun"
          ]
        },
        {
          "id": "5882855",
          "text": "Lui abita nelle vicinanze.",
          "translation": "Он живёт поблизости.",
          "source": "Tatoeba #5882855 @dnnywld / #5882742 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5882855",
          "cefr_level": "A1",
          "word_slugs": [
            "vicinanze-noun"
          ]
        },
        {
          "id": "7326853",
          "text": "Fadil aspettava nelle vicinanze.",
          "translation": "Фадель ждал неподалёку.",
          "source": "Tatoeba #7326853 @dnnywld / #7326199 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7326853",
          "cefr_level": "A1",
          "word_slugs": [
            "vicinanze-noun"
          ]
        },
        {
          "id": "7326850",
          "text": "Fadil aspettava lì nelle vicinanze.",
          "translation": "Фадель ждал там неподалёку.",
          "source": "Tatoeba #7326850 @dnnywld / #7326201 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7326850",
          "cefr_level": "A1",
          "word_slugs": [
            "vicinanze-noun"
          ]
        },
        {
          "id": "5966252",
          "text": "Nelle vicinanze c'è una fattoria.",
          "translation": "Поблизости есть ферма.",
          "source": "Tatoeba #5966252 @dnnywld / #5964999 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5966252",
          "cefr_level": "A1",
          "word_slugs": [
            "vicinanze-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la vicinanze",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "metterà-verb",
      "lemma": "metterà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8241,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2161301",
          "text": "Dove lo metterà?",
          "translation": "Куда он это поставит?",
          "source": "Tatoeba #2161301 @Guybrush88 / #6044229 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2161301",
          "cefr_level": "A1",
          "word_slugs": [
            "metterà-verb"
          ]
        },
        {
          "id": "6611732",
          "text": "So che Tom si metterà a piangere.",
          "translation": "Я знаю, что Том заплачет.",
          "source": "Tatoeba #6611732 @dnnywld / #6603711 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6611732",
          "cefr_level": "A1",
          "word_slugs": [
            "metterà-verb"
          ]
        },
        {
          "id": "5652086",
          "text": "Lei metterà la sua casa in vendita.",
          "translation": "Она продаст свой дом.",
          "source": "Tatoeba #5652086 @dnnywld / #5651685 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652086",
          "cefr_level": "A1",
          "word_slugs": [
            "metterà-verb"
          ]
        },
        {
          "id": "5551356",
          "text": "La vita metterà ogni cosa al suo posto.",
          "translation": "Жизнь расставит всё по своим местам.",
          "source": "Tatoeba #5551356 @dnnywld / #5550824 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551356",
          "cefr_level": "A1",
          "word_slugs": [
            "metterà-verb"
          ]
        },
        {
          "id": "6873630",
          "text": "Aspettiamo. Il tempo metterà tutto al proprio posto.",
          "translation": "Подождём. Время всё расставит по своим местам.",
          "source": "Tatoeba #6873630 @dnnywld / #6872646 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6873630",
          "cefr_level": "A1",
          "word_slugs": [
            "metterà-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "metterà",
        "plural": "",
        "infinitive": "metterà"
      }
