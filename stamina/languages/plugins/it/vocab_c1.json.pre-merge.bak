      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5476311",
          "text": "Oggi non ci sono nuvole.",
          "translation": "Сегодня нет туч.",
          "source": "Tatoeba #5476311 @dnnywld / #2035888 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476311",
          "cefr_level": "A1",
          "word_slugs": [
            "nuvole-adj"
          ]
        },
        {
          "id": "3293841",
          "text": "Sono volato sopra le nuvole.",
          "translation": "Я летел над облаками.",
          "source": "Tatoeba #3293841 @Guybrush88 / #920050 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3293841",
          "cefr_level": "A1",
