    {
      "slug": "professionisti-adj",
      "lemma": "professionisti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6041,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5580382",
          "text": "Siamo tutti professionisti.",
          "translation": "Мы все профессионалы.",
          "source": "Tatoeba #5580382 @dnnywld / #5579501 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5580382",
          "cefr_level": "A1",
          "word_slugs": [
            "professionisti-adj"
          ]
        },
        {
          "id": "5997053",
          "text": "Lascialo ai professionisti.",
          "translation": "Оставь это профессионалам.",
          "source": "Tatoeba #5997053 @dnnywld / #2868838 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997053",
          "cefr_level": "A1",
          "word_slugs": [
            "professionisti-adj"
          ]
        },
        {
          "id": "5504187",
          "text": "Qui siamo tutti professionisti.",
          "translation": "Мы здесь все профи.",
          "source": "Tatoeba #5504187 @dnnywld / #5503885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504187",
          "cefr_level": "A1",
          "word_slugs": [
            "professionisti-adj"
          ]
        },
        {
          "id": "10917135",
          "text": "I volontari aiutano i professionisti.",
          "translation": "Профессионалам помогают добровольцы.",
          "source": "Tatoeba #10917135 @dnnywld / #6571984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10917135",
          "cefr_level": "A1",
          "word_slugs": [
            "professionisti-adj"
          ]
        },
        {
          "id": "5997171",
          "text": "Lascia questo lavoro ai professionisti!",
          "translation": "Оставь это дело профессионалам!",
          "source": "Tatoeba #5997171 @dnnywld / #2493372 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997171",
          "cefr_level": "A1",
          "word_slugs": [
            "professionisti-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
