    {
      "slug": "limone-adj",
      "lemma": "limone",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7283,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "971663",
          "text": "Il limone è acido.",
          "translation": "Лимоны кислые.",
          "source": "Tatoeba #971663 @Guybrush88 / #351216 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/971663",
          "cefr_level": "A1",
          "word_slugs": [
            "limone-adj"
          ]
        },
        {
          "id": "2516139",
          "text": "Il limone è giallo.",
          "translation": "Лимон жёлтый.",
          "source": "Tatoeba #2516139 @Guybrush88 / #3337882 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2516139",
          "cefr_level": "A1",
          "word_slugs": [
            "limone-adj"
          ]
        },
        {
          "id": "5628451",
          "text": "Lei spremette un limone.",
          "translation": "Она выжала лимон.",
          "source": "Tatoeba #5628451 @dnnywld / #5628205 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5628451",
          "cefr_level": "A1",
          "word_slugs": [
            "limone-adj"
          ]
        },
        {
          "id": "677814",
          "text": "Il limone contiene acido citrico.",
          "translation": "В лимонах содержится лимонная кислота.",
          "source": "Tatoeba #677814 @rado / #3337875 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/677814",
          "cefr_level": "A1",
          "word_slugs": [
            "limone-adj"
          ]
        },
        {
          "id": "2602329",
