      "frequency_rank": 8301,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6978316",
          "text": "Non porto le calze.",
          "translation": "Я не ношу носков.",
          "source": "Tatoeba #6978316 @dnnywld / #5183900 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6978316",
          "cefr_level": "A1",
          "word_slugs": [
            "calze-noun"
          ]
        },
        {
          "id": "5560766",
          "text": "Tom era senza calze.",
          "translation": "Том был без носков.",
