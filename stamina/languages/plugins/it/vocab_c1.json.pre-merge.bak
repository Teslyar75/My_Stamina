    {
      "slug": "piove-verb",
      "lemma": "piove",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7169,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6887794",
          "text": "Piove da lunedì.",
          "translation": "Дождь идёт с понедельника.",
          "source": "Tatoeba #6887794 @dnnywld / #6887697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6887794",
          "cefr_level": "A1",
          "word_slugs": [
            "piove-verb"
          ]
        },
        {
          "id": "5493271",
          "text": "Qui piove spesso.",
          "translation": "Здесь часто идёт дождь.",
          "source": "Tatoeba #5493271 @dnnywld / #5493215 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5493271",
          "cefr_level": "A1",
          "word_slugs": [
            "piove-verb"
          ]
        },
        {
          "id": "384564",
          "text": "Piove a catinelle!",
          "translation": "Льёт как из ведра.",
          "source": "Tatoeba #384564 @Pharamp / #384560 @Dorenda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/384564",
          "cefr_level": "A1",
          "word_slugs": [
            "piove-verb"
          ]
        },
        {
          "id": "12374024",
          "text": "Qui piove abbondantemente.",
          "translation": "Здесь идут обильные дожди.",
          "source": "Tatoeba #12374024 @dnnywld / #12373127 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12374024",
          "cefr_level": "A1",
          "word_slugs": [
            "piove-verb"
          ]
        },
        {
          "id": "12391155",
          "text": "Piove lì da voi?",
          "translation": "У вас там дождь идёт?",
          "source": "Tatoeba #12391155 @dnnywld / #12391027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12391155",
          "cefr_level": "A1",
          "word_slugs": [
            "piove-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "piove",
        "plural": "",
        "infinitive": "piove"
      }
