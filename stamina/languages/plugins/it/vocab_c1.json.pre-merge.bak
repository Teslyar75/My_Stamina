    {
      "slug": "cappelli-noun",
      "lemma": "cappelli",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9444,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5497397",
          "text": "Ho molti cappelli.",
          "translation": "У меня много шапок.",
          "source": "Tatoeba #5497397 @dnnywld / #5497280 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497397",
          "cefr_level": "A1",
          "word_slugs": [
            "cappelli-noun"
          ]
        },
        {
          "id": "7976098",
          "text": "Quanti cappelli hai?",
          "translation": "Сколько у тебя шапок?",
          "source": "Tatoeba #7976098 @dnnywld / #953034 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7976098",
          "cefr_level": "A1",
          "word_slugs": [
            "cappelli-noun"
          ]
        },
        {
          "id": "6484897",
          "text": "Quanti cappelli avete?",
          "translation": "Сколько у вас шапок?",
          "source": "Tatoeba #6484897 @dnnywld / #6484629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6484897",
          "cefr_level": "A1",
          "word_slugs": [
            "cappelli-noun"
          ]
        },
        {
          "id": "5643663",
          "text": "Ho cappelli a sufficienza.",
          "translation": "У меня довольно много шляп.",
          "source": "Tatoeba #5643663 @dnnywld / #5642810 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643663",
          "cefr_level": "A1",
          "word_slugs": [
            "cappelli-noun"
          ]
        },
        {
          "id": "11530677",
          "text": "I cappelli mi stanno bene.",
          "translation": "Мне идут шляпы.",
          "source": "Tatoeba #11530677 @dnnywld / #9509020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11530677",
          "cefr_level": "A1",
          "word_slugs": [
            "cappelli-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il cappelli",
        "plural": "",
