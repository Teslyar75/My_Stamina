    {
      "slug": "fetta-noun",
      "lemma": "fetta",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6499,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5662167",
          "text": "Tutti volevano una fetta di torta.",
          "translation": "Все хотели по кусочку пирога.",
          "source": "Tatoeba #5662167 @dnnywld / #5661320 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662167",
          "cefr_level": "A1",
          "word_slugs": [
            "fetta-noun"
          ]
        },
        {
          "id": "3382491",
          "text": "Tom ha imburrato una fetta di pane.",
          "translation": "Том намазал маслом кусок хлеба.",
          "source": "Tatoeba #3382491 @Guybrush88 / #3715995 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3382491",
          "cefr_level": "A1",
          "word_slugs": [
            "fetta-noun"
          ]
        },
        {
          "id": "5494736",
          "text": "Tom ha mangiato solo una fetta di pane.",
          "translation": "Том съел только кусочек хлеба.",
          "source": "Tatoeba #5494736 @dnnywld / #5494685 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494736",
          "cefr_level": "A1",
          "word_slugs": [
            "fetta-noun"
          ]
        },
        {
          "id": "6876924",
          "text": "\"Vuoi un'altra fetta di torta?\" - \"Si, grazie\".",
          "translation": "\"Хочешь ещё кусочек торта?\" - \"Да, спасибо\".",
          "source": "Tatoeba #6876924 @dnnywld / #2994298 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6876924",
          "cefr_level": "A1",
          "word_slugs": [
            "fetta-noun"
          ]
        },
        {
          "id": "6876931",
          "text": "\"Volete un'altra fetta di torta?\" - \"Sì, volentieri\".",
          "translation": "\"Хотите ещё кусочек пирога?\" - \"Да, с удовольствием\".",
          "source": "Tatoeba #6876931 @dnnywld / #2079178 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6876931",
          "cefr_level": "A1",
          "word_slugs": [
            "fetta-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la fetta",
        "plural": "",
        "infinitive": ""
      }
    },
