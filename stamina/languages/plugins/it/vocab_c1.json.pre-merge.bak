    {
      "slug": "piene-adj",
      "lemma": "piene",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5684,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4352213",
          "text": "Quante persone piene di razzismo e odio!",
          "translation": "Сколько людей полны расизма и ненависти!",
          "source": "Tatoeba #4352213 @Guybrush88 / #4352219 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4352213",
          "cefr_level": "A1",
          "word_slugs": [
            "piene-adj"
          ]
        },
        {
          "id": "5463124",
          "text": "Per favore, togliete le vostre scarpe piene di fango.",
          "translation": "Пожалуйста, сними свои грязные ботинки.",
          "source": "Tatoeba #5463124 @dnnywld / #5462907 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5463124",
          "cefr_level": "A1",
          "word_slugs": [
            "piene-adj"
          ]
        },
        {
          "id": "5398923",
          "text": "Tom entrò in camera con le mani piene di panni.",
          "translation": "Том вошёл в комнату с охапкой белья.",
          "source": "Tatoeba #5398923 @dnnywld / #2963788 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5398923",
          "cefr_level": "A1",
          "word_slugs": [
            "piene-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il piene",
        "plural": "",
        "infinitive": ""
      }
