          ]
        },
        {
          "id": "6378829",
          "text": "Lei adora fare shopping.",
          "translation": "Она обожает ходить по магазинам.",
          "source": "Tatoeba #6378829 @dnnywld / #3520453 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6378829",
          "cefr_level": "A1",
          "word_slugs": [
