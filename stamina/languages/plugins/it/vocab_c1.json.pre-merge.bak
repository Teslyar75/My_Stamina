    {
      "slug": "rifiuta-verb",
      "lemma": "rifiuta",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5682,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6770780",
          "text": "Tom si rifiuta di mangiare.",
          "translation": "Том отказывается есть.",
          "source": "Tatoeba #6770780 @Guybrush88 / #6783531 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770780",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiuta-verb"
          ]
        },
        {
          "id": "6809398",
          "text": "Perché Tom rifiuta l'aiuto?",
          "translation": "Почему Том отказывается от помощи?",
          "source": "Tatoeba #6809398 @dnnywld / #6808609 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6809398",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiuta-verb"
          ]
        },
        {
          "id": "10851067",
          "text": "Tom rifiuta di pagare gli alimenti.",
          "translation": "Том отказывается платить алименты.",
          "source": "Tatoeba #10851067 @dnnywld / #7952758 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851067",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiuta-verb"
          ]
        },
        {
          "id": "6891000",
          "text": "Gravemente malata, Vitya si rifiuta di mangiare qualsiasi cosa.",
          "translation": "Тяжело болеющий Витя отказывается хоть что-нибудь поесть.",
          "source": "Tatoeba #6891000 @dnnywld / #2512672 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891000",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiuta-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "rifiuta",
        "plural": "",
        "infinitive": "rifiuta"
