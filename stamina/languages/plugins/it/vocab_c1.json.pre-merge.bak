      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5574025",
          "text": "Le macchine sono care.",
          "translation": "Машины дорогие.",
          "source": "Tatoeba #5574025 @dnnywld / #5573912 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5574025",
          "cefr_level": "A1",
          "word_slugs": [
