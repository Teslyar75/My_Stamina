    {
      "slug": "interrotto-adj",
      "lemma": "interrotto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5322,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4884884",
          "text": "Tom mi ha interrotto.",
          "translation": "Том меня перебил.",
          "source": "Tatoeba #4884884 @Guybrush88 / #5675321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4884884",
          "cefr_level": "A1",
          "word_slugs": [
            "interrotto-adj"
          ]
        },
        {
          "id": "5688494",
          "text": "Ho interrotto il tuo sonno.",
          "translation": "Я прервал твой сон.",
          "source": "Tatoeba #5688494 @dnnywld / #2494904 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688494",
          "cefr_level": "A1",
          "word_slugs": [
            "interrotto-adj"
          ]
        },
        {
          "id": "5598304",
          "text": "Gli hanno interrotto il servizio telefonico per mancato pagamento.",
          "translation": "Ему отключили телефон за неуплату.",
          "source": "Tatoeba #5598304 @dnnywld / #5598178 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5598304",
          "cefr_level": "A1",
          "word_slugs": [
            "interrotto-adj"
          ]
        },
        {
          "id": "992245",
          "text": "Il silenzio è stato interrotto da un forte colpo di tosse.",
          "translation": "Тишину нарушил громкий кашель.",
          "source": "Tatoeba #992245 @Guybrush88 / #5816313 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/992245",
          "cefr_level": "A1",
          "word_slugs": [
