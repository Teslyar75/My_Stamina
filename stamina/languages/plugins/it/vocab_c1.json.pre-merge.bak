    {
      "slug": "meritato-adj",
      "lemma": "meritato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8286,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5387870",
          "text": "L'ho meritato.",
          "translation": "Я это заслужил.",
          "source": "Tatoeba #5387870 @dnnywld / #3090217 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387870",
          "cefr_level": "A1",
          "word_slugs": [
            "meritato-adj"
          ]
        },
        {
          "id": "5411414",
          "text": "Non te lo sei meritato.",
          "translation": "Ты этого не заслужил.",
          "source": "Tatoeba #5411414 @dnnywld / #4281347 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5411414",
          "cefr_level": "A1",
          "word_slugs": [
            "meritato-adj"
          ]
        },
        {
          "id": "5465501",
          "text": "Tom ha meritato il premio.",
          "translation": "Том заслужил приз.",
          "source": "Tatoeba #5465501 @dnnywld / #5465003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5465501",
          "cefr_level": "A1",
          "word_slugs": [
