        {
          "id": "6562806",
          "text": "Parlo l'arabo.",
          "translation": "Я говорю по-арабски.",
          "source": "Tatoeba #6562806 @Guybrush88 / #2638418 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6562806",
