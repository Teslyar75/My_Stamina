    {
      "slug": "condotta-adj",
      "lemma": "condotta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5651,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11860730",
          "text": "La tua condotta è assolutamente vergognosa.",
          "translation": "Твоё поведение в высшей степени постыдно.",
          "source": "Tatoeba #11860730 @dnnywld / #6461176 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11860730",
          "cefr_level": "A1",
          "word_slugs": [
            "condotta-adj"
          ]
        },
        {
          "id": "6857577",
          "text": "La tua linea di condotta è sbagliata.",
          "translation": "Твоя линия поведения ошибочна.",
          "source": "Tatoeba #6857577 @dnnywld / #3251971 @kukla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857577",
          "cefr_level": "A1",
          "word_slugs": [
            "condotta-adj"
          ]
        },
        {
          "id": "6956670",
          "text": "Non riesco a sopportare la sua condotta.",
          "translation": "Я не могу терпеть его поступки.",
          "source": "Tatoeba #6956670 @dnnywld / #6956146 @kruvez (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6956670",
          "cefr_level": "A1",
          "word_slugs": [
            "condotta-adj"
          ]
        },
        {
          "id": "6786743",
          "text": "La tua condotta lascia molto a desiderare.",
          "translation": "Твоё поведение оставляет желать лучшего.",
          "source": "Tatoeba #6786743 @dnnywld / #1772896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786743",
          "cefr_level": "A1",
          "word_slugs": [
            "condotta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il condotta",
        "plural": "",
        "infinitive": ""
      }
    },
