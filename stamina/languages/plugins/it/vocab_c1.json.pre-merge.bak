          ]
        },
        {
          "id": "10849818",
          "text": "Si è tenuta l'assemblea degli azionisti.",
          "translation": "Встреча акционеров состоялась.",
          "source": "Tatoeba #10849818 @dnnywld / #578203 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849818",
          "cefr_level": "A1",
          "word_slugs": [
            "assemblea-noun"
          ]
        },
        {
          "id": "5564150",
          "text": "L'assemblea generale cominciò alle nove in punto del mattino.",
          "translation": "Общее собрание началось ровно в девять утра.",
          "source": "Tatoeba #5564150 @dnnywld / #5563988 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5564150",
          "cefr_level": "A1",
          "word_slugs": [
            "assemblea-noun"
          ]
        }
