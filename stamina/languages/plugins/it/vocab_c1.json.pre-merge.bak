    {
      "slug": "andavi-verb",
      "lemma": "andavi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8644,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6050302",
          "text": "Andavi spesso lì?",
          "translation": "Ты часто туда ходил?",
          "source": "Tatoeba #6050302 @dnnywld / #5008298 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6050302",
          "cefr_level": "A1",
          "word_slugs": [
            "andavi-verb"
          ]
        },
        {
          "id": "12391158",
          "text": "Ci andavi spesso?",
          "translation": "Ты часто туда ездил?",
          "source": "Tatoeba #12391158 @dnnywld / #12391023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12391158",
          "cefr_level": "A1",
          "word_slugs": [
            "andavi-verb"
          ]
        },
        {
          "id": "5577788",
          "text": "Io andavo nella stessa scuola dove andavi tu.",
          "translation": "Я ходил в ту же школу, что и ты.",
          "source": "Tatoeba #5577788 @dnnywld / #2677763 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5577788",
          "cefr_level": "A1",
          "word_slugs": [
            "andavi-verb"
          ]
        },
        {
          "id": "4401321",
          "text": "Secondo la polizia stradale, tu andavi con la motocicletta troppo velocemente.",
          "translation": "По данным дорожной полиции, ты ехал на мотоцикле слишком быстро.",
          "source": "Tatoeba #4401321 @aldolit58 / #4401573 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4401321",
          "cefr_level": "A1",
          "word_slugs": [
            "andavi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "andavi",
        "plural": "",
        "infinitive": "andavi"
      }
    },
