          ]
        },
        {
          "id": "5889103",
          "text": "Camminate lentamente, io vi raggiungo.",
          "translation": "Идите не спеша, я вас догоню.",
          "source": "Tatoeba #5889103 @dnnywld / #5888969 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889103",
          "cefr_level": "A1",
          "word_slugs": [
            "raggiungo-verb"
          ]
        },
        {
          "id": "7677233",
          "text": "Non raggiungo lo scaffale più alto.",
          "translation": "Я не дотягиваюсь до верхней полки.",
          "source": "Tatoeba #7677233 @dnnywld / #7676796 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7677233",
          "cefr_level": "A1",
          "word_slugs": [
