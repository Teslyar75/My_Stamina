    {
      "slug": "sequenza-noun",
      "lemma": "sequenza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6488,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5982415",
          "text": "La vita è una sequenza di decisioni.",
          "translation": "Жизнь - это последовательность решений.",
          "source": "Tatoeba #5982415 @dnnywld / #5982174 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5982415",
          "cefr_level": "A1",
          "word_slugs": [
            "sequenza-noun"
          ]
        },
        {
          "id": "13284473",
          "text": "Un algoritmo è una sequenza finita di istruzioni.",
          "translation": "Алгоритм — конечная последовательность инструкций.",
          "source": "Tatoeba #13284473 @dnnywld / #13220901 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13284473",
          "cefr_level": "A1",
          "word_slugs": [
            "sequenza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la sequenza",
        "plural": "",
