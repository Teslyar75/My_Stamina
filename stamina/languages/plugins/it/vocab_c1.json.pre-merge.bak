    {
      "slug": "indossando-verb",
      "lemma": "indossando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7899,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3395687",
          "text": "Cosa sta indossando Tom?",
          "translation": "Во что Том одет?",
          "source": "Tatoeba #3395687 @Guybrush88 / #4918833 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3395687",
          "cefr_level": "A1",
          "word_slugs": [
            "indossando-verb"
          ]
        },
        {
          "id": "3258338",
          "text": "Stava indossando degli occhiali.",
          "translation": "На нём были очки.",
          "source": "Tatoeba #3258338 @Guybrush88 / #3258335 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3258338",
          "cefr_level": "A1",
          "word_slugs": [
            "indossando-verb"
          ]
        },
        {
          "id": "6863859",
          "text": "Tom sta indossando dei sandali.",
          "translation": "Том в сандалиях.",
          "source": "Tatoeba #6863859 @Guybrush88 / #6884120 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6863859",
          "cefr_level": "A1",
          "word_slugs": [
            "indossando-verb"
          ]
        },
        {
          "id": "3673547",
          "text": "Sto indossando un orologio costoso.",
          "translation": "Я ношу дорогие часы.",
          "source": "Tatoeba #3673547 @Guybrush88 / #5537031 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3673547",
          "cefr_level": "A1",
          "word_slugs": [
            "indossando-verb"
          ]
        },
        {
          "id": "5923881",
          "text": "Adesso sto indossando una parrucca.",
          "translation": "Сейчас я ношу парик.",
          "source": "Tatoeba #5923881 @dnnywld / #5923846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5923881",
          "cefr_level": "A1",
          "word_slugs": [
            "indossando-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "indossando",
        "plural": "",
        "infinitive": "indossando"
      }
