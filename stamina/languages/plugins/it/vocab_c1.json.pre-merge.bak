            "avvelenato-adj"
          ]
        },
        {
          "id": "5902825",
          "text": "Mi sono avvelenato accidentalmente.",
          "translation": "Я случайно отравился.",
          "source": "Tatoeba #5902825 @dnnywld / #5902804 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5902825",
          "cefr_level": "A1",
          "word_slugs": [
