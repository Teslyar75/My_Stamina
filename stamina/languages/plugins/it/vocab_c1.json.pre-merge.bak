    {
      "slug": "grotta-noun",
      "lemma": "grotta",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8353,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5653512",
          "text": "Vorrei veramente esplorare questa grotta.",
          "translation": "Я бы правда хотел осмотреть эту пещеру.",
          "source": "Tatoeba #5653512 @dnnywld / #5653368 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5653512",
          "cefr_level": "A1",
          "word_slugs": [
            "grotta-noun"
          ]
        },
        {
          "id": "5410466",
          "text": "Tom ha esplorato la grotta marina.",
          "translation": "Том исследовал подводную пещеру.",
          "source": "Tatoeba #5410466 @dnnywld / #5409963 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5410466",
          "cefr_level": "A1",
          "word_slugs": [
            "grotta-noun"
          ]
        },
        {
          "id": "5406097",
          "text": "Nessuno è riuscito a trovare la grotta.",
          "translation": "Никто не мог найти пещеру.",
          "source": "Tatoeba #5406097 @dnnywld / #2598862 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5406097",
          "cefr_level": "A1",
          "word_slugs": [
            "grotta-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la grotta",
        "plural": "",
        "infinitive": ""
      }
