    {
      "slug": "divento-verb",
      "lemma": "divento",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6047,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5643654",
          "text": "In ottobre divento trentenne.",
          "translation": "В октябре мне исполняется тридцать.",
          "source": "Tatoeba #5643654 @dnnywld / #5642825 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643654",
          "cefr_level": "A1",
          "word_slugs": [
            "divento-verb"
          ]
        },
        {
          "id": "5835315",
          "text": "Più vecchio divento, meno mi ricordo.",
          "translation": "Чем старше я становлюсь — тем меньше я понимаю.",
          "source": "Tatoeba #5835315 @dnnywld / #2691252 @dipdowel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5835315",
          "cefr_level": "A1",
          "word_slugs": [
            "divento-verb"
          ]
        },
        {
          "id": "5835314",
          "text": "Più a lungo vivo, più divento intelligente.",
          "translation": "Чем дольше я живу, тем умнее становлюсь.",
          "source": "Tatoeba #5835314 @dnnywld / #5243574 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5835314",
          "cefr_level": "A1",
          "word_slugs": [
            "divento-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
