    {
      "slug": "reagire-verb",
      "lemma": "reagire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7015,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2468586",
          "text": "Dobbiamo reagire rapidamente.",
          "translation": "Мы должны реагировать быстро.",
          "source": "Tatoeba #2468586 @al_ex_an_der / #2468578 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2468586",
          "cefr_level": "A1",
          "word_slugs": [
            "reagire-verb"
          ]
        },
        {
          "id": "2468554",
          "text": "Dobbiamo reagire più rapidamente.",
          "translation": "Мы должны реагировать быстрее.",
          "source": "Tatoeba #2468554 @al_ex_an_der / #2468564 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2468554",
          "cefr_level": "A1",
          "word_slugs": [
            "reagire-verb"
          ]
        },
        {
          "id": "6811146",
          "text": "Avrei doduto reagire diversamente.",
          "translation": "Мне надо было иначе отреагировать.",
          "source": "Tatoeba #6811146 @dnnywld / #6767014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6811146",
          "cefr_level": "A1",
          "word_slugs": [
            "reagire-verb"
          ]
        },
        {
          "id": "5904970",
          "text": "In qualche modo devo reagire.",
          "translation": "Мне надо как-то отреагировать.",
          "source": "Tatoeba #5904970 @dnnywld / #5904901 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5904970",
          "cefr_level": "A1",
          "word_slugs": [
            "reagire-verb"
          ]
        },
        {
          "id": "5450316",
          "text": "Non reagire d'impulso, rifletti.",
          "translation": "Не руби с плеча, подумай.",
          "source": "Tatoeba #5450316 @dnnywld / #598691 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5450316",
          "cefr_level": "A1",
          "word_slugs": [
            "reagire-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "reagire",
        "plural": "",
        "infinitive": "reagire"
      }
    },
    {
      "slug": "interessati-adj",
      "lemma": "interessati",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7016,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6611178",
          "text": "Pensavo foste interessati.",
          "translation": "Я думал, вам интересно.",
          "source": "Tatoeba #6611178 @dnnywld / #6603736 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6611178",
          "cefr_level": "A1",
          "word_slugs": [
            "interessati-adj"
          ]
        },
        {
          "id": "5411899",
          "text": "Non sono interessati a me.",
          "translation": "Они меня не интересуют.",
          "source": "Tatoeba #5411899 @dnnywld / #4073494 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5411899",
          "cefr_level": "A1",
          "word_slugs": [
            "interessati-adj"
          ]
        },
        {
          "id": "5093391",
          "text": "Tutti erano interessati alla storia.",
          "translation": "Все интересовались историей.",
          "source": "Tatoeba #5093391 @Guybrush88 / #11497146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5093391",
          "cefr_level": "A1",
          "word_slugs": [
            "interessati-adj"
          ]
        },
        {
          "id": "1618392",
          "text": "Sono molto interessati all'astronomia.",
          "translation": "Они очень интересуются астрономией.",
          "source": "Tatoeba #1618392 @hitori37 / #1363497 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1618392",
          "cefr_level": "A1",
          "word_slugs": [
            "interessati-adj"
          ]
        },
        {
          "id": "3776415",
          "text": "Siete interessati alle lingue straniere?",
          "translation": "Вы интересуетесь иностранными языками?",
          "source": "Tatoeba #3776415 @Guybrush88 / #425441 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3776415",
          "cefr_level": "A1",
          "word_slugs": [
            "interessati-adj"
          ]
        }
