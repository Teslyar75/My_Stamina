    {
      "slug": "adolescenti-noun",
      "lemma": "adolescenti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6534,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5971282",
          "text": "Perché questi adolescenti stanno ridendo?",
          "translation": "Чего эти подростки смеются?",
          "source": "Tatoeba #5971282 @dnnywld / #5969924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971282",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescenti-noun"
          ]
        },
        {
          "id": "6953126",
          "text": "La popolarità di Facebook tra gli adolescenti sta calando rapidamente.",
          "translation": "Популярность Фейсбука среди подростков стремительно падает.",
          "source": "Tatoeba #6953126 @dnnywld / #6952807 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953126",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescenti-noun"
          ]
        },
        {
          "id": "5706004",
          "text": "Intorno al fuoco siedono degli adolescenti, qualcuno sta strimpellando la chitarra.",
          "translation": "Вокруг костра сидят подростки, кто-то бренчит на гитаре.",
          "source": "Tatoeba #5706004 @dnnywld / #5705657 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5706004",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescenti-noun"
          ]
        },
        {
          "id": "3364216",
          "text": "L'omosessualità è una delle principali cause di suicidio tra gli adolescenti.",
          "translation": "Гомосексуальность — одна из основных причин самоубийств среди подростков.",
          "source": "Tatoeba #3364216 @Guybrush88 / #4945284 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3364216",
          "cefr_level": "A1",
          "word_slugs": [
            "adolescenti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il adolescenti",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "formula-noun",
      "lemma": "formula",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6535,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6879483",
          "text": "Per prima cosa, impara la formula a memoria.",
          "translation": "Первым делом, выучи формулу наизусть.",
          "source": "Tatoeba #6879483 @dnnywld / #2117951 @Elenkina (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879483",
          "cefr_level": "A1",
          "word_slugs": [
            "formula-noun"
          ]
        },
        {
          "id": "6879497",
          "text": "Prima di tutto, impara la formula a memoria.",
          "translation": "Прежде всего, выучи формулу наизусть.",
          "source": "Tatoeba #6879497 @dnnywld / #4271234 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879497",
          "cefr_level": "A1",
          "word_slugs": [
            "formula-noun"
          ]
        },
        {
          "id": "5700252",
          "text": "Qual è la formula chimica dell'acqua ossigenata?",
          "translation": "Какая химическая формула у перекиси водорода?",
          "source": "Tatoeba #5700252 @dnnywld / #5699956 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5700252",
          "cefr_level": "A1",
          "word_slugs": [
            "formula-noun"
          ]
        },
        {
          "id": "5700249",
          "text": "Qual è la formula chimica del perossido di idrogeno?",
          "translation": "Какая химическая формула у перекиси водорода?",
          "source": "Tatoeba #5700249 @dnnywld / #5699956 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5700249",
          "cefr_level": "A1",
          "word_slugs": [
            "formula-noun"
          ]
        },
        {
          "id": "5700250",
          "text": "Qual è la formula chimica per il perossido di idrogeno?",
          "translation": "Какова химическая формула перекиси водорода?",
          "source": "Tatoeba #5700250 @dnnywld / #5699958 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5700250",
          "cefr_level": "A1",
          "word_slugs": [
            "formula-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
