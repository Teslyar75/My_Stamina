    {
      "slug": "franchi-adj",
      "lemma": "franchi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7493,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5389542",
          "text": "Guadagno cinque franchi al giorno.",
          "translation": "Я получаю пять франков в день.",
          "source": "Tatoeba #5389542 @dnnywld / #5389440 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389542",
          "cefr_level": "A1",
          "word_slugs": [
            "franchi-adj"
          ]
        },
        {
          "id": "5530958",
          "text": "I Franchi si convertirono al cristianesimo.",
          "translation": "Франки приняли христианство.",
          "source": "Tatoeba #5530958 @dnnywld / #5530519 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5530958",
          "cefr_level": "A1",
          "word_slugs": [
            "franchi-adj"
          ]
        },
        {
          "id": "6896664",
          "text": "Questo orologio costa dieci mila franchi CFA.",
          "translation": "Эти часы стоят десять тысяч африканских франков.",
          "source": "Tatoeba #6896664 @dnnywld / #6895574 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6896664",
          "cefr_level": "A1",
          "word_slugs": [
            "franchi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
