    {
      "slug": "biologia-noun",
      "lemma": "biologia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9594,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10852154",
          "text": "Lui sa la biologia.",
          "translation": "Он знает биологию.",
          "source": "Tatoeba #10852154 @dnnywld / #2470459 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10852154",
          "cefr_level": "A1",
          "word_slugs": [
            "biologia-noun"
          ]
        },
        {
          "id": "6368467",
          "text": "Ho intenzione di studiare biologia.",
          "translation": "Я собираюсь изучать биологию.",
          "source": "Tatoeba #6368467 @dnnywld / #6360668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6368467",
          "cefr_level": "A1",
          "word_slugs": [
            "biologia-noun"
          ]
        },
        {
          "id": "5593314",
          "text": "Lei dà lezioni di matematica, fisica e biologia.",
          "translation": "Она ведёт математику, физику и биологию.",
          "source": "Tatoeba #5593314 @dnnywld / #5593290 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5593314",
          "cefr_level": "A1",
          "word_slugs": [
            "biologia-noun"
          ]
        },
        {
          "id": "5536634",
          "text": "La biologia è la scienza che studia la vita.",
          "translation": "Биология — это наука, изучающая жизнь.",
          "source": "Tatoeba #5536634 @dnnywld / #5535458 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5536634",
          "cefr_level": "A1",
          "word_slugs": [
            "biologia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la biologia",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "insegni-verb",
      "lemma": "insegni",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9595,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5982359",
          "text": "Voglio che insegni a Tom a guidare.",
          "translation": "Я хочу, чтобы ты поучил Тома водить.",
          "source": "Tatoeba #5982359 @dnnywld / #5982215 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5982359",
          "cefr_level": "A1",
          "word_slugs": [
            "insegni-verb"
          ]
        },
        {
          "id": "5982356",
          "text": "Voglio che insegni a Tom a guidare la macchina.",
          "translation": "Я хочу, чтобы ты научил Тома водить машину.",
          "source": "Tatoeba #5982356 @dnnywld / #5982220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5982356",
          "cefr_level": "A1",
          "word_slugs": [
            "insegni-verb"
          ]
        },
        {
          "id": "6956572",
          "text": "Mary sta cercando qualcuno che le insegni il francese.",
          "translation": "Мэри ищет кого-нибудь, кто научит её французскому.",
          "source": "Tatoeba #6956572 @dnnywld / #6956308 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6956572",
          "cefr_level": "A1",
          "word_slugs": [
            "insegni-verb"
          ]
        }
      ],
      "tags": [
