    {
      "slug": "schiavo-adj",
      "lemma": "schiavo",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5891,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1546065",
          "text": "Lavoro come uno schiavo!",
          "translation": "Я работаю как раб!",
          "source": "Tatoeba #1546065 @Guybrush88 / #3689084 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1546065",
          "cefr_level": "A1",
          "word_slugs": [
            "schiavo-adj"
          ]
        },
        {
          "id": "5565798",
          "text": "Non sono il tuo schiavo.",
          "translation": "Я тебе не раб.",
          "source": "Tatoeba #5565798 @dnnywld / #5565179 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5565798",
          "cefr_level": "A1",
          "word_slugs": [
            "schiavo-adj"
          ]
        },
        {
          "id": "5565799",
          "text": "Non sono il vostro schiavo.",
          "translation": "Я вам не раб.",
          "source": "Tatoeba #5565799 @dnnywld / #5565180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5565799",
          "cefr_level": "A1",
          "word_slugs": [
            "schiavo-adj"
          ]
        },
        {
          "id": "10887209",
          "text": "Lo schiavo cercò di fuggire.",
          "translation": "Раб пытался бежать.",
          "source": "Tatoeba #10887209 @dnnywld / #10885961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10887209",
          "cefr_level": "A1",
          "word_slugs": [
            "schiavo-adj"
          ]
        },
        {
          "id": "12870559",
          "text": "Sii il padrone della tua volontà, ma lo schiavo della tua coscienza.",
          "translation": "Будь воли своей хозяином, совести же своей - рабом.",
          "source": "Tatoeba #12870559 @Bernie75 / #2521056 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12870559",
          "cefr_level": "A1",
          "word_slugs": [
            "schiavo-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il schiavo",
        "plural": "",
        "infinitive": ""
      }
