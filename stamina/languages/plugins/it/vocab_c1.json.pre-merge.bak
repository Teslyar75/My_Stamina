    {
      "slug": "organizzando-verb",
      "lemma": "organizzando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7216,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6963808",
          "text": "Tom stava organizzando una festa.",
          "translation": "Том планировал устроить вечеринку.",
          "source": "Tatoeba #6963808 @dnnywld / #6963016 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6963808",
          "cefr_level": "A1",
          "word_slugs": [
            "organizzando-verb"
          ]
        },
        {
          "id": "10867109",
          "text": "E tu cosa, stai organizzando un fuoco?",
          "translation": "Ты что, пожар устроишь!",
          "source": "Tatoeba #10867109 @dnnywld / #10865272 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10867109",
          "cefr_level": "A1",
          "word_slugs": [
            "organizzando-verb"
          ]
        },
        {
          "id": "10867107",
          "text": "E voi cosa, state organizzando un fuoco?",
          "translation": "Вы что, пожар устроите!",
          "source": "Tatoeba #10867107 @dnnywld / #10865273 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10867107",
          "cefr_level": "A1",
          "word_slugs": [
            "organizzando-verb"
          ]
        }
      ],
      "tags": [
