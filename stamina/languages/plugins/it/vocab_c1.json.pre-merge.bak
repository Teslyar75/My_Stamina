    {
      "slug": "toro-noun",
      "lemma": "toro",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5885,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "Бык"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1662826",
          "text": "Il toro sta muggendo.",
          "translation": "Бык мычит.",
          "source": "Tatoeba #1662826 @Guybrush88 / #2335237 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1662826",
          "cefr_level": "A1",
          "word_slugs": [
            "toro-noun"
          ]
        },
        {
          "id": "2833313",
          "text": "Un toro è maschio e una vacca è femmina.",
          "translation": "Бык мужского пола, а корова - женского.",
          "source": "Tatoeba #2833313 @Guybrush88 / #4592733 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2833313",
          "cefr_level": "A1",
          "word_slugs": [
            "toro-noun"
          ]
        },
        {
          "id": "2833314",
          "text": "Un toro è maschio e una mucca è femmina.",
          "translation": "Бык мужского пола, а корова - женского.",
          "source": "Tatoeba #2833314 @Guybrush88 / #4592733 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2833314",
          "cefr_level": "A1",
          "word_slugs": [
            "toro-noun"
          ]
        },
        {
          "id": "6946037",
          "text": "Sul prato pascolano un toro, una mucca e un vitello.",
          "translation": "На лугу пасутся бык, корова и телёнок.",
          "source": "Tatoeba #6946037 @dnnywld / #6945632 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6946037",
          "cefr_level": "A1",
          "word_slugs": [
            "toro-noun"
          ]
        },
        {
          "id": "1005932",
          "text": "La lettera A deriva da un antichissimo pittogramma raffigurante un toro.",
          "translation": "Буква А развилась из древнейшей пиктограммы, обозначавшей быка.",
          "source": "Tatoeba #1005932 @riccioberto / #1005938 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1005932",
          "cefr_level": "A1",
          "word_slugs": [
            "toro-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il toro",
        "plural": "",
        "infinitive": ""
      }
    },
