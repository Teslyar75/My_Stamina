    {
      "slug": "lavandino-noun",
      "lemma": "lavandino",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8800,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6136478",
          "text": "Puoi aggiustarmi il lavandino?",
          "translation": "Можешь починить мне раковину?",
          "source": "Tatoeba #6136478 @dnnywld / #6136325 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6136478",
          "cefr_level": "A1",
          "word_slugs": [
            "lavandino-noun"
          ]
        },
        {
          "id": "6301957",
          "text": "Lascio spesso i piatti sporchi nel lavandino.",
          "translation": "Я часто оставляю в раковине грязную посуду.",
          "source": "Tatoeba #6301957 @dnnywld / #6301563 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6301957",
          "cefr_level": "A1",
          "word_slugs": [
            "lavandino-noun"
          ]
        },
        {
          "id": "5507822",
          "text": "Lei ha messo i piatti sporchi nel lavandino.",
          "translation": "Она положила грязную посуду в раковину.",
          "source": "Tatoeba #5507822 @dnnywld / #5507385 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507822",
          "cefr_level": "A1",
          "word_slugs": [
            "lavandino-noun"
          ]
        },
        {
          "id": "4720146",
          "text": "Tom lascia spesso i piatti sporchi nel lavandino.",
          "translation": "Том часто оставляет в раковине грязную посуду.",
          "source": "Tatoeba #4720146 @Guybrush88 / #4721074 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4720146",
          "cefr_level": "A1",
          "word_slugs": [
            "lavandino-noun"
          ]
        },
        {
          "id": "4720147",
          "text": "Tom lascia spesso dei piatti sporchi nel lavandino.",
          "translation": "Том часто оставляет грязную посуду в раковине.",
          "source": "Tatoeba #4720147 @Guybrush88 / #1601350 @mutternoise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4720147",
          "cefr_level": "A1",
          "word_slugs": [
            "lavandino-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
