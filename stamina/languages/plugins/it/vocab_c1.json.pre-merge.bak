          ]
        },
        {
          "id": "5423808",
          "text": "Per favore, non toccate i fiori.",
          "translation": "Пожалуйста, не трогайте цветы.",
          "source": "Tatoeba #5423808 @dnnywld / #4970445 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5423808",
          "cefr_level": "A1",
          "word_slugs": [
            "toccate-noun"
          ]
        },
        {
          "id": "5507085",
          "text": "Non toccate mai più questa bottiglia!",
          "translation": "Никогда больше не трогайте эту бутылочку!",
          "source": "Tatoeba #5507085 @dnnywld / #378101 @Dorenda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507085",
          "cefr_level": "A1",
          "word_slugs": [
            "toccate-noun"
          ]
        }
      ],
      "tags": [
