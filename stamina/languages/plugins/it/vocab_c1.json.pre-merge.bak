    {
      "slug": "dente-noun",
      "lemma": "dente",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5847,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "зуб"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5540393",
          "text": "Questo dente va otturato.",
          "translation": "На этот зуб нужно поставить пломбу.",
          "source": "Tatoeba #5540393 @dnnywld / #5540242 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5540393",
          "cefr_level": "A1",
          "word_slugs": [
            "dente-noun"
          ]
        },
        {
          "id": "1096695",
          "text": "Mi fa male un dente.",
          "translation": "У меня болит зуб.",
          "source": "Tatoeba #1096695 @Guybrush88 / #831924 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1096695",
          "cefr_level": "A1",
          "word_slugs": [
            "dente-noun"
          ]
        },
        {
          "id": "4386618",
          "text": "Questo dente è un incisivo.",
          "translation": "Этот зуб называется резец.",
          "source": "Tatoeba #4386618 @Guybrush88 / #4386537 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4386618",
          "cefr_level": "A1",
          "word_slugs": [
            "dente-noun"
          ]
        },
        {
          "id": "6785978",
          "text": "Ieri mi hanno estratto un dente.",
          "translation": "Мне вчера вырвали зуб.",
          "source": "Tatoeba #6785978 @dnnywld / #6785798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6785978",
          "cefr_level": "A1",
          "word_slugs": [
            "dente-noun"
          ]
        },
        {
          "id": "6890820",
          "text": "Il dente faceva male in maniera incredibile.",
          "translation": "Зуб болел неимоверно.",
          "source": "Tatoeba #6890820 @dnnywld / #2078801 @Lathean (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890820",
          "cefr_level": "A1",
          "word_slugs": [
            "dente-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
