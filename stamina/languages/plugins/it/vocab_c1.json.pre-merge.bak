    {
      "slug": "bollente-adj",
      "lemma": "bollente",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6373,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5556613",
          "text": "MI piace il caffè bollente.",
          "translation": "Кофе я люблю горячим.",
          "source": "Tatoeba #5556613 @dnnywld / #5556316 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5556613",
          "cefr_level": "A1",
          "word_slugs": [
            "bollente-adj"
          ]
        },
        {
          "id": "11860530",
          "text": "Voglio mangiare una minestra bollente.",
          "translation": "Я хочу поесть горячего супа.",
          "source": "Tatoeba #11860530 @dnnywld / #11859793 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11860530",
          "cefr_level": "A1",
          "word_slugs": [
            "bollente-adj"
          ]
        },
        {
          "id": "10808811",
          "text": "Abbiate la bontà, un tè bollente.",
          "translation": "Будьте добры, горячего чая.",
          "source": "Tatoeba #10808811 @dnnywld / #10808784 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10808811",
          "cefr_level": "A1",
          "word_slugs": [
            "bollente-adj"
          ]
        },
        {
          "id": "7038317",
          "text": "Vorrei del tè bollente, per favore.",
          "translation": "Я бы хотел горячего чая, пожалуйста.",
          "source": "Tatoeba #7038317 @dnnywld / #7037193 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7038317",
          "cefr_level": "A1",
          "word_slugs": [
            "bollente-adj"
          ]
        },
        {
          "id": "5733484",
          "text": "Tom si è scottato con l'acqua bollente.",
          "translation": "Том ошпарился кипятком.",
          "source": "Tatoeba #5733484 @dnnywld / #5733313 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5733484",
          "cefr_level": "A1",
          "word_slugs": [
            "bollente-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
