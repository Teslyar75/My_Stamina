        {
          "id": "4336162",
          "text": "Che sensazioni avete?",
          "translation": "Что вы чувствуете?",
          "source": "Tatoeba #4336162 @Guybrush88 / #3503941 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4336162",
          "cefr_level": "A1",
          "word_slugs": [
            "sensazioni-noun"
          ]
        },
        {
          "id": "10841405",
          "text": "Alcune sensazioni sono difficili da descrivere con le parole.",
          "translation": "Некоторые чувства трудно описать словами.",
          "source": "Tatoeba #10841405 @dnnywld / #3714312 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10841405",
          "cefr_level": "A1",
          "word_slugs": [
            "sensazioni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
