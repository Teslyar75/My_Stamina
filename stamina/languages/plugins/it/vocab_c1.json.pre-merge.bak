    {
      "slug": "pericolose-adj",
      "lemma": "pericolose",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7969,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10851075",
          "text": "Furia ed avarizia sono pericolose.",
          "translation": "Ярость и алчность опасны.",
          "source": "Tatoeba #10851075 @dnnywld / #3950805 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851075",
          "cefr_level": "A1",
          "word_slugs": [
            "pericolose-adj"
          ]
        },
        {
          "id": "5455894",
          "text": "Alcune donne sono molto pericolose.",
          "translation": "Некоторые женщины очень опасны.",
          "source": "Tatoeba #5455894 @dnnywld / #5455847 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5455894",
          "cefr_level": "A1",
          "word_slugs": [
            "pericolose-adj"
          ]
        },
        {
          "id": "1871639",
          "text": "Ma sono pericolose per la salute queste cose?",
          "translation": "Разве это не опасно для здоровья?",
          "source": "Tatoeba #1871639 @Guybrush88 / #1872161 @sixtynine (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1871639",
          "cefr_level": "A1",
          "word_slugs": [
            "pericolose-adj"
          ]
        },
        {
          "id": "10854565",
          "text": "Le verruche non sono belle ma non sono pericolose.",
          "translation": "Бородавки некрасивы, но безопасны.",
          "source": "Tatoeba #10854565 @dnnywld / #2841683 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854565",
          "cefr_level": "A1",
          "word_slugs": [
            "pericolose-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
