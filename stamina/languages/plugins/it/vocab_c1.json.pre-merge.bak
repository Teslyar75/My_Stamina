    {
      "slug": "sedersi-verb",
      "lemma": "sedersi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6121,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5695343",
          "text": "Per me fa lo stesso dove sedersi.",
          "translation": "Мне всё равно, где сидеть.",
          "source": "Tatoeba #5695343 @dnnywld / #5695285 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5695343",
          "cefr_level": "A1",
          "word_slugs": [
            "sedersi-verb"
          ]
        },
        {
          "id": "5647868",
          "text": "È molto scomodo sedersi su questo divano.",
          "translation": "На этом диване сидеть очень неудобно.",
          "source": "Tatoeba #5647868 @dnnywld / #5647687 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647868",
          "cefr_level": "A1",
          "word_slugs": [
            "sedersi-verb"
          ]
        },
        {
          "id": "5620053",
          "text": "Lui ha l'abitudine di sedersi in ritardo.",
          "translation": "Он привык сидеть допоздна.",
          "source": "Tatoeba #5620053 @dnnywld / #422466 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5620053",
          "cefr_level": "A1",
          "word_slugs": [
            "sedersi-verb"
          ]
        },
        {
          "id": "5665566",
          "text": "Sedersi con le braccia incrociate significa perdere tempo.",
          "translation": "Сидеть сложа руки — значит потерять время.",
          "source": "Tatoeba #5665566 @dnnywld / #5665474 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5665566",
          "cefr_level": "A1",
          "word_slugs": [
            "sedersi-verb"
          ]
        },
        {
          "id": "5412063",
          "text": "Tom con un gesto indicò a Mary di sedersi.",
          "translation": "Фома жестом показал Маше сесть.",
          "source": "Tatoeba #5412063 @dnnywld / #4148216 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5412063",
          "cefr_level": "A1",
          "word_slugs": [
            "sedersi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sedersi",
        "plural": "",
        "infinitive": "sedersi"
      }
    },
    {
      "slug": "note-adj",
      "lemma": "note",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6122,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10878773",
          "text": "Lascia questa casella per le note.",
          "translation": "Эту графу оставь для примечаний.",
          "source": "Tatoeba #10878773 @dnnywld / #5908527 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878773",
          "cefr_level": "A1",
          "word_slugs": [
            "note-adj"
          ]
        },
        {
          "id": "6003239",
          "text": "Lui sta scrivendo note sui suoi appunti.",
          "translation": "Он делает пометки в своих записях.",
          "source": "Tatoeba #6003239 @dnnywld / #6003074 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6003239",
          "cefr_level": "A1",
          "word_slugs": [
            "note-adj"
          ]
        },
        {
          "id": "6292746",
          "text": "Tom ha annotato qualcosa sul suo blocco note.",
          "translation": "Том что-то нацарапал у себя в блокноте.",
          "source": "Tatoeba #6292746 @dnnywld / #6291546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6292746",
          "cefr_level": "A1",
          "word_slugs": [
            "note-adj"
          ]
        },
        {
          "id": "6162548",
          "text": "Ascolto con attenzione e prendo appunti sul blocco note.",
          "translation": "Я внимательно слушаю и делаю пометки в блокноте.",
          "source": "Tatoeba #6162548 @dnnywld / #6162520 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6162548",
          "cefr_level": "A1",
          "word_slugs": [
            "note-adj"
          ]
        },
        {
          "id": "7023907",
          "text": "Sulle prime note della musica, Tom si mise a ballare.",
          "translation": "При первых звуках музыки Том пустился в пляс.",
          "source": "Tatoeba #7023907 @dnnywld / #7022709 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7023907",
          "cefr_level": "A1",
          "word_slugs": [
            "note-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il note",
        "plural": "",
        "infinitive": ""
      }
    },
