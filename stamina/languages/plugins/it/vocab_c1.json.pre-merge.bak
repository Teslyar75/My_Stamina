    {
      "slug": "nodo-noun",
      "lemma": "nodo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9771,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "узел"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5508675",
          "text": "Tom ha stretto il nodo.",
          "translation": "Том затянул узел.",
          "source": "Tatoeba #5508675 @dnnywld / #5508609 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5508675",
          "cefr_level": "A1",
          "word_slugs": [
            "nodo-noun"
          ]
        },
        {
          "id": "6326066",
          "text": "Sai farti il nodo alla cravatta?",
          "translation": "Ты умеешь завязывать галстук?",
          "source": "Tatoeba #6326066 @dnnywld / #6325751 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326066",
          "cefr_level": "A1",
          "word_slugs": [
            "nodo-noun"
          ]
        },
        {
          "id": "6326064",
          "text": "Sapete farvi il nodo alla cravatta?",
          "translation": "Вы умеете завязывать галстук?",
          "source": "Tatoeba #6326064 @dnnywld / #6325752 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326064",
          "cefr_level": "A1",
          "word_slugs": [
            "nodo-noun"
          ]
        },
        {
          "id": "6904800",
          "text": "Tom ha sentito un nodo in gola.",
          "translation": "Том почувствовал ком в горле.",
          "source": "Tatoeba #6904800 @dnnywld / #4021247 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904800",
          "cefr_level": "A1",
          "word_slugs": [
            "nodo-noun"
          ]
        },
        {
          "id": "6326061",
          "text": "Non sono mai stato capace di farmi il nodo alla cravatta.",
          "translation": "Я никогда не умел завязывать галстук.",
          "source": "Tatoeba #6326061 @dnnywld / #6325753 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326061",
          "cefr_level": "A1",
          "word_slugs": [
            "nodo-noun"
          ]
