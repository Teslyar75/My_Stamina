    {
      "slug": "agitato-adj",
      "lemma": "agitato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6759,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5568759",
          "text": "Tom ha dormito agitato.",
          "translation": "Том спал беспокойно.",
          "source": "Tatoeba #5568759 @dnnywld / #5567922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5568759",
          "cefr_level": "A1",
          "word_slugs": [
            "agitato-adj"
          ]
        },
        {
          "id": "5804585",
          "text": "Perché sei così agitato?",
          "translation": "Ты чего так разволновался?",
          "source": "Tatoeba #5804585 @dnnywld / #5803572 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5804585",
          "cefr_level": "A1",
          "word_slugs": [
            "agitato-adj"
          ]
        },
        {
          "id": "5904981",
          "text": "Mi sono parecchio agitato.",
          "translation": "Я очень разволновался.",
          "source": "Tatoeba #5904981 @dnnywld / #5904898 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5904981",
          "cefr_level": "A1",
          "word_slugs": [
            "agitato-adj"
          ]
        },
        {
          "id": "5512973",
          "text": "Oggi il mare è agitato.",
          "translation": "Сегодня на море неспокойно.",
          "source": "Tatoeba #5512973 @dnnywld / #5512518 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512973",
          "cefr_level": "A1",
          "word_slugs": [
            "agitato-adj"
          ]
        },
        {
          "id": "5502712",
          "text": "Tom ha agitato la mano in segno di addio.",
          "translation": "Том помахал мне рукой на прощанье.",
          "source": "Tatoeba #5502712 @dnnywld / #5501895 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5502712",
          "cefr_level": "A1",
          "word_slugs": [
            "agitato-adj"
          ]
        }
      ],
      "tags": [
