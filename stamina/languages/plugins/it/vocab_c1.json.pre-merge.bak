    {
      "slug": "stranieri-adj",
      "lemma": "stranieri",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6185,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5777539",
          "text": "Gli stranieri qui non girano.",
          "translation": "Чужие здесь не ходят.",
          "source": "Tatoeba #5777539 @dnnywld / #5777521 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5777539",
          "cefr_level": "A1",
          "word_slugs": [
            "stranieri-adj"
          ]
        },
        {
          "id": "350354",
          "text": "Non prendere in giro gli stranieri.",
          "translation": "Не смейся над иностранцами.",
          "source": "Tatoeba #350354 @martin / #469966 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350354",
          "cefr_level": "A1",
          "word_slugs": [
            "stranieri-adj"
          ]
        },
        {
          "id": "10959616",
          "text": "Agli stranieri era proibito entrare nel tempio.",
          "translation": "Иностранцам было запрещено входить в храм.",
          "source": "Tatoeba #10959616 @dnnywld / #10958188 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10959616",
          "cefr_level": "A1",
          "word_slugs": [
            "stranieri-adj"
          ]
        },
        {
          "id": "6940773",
          "text": "Loro sono stranieri e non capiscono il russo.",
          "translation": "Они иностранцы и не понимают по-русски.",
          "source": "Tatoeba #6940773 @dnnywld / #6940406 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6940773",
          "cefr_level": "A1",
          "word_slugs": [
            "stranieri-adj"
          ]
        },
        {
          "id": "5620607",
          "text": "Tom è abituato a conversare con gli stranieri.",
          "translation": "Том привык общаться с иностранцами.",
          "source": "Tatoeba #5620607 @dnnywld / #4910222 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5620607",
          "cefr_level": "A1",
          "word_slugs": [
            "stranieri-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il stranieri",
        "plural": "",
        "infinitive": ""
      }
    },
