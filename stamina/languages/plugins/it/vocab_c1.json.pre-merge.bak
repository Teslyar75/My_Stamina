    {
      "slug": "chiederò-verb",
      "lemma": "chiederò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5929,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5419120",
          "text": "A chi chiederò?",
          "translation": "Кого мне попросить?",
          "source": "Tatoeba #5419120 @dnnywld / #5418235 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419120",
          "cefr_level": "A1",
          "word_slugs": [
            "chiederò-verb"
          ]
        },
        {
          "id": "6363508",
          "text": "Non chiederò aiuto.",
          "translation": "Я не буду просить помощи.",
          "source": "Tatoeba #6363508 @dnnywld / #6363068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6363508",
          "cefr_level": "A1",
          "word_slugs": [
            "chiederò-verb"
          ]
        },
        {
          "id": "947742",
          "text": "Glielo chiederò domani.",
          "translation": "Завтра я его спрошу.",
          "source": "Tatoeba #947742 @Guybrush88 / #6153957 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/947742",
          "cefr_level": "A1",
          "word_slugs": [
            "chiederò-verb"
          ]
        },
        {
          "id": "6824355",
          "text": "Non lo chiederò più.",
          "translation": "Я больше просить не буду.",
          "source": "Tatoeba #6824355 @dnnywld / #5612595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6824355",
          "cefr_level": "A1",
          "word_slugs": [
            "chiederò-verb"
          ]
        },
        {
          "id": "5607494",
          "text": "Se verrà glielo chiederò.",
          "translation": "Если он придёт, я спрошу его.",
          "source": "Tatoeba #5607494 @dnnywld / #5606280 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607494",
          "cefr_level": "A1",
          "word_slugs": [
            "chiederò-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "chiederò",
        "plural": "",
        "infinitive": "chiederò"
      }
    },
    {
      "slug": "fidarsi-verb",
      "lemma": "fidarsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5930,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "11460590",
          "text": "Fidarsi... ma verificare.",
          "translation": "Доверяй, но проверяй.",
          "source": "Tatoeba #11460590 @Bernie75 / #1745041 @zalaim (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11460590",
          "cefr_level": "A1",
          "word_slugs": [
            "fidarsi-verb"
          ]
        },
        {
          "id": "1444848",
          "text": "Deve fidarsi di me.",
          "translation": "Вы должны довериться мне.",
          "source": "Tatoeba #1444848 @Guybrush88 / #10136246 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1444848",
          "cefr_level": "A1",
          "word_slugs": [
            "fidarsi-verb"
          ]
        },
        {
          "id": "5471979",
          "text": "Mai fidarsi delle voci!",
          "translation": "Нельзя доверять слухам!",
          "source": "Tatoeba #5471979 @dnnywld / #2157428 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5471979",
          "cefr_level": "A1",
          "word_slugs": [
            "fidarsi-verb"
          ]
        },
        {
          "id": "6920966",
          "text": "Tom è l'unico di cui Mary può fidarsi.",
          "translation": "Том — единственный, кому Мэри может доверять.",
          "source": "Tatoeba #6920966 @dnnywld / #4241446 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6920966",
          "cefr_level": "A1",
          "word_slugs": [
            "fidarsi-verb"
          ]
        },
        {
          "id": "5620595",
          "text": "Tom ha l'abitudine di fidarsi del suo intuito.",
          "translation": "Том привык доверять своей интуиции.",
          "source": "Tatoeba #5620595 @dnnywld / #4428892 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5620595",
          "cefr_level": "A1",
          "word_slugs": [
            "fidarsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "fidarsi",
        "plural": "",
        "infinitive": "fidarsi"
      }
    },
