    {
      "slug": "nasce-verb",
      "lemma": "nasce",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8480,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4894649",
          "text": "Nessuno nasce maestro.",
          "translation": "Никто не рождается мастером.",
          "source": "Tatoeba #4894649 @Balamax / #5661662 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4894649",
          "cefr_level": "A1",
          "word_slugs": [
            "nasce-verb"
          ]
        },
        {
          "id": "5387041",
          "text": "Soldati non si nasce.",
          "translation": "Солдатами не рождаются.",
          "source": "Tatoeba #5387041 @dnnywld / #5387030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387041",
          "cefr_level": "A1",
          "word_slugs": [
            "nasce-verb"
          ]
        },
        {
          "id": "6872121",
          "text": "Nessuno nasce in autonomia.",
          "translation": "Никто не рождается сам по себе.",
          "source": "Tatoeba #6872121 @dnnywld / #3995741 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6872121",
          "cefr_level": "A1",
          "word_slugs": [
            "nasce-verb"
          ]
        },
        {
          "id": "3146371",
          "text": "Nessuna donna nasce prostituta.",
          "translation": "Ни одна женщина не рождается проституткой.",
          "source": "Tatoeba #3146371 @Guybrush88 / #3715747 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3146371",
          "cefr_level": "A1",
          "word_slugs": [
            "nasce-verb"
          ]
        },
        {
          "id": "5387040",
          "text": "Soldati non si nasce, soldati si diventa.",
          "translation": "Солдатами не рождаются, солдатами становятся.",
          "source": "Tatoeba #5387040 @dnnywld / #5387032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387040",
          "cefr_level": "A1",
          "word_slugs": [
            "nasce-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "nasce",
        "plural": "",
        "infinitive": "nasce"
      }
    },
    {
      "slug": "diciotto-adj",
      "lemma": "diciotto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8481,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "восемнадцать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5650567",
          "text": "Il defunto aveva diciotto anni.",
          "translation": "Покойному было восемнадцать лет.",
          "source": "Tatoeba #5650567 @dnnywld / #5649741 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650567",
          "cefr_level": "A1",
          "word_slugs": [
            "diciotto-adj"
          ]
        },
        {
          "id": "622285",
          "text": "Quattro più diciotto fa ventidue.",
          "translation": "Четыре плюс восемнадцать будет двадцать два.",
          "source": "Tatoeba #622285 @rado / #827884 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/622285",
          "cefr_level": "A1",
          "word_slugs": [
            "diciotto-adj"
          ]
        },
        {
          "id": "2155806",
          "text": "Sommando quattro a diciotto si ottiene ventidue.",
          "translation": "Четыре плюс восемнадцать будет двадцать два.",
          "source": "Tatoeba #2155806 @marioparcia / #827884 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2155806",
          "cefr_level": "A1",
          "word_slugs": [
            "diciotto-adj"
          ]
        },
        {
          "id": "12016265",
          "text": "Fino ai diciotto anni sono responsabile per te.",
          "translation": "Пока тебе нет восемнадцати, я несу за тебя ответственность.",
          "source": "Tatoeba #12016265 @carlosalberto / #11516170 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12016265",
          "cefr_level": "A1",
          "word_slugs": [
            "diciotto-adj"
          ]
        },
        {
          "id": "6893906",
          "text": "Scrivi: sedici, zero cinque, del duemila e diciotto.",
          "translation": "Пиши: шестнадцатое, ноль пятое, две тысячи восемнадцатый.",
          "source": "Tatoeba #6893906 @dnnywld / #6893169 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893906",
          "cefr_level": "A1",
          "word_slugs": [
            "diciotto-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "diciotto",
        "plural": "",
        "infinitive": ""
      }
    },
