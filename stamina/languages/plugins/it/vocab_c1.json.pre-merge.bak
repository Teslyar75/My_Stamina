    {
      "slug": "farina-noun",
      "lemma": "farina",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8955,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7870149",
          "text": "Mi serve della farina.",
          "translation": "Мне нужна мука.",
          "source": "Tatoeba #7870149 @dnnywld / #7869779 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7870149",
          "cefr_level": "A1",
          "word_slugs": [
            "farina-noun"
          ]
        },
        {
          "id": "7870150",
          "text": "Quale farina serve per questo?",
          "translation": "Какая мука для этого нужна?",
          "source": "Tatoeba #7870150 @dnnywld / #7869778 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7870150",
          "cefr_level": "A1",
          "word_slugs": [
            "farina-noun"
          ]
        },
        {
          "id": "5845492",
          "text": "Dalla farina si ottiene il pane.",
          "translation": "Из муки получается хлеб.",
          "source": "Tatoeba #5845492 @dnnywld / #5180179 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845492",
          "cefr_level": "A1",
          "word_slugs": [
            "farina-noun"
          ]
        },
        {
          "id": "6385593",
          "text": "Il pane si fa con la farina.",
          "translation": "Хлеб делается из муки.",
          "source": "Tatoeba #6385593 @dnnywld / #6385291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6385593",
          "cefr_level": "A1",
          "word_slugs": [
            "farina-noun"
          ]
        },
        {
          "id": "7870148",
          "text": "C'è della farina da qualche parte?",
          "translation": "Где-нибудь есть мука?",
          "source": "Tatoeba #7870148 @dnnywld / #7869780 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7870148",
          "cefr_level": "A1",
          "word_slugs": [
            "farina-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la farina",
        "plural": "",
        "infinitive": ""
      }
