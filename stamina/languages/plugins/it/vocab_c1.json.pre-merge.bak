          ]
        },
        {
          "id": "4467793",
          "text": "I ragni hanno otto zampe e otto occhi.",
          "translation": "У пауков восемь лап и восемь глаз.",
          "source": "Tatoeba #4467793 @Guybrush88 / #5276497 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4467793",
          "cefr_level": "A1",
          "word_slugs": [
            "zampe-noun"
          ]
        },
        {
          "id": "6637643",
          "text": "Perché il gatto ti calpesta con le zampe?",
          "translation": "Почему кошка топчет тебя лапками?",
          "source": "Tatoeba #6637643 @dnnywld / #6634702 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6637643",
          "cefr_level": "A1",
          "word_slugs": [
            "zampe-noun"
          ]
        }
      ],
