    {
      "slug": "foglie-noun",
      "lemma": "foglie",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6061,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5512428",
          "text": "Le foglie stanno cadendo.",
          "translation": "Листья падают.",
          "source": "Tatoeba #5512428 @dnnywld / #1419001 @tien_oroniel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512428",
          "cefr_level": "A1",
          "word_slugs": [
            "foglie-noun"
          ]
        },
        {
          "id": "380921",
          "text": "Le foglie cadono lentamente.",
          "translation": "Листья медленно опадают.",
          "source": "Tatoeba #380921 @ver / #412173 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/380921",
          "cefr_level": "A1",
          "word_slugs": [
            "foglie-noun"
          ]
        },
        {
          "id": "5512464",
          "text": "Le foglie cadono per terra.",
          "translation": "Листья падали на землю.",
          "source": "Tatoeba #5512464 @dnnywld / #1507518 @tengo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512464",
          "cefr_level": "A1",
          "word_slugs": [
            "foglie-noun"
          ]
        },
        {
          "id": "411818",
          "text": "In autunno cadono le foglie.",
          "translation": "Осенью падает листва.",
          "source": "Tatoeba #411818 @shoras / #4127139 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/411818",
          "cefr_level": "A1",
          "word_slugs": [
            "foglie-noun"
          ]
        },
        {
          "id": "6009483",
          "text": "Perché le foglie sono verdi?",
          "translation": "Почему листья зелёные?",
          "source": "Tatoeba #6009483 @dnnywld / #6008522 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009483",
          "cefr_level": "A1",
          "word_slugs": [
            "foglie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la foglie",
        "plural": "",
        "infinitive": ""
      }
