      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "819853",
          "text": "Pesce d'aprile!",
          "translation": "С первым апреля!",
          "source": "Tatoeba #819853 @Guybrush88 / #1946274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/819853",
          "cefr_level": "A1",
          "word_slugs": [
            "aprile-noun"
          ]
        },
        {
          "id": "10851524",
          "text": "Oggi è il primo di aprile.",
          "translation": "Сегодня первое апреля.",
          "source": "Tatoeba #10851524 @dnnywld / #6305887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851524",
          "cefr_level": "A1",
          "word_slugs": [
            "aprile-noun"
          ]
        },
        {
          "id": "691868",
          "text": "Il quarto mese si chiama aprile.",
          "translation": "Четвёртый месяц называется апрелем.",
          "source": "Tatoeba #691868 @Pharamp / #2205275 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/691868",
          "cefr_level": "A1",
          "word_slugs": [
            "aprile-noun"
          ]
        },
        {
          "id": "749837",
          "text": "L'anno scolastico comincia il 10 aprile.",
          "translation": "Учебный год начинается 10 апреля.",
          "source": "Tatoeba #749837 @Guybrush88 / #614506 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/749837",
          "cefr_level": "A1",
          "word_slugs": [
            "aprile-noun"
          ]
        },
        {
          "id": "621054",
          "text": "In Giappone la scuola comincia in aprile.",
          "translation": "В Японии учебный год начинается в апреле.",
          "source": "Tatoeba #621054 @Guybrush88 / #424465 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/621054",
          "cefr_level": "A1",
          "word_slugs": [
            "aprile-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il aprile",
