          ]
        },
        {
          "id": "6301963",
          "text": "Sono stato punito.",
          "translation": "Я был наказан.",
          "source": "Tatoeba #6301963 @dnnywld / #6301558 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6301963",
          "cefr_level": "A1",
          "word_slugs": [
            "punito-verb"
          ]
        },
        {
          "id": "5826288",
          "text": "So che sarò punito.",
          "translation": "Знаю, я буду наказан.",
          "source": "Tatoeba #5826288 @dnnywld / #5826089 @Fin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5826288",
