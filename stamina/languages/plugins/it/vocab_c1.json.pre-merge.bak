    {
      "slug": "casinò-noun",
      "lemma": "casinò",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7967,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7073380",
          "text": "Tom è andato al casinò.",
          "translation": "Том пошёл в казино.",
          "source": "Tatoeba #7073380 @dnnywld / #7072750 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7073380",
          "cefr_level": "A1",
          "word_slugs": [
            "casinò-noun"
          ]
        },
        {
          "id": "5595764",
          "text": "Tom ha due passioni, le donne e il casinò.",
          "translation": "У Тома две страсти — женщины и казино.",
          "source": "Tatoeba #5595764 @dnnywld / #5595580 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5595764",
          "cefr_level": "A1",
          "word_slugs": [
            "casinò-noun"
          ]
        },
        {
          "id": "6718599",
          "text": "Tom ha lasciato tutti i suoi soldi al casinò.",
          "translation": "Том оставил все свои деньги в казино.",
          "source": "Tatoeba #6718599 @dnnywld / #6717593 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6718599",
          "cefr_level": "A1",
          "word_slugs": [
            "casinò-noun"
          ]
        }
      ],
      "tags": [
