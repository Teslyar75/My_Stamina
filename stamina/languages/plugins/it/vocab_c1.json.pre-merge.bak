          ]
        },
        {
          "id": "5625986",
          "text": "Hai dormito a sufficienza.",
          "translation": "Ты спал достаточно.",
          "source": "Tatoeba #5625986 @dnnywld / #2555589 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5625986",
