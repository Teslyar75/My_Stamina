    {
      "slug": "preoccupo-verb",
      "lemma": "preoccupo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5905,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2564490",
          "text": "Mi preoccupo per te.",
          "translation": "Я за тебя волнуюсь.",
          "source": "Tatoeba #2564490 @Guybrush88 / #2661454 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2564490",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupo-verb"
          ]
        },
        {
          "id": "2564493",
          "text": "Mi preoccupo per voi.",
          "translation": "Я беспокоюсь о вас.",
          "source": "Tatoeba #2564493 @Guybrush88 / #2609901 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2564493",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupo-verb"
          ]
        },
        {
          "id": "3662973",
          "text": "Mi preoccupo per lui.",
          "translation": "Я беспокоюсь за него.",
          "source": "Tatoeba #3662973 @Guybrush88 / #3662975 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3662973",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupo-verb"
          ]
        },
        {
          "id": "5607810",
          "text": "Non mi preoccupo mai.",
          "translation": "Я никогда не волнуюсь.",
          "source": "Tatoeba #5607810 @dnnywld / #2848290 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607810",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupo-verb"
          ]
        },
        {
          "id": "6788883",
          "text": "Ma che mi preoccupo a fare?",
          "translation": "Чего я вообще парюсь?",
          "source": "Tatoeba #6788883 @dnnywld / #1682565 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6788883",
          "cefr_level": "A1",
          "word_slugs": [
            "preoccupo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "preoccupo",
        "plural": "",
        "infinitive": "preoccupo"
      }
