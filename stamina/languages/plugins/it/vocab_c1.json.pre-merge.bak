    {
      "slug": "legami-noun",
      "lemma": "legami",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6212,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5656861",
          "text": "La Turchia sta cercando di rafforzare i legami con l'Europa.",
          "translation": "Турция пытается укрепить связи с Европой.",
          "source": "Tatoeba #5656861 @dnnywld / #5656169 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5656861",
          "cefr_level": "A1",
          "word_slugs": [
