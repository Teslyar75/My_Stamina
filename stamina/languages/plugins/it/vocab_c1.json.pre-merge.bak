    {
      "slug": "marrone-adj",
      "lemma": "marrone",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6989,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6326910",
          "text": "Questo gatto è marrone.",
          "translation": "Этот кот коричневый.",
          "source": "Tatoeba #6326910 @dnnywld / #6324294 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326910",
          "cefr_level": "A1",
          "word_slugs": [
            "marrone-adj"
          ]
        },
        {
          "id": "6961739",
          "text": "Quello marrone è anche mio.",
          "translation": "Тот коричневый тоже мой.",
          "source": "Tatoeba #6961739 @dnnywld / #6960071 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961739",
          "cefr_level": "A1",
          "word_slugs": [
            "marrone-adj"
          ]
        },
        {
          "id": "5661659",
          "text": "Tom vive in una casa marrone.",
          "translation": "Том живет в коричневом доме.",
          "source": "Tatoeba #5661659 @Balamax / #5661653 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5661659",
          "cefr_level": "A1",
          "word_slugs": [
            "marrone-adj"
          ]
        },
        {
          "id": "411040",
          "text": "Il cane è marrone, piccolo e magro.",
          "translation": "Собака коричневая, маленькая и худая.",
          "source": "Tatoeba #411040 @Nox / #657472 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/411040",
          "cefr_level": "A1",
          "word_slugs": [
            "marrone-adj"
          ]
        },
        {
          "id": "2582725",
          "text": "Il mio colore preferito è il marrone.",
          "translation": "Мой любимый цвет - коричневый.",
          "source": "Tatoeba #2582725 @Guybrush88 / #5690906 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2582725",
          "cefr_level": "A1",
          "word_slugs": [
            "marrone-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
