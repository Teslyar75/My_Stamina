      "slug": "rovescia-noun",
      "lemma": "rovescia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8736,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5569573",
          "text": "Tutto alla rovescia.",
          "translation": "Всё шиворот-навыворот.",
          "source": "Tatoeba #5569573 @dnnywld / #5569540 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5569573",
          "cefr_level": "A1",
          "word_slugs": [
            "rovescia-noun"
          ]
        },
        {
          "id": "6918180",
          "text": "Questa volta è andato tutto alla rovescia.",
          "translation": "На этот раз всё вышло наоборот.",
          "source": "Tatoeba #6918180 @dnnywld / #6918133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6918180",
          "cefr_level": "A1",
          "word_slugs": [
            "rovescia-noun"
          ]
        },
        {
          "id": "5440571",
          "text": "Il governo non capisce niente, lui fa tutto alla rovescia.",
          "translation": "Правительство ничего не понимает, оно всё делает шиворот-навыворот.",
          "source": "Tatoeba #5440571 @dnnywld / #5439662 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5440571",
