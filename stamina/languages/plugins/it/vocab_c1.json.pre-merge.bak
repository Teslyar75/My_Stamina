      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5387223",
          "text": "Abbiamo piantato il riso.",
          "translation": "Мы посадили рис.",
          "source": "Tatoeba #5387223 @dnnywld / #5387213 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387223",
          "cefr_level": "A1",
          "word_slugs": [
            "piantato-adj"
          ]
        },
        {
          "id": "5811625",
          "text": "Ho piantato rose nel giardino.",
          "translation": "Я посадила в саду розы.",
          "source": "Tatoeba #5811625 @dnnywld / #5811385 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5811625",
          "cefr_level": "A1",
          "word_slugs": [
            "piantato-adj"
          ]
        },
        {
          "id": "6025298",
          "text": "Questa settimana ho piantato patate.",
