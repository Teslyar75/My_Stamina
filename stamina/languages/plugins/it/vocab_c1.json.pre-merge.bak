    {
      "slug": "timido-adj",
      "lemma": "timido",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7356,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6944313",
          "text": "Sami era molto timido.",
          "translation": "Сами был очень застенчивым.",
          "source": "Tatoeba #6944313 @dnnywld / #6943899 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944313",
          "cefr_level": "A1",
          "word_slugs": [
            "timido-adj"
          ]
        },
        {
          "id": "382284",
          "text": "Sono un ragazzo timido.",
          "translation": "Я юноша стеснительный.",
          "source": "Tatoeba #382284 @Pharamp / #495211 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/382284",
          "cefr_level": "A1",
          "word_slugs": [
            "timido-adj"
          ]
        },
        {
          "id": "5589200",
          "text": "Tom è un ragazzo molto timido.",
          "translation": "Том очень стеснительный мальчик.",
          "source": "Tatoeba #5589200 @dnnywld / #5588357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589200",
          "cefr_level": "A1",
          "word_slugs": [
            "timido-adj"
          ]
        },
        {
          "id": "6921480",
          "text": "Lui è timido come un topolino.",
          "translation": "Он пугливый, как мышь.",
          "source": "Tatoeba #6921480 @dnnywld / #6921374 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6921480",
          "cefr_level": "A1",
          "word_slugs": [
            "timido-adj"
          ]
        },
        {
          "id": "6924188",
          "text": "Bob era timido come un liceale.",
          "translation": "Боб был застенчив, как гимназист.",
          "source": "Tatoeba #6924188 @dnnywld / #6923883 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6924188",
          "cefr_level": "A1",
          "word_slugs": [
            "timido-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
