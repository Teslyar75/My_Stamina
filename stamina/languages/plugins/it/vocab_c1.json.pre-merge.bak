      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10885187",
          "text": "Passatemi la marmellata.",
          "translation": "Передайте мне джем.",
          "source": "Tatoeba #10885187 @dnnywld / #2659713 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885187",
          "cefr_level": "A1",
