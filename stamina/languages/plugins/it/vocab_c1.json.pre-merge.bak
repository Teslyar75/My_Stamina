    {
      "slug": "popcorn-noun",
      "lemma": "popcorn",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8636,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6698378",
          "text": "Vuoi i popcorn?",
          "translation": "Будешь попкорн?",
          "source": "Tatoeba #6698378 @dnnywld / #6697416 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698378",
          "cefr_level": "A1",
          "word_slugs": [
            "popcorn-noun"
          ]
        },
        {
          "id": "6698380",
          "text": "Ti piacciono i popcorn?",
          "translation": "Ты любишь попкорн?",
          "source": "Tatoeba #6698380 @dnnywld / #6697415 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698380",
          "cefr_level": "A1",
          "word_slugs": [
            "popcorn-noun"
          ]
        },
        {
          "id": "7453691",
          "text": "Questi sono dei popcorn.",
          "translation": "Это попкорн.",
          "source": "Tatoeba #7453691 @dnnywld / #7453598 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7453691",
          "cefr_level": "A1",
          "word_slugs": [
            "popcorn-noun"
          ]
        },
        {
          "id": "5686983",
          "text": "Più popcorn mangi, più ne vorresti.",
          "translation": "Чем больше попкорна ты ешь, тем больше его хочется.",
          "source": "Tatoeba #5686983 @dnnywld / #599588 @loins (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686983",
          "cefr_level": "A1",
          "word_slugs": [
            "popcorn-noun"
          ]
        },
        {
          "id": "6698376",
          "text": "Per te il popcorn dolce o salato?",
          "translation": "Тебе сладкий попкорн или солёный?",
          "source": "Tatoeba #6698376 @dnnywld / #6697417 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698376",
          "cefr_level": "A1",
          "word_slugs": [
            "popcorn-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il popcorn",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "cucchiaio-noun",
      "lemma": "cucchiaio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8637,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5424736",
          "text": "Tom ha leccato il cucchiaio.",
          "translation": "Том облизал ложку.",
          "source": "Tatoeba #5424736 @dnnywld / #5424692 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5424736",
          "cefr_level": "A1",
          "word_slugs": [
            "cucchiaio-noun"
          ]
        },
        {
          "id": "5423521",
          "text": "Ho perso il mio cucchiaio d'argento.",
          "translation": "Я потерял свою серебряную ложку.",
          "source": "Tatoeba #5423521 @dnnywld / #5423512 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5423521",
          "cefr_level": "A1",
          "word_slugs": [
            "cucchiaio-noun"
          ]
        },
        {
          "id": "5502946",
          "text": "La minestra si mangia con il cucchiaio.",
          "translation": "Суп едят ложкой.",
          "source": "Tatoeba #5502946 @dnnywld / #5501648 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5502946",
          "cefr_level": "A1",
          "word_slugs": [
            "cucchiaio-noun"
          ]
        },
        {
          "id": "5648564",
          "text": "Il bimbo non sa ancora usare il cucchiaio.",
          "translation": "Малыш еще не умеет использовать ложку.",
          "source": "Tatoeba #5648564 @dnnywld / #570827 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5648564",
          "cefr_level": "A1",
          "word_slugs": [
            "cucchiaio-noun"
          ]
        },
        {
          "id": "7000435",
          "text": "Per scommessa Tom ha mangiato un cucchiaio di sale.",
          "translation": "Том на спор съел столовую ложку соли.",
          "source": "Tatoeba #7000435 @dnnywld / #6999438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7000435",
          "cefr_level": "A1",
          "word_slugs": [
            "cucchiaio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il cucchiaio",
        "plural": "",
        "infinitive": ""
      }
