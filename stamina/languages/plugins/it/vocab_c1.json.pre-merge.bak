    {
      "slug": "campana-adj",
      "lemma": "campana",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6821,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "колокол"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "11469838",
          "text": "Tom è sordo come una campana.",
          "translation": "Том глухой как пень.",
          "source": "Tatoeba #11469838 @Bernie75 / #3466765 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11469838",
          "cefr_level": "A1",
          "word_slugs": [
            "campana-adj"
          ]
        },
        {
          "id": "5648574",
          "text": "Appena lui entrò, la campana suonò.",
          "translation": "Как только он вошел, прозвенел звонок.",
          "source": "Tatoeba #5648574 @dnnywld / #570815 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5648574",
          "cefr_level": "A1",
          "word_slugs": [
            "campana-adj"
          ]
        },
        {
          "id": "10854614",
          "text": "La campana di bronzo ha un bel suono.",
          "translation": "Колокол из бронзы звучит красиво.",
          "source": "Tatoeba #10854614 @dnnywld / #1535638 @zalaim (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854614",
          "cefr_level": "A1",
          "word_slugs": [
            "campana-adj"
          ]
        },
        {
          "id": "9110284",
          "text": "L'infelice insegnante è stata salvata dalla campana.",
          "translation": "Несчастную учительницу спас звонок.",
          "source": "Tatoeba #9110284 @carlosalberto / #4020947 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9110284",
          "cefr_level": "A1",
          "word_slugs": [
            "campana-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il campana",
        "plural": "",
        "infinitive": ""
      }
