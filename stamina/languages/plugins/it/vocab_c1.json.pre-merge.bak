            "comprati-verb"
          ]
        },
        {
          "id": "5594298",
          "text": "Davvero pensi che tutti possano essere comprati?",
          "translation": "Ты что же думаешь, всех купить можно?",
          "source": "Tatoeba #5594298 @dnnywld / #5594011 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5594298",
          "cefr_level": "A1",
          "word_slugs": [
            "comprati-verb"
          ]
        },
