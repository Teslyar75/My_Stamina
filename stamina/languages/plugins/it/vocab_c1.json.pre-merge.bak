    {
      "slug": "trovarsi-verb",
      "lemma": "trovarsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6418,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10792343",
          "text": "Al posto potrebbe trovarsi chiunque.",
          "translation": "На моём месте мог оказаться любой.",
          "source": "Tatoeba #10792343 @dnnywld / #8139813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10792343",
          "cefr_level": "A1",
          "word_slugs": [
            "trovarsi-verb"
          ]
        },
        {
          "id": "10792344",
          "text": "Al mio posto potrebbe trovarsi chiunque.",
          "translation": "На моём месте может оказаться любой.",
          "source": "Tatoeba #10792344 @dnnywld / #8139815 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10792344",
          "cefr_level": "A1",
          "word_slugs": [
            "trovarsi-verb"
          ]
        },
        {
          "id": "10792345",
          "text": "Al tuo posto potrebbe trovarsi chiunque.",
          "translation": "На твоём месте мог оказаться любой.",
          "source": "Tatoeba #10792345 @dnnywld / #8139816 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10792345",
          "cefr_level": "A1",
          "word_slugs": [
            "trovarsi-verb"
          ]
        },
        {
          "id": "8679675",
          "text": "Tom pensava che Mary potesse trovarsi un lavoro.",
          "translation": "Том подумал, что Мэри сможет найти работу.",
          "source": "Tatoeba #8679675 @Guybrush88 / #8679685 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8679675",
          "cefr_level": "A1",
          "word_slugs": [
            "trovarsi-verb"
          ]
        },
        {
          "id": "7610916",
          "text": "Tom è arrivato a Boston con la speranza di trovarsi un lavoro.",
          "translation": "Том приехал в Бостон в надежде найти себе здесь работу.",
          "source": "Tatoeba #7610916 @dnnywld / #7610443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7610916",
          "cefr_level": "A1",
          "word_slugs": [
            "trovarsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
