    {
      "slug": "rifiutare-verb",
      "lemma": "rifiutare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5772,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12374017",
          "text": "Non dovevo rifiutare.",
          "translation": "Я не должен был отказываться.",
          "source": "Tatoeba #12374017 @dnnywld / #12373151 @xlenchik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12374017",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiutare-verb"
          ]
        },
        {
          "id": "2009098",
          "text": "Tom non può rifiutare.",
          "translation": "Том не может отказать.",
          "source": "Tatoeba #2009098 @Guybrush88 / #5786889 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2009098",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiutare-verb"
          ]
        },
        {
          "id": "6893459",
          "text": "Vi è difficile rifiutare.",
          "translation": "Вам трудно отказать.",
          "source": "Tatoeba #6893459 @dnnywld / #6703222 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893459",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiutare-verb"
          ]
        },
        {
          "id": "7140191",
          "text": "Non sapevo come rifiutare.",
          "translation": "Я не знал, как отказаться.",
          "source": "Tatoeba #7140191 @dnnywld / #7139909 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7140191",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiutare-verb"
          ]
        },
        {
          "id": "12374018",
          "text": "Non avrei dovuto rifiutare.",
          "translation": "Я не должен был отказываться.",
          "source": "Tatoeba #12374018 @dnnywld / #12373151 @xlenchik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12374018",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiutare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
