          ]
        },
        {
          "id": "10840752",
          "text": "Potetre registrare file audio?",
          "translation": "Вы можете записать аудиофайлы.",
          "source": "Tatoeba #10840752 @dnnywld / #8088123 @cykel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10840752",
