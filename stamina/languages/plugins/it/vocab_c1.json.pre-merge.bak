    {
      "slug": "sprecare-verb",
      "lemma": "sprecare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5407,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5693167",
          "text": "Non sprecare tempo.",
          "translation": "Не трать зря время.",
          "source": "Tatoeba #5693167 @dnnywld / #5693107 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5693167",
          "cefr_level": "A1",
          "word_slugs": [
            "sprecare-verb"
          ]
        },
        {
          "id": "5857163",
          "text": "Smettila di sprecare tempo.",
          "translation": "Перестань с этим возиться.",
          "source": "Tatoeba #5857163 @dnnywld / #3618425 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5857163",
          "cefr_level": "A1",
          "word_slugs": [
            "sprecare-verb"
          ]
        },
        {
          "id": "5504387",
          "text": "Non sprecare soldi in nullità.",
          "translation": "Не трать деньги на пустяки.",
          "source": "Tatoeba #5504387 @dnnywld / #5503538 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504387",
          "cefr_level": "A1",
          "word_slugs": [
            "sprecare-verb"
          ]
        },
        {
          "id": "2058077",
          "text": "Facebook mi fa sprecare molto tempo.",
          "translation": "Фейсбук отнимает у меня много времени.",
          "source": "Tatoeba #2058077 @Guybrush88 / #3351248 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2058077",
          "cefr_level": "A1",
          "word_slugs": [
            "sprecare-verb"
          ]
        },
        {
          "id": "5472765",
          "text": "Non volevo sprecare nemmeno un minuto.",
          "translation": "Я не хотел тратить ни минуты.",
          "source": "Tatoeba #5472765 @dnnywld / #9694676 @AnnaHX (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472765",
          "cefr_level": "A1",
          "word_slugs": [
            "sprecare-verb"
          ]
        }
      ],
