          ]
        },
        {
          "id": "5070253",
          "text": "La vostra approvazione non è richiesta.",
          "translation": "Ваше одобрение не требуется.",
          "source": "Tatoeba #5070253 @Guybrush88 / #5179843 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5070253",
          "cefr_level": "A1",
          "word_slugs": [
            "approvazione-noun"
          ]
        },
        {
          "id": "6790647",
          "text": "Non mi serve la tua approvazione per questo.",
          "translation": "Мне на это твоё разрешение не требуется.",
          "source": "Tatoeba #6790647 @dnnywld / #3292439 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790647",
          "cefr_level": "A1",
          "word_slugs": [
