    {
      "slug": "addormentato-adj",
      "lemma": "addormentato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5718,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2702658",
          "text": "Tom si è addormentato.",
          "translation": "Том уснул.",
          "source": "Tatoeba #2702658 @Guybrush88 / #3057212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2702658",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentato-adj"
          ]
        },
        {
          "id": "5496930",
          "text": "Sono ancora mezzo addormentato.",
          "translation": "Я всё ещё в полусонном состоянии.",
          "source": "Tatoeba #5496930 @dnnywld / #5496914 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5496930",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentato-adj"
          ]
        },
        {
          "id": "5531935",
          "text": "Tom si era quasi addormentato.",
          "translation": "Том почти уснул.",
          "source": "Tatoeba #5531935 @dnnywld / #5531241 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5531935",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentato-adj"
          ]
        },
        {
          "id": "5483171",
          "text": "Tom finalmente si è addormentato.",
          "translation": "Том наконец уснул.",
          "source": "Tatoeba #5483171 @dnnywld / #5482850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5483171",
          "cefr_level": "A1",
          "word_slugs": [
            "addormentato-adj"
          ]
        },
        {
          "id": "10844036",
          "text": "Ho il piede sinistro addormentato.",
          "translation": "У меня левая нога затекла.",
          "source": "Tatoeba #10844036 @dnnywld / #10841891 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844036",
