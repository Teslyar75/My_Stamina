    {
      "slug": "commenti-noun",
      "lemma": "commenti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6248,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6875046",
          "text": "Chi ha commenti da fare?",
          "translation": "У кого есть замечания?",
          "source": "Tatoeba #6875046 @dnnywld / #6874878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6875046",
          "cefr_level": "A1",
          "word_slugs": [
            "commenti-noun"
          ]
        },
        {
          "id": "10797414",
          "text": "Non voglio leggere i commenti.",
          "translation": "Я не хочу читать комментарии.",
          "source": "Tatoeba #10797414 @dnnywld / #8151224 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10797414",
          "cefr_level": "A1",
          "word_slugs": [
            "commenti-noun"
          ]
        },
        {
          "id": "7368898",
          "text": "Sono stanca dei vostri commenti.",
          "translation": "Мне надоели ваши комментарии.",
          "source": "Tatoeba #7368898 @Guybrush88 / #4081617 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7368898",
          "cefr_level": "A1",
          "word_slugs": [
            "commenti-noun"
          ]
        },
        {
          "id": "6005057",
          "text": "I commenti sono sempre benvenuti.",
          "translation": "Комментарии всегда приветствуются.",
