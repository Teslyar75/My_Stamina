    {
      "slug": "corrono-verb",
      "lemma": "corrono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9975,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6687098",
          "text": "Le voci corrono.",
          "translation": "Слухами земля полнится.",
          "source": "Tatoeba #6687098 @dnnywld / #6686914 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6687098",
          "cefr_level": "A1",
          "word_slugs": [
            "corrono-verb"
          ]
        },
        {
          "id": "3100646",
          "text": "Gli animali corrono.",
          "translation": "Животные бегают.",
          "source": "Tatoeba #3100646 @Guybrush88 / #3225089 @sicerabibax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3100646",
          "cefr_level": "A1",
          "word_slugs": [
            "corrono-verb"
          ]
        },
        {
          "id": "6687096",
          "text": "\"E tu come fai a saperlo?\" - \"Le voci corrono\".",
          "translation": "\"А ты откуда знаешь?\" - \"Слухами земля полнится\".",
          "source": "Tatoeba #6687096 @dnnywld / #6686915 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6687096",
          "cefr_level": "A1",
          "word_slugs": [
            "corrono-verb"
          ]
        },
        {
          "id": "5553326",
          "text": "I Moscoviti corrono tutto il tempo da qualche parte.",
          "translation": "Москвичи всё время куда-то бегут.",
          "source": "Tatoeba #5553326 @dnnywld / #5553109 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5553326",
          "cefr_level": "A1",
          "word_slugs": [
            "corrono-verb"
          ]
        },
        {
          "id": "10836614",
          "text": "È uno schifo essere russi con i tempi che corrono.",
          "translation": "В нынешние времена быть русским отстойно.",
          "source": "Tatoeba #10836614 @dnnywld / #10836459 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10836614",
          "cefr_level": "A1",
          "word_slugs": [
            "corrono-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "corrono",
        "plural": "",
        "infinitive": "corrono"
      }
    },
    {
      "slug": "soddisfatta-adj",
      "lemma": "soddisfatta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9976,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5549659",
          "text": "La mia sete è soddisfatta.",
          "translation": "Моя жажда утолена.",
          "source": "Tatoeba #5549659 @dnnywld / #4782652 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549659",
          "cefr_level": "A1",
          "word_slugs": [
            "soddisfatta-adj"
          ]
        },
        {
          "id": "6973545",
          "text": "Non ero soddisfatta di te.",
          "translation": "Я не была тобой довольна.",
          "source": "Tatoeba #6973545 @dnnywld / #6973070 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6973545",
          "cefr_level": "A1",
          "word_slugs": [
            "soddisfatta-adj"
          ]
        },
        {
          "id": "3646791",
          "text": "Sono molto soddisfatta della mia nuova casa.",
          "translation": "Я очень довольна своим новым домом.",
          "source": "Tatoeba #3646791 @Guybrush88 / #3646861 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3646791",
          "cefr_level": "A1",
          "word_slugs": [
            "soddisfatta-adj"
          ]
        },
        {
          "id": "6942695",
          "text": "Mari era rimasta soddisfatta del lavoro di Tom.",
          "translation": "Мария осталась довольна работой Тома.",
          "source": "Tatoeba #6942695 @dnnywld / #6941925 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6942695",
          "cefr_level": "A1",
          "word_slugs": [
            "soddisfatta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
