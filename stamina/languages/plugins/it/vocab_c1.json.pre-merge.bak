          ]
        },
        {
          "id": "2838415",
          "text": "Sei allergico a qualcosa?",
          "translation": "У тебя есть аллергия на что-нибудь?",
          "source": "Tatoeba #2838415 @Guybrush88 / #5217802 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2838415",
          "cefr_level": "A1",
          "word_slugs": [
            "allergico-noun"
          ]
        },
        {
          "id": "5656800",
          "text": "Sono allergico ai medicinali.",
          "translation": "У меня аллергия на лекарства.",
          "source": "Tatoeba #5656800 @dnnywld / #5656682 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5656800",
          "cefr_level": "A1",
          "word_slugs": [
            "allergico-noun"
          ]
        },
        {
          "id": "2966471",
          "text": "Io sono allergico ai cani.",
          "translation": "У меня аллергия на собак.",
          "source": "Tatoeba #2966471 @Guybrush88 / #3566237 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2966471",
