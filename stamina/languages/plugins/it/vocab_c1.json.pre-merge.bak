    {
      "slug": "pranzare-verb",
      "lemma": "pranzare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8215,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7587815",
          "text": "Ho mezz'ora per pranzare.",
          "translation": "У меня есть полчаса, чтобы пообедать.",
          "source": "Tatoeba #7587815 @dnnywld / #7587654 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7587815",
          "cefr_level": "A1",
          "word_slugs": [
            "pranzare-verb"
          ]
        },
        {
          "id": "6908122",
          "text": "Tom voleva pranzare con te.",
          "translation": "Том хотел с тобой пообедать.",
          "source": "Tatoeba #6908122 @dnnywld / #6908048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908122",
          "cefr_level": "A1",
          "word_slugs": [
            "pranzare-verb"
          ]
        },
        {
          "id": "6908121",
          "text": "Tom voleva pranzare con voi.",
          "translation": "Том хотел с вами пообедать.",
          "source": "Tatoeba #6908121 @dnnywld / #6908049 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908121",
          "cefr_level": "A1",
          "word_slugs": [
            "pranzare-verb"
          ]
        },
        {
          "id": "6917816",
          "text": "Tom si è rifiutato di pranzare.",
          "translation": "Том отказался обедать.",
          "source": "Tatoeba #6917816 @dnnywld / #6917744 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917816",
          "cefr_level": "A1",
          "word_slugs": [
            "pranzare-verb"
          ]
        },
        {
          "id": "10267422",
          "text": "Ho tempo per pranzare e rilassarmi.",
          "translation": "Я успеваю пообедать и отдохнуть.",
          "source": "Tatoeba #10267422 @carlosalberto / #2709919 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10267422",
          "cefr_level": "A1",
          "word_slugs": [
            "pranzare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "pranzare",
        "plural": "",
        "infinitive": "pranzare"
      }
