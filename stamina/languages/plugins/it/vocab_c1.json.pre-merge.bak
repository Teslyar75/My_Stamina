    {
      "slug": "unirsi-verb",
      "lemma": "unirsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6234,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6803439",
          "text": "Tom può unirsi a te?",
          "translation": "Том может к тебе присоединиться?",
          "source": "Tatoeba #6803439 @dnnywld / #6803280 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6803439",
          "cefr_level": "A1",
          "word_slugs": [
            "unirsi-verb"
          ]
        },
        {
          "id": "6803436",
          "text": "Tom può unirsi a voi?",
          "translation": "Том может к вам присоединиться?",
          "source": "Tatoeba #6803436 @dnnywld / #6803281 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6803436",
          "cefr_level": "A1",
          "word_slugs": [
            "unirsi-verb"
          ]
        },
        {
          "id": "5646105",
          "text": "Tom ha convinto Mary ad unirsi al gruppo.",
          "translation": "Том уговорил Мэри присоединиться к нашей группе.",
          "source": "Tatoeba #5646105 @dnnywld / #5333713 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646105",
          "cefr_level": "A1",
          "word_slugs": [
            "unirsi-verb"
          ]
        },
        {
          "id": "7145435",
          "text": "Ho cercato di convincere Tom ad unirsi a noi.",
          "translation": "Я пытался убедить Тома к нам присоединиться.",
          "source": "Tatoeba #7145435 @dnnywld / #4589652 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7145435",
          "cefr_level": "A1",
          "word_slugs": [
            "unirsi-verb"
          ]
        },
        {
          "id": "7033656",
          "text": "Mary ha chiesto a Tom di unirsi al circolo letterario.",
          "translation": "Мэри попросила Тома вступить в литературный кружок.",
          "source": "Tatoeba #7033656 @dnnywld / #7033652 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7033656",
          "cefr_level": "A1",
          "word_slugs": [
            "unirsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "unirsi",
        "plural": "",
        "infinitive": "unirsi"
      }
