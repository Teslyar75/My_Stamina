          ]
        },
        {
          "id": "10772611",
          "text": "Tom fece scendere il secchio nel pozzo.",
          "translation": "Том спустил ведро в колодец.",
          "source": "Tatoeba #10772611 @dnnywld / #3189792 @averoes (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10772611",
