    {
      "slug": "ago-noun",
      "lemma": "ago",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5619,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "игла"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5516032",
          "text": "Hai ago e filo nero?",
          "translation": "У тебя есть иголка и чёрные нитки?",
          "source": "Tatoeba #5516032 @dnnywld / #5516022 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5516032",
          "cefr_level": "A1",
          "word_slugs": [
            "ago-noun"
          ]
        },
        {
          "id": "5463822",
          "text": "L'ago della bussola indica il nord.",
          "translation": "Стрелка компаса указывает на север.",
          "source": "Tatoeba #5463822 @dnnywld / #1792922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5463822",
          "cefr_level": "A1",
          "word_slugs": [
            "ago-noun"
          ]
        },
        {
          "id": "5984914",
          "text": "Hai un ago per cucire questi bottoni?",
          "translation": "У тебя есть иголка, чтобы пришить эти пуговицы?",
          "source": "Tatoeba #5984914 @dnnywld / #5984580 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5984914",
          "cefr_level": "A1",
          "word_slugs": [
            "ago-noun"
          ]
        },
        {
          "id": "691391",
          "text": "È come cercare un ago in un pagliaio.",
          "translation": "Это как искать иголку в стоге сена.",
          "source": "Tatoeba #691391 @Heracleum / #3699290 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/691391",
          "cefr_level": "A1",
          "word_slugs": [
            "ago-noun"
          ]
        },
        {
          "id": "6876795",
          "text": "Lasciate che infili il filo nell'ago per voi.",
          "translation": "Позвольте, я вдену вам нитку в иголку.",
          "source": "Tatoeba #6876795 @dnnywld / #6876663 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6876795",
          "cefr_level": "A1",
          "word_slugs": [
            "ago-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ago",
        "plural": "",
        "infinitive": ""
      }
    },
