    {
      "slug": "conversazioni-noun",
      "lemma": "conversazioni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8057,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6866484",
          "text": "Conversazioni simili non sono costruttive.",
          "translation": "Подобные разговоры неконструктивны.",
          "source": "Tatoeba #6866484 @dnnywld / #6866143 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866484",
          "cefr_level": "A1",
          "word_slugs": [
            "conversazioni-noun"
          ]
        },
        {
          "id": "7006477",
          "text": "Meglio un Khinkali di lunghe conversazioni.",
          "translation": "Чем долгие разговоры, лучше хинкал.",
          "source": "Tatoeba #7006477 @dnnywld / #7005054 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7006477",
          "cefr_level": "A1",
          "word_slugs": [
            "conversazioni-noun"
          ]
        },
        {
          "id": "7006478",
          "text": "Insignificanti conversazioni distruggeranno la grande casa.",
          "translation": "Мелкие разговоры разрушат большой дом.",
          "source": "Tatoeba #7006478 @dnnywld / #7005047 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7006478",
          "cefr_level": "A1",
          "word_slugs": [
            "conversazioni-noun"
          ]
        },
        {
          "id": "5408442",
          "text": "Le registrazioni delle nostre conversazioni si trovano dalla segretaria.",
          "translation": "Записи наших бесед находятся у секретаря.",
          "source": "Tatoeba #5408442 @dnnywld / #582701 @loins (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408442",
          "cefr_level": "A1",
          "word_slugs": [
            "conversazioni-noun"
          ]
        }
      ],
      "tags": [
