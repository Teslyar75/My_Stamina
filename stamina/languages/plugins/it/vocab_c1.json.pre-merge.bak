    {
      "slug": "biliardo-noun",
      "lemma": "biliardo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9198,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1561937",
          "text": "Non gioco a biliardo.",
          "translation": "Я не играю в бильярд.",
          "source": "Tatoeba #1561937 @Guybrush88 / #6227024 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1561937",
          "cefr_level": "A1",
          "word_slugs": [
            "biliardo-noun"
          ]
        },
        {
          "id": "3248193",
          "text": "Tom ama giocare a biliardo.",
          "translation": "Том любит играть в бильярд.",
          "source": "Tatoeba #3248193 @al_ex_an_der / #3247337 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3248193",
          "cefr_level": "A1",
          "word_slugs": [
            "biliardo-noun"
          ]
        },
        {
          "id": "6396359",
          "text": "Tom ha un tavolo da biliardo in cantina.",
