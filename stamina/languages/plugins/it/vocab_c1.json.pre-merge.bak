    {
      "slug": "juan-name",
      "lemma": "Juan",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5782,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5688915",
          "text": "Lo prometto, Juan.",
          "translation": "Я обещаю, Хуан.",
          "source": "Tatoeba #5688915 @dnnywld / #5270755 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688915",
          "cefr_level": "A1",
          "word_slugs": [
            "juan-name"
          ]
        },
        {
          "id": "5662174",
          "text": "Juan lavora alla zecca.",
          "translation": "Хуан работает на монетном дворе.",
          "source": "Tatoeba #5662174 @dnnywld / #5661306 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662174",
          "cefr_level": "A1",
          "word_slugs": [
            "juan-name"
          ]
        },
        {
          "id": "5614017",
          "text": "Juan ha plastificato i documenti.",
          "translation": "Хуан заламинировал документы.",
          "source": "Tatoeba #5614017 @dnnywld / #5613548 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614017",
          "cefr_level": "A1",
          "word_slugs": [
            "juan-name"
          ]
        },
        {
          "id": "7865939",
          "text": "Juan non ha una casa sua.",
          "translation": "У Хуана нет своего дома.",
          "source": "Tatoeba #7865939 @dnnywld / #7865825 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7865939",
          "cefr_level": "A1",
          "word_slugs": [
            "juan-name"
          ]
        },
        {
          "id": "3235456",
          "text": "Juan è uno studente molto cattivo.",
          "translation": "Хуан - очень плохой студент.",
