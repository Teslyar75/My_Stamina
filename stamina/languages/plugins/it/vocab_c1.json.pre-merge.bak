    {
      "slug": "enormi-adj",
      "lemma": "enormi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5078,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7566406",
          "text": "Le porzioni sono enormi.",
          "translation": "Порции огромные.",
          "source": "Tatoeba #7566406 @Guybrush88 / #13944995 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7566406",
          "cefr_level": "A1",
          "word_slugs": [
            "enormi-adj"
          ]
        },
        {
          "id": "4609122",
          "text": "I suoi bicipiti sono enormi.",
          "translation": "У него огромные бицепсы.",
          "source": "Tatoeba #4609122 @Guybrush88 / #5143621 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4609122",
          "cefr_level": "A1",
          "word_slugs": [
            "enormi-adj"
          ]
        },
        {
          "id": "3221725",
          "text": "Le uova di struzzo sono enormi.",
          "translation": "Страусиные яйца огромные.",
          "source": "Tatoeba #3221725 @Selena777 / #3226472 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3221725",
          "cefr_level": "A1",
          "word_slugs": [
            "enormi-adj"
          ]
        },
        {
          "id": "5899923",
          "text": "Le porzioni in questo ristorante sono enormi.",
          "translation": "Порции в этом ресторане огромные.",
          "source": "Tatoeba #5899923 @dnnywld / #5899813 @Ivanovich (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5899923",
          "cefr_level": "A1",
          "word_slugs": [
            "enormi-adj"
          ]
        },
        {
          "id": "10857829",
          "text": "Dal soffitto pendevano enormi pezzi di ghiaccio.",
          "translation": "С крыши свисали огромные сосульки.",
          "source": "Tatoeba #10857829 @dnnywld / #10857721 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10857829",
          "cefr_level": "A1",
          "word_slugs": [
            "enormi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
