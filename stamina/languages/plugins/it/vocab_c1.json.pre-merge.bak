    {
      "slug": "nati-adj",
      "lemma": "nati",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7005,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5093233",
          "text": "Tutti noi siamo nati su Marte.",
          "translation": "Мы все родились на Марсе.",
          "source": "Tatoeba #5093233 @Guybrush88 / #5093242 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5093233",
          "cefr_level": "A1",
          "word_slugs": [
