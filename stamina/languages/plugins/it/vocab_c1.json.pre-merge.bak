    {
      "slug": "fissando-verb",
      "lemma": "fissando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8763,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5484810",
          "text": "Tom ti stava fissando.",
          "translation": "Том на тебя пялился.",
          "source": "Tatoeba #5484810 @dnnywld / #5484653 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5484810",
          "cefr_level": "A1",
          "word_slugs": [
            "fissando-verb"
          ]
        },
        {
          "id": "5335718",
          "text": "Cosa stava fissando Tom?",
          "translation": "На что Том уставился?",
          "source": "Tatoeba #5335718 @Guybrush88 / #6597856 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5335718",
          "cefr_level": "A1",
          "word_slugs": [
            "fissando-verb"
          ]
        },
        {
          "id": "5738838",
          "text": "Tom stava solo fissando Mary.",
          "translation": "Том просто глазел на Мэри.",
          "source": "Tatoeba #5738838 @dnnywld / #5736883 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5738838",
          "cefr_level": "A1",
          "word_slugs": [
            "fissando-verb"
          ]
        },
        {
          "id": "5477523",
          "text": "Perché tutti vi stanno fissando?",
          "translation": "Почему все на вас уставились?",
          "source": "Tatoeba #5477523 @dnnywld / #5477185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5477523",
          "cefr_level": "A1",
          "word_slugs": [
