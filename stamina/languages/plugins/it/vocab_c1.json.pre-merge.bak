    {
      "slug": "incontriamo-verb",
      "lemma": "incontriamo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6442,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "569361",
          "text": "Ci incontriamo domenica.",
          "translation": "Мы встречаемся в воскресенье.",
          "source": "Tatoeba #569361 @bruno_b / #567035 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/569361",
          "cefr_level": "A1",
          "word_slugs": [
            "incontriamo-verb"
          ]
        },
        {
          "id": "7000417",
          "text": "A che ora ci incontriamo?",
          "translation": "Во сколько часов встречаемся?",
          "source": "Tatoeba #7000417 @dnnywld / #7000051 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7000417",
          "cefr_level": "A1",
          "word_slugs": [
            "incontriamo-verb"
          ]
        },
        {
          "id": "5384442",
          "text": "Dove e quando ci incontriamo?",
          "translation": "Где и когда мы встретимся?",
          "source": "Tatoeba #5384442 @dnnywld / #4350942 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384442",
          "cefr_level": "A1",
          "word_slugs": [
            "incontriamo-verb"
          ]
        },
        {
          "id": "10792353",
          "text": "Li incontriamo di quando in quando.",
          "translation": "Мы их время от времени встречаем.",
          "source": "Tatoeba #10792353 @dnnywld / #8139826 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10792353",
          "cefr_level": "A1",
          "word_slugs": [
            "incontriamo-verb"
          ]
        },
        {
          "id": "6702538",
          "text": "Io e lei ci incontriamo proprio oggi.",
          "translation": "Мы с ней как раз сегодня встречаемся.",
          "source": "Tatoeba #6702538 @dnnywld / #6701540 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6702538",
          "cefr_level": "A1",
          "word_slugs": [
            "incontriamo-verb"
          ]
        }
      ],
      "tags": [
