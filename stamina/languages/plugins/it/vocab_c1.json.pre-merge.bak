      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9146,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6326080",
          "text": "Ho i capelli corti.",
          "translation": "У меня короткая стрижка.",
          "source": "Tatoeba #6326080 @dnnywld / #6325741 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326080",
          "cefr_level": "A1",
          "word_slugs": [
            "corti-name"
          ]
        },
        {
          "id": "6965136",
          "text": "Sono ai ferri corti.",
          "translation": "Они на ножах.",
          "source": "Tatoeba #6965136 @dnnywld / #4134118 @allasobirova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6965136",
          "cefr_level": "A1",
          "word_slugs": [
            "corti-name"
          ]
        },
        {
          "id": "3794676",
          "text": "Lei ha i capelli corti.",
          "translation": "У неё короткая стрижка.",
          "source": "Tatoeba #3794676 @Guybrush88 / #4431163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3794676",
          "cefr_level": "A1",
          "word_slugs": [
            "corti-name"
          ]
        },
        {
          "id": "6698322",
          "text": "Lukas ha i capelli corti.",
          "translation": "У Лукаса короткие волосы.",
          "source": "Tatoeba #6698322 @dnnywld / #6697439 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698322",
          "cefr_level": "A1",
          "word_slugs": [
            "corti-name"
          ]
        },
        {
          "id": "3185758",
          "text": "Adesso ha i capelli corti.",
          "translation": "Сейчас у него короткие волосы.",
          "source": "Tatoeba #3185758 @Guybrush88 / #3185906 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3185758",
          "cefr_level": "A1",
          "word_slugs": [
            "corti-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "Corti",
        "plural": "",
