    {
      "slug": "presentazione-noun",
      "lemma": "presentazione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5162,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1470717",
          "text": "Cos'è una presentazione?",
          "translation": "Что такое презентация?",
          "source": "Tatoeba #1470717 @Guybrush88 / #6183551 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1470717",
          "cefr_level": "A1",
          "word_slugs": [
            "presentazione-noun"
          ]
        },
        {
          "id": "5539252",
          "text": "Tom deve fare una presentazione.",
          "translation": "Том должен сделать презентацию.",
          "source": "Tatoeba #5539252 @dnnywld / #5539173 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5539252",
          "cefr_level": "A1",
          "word_slugs": [
            "presentazione-noun"
          ]
        },
        {
          "id": "5672420",
          "text": "Oggi Tom farà la presentazione alla conferenza.",
          "translation": "Сегодня Том выступает с докладом на конференции.",
          "source": "Tatoeba #5672420 @dnnywld / #5672085 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672420",
          "cefr_level": "A1",
          "word_slugs": [
            "presentazione-noun"
          ]
        },
        {
          "id": "5672419",
          "text": "Domani alla conferenza Tom farà la presentazione.",
          "translation": "Завтра на конференции Том выступит с докладом.",
          "source": "Tatoeba #5672419 @dnnywld / #5672081 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672419",
          "cefr_level": "A1",
          "word_slugs": [
            "presentazione-noun"
          ]
        },
        {
          "id": "6790917",
          "text": "Nel corso della presentazione l'ingresso è chiuso.",
          "translation": "Вход закрыт в течение презентации.",
          "source": "Tatoeba #6790917 @dnnywld / #6392368 @al_lastor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790917",
          "cefr_level": "A1",
          "word_slugs": [
            "presentazione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
