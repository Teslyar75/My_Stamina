    {
      "slug": "sordo-adj",
      "lemma": "sordo",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6673,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "752805",
          "text": "Non sono sordo.",
          "translation": "Я не глухой.",
          "source": "Tatoeba #752805 @Guybrush88 / #1513712 @Aj (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/752805",
          "cefr_level": "A1",
          "word_slugs": [
            "sordo-adj"
          ]
        },
        {
          "id": "5515592",
          "text": "Lui era anche sordo.",
          "translation": "Он также был глухим.",
          "source": "Tatoeba #5515592 @dnnywld / #3555798 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5515592",
          "cefr_level": "A1",
          "word_slugs": [
            "sordo-adj"
          ]
        },
        {
          "id": "3681262",
          "text": "Tom sta diventando sordo.",
          "translation": "Том глохнет.",
          "source": "Tatoeba #3681262 @Guybrush88 / #4592294 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3681262",
          "cefr_level": "A1",
          "word_slugs": [
            "sordo-adj"
          ]
        },
        {
          "id": "5517597",
          "text": "Tom è sordo da un orecchio.",
          "translation": "Том глухой на одно ухо.",
          "source": "Tatoeba #5517597 @dnnywld / #5517383 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5517597",
          "cefr_level": "A1",
          "word_slugs": [
            "sordo-adj"
          ]
        },
        {
          "id": "11469838",
          "text": "Tom è sordo come una campana.",
          "translation": "Том глухой как пень.",
          "source": "Tatoeba #11469838 @Bernie75 / #3466765 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11469838",
          "cefr_level": "A1",
          "word_slugs": [
            "sordo-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
