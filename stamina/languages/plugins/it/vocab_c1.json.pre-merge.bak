    {
      "slug": "recitare-verb",
      "lemma": "recitare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5020,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5855065",
          "text": "Volete recitare in un film?",
          "translation": "Вы хотите сниматься в кино?",
          "source": "Tatoeba #5855065 @dnnywld / #4541653 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5855065",
          "cefr_level": "A1",
          "word_slugs": [
            "recitare-verb"
          ]
        },
        {
          "id": "6777963",
          "text": "Smettila di recitare la commedia.",
          "translation": "Хватит ломать комедию.",
          "source": "Tatoeba #6777963 @dnnywld / #6777819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6777963",
          "cefr_level": "A1",
          "word_slugs": [
            "recitare-verb"
          ]
        },
        {
          "id": "5780697",
          "text": "Questo attore è sia bello che bravo a recitare.",
          "translation": "Этот актёр и красивый, и играет хорошо.",
          "source": "Tatoeba #5780697 @dnnywld / #5780494 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5780697",
          "cefr_level": "A1",
          "word_slugs": [
            "recitare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "recitare",
        "plural": "",
        "infinitive": "recitare"
      }
