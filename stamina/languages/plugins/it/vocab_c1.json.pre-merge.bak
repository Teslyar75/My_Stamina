    {
      "slug": "sedile-noun",
      "lemma": "sedile",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5151,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5479803",
          "text": "Sedetevi sul sedile posteriore.",
          "translation": "Садитесь на заднее сиденье.",
          "source": "Tatoeba #5479803 @dnnywld / #5479782 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479803",
          "cefr_level": "A1",
          "word_slugs": [
            "sedile-noun"
          ]
        },
        {
          "id": "836253",
          "text": "Dov'è il mio sedile?",
          "translation": "Где мое место?",
          "source": "Tatoeba #836253 @Guybrush88 / #2622413 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/836253",
          "cefr_level": "A1",
          "word_slugs": [
            "sedile-noun"
          ]
        },
        {
          "id": "5452838",
          "text": "Abbiamo occupato per te un sedile.",
          "translation": "Мы заняли для тебя сиденье.",
          "source": "Tatoeba #5452838 @dnnywld / #3365911 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452838",
          "cefr_level": "A1",
          "word_slugs": [
            "sedile-noun"
          ]
        },
        {
          "id": "5913018",
          "text": "Il conducente si sedette sul sedile anteriore.",
          "translation": "Водитель сел на переднее сиденье.",
          "source": "Tatoeba #5913018 @dnnywld / #5911376 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913018",
          "cefr_level": "A1",
          "word_slugs": [
            "sedile-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
