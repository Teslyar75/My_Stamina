      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1578335",
          "text": "Non spreco munizioni.",
          "translation": "Я не разбазариваю патроны.",
          "source": "Tatoeba #1578335 @Guybrush88 / #1576635 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1578335",
          "cefr_level": "A1",
          "word_slugs": [
            "munizioni-noun"
          ]
        },
        {
          "id": "1578336",
          "text": "Io non spreco munizioni.",
          "translation": "Я не разбазариваю патроны.",
          "source": "Tatoeba #1578336 @Guybrush88 / #1576635 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1578336",
          "cefr_level": "A1",
          "word_slugs": [
            "munizioni-noun"
          ]
        },
        {
          "id": "10854319",
          "text": "Le munizioni costano care.",
          "translation": "Боеприпасы дорого стоят.",
          "source": "Tatoeba #10854319 @dnnywld / #4122845 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854319",
          "cefr_level": "A1",
          "word_slugs": [
            "munizioni-noun"
          ]
        },
        {
          "id": "3601958",
          "text": "Abbiamo finito le munizioni.",
          "translation": "У нас закончились боеприпасы.",
          "source": "Tatoeba #3601958 @Guybrush88 / #5110936 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3601958",
          "cefr_level": "A1",
          "word_slugs": [
            "munizioni-noun"
          ]
        },
        {
          "id": "5900673",
          "text": "Lui voleva armi e munizioni.",
          "translation": "Он хотел только оружия и боеприпасов.",
          "source": "Tatoeba #5900673 @dnnywld / #5900496 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5900673",
          "cefr_level": "A1",
          "word_slugs": [
            "munizioni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
