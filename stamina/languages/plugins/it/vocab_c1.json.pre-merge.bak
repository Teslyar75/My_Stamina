      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13990946",
          "text": "Chi ti ha impedito di ridere?",
          "translation": "Кто запрещал тебе смеяться?",
          "source": "Tatoeba #13990946 @dnnywld / #13990641 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13990946",
          "cefr_level": "A1",
          "word_slugs": [
            "impedito-adj"
          ]
        },
        {
          "id": "5447557",
          "text": "L'orgoglio le ha impedito di chiedere aiuto agli altri.",
          "translation": "Гордость мешала ей попросить других о помощи.",
          "source": "Tatoeba #5447557 @dnnywld / #5446638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5447557",
          "cefr_level": "A1",
          "word_slugs": [
            "impedito-adj"
          ]
        },
        {
          "id": "5447559",
          "text": "L'orgoglio gli ha impedito di chiedere aiuto agli altri.",
          "translation": "Гордость мешала ему попросить других о помощи.",
          "source": "Tatoeba #5447559 @dnnywld / #5446637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5447559",
