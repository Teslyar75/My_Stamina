    {
      "slug": "nonni-noun",
      "lemma": "nonni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8098,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10713198",
          "text": "I miei nonni sono morti.",
          "translation": "Мои бабушка и дедушка умерли.",
          "source": "Tatoeba #10713198 @carlosalberto / #10714517 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10713198",
          "cefr_level": "A1",
          "word_slugs": [
            "nonni-noun"
          ]
        },
        {
          "id": "3083826",
          "text": "È la casa dei miei nonni.",
          "translation": "Это дом моих бабушки и дедушки.",
          "source": "Tatoeba #3083826 @rado / #3083829 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3083826",
          "cefr_level": "A1",
          "word_slugs": [
            "nonni-noun"
          ]
        },
        {
          "id": "5987156",
          "text": "Stiamo scrivendo una lunga lettera ai nonni.",
          "translation": "Мы пишем бабушке и дедушке длинное письмо.",
          "source": "Tatoeba #5987156 @dnnywld / #5986675 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5987156",
          "cefr_level": "A1",
          "word_slugs": [
            "nonni-noun"
          ]
        },
        {
          "id": "6378016",
          "text": "Io e Tom siamo i nonni di Mary.",
          "translation": "Мы с Томом - бабушка и дедушка Мэри.",
          "source": "Tatoeba #6378016 @dnnywld / #6377870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6378016",
          "cefr_level": "A1",
          "word_slugs": [
            "nonni-noun"
          ]
        },
        {
          "id": "5397145",
          "text": "I miei nonni avevano una casa a Boston.",
          "translation": "У моих дедушки и бабушки был дом в Бостоне.",
          "source": "Tatoeba #5397145 @dnnywld / #5397045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5397145",
          "cefr_level": "A1",
          "word_slugs": [
            "nonni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il nonni",
        "plural": "",
        "infinitive": ""
      }
    },
