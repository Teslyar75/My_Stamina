    {
      "slug": "conoscessi-verb",
      "lemma": "conoscessi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7691,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5504481",
          "text": "Pensavo che tu conoscessi Tom.",
          "translation": "Я думал, ты знаком с Томом.",
          "source": "Tatoeba #5504481 @dnnywld / #5504276 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504481",
          "cefr_level": "A1",
          "word_slugs": [
            "conoscessi-verb"
          ]
        },
        {
          "id": "5493194",
          "text": "Tom pensava che conoscessi Mary.",
          "translation": "Том думал, что я знаком с Мэри.",
          "source": "Tatoeba #5493194 @Guybrush88 / #6893351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5493194",
          "cefr_level": "A1",
          "word_slugs": [
            "conoscessi-verb"
          ]
        },
        {
          "id": "5534345",
          "text": "Vorrei che tu conoscessi qualcuno.",
          "translation": "Я хочу, чтобы ты с кем-нибудь познакомился.",
          "source": "Tatoeba #5534345 @dnnywld / #5533566 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5534345",
          "cefr_level": "A1",
          "word_slugs": [
            "conoscessi-verb"
          ]
        },
        {
          "id": "12385543",
          "text": "È come se ti conoscessi da una vita.",
          "translation": "Такое чувство, что я знал тебя всю жизнь.",
          "source": "Tatoeba #12385543 @Bernie75 / #12385533 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12385543",
          "cefr_level": "A1",
          "word_slugs": [
            "conoscessi-verb"
          ]
        },
        {
          "id": "5529073",
          "text": "Non mi aspettavo che tu conoscessi così bene il francese.",
          "translation": "Я и не знал, что ты так хорошо знаешь французский.",
          "source": "Tatoeba #5529073 @dnnywld / #5141410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5529073",
          "cefr_level": "A1",
          "word_slugs": [
            "conoscessi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "conoscessi",
        "plural": "",
        "infinitive": "conoscessi"
      }
    },
