      "examples": [
        {
          "id": "1824539",
          "text": "Ecco perché gli spettatori ti amano.",
          "translation": "Вот почему зрители тебя любят.",
          "source": "Tatoeba #1824539 @Guybrush88 / #3856074 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1824539",
