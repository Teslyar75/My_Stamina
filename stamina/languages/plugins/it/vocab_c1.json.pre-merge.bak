    {
      "slug": "finirai-verb",
      "lemma": "finirai",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5550,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10864739",
          "text": "Finirai sul patibolo.",
          "translation": "Ты закончишь на виселице.",
          "source": "Tatoeba #10864739 @dnnywld / #4957494 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10864739",
          "cefr_level": "A1",
          "word_slugs": [
            "finirai-verb"
          ]
        },
        {
          "id": "13990932",
          "text": "Finirai per essere solo.",
          "translation": "Ты закончишь в одиночестве.",
          "source": "Tatoeba #13990932 @dnnywld / #13990686 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13990932",
          "cefr_level": "A1",
          "word_slugs": [
            "finirai-verb"
          ]
        },
        {
          "id": "350438",
          "text": "Se non stai attento, finirai nei guai.",
          "translation": "Если ты не будешь осторожным, ты попадёшь в беду.",
          "source": "Tatoeba #350438 @martin / #3099220 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350438",
          "cefr_level": "A1",
          "word_slugs": [
            "finirai-verb"
          ]
        },
        {
          "id": "6903285",
          "text": "Se guidi la macchina così, finirai all'ospedale.",
          "translation": "Если ты так водишь машину, дело кончится больницей.",
          "source": "Tatoeba #6903285 @dnnywld / #777642 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6903285",
          "cefr_level": "A1",
          "word_slugs": [
            "finirai-verb"
          ]
        },
        {
          "id": "6864157",
          "text": "Se ritorna lo stregone e ti vede qui, finirai male.",
          "translation": "Если колдун вернётся и увидит тебя здесь, тебе несдобровать.",
          "source": "Tatoeba #6864157 @dnnywld / #6863504 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6864157",
          "cefr_level": "A1",
          "word_slugs": [
            "finirai-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "finirai",
        "plural": "",
        "infinitive": "finirai"
      }
    },
    {
      "slug": "cambiate-adj",
      "lemma": "cambiate",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5551,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5472343",
          "text": "Le leggi sono cambiate.",
          "translation": "Законы изменились.",
          "source": "Tatoeba #5472343 @dnnywld / #4773536 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472343",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiate-adj"
          ]
        },
        {
          "id": "5472439",
          "text": "Sono cambiate poche cose.",
          "translation": "Мало что изменилось.",
          "source": "Tatoeba #5472439 @dnnywld / #4773491 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472439",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiate-adj"
          ]
        },
        {
          "id": "6828342",
          "text": "Cambiate tono, per favore.",
          "translation": "Смените тон, пожалуйста.",
          "source": "Tatoeba #6828342 @dnnywld / #6827881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6828342",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiate-adj"
          ]
        },
        {
          "id": "3137523",
          "text": "Cambiate ciò che bisogna cambiare.",
          "translation": "Изменяйте то, что нужно изменить.",
          "source": "Tatoeba #3137523 @Guybrush88 / #3265247 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3137523",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiate-adj"
          ]
        },
        {
          "id": "6918244",
          "text": "Cambiate la lampadina, per favore.",
          "translation": "Поменяйте лампочку, пожалуйста.",
          "source": "Tatoeba #6918244 @dnnywld / #6917888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6918244",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiate-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
