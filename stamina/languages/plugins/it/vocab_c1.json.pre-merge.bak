    {
      "slug": "cittadina-adj",
      "lemma": "cittadina",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6714,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5502758",
          "text": "È una piccola cittadina.",
          "translation": "Городок маленький.",
          "source": "Tatoeba #5502758 @dnnywld / #5501863 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5502758",
          "cefr_level": "A1",
          "word_slugs": [
            "cittadina-adj"
          ]
        },
        {
          "id": "5662286",
          "text": "Tom lavora alla biblioteca cittadina.",
          "translation": "Мэри работает в городской библиотеке.",
          "source": "Tatoeba #5662286 @dnnywld / #5661055 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662286",
          "cefr_level": "A1",
          "word_slugs": [
            "cittadina-adj"
          ]
        },
        {
          "id": "5673258",
          "text": "Lui vive in una piccola cittadina di provincia.",
          "translation": "Он живёт в небольшом провинциальном городке.",
          "source": "Tatoeba #5673258 @dnnywld / #5672873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5673258",
          "cefr_level": "A1",
          "word_slugs": [
            "cittadina-adj"
          ]
        },
        {
          "id": "6919157",
          "text": "Preferireste vivere in una grande città o in una piccola cittadina?",
          "translation": "Вы бы предпочли жить в большом городе или в маленьком городке?",
          "source": "Tatoeba #6919157 @dnnywld / #6918363 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919157",
          "cefr_level": "A1",
          "word_slugs": [
            "cittadina-adj"
          ]
        },
        {
          "id": "6919158",
          "text": "Preferiresti vivere in una grande città o in una piccola cittadina?",
          "translation": "Ты бы предпочёл жить в большом городе или в маленьком городке?",
