          ]
        },
        {
          "id": "5389023",
          "text": "Non ascoltare i pettegolezzi.",
          "translation": "Не слушай сплетни.",
          "source": "Tatoeba #5389023 @dnnywld / #5389004 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389023",
          "cefr_level": "A1",
          "word_slugs": [
            "pettegolezzi-noun"
          ]
        },
        {
          "id": "7031287",
          "text": "Non presto attenzione ai pettegolezzi.",
          "translation": "Я не обращаю внимания на сплетни.",
          "source": "Tatoeba #7031287 @dnnywld / #7030981 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7031287",
          "cefr_level": "A1",
          "word_slugs": [
            "pettegolezzi-noun"
          ]
        },
        {
          "id": "2076727",
          "text": "A lei piacciono molto i pettegolezzi.",
          "translation": "Ей очень нравится сплетничать.",
          "source": "Tatoeba #2076727 @Sirio60 / #2842534 @izdaleka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2076727",
          "cefr_level": "A1",
          "word_slugs": [
            "pettegolezzi-noun"
          ]
        },
        {
          "id": "11463008",
          "text": "Non mettere il naso nei pettegolezzi altrui.",
          "translation": "Не суй свой нос в чужие дела.",
          "source": "Tatoeba #11463008 @Bernie75 / #3945920 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11463008",
          "cefr_level": "A1",
