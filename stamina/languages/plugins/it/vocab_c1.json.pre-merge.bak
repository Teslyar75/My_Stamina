    {
      "slug": "competizione-noun",
      "lemma": "competizione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6076,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5835410",
          "text": "La competizione si è inferocita.",
          "translation": "Состязание стало горячим.",
          "source": "Tatoeba #5835410 @dnnywld / #446883 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5835410",
          "cefr_level": "A1",
          "word_slugs": [
            "competizione-noun"
          ]
        },
        {
          "id": "6904624",
          "text": "Quindi, tiriamo le somme della nostra competizione.",
          "translation": "Итак, подводим итоги нашего конкурса.",
          "source": "Tatoeba #6904624 @dnnywld / #2468394 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904624",
          "cefr_level": "A1",
          "word_slugs": [
            "competizione-noun"
          ]
        },
        {
          "id": "7788446",
          "text": "Dov'eri quando abbiamo discusso le regole della competizione?",
          "translation": "Где ты была, когда мы обсуждали правила конкурса?",
          "source": "Tatoeba #7788446 @dnnywld / #7788352 @User55521 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7788446",
          "cefr_level": "A1",
          "word_slugs": [
            "competizione-noun"
          ]
        },
        {
          "id": "5507106",
          "text": "La squadra giapponese ha vinto la medaglia d'oro in questa competizione.",
          "translation": "В этом соревновании японская команда взяла золотую медаль.",
          "source": "Tatoeba #5507106 @dnnywld / #2856613 @Shady_arc (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507106",
          "cefr_level": "A1",
          "word_slugs": [
            "competizione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la competizione",
        "plural": "",
