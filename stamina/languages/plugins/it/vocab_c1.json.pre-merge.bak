      "examples": [
        {
          "id": "1966202",
          "text": "Che lingue parli?",
          "translation": "На каких языках ты говоришь?",
          "source": "Tatoeba #1966202 @Icetoni / #3293639 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1966202",
          "cefr_level": "A1",
          "word_slugs": [
            "lingue-noun"
          ]
        },
        {
          "id": "1003045",
          "text": "Parla dieci lingue.",
          "translation": "Она говорит на десяти языках.",
          "source": "Tatoeba #1003045 @Tradukero / #1946509 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1003045",
          "cefr_level": "A1",
          "word_slugs": [
            "lingue-noun"
          ]
        },
        {
          "id": "6559610",
          "text": "Parla sette lingue.",
          "translation": "Она говорит на семи языках.",
          "source": "Tatoeba #6559610 @Guybrush88 / #2883277 @evkon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6559610",
          "cefr_level": "A1",
          "word_slugs": [
            "lingue-noun"
          ]
        },
        {
          "id": "6559644",
          "text": "Parlo molte lingue.",
          "translation": "Я говорю на многих языках.",
          "source": "Tatoeba #6559644 @Guybrush88 / #6035915 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6559644",
          "cefr_level": "A1",
          "word_slugs": [
            "lingue-noun"
          ]
        },
        {
          "id": "5223855",
          "text": "Parlo alcune lingue.",
          "translation": "Я говорю на нескольких языках.",
          "source": "Tatoeba #5223855 @BEASY8 / #1931630 @Joseshka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5223855",
          "cefr_level": "A1",
          "word_slugs": [
            "lingue-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la lingue",
        "plural": "",
        "infinitive": ""
      }
