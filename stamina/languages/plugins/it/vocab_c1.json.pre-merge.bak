    {
      "slug": "disordine-noun",
      "lemma": "disordine",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7065,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5528623",
          "text": "Dobbiamo sistemare questo disordine.",
          "translation": "Мы должны устранить этот беспорядок.",
          "source": "Tatoeba #5528623 @dnnywld / #5528227 @djbios (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5528623",
          "cefr_level": "A1",
          "word_slugs": [
            "disordine-noun"
          ]
        },
        {
          "id": "5781935",
          "text": "Entra e non fare caso al disordine.",
          "translation": "Заходи и не обращай внимания на беспорядок.",
          "source": "Tatoeba #5781935 @dnnywld / #5781664 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5781935",
          "cefr_level": "A1",
          "word_slugs": [
            "disordine-noun"
          ]
        },
        {
          "id": "5987104",
          "text": "Scusate il disordine! Ieri sono tornato tardi.",
          "translation": "Простите за беспорядок! Я вчера поздно вернулся.",
          "source": "Tatoeba #5987104 @dnnywld / #5986761 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5987104",
          "cefr_level": "A1",
          "word_slugs": [
            "disordine-noun"
          ]
        },
        {
          "id": "5389993",
          "text": "A mamma non piace quando c'è disordine nella mia camera.",
          "translation": "Мама не любит, когда у меня в комнате беспорядок.",
          "source": "Tatoeba #5389993 @dnnywld / #5385591 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389993",
          "cefr_level": "A1",
          "word_slugs": [
            "disordine-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il disordine",
        "plural": "",
        "infinitive": ""
      }
