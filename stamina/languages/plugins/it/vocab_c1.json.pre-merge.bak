          ]
        },
        {
          "id": "6790648",
          "text": "Non mi serve la vostra approvazione per questo.",
          "translation": "Мне на это ваше разрешение не требуется.",
          "source": "Tatoeba #6790648 @dnnywld / #3292440 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790648",
          "cefr_level": "A1",
          "word_slugs": [
            "approvazione-noun"
          ]
        },
        {
          "id": "6940779",
          "text": "Il progetto ha ottenuto l'approvazione degli sponsor.",
          "translation": "Проект получил одобрение спонсоров.",
          "source": "Tatoeba #6940779 @dnnywld / #6940400 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6940779",
          "cefr_level": "A1",
          "word_slugs": [
