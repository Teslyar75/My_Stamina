      "cefr_level": "C1",
      "frequency_rank": 8728,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1876267",
          "text": "Anche se fossi un nano, sarei ancora un gigante.",
          "translation": "Даже если бы я был карликом, я всё равно был бы великаном.",
          "source": "Tatoeba #1876267 @al_ex_an_der / #1876217 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1876267",
          "cefr_level": "A1",
          "word_slugs": [
            "nano-adj"
          ]
        },
        {
          "id": "1876248",
          "text": "Europa, il gigante economico, è ancora un nano politico.",
          "translation": "Европа — экономический гигант, но по-прежнему политический карлик.",
          "source": "Tatoeba #1876248 @al_ex_an_der / #1876352 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1876248",
          "cefr_level": "A1",
          "word_slugs": [
            "nano-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
