    {
      "slug": "notturno-adj",
      "lemma": "notturno",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8151,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10870843",
          "text": "La vipera è un animale notturno.",
          "translation": "Гадюка – ночное животное.",
          "source": "Tatoeba #10870843 @dnnywld / #4020473 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10870843",
          "cefr_level": "A1",
          "word_slugs": [
            "notturno-adj"
          ]
        },
        {
          "id": "11174605",
          "text": "Sono il tuo peggior incubo notturno.",
          "translation": "Я твой самый ужасный ночной кошмар.",
          "source": "Tatoeba #11174605 @dnnywld / #11172890 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11174605",
          "cefr_level": "A1",
          "word_slugs": [
            "notturno-adj"
          ]
        },
        {
          "id": "908414",
          "text": "Le stelle luccicanti nel cielo notturno sembravano gioielli.",
          "translation": "Звезды, мерцавшие в ночном небе, выглядели как драгоценные камни.",
          "source": "Tatoeba #908414 @riccioberto / #471776 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/908414",
          "cefr_level": "A1",
          "word_slugs": [
            "notturno-adj"
          ]
        }
      ],
