    {
      "slug": "centesimo-adj",
      "lemma": "centesimo",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5685,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6113822",
          "text": "Non avevo alcun centesimo.",
          "translation": "У меня не было ни гроша.",
          "source": "Tatoeba #6113822 @dnnywld / #6109372 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6113822",
          "cefr_level": "A1",
          "word_slugs": [
            "centesimo-adj"
          ]
        },
        {
          "id": "5540400",
          "text": "Per noi conta ogni centesimo.",
          "translation": "У нас каждая копейка на счету.",
          "source": "Tatoeba #5540400 @dnnywld / #5540187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5540400",
          "cefr_level": "A1",
          "word_slugs": [
            "centesimo-adj"
          ]
        },
        {
          "id": "5538815",
          "text": "Non vedrete nemmeno un centesimo.",
          "translation": "Вы не получите ни гроша.",
          "source": "Tatoeba #5538815 @dnnywld / #5538792 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5538815",
          "cefr_level": "A1",
          "word_slugs": [
            "centesimo-adj"
          ]
        },
        {
          "id": "1969480",
          "text": "Peccato che non ho un centesimo a disposizione.",
          "translation": "Беда в том, что у меня нет ни копейки в наличии.",
          "source": "Tatoeba #1969480 @sixtynine / #1969386 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1969480",
          "cefr_level": "A1",
          "word_slugs": [
            "centesimo-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
