    {
      "slug": "trascorso-noun",
      "lemma": "trascorso",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5191,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6889766",
          "text": "Ho trascorso lì due giorni.",
          "translation": "Я провела там два дня.",
          "source": "Tatoeba #6889766 @dnnywld / #5127193 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6889766",
          "cefr_level": "A1",
          "word_slugs": [
            "trascorso-noun"
          ]
        },
        {
          "id": "6889538",
          "text": "Come hai trascorso l'estate?",
          "translation": "Как провёл лето?",
          "source": "Tatoeba #6889538 @dnnywld / #4257975 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6889538",
          "cefr_level": "A1",
          "word_slugs": [
            "trascorso-noun"
          ]
        },
        {
          "id": "6889567",
          "text": "Dove hai trascorso l'estate?",
          "translation": "Где ты провёл лето?",
          "source": "Tatoeba #6889567 @dnnywld / #4598031 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6889567",
          "cefr_level": "A1",
          "word_slugs": [
            "trascorso-noun"
          ]
        },
        {
          "id": "5548668",
          "text": "Ho trascorso tutta la guerra.",
          "translation": "Я прошел всю войну.",
          "source": "Tatoeba #5548668 @dnnywld / #5548619 @SergioChemist (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5548668",
          "cefr_level": "A1",
          "word_slugs": [
            "trascorso-noun"
          ]
        },
        {
          "id": "4312824",
          "text": "Dove hai trascorso le vacanze?",
