      "examples": [
        {
          "id": "4286084",
          "text": "Roma ha molti edifici antichi.",
          "translation": "В Риме много старинных зданий.",
          "source": "Tatoeba #4286084 @bailujia / #4286297 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4286084",
