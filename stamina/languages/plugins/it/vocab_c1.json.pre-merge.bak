    {
      "slug": "mancare-verb",
      "lemma": "mancare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7149,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "отсутствовать"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6862407",
          "text": "Tom è venuto a mancare tre mesi fa.",
          "translation": "Тома не стало три месяца назад.",
          "source": "Tatoeba #6862407 @dnnywld / #3782617 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6862407",
          "cefr_level": "A1",
          "word_slugs": [
            "mancare-verb"
          ]
        },
        {
          "id": "6861924",
          "text": "Tom è venuto a mancare il venti di ottobre.",
          "translation": "Тома не стало двадцатого октября.",
          "source": "Tatoeba #6861924 @dnnywld / #5793081 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6861924",
          "cefr_level": "A1",
          "word_slugs": [
            "mancare-verb"
          ]
        },
        {
          "id": "6884779",
          "text": "Tuo padre e tua madre sono venuti a mancare.",
          "translation": "Твоих отца и матери больше нет.",
          "source": "Tatoeba #6884779 @dnnywld / #6884151 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884779",
          "cefr_level": "A1",
          "word_slugs": [
            "mancare-verb"
          ]
        },
        {
          "id": "6884781",
          "text": "Vostro padre e Vostra madre sono venuti a mancare.",
          "translation": "Ваших отца и матери больше нет.",
          "source": "Tatoeba #6884781 @dnnywld / #6884150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884781",
          "cefr_level": "A1",
          "word_slugs": [
            "mancare-verb"
          ]
        },
        {
          "id": "5524997",
          "text": "Tom si sentì mancare quando Mary gli chiese di ballare.",
          "translation": "У Тома подкосились ноги, когда Мэри пригласила его на танец.",
          "source": "Tatoeba #5524997 @dnnywld / #5524851 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5524997",
          "cefr_level": "A1",
          "word_slugs": [
            "mancare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "mancare",
        "plural": "",
        "infinitive": "mancare"
      }
