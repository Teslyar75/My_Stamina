      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5254084",
          "text": "Mari è pazza per lo sport.",
          "translation": "Мария помешана на спорте.",
          "source": "Tatoeba #5254084 @madriot / #5254126 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5254084",
          "cefr_level": "A1",
          "word_slugs": [
            "mari-noun"
          ]
        },
        {
          "id": "6942695",
          "text": "Mari era rimasta soddisfatta del lavoro di Tom.",
