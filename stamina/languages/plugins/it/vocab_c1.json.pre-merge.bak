          ]
        },
        {
          "id": "5480255",
          "text": "Tutto stava peggiorando.",
          "translation": "Становилось всё хуже.",
          "source": "Tatoeba #5480255 @dnnywld / #3707925 @omosk (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5480255",
          "cefr_level": "A1",
          "word_slugs": [
            "peggiorando-verb"
          ]
        },
        {
          "id": "6917488",
          "text": "Tom sta peggiorando, vero?",
          "translation": "Тому хуже, да?",
          "source": "Tatoeba #6917488 @Guybrush88 / #6918138 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917488",
