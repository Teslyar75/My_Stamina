    {
      "slug": "violino-noun",
      "lemma": "violino",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8493,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "скрипка"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6944347",
          "text": "Da piccolo suonavo il violino.",
          "translation": "В детстве я играл на скрипке.",
          "source": "Tatoeba #6944347 @dnnywld / #6943831 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944347",
          "cefr_level": "A1",
          "word_slugs": [
            "violino-noun"
          ]
        },
        {
          "id": "351824",
          "text": "Tom sta suonando il violino adesso.",
          "translation": "Том сейчас играет на скрипке.",
          "source": "Tatoeba #351824 @martin / #1546951 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/351824",
          "cefr_level": "A1",
          "word_slugs": [
            "violino-noun"
          ]
        },
        {
          "id": "5572722",
          "text": "Il nostro nuovo vicino suona il violino.",
          "translation": "Наш новый сосед играет на скрипке.",
          "source": "Tatoeba #5572722 @dnnywld / #5572561 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5572722",
          "cefr_level": "A1",
          "word_slugs": [
            "violino-noun"
          ]
        },
        {
          "id": "6608940",
          "text": "Chi è quella persona che suona il violino?",
          "translation": "Кто этот человек, играющий на скрипке?",
          "source": "Tatoeba #6608940 @dnnywld / #6604133 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6608940",
          "cefr_level": "A1",
          "word_slugs": [
            "violino-noun"
          ]
        },
        {
          "id": "5551689",
          "text": "Suoni bene il violino. Chi ti ha insegnato?",
          "translation": "А ты хорошо играешь на скрипке. Кто тебя научил?",
          "source": "Tatoeba #5551689 @dnnywld / #5551666 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551689",
          "cefr_level": "A1",
          "word_slugs": [
            "violino-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il violino",
        "plural": "",
        "infinitive": ""
      }
    },
