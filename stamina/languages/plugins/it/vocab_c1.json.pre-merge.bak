      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3679888",
          "text": "C'è una fontana di fronte alla stazione.",
          "translation": "Перед вокзалом есть фонтан.",
          "source": "Tatoeba #3679888 @Guybrush88 / #600563 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3679888",
          "cefr_level": "A1",
          "word_slugs": [
            "fontana-noun"
          ]
        },
        {
          "id": "2977223",
          "text": "L'acqua in questa fontana è molto fredda.",
          "translation": "Вода в этом фонтане очень холодная.",
          "source": "Tatoeba #2977223 @Guybrush88 / #4386927 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2977223",
          "cefr_level": "A1",
          "word_slugs": [
            "fontana-noun"
          ]
        },
        {
          "id": "2193572",
          "text": "Al centro della città si trova una fontana.",
          "translation": "В центре города есть фонтан.",
          "source": "Tatoeba #2193572 @miccap / #10302600 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2193572",
          "cefr_level": "A1",
          "word_slugs": [
            "fontana-noun"
          ]
        },
        {
          "id": "4300050",
          "text": "L'acqua che sgorga dalla fontana è limpida.",
          "translation": "Вода, бьющая из фонтана, чистая.",
          "source": "Tatoeba #4300050 @aldolit58 / #4300126 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4300050",
          "cefr_level": "A1",
          "word_slugs": [
            "fontana-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
