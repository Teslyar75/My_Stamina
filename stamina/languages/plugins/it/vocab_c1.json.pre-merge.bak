    {
      "slug": "cenare-verb",
      "lemma": "cenare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5373,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "940960",
          "text": "Ho già finito di cenare.",
          "translation": "Я уже закончил ужинать.",
          "source": "Tatoeba #940960 @zhou24 / #3175734 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/940960",
          "cefr_level": "A1",
          "word_slugs": [
            "cenare-verb"
          ]
        },
        {
          "id": "5675834",
          "text": "Non vuoi cenare da me oggi?",
          "translation": "Не хочешь сегодня поужинать у меня?",
          "source": "Tatoeba #5675834 @dnnywld / #5675437 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5675834",
          "cefr_level": "A1",
          "word_slugs": [
            "cenare-verb"
          ]
        },
        {
          "id": "2933065",
          "text": "Che ne dici di cenare assieme?",
          "translation": "Как насчет поужинать вместе?",
          "source": "Tatoeba #2933065 @Guybrush88 / #990015 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2933065",
          "cefr_level": "A1",
          "word_slugs": [
            "cenare-verb"
          ]
        },
        {
          "id": "6963697",
          "text": "Perché non sei venuto a cenare?",
          "translation": "Почему ты не пришёл поужинать?",
          "source": "Tatoeba #6963697 @dnnywld / #6963590 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6963697",
          "cefr_level": "A1",
          "word_slugs": [
            "cenare-verb"
          ]
        },
        {
          "id": "11856738",
          "text": "Vorrei cenare con te qualche volta.",
          "translation": "Я хотел бы с тобой как-нибудь поужинать.",
          "source": "Tatoeba #11856738 @dnnywld / #11855437 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11856738",
          "cefr_level": "A1",
          "word_slugs": [
            "cenare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cenare",
        "plural": "",
        "infinitive": "cenare"
      }
    },
