          ]
        },
        {
          "id": "13901772",
          "text": "Io sono un'intelligenza artificiale.",
          "translation": "Я – искусственный интеллект.",
          "source": "Tatoeba #13901772 @Adelpa / #13901779 @Adelpa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13901772",
          "cefr_level": "A1",
          "word_slugs": [
