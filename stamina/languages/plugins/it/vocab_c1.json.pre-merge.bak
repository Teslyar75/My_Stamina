    {
      "slug": "parlerai-verb",
      "lemma": "parlerai",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9637,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5250012",
          "text": "Parlerai con Tom?",
          "translation": "Ты не поговоришь с Томом?",
          "source": "Tatoeba #5250012 @Guybrush88 / #5924706 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5250012",
          "cefr_level": "A1",
          "word_slugs": [
            "parlerai-verb"
          ]
        },
        {
          "id": "5498154",
          "text": "Gliene parlerai quando lui tornerà a casa?",
          "translation": "Ты скажешь ему об этом, когда он придёт домой?",
          "source": "Tatoeba #5498154 @dnnywld / #5146626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5498154",
          "cefr_level": "A1",
          "word_slugs": [
            "parlerai-verb"
          ]
        },
        {
          "id": "5800816",
          "text": "Spero che tu non ne parlerai con Tom.",
          "translation": "Надеюсь, ты не скажешь об этом Тому.",
          "source": "Tatoeba #5800816 @dnnywld / #5800324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5800816",
          "cefr_level": "A1",
          "word_slugs": [
            "parlerai-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "parlerai",
        "plural": "",
        "infinitive": "parlerai"
      }
    },
    {
      "slug": "difeso-adj",
      "lemma": "difeso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9638,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5672617",
          "text": "Mi sono difeso.",
          "translation": "Я защитился.",
          "source": "Tatoeba #5672617 @dnnywld / #5672549 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672617",
          "cefr_level": "A1",
          "word_slugs": [
            "difeso-adj"
          ]
        },
        {
          "id": "5678580",
          "text": "Il campione ha difeso con successo il suo titolo.",
          "translation": "Чемпион успешно отстоял свой титул.",
          "source": "Tatoeba #5678580 @dnnywld / #5678399 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5678580",
          "cefr_level": "A1",
          "word_slugs": [
            "difeso-adj"
          ]
        },
        {
          "id": "13734534",
          "text": "Lo hai difeso più di chiunque altro, e adesso? Hai cambiato idea?",
          "translation": "Ты его чуть не ли не громче всех защищал, а теперь что? Передумал?",
          "source": "Tatoeba #13734534 @carlosalberto / #13734266 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13734534",
          "cefr_level": "A1",
          "word_slugs": [
            "difeso-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il difeso",
        "plural": "",
        "infinitive": ""
      }
    },
