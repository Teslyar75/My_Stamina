          ]
        },
        {
          "id": "10867105",
          "text": "Guardate di non organizzare fuochi.",
          "translation": "Смотрите пожар не устройте.",
          "source": "Tatoeba #10867105 @dnnywld / #10865275 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10867105",
          "cefr_level": "A1",
          "word_slugs": [
