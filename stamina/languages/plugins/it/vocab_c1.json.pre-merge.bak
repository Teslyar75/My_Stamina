        {
          "id": "5497033",
          "text": "Non pagherò per voi.",
          "translation": "Я не буду за вас платить.",
          "source": "Tatoeba #5497033 @dnnywld / #5497007 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497033",
          "cefr_level": "A1",
          "word_slugs": [
            "pagherò-noun"
          ]
        },
        {
          "id": "6767918",
          "text": "No, pagherò io per questo.",
          "translation": "Нет, я за это заплачу.",
          "source": "Tatoeba #6767918 @dnnywld / #6767442 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6767918",
          "cefr_level": "A1",
          "word_slugs": [
            "pagherò-noun"
          ]
        },
        {
          "id": "5592430",
          "text": "Io pagherò per i biglietti.",
          "translation": "Я заплачу за билеты.",
          "source": "Tatoeba #5592430 @dnnywld / #5592358 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5592430",
