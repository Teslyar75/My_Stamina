          ]
        },
        {
          "id": "5427040",
          "text": "Ho fatto qualche progresso.",
          "translation": "Некоторый прогресс у меня есть.",
          "source": "Tatoeba #5427040 @Guybrush88 / #4632067 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5427040",
          "cefr_level": "A1",
          "word_slugs": [
            "progresso-noun"
          ]
        },
        {
          "id": "5942804",
          "text": "Hai fatto qualche altro progresso?",
          "translation": "У тебя есть ещё какие-то успехи?",
          "source": "Tatoeba #5942804 @dnnywld / #5942025 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5942804",
          "cefr_level": "A1",
          "word_slugs": [
            "progresso-noun"
          ]
        },
        {
          "id": "10881842",
          "text": "La pigrizia è il motore del progresso.",
          "translation": "Лень - двигатель прогресса.",
          "source": "Tatoeba #10881842 @dnnywld / #2029821 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10881842",
          "cefr_level": "A1",
          "word_slugs": [
            "progresso-noun"
          ]
        },
        {
          "id": "12998087",
          "text": "Sono passati tre giorni e non abbiamo fatto alcun progresso.",
          "translation": "Прошло трое суток, а мы ни на шаг не продвинулись.",
          "source": "Tatoeba #12998087 @carlosalberto / #12998054 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12998087",
          "cefr_level": "A1",
          "word_slugs": [
            "progresso-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il progresso",
        "plural": "",
        "infinitive": ""
      }
    },
