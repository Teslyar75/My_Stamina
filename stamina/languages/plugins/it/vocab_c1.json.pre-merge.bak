    {
      "slug": "trasforma-verb",
      "lemma": "trasforma",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7776,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "9039892",
          "text": "L'uva si trasforma in vino.",
          "translation": "Виноград превращается в вино.",
          "source": "Tatoeba #9039892 @Valdast / #8609819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9039892",
          "cefr_level": "A1",
          "word_slugs": [
            "trasforma-verb"
          ]
        },
        {
          "id": "5512107",
          "text": "Sciogliendosi, il ghiaccio si trasforma in acqua.",
          "translation": "Тая, лёд превращается в воду.",
          "source": "Tatoeba #5512107 @dnnywld / #5511113 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512107",
          "cefr_level": "A1",
          "word_slugs": [
            "trasforma-verb"
          ]
        },
        {
          "id": "379771",
          "text": "Un motore a vapore trasforma il calore in energia.",
          "translation": "Паровой двигатель преобразует тепло в энергию.",
          "source": "Tatoeba #379771 @Pharamp / #5722456 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379771",
          "cefr_level": "A1",
          "word_slugs": [
            "trasforma-verb"
          ]
        },
        {
          "id": "965644",
          "text": "Dopo la morte la mia anima si trasforma nel nulla.",
          "translation": "После смерти моя душа обратится в небытие.",
          "source": "Tatoeba #965644 @riccioberto / #683594 @debian2007 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/965644",
          "cefr_level": "A1",
          "word_slugs": [
            "trasforma-verb"
          ]
        },
        {
          "id": "5554130",
          "text": "A volte mia moglie si trasforma in una bestia feroce.",
          "translation": "Временами моя жена превращается в злобного зверя.",
          "source": "Tatoeba #5554130 @dnnywld / #5554099 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5554130",
          "cefr_level": "A1",
          "word_slugs": [
            "trasforma-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "trasforma",
        "plural": "",
        "infinitive": "trasforma"
      }
