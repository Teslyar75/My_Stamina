    {
      "slug": "cominciano-verb",
      "lemma": "cominciano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8117,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10876172",
          "text": "Le mele cominciano a marcire.",
          "translation": "Яблоки начинают гнить.",
          "source": "Tatoeba #10876172 @dnnywld / #5176094 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10876172",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciano-verb"
          ]
        },
        {
          "id": "6910779",
          "text": "In Europa le attività cominciano in settembre.",
          "translation": "В Европе занятия начинаются в сентябре.",
          "source": "Tatoeba #6910779 @dnnywld / #6909515 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6910779",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciano-verb"
          ]
        },
        {
          "id": "6698248",
          "text": "Le lezioni a scuola cominciano il prossimo lunedì.",
          "translation": "Занятия в школе начинаются в следующий понедельник.",
          "source": "Tatoeba #6698248 @dnnywld / #6698239 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698248",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciano-verb"
          ]
        },
        {
          "id": "5869990",
          "text": "A che età di solito i bambini cominciano a camminare?",
          "translation": "В каком возрасте дети обычно начинают ходить?",
          "source": "Tatoeba #5869990 @dnnywld / #5869986 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5869990",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciano-verb"
          ]
        },
        {
          "id": "5985640",
          "text": "Cosa si deve fare quando al paziente cominciano le convulsioni?",
          "translation": "Что надо делать, когда у пациента начинаются конвульсии?",
          "source": "Tatoeba #5985640 @dnnywld / #4022928 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5985640",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cominciano",
        "plural": "",
        "infinitive": "cominciano"
      }
    },
    {
      "slug": "musicista-noun",
