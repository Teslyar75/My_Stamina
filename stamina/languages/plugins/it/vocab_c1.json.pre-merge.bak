    {
      "slug": "chiacchierare-verb",
      "lemma": "chiacchierare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8178,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13136129",
          "text": "Basta chiacchierare, va bene?",
          "translation": "Хватит болтать, ладно?",
          "source": "Tatoeba #13136129 @dnnywld / #13134958 @atitarev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13136129",
          "cefr_level": "A1",
          "word_slugs": [
            "chiacchierare-verb"
          ]
        },
        {
          "id": "6025011",
          "text": "Basta, smetti di chiacchierare! Dormiamo!",
          "translation": "Всё, хватит болтать! Спим!",
          "source": "Tatoeba #6025011 @dnnywld / #6024580 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6025011",
          "cefr_level": "A1",
          "word_slugs": [
            "chiacchierare-verb"
          ]
        },
        {
          "id": "5692524",
          "text": "Smettete di chiacchierare e tornate al lavoro.",
          "translation": "Перестаньте разговаривать и вернитесь к работе.",
          "source": "Tatoeba #5692524 @dnnywld / #5692521 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5692524",
          "cefr_level": "A1",
          "word_slugs": [
            "chiacchierare-verb"
          ]
        },
        {
          "id": "6857385",
          "text": "Preferireste tradurre delle frasi, piuttosto che chiacchierare con me.",
          "translation": "Вы предпочли бы переводить фразы, вместо того чтобы болтать со мной.",
          "source": "Tatoeba #6857385 @dnnywld / #544820 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857385",
          "cefr_level": "A1",
          "word_slugs": [
            "chiacchierare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "chiacchierare",
        "plural": "",
        "infinitive": "chiacchierare"
      }
    },
    {
      "slug": "cadendo-verb",
      "lemma": "cadendo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8179,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5512430",
          "text": "Lui sta cadendo.",
          "translation": "Он падает.",
          "source": "Tatoeba #5512430 @dnnywld / #1419027 @tien_oroniel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512430",
          "cefr_level": "A1",
          "word_slugs": [
            "cadendo-verb"
          ]
        },
        {
          "id": "5512575",
          "text": "Si è ferito cadendo.",
          "translation": "Он поранился, когда падал.",
          "source": "Tatoeba #5512575 @dnnywld / #5412209 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512575",
          "cefr_level": "A1",
          "word_slugs": [
            "cadendo-verb"
          ]
        },
        {
          "id": "5512427",
          "text": "Una foglia sta cadendo.",
          "translation": "Лист падает.",
          "source": "Tatoeba #5512427 @dnnywld / #1418996 @tien_oroniel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512427",
          "cefr_level": "A1",
          "word_slugs": [
            "cadendo-verb"
          ]
        },
        {
          "id": "5512428",
          "text": "Le foglie stanno cadendo.",
          "translation": "Листья падают.",
          "source": "Tatoeba #5512428 @dnnywld / #1419001 @tien_oroniel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512428",
          "cefr_level": "A1",
          "word_slugs": [
            "cadendo-verb"
          ]
        },
        {
          "id": "5868606",
          "text": "Cadendo, lui si è fatto male al ginocchio.",
          "translation": "Падая, он повредил колено.",
          "source": "Tatoeba #5868606 @dnnywld / #5783770 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868606",
          "cefr_level": "A1",
          "word_slugs": [
            "cadendo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cadendo",
        "plural": "",
        "infinitive": "cadendo"
      }
    },
    {
      "slug": "panna-noun",
      "lemma": "panna",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8180,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3340890",
          "text": "La panna è fresca?",
          "translation": "Сливки свежие?",
          "source": "Tatoeba #3340890 @bailujia / #3340904 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3340890",
          "cefr_level": "A1",
          "word_slugs": [
            "panna-noun"
          ]
        },
        {
          "id": "2793109",
          "text": "Le fragole con la panna sono deliziose.",
          "translation": "Клубника со сливками очень вкусная.",
          "source": "Tatoeba #2793109 @Guybrush88 / #3337583 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2793109",
          "cefr_level": "A1",
          "word_slugs": [
            "panna-noun"
          ]
        },
        {
          "id": "2991406",
          "text": "Ho bisogno di duecentocinquanta millilitri di panna.",
          "translation": "Мне нужно двести пятьдесят миллилитров сливок.",
          "source": "Tatoeba #2991406 @al_ex_an_der / #2991390 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2991406",
          "cefr_level": "A1",
          "word_slugs": [
            "panna-noun"
          ]
        },
        {
          "id": "2989599",
          "text": "Il latticello è il sottoprodotto della trasformazione in burro della panna.",
          "translation": "Пахта – побочный продукт при производстве масла из сливок.",
          "source": "Tatoeba #2989599 @al_ex_an_der / #2989648 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2989599",
          "cefr_level": "A1",
          "word_slugs": [
            "panna-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la panna",
        "plural": "",
        "infinitive": ""
      }
