    {
      "slug": "negare-verb",
      "lemma": "negare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6597,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4511841",
          "text": "Nessuno lo può negare.",
          "translation": "Никто не может это отрицать.",
          "source": "Tatoeba #4511841 @Guybrush88 / #4509788 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4511841",
          "cefr_level": "A1",
          "word_slugs": [
            "negare-verb"
          ]
        },
        {
          "id": "5705967",
          "text": "Non posso negare questo.",
          "translation": "Не могу этого отрицать.",
          "source": "Tatoeba #5705967 @dnnywld / #5705713 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5705967",
          "cefr_level": "A1",
          "word_slugs": [
            "negare-verb"
          ]
        },
        {
          "id": "5624272",
          "text": "Negare l'ovvio è stupido.",
          "translation": "Отрицать очевидное - глупо.",
          "source": "Tatoeba #5624272 @dnnywld / #5623664 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624272",
          "cefr_level": "A1",
          "word_slugs": [
            "negare-verb"
          ]
        },
        {
          "id": "5913007",
          "text": "Puoi non negare, so tutto.",
          "translation": "Можешь не отпираться, я всё знаю.",
          "source": "Tatoeba #5913007 @dnnywld / #5911383 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913007",
          "cefr_level": "A1",
          "word_slugs": [
            "negare-verb"
          ]
        },
        {
          "id": "5913008",
          "text": "Puoi non negare le tue colpe, so già tutto.",
          "translation": "Можешь не отпираться, я всё знаю.",
          "source": "Tatoeba #5913008 @dnnywld / #5911383 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913008",
          "cefr_level": "A1",
          "word_slugs": [
            "negare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "negare",
        "plural": "",
        "infinitive": "negare"
      }
    },
