    {
      "slug": "apparso-verb",
      "lemma": "apparso",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9313,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6329737",
          "text": "È apparso il mare.",
          "translation": "Появилось море.",
          "source": "Tatoeba #6329737 @dnnywld / #6329101 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6329737",
          "cefr_level": "A1",
          "word_slugs": [
            "apparso-verb"
          ]
        },
        {
          "id": "7275423",
          "text": "Questo concetto è apparso relativamente di recente.",
          "translation": "Это понятие появилось сравнительно недавно.",
          "source": "Tatoeba #7275423 @dnnywld / #7275279 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275423",
          "cefr_level": "A1",
          "word_slugs": [
            "apparso-verb"
          ]
        },
        {
          "id": "5507034",
          "text": "Nei suoi occhi è apparso un bagliore di gioia.",
          "translation": "В его глазах появился радостный блеск.",
          "source": "Tatoeba #5507034 @dnnywld / #381032 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507034",
          "cefr_level": "A1",
          "word_slugs": [
            "apparso-verb"
          ]
        },
        {
          "id": "5614494",
          "text": "Quando e come è apparso questo messaggio nella bottiglia?",
          "translation": "Когда и как появилась бутылочная почта?",
          "source": "Tatoeba #5614494 @dnnywld / #2161783 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614494",
          "cefr_level": "A1",
          "word_slugs": [
            "apparso-verb"
          ]
        },
        {
          "id": "5966013",
          "text": "La mattina dopo il suo nome è apparso su tutti i giornali.",
          "translation": "Наутро его имя появилось во всех газетах.",
          "source": "Tatoeba #5966013 @dnnywld / #5965532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5966013",
          "cefr_level": "A1",
          "word_slugs": [
            "apparso-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "apparso",
        "plural": "",
        "infinitive": "apparso"
      }
    },
    {
      "slug": "ricordano-verb",
      "lemma": "ricordano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9314,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "936486",
          "text": "Queste fotografie mi ricordano la nostra vacanza.",
          "translation": "Эти фотографии напоминают мне о нашем отпуске.",
          "source": "Tatoeba #936486 @Guybrush88 / #6827846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/936486",
          "cefr_level": "A1",
          "word_slugs": [
            "ricordano-verb"
          ]
        },
        {
          "id": "6743514",
          "text": "Le farfalle ci ricordano che tutto al mondo cambia.",
          "translation": "Бабочки напоминают нам, что всё в жизни меняется.",
          "source": "Tatoeba #6743514 @dnnywld / #6742919 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6743514",
          "cefr_level": "A1",
          "word_slugs": [
            "ricordano-verb"
          ]
        },
        {
          "id": "5559820",
          "text": "Le persone più anziane ricordano ancora l'assassinio di Kennedy.",
          "translation": "Люди постарше ещё помнят убийство Кеннеди.",
          "source": "Tatoeba #5559820 @dnnywld / #5559784 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5559820",
          "cefr_level": "A1",
          "word_slugs": [
            "ricordano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ricordano",
        "plural": "",
        "infinitive": "ricordano"
      }
