        {
          "id": "842577",
          "text": "Gli Stati Uniti sono una repubblica.",
          "translation": "США — это республика.",
          "source": "Tatoeba #842577 @Guybrush88 / #7306746 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/842577",
          "cefr_level": "A1",
          "word_slugs": [
            "repubblica-noun"
          ]
        },
        {
          "id": "3195204",
          "text": "Siamo noi la repubblica delle banane!",
          "translation": "Мы - банановая республика!",
          "source": "Tatoeba #3195204 @Guybrush88 / #3195211 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3195204",
          "cefr_level": "A1",
          "word_slugs": [
            "repubblica-noun"
          ]
        },
        {
          "id": "2458125",
          "text": "Cosa sapete sulla Repubblica Democratica Tedesca?",
          "translation": "Что вы знаете о ГДР?",
          "source": "Tatoeba #2458125 @al_ex_an_der / #2458127 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2458125",
          "cefr_level": "A1",
          "word_slugs": [
            "repubblica-noun"
          ]
        },
        {
          "id": "3166530",
          "text": "Ma questa è la repubblica delle banane!",
          "translation": "Но это банановая республика!",
          "source": "Tatoeba #3166530 @Guybrush88 / #3335870 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3166530",
          "cefr_level": "A1",
          "word_slugs": [
            "repubblica-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
