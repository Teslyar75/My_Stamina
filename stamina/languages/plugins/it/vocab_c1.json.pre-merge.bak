      "slug": "carrozza-noun",
      "lemma": "carrozza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5843,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10856350",
          "text": "La carrozza era vuota.",
          "translation": "Вагон был пустой.",
          "source": "Tatoeba #10856350 @dnnywld / #6146771 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10856350",
          "cefr_level": "A1",
          "word_slugs": [
            "carrozza-noun"
          ]
        },
        {
          "id": "10856349",
          "text": "La nostra carrozza è la nona.",
          "translation": "Наш вагон — девятый.",
          "source": "Tatoeba #10856349 @dnnywld / #5384498 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10856349",
          "cefr_level": "A1",
          "word_slugs": [
            "carrozza-noun"
          ]
        },
        {
          "id": "10856352",
          "text": "Le porte della carrozza si chiusero.",
          "translation": "Двери вагона закрылись.",
          "source": "Tatoeba #10856352 @dnnywld / #10084799 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10856352",
          "cefr_level": "A1",
          "word_slugs": [
            "carrozza-noun"
          ]
        },
        {
          "id": "10856353",
          "text": "Le porte della carrozza si aprirono.",
          "translation": "Двери вагона открылись.",
          "source": "Tatoeba #10856353 @dnnywld / #10084800 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10856353",
          "cefr_level": "A1",
          "word_slugs": [
            "carrozza-noun"
          ]
        },
        {
          "id": "5495813",
          "text": "Il treno si fermò e i passeggeri scesero dalla carrozza.",
          "translation": "Поезд остановился, и пассажиры вышли из вагона.",
          "source": "Tatoeba #5495813 @dnnywld / #5495692 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5495813",
          "cefr_level": "A1",
          "word_slugs": [
            "carrozza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la carrozza",
        "plural": "",
        "infinitive": ""
      }
