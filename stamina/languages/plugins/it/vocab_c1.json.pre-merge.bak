    {
      "slug": "sconosciuti-adj",
      "lemma": "sconosciuti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6450,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5913980",
          "text": "La mamma non mi permette di parlare con degli sconosciuti.",
          "translation": "Мама не разрешает мне разговаривать с незнакомыми людьми.",
          "source": "Tatoeba #5913980 @dnnywld / #4138972 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913980",
          "cefr_level": "A1",
          "word_slugs": [
            "sconosciuti-adj"
          ]
        },
        {
          "id": "5913978",
          "text": "La mamma non mi permette di conversare con degli sconosciuti.",
          "translation": "Мама не разрешает мне разговаривать с незнакомыми людьми.",
          "source": "Tatoeba #5913978 @dnnywld / #4138972 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913978",
          "cefr_level": "A1",
          "word_slugs": [
            "sconosciuti-adj"
          ]
        },
        {
          "id": "6809493",
          "text": "A dire il vero, non mi piace parlare con gli sconosciuti.",
          "translation": "По правде говоря, я не люблю говорить с незнакомцами.",
          "source": "Tatoeba #6809493 @dnnywld / #6808504 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6809493",
          "cefr_level": "A1",
          "word_slugs": [
