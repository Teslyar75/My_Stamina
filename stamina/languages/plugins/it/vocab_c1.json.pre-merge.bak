    {
      "slug": "esercizio-noun",
      "lemma": "esercizio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5119,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5540576",
          "text": "Ho fatto questo esercizio.",
          "translation": "Я сделала это упражнение.",
          "source": "Tatoeba #5540576 @dnnywld / #5540369 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5540576",
          "cefr_level": "A1",
          "word_slugs": [
            "esercizio-noun"
          ]
        },
        {
          "id": "1525138",
          "text": "Nuotare è un buon esercizio.",
          "translation": "Плавание – хорошее упражнение.",
          "source": "Tatoeba #1525138 @Guybrush88 / #7011628 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1525138",
          "cefr_level": "A1",
          "word_slugs": [
            "esercizio-noun"
          ]
        },
        {
          "id": "724566",
          "text": "Ci sono errori in questo esercizio?",
          "translation": "В этом упражнении есть ошибки?",
          "source": "Tatoeba #724566 @Guybrush88 / #5659153 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/724566",
          "cefr_level": "A1",
          "word_slugs": [
            "esercizio-noun"
          ]
        },
        {
          "id": "3000158",
          "text": "L'esercizio fisico allena i muscoli.",
          "translation": "Физические упражнения тренируют мышцы.",
          "source": "Tatoeba #3000158 @Guybrush88 / #6117080 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3000158",
          "cefr_level": "A1",
          "word_slugs": [
            "esercizio-noun"
          ]
        },
        {
          "id": "7012219",
          "text": "La camminata è un eccellente esercizio.",
          "translation": "Прогулка – отличное упражнение.",
          "source": "Tatoeba #7012219 @dnnywld / #7011635 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7012219",
          "cefr_level": "A1",
          "word_slugs": [
            "esercizio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
