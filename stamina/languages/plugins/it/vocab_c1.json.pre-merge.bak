    {
      "slug": "postale-adj",
      "lemma": "postale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6686,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7846212",
          "text": "L'ufficio postale è sulla destra.",
          "translation": "Почта направо.",
          "source": "Tatoeba #7846212 @dnnywld / #7846150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7846212",
          "cefr_level": "A1",
          "word_slugs": [
            "postale-adj"
          ]
        },
        {
          "id": "5471949",
          "text": "Qui vicino c'è un ufficio postale.",
          "translation": "Неподалёку есть почтовое отделение.",
          "source": "Tatoeba #5471949 @dnnywld / #2587912 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5471949",
          "cefr_level": "A1",
          "word_slugs": [
            "postale-adj"
          ]
        },
        {
          "id": "5650700",
          "text": "Il servizio postale ha perso il pacchetto.",
          "translation": "Почтовая служба потеряла посылку.",
          "source": "Tatoeba #5650700 @dnnywld / #5650481 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650700",
          "cefr_level": "A1",
          "word_slugs": [
            "postale-adj"
          ]
        },
        {
          "id": "5662119",
          "text": "Tom è appena tornato dall'ufficio postale.",
          "translation": "Том только что вернулся с почты.",
          "source": "Tatoeba #5662119 @dnnywld / #5661422 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662119",
          "cefr_level": "A1",
          "word_slugs": [
            "postale-adj"
          ]
        },
        {
          "id": "1438383",
          "text": "Puoi comprare francobolli in qualsiasi ufficio postale.",
          "translation": "Вы можете купить марки в любом почтовом отделении.",
          "source": "Tatoeba #1438383 @Guybrush88 / #1076169 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1438383",
          "cefr_level": "A1",
          "word_slugs": [
            "postale-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
