    {
      "slug": "sfruttare-verb",
      "lemma": "sfruttare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6910,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5844977",
          "text": "Devo sfruttare questa opportunità.",
          "translation": "Я должен использовать этот шанс.",
          "source": "Tatoeba #5844977 @dnnywld / #3066572 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5844977",
          "cefr_level": "A1",
          "word_slugs": [
            "sfruttare-verb"
          ]
        },
        {
          "id": "5844988",
          "text": "Dobbiamo sfruttare questa opportunità.",
          "translation": "Мы должны использовать этот шанс.",
          "source": "Tatoeba #5844988 @dnnywld / #4121877 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5844988",
          "cefr_level": "A1",
          "word_slugs": [
            "sfruttare-verb"
          ]
        },
        {
          "id": "5843671",
          "text": "Cerca di sfruttare ogni occasione.",
          "translation": "Старайся использовать любую возможность.",
          "source": "Tatoeba #5843671 @dnnywld / #2339504 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843671",
          "cefr_level": "A1",
          "word_slugs": [
            "sfruttare-verb"
          ]
        },
        {
          "id": "5843903",
          "text": "Bisogna assolutamente sfruttare una opportunità simile!",
          "translation": "Такой шанс обязательно нужно использовать!",
          "source": "Tatoeba #5843903 @dnnywld / #2345726 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843903",
          "cefr_level": "A1",
          "word_slugs": [
            "sfruttare-verb"
          ]
        },
        {
          "id": "5843897",
          "text": "Una opportunità simile non si può non sfruttare!",
          "translation": "Такой шанс нельзя не использовать!",
          "source": "Tatoeba #5843897 @dnnywld / #2345658 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843897",
          "cefr_level": "A1",
          "word_slugs": [
            "sfruttare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sfruttare",
        "plural": "",
        "infinitive": "sfruttare"
      }
