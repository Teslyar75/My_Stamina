    {
      "slug": "tristi-adj",
      "lemma": "tristi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6239,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3352339",
          "text": "Noi siamo tristi.",
          "translation": "Нам грустно.",
          "source": "Tatoeba #3352339 @Guybrush88 / #4432330 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3352339",
          "cefr_level": "A1",
          "word_slugs": [
            "tristi-adj"
          ]
        },
        {
          "id": "6908183",
          "text": "Perché siete tristi?",
          "translation": "Почему вы грустите?",
          "source": "Tatoeba #6908183 @dnnywld / #6908005 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908183",
          "cefr_level": "A1",
          "word_slugs": [
            "tristi-adj"
          ]
        },
        {
          "id": "6908159",
          "text": "Non siete molto tristi.",
          "translation": "Вы не очень грустите.",
          "source": "Tatoeba #6908159 @dnnywld / #6908019 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908159",
          "cefr_level": "A1",
          "word_slugs": [
            "tristi-adj"
          ]
        },
        {
          "id": "3536727",
          "text": "La sua morte ha reso tutti tristi.",
          "translation": "Его смерть всех опечалила.",
          "source": "Tatoeba #3536727 @Guybrush88 / #6885930 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3536727",
          "cefr_level": "A1",
          "word_slugs": [
            "tristi-adj"
          ]
        },
        {
          "id": "6043027",
          "text": "A Tom non piace cantare canzoni tristi.",
          "translation": "Том не любит петь грустные песни.",
          "source": "Tatoeba #6043027 @dnnywld / #6039787 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6043027",
          "cefr_level": "A1",
          "word_slugs": [
            "tristi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tristi",
        "plural": "",
        "infinitive": ""
      }
