    {
      "slug": "tennis-noun",
      "lemma": "tennis",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5934,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5997515",
          "text": "Giocherò a tennis.",
          "translation": "Я буду играть в теннис.",
          "source": "Tatoeba #5997515 @dnnywld / #5997024 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997515",
          "cefr_level": "A1",
          "word_slugs": [
            "tennis-noun"
          ]
        },
        {
          "id": "374328",
          "text": "Mi piace il tennis.",
          "translation": "Я люблю теннис.",
          "source": "Tatoeba #374328 @Pharamp / #5654609 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/374328",
          "cefr_level": "A1",
          "word_slugs": [
            "tennis-noun"
          ]
        },
        {
          "id": "5475013",
          "text": "Tom gioca a tennis.",
          "translation": "Том играет в теннис.",
          "source": "Tatoeba #5475013 @dnnywld / #5474718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5475013",
          "cefr_level": "A1",
          "word_slugs": [
            "tennis-noun"
          ]
        },
        {
          "id": "6375318",
          "text": "Ho giocato a tennis.",
          "translation": "Я поиграла в теннис.",
          "source": "Tatoeba #6375318 @dnnywld / #6375203 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6375318",
          "cefr_level": "A1",
          "word_slugs": [
            "tennis-noun"
          ]
        },
        {
          "id": "5997500",
          "text": "Domani gioco a tennis.",
          "translation": "Завтра я играю в теннис.",
          "source": "Tatoeba #5997500 @dnnywld / #5997076 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997500",
          "cefr_level": "A1",
          "word_slugs": [
            "tennis-noun"
          ]
        }
