    {
      "slug": "stretti-adj",
      "lemma": "stretti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7148,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4651773",
          "text": "Quanti amici stretti hai?",
          "translation": "Сколько у тебя близких друзей?",
          "source": "Tatoeba #4651773 @madriot / #5488 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4651773",
          "cefr_level": "A1",
          "word_slugs": [
            "stretti-adj"
          ]
        },
        {
          "id": "5671321",
          "text": "Abbiamo pianto stretti in un abbraccio.",
          "translation": "Мы плакали в объятиях друг друга.",
          "source": "Tatoeba #5671321 @dnnywld / #5670266 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5671321",
          "cefr_level": "A1",
          "word_slugs": [
            "stretti-adj"
          ]
        },
        {
          "id": "5552434",
          "text": "Ci siamo stretti la mano e salutati.",
          "translation": "Мы пожали друг другу руки и попрощались.",
          "source": "Tatoeba #5552434 @dnnywld / #5552382 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5552434",
          "cefr_level": "A1",
          "word_slugs": [
            "stretti-adj"
          ]
        },
        {
          "id": "6851931",
          "text": "Abbiamo dormito stretti l'uno all'altro.",
          "translation": "Мы спали, прижавшись друг к другу.",
          "source": "Tatoeba #6851931 @dnnywld / #6851653 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6851931",
          "cefr_level": "A1",
          "word_slugs": [
            "stretti-adj"
          ]
        },
        {
          "id": "5494453",
          "text": "Io e Tom ci siamo stretti la mano.",
          "translation": "Мы с Томом пожали друг другу руки.",
          "source": "Tatoeba #5494453 @dnnywld / #3931526 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494453",
          "cefr_level": "A1",
          "word_slugs": [
            "stretti-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il stretti",
