    {
      "slug": "cicatrici-noun",
      "lemma": "cicatrici",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8288,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6628390",
          "text": "Possono rimanere alcune cicatrici.",
          "translation": "Могут остаться несколько шрамов.",
          "source": "Tatoeba #6628390 @dnnywld / #6628387 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6628390",
          "cefr_level": "A1",
          "word_slugs": [
            "cicatrici-noun"
          ]
        },
        {
          "id": "5054741",
          "text": "Le cicatrici sono appena visibili.",
          "translation": "Шрамы едва видны.",
          "source": "Tatoeba #5054741 @Guybrush88 / #4096222 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5054741",
          "cefr_level": "A1",
          "word_slugs": [
            "cicatrici-noun"
          ]
        },
        {
          "id": "5497603",
          "text": "Non ti preoccupare. Alle ragazze piacciono le cicatrici.",
          "translation": "Не переживай. Девчонкам нравятся шрамы.",
          "source": "Tatoeba #5497603 @dnnywld / #5497133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497603",
          "cefr_level": "A1",
          "word_slugs": [
            "cicatrici-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
