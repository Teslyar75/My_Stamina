    {
      "slug": "costretta-adj",
      "lemma": "costretta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5049,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10885715",
          "text": "Sono costretta a studiare.",
          "translation": "Меня заставляют учиться.",
          "source": "Tatoeba #10885715 @carlosalberto / #6717287 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885715",
          "cefr_level": "A1",
          "word_slugs": [
            "costretta-adj"
          ]
        },
        {
          "id": "6866502",
          "text": "Sarò costretta a dirglielo.",
          "translation": "Я буду вынуждена ему рассказать.",
          "source": "Tatoeba #6866502 @dnnywld / #6865814 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866502",
          "cefr_level": "A1",
          "word_slugs": [
            "costretta-adj"
          ]
        },
        {
          "id": "6866632",
          "text": "Fui costretta a lasciare la patria.",
          "translation": "Я была вынуждена покинуть родную землю.",
          "source": "Tatoeba #6866632 @dnnywld / #6865352 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866632",
          "cefr_level": "A1",
          "word_slugs": [
            "costretta-adj"
          ]
        },
        {
          "id": "10870928",
          "text": "La guarnigione fu costretta ad arrendersi.",
          "translation": "Гарнизон был вынужден сдаться.",
          "source": "Tatoeba #10870928 @dnnywld / #4493052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10870928",
          "cefr_level": "A1",
          "word_slugs": [
            "costretta-adj"
          ]
        },
        {
          "id": "6141119",
          "text": "Sono costretta a vendere la mia proprietà per pagare i miei debiti.",
          "translation": "Я должна продать свою недвижимость, чтобы погасить свои долги.",
          "source": "Tatoeba #6141119 @dnnywld / #3309787 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6141119",
          "cefr_level": "A1",
          "word_slugs": [
            "costretta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il costretta",
        "plural": "",
        "infinitive": ""
      }
