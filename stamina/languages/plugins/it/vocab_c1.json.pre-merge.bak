    {
      "slug": "onesti-adj",
      "lemma": "onesti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5089,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5677795",
          "text": "Siate onesti con me!",
          "translation": "Будьте со мной откровенны!",
          "source": "Tatoeba #5677795 @dnnywld / #5677435 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677795",
          "cefr_level": "A1",
          "word_slugs": [
            "onesti-adj"
          ]
        },
        {
          "id": "5768142",
          "text": "È dura essere onesti.",
          "translation": "Трудно быть честным.",
          "source": "Tatoeba #5768142 @dnnywld / #2747135 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5768142",
          "cefr_level": "A1",
          "word_slugs": [
            "onesti-adj"
          ]
        },
        {
          "id": "5768158",
          "text": "È importante essere onesti.",
          "translation": "Быть честным важно.",
          "source": "Tatoeba #5768158 @dnnywld / #2973525 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5768158",
          "cefr_level": "A1",
          "word_slugs": [
            "onesti-adj"
          ]
        },
        {
          "id": "6947914",
          "text": "Tutti i bambini sono onesti.",
          "translation": "Все дети честные.",
          "source": "Tatoeba #6947914 @dnnywld / #6946955 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6947914",
          "cefr_level": "A1",
          "word_slugs": [
            "onesti-adj"
          ]
        },
        {
          "id": "3609794",
          "text": "Siamo poveri perché siamo onesti.",
          "translation": "Мы бедные, потому что мы честные.",
          "source": "Tatoeba #3609794 @Guybrush88 / #2513191 @dimitris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3609794",
          "cefr_level": "A1",
          "word_slugs": [
            "onesti-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
