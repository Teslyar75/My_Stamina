    {
      "slug": "industria-noun",
      "lemma": "industria",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5412,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "промышленность"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5626704",
          "text": "Dobbiamo creare la nostra industria cinematografica.",
          "translation": "Мы должны создать свою собственную киноиндустрию.",
          "source": "Tatoeba #5626704 @dnnywld / #5626474 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626704",
          "cefr_level": "A1",
          "word_slugs": [
            "industria-noun"
          ]
        },
        {
          "id": "3025308",
          "text": "L'industria e l'agricoltura si modernizzano.",
          "translation": "Промышленность и сельское хозяйство улучшаются.",
          "source": "Tatoeba #3025308 @Guybrush88 / #3801579 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3025308",
          "cefr_level": "A1",
          "word_slugs": [
            "industria-noun"
          ]
        },
        {
          "id": "6953656",
          "text": "L'industria cinematografica è diventata un grande business.",
          "translation": "Киноиндустрия стала большим бизнесом.",
          "source": "Tatoeba #6953656 @dnnywld / #3040693 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953656",
          "cefr_level": "A1",
          "word_slugs": [
            "industria-noun"
          ]
        },
        {
          "id": "2575516",
          "text": "La Cina è diventata il laboratorio dell'industria mondiale.",
          "translation": "Китай стал промышленной мастерской мира.",
          "source": "Tatoeba #2575516 @al_ex_an_der / #2575505 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2575516",
          "cefr_level": "A1",
          "word_slugs": [
            "industria-noun"
          ]
        },
        {
          "id": "350344",
          "text": "L'industria automobilistica è una delle industrie principali in Giappone.",
          "translation": "Автомобильная промышленность - одна из основных в Японии.",
          "source": "Tatoeba #350344 @martin / #469959 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350344",
          "cefr_level": "A1",
          "word_slugs": [
            "industria-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la industria",
        "plural": "",
        "infinitive": ""
      }
    },
    {
