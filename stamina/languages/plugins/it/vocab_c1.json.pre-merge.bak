    {
      "slug": "detesto-verb",
      "lemma": "detesto",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5860,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5971649",
          "text": "Detesto gli zoo.",
          "translation": "Ненавижу зоопарки.",
          "source": "Tatoeba #5971649 @dnnywld / #5969208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971649",
          "cefr_level": "A1",
          "word_slugs": [
            "detesto-verb"
          ]
        },
        {
          "id": "4470357",
          "text": "Detesto il caldo.",
          "translation": "Терпеть не могу жару.",
          "source": "Tatoeba #4470357 @Guybrush88 / #8177058 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4470357",
          "cefr_level": "A1",
          "word_slugs": [
            "detesto-verb"
          ]
        },
        {
          "id": "3412262",
          "text": "Detesto i rettili.",
          "translation": "Я ненавижу рептилий.",
          "source": "Tatoeba #3412262 @Guybrush88 / #1558287 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3412262",
          "cefr_level": "A1",
          "word_slugs": [
            "detesto-verb"
          ]
        },
        {
          "id": "8177144",
          "text": "Detesto il freddo.",
          "translation": "Терпеть не могу холод.",
          "source": "Tatoeba #8177144 @dnnywld / #8177039 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8177144",
          "cefr_level": "A1",
          "word_slugs": [
            "detesto-verb"
          ]
        },
        {
          "id": "3412263",
          "text": "Io detesto i rettili.",
          "translation": "Я ненавижу рептилий.",
          "source": "Tatoeba #3412263 @Guybrush88 / #1558287 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3412263",
          "cefr_level": "A1",
