    {
      "slug": "regolamento-noun",
      "lemma": "regolamento",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8516,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5496936",
          "text": "Il regolamento è chiaro.",
          "translation": "Правила понятны.",
          "source": "Tatoeba #5496936 @dnnywld / #5496830 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5496936",
          "cefr_level": "A1",
          "word_slugs": [
            "regolamento-noun"
          ]
        },
        {
          "id": "12488202",
          "text": "Bisogna rispettare il regolamento del gioco.",
          "translation": "Правила игры надо соблюдать.",
          "source": "Tatoeba #12488202 @dnnywld / #12488195 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12488202",
          "cefr_level": "A1",
          "word_slugs": [
            "regolamento-noun"
          ]
        },
        {
          "id": "10844411",
          "text": "Sul regolamento tutto questo è chiaramente specificato.",
          "translation": "В правилах это всё чётко прописано.",
          "source": "Tatoeba #10844411 @dnnywld / #10128657 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844411",
          "cefr_level": "A1",
          "word_slugs": [
            "regolamento-noun"
          ]
        },
        {
          "id": "10844426",
          "text": "Ma nel regolamento del gioco questo non è specificato!",
          "translation": "Но в правилах игры этого не прописали!",
          "source": "Tatoeba #10844426 @dnnywld / #9101770 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844426",
          "cefr_level": "A1",
          "word_slugs": [
            "regolamento-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
