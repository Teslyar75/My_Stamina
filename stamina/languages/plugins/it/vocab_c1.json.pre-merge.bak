      "examples": [
        {
          "id": "6329738",
          "text": "Voglio ripulire la zucca a questo ragazzino.",
          "translation": "Я хочу начистить этому парню репу.",
          "source": "Tatoeba #6329738 @dnnywld / #6329099 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6329738",
