    {
      "slug": "naturali-adj",
      "lemma": "naturali",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7151,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7215772",
          "text": "Tom è morto nel 2013 di cause naturali.",
          "translation": "Том умер в 2013 году от естественных причин.",
          "source": "Tatoeba #7215772 @dnnywld / #7215458 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7215772",
          "cefr_level": "A1",
          "word_slugs": [
            "naturali-adj"
          ]
        },
        {
          "id": "2931421",
          "text": "I terremoti e le alluvioni sono dei disastri naturali.",
          "translation": "Землетрясения и наводнения - это стихийные бедствия.",
          "source": "Tatoeba #2931421 @Guybrush88 / #2505052 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2931421",
          "cefr_level": "A1",
          "word_slugs": [
            "naturali-adj"
          ]
        },
        {
          "id": "5384947",
          "text": "Molti poeti esprimono i propri sentimenti sulle bellezze naturali.",
          "translation": "Многие поэты выражают свои ощущения от природных красот.",
          "source": "Tatoeba #5384947 @dnnywld / #5384788 @lemeoejubsmgt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384947",
          "cefr_level": "A1",
          "word_slugs": [
            "naturali-adj"
          ]
        },
        {
          "id": "6033742",
          "text": "Sull'iscrizione dell'etichetta si leggeva: \"Solo materiali naturali\".",
          "translation": "Надпись на этикетке гласила: \"Только натуральные материалы\".",
          "source": "Tatoeba #6033742 @dnnywld / #1337147 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6033742",
          "cefr_level": "A1",
          "word_slugs": [
            "naturali-adj"
          ]
        },
        {
          "id": "350357",
          "text": "Non ci sono molti paesi nel mondo che abbondano di risorse naturali.",
          "translation": "В мире немного стран, изобилующих природными ресурсами.",
          "source": "Tatoeba #350357 @martin / #573449 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350357",
          "cefr_level": "A1",
          "word_slugs": [
            "naturali-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il naturali",
        "plural": "",
        "infinitive": ""
      }
    },
