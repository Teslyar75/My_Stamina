    {
      "slug": "fascino-noun",
      "lemma": "fascino",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5017,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4517768",
          "text": "Usa il tuo fascino.",
          "translation": "Используй своё обаяние.",
          "source": "Tatoeba #4517768 @Guybrush88 / #5771722 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4517768",
          "cefr_level": "A1",
          "word_slugs": [
            "fascino-noun"
          ]
        },
        {
          "id": "4517770",
          "text": "Usate il vostro fascino.",
          "translation": "Используйте своё обаяние.",
          "source": "Tatoeba #4517770 @Guybrush88 / #5771725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4517770",
          "cefr_level": "A1",
          "word_slugs": [
            "fascino-noun"
          ]
        },
        {
          "id": "6851887",
          "text": "Il suo fascino non lasciava nessuno indifferente.",
          "translation": "Её обаяние никого не оставляло равнодушным.",
          "source": "Tatoeba #6851887 @dnnywld / #6851659 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6851887",
          "cefr_level": "A1",
          "word_slugs": [
            "fascino-noun"
          ]
        },
        {
          "id": "2420352",
          "text": "Quella donna sa convincere tutti con il suo fascino.",
          "translation": "Эта женщина знает, как убедить всех своим обаянием.",
          "source": "Tatoeba #2420352 @al_ex_an_der / #2420361 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2420352",
          "cefr_level": "A1",
          "word_slugs": [
            "fascino-noun"
          ]
        }
      ],
      "tags": [
