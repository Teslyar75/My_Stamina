    {
      "slug": "paolo-name",
      "lemma": "Paolo",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6290,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "Пол"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5596343",
          "text": "Dicono che Paolo sia molto ricco.",
          "translation": "Говорят, что Павел очень богатый.",
          "source": "Tatoeba #5596343 @dnnywld / #3225277 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5596343",
          "cefr_level": "A1",
          "word_slugs": [
            "paolo-name"
          ]
        },
        {
          "id": "5973598",
          "text": "Paolo vuole assolutamente vedere la neve.",
          "translation": "Поль непременно хочет увидеть снег.",
          "source": "Tatoeba #5973598 @dnnywld / #5972993 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5973598",
          "cefr_level": "A1",
          "word_slugs": [
            "paolo-name"
          ]
        },
        {
          "id": "3475530",
          "text": "La macchina di Paolo si è rotta.",
          "translation": "Машина Павла сломалась.",
          "source": "Tatoeba #3475530 @Guybrush88 / #3475547 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3475530",
          "cefr_level": "A1",
          "word_slugs": [
            "paolo-name"
          ]
        },
        {
          "id": "6800099",
          "text": "A San Paolo ci sono diversi musei.",
          "translation": "В Сан-Паулу есть несколько музеев.",
          "source": "Tatoeba #6800099 @dnnywld / #5562953 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6800099",
          "cefr_level": "A1",
          "word_slugs": [
            "paolo-name"
          ]
        },
        {
          "id": "3221709",
          "text": "La gente dice che Paolo è molto ricco.",
          "translation": "Говорят, что Павел очень богатый.",
          "source": "Tatoeba #3221709 @Selena777 / #3225277 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3221709",
          "cefr_level": "A1",
          "word_slugs": [
            "paolo-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
