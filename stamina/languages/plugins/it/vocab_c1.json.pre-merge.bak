    {
      "slug": "maniere-noun",
      "lemma": "maniere",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5783,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5483141",
          "text": "Lei ha delle buone maniere.",
          "translation": "У неё прекрасные манеры.",
          "source": "Tatoeba #5483141 @dnnywld / #5482880 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5483141",
          "cefr_level": "A1",
          "word_slugs": [
            "maniere-noun"
          ]
        },
        {
          "id": "6890098",
          "text": "Non conosci le buone maniere.",
          "translation": "Ты не умеешь себя вести.",
          "source": "Tatoeba #6890098 @dnnywld / #5272295 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890098",
          "cefr_level": "A1",
          "word_slugs": [
            "maniere-noun"
          ]
        },
        {
          "id": "6890100",
          "text": "Non conoscete le buone maniere.",
          "translation": "Вы не умеете себя вести.",
          "source": "Tatoeba #6890100 @dnnywld / #5272296 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890100",
          "cefr_level": "A1",
          "word_slugs": [
            "maniere-noun"
          ]
        },
        {
          "id": "6894971",
          "text": "Le sue maniere mi fanno perdere il controllo.",
          "translation": "Его манера доводит меня до белого каления.",
          "source": "Tatoeba #6894971 @dnnywld / #3774971 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6894971",
          "cefr_level": "A1",
          "word_slugs": [
            "maniere-noun"
          ]
        },
        {
          "id": "5843879",
          "text": "Il linguaggio può essere utilizzato in maniere differenti.",
          "translation": "Язык можно использовать по-разному.",
          "source": "Tatoeba #5843879 @dnnywld / #976648 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843879",
          "cefr_level": "A1",
          "word_slugs": [
            "maniere-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
