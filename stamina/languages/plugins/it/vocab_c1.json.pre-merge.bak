    {
      "slug": "temi-name",
      "lemma": "Temi",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9467,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6891268",
          "text": "Cosa temi in concreto?",
          "translation": "Чего конкретно ты боишься?",
          "source": "Tatoeba #6891268 @dnnywld / #3363938 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891268",
          "cefr_level": "A1",
          "word_slugs": [
            "temi-name"
          ]
        },
        {
          "id": "5872815",
          "text": "Lui ha toccato diversi temi.",
          "translation": "Он касался разных тем.",
          "source": "Tatoeba #5872815 @dnnywld / #4177531 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5872815",
          "cefr_level": "A1",
          "word_slugs": [
            "temi-name"
          ]
        },
        {
          "id": "6891309",
          "text": "Temi di perdere i tuoi soldi?",
          "translation": "Ты боишься потерять свои деньги?",
          "source": "Tatoeba #6891309 @dnnywld / #5406314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891309",
          "cefr_level": "A1",
          "word_slugs": [
            "temi-name"
          ]
        },
        {
          "id": "6891339",
          "text": "Temi che io abbia ragione, vero?",
          "translation": "Ты боишься, что я прав, да?",
          "source": "Tatoeba #6891339 @dnnywld / #5671780 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891339",
          "cefr_level": "A1",
          "word_slugs": [
            "temi-name"
          ]
        },
        {
          "id": "6766328",
          "text": "Il tempo è scaduto, consegnate i temi.",
          "translation": "Время вышло, сдавайте сочинения.",
          "source": "Tatoeba #6766328 @dnnywld / #6765174 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6766328",
          "cefr_level": "A1",
          "word_slugs": [
            "temi-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la Temi",
        "plural": "",
        "infinitive": ""
      }
    },
