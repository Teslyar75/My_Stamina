    {
      "slug": "automatico-adj",
      "lemma": "automatico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8426,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10849593",
          "text": "Questo distributore automatico non funziona.",
          "translation": "Этот автомат не работает.",
          "source": "Tatoeba #10849593 @dnnywld / #569788 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849593",
          "cefr_level": "A1",
          "word_slugs": [
            "automatico-adj"
          ]
        },
        {
          "id": "10849592",
          "text": "Il distributore automatico è fuori servizio.",
          "translation": "Торговый автомат неисправен.",
          "source": "Tatoeba #10849592 @dnnywld / #2420441 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849592",
          "cefr_level": "A1",
          "word_slugs": [
            "automatico-adj"
          ]
        },
        {
          "id": "6950113",
          "text": "Hanno installato un distributore automatico al lavoro.",
          "translation": "На работе поставили торговый автомат.",
          "source": "Tatoeba #6950113 @dnnywld / #438195 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950113",
          "cefr_level": "A1",
          "word_slugs": [
            "automatico-adj"
          ]
        },
        {
          "id": "5415777",
          "text": "Per favore utilizzate il riconoscimento vocale automatico.",
          "translation": "Пожалуйста, используйте автоматическое распознавание речи!",
          "source": "Tatoeba #5415777 @dnnywld / #3100149 @Khvalovsky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415777",
          "cefr_level": "A1",
          "word_slugs": [
            "automatico-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
