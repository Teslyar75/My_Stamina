    {
      "slug": "interessanti-adj",
      "lemma": "interessanti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5236,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1254898",
          "text": "Queste sono notizie interessanti.",
          "translation": "Это интересные новости.",
          "source": "Tatoeba #1254898 @riccioberto / #469050 @ArsWalrus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1254898",
          "cefr_level": "A1",
          "word_slugs": [
            "interessanti-adj"
          ]
        },
        {
          "id": "7271075",
          "text": "Il mondo è pieno di persone interessanti.",
          "translation": "Мир полон интересных людей.",
          "source": "Tatoeba #7271075 @Guybrush88 / #7274322 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7271075",
          "cefr_level": "A1",
          "word_slugs": [
            "interessanti-adj"
          ]
        },
        {
          "id": "6919582",
          "text": "Tom e Mary sono delle persone interessanti.",
          "translation": "Том и Мэри - интересные люди.",
          "source": "Tatoeba #6919582 @dnnywld / #6919066 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919582",
          "cefr_level": "A1",
          "word_slugs": [
            "interessanti-adj"
          ]
        },
        {
          "id": "10915131",
          "text": "Tom aggiunse alcune spezie interessanti al ragù.",
          "translation": "Том добавил несколько интересных специй в рагу.",
          "source": "Tatoeba #10915131 @dnnywld / #10914943 @Shep7000 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10915131",
          "cefr_level": "A1",
