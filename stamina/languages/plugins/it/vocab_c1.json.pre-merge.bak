    {
      "slug": "rispetta-verb",
      "lemma": "rispetta",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9055,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5760239",
          "text": "Lui mi rispetta.",
          "translation": "Он меня уважает.",
          "source": "Tatoeba #5760239 @Guybrush88 / #2630003 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5760239",
          "cefr_level": "A1",
          "word_slugs": [
            "rispetta-verb"
          ]
        },
        {
          "id": "5386796",
          "text": "Rispetta gli anziani.",
          "translation": "Уважай старших.",
          "source": "Tatoeba #5386796 @dnnywld / #5386030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5386796",
          "cefr_level": "A1",
          "word_slugs": [
            "rispetta-verb"
          ]
        },
        {
          "id": "6876865",
          "text": "Nora rispetta sua madre.",
          "translation": "Нора уважает свою мать.",
          "source": "Tatoeba #6876865 @dnnywld / #6876201 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6876865",
          "cefr_level": "A1",
          "word_slugs": [
            "rispetta-verb"
          ]
        },
        {
          "id": "5766086",
          "text": "Tom rispetta i suoi genitori.",
          "translation": "Том уважает своих родителей.",
          "source": "Tatoeba #5766086 @Guybrush88 / #6876200 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5766086",
          "cefr_level": "A1",
          "word_slugs": [
            "rispetta-verb"
          ]
        },
        {
          "id": "11657719",
          "text": "Tom non rispetta niente e nessuno.",
          "translation": "Том ничего и никого не уважает.",
          "source": "Tatoeba #11657719 @dnnywld / #11657690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11657719",
          "cefr_level": "A1",
          "word_slugs": [
            "rispetta-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "rispetta",
        "plural": "",
        "infinitive": "rispetta"
      }
    },
