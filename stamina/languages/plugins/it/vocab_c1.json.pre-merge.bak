    {
      "slug": "tosse-noun",
      "lemma": "tosse",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8354,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "кашель"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8815125",
          "text": "Ha la tosse.",
          "translation": "У него кашель.",
          "source": "Tatoeba #8815125 @Guybrush88 / #12126354 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8815125",
          "cefr_level": "A1",
          "word_slugs": [
            "tosse-noun"
          ]
        },
        {
          "id": "3262004",
          "text": "La tua tosse mi preoccupa.",
          "translation": "Твой кашель меня беспокоит.",
          "source": "Tatoeba #3262004 @Guybrush88 / #6312349 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3262004",
          "cefr_level": "A1",
          "word_slugs": [
            "tosse-noun"
          ]
        },
        {
          "id": "5619495",
          "text": "Hai qualche medicina per la tosse?",
          "translation": "У тебя есть какие-нибудь лекарства от кашля?",
          "source": "Tatoeba #5619495 @dnnywld / #4097606 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619495",
          "cefr_level": "A1",
          "word_slugs": [
            "tosse-noun"
          ]
        },
        {
          "id": "5688482",
          "text": "La tosse disturba il Vostro sonno?",
          "translation": "Кашель нарушает Ваш сон?",
          "source": "Tatoeba #5688482 @dnnywld / #1578306 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688482",
          "cefr_level": "A1",
          "word_slugs": [
            "tosse-noun"
          ]
        },
        {
          "id": "5412685",
          "text": "Non riesco a liberarmi di questa tosse.",
          "translation": "Я никак не могу избавиться от кашля.",
          "source": "Tatoeba #5412685 @dnnywld / #3533740 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5412685",
          "cefr_level": "A1",
          "word_slugs": [
            "tosse-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la tosse",
        "plural": "",
        "infinitive": ""
      }
    },
