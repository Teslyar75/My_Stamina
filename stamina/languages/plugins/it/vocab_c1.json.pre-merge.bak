    {
      "slug": "prevedere-verb",
      "lemma": "prevedere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9280,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5684154",
          "text": "Non possiamo prevedere cosa accadrà.",
          "translation": "Мы не можем предсказать, что будет.",
          "source": "Tatoeba #5684154 @dnnywld / #5683824 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5684154",
          "cefr_level": "A1",
          "word_slugs": [
            "prevedere-verb"
          ]
        },
        {
          "id": "5897194",
          "text": "È impossibile prevedere i terremoti.",
          "translation": "Землетрясения невозможно предсказать.",
          "source": "Tatoeba #5897194 @Guybrush88 / #4571362 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5897194",
          "cefr_level": "A1",
          "word_slugs": [
            "prevedere-verb"
          ]
        },
        {
          "id": "5949347",
          "text": "Nessuno può prevedere quello che accadrà.",
          "translation": "Никто не может предсказать, что случится.",
          "source": "Tatoeba #5949347 @dnnywld / #5949164 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5949347",
          "cefr_level": "A1",
          "word_slugs": [
            "prevedere-verb"
          ]
        },
        {
          "id": "12304120",
          "text": "Facile da prevedere - difficile da attuare.",
          "translation": "Легко планировать - трудно осуществить.",
          "source": "Tatoeba #12304120 @Bernie75 / #2841742 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12304120",
          "cefr_level": "A1",
          "word_slugs": [
            "prevedere-verb"
          ]
        },
        {
          "id": "5666489",
          "text": "Tom pretende di poter prevedere con precisione il futuro.",
          "translation": "Том утверждает, что может точно предсказывать будущее.",
          "source": "Tatoeba #5666489 @dnnywld / #5666314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5666489",
          "cefr_level": "A1",
          "word_slugs": [
            "prevedere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "prevedere",
