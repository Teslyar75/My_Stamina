    {
      "slug": "moderna-adj",
      "lemma": "moderna",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6628,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5269415",
          "text": "Non capisco l'arte moderna.",
          "translation": "Я не понимаю современное искусство.",
          "source": "Tatoeba #5269415 @WM3DAS / #5269628 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5269415",
          "cefr_level": "A1",
          "word_slugs": [
            "moderna-adj"
          ]
        },
        {
          "id": "5706826",
          "text": "Vi piace la musica moderna?",
          "translation": "Вам нравится современная музыка?",
          "source": "Tatoeba #5706826 @Guybrush88 / #3889704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5706826",
          "cefr_level": "A1",
          "word_slugs": [
            "moderna-adj"
          ]
        },
        {
          "id": "6361582",
          "text": "Non capisco la moda moderna.",
          "translation": "Не понимаю я современной моды.",
          "source": "Tatoeba #6361582 @dnnywld / #6361288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361582",
          "cefr_level": "A1",
          "word_slugs": [
            "moderna-adj"
          ]
        },
        {
          "id": "6359982",
          "text": "A Tom piace l'architettura moderna.",
          "translation": "Тому нравится современная архитектура.",
          "source": "Tatoeba #6359982 @dnnywld / #6359693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6359982",
          "cefr_level": "A1",
          "word_slugs": [
            "moderna-adj"
          ]
        },
        {
          "id": "5532933",
          "text": "Dicono che la gioventù moderna sia apatica.",
          "translation": "Говорят, нынешняя молодёжь апатична.",
          "source": "Tatoeba #5532933 @dnnywld / #5532887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5532933",
          "cefr_level": "A1",
          "word_slugs": [
            "moderna-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il moderna",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "liscia-adj",
      "lemma": "liscia",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6629,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5607752",
          "text": "Qui la terra è liscia.",
          "translation": "Земля здесь ровная.",
          "source": "Tatoeba #5607752 @dnnywld / #5605901 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607752",
          "cefr_level": "A1",
          "word_slugs": [
            "liscia-adj"
          ]
        },
        {
          "id": "6830243",
          "text": "Mary ha la pelle liscia.",
          "translation": "У Марии атласная кожа.",
          "source": "Tatoeba #6830243 @dnnywld / #6829340 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6830243",
          "cefr_level": "A1",
          "word_slugs": [
            "liscia-adj"
          ]
        },
        {
          "id": "5676760",
          "text": "Uff! L'ho passata liscia!",
          "translation": "Уф! Пронесло!",
          "source": "Tatoeba #5676760 @dnnywld / #5676566 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5676760",
          "cefr_level": "A1",
          "word_slugs": [
            "liscia-adj"
          ]
        },
        {
          "id": "5883059",
          "text": "Tom vorrebbe avere la pelle liscia.",
          "translation": "Том хотел бы иметь гладкую кожу.",
          "source": "Tatoeba #5883059 @dnnywld / #5882391 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5883059",
          "cefr_level": "A1",
          "word_slugs": [
            "liscia-adj"
          ]
        },
        {
          "id": "6978297",
          "text": "Se lui muore, non la passeremo liscia.",
          "translation": "Если он погибнет, нам не сносить головы.",
          "source": "Tatoeba #6978297 @dnnywld / #6089981 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6978297",
          "cefr_level": "A1",
          "word_slugs": [
            "liscia-adj"
          ]
        }
