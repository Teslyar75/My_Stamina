          ]
        },
        {
          "id": "2777425",
          "text": "Lei sa giocare a poker.",
          "translation": "Она умеет играть в покер.",
          "source": "Tatoeba #2777425 @Guybrush88 / #3292673 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2777425",
          "cefr_level": "A1",
          "word_slugs": [
            "poker-noun"
          ]
        },
        {
          "id": "2777611",
          "text": "Gioca a poker con loro.",
          "translation": "Она играет с ними в покер.",
          "source": "Tatoeba #2777611 @Guybrush88 / #3097050 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2777611",
