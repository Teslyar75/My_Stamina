          "cefr_level": "A1",
          "word_slugs": [
            "sappi-verb"
          ]
        },
        {
          "id": "5571895",
          "text": "Qualsiasi cosa accada, sappi: io ti amo.",
          "translation": "Что бы ни случилось, знай: я люблю тебя.",
          "source": "Tatoeba #5571895 @dnnywld / #2034612 @everlasting (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571895",
          "cefr_level": "A1",
          "word_slugs": [
