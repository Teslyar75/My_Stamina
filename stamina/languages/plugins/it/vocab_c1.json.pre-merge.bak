    {
      "slug": "ulteriori-adj",
      "lemma": "ulteriori",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6360,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5449788",
          "text": "Non voglio guai ulteriori.",
          "translation": "Я не хочу больше неприятностей.",
          "source": "Tatoeba #5449788 @dnnywld / #5449149 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5449788",
          "cefr_level": "A1",
          "word_slugs": [
            "ulteriori-adj"
          ]
        },
        {
          "id": "5989377",
          "text": "Tornate a casa e attendete ulteriori istruzioni.",
          "translation": "Возвращайтесь домой и ждите дальнейших указаний.",
          "source": "Tatoeba #5989377 @dnnywld / #5989052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5989377",
          "cefr_level": "A1",
          "word_slugs": [
            "ulteriori-adj"
          ]
        }
      ],
      "tags": [
