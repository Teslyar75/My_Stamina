    {
      "slug": "messicano-adj",
      "lemma": "messicano",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6590,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7031454",
          "text": "Avete mai assaggiato cibo messicano?",
          "translation": "Вы когда-нибудь пробовали мексиканскую еду?",
          "source": "Tatoeba #7031454 @dnnywld / #7030574 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7031454",
          "cefr_level": "A1",
          "word_slugs": [
            "messicano-adj"
          ]
        },
        {
          "id": "5492512",
          "text": "Sono messicano. Parlo lo spagnolo in modo fluente.",
          "translation": "Я мексиканец. Я свободно говорю по-испански.",
          "source": "Tatoeba #5492512 @dnnywld / #5492342 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5492512",
          "cefr_level": "A1",
          "word_slugs": [
            "messicano-adj"
          ]
        },
        {
          "id": "6890066",
          "text": "Il governo messicano si è rifiutato di condurre i negoziati.",
          "translation": "Правительство Мексики отказалось вести переговоры.",
          "source": "Tatoeba #6890066 @dnnywld / #2782692 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890066",
          "cefr_level": "A1",
          "word_slugs": [
            "messicano-adj"
          ]
        },
        {
          "id": "6018639",
          "text": "Puoi raccomandarmi un posto carino dove posso gustare del cibo messicano?",
          "translation": "Можешь порекомендовать мне хорошее место, где можно отведать блюда мексиканской кухни?",
          "source": "Tatoeba #6018639 @dnnywld / #6018012 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6018639",
          "cefr_level": "A1",
          "word_slugs": [
            "messicano-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il messicano",
        "plural": "",
        "infinitive": ""
      }
    },
