          ]
        },
        {
          "id": "859403",
          "text": "Si è rifiutata di prendere i soldi.",
          "translation": "Она отказалась взять деньги.",
          "source": "Tatoeba #859403 @Guybrush88 / #471854 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/859403",
          "cefr_level": "A1",
          "word_slugs": [
            "rifiutata-adj"
          ]
        },
        {
          "id": "5997014",
          "text": "Lei si è rifiutata di rispondere alle mie domande.",
          "translation": "Она отказалась отвечать на мои вопросы.",
          "source": "Tatoeba #5997014 @dnnywld / #473725 @unholywhale (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997014",
          "cefr_level": "A1",
