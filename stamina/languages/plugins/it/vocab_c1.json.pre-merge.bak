    {
      "slug": "ingenuo-adj",
      "lemma": "ingenuo",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9119,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6083497",
          "text": "Come sei ingenuo.",
          "translation": "Как ты наивен.",
          "source": "Tatoeba #6083497 @dnnywld / #6083048 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6083497",
          "cefr_level": "A1",
          "word_slugs": [
            "ingenuo-adj"
          ]
        },
        {
          "id": "5027908",
          "text": "Sei davvero così ingenuo?",
          "translation": "Ты действительно такой наивный?",
          "source": "Tatoeba #5027908 @ianna / #6844642 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5027908",
          "cefr_level": "A1",
          "word_slugs": [
            "ingenuo-adj"
          ]
        },
        {
          "id": "6810640",
          "text": "È ingenuo ritenere altrimenti.",
          "translation": "Наивно считать иначе.",
          "source": "Tatoeba #6810640 @dnnywld / #4683968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6810640",
          "cefr_level": "A1",
          "word_slugs": [
            "ingenuo-adj"
          ]
        },
        {
          "id": "5781908",
          "text": "Non sono così ingenuo come pensi.",
          "translation": "Я не настолько наивен, как ты думаешь.",
          "source": "Tatoeba #5781908 @dnnywld / #5781713 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5781908",
          "cefr_level": "A1",
          "word_slugs": [
            "ingenuo-adj"
          ]
        },
        {
          "id": "5781909",
          "text": "Non sono così ingenuo come pensate.",
          "translation": "Я не настолько наивен, как Вы думаете.",
          "source": "Tatoeba #5781909 @dnnywld / #5781712 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5781909",
