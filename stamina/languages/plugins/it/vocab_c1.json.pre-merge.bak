    {
      "slug": "saggezza-noun",
      "lemma": "saggezza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6160,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "мудрость"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5589362",
          "text": "La saggezza viene col tempo.",
          "translation": "Мудрость приходит с годами.",
          "source": "Tatoeba #5589362 @dnnywld / #3644712 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589362",
          "cefr_level": "A1",
          "word_slugs": [
            "saggezza-noun"
          ]
        },
        {
          "id": "5494368",
          "text": "Dall'esperienza deriva la saggezza.",
          "translation": "С опытом приходит мудрость.",
          "source": "Tatoeba #5494368 @dnnywld / #3882625 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494368",
          "cefr_level": "A1",
          "word_slugs": [
            "saggezza-noun"
          ]
        },
        {
          "id": "12393801",
          "text": "Usate il vostro tempo con saggezza.",
          "translation": "Используйте своё время с умом.",
          "source": "Tatoeba #12393801 @Bernie75 / #4552498 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12393801",
          "cefr_level": "A1",
          "word_slugs": [
            "saggezza-noun"
          ]
        },
        {
          "id": "1271645",
          "text": "La ripetizione è madre della saggezza.",
          "translation": "Повторение — мать учения.",
          "source": "Tatoeba #1271645 @Guybrush88 / #981758 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1271645",
          "cefr_level": "A1",
          "word_slugs": [
            "saggezza-noun"
          ]
        },
        {
          "id": "5494426",
          "text": "La saggezza non può non derivare dall'esperienza.",
          "translation": "Мудрость не может прийти без опыта.",
          "source": "Tatoeba #5494426 @dnnywld / #1568933 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494426",
          "cefr_level": "A1",
          "word_slugs": [
            "saggezza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la saggezza",
        "plural": "",
        "infinitive": ""
      }
