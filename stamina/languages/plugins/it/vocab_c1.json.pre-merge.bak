      "examples": [
        {
          "id": "4863422",
          "text": "Lui è giovane e abile.",
          "translation": "Он молодой и способный.",
          "source": "Tatoeba #4863422 @Guybrush88 / #10142917 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4863422",
