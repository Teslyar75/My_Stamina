    {
      "slug": "anziana-adj",
      "lemma": "anziana",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8377,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6917814",
          "text": "Lei è un po' più anziana di me.",
          "translation": "Она чуть постарше меня.",
          "source": "Tatoeba #6917814 @dnnywld / #6917762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917814",
          "cefr_level": "A1",
          "word_slugs": [
            "anziana-adj"
          ]
        },
        {
          "id": "377184",
          "text": "Mia zia è più anziana di mia madre.",
          "translation": "Моя тётя старше моей матери.",
          "source": "Tatoeba #377184 @Pharamp / #1482540 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/377184",
          "cefr_level": "A1",
          "word_slugs": [
            "anziana-adj"
          ]
        },
        {
          "id": "5632323",
          "text": "Lei deve prendersi cura di una persona anziana.",
          "translation": "Она должна заботиться о том пожилом человеке.",
          "source": "Tatoeba #5632323 @dnnywld / #366843 @Tassadar (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632323",
          "cefr_level": "A1",
          "word_slugs": [
            "anziana-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
