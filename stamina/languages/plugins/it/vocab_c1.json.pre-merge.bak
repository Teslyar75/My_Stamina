            "improbabile-adj"
          ]
        },
        {
          "id": "6819638",
          "text": "È improbabile che vincerò.",
          "translation": "Я вряд ли выиграю.",
          "source": "Tatoeba #6819638 @dnnywld / #5929218 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6819638",
          "cefr_level": "A1",
          "word_slugs": [
            "improbabile-adj"
          ]
        },
        {
          "id": "6819635",
          "text": "È improbabile che lei verrà.",
          "translation": "Вряд ли она придёт.",
          "source": "Tatoeba #6819635 @dnnywld / #5045859 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6819635",
          "cefr_level": "A1",
          "word_slugs": [
            "improbabile-adj"
          ]
        }
