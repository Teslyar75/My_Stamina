      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3585762",
          "text": "Leopardi era un poeta.",
          "translation": "Леопарди был поэтом.",
          "source": "Tatoeba #3585762 @Guybrush88 / #3585899 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3585762",
          "cefr_level": "A1",
          "word_slugs": [
