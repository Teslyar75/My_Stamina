    {
      "slug": "sportivo-adj",
      "lemma": "sportivo",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8884,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3026991",
          "text": "Sono uno sportivo entusiasta.",
          "translation": "Я энтузиаст спорта.",
          "source": "Tatoeba #3026991 @Pharamp / #2383796 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3026991",
          "cefr_level": "A1",
          "word_slugs": [
            "sportivo-adj"
          ]
        },
        {
          "id": "6953496",
          "text": "Lui è alto e sportivo.",
          "translation": "Он высокий и спортивный.",
          "source": "Tatoeba #6953496 @dnnywld / #3460854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953496",
          "cefr_level": "A1",
          "word_slugs": [
            "sportivo-adj"
          ]
        },
        {
          "id": "425491",
          "text": "Voglio diventare un giornalista sportivo.",
          "translation": "Я хочу стать спортивным журналистом.",
          "source": "Tatoeba #425491 @Pharamp / #5655085 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/425491",
          "cefr_level": "A1",
          "word_slugs": [
            "sportivo-adj"
          ]
        },
        {
          "id": "6051355",
          "text": "Lui è lo sportivo dell'anno.",
          "translation": "Он спортсмен года.",
          "source": "Tatoeba #6051355 @dnnywld / #6051352 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6051355",
          "cefr_level": "A1",
          "word_slugs": [
            "sportivo-adj"
          ]
        },
        {
          "id": "2383804",
          "text": "La bicicletta è un attrezzo sportivo davvero unico.",
          "translation": "Велосипед является поистине уникальным спортивным оборудованием.",
          "source": "Tatoeba #2383804 @al_ex_an_der / #2383814 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2383804",
          "cefr_level": "A1",
          "word_slugs": [
            "sportivo-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
