    {
      "slug": "licenziare-verb",
      "lemma": "licenziare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5572,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2259847",
          "text": "Non puoi licenziare Tom.",
          "translation": "Ты не можешь уволить Тома.",
          "source": "Tatoeba #2259847 @Guybrush88 / #5072576 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259847",
          "cefr_level": "A1",
          "word_slugs": [
            "licenziare-verb"
          ]
        },
        {
          "id": "2259852",
          "text": "Non potete licenziare Tom.",
          "translation": "Вы не можете уволить Тома.",
          "source": "Tatoeba #2259852 @Guybrush88 / #5072575 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2259852",
          "cefr_level": "A1",
          "word_slugs": [
            "licenziare-verb"
          ]
        },
        {
          "id": "5494713",
          "text": "Non abbiamo intenzione di licenziare Tom.",
          "translation": "Мы не собираемся увольнять Тома.",
          "source": "Tatoeba #5494713 @dnnywld / #5494705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494713",
          "cefr_level": "A1",
          "word_slugs": [
            "licenziare-verb"
          ]
        },
        {
          "id": "1179806",
          "text": "Di chi è stata l'idea di licenziare Tom?",
          "translation": "Чьей идеей было уволить Тома?",
          "source": "Tatoeba #1179806 @Guybrush88 / #5496837 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1179806",
          "cefr_level": "A1",
          "word_slugs": [
            "licenziare-verb"
          ]
        },
        {
          "id": "5637262",
          "text": "Licenziare non ti licenzieranno, ma ti renderanno la vita molto difficile.",
          "translation": "Уволить они тебя не уволят, но крови попортят изрядно.",
          "source": "Tatoeba #5637262 @dnnywld / #5637166 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5637262",
          "cefr_level": "A1",
          "word_slugs": [
            "licenziare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "licenziare",
        "plural": "",
        "infinitive": "licenziare"
      }
    },
    {
      "slug": "decide-verb",
      "lemma": "decide",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5573,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1794049",
          "text": "Ognuno decide per se stesso.",
          "translation": "Каждый решает для себя сам.",
          "source": "Tatoeba #1794049 @al_ex_an_der / #1794042 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1794049",
          "cefr_level": "A1",
          "word_slugs": [
            "decide-verb"
          ]
        },
        {
          "id": "6839948",
          "text": "Domani si decide il mio destino.",
          "translation": "Завтра решается моя судьба.",
          "source": "Tatoeba #6839948 @dnnywld / #6839877 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6839948",
          "cefr_level": "A1",
          "word_slugs": [
            "decide-verb"
          ]
        },
        {
          "id": "6839945",
          "text": "Domani si decide il nostro destino.",
          "translation": "Завтра решается наша судьба.",
          "source": "Tatoeba #6839945 @dnnywld / #6839878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6839945",
          "cefr_level": "A1",
          "word_slugs": [
            "decide-verb"
          ]
        },
        {
          "id": "5425097",
          "text": "A volte la vita decide per noi.",
          "translation": "Иногда жизнь решает за нас.",
          "source": "Tatoeba #5425097 @dnnywld / #5424974 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5425097",
          "cefr_level": "A1",
          "word_slugs": [
            "decide-verb"
          ]
        },
        {
          "id": "905683",
          "text": "La donna decide da sé chi la conquisterà.",
          "translation": "Женщина сама решает, кто её победит.",
          "source": "Tatoeba #905683 @riccioberto / #632631 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/905683",
          "cefr_level": "A1",
          "word_slugs": [
            "decide-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "decide",
        "plural": "",
        "infinitive": "decide"
      }
    },
    {
      "slug": "legati-adj",
      "lemma": "legati",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5574,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6917807",
          "text": "Erano legati da un'amicizia.",
          "translation": "Их связывала дружба.",
          "source": "Tatoeba #6917807 @dnnywld / #6917777 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917807",
          "cefr_level": "A1",
          "word_slugs": [
            "legati-adj"
          ]
        },
        {
          "id": "7528660",
          "text": "Tom aveva le mani e i piedi legati.",
          "translation": "У Тома были связаны руки и ноги.",
          "source": "Tatoeba #7528660 @dnnywld / #7528598 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7528660",
          "cefr_level": "A1",
          "word_slugs": [
            "legati-adj"
          ]
        },
        {
          "id": "7528652",
          "text": "Le mani e i piedi di Tom erano legati.",
          "translation": "Руки и ноги Тома были связаны.",
          "source": "Tatoeba #7528652 @dnnywld / #7528600 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7528652",
          "cefr_level": "A1",
          "word_slugs": [
            "legati-adj"
          ]
        },
        {
          "id": "1616179",
          "text": "Nessuno è libero; perfino gli uccelli sono legati al cielo.",
          "translation": "Никто не свободен: даже птицы прикованы к небу.",
          "source": "Tatoeba #1616179 @hitori37 / #3565882 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1616179",
          "cefr_level": "A1",
          "word_slugs": [
            "legati-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il legati",
        "plural": "",
        "infinitive": ""
      }
