    {
      "slug": "odiava-verb",
      "lemma": "odiava",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7778,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "8362589",
          "text": "Odiava sua madre.",
          "translation": "Она ненавидела свою мать.",
          "source": "Tatoeba #8362589 @Guybrush88 / #7952776 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8362589",
          "cefr_level": "A1",
          "word_slugs": [
            "odiava-verb"
          ]
        },
        {
          "id": "13284459",
          "text": "Lei odiava andare a piedi.",
          "translation": "Она ненавидела ходить пешком.",
          "source": "Tatoeba #13284459 @dnnywld / #13226110 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13284459",
          "cefr_level": "A1",
          "word_slugs": [
            "odiava-verb"
          ]
        },
        {
          "id": "5527183",
          "text": "James Madison odiava questa idea.",
          "translation": "Джеймс Мэдисон ненавидел эту мысль.",
          "source": "Tatoeba #5527183 @dnnywld / #1424692 @Snark (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527183",
          "cefr_level": "A1",
          "word_slugs": [
            "odiava-verb"
          ]
        },
        {
          "id": "6377995",
          "text": "Una volta Tom odiava gli spinaci.",
          "translation": "Том раньше ненавидел шпинат.",
          "source": "Tatoeba #6377995 @dnnywld / #6377892 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6377995",
          "cefr_level": "A1",
          "word_slugs": [
            "odiava-verb"
          ]
        },
        {
          "id": "5471957",
          "text": "Tom non sapeva il motivo per cui Mary lo odiava.",
          "translation": "Том не знал, почему Мэри его ненавидит.",
          "source": "Tatoeba #5471957 @dnnywld / #5229680 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5471957",
          "cefr_level": "A1",
          "word_slugs": [
            "odiava-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "odiava",
        "plural": "",
        "infinitive": "odiava"
      }
