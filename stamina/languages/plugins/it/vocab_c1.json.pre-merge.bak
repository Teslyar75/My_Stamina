      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5594498",
          "text": "È ancora in garanzia.",
          "translation": "Он ещё на гарантии.",
          "source": "Tatoeba #5594498 @dnnywld / #5594454 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5594498",
          "cefr_level": "A1",
          "word_slugs": [
            "garanzia-noun"
          ]
        },
        {
          "id": "5390760",
          "text": "Non posso dare una tale garanzia.",
          "translation": "Я не могу дать такой гарантии.",
          "source": "Tatoeba #5390760 @dnnywld / #5390441 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5390760",
          "cefr_level": "A1",
          "word_slugs": [
            "garanzia-noun"
          ]
        },
        {
          "id": "6858817",
          "text": "Nessuno vi darà una garanzia simile.",
          "translation": "Никто вам такой гарантии не даст.",
          "source": "Tatoeba #6858817 @dnnywld / #6858713 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6858817",
          "cefr_level": "A1",
          "word_slugs": [
