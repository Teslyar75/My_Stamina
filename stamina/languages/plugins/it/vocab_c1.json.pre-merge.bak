    {
      "slug": "concetto-name",
      "lemma": "Concetto",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5367,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5663213",
          "text": "Hai un concetto errato dell'amore.",
          "translation": "У тебя ложное представление о любви.",
          "source": "Tatoeba #5663213 @dnnywld / #5661397 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5663213",
          "cefr_level": "A1",
          "word_slugs": [
            "concetto-name"
          ]
        },
        {
          "id": "11363603",
          "text": "Ha messi in ridicolo il mio concetto.",
          "translation": "Он поднял на смех мою идею.",
          "source": "Tatoeba #11363603 @Bernie75 / #2274786 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11363603",
          "cefr_level": "A1",
          "word_slugs": [
            "concetto-name"
          ]
        },
        {
          "id": "7275423",
          "text": "Questo concetto è apparso relativamente di recente.",
          "translation": "Это понятие появилось сравнительно недавно.",
          "source": "Tatoeba #7275423 @dnnywld / #7275279 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275423",
          "cefr_level": "A1",
          "word_slugs": [
            "concetto-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
