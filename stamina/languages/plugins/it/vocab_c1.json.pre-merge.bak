    {
      "slug": "frigorifero-adj",
      "lemma": "frigorifero",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8660,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "холодильник"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5385561",
          "text": "Ho il frigorifero rotto.",
          "translation": "У меня холодильник сломался.",
          "source": "Tatoeba #5385561 @dnnywld / #5385535 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385561",
          "cefr_level": "A1",
          "word_slugs": [
            "frigorifero-adj"
          ]
        },
        {
          "id": "5385325",
          "text": "Il boršč è in frigorifero.",
          "translation": "Борщ в холодильнике.",
          "source": "Tatoeba #5385325 @dnnywld / #5385316 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385325",
          "cefr_level": "A1",
          "word_slugs": [
            "frigorifero-adj"
          ]
        },
        {
          "id": "6586375",
          "text": "Non lasciare il frigorifero aperto.",
          "translation": "Не оставляй холодильник открытым.",
          "source": "Tatoeba #6586375 @Valdast / #6586380 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6586375",
          "cefr_level": "A1",
          "word_slugs": [
            "frigorifero-adj"
          ]
        },
        {
          "id": "4182136",
          "text": "Bisogna che riparino il frigorifero.",
          "translation": "Им надо починить холодильник.",
          "source": "Tatoeba #4182136 @Guybrush88 / #5062095 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4182136",
          "cefr_level": "A1",
          "word_slugs": [
            "frigorifero-adj"
          ]
        },
        {
          "id": "9045262",
          "text": "Il frigorifero è completamente vuoto.",
          "translation": "Холодильник совсем пуст.",
          "source": "Tatoeba #9045262 @carlosalberto / #6934390 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9045262",
          "cefr_level": "A1",
          "word_slugs": [
            "frigorifero-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il frigorifero",
        "plural": "",
        "infinitive": ""
      }
