      "translations": {
        "ru": [
          "хоккей"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5189895",
          "text": "Giocavo ad hockey.",
          "translation": "Я играл в хоккей.",
          "source": "Tatoeba #5189895 @Guybrush88 / #5190225 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5189895",
          "cefr_level": "A1",
          "word_slugs": [
            "hockey-noun"
          ]
        },
        {
          "id": "5496780",
          "text": "A Tom piace l'hockey su prato.",
          "translation": "Тому нравится хоккей на траве.",
          "source": "Tatoeba #5496780 @dnnywld / #5496663 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5496780",
          "cefr_level": "A1",
          "word_slugs": [
            "hockey-noun"
          ]
        },
        {
          "id": "5630955",
          "text": "Tom è un talentuoso giocatore di hockey.",
          "translation": "Том - талантливый хоккеист.",
          "source": "Tatoeba #5630955 @dnnywld / #5630947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5630955",
          "cefr_level": "A1",
          "word_slugs": [
            "hockey-noun"
          ]
        },
        {
          "id": "5766857",
          "text": "La partita di hockey si è conclusa in rissa.",
          "translation": "Хоккейный матч закончился дракой.",
          "source": "Tatoeba #5766857 @dnnywld / #5766548 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5766857",
          "cefr_level": "A1",
          "word_slugs": [
            "hockey-noun"
          ]
        },
        {
          "id": "3668515",
          "text": "Molti bambini nel Wisconsin giocano a hockey d'inverno.",
          "translation": "Многие дети в Висконсине зимой играют в хоккей.",
          "source": "Tatoeba #3668515 @Guybrush88 / #3668624 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3668515",
          "cefr_level": "A1",
          "word_slugs": [
            "hockey-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
