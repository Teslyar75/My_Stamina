    {
      "slug": "precisione-noun",
      "lemma": "precisione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6869,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6878034",
          "text": "Qui è importante l'estrema precisione.",
          "translation": "Тут важна исключительная точность.",
          "source": "Tatoeba #6878034 @dnnywld / #6878009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6878034",
          "cefr_level": "A1",
          "word_slugs": [
            "precisione-noun"
          ]
        },
        {
          "id": "6878033",
          "text": "In questo caso la precisione estrema è importante.",
          "translation": "В этом деле важна исключительная точность.",
          "source": "Tatoeba #6878033 @dnnywld / #6878010 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6878033",
          "cefr_level": "A1",
          "word_slugs": [
            "precisione-noun"
          ]
        },
        {
          "id": "5666489",
          "text": "Tom pretende di poter prevedere con precisione il futuro.",
          "translation": "Том утверждает, что может точно предсказывать будущее.",
          "source": "Tatoeba #5666489 @dnnywld / #5666314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5666489",
          "cefr_level": "A1",
          "word_slugs": [
            "precisione-noun"
          ]
        },
        {
          "id": "5386793",
          "text": "Non mi sono perso. Semplicemente non so con precisione dove sono.",
          "translation": "Я не заблудился. Я просто точно не знаю, где я.",
          "source": "Tatoeba #5386793 @dnnywld / #5386032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5386793",
          "cefr_level": "A1",
          "word_slugs": [
            "precisione-noun"
          ]
        },
        {
          "id": "13851590",
          "text": "Cosa è più importante nella traduzione: la precisione o la bellezza?",
          "translation": "Что в переводе важнее: точность или красота?",
          "source": "Tatoeba #13851590 @carlosalberto / #13851455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13851590",
          "cefr_level": "A1",
          "word_slugs": [
            "precisione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la precisione",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "dirige-verb",
      "lemma": "dirige",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6870,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5923316",
          "text": "Tom dirige questo progetto.",
          "translation": "Том руководит этим проектом.",
          "source": "Tatoeba #5923316 @dnnywld / #5793204 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5923316",
          "cefr_level": "A1",
          "word_slugs": [
            "dirige-verb"
          ]
        },
        {
          "id": "5642615",
          "text": "Tom si dirige ad ovest.",
          "translation": "Том направляется на запад.",
          "source": "Tatoeba #5642615 @dnnywld / #5642522 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642615",
          "cefr_level": "A1",
          "word_slugs": [
            "dirige-verb"
          ]
        },
        {
          "id": "6910783",
          "text": "Lui si dirige a Parigi.",
          "translation": "Он направляется в Париж.",
          "source": "Tatoeba #6910783 @dnnywld / #6909507 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6910783",
          "cefr_level": "A1",
          "word_slugs": [
            "dirige-verb"
          ]
        },
        {
          "id": "4912499",
          "text": "Il nostro aereo si dirige verso sud.",
          "translation": "Наш самолёт направляется на юг.",
          "source": "Tatoeba #4912499 @Guybrush88 / #5169341 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4912499",
          "cefr_level": "A1",
          "word_slugs": [
            "dirige-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "dirige",
        "plural": "",
        "infinitive": "dirige"
      }
