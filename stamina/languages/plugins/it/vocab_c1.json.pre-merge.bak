          ]
        },
        {
          "id": "5629716",
          "text": "Tom e Mary sono giovani e sani.",
          "translation": "Том и Мэри молоды и здоровы.",
          "source": "Tatoeba #5629716 @dnnywld / #5629032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629716",
          "cefr_level": "A1",
          "word_slugs": [
            "sani-adj"
          ]
        },
        {
          "id": "1190434",
          "text": "Ho portato tutti a casa sani e salvi.",
          "translation": "Я привёл всех домой целыми и невредимыми.",
          "source": "Tatoeba #1190434 @Guybrush88 / #4534320 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1190434",
          "cefr_level": "A1",
          "word_slugs": [
            "sani-adj"
          ]
        },
        {
          "id": "3516661",
          "text": "Spero che tutti siano arrivati sani e salvi.",
          "translation": "Я надеюсь, что все благополучно добрались.",
          "source": "Tatoeba #3516661 @Guybrush88 / #5900789 @Ivanovich (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3516661",
          "cefr_level": "A1",
          "word_slugs": [
            "sani-adj"
          ]
        },
        {
          "id": "5901651",
          "text": "Mi sono sentito sollevato nel sentire che eravate arrivati sani e salvi.",
          "translation": "Я вздохнул с облегчением, когда услышал, что вы благополучно добрались.",
          "source": "Tatoeba #5901651 @dnnywld / #5900834 @Ivanovich (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5901651",
          "cefr_level": "A1",
          "word_slugs": [
            "sani-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il sani",
        "plural": "",
        "infinitive": ""
      }
