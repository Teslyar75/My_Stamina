    {
      "slug": "meritano-verb",
      "lemma": "meritano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6769,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "950779",
          "text": "Tutti ottengono ciò che si meritano.",
          "translation": "Каждый получает то, что заслуживает.",
          "source": "Tatoeba #950779 @Guybrush88 / #1939705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/950779",
          "cefr_level": "A1",
          "word_slugs": [
            "meritano-verb"
          ]
        },
        {
          "id": "5845995",
          "text": "Stanno ottenendo quello che si meritano.",
          "translation": "Они получают то, что заслуживают.",
          "source": "Tatoeba #5845995 @dnnywld / #4899309 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845995",
          "cefr_level": "A1",
          "word_slugs": [
            "meritano-verb"
          ]
        },
        {
          "id": "3538602",
          "text": "Non tutti i testi meritano di essere pubblicati.",
          "translation": "Не все тексты заслуживают публикации.",
          "source": "Tatoeba #3538602 @al_ex_an_der / #3538592 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3538602",
          "cefr_level": "A1",
          "word_slugs": [
            "meritano-verb"
          ]
        },
        {
          "id": "10824121",
          "text": "Ci sono frasi che non meritano di essere tradotte.",
          "translation": "Есть предложения, которые не заслуживают того, чтобы их переводили.",
          "source": "Tatoeba #10824121 @dnnywld / #2824236 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10824121",
          "cefr_level": "A1",
          "word_slugs": [
            "meritano-verb"
          ]
        },
        {
          "id": "5393434",
          "text": "Soltanto i progetti a lungo termine meritano investimenti finanziari.",
          "translation": "Только перспективные проекты заслуживают финансовых вложений.",
          "source": "Tatoeba #5393434 @dnnywld / #1786053 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5393434",
          "cefr_level": "A1",
          "word_slugs": [
            "meritano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "meritano",
        "plural": "",
        "infinitive": "meritano"
      }
    },
    {
      "slug": "bestie-noun",
      "lemma": "bestie",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6773,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5942468",
          "text": "Queste bestie sono molto amichevoli.",
          "translation": "Эти звери очень дружелюбны.",
          "source": "Tatoeba #5942468 @dnnywld / #5942204 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5942468",
          "cefr_level": "A1",
          "word_slugs": [
            "bestie-noun"
          ]
        },
        {
          "id": "2985159",
          "text": "Anche le bestie le ha fatte il Signore.",
          "translation": "Животные также были сотворены Богом.",
          "source": "Tatoeba #2985159 @Guybrush88 / #3052536 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2985159",
          "cefr_level": "A1",
          "word_slugs": [
            "bestie-noun"
          ]
        },
        {
          "id": "6908643",
          "text": "Lui ha cominciato ad allevare bestie da macello.",
          "translation": "Он начал разводить скот на мясо.",
          "source": "Tatoeba #6908643 @dnnywld / #4563903 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908643",
          "cefr_level": "A1",
          "word_slugs": [
            "bestie-noun"
          ]
        },
        {
          "id": "2985140",
          "text": "Chi non ama le bestie, non ama i cristiani.",
          "translation": "Кто не любит животных, тот не любит христиан.",
          "source": "Tatoeba #2985140 @Guybrush88 / #3351036 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2985140",
          "cefr_level": "A1",
          "word_slugs": [
            "bestie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la bestie",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "segnato-adj",
      "lemma": "segnato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6774,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10849685",
          "text": "Chi ha segnato?",
          "translation": "Кто был автором гола?",
          "source": "Tatoeba #10849685 @dnnywld / #3540498 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849685",
          "cefr_level": "A1",
          "word_slugs": [
            "segnato-adj"
          ]
        },
        {
          "id": "5070493",
          "text": "Ho segnato un goal.",
          "translation": "Я забил гол.",
          "source": "Tatoeba #5070493 @Guybrush88 / #2589407 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5070493",
          "cefr_level": "A1",
          "word_slugs": [
            "segnato-adj"
          ]
        },
        {
          "id": "6845823",
          "text": "Ho segnato la lettera da leggere.",
          "translation": "Я пометил письмо непрочитанным.",
          "source": "Tatoeba #6845823 @dnnywld / #6845552 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845823",
          "cefr_level": "A1",
          "word_slugs": [
            "segnato-adj"
          ]
        },
        {
          "id": "5683679",
          "text": "Tom ha segnato due gol durante il primo tempo.",
          "translation": "Том забил два гола в первом тайме.",
          "source": "Tatoeba #5683679 @dnnywld / #5680116 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683679",
          "cefr_level": "A1",
          "word_slugs": [
            "segnato-adj"
          ]
        },
        {
          "id": "6924177",
          "text": "Ad ogni goal segnato, i tifosi si abbracciano e si baciano.",
          "translation": "После каждого забитого гола болельщики обнимаются и целуются.",
          "source": "Tatoeba #6924177 @dnnywld / #6923908 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6924177",
          "cefr_level": "A1",
          "word_slugs": [
            "segnato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il segnato",
        "plural": "",
        "infinitive": ""
      }
    },
