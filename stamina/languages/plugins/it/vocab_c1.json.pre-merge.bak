    {
      "slug": "sentiva-verb",
      "lemma": "sentiva",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5075,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6904500",
          "text": "Come si sentiva Tom?",
          "translation": "Как Том себя чувствовал?",
          "source": "Tatoeba #6904500 @dnnywld / #6904444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904500",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiva-verb"
          ]
        },
        {
          "id": "5584007",
          "text": "Tom si sentiva debole.",
          "translation": "Том чувствовал слабость.",
          "source": "Tatoeba #5584007 @Guybrush88 / #5888641 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5584007",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiva-verb"
          ]
        },
        {
          "id": "11107042",
          "text": "Tom si sentiva meglio.",
          "translation": "Том чувствовал себя лучше.",
          "source": "Tatoeba #11107042 @monfernosknee / #11107117 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11107042",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiva-verb"
          ]
        },
        {
          "id": "3154928",
          "text": "Tom si sentiva escluso.",
          "translation": "Том почувствовал себя лишним.",
          "source": "Tatoeba #3154928 @Guybrush88 / #2340911 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3154928",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiva-verb"
          ]
        },
        {
          "id": "6321257",
          "text": "Layla si sentiva amata.",
          "translation": "Лейла чувствовала себя любимой.",
          "source": "Tatoeba #6321257 @Guybrush88 / #7275271 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6321257",
          "cefr_level": "A1",
          "word_slugs": [
            "sentiva-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
