    {
      "slug": "pomodori-noun",
      "lemma": "pomodori",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9354,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3767097",
          "text": "No, sono i pomodori!",
          "translation": "Нет, это помидоры!",
          "source": "Tatoeba #3767097 @Guybrush88 / #3767106 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3767097",
          "cefr_level": "A1",
          "word_slugs": [
            "pomodori-noun"
          ]
        },
        {
          "id": "5415032",
          "text": "Lei mangia i pomodori.",
          "translation": "Она ест помидоры.",
          "source": "Tatoeba #5415032 @dnnywld / #5272085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415032",
          "cefr_level": "A1",
          "word_slugs": [
            "pomodori-noun"
          ]
        },
        {
          "id": "11712832",
          "text": "I pomodori sono rossi.",
          "translation": "Помидоры красные.",
          "source": "Tatoeba #11712832 @Guybrush88 / #10108678 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11712832",
          "cefr_level": "A1",
          "word_slugs": [
            "pomodori-noun"
          ]
        },
        {
          "id": "9929945",
          "text": "Coltiva pomodori nell'orto.",
          "translation": "Он выращивает томаты в огороде.",
          "source": "Tatoeba #9929945 @super5 / #2853137 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9929945",
          "cefr_level": "A1",
          "word_slugs": [
            "pomodori-noun"
          ]
        },
        {
          "id": "12686837",
          "text": "I pomodori maturi sono rossi.",
          "translation": "Спелые помидоры красные.",
          "source": "Tatoeba #12686837 @Adelpa / #12686822 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12686837",
          "cefr_level": "A1",
          "word_slugs": [
            "pomodori-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
