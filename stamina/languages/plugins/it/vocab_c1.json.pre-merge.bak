    {
      "slug": "necessità-noun",
      "lemma": "necessità",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9033,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "11511315",
          "text": "La necessità infrange la legge.",
          "translation": "Нужда свой закон пишет.",
          "source": "Tatoeba #11511315 @Bernie75 / #3187978 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11511315",
          "cefr_level": "A1",
          "word_slugs": [
            "necessità-noun"
          ]
        },
        {
          "id": "10846929",
          "text": "Non vedo la necessità di farlo.",
          "translation": "Не вижу необходимости это делать.",
          "source": "Tatoeba #10846929 @dnnywld / #10587234 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846929",
          "cefr_level": "A1",
          "word_slugs": [
            "necessità-noun"
          ]
        },
        {
          "id": "10838763",
          "text": "Tom aveva necessità di un bypass.",
          "translation": "Тому требовалось шунтирование.",
          "source": "Tatoeba #10838763 @dnnywld / #10837046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10838763",
          "cefr_level": "A1",
          "word_slugs": [
            "necessità-noun"
          ]
        },
        {
          "id": "7856360",
          "text": "Non hai alcuna necessità di correre.",
          "translation": "Тебе нет необходимости спешить.",
          "source": "Tatoeba #7856360 @dnnywld / #7856291 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7856360",
          "cefr_level": "A1",
          "word_slugs": [
            "necessità-noun"
          ]
        },
        {
          "id": "7065309",
          "text": "Saper coniugare i verbi è un'assoluta necessità.",
          "translation": "Уметь спрягать глаголы — абсолютная необходимость.",
          "source": "Tatoeba #7065309 @dnnywld / #7065128 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7065309",
          "cefr_level": "A1",
          "word_slugs": [
            "necessità-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la necessità",
        "plural": "",
