    {
      "slug": "insiste-verb",
      "lemma": "insiste",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9558,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6967732",
          "text": "Mi licenzio. Mary insiste su questo.",
          "translation": "Я бросаю работу. Мэри на этом настаивает.",
          "source": "Tatoeba #6967732 @dnnywld / #5465794 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6967732",
          "cefr_level": "A1",
          "word_slugs": [
            "insiste-verb"
          ]
        },
        {
          "id": "1528628",
          "text": "Lei insiste sull'innocenza di suo figlio.",
          "translation": "Она настаивает на невиновности своего сына.",
          "source": "Tatoeba #1528628 @Guybrush88 / #1792773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1528628",
          "cefr_level": "A1",
          "word_slugs": [
            "insiste-verb"
          ]
        },
        {
          "id": "6961749",
          "text": "Il redattore insiste che accorci l'articolo e cambi qualcosa.",
          "translation": "Редактор настаивает, чтобы я сократил статью и кое-что изменил.",
          "source": "Tatoeba #6961749 @dnnywld / #6961709 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961749",
          "cefr_level": "A1",
          "word_slugs": [
            "insiste-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "insiste",
        "plural": "",
        "infinitive": "insiste"
      }
