    {
      "slug": "suggerito-verb",
      "lemma": "suggerito",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7352,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6009552",
          "text": "Questo lo ha suggerito lei.",
          "translation": "Это она предложила.",
          "source": "Tatoeba #6009552 @dnnywld / #6007579 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009552",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerito-verb"
          ]
        },
        {
          "id": "2823086",
          "text": "L'hai suggerito tu a Tom?",
          "translation": "Ты предложил это Тому?",
          "source": "Tatoeba #2823086 @Guybrush88 / #7311738 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2823086",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerito-verb"
          ]
        },
        {
          "id": "2823089",
          "text": "L'avete suggerito voi a Tom?",
          "translation": "Вы предложили это Тому?",
          "source": "Tatoeba #2823089 @Guybrush88 / #7311739 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2823089",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerito-verb"
          ]
        },
        {
          "id": "5993927",
          "text": "Ho suggerito di fare quattro passi.",
          "translation": "Я предложил прогуляться.",
          "source": "Tatoeba #5993927 @dnnywld / #5992808 @kukla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5993927",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerito-verb"
          ]
        },
        {
          "id": "1022010",
          "text": "Ho suggerito di andare a fare una passeggiata.",
          "translation": "Я предложил отправиться на прогулку.",
          "source": "Tatoeba #1022010 @Guybrush88 / #3364664 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1022010",
          "cefr_level": "A1",
          "word_slugs": [
            "suggerito-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il suggerito",
        "plural": "",
        "infinitive": "suggerito"
      }
    },
    {
      "slug": "pollice-noun",
      "lemma": "pollice",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7353,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "дюйм"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "651039",
          "text": "La mano ha cinque dita: pollice, indice, medio, anulare, mignolo.",
          "translation": "На руке пять пальцев: большой, указательный, средний, безымянный, мизинец.",
          "source": "Tatoeba #651039 @rado / #6107528 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/651039",
          "cefr_level": "A1",
          "word_slugs": [
            "pollice-noun"
          ]
        },
        {
          "id": "1545159",
          "text": "Tom ha catturato una zanzara tra il pollice e l'indice.",
          "translation": "Том захватил комара между большим и указательным пальцами.",
          "source": "Tatoeba #1545159 @Guybrush88 / #4442046 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1545159",
          "cefr_level": "A1",
          "word_slugs": [
            "pollice-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il pollice",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "ostacolo-noun",
      "lemma": "ostacolo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7354,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7023876",
          "text": "La distanza in amore non è un ostacolo.",
          "translation": "Расстояние для любви не помеха.",
          "source": "Tatoeba #7023876 @dnnywld / #7023013 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7023876",
          "cefr_level": "A1",
          "word_slugs": [
            "ostacolo-noun"
          ]
        },
        {
          "id": "2426915",
          "text": "L'unico ostacolo al raggiungimento dei nostri obiettivi sono i nostri dubbi.",
          "translation": "Единственным препятствием к достижению наших целей являются наши сомнения.",
          "source": "Tatoeba #2426915 @al_ex_an_der / #2426906 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2426915",
          "cefr_level": "A1",
          "word_slugs": [
            "ostacolo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
