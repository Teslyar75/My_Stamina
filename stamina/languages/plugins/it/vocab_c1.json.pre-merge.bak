    {
      "slug": "confesso-adj",
      "lemma": "confesso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9454,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5690459",
          "text": "Ti confesso un segreto.",
          "translation": "Я доверю тебе один секрет.",
          "source": "Tatoeba #5690459 @dnnywld / #5690136 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690459",
          "cefr_level": "A1",
          "word_slugs": [
            "confesso-adj"
          ]
        },
        {
          "id": "5519153",
          "text": "Confesso che la mia traduzione non è perfetta.",
          "translation": "Признаю, что мой перевод не идеален.",
          "source": "Tatoeba #5519153 @dnnywld / #5518863 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5519153",
          "cefr_level": "A1",
          "word_slugs": [
            "confesso-adj"
          ]
        },
        {
          "id": "6955568",
          "text": "Confesso che il mio primo pensiero fu: lei è pazza.",
          "translation": "Признаюсь, первой моей мыслью было: она сумасшедшая.",
          "source": "Tatoeba #6955568 @dnnywld / #6955475 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6955568",
          "cefr_level": "A1",
          "word_slugs": [
            "confesso-adj"
          ]
        },
        {
          "id": "6955570",
          "text": "Confesso che il mio primo pensiero fu: lui è pazzo.",
          "translation": "Признаюсь, первой моей мыслью было: он сумасшедший.",
          "source": "Tatoeba #6955570 @dnnywld / #6955474 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6955570",
          "cefr_level": "A1",
          "word_slugs": [
            "confesso-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
