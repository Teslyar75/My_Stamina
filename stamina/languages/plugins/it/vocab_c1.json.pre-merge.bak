    {
      "slug": "borse-noun",
      "lemma": "borse",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6468,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2853167",
          "text": "Quante borse avevi?",
          "translation": "Сколько у тебя было сумок?",
          "source": "Tatoeba #2853167 @Guybrush88 / #4821123 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2853167",
          "cefr_level": "A1",
          "word_slugs": [
            "borse-noun"
          ]
        },
        {
          "id": "2853169",
          "text": "Quante borse avevate?",
          "translation": "Сколько у тебя было сумок?",
          "source": "Tatoeba #2853169 @Guybrush88 / #4821123 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2853169",
          "cefr_level": "A1",
          "word_slugs": [
            "borse-noun"
          ]
        },
        {
          "id": "13284467",
          "text": "Prenderemo le tue borse.",
          "translation": "Мы возьмём твои сумки.",
          "source": "Tatoeba #13284467 @dnnywld / #13223792 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13284467",
          "cefr_level": "A1",
          "word_slugs": [
            "borse-noun"
          ]
        },
        {
          "id": "3852579",
          "text": "Uso raramente le borse di plastica.",
          "translation": "Я редко пользуюсь пластиковыми пакетами.",
          "source": "Tatoeba #3852579 @Guybrush88 / #3852634 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3852579",
          "cefr_level": "A1",
          "word_slugs": [
            "borse-noun"
          ]
        },
        {
          "id": "5845518",
          "text": "Molti studenti poveri ricevono borse di studio.",
          "translation": "Многие бедные студенты получают стипендии.",
          "source": "Tatoeba #5845518 @dnnywld / #4182741 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845518",
          "cefr_level": "A1",
          "word_slugs": [
            "borse-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la borse",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "ubriachi-noun",
      "lemma": "ubriachi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6470,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2551607",
          "text": "Siamo troppo ubriachi.",
          "translation": "Мы слишком пьяны.",
          "source": "Tatoeba #2551607 @Guybrush88 / #6875716 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2551607",
          "cefr_level": "A1",
          "word_slugs": [
            "ubriachi-noun"
          ]
        },
        {
          "id": "5393077",
          "text": "Eravate ubriachi, vero?",
          "translation": "Вы же были пьяны?",
          "source": "Tatoeba #5393077 @dnnywld / #2289112 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5393077",
          "cefr_level": "A1",
          "word_slugs": [
            "ubriachi-noun"
          ]
        },
        {
          "id": "3108500",
          "text": "Eravamo entrambi ubriachi.",
          "translation": "Мы оба были пьяные.",
          "source": "Tatoeba #3108500 @Guybrush88 / #3148216 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3108500",
          "cefr_level": "A1",
          "word_slugs": [
            "ubriachi-noun"
          ]
        },
        {
          "id": "5386871",
          "text": "Tom pensava che foste ubriachi.",
          "translation": "Том подумал, Вы пьяны.",
          "source": "Tatoeba #5386871 @dnnywld / #5385972 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5386871",
          "cefr_level": "A1",
          "word_slugs": [
            "ubriachi-noun"
          ]
        },
        {
          "id": "5971611",
          "text": "Sono tutti ubriachi eccetto Tom.",
          "translation": "Все, кроме Тома, пьяны.",
          "source": "Tatoeba #5971611 @dnnywld / #5969334 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971611",
          "cefr_level": "A1",
          "word_slugs": [
            "ubriachi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ubriachi",
        "plural": "",
        "infinitive": ""
      }
    },
