      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5489549",
          "text": "Ero paralizzato dal terrore.",
          "translation": "Я оцепенел от ужаса.",
          "source": "Tatoeba #5489549 @dnnywld / #5488352 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489549",
          "cefr_level": "A1",
