    {
      "slug": "guancia-noun",
      "lemma": "guancia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9460,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2439805",
          "text": "Lui mi baciò sulla guancia.",
          "translation": "Он поцеловал меня в щёку.",
          "source": "Tatoeba #2439805 @Guybrush88 / #3124601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2439805",
          "cefr_level": "A1",
          "word_slugs": [
            "guancia-noun"
          ]
        },
        {
          "id": "8994497",
          "text": "Ha una cicatrice sulla guancia.",
          "translation": "У него шрам на щеке.",
          "source": "Tatoeba #8994497 @Guybrush88 / #7950586 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8994497",
          "cefr_level": "A1",
          "word_slugs": [
            "guancia-noun"
          ]
        },
        {
          "id": "3367923",
          "text": "La ragazza baciò suo padre sulla guancia.",
          "translation": "Девушка поцеловала отца в щёку.",
          "source": "Tatoeba #3367923 @Guybrush88 / #6839370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3367923",
          "cefr_level": "A1",
          "word_slugs": [
            "guancia-noun"
          ]
        },
        {
          "id": "5387147",
          "text": "Sono scese due lacrime sulla sua guancia.",
          "translation": "Две слезы скатились по его щекам.",
          "source": "Tatoeba #5387147 @dnnywld / #5387081 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387147",
          "cefr_level": "A1",
          "word_slugs": [
            "guancia-noun"
          ]
        },
        {
          "id": "6327561",
          "text": "Come ti è venuta quella cicatrice sulla guancia?",
          "translation": "Откуда у тебя этот шрам на щеке?",
          "source": "Tatoeba #6327561 @dnnywld / #6327268 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6327561",
          "cefr_level": "A1",
          "word_slugs": [
            "guancia-noun"
          ]
        }
      ],
      "tags": [
