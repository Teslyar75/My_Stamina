    {
      "slug": "obbligato-verb",
      "lemma": "obbligato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5293,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6875054",
          "text": "Sei obbligato a farlo?",
          "translation": "Ты обязан это делать?",
          "source": "Tatoeba #6875054 @dnnywld / #6875033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6875054",
          "cefr_level": "A1",
          "word_slugs": [
            "obbligato-verb"
          ]
        },
        {
          "id": "12381474",
          "text": "No, non sei obbligato.",
          "translation": "Нет, ты не обязан.",
          "source": "Tatoeba #12381474 @dnnywld / #12381362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12381474",
          "cefr_level": "A1",
          "word_slugs": [
            "obbligato-verb"
          ]
        },
        {
          "id": "5652257",
          "text": "Non mi sento obbligato.",
          "translation": "Я не чувствую себя обязанным.",
          "source": "Tatoeba #5652257 @dnnywld / #5651558 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652257",
          "cefr_level": "A1",
          "word_slugs": [
            "obbligato-verb"
          ]
        },
        {
          "id": "12381475",
          "text": "No, non siete obbligato.",
          "translation": "Нет, Вы не обязаны.",
          "source": "Tatoeba #12381475 @dnnywld / #12381361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12381475",
          "cefr_level": "A1",
          "word_slugs": [
            "obbligato-verb"
          ]
        },
        {
          "id": "6919547",
          "text": "Non ti ho obbligato a questo.",
          "translation": "Я тебя к этому не принуждал.",
          "source": "Tatoeba #6919547 @dnnywld / #6919307 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6919547",
          "cefr_level": "A1",
          "word_slugs": [
            "obbligato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
