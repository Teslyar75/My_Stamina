      "frequency_rank": 6984,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5779749",
          "text": "Chi tiene la torcia?",
          "translation": "Кто держит факел?",
          "source": "Tatoeba #5779749 @Balamax / #5779737 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5779749",
          "cefr_level": "A1",
          "word_slugs": [
            "torcia-noun"
          ]
        },
        {
          "id": "6072316",
          "text": "La torcia elettrica non si accende.",
          "translation": "Фонарик не включается.",
          "source": "Tatoeba #6072316 @dnnywld / #6071585 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6072316",
          "cefr_level": "A1",
          "word_slugs": [
            "torcia-noun"
          ]
        },
        {
          "id": "6956593",
          "text": "Tom accese la torcia e illuminò intorno.",
          "translation": "Том включил фонарик и посветил вокруг.",
          "source": "Tatoeba #6956593 @dnnywld / #6956187 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6956593",
          "cefr_level": "A1",
          "word_slugs": [
            "torcia-noun"
          ]
        },
        {
          "id": "6806312",
          "text": "Il poliziotto illuminò il viso di Tom con una torcia.",
          "translation": "Полицейский посветил фонариком Тому в лицо.",
          "source": "Tatoeba #6806312 @dnnywld / #6805686 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6806312",
          "cefr_level": "A1",
          "word_slugs": [
            "torcia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la torcia",
        "plural": "",
        "infinitive": ""
      }
    },
