          ]
        },
        {
          "id": "10851249",
          "text": "Vuoi sentire una barzelletta?",
          "translation": "Хочешь анекдот?",
          "source": "Tatoeba #10851249 @dnnywld / #4625144 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851249",
