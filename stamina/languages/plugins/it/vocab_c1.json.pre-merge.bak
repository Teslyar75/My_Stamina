      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10854779",
          "text": "Che bel mazzo di fiori!",
          "translation": "Какой красивый букет!",
          "source": "Tatoeba #10854779 @dnnywld / #4373374 @marllboro06 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854779",
          "cefr_level": "A1",
          "word_slugs": [
            "mazzo-noun"
          ]
        },
        {
          "id": "6865972",
          "text": "Mi è caduto un mazzo di chiavi.",
          "translation": "Я уронил связку ключей.",
          "source": "Tatoeba #6865972 @dnnywld / #6865869 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6865972",
          "cefr_level": "A1",
          "word_slugs": [
            "mazzo-noun"
          ]
        },
        {
          "id": "6865973",
          "text": "Ho tirato fuori un mazzo di chiavi.",
          "translation": "Я достала связку ключей.",
          "source": "Tatoeba #6865973 @dnnywld / #6865867 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6865973",
          "cefr_level": "A1",
          "word_slugs": [
            "mazzo-noun"
          ]
        },
        {
          "id": "2443681",
          "text": "Lui mi ha regalato un mazzo di fiori.",
          "translation": "Он вручил мне букет цветов.",
          "source": "Tatoeba #2443681 @Guybrush88 / #2443656 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2443681",
          "cefr_level": "A1",
          "word_slugs": [
            "mazzo-noun"
          ]
        },
        {
          "id": "6865976",
          "text": "Ho tirato fuori dalla borsetta un mazzo di chiavi.",
          "translation": "Я достала из сумочки связку ключей.",
          "source": "Tatoeba #6865976 @dnnywld / #6865864 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6865976",
          "cefr_level": "A1",
          "word_slugs": [
            "mazzo-noun"
          ]
        }
      ],
      "tags": [
