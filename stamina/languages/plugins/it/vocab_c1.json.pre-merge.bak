    {
      "slug": "clima-noun",
      "lemma": "clima",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8223,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "759913",
          "text": "Il clima è piacevole.",
          "translation": "Климат приятный.",
          "source": "Tatoeba #759913 @Guybrush88 / #1511986 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/759913",
          "cefr_level": "A1",
          "word_slugs": [
            "clima-noun"
          ]
        },
        {
          "id": "3361273",
          "text": "Ti abituerai al clima.",
          "translation": "Ты привыкнешь к погоде.",
          "source": "Tatoeba #3361273 @Guybrush88 / #3361256 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3361273",
          "cefr_level": "A1",
          "word_slugs": [
            "clima-noun"
          ]
        },
        {
          "id": "5620251",
          "text": "Sono abituato a questo clima.",
          "translation": "Я привык к этому климату.",
          "source": "Tatoeba #5620251 @dnnywld / #3873753 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5620251",
          "cefr_level": "A1",
          "word_slugs": [
            "clima-noun"
          ]
        },
        {
          "id": "4386408",
          "text": "Dobbiamo abituarci al nuovo clima.",
          "translation": "Мы должны привыкнуть к новому климату.",
          "source": "Tatoeba #4386408 @Guybrush88 / #5296333 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4386408",
          "cefr_level": "A1",
          "word_slugs": [
            "clima-noun"
          ]
        },
        {
          "id": "340690",
          "text": "Il Canada ha un clima freddo.",
          "translation": "В Канаде холодный климат.",
          "source": "Tatoeba #340690 @hwarang / #3070791 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/340690",
          "cefr_level": "A1",
          "word_slugs": [
            "clima-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il clima",
