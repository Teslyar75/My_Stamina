    {
      "slug": "guardano-verb",
      "lemma": "guardano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5059,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5500215",
          "text": "Si guardano allo specchio.",
          "translation": "Они смотрятся в зеркало.",
          "source": "Tatoeba #5500215 @dnnywld / #2450138 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500215",
          "cefr_level": "A1",
          "word_slugs": [
            "guardano-verb"
          ]
        },
        {
          "id": "5513026",
          "text": "Io guardo le stelle, e le stelle guardano me.",
          "translation": "Я смотрю на звёзды, а звёзды смотрят на меня.",
          "source": "Tatoeba #5513026 @dnnywld / #5512463 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513026",
          "cefr_level": "A1",
          "word_slugs": [
            "guardano-verb"
          ]
        },
        {
          "id": "6910796",
          "text": "Non riesco a concentrarmi quando le persone mi guardano.",
          "translation": "Я не могу сосредоточиться, когда люди на меня смотрят.",
          "source": "Tatoeba #6910796 @dnnywld / #6909492 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6910796",
          "cefr_level": "A1",
          "word_slugs": [
            "guardano-verb"
          ]
        },
        {
          "id": "6811148",
          "text": "Le nuove generazioni guardano alla vita in maniera differente.",
          "translation": "Молодое поколение смотрит на жизнь иначе.",
          "source": "Tatoeba #6811148 @dnnywld / #1670636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6811148",
          "cefr_level": "A1",
          "word_slugs": [
            "guardano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "guardano",
        "plural": "",
        "infinitive": "guardano"
      }
