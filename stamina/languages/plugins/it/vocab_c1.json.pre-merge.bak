    {
      "slug": "chiedete-verb",
      "lemma": "chiedete",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6131,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5554264",
          "text": "Farò come chiedete.",
          "translation": "Я сделаю, как вы просите.",
          "source": "Tatoeba #5554264 @dnnywld / #5553685 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5554264",
          "cefr_level": "A1",
          "word_slugs": [
            "chiedete-verb"
          ]
        },
        {
          "id": "5846200",
          "text": "Chiedete e otterrete.",
          "translation": "Спросите, и получите.",
          "source": "Tatoeba #5846200 @dnnywld / #3319879 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846200",
          "cefr_level": "A1",
          "word_slugs": [
            "chiedete-verb"
          ]
        },
        {
          "id": "13494675",
          "text": "Chiedete qualcos'altro.",
          "translation": "Спросите ещё что-нибудь.",
          "source": "Tatoeba #13494675 @dnnywld / #11340908 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13494675",
          "cefr_level": "A1",
          "word_slugs": [
            "chiedete-verb"
          ]
        },
        {
          "id": "13494671",
          "text": "Chiedete ancora qualcosa.",
          "translation": "Спросите ещё что-нибудь.",
          "source": "Tatoeba #13494671 @dnnywld / #11340908 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13494671",
          "cefr_level": "A1",
          "word_slugs": [
