    {
      "slug": "api-noun",
      "lemma": "api",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6936,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6908621",
          "text": "Sei capace di allevare le api?",
          "translation": "Ты умеешь разводить пчёл?",
          "source": "Tatoeba #6908621 @dnnywld / #6376696 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908621",
          "cefr_level": "A1",
          "word_slugs": [
            "api-noun"
          ]
        },
        {
          "id": "7554331",
          "text": "I gruccioni non mangiano solo api.",
          "translation": "Пчелоедки едят не только пчёл.",
          "source": "Tatoeba #7554331 @dnnywld / #7553862 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7554331",
          "cefr_level": "A1",
          "word_slugs": [
            "api-noun"
          ]
        },
        {
          "id": "3350918",
          "text": "Lo sanno tutti che le api bevono il miele.",
          "translation": "Все знают, что пчёлы пьют мёд.",
          "source": "Tatoeba #3350918 @Guybrush88 / #3711609 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3350918",
          "cefr_level": "A1",
          "word_slugs": [
            "api-noun"
          ]
        },
        {
          "id": "5989300",
          "text": "Come fanno esattamente le api a fare il miele?",
          "translation": "Как именно пчёлы делают мёд?",
          "source": "Tatoeba #5989300 @dnnywld / #5989098 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5989300",
          "cefr_level": "A1",
          "word_slugs": [
            "api-noun"
          ]
        },
        {
          "id": "10841253",
          "text": "Il ragazzo decise di osservare e registrare le api nel dettaglio.",
          "translation": "Мальчик решил понаблюдать и записать пчёл в подробностях.",
          "source": "Tatoeba #10841253 @dnnywld / #1480808 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10841253",
          "cefr_level": "A1",
          "word_slugs": [
            "api-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la api",
        "plural": "",
        "infinitive": ""
      }
    },
