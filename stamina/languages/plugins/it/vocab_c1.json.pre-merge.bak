    {
      "slug": "penserai-verb",
      "lemma": "penserai",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6778,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6839642",
          "text": "La prossima volta penserai.",
          "translation": "В следующий раз будешь думать.",
          "source": "Tatoeba #6839642 @dnnywld / #6839245 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6839642",
          "cefr_level": "A1",
          "word_slugs": [
            "penserai-verb"
          ]
        },
        {
          "id": "6839639",
          "text": "La prossima volta penserai prima di agire.",
          "translation": "В следующий раз будешь думать, прежде чем делать.",
          "source": "Tatoeba #6839639 @dnnywld / #6839249 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6839639",
          "cefr_level": "A1",
          "word_slugs": [
            "penserai-verb"
          ]
        }
      ],
      "tags": [
