      "examples": [
        {
          "id": "4503964",
          "text": "Prenderò del sushi.",
          "translation": "Я возьму суши.",
          "source": "Tatoeba #4503964 @Guybrush88 / #5705838 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4503964",
          "cefr_level": "A1",
          "word_slugs": [
