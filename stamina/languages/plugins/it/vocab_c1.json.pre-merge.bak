    {
      "slug": "costantemente-adv",
      "lemma": "costantemente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7881,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "постоянно"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5549676",
          "text": "Ho costantemente sete.",
          "translation": "Меня постоянно мучает жажда.",
          "source": "Tatoeba #5549676 @dnnywld / #3578943 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549676",
          "cefr_level": "A1",
          "word_slugs": [
            "costantemente-adv"
          ]
        },
        {
          "id": "5662220",
          "text": "Lui è costantemente all'estero.",
          "translation": "Он постоянно бывает за границей.",
          "source": "Tatoeba #5662220 @dnnywld / #5661287 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662220",
          "cefr_level": "A1",
          "word_slugs": [
            "costantemente-adv"
          ]
        },
        {
          "id": "6477852",
          "text": "Lei è costantemente in movimento.",
          "translation": "Она постоянно в движении.",
          "source": "Tatoeba #6477852 @dnnywld / #6477676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6477852",
          "cefr_level": "A1",
          "word_slugs": [
            "costantemente-adv"
          ]
        },
        {
          "id": "5549114",
          "text": "Devi costantemente fare del tuo meglio.",
          "translation": "Ты постоянно должен стараться изо всех сил.",
          "source": "Tatoeba #5549114 @dnnywld / #2278642 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549114",
          "cefr_level": "A1",
          "word_slugs": [
            "costantemente-adv"
          ]
        },
        {
          "id": "5539267",
          "text": "Questo succede costantemente. Non ti pare?",
          "translation": "Да это постоянно случается. Тебе так не кажется?",
          "source": "Tatoeba #5539267 @dnnywld / #5538993 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5539267",
          "cefr_level": "A1",
          "word_slugs": [
            "costantemente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "costantemente",
        "plural": "",
        "infinitive": ""
      }
