          ]
        },
        {
          "id": "6799958",
          "text": "Lui mi ha puntato l'arma contro.",
          "translation": "Он направил на меня своё оружие.",
          "source": "Tatoeba #6799958 @dnnywld / #3270112 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799958",
          "cefr_level": "A1",
          "word_slugs": [
            "puntato-verb"
          ]
        },
        {
          "id": "6799953",
          "text": "Lui mi ha puntato contro la pistola.",
          "translation": "Он направил на меня своё ружьё.",
          "source": "Tatoeba #6799953 @dnnywld / #3270119 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799953",
          "cefr_level": "A1",
          "word_slugs": [
