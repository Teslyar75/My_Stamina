      "cefr_level": "C1",
      "frequency_rank": 5796,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1109258",
          "text": "Puoi sempre fare affidamento su Tom.",
          "translation": "Ты всегда можешь положиться на Тома.",
          "source": "Tatoeba #1109258 @riccioberto / #6055514 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1109258",
          "cefr_level": "A1",
          "word_slugs": [
            "affidamento-noun"
          ]
        },
        {
          "id": "5453993",
          "text": "Su di me si può fare affidamento.",
          "translation": "На меня можно положиться.",
          "source": "Tatoeba #5453993 @dnnywld / #4300423 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5453993",
          "cefr_level": "A1",
          "word_slugs": [
            "affidamento-noun"
          ]
        },
        {
          "id": "6143299",
          "text": "Devo fare affidamento solo su me stesso.",
          "translation": "Мне приходится рассчитывать только на себя.",
          "source": "Tatoeba #6143299 @dnnywld / #6143284 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6143299",
          "cefr_level": "A1",
          "word_slugs": [
            "affidamento-noun"
          ]
        },
        {
          "id": "10846968",
          "text": "È una persona sulla quale puoi fare affidamento.",
          "translation": "Это человек, на которого ты можешь рассчитывать.",
          "source": "Tatoeba #10846968 @dnnywld / #10587131 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846968",
          "cefr_level": "A1",
          "word_slugs": [
            "affidamento-noun"
          ]
        },
        {
          "id": "10846970",
          "text": "È una persona sulla quale potete fare affidamento.",
          "translation": "Это человек, на которого вы можете рассчитывать.",
          "source": "Tatoeba #10846970 @dnnywld / #10587129 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846970",
          "cefr_level": "A1",
          "word_slugs": [
            "affidamento-noun"
          ]
        }
      ],
