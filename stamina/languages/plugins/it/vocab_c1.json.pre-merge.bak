      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10851072",
          "text": "Recita l'alfabeto al contrario.",
          "translation": "Расскажи алфавит задом наперед.",
          "source": "Tatoeba #10851072 @dnnywld / #468908 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851072",
          "cefr_level": "A1",
          "word_slugs": [
            "recita-noun"
          ]
        },
        {
          "id": "6879477",
          "text": "Lui recita le poesie a memoria.",
