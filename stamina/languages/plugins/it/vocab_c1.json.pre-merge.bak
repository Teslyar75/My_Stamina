    {
      "slug": "lenti-adj",
      "lemma": "lenti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7583,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5030008",
          "text": "I nostri muli sono lenti.",
          "translation": "Наши мулы медлительны.",
          "source": "Tatoeba #5030008 @Guybrush88 / #8300267 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5030008",
          "cefr_level": "A1",
          "word_slugs": [
            "lenti-adj"
          ]
        },
        {
          "id": "2470431",
          "text": "Io porto le lenti a contatto.",
          "translation": "Я ношу контактные линзы.",
          "source": "Tatoeba #2470431 @Guybrush88 / #1576405 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2470431",
          "cefr_level": "A1",
          "word_slugs": [
            "lenti-adj"
          ]
        },
        {
          "id": "621174",
          "text": "Hai trovato le tue lenti a contatto?",
          "translation": "Ты нашла свои контактные линзы?",
          "source": "Tatoeba #621174 @Guybrush88 / #1618364 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/621174",
          "cefr_level": "A1",
          "word_slugs": [
            "lenti-adj"
          ]
        },
        {
          "id": "664304",
          "text": "I treni in Serbia sono terribilmente lenti.",
          "translation": "Поезда в Сербии ужасно медленные.",
          "source": "Tatoeba #664304 @Guybrush88 / #396693 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/664304",
          "cefr_level": "A1",
          "word_slugs": [
            "lenti-adj"
          ]
        },
        {
          "id": "5513914",
