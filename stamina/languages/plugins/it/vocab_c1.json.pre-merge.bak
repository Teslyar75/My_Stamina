      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5657021",
          "text": "Ecco la ricetta.",
          "translation": "Вот рецепт.",
          "source": "Tatoeba #5657021 @dnnywld / #5656444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5657021",
          "cefr_level": "A1",
          "word_slugs": [
            "ricetta-noun"
          ]
        },
        {
          "id": "1534639",
          "text": "Puoi darmi la ricetta?",
          "translation": "Ты можешь дать мне рецепт?",
          "source": "Tatoeba #1534639 @Guybrush88 / #2735163 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1534639",
