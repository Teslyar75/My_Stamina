      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6853097",
          "text": "Ogni lavoro è differente.",
          "translation": "Каждая работа отличается.",
          "source": "Tatoeba #6853097 @dnnywld / #6851181 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6853097",
          "cefr_level": "A1",
