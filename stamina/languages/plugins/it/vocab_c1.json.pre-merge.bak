      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12377210",
          "text": "Come osi dirmi questo?",
          "translation": "Как ты себе позволяешь говорить мне такое?",
          "source": "Tatoeba #12377210 @Bernie75 / #3922496 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12377210",
          "cefr_level": "A1",
          "word_slugs": [
            "osi-adj"
          ]
        },
        {
          "id": "5535747",
          "text": "\"Come osi chiamarmi bugiardo!\" - \"Come oso? Standomene in silenzio!\"",
          "translation": "«Да как ты смеешь называть меня лгуньей!» — «Как я смею? Молча!»",
          "source": "Tatoeba #5535747 @dnnywld / #4175651 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5535747",
          "cefr_level": "A1",
          "word_slugs": [
            "osi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
