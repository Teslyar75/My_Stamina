    {
      "slug": "trasferirsi-verb",
      "lemma": "trasferirsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9178,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6301964",
          "text": "Tom non vuole trasferirsi a Boston.",
          "translation": "Том не хочет переезжать в Бостон.",
          "source": "Tatoeba #6301964 @dnnywld / #6301557 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6301964",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferirsi-verb"
          ]
        },
        {
          "id": "5686510",
          "text": "Tom non voleva trasferirsi a Boston.",
          "translation": "Том не хотел переезжать в Бостон.",
          "source": "Tatoeba #5686510 @Guybrush88 / #5687014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686510",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferirsi-verb"
          ]
        },
        {
          "id": "7294218",
          "text": "Mary mi ha detto che non voleva trasferirsi a Boston.",
          "translation": "Мэри сказала мне, что не хочет переезжать в Бостон.",
          "source": "Tatoeba #7294218 @dnnywld / #7293763 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7294218",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferirsi-verb"
          ]
        },
        {
          "id": "7294182",
          "text": "Tom mi ha detto che non voleva trasferirsi in Australia.",
          "translation": "Том сказал мне, что не хочет переезжать в Австралию.",
          "source": "Tatoeba #7294182 @dnnywld / #7293793 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7294182",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferirsi-verb"
          ]
        },
        {
          "id": "5680895",
          "text": "Tom ha intenzione di trasferirsi più vicino ai suoi genitori.",
          "translation": "Том собирается переехать поближе к родителям.",
          "source": "Tatoeba #5680895 @dnnywld / #5680166 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5680895",
          "cefr_level": "A1",
          "word_slugs": [
            "trasferirsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
