      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3604506",
          "text": "Parlo il coreano.",
          "translation": "Я говорю по-корейски.",
          "source": "Tatoeba #3604506 @Guybrush88 / #3604571 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3604506",
          "cefr_level": "A1",
          "word_slugs": [
            "coreano-adj"
          ]
        },
        {
          "id": "5515309",
          "text": "Adoro il cibo coreano.",
          "translation": "Обожаю корейскую еду.",
          "source": "Tatoeba #5515309 @dnnywld / #1833110 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5515309",
          "cefr_level": "A1",
          "word_slugs": [
            "coreano-adj"
          ]
        },
        {
          "id": "6961231",
          "text": "Presto parlerò in coreano.",
