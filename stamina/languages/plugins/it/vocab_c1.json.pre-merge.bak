    {
      "slug": "egitto-name",
      "lemma": "Egitto",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8389,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "Египет"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3476046",
          "text": "Che lingua si parla in Egitto?",
          "translation": "На каком языке говорят в Египте?",
          "source": "Tatoeba #3476046 @Guybrush88 / #2536233 @dipdowel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3476046",
          "cefr_level": "A1",
          "word_slugs": [
            "egitto-name"
          ]
        },
        {
          "id": "5617537",
          "text": "Un giorno voglio visitare l'Egitto.",
          "translation": "Я хочу как-нибудь побывать в Египте.",
          "source": "Tatoeba #5617537 @dnnywld / #5155281 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5617537",
          "cefr_level": "A1",
          "word_slugs": [
            "egitto-name"
          ]
        },
        {
          "id": "5619562",
          "text": "Vorrei visitare l'Egitto un giorno.",
          "translation": "Я хотел бы как-нибудь съездить в Египет.",
          "source": "Tatoeba #5619562 @dnnywld / #5154989 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619562",
          "cefr_level": "A1",
          "word_slugs": [
            "egitto-name"
          ]
        },
        {
          "id": "13229819",
          "text": "L'Egitto è un dono del Nilo.",
          "translation": "Египет – дар Нила.",
          "source": "Tatoeba #13229819 @Adelpa / #13229962 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13229819",
          "cefr_level": "A1",
          "word_slugs": [
            "egitto-name"
          ]
        },
        {
          "id": "3883871",
          "text": "L'Egitto si chiama \"Misr\" in arabo.",
          "translation": "Египет по-арабски называется \"Миср\".",
          "source": "Tatoeba #3883871 @Guybrush88 / #12126358 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3883871",
          "cefr_level": "A1",
          "word_slugs": [
            "egitto-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il Egitto",
        "plural": "",
        "infinitive": ""
      }
