    {
      "slug": "candidati-adj",
      "lemma": "candidati",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7119,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5625974",
          "text": "Ci sono abbastanza candidati.",
          "translation": "Кандидатов достаточно.",
          "source": "Tatoeba #5625974 @dnnywld / #5546339 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5625974",
          "cefr_level": "A1",
          "word_slugs": [
            "candidati-adj"
          ]
        },
        {
          "id": "5397172",
          "text": "Tom è stato scelto tra 300 candidati.",
          "translation": "Том был выбран из трёхсот кандидатов.",
          "source": "Tatoeba #5397172 @dnnywld / #5397168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5397172",
          "cefr_level": "A1",
          "word_slugs": [
            "candidati-adj"
          ]
        },
        {
          "id": "6866831",
          "text": "Solo l'1% dei candidati supera l'esame.",
          "translation": "Только 1% претендентов сдают экзамен.",
          "source": "Tatoeba #6866831 @dnnywld / #6863168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866831",
          "cefr_level": "A1",
          "word_slugs": [
            "candidati-adj"
          ]
        },
        {
          "id": "6142351",
          "text": "Per questa carica non troverete candidati migliori.",
          "translation": "Лучшей кандидатуры на эту должность Вы не найдёте.",
          "source": "Tatoeba #6142351 @dnnywld / #6141576 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6142351",
          "cefr_level": "A1",
          "word_slugs": [
            "candidati-adj"
          ]
        },
        {
          "id": "5621046",
          "text": "Forse ci sono dei candidati migliori di Tom.",
          "translation": "Возможно, есть кандидатуры получше Тома.",
          "source": "Tatoeba #5621046 @dnnywld / #5620987 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5621046",
          "cefr_level": "A1",
          "word_slugs": [
            "candidati-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
