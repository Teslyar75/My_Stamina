      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5371,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10827948",
          "text": "Lavoravo e studiavo.",
          "translation": "Я работал и учился.",
          "source": "Tatoeba #10827948 @dnnywld / #8917981 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10827948",
          "cefr_level": "A1",
          "word_slugs": [
            "lavoravo-verb"
          ]
        },
        {
          "id": "5190123",
          "text": "Lavoravo in una banca.",
          "translation": "Я работал в банке.",
          "source": "Tatoeba #5190123 @Guybrush88 / #668321 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5190123",
          "cefr_level": "A1",
          "word_slugs": [
