    {
      "slug": "legna-noun",
      "lemma": "legna",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7760,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3270928",
          "text": "La legna secca brucia bene.",
          "translation": "Сухое дерево хорошо горит.",
          "source": "Tatoeba #3270928 @Guybrush88 / #1576582 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3270928",
          "cefr_level": "A1",
          "word_slugs": [
            "legna-noun"
          ]
        },
        {
          "id": "6951725",
          "text": "A Mary piace spaccar legna.",
          "translation": "Мэри нравится рубить дрова.",
          "source": "Tatoeba #6951725 @dnnywld / #6951133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6951725",
          "cefr_level": "A1",
          "word_slugs": [
            "legna-noun"
          ]
        },
        {
          "id": "1287095",
          "text": "Questo inverno bruceremo molta legna.",
          "translation": "Этой зимой мы сожжём много дров.",
          "source": "Tatoeba #1287095 @rado / #3244552 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1287095",
          "cefr_level": "A1",
          "word_slugs": [
            "legna-noun"
          ]
        },
        {
          "id": "2455498",
          "text": "La legna da ardere bagnata non brucia bene.",
          "translation": "Мокрые дрова плохо горят.",
          "source": "Tatoeba #2455498 @Guybrush88 / #3244603 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2455498",
          "cefr_level": "A1",
          "word_slugs": [
            "legna-noun"
          ]
        },
        {
          "id": "5451460",
          "text": "Lui ha rotto la sedia per farne legna da ardere.",
          "translation": "Он разломал стул на дрова.",
          "source": "Tatoeba #5451460 @dnnywld / #5450978 @Ebach (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5451460",
          "cefr_level": "A1",
          "word_slugs": [
            "legna-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la legna",
        "plural": "",
        "infinitive": ""
      }
    },
