      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6881338",
          "text": "Tom vi lascerà farlo.",
          "translation": "Том позволит вам это сделать.",
          "source": "Tatoeba #6881338 @dnnywld / #6881063 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881338",
          "cefr_level": "A1",
          "word_slugs": [
            "lascerà-verb"
          ]
        },
        {
          "id": "6881340",
          "text": "Tom ti lascerà farlo.",
          "translation": "Том позволит тебе это сделать.",
          "source": "Tatoeba #6881340 @dnnywld / #6881062 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881340",
          "cefr_level": "A1",
          "word_slugs": [
            "lascerà-verb"
          ]
        },
        {
          "id": "6879071",
          "text": "Tom lascerà Boston domani.",
          "translation": "Том завтра покинет Бостон.",
          "source": "Tatoeba #6879071 @dnnywld / #6878496 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879071",
          "cefr_level": "A1",
          "word_slugs": [
            "lascerà-verb"
          ]
        },
        {
          "id": "5462484",
          "text": "Lui si lascerà con lei.",
          "translation": "Он с ней расстанется.",
          "source": "Tatoeba #5462484 @dnnywld / #5462336 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5462484",
          "cefr_level": "A1",
          "word_slugs": [
            "lascerà-verb"
          ]
        },
        {
          "id": "5472807",
          "text": "Lui non ci lascerà soli.",
          "translation": "Он нас не оставит одних.",
          "source": "Tatoeba #5472807 @dnnywld / #3963968 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472807",
          "cefr_level": "A1",
          "word_slugs": [
            "lascerà-verb"
          ]
        }
      ],
      "tags": [
