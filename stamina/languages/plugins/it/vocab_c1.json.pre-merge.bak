      "examples": [
        {
          "id": "5512453",
          "text": "Le nostre vendite sono in calo.",
          "translation": "Наши продажи падают.",
          "source": "Tatoeba #5512453 @dnnywld / #4520521 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512453",
