    {
      "slug": "dimensioni-noun",
      "lemma": "dimensioni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5500,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5981114",
          "text": "Le dimensioni contano.",
          "translation": "Размер имеет значение.",
          "source": "Tatoeba #5981114 @dnnywld / #3537104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5981114",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensioni-noun"
          ]
        },
        {
          "id": "4260433",
          "text": "Le dimensioni non contano.",
          "translation": "Размер не имеет значения.",
          "source": "Tatoeba #4260433 @Guybrush88 / #1655013 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4260433",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensioni-noun"
          ]
        },
        {
          "id": "5981131",
          "text": "A volte le dimensioni contano.",
          "translation": "Иногда размер имеет значение.",
          "source": "Tatoeba #5981131 @dnnywld / #3537105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5981131",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensioni-noun"
          ]
        },
        {
          "id": "5981221",
          "text": "Queste non sono le dimensioni che contano.",
          "translation": "Это не размер имеет значение.",
          "source": "Tatoeba #5981221 @dnnywld / #3597309 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5981221",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensioni-noun"
          ]
        },
        {
          "id": "3617598",
          "text": "Protoni e neutroni hanno circa le stesse dimensioni.",
          "translation": "Протоны и нейтроны имеют примерно одинаковый размер.",
          "source": "Tatoeba #3617598 @rado / #3617649 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3617598",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensioni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
