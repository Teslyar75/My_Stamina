        {
          "id": "2190758",
          "text": "Tom è ritornato.",
          "translation": "Том вернулся.",
          "source": "Tatoeba #2190758 @Guybrush88 / #3125096 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2190758",
          "cefr_level": "A1",
