    {
      "slug": "irrilevante-adj",
      "lemma": "irrilevante",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8383,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5345262",
          "text": "Questo è irrilevante.",
          "translation": "Это не имеет принципиального значения.",
          "source": "Tatoeba #5345262 @Guybrush88 / #3293173 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5345262",
          "cefr_level": "A1",
          "word_slugs": [
            "irrilevante-adj"
          ]
        },
        {
          "id": "4851003",
          "text": "La mia opinione è irrilevante.",
          "translation": "Моё мнение к делу не относится.",
          "source": "Tatoeba #4851003 @Guybrush88 / #6098574 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4851003",
          "cefr_level": "A1",
          "word_slugs": [
            "irrilevante-adj"
          ]
        },
        {
          "id": "2844975",
          "text": "Che venga o no è irrilevante.",
          "translation": "Придет он или нет — значения не имеет.",
          "source": "Tatoeba #2844975 @Guybrush88 / #3668217 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2844975",
          "cefr_level": "A1",
          "word_slugs": [
            "irrilevante-adj"
          ]
        },
        {
          "id": "5907033",
          "text": "Abbiamo parlato di qualcosa di insignificante, irrilevante.",
          "translation": "Мы говорили о чём-то несущественном, незначительном.",
          "source": "Tatoeba #5907033 @dnnywld / #5906079 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907033",
          "cefr_level": "A1",
          "word_slugs": [
            "irrilevante-adj"
          ]
        },
        {
          "id": "5414498",
          "text": "Quello che gli ho detto è del tutto irrilevante.",
          "translation": "Не имеет никакого значения, что я ему сказал.",
          "source": "Tatoeba #5414498 @dnnywld / #5414134 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5414498",
          "cefr_level": "A1",
          "word_slugs": [
            "irrilevante-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il irrilevante",
        "plural": "",
        "infinitive": ""
      }
