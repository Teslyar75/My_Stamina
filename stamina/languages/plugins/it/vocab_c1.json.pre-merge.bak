    {
      "slug": "padroni-adj",
      "lemma": "padroni",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8801,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5670932",
          "text": "Perché fate i padroni a casa mia?",
          "translation": "Почему вы хозяйничаете у меня в доме?",
          "source": "Tatoeba #5670932 @dnnywld / #5670520 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5670932",
          "cefr_level": "A1",
          "word_slugs": [
            "padroni-adj"
          ]
        },
        {
          "id": "5670933",
          "text": "Non è il caso di fare i padroni qui!",
          "translation": "Нечего тут хозяйничать!",
          "source": "Tatoeba #5670933 @dnnywld / #5670522 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5670933",
          "cefr_level": "A1",
          "word_slugs": [
            "padroni-adj"
          ]
        },
        {
          "id": "6906433",
          "text": "I padroni di casa uscirono sotto il portico per accompagnare l'ospite.",
          "translation": "Хозяева вышли на крыльцо проводить гостя.",
          "source": "Tatoeba #6906433 @dnnywld / #5065991 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6906433",
          "cefr_level": "A1",
          "word_slugs": [
            "padroni-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
