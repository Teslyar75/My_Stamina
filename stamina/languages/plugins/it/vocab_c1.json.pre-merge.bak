    {
      "slug": "contesto-noun",
      "lemma": "contesto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8888,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6055559",
          "text": "È stato estratto dal contesto.",
          "translation": "Это было выдернуто из контекста.",
          "source": "Tatoeba #6055559 @dnnywld / #6055233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6055559",
          "cefr_level": "A1",
          "word_slugs": [
            "contesto-noun"
          ]
        },
        {
          "id": "3214413",
          "text": "Il contesto è molto importante.",
          "translation": "Контекст очень важен.",
          "source": "Tatoeba #3214413 @Guybrush88 / #3214586 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3214413",
          "cefr_level": "A1",
          "word_slugs": [
            "contesto-noun"
          ]
        },
        {
          "id": "2455799",
          "text": "Non voglio imparare parole senza alcun contesto.",
          "translation": "Я не хочу учить слова вне контекста.",
          "source": "Tatoeba #2455799 @al_ex_an_der / #2455796 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2455799",
          "cefr_level": "A1",
          "word_slugs": [
            "contesto-noun"
          ]
        },
        {
          "id": "5981219",
          "text": "Ricavate il significato della parola dal contesto.",
          "translation": "Получите значение слова из контекста.",
