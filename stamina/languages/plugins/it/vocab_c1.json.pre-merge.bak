    {
      "slug": "dubitare-verb",
      "lemma": "dubitare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9409,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6398295",
          "text": "Non osate dubitare.",
          "translation": "Не извольте сомневаться.",
          "source": "Tatoeba #6398295 @dnnywld / #6398158 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6398295",
          "cefr_level": "A1",
          "word_slugs": [
            "dubitare-verb"
          ]
        },
        {
          "id": "5503130",
          "text": "Comincio a dubitare.",
          "translation": "Я начинаю сомневаться.",
          "source": "Tatoeba #5503130 @dnnywld / #5503098 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5503130",
          "cefr_level": "A1",
          "word_slugs": [
            "dubitare-verb"
          ]
        },
        {
          "id": "6024996",
          "text": "Bisogna dubitare di tutto.",
          "translation": "Надо во всём сомневаться.",
          "source": "Tatoeba #6024996 @dnnywld / #6024592 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6024996",
          "cefr_level": "A1",
          "word_slugs": [
            "dubitare-verb"
          ]
        },
        {
          "id": "5649499",
          "text": "Queste cifre mi fanno dubitare.",
          "translation": "Эти цифры вызывают у меня сомнения.",
          "source": "Tatoeba #5649499 @dnnywld / #5649144 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5649499",
          "cefr_level": "A1",
          "word_slugs": [
            "dubitare-verb"
          ]
        },
        {
          "id": "5012602",
          "text": "Dubitare è la chiave per la conoscenza.",
          "translation": "Сомнение - ключ к знанию.",
          "source": "Tatoeba #5012602 @Xanatos / #5012074 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5012602",
          "cefr_level": "A1",
          "word_slugs": [
            "dubitare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "dubitare",
        "plural": "",
        "infinitive": "dubitare"
      }
