    {
      "slug": "annullare-verb",
      "lemma": "annullare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5769,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5396280",
          "text": "Dovrai annullare l'appuntamento.",
          "translation": "Тебе придётся отменить встречу.",
          "source": "Tatoeba #5396280 @dnnywld / #5396268 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5396280",
          "cefr_level": "A1",
          "word_slugs": [
            "annullare-verb"
          ]
        },
        {
          "id": "5499651",
          "text": "Non sarebbe meglio annullare tutto?",
          "translation": "Не будет ли лучше всё отменить?",
          "source": "Tatoeba #5499651 @dnnywld / #5499085 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499651",
          "cefr_level": "A1",
          "word_slugs": [
            "annullare-verb"
          ]
        },
        {
          "id": "409833",
          "text": "Jack ha deciso di annullare la prenotazione.",
          "translation": "Джек решил аннулировать бронирование.",
          "source": "Tatoeba #409833 @shoras / #1443776 @chispa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/409833",
          "cefr_level": "A1",
          "word_slugs": [
            "annullare-verb"
          ]
        },
        {
          "id": "5514663",
          "text": "Ho dovuto annullare il viaggio per colpa dello sciopero.",
          "translation": "Мне пришлось отменить поездку из-за забастовки.",
          "source": "Tatoeba #5514663 @dnnywld / #5514604 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514663",
          "cefr_level": "A1",
          "word_slugs": [
            "annullare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "annullare",
        "plural": "",
        "infinitive": "annullare"
      }
