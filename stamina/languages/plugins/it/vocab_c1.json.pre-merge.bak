    {
      "slug": "terminato-verb",
      "lemma": "terminato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7060,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6301966",
          "text": "Ho terminato matematica.",
          "translation": "Я доделал математику.",
          "source": "Tatoeba #6301966 @dnnywld / #6301555 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6301966",
          "cefr_level": "A1",
          "word_slugs": [
            "terminato-verb"
          ]
        },
        {
          "id": "5577633",
          "text": "Il mio turno è terminato.",
          "translation": "Моя смена закончилась.",
          "source": "Tatoeba #5577633 @dnnywld / #5576673 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5577633",
          "cefr_level": "A1",
          "word_slugs": [
            "terminato-verb"
          ]
        },
        {
          "id": "7552139",
          "text": "Il rapporto era quasi terminato.",
          "translation": "Отчёт был почти закончен.",
          "source": "Tatoeba #7552139 @dnnywld / #7551900 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7552139",
          "cefr_level": "A1",
          "word_slugs": [
            "terminato-verb"
          ]
        },
        {
          "id": "5631957",
          "text": "L'esperimento è terminato con un fallimento.",
          "translation": "Эксперимент закончился неудачей.",
          "source": "Tatoeba #5631957 @dnnywld / #351217 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5631957",
          "cefr_level": "A1",
          "word_slugs": [
            "terminato-verb"
          ]
        },
        {
          "id": "5481329",
          "text": "Terminato il proprio lavoro, lui ha telefonato alla moglie.",
          "translation": "Доделав свою работу, он позвонил жене.",
          "source": "Tatoeba #5481329 @dnnywld / #5481287 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5481329",
          "cefr_level": "A1",
          "word_slugs": [
            "terminato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il terminato",
        "plural": "",
        "infinitive": "terminato"
      }
