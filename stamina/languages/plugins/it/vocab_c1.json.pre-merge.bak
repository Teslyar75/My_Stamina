      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5862,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5591846",
          "text": "Tom guardava le notizie.",
          "translation": "Том смотрел новости.",
          "source": "Tatoeba #5591846 @dnnywld / #5591495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591846",
          "cefr_level": "A1",
          "word_slugs": [
