      "examples": [
        {
          "id": "6368436",
          "text": "Aspetterò di sotto.",
          "translation": "Я буду ждать внизу.",
          "source": "Tatoeba #6368436 @dnnywld / #6360705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6368436",
          "cefr_level": "A1",
          "word_slugs": [
            "aspetterò-verb"
          ]
        },
        {
          "id": "5662643",
          "text": "Aspetterò la risposta.",
          "translation": "Я буду ждать ответа.",
          "source": "Tatoeba #5662643 @dnnywld / #5660646 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662643",
          "cefr_level": "A1",
          "word_slugs": [
            "aspetterò-verb"
          ]
        },
        {
          "id": "5507451",
          "text": "Ti aspetterò al parco.",
          "translation": "Я буду ждать тебя в парке.",
