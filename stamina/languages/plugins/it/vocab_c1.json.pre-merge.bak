    {
      "slug": "impiegati-noun",
      "lemma": "impiegati",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5600,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5519304",
          "text": "Abbiamo circa trecento impiegati.",
          "translation": "У нас почти триста служащих.",
          "source": "Tatoeba #5519304 @dnnywld / #5518724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5519304",
          "cefr_level": "A1",
          "word_slugs": [
            "impiegati-noun"
          ]
        },
        {
          "id": "3139428",
          "text": "Avete degli impiegati che parlano giapponese?",
          "translation": "У вас есть сотрудники, которые говорят по-японски?",
          "source": "Tatoeba #3139428 @Guybrush88 / #3139526 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3139428",
          "cefr_level": "A1",
          "word_slugs": [
            "impiegati-noun"
          ]
        },
        {
          "id": "10812813",
          "text": "Quasi un terzo degli impiegati di ufficio porta gli occhiali.",
          "translation": "Почти треть всех офисных работников носит очки.",
          "source": "Tatoeba #10812813 @dnnywld / #2497329 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10812813",
          "cefr_level": "A1",
          "word_slugs": [
            "impiegati-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il impiegati",
        "plural": "",
        "infinitive": ""
      }
