    {
      "slug": "resteremo-verb",
      "lemma": "resteremo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8608,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4422954",
          "text": "Resteremo con lui.",
          "translation": "Мы останемся с ним.",
          "source": "Tatoeba #4422954 @Guybrush88 / #4022582 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4422954",
          "cefr_level": "A1",
          "word_slugs": [
            "resteremo-verb"
          ]
        },
        {
          "id": "4422962",
          "text": "Resteremo con lei.",
          "translation": "Мы останемся с ней.",
          "source": "Tatoeba #4422962 @Guybrush88 / #4022583 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4422962",
          "cefr_level": "A1",
          "word_slugs": [
            "resteremo-verb"
          ]
        },
        {
          "id": "5985331",
          "text": "Resteremo con loro.",
          "translation": "Мы останемся с ними.",
          "source": "Tatoeba #5985331 @dnnywld / #4022581 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5985331",
          "cefr_level": "A1",
          "word_slugs": [
            "resteremo-verb"
          ]
        },
        {
          "id": "6488890",
          "text": "Io e Tom resteremo uniti.",
          "translation": "Мы с Томом будем держаться вместе.",
          "source": "Tatoeba #6488890 @dnnywld / #6488679 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6488890",
          "cefr_level": "A1",
          "word_slugs": [
            "resteremo-verb"
          ]
        },
        {
          "id": "6312792",
          "text": "Se pioverà, resteremo a casa.",
          "translation": "Если будет дождь, останемся дома.",
          "source": "Tatoeba #6312792 @dnnywld / #6312103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6312792",
          "cefr_level": "A1",
          "word_slugs": [
            "resteremo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
