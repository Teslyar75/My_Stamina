    {
      "slug": "preparata-adj",
      "lemma": "preparata",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8733,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
