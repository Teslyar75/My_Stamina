    {
      "slug": "aspetteremo-verb",
      "lemma": "aspetteremo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9238,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5543071",
          "text": "Vi aspetteremo lì.",
          "translation": "Мы будем вас там ждать.",
          "source": "Tatoeba #5543071 @dnnywld / #5542901 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5543071",
          "cefr_level": "A1",
          "word_slugs": [
            "aspetteremo-verb"
          ]
        },
        {
          "id": "5543072",
          "text": "Ti aspetteremo lì.",
          "translation": "Мы будем тебя там ждать.",
          "source": "Tatoeba #5543072 @dnnywld / #5542900 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5543072",
          "cefr_level": "A1",
          "word_slugs": [
            "aspetteremo-verb"
          ]
        },
        {
          "id": "5548798",
          "text": "Aspetteremo un'ora.",
          "translation": "Мы подождём час.",
          "source": "Tatoeba #5548798 @dnnywld / #5547969 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5548798",
          "cefr_level": "A1",
          "word_slugs": [
            "aspetteremo-verb"
          ]
        },
        {
          "id": "5559877",
          "text": "Aspetteremo per strada.",
          "translation": "Мы на улице подождём.",
          "source": "Tatoeba #5559877 @dnnywld / #5559452 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5559877",
          "cefr_level": "A1",
          "word_slugs": [
            "aspetteremo-verb"
          ]
        },
        {
          "id": "5627949",
          "text": "Quando aspetteremo ancora?",
          "translation": "Сколько мы ещё будем ждать?",
          "source": "Tatoeba #5627949 @dnnywld / #5627887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627949",
          "cefr_level": "A1",
          "word_slugs": [
            "aspetteremo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "aspetteremo",
        "plural": "",
        "infinitive": "aspetteremo"
