    {
      "slug": "privo-adj",
      "lemma": "privo",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8287,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5327248",
          "text": "Sei privo di ambizione.",
          "translation": "Ты лишён амбиций.",
          "source": "Tatoeba #5327248 @Guybrush88 / #5207637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5327248",
          "cefr_level": "A1",
          "word_slugs": [
            "privo-adj"
          ]
        },
        {
          "id": "5327264",
          "text": "Io sono privo di ambizioni.",
          "translation": "Я лишён амбиций.",
          "source": "Tatoeba #5327264 @Guybrush88 / #5147220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5327264",
          "cefr_level": "A1",
          "word_slugs": [
            "privo-adj"
          ]
        },
        {
          "id": "6372157",
          "text": "Tom potrebbe essere privo di sensi.",
          "translation": "Том мог быть без сознания.",
          "source": "Tatoeba #6372157 @dnnywld / #6372001 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6372157",
          "cefr_level": "A1",
          "word_slugs": [
            "privo-adj"
          ]
        },
        {
          "id": "5433632",
          "text": "Tom era privo di sensi, ma respirava ancora.",
          "translation": "Том был в беспамятстве, но еще дышал.",
          "source": "Tatoeba #5433632 @dnnywld / #4883756 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433632",
          "cefr_level": "A1",
          "word_slugs": [
            "privo-adj"
          ]
        },
        {
          "id": "7137831",
          "text": "Sfortunatamente in questo momento sono privo di questa possibilità.",
          "translation": "К сожалению, сейчас я лишён этой возможности.",
          "source": "Tatoeba #7137831 @dnnywld / #7133442 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7137831",
          "cefr_level": "A1",
          "word_slugs": [
            "privo-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il privo",
        "plural": "",
        "infinitive": ""
      }
