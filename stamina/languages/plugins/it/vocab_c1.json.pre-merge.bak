    {
      "slug": "efficace-adj",
      "lemma": "efficace",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6814,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1895041",
          "text": "È molto efficace.",
          "translation": "Это очень эффективно.",
          "source": "Tatoeba #1895041 @Guybrush88 / #3269612 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1895041",
          "cefr_level": "A1",
          "word_slugs": [
            "efficace-adj"
          ]
        },
        {
          "id": "10142133",
          "text": "Questo vaccino è efficace?",
          "translation": "Эта вакцина эффективна?",
          "source": "Tatoeba #10142133 @Guybrush88 / #10140321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10142133",
          "cefr_level": "A1",
          "word_slugs": [
            "efficace-adj"
          ]
        },
        {
          "id": "3259498",
          "text": "Dobbiamo trovare un metodo più efficace.",
          "translation": "Надо найти более эффективный метод.",
          "source": "Tatoeba #3259498 @Guybrush88 / #3845730 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3259498",
          "cefr_level": "A1",
          "word_slugs": [
            "efficace-adj"
          ]
        },
        {
          "id": "5412689",
          "text": "La sua tecnica è assai più efficace della nostra.",
          "translation": "Её методика намного эффективнее нашей.",
          "source": "Tatoeba #5412689 @dnnywld / #3521339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5412689",
          "cefr_level": "A1",
          "word_slugs": [
            "efficace-adj"
          ]
        },
        {
          "id": "5907038",
          "text": "Tom è il giocatore più efficace della nostra squadra.",
          "translation": "Том — самый результативный игрок нашей команды.",
          "source": "Tatoeba #5907038 @dnnywld / #5906042 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907038",
          "cefr_level": "A1",
          "word_slugs": [
            "efficace-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
