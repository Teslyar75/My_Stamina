    {
      "slug": "immaginate-verb",
      "lemma": "immaginate",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8004,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6136462",
          "text": "Immaginate un mondo senza guerra.",
          "translation": "Представьте мир без войн.",
          "source": "Tatoeba #6136462 @dnnywld / #6136348 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6136462",
          "cefr_level": "A1",
          "word_slugs": [
            "immaginate-verb"
          ]
        },
        {
          "id": "6886193",
          "text": "Immaginate come possa essermi sentito?",
          "translation": "Представляете, каково мне было?",
          "source": "Tatoeba #6886193 @dnnywld / #6885972 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886193",
          "cefr_level": "A1",
          "word_slugs": [
            "immaginate-verb"
          ]
        },
        {
          "id": "6886137",
          "text": "Immaginate come ci si possa sentire?",
          "translation": "Представляете, каково это?",
          "source": "Tatoeba #6886137 @dnnywld / #6886039 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886137",
          "cefr_level": "A1",
          "word_slugs": [
            "immaginate-verb"
          ]
        },
        {
          "id": "6083532",
          "text": "Immaginate di aver vinto alla lotteria!",
          "translation": "Представьте, что вы выиграли в лотерею!",
          "source": "Tatoeba #6083532 @dnnywld / #6082660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6083532",
          "cefr_level": "A1",
          "word_slugs": [
            "immaginate-verb"
          ]
        },
        {
          "id": "6219098",
          "text": "Non è proprio tutto come vi immaginate.",
          "translation": "Всё не совсем так, как вы себе представляете.",
          "source": "Tatoeba #6219098 @dnnywld / #6218216 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6219098",
          "cefr_level": "A1",
          "word_slugs": [
            "immaginate-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "immaginate",
