        },
        {
          "id": "10849807",
          "text": "Gli squali sono pericolosi.",
          "translation": "Акулы опасны.",
          "source": "Tatoeba #10849807 @dnnywld / #10299057 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849807",
          "cefr_level": "A1",
          "word_slugs": [
