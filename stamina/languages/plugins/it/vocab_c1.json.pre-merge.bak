    {
      "slug": "telegramma-noun",
      "lemma": "telegramma",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8313,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10802378",
          "text": "Spedisci un telegramma!",
          "translation": "Отправь телеграмму!",
          "source": "Tatoeba #10802378 @dnnywld / #4241873 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10802378",
          "cefr_level": "A1",
          "word_slugs": [
            "telegramma-noun"
          ]
        },
        {
          "id": "5595760",
          "text": "Ieri ho ricevuto un telegramma da Tom.",
          "translation": "Вчера я получил телеграмму от Тома.",
          "source": "Tatoeba #5595760 @dnnywld / #5595603 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5595760",
          "cefr_level": "A1",
          "word_slugs": [
            "telegramma-noun"
          ]
        },
        {
          "id": "6167334",
          "text": "\"Avete ricevuto il telegramma?\" - \"Non abbiamo ricevuto alcun telegramma\".",
          "translation": "\"Вы не получили телеграмму?\" — \"Мы никакой телеграммы не получали\".",
          "source": "Tatoeba #6167334 @dnnywld / #2396346 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6167334",
          "cefr_level": "A1",
          "word_slugs": [
            "telegramma-noun"
          ]
        },
        {
          "id": "6917614",
          "text": "Mi sono congratulato con i giovani sposi attraverso un telegramma.",
          "translation": "Я поздравил молодожёнов телеграммой.",
          "source": "Tatoeba #6917614 @dnnywld / #2143367 @Leonid204 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6917614",
          "cefr_level": "A1",
          "word_slugs": [
            "telegramma-noun"
          ]
        },
        {
          "id": "5571256",
          "text": "Ho ricevuto un telegramma che dice che è arrivato mio zio.",
          "translation": "Я получил телеграмму о том, что приехал мой дядя.",
          "source": "Tatoeba #5571256 @dnnywld / #5570445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571256",
          "cefr_level": "A1",
          "word_slugs": [
            "telegramma-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il telegramma",
        "plural": "",
        "infinitive": ""
      }
    },
