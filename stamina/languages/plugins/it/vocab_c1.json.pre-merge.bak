          ]
        },
        {
          "id": "5635125",
          "text": "Tom ha una giacca blu scuro.",
          "translation": "У Тома тёмно-синяя куртка.",
          "source": "Tatoeba #5635125 @dnnywld / #5635097 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635125",
          "cefr_level": "A1",
