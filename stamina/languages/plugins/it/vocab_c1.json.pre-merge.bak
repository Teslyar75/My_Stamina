    {
      "slug": "caviglia-noun",
      "lemma": "caviglia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7445,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6142320",
          "text": "Sembra che mi sia storto una caviglia.",
          "translation": "Я, кажется, подвернула ногу.",
          "source": "Tatoeba #6142320 @dnnywld / #6141677 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6142320",
          "cefr_level": "A1",
          "word_slugs": [
            "caviglia-noun"
          ]
        },
        {
          "id": "6989582",
          "text": "Sono scivolato e mi sono slogato una caviglia.",
          "translation": "Я поскользнулся и подвернул лодыжку.",
          "source": "Tatoeba #6989582 @dnnywld / #6987647 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6989582",
          "cefr_level": "A1",
          "word_slugs": [
            "caviglia-noun"
          ]
        },
        {
          "id": "5670890",
          "text": "Lui è caduto e si è slogato la caviglia.",
          "translation": "Он упал и вывихнул лодыжку.",
          "source": "Tatoeba #5670890 @dnnywld / #5670553 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5670890",
          "cefr_level": "A1",
          "word_slugs": [
            "caviglia-noun"
          ]
        },
        {
          "id": "6142319",
          "text": "Non riesco a camminare, mi sono storto una caviglia.",
          "translation": "Я не могу идти, я подвернула ногу.",
          "source": "Tatoeba #6142319 @dnnywld / #6141678 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6142319",
          "cefr_level": "A1",
          "word_slugs": [
            "caviglia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la caviglia",
        "plural": "",
        "infinitive": ""
      }
