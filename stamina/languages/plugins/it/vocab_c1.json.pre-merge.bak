          ]
        },
        {
          "id": "7312055",
          "text": "Certi eventi si verificano in modo estremamente raro.",
          "translation": "Такие события происходят крайне редко.",
          "source": "Tatoeba #7312055 @dnnywld / #7311813 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7312055",
