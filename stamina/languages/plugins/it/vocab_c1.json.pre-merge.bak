    {
      "slug": "trovassi-verb",
      "lemma": "trovassi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9566,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6842129",
          "text": "Era ora che ti trovassi un ragazzo.",
          "translation": "Тебе давно пора найти себе парня.",
          "source": "Tatoeba #6842129 @dnnywld / #5281933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6842129",
          "cefr_level": "A1",
          "word_slugs": [
            "trovassi-verb"
          ]
        },
        {
          "id": "5586981",
          "text": "Cosa faresti se ti trovassi nei miei panni?",
          "translation": "Что бы ты сделал, окажись ты в моей шкуре?",
          "source": "Tatoeba #5586981 @dnnywld / #5586837 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586981",
          "cefr_level": "A1",
          "word_slugs": [
            "trovassi-verb"
          ]
        },
        {
          "id": "6876825",
          "text": "Cosa diresti se ti trovassi in una situazione così?",
          "translation": "Что бы ты сказал, окажись ты в такой ситуации?",
          "source": "Tatoeba #6876825 @dnnywld / #6876488 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6876825",
          "cefr_level": "A1",
          "word_slugs": [
            "trovassi-verb"
          ]
        },
        {
          "id": "6871878",
          "text": "Se trovassi uno scorpione in camera mia, grideri ad alta voce.",
          "translation": "Я бы громко кричала, если бы нашла скорпиона в своей комнате.",
          "source": "Tatoeba #6871878 @dnnywld / #1525005 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871878",
          "cefr_level": "A1",
          "word_slugs": [
            "trovassi-verb"
          ]
        },
        {
          "id": "3123156",
          "text": "Comprerei volentieri un'auto a idrogeno purché la trovassi già sul mercato.",
          "translation": "Я охотно купил бы автомобиль на водородном топливе, если бы они продавались.",
          "source": "Tatoeba #3123156 @Guybrush88 / #4387535 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3123156",
          "cefr_level": "A1",
          "word_slugs": [
            "trovassi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "trovassi",
        "plural": "",
        "infinitive": "trovassi"
      }
    },
    {
      "slug": "tentazione-noun",
      "lemma": "tentazione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9567,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6894925",
          "text": "Non inducetemi in tentazione!",
          "translation": "Не вводите меня в искушение!",
          "source": "Tatoeba #6894925 @dnnywld / #5709836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6894925",
          "cefr_level": "A1",
          "word_slugs": [
            "tentazione-noun"
          ]
        },
        {
          "id": "5725076",
          "text": "Tom ha ceduto alla tentazione.",
          "translation": "Том поддался искушению.",
          "source": "Tatoeba #5725076 @Guybrush88 / #5812484 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5725076",
          "cefr_level": "A1",
          "word_slugs": [
            "tentazione-noun"
          ]
        },
        {
          "id": "5447540",
          "text": "Bill ha resistito alla tentazione.",
          "translation": "Билл устоял перед искушением.",
