      "gender": "m",
      "examples": [
        {
          "id": "4383815",
          "text": "La Grecia è un paese sviluppato.",
          "translation": "Греция - развитая страна.",
          "source": "Tatoeba #4383815 @Guybrush88 / #4384325 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4383815",
          "cefr_level": "A1",
          "word_slugs": [
            "sviluppato-adj"
          ]
        },
        {
          "id": "5589460",
          "text": "Ho sviluppato questa abilità col passare degli anni.",
          "translation": "Это умение развивалось у меня с годами.",
          "source": "Tatoeba #5589460 @dnnywld / #2322127 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589460",
          "cefr_level": "A1",
          "word_slugs": [
            "sviluppato-adj"
          ]
        },
        {
          "id": "5414393",
          "text": "Negli stati non riconosciuti il turismo è poco sviluppato.",
          "translation": "В непризнанных государствах мало развит туризм.",
          "source": "Tatoeba #5414393 @dnnywld / #5414150 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5414393",
          "cefr_level": "A1",
          "word_slugs": [
            "sviluppato-adj"
          ]
        },
        {
          "id": "13612815",
          "text": "Ho sviluppato un metodo rivoluzionario per studiare l'inglese.",
          "translation": "Я разработал революционный метод изучения английского языка.",
          "source": "Tatoeba #13612815 @dnnywld / #6391505 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13612815",
          "cefr_level": "A1",
          "word_slugs": [
            "sviluppato-adj"
          ]
        },
        {
          "id": "5563918",
          "text": "Tom ha sviluppato un nuovo sistema per studiare l'inglese.",
          "translation": "Том разработал новую систему изучения английского.",
          "source": "Tatoeba #5563918 @dnnywld / #5563719 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5563918",
          "cefr_level": "A1",
          "word_slugs": [
            "sviluppato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
