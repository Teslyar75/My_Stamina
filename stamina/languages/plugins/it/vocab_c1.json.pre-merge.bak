    {
      "slug": "successiva-adj",
      "lemma": "successiva",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8315,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6857573",
          "text": "La frase successiva è errata.",
          "translation": "Следующее предложение ошибочно.",
          "source": "Tatoeba #6857573 @dnnywld / #5078490 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857573",
          "cefr_level": "A1",
          "word_slugs": [
            "successiva-adj"
          ]
        },
        {
          "id": "6954872",
          "text": "Loro scesero alla stazione successiva.",
          "translation": "Они вышли на следующей остановке.",
          "source": "Tatoeba #6954872 @dnnywld / #6954372 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6954872",
          "cefr_level": "A1",
          "word_slugs": [
            "successiva-adj"
          ]
        },
        {
          "id": "7060281",
          "text": "L'esplosione successiva tolse la vita a molte persone.",
          "translation": "Последовавший взрыв унёс жизни многих людей.",
          "source": "Tatoeba #7060281 @dnnywld / #7059127 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7060281",
          "cefr_level": "A1",
          "word_slugs": [
            "successiva-adj"
          ]
        },
        {
          "id": "3020848",
          "text": "Il rema della prima frase diventa il tema della frase successiva.",
          "translation": "Рема первого предложения становится темой последующего.",
          "source": "Tatoeba #3020848 @Guybrush88 / #7416106 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3020848",
          "cefr_level": "A1",
          "word_slugs": [
            "successiva-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il successiva",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "italiana-adj",
      "lemma": "italiana",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8316,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "791275",
          "text": "Roma è una città italiana.",
          "translation": "Рим - это итальянский город.",
          "source": "Tatoeba #791275 @Pharamp / #1577858 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/791275",
          "cefr_level": "A1",
          "word_slugs": [
            "italiana-adj"
          ]
        },
        {
          "id": "5653682",
          "text": "Ti piace la cucina italiana?",
          "translation": "Ты любишь итальянскую еду?",
          "source": "Tatoeba #5653682 @dnnywld / #5653599 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5653682",
          "cefr_level": "A1",
          "word_slugs": [
            "italiana-adj"
          ]
        },
        {
          "id": "1645918",
          "text": "Ho paura della polizia italiana.",
          "translation": "Я боюсь итальянской полиции.",
          "source": "Tatoeba #1645918 @Guybrush88 / #3252616 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1645918",
          "cefr_level": "A1",
          "word_slugs": [
            "italiana-adj"
          ]
        },
        {
          "id": "1405020",
          "text": "È la sua parola italiana preferita.",
          "translation": "Это его самое любимое итальянское слово.",
          "source": "Tatoeba #1405020 @Guybrush88 / #1803876 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1405020",
          "cefr_level": "A1",
          "word_slugs": [
            "italiana-adj"
          ]
        },
        {
          "id": "6939740",
          "text": "Tom lavora per un'azienda italiana.",
          "translation": "Том работает в итальянской фирме.",
          "source": "Tatoeba #6939740 @dnnywld / #6939510 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6939740",
          "cefr_level": "A1",
          "word_slugs": [
            "italiana-adj"
          ]
        }
      ],
      "tags": [
