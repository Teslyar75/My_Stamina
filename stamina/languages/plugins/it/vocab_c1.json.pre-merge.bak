    {
      "slug": "troverà-verb",
      "lemma": "troverà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5102,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6541594",
          "text": "Tom non troverà mai Mary.",
          "translation": "Том никогда не найдёт Мэри.",
          "source": "Tatoeba #6541594 @Guybrush88 / #6902727 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6541594",
          "cefr_level": "A1",
          "word_slugs": [
            "troverà-verb"
          ]
        },
        {
          "id": "5510016",
          "text": "Questo non mi troverà mai d'accordo.",
          "translation": "Я с этим никогда не соглашусь.",
          "source": "Tatoeba #5510016 @dnnywld / #5509702 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510016",
          "cefr_level": "A1",
          "word_slugs": [
            "troverà-verb"
          ]
        },
        {
          "id": "6892515",
          "text": "Ah, l'insegnante non ci troverà qui.",
          "translation": "Ха, учитель не найдёт нас здесь.",
          "source": "Tatoeba #6892515 @dnnywld / #6892409 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6892515",
          "cefr_level": "A1",
          "word_slugs": [
            "troverà-verb"
          ]
        },
        {
          "id": "5477487",
          "text": "La polizia ci troverà se restiamo qui.",
          "translation": "Полиция обнаружит нас, если мы останемся здесь.",
          "source": "Tatoeba #5477487 @dnnywld / #5477229 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5477487",
          "cefr_level": "A1",
          "word_slugs": [
            "troverà-verb"
          ]
        },
        {
          "id": "5469572",
          "text": "Questo libro è scritto per tutti - ognuno ci troverà qualcosa di interessante.",
          "translation": "Эта книга написана для всех — каждый найдёт в ней что-то интересное.",
          "source": "Tatoeba #5469572 @dnnywld / #5469515 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5469572",
          "cefr_level": "A1",
          "word_slugs": [
            "troverà-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "troverà",
        "plural": "",
        "infinitive": "troverà"
      }
    },
