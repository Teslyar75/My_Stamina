    {
      "slug": "risparmiare-verb",
      "lemma": "risparmiare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5390,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5964067",
          "text": "Voglio risparmiare di più.",
          "translation": "Я хочу сэкономить больше.",
          "source": "Tatoeba #5964067 @dnnywld / #5963953 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964067",
          "cefr_level": "A1",
          "word_slugs": [
            "risparmiare-verb"
          ]
        },
        {
          "id": "6947728",
          "text": "Questo permette di risparmiare tempo.",
          "translation": "Это позволяет сэкономить время.",
          "source": "Tatoeba #6947728 @dnnywld / #6947105 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6947728",
          "cefr_level": "A1",
          "word_slugs": [
            "risparmiare-verb"
          ]
        },
        {
          "id": "6884665",
          "text": "Tom deve risparmiare le sue forze.",
          "translation": "Том должен беречь свою силу.",
          "source": "Tatoeba #6884665 @dnnywld / #6884585 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884665",
          "cefr_level": "A1",
          "word_slugs": [
            "risparmiare-verb"
          ]
        },
        {
          "id": "5671357",
          "text": "Risparmiare un rublo è come guadagnarne due.",
          "translation": "Сэкономил рубль — всё равно что заработал два.",
          "source": "Tatoeba #5671357 @dnnywld / #5670171 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5671357",
          "cefr_level": "A1",
          "word_slugs": [
            "risparmiare-verb"
          ]
        },
        {
          "id": "5403083",
          "text": "Questo vi aiuterà a risparmiare energia elettrica.",
          "translation": "Это поможет вам сэкономить электроэнергию.",
          "source": "Tatoeba #5403083 @dnnywld / #5402968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5403083",
          "cefr_level": "A1",
          "word_slugs": [
            "risparmiare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "risparmiare",
        "plural": "",
        "infinitive": "risparmiare"
      }
