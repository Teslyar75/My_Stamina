    {
      "slug": "sostiene-verb",
      "lemma": "sostiene",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5456,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6958951",
          "text": "Lei sostiene il Partito Democratico.",
          "translation": "Она поддерживает Демократическую партию.",
          "source": "Tatoeba #6958951 @dnnywld / #6958898 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6958951",
          "cefr_level": "A1",
          "word_slugs": [
            "sostiene-verb"
          ]
        },
        {
          "id": "6958952",
          "text": "Lui sostiene il Partito Democratico.",
          "translation": "Он поддерживает Демократическую партию.",
          "source": "Tatoeba #6958952 @dnnywld / #6958897 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6958952",
          "cefr_level": "A1",
          "word_slugs": [
            "sostiene-verb"
          ]
        },
        {
          "id": "5559874",
          "text": "Mary sostiene che abbia rubato le sue perle.",
          "translation": "Мэри утверждает, что ты украла её жемчуг.",
          "source": "Tatoeba #5559874 @dnnywld / #5559591 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5559874",
          "cefr_level": "A1",
          "word_slugs": [
            "sostiene-verb"
          ]
        },
        {
          "id": "6896666",
          "text": "Mary sostiene di non essere ancora stata pagata.",
          "translation": "Мэри утверждает, что ей ещё не заплатили.",
          "source": "Tatoeba #6896666 @dnnywld / #6895571 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6896666",
          "cefr_level": "A1",
          "word_slugs": [
            "sostiene-verb"
          ]
        },
        {
          "id": "12580978",
          "text": "Mary sostiene di poter influenzare le condizioni atmosferiche.",
          "translation": "Мария утверждает, что может влиять на погоду.",
          "source": "Tatoeba #12580978 @dnnywld / #7498780 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12580978",
          "cefr_level": "A1",
          "word_slugs": [
            "sostiene-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
