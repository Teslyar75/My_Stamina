      "cefr_level": "C1",
      "frequency_rank": 6216,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5619566",
          "text": "Avete allergie a qualche farmaco?",
          "translation": "У Вас есть аллергия на какие-нибудь лекарства?",
          "source": "Tatoeba #5619566 @dnnywld / #5202501 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619566",
          "cefr_level": "A1",
          "word_slugs": [
            "farmaco-noun"
          ]
        },
        {
          "id": "6843289",
          "text": "Il dottore le prescrisse un farmaco.",
          "translation": "Врач выписал ей лекарство.",
          "source": "Tatoeba #6843289 @dnnywld / #5137925 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843289",
          "cefr_level": "A1",
          "word_slugs": [
            "farmaco-noun"
          ]
        },
        {
          "id": "6843288",
          "text": "Il dottore gli prescrisse un farmaco.",
          "translation": "Врач выписал ему лекарство.",
          "source": "Tatoeba #6843288 @dnnywld / #5137924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843288",
          "cefr_level": "A1",
          "word_slugs": [
            "farmaco-noun"
          ]
        },
        {
          "id": "6884994",
          "text": "Vi scriverò la prescrizione del farmaco.",
          "translation": "Я Вам выпишу рецепт на лекарство.",
          "source": "Tatoeba #6884994 @dnnywld / #6884036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884994",
          "cefr_level": "A1",
          "word_slugs": [
            "farmaco-noun"
          ]
        },
        {
          "id": "6843298",
          "text": "Ho prescritto io questo farmaco a Tom.",
          "translation": "Это я выписал Тому это лекарство.",
          "source": "Tatoeba #6843298 @dnnywld / #4640624 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843298",
          "cefr_level": "A1",
          "word_slugs": [
            "farmaco-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il farmaco",
