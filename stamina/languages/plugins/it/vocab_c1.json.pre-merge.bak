    {
      "slug": "stiate-verb",
      "lemma": "stiate",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6194,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6891164",
          "text": "Temo che stiate sbagliando.",
          "translation": "Боюсь, вы ошибаетесь.",
          "source": "Tatoeba #6891164 @dnnywld / #3699027 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891164",
          "cefr_level": "A1",
          "word_slugs": [
            "stiate-verb"
          ]
        },
        {
          "id": "4888322",
          "text": "Spero che voi stiate bene.",
          "translation": "Надеемся, вы здоровы.",
          "source": "Tatoeba #4888322 @Guybrush88 / #5529930 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4888322",
          "cefr_level": "A1",
          "word_slugs": [
            "stiate-verb"
          ]
        },
        {
          "id": "6953081",
          "text": "Sembra che vi stiate divertendo.",
          "translation": "Вам, похоже, весело.",
          "source": "Tatoeba #6953081 @dnnywld / #6952874 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953081",
          "cefr_level": "A1",
          "word_slugs": [
            "stiate-verb"
          ]
        },
        {
          "id": "5423480",
          "text": "Penso che tutti stiate sbagliando.",
          "translation": "Я думаю, вы все ошибаетесь.",
          "source": "Tatoeba #5423480 @dnnywld / #5422792 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5423480",
          "cefr_level": "A1",
          "word_slugs": [
            "stiate-verb"
          ]
        },
        {
          "id": "5604132",
          "text": "Penso che mi stiate nascondendo qualcosa.",
          "translation": "Думаю, вы мне чего-то недоговариваете.",
          "source": "Tatoeba #5604132 @dnnywld / #3783086 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5604132",
          "cefr_level": "A1",
          "word_slugs": [
            "stiate-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "stiate",
        "plural": "",
        "infinitive": "stiate"
      }
