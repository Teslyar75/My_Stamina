            "mancia-noun"
          ]
        },
        {
          "id": "5997254",
          "text": "Non dimenticarti di lasciare la mancia.",
          "translation": "Не забудь оставить чаевые.",
          "source": "Tatoeba #5997254 @dnnywld / #4007516 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997254",
          "cefr_level": "A1",
          "word_slugs": [
            "mancia-noun"
          ]
        },
        {
          "id": "5997257",
          "text": "Non dimenticatevi di lasciare la mancia.",
          "translation": "Не забудьте оставить чаевые.",
          "source": "Tatoeba #5997257 @dnnywld / #4007517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997257",
