          "молоток"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4073202",
          "text": "Dov'è il martello?",
          "translation": "Где молоток?",
          "source": "Tatoeba #4073202 @Guybrush88 / #4073205 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4073202",
          "cefr_level": "A1",
          "word_slugs": [
            "martello-noun"
          ]
        },
        {
          "id": "2178360",
          "text": "Guardi quel grande martello.",
          "translation": "Смотрите, какой большой молоток.",
          "source": "Tatoeba #2178360 @Guybrush88 / #3171057 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2178360",
          "cefr_level": "A1",
          "word_slugs": [
            "martello-noun"
          ]
        },
        {
          "id": "5486739",
          "text": "Dove ho messo il martello?",
          "translation": "Куда я молоток дел?",
          "source": "Tatoeba #5486739 @Guybrush88 / #5486951 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5486739",
          "cefr_level": "A1",
          "word_slugs": [
            "martello-noun"
          ]
        },
        {
          "id": "12783416",
          "text": "Perché non usate il martello?",
          "translation": "Почему вы не используете молоток?",
          "source": "Tatoeba #12783416 @dnnywld / #12783292 @Alex_M (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12783416",
          "cefr_level": "A1",
          "word_slugs": [
            "martello-noun"
          ]
        },
        {
          "id": "5845231",
          "text": "Spesso i giudici utitlizzano un martello.",
          "translation": "Судьи часто используют молоток.",
          "source": "Tatoeba #5845231 @dnnywld / #4316990 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845231",
          "cefr_level": "A1",
          "word_slugs": [
            "martello-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il martello",
