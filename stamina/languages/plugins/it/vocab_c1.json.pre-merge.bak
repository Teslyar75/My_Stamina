    {
      "slug": "conigli-noun",
      "lemma": "conigli",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9030,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2790673",
          "text": "I conigli sanno nuotare?",
          "translation": "А кролики умеют плавать?",
          "source": "Tatoeba #2790673 @Guybrush88 / #2263974 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2790673",
          "cefr_level": "A1",
          "word_slugs": [
            "conigli-noun"
          ]
        },
        {
          "id": "6947658",
          "text": "Allevo conigli da carne.",
          "translation": "Я развожу кроликов на мясо.",
          "source": "Tatoeba #6947658 @dnnywld / #6947238 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6947658",
          "cefr_level": "A1",
          "word_slugs": [
            "conigli-noun"
          ]
        },
        {
          "id": "1947776",
          "text": "Ai conigli piacciono le carote.",
          "translation": "Кролики любят морковку.",
          "source": "Tatoeba #1947776 @Guybrush88 / #1102062 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1947776",
          "cefr_level": "A1",
          "word_slugs": [
            "conigli-noun"
          ]
        },
        {
          "id": "5399168",
          "text": "I conigli non depongono le uova.",
          "translation": "Кролики не откладывают яйца.",
          "source": "Tatoeba #5399168 @dnnywld / #3870176 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5399168",
          "cefr_level": "A1",
          "word_slugs": [
            "conigli-noun"
          ]
        },
        {
          "id": "375430",
          "text": "Ai conigli piace mangiare le carote.",
          "translation": "Кролики любят есть морковку.",
          "source": "Tatoeba #375430 @martin / #3339592 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/375430",
          "cefr_level": "A1",
          "word_slugs": [
            "conigli-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il conigli",
        "plural": "",
