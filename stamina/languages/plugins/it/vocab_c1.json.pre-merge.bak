          "cefr_level": "A1",
          "word_slugs": [
            "desiderate-adj"
          ]
        },
        {
          "id": "10857944",
          "text": "Desiderate un caffè o un tè?",
          "translation": "Желаете кофе или чаю?",
          "source": "Tatoeba #10857944 @dnnywld / #10857582 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10857944",
          "cefr_level": "A1",
          "word_slugs": [
            "desiderate-adj"
          ]
        },
        {
          "id": "10857943",
          "text": "Non desiderate un caffè o un tè?",
          "translation": "Не желаете кофе или чаю?",
          "source": "Tatoeba #10857943 @dnnywld / #10857584 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10857943",
