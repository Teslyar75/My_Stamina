    {
      "slug": "preghiere-noun",
      "lemma": "preghiere",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5711,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10796978",
          "text": "Dio ha ascoltato le sue preghiere.",
          "translation": "Бог услышал его молитвы.",
          "source": "Tatoeba #10796978 @dnnywld / #7421668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10796978",
          "cefr_level": "A1",
          "word_slugs": [
            "preghiere-noun"
          ]
        },
        {
          "id": "10796977",
          "text": "Dio ha ascoltato le preghiere di Tom.",
          "translation": "Бог услышал молитвы Тома.",
          "source": "Tatoeba #10796977 @dnnywld / #7421667 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10796977",
          "cefr_level": "A1",
          "word_slugs": [
            "preghiere-noun"
          ]
        },
        {
          "id": "5504825",
          "text": "Perché terminiamo le preghiere con la parola \"amen\"?",
          "translation": "Почему мы заканчиваем молитвы словом \"аминь\"?",
          "source": "Tatoeba #5504825 @dnnywld / #5504802 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5504825",
          "cefr_level": "A1",
          "word_slugs": [
            "preghiere-noun"
          ]
        },
        {
          "id": "5647226",
          "text": "Nelle moschee, di regola, si trovano tappeti per le preghiere.",
          "translation": "В мечети, как правило, находятся молитвенные коврики.",
          "source": "Tatoeba #5647226 @dnnywld / #5647077 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647226",
          "cefr_level": "A1",
          "word_slugs": [
            "preghiere-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la preghiere",
        "plural": "",
        "infinitive": ""
      }
