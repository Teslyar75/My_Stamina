    {
      "slug": "informare-verb",
      "lemma": "informare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9366,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5512075",
          "text": "Devo informare Tom.",
          "translation": "Мне нужно Тому сообщить.",
          "source": "Tatoeba #5512075 @dnnywld / #5511470 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512075",
          "cefr_level": "A1",
          "word_slugs": [
            "informare-verb"
          ]
        },
        {
          "id": "6795253",
          "text": "Devo informare Tom che verrai?",
          "translation": "Мне сообщить Тому о том, что ты придешь?",
          "source": "Tatoeba #6795253 @dnnywld / #6795249 @Annushka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6795253",
          "cefr_level": "A1",
          "word_slugs": [
            "informare-verb"
          ]
        },
        {
          "id": "350281",
          "text": "Dovresti informare la polizia immediatamente.",
          "translation": "Тебе следует сообщить в полицию немедленно.",
          "source": "Tatoeba #350281 @martin / #469874 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350281",
          "cefr_level": "A1",
          "word_slugs": [
            "informare-verb"
          ]
        },
        {
          "id": "5468211",
          "text": "Volete informare Tom su quello che è successo?",
          "translation": "Вы можете сообщить Тому о том, что произошло?",
          "source": "Tatoeba #5468211 @dnnywld / #3094497 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5468211",
          "cefr_level": "A1",
          "word_slugs": [
            "informare-verb"
          ]
        },
        {
          "id": "6138175",
          "text": "Credo che dovremmo informare i genitori di Tom.",
          "translation": "Думаю, нам надо поставить родителей Тома в известность.",
          "source": "Tatoeba #6138175 @dnnywld / #6137464 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6138175",
          "cefr_level": "A1",
          "word_slugs": [
            "informare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "informare",
        "plural": "",
        "infinitive": "informare"
      }
    },
