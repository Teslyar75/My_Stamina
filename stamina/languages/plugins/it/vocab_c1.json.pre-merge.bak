      "gender": "f",
      "examples": [
        {
          "id": "2799221",
          "text": "Un microonde riscalda il cibo in un istante.",
          "translation": "Микроволновка разогревает еду мгновенно.",
          "source": "Tatoeba #2799221 @Guybrush88 / #3063796 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2799221",
          "cefr_level": "A1",
          "word_slugs": [
            "microonde-noun"
          ]
        },
        {
          "id": "12465085",
          "text": "Nel forno a microonde si può riscaldare il cibo.",
          "translation": "В микроволновой печи можно подогревать еду.",
          "source": "Tatoeba #12465085 @dnnywld / #9700407 @issadouba (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12465085",
          "cefr_level": "A1",
          "word_slugs": [
