    {
      "slug": "spendere-verb",
      "lemma": "spendere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5404,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6718310",
          "text": "Potete spendere soldi a vostro piacimento.",
          "translation": "Вы можете тратить деньги по своему усмотрению.",
          "source": "Tatoeba #6718310 @dnnywld / #6718227 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6718310",
          "cefr_level": "A1",
          "word_slugs": [
            "spendere-verb"
          ]
        },
        {
          "id": "10888361",
          "text": "Cerca di non spendere tutto in una volta.",
          "translation": "Постарайся всё сразу не тратить.",
          "source": "Tatoeba #10888361 @dnnywld / #10888333 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10888361",
          "cefr_level": "A1",
          "word_slugs": [
            "spendere-verb"
          ]
        },
        {
          "id": "10888359",
          "text": "Cercate di non spendere tutto in una volta.",
          "translation": "Постарайтесь всё сразу не тратить.",
          "source": "Tatoeba #10888359 @dnnywld / #10888334 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10888359",
          "cefr_level": "A1",
          "word_slugs": [
            "spendere-verb"
          ]
        },
        {
          "id": "6636005",
          "text": "Lui non aveva tempo da spendere con i figli.",
          "translation": "У него не было времени на детей.",
          "source": "Tatoeba #6636005 @dnnywld / #6635578 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6636005",
          "cefr_level": "A1",
          "word_slugs": [
            "spendere-verb"
          ]
        },
        {
          "id": "6946379",
          "text": "Non spendere soldi per una nuova macchina. Meglio ristrutturare casa.",
          "translation": "Не стоит тратить деньги на новую машину. Лучше сделать дома ремонт.",
          "source": "Tatoeba #6946379 @dnnywld / #6946337 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6946379",
          "cefr_level": "A1",
          "word_slugs": [
            "spendere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "spendere",
        "plural": "",
        "infinitive": "spendere"
      }
    },
