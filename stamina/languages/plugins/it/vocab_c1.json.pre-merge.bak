    {
      "slug": "mangiano-verb",
      "lemma": "mangiano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5225,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5686046",
          "text": "Mangiano come maiali.",
          "translation": "Они едят как свиньи.",
          "source": "Tatoeba #5686046 @dnnywld / #5684353 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686046",
          "cefr_level": "A1",
          "word_slugs": [
            "mangiano-verb"
          ]
        },
        {
          "id": "12559268",
          "text": "Cosa mangiano i lupi?",
          "translation": "Что едят волки?",
          "source": "Tatoeba #12559268 @Guybrush88 / #12559111 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12559268",
          "cefr_level": "A1",
          "word_slugs": [
            "mangiano-verb"
          ]
        },
        {
          "id": "11821580",
          "text": "Cosa mangiano le tigri?",
          "translation": "Что едят тигры?",
          "source": "Tatoeba #11821580 @Adelpa / #3005132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11821580",
          "cefr_level": "A1",
          "word_slugs": [
            "mangiano-verb"
          ]
        },
        {
          "id": "5251897",
          "text": "Le pecore mangiano l'erba.",
          "translation": "Овцы едят траву.",
          "source": "Tatoeba #5251897 @Guybrush88 / #4491620 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5251897",
          "cefr_level": "A1",
          "word_slugs": [
            "mangiano-verb"
          ]
        },
        {
          "id": "9674441",
          "text": "I leoni mangiano il pesce?",
          "translation": "Львы едят рыбу?",
          "source": "Tatoeba #9674441 @Nuel / #9925570 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9674441",
          "cefr_level": "A1",
          "word_slugs": [
            "mangiano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
