    {
      "slug": "affidabile-adj",
      "lemma": "affidabile",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6591,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2442413",
          "text": "Lui è affidabile e paziente.",
          "translation": "Он надёжен и терпелив.",
          "source": "Tatoeba #2442413 @al_ex_an_der / #2442421 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2442413",
          "cefr_level": "A1",
          "word_slugs": [
            "affidabile-adj"
          ]
        },
        {
          "id": "3511568",
          "text": "Tom è un conducente affidabile.",
          "translation": "Том надёжный водитель.",
          "source": "Tatoeba #3511568 @Guybrush88 / #6055508 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3511568",
          "cefr_level": "A1",
          "word_slugs": [
            "affidabile-adj"
          ]
        },
        {
          "id": "1318540",
          "text": "Io sono responsabile e affidabile!",
          "translation": "Я ответственный и надёжный!",
          "source": "Tatoeba #1318540 @Guybrush88 / #6055495 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1318540",
          "cefr_level": "A1",
          "word_slugs": [
            "affidabile-adj"
          ]
        },
        {
          "id": "13990945",
          "text": "È una persona assolutamente affidabile.",
          "translation": "Он абсолютно надёжный человек.",
          "source": "Tatoeba #13990945 @dnnywld / #13990642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13990945",
          "cefr_level": "A1",
          "word_slugs": [
            "affidabile-adj"
          ]
        },
        {
          "id": "6833306",
          "text": "Sapevo che Tom non era molto affidabile.",
          "translation": "Я знал, что Том не очень надёжен.",
          "source": "Tatoeba #6833306 @dnnywld / #6833013 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833306",
          "cefr_level": "A1",
          "word_slugs": [
            "affidabile-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il affidabile",
        "plural": "",
        "infinitive": ""
      }
