    {
      "slug": "veicoli-noun",
      "lemma": "veicoli",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8722,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "612825",
          "text": "Ci sono sempre un sacco di veicoli su questa strada.",
          "translation": "На этой дороге всегда полно машин.",
          "source": "Tatoeba #612825 @Guybrush88 / #3226386 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/612825",
          "cefr_level": "A1",
          "word_slugs": [
            "veicoli-noun"
          ]
        },
        {
          "id": "11880780",
          "text": "Ma non tutti hanno la capacità di cambiare i veicoli spesso.",
          "translation": "Но не у всех есть возможность регулярно менять транспортное средство.",
          "source": "Tatoeba #11880780 @Bernie75 / #11880757 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11880780",
          "cefr_level": "A1",
          "word_slugs": [
            "veicoli-noun"
          ]
        },
        {
          "id": "11880774",
          "text": "Ma non tutti hanno la capacità di cambiare i veicoli regolarmente.",
          "translation": "Но не у всех есть возможность регулярно менять транспортное средство.",
          "source": "Tatoeba #11880774 @Bernie75 / #11880757 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11880774",
          "cefr_level": "A1",
          "word_slugs": [
            "veicoli-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il veicoli",
        "plural": "",
        "infinitive": ""
      }
