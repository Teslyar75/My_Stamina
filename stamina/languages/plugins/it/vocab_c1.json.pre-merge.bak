    {
      "slug": "lite-noun",
      "lemma": "lite",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7428,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5408394",
          "text": "La nostra conversazione finisce sempre in lite.",
          "translation": "Наша беседа всегда оканчивается ссорой.",
          "source": "Tatoeba #5408394 @dnnywld / #1062916 @omsnbnk (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408394",
          "cefr_level": "A1",
          "word_slugs": [
            "lite-noun"
          ]
        },
        {
          "id": "5753126",
          "text": "La conversazione con Mary si concluse in lite.",
          "translation": "Разговор с Мэри закончился ссорой.",
          "source": "Tatoeba #5753126 @dnnywld / #5750188 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5753126",
          "cefr_level": "A1",
          "word_slugs": [
            "lite-noun"
          ]
        },
        {
          "id": "5753127",
          "text": "Sento che la conversazione con Tom potrebbe finire in lite.",
          "translation": "Я чувствую, что разговор с Томом может закончиться ссорой.",
          "source": "Tatoeba #5753127 @dnnywld / #5750186 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5753127",
          "cefr_level": "A1",
          "word_slugs": [
            "lite-noun"
          ]
        }
      ],
