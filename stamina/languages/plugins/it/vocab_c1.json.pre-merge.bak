    {
      "slug": "concentrato-adj",
      "lemma": "concentrato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6647,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6950095",
          "text": "Sono concentrato sul lavoro.",
          "translation": "Я сосредоточен на работе.",
          "source": "Tatoeba #6950095 @dnnywld / #4964701 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950095",
          "cefr_level": "A1",
          "word_slugs": [
            "concentrato-adj"
          ]
        },
        {
          "id": "7063475",
          "text": "Mi sono concentrato sulla lezione.",
          "translation": "Я сосредоточился на лекции.",
          "source": "Tatoeba #7063475 @dnnywld / #7063458 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7063475",
          "cefr_level": "A1",
          "word_slugs": [
            "concentrato-adj"
          ]
        },
        {
          "id": "6304609",
          "text": "Ero concentrato su quello che lui stava dicendo.",
          "translation": "Я сконцентрировалась на том, что он говорил.",
          "source": "Tatoeba #6304609 @dnnywld / #2557559 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6304609",
          "cefr_level": "A1",
          "word_slugs": [
            "concentrato-adj"
          ]
        },
        {
          "id": "5965951",
          "text": "La spremuta è più cara del concentrato di succo.",
          "translation": "Свежевыжатый сок дороже сока из концентрата.",
          "source": "Tatoeba #5965951 @dnnywld / #5965602 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5965951",
          "cefr_level": "A1",
          "word_slugs": [
            "concentrato-adj"
          ]
        }
      ],
