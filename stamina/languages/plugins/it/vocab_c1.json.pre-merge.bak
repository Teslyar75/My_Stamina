    {
      "slug": "osservando-verb",
      "lemma": "osservando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7908,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5514379",
          "text": "Mi stanno osservando.",
          "translation": "Они за мной наблюдают.",
          "source": "Tatoeba #5514379 @dnnywld / #5513291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514379",
          "cefr_level": "A1",
          "word_slugs": [
            "osservando-verb"
          ]
        },
        {
          "id": "5655997",
          "text": "Stai osservando un digiuno?",
          "translation": "Ты соблюдаешь посты?",
          "source": "Tatoeba #5655997 @dnnywld / #5655978 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5655997",
          "cefr_level": "A1",
          "word_slugs": [
            "osservando-verb"
          ]
        },
        {
          "id": "5632164",
          "text": "Da quanto mi stai osservando?",
          "translation": "Давно ты за мной наблюдаешь?",
          "source": "Tatoeba #5632164 @dnnywld / #5631117 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632164",
          "cefr_level": "A1",
          "word_slugs": [
            "osservando-verb"
          ]
        },
        {
          "id": "5632162",
          "text": "Da quanto mi state osservando?",
          "translation": "Давно вы за мной наблюдаете?",
          "source": "Tatoeba #5632162 @dnnywld / #5631118 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632162",
          "cefr_level": "A1",
          "word_slugs": [
            "osservando-verb"
          ]
        },
        {
          "id": "6953469",
          "text": "Oggi sto osservando il digiuno.",
          "translation": "Сегодня я соблюдаю пост.",
          "source": "Tatoeba #6953469 @dnnywld / #6953251 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953469",
          "cefr_level": "A1",
          "word_slugs": [
            "osservando-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
