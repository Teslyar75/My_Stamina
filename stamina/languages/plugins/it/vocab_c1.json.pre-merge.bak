    {
      "slug": "afferma-verb",
      "lemma": "afferma",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7957,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5669290",
          "text": "Tom afferma di essere nato a Boston.",
          "translation": "Том утверждает, что родился в Бостоне.",
          "source": "Tatoeba #5669290 @dnnywld / #5668701 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5669290",
          "cefr_level": "A1",
          "word_slugs": [
            "afferma-verb"
          ]
        },
        {
          "id": "5444800",
          "text": "Tom afferma di non aver mai detto questo.",
          "translation": "Том утверждает, что никогда такого не говорил.",
          "source": "Tatoeba #5444800 @dnnywld / #5444792 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5444800",
          "cefr_level": "A1",
          "word_slugs": [
            "afferma-verb"
          ]
        },
        {
          "id": "7049978",
          "text": "Mia sorella afferma di aver visto un UFO.",
          "translation": "Моя сестра утверждает, что видела НЛО.",
          "source": "Tatoeba #7049978 @dnnywld / #7049071 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7049978",
          "cefr_level": "A1",
          "word_slugs": [
            "afferma-verb"
          ]
        },
        {
          "id": "7049591",
          "text": "Mio fratello afferma di aver visto un UFO nel cielo.",
          "translation": "Мой брат утверждает, что видел в небе НЛО.",
          "source": "Tatoeba #7049591 @dnnywld / #7049086 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7049591",
          "cefr_level": "A1",
          "word_slugs": [
            "afferma-verb"
          ]
        },
        {
          "id": "5692403",
          "text": "Tom afferma di aver sparato a Mary per legittima difesa.",
          "translation": "Том утверждает, что выстрелил в Мэри в целях самообороны.",
          "source": "Tatoeba #5692403 @dnnywld / #5689639 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5692403",
          "cefr_level": "A1",
          "word_slugs": [
            "afferma-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "afferma",
        "plural": "",
        "infinitive": "afferma"
      }
    },
    {
      "slug": "chiuda-verb",
      "lemma": "chiuda",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7958,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3412780",
          "text": "Chiuda la porta.",
          "translation": "Закройте дверь.",
          "source": "Tatoeba #3412780 @Guybrush88 / #2339004 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3412780",
          "cefr_level": "A1",
          "word_slugs": [
            "chiuda-verb"
          ]
        },
        {
          "id": "1870752",
          "text": "Chiuda la finestra.",
          "translation": "Закройте окно.",
          "source": "Tatoeba #1870752 @Guybrush88 / #580369 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1870752",
          "cefr_level": "A1",
          "word_slugs": [
            "chiuda-verb"
          ]
        },
        {
          "id": "4692",
          "text": "Chiuda la porta uscendo.",
          "translation": "Уходя, закройте дверь.",
          "source": "Tatoeba #4692 @Pharamp / #3069169 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4692",
          "cefr_level": "A1",
          "word_slugs": [
            "chiuda-verb"
          ]
        },
        {
          "id": "5385488",
          "text": "Vai in negozio prima che chiuda.",
          "translation": "Сходи в магазин, пока он не закрылся.",
          "source": "Tatoeba #5385488 @dnnywld / #5385463 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385488",
          "cefr_level": "A1",
          "word_slugs": [
            "chiuda-verb"
          ]
        },
        {
          "id": "5385486",
          "text": "Andate in negozio, prima che chiuda.",
          "translation": "Сходите в магазин, пока он не закрылся.",
          "source": "Tatoeba #5385486 @dnnywld / #5385465 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385486",
          "cefr_level": "A1",
          "word_slugs": [
            "chiuda-verb"
          ]
        }
      ],
