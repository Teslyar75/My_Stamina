          ]
        },
        {
          "id": "5998830",
          "text": "Tom calò il secchio nel pozzo.",
          "translation": "Том опустил ведро в колодец.",
          "source": "Tatoeba #5998830 @dnnywld / #4281767 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5998830",
