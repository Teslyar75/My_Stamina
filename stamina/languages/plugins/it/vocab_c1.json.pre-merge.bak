      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8412,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5392575",
          "text": "Loro hanno sostenuto il suo diritto per esprimersi liberamente.",
          "translation": "Они поддержали его право говорить свободно.",
          "source": "Tatoeba #5392575 @dnnywld / #5392451 @anton_tupy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5392575",
          "cefr_level": "A1",
          "word_slugs": [
            "liberamente-adv"
          ]
        },
        {
          "id": "5520413",
          "text": "Non sono un ipocrita, pertanto esprimo liberamente le mie opinioni.",
          "translation": "Я не лицемер и поэтому свободно выражаю свои взгляды.",
          "source": "Tatoeba #5520413 @dnnywld / #5216355 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5520413",
          "cefr_level": "A1",
          "word_slugs": [
            "liberamente-adv"
          ]
        }
      ],
      "tags": [
