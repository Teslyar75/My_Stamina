    {
      "slug": "comportarsi-verb",
      "lemma": "comportarsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6804,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6890067",
          "text": "Lui cominciò comportarsi stranamente.",
          "translation": "Он стал странно себя вести.",
          "source": "Tatoeba #6890067 @dnnywld / #2788654 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890067",
          "cefr_level": "A1",
          "word_slugs": [
            "comportarsi-verb"
          ]
        },
        {
          "id": "6890068",
          "text": "Lei cominciò comportarsi stranamente.",
          "translation": "Она стала странно себя вести.",
          "source": "Tatoeba #6890068 @dnnywld / #2788655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890068",
          "cefr_level": "A1",
          "word_slugs": [
            "comportarsi-verb"
          ]
        },
        {
          "id": "5574245",
          "text": "Lei non sa come comportarsi.",
          "translation": "Она не умеет себя вести.",
          "source": "Tatoeba #5574245 @dnnywld / #5574097 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5574245",
          "cefr_level": "A1",
          "word_slugs": [
            "comportarsi-verb"
          ]
        },
        {
          "id": "6738869",
          "text": "Tom non sa come comportarsi.",
          "translation": "Том не знает, как поступить.",
          "source": "Tatoeba #6738869 @dnnywld / #1986169 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6738869",
          "cefr_level": "A1",
          "word_slugs": [
            "comportarsi-verb"
          ]
        },
        {
          "id": "6811126",
          "text": "Jiro non poteva comportarsi diversamente.",
          "translation": "Дзиро не мог поступить иначе.",
          "source": "Tatoeba #6811126 @dnnywld / #4893449 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6811126",
          "cefr_level": "A1",
          "word_slugs": [
            "comportarsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "comportarsi",
