      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10885190",
          "text": "Pratico lo judo.",
          "translation": "Я занимаюсь дзюдо.",
          "source": "Tatoeba #10885190 @dnnywld / #2627522 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885190",
          "cefr_level": "A1",
          "word_slugs": [
            "pratico-adj"
          ]
        },
        {
          "id": "5510988",
          "text": "Tom è un tipo pratico.",
          "translation": "Том - практичный человек.",
          "source": "Tatoeba #5510988 @dnnywld / #5510541 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510988",
