          ]
        },
        {
          "id": "5401185",
          "text": "Come si legge l'ultima parola nella terza riga?",
          "translation": "Как читается последнее слово в третьей строке?",
          "source": "Tatoeba #5401185 @dnnywld / #4148406 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5401185",
          "cefr_level": "A1",
