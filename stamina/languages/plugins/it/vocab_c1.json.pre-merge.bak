      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7073356",
          "text": "Tom entrò senza bussare.",
          "translation": "Том вошёл без стука.",
          "source": "Tatoeba #7073356 @dnnywld / #7072887 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7073356",
          "cefr_level": "A1",
          "word_slugs": [
