            "cominciando-verb"
          ]
        },
        {
          "id": "5437505",
          "text": "Lo spettacolo sta appena cominciando.",
          "translation": "Спектакль только начинается.",
          "source": "Tatoeba #5437505 @dnnywld / #5436434 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5437505",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciando-verb"
          ]
        },
        {
          "id": "6866836",
          "text": "Lo spettacolo sta cominciando adesso.",
          "translation": "Шоу сейчас начнётся.",
          "source": "Tatoeba #6866836 @dnnywld / #6863163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866836",
