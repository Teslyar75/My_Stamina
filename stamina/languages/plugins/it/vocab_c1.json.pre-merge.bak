    {
      "slug": "facili-adj",
      "lemma": "facili",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5114,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5862147",
          "text": "Questi libri sono più facili di quelli.",
          "translation": "Эти книги легче тех.",
          "source": "Tatoeba #5862147 @dnnywld / #5861963 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5862147",
          "cefr_level": "A1",
          "word_slugs": [
            "facili-adj"
          ]
        },
        {
          "id": "6896836",
          "text": "Le frasi di Dan sono facili da tradurre.",
          "translation": "Предложения Дэна легко переводить.",
          "source": "Tatoeba #6896836 @dnnywld / #4172014 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6896836",
          "cefr_level": "A1",
          "word_slugs": [
            "facili-adj"
          ]
        },
        {
          "id": "1761046",
          "text": "Le frasi di Mary sono facili da tradurre.",
          "translation": "Предложения Мэри легко переводить.",
          "source": "Tatoeba #1761046 @Guybrush88 / #2562599 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1761046",
          "cefr_level": "A1",
          "word_slugs": [
            "facili-adj"
          ]
        },
        {
          "id": "7372923",
          "text": "Volevo soldi facili, ed ecco che ho abboccato.",
          "translation": "Лёгких денег захотелось, вот и попался на удочку.",
          "source": "Tatoeba #7372923 @dnnywld / #7372404 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7372923",
          "cefr_level": "A1",
          "word_slugs": [
            "facili-adj"
          ]
        },
        {
          "id": "6961200",
          "text": "Palla di Sego è una donna di facili virtù.",
          "translation": "Пышка — женщина лёгкого поведения.",
          "source": "Tatoeba #6961200 @dnnywld / #6960644 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961200",
          "cefr_level": "A1",
          "word_slugs": [
            "facili-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il facili",
        "plural": "",
        "infinitive": ""
      }
