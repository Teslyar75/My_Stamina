      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5389022",
          "text": "Non ascoltate i pettegolezzi.",
          "translation": "Не слушайте сплетни.",
          "source": "Tatoeba #5389022 @dnnywld / #5389005 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5389022",
          "cefr_level": "A1",
          "word_slugs": [
