    {
      "slug": "vaga-adj",
      "lemma": "vaga",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9159,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5513471",
          "text": "Lui gli ha dato una risposta vaga.",
          "translation": "Он дал ему расплывчатый ответ.",
          "source": "Tatoeba #5513471 @dnnywld / #5513436 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513471",
          "cefr_level": "A1",
          "word_slugs": [
            "vaga-adj"
          ]
        },
        {
          "id": "13495383",
          "text": "Almeno hai qualche vaga idea di chi sia lui?",
          "translation": "Ты хоть представляешь, кто это?",
          "source": "Tatoeba #13495383 @dnnywld / #11339401 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495383",
          "cefr_level": "A1",
          "word_slugs": [
            "vaga-adj"
          ]
        },
        {
          "id": "13495384",
          "text": "Almeno avete qualche vaga idea di chi sia lui?",
          "translation": "Вы хоть представляете, кто это?",
          "source": "Tatoeba #13495384 @dnnywld / #11339400 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495384",
          "cefr_level": "A1",
          "word_slugs": [
            "vaga-adj"
          ]
        },
        {
          "id": "5454734",
          "text": "Hai una vaga idea di cosa ci sia nella scatola?",
          "translation": "Ты хоть представляешь, что в коробке?",
          "source": "Tatoeba #5454734 @dnnywld / #5454307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5454734",
          "cefr_level": "A1",
          "word_slugs": [
            "vaga-adj"
          ]
        },
        {
          "id": "5706877",
          "text": "Tom vaga da solo per la città e non parla con nessuno.",
          "translation": "Том бродит один по городу и ни с кем не общается.",
          "source": "Tatoeba #5706877 @dnnywld / #5705558 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5706877",
          "cefr_level": "A1",
          "word_slugs": [
            "vaga-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il vaga",
        "plural": "",
        "infinitive": ""
      }
    },
