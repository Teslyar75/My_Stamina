    {
      "slug": "insistere-verb",
      "lemma": "insistere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7361,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5827251",
          "text": "È necessario continuare a insistere.",
          "translation": "Необходимо продолжать настаивать.",
          "source": "Tatoeba #5827251 @dnnywld / #4097363 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5827251",
          "cefr_level": "A1",
          "word_slugs": [
            "insistere-verb"
          ]
        },
        {
          "id": "6860621",
          "text": "Lui pensò bene di non insistere.",
          "translation": "Он не стал настаивать.",
          "source": "Tatoeba #6860621 @dnnywld / #4028782 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6860621",
          "cefr_level": "A1",
          "word_slugs": [
            "insistere-verb"
          ]
        },
        {
          "id": "760721",
          "text": "È bene insistere quando sai di aver ragione.",
          "translation": "Хорошо настаивать, когда знаешь, что прав.",
          "source": "Tatoeba #760721 @rado / #1792753 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/760721",
          "cefr_level": "A1",
          "word_slugs": [
            "insistere-verb"
          ]
        },
        {
          "id": "1766166",
          "text": "Ad ogni modo, come ho detto, non ho intenzione di insistere.",
          "translation": "В любом случае, как я говорил, не хочу настаивать.",
          "source": "Tatoeba #1766166 @al_ex_an_der / #3800920 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1766166",
          "cefr_level": "A1",
          "word_slugs": [
            "insistere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "insistere",
        "plural": "",
        "infinitive": "insistere"
      }
