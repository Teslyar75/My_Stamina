        {
          "id": "5610424",
          "text": "Abbiamo disatteso le aspettative.",
          "translation": "Мы не оправдали ожиданий.",
          "source": "Tatoeba #5610424 @dnnywld / #5609672 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5610424",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettative-noun"
          ]
        },
        {
          "id": "5520753",
          "text": "Tom ha delle aspettative molto grandi.",
          "translation": "У Тома очень высокие ожидания.",
          "source": "Tatoeba #5520753 @dnnywld / #5520541 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5520753",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettative-noun"
          ]
        },
        {
          "id": "5456251",
          "text": "Nessuno dei pretendenti ha soddisfatto le aspettative di Mary.",
          "translation": "Никто из ухажёров не оправдал ожиданий Мэри.",
          "source": "Tatoeba #5456251 @dnnywld / #4110868 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5456251",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettative-noun"
          ]
        },
        {
          "id": "10844127",
          "text": "Scusami se non sono stato all'altezza delle tue aspettative.",
          "translation": "Прости, что не оправдал твоих надежд.",
          "source": "Tatoeba #10844127 @dnnywld / #10841600 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844127",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettative-noun"
          ]
        },
        {
          "id": "10844125",
          "text": "Scusate se non sono stato all'altezza delle vostre aspettative.",
          "translation": "Простите, что не оправдал ваших надежд.",
          "source": "Tatoeba #10844125 @dnnywld / #10841601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844125",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettative-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
