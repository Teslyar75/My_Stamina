    {
      "slug": "viaggiato-verb",
      "lemma": "viaggiato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7163,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "351079",
          "text": "Ho viaggiato da solo.",
          "translation": "Я путешествовал в одиночку.",
          "source": "Tatoeba #351079 @martin / #6179410 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/351079",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggiato-verb"
          ]
        },
        {
          "id": "5567926",
          "text": "Ho viaggiato a piedi.",
          "translation": "Я путешествовал пешком.",
          "source": "Tatoeba #5567926 @dnnywld / #5566949 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5567926",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggiato-verb"
          ]
        },
        {
          "id": "6365360",
          "text": "Ho viaggiato da sola.",
          "translation": "Я путешествовала одна.",
          "source": "Tatoeba #6365360 @dnnywld / #6179412 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6365360",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggiato-verb"
          ]
        },
        {
          "id": "5532950",
          "text": "Tom ha viaggiato in Australia.",
          "translation": "Том путешествовал по Австралии.",
          "source": "Tatoeba #5532950 @dnnywld / #5532880 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5532950",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggiato-verb"
          ]
        },
        {
          "id": "5387027",
          "text": "Avete mai viaggiato in mongolfiera?",
          "translation": "Вы когда-нибудь путешествовали на воздушном шаре?",
          "source": "Tatoeba #5387027 @dnnywld / #5387004 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387027",
          "cefr_level": "A1",
          "word_slugs": [
            "viaggiato-verb"
          ]
        }
