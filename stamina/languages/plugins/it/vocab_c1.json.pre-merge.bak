            "calze-noun"
          ]
        },
        {
          "id": "1276429",
          "text": "Comprò due paia di calze.",
          "translation": "Она купила две пары носков.",
          "source": "Tatoeba #1276429 @Guybrush88 / #1394345 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1276429",
