    {
      "slug": "mento-noun",
      "lemma": "mento",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6288,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5429428",
          "text": "Mento in su!",
          "translation": "Не вешай нос!",
          "source": "Tatoeba #5429428 @dnnywld / #2287513 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5429428",
          "cefr_level": "A1",
          "word_slugs": [
            "mento-noun"
          ]
        },
        {
          "id": "5630114",
          "text": "Io non mento deliberatamente alle persone.",
          "translation": "Я не намеренно лгу людям.",
