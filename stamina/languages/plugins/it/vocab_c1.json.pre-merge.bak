    {
      "slug": "orientale-adj",
      "lemma": "orientale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8188,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "12755792",
          "text": "Il russo è una lingua slava orientale.",
          "translation": "Русский - восточнославянский язык.",
          "source": "Tatoeba #12755792 @Adelpa / #11671129 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12755792",
          "cefr_level": "A1",
          "word_slugs": [
            "orientale-adj"
          ]
        },
        {
          "id": "5619531",
          "text": "Ho sempre voluto imparare una lingua orientale.",
          "translation": "Я всегда хотел выучить какой-нибудь восточный язык.",
          "source": "Tatoeba #5619531 @dnnywld / #4570345 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5619531",
          "cefr_level": "A1",
          "word_slugs": [
            "orientale-adj"
          ]
        },
