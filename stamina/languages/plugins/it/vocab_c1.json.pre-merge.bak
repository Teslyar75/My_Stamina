    {
      "slug": "iniziata-verb",
      "lemma": "iniziata",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5019,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1387182",
          "text": "La vita è appena iniziata.",
          "translation": "Жизнь только началась.",
          "source": "Tatoeba #1387182 @Guybrush88 / #3588046 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1387182",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziata-verb"
          ]
        },
        {
          "id": "3168746",
          "text": "La partita di calcio non è ancora iniziata.",
          "translation": "Футбольный матч ещё не начался.",
          "source": "Tatoeba #3168746 @Guybrush88 / #3315547 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3168746",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziata-verb"
          ]
        },
        {
          "id": "3323590",
          "text": "La Prima Guerra Mondiale è iniziata nell'anno 1914.",
          "translation": "Первая мировая война началась в 1914 году.",
          "source": "Tatoeba #3323590 @Guybrush88 / #831782 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3323590",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziata-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
