    {
      "slug": "facoltà-noun",
      "lemma": "facoltà",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9710,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6203848",
          "text": "Vengo con te alla facoltà.",
          "translation": "Я пойду с тобой до факультета.",
          "source": "Tatoeba #6203848 @dnnywld / #6203489 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6203848",
          "cefr_level": "A1",
          "word_slugs": [
            "facoltà-noun"
          ]
        },
        {
          "id": "5489733",
          "text": "In quale facoltà state studiando?",
          "translation": "На каком факультете вы учитесь?",
          "source": "Tatoeba #5489733 @dnnywld / #5489195 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489733",
          "cefr_level": "A1",
          "word_slugs": [
            "facoltà-noun"
          ]
        },
        {
          "id": "6385588",
          "text": "Sono uno studente della facoltà di giurisprudenza.",
          "translation": "Я студент юридического факультета.",
          "source": "Tatoeba #6385588 @dnnywld / #6385294 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6385588",
          "cefr_level": "A1",
          "word_slugs": [
            "facoltà-noun"
          ]
        },
        {
          "id": "6385590",
          "text": "Sono una studentessa della facoltà di giurisprudenza.",
          "translation": "Я студентка юридического факультета.",
          "source": "Tatoeba #6385590 @dnnywld / #6385292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6385590",
          "cefr_level": "A1",
          "word_slugs": [
            "facoltà-noun"
          ]
        },
        {
          "id": "6375313",
          "text": "Lui è uno studente della facoltà di giurisprudenza.",
          "translation": "Он студент юридического факультета.",
          "source": "Tatoeba #6375313 @dnnywld / #6375205 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6375313",
          "cefr_level": "A1",
