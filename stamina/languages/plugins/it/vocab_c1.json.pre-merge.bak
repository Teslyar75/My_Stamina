    {
      "slug": "ragazzine-noun",
      "lemma": "ragazzine",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8131,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7065329",
          "text": "La cantante è popolare tra le ragazzine.",
          "translation": "Певица популярна среди девочек.",
          "source": "Tatoeba #7065329 @dnnywld / #7064920 @Androix (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7065329",
          "cefr_level": "A1",
          "word_slugs": [
            "ragazzine-noun"
          ]
        },
        {
          "id": "7085019",
          "text": "Le bambole alle ragazzine e il pallone ai ragazzini.",
          "translation": "Куклы девочкам, а мяч - мальчикам.",
          "source": "Tatoeba #7085019 @dnnywld / #7083624 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7085019",
          "cefr_level": "A1",
          "word_slugs": [
            "ragazzine-noun"
          ]
        },
        {
          "id": "6477845",
          "text": "La morte della madre fu un duro colpo per le ragazzine.",
          "translation": "Смерть матери была для девочек тяжёлым ударом.",
          "source": "Tatoeba #6477845 @dnnywld / #6477698 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6477845",
          "cefr_level": "A1",
          "word_slugs": [
            "ragazzine-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ragazzine",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "osserva-verb",
      "lemma": "osserva",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8133,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5591084",
          "text": "Tom osserva una rigida dieta.",
          "translation": "Том на строгой диете.",
          "source": "Tatoeba #5591084 @dnnywld / #5590974 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591084",
          "cefr_level": "A1",
          "word_slugs": [
            "osserva-verb"
          ]
        },
        {
          "id": "5635678",
          "text": "Tom siede sul tetto e osserva il sole che tramonta.",
          "translation": "Том сидит на крыше дома и наблюдает, как садится солнце.",
          "source": "Tatoeba #5635678 @dnnywld / #5635663 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635678",
          "cefr_level": "A1",
          "word_slugs": [
            "osserva-verb"
          ]
        },
        {
          "id": "7682219",
          "text": "Tom osserva il mondo attraverso degli occhiali tinti di rosa.",
          "translation": "Том смотрит на мир сквозь розовые очки.",
          "source": "Tatoeba #7682219 @dnnywld / #7681697 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7682219",
          "cefr_level": "A1",
          "word_slugs": [
            "osserva-verb"
          ]
        },
        {
          "id": "5429004",
          "text": "Il piccolo osserva come il gatto va a caccia di passeri.",
          "translation": "Малыш наблюдает, как кошка охотится за воробьями.",
          "source": "Tatoeba #5429004 @dnnywld / #5428156 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5429004",
          "cefr_level": "A1",
          "word_slugs": [
            "osserva-verb"
          ]
        }
      ],
      "tags": [
