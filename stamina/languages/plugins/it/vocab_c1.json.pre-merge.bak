      "cefr_level": "C1",
      "frequency_rank": 8413,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "4538426",
          "text": "L'oca starnazza.",
          "translation": "Гусь гогочет.",
          "source": "Tatoeba #4538426 @Guybrush88 / #4539182 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538426",
          "cefr_level": "A1",
          "word_slugs": [
            "oca-noun"
          ]
        },
        {
          "id": "5472809",
          "text": "Ho ancora la pelle d'oca.",
          "translation": "Я чувствую мурашки опять.",
          "source": "Tatoeba #5472809 @dnnywld / #2191520 @Snark (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472809",
          "cefr_level": "A1",
          "word_slugs": [
            "oca-noun"
          ]
        },
        {
          "id": "5444784",
          "text": "Tom mi fa venire la pelle d'oca.",
          "translation": "У меня от Тома мурашки.",
          "source": "Tatoeba #5444784 @dnnywld / #5444678 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5444784",
          "cefr_level": "A1",
          "word_slugs": [
            "oca-noun"
          ]
        }
      ],
      "tags": [
