          ]
        },
        {
          "id": "6378828",
          "text": "Non sopporto fare shopping.",
          "translation": "Я терпеть не могу ходить по магазинам.",
          "source": "Tatoeba #6378828 @dnnywld / #3520454 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6378828",
