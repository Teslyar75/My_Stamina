    {
      "slug": "pescare-verb",
      "lemma": "pescare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6533,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2718400",
          "text": "Lui ama pescare.",
          "translation": "Он любит рыбалку.",
          "source": "Tatoeba #2718400 @Guybrush88 / #351643 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2718400",
          "cefr_level": "A1",
          "word_slugs": [
            "pescare-verb"
          ]
        },
        {
          "id": "6893859",
          "text": "Ti piace pescare?",
          "translation": "Ты любишь рыбачить?",
          "source": "Tatoeba #6893859 @dnnywld / #6893200 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893859",
          "cefr_level": "A1",
          "word_slugs": [
            "pescare-verb"
          ]
        },
        {
          "id": "6893860",
          "text": "Vi piace pescare?",
          "translation": "Вы любите рыбачить?",
          "source": "Tatoeba #6893860 @dnnywld / #6893199 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893860",
          "cefr_level": "A1",
          "word_slugs": [
            "pescare-verb"
          ]
        },
        {
          "id": "5593729",
          "text": "Qui si può pescare?",
          "translation": "Здесь можно рыбачить?",
          "source": "Tatoeba #5593729 @dnnywld / #5593704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5593729",
          "cefr_level": "A1",
          "word_slugs": [
            "pescare-verb"
          ]
        },
        {
          "id": "3761750",
          "text": "Sono andati a pescare.",
          "translation": "Они пошли на рыбалку.",
          "source": "Tatoeba #3761750 @Guybrush88 / #2518552 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3761750",
          "cefr_level": "A1",
          "word_slugs": [
            "pescare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
