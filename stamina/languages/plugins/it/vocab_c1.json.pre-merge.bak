    {
      "slug": "passava-verb",
      "lemma": "passava",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7743,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6889818",
          "text": "Lui di solito passava del tempo da sua nonna.",
          "translation": "Он обычно проводил время у своей бабушки.",
          "source": "Tatoeba #6889818 @dnnywld / #3539026 @calebante (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6889818",
          "cefr_level": "A1",
          "word_slugs": [
            "passava-verb"
          ]
        },
        {
          "id": "5662265",
          "text": "Tom passava il giorno in archivio, e la sera scriveva articoli.",
          "translation": "Том проводил дни в архиве, а вечерами писал статьи.",
          "source": "Tatoeba #5662265 @dnnywld / #5661110 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662265",
          "cefr_level": "A1",
          "word_slugs": [
            "passava-verb"
          ]
        },
        {
          "id": "2417866",
          "text": "La luce di un nuovo giorno passava per gli strati di nebbia.",
          "translation": "Свет нового дня уже сочился сквозь слои тумана.",
          "source": "Tatoeba #2417866 @al_ex_an_der / #2417833 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2417866",
          "cefr_level": "A1",
          "word_slugs": [
            "passava-verb"
          ]
        },
        {
          "id": "12532068",
          "text": "Volevo salire sul primo treno che passava e andare lontano, molto lontano.",
          "translation": "Мне хотелось сесть в первый попавшийся поезд и уехать далеко-далеко.",
          "source": "Tatoeba #12532068 @carlosalberto / #12530722 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12532068",
          "cefr_level": "A1",
          "word_slugs": [
            "passava-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "passava",
        "plural": "",
        "infinitive": "passava"
      }
