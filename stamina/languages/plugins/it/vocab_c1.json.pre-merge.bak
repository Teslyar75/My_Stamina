    {
      "slug": "autunno-noun",
      "lemma": "autunno",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5904,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "осень"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5515280",
          "text": "Adoro l'autunno.",
          "translation": "Обожаю осень.",
          "source": "Tatoeba #5515280 @dnnywld / #5207232 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5515280",
          "cefr_level": "A1",
          "word_slugs": [
            "autunno-noun"
          ]
        },
        {
          "id": "5391727",
          "text": "Arriva l'autunno.",
          "translation": "Наступает осень.",
          "source": "Tatoeba #5391727 @dnnywld / #5391724 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5391727",
          "cefr_level": "A1",
          "word_slugs": [
            "autunno-noun"
          ]
        },
        {
          "id": "1082489",
          "text": "Vado a Parigi in autunno.",
          "translation": "Я поеду в Париж осенью.",
          "source": "Tatoeba #1082489 @Guybrush88 / #4157313 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1082489",
          "cefr_level": "A1",
          "word_slugs": [
            "autunno-noun"
          ]
        },
        {
          "id": "411818",
          "text": "In autunno cadono le foglie.",
          "translation": "Осенью падает листва.",
          "source": "Tatoeba #411818 @shoras / #4127139 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/411818",
          "cefr_level": "A1",
          "word_slugs": [
            "autunno-noun"
          ]
        },
        {
          "id": "5526154",
          "text": "Lei si sposa questo autunno.",
          "translation": "Этой осенью она выходит замуж.",
