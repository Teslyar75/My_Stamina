    {
      "slug": "giovinezza-noun",
      "lemma": "giovinezza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9673,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5627712",
          "text": "La giovinezza è breve.",
          "translation": "Молодость коротка.",
          "source": "Tatoeba #5627712 @dnnywld / #4003912 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627712",
          "cefr_level": "A1",
          "word_slugs": [
            "giovinezza-noun"
          ]
        },
        {
          "id": "5470675",
          "text": "La giovinezza non ritorna.",
          "translation": "Молодость нельзя вернуть.",
          "source": "Tatoeba #5470675 @dnnywld / #2499691 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5470675",
          "cefr_level": "A1",
          "word_slugs": [
            "giovinezza-noun"
          ]
        },
        {
          "id": "8177193",
          "text": "La mia giovinezza è andata.",
          "translation": "Моя молодость прошла.",
          "source": "Tatoeba #8177193 @dnnywld / #8176977 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8177193",
          "cefr_level": "A1",
          "word_slugs": [
            "giovinezza-noun"
          ]
        },
        {
          "id": "5627785",
          "text": "Le hanno rubato la giovinezza.",
          "translation": "У неё украли молодость.",
          "source": "Tatoeba #5627785 @dnnywld / #2404418 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627785",
          "cefr_level": "A1",
          "word_slugs": [
            "giovinezza-noun"
          ]
        },
        {
          "id": "5627784",
