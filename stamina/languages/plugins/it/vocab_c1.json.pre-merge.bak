    {
      "slug": "mercoledì-noun",
      "lemma": "mercoledì",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7377,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4264242",
          "text": "Oggi è mercoledì.",
          "translation": "Сегодня среда.",
          "source": "Tatoeba #4264242 @Guybrush88 / #2484149 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4264242",
          "cefr_level": "A1",
          "word_slugs": [
            "mercoledì-noun"
          ]
        },
        {
          "id": "5500089",
          "text": "Ieri era mercoledì.",
          "translation": "Вчера была среда.",
          "source": "Tatoeba #5500089 @dnnywld / #5500018 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500089",
          "cefr_level": "A1",
          "word_slugs": [
            "mercoledì-noun"
          ]
        },
        {
          "id": "6716839",
          "text": "Mercoledì sono libera.",
          "translation": "В среду я свободна.",
          "source": "Tatoeba #6716839 @dnnywld / #6712593 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6716839",
          "cefr_level": "A1",
          "word_slugs": [
            "mercoledì-noun"
          ]
        },
        {
          "id": "5500082",
          "text": "Dopodomani è mercoledì.",
          "translation": "Послезавтра среда.",
          "source": "Tatoeba #5500082 @dnnywld / #5500027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500082",
          "cefr_level": "A1",
          "word_slugs": [
            "mercoledì-noun"
          ]
        },
        {
          "id": "6716840",
          "text": "Mercoledì non ho impegni.",
          "translation": "В среду я свободна.",
          "source": "Tatoeba #6716840 @dnnywld / #6712593 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6716840",
          "cefr_level": "A1",
          "word_slugs": [
            "mercoledì-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il mercoledì",
        "plural": "",
        "infinitive": ""
      }
