    {
      "slug": "specialista-adj",
      "lemma": "specialista",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8578,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5677844",
          "text": "Lei è una specialista.",
          "translation": "Она специалист.",
          "source": "Tatoeba #5677844 @dnnywld / #5677152 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677844",
          "cefr_level": "A1",
          "word_slugs": [
            "specialista-adj"
          ]
        },
        {
          "id": "11585233",
          "text": "Tom è uno specialista di reti neurali.",
          "translation": "Том — специалист по нейросетям.",
          "source": "Tatoeba #11585233 @Valdast / #10148541 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11585233",
          "cefr_level": "A1",
          "word_slugs": [
            "specialista-adj"
          ]
        },
        {
          "id": "5408080",
          "text": "Un bravo specialista deve salvaguardare l'attrezzatura.",
          "translation": "Хороший специалист должен беречь технику.",
          "source": "Tatoeba #5408080 @dnnywld / #4190696 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408080",
          "cefr_level": "A1",
          "word_slugs": [
            "specialista-adj"
          ]
        },
        {
          "id": "6944357",
          "text": "In questo campo lui è un grande specialista.",
          "translation": "Он большой спец в этой области.",
          "source": "Tatoeba #6944357 @dnnywld / #6943827 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944357",
          "cefr_level": "A1",
          "word_slugs": [
            "specialista-adj"
          ]
        }
      ],
