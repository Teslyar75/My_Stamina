      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7073391",
          "text": "Quanto al chilo?",
          "translation": "Сколько за килограмм?",
          "source": "Tatoeba #7073391 @dnnywld / #7072742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7073391",
          "cefr_level": "A1",
          "word_slugs": [
            "chilo-noun"
          ]
        },
        {
          "id": "7275411",
          "text": "È il prezzo al chilo?",
          "translation": "Это цена за килограмм?",
          "source": "Tatoeba #7275411 @dnnywld / #7275291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7275411",
          "cefr_level": "A1",
          "word_slugs": [
            "chilo-noun"
          ]
        },
        {
          "id": "1122120",
          "text": "Il riso è venduto al chilo.",
          "translation": "Рис продаётся килограммами.",
          "source": "Tatoeba #1122120 @Guybrush88 / #1444687 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1122120",
