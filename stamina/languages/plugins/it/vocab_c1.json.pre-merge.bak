    {
      "slug": "miracoli-verb",
      "lemma": "miracoli",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6436,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5640146",
          "text": "Credo veramente nei miracoli.",
          "translation": "Я действительно верю в чудеса.",
          "source": "Tatoeba #5640146 @dnnywld / #5640042 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5640146",
          "cefr_level": "A1",
          "word_slugs": [
            "miracoli-verb"
          ]
        },
        {
          "id": "5622293",
          "text": "Questo dispositivo fa miracoli.",
          "translation": "Это устройство творит чудеса.",
          "source": "Tatoeba #5622293 @dnnywld / #5622119 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5622293",
          "cefr_level": "A1",
          "word_slugs": [
            "miracoli-verb"
          ]
        },
        {
          "id": "6067535",
          "text": "A volte succedono ancora miracoli.",
          "translation": "Иногда чудеса ещё случаются.",
          "source": "Tatoeba #6067535 @dnnywld / #6065728 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6067535",
          "cefr_level": "A1",
          "word_slugs": [
            "miracoli-verb"
          ]
        },
        {
          "id": "6829886",
          "text": "I miracoli si chiamano miracoli perché non accadono!",
          "translation": "Чудеса называют чудесами, потому что они не случаются!",
          "source": "Tatoeba #6829886 @dnnywld / #6829866 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6829886",
          "cefr_level": "A1",
          "word_slugs": [
            "miracoli-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "miracoli",
        "plural": "",
        "infinitive": "miracoli"
      }
