    {
      "slug": "insegno-verb",
      "lemma": "insegno",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7615,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5589430",
          "text": "Insegno il russo dal 1967.",
          "translation": "Я преподаю русский с 1967 года.",
          "source": "Tatoeba #5589430 @dnnywld / #5281429 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589430",
          "cefr_level": "A1",
          "word_slugs": [
            "insegno-verb"
          ]
        },
        {
          "id": "6611163",
          "text": "Insegno francese ai miei figli.",
          "translation": "Я преподаю своим детям французский.",
          "source": "Tatoeba #6611163 @dnnywld / #6603750 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6611163",
          "cefr_level": "A1",
          "word_slugs": [
            "insegno-verb"
          ]
        },
        {
          "id": "6839521",
          "text": "Insegno francese ai figli di Tom.",
          "translation": "Я учу детей Тома французскому.",
          "source": "Tatoeba #6839521 @dnnywld / #6839410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6839521",
          "cefr_level": "A1",
          "word_slugs": [
            "insegno-verb"
          ]
        },
        {
          "id": "6153968",
          "text": "Insegno la lingua francese agli studenti.",
          "translation": "Я преподаю французский язык школьникам.",
          "source": "Tatoeba #6153968 @dnnywld / #6153963 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6153968",
          "cefr_level": "A1",
          "word_slugs": [
            "insegno-verb"
          ]
        },
        {
          "id": "5830469",
          "text": "Io insegno qui cinque giorni alla settimana.",
          "translation": "Я преподаю здесь пять дней в неделю.",
          "source": "Tatoeba #5830469 @Valdast / #6668149 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5830469",
          "cefr_level": "A1",
          "word_slugs": [
            "insegno-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "insegno",
        "plural": "",
        "infinitive": "insegno"
      }
