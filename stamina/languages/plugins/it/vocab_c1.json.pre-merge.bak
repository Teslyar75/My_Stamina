          ]
        },
        {
          "id": "10839248",
          "text": "Mary annotò la ricetta.",
          "translation": "Мэри записала рецепт.",
          "source": "Tatoeba #10839248 @dnnywld / #6558813 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10839248",
