    {
      "slug": "esservi-verb",
      "lemma": "esservi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9597,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5669869",
          "text": "Vorremmo esservi molto riconoscenti.",
          "translation": "Мы были бы вам очень признательны.",
          "source": "Tatoeba #5669869 @dnnywld / #5669718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5669869",
          "cefr_level": "A1",
          "word_slugs": [
            "esservi-verb"
          ]
        },
        {
          "id": "5567930",
          "text": "Come posso esservi di aiuto?",
          "translation": "Как мне вам помочь?",
          "source": "Tatoeba #5567930 @dnnywld / #5566893 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5567930",
          "cefr_level": "A1",
          "word_slugs": [
            "esservi-verb"
          ]
        },
        {
          "id": "5527896",
          "text": "Posso esserVi utile in qualche modo?",
          "translation": "Могу я Вам чем-нибудь помочь?",
          "source": "Tatoeba #5527896 @dnnywld / #3094681 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527896",
          "cefr_level": "A1",
          "word_slugs": [
            "esservi-verb"
          ]
        },
        {
          "id": "5652161",
          "text": "\"Posso esserVi di aiuto?\" - chiese il venditore.",
          "translation": "\"Я могу Вам помочь?\" - спросил продавец.",
          "source": "Tatoeba #5652161 @dnnywld / #5651637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652161",
          "cefr_level": "A1",
          "word_slugs": [
            "esservi-verb"
          ]
        },
        {
          "id": "10843902",
          "text": "Grazie per esservi iscritti alla nostra newsletter.",
          "translation": "Спасибо, что подписались на нашу почтовую рассылку.",
          "source": "Tatoeba #10843902 @dnnywld / #5407511 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10843902",
          "cefr_level": "A1",
          "word_slugs": [
            "esservi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "esservi",
        "plural": "",
        "infinitive": "esservi"
      }
    },
    {
      "slug": "finanziaria-adj",
      "lemma": "finanziaria",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9598,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2440411",
          "text": "Nella crisi finanziaria anche il diavolo diventa insolvente.",
          "translation": "Во время финансового кризиса даже дьявол станет неплатёжеспособным.",
          "source": "Tatoeba #2440411 @al_ex_an_der / #2440403 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2440411",
          "cefr_level": "A1",
          "word_slugs": [
            "finanziaria-adj"
          ]
        },
        {
          "id": "1634004",
          "text": "La situazione finanziaria sta peggiorando settimana dopo settimana.",
          "translation": "Финансовая ситуация становится хуже неделя за неделей.",
          "source": "Tatoeba #1634004 @Guybrush88 / #1601720 @mutternoise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1634004",
          "cefr_level": "A1",
          "word_slugs": [
            "finanziaria-adj"
          ]
        },
        {
          "id": "6894207",
          "text": "Al momento attuale Maria si trova in una situazione finanziaria estremamente difficile.",
          "translation": "В настоящее время Мария находится в крайне трудном финансовом положении.",
          "source": "Tatoeba #6894207 @dnnywld / #6893028 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6894207",
          "cefr_level": "A1",
          "word_slugs": [
            "finanziaria-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il finanziaria",
