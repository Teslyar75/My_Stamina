            "asso-noun"
          ]
        },
        {
          "id": "6904631",
          "text": "Vi ho mai piantato in asso?",
          "translation": "Я вас когда-нибудь подводил?",
          "source": "Tatoeba #6904631 @dnnywld / #6560351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904631",
          "cefr_level": "A1",
          "word_slugs": [
            "asso-noun"
          ]
        },
        {
          "id": "6904658",
          "text": "Io non ti pianterei mai in asso.",
          "translation": "Я бы никогда тебя не подвёл.",
          "source": "Tatoeba #6904658 @dnnywld / #6369789 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904658",
          "cefr_level": "A1",
          "word_slugs": [
            "asso-noun"
          ]
        },
        {
          "id": "6904663",
          "text": "Io non vi pianterei mai in asso.",
          "translation": "Я бы никогда вас не подвёл.",
          "source": "Tatoeba #6904663 @dnnywld / #6369790 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904663",
