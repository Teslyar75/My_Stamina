      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13779197",
          "text": "Su che base incolpare Tom?",
          "translation": "С какой стати обвинять Тома?",
          "source": "Tatoeba #13779197 @dnnywld / #5888123 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13779197",
          "cefr_level": "A1",
          "word_slugs": [
            "incolpare-verb"
          ]
        },
        {
          "id": "1217343",
          "text": "Tom deve incolpare solo se stesso.",
          "translation": "Том должен винить только себя.",
          "source": "Tatoeba #1217343 @Guybrush88 / #3090428 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1217343",
          "cefr_level": "A1",
          "word_slugs": [
            "incolpare-verb"
          ]
        },
        {
          "id": "6866907",
          "text": "Non hai nessuno da incolpare se non te stesso.",
          "translation": "Тебе некого винить, кроме себя самого.",
          "source": "Tatoeba #6866907 @dnnywld / #5772072 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866907",
          "cefr_level": "A1",
          "word_slugs": [
            "incolpare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "incolpare",
