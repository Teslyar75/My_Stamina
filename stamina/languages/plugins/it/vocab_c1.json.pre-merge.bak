    {
      "slug": "salito-verb",
      "lemma": "salito",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5972,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5860850",
          "text": "Sono salito sulla barca.",
          "translation": "Я поднялся на корабль.",
          "source": "Tatoeba #5860850 @Guybrush88 / #5902056 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5860850",
          "cefr_level": "A1",
          "word_slugs": [
            "salito-verb"
          ]
        },
        {
          "id": "5971352",
          "text": "Come sei salito fin lì?",
          "translation": "Как ты туда забрался?",
          "source": "Tatoeba #5971352 @dnnywld / #5969714 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971352",
          "cefr_level": "A1",
          "word_slugs": [
            "salito-verb"
          ]
        },
        {
          "id": "6943334",
          "text": "Sei già salito sul treno?",
          "translation": "Ты уже сел в поезд?",
          "source": "Tatoeba #6943334 @dnnywld / #6943314 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6943334",
          "cefr_level": "A1",
          "word_slugs": [
            "salito-verb"
          ]
        },
        {
          "id": "4140103",
          "text": "Dove sei salito sul treno?",
          "translation": "Где ты сел на поезд?",
          "source": "Tatoeba #4140103 @Guybrush88 / #4140217 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4140103",
          "cefr_level": "A1",
          "word_slugs": [
            "salito-verb"
          ]
        },
        {
          "id": "5404551",
          "text": "Tom è salito nuovamente in macchina.",
          "translation": "Том снова сел в машину.",
          "source": "Tatoeba #5404551 @dnnywld / #5404512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5404551",
          "cefr_level": "A1",
          "word_slugs": [
            "salito-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "salito",
        "plural": "",
