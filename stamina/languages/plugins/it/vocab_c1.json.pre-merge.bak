    {
      "slug": "distante-adj",
      "lemma": "distante",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7142,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5606733",
          "text": "È distante da Brno?",
          "translation": "Далеко ли до Брно?",
          "source": "Tatoeba #5606733 @dnnywld / #900109 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5606733",
          "cefr_level": "A1",
          "word_slugs": [
            "distante-adj"
          ]
        },
        {
          "id": "10989234",
          "text": "Loro abitano non distante da qui.",
          "translation": "Они тут недалеко живут.",
          "source": "Tatoeba #10989234 @dnnywld / #10987591 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10989234",
          "cefr_level": "A1",
          "word_slugs": [
            "distante-adj"
          ]
        },
        {
          "id": "5486431",
          "text": "Boston è molto distante da Chicago.",
          "translation": "До Бостона от Чикаго далеко.",
          "source": "Tatoeba #5486431 @dnnywld / #5485378 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5486431",
          "cefr_level": "A1",
          "word_slugs": [
            "distante-adj"
          ]
        },
        {
          "id": "410888",
          "text": "Il Sole è molto distante dalla Terra.",
          "translation": "Солнце очень далеко от Земли.",
          "source": "Tatoeba #410888 @shoras / #573418 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/410888",
          "cefr_level": "A1",
