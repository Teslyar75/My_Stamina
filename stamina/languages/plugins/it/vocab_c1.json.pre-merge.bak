    {
      "slug": "materiali-adj",
      "lemma": "materiali",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7996,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5601873",
          "text": "Preferisco i materiali semplici.",
          "translation": "Я предпочитаю простые материалы.",
          "source": "Tatoeba #5601873 @dnnywld / #5601462 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5601873",
          "cefr_level": "A1",
          "word_slugs": [
            "materiali-adj"
          ]
        },
        {
          "id": "2283567",
          "text": "Noi otteniamo i materiali dalla Malesia.",
          "translation": "Мы получаем материалы из Малайзии.",
          "source": "Tatoeba #2283567 @Guybrush88 / #652746 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2283567",
          "cefr_level": "A1",
          "word_slugs": [
            "materiali-adj"
          ]
        },
        {
          "id": "1386266",
          "text": "I materiali di costruzione sono costosi ora.",
          "translation": "Стройматериалы сейчас дороги.",
          "source": "Tatoeba #1386266 @Guybrush88 / #750991 @GranD (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1386266",
          "cefr_level": "A1",
          "word_slugs": [
            "materiali-adj"
          ]
        },
        {
          "id": "1386267",
          "text": "I materiali di costruzione sono costosi adesso.",
          "translation": "Стройматериалы сейчас дороги.",
          "source": "Tatoeba #1386267 @Guybrush88 / #750991 @GranD (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1386267",
          "cefr_level": "A1",
          "word_slugs": [
            "materiali-adj"
          ]
        },
        {
          "id": "3413798",
          "text": "I materiali di costruzione sono molto cari ora.",
          "translation": "Стройматериалы сейчас очень дорогие.",
          "source": "Tatoeba #3413798 @Guybrush88 / #3801302 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3413798",
          "cefr_level": "A1",
          "word_slugs": [
            "materiali-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il materiali",
        "plural": "",
        "infinitive": ""
      }
