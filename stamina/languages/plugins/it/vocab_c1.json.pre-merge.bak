    {
      "slug": "zucca-noun",
      "lemma": "zucca",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7837,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6879000",
          "text": "È un melone o una zucca?",
          "translation": "Это дыня или тыква?",
          "source": "Tatoeba #6879000 @dnnywld / #6878577 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879000",
          "cefr_level": "A1",
          "word_slugs": [
            "zucca-noun"
          ]
        },
        {
          "id": "7036069",
          "text": "Hai visto che zucca è cresciuta? Enorme!",
          "translation": "Ты видел, какая тыква выросла? Огромная!",
          "source": "Tatoeba #7036069 @dnnywld / #7035832 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7036069",
          "cefr_level": "A1",
          "word_slugs": [
            "zucca-noun"
          ]
        },
        {
          "id": "6329738",
          "text": "Voglio ripulire la zucca a questo ragazzino.",
          "translation": "Я хочу начистить этому парню репу.",
          "source": "Tatoeba #6329738 @dnnywld / #6329099 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6329738",
          "cefr_level": "A1",
          "word_slugs": [
            "zucca-noun"
          ]
        },
        {
          "id": "5565812",
          "text": "Tom ha vinto il concorso per l'intaglio della zucca.",
          "translation": "Том выиграл конкурс по вырезанию тыкв.",
          "source": "Tatoeba #5565812 @dnnywld / #5565174 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5565812",
          "cefr_level": "A1",
          "word_slugs": [
            "zucca-noun"
          ]
        },
        {
          "id": "5395622",
          "text": "A mezzanotte la carrozza di Cenerentola si trasformò in una zucca.",
          "translation": "В двенадцать часов карета Золушки превратилась в тыкву.",
          "source": "Tatoeba #5395622 @dnnywld / #5395445 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5395622",
          "cefr_level": "A1",
          "word_slugs": [
            "zucca-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la zucca",
        "plural": "",
        "infinitive": ""
      }
    },
