      "lemma": "riga",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6040,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "989799",
          "text": "Iniziamo dalla penultima riga.",
          "translation": "Давайте начнём с предпоследней строки.",
          "source": "Tatoeba #989799 @riccioberto / #443513 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/989799",
          "cefr_level": "A1",
          "word_slugs": [
