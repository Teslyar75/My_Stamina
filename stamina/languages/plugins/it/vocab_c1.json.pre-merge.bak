    {
      "slug": "irlanda-name",
      "lemma": "Irlanda",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8715,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1238431",
          "text": "Quanto mi manca l'Irlanda!",
          "translation": "Как я скучаю по Ирландии!",
          "source": "Tatoeba #1238431 @Guybrush88 / #3265380 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1238431",
          "cefr_level": "A1",
          "word_slugs": [
            "irlanda-name"
          ]
        },
        {
          "id": "2974611",
          "text": "Dublino è la capitale dell'Irlanda.",
          "translation": "Дублин — столица Ирландии.",
          "source": "Tatoeba #2974611 @Guybrush88 / #4520048 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2974611",
          "cefr_level": "A1",
          "word_slugs": [
            "irlanda-name"
          ]
        },
        {
          "id": "7600246",
          "text": "Non vanno a insegnare qualcosa in Irlanda?",
          "translation": "Они не едут преподавать что-нибудь в Ирландии?",
          "source": "Tatoeba #7600246 @Guybrush88 / #10136499 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7600246",
          "cefr_level": "A1",
          "word_slugs": [
            "irlanda-name"
          ]
        },
        {
          "id": "3025307",
          "text": "L'Inghilterra è militarmente più forte dell'Irlanda.",
          "translation": "Военная мощь Англии выше, чем у Ирландии.",
          "source": "Tatoeba #3025307 @Guybrush88 / #3801575 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3025307",
          "cefr_level": "A1",
          "word_slugs": [
            "irlanda-name"
          ]
        },
        {
          "id": "7605492",
          "text": "Non andiamo a fare carriera in Irlanda del Nord.",
          "translation": "Мы не едем делать карьеру в Северную Ирландию.",
          "source": "Tatoeba #7605492 @Guybrush88 / #10136449 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7605492",
          "cefr_level": "A1",
          "word_slugs": [
            "irlanda-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la Irlanda",
        "plural": "",
        "infinitive": ""
      }
