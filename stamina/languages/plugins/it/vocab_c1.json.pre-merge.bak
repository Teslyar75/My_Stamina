    {
      "slug": "dicembre-noun",
      "lemma": "dicembre",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6074,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "декабрь"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5683643",
          "text": "Oggi è martedì 13 dicembre.",
          "translation": "Сегодня вторник, тринадцатое декабря.",
          "source": "Tatoeba #5683643 @dnnywld / #5682309 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683643",
          "cefr_level": "A1",
          "word_slugs": [
            "dicembre-noun"
          ]
        },
        {
          "id": "5551672",
          "text": "Dicembre è il mese del Chanukkah.",
          "translation": "Декабрь — месяц Хануки.",
          "source": "Tatoeba #5551672 @dnnywld / #5551617 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551672",
          "cefr_level": "A1",
          "word_slugs": [
            "dicembre-noun"
          ]
        },
        {
          "id": "10883330",
          "text": "Il 24 Dicembre è la Vigilia di Natale.",
          "translation": "24 декабря - сочельник.",
          "source": "Tatoeba #10883330 @dnnywld / #3154379 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10883330",
          "cefr_level": "A1",
          "word_slugs": [
            "dicembre-noun"
          ]
        },
        {
          "id": "10752153",
          "text": "Quali tasse devo pagare entro il primo dicembre?",
          "translation": "Какие налоги я должен заплатить до 1 декабря?",
          "source": "Tatoeba #10752153 @dnnywld / #5513344 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10752153",
          "cefr_level": "A1",
          "word_slugs": [
            "dicembre-noun"
          ]
        },
        {
          "id": "5572729",
          "text": "Le festività Natalizie dureranno dal 31 dicembre all'8 gennaio.",
          "translation": "Новогодние праздники продлятся с 31 декабря по 8 января.",
          "source": "Tatoeba #5572729 @dnnywld / #5572555 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5572729",
          "cefr_level": "A1",
          "word_slugs": [
            "dicembre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il dicembre",
        "plural": "",
        "infinitive": ""
      }
    },
