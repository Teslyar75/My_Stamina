      "lemma": "battaglione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9664,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10851659",
          "text": "Il battaglione si è arreso al nemico.",
