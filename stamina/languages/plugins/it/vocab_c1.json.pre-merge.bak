    {
      "slug": "riunioni-noun",
      "lemma": "riunioni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5844,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6365429",
          "text": "Odio andare alle riunioni.",
          "translation": "Ненавижу ходить на планёрки.",
          "source": "Tatoeba #6365429 @dnnywld / #6179088 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6365429",
          "cefr_level": "A1",
          "word_slugs": [
            "riunioni-noun"
          ]
        },
        {
          "id": "6365419",
          "text": "Odio presenziare alle riunioni.",
          "translation": "Ненавижу сидеть на совещаниях.",
          "source": "Tatoeba #6365419 @dnnywld / #6179093 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6365419",
          "cefr_level": "A1",
          "word_slugs": [
            "riunioni-noun"
          ]
        },
        {
          "id": "5973508",
          "text": "Non ne posso più delle riunioni.",
          "translation": "Я сыт по горло собраниями.",
          "source": "Tatoeba #5973508 @dnnywld / #5973274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5973508",
          "cefr_level": "A1",
          "word_slugs": [
            "riunioni-noun"
          ]
        },
        {
          "id": "5643812",
          "text": "Lui raramente ritarda per le riunioni.",
          "translation": "Он редко опаздывает на собрания.",
          "source": "Tatoeba #5643812 @dnnywld / #5643709 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643812",
          "cefr_level": "A1",
          "word_slugs": [
            "riunioni-noun"
          ]
        },
        {
          "id": "5733948",
          "text": "Ho trovato uno scarafaggio morto nella sala riunioni.",
          "translation": "В зале заседаний я обнаружил дохлого таракана.",
          "source": "Tatoeba #5733948 @dnnywld / #5732104 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5733948",
          "cefr_level": "A1",
          "word_slugs": [
            "riunioni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il riunioni",
        "plural": "",
        "infinitive": ""
      }
