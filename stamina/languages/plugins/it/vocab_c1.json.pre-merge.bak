          "cefr_level": "A1",
          "word_slugs": [
            "norma-name"
          ]
        },
        {
          "id": "5647699",
          "text": "Di norma questo indicatore è inferiore all'unità.",
          "translation": "В норме этот показатель ниже единицы.",
