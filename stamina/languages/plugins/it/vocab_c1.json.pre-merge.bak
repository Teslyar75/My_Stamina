    {
      "slug": "indosso-adv",
      "lemma": "indosso",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5616,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2554122",
          "text": "Indosso dei boxer.",
          "translation": "Я ношу боксеры.",
          "source": "Tatoeba #2554122 @Guybrush88 / #5066318 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2554122",
          "cefr_level": "A1",
          "word_slugs": [
            "indosso-adv"
          ]
        },
        {
          "id": "11461201",
          "text": "Non indosso le mutande.",
          "translation": "На мне нет нижнего белья.",
          "source": "Tatoeba #11461201 @Bernie75 / #4640157 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11461201",
          "cefr_level": "A1",
          "word_slugs": [
            "indosso-adv"
          ]
        },
        {
          "id": "6978314",
          "text": "Indosso un vestito a fiori.",
          "translation": "Я ношу цветочное платье.",
          "source": "Tatoeba #6978314 @dnnywld / #3335808 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6978314",
          "cefr_level": "A1",
          "word_slugs": [
            "indosso-adv"
          ]
        },
        {
          "id": "5647477",
          "text": "Lei aveva indosso un kimono.",
          "translation": "На ней было кимоно.",
          "source": "Tatoeba #5647477 @dnnywld / #3575226 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647477",
          "cefr_level": "A1",
          "word_slugs": [
            "indosso-adv"
          ]
        },
        {
          "id": "6978323",
          "text": "Non indosso una cosa simile.",
          "translation": "Я такое не ношу.",
          "source": "Tatoeba #6978323 @dnnywld / #5471628 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6978323",
          "cefr_level": "A1",
          "word_slugs": [
