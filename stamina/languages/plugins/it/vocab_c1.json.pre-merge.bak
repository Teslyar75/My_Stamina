    {
      "slug": "eternità-noun",
      "lemma": "eternità",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8007,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10860310",
          "text": "Ci impiegherà un'eternità.",
          "translation": "Это займёт вечность.",
          "source": "Tatoeba #10860310 @dnnywld / #6915680 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10860310",
          "cefr_level": "A1",
          "word_slugs": [
            "eternità-noun"
          ]
        },
        {
          "id": "10860298",
          "text": "L'eternità è un lungo tempo.",
          "translation": "Вечность — это долго.",
          "source": "Tatoeba #10860298 @dnnywld / #4979848 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10860298",
          "cefr_level": "A1",
          "word_slugs": [
            "eternità-noun"
          ]
        },
        {
          "id": "10844068",
          "text": "Lei ha vissuto sola per un'eternità.",
          "translation": "Она целую вечность жила одна.",
          "source": "Tatoeba #10844068 @dnnywld / #10841790 @ChasCM (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844068",
          "cefr_level": "A1",
          "word_slugs": [
            "eternità-noun"
          ]
        },
        {
          "id": "12995057",
          "text": "Vuoi che ti aspetti fino all'eternità?",
          "translation": "Ты хочешь, чтобы я тебя до второго пришествия ждала?",
          "source": "Tatoeba #12995057 @dnnywld / #12993992 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12995057",
          "cefr_level": "A1",
          "word_slugs": [
            "eternità-noun"
          ]
        },
        {
          "id": "6770166",
          "text": "Vedete, nessuna sofferenza è per l'eternità.",
          "translation": "Поймите, что никакое страдание не вечно.",
          "source": "Tatoeba #6770166 @dnnywld / #6770073 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770166",
          "cefr_level": "A1",
          "word_slugs": [
            "eternità-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la eternità",
        "plural": "",
        "infinitive": ""
      }
    },
