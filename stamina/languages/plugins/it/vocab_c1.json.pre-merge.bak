      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3270352",
          "text": "Sei sempre la solita.",
          "translation": "Ты всё такая же.",
          "source": "Tatoeba #3270352 @Guybrush88 / #4624775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3270352",
          "cefr_level": "A1",
          "word_slugs": [
            "solita-adj"
          ]
        },
        {
          "id": "6845547",
          "text": "Siete sempre la solita.",
          "translation": "Вы всё такая же.",
          "source": "Tatoeba #6845547 @dnnywld / #4624778 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845547",
          "cefr_level": "A1",
          "word_slugs": [
            "solita-adj"
          ]
        },
        {
          "id": "6845560",
          "text": "Lei è sempre la solita.",
          "translation": "Она всё такая же.",
          "source": "Tatoeba #6845560 @dnnywld / #6622532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845560",
          "cefr_level": "A1",
          "word_slugs": [
            "solita-adj"
          ]
        },
        {
          "id": "6890130",
          "text": "Conduco la solita vita mediocre.",
          "translation": "Я веду обычную среднестатистическую жизнь.",
          "source": "Tatoeba #6890130 @dnnywld / #6171374 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6890130",
          "cefr_level": "A1",
          "word_slugs": [
            "solita-adj"
          ]
        },
        {
          "id": "5707451",
          "text": "Tom canticchia sempre la solita melodia.",
          "translation": "Том всегда напевает одну и ту же мелодию.",
          "source": "Tatoeba #5707451 @dnnywld / #5705544 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5707451",
