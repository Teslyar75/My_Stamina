          ]
        },
        {
          "id": "7247054",
          "text": "E voi chi vi ha chiamati qui?",
          "translation": "А вас кто сюда звал?",
          "source": "Tatoeba #7247054 @dnnywld / #7245028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7247054",
          "cefr_level": "A1",
          "word_slugs": [
            "chiamati-verb"
          ]
        },
        {
          "id": "5520356",
          "text": "Ecco perché vi ho chiamati al telefono.",
