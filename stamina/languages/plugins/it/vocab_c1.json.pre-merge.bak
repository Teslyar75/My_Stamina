    {
      "slug": "umanità-noun",
      "lemma": "umanità",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5005,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5835611",
          "text": "L'umanità è diventata più ricca.",
          "translation": "Человечество стало богаче.",
          "source": "Tatoeba #5835611 @dnnywld / #1881532 @Aleksander (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5835611",
          "cefr_level": "A1",
          "word_slugs": [
            "umanità-noun"
          ]
        },
        {
          "id": "5492343",
          "text": "Questo è un crimine contro l'umanità!",
          "translation": "Это преступление против человечности!",
          "source": "Tatoeba #5492343 @dnnywld / #4602369 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5492343",
          "cefr_level": "A1",
          "word_slugs": [
            "umanità-noun"
          ]
        },
        {
          "id": "10755280",
          "text": "L'umanità ha la memoria troppo corta.",
          "translation": "У человечества слишком короткая память.",
          "source": "Tatoeba #10755280 @dnnywld / #10754972 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10755280",
          "cefr_level": "A1",
          "word_slugs": [
            "umanità-noun"
          ]
        },
        {
          "id": "2692443",
          "text": "Voi siete l'ultima speranza per l'umanità.",
          "translation": "Вы последняя надежда человечества.",
          "source": "Tatoeba #2692443 @Guybrush88 / #1944699 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2692443",
          "cefr_level": "A1",
          "word_slugs": [
            "umanità-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
