          ]
        },
        {
          "id": "6884981",
          "text": "Dal tubo di scarico gocciola dell'acqua.",
          "translation": "Из водосточной трубы капает вода.",
          "source": "Tatoeba #6884981 @dnnywld / #6884048 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884981",
          "cefr_level": "A1",
          "word_slugs": [
            "scarico-adj"
          ]
        },
        {
          "id": "6884978",
          "text": "L'acqua piovana scorre dal tubo di scarico.",
          "translation": "Из водосточной трубы течёт дождевая вода.",
