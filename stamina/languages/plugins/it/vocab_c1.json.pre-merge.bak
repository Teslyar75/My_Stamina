    {
      "slug": "pesa-noun",
      "lemma": "pesa",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7455,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3857419",
          "text": "Pesa settanta chili.",
          "translation": "Он весит семьдесят килограммов.",
          "source": "Tatoeba #3857419 @Guybrush88 / #1791792 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3857419",
          "cefr_level": "A1",
          "word_slugs": [
            "pesa-noun"
          ]
        },
        {
          "id": "3857420",
          "text": "Lui pesa settanta chili.",
          "translation": "Он весит семьдесят килограммов.",
          "source": "Tatoeba #3857420 @Guybrush88 / #1791792 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3857420",
          "cefr_level": "A1",
          "word_slugs": [
            "pesa-noun"
          ]
        },
        {
          "id": "5524606",
          "text": "Lui pesa circa 140 chili.",
          "translation": "Он весит около трёхсот фунтов.",
          "source": "Tatoeba #5524606 @dnnywld / #5524592 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5524606",
          "cefr_level": "A1",
          "word_slugs": [
            "pesa-noun"
          ]
        },
        {
          "id": "5693883",
          "text": "Tom pesa più di Mary.",
          "translation": "Том весит больше, чем Мэри.",
          "source": "Tatoeba #5693883 @Guybrush88 / #10136418 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5693883",
          "cefr_level": "A1",
          "word_slugs": [
            "pesa-noun"
          ]
        },
        {
          "id": "5401225",
          "text": "Il tuo gatto pesa troppo.",
          "translation": "Твой кот слишком много весит.",
          "source": "Tatoeba #5401225 @dnnywld / #4998349 @al_lastor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5401225",
          "cefr_level": "A1",
          "word_slugs": [
            "pesa-noun"
          ]
        }
      ],
