    {
      "slug": "bottiglie-noun",
      "lemma": "bottiglie",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5605,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7789600",
          "text": "Dove ha messo le bottiglie?",
          "translation": "Куда она дела бутылки?",
          "source": "Tatoeba #7789600 @dnnywld / #7789243 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7789600",
          "cefr_level": "A1",
          "word_slugs": [
            "bottiglie-noun"
          ]
        },
        {
          "id": "5555782",
          "text": "Tom colleziona tappi di bottiglie.",
          "translation": "Том собирает крышки от бутылок.",
          "source": "Tatoeba #5555782 @dnnywld / #5554855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5555782",
          "cefr_level": "A1",
          "word_slugs": [
            "bottiglie-noun"
          ]
        },
        {
          "id": "6800206",
          "text": "Dove avete messo le mie bottiglie?",
          "translation": "Куда вы дели мои бутылки?",
          "source": "Tatoeba #6800206 @dnnywld / #6318877 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6800206",
          "cefr_level": "A1",
          "word_slugs": [
            "bottiglie-noun"
          ]
        },
        {
          "id": "707078",
          "text": "Hanno bevuto due bottiglie di vino.",
          "translation": "Они выпили две бутылки вина.",
          "source": "Tatoeba #707078 @Guybrush88 / #1587462 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/707078",
          "cefr_level": "A1",
          "word_slugs": [
            "bottiglie-noun"
          ]
        },
