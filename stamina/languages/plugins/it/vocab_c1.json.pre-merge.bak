          "cefr_level": "A1",
          "word_slugs": [
            "servivano-verb"
          ]
        },
        {
          "id": "5161284",
          "text": "Ero giovane e mi servivano i soldi.",
          "translation": "Я был молод, и мне нужны были деньги.",
          "source": "Tatoeba #5161284 @Guybrush88 / #3461981 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5161284",
