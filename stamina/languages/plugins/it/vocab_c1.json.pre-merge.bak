      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5212,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3383276",
          "text": "Aspettava l'autobus.",
          "translation": "Он ждал автобус.",
          "source": "Tatoeba #3383276 @Guybrush88 / #2831040 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3383276",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettava-verb"
          ]
        },
        {
          "id": "5403375",
          "text": "Tom aspettava fuori.",
          "translation": "Том ждал на улице.",
          "source": "Tatoeba #5403375 @Guybrush88 / #5690773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5403375",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettava-verb"
          ]
        },
        {
          "id": "3383288",
          "text": "Lui aspettava l'autobus.",
          "translation": "Он ждал автобус.",
          "source": "Tatoeba #3383288 @Guybrush88 / #2831040 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3383288",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettava-verb"
          ]
        },
        {
          "id": "389715",
          "text": "L'avvocato aspettava Ben.",
          "translation": "Адвокат ждал Бена.",
          "source": "Tatoeba #389715 @Pharamp / #389916 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/389715",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettava-verb"
          ]
        },
        {
          "id": "5700882",
          "text": "Tom non aspettava nessuno.",
          "translation": "Том никого не ждал.",
          "source": "Tatoeba #5700882 @dnnywld / #5699909 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5700882",
          "cefr_level": "A1",
          "word_slugs": [
            "aspettava-verb"
          ]
        }
      ],
      "tags": [
