    {
      "slug": "osservare-verb",
      "lemma": "osservare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6092,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5484139",
          "text": "Devi osservare la dieta.",
          "translation": "Тебе нужно соблюдать диету.",
          "source": "Tatoeba #5484139 @dnnywld / #5483926 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5484139",
          "cefr_level": "A1",
          "word_slugs": [
            "osservare-verb"
          ]
        },
        {
          "id": "6558190",
          "text": "Amo osservare gli uccelli.",
          "translation": "Я люблю наблюдать за птицами.",
          "source": "Tatoeba #6558190 @Guybrush88 / #5531479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6558190",
          "cefr_level": "A1",
          "word_slugs": [
            "osservare-verb"
          ]
        },
        {
          "id": "6558191",
          "text": "Io amo osservare gli uccelli.",
          "translation": "Я люблю наблюдать за птицами.",
          "source": "Tatoeba #6558191 @Guybrush88 / #5531479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6558191",
          "cefr_level": "A1",
          "word_slugs": [
            "osservare-verb"
          ]
        },
        {
          "id": "2728451",
          "text": "Mi piace osservare gli uccelli.",
          "translation": "Мне нравится смотреть на птиц.",
          "source": "Tatoeba #2728451 @Guybrush88 / #1336599 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2728451",
          "cefr_level": "A1",
          "word_slugs": [
            "osservare-verb"
          ]
        },
        {
          "id": "2728477",
          "text": "A Mary piace osservare gli uccelli.",
          "translation": "Марии нравится наблюдать за птицами.",
          "source": "Tatoeba #2728477 @Guybrush88 / #3346912 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2728477",
          "cefr_level": "A1",
          "word_slugs": [
            "osservare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
