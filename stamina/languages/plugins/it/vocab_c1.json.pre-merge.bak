    {
      "slug": "dimenticate-verb",
      "lemma": "dimenticate",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7188,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7434289",
          "text": "Non dimenticate di dirglielo.",
          "translation": "Не забудьте сказать это ей.",
          "source": "Tatoeba #7434289 @dnnywld / #7433945 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7434289",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticate-verb"
          ]
        },
        {
          "id": "6852999",
          "text": "Non dimenticate, avete promesso.",
          "translation": "Не забудьте, вы обещали.",
          "source": "Tatoeba #6852999 @dnnywld / #6852364 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6852999",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticate-verb"
          ]
        },
        {
          "id": "5624175",
          "text": "Non dimenticate i vostri amici.",
          "translation": "Не забывайте своих друзей.",
          "source": "Tatoeba #5624175 @dnnywld / #5624098 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624175",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticate-verb"
          ]
        },
        {
          "id": "5499930",
          "text": "Non dimenticate di pagare l'affitto.",
          "translation": "Не забудьте заплатить за квартиру.",
          "source": "Tatoeba #5499930 @dnnywld / #4119246 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499930",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticate-verb"
          ]
        },
        {
          "id": "7310717",
          "text": "Non dimenticate di mettere l'accento!",
          "translation": "Не забудьте указать ударение!",
          "source": "Tatoeba #7310717 @dnnywld / #7310544 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7310717",
          "cefr_level": "A1",
          "word_slugs": [
            "dimenticate-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
