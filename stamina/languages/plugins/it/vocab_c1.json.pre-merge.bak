      "frequency_rank": 6925,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3857908",
          "text": "Non li ricevo.",
          "translation": "Я их не получаю.",
          "source": "Tatoeba #3857908 @Guybrush88 / #2759480 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3857908",
          "cefr_level": "A1",
          "word_slugs": [
            "ricevo-verb"
          ]
        },
        {
          "id": "5845485",
          "text": "Ricevo molte lamentele.",
          "translation": "Я получаю много жалоб.",
          "source": "Tatoeba #5845485 @dnnywld / #4746824 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845485",
          "cefr_level": "A1",
          "word_slugs": [
            "ricevo-verb"
          ]
        },
        {
          "id": "5846073",
          "text": "Spesso ricevo lettere da lui.",
          "translation": "Я часто получаю письма от него.",
          "source": "Tatoeba #5846073 @dnnywld / #1345944 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846073",
          "cefr_level": "A1",
          "word_slugs": [
            "ricevo-verb"
          ]
        },
        {
          "id": "5846074",
          "text": "Spesso ricevo lettere da lei.",
          "translation": "Я часто получаю письма от нее.",
          "source": "Tatoeba #5846074 @dnnywld / #1346418 @Eldad (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846074",
          "cefr_level": "A1",
          "word_slugs": [
            "ricevo-verb"
          ]
        },
        {
          "id": "5846084",
          "text": "Ricevo informazioni da diverse fonti.",
