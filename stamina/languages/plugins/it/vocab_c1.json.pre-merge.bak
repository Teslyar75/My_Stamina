    {
      "slug": "riva-noun",
      "lemma": "riva",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6566,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5681331",
          "text": "Vivo in riva al mare.",
          "translation": "Я живу у моря.",
          "source": "Tatoeba #5681331 @dnnywld / #5681326 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5681331",
          "cefr_level": "A1",
          "word_slugs": [
            "riva-noun"
          ]
        },
        {
          "id": "5625914",
          "text": "La nave era diretta alla riva.",
          "translation": "Корабль направился к берегу.",
          "source": "Tatoeba #5625914 @dnnywld / #2217701 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5625914",
          "cefr_level": "A1",
          "word_slugs": [
            "riva-noun"
          ]
        },
        {
          "id": "1135800",
          "text": "Ha una villa in riva al mare.",
          "translation": "У него есть вилла на берегу моря.",
          "source": "Tatoeba #1135800 @riccioberto / #3075517 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1135800",
          "cefr_level": "A1",
          "word_slugs": [
            "riva-noun"
          ]
        },
        {
          "id": "6857299",
          "text": "Quando vivevo in riva al mare, nuovato molto.",
          "translation": "Когда я жил на берегу моря, я много купался.",
          "source": "Tatoeba #6857299 @dnnywld / #6810155 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6857299",
          "cefr_level": "A1",
          "word_slugs": [
            "riva-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
