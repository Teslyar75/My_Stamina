    {
      "slug": "scoprirai-verb",
      "lemma": "scoprirai",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8667,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7738083",
          "text": "Col tempo scoprirai tutto.",
          "translation": "В своё время всё узнаешь.",
          "source": "Tatoeba #7738083 @dnnywld / #7731282 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7738083",
          "cefr_level": "A1",
          "word_slugs": [
            "scoprirai-verb"
          ]
        },
        {
          "id": "5665650",
          "text": "Scoprirai più tardi i dettagli.",
          "translation": "Подробности ты узнаешь позже.",
          "source": "Tatoeba #5665650 @dnnywld / #5665442 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5665650",
          "cefr_level": "A1",
          "word_slugs": [
            "scoprirai-verb"
          ]
        },
        {
          "id": "6897140",
          "text": "Su questo articolo scoprirai come tradurre l'intraducibile.",
          "translation": "Из этой статьи ты узнаешь, как переводить непереводимое.",
          "source": "Tatoeba #6897140 @dnnywld / #3900282 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6897140",
          "cefr_level": "A1",
