          "word_slugs": [
            "rio-noun"
          ]
        },
        {
          "id": "7053244",
          "text": "Vengo da Rio.",
          "translation": "Я из Рио.",
          "source": "Tatoeba #7053244 @dnnywld / #7053186 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7053244",
          "cefr_level": "A1",
          "word_slugs": [
            "rio-noun"
          ]
        },
        {
          "id": "5646662",
          "text": "A Rio fa sempre molto caldo.",
          "translation": "В Рио обычно очень жарко.",
          "source": "Tatoeba #5646662 @dnnywld / #5646492 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646662",
          "cefr_level": "A1",
          "word_slugs": [
            "rio-noun"
          ]
        },
        {
          "id": "7053240",
          "text": "Cosa pensi di Rio de Janeiro?",
          "translation": "Что ты думаешь о Рио-де-Жанейро?",
          "source": "Tatoeba #7053240 @dnnywld / #7053190 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7053240",
          "cefr_level": "A1",
          "word_slugs": [
            "rio-noun"
          ]
        },
        {
          "id": "5566543",
          "text": "No, questa non è Rio de Janeiro.",
          "translation": "Нет, это не Рио-де-Жанейро.",
          "source": "Tatoeba #5566543 @dnnywld / #5566161 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5566543",
          "cefr_level": "A1",
          "word_slugs": [
            "rio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
