    {
      "slug": "sporchi-adj",
      "lemma": "sporchi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5725,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5469308",
          "text": "I piatti sono sporchi.",
          "translation": "Тарелки грязные.",
          "source": "Tatoeba #5469308 @dnnywld / #5468983 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5469308",
          "cefr_level": "A1",
          "word_slugs": [
            "sporchi-adj"
          ]
        },
        {
          "id": "5563944",
          "text": "Questi occhiali sono sporchi.",
          "translation": "Эти очки грязные.",
          "source": "Tatoeba #5563944 @dnnywld / #5563648 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5563944",
          "cefr_level": "A1",
          "word_slugs": [
            "sporchi-adj"
          ]
        },
        {
          "id": "5562982",
          "text": "Questi pantaloni sono sporchi.",
          "translation": "Эти штаны грязные.",
          "source": "Tatoeba #5562982 @dnnywld / #5561030 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5562982",
          "cefr_level": "A1",
          "word_slugs": [
            "sporchi-adj"
          ]
        },
        {
          "id": "5544932",
          "text": "Lui ha i piedi sporchi.",
          "translation": "У него грязные ноги.",
          "source": "Tatoeba #5544932 @dnnywld / #5543703 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5544932",
          "cefr_level": "A1",
          "word_slugs": [
            "sporchi-adj"
          ]
        },
        {
          "id": "5506787",
          "text": "Tom ha i vestiti sporchi.",
          "translation": "У Тома грязная одежда.",
          "source": "Tatoeba #5506787 @dnnywld / #5505770 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506787",
          "cefr_level": "A1",
          "word_slugs": [
            "sporchi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
