      "cefr_level": "C1",
      "frequency_rank": 9537,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13102510",
          "text": "Se sapessi cosa fare, non vi chiederei.",
          "translation": "Если бы я знал, что делать, я бы вас не спрашивал.",
