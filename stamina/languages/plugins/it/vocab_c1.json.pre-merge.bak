    {
      "slug": "fareste-verb",
      "lemma": "fareste",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8211,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6765886",
          "text": "Fareste questo per Tom?",
          "translation": "Вы бы сделали это для Тома?",
          "source": "Tatoeba #6765886 @dnnywld / #6765237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6765886",
          "cefr_level": "A1",
          "word_slugs": [
            "fareste-verb"
          ]
        },
        {
          "id": "6374047",
          "text": "Se succedesse questo, cosa fareste?",
          "translation": "Что вы будете делать, если это случится?",
          "source": "Tatoeba #6374047 @dnnywld / #6373567 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6374047",
          "cefr_level": "A1",
          "word_slugs": [
            "fareste-verb"
          ]
        },
        {
          "id": "5586980",
          "text": "Cosa fareste se vi trovaste nei miei panni?",
          "translation": "Что бы вы сделали, окажись вы в моей шкуре?",
          "source": "Tatoeba #5586980 @dnnywld / #5586838 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586980",
          "cefr_level": "A1",
          "word_slugs": [
            "fareste-verb"
          ]
        },
        {
          "id": "10755855",
          "text": "Vorrei vedere cosa fareste voi in una simile situazione.",
          "translation": "Я бы посмотрел, что бы вы стали делать в такой ситуации.",
          "source": "Tatoeba #10755855 @dnnywld / #6622637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10755855",
          "cefr_level": "A1",
          "word_slugs": [
            "fareste-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "fareste",
        "plural": "",
        "infinitive": "fareste"
      }
    },
    {
      "slug": "udito-adj",
      "lemma": "udito",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8212,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11469400",
          "text": "Tom è tutto udito",
          "translation": "Том весь обратился в слух.",
          "source": "Tatoeba #11469400 @Bernie75 / #3472240 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11469400",
          "cefr_level": "A1",
          "word_slugs": [
            "udito-adj"
          ]
        },
        {
          "id": "5691560",
          "text": "Il suo cane ha un cattivo udito.",
          "translation": "Его собака плохо слышит.",
          "source": "Tatoeba #5691560 @dnnywld / #5691515 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5691560",
          "cefr_level": "A1",
          "word_slugs": [
            "udito-adj"
          ]
        },
        {
          "id": "7274503",
          "text": "Il mio udito non è più quello di un tempo.",
          "translation": "Слух у меня уже не тот, что прежде.",
          "source": "Tatoeba #7274503 @dnnywld / #7274324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7274503",
          "cefr_level": "A1",
          "word_slugs": [
            "udito-adj"
          ]
        },
        {
          "id": "7274505",
          "text": "L'udito di Tom non è più quello di un tempo.",
          "translation": "Слух у Тома уже не тот, что прежде.",
