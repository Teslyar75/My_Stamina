          ]
        },
        {
          "id": "5419439",
          "text": "Il prezzo non comprende l'IVA.",
          "translation": "Цена не включает НДС.",
          "source": "Tatoeba #5419439 @dnnywld / #2791709 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419439",
          "cefr_level": "A1",
          "word_slugs": [
            "comprende-verb"
          ]
        },
        {
          "id": "5419441",
          "text": "Il prezzo comprende le spese di spedizione.",
          "translation": "Цена включает почтовые расходы.",
          "source": "Tatoeba #5419441 @dnnywld / #4650615 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419441",
          "cefr_level": "A1",
          "word_slugs": [
            "comprende-verb"
          ]
        },
        {
          "id": "5449986",
          "text": "La storia dell'impero Bizantino comprende 1058 anni.",
          "translation": "История Византийской империи насчитывает 1058 лет.",
