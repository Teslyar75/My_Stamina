      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5571103",
          "text": "Preghiamo perché questo non succeda più.",
          "translation": "Давайте помолимся, чтобы этого больше не случилось.",
          "source": "Tatoeba #5571103 @dnnywld / #5570743 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571103",
          "cefr_level": "A1",
          "word_slugs": [
            "preghiamo-verb"
          ]
        },
        {
          "id": "6852858",
          "text": "Vi preghiamo di allacciare le cinture di sicurezza!",
          "translation": "Просим вас пристегнуть ремни!",
          "source": "Tatoeba #6852858 @dnnywld / #6852545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6852858",
          "cefr_level": "A1",
          "word_slugs": [
            "preghiamo-verb"
          ]
        }
      ],
      "tags": [
