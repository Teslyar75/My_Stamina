      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3403691",
          "text": "Tom era scortese.",
          "translation": "Том был неприветлив.",
          "source": "Tatoeba #3403691 @Guybrush88 / #5677505 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3403691",
          "cefr_level": "A1",
          "word_slugs": [
            "scortese-noun"
          ]
        },
        {
          "id": "5550714",
          "text": "Questo sarebbe scortese.",
          "translation": "Это было бы грубо.",
          "source": "Tatoeba #5550714 @dnnywld / #5550472 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5550714",
          "cefr_level": "A1",
          "word_slugs": [
            "scortese-noun"
          ]
        },
        {
          "id": "3403533",
          "text": "Tom è molto scortese.",
