    {
      "slug": "bancarotta-noun",
      "lemma": "bancarotta",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8899,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10878765",
          "text": "Siamo prossimi alla bancarotta.",
          "translation": "Мы на грани банкротства.",
          "source": "Tatoeba #10878765 @dnnywld / #2345019 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878765",
          "cefr_level": "A1",
          "word_slugs": [
            "bancarotta-noun"
          ]
        },
        {
          "id": "2512405",
          "text": "Quel negozio è andato in bancarotta.",
          "translation": "Тот магазин обанкротился.",
          "source": "Tatoeba #2512405 @Guybrush88 / #5654501 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2512405",
          "cefr_level": "A1",
          "word_slugs": [
            "bancarotta-noun"
          ]
        },
        {
          "id": "10851636",
          "text": "Di fatto, la bancarotta è inevitabile.",
          "translation": "Фактически, банкротство неизбежно.",
          "source": "Tatoeba #10851636 @dnnywld / #4542517 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851636",
          "cefr_level": "A1",
          "word_slugs": [
            "bancarotta-noun"
          ]
        },
        {
          "id": "2335211",
          "text": "Cipro lotta contro la minaccia di bancarotta nazionale.",
          "translation": "Кипр борется против угрозы национального банкротства.",
          "source": "Tatoeba #2335211 @al_ex_an_der / #2335205 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2335211",
          "cefr_level": "A1",
          "word_slugs": [
            "bancarotta-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
