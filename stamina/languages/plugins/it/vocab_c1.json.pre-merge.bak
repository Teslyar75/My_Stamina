          ]
        },
        {
          "id": "5614361",
          "text": "Lui è solamente un poeta.",
          "translation": "Он - всего лишь поэт.",
          "source": "Tatoeba #5614361 @dnnywld / #710659 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614361",
          "cefr_level": "A1",
