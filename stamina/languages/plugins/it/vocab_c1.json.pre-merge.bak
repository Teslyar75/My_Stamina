      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5532911",
          "text": "Tom è sceso nel seminterrato.",
          "translation": "Том спустился в подвал.",
          "source": "Tatoeba #5532911 @dnnywld / #5532890 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5532911",
