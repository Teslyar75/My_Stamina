    {
      "slug": "distratto-adj",
      "lemma": "distratto",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7608,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6161823",
          "text": "A lezione Tom è distratto.",
          "translation": "На уроках Том невнимателен.",
          "source": "Tatoeba #6161823 @dnnywld / #6161788 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6161823",
          "cefr_level": "A1",
          "word_slugs": [
            "distratto-adj"
          ]
        },
        {
          "id": "6967746",
          "text": "Ogni tanto sono un po' distratto.",
          "translation": "Я иногда бываю немного рассеян.",
          "source": "Tatoeba #6967746 @dnnywld / #5934675 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6967746",
          "cefr_level": "A1",
          "word_slugs": [
            "distratto-adj"
          ]
        },
        {
          "id": "5448061",
          "text": "È un bambino così distratto da commettere spesso errori.",
          "translation": "Он такой невнимательный мальчик, что часто делает ошибки.",
          "source": "Tatoeba #5448061 @dnnywld / #416032 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5448061",
          "cefr_level": "A1",
          "word_slugs": [
            "distratto-adj"
          ]
        },
        {
          "id": "5620825",
          "text": "Ero distratto e per errore sono salito sull'autobus sbagliato.",
          "translation": "Я был невнимателен и по ошибке сел в не тот автобус.",
          "source": "Tatoeba #5620825 @dnnywld / #447330 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5620825",
          "cefr_level": "A1",
          "word_slugs": [
            "distratto-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il distratto",
        "plural": "",
        "infinitive": ""
      }
