    {
      "slug": "andassi-verb",
      "lemma": "andassi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5465,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4142979",
          "text": "Vorresti che me ne andassi?",
          "translation": "Хочешь, чтобы я ушёл?",
          "source": "Tatoeba #4142979 @Guybrush88 / #2110290 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4142979",
          "cefr_level": "A1",
          "word_slugs": [
            "andassi-verb"
          ]
        },
        {
          "id": "6842123",
          "text": "Era ora che tu andassi a dormire.",
          "translation": "Тебе давно пора идти спать.",
          "source": "Tatoeba #6842123 @dnnywld / #4212506 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6842123",
          "cefr_level": "A1",
          "word_slugs": [
            "andassi-verb"
          ]
        },
        {
          "id": "6842116",
          "text": "Era ora che andassi a dormire, Ken.",
          "translation": "Тебе давно пора спать, Кен.",
          "source": "Tatoeba #6842116 @dnnywld / #1678238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6842116",
          "cefr_level": "A1",
          "word_slugs": [
            "andassi-verb"
          ]
        },
        {
          "id": "6799434",
          "text": "Perché Tom voleva che te ne andassi?",
          "translation": "Почему Том хотел, чтобы ты ушёл?",
          "source": "Tatoeba #6799434 @dnnywld / #6798913 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799434",
          "cefr_level": "A1",
          "word_slugs": [
            "andassi-verb"
          ]
        },
        {
          "id": "7633824",
          "text": "Tom non voleva che andassi in Australia.",
          "translation": "Том не хотел, чтобы я ехал в Австралию.",
          "source": "Tatoeba #7633824 @dnnywld / #7633522 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7633824",
          "cefr_level": "A1",
          "word_slugs": [
            "andassi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "andassi",
        "plural": "",
        "infinitive": "andassi"
      }
    },
    {
