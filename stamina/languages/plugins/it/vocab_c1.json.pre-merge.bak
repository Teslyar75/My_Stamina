    {
      "slug": "divorziato-noun",
      "lemma": "divorziato",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5814,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5687543",
          "text": "Lui ha divorziato due anni fa.",
          "translation": "Он развёлся два года назад.",
          "source": "Tatoeba #5687543 @dnnywld / #2694395 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5687543",
          "cefr_level": "A1",
          "word_slugs": [
            "divorziato-noun"
          ]
        },
        {
          "id": "6847081",
          "text": "Io e Tom abbiamo divorziato nel 2013.",
          "translation": "Мы с Томом развелись в две тысячи тринадцатом.",
          "source": "Tatoeba #6847081 @dnnywld / #6846467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6847081",
          "cefr_level": "A1",
          "word_slugs": [
            "divorziato-noun"
          ]
        },
        {
          "id": "6878039",
          "text": "Davvero pensi che Tom sia divorziato?",
          "translation": "Ты правда думаешь, что Том разведён?",
          "source": "Tatoeba #6878039 @dnnywld / #6878003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6878039",
          "cefr_level": "A1",
          "word_slugs": [
            "divorziato-noun"
          ]
        },
        {
          "id": "6878038",
          "text": "Davvero pensate che Tom sia divorziato?",
          "translation": "Вы действительно думаете, что Том разведён?",
          "source": "Tatoeba #6878038 @dnnywld / #6878004 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6878038",
          "cefr_level": "A1",
          "word_slugs": [
            "divorziato-noun"
          ]
        },
        {
          "id": "5512204",
          "text": "Tom beve molto da quando ha divorziato.",
          "translation": "Том здорово пьёт, с тех пор как развёлся.",
          "source": "Tatoeba #5512204 @dnnywld / #4909835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512204",
          "cefr_level": "A1",
          "word_slugs": [
