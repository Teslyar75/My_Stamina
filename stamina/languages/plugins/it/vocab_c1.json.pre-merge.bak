      "cefr_level": "C1",
      "frequency_rank": 8103,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6799739",
          "text": "Ho superato l'esame senza preparazione.",
          "translation": "Я сдал экзамен без подготовки.",
          "source": "Tatoeba #6799739 @dnnywld / #6590452 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799739",
          "cefr_level": "A1",
          "word_slugs": [
            "preparazione-noun"
          ]
        },
        {
          "id": "6810180",
          "text": "La preparazione per la festa è in pieno svolgimento.",
          "translation": "Полным ходом идёт подготовка к празднику.",
          "source": "Tatoeba #6810180 @dnnywld / #6807737 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6810180",
          "cefr_level": "A1",
          "word_slugs": [
            "preparazione-noun"
          ]
        },
        {
          "id": "5647691",
          "text": "La preparazione per il seminario richiede molto tempo e tanta fatica.",
          "translation": "Подготовка к семинару требует много времени и труда.",
          "source": "Tatoeba #5647691 @dnnywld / #5647603 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647691",
          "cefr_level": "A1",
          "word_slugs": [
            "preparazione-noun"
          ]
        }
      ],
      "tags": [
