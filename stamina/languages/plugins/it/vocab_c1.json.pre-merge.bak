      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12383824",
          "text": "Ogni giorno, il prezzo del petrolio aumenta.",
          "translation": "Каждый день повышается цена на нефть.",
          "source": "Tatoeba #12383824 @Bernie75 / #12383820 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12383824",
          "cefr_level": "A1",
          "word_slugs": [
            "aumenta-verb"
          ]
        },
        {
          "id": "7003026",
          "text": "Ad ogni minuto il nostro passato aumenta, e il nostro futuro diminuisce.",
          "translation": "С каждой минутой у нас всё больше прошлого и всё меньше будущего.",
          "source": "Tatoeba #7003026 @dnnywld / #6932029 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7003026",
          "cefr_level": "A1",
          "word_slugs": [
