          "cefr_level": "A1",
          "word_slugs": [
            "peggiorare-verb"
          ]
        },
        {
          "id": "5419293",
          "text": "Le cose possono solo peggiorare.",
          "translation": "Всё становится только хуже.",
          "source": "Tatoeba #5419293 @dnnywld / #2143187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419293",
