          ]
        },
        {
          "id": "1647800",
          "text": "I frutti contengono dei semi.",
          "translation": "В плодах находятся семена.",
          "source": "Tatoeba #1647800 @Guybrush88 / #3565533 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1647800",
          "cefr_level": "A1",
          "word_slugs": [
            "semi-noun"
          ]
        },
        {
          "id": "5884422",
          "text": "I gatti radioattivi hanno 18 semi-vite?",
          "translation": "У радиоактивных кошек 18 полураспадов?",
          "source": "Tatoeba #5884422 @dnnywld / #5884372 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5884422",
          "cefr_level": "A1",
          "word_slugs": [
            "semi-noun"
          ]
        },
        {
          "id": "5388422",
          "text": "I semi di questo albero sono gialli.",
          "translation": "Семена этого дерева жёлтые.",
          "source": "Tatoeba #5388422 @dnnywld / #5381997 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388422",
          "cefr_level": "A1",
          "word_slugs": [
            "semi-noun"
          ]
        },
        {
          "id": "6934066",
          "text": "Coprite i semi con un po' di terra.",
          "translation": "Покройте семена небольшим количеством земли.",
          "source": "Tatoeba #6934066 @dnnywld / #1601559 @mutternoise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6934066",
          "cefr_level": "A1",
