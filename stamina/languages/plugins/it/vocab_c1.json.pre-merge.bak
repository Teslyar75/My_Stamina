          "cefr_level": "A1",
          "word_slugs": [
            "capra-noun"
          ]
        },
        {
          "id": "6878999",
          "text": "È latte di capra o di mucca?",
          "translation": "Это козье молоко или коровье?",
          "source": "Tatoeba #6878999 @dnnywld / #6878580 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6878999",
          "cefr_level": "A1",
