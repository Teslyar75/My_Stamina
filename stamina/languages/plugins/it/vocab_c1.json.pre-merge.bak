      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5536813",
          "text": "Non siamo scappati.",
          "translation": "Мы не убежали.",
          "source": "Tatoeba #5536813 @dnnywld / #5536513 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5536813",
          "cefr_level": "A1",
