    {
      "slug": "spaventati-adj",
      "lemma": "spaventati",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7667,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4000395",
          "text": "Tom ci ha spaventati.",
          "translation": "Том нас напугал.",
          "source": "Tatoeba #4000395 @Guybrush88 / #5883863 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4000395",
          "cefr_level": "A1",
          "word_slugs": [
            "spaventati-adj"
          ]
        },
        {
          "id": "5594280",
          "text": "Ci siamo spaventati tutti.",
          "translation": "Мы все перепугались.",
          "source": "Tatoeba #5594280 @dnnywld / #5594177 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5594280",
          "cefr_level": "A1",
          "word_slugs": [
            "spaventati-adj"
          ]
        },
        {
          "id": "5470370",
          "text": "Tutti loro erano spaventati.",
          "translation": "Все они были напуганы.",
          "source": "Tatoeba #5470370 @dnnywld / #5470361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5470370",
          "cefr_level": "A1",
          "word_slugs": [
            "spaventati-adj"
          ]
        },
        {
          "id": "5386887",
          "text": "Tom e Mary erano spaventati.",
          "translation": "Том и Мэри были напуганы.",
          "source": "Tatoeba #5386887 @dnnywld / #5385753 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5386887",
          "cefr_level": "A1",
          "word_slugs": [
            "spaventati-adj"
          ]
        },
        {
          "id": "6798503",
          "text": "Loro erano spaventati dalla tempesta.",
          "translation": "Они были напуганы грозой.",
          "source": "Tatoeba #6798503 @dnnywld / #6794003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6798503",
