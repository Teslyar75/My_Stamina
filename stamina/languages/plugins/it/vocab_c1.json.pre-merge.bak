    {
      "slug": "diranno-verb",
      "lemma": "diranno",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6006,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5402430",
          "text": "Ti diranno dove sederti.",
          "translation": "Тебе скажут, куда сесть.",
          "source": "Tatoeba #5402430 @dnnywld / #3717986 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5402430",
          "cefr_level": "A1",
          "word_slugs": [
            "diranno-verb"
          ]
        },
        {
          "id": "4220905",
          "text": "Ora vi diranno la verità.",
          "translation": "Теперь они скажут вам правду.",
          "source": "Tatoeba #4220905 @Guybrush88 / #5396213 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4220905",
          "cefr_level": "A1",
          "word_slugs": [
            "diranno-verb"
          ]
        },
        {
          "id": "6845167",
          "text": "Loro non mi diranno niente.",
          "translation": "Они мне ничего не скажут.",
          "source": "Tatoeba #6845167 @dnnywld / #6844990 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845167",
          "cefr_level": "A1",
          "word_slugs": [
            "diranno-verb"
          ]
        },
        {
          "id": "10852226",
          "text": "Chiederò agli altri madrelingua e vediamo cosa diranno.",
          "translation": "Я спрошу у других носителей языка - посмотрим, что они скажут.",
          "source": "Tatoeba #10852226 @dnnywld / #10851974 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10852226",
          "cefr_level": "A1",
          "word_slugs": [
            "diranno-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "diranno",
        "plural": "",
        "infinitive": "diranno"
      }
