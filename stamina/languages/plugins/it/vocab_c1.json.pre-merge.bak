          ]
        },
        {
          "id": "5510994",
          "text": "Separa i tuorli dagli albumi prima di sbattere le uova.",
          "translation": "Отдели желтки от белков, перед тем как взбить яйца.",
          "source": "Tatoeba #5510994 @dnnywld / #5510514 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510994",
          "cefr_level": "A1",
          "word_slugs": [
            "sbattere-verb"
          ]
        }
      ],
