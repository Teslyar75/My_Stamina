    {
      "slug": "sosta-noun",
      "lemma": "sosta",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6799,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6673198",
          "text": "Nevicava senza sosta.",
          "translation": "Снег шёл без остановки.",
          "source": "Tatoeba #6673198 @dnnywld / #6673035 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6673198",
          "cefr_level": "A1",
          "word_slugs": [
            "sosta-noun"
          ]
        },
        {
          "id": "5658836",
          "text": "Ti contraddici senza sosta.",
          "translation": "Ты без конца себе противоречишь.",
          "source": "Tatoeba #5658836 @dnnywld / #5658578 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5658836",
          "cefr_level": "A1",
          "word_slugs": [
            "sosta-noun"
          ]
        },
        {
          "id": "6673200",
          "text": "La neve scendeva senza sosta.",
          "translation": "Снег падал без остановки.",
          "source": "Tatoeba #6673200 @dnnywld / #6673033 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6673200",
          "cefr_level": "A1",
          "word_slugs": [
            "sosta-noun"
          ]
        },
        {
          "id": "6628453",
          "text": "La sosta nel tunnel è vietata.",
          "translation": "Остановка в тоннеле запрещена.",
          "source": "Tatoeba #6628453 @dnnywld / #6628050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6628453",
          "cefr_level": "A1",
          "word_slugs": [
            "sosta-noun"
          ]
        },
        {
          "id": "6852982",
          "text": "Ho corso senza sosta fino a casa mia.",
          "translation": "Я бежал без передышки до самого дома.",
          "source": "Tatoeba #6852982 @dnnywld / #6852500 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6852982",
          "cefr_level": "A1",
          "word_slugs": [
            "sosta-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la sosta",
        "plural": "",
        "infinitive": ""
      }
    },
