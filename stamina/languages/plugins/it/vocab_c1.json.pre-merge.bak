    {
      "slug": "mortali-noun",
      "lemma": "mortali",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7677,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6302422",
          "text": "Gli umani sono mortali?",
          "translation": "Люди смертны?",
          "source": "Tatoeba #6302422 @dnnywld / #3326985 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6302422",
          "cefr_level": "A1",
          "word_slugs": [
            "mortali-noun"
          ]
        },
        {
          "id": "5652321",
          "text": "Gli incidenti mortali sono frequenti.",
          "translation": "Часты смертельные случаи.",
          "source": "Tatoeba #5652321 @dnnywld / #5651534 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652321",
          "cefr_level": "A1",
          "word_slugs": [
            "mortali-noun"
          ]
        },
        {
          "id": "5433011",
          "text": "Tutte le persone in questa Terra sono mortali.",
          "translation": "Все люди на этой Земле смертны.",
          "source": "Tatoeba #5433011 @dnnywld / #5432084 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433011",
          "cefr_level": "A1",
          "word_slugs": [
            "mortali-noun"
          ]
        },
        {
          "id": "4425751",
          "text": "Ravenna custodisce le spoglie mortali di Dante, il sommo poeta.",
          "translation": "Равенна хранит останки Данте, величайшего поэта.",
          "source": "Tatoeba #4425751 @aldolit58 / #4426035 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4425751",
          "cefr_level": "A1",
          "word_slugs": [
