    {
      "slug": "pareti-noun",
      "lemma": "pareti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6251,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2430142",
          "text": "Le pareti sono bianche.",
          "translation": "Стены белые.",
          "source": "Tatoeba #2430142 @al_ex_an_der / #2430144 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430142",
          "cefr_level": "A1",
          "word_slugs": [
            "pareti-noun"
          ]
        },
        {
          "id": "6005654",
          "text": "Quando hai dipinto le pareti della casa?",
          "translation": "Когда ты покрасил стену дома?",
          "source": "Tatoeba #6005654 @dnnywld / #6005104 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6005654",
          "cefr_level": "A1",
          "word_slugs": [
            "pareti-noun"
          ]
        },
        {
          "id": "6865315",
          "text": "Le pareti della tomba erano coperte di geroglifici.",
          "translation": "Стены гробницы были исписаны иероглифами.",
          "source": "Tatoeba #6865315 @dnnywld / #6864332 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6865315",
          "cefr_level": "A1",
          "word_slugs": [
            "pareti-noun"
          ]
        },
        {
          "id": "2507781",
          "text": "Bizzarre formazioni rocciose formano le pareti del burrone.",
          "translation": "Скалы причудливой формы образуют стены ущелья.",
          "source": "Tatoeba #2507781 @al_ex_an_der / #2507719 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2507781",
          "cefr_level": "A1",
          "word_slugs": [
            "pareti-noun"
          ]
        },
        {
          "id": "2430145",
          "text": "Di che colore sono le pareti della tua casa?",
          "translation": "Какого цвета стены твоего дома?",
          "source": "Tatoeba #2430145 @al_ex_an_der / #2430150 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430145",
          "cefr_level": "A1",
          "word_slugs": [
            "pareti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la pareti",
        "plural": "",
        "infinitive": ""
      }
