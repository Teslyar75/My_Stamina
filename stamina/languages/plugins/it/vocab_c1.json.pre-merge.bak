      "frequency_rank": 9216,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6966090",
          "text": "Tifo per voi.",
          "translation": "Я болею за вас.",
          "source": "Tatoeba #6966090 @dnnywld / #4955742 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6966090",
          "cefr_level": "A1",
          "word_slugs": [
            "tifo-noun"
          ]
        },
        {
          "id": "5409296",
          "text": "Farai il tifo per me?",
          "translation": "Ты будешь болеть за меня?",
          "source": "Tatoeba #5409296 @dnnywld / #3559520 @pgavda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409296",
          "cefr_level": "A1",
          "word_slugs": [
            "tifo-noun"
          ]
        },
        {
          "id": "3283930",
          "text": "Faccio il tifo per voi.",
          "translation": "Я болею за вас.",
          "source": "Tatoeba #3283930 @Guybrush88 / #4955742 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3283930",
          "cefr_level": "A1",
          "word_slugs": [
            "tifo-noun"
          ]
        },
        {
          "id": "6966093",
          "text": "Faccio il tifo per lo \"Spartak\".",
          "translation": "Я болею за \"Спартак\".",
          "source": "Tatoeba #6966093 @dnnywld / #6295528 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6966093",
          "cefr_level": "A1",
          "word_slugs": [
            "tifo-noun"
          ]
        },
        {
          "id": "6966112",
          "text": "Tifo per la squadra del \"Vasco de Gama\".",
          "translation": "Я болею за команду \"Васко да Гама\".",
          "source": "Tatoeba #6966112 @dnnywld / #2735410 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6966112",
          "cefr_level": "A1",
          "word_slugs": [
            "tifo-noun"
          ]
        }
      ],
