    {
      "slug": "obiettivi-adj",
      "lemma": "obiettivi",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5524,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2444774",
          "text": "Mi pongo obiettivi realistici.",
          "translation": "Я ставлю перед собой реальные цели.",
          "source": "Tatoeba #2444774 @al_ex_an_der / #2444769 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2444774",
          "cefr_level": "A1",
          "word_slugs": [
            "obiettivi-adj"
          ]
        },
        {
          "id": "4516043",
          "text": "Quali sono i vostri obiettivi?",
          "translation": "Какие у вас цели?",
          "source": "Tatoeba #4516043 @Guybrush88 / #6808414 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4516043",
          "cefr_level": "A1",
          "word_slugs": [
            "obiettivi-adj"
          ]
        },
        {
          "id": "5862305",
          "text": "Lui spesso insegue obiettivi irraggiungibili.",
          "translation": "Он часто гонится за недостижимыми целями.",
          "source": "Tatoeba #5862305 @dnnywld / #5861919 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5862305",
          "cefr_level": "A1",
          "word_slugs": [
            "obiettivi-adj"
          ]
        },
        {
          "id": "2427262",
          "text": "Impara a definire i tuoi obiettivi.",
          "translation": "Учись определять свои цели.",
          "source": "Tatoeba #2427262 @al_ex_an_der / #2427269 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2427262",
          "cefr_level": "A1",
          "word_slugs": [
            "obiettivi-adj"
          ]
        },
        {
          "id": "10755686",
          "text": "Alla fine Tom ha raggiunto i suoi obiettivi.",
          "translation": "В конце концов Том достиг своей цели.",
          "source": "Tatoeba #10755686 @dnnywld / #10755651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10755686",
          "cefr_level": "A1",
          "word_slugs": [
            "obiettivi-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
