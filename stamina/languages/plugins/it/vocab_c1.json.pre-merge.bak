    {
      "slug": "ombrello-noun",
      "lemma": "ombrello",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9765,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2224255",
          "text": "Apri l'ombrello.",
          "translation": "Раскрой зонт!",
          "source": "Tatoeba #2224255 @Guybrush88 / #2532735 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2224255",
          "cefr_level": "A1",
          "word_slugs": [
            "ombrello-noun"
          ]
        },
        {
          "id": "5980591",
          "text": "Afferra l'ombrello.",
          "translation": "Захвати зонт.",
          "source": "Tatoeba #5980591 @dnnywld / #4939632 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980591",
          "cefr_level": "A1",
          "word_slugs": [
            "ombrello-noun"
          ]
        },
        {
          "id": "5980592",
          "text": "Afferrate l'ombrello.",
          "translation": "Захватите зонт.",
          "source": "Tatoeba #5980592 @dnnywld / #4939634 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980592",
          "cefr_level": "A1",
          "word_slugs": [
            "ombrello-noun"
          ]
        },
        {
          "id": "5980603",
          "text": "Vi serve un ombrello?",
          "translation": "Вам нужен зонт?",
          "source": "Tatoeba #5980603 @dnnywld / #4908362 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5980603",
          "cefr_level": "A1",
          "word_slugs": [
            "ombrello-noun"
          ]
        },
        {
          "id": "5572066",
          "text": "Questo ombrello è tuo?",
          "translation": "Этот зонт твой?",
          "source": "Tatoeba #5572066 @Guybrush88 / #3828293 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5572066",
          "cefr_level": "A1",
          "word_slugs": [
            "ombrello-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ombrello",
