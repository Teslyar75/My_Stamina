    {
      "slug": "chiude-verb",
      "lemma": "chiude",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5276,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "378139",
          "text": "Il negozio chiude alle sette.",
          "translation": "Магазин закрывается в семь.",
          "source": "Tatoeba #378139 @Pharamp / #563545 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/378139",
          "cefr_level": "A1",
          "word_slugs": [
            "chiude-verb"
          ]
        },
        {
          "id": "5418955",
          "text": "Questa finestra non si chiude.",
          "translation": "Это окно не закрывается.",
          "source": "Tatoeba #5418955 @dnnywld / #5418938 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5418955",
          "cefr_level": "A1",
          "word_slugs": [
            "chiude-verb"
          ]
        },
        {
          "id": "3827470",
          "text": "Questo negozio chiude alle nove.",
          "translation": "Этот магазин закрывается в девять.",
          "source": "Tatoeba #3827470 @Guybrush88 / #2206087 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3827470",
          "cefr_level": "A1",
          "word_slugs": [
            "chiude-verb"
          ]
        },
        {
          "id": "1514832",
          "text": "La biblioteca chiude al pubblico.",
          "translation": "Библиотека закрыта.",
          "source": "Tatoeba #1514832 @Guybrush88 / #3109660 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1514832",
          "cefr_level": "A1",
          "word_slugs": [
            "chiude-verb"
          ]
        },
        {
          "id": "11024590",
          "text": "Questa porta non si chiude bene.",
          "translation": "Эта дверь плохо закрывается.",
          "source": "Tatoeba #11024590 @ml_tatoeba / #11024676 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11024590",
          "cefr_level": "A1",
          "word_slugs": [
            "chiude-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
