    {
      "slug": "fortunatamente-adv",
      "lemma": "fortunatamente",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5707,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5640097",
          "text": "Fortunatamente Tom è ancora vivo.",
          "translation": "К счастью, Том ещё жив.",
          "source": "Tatoeba #5640097 @dnnywld / #5640091 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5640097",
          "cefr_level": "A1",
          "word_slugs": [
            "fortunatamente-adv"
          ]
        },
        {
          "id": "6385572",
          "text": "Fortunatamente la porta era aperta.",
          "translation": "К счастью, дверь была открыта.",
          "source": "Tatoeba #6385572 @dnnywld / #6385342 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6385572",
          "cefr_level": "A1",
          "word_slugs": [
            "fortunatamente-adv"
          ]
        },
        {
          "id": "6378052",
          "text": "Fortunatamente abbiamo volato senza incidenti.",
          "translation": "К счастью, мы долетели без приключений.",
          "source": "Tatoeba #6378052 @dnnywld / #1758239 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6378052",
          "cefr_level": "A1",
          "word_slugs": [
            "fortunatamente-adv"
          ]
        },
        {
          "id": "7328745",
          "text": "Fortunatamente è andato tutto com'è andato.",
          "translation": "К счастью, всё сложилось так, как сложилось.",
          "source": "Tatoeba #7328745 @dnnywld / #7328594 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7328745",
          "cefr_level": "A1",
          "word_slugs": [
            "fortunatamente-adv"
          ]
        },
        {
          "id": "7015679",
          "text": "Fortunatamente i nostri timori non si sono confermati.",
          "translation": "К счастью, наши опасения не подтвердились.",
          "source": "Tatoeba #7015679 @dnnywld / #7015126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7015679",
          "cefr_level": "A1",
          "word_slugs": [
            "fortunatamente-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "fortunatamente",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "lasceremo-verb",
      "lemma": "lasceremo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5708,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5690592",
          "text": "Lo lasceremo a lui.",
          "translation": "Мы оставим это ему.",
          "source": "Tatoeba #5690592 @dnnywld / #5689797 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690592",
          "cefr_level": "A1",
          "word_slugs": [
            "lasceremo-verb"
          ]
        },
        {
          "id": "5690594",
          "text": "La lasceremo a lei.",
          "translation": "Мы оставим это ей.",
          "source": "Tatoeba #5690594 @dnnywld / #5689796 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690594",
          "cefr_level": "A1",
          "word_slugs": [
            "lasceremo-verb"
          ]
        },
        {
          "id": "5577286",
          "text": "Ti lasceremo in pace.",
          "translation": "Мы оставим тебя в покое.",
          "source": "Tatoeba #5577286 @dnnywld / #5576936 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5577286",
          "cefr_level": "A1",
          "word_slugs": [
            "lasceremo-verb"
          ]
        },
        {
          "id": "5690591",
          "text": "Lasceremo questo a lui.",
          "translation": "Мы оставим это ему.",
          "source": "Tatoeba #5690591 @dnnywld / #5689797 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690591",
          "cefr_level": "A1",
          "word_slugs": [
            "lasceremo-verb"
          ]
        },
        {
          "id": "5690595",
          "text": "Lasceremo questo a lei.",
          "translation": "Мы оставим это ей.",
          "source": "Tatoeba #5690595 @dnnywld / #5689796 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5690595",
          "cefr_level": "A1",
          "word_slugs": [
            "lasceremo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
