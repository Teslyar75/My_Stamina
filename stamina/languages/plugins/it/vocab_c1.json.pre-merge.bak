    {
      "slug": "laurea-noun",
      "lemma": "laurea",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5183,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "634405",
          "text": "Ho una laurea.",
          "translation": "У меня есть диплом.",
          "source": "Tatoeba #634405 @Guybrush88 / #3415553 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/634405",
          "cefr_level": "A1",
          "word_slugs": [
            "laurea-noun"
          ]
        },
        {
          "id": "6360220",
          "text": "Il prossimo anno prenderò la laurea.",
          "translation": "В следующем году я окончу институт.",
          "source": "Tatoeba #6360220 @dnnywld / #6359634 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6360220",
          "cefr_level": "A1",
          "word_slugs": [
            "laurea-noun"
          ]
        },
        {
          "id": "5637190",
          "text": "Olya ha ricevuto una laurea in comunicazione interculturale.",
          "translation": "Оля получила диплом специалиста по межкультурным коммуникациям.",
          "source": "Tatoeba #5637190 @dnnywld / #4651939 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5637190",
          "cefr_level": "A1",
          "word_slugs": [
            "laurea-noun"
          ]
        },
        {
          "id": "5507512",
          "text": "Questo è lo stesso vestito che avevi alla laurea?",
          "translation": "Это то самое платье, в котором ты была на выпускном?",
          "source": "Tatoeba #5507512 @dnnywld / #5507045 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5507512",
          "cefr_level": "A1",
          "word_slugs": [
            "laurea-noun"
          ]
        },
        {
          "id": "5683687",
          "text": "State scrivendo una tesi di laurea? Su quale argomento?",
          "translation": "Вы пишете диссертацию? На какую тему?",
          "source": "Tatoeba #5683687 @dnnywld / #5679880 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5683687",
          "cefr_level": "A1",
          "word_slugs": [
            "laurea-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la laurea",
        "plural": "",
        "infinitive": ""
      }
