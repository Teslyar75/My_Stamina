      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6819391",
          "text": "Lei ha munto una capra.",
          "translation": "Она подоила козу.",
          "source": "Tatoeba #6819391 @dnnywld / #6819204 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6819391",
          "cefr_level": "A1",
          "word_slugs": [
            "capra-noun"
          ]
        },
        {
          "id": "2792290",
          "text": "Amo il formaggio di capra.",
          "translation": "Я люблю козий сыр.",
          "source": "Tatoeba #2792290 @Guybrush88 / #3875214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2792290",
          "cefr_level": "A1",
          "word_slugs": [
            "capra-noun"
          ]
        },
        {
          "id": "3177441",
          "text": "Io voglio essere una capra.",
