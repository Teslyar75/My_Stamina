            "scortese-noun"
          ]
        },
        {
          "id": "5560588",
          "text": "Tom è stato scortese con noi.",
          "translation": "Том был с нами невежлив.",
          "source": "Tatoeba #5560588 @dnnywld / #5560399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5560588",
          "cefr_level": "A1",
          "word_slugs": [
            "scortese-noun"
          ]
        },
        {
          "id": "13139429",
          "text": "Da parte sua è stato scortese.",
          "translation": "С его стороны это было грубо.",
          "source": "Tatoeba #13139429 @dnnywld / #13139251 @Aquinastotle (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13139429",
          "cefr_level": "A1",
