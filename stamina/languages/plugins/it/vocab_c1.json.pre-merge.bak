      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5677877",
          "text": "Ho disegnato una mappa.",
          "translation": "Я нарисовал карту.",
          "source": "Tatoeba #5677877 @dnnywld / #5677054 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677877",
          "cefr_level": "A1",
