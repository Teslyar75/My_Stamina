          ]
        },
        {
          "id": "1254084",
          "text": "Tom è diventato depresso.",
          "translation": "Том стал подавленным.",
          "source": "Tatoeba #1254084 @Guybrush88 / #1424284 @Snark (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1254084",
          "cefr_level": "A1",
          "word_slugs": [
            "depresso-adj"
          ]
        },
        {
          "id": "6883173",
          "text": "Lui è depresso e solo.",
          "translation": "Он подавлен и одинок.",
          "source": "Tatoeba #6883173 @dnnywld / #6882275 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6883173",
          "cefr_level": "A1",
          "word_slugs": [
            "depresso-adj"
          ]
        },
        {
          "id": "6051757",
          "text": "Tom è depresso, e non esce di casa.",
          "translation": "У Тома депрессия, и он не выходит из дома.",
          "source": "Tatoeba #6051757 @dnnywld / #6050828 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6051757",
