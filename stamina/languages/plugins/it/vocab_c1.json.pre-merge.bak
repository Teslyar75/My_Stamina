    {
      "slug": "suicidato-verb",
      "lemma": "suicidato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8768,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5479996",
          "text": "Tom non si è suicidato.",
          "translation": "Том не покончил с собой.",
          "source": "Tatoeba #5479996 @dnnywld / #5479963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479996",
          "cefr_level": "A1",
          "word_slugs": [
            "suicidato-verb"
          ]
        },
        {
          "id": "5848713",
          "text": "Tom si è suicidato ieri.",
          "translation": "Том вчера покончил с собой.",
          "source": "Tatoeba #5848713 @Guybrush88 / #5986791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5848713",
          "cefr_level": "A1",
          "word_slugs": [
            "suicidato-verb"
          ]
        },
        {
          "id": "13346914",
          "text": "Epstein non si è suicidato.",
          "translation": "Эпштейн не убивал себя.",
          "source": "Tatoeba #13346914 @rul / #10641625 @nipbud (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13346914",
          "cefr_level": "A1",
          "word_slugs": [
            "suicidato-verb"
          ]
        },
        {
          "id": "5589484",
          "text": "Tom si è suicidato tre anni fa.",
