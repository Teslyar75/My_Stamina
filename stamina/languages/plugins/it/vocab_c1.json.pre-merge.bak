    {
      "slug": "vennero-verb",
      "lemma": "vennero",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8209,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "658421",
          "text": "Vennero quasi tutti.",
          "translation": "Пришли почти все.",
          "source": "Tatoeba #658421 @rado / #658418 @Aleksej (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/658421",
          "cefr_level": "A1",
          "word_slugs": [
            "vennero-verb"
          ]
        },
        {
          "id": "1132137",
          "text": "Sette poliziotti vennero uccisi.",
          "translation": "Семеро полицейских было убито.",
          "source": "Tatoeba #1132137 @Guybrush88 / #2344431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1132137",
          "cefr_level": "A1",
          "word_slugs": [
            "vennero-verb"
          ]
        },
        {
          "id": "1132138",
          "text": "Vennero uccisi sette poliziotti.",
          "translation": "Семеро полицейских было убито.",
          "source": "Tatoeba #1132138 @Guybrush88 / #2344431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1132138",
          "cefr_level": "A1",
          "word_slugs": [
            "vennero-verb"
          ]
        },
        {
          "id": "3235237",
          "text": "Le truppe argentine vennero sconfitte.",
          "translation": "Аргентинские войска были разгромлены.",
          "source": "Tatoeba #3235237 @Guybrush88 / #3235313 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3235237",
          "cefr_level": "A1",
          "word_slugs": [
            "vennero-verb"
          ]
        },
        {
          "id": "5601897",
          "text": "Alla vista del sangue gli vennero i brividi.",
          "translation": "От вида крови его пробрал озноб.",
          "source": "Tatoeba #5601897 @dnnywld / #5601237 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5601897",
          "cefr_level": "A1",
          "word_slugs": [
            "vennero-verb"
          ]
        }
