            "proibito-adj"
          ]
        },
        {
          "id": "4274590",
          "text": "Fumare nel ristorante era proibito.",
          "translation": "В ресторане было запрещено курить.",
          "source": "Tatoeba #4274590 @Guybrush88 / #4445684 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4274590",
          "cefr_level": "A1",
          "word_slugs": [
            "proibito-adj"
          ]
        },
        {
          "id": "5646708",
          "text": "È proibito nuotare in questo lago.",
          "translation": "Купаться в этом озере запрещено.",
