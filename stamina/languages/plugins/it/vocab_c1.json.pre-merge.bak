          ]
        },
        {
          "id": "5393150",
          "text": "Ho perso la bicicletta.",
          "translation": "У меня пропал велосипед.",
          "source": "Tatoeba #5393150 @dnnywld / #5267105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5393150",
          "cefr_level": "A1",
