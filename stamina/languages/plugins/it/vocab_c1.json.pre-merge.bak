    {
      "slug": "esprimere-verb",
      "lemma": "esprimere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5680,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "989798",
          "text": "Non so come esprimere la mia gratitudine.",
          "translation": "Я не знаю, как выразить свою благодарность.",
          "source": "Tatoeba #989798 @riccioberto / #5987045 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/989798",
          "cefr_level": "A1",
          "word_slugs": [
            "esprimere-verb"
          ]
        },
        {
          "id": "6315881",
          "text": "Tom non sa come esprimere i suoi sentimenti",
          "translation": "Том не знает, как выразить свои чувства.",
          "source": "Tatoeba #6315881 @dnnywld / #3467846 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6315881",
          "cefr_level": "A1",
          "word_slugs": [
            "esprimere-verb"
          ]
        },
        {
          "id": "1369329",
          "text": "Trovo difficile esprimere i miei pensieri in parole.",
          "translation": "Мне сложно выразить свои мысли в словах.",
          "source": "Tatoeba #1369329 @riccioberto / #421516 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1369329",
          "cefr_level": "A1",
          "word_slugs": [
            "esprimere-verb"
          ]
        },
        {
          "id": "6894218",
          "text": "Molti non osano esprimere francamente la loro opinione.",
          "translation": "Многие не отваживаются прямо высказать своё мнение.",
          "source": "Tatoeba #6894218 @dnnywld / #6892974 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6894218",
          "cefr_level": "A1",
          "word_slugs": [
            "esprimere-verb"
          ]
        },
        {
          "id": "10788025",
          "text": "Non sono in grado di esprimere i miei sentimenti.",
          "translation": "Я не в состоянии выразить свои чувства.",
          "source": "Tatoeba #10788025 @dnnywld / #2159289 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10788025",
          "cefr_level": "A1",
          "word_slugs": [
            "esprimere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "esprimere",
