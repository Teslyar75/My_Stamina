          ]
        },
        {
          "id": "10851252",
          "text": "Raccontateci una barzelletta.",
          "translation": "Расскажите нам анекдот.",
          "source": "Tatoeba #10851252 @dnnywld / #2649418 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851252",
          "cefr_level": "A1",
          "word_slugs": [
