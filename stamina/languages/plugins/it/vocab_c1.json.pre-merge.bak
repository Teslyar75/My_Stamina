    {
      "slug": "pittura-noun",
      "lemma": "pittura",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9657,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "13699192",
          "text": "Insomma, una pittura ad olio.",
          "translation": "В общем, картина маслом.",
          "source": "Tatoeba #13699192 @dnnywld / #10735624 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13699192",
          "cefr_level": "A1",
          "word_slugs": [
            "pittura-noun"
          ]
        },
        {
          "id": "6003255",
          "text": "Mi reco in Francia a studiare pittura.",
          "translation": "Я отправляюсь во Францию, чтобы изучать живопись.",
          "source": "Tatoeba #6003255 @dnnywld / #6002926 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6003255",
          "cefr_level": "A1",
          "word_slugs": [
            "pittura-noun"
          ]
        },
        {
          "id": "6811242",
          "text": "Lei si è data alla pittura ad olio.",
          "translation": "Она начала писать картины маслом.",
          "source": "Tatoeba #6811242 @dnnywld / #6811184 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6811242",
          "cefr_level": "A1",
          "word_slugs": [
            "pittura-noun"
          ]
        },
        {
          "id": "5617755",
          "text": "Hai qualche hobby, come per esempio la pittura?",
          "translation": "У тебя есть какое-нибудь хобби, например, рисование?",
          "source": "Tatoeba #5617755 @dnnywld / #2487168 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5617755",
          "cefr_level": "A1",
          "word_slugs": [
            "pittura-noun"
          ]
        },
        {
          "id": "5441274",
          "text": "Si era dimostrato un fine intenditore ed esperto di pittura.",
          "translation": "Он оказался тонким ценителем и знатоком живописи.",
          "source": "Tatoeba #5441274 @dnnywld / #5440595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5441274",
          "cefr_level": "A1",
          "word_slugs": [
            "pittura-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la pittura",
        "plural": "",
        "infinitive": ""
      }
    },
