      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5569743",
          "text": "I maghi usano l'illusione.",
          "translation": "Волшебники используют иллюзию.",
          "source": "Tatoeba #5569743 @dnnywld / #5569705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5569743",
          "cefr_level": "A1",
          "word_slugs": [
