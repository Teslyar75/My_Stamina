          ]
        },
        {
          "id": "5636869",
          "text": "Ti ho colto di sorpresa?",
          "translation": "Я застал тебя врасплох?",
          "source": "Tatoeba #5636869 @dnnywld / #4652037 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5636869",
          "cefr_level": "A1",
          "word_slugs": [
            "colto-verb"
          ]
        },
        {
          "id": "5830043",
          "text": "L'anno colto in flagrante.",
          "translation": "Его взяли с поличным.",
          "source": "Tatoeba #5830043 @dnnywld / #3839948 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5830043",
          "cefr_level": "A1",
          "word_slugs": [
            "colto-verb"
          ]
        },
        {
          "id": "13070991",
          "text": "Ti hanno colto di sorpresa?",
          "translation": "Тебя застали врасплох?",
          "source": "Tatoeba #13070991 @dnnywld / #13070964 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13070991",
          "cefr_level": "A1",
