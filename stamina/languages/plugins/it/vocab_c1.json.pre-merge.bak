      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4430986",
          "text": "Tom ha avvelenato Mary.",
          "translation": "Том отравил Мэри.",
          "source": "Tatoeba #4430986 @Guybrush88 / #3855132 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4430986",
          "cefr_level": "A1",
          "word_slugs": [
            "avvelenato-adj"
          ]
        },
        {
          "id": "5494892",
          "text": "Perché hai avvelenato Tom?",
          "translation": "Зачем ты отравил Тома?",
          "source": "Tatoeba #5494892 @dnnywld / #5494497 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494892",
          "cefr_level": "A1",
