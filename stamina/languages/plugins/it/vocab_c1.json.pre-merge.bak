          ]
        },
        {
          "id": "6896900",
          "text": "Le persone vogliono tradurre cose più interessanti.",
          "translation": "Людям хочется переводить более интересные вещи.",
          "source": "Tatoeba #6896900 @dnnywld / #5144122 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6896900",
          "cefr_level": "A1",
