      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "4741975",
          "text": "Lei quando rientra?",
          "translation": "Она когда возвращается?",
          "source": "Tatoeba #4741975 @Guybrush88 / #4614769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4741975",
          "cefr_level": "A1",
          "word_slugs": [
            "rientra-verb"
          ]
        },
        {
          "id": "4741988",
          "text": "Lui quando rientra?",
          "translation": "Он когда возвращается?",
          "source": "Tatoeba #4741988 @Guybrush88 / #4614767 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4741988",
          "cefr_level": "A1",
          "word_slugs": [
            "rientra-verb"
          ]
        },
        {
          "id": "4741985",
          "text": "Marie quando rientra?",
          "translation": "Мэри когда возвращается?",
          "source": "Tatoeba #4741985 @Guybrush88 / #4614772 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4741985",
          "cefr_level": "A1",
          "word_slugs": [
            "rientra-verb"
          ]
        },
        {
          "id": "10766135",
          "text": "Tom oggi rientra più tardi.",
          "translation": "Том сегодня вернётся позже.",
          "source": "Tatoeba #10766135 @dnnywld / #7009808 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10766135",
          "cefr_level": "A1",
          "word_slugs": [
            "rientra-verb"
          ]
        },
        {
          "id": "6790797",
          "text": "Cosa rientra nelle tue responsabilità?",
          "translation": "Что входит в твои обязанности?",
          "source": "Tatoeba #6790797 @dnnywld / #6703807 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790797",
          "cefr_level": "A1",
          "word_slugs": [
            "rientra-verb"
          ]
        }
      ],
