        },
        {
          "id": "6786559",
          "text": "I coloni furono costretti a lasciare le loro terre.",
          "translation": "Поселенцы были вынуждены покинуть свои земли.",
          "source": "Tatoeba #6786559 @dnnywld / #4420643 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786559",
          "cefr_level": "A1",
          "word_slugs": [
            "terre-noun"
          ]
        },
        {
          "id": "6786565",
          "text": "Molti armeni furono costretti ad abbandonare le loro terre.",
          "translation": "Многих армян заставили покинуть свои земли.",
          "source": "Tatoeba #6786565 @dnnywld / #5681541 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786565",
          "cefr_level": "A1",
          "word_slugs": [
            "terre-noun"
          ]
        },
        {
          "id": "6594862",
          "text": "Lui ha dato via le sue terre a poco prezzo.",
          "translation": "Он раздал по дешёвке свои земли.",
          "source": "Tatoeba #6594862 @dnnywld / #6594804 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6594862",
          "cefr_level": "A1",
          "word_slugs": [
            "terre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la terre",
        "plural": "",
        "infinitive": ""
      }
