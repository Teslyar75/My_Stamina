    {
      "slug": "coperte-adj",
      "lemma": "coperte",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5870,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5563035",
          "text": "Lui non ha trovato le coperte.",
          "translation": "Он не нашёл покрывал.",
          "source": "Tatoeba #5563035 @dnnywld / #5560777 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5563035",
          "cefr_level": "A1",
          "word_slugs": [
            "coperte-adj"
          ]
        },
        {
          "id": "5480024",
          "text": "Le strade sono coperte di neve.",
          "translation": "Улицы засыпаны снегом.",
          "source": "Tatoeba #5480024 @dnnywld / #5479954 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5480024",
          "cefr_level": "A1",
          "word_slugs": [
            "coperte-adj"
          ]
        },
        {
          "id": "6865315",
          "text": "Le pareti della tomba erano coperte di geroglifici.",
          "translation": "Стены гробницы были исписаны иероглифами.",
          "source": "Tatoeba #6865315 @dnnywld / #6864332 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6865315",
          "cefr_level": "A1",
          "word_slugs": [
            "coperte-adj"
          ]
        },
        {
          "id": "6365324",
          "text": "Con l'arrivo dell'inverno le montagne saranno coperte di neve.",
          "translation": "С приходом зимы горы покроются снегом.",
          "source": "Tatoeba #6365324 @dnnywld / #6184779 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6365324",
          "cefr_level": "A1",
          "word_slugs": [
            "coperte-adj"
          ]
        },
        {
          "id": "5675955",
          "text": "Le loro facce, coperte di vernice cremisi e nera, sembravano disumane.",
          "translation": "Покрытые багряной и чёрной краской, их лица казались нечеловеческими.",
          "source": "Tatoeba #5675955 @dnnywld / #5675278 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5675955",
          "cefr_level": "A1",
          "word_slugs": [
            "coperte-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il coperte",
        "plural": "",
        "infinitive": ""
      }
    },
