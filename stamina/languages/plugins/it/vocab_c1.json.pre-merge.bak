    {
      "slug": "critiche-noun",
      "lemma": "critiche",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8401,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5678569",
          "text": "Non temo le critiche.",
          "translation": "Я не боюсь быть раскритикованным.",
          "source": "Tatoeba #5678569 @dnnywld / #5678528 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5678569",
          "cefr_level": "A1",
          "word_slugs": [
            "critiche-noun"
          ]
        },
        {
          "id": "5678568",
          "text": "Non ho paura delle critiche.",
          "translation": "Я не боюсь быть раскритикованным.",
          "source": "Tatoeba #5678568 @dnnywld / #5678528 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5678568",
          "cefr_level": "A1",
          "word_slugs": [
            "critiche-noun"
          ]
        },
        {
          "id": "5681124",
          "text": "Le critiche sono bene accette.",
          "translation": "Критика приветствуется.",
          "source": "Tatoeba #5681124 @dnnywld / #5678632 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5681124",
          "cefr_level": "A1",
          "word_slugs": [
            "critiche-noun"
          ]
        },
        {
          "id": "5691563",
          "text": "Le sue condizioni sono critiche.",
          "translation": "Его состояние критическое.",
          "source": "Tatoeba #5691563 @dnnywld / #5691504 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5691563",
          "cefr_level": "A1",
          "word_slugs": [
            "critiche-noun"
          ]
        },
        {
          "id": "5650177",
          "text": "Tom si trova in condizioni critiche.",
          "translation": "Том находится в критическом состоянии.",
          "source": "Tatoeba #5650177 @dnnywld / #5144282 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5650177",
          "cefr_level": "A1",
          "word_slugs": [
            "critiche-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la critiche",
        "plural": "",
        "infinitive": ""
      }
