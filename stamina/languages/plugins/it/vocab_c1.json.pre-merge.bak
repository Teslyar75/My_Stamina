    {
      "slug": "equilibrio-noun",
      "lemma": "equilibrio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5378,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "равновесие"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5692548",
          "text": "Possiamo ancora trovare il punto di equilibrio.",
          "translation": "Мы ещё можем выйти в ноль.",
          "source": "Tatoeba #5692548 @dnnywld / #5692489 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5692548",
          "cefr_level": "A1",
          "word_slugs": [
            "equilibrio-noun"
          ]
        },
        {
          "id": "1794773",
          "text": "L'equilibrio dell'energia femminile e maschile è importante.",
          "translation": "Баланс женской и мужской энергии имеет важное значение.",
          "source": "Tatoeba #1794773 @al_ex_an_der / #1794767 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1794773",
          "cefr_level": "A1",
          "word_slugs": [
            "equilibrio-noun"
          ]
        },
        {
          "id": "6806361",
          "text": "Tom vuole raggiungere un equilibrio migliore tra lavoro e tempo libero.",
          "translation": "Том хочет достигнуть лучшего равновесия между работой и свободным временем.",
          "source": "Tatoeba #6806361 @dnnywld / #6805640 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6806361",
          "cefr_level": "A1",
          "word_slugs": [
            "equilibrio-noun"
          ]
        },
        {
          "id": "1794726",
          "text": "Questo film parla dell'importanza dell’equilibrio tra natura e progresso.",
          "translation": "В этом фильме речь идёт о важности равновесия между природой и прогрессом.",
          "source": "Tatoeba #1794726 @al_ex_an_der / #1794734 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1794726",
          "cefr_level": "A1",
          "word_slugs": [
            "equilibrio-noun"
          ]
        },
        {
          "id": "1866496",
          "text": "Come si fa a raggiungere un equilibrio tra lavoro e vita privata?",
          "translation": "Как можно достичь баланса между работой и личной жизнью?",
          "source": "Tatoeba #1866496 @al_ex_an_der / #1866508 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1866496",
          "cefr_level": "A1",
          "word_slugs": [
            "equilibrio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il equilibrio",
        "plural": "",
        "infinitive": ""
      }
    },
    {
