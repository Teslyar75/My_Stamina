    {
      "slug": "svezia-name",
      "lemma": "Svezia",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9672,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3296180",
          "text": "Quanti cavalli ci sono in Svezia?",
          "translation": "Сколько лошадей в Швеции?",
          "source": "Tatoeba #3296180 @Guybrush88 / #3296191 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3296180",
          "cefr_level": "A1",
          "word_slugs": [
            "svezia-name"
          ]
        },
        {
          "id": "1816409",
          "text": "Io sono appena tornato dalla Svezia.",
          "translation": "Я только что вернулся из Швеции.",
          "source": "Tatoeba #1816409 @Guybrush88 / #1246139 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1816409",
          "cefr_level": "A1",
          "word_slugs": [
            "svezia-name"
          ]
        },
        {
          "id": "7651493",
          "text": "Vado a costruire sinagoghe in Svezia?",
          "translation": "Я собираюсь строить синагоги в Швеции?",
          "source": "Tatoeba #7651493 @Guybrush88 / #8688208 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7651493",
          "cefr_level": "A1",
          "word_slugs": [
            "svezia-name"
          ]
        },
        {
          "id": "2448093",
          "text": "La popolazione della Svezia sta crescendo.",
          "translation": "Население Швеции растёт.",
          "source": "Tatoeba #2448093 @Guybrush88 / #800887 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2448093",
          "cefr_level": "A1",
          "word_slugs": [
            "svezia-name"
          ]
        },
        {
          "id": "5409080",
          "text": "In Svezia è vietato picchiare i bambini.",
          "translation": "В Швеции детей бить запрещено.",
          "source": "Tatoeba #5409080 @dnnywld / #3308124 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409080",
          "cefr_level": "A1",
          "word_slugs": [
            "svezia-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la Svezia",
        "plural": "",
        "infinitive": ""
      }
