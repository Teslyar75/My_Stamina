    {
      "slug": "applausi-noun",
      "lemma": "applausi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7829,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5568752",
          "text": "Scoppiarono gli applausi.",
          "translation": "Разразились аплодисменты.",
          "source": "Tatoeba #5568752 @dnnywld / #5567963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5568752",
          "cefr_level": "A1",
          "word_slugs": [
            "applausi-noun"
          ]
        },
        {
          "id": "5949312",
          "text": "Si alzò uno scroscio di applausi.",
          "translation": "Раздался шквал аплодисментов.",
          "source": "Tatoeba #5949312 @dnnywld / #5949181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5949312",
          "cefr_level": "A1",
          "word_slugs": [
            "applausi-noun"
          ]
        },
        {
          "id": "5571048",
          "text": "L'attuale politico cerca più gli applausi che il successo.",
          "translation": "Современный политик ищет более оваций, нежели успеха.",
          "source": "Tatoeba #5571048 @dnnywld / #5570761 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571048",
