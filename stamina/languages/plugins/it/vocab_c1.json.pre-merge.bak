      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5889540",
          "text": "Lui è abituato a situazioni simili.",
          "translation": "Он привык к таким ситуациям.",
          "source": "Tatoeba #5889540 @dnnywld / #4940806 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889540",
          "cefr_level": "A1",
          "word_slugs": [
