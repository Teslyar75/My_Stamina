          "cefr_level": "A1",
          "word_slugs": [
            "venezia-name"
          ]
        },
        {
          "id": "7180875",
          "text": "Venezia è una bella città.",
          "translation": "Венеция — красивый город.",
          "source": "Tatoeba #7180875 @Guybrush88 / #14097599 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7180875",
          "cefr_level": "A1",
          "word_slugs": [
            "venezia-name"
          ]
        },
        {
          "id": "341638",
          "text": "A Venezia ci sono sempre tanti turisti.",
          "translation": "В Венеции всегда много туристов.",
          "source": "Tatoeba #341638 @MUIRIEL / #469834 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341638",
          "cefr_level": "A1",
          "word_slugs": [
            "venezia-name"
          ]
        },
        {
          "id": "621071",
          "text": "Ho studiato cinese all'università di Venezia.",
          "translation": "Я изучал китайский язык в университете Венеции.",
          "source": "Tatoeba #621071 @Guybrush88 / #3732115 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/621071",
          "cefr_level": "A1",
          "word_slugs": [
            "venezia-name"
          ]
        }
      ],
