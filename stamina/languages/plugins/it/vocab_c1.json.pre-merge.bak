      "examples": [
        {
          "id": "6484859",
          "text": "Nella sua voce traspariva ironia.",
          "translation": "В её голосе сквозила ирония.",
          "source": "Tatoeba #6484859 @dnnywld / #6484651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6484859",
          "cefr_level": "A1",
          "word_slugs": [
