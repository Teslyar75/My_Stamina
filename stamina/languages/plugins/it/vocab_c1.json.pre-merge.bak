    {
      "slug": "ritirare-verb",
      "lemma": "ritirare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5873,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5856994",
          "text": "Vado a ritirare dei soldi.",
          "translation": "Схожу сниму денег.",
          "source": "Tatoeba #5856994 @dnnywld / #4923690 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5856994",
          "cefr_level": "A1",
          "word_slugs": [
            "ritirare-verb"
          ]
        },
        {
          "id": "5569490",
          "text": "Vorrei ritirare la mia dichiarazione precedente.",
          "translation": "Я хотел бы отозвать своё предыдущее заявление.",
          "source": "Tatoeba #5569490 @dnnywld / #5569248 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5569490",
          "cefr_level": "A1",
          "word_slugs": [
            "ritirare-verb"
          ]
        },
        {
          "id": "6881901",
          "text": "Ti chiedo di ritirare ciò che hai detto.",
          "translation": "Прошу тебя взять свои слова обратно.",
          "source": "Tatoeba #6881901 @dnnywld / #5160448 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881901",
          "cefr_level": "A1",
          "word_slugs": [
            "ritirare-verb"
          ]
        },
        {
          "id": "6881902",
          "text": "Lui ha dovuto ritirare ciò che aveva detto.",
          "translation": "Ему пришлось взять свои слова обратно.",
          "source": "Tatoeba #6881902 @dnnywld / #5567380 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881902",
          "cefr_level": "A1",
          "word_slugs": [
            "ritirare-verb"
          ]
        },
        {
          "id": "5689302",
          "text": "Dove posso ritirare il mio biglietto dell'aereo?",
          "translation": "Где я могу забрать свой билет на самолёт?",
          "source": "Tatoeba #5689302 @dnnywld / #5688962 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5689302",
          "cefr_level": "A1",
          "word_slugs": [
            "ritirare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ritirare",
        "plural": "",
        "infinitive": "ritirare"
      }
    },
