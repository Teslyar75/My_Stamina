    {
      "slug": "grano-noun",
      "lemma": "grano",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6452,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5949344",
          "text": "C'è carenza di grano.",
          "translation": "Пшеница в дефиците.",
          "source": "Tatoeba #5949344 @dnnywld / #5949165 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5949344",
          "cefr_level": "A1",
          "word_slugs": [
            "grano-noun"
          ]
        },
        {
          "id": "3108689",
          "text": "I granai sono pieni di grano.",
          "translation": "Амбары полны зерна.",
          "source": "Tatoeba #3108689 @Guybrush88 / #2711690 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3108689",
          "cefr_level": "A1",
          "word_slugs": [
            "grano-noun"
          ]
        },
        {
          "id": "6598130",
          "text": "Il Canada produce del buon grano.",
          "translation": "Канада производит хорошую пшеницу.",
          "source": "Tatoeba #6598130 @dnnywld / #6598098 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6598130",
          "cefr_level": "A1",
          "word_slugs": [
            "grano-noun"
          ]
        },
        {
          "id": "5821120",
          "text": "Di contorno ci sarà del grano saraceno.",
          "translation": "На гарнир будет гречка.",
          "source": "Tatoeba #5821120 @dnnywld / #5817613 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5821120",
          "cefr_level": "A1",
          "word_slugs": [
            "grano-noun"
          ]
        },
        {
          "id": "3650442",
          "text": "Il grano saraceno è diventato più costoso.",
          "translation": "Гречка подорожала.",
          "source": "Tatoeba #3650442 @al_ex_an_der / #3647067 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3650442",
          "cefr_level": "A1",
          "word_slugs": [
            "grano-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il grano",
        "plural": "",
        "infinitive": ""
      }
