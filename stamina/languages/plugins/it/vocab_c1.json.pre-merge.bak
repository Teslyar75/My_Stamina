    {
      "slug": "coltelli-noun",
      "lemma": "coltelli",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7338,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3292484",
          "text": "Dove sono i coltelli?",
          "translation": "Где ножи?",
          "source": "Tatoeba #3292484 @Guybrush88 / #614617 @Aleksej (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3292484",
          "cefr_level": "A1",
          "word_slugs": [
            "coltelli-noun"
          ]
        },
        {
          "id": "3295863",
          "text": "Non c'erano coltelli.",
          "translation": "Ножей не было.",
          "source": "Tatoeba #3295863 @Guybrush88 / #3219566 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3295863",
          "cefr_level": "A1",
          "word_slugs": [
            "coltelli-noun"
          ]
        },
        {
          "id": "7326962",
          "text": "Uno dei coltelli è andato perso.",
          "translation": "Один из ножей потерялся.",
          "source": "Tatoeba #7326962 @dnnywld / #7326139 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7326962",
          "cefr_level": "A1",
          "word_slugs": [
            "coltelli-noun"
          ]
        },
        {
          "id": "6833783",
          "text": "Tom non ha ancora affilato i coltelli.",
          "translation": "Том ещё не наточил ножи.",
          "source": "Tatoeba #6833783 @dnnywld / #6832435 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833783",
          "cefr_level": "A1",
          "word_slugs": [
            "coltelli-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il coltelli",
        "plural": "",
        "infinitive": ""
      }
    },
