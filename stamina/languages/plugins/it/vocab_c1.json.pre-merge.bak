    {
      "slug": "circo-noun",
      "lemma": "circo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5244,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2672088",
          "text": "La vita è un circo.",
          "translation": "Жизнь - это цирк.",
          "source": "Tatoeba #2672088 @Guybrush88 / #3268212 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2672088",
          "cefr_level": "A1",
          "word_slugs": [
            "circo-noun"
          ]
        },
        {
          "id": "1867290",
          "text": "Dai, andiamo domani al circo!",
          "translation": "Давайте пойдём завтра в цирк.",
          "source": "Tatoeba #1867290 @sixtynine / #1866737 @estong (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1867290",
          "cefr_level": "A1",
          "word_slugs": [
            "circo-noun"
          ]
        },
        {
          "id": "992998",
          "text": "Lavoro come addestratore di leoni in un circo.",
          "translation": "Я работаю дрессировщиком львов в цирке.",
          "source": "Tatoeba #992998 @Guybrush88 / #3233791 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/992998",
          "cefr_level": "A1",
          "word_slugs": [
            "circo-noun"
          ]
        },
        {
          "id": "6007198",
          "text": "Tom lavora al circo come addestratore di elefanti.",
          "translation": "Том работает дрессировщиком слонов в цирке.",
          "source": "Tatoeba #6007198 @dnnywld / #6006986 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6007198",
          "cefr_level": "A1",
          "word_slugs": [
            "circo-noun"
          ]
        },
        {
          "id": "5669862",
          "text": "Chi è nato in Russia non ride al circo.",
          "translation": "Кто родился в России, тот в цирке не смеётся.",
          "source": "Tatoeba #5669862 @dnnywld / #5669725 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5669862",
          "cefr_level": "A1",
          "word_slugs": [
            "circo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il circo",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "spedito-adj",
