    {
      "slug": "guadagna-verb",
      "lemma": "guadagna",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6537,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5419243",
          "text": "Lei guadagna molto.",
          "translation": "Она много получает.",
          "source": "Tatoeba #5419243 @dnnywld / #2210237 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419243",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagna-verb"
          ]
        },
        {
          "id": "5845408",
          "text": "Lei guadagna un buon stipendio.",
          "translation": "Она получает хорошую зарплату.",
          "source": "Tatoeba #5845408 @dnnywld / #2210236 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845408",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagna-verb"
          ]
        },
        {
          "id": "874314",
          "text": "Si guadagna da vivere scrivendo.",
          "translation": "Он зарабатывает на жизнь пером.",
          "source": "Tatoeba #874314 @riccioberto / #473387 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/874314",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagna-verb"
          ]
        },
        {
          "id": "4725042",
          "text": "Tom guadagna il doppio di me.",
          "translation": "Том зарабатывает в два раза больше, чем я.",
          "source": "Tatoeba #4725042 @Guybrush88 / #6803248 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4725042",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagna-verb"
          ]
        },
        {
          "id": "6944977",
          "text": "Fadil guadagna una cifra a 6 zeri.",
          "translation": "Фадель получает зарплату в сотни тысяч долларов.",
          "source": "Tatoeba #6944977 @dnnywld / #6944730 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944977",
          "cefr_level": "A1",
          "word_slugs": [
            "guadagna-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
