    {
      "slug": "presso-adv",
      "lemma": "presso",
      "pos": "adv",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5369,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10846647",
          "text": "Incontriamoci presso la foresta all'alba.",
          "translation": "Давай встретимся возле леса на рассвете.",
          "source": "Tatoeba #10846647 @carlosalberto / #10846636 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846647",
          "cefr_level": "A1",
          "word_slugs": [
            "presso-adv"
          ]
        },
        {
          "id": "6952313",
          "text": "Dopo il lavoro rimanemmo a pernottare presso la redazione.",
          "translation": "После работы мы остались ночевать в редакции.",
          "source": "Tatoeba #6952313 @dnnywld / #4563616 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952313",
          "cefr_level": "A1",
          "word_slugs": [
            "presso-adv"
          ]
        },
        {
          "id": "5494344",
          "text": "Maggiori informazioni sono disponibili presso il nostro sito internet.",
          "translation": "Больше информации можно найти на нашем сайте.",
          "source": "Tatoeba #5494344 @dnnywld / #5494262 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494344",
          "cefr_level": "A1",
          "word_slugs": [
            "presso-adv"
          ]
        },
        {
          "id": "10839143",
          "text": "È stato emesso un mandato di comparizione presso il giudice.",
          "translation": "Была выписана повестка в суд.",
          "source": "Tatoeba #10839143 @dnnywld / #9831730 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10839143",
          "cefr_level": "A1",
          "word_slugs": [
            "presso-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
