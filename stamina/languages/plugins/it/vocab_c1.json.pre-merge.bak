    {
      "slug": "globale-adj",
      "lemma": "globale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7222,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5678579",
          "text": "Lui non crede al riscaldamento globale.",
          "translation": "Он не верит в глобальное потепление.",
          "source": "Tatoeba #5678579 @dnnywld / #5678410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5678579",
          "cefr_level": "A1",
          "word_slugs": [
            "globale-adj"
          ]
        },
        {
          "id": "4503357",
          "text": "Sei preoccupato per il riscaldamento globale?",
          "translation": "Тебя беспокоит глобальное потепление?",
          "source": "Tatoeba #4503357 @Guybrush88 / #5419732 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4503357",
          "cefr_level": "A1",
          "word_slugs": [
            "globale-adj"
          ]
        },
        {
          "id": "5443060",
          "text": "GPS significa \"Sistema di posizionamento globale\".",
          "translation": "GPS означает \"Система глобального позиционирования\".",
          "source": "Tatoeba #5443060 @dnnywld / #5442907 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5443060",
          "cefr_level": "A1",
          "word_slugs": [
            "globale-adj"
          ]
        },
        {
          "id": "12893256",
          "text": "I paesi si sono uniti per prevenire un’altra guerra globale.",
          "translation": "Страны объединились, чтобы не допустить новой глобальной войны.",
          "source": "Tatoeba #12893256 @carlosalberto / #12892957 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12893256",
          "cefr_level": "A1",
          "word_slugs": [
            "globale-adj"
          ]
        },
        {
          "id": "4720757",
          "text": "Nel mondo della comunicazione globale siamo sempre più poveri di parole.",
          "translation": "В эпоху глобальной коммуникации мы становимся всё беднее на слова.",
          "source": "Tatoeba #4720757 @ianna / #4933521 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4720757",
          "cefr_level": "A1",
          "word_slugs": [
            "globale-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il globale",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "orsi-noun",
      "lemma": "orsi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7224,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "носит"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1082985",
          "text": "Ho paura degli orsi.",
          "translation": "Я боюсь медведей.",
          "source": "Tatoeba #1082985 @Guybrush88 / #2767044 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1082985",
          "cefr_level": "A1",
          "word_slugs": [
            "orsi-noun"
          ]
        },
        {
          "id": "11701551",
          "text": "I koala non sono orsi.",
          "translation": "Коалы не медведи.",
          "source": "Tatoeba #11701551 @WM3DAS / #10031488 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11701551",
          "cefr_level": "A1",
          "word_slugs": [
            "orsi-noun"
          ]
        },
        {
          "id": "13100783",
          "text": "Gli orsi amano le bacche.",
          "translation": "Медведи любят ягоды.",
          "source": "Tatoeba #13100783 @Adelpa / #13088812 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13100783",
          "cefr_level": "A1",
          "word_slugs": [
            "orsi-noun"
          ]
        },
        {
          "id": "11894835",
          "text": "Gli orsi bruni sono onnivori.",
          "translation": "Бурые медведи всеядны.",
          "source": "Tatoeba #11894835 @Adelpa / #11897345 @Adelpa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11894835",
          "cefr_level": "A1",
          "word_slugs": [
            "orsi-noun"
          ]
        },
        {
          "id": "5494227",
          "text": "I russi sanno tutto degli orsi.",
          "translation": "Русские знают о медведях всё.",
          "source": "Tatoeba #5494227 @dnnywld / #5493717 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494227",
          "cefr_level": "A1",
          "word_slugs": [
            "orsi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il orsi",
        "plural": "",
        "infinitive": ""
      }
    },
