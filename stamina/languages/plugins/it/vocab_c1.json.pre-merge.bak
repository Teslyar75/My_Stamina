    {
      "slug": "ipocrita-adj",
      "lemma": "ipocrita",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8326,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3397186",
          "text": "È un paese ipocrita.",
          "translation": "Это лицемерная страна.",
          "source": "Tatoeba #3397186 @Guybrush88 / #6576446 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3397186",
          "cefr_level": "A1",
          "word_slugs": [
            "ipocrita-adj"
          ]
        },
        {
          "id": "5969150",
          "text": "Lui è così ipocrita.",
          "translation": "Он такой ханжа.",
          "source": "Tatoeba #5969150 @dnnywld / #5967272 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5969150",
          "cefr_level": "A1",
          "word_slugs": [
            "ipocrita-adj"
          ]
        },
        {
          "id": "10825687",
          "text": "Uno così ipocrita si deve ancora trovare.",
          "translation": "Другого такого лицемера ещё поискать.",
          "source": "Tatoeba #10825687 @dnnywld / #10825668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10825687",
          "cefr_level": "A1",
          "word_slugs": [
            "ipocrita-adj"
          ]
        },
        {
          "id": "10825686",
          "text": "Non è mai esistito nessuno più ipocrita di lui.",
          "translation": "Не было никого лицемернее его.",
          "source": "Tatoeba #10825686 @dnnywld / #10825669 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10825686",
          "cefr_level": "A1",
          "word_slugs": [
            "ipocrita-adj"
          ]
        },
        {
          "id": "5520413",
          "text": "Non sono un ipocrita, pertanto esprimo liberamente le mie opinioni.",
          "translation": "Я не лицемер и поэтому свободно выражаю свои взгляды.",
          "source": "Tatoeba #5520413 @dnnywld / #5216355 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5520413",
          "cefr_level": "A1",
          "word_slugs": [
            "ipocrita-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ipocrita",
        "plural": "",
        "infinitive": ""
      }
    },
