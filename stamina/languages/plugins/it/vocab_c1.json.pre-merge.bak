    {
      "slug": "antico-adj",
      "lemma": "antico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5029,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2601404",
          "text": "Questo è un libro antico.",
          "translation": "Это старинная книга.",
          "source": "Tatoeba #2601404 @Guybrush88 / #5529389 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2601404",
          "cefr_level": "A1",
          "word_slugs": [
            "antico-adj"
          ]
        },
        {
          "id": "6905534",
          "text": "Io parlo il greco antico.",
          "translation": "Я говорю по-древнегречески.",
          "source": "Tatoeba #6905534 @dnnywld / #6905398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6905534",
          "cefr_level": "A1",
          "word_slugs": [
            "antico-adj"
          ]
        },
        {
          "id": "3996848",
          "text": "La Grecia è un paese antico.",
          "translation": "Греция — древняя страна.",
          "source": "Tatoeba #3996848 @Guybrush88 / #3935514 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3996848",
          "cefr_level": "A1",
          "word_slugs": [
            "antico-adj"
          ]
        },
        {
          "id": "428842",
          "text": "C'è un tempio molto antico in città.",
          "translation": "В городе есть очень древний храм.",
          "source": "Tatoeba #428842 @Pharamp / #573302 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/428842",
          "cefr_level": "A1",
          "word_slugs": [
            "antico-adj"
          ]
        },
        {
          "id": "10773769",
          "text": "Una volta qui c'era un tempio antico.",
          "translation": "Раньше здесь был старинный храм.",
          "source": "Tatoeba #10773769 @dnnywld / #1832673 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10773769",
          "cefr_level": "A1",
          "word_slugs": [
            "antico-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il antico",
        "plural": "",
        "infinitive": ""
      }
