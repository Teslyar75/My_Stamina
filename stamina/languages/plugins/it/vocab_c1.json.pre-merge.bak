    {
      "slug": "indiani-adj",
      "lemma": "indiani",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5184,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5700291",
          "text": "Vuoi giocare a indiani e cowboy?",
          "translation": "Хочешь поиграть в ковбоев и индейцев?",
          "source": "Tatoeba #5700291 @dnnywld / #5699941 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5700291",
          "cefr_level": "A1",
          "word_slugs": [
            "indiani-adj"
          ]
        },
        {
          "id": "6738843",
          "text": "Gli indiani hanno scoccato frecce avvelenate.",
          "translation": "Индейцы стреляли отравленными стрелами.",
          "source": "Tatoeba #6738843 @dnnywld / #6738644 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6738843",
          "cefr_level": "A1",
          "word_slugs": [
            "indiani-adj"
          ]
        },
        {
          "id": "4002958",
          "text": "Gli indiani hanno mangiato il suo cuore.",
          "translation": "Индейцы съели его сердце.",
          "source": "Tatoeba #4002958 @mervert1 / #5354456 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4002958",
          "cefr_level": "A1",
          "word_slugs": [
            "indiani-adj"
          ]
        },
        {
          "id": "5855168",
          "text": "Gli indiani facevano lo scalpo ai nemici.",
          "translation": "Индейцы снимали со своих врагов скальпы.",
          "source": "Tatoeba #5855168 @dnnywld / #3189535 @averoes (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5855168",
          "cefr_level": "A1",
          "word_slugs": [
            "indiani-adj"
          ]
        },
        {
          "id": "5730217",
          "text": "Finalmente due capi indiani decisero di fare pace.",
          "translation": "Наконец два индейских вождя решили заключить мир.",
          "source": "Tatoeba #5730217 @dnnywld / #2112515 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5730217",
          "cefr_level": "A1",
          "word_slugs": [
            "indiani-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il indiani",
        "plural": "",
        "infinitive": ""
      }
    },
