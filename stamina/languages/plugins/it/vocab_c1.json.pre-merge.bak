    {
      "slug": "ombre-noun",
      "lemma": "ombre",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7056,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5484518",
          "text": "Quando spariscono le ombre?",
          "translation": "Когда исчезают тени?",
          "source": "Tatoeba #5484518 @dnnywld / #5484444 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5484518",
          "cefr_level": "A1",
          "word_slugs": [
            "ombre-noun"
          ]
        },
        {
          "id": "5484517",
          "text": "Le ombre spariscono a mezzogiorno.",
          "translation": "Тени исчезают в полдень.",
          "source": "Tatoeba #5484517 @dnnywld / #5484445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5484517",
          "cefr_level": "A1",
          "word_slugs": [
            "ombre-noun"
          ]
        },
        {
          "id": "6006462",
          "text": "Siamo con voi, soltanto ombre effimere in questo vasto universo.",
          "translation": "Мы с вами — лишь мимолётные тени в этой огромной Вселенной.",
          "source": "Tatoeba #6006462 @dnnywld / #6002475 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6006462",
          "cefr_level": "A1",
          "word_slugs": [
            "ombre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la ombre",
        "plural": "",
        "infinitive": ""
      }
    },
    {
