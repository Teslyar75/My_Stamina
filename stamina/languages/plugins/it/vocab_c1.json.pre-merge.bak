          "cefr_level": "A1",
          "word_slugs": [
            "venir-verb"
          ]
        },
        {
          "id": "7448015",
          "text": "Non si può venir meno alla parola data.",
          "translation": "Нельзя нарушать свое слово.",
          "source": "Tatoeba #7448015 @dnnywld / #2164334 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7448015",
          "cefr_level": "A1",
          "word_slugs": [
