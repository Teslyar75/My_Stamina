          "word_slugs": [
            "scritte-adj"
          ]
        },
        {
          "id": "13393398",
          "text": "Le regole sono scritte con il sangue.",
          "translation": "Правила пишутся кровью.",
          "source": "Tatoeba #13393398 @Guybrush88 / #13433748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13393398",
          "cefr_level": "A1",
          "word_slugs": [
            "scritte-adj"
          ]
        },
        {
          "id": "6367251",
          "text": "Queste domande sono state scritte da Tom.",
          "translation": "Эти вопросы были написаны Томом.",
          "source": "Tatoeba #6367251 @dnnywld / #6366995 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367251",
