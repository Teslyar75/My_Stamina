    {
      "slug": "produce-noun",
      "lemma": "produce",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9067,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5871296",
          "text": "Questa azienda produce microchip.",
          "translation": "Эта компания производит микрочипы.",
          "source": "Tatoeba #5871296 @dnnywld / #4413627 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5871296",
          "cefr_level": "A1",
          "word_slugs": [
            "produce-noun"
          ]
        },
        {
          "id": "6871571",
          "text": "Questa fabbrica produce ricambi auto.",
          "translation": "Этот завод выпускает автозапчасти.",
          "source": "Tatoeba #6871571 @dnnywld / #6871570 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871571",
          "cefr_level": "A1",
          "word_slugs": [
            "produce-noun"
          ]
        },
        {
          "id": "5889659",
          "text": "Questa fabbrica produce forni elettrici.",
          "translation": "Этот завод производит электрические печи.",
          "source": "Tatoeba #5889659 @dnnywld / #2599875 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5889659",
          "cefr_level": "A1",
          "word_slugs": [
            "produce-noun"
          ]
        },
        {
          "id": "6598130",
          "text": "Il Canada produce del buon grano.",
          "translation": "Канада производит хорошую пшеницу.",
          "source": "Tatoeba #6598130 @dnnywld / #6598098 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6598130",
          "cefr_level": "A1",
          "word_slugs": [
            "produce-noun"
          ]
        },
        {
          "id": "5652616",
          "text": "Questo campo produce dei buoni raccolti.",
          "translation": "На этом поле хороший урожай.",
          "source": "Tatoeba #5652616 @dnnywld / #5652400 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5652616",
          "cefr_level": "A1",
          "word_slugs": [
            "produce-noun"
          ]
        }
      ],
