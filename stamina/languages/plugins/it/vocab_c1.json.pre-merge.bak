    {
      "slug": "condoglianze-intj",
      "lemma": "condoglianze",
      "pos": "intj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5806,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "845870",
          "text": "Le mie condoglianze!",
          "translation": "Мои соболезнования!",
          "source": "Tatoeba #845870 @Guybrush88 / #1913361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/845870",
          "cefr_level": "A1",
          "word_slugs": [
            "condoglianze-intj"
          ]
        },
        {
          "id": "7328741",
          "text": "Tom ha porto le sue condoglianze.",
          "translation": "Том выразил свои соболезнования.",
          "source": "Tatoeba #7328741 @dnnywld / #7328596 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7328741",
          "cefr_level": "A1",
          "word_slugs": [
            "condoglianze-intj"
          ]
        },
        {
          "id": "11540701",
          "text": "Le porgo le mie più sincere condoglianze!",
