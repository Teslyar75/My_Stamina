      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3365681",
          "text": "Ha un ragno sul soffitto!",
          "translation": "У Вас паук на потолке!",
          "source": "Tatoeba #3365681 @Guybrush88 / #3365729 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3365681",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitto-noun"
          ]
        },
        {
          "id": "3365678",
          "text": "Hai un ragno sul soffitto!",
          "translation": "У тебя паук на потолке!",
          "source": "Tatoeba #3365678 @Guybrush88 / #3365735 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3365678",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitto-noun"
          ]
        },
        {
          "id": "3365682",
          "text": "Avete un ragno sul soffitto!",
          "translation": "У вас паук на потолке!",
          "source": "Tatoeba #3365682 @Guybrush88 / #3365726 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3365682",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitto-noun"
          ]
        },
        {
          "id": "10857829",
          "text": "Dal soffitto pendevano enormi pezzi di ghiaccio.",
          "translation": "С крыши свисали огромные сосульки.",
          "source": "Tatoeba #10857829 @dnnywld / #10857721 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10857829",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitto-noun"
          ]
        },
        {
          "id": "383885",
          "text": "Se non hai niente da fare, guarda il soffitto della tua camera.",
          "translation": "Если тебе нечего делать, смотри на потолок своей комнаты.",
          "source": "Tatoeba #383885 @Pharamp / #3238315 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/383885",
          "cefr_level": "A1",
          "word_slugs": [
            "soffitto-noun"
          ]
        }
      ],
