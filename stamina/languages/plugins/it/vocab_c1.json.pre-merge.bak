    {
      "slug": "girano-verb",
      "lemma": "girano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6674,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5777539",
          "text": "Gli stranieri qui non girano.",
          "translation": "Чужие здесь не ходят.",
          "source": "Tatoeba #5777539 @dnnywld / #5777521 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5777539",
          "cefr_level": "A1",
          "word_slugs": [
            "girano-verb"
          ]
        },
        {
          "id": "6951812",
          "text": "Vuoi vedere come girano un film?",
          "translation": "Хочешь увидеть, как снимают кино?",
          "source": "Tatoeba #6951812 @dnnywld / #6950773 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6951812",
          "cefr_level": "A1",
          "word_slugs": [
            "girano-verb"
          ]
        },
        {
          "id": "5500262",
          "text": "Lì girano i filobus e i tram.",
          "translation": "Туда ходят троллейбусы и трамваи.",
          "source": "Tatoeba #5500262 @dnnywld / #5500164 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500262",
          "cefr_level": "A1",
          "word_slugs": [
            "girano-verb"
          ]
        },
        {
          "id": "5989251",
          "text": "Girano voci che voi due uscite insieme.",
          "translation": "Ходит слух, что вы двое встречаетесь.",
          "source": "Tatoeba #5989251 @dnnywld / #5989225 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5989251",
          "cefr_level": "A1",
          "word_slugs": [
            "girano-verb"
          ]
        },
        {
          "id": "5476904",
          "text": "Gli autobus in città girano in orario. Il prossimo sarà alle 9-30.",
          "translation": "Автобусы в город ходят по расписанию. Ближайший будет в 9-30.",
          "source": "Tatoeba #5476904 @dnnywld / #5475790 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476904",
          "cefr_level": "A1",
          "word_slugs": [
            "girano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "girano",
        "plural": "",
        "infinitive": "girano"
      }
    },
    {
      "slug": "scende-verb",
      "lemma": "scende",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6675,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10790963",
          "text": "L'ascensore scende.",
          "translation": "Лифт спускается.",
          "source": "Tatoeba #10790963 @dnnywld / #10688286 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790963",
          "cefr_level": "A1",
          "word_slugs": [
            "scende-verb"
          ]
        },
        {
          "id": "1647725",
          "text": "L'ascensore sale e scende.",
          "translation": "Лифт поднимается и опускается.",
          "source": "Tatoeba #1647725 @Guybrush88 / #5124420 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1647725",
          "cefr_level": "A1",
          "word_slugs": [
            "scende-verb"
          ]
        },
        {
          "id": "6200590",
          "text": "La pioggia scende incessantemente da due giorni.",
          "translation": "Вторые сутки дождь льёт не переставая.",
          "source": "Tatoeba #6200590 @dnnywld / #6200287 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6200590",
          "cefr_level": "A1",
          "word_slugs": [
            "scende-verb"
          ]
        },
        {
          "id": "5495992",
          "text": "Aspettiamo finché la nave non scende in mare.",
          "translation": "Подождём, пока судно не выйдет в море.",
          "source": "Tatoeba #5495992 @dnnywld / #5495536 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5495992",
          "cefr_level": "A1",
          "word_slugs": [
            "scende-verb"
          ]
        },
        {
          "id": "5614538",
          "text": "È meraviglioso come tutto diventa tranquillo quando scende la neve.",
          "translation": "Удивительно, как тихо становится, когда падает снег.",
          "source": "Tatoeba #5614538 @dnnywld / #4464981 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614538",
          "cefr_level": "A1",
          "word_slugs": [
            "scende-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "scende",
        "plural": "",
        "infinitive": "scende"
      }
    },
