          ]
        },
        {
          "id": "5579957",
          "text": "Il turco è una lingua agglutinante.",
          "translation": "Турецкий — агглютинативный язык.",
          "source": "Tatoeba #5579957 @dnnywld / #5579607 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5579957",
