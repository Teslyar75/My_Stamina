    {
      "slug": "yen-noun",
      "lemma": "Yen",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7221,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "497667",
          "text": "Gli devo 5000 yen.",
          "translation": "Я должен ему пять тысяч иен.",
          "source": "Tatoeba #497667 @giok / #8776655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/497667",
          "cefr_level": "A1",
          "word_slugs": [
            "yen-noun"
          ]
        },
        {
          "id": "3518122",
          "text": "Sono cinquanta yen.",
          "translation": "Пятьдесят иен.",
          "source": "Tatoeba #3518122 @Guybrush88 / #5888924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3518122",
          "cefr_level": "A1",
          "word_slugs": [
            "yen-noun"
          ]
        },
        {
          "id": "5897365",
          "text": "Potete prestarmi cinquecento yen?",
          "translation": "Можете одолжить мне пятьсот иен?",
          "source": "Tatoeba #5897365 @dnnywld / #5897159 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5897365",
          "cefr_level": "A1",
          "word_slugs": [
            "yen-noun"
          ]
        },
        {
          "id": "5846005",
          "text": "In tutto fa tre mila yen.",
          "translation": "Всего получается три тысячи иен.",
          "source": "Tatoeba #5846005 @dnnywld / #5137998 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846005",
          "cefr_level": "A1",
          "word_slugs": [
            "yen-noun"
          ]
        },
        {
          "id": "5527186",
          "text": "Gli devo non meno di 50000 yen.",
          "translation": "Я должен ему не меньше 50000 иен.",
          "source": "Tatoeba #5527186 @dnnywld / #1118451 @Shady_arc (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527186",
          "cefr_level": "A1",
          "word_slugs": [
            "yen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il Yen",
        "plural": "",
        "infinitive": ""
      }
