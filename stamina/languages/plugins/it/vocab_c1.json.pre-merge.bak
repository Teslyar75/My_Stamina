    {
      "slug": "scambiato-verb",
      "lemma": "scambiato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7478,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13495263",
          "text": "Ho scambiato persona.",
          "translation": "Я обознался.",
          "source": "Tatoeba #13495263 @dnnywld / #11340623 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495263",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiato-verb"
          ]
        },
        {
          "id": "5624327",
          "text": "Ho scambiato Tom per suo fratello.",
          "translation": "Я принял Тома за его брата.",
          "source": "Tatoeba #5624327 @dnnywld / #5623430 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624327",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiato-verb"
          ]
        },
        {
          "id": "884133",
          "text": "Lei ha scambiato mio fratello per me.",
          "translation": "Она ошибочно приняла моего брата за меня.",
          "source": "Tatoeba #884133 @Guybrush88 / #1344475 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/884133",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiato-verb"
          ]
        },
        {
          "id": "10931062",
          "text": "Tom è spesso scambiato con il suo gemello.",
          "translation": "Тома часто путают с его братом-близнецом.",
          "source": "Tatoeba #10931062 @dnnywld / #10930934 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10931062",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiato-verb"
          ]
        },
        {
          "id": "5671055",
          "text": "Era chiaro che mi avevano scambiato per qualcun altro.",
          "translation": "Было ясно, что меня приняли за кого-то другого.",
          "source": "Tatoeba #5671055 @dnnywld / #5670373 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5671055",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il scambiato",
        "plural": "",
        "infinitive": "scambiato"
      }
    },
