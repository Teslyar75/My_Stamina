    {
      "slug": "sciopero-noun",
      "lemma": "sciopero",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6824,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6047260",
          "text": "Siamo in sciopero.",
          "translation": "У нас забастовка.",
          "source": "Tatoeba #6047260 @dnnywld / #6046581 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6047260",
          "cefr_level": "A1",
          "word_slugs": [
            "sciopero-noun"
          ]
        },
        {
          "id": "6909202",
          "text": "Lo sciopero è cominciato tre giorni fa.",
          "translation": "Забастовка началась три дня назад.",
          "source": "Tatoeba #6909202 @dnnywld / #6909111 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6909202",
          "cefr_level": "A1",
          "word_slugs": [
            "sciopero-noun"
          ]
        },
        {
          "id": "13495268",
          "text": "Il giorno 29 si terrà uno sciopero generale.",
          "translation": "29-го числа состоится всеобщая забастовка.",
          "source": "Tatoeba #13495268 @dnnywld / #11340611 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495268",
          "cefr_level": "A1",
          "word_slugs": [
            "sciopero-noun"
          ]
        },
        {
          "id": "4721499",
          "text": "Quanto tempo è durato lo sciopero dei minatori?",
          "translation": "Сколько времени продолжилась забастовка шахтёров?",
          "source": "Tatoeba #4721499 @Guybrush88 / #3060611 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4721499",
          "cefr_level": "A1",
          "word_slugs": [
            "sciopero-noun"
          ]
        },
        {
          "id": "5514663",
          "text": "Ho dovuto annullare il viaggio per colpa dello sciopero.",
          "translation": "Мне пришлось отменить поездку из-за забастовки.",
          "source": "Tatoeba #5514663 @dnnywld / #5514604 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514663",
          "cefr_level": "A1",
          "word_slugs": [
            "sciopero-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il sciopero",
        "plural": "",
        "infinitive": ""
      }
