    {
      "slug": "contadini-adj",
      "lemma": "contadini",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7560,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5586061",
          "text": "Durante questa siccità morirono molti contadini.",
          "translation": "Во время этой засухи умерло много крестьян.",
          "source": "Tatoeba #5586061 @dnnywld / #5585924 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586061",
          "cefr_level": "A1",
          "word_slugs": [
            "contadini-adj"
          ]
        },
        {
          "id": "5385284",
          "text": "Al mercato i contadini vendono verdure fresche e frutti.",
          "translation": "На рынке фермеры продают свежие овощи и фрукты.",
          "source": "Tatoeba #5385284 @dnnywld / #5385275 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385284",
          "cefr_level": "A1",
          "word_slugs": [
            "contadini-adj"
          ]
        },
        {
          "id": "5486502",
          "text": "I contadini lavorano ogni giorno dalla mattina presto alla sera tardi.",
          "translation": "Крестьяне работают каждый день с раннего утра до позднего вечера.",
          "source": "Tatoeba #5486502 @dnnywld / #5485178 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5486502",
          "cefr_level": "A1",
          "word_slugs": [
            "contadini-adj"
          ]
        },
        {
          "id": "3025446",
          "text": "I contadini vogliono delle terre, volendo appropriarsi anche delle terre statali.",
          "translation": "Крестьяне хотят земель, желая завладеть также и государственной территорией.",
          "source": "Tatoeba #3025446 @Guybrush88 / #3319802 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3025446",
          "cefr_level": "A1",
          "word_slugs": [
            "contadini-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il contadini",
        "plural": "",
        "infinitive": ""
      }
    },
