    {
      "slug": "prato-name",
      "lemma": "Prato",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6568,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5497661",
          "text": "Tom sta falciando il prato.",
          "translation": "Том стрижёт газон.",
          "source": "Tatoeba #5497661 @dnnywld / #5497648 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497661",
          "cefr_level": "A1",
          "word_slugs": [
            "prato-name"
          ]
        },
        {
          "id": "6372161",
          "text": "Il prato deve essere tagliato.",
          "translation": "Газон нужно постричь.",
          "source": "Tatoeba #6372161 @dnnywld / #6371992 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6372161",
          "cefr_level": "A1",
          "word_slugs": [
            "prato-name"
          ]
        },
        {
          "id": "5472108",
          "text": "Ho falciato il prato di Tom.",
          "translation": "Я стриг газон Тома.",
          "source": "Tatoeba #5472108 @dnnywld / #3615481 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472108",
          "cefr_level": "A1",
          "word_slugs": [
            "prato-name"
          ]
        },
        {
          "id": "6946038",
          "text": "Sul prato pascolano mucche e vitelli.",
          "translation": "На лугу пасутся коровы и телята.",
          "source": "Tatoeba #6946038 @dnnywld / #6945631 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6946038",
          "cefr_level": "A1",
          "word_slugs": [
            "prato-name"
          ]
        },
        {
          "id": "5496780",
          "text": "A Tom piace l'hockey su prato.",
          "translation": "Тому нравится хоккей на траве.",
          "source": "Tatoeba #5496780 @dnnywld / #5496663 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5496780",
          "cefr_level": "A1",
          "word_slugs": [
            "prato-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
