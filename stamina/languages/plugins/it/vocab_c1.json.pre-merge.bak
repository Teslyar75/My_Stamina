    {
      "slug": "rappresentante-noun",
      "lemma": "rappresentante",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5932,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7587857",
          "text": "Sono il rappresentante legale della compagnia.",
          "translation": "Я законный представитель компании.",
          "source": "Tatoeba #7587857 @dnnywld / #7587525 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7587857",
          "cefr_level": "A1",
          "word_slugs": [
            "rappresentante-noun"
          ]
        },
        {
          "id": "5551683",
          "text": "John Locke fu un grande rappresentante dell'empirismo.",
          "translation": "Джон Локк был видным представителем эмпиризма.",
          "source": "Tatoeba #5551683 @dnnywld / #5551603 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551683",
          "cefr_level": "A1",
          "word_slugs": [
            "rappresentante-noun"
          ]
        },
        {
          "id": "5500158",
          "text": "Per informazioni dettagliate vi verrà a trovare il nostro rappresentante.",
          "translation": "Для детальной беседы к вам прибудет наш представитель.",
          "source": "Tatoeba #5500158 @dnnywld / #5499884 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500158",
          "cefr_level": "A1",
          "word_slugs": [
            "rappresentante-noun"
          ]
        }
      ],
      "tags": [
