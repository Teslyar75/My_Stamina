          ]
        },
        {
          "id": "5446308",
          "text": "Sono scappati via da scuola.",
          "translation": "Они сбежали из школы.",
          "source": "Tatoeba #5446308 @dnnywld / #5445071 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5446308",
