    {
      "slug": "riscatto-noun",
      "lemma": "riscatto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6715,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10868321",
          "text": "Tom ha pagato un riscatto.",
          "translation": "Том заплатил выкуп.",
          "source": "Tatoeba #10868321 @dnnywld / #8146978 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10868321",
          "cefr_level": "A1",
          "word_slugs": [
            "riscatto-noun"
          ]
        },
        {
          "id": "10868315",
          "text": "I rapitori chiedono un riscatto.",
          "translation": "Похитители требуют выкуп.",
          "source": "Tatoeba #10868315 @dnnywld / #6724490 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10868315",
          "cefr_level": "A1",
          "word_slugs": [
            "riscatto-noun"
          ]
        },
        {
          "id": "10868319",
          "text": "I rapitori chiedevano un riscatto.",
          "translation": "Похитители требовали выкуп.",
          "source": "Tatoeba #10868319 @dnnywld / #6724491 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10868319",
          "cefr_level": "A1",
          "word_slugs": [
            "riscatto-noun"
          ]
        },
        {
          "id": "10868322",
          "text": "Tom si è rifiutato di pagare il riscatto.",
          "translation": "Том отказался платить выкуп.",
          "source": "Tatoeba #10868322 @dnnywld / #3710287 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10868322",
          "cefr_level": "A1",
          "word_slugs": [
            "riscatto-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il riscatto",
        "plural": "",
        "infinitive": ""
      }
