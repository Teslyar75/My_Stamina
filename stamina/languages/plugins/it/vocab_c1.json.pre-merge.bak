    {
      "slug": "fecero-verb",
      "lemma": "fecero",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7047,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1948382",
          "text": "Fecero la scelta giusta.",
          "translation": "Они сделали правильный выбор.",
          "source": "Tatoeba #1948382 @Guybrush88 / #2229816 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1948382",
          "cefr_level": "A1",
          "word_slugs": [
            "fecero-verb"
          ]
        },
        {
          "id": "1948383",
          "text": "Loro fecero la scelta giusta.",
          "translation": "Они сделали правильный выбор.",
          "source": "Tatoeba #1948383 @Guybrush88 / #2229816 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1948383",
          "cefr_level": "A1",
          "word_slugs": [
            "fecero-verb"
          ]
        },
        {
          "id": "6895177",
          "text": "Le sue parole la fecero piangere.",
          "translation": "Его слова довели её до слёз.",
          "source": "Tatoeba #6895177 @dnnywld / #1591922 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6895177",
          "cefr_level": "A1",
          "word_slugs": [
            "fecero-verb"
          ]
        },
        {
          "id": "6840021",
          "text": "Loro fecero finta di non avermi sentito.",
          "translation": "Они сделали вид, что не слышали меня.",
          "source": "Tatoeba #6840021 @dnnywld / #5141452 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6840021",
          "cefr_level": "A1",
          "word_slugs": [
            "fecero-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "fecero",
