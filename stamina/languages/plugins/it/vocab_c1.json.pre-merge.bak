      "frequency_rank": 5949,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1520818",
          "text": "Chiudete il gas!",
          "translation": "Выключите газ!",
          "source": "Tatoeba #1520818 @Shadd / #3109663 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1520818",
          "cefr_level": "A1",
          "word_slugs": [
            "chiudete-verb"
          ]
        },
        {
          "id": "3412781",
          "text": "Chiudete la porta.",
          "translation": "Закройте дверь.",
          "source": "Tatoeba #3412781 @Guybrush88 / #2339004 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3412781",
          "cefr_level": "A1",
          "word_slugs": [
            "chiudete-verb"
          ]
        },
        {
          "id": "1870751",
          "text": "Chiudete la finestra.",
          "translation": "Закройте окно.",
          "source": "Tatoeba #1870751 @Guybrush88 / #580369 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1870751",
          "cefr_level": "A1",
          "word_slugs": [
            "chiudete-verb"
          ]
        },
        {
          "id": "5842570",
          "text": "Uscendo chiudete la porta.",
          "translation": "Уходя, закройте дверь.",
          "source": "Tatoeba #5842570 @dnnywld / #3069169 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5842570",
          "cefr_level": "A1",
          "word_slugs": [
            "chiudete-verb"
          ]
        },
        {
          "id": "3628796",
          "text": "Chiudete bene tutte le porte e le finestre.",
          "translation": "Хорошенько закройте все двери и окна.",
          "source": "Tatoeba #3628796 @Guybrush88 / #3628809 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3628796",
          "cefr_level": "A1",
          "word_slugs": [
            "chiudete-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
