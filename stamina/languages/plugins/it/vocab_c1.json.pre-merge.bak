      "cefr_level": "C1",
      "frequency_rank": 5254,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6843161",
          "text": "Sto scrivendo il mio testamento.",
          "translation": "Я пишу завещание.",
          "source": "Tatoeba #6843161 @dnnywld / #4653519 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843161",
          "cefr_level": "A1",
          "word_slugs": [
            "testamento-noun"
          ]
        },
        {
          "id": "13612814",
          "text": "È morto senza lasciare un testamento.",
          "translation": "Он умер, не оставив завещания.",
          "source": "Tatoeba #13612814 @dnnywld / #6391522 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13612814",
          "cefr_level": "A1",
          "word_slugs": [
            "testamento-noun"
          ]
        },
        {
          "id": "6585056",
          "text": "Tom non ha firmato il suo testamento.",
          "translation": "Том не подписал своё завещание.",
          "source": "Tatoeba #6585056 @Guybrush88 / #4432829 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6585056",
          "cefr_level": "A1",
          "word_slugs": [
            "testamento-noun"
          ]
        },
        {
          "id": "5679664",
          "text": "L'anno scorso lui ha lasciato il testamento.",
          "translation": "В прошлом году он составил завещание.",
          "source": "Tatoeba #5679664 @dnnywld / #5679620 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5679664",
          "cefr_level": "A1",
          "word_slugs": [
            "testamento-noun"
          ]
        },
        {
          "id": "2689432",
          "text": "Lui ha fatto il suo testamento l'anno scorso.",
          "translation": "Он составил завещание в прошлом году.",
          "source": "Tatoeba #2689432 @Guybrush88 / #3332081 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2689432",
          "cefr_level": "A1",
          "word_slugs": [
            "testamento-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
