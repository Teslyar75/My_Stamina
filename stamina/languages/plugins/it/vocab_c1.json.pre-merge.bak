        {
          "id": "5816387",
          "text": "Riesci ad immaginarti lo splendore di Babele?",
          "translation": "Можешь представить себе великолепие Вавилона?",
          "source": "Tatoeba #5816387 @dnnywld / #5816323 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5816387",
          "cefr_level": "A1",
          "word_slugs": [
            "splendore-noun"
          ]
        },
        {
          "id": "5540912",
          "text": "Bene, guardate - eccolo in tutto il suo splendore!",
          "translation": "Вы только посмотрите – вот он во всей красе!",
          "source": "Tatoeba #5540912 @dnnywld / #5540777 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5540912",
          "cefr_level": "A1",
          "word_slugs": [
            "splendore-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il splendore",
        "plural": "",
        "infinitive": ""
      }
