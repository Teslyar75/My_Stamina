    {
      "slug": "rana-noun",
      "lemma": "rana",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8698,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "лягу́шка"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4538450",
          "text": "La rana gracida.",
          "translation": "Лягушка квакает.",
          "source": "Tatoeba #4538450 @Guybrush88 / #4539143 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4538450",
          "cefr_level": "A1",
          "word_slugs": [
            "rana-noun"
          ]
        },
        {
          "id": "5394186",
          "text": "Lei si trasformò in una rana.",
          "translation": "Она превратилась в лягушку.",
          "source": "Tatoeba #5394186 @dnnywld / #5394149 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5394186",
          "cefr_level": "A1",
          "word_slugs": [
            "rana-noun"
          ]
        },
        {
          "id": "963500",
          "text": "Il ragazzo tirò una pietra alla rana.",
          "translation": "Мальчик бросил камень в лягушку.",
          "source": "Tatoeba #963500 @Cero / #3613819 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/963500",
          "cefr_level": "A1",
          "word_slugs": [
            "rana-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
