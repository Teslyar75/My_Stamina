          ]
        },
        {
          "id": "6788048",
          "text": "In realtà l'hanno avvelenato.",
          "translation": "На самом деле его отравили.",
          "source": "Tatoeba #6788048 @dnnywld / #6683855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6788048",
          "cefr_level": "A1",
