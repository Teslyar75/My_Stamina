    {
      "slug": "guarire-verb",
      "lemma": "guarire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5541,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5724905",
          "text": "Vorrei guarire completamente.",
          "translation": "Я хотел бы полностью выздороветь.",
          "source": "Tatoeba #5724905 @Guybrush88 / #6128101 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5724905",
          "cefr_level": "A1",
          "word_slugs": [
            "guarire-verb"
          ]
        },
        {
          "id": "5571139",
          "text": "Mi ci è voluta una settimana per guarire dal raffreddore.",
          "translation": "Мне потребовалась неделя, чтобы вылечиться от простуды.",
          "source": "Tatoeba #5571139 @dnnywld / #5570722 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571139",
          "cefr_level": "A1",
          "word_slugs": [
            "guarire-verb"
          ]
        },
        {
          "id": "6806309",
          "text": "Nessuna quantità di alcol potrebbe guarire il cuore spezzato di Tom.",
          "translation": "Никакое количество спиртного не могло залечить разбитое сердце Тома.",
          "source": "Tatoeba #6806309 @dnnywld / #6805690 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6806309",
          "cefr_level": "A1",
          "word_slugs": [
            "guarire-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "guarire",
        "plural": "",
        "infinitive": "guarire"
      }
