      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2604843",
          "text": "Il progresso è inevitabile.",
          "translation": "Прогресс неизбежен.",
          "source": "Tatoeba #2604843 @Guybrush88 / #2604852 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2604843",
          "cefr_level": "A1",
