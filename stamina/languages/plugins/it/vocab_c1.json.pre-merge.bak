          ]
        },
        {
          "id": "5384693",
          "text": "Cosa faresti se disponessi di diecimila dollari?",
          "translation": "Что бы ты делал, если б имел десять тысяч долларов?",
          "source": "Tatoeba #5384693 @dnnywld / #5384664 @lemeoejubsmgt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384693",
          "cefr_level": "A1",
          "word_slugs": [
            "diecimila-adj"
          ]
        },
        {
          "id": "10843851",
          "text": "La petizione è stata sottoscritta da più di diecimila persone.",
          "translation": "Петицию подписали более десяти тысяч человек.",
          "source": "Tatoeba #10843851 @dnnywld / #5001672 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10843851",
          "cefr_level": "A1",
          "word_slugs": [
            "diecimila-adj"
          ]
        }
