          ]
        },
        {
          "id": "13601825",
          "text": "Qual è la tua professione?",
          "translation": "Ты кто по профессии?",
          "source": "Tatoeba #13601825 @dnnywld / #13601795 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13601825",
          "cefr_level": "A1",
          "word_slugs": [
            "professione-noun"
          ]
        },
        {
          "id": "5691116",
          "text": "Di professione faccio il poliziotto.",
          "translation": "По профессии я полицейский.",
          "source": "Tatoeba #5691116 @dnnywld / #5690882 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5691116",
          "cefr_level": "A1",
          "word_slugs": [
            "professione-noun"
          ]
        }
