    {
      "slug": "letteratura-noun",
      "lemma": "letteratura",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8002,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "7570217",
          "text": "Domani avrò letteratura.",
          "translation": "Завтра у меня будет литература.",
          "source": "Tatoeba #7570217 @Guybrush88 / #12784198 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7570217",
          "cefr_level": "A1",
          "word_slugs": [
            "letteratura-noun"
          ]
        },
        {
          "id": "5628807",
          "text": "Cos'è la letteratura?",
          "translation": "Что такое литература?",
          "source": "Tatoeba #5628807 @dnnywld / #5628723 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5628807",
          "cefr_level": "A1",
          "word_slugs": [
            "letteratura-noun"
          ]
        },
        {
          "id": "11863278",
          "text": "La letteratura è un'arte?",
          "translation": "Литература - это искусство?",
          "source": "Tatoeba #11863278 @carlosalberto / #11863267 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11863278",
          "cefr_level": "A1",
          "word_slugs": [
            "letteratura-noun"
          ]
        },
        {
          "id": "6839523",
          "text": "Sono interessato alla letteratura francese.",
          "translation": "Я интересуюсь французской литературой.",
          "source": "Tatoeba #6839523 @dnnywld / #6839405 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6839523",
          "cefr_level": "A1",
          "word_slugs": [
            "letteratura-noun"
          ]
        },
        {
          "id": "3414441",
          "text": "Lui conosce bene la letteratura americana.",
          "translation": "Он хорошо знаком с американской литературой.",
          "source": "Tatoeba #3414441 @Guybrush88 / #4386194 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3414441",
          "cefr_level": "A1",
          "word_slugs": [
            "letteratura-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
