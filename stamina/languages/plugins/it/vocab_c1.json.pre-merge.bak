    {
      "slug": "medaglia-noun",
      "lemma": "medaglia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5097,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5974819",
          "text": "Mi hanno assegnato una medaglia.",
          "translation": "Мне вручили медаль.",
          "source": "Tatoeba #5974819 @dnnywld / #5974489 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5974819",
          "cefr_level": "A1",
          "word_slugs": [
            "medaglia-noun"
          ]
        },
        {
          "id": "1757710",
          "text": "Ha vinto una medaglia di bronzo.",
          "translation": "Она завоевала бронзовую медаль.",
          "source": "Tatoeba #1757710 @Guybrush88 / #2401836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1757710",
          "cefr_level": "A1",
          "word_slugs": [
            "medaglia-noun"
          ]
        },
        {
          "id": "1182411",
          "text": "Hanno vinto la medaglia d'argento.",
          "translation": "Они завоевали серебряную медаль.",
          "source": "Tatoeba #1182411 @Guybrush88 / #3145696 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1182411",
          "cefr_level": "A1",
          "word_slugs": [
            "medaglia-noun"
          ]
        },
        {
          "id": "5496793",
          "text": "Questo è il rovescio della medaglia.",
          "translation": "Это оборотная сторона медали.",
          "source": "Tatoeba #5496793 @dnnywld / #5496621 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5496793",
          "cefr_level": "A1",
          "word_slugs": [
            "medaglia-noun"
          ]
        },
        {
          "id": "5433546",
          "text": "Tom ha vinto una medaglia d'oro.",
          "translation": "Том выиграл золотую медаль.",
          "source": "Tatoeba #5433546 @dnnywld / #5432973 @sikmir (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5433546",
          "cefr_level": "A1",
          "word_slugs": [
            "medaglia-noun"
          ]
        }
