    {
      "slug": "elettrico-adj",
      "lemma": "elettrico",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7204,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5534218",
          "text": "Il cavo elettrico era danneggiato.",
          "translation": "Электрический кабель был повреждён.",
          "source": "Tatoeba #5534218 @dnnywld / #5533953 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5534218",
          "cefr_level": "A1",
          "word_slugs": [
            "elettrico-adj"
          ]
        },
        {
          "id": "5392961",
          "text": "Questo forno elettrico ha solo due fuochi.",
          "translation": "У этой электрической плиты всего две конфорки.",
          "source": "Tatoeba #5392961 @dnnywld / #4330800 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5392961",
          "cefr_level": "A1",
          "word_slugs": [
            "elettrico-adj"
          ]
        },
        {
          "id": "6161818",
          "text": "Ritengo che l'apriscatole elettrico sia anche una buona invenzione.",
          "translation": "Я считаю, что электрический консервный нож — тоже хорошее изобретение.",
          "source": "Tatoeba #6161818 @dnnywld / #6161803 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6161818",
          "cefr_level": "A1",
          "word_slugs": [
            "elettrico-adj"
          ]
        },
        {
          "id": "10798966",
          "text": "Fu stabilito che un collegamento elettrico difettoso era la causa dell'incendio.",
          "translation": "Было установлено, что причиной пожара стало неправильное электрическое соединение.",
          "source": "Tatoeba #10798966 @dnnywld / #710050 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10798966",
          "cefr_level": "A1",
          "word_slugs": [
            "elettrico-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il elettrico",
        "plural": "",
        "infinitive": ""
      }
    },
