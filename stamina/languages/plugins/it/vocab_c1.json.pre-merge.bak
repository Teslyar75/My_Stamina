    {
      "slug": "ingannare-verb",
      "lemma": "ingannare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6627,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6100636",
          "text": "Smettila di ingannare te stesso.",
          "translation": "Перестань себя обманывать.",
          "source": "Tatoeba #6100636 @dnnywld / #6100587 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6100636",
          "cefr_level": "A1",
          "word_slugs": [
            "ingannare-verb"
          ]
        },
        {
          "id": "7047773",
          "text": "Non cercare di ingannare la morte.",
          "translation": "Не пытайся обмануть смерть.",
          "source": "Tatoeba #7047773 @dnnywld / #7047703 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7047773",
          "cefr_level": "A1",
          "word_slugs": [
            "ingannare-verb"
          ]
        },
        {
          "id": "5385586",
          "text": "Non va bene ingannare le persone così.",
          "translation": "Нехорошо так людей обманывать.",
          "source": "Tatoeba #5385586 @dnnywld / #5384153 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5385586",
          "cefr_level": "A1",
          "word_slugs": [
            "ingannare-verb"
          ]
        },
        {
          "id": "6004676",
          "text": "Ci risulta facile ingannare colui che amiamo.",
          "translation": "Нас легко обмануть тем, кого мы любим.",
          "source": "Tatoeba #6004676 @dnnywld / #6004082 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6004676",
          "cefr_level": "A1",
          "word_slugs": [
            "ingannare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ingannare",
        "plural": "",
        "infinitive": "ingannare"
      }
