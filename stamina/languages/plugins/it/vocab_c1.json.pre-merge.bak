          "cefr_level": "A1",
          "word_slugs": [
            "maggio-adj"
          ]
        },
        {
          "id": "3219683",
          "text": "Domani è il primo maggio.",
          "translation": "Завтра первое мая.",
          "source": "Tatoeba #3219683 @Guybrush88 / #3219800 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3219683",
