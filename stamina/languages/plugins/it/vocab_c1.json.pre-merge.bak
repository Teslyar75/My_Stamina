    {
      "slug": "sostenere-verb",
      "lemma": "sostenere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5372,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6799567",
          "text": "In gennaio devo sostenere un esame.",
          "translation": "В январе мне нужно сдавать экзамен.",
          "source": "Tatoeba #6799567 @dnnywld / #5351320 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799567",
          "cefr_level": "A1",
          "word_slugs": [
            "sostenere-verb"
          ]
        },
        {
          "id": "1053313",
          "text": "Devo sostenere l'esame di ingresso oggi.",
          "translation": "Я должен сдавать вступительный экзамен сегодня.",
          "source": "Tatoeba #1053313 @Guybrush88 / #470369 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1053313",
          "cefr_level": "A1",
          "word_slugs": [
            "sostenere-verb"
          ]
        },
        {
          "id": "5408436",
          "text": "Tom non è in grado di sostenere una conversazione.",
          "translation": "Том не умеет поддерживать беседу.",
          "source": "Tatoeba #5408436 @dnnywld / #4443100 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408436",
          "cefr_level": "A1",
          "word_slugs": [
            "sostenere-verb"
          ]
        },
        {
          "id": "6799578",
          "text": "Gli studenti sono autorizzati a sostenere alcuni esami in anticipo.",
          "translation": "Некоторые экзамены студентам разрешается сдавать досрочно.",
          "source": "Tatoeba #6799578 @dnnywld / #5873320 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799578",
          "cefr_level": "A1",
          "word_slugs": [
            "sostenere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sostenere",
        "plural": "",
        "infinitive": "sostenere"
      }
