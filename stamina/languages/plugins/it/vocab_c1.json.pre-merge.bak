    {
      "slug": "tabacco-noun",
      "lemma": "tabacco",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9149,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "табак",
          "табачок"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "10791131",
          "text": "Il tabacco provoca assuefazione.",
          "translation": "Табак вызывает привыкание.",
          "source": "Tatoeba #10791131 @dnnywld / #8413392 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10791131",
          "cefr_level": "A1",
          "word_slugs": [
            "tabacco-noun"
          ]
        },
        {
          "id": "6893467",
          "text": "Vi sarà difficile procurarvi del tabacco da pipa qui.",
          "translation": "Вам будет трудно доставать здесь трубочный табак.",
          "source": "Tatoeba #6893467 @dnnywld / #2820730 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893467",
          "cefr_level": "A1",
          "word_slugs": [
            "tabacco-noun"
          ]
        },
        {
          "id": "13619537",
          "text": "Esiste una relazione tra il tabacco e il cancro ai polmoni?",
          "translation": "Существует ли связь между табаком и раком лёгких?",
          "source": "Tatoeba #13619537 @dnnywld / #6391362 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13619537",
          "cefr_level": "A1",
          "word_slugs": [
            "tabacco-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tabacco",
        "plural": "",
        "infinitive": ""
      }
    },
