      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5883,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10857878",
          "text": "Alcune persone hanno cercato di sfondare attraverso il perimetro.",
          "translation": "Несколько человек попытались прорваться сквозь оцепление.",
          "source": "Tatoeba #10857878 @dnnywld / #10857715 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10857878",
          "cefr_level": "A1",
          "word_slugs": [
            "perimetro-noun"
          ]
        },
        {
          "id": "6953821",
          "text": "Il perimetro della prigione è circondato da una grande recinzione.",
          "translation": "Периметр тюрьмы обнесён большим забором.",
          "source": "Tatoeba #6953821 @dnnywld / #4425810 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953821",
          "cefr_level": "A1",
          "word_slugs": [
            "perimetro-noun"
          ]
        }
      ],
