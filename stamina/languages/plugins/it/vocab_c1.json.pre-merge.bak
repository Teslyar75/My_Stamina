    {
      "slug": "costituzione-noun",
      "lemma": "costituzione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8754,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6316056",
          "text": "È vietato violare la costituzione.",
          "translation": "Нельзя нарушать конституцию.",
          "source": "Tatoeba #6316056 @dnnywld / #6315956 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6316056",
          "cefr_level": "A1",
          "word_slugs": [
            "costituzione-noun"
          ]
        },
        {
          "id": "10844409",
          "text": "Deve essere autorizzato dalla costituzione.",
          "translation": "Это должно быть прописано в конституции.",
          "source": "Tatoeba #10844409 @dnnywld / #7276760 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10844409",
          "cefr_level": "A1",
          "word_slugs": [
            "costituzione-noun"
          ]
        },
        {
          "id": "1969478",
          "text": "L'uguaglianza è garantita dalla Costituzione.",
          "translation": "Равенство гарантируется конституцией.",
          "source": "Tatoeba #1969478 @sixtynine / #1969442 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1969478",
          "cefr_level": "A1",
          "word_slugs": [
            "costituzione-noun"
          ]
        },
        {
          "id": "5738857",
          "text": "Spero che il Giappone osservi la sua costituzione.",
          "translation": "Надеюсь, Япония будет придерживаться своей конституции.",
          "source": "Tatoeba #5738857 @dnnywld / #2596473 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5738857",
          "cefr_level": "A1",
          "word_slugs": [
            "costituzione-noun"
          ]
        },
        {
          "id": "6316055",
          "text": "È vietato manipolare la costituzione per propri scopi.",
          "translation": "Нельзя подминать под себя конституцию.",
          "source": "Tatoeba #6316055 @dnnywld / #6315959 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6316055",
          "cefr_level": "A1",
          "word_slugs": [
            "costituzione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la costituzione",
        "plural": "",
        "infinitive": ""
      }
    },
