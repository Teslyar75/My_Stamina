          ]
        },
        {
          "id": "10851834",
          "text": "È uno scoiattolo.",
          "translation": "Это белка.",
          "source": "Tatoeba #10851834 @dnnywld / #5966589 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851834",
          "cefr_level": "A1",
          "word_slugs": [
            "scoiattolo-noun"
          ]
        },
        {
          "id": "4880536",
          "text": "Guarda, uno scoiattolo!",
          "translation": "Смотри, белка!",
          "source": "Tatoeba #4880536 @Guybrush88 / #5143588 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4880536",
          "cefr_level": "A1",
