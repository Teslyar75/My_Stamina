    {
      "slug": "ritirato-adj",
      "lemma": "ritirato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6930,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11856759",
