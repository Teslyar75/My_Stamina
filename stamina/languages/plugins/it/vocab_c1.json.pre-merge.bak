      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10851526",
          "text": "Non posso mangiare arachidi.",
          "translation": "Мне нельзя арахис.",
          "source": "Tatoeba #10851526 @dnnywld / #3285827 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851526",
          "cefr_level": "A1",
          "word_slugs": [
            "arachidi-noun"
          ]
        },
        {
          "id": "5591646",
          "text": "Questo è burro di arachidi?",
          "translation": "Это арахисовое масло?",
          "source": "Tatoeba #5591646 @dnnywld / #5590532 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5591646",
          "cefr_level": "A1",
          "word_slugs": [
            "arachidi-noun"
          ]
        },
        {
          "id": "10851527",
          "text": "Tom non può mangiare arachidi.",
          "translation": "Тому нельзя арахис.",
          "source": "Tatoeba #10851527 @dnnywld / #5587520 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851527",
          "cefr_level": "A1",
          "word_slugs": [
            "arachidi-noun"
          ]
        },
        {
          "id": "5681352",
          "text": "Ti piace il burro di arachidi?",
          "translation": "Тебе нравится арахисовое масло?",
          "source": "Tatoeba #5681352 @dnnywld / #5681260 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5681352",
          "cefr_level": "A1",
          "word_slugs": [
            "arachidi-noun"
          ]
        },
        {
          "id": "5967240",
          "text": "Dicono che le arachidi siano un afrodisiaco.",
          "translation": "Говорят, арахис - афродизиак.",
          "source": "Tatoeba #5967240 @dnnywld / #5967225 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5967240",
          "cefr_level": "A1",
          "word_slugs": [
            "arachidi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
