    {
      "slug": "camino-noun",
      "lemma": "camino",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9152,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "997327",
          "text": "Possiamo accendere il camino?",
          "translation": "Можно мы разожжём камин?",
          "source": "Tatoeba #997327 @Guybrush88 / #3109559 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/997327",
          "cefr_level": "A1",
          "word_slugs": [
            "camino-noun"
          ]
        },
        {
          "id": "10754506",
          "text": "Il fumo usciva dal camino.",
          "translation": "Дым выходил из трубы.",
          "source": "Tatoeba #10754506 @dnnywld / #990011 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754506",
          "cefr_level": "A1",
          "word_slugs": [
            "camino-noun"
          ]
        },
        {
          "id": "6882827",
          "text": "Vai a riscaldarti vicino al camino.",
          "translation": "Иди погрейся у камина.",
          "source": "Tatoeba #6882827 @dnnywld / #6882479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6882827",
          "cefr_level": "A1",
          "word_slugs": [
            "camino-noun"
          ]
        },
        {
          "id": "6882825",
          "text": "Andate a riscaldarvi vicino al camino.",
          "translation": "Идите погрейтесь у камина.",
          "source": "Tatoeba #6882825 @dnnywld / #6882480 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6882825",
          "cefr_level": "A1",
          "word_slugs": [
            "camino-noun"
          ]
        },
        {
          "id": "6000714",
          "text": "Tom bruciò tutte le lettere nel camino.",
          "translation": "Том сжёг все письма в камине.",
          "source": "Tatoeba #6000714 @dnnywld / #5999884 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6000714",
          "cefr_level": "A1",
          "word_slugs": [
            "camino-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il camino",
        "plural": "",
        "infinitive": ""
      }
