    {
      "slug": "agnello-noun",
      "lemma": "agnello",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8156,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "872051",
          "text": "È un lupo vestito da agnello.",
          "translation": "Он волк в овечьей шкуре.",
          "source": "Tatoeba #872051 @riccioberto / #1055809 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/872051",
          "cefr_level": "A1",
          "word_slugs": [
            "agnello-noun"
          ]
        },
        {
          "id": "6920939",
          "text": "Guardati dal lupo travestito da agnello.",
          "translation": "Берегись волка в овечьей шкуре.",
          "source": "Tatoeba #6920939 @dnnywld / #6920491 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6920939",
          "cefr_level": "A1",
          "word_slugs": [
            "agnello-noun"
          ]
        },
        {
          "id": "6946026",
          "text": "Sul prato pascolano un agnello, una pecorella e un agnellino.",
          "translation": "На лугу пасутся барашек, овечка и ягнята.",
          "source": "Tatoeba #6946026 @dnnywld / #6945635 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6946026",
          "cefr_level": "A1",
          "word_slugs": [
            "agnello-noun"
          ]
        },
        {
          "id": "5514538",
          "text": "Voglio ordinare qualche piatto a base di carne, meglio non d'agnello.",
          "translation": "Я хочу заказать что-нибудь из мяса, лучше из баранины.",
          "source": "Tatoeba #5514538 @dnnywld / #5514452 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5514538",
          "cefr_level": "A1",
          "word_slugs": [
            "agnello-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il agnello",
        "plural": "",
        "infinitive": ""
      }
