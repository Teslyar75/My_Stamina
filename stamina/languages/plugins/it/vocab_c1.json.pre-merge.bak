    {
      "slug": "eccezione-noun",
      "lemma": "eccezione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5460,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5613769",
          "text": "Non potresti fare un'eccezione?",
          "translation": "Не мог бы ты сделать исключение?",
          "source": "Tatoeba #5613769 @dnnywld / #2877306 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5613769",
          "cefr_level": "A1",
          "word_slugs": [
            "eccezione-noun"
          ]
        },
        {
          "id": "2769851",
          "text": "Farò un'eccezione solo per questa volta.",
          "translation": "Я сделаю исключение только в этот раз.",
          "source": "Tatoeba #2769851 @Guybrush88 / #5947225 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2769851",
          "cefr_level": "A1",
          "word_slugs": [
            "eccezione-noun"
          ]
        },
        {
          "id": "5552120",
          "text": "Non sono un misogino, ma per te faccio un'eccezione.",
          "translation": "Я не женоненавистник, но для тебя сделаю исключение.",
          "source": "Tatoeba #5552120 @dnnywld / #5551896 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5552120",
          "cefr_level": "A1",
          "word_slugs": [
            "eccezione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la eccezione",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "maglia-noun",
      "lemma": "maglia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5461,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2191136",
          "text": "Tom lavora a maglia.",
          "translation": "Том вяжет.",
          "source": "Tatoeba #2191136 @Guybrush88 / #3478559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2191136",
          "cefr_level": "A1",
          "word_slugs": [
            "maglia-noun"
          ]
        },
        {
          "id": "2010371",
          "text": "Mi piace la sua maglia.",
          "translation": "Мне нравится ваша рубашка.",
          "source": "Tatoeba #2010371 @Guybrush88 / #2664858 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2010371",
          "cefr_level": "A1",
          "word_slugs": [
            "maglia-noun"
          ]
        },
        {
          "id": "6886206",
          "text": "Lavoro a maglia ogni giorno.",
          "translation": "Я вяжу каждый день.",
          "source": "Tatoeba #6886206 @dnnywld / #6885967 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886206",
          "cefr_level": "A1",
          "word_slugs": [
            "maglia-noun"
          ]
        },
        {
          "id": "7327039",
          "text": "Tom vuole imparare a lavorare a maglia.",
          "translation": "Том хочет научиться вязать.",
          "source": "Tatoeba #7327039 @dnnywld / #7326082 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7327039",
          "cefr_level": "A1",
          "word_slugs": [
            "maglia-noun"
          ]
        },
        {
          "id": "5391394",
          "text": "Mary posò il lavoro a maglia e si alzò.",
          "translation": "Мэри отложила вязание и встала.",
          "source": "Tatoeba #5391394 @dnnywld / #3860020 @TheWyld (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5391394",
          "cefr_level": "A1",
          "word_slugs": [
            "maglia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la maglia",
        "plural": "",
        "infinitive": ""
      }
    },
