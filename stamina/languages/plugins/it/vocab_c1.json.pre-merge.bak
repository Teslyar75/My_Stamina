    {
      "slug": "permetti-verb",
      "lemma": "permetti",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5364,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5828010",
          "text": "Se permetti, continuo.",
          "translation": "Если позволишь, я продолжу.",
          "source": "Tatoeba #5828010 @dnnywld / #5038890 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5828010",
          "cefr_level": "A1",
          "word_slugs": [
            "permetti-verb"
          ]
        },
        {
          "id": "5399913",
          "text": "Permetti ai ragazzi di giocare.",
          "translation": "Позволь детям поиграть.",
          "source": "Tatoeba #5399913 @dnnywld / #5399871 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5399913",
          "cefr_level": "A1",
          "word_slugs": [
            "permetti-verb"
          ]
        },
        {
          "id": "5555727",
          "text": "Come ti permetti di darmi del razzista?",
          "translation": "Как ты смеешь называть меня расистом?",
          "source": "Tatoeba #5555727 @dnnywld / #5555006 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5555727",
          "cefr_level": "A1",
          "word_slugs": [
            "permetti-verb"
          ]
        },
        {
          "id": "5555496",
          "text": "Come ti permetti di darmi dello stupido?",
          "translation": "Как ты смеешь называть меня тупым?",
          "source": "Tatoeba #5555496 @dnnywld / #5555028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5555496",
          "cefr_level": "A1",
          "word_slugs": [
            "permetti-verb"
          ]
        },
        {
          "id": "5555658",
          "text": "Come ti permetti di darmi del poveretto?",
          "translation": "Как ты смеешь называть меня бедным?",
