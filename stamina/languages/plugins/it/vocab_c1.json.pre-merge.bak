    {
      "slug": "impaziente-adj",
      "lemma": "impaziente",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8808,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2022773",
          "text": "Papà è impaziente oggi.",
          "translation": "Папа сегодня нервничает.",
          "source": "Tatoeba #2022773 @AYDYL84 / #4104363 @Ananstasia (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2022773",
          "cefr_level": "A1",
          "word_slugs": [
            "impaziente-adj"
          ]
        },
        {
          "id": "6969598",
          "text": "Tom è impaziente di farlo, vero?",
          "translation": "Тому ведь не терпится это сделать?",
          "source": "Tatoeba #6969598 @dnnywld / #6969400 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6969598",
          "cefr_level": "A1",
          "word_slugs": [
            "impaziente-adj"
          ]
        },
        {
          "id": "5629842",
          "text": "Sono impaziente di vedere tuo padre.",
          "translation": "Мне не терпится увидеть твоего отца.",
          "source": "Tatoeba #5629842 @dnnywld / #5628809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629842",
          "cefr_level": "A1",
          "word_slugs": [
            "impaziente-adj"
          ]
        },
        {
          "id": "5629826",
          "text": "Sono impaziente di vedere vostro padre.",
          "translation": "Мне не терпится увидеть вашего отца.",
          "source": "Tatoeba #5629826 @dnnywld / #5628811 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629826",
          "cefr_level": "A1",
          "word_slugs": [
            "impaziente-adj"
          ]
        },
        {
          "id": "5387724",
          "text": "Tom è impaziente di parlare con Mary.",
          "translation": "Тому не терпится поговорить с Мэри.",
          "source": "Tatoeba #5387724 @dnnywld / #5387295 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387724",
          "cefr_level": "A1",
          "word_slugs": [
            "impaziente-adj"
          ]
        }
      ],
