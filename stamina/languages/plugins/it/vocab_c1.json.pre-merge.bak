    {
      "slug": "attivo-verb",
      "lemma": "attivo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5869,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5522393",
          "text": "Non sono attivo come mio fratello.",
          "translation": "Я не так активен, как мой брат.",
          "source": "Tatoeba #5522393 @dnnywld / #5522360 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5522393",
          "cefr_level": "A1",
          "word_slugs": [
            "attivo-verb"
          ]
        },
        {
          "id": "5452990",
          "text": "Attualmente questo gruppo è molto attivo.",
          "translation": "В настоящее время эта группа очень активна.",
          "source": "Tatoeba #5452990 @dnnywld / #381048 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452990",
          "cefr_level": "A1",
          "word_slugs": [
            "attivo-verb"
          ]
        },
        {
          "id": "5573551",
          "text": "Il vulcano non è attivo da tanto tempo.",
          "translation": "Вулкан уже давно неактивен.",
          "source": "Tatoeba #5573551 @dnnywld / #5365044 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5573551",
          "cefr_level": "A1",
          "word_slugs": [
            "attivo-verb"
          ]
        },
        {
          "id": "5584397",
          "text": "Lui ha giocato un ruolo attivo nella rivoluzione.",
          "translation": "Он принимал активное участие в революции.",
          "source": "Tatoeba #5584397 @dnnywld / #5584331 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5584397",
          "cefr_level": "A1",
          "word_slugs": [
            "attivo-verb"
          ]
        },
        {
          "id": "1607424",
          "text": "Il nonno è ancora molto attivo per la sua età.",
          "translation": "Дедушка всё ещё очень активен для своего возраста.",
          "source": "Tatoeba #1607424 @hitori37 / #3061489 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1607424",
          "cefr_level": "A1",
          "word_slugs": [
            "attivo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
