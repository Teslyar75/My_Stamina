    {
      "slug": "economica-adj",
      "lemma": "economica",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7248,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11174461",
          "text": "È una motocicletta economica.",
          "translation": "Это недорогой мотоцикл.",
          "source": "Tatoeba #11174461 @dnnywld / #11174357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11174461",
          "cefr_level": "A1",
          "word_slugs": [
            "economica-adj"
          ]
        },
        {
          "id": "762844",
          "text": "Ha molta conoscenza economica.",
          "translation": "Его познания в экономике глубоки.",
          "source": "Tatoeba #762844 @Guybrush88 / #872500 @Hotaru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/762844",
          "cefr_level": "A1",
          "word_slugs": [
            "economica-adj"
          ]
        },
        {
          "id": "6879743",
          "text": "L'edizione tascabile è più economica.",
          "translation": "Карманное издание дешевле.",
          "source": "Tatoeba #6879743 @dnnywld / #6879594 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6879743",
          "cefr_level": "A1",
          "word_slugs": [
            "economica-adj"
          ]
        },
        {
          "id": "3067300",
          "text": "La crisi attuale non è solo di natura economica.",
          "translation": "Нынешний кризис – не только экономический.",
          "source": "Tatoeba #3067300 @al_ex_an_der / #3067296 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3067300",
          "cefr_level": "A1",
          "word_slugs": [
            "economica-adj"
          ]
        },
        {
          "id": "5978399",
          "text": "La Grecia sta patendo una crisi economica e sociale.",
          "translation": "Греция переживает экономический и социальный кризис.",
          "source": "Tatoeba #5978399 @dnnywld / #5978377 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5978399",
          "cefr_level": "A1",
          "word_slugs": [
            "economica-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
