    {
      "slug": "vadano-verb",
      "lemma": "vadano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5937,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5644995",
          "text": "È quasi ora che vadano.",
          "translation": "Им уже почти пора ехать.",
          "source": "Tatoeba #5644995 @dnnywld / #5644912 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5644995",
          "cefr_level": "A1",
          "word_slugs": [
            "vadano-verb"
          ]
        },
        {
          "id": "10857771",
          "text": "Che vadano tutti al diavolo!",
          "translation": "Чёрт бы их всех побрал!",
          "source": "Tatoeba #10857771 @dnnywld / #10857762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10857771",
          "cefr_level": "A1",
          "word_slugs": [
            "vadano-verb"
          ]
        },
        {
          "id": "5868461",
          "text": "Sembra che le cosa vadano bene.",
          "translation": "Похоже, что дела идут хорошо.",
          "source": "Tatoeba #5868461 @dnnywld / #5783826 @Meka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868461",
          "cefr_level": "A1",
          "word_slugs": [
            "vadano-verb"
          ]
        },
        {
          "id": "6367790",
          "text": "Sto aspettando che tutti se ne vadano.",
          "translation": "Я жду, чтобы все ушли.",
          "source": "Tatoeba #6367790 @dnnywld / #6366920 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367790",
          "cefr_level": "A1",
          "word_slugs": [
            "vadano-verb"
          ]
        },
        {
          "id": "6797223",
          "text": "È ora che i bambini vadano a dormire.",
          "translation": "Детям пора ложиться спать.",
          "source": "Tatoeba #6797223 @dnnywld / #6024251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797223",
          "cefr_level": "A1",
          "word_slugs": [
            "vadano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "vadano",
        "plural": "",
        "infinitive": "vadano"
      }
