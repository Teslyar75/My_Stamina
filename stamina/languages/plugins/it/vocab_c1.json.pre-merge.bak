    {
      "slug": "volontari-adj",
      "lemma": "volontari",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7649,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6843068",
          "text": "Si richiedono volontari.",
          "translation": "Требуются добровольцы.",
          "source": "Tatoeba #6843068 @dnnywld / #4749791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843068",
          "cefr_level": "A1",
          "word_slugs": [
            "volontari-adj"
          ]
        },
        {
          "id": "7560461",
          "text": "Tom sta cercando volontari.",
          "translation": "Том ищет добровольцев.",
          "source": "Tatoeba #7560461 @dnnywld / #7559503 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7560461",
          "cefr_level": "A1",
          "word_slugs": [
            "volontari-adj"
          ]
        },
        {
          "id": "10917135",
          "text": "I volontari aiutano i professionisti.",
          "translation": "Профессионалам помогают добровольцы.",
          "source": "Tatoeba #10917135 @dnnywld / #6571984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10917135",
          "cefr_level": "A1",
          "word_slugs": [
            "volontari-adj"
          ]
        },
        {
          "id": "6843077",
          "text": "C'è un forte bisogno di volontari.",
          "translation": "Срочно требуются добровольцы.",
          "source": "Tatoeba #6843077 @dnnywld / #3624243 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843077",
          "cefr_level": "A1",
          "word_slugs": [
            "volontari-adj"
          ]
        },
        {
          "id": "6533376",
          "text": "Tom ha detto che stava cercando più volontari.",
          "translation": "Том сказал, что ищет ещё добровольцев.",
          "source": "Tatoeba #6533376 @Guybrush88 / #6858739 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6533376",
          "cefr_level": "A1",
          "word_slugs": [
            "volontari-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il volontari",
        "plural": "",
        "infinitive": ""
      }
