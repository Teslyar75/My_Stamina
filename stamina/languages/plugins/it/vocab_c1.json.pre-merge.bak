    {
      "slug": "odiano-verb",
      "lemma": "odiano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5727,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2863551",
          "text": "Non la odiano.",
          "translation": "Они Вас не ненавидят.",
          "source": "Tatoeba #2863551 @Guybrush88 / #3350808 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2863551",
          "cefr_level": "A1",
          "word_slugs": [
            "odiano-verb"
          ]
        },
        {
          "id": "4599890",
          "text": "Odiano le donne.",
          "translation": "Они ненавидят женщин.",
          "source": "Tatoeba #4599890 @Guybrush88 / #2342572 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4599890",
          "cefr_level": "A1",
          "word_slugs": [
            "odiano-verb"
          ]
        },
        {
          "id": "6893966",
          "text": "Ti odiano tutti.",
          "translation": "Тебя все ненавидят.",
          "source": "Tatoeba #6893966 @dnnywld / #6893158 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893966",
          "cefr_level": "A1",
          "word_slugs": [
            "odiano-verb"
          ]
        },
        {
          "id": "6893981",
          "text": "Vi odiano tutti.",
          "translation": "Вас все ненавидят.",
          "source": "Tatoeba #6893981 @dnnywld / #6893157 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893981",
          "cefr_level": "A1",
          "word_slugs": [
            "odiano-verb"
          ]
        },
        {
          "id": "3192019",
          "text": "Perché ci odiano?",
          "translation": "Почему они нас ненавидят?",
          "source": "Tatoeba #3192019 @Guybrush88 / #3192126 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3192019",
          "cefr_level": "A1",
          "word_slugs": [
            "odiano-verb"
          ]
        }
      ],
