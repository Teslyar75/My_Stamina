        },
        {
          "id": "3695179",
          "text": "Io peso oltre duecento chili.",
          "translation": "Я вешу больше двухсот килограмм.",
          "source": "Tatoeba #3695179 @Guybrush88 / #3695370 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3695179",
          "cefr_level": "A1",
          "word_slugs": [
            "duecento-adj"
          ]
        },
        {
          "id": "1826937",
          "text": "Duecento dollari sono molti per me.",
