    {
      "slug": "leoni-noun",
      "lemma": "leoni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8799,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5476498",
          "text": "Ho parlato sui leoni.",
          "translation": "Я говорил о львах.",
          "source": "Tatoeba #5476498 @dnnywld / #5476009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476498",
          "cefr_level": "A1",
          "word_slugs": [
            "leoni-noun"
          ]
        },
        {
          "id": "5605859",
          "text": "I leoni sono nella gabbia.",
          "translation": "Львы в клетке.",
          "source": "Tatoeba #5605859 @Hachiko / #2283251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5605859",
          "cefr_level": "A1",
          "word_slugs": [
            "leoni-noun"
          ]
        },
        {
          "id": "9674441",
          "text": "I leoni mangiano il pesce?",
          "translation": "Львы едят рыбу?",
          "source": "Tatoeba #9674441 @Nuel / #9925570 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9674441",
          "cefr_level": "A1",
          "word_slugs": [
            "leoni-noun"
          ]
        },
        {
          "id": "628869",
          "text": "In Africa ci sono molti leoni.",
          "translation": "В Африке много львов.",
          "source": "Tatoeba #628869 @rado / #628875 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/628869",
          "cefr_level": "A1",
          "word_slugs": [
            "leoni-noun"
          ]
        },
        {
          "id": "992998",
          "text": "Lavoro come addestratore di leoni in un circo.",
          "translation": "Я работаю дрессировщиком львов в цирке.",
          "source": "Tatoeba #992998 @Guybrush88 / #3233791 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/992998",
          "cefr_level": "A1",
          "word_slugs": [
            "leoni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il leoni",
        "plural": "",
        "infinitive": ""
      }
