    {
      "slug": "sentirà-verb",
      "lemma": "sentirà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9175,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6444268",
          "text": "Tom sentirà la mia mancanza.",
          "translation": "Том будет по мне скучать.",
          "source": "Tatoeba #6444268 @dnnywld / #6443821 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6444268",
          "cefr_level": "A1",
          "word_slugs": [
            "sentirà-verb"
          ]
        },
        {
          "id": "6893516",
          "text": "Tom sentirà molto la tua mancanza.",
          "translation": "Том будет очень по тебе скучать.",
          "source": "Tatoeba #6893516 @dnnywld / #6893393 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893516",
          "cefr_level": "A1",
          "word_slugs": [
            "sentirà-verb"
          ]
        },
        {
          "id": "5455761",
          "text": "Tom si sentirà meglio molto presto.",
          "translation": "Тому совсем скоро станет лучше.",
          "source": "Tatoeba #5455761 @dnnywld / #5455065 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5455761",
          "cefr_level": "A1",
          "word_slugs": [
            "sentirà-verb"
          ]
        },
        {
          "id": "6893515",
          "text": "Tom sentirà molto la vostra mancanza.",
          "translation": "Том будет очень по вам скучать.",
          "source": "Tatoeba #6893515 @dnnywld / #6893394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893515",
          "cefr_level": "A1",
          "word_slugs": [
            "sentirà-verb"
          ]
        },
        {
          "id": "5949307",
          "text": "Sono sicuro che Tom sentirà la mancanza di Mary.",
          "translation": "Я уверен, что Том будет скучать по Мэри.",
          "source": "Tatoeba #5949307 @dnnywld / #5949186 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5949307",
          "cefr_level": "A1",
          "word_slugs": [
            "sentirà-verb"
          ]
        }
      ],
