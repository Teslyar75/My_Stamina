    {
      "slug": "riconoscimento-noun",
      "lemma": "riconoscimento",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6207,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5409224",
          "text": "Grazie per il riconoscimento.",
          "translation": "Благодарю за признание.",
          "source": "Tatoeba #5409224 @dnnywld / #3391057 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5409224",
          "cefr_level": "A1",
          "word_slugs": [
            "riconoscimento-noun"
          ]
        },
        {
          "id": "1692854",
          "text": "Tom non ha mai ricevuto un riconoscimento.",
          "translation": "Том так и не получил приз.",
          "source": "Tatoeba #1692854 @Guybrush88 / #6884023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1692854",
          "cefr_level": "A1",
          "word_slugs": [
            "riconoscimento-noun"
          ]
        },
        {
          "id": "5415777",
          "text": "Per favore utilizzate il riconoscimento vocale automatico.",
          "translation": "Пожалуйста, используйте автоматическое распознавание речи!",
          "source": "Tatoeba #5415777 @dnnywld / #3100149 @Khvalovsky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415777",
          "cefr_level": "A1",
          "word_slugs": [
            "riconoscimento-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il riconoscimento",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "bastano-verb",
      "lemma": "bastano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6208,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5432036",
          "text": "Vi bastano le sedie?",
          "translation": "У нас хватает стульев?",
          "source": "Tatoeba #5432036 @dnnywld / #5431911 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5432036",
          "cefr_level": "A1",
          "word_slugs": [
            "bastano-verb"
          ]
        },
        {
          "id": "3339129",
          "text": "Due francobolli non bastano.",
          "translation": "Двух марок не хватит.",
          "source": "Tatoeba #3339129 @bailujia / #3339141 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3339129",
          "cefr_level": "A1",
          "word_slugs": [
            "bastano-verb"
          ]
        },
        {
          "id": "10933213",
          "text": "I soldi non bastano per niente.",
          "translation": "Денег ни на что не хватает.",
          "source": "Tatoeba #10933213 @dnnywld / #10933105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10933213",
          "cefr_level": "A1",
          "word_slugs": [
            "bastano-verb"
          ]
        },
        {
          "id": "5548732",
          "text": "Semplicemente non ci bastano i soldi.",
          "translation": "Нам просто не хватает денег.",
          "source": "Tatoeba #5548732 @dnnywld / #5548019 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5548732",
          "cefr_level": "A1",
          "word_slugs": [
            "bastano-verb"
          ]
        },
        {
          "id": "6955593",
          "text": "Il quarto sarà di troppo. Ne bastano tre.",
          "translation": "Четвёртый будет лишний. Хватит и трёх.",
          "source": "Tatoeba #6955593 @dnnywld / #6955440 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6955593",
          "cefr_level": "A1",
          "word_slugs": [
            "bastano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "bastano",
        "plural": "",
        "infinitive": "bastano"
      }
    },
    {
      "slug": "molo-noun",
      "lemma": "molo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6209,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "пирс"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "806573",
          "text": "Hai mai visto un molo?",
          "translation": "Ты когда-нибудь видел пристань?",
          "source": "Tatoeba #806573 @Guybrush88 / #5627869 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/806573",
          "cefr_level": "A1",
          "word_slugs": [
            "molo-noun"
          ]
        },
        {
          "id": "5527167",
          "text": "Jim andò a pescare sul molo.",
          "translation": "Джим пошёл ловить рыбу на молу.",
          "source": "Tatoeba #5527167 @dnnywld / #374664 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527167",
          "cefr_level": "A1",
          "word_slugs": [
            "molo-noun"
          ]
        },
        {
          "id": "5538827",
          "text": "Tom ha spinto Mary giù dal molo.",
          "translation": "Том столкнул Мэри с пирса.",
          "source": "Tatoeba #5538827 @dnnywld / #5538644 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5538827",
          "cefr_level": "A1",
          "word_slugs": [
            "molo-noun"
          ]
        },
        {
          "id": "6906456",
          "text": "Sono venuta al molo a salutare Tom.",
          "translation": "Я пришла проводить Тома на пристань.",
          "source": "Tatoeba #6906456 @dnnywld / #6534803 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6906456",
          "cefr_level": "A1",
          "word_slugs": [
            "molo-noun"
          ]
        },
        {
          "id": "6963777",
          "text": "Tom pesca del pesce e lo vende sul molo.",
          "translation": "Том ловит рыбу и продает её на пристани.",
          "source": "Tatoeba #6963777 @dnnywld / #6963111 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6963777",
          "cefr_level": "A1",
          "word_slugs": [
            "molo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il molo",
        "plural": "",
        "infinitive": ""
      }
    },
