    {
      "slug": "sembravano-verb",
      "lemma": "sembravano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7032,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1179878",
          "text": "Le mani di Tom sembravano come il ghiaccio.",
          "translation": "Руки Тома казались ледяными.",
          "source": "Tatoeba #1179878 @Guybrush88 / #3245197 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1179878",
          "cefr_level": "A1",
          "word_slugs": [
            "sembravano-verb"
          ]
        },
        {
          "id": "908414",
          "text": "Le stelle luccicanti nel cielo notturno sembravano gioielli.",
          "translation": "Звезды, мерцавшие в ночном небе, выглядели как драгоценные камни.",
          "source": "Tatoeba #908414 @riccioberto / #471776 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/908414",
          "cefr_level": "A1",
          "word_slugs": [
            "sembravano-verb"
          ]
        },
        {
          "id": "5675955",
          "text": "Le loro facce, coperte di vernice cremisi e nera, sembravano disumane.",
          "translation": "Покрытые багряной и чёрной краской, их лица казались нечеловеческими.",
          "source": "Tatoeba #5675955 @dnnywld / #5675278 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5675955",
          "cefr_level": "A1",
          "word_slugs": [
            "sembravano-verb"
          ]
        }
      ],
      "tags": [
