          ]
        },
        {
          "id": "5835363",
          "text": "Non sta migliorando.",
          "translation": "Лучше не становится.",
          "source": "Tatoeba #5835363 @dnnywld / #4255229 @averoes (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5835363",
          "cefr_level": "A1",
          "word_slugs": [
            "migliorando-verb"
          ]
        },
        {
          "id": "1484106",
          "text": "I feriti stanno migliorando.",
          "translation": "Раненым становится лучше.",
          "source": "Tatoeba #1484106 @Guybrush88 / #3060279 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1484106",
          "cefr_level": "A1",
          "word_slugs": [
            "migliorando-verb"
          ]
        }
