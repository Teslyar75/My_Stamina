      "examples": [
        {
          "id": "6949973",
          "text": "Perché i pianeti sono rotondi?",
          "translation": "Почему планеты круглые?",
          "source": "Tatoeba #6949973 @dnnywld / #5324441 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6949973",
          "cefr_level": "A1",
          "word_slugs": [
            "pianeti-noun"
          ]
        },
        {
          "id": "1032513",
          "text": "I pianeti ruotano attorno ad una stella.",
          "translation": "Планеты вращаются вокруг звезды.",
          "source": "Tatoeba #1032513 @rado / #1457328 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1032513",
          "cefr_level": "A1",
          "word_slugs": [
            "pianeti-noun"
          ]
        },
        {
          "id": "382269",
          "text": "L'astronomia si occupa delle stelle e dei pianeti.",
          "translation": "Астрономия занимается звёздами и планетами.",
          "source": "Tatoeba #382269 @Pharamp / #993207 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/382269",
          "cefr_level": "A1",
          "word_slugs": [
            "pianeti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
