    {
      "slug": "argomenti-noun",
      "lemma": "argomenti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9804,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5838541",
          "text": "I tuoi argomenti non sono convincenti.",
          "translation": "Твой довод не убедителен.",
          "source": "Tatoeba #5838541 @dnnywld / #3565516 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5838541",
          "cefr_level": "A1",
          "word_slugs": [
            "argomenti-noun"
          ]
        },
        {
          "id": "5838540",
          "text": "I vostri argomenti non sono convincenti.",
          "translation": "Ваш довод не убедителен.",
          "source": "Tatoeba #5838540 @dnnywld / #3565515 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5838540",
          "cefr_level": "A1",
          "word_slugs": [
            "argomenti-noun"
          ]
        },
        {
          "id": "5838538",
          "text": "Gli argomenti contro questo sono i seguenti.",
          "translation": "Доводы против этого следующие.",
          "source": "Tatoeba #5838538 @dnnywld / #2649663 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5838538",
          "cefr_level": "A1",
          "word_slugs": [
            "argomenti-noun"
          ]
        },
        {
          "id": "7073419",
          "text": "A loro piaceva discutere su argomenti di politica.",
          "translation": "Они любили спорить на политические темы.",
          "source": "Tatoeba #7073419 @dnnywld / #7072252 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7073419",
          "cefr_level": "A1",
          "word_slugs": [
            "argomenti-noun"
          ]
        },
        {
          "id": "5734148",
          "text": "In questa conferenza sono stati affrontati molti argomenti.",
          "translation": "На этой конференции было затронуто много тем.",
          "source": "Tatoeba #5734148 @dnnywld / #5732041 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5734148",
          "cefr_level": "A1",
          "word_slugs": [
