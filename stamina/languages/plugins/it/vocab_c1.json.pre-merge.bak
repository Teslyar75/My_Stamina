      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2897740",
          "text": "Sono partiti tutti.",
          "translation": "Все уехали.",
          "source": "Tatoeba #2897740 @Guybrush88 / #5558562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2897740",
          "cefr_level": "A1",
          "word_slugs": [
            "partiti-noun"
          ]
        },
        {
          "id": "2896031",
          "text": "Sono appena partiti.",
          "translation": "Они только что ушли.",
          "source": "Tatoeba #2896031 @Guybrush88 / #2942377 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2896031",
          "cefr_level": "A1",
          "word_slugs": [
            "partiti-noun"
          ]
        },
        {
          "id": "5642306",
          "text": "Tre-Quattro! Partiti!",
          "translation": "Три-четыре! Начали!",
          "source": "Tatoeba #5642306 @dnnywld / #5642115 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642306",
          "cefr_level": "A1",
          "word_slugs": [
            "partiti-noun"
          ]
        },
        {
          "id": "2261088",
          "text": "Siamo partiti da zero.",
          "translation": "Мы начали с нуля.",
          "source": "Tatoeba #2261088 @al_ex_an_der / #2261091 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2261088",
          "cefr_level": "A1",
          "word_slugs": [
            "partiti-noun"
          ]
        },
        {
          "id": "1795363",
          "text": "I partiti parlamentari rappresentano solo se stessi.",
          "translation": "Парламентские партии не представляют никого, кроме самих себя.",
          "source": "Tatoeba #1795363 @al_ex_an_der / #1795352 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1795363",
          "cefr_level": "A1",
          "word_slugs": [
            "partiti-noun"
          ]
        }
      ],
      "tags": [
