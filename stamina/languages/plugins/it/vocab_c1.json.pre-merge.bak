        {
          "id": "6810635",
          "text": "La madre decise diversamente.",
          "translation": "Мать решила иначе.",
          "source": "Tatoeba #6810635 @dnnywld / #2661418 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6810635",
          "cefr_level": "A1",
