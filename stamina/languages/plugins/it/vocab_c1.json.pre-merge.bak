          "cefr_level": "A1",
          "word_slugs": [
            "urlato-verb"
          ]
        },
        {
          "id": "5549699",
          "text": "Le ho urlato contro.",
          "translation": "Я накричала на неё.",
          "source": "Tatoeba #5549699 @dnnywld / #5549593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5549699",
          "cefr_level": "A1",
          "word_slugs": [
            "urlato-verb"
          ]
        },
        {
          "id": "5586045",
          "text": "Ho urlato contro Tom.",
          "translation": "Я наорал на Тома.",
