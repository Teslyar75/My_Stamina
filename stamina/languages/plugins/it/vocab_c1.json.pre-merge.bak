    {
      "slug": "fonti-noun",
      "lemma": "fonti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5556,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5845233",
          "text": "Utilizza solo fonti affidabili.",
          "translation": "Используй только авторитетные источники.",
          "source": "Tatoeba #5845233 @dnnywld / #4447545 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845233",
          "cefr_level": "A1",
          "word_slugs": [
            "fonti-noun"
          ]
        },
        {
          "id": "5846084",
          "text": "Ricevo informazioni da diverse fonti.",
          "translation": "Я получаю информацию из разных источников.",
          "source": "Tatoeba #5846084 @dnnywld / #2398317 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5846084",
          "cefr_level": "A1",
          "word_slugs": [
            "fonti-noun"
          ]
        },
        {
          "id": "5476277",
          "text": "Dobbiamo sviluppare le fonti di energia rinnovabili.",
          "translation": "Мы должны развивать возобновляемые источники энергии.",
          "source": "Tatoeba #5476277 @dnnywld / #2036077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476277",
          "cefr_level": "A1",
          "word_slugs": [
            "fonti-noun"
          ]
        },
        {
          "id": "5672638",
          "text": "Il tuorlo d'uovo è una delle principali fonti della vitamina A.",
          "translation": "Яичный желток — один из основных источников витамина А.",
          "source": "Tatoeba #5672638 @dnnywld / #5672527 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5672638",
          "cefr_level": "A1",
          "word_slugs": [
            "fonti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la fonti",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "bada-noun",
      "lemma": "bada",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5557,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5387638",
          "text": "Bada al fratellino.",
          "translation": "Присматривай за братиком.",
          "source": "Tatoeba #5387638 @dnnywld / #5387624 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387638",
          "cefr_level": "A1",
          "word_slugs": [
            "bada-noun"
          ]
        },
        {
          "id": "5387635",
          "text": "Bada alla sorellina.",
          "translation": "Присматривай за сестричкой.",
          "source": "Tatoeba #5387635 @dnnywld / #5387627 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387635",
          "cefr_level": "A1",
          "word_slugs": [
            "bada-noun"
          ]
        },
        {
          "id": "5884983",
          "text": "Bada a come parli.",
          "translation": "Выбирай выражения.",
          "source": "Tatoeba #5884983 @dnnywld / #2900599 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5884983",
          "cefr_level": "A1",
          "word_slugs": [
            "bada-noun"
          ]
        },
        {
          "id": "5987732",
          "text": "Resta qui e bada a Tom.",
          "translation": "Останься здесь и присмотри за Томом.",
          "source": "Tatoeba #5987732 @dnnywld / #5986994 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5987732",
          "cefr_level": "A1",
          "word_slugs": [
            "bada-noun"
          ]
        },
        {
          "id": "5388117",
          "text": "Bada a tuo fratello quando non ci sono.",
          "translation": "Присмотри за братом, пока меня нет.",
          "source": "Tatoeba #5388117 @dnnywld / #5388002 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388117",
          "cefr_level": "A1",
          "word_slugs": [
            "bada-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la bada",
        "plural": "",
        "infinitive": ""
      }
    },
