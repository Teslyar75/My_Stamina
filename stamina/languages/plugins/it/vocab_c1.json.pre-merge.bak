    {
      "slug": "ammissione-noun",
      "lemma": "ammissione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8432,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6847322",
          "text": "Lui ha fatto una sincera ammissione.",
          "translation": "Он сделал откровенное признание.",
          "source": "Tatoeba #6847322 @dnnywld / #2264225 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6847322",
          "cefr_level": "A1",
          "word_slugs": [
            "ammissione-noun"
          ]
        },
        {
          "id": "6799705",
          "text": "Lui ha superato l'esame d'ammissione.",
          "translation": "Он сдал вступительные экзамены.",
          "source": "Tatoeba #6799705 @dnnywld / #6598450 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799705",
          "cefr_level": "A1",
          "word_slugs": [
            "ammissione-noun"
          ]
        },
        {
          "id": "5584009",
          "text": "Il prossimo anno devo dare gli esami di ammissione.",
          "translation": "В следующем году я должен сдавать вступительные экзамены.",
          "source": "Tatoeba #5584009 @dnnywld / #351724 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5584009",
          "cefr_level": "A1",
          "word_slugs": [
            "ammissione-noun"
          ]
        },
        {
          "id": "6799734",
          "text": "Tom ha superato con successo gli esami di ammissione.",
          "translation": "Том успешно сдал вступительные экзамены.",
          "source": "Tatoeba #6799734 @dnnywld / #5428572 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799734",
          "cefr_level": "A1",
          "word_slugs": [
            "ammissione-noun"
          ]
        },
        {
          "id": "6799616",
          "text": "Per l'ammissione all'instituto, bisognava superare degli esami.",
          "translation": "При поступлении в институт надо было сдавать экзамены.",
          "source": "Tatoeba #6799616 @dnnywld / #6361344 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799616",
          "cefr_level": "A1",
          "word_slugs": [
            "ammissione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la ammissione",
        "plural": "",
        "infinitive": ""
      }
