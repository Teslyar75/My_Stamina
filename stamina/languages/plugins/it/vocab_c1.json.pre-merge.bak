    {
      "slug": "cresciuti-adj",
      "lemma": "cresciuti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6509,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5875463",
          "text": "Come sono cresciuti!",
          "translation": "Как они выросли!",
          "source": "Tatoeba #5875463 @dnnywld / #5875102 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5875463",
          "cefr_level": "A1",
          "word_slugs": [
            "cresciuti-adj"
          ]
        },
        {
          "id": "5531973",
          "text": "Siete cresciuti a Boston?",
          "translation": "Вы в Бостоне выросли?",
          "source": "Tatoeba #5531973 @dnnywld / #5531170 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5531973",
          "cefr_level": "A1",
          "word_slugs": [
            "cresciuti-adj"
          ]
        },
        {
          "id": "6099374",
          "text": "Ora siete cresciuti abbastanza.",
          "translation": "Теперь вы достаточно взрослые.",
          "source": "Tatoeba #6099374 @dnnywld / #6098556 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6099374",
          "cefr_level": "A1",
          "word_slugs": [
            "cresciuti-adj"
          ]
        },
        {
          "id": "11174617",
          "text": "Siamo cresciuti nella stessa casa.",
          "translation": "Мы выросли в одном доме.",
          "source": "Tatoeba #11174617 @dnnywld / #11172886 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11174617",
          "cefr_level": "A1",
          "word_slugs": [
            "cresciuti-adj"
          ]
        },
        {
          "id": "5598910",
          "text": "Avevate un cane quando siete cresciuti?",
          "translation": "У вас была собака, когда вы росли?",
          "source": "Tatoeba #5598910 @dnnywld / #5598686 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5598910",
          "cefr_level": "A1",
          "word_slugs": [
            "cresciuti-adj"
          ]
        }
      ],
      "tags": [
