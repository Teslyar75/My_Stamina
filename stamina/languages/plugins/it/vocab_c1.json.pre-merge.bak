      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6078,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5466832",
          "text": "Compri riviste e giornali?",
          "translation": "Покупаешь ли ты журналы и газеты?",
          "source": "Tatoeba #5466832 @dnnywld / #5466655 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5466832",
          "cefr_level": "A1",
          "word_slugs": [
            "compri-verb"
          ]
        },
        {
          "id": "5466835",
          "text": "Compri riviste o giornali?",
          "translation": "Ты покупаешь журналы и газеты?",
          "source": "Tatoeba #5466835 @dnnywld / #5466654 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5466835",
          "cefr_level": "A1",
          "word_slugs": [
            "compri-verb"
          ]
        },
        {
          "id": "10766110",
          "text": "Vuoi veramente che te lo compri?",
          "translation": "Ты правда хочешь, чтобы я тебе это купил?",
          "source": "Tatoeba #10766110 @dnnywld / #7009640 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10766110",
          "cefr_level": "A1",
          "word_slugs": [
            "compri-verb"
          ]
        },
        {
          "id": "13302284",
          "text": "Dove compri le palline da tennis?",
          "translation": "Где ты покупаешь теннисные мячи?",
          "source": "Tatoeba #13302284 @Guybrush88 / #13674166 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13302284",
          "cefr_level": "A1",
          "word_slugs": [
            "compri-verb"
          ]
        },
        {
          "id": "10766111",
          "text": "Davvero vuoi che ti compri questo?",
          "translation": "Ты правда хочешь, чтобы я тебе это купил?",
          "source": "Tatoeba #10766111 @dnnywld / #7009640 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10766111",
          "cefr_level": "A1",
          "word_slugs": [
