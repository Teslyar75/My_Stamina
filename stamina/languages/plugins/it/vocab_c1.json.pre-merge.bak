    {
      "slug": "dimensione-noun",
      "lemma": "dimensione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7182,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5141607",
          "text": "Il prezzo dipende dalla dimensione.",
          "translation": "Цена зависит от размера.",
          "source": "Tatoeba #5141607 @Guybrush88 / #3058458 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5141607",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensione-noun"
          ]
        },
        {
          "id": "5002261",
          "text": "Aveva circa la dimensione di un uovo.",
          "translation": "Он был размером примерно с яйцо.",
          "source": "Tatoeba #5002261 @Guybrush88 / #5002270 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5002261",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensione-noun"
          ]
        },
        {
          "id": "6332062",
          "text": "È il secondo fiume del Giappone per dimensione.",
          "translation": "Это вторая по протяжённости река в Японии.",
          "source": "Tatoeba #6332062 @dnnywld / #6332045 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6332062",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensione-noun"
          ]
        },
        {
          "id": "5569524",
          "text": "Abbiamo disposto i libri in base alla dimensione.",
          "translation": "Мы расставили книги по росту.",
          "source": "Tatoeba #5569524 @dnnywld / #5569147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5569524",
          "cefr_level": "A1",
          "word_slugs": [
            "dimensione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la dimensione",
        "plural": "",
        "infinitive": ""
      }
