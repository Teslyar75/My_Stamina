      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6963749",
          "text": "I suoi dipinti sono molto cari.",
          "translation": "Его картины очень ценны.",
          "source": "Tatoeba #6963749 @dnnywld / #6963162 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6963749",
          "cefr_level": "A1",
