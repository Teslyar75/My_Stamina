      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5625772",
          "text": "Siete molto intelligenti.",
          "translation": "Вы очень умны.",
          "source": "Tatoeba #5625772 @dnnywld / #5625235 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5625772",
          "cefr_level": "A1",
          "word_slugs": [
