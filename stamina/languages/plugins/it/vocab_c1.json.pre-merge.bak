    {
      "slug": "candela-noun",
      "lemma": "candela",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6646,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "свеча"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3658917",
          "text": "Accendi la candela.",
          "translation": "Зажги свечу.",
          "source": "Tatoeba #3658917 @Guybrush88 / #4486844 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3658917",
          "cefr_level": "A1",
          "word_slugs": [
            "candela-noun"
          ]
        },
        {
          "id": "3658919",
          "text": "Accendete la candela.",
          "translation": "Зажгите свечку.",
          "source": "Tatoeba #3658919 @Guybrush88 / #4486847 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3658919",
          "cefr_level": "A1",
          "word_slugs": [
            "candela-noun"
          ]
        },
        {
          "id": "4551106",
          "text": "Accendiamo qualche candela.",
          "translation": "Давай зажжём несколько свечей.",
          "source": "Tatoeba #4551106 @Guybrush88 / #4551096 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4551106",
          "cefr_level": "A1",
          "word_slugs": [
            "candela-noun"
          ]
        },
        {
          "id": "2434495",
          "text": "Non accenda la candela.",
          "translation": "Не зажигайте свечу!",
          "source": "Tatoeba #2434495 @Guybrush88 / #3109596 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2434495",
          "cefr_level": "A1",
          "word_slugs": [
            "candela-noun"
          ]
        },
        {
          "id": "5646696",
          "text": "Non spegnete la candela.",
          "translation": "Не гасите свечу.",
          "source": "Tatoeba #5646696 @dnnywld / #5646460 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5646696",
          "cefr_level": "A1",
          "word_slugs": [
            "candela-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
