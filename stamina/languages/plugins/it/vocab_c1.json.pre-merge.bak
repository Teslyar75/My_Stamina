      "examples": [
        {
          "id": "5521968",
          "text": "Siete completamente inutili.",
          "translation": "Вы совершенно бесполезны.",
          "source": "Tatoeba #5521968 @dnnywld / #5520833 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5521968",
          "cefr_level": "A1",
          "word_slugs": [
            "inutili-adj"
          ]
        },
        {
          "id": "6797552",
          "text": "Non fate domande inutili.",
          "translation": "Не задавайте лишних вопросов.",
          "source": "Tatoeba #6797552 @dnnywld / #6797475 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797552",
          "cefr_level": "A1",
          "word_slugs": [
            "inutili-adj"
          ]
        },
        {
          "id": "6797553",
          "text": "Non fare domande inutili.",
          "translation": "Не задавай лишних вопросов.",
          "source": "Tatoeba #6797553 @dnnywld / #6797474 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797553",
          "cefr_level": "A1",
          "word_slugs": [
            "inutili-adj"
          ]
        },
        {
          "id": "5607648",
          "text": "Hai delle riviste inutili?",
          "translation": "У тебя есть ненужные журналы?",
          "source": "Tatoeba #5607648 @dnnywld / #5606231 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607648",
          "cefr_level": "A1",
          "word_slugs": [
            "inutili-adj"
          ]
        },
        {
          "id": "1512889",
          "text": "I tuoi sforzi sono inutili.",
          "translation": "Твои старания тщетны.",
          "source": "Tatoeba #1512889 @Guybrush88 / #1510227 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1512889",
          "cefr_level": "A1",
          "word_slugs": [
            "inutili-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
