    {
      "slug": "sorride-verb",
      "lemma": "sorride",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9412,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5449883",
          "text": "Tom sorride sempre.",
          "translation": "Том всегда улыбается.",
          "source": "Tatoeba #5449883 @Sofia1789 / #2450118 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5449883",
          "cefr_level": "A1",
          "word_slugs": [
            "sorride-verb"
          ]
        },
        {
          "id": "5521931",
          "text": "Lui sorride sempre.",
          "translation": "Он всегда улыбается.",
          "source": "Tatoeba #5521931 @dnnywld / #5520925 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5521931",
          "cefr_level": "A1",
          "word_slugs": [
            "sorride-verb"
          ]
        },
        {
          "id": "6361565",
          "text": "Tom sorride in continuazione.",
          "translation": "Том всё время улыбается.",
          "source": "Tatoeba #6361565 @dnnywld / #6361293 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361565",
          "cefr_level": "A1",
          "word_slugs": [
            "sorride-verb"
          ]
        },
        {
          "id": "4189558",
          "text": "Ogni volta che lo guardo sorride.",
          "translation": "Каждый раз, когда я смотрю на него, он улыбается.",
          "source": "Tatoeba #4189558 @Guybrush88 / #4386850 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4189558",
          "cefr_level": "A1",
          "word_slugs": [
            "sorride-verb"
          ]
        },
        {
          "id": "1548278",
          "text": "Ogni volta che la vedo mi sorride.",
          "translation": "Она улыбается мне каждый раз, как её увижу.",
          "source": "Tatoeba #1548278 @Guybrush88 / #3501482 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1548278",
          "cefr_level": "A1",
          "word_slugs": [
            "sorride-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sorride",
        "plural": "",
        "infinitive": "sorride"
      }
