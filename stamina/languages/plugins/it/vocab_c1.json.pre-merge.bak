    {
      "slug": "isole-noun",
      "lemma": "isole",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8069,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3663255",
          "text": "Ci sono isole nel mare.",
          "translation": "В море есть острова.",
          "source": "Tatoeba #3663255 @Guybrush88 / #3663264 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3663255",
          "cefr_level": "A1",
          "word_slugs": [
            "isole-noun"
          ]
        },
        {
          "id": "3671982",
          "text": "Ci sono delle isole sul mare.",
          "translation": "В море есть острова.",
          "source": "Tatoeba #3671982 @Balamax / #3663264 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3671982",
          "cefr_level": "A1",
          "word_slugs": [
            "isole-noun"
          ]
        },
        {
          "id": "617141",
          "text": "In Grecia ci sono molte isole.",
          "translation": "В Греции много островов.",
          "source": "Tatoeba #617141 @rado / #2583035 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/617141",
          "cefr_level": "A1",
          "word_slugs": [
            "isole-noun"
          ]
        },
        {
          "id": "2685866",
          "text": "I viaggi alle isole non sono economici.",
          "translation": "Поездки на острова стоят недёшево.",
          "source": "Tatoeba #2685866 @fekundulo / #2686794 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2685866",
          "cefr_level": "A1",
          "word_slugs": [
            "isole-noun"
          ]
        },
        {
          "id": "5871265",
          "text": "Quando ritorni a casa nelle Isole Faroe?",
          "translation": "Когда ты вернёшься домой на Фареры?",
          "source": "Tatoeba #5871265 @dnnywld / #5692452 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5871265",
          "cefr_level": "A1",
          "word_slugs": [
            "isole-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la isole",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "sceglie-verb",
      "lemma": "sceglie",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8070,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5885003",
          "text": "La patria non si sceglie.",
          "translation": "Родину не выбирают.",
          "source": "Tatoeba #5885003 @dnnywld / #4106377 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885003",
          "cefr_level": "A1",
          "word_slugs": [
            "sceglie-verb"
          ]
        },
        {
          "id": "5885110",
          "text": "L'uomo nobile sceglie dove vivere.",
          "translation": "Благородный муж выбирает, где жить.",
          "source": "Tatoeba #5885110 @dnnywld / #1216488 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885110",
          "cefr_level": "A1",
          "word_slugs": [
            "sceglie-verb"
          ]
        },
        {
          "id": "5885195",
          "text": "La nazionalità, si sa, non si sceglie.",
          "translation": "Национальность, знаете ли, не выбирают.",
          "source": "Tatoeba #5885195 @dnnywld / #4028561 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885195",
          "cefr_level": "A1",
          "word_slugs": [
            "sceglie-verb"
          ]
        },
        {
          "id": "5885217",
          "text": "Chi sceglie a lungo, prende la decisione sbagliata.",
          "translation": "Кто долго выбирает, тот прогадает.",
          "source": "Tatoeba #5885217 @dnnywld / #5188839 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5885217",
          "cefr_level": "A1",
          "word_slugs": [
            "sceglie-verb"
          ]
        },
        {
          "id": "5536521",
          "text": "Nel dialogo con me lui sceglie sempre un tono accondiscendente.",
          "translation": "В общении со мной он всегда выбирает снисходительный тон.",
          "source": "Tatoeba #5536521 @dnnywld / #5535622 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5536521",
          "cefr_level": "A1",
          "word_slugs": [
            "sceglie-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "sceglie",
        "plural": "",
        "infinitive": "sceglie"
      }
    },
