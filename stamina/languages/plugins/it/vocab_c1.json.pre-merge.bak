    {
      "slug": "mail-noun",
      "lemma": "mail",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5749,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5513828",
          "text": "Ho molte mail questa mattina.",
          "translation": "У меня сегодня утром много писем.",
          "source": "Tatoeba #5513828 @dnnywld / #5513568 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513828",
          "cefr_level": "A1",
          "word_slugs": [
            "mail-noun"
          ]
        },
        {
          "id": "6872216",
          "text": "Ti ho appena mandato una mail.",
          "translation": "Я только что отправил тебе e-mail.",
          "source": "Tatoeba #6872216 @dnnywld / #2973473 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6872216",
          "cefr_level": "A1",
          "word_slugs": [
            "mail-noun"
          ]
        },
        {
          "id": "5397244",
          "text": "I politici non dicono mail il vero.",
          "translation": "Политики не всегда говорят правду.",
          "source": "Tatoeba #5397244 @dnnywld / #5397238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5397244",
          "cefr_level": "A1",
          "word_slugs": [
            "mail-noun"
          ]
        },
        {
          "id": "2177992",
          "text": "L'e-mail specificata è già registrata.",
          "translation": "Указанный электронный адрес уже зарегистрирован.",
          "source": "Tatoeba #2177992 @Guybrush88 / #5789548 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2177992",
          "cefr_level": "A1",
          "word_slugs": [
            "mail-noun"
          ]
        },
        {
          "id": "6872218",
          "text": "La prossima settimana scriverò una mail ai miei genitori.",
          "translation": "На следующей неделе я напишу e-mail моим родителям.",
          "source": "Tatoeba #6872218 @dnnywld / #2695066 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6872218",
          "cefr_level": "A1",
          "word_slugs": [
            "mail-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
