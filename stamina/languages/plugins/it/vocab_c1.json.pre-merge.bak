      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10851288",
          "text": "È un'arancia.",
          "translation": "Это апельсин.",
          "source": "Tatoeba #10851288 @dnnywld / #4540294 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851288",
          "cefr_level": "A1",
          "word_slugs": [
            "arancia-noun"
          ]
        },
        {
          "id": "6621591",
          "text": "Vorrei un'arancia.",
          "translation": "Я бы хотел апельсин.",
          "source": "Tatoeba #6621591 @Guybrush88 / #6882580 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6621591",
          "cefr_level": "A1",
          "word_slugs": [
            "arancia-noun"
          ]
        },
        {
          "id": "10875921",
          "text": "Mangerete un'arancia.",
          "translation": "Вы съедите апельсин.",
          "source": "Tatoeba #10875921 @dnnywld / #5248760 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10875921",
          "cefr_level": "A1",
          "word_slugs": [
            "arancia-noun"
          ]
        },
        {
          "id": "10875951",
          "text": "Mangerete la mia arancia.",
          "translation": "Вы съедите мой апельсин.",
          "source": "Tatoeba #10875951 @dnnywld / #8126017 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10875951",
          "cefr_level": "A1",
          "word_slugs": [
