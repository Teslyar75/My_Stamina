    {
      "slug": "riposa-verb",
      "lemma": "riposa",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8757,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6893746",
          "text": "Tom riposa dopo pranzo.",
          "translation": "Том отдыхает после обеда.",
          "source": "Tatoeba #6893746 @dnnywld / #6893232 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893746",
          "cefr_level": "A1",
          "word_slugs": [
            "riposa-verb"
          ]
        },
        {
          "id": "10790787",
          "text": "Riposa in pace, compagno caro.",
          "translation": "Покойся с миром, дорогой товарищ.",
          "source": "Tatoeba #10790787 @dnnywld / #10790722 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790787",
          "cefr_level": "A1",
          "word_slugs": [
            "riposa-verb"
          ]
        },
        {
          "id": "5661247",
          "text": "Io lavoro con il sudore nella fronte e lui si riposa.",
          "translation": "Я работаю в поте лица, а он отдыхает.",
          "source": "Tatoeba #5661247 @dnnywld / #5661203 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5661247",
          "cefr_level": "A1",
          "word_slugs": [
            "riposa-verb"
          ]
        }
      ],
      "tags": [
