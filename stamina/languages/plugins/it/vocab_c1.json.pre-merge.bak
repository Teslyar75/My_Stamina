    {
      "slug": "divertirsi-verb",
      "lemma": "divertirsi",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5360,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5614447",
          "text": "Lei vuole semplicemente divertirsi.",
          "translation": "Она всего лишь хочет развлечься.",
          "source": "Tatoeba #5614447 @dnnywld / #2302965 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5614447",
          "cefr_level": "A1",
          "word_slugs": [
            "divertirsi-verb"
          ]
        },
        {
          "id": "4674",
          "text": "È più facile divertirsi che lavorare.",
          "translation": "Развлекаться проще, чем работать.",
          "source": "Tatoeba #4674 @Pharamp / #2021829 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4674",
          "cefr_level": "A1",
          "word_slugs": [
            "divertirsi-verb"
          ]
        },
        {
          "id": "6889476",
          "text": "Sembra che qui io sia l'unico a divertirsi.",
          "translation": "Похоже, что только я провожу время хорошо здесь.",
          "source": "Tatoeba #6889476 @dnnywld / #3470672 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6889476",
          "cefr_level": "A1",
          "word_slugs": [
            "divertirsi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "divertirsi",
        "plural": "",
        "infinitive": "divertirsi"
      }
    },
