    {
      "slug": "orchestra-noun",
      "lemma": "orchestra",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7548,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5923280",
          "text": "Il direttore conduce l'orchestra.",
          "translation": "Дирижёр руководит оркестром.",
          "source": "Tatoeba #5923280 @dnnywld / #5829390 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5923280",
          "cefr_level": "A1",
          "word_slugs": [
            "orchestra-noun"
          ]
        },
        {
          "id": "6167294",
          "text": "Chi è questo direttore d'orchestra?",
          "translation": "Кто такой капельмейстер?",
          "source": "Tatoeba #6167294 @dnnywld / #6166834 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6167294",
          "cefr_level": "A1",
          "word_slugs": [
            "orchestra-noun"
          ]
        },
        {
          "id": "5827249",
          "text": "L'orchestra continuava a far rumore.",
          "translation": "Оркестр продолжал шуметь.",
          "source": "Tatoeba #5827249 @dnnywld / #4005927 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5827249",
          "cefr_level": "A1",
          "word_slugs": [
            "orchestra-noun"
          ]
        },
        {
          "id": "10840834",
          "text": "Ho intenzione di entrare nell'orchestra scolastica.",
          "translation": "Я собираюсь записаться в школьный оркестр.",
          "source": "Tatoeba #10840834 @dnnywld / #880836 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10840834",
          "cefr_level": "A1",
          "word_slugs": [
            "orchestra-noun"
          ]
        },
        {
          "id": "390683",
          "text": "Questo famoso direttore d'orchestra abita a New York.",
          "translation": "Этот знаменитый дирижер живёт в Нью-Йорке.",
          "source": "Tatoeba #390683 @Pharamp / #497082 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/390683",
          "cefr_level": "A1",
          "word_slugs": [
            "orchestra-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la orchestra",
        "plural": "",
        "infinitive": ""
      }
