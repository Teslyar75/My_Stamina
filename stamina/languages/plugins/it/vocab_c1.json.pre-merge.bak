    {
      "slug": "comprensibile-adj",
      "lemma": "comprensibile",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8276,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6938361",
          "text": "Questo è comprensibile?",
          "translation": "Это понятно?",
          "source": "Tatoeba #6938361 @Guybrush88 / #6938284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6938361",
          "cefr_level": "A1",
          "word_slugs": [
            "comprensibile-adj"
          ]
        },
        {
          "id": "5528819",
          "text": "È assolutamente comprensibile.",
          "translation": "Это абсолютно понятно.",
          "source": "Tatoeba #5528819 @dnnywld / #2580859 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5528819",
          "cefr_level": "A1",
          "word_slugs": [
            "comprensibile-adj"
          ]
        },
        {
          "id": "5528824",
          "text": "Così sarà più comprensibile?",
          "translation": "Так будет понятнее?",
          "source": "Tatoeba #5528824 @dnnywld / #5154575 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5528824",
          "cefr_level": "A1",
          "word_slugs": [
            "comprensibile-adj"
          ]
        },
        {
          "id": "7004792",
          "text": "Sto esponendo in modo comprensibile?",
          "translation": "Я понятно излагаю?",
          "source": "Tatoeba #7004792 @dnnywld / #7002362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7004792",
          "cefr_level": "A1",
          "word_slugs": [
            "comprensibile-adj"
          ]
        },
        {
          "id": "5528823",
          "text": "La loro preoccupazione è comprensibile.",
          "translation": "Их беспокойство понятно.",
