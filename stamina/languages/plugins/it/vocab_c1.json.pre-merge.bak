    {
      "slug": "dama-noun",
      "lemma": "dama",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9136,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "шашки"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5781937",
          "text": "Non so giocare a dama.",
          "translation": "Я не умею играть в шашки.",
          "source": "Tatoeba #5781937 @dnnywld / #5781660 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5781937",
          "cefr_level": "A1",
          "word_slugs": [
            "dama-noun"
          ]
        },
        {
          "id": "5781936",
          "text": "Mary non sa giocare a dama.",
          "translation": "Мэри не умеет играть в шашки.",
          "source": "Tatoeba #5781936 @dnnywld / #5781661 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5781936",
          "cefr_level": "A1",
          "word_slugs": [
            "dama-noun"
          ]
        },
        {
          "id": "5434995",
          "text": "Quale gioco preferisci: scacchi o dama?",
          "translation": "Какую игру ты предпочитаешь: шахматы или шашки?",
          "source": "Tatoeba #5434995 @dnnywld / #5434977 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5434995",
          "cefr_level": "A1",
          "word_slugs": [
            "dama-noun"
          ]
        },
        {
          "id": "5527608",
          "text": "Un vero gentiluomo corteggia una dama con rispetto.",
          "translation": "Истинный джентльмен относится с уважением к даме, за которой ухаживает.",
          "source": "Tatoeba #5527608 @dnnywld / #5527503 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5527608",
          "cefr_level": "A1",
          "word_slugs": [
            "dama-noun"
          ]
        },
        {
          "id": "5774586",
          "text": "Quando lui incontrò la dama, si tolse il cappello.",
          "translation": "Когда он встретил даму, он приподнял свою шляпу.",
          "source": "Tatoeba #5774586 @dnnywld / #5774419 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5774586",
          "cefr_level": "A1",
          "word_slugs": [
            "dama-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la dama",
        "plural": "",
        "infinitive": ""
      }
    },
