    {
      "slug": "utili-adj",
      "lemma": "utili",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5951,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1015652",
          "text": "I cavalli sono animali utili.",
          "translation": "Лошади — полезные животные.",
          "source": "Tatoeba #1015652 @Guybrush88 / #1015654 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1015652",
          "cefr_level": "A1",
          "word_slugs": [
            "utili-adj"
          ]
        },
        {
          "id": "819759",
          "text": "Non tutti quei libri sono utili.",
          "translation": "Не все из этих книг полезны.",
          "source": "Tatoeba #819759 @Guybrush88 / #692543 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/819759",
          "cefr_level": "A1",
          "word_slugs": [
            "utili-adj"
          ]
        },
        {
          "id": "5398843",
          "text": "I tuoi consigli sono sempre utili per me.",
          "translation": "Твои советы всегда идут мне на пользу.",
          "source": "Tatoeba #5398843 @dnnywld / #2000904 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5398843",
          "cefr_level": "A1",
          "word_slugs": [
            "utili-adj"
          ]
        },
        {
          "id": "5520400",
          "text": "Greco e latino sono lingue utili, perciò le studio.",
          "translation": "Греческий и латинский — полезные языки, поэтому я их учу.",
          "source": "Tatoeba #5520400 @dnnywld / #4512810 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5520400",
          "cefr_level": "A1",
          "word_slugs": [
            "utili-adj"
          ]
        },
        {
          "id": "4403",
          "text": "Le sole risposte utili sono quelle che propongono nuove domande.",
          "translation": "Единственные полезные ответы - те, которые поднимают новые вопросы.",
          "source": "Tatoeba #4403 @Pharamp / #5622 @Farol (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4403",
          "cefr_level": "A1",
          "word_slugs": [
            "utili-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il utili",
        "plural": "",
        "infinitive": ""
      }
