    {
      "slug": "orologi-noun",
      "lemma": "orologi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8764,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "946936",
          "text": "Mi piacciono gli orologi.",
          "translation": "Я люблю часы.",
          "source": "Tatoeba #946936 @riccioberto / #2358243 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/946936",
          "cefr_level": "A1",
          "word_slugs": [
            "orologi-noun"
          ]
        },
        {
          "id": "3343673",
          "text": "A me piacciono gli orologi.",
          "translation": "Я люблю часы.",
          "source": "Tatoeba #3343673 @Guybrush88 / #2358243 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3343673",
          "cefr_level": "A1",
          "word_slugs": [
            "orologi-noun"
          ]
        },
        {
          "id": "5654853",
          "text": "Non mi piacciono questi orologi.",
          "translation": "Мне не нравятся эти наручные часы.",
          "source": "Tatoeba #5654853 @dnnywld / #5654702 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5654853",
          "cefr_level": "A1",
          "word_slugs": [
            "orologi-noun"
          ]
        },
        {
          "id": "351124",
          "text": "Non ci sono orologi nella mia stanza.",
          "translation": "В моей комнате нет часов.",
          "source": "Tatoeba #351124 @martin / #704717 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/351124",
          "cefr_level": "A1",
          "word_slugs": [
            "orologi-noun"
          ]
        },
        {
          "id": "5598901",
          "text": "Quegli orologi non sono così cari come questi.",
          "translation": "Те часы не такие дорогие, как эти.",
          "source": "Tatoeba #5598901 @dnnywld / #5598695 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5598901",
          "cefr_level": "A1",
          "word_slugs": [
            "orologi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il orologi",
        "plural": "",
        "infinitive": ""
      }
