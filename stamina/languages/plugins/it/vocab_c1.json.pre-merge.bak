    {
      "slug": "gialla-adj",
      "lemma": "gialla",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8012,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "399699",
          "text": "La porta dell'ufficio è gialla.",
          "translation": "Офисная дверь жёлтая.",
          "source": "Tatoeba #399699 @ver / #6851430 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399699",
          "cefr_level": "A1",
          "word_slugs": [
            "gialla-adj"
          ]
        },
        {
          "id": "3759551",
          "text": "Lui abita in quella casa gialla.",
          "translation": "Он живёт в том жёлтом доме.",
          "source": "Tatoeba #3759551 @Guybrush88 / #5654494 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3759551",
          "cefr_level": "A1",
          "word_slugs": [
            "gialla-adj"
          ]
        },
        {
          "id": "5417759",
          "text": "Dammi la matita gialla per favore.",
          "translation": "Дай-ка мне, пожалуйста, жёлтый карандаш.",
          "source": "Tatoeba #5417759 @dnnywld / #5417750 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5417759",
          "cefr_level": "A1",
          "word_slugs": [
            "gialla-adj"
          ]
        },
        {
          "id": "3093404",
          "text": "Non ti piace la mia sciarpa gialla?",
          "translation": "Тебе не нравится мой жёлтый шарф?",
          "source": "Tatoeba #3093404 @Guybrush88 / #5865830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3093404",
          "cefr_level": "A1",
          "word_slugs": [
            "gialla-adj"
          ]
        },
        {
          "id": "3093405",
          "text": "Non vi piace la mia sciarpa gialla?",
          "translation": "Вам не нравится мой жёлтый шарф?",
          "source": "Tatoeba #3093405 @Guybrush88 / #5865831 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3093405",
          "cefr_level": "A1",
          "word_slugs": [
            "gialla-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
