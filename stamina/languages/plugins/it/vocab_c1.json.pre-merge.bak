    {
      "slug": "iniziale-adj",
      "lemma": "iniziale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7460,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5513034",
          "text": "Durante il periodo iniziale vi aiuterò.",
          "translation": "Я вам на первых порах помогу.",
          "source": "Tatoeba #5513034 @dnnywld / #5512994 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513034",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziale-adj"
          ]
        },
        {
          "id": "5566747",
          "text": "La malattia è ancora allo stadio iniziale.",
          "translation": "Болезнь пока в начальной стадии.",
          "source": "Tatoeba #5566747 @dnnywld / #5566084 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5566747",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziale-adj"
          ]
        },
        {
          "id": "6871407",
          "text": "La Corte suprema ha confermato la decisione iniziale del tribunale.",
          "translation": "Верховный суд подтвердил первоначальное решение суда.",
          "source": "Tatoeba #6871407 @dnnywld / #6867054 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871407",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziale-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
