      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5643898",
          "text": "Le tartarughe ninja sono il mio gioco preferito.",
          "translation": "«Черепашки ниндзя» — моя любимая игра.",
          "source": "Tatoeba #5643898 @dnnywld / #5642356 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643898",
          "cefr_level": "A1",
          "word_slugs": [
            "ninja-noun"
          ]
        },
        {
          "id": "2983528",
          "text": "Io ho visto un uomo vestito come un ninja.",
          "translation": "Я видел мужчину, одетого как ниндзя.",
          "source": "Tatoeba #2983528 @Guybrush88 / #3354756 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2983528",
          "cefr_level": "A1",
          "word_slugs": [
            "ninja-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
