      "examples": [
        {
          "id": "914325",
          "text": "O Cesare o niente.",
          "translation": "Или Цезарь, или ничего.",
          "source": "Tatoeba #914325 @riccioberto / #5822037 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/914325",
          "cefr_level": "A1",
          "word_slugs": [
            "cesare-name"
          ]
        },
        {
          "id": "3298775",
          "text": "Cesare nacque a Roma.",
          "translation": "Цезарь родился в Риме.",
          "source": "Tatoeba #3298775 @Guybrush88 / #3298779 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3298775",
          "cefr_level": "A1",
          "word_slugs": [
            "cesare-name"
          ]
        },
        {
          "id": "3298776",
          "text": "Cesare è nato a Roma.",
          "translation": "Цезарь родился в Риме.",
          "source": "Tatoeba #3298776 @Guybrush88 / #3298779 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3298776",
          "cefr_level": "A1",
          "word_slugs": [
            "cesare-name"
          ]
        },
        {
          "id": "6588712",
          "text": "Cesare fu dittatore dei romani.",
          "translation": "Цезарь был вождём римлян.",
          "source": "Tatoeba #6588712 @dnnywld / #6583303 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6588712",
          "cefr_level": "A1",
          "word_slugs": [
            "cesare-name"
          ]
        },
        {
          "id": "923914",
          "text": "Cesare fu informato del loro arrivo.",
          "translation": "Цезарю сообщили об их приходе.",
          "source": "Tatoeba #923914 @rado / #6306007 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/923914",
          "cefr_level": "A1",
          "word_slugs": [
            "cesare-name"
          ]
        }
      ],
