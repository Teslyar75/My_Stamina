    {
      "slug": "comportati-verb",
      "lemma": "comportati",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7049,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5489693",
          "text": "Vi siete comportati bene oggi?",
          "translation": "Вы хорошо себя сегодня вели?",
          "source": "Tatoeba #5489693 @dnnywld / #5489505 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489693",
          "cefr_level": "A1",
          "word_slugs": [
            "comportati-verb"
          ]
        },
        {
          "id": "5428347",
          "text": "I bambini si sono comportati bene.",
          "translation": "Дети вели себя хорошо.",
          "source": "Tatoeba #5428347 @dnnywld / #5428298 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5428347",
          "cefr_level": "A1",
          "word_slugs": [
            "comportati-verb"
          ]
        },
        {
          "id": "8735001",
          "text": "Capite che vi siete comportati male?",
          "translation": "Вы понимаете, что поступили плохо?",
          "source": "Tatoeba #8735001 @Valdast / #7096645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8735001",
          "cefr_level": "A1",
          "word_slugs": [
            "comportati-verb"
          ]
        },
        {
          "id": "5662292",
          "text": "Comportati bene a tavola, per favore.",
          "translation": "За столом веди себя прилично, пожалуйста.",
          "source": "Tatoeba #5662292 @dnnywld / #5661045 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5662292",
          "cefr_level": "A1",
          "word_slugs": [
            "comportati-verb"
          ]
        },
        {
          "id": "5570966",
          "text": "Siamo dispiaciuti di esserci comportati così.",
          "translation": "Нам жаль, что мы так поступили.",
          "source": "Tatoeba #5570966 @dnnywld / #5570815 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5570966",
          "cefr_level": "A1",
          "word_slugs": [
            "comportati-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "comportati",
        "plural": "",
        "infinitive": "comportati"
      }
    },
