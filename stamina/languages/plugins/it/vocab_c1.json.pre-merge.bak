    {
      "slug": "serpenti-noun",
      "lemma": "serpenti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6666,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "4987109",
          "text": "Ho paura dei serpenti.",
          "translation": "Я боюсь змей.",
          "source": "Tatoeba #4987109 @Guybrush88 / #1347336 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4987109",
          "cefr_level": "A1",
          "word_slugs": [
            "serpenti-noun"
          ]
        },
        {
          "id": "427747",
          "text": "Alcuni serpenti sono velenosi.",
          "translation": "Некоторые змеи ядовиты.",
          "source": "Tatoeba #427747 @Pharamp / #553071 @arseniiv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/427747",
          "cefr_level": "A1",
          "word_slugs": [
            "serpenti-noun"
          ]
        },
        {
          "id": "6841344",
          "text": "Lei ha paura dei serpenti.",
          "translation": "Она боится змей.",
          "source": "Tatoeba #6841344 @dnnywld / #4639372 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841344",
          "cefr_level": "A1",
          "word_slugs": [
            "serpenti-noun"
          ]
        },
        {
          "id": "5655448",
          "text": "Non mi piacciono i serpenti.",
          "translation": "Я не люблю змей.",
          "source": "Tatoeba #5655448 @dnnywld / #5655047 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5655448",
          "cefr_level": "A1",
          "word_slugs": [
            "serpenti-noun"
          ]
        },
        {
          "id": "6891311",
          "text": "Hai ancora paura dei serpenti?",
          "translation": "Ты всё ещё боишься змей?",
          "source": "Tatoeba #6891311 @dnnywld / #6598539 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6891311",
          "cefr_level": "A1",
          "word_slugs": [
            "serpenti-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il serpenti",
        "plural": "",
