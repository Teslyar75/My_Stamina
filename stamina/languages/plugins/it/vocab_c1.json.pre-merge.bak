    {
      "slug": "possedere-verb",
      "lemma": "possedere",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9908,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5634812",
          "text": "Più cose possediamo, più cose vorremmo possedere.",
          "translation": "Чем больше мы имеем, тем больше мы хотим иметь.",
          "source": "Tatoeba #5634812 @dnnywld / #2178780 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5634812",
          "cefr_level": "A1",
          "word_slugs": [
            "possedere-verb"
          ]
        },
        {
          "id": "6961750",
          "text": "Perché possedere un'enorme biblioteca se non ti piace leggere?",
          "translation": "Зачем иметь огромную библиотеку, если ты не любишь читать?",
          "source": "Tatoeba #6961750 @dnnywld / #6961706 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961750",
          "cefr_level": "A1",
          "word_slugs": [
            "possedere-verb"
          ]
        },
        {
          "id": "6961754",
          "text": "Che senso ha possedere un'enorme biblioteca se non ti piace leggere?",
          "translation": "Какой смысл иметь огромную библиотеку, если ты не любишь читать?",
          "source": "Tatoeba #6961754 @dnnywld / #6961700 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961754",
          "cefr_level": "A1",
          "word_slugs": [
            "possedere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "possedere",
