          ]
        },
        {
          "id": "3146160",
          "text": "In bocca chiusa non entrano mosche.",
          "translation": "В закрытый рот не попадают мухи.",
          "source": "Tatoeba #3146160 @Guybrush88 / #3293119 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3146160",
          "cefr_level": "A1",
          "word_slugs": [
            "mosche-noun"
          ]
        },
        {
          "id": "5626770",
          "text": "Loro vagano per la casa come mosche assonnate.",
          "translation": "Они бродят по дому, как сонные мухи.",
          "source": "Tatoeba #5626770 @dnnywld / #5626285 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626770",
          "cefr_level": "A1",
          "word_slugs": [
            "mosche-noun"
          ]
        }
      ],
