    {
      "slug": "esperta-adj",
      "lemma": "esperta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6940,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5677843",
          "text": "Lei è un'esperta.",
          "translation": "Она специалист.",
          "source": "Tatoeba #5677843 @dnnywld / #5677152 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5677843",
          "cefr_level": "A1",
          "word_slugs": [
            "esperta-adj"
          ]
        },
        {
          "id": "1807229",
          "text": "È esperta in matematica.",
          "translation": "Он эксперт в математике.",
          "source": "Tatoeba #1807229 @Guybrush88 / #4391061 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1807229",
          "cefr_level": "A1",
          "word_slugs": [
            "esperta-adj"
          ]
        },
        {
          "id": "5386693",
          "text": "Lei è un'acrobata molto esperta.",
          "translation": "Она очень опытная акробатка.",
          "source": "Tatoeba #5386693 @dnnywld / #5386692 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5386693",
          "cefr_level": "A1",
          "word_slugs": [
            "esperta-adj"
          ]
        },
        {
          "id": "10870880",
          "text": "Per una persona esperta un labirinto è come una galleria.",
