      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8796,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5956014",
          "text": "Non ho mai fumato.",
          "translation": "Я никогда не курил.",
          "source": "Tatoeba #5956014 @Guybrush88 / #4707169 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5956014",
          "cefr_level": "A1",
          "word_slugs": [
            "fumato-adj"
          ]
        },
        {
          "id": "3290282",
          "text": "Cosa ti sei fumato oggi?",
          "translation": "Чем ты обкурился сегодня?",
          "source": "Tatoeba #3290282 @Guybrush88 / #3290288 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3290282",
          "cefr_level": "A1",
          "word_slugs": [
            "fumato-adj"
          ]
        },
        {
          "id": "6884754",
          "text": "Non ho mai fumato in vita mia.",
          "translation": "Я никогда в жизни не курила.",
          "source": "Tatoeba #6884754 @dnnywld / #6884425 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6884754",
          "cefr_level": "A1",
          "word_slugs": [
            "fumato-adj"
          ]
        },
        {
          "id": "5647459",
          "text": "Per quanto io ricordi, lui ha sempre fumato la pipa.",
          "translation": "Сколько помню, он всегда курил трубку.",
          "source": "Tatoeba #5647459 @dnnywld / #3575270 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647459",
          "cefr_level": "A1",
          "word_slugs": [
            "fumato-adj"
          ]
        }
      ],
