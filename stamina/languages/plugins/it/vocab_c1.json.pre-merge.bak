      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9434,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7497276",
          "text": "A chi assomigli?",
          "translation": "На кого ты похож?",
          "source": "Tatoeba #7497276 @dnnywld / #7497080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7497276",
          "cefr_level": "A1",
          "word_slugs": [
            "assomigli-verb"
          ]
        },
        {
          "id": "5656892",
          "text": "Le assomigli molto.",
          "translation": "Ты на неё очень похожа.",
          "source": "Tatoeba #5656892 @dnnywld / #5656072 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5656892",
          "cefr_level": "A1",
          "word_slugs": [
            "assomigli-verb"
          ]
        },
        {
          "id": "5656889",
          "text": "Gli assomigli molto.",
          "translation": "Ты на него очень похожа.",
          "source": "Tatoeba #5656889 @dnnywld / #5656074 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5656889",
          "cefr_level": "A1",
          "word_slugs": [
            "assomigli-verb"
          ]
        },
        {
          "id": "5537055",
          "text": "Assomigli molto a Tom.",
