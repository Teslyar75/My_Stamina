      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7991490",
          "text": "Scusate. Devo aver composto il numero sbagliato.",
          "translation": "Извините. Я, наверное, неправильно набрал номер.",
          "source": "Tatoeba #7991490 @dnnywld / #7991257 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7991490",
          "cefr_level": "A1",
          "word_slugs": [
            "composto-adj"
          ]
        },
        {
          "id": "10852206",
          "text": "Tom è un sostantivo composto da tre lettere.",
          "translation": "Том - существительное, состоящее из трёх букв.",
          "source": "Tatoeba #10852206 @dnnywld / #10852068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10852206",
          "cefr_level": "A1",
          "word_slugs": [
            "composto-adj"
          ]
        },
        {
          "id": "5499870",
          "text": "Tom ha affittato un appartamento composto da tre stanze.",
          "translation": "Том снимает трёхкомнатную квартиру.",
          "source": "Tatoeba #5499870 @dnnywld / #4518089 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499870",
          "cefr_level": "A1",
          "word_slugs": [
            "composto-adj"
          ]
        },
        {
          "id": "5499860",
          "text": "Lei ha affittato un appartamento composto da quattro stanze.",
          "translation": "Она арендовала четырёхкомнатную квартиру.",
