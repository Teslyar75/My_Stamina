          ]
        },
        {
          "id": "2920991",
          "text": "Mi sono fatto un sandwich.",
          "translation": "Я сделал себе сэндвич.",
          "source": "Tatoeba #2920991 @Guybrush88 / #3066546 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2920991",
