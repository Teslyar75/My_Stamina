      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1300764",
          "text": "Seguite quell'auto.",
          "translation": "Следуй за той машиной.",
          "source": "Tatoeba #1300764 @Guybrush88 / #2418396 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1300764",
          "cefr_level": "A1",
          "word_slugs": [
            "seguite-verb"
          ]
        },
        {
          "id": "6698409",
          "text": "Seguite le notizie.",
          "translation": "Следите за новостями.",
          "source": "Tatoeba #6698409 @dnnywld / #6697334 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6698409",
