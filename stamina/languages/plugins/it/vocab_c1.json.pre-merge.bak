      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5856995",
          "text": "Togliti la gonna, per favore.",
          "translation": "Сними юбку, пожалуйста.",
          "source": "Tatoeba #5856995 @dnnywld / #5156522 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5856995",
          "cefr_level": "A1",
          "word_slugs": [
            "gonna-noun"
          ]
        },
        {
          "id": "5562928",
          "text": "Mary indossava una gonna rossa.",
          "translation": "На Мэри была красная юбка.",
          "source": "Tatoeba #5562928 @dnnywld / #5561540 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5562928",
          "cefr_level": "A1",
