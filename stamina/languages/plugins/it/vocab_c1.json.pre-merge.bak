      "frequency_rank": 6565,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3253854",
          "text": "Rimane poca acqua.",
          "translation": "Осталось мало воды.",
          "source": "Tatoeba #3253854 @Guybrush88 / #3680366 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3253854",
          "cefr_level": "A1",
          "word_slugs": [
            "poca-adj"
          ]
        },
        {
          "id": "1244984",
          "text": "Avevamo poca acqua.",
          "translation": "У нас было мало воды.",
          "source": "Tatoeba #1244984 @Guybrush88 / #3680369 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1244984",
          "cefr_level": "A1",
          "word_slugs": [
            "poca-adj"
          ]
        },
        {
          "id": "3373780",
          "text": "C'è poca gente.",
          "translation": "Людей мало.",
          "source": "Tatoeba #3373780 @Guybrush88 / #4367079 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3373780",
          "cefr_level": "A1",
          "word_slugs": [
            "poca-adj"
          ]
        },
        {
          "id": "5494383",
          "text": "Tom ha molto poca esperienza.",
          "translation": "У Тома очень мало опыта.",
          "source": "Tatoeba #5494383 @dnnywld / #3803318 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5494383",
          "cefr_level": "A1",
          "word_slugs": [
            "poca-adj"
          ]
        },
        {
          "id": "350403",
          "text": "Avremo poca neve questo inverno.",
          "translation": "У нас будет мало снега этой зимой.",
          "source": "Tatoeba #350403 @martin / #3082833 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350403",
          "cefr_level": "A1",
          "word_slugs": [
            "poca-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
