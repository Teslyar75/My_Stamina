    {
      "slug": "invitare-verb",
      "lemma": "invitare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6215,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1078283",
          "text": "Chi dobbiamo invitare?",
          "translation": "Кого нам пригласить?",
          "source": "Tatoeba #1078283 @Guybrush88 / #4954652 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1078283",
          "cefr_level": "A1",
          "word_slugs": [
            "invitare-verb"
          ]
        },
        {
          "id": "5671015",
          "text": "Posso farmi invitare da te?",
          "translation": "Можно я к тебе в гости напрошусь?",
          "source": "Tatoeba #5671015 @dnnywld / #5670414 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5671015",
          "cefr_level": "A1",
          "word_slugs": [
            "invitare-verb"
          ]
        },
        {
          "id": "5671013",
          "text": "Posso farmi invitare da voi?",
          "translation": "Можно я к вам в гости напрошусь?",
          "source": "Tatoeba #5671013 @dnnywld / #5670415 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5671013",
          "cefr_level": "A1",
          "word_slugs": [
            "invitare-verb"
          ]
        },
        {
          "id": "5405436",
          "text": "Non avrei dovuto invitare Tom alla festa.",
          "translation": "Мне не стоило приглашать Тома на вечеринку.",
          "source": "Tatoeba #5405436 @dnnywld / #5404901 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5405436",
          "cefr_level": "A1",
          "word_slugs": [
            "invitare-verb"
          ]
        },
        {
          "id": "6367830",
          "text": "Abbiamo intenzione di invitare Tom e Mary.",
          "translation": "Мы собираемся пригласить Тома и Мэри.",
          "source": "Tatoeba #6367830 @dnnywld / #6366903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367830",
          "cefr_level": "A1",
          "word_slugs": [
            "invitare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
