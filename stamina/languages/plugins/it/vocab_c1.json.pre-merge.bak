    {
      "slug": "pirati-noun",
      "lemma": "pirati",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6919,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "11576013",
          "text": "I pirati non bevono mai acqua.",
          "translation": "Пираты никогда не пьют воду.",
          "source": "Tatoeba #11576013 @carlosalberto / #11576018 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11576013",
          "cefr_level": "A1",
          "word_slugs": [
            "pirati-noun"
          ]
        },
        {
          "id": "5601492",
          "text": "Il tesoro fu rubato dai pirati.",
          "translation": "Сокровища были украдены пиратами.",
          "source": "Tatoeba #5601492 @dnnywld / #5601311 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5601492",
          "cefr_level": "A1",
          "word_slugs": [
            "pirati-noun"
          ]
        },
        {
          "id": "3353001",
          "text": "Quei pirati sono armati sino ai denti.",
          "translation": "Эти пираты вооружены до зубов.",
          "source": "Tatoeba #3353001 @bailujia / #3556343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3353001",
          "cefr_level": "A1",
          "word_slugs": [
            "pirati-noun"
          ]
        },
        {
          "id": "6743669",
          "text": "Cosa è raffigurato sulla bandiera dei pirati?",
          "translation": "Что изображено на пиратском флаге?",
          "source": "Tatoeba #6743669 @dnnywld / #6742653 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6743669",
          "cefr_level": "A1",
          "word_slugs": [
            "pirati-noun"
          ]
        },
        {
          "id": "6743670",
          "text": "Solo non parlare con Tom di pirati o di tesori!",
          "translation": "Только не говори с Томом о пиратах и сокровищах!",
          "source": "Tatoeba #6743670 @dnnywld / #6742652 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6743670",
          "cefr_level": "A1",
          "word_slugs": [
            "pirati-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il pirati",
        "plural": "",
        "infinitive": ""
      }
    },
