    {
      "slug": "adulta-adj",
      "lemma": "adulta",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6050,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10954532",
          "text": "Mary adesso è una donna adulta.",
          "translation": "Мэри теперь взрослая женщина.",
          "source": "Tatoeba #10954532 @dnnywld / #9997320 @BW (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10954532",
          "cefr_level": "A1",
          "word_slugs": [
            "adulta-adj"
          ]
        },
        {
          "id": "1217584",
          "text": "Morì prima di essere diventata adulta.",
          "translation": "Она умерла несовершеннолетней.",
          "source": "Tatoeba #1217584 @riccioberto / #4386887 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1217584",
          "cefr_level": "A1",
          "word_slugs": [
            "adulta-adj"
          ]
        },
        {
          "id": "5665986",
          "text": "Lui è un bamnino, e lei adulta.",
          "translation": "Он ребёнок, а она взрослая.",
          "source": "Tatoeba #5665986 @dnnywld / #5665420 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5665986",
          "cefr_level": "A1",
          "word_slugs": [
            "adulta-adj"
          ]
        },
        {
          "id": "7962549",
          "text": "Siete gente adulta, ma credete alla pubblicità.",
          "translation": "Вы взрослые люди, а верите рекламе.",
          "source": "Tatoeba #7962549 @dnnywld / #7962287 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7962549",
          "cefr_level": "A1",
          "word_slugs": [
            "adulta-adj"
          ]
        },
        {
          "id": "7962551",
          "text": "Sei una persona adulta, ma credi alla pubblicità.",
          "translation": "Ты взрослый человек, а веришь рекламе.",
          "source": "Tatoeba #7962551 @dnnywld / #7962285 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7962551",
          "cefr_level": "A1",
          "word_slugs": [
            "adulta-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
