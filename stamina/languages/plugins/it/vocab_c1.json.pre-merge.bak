    {
      "slug": "scritte-adj",
      "lemma": "scritte",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7467,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6367250",
          "text": "Queste domande le ha scritte Tom.",
          "translation": "Эти вопросы написал Том.",
          "source": "Tatoeba #6367250 @dnnywld / #6366996 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367250",
          "cefr_level": "A1",
          "word_slugs": [
            "scritte-adj"
          ]
        },
        {
          "id": "13393396",
          "text": "Le regole sono scritte col sangue.",
          "translation": "Правила пишутся кровью.",
          "source": "Tatoeba #13393396 @Guybrush88 / #13433748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13393396",
          "cefr_level": "A1",
          "word_slugs": [
            "scritte-adj"
          ]
        },
        {
          "id": "13071024",
          "text": "Tutte le scritte erano in cirillico.",
          "translation": "Все надписи были на кириллице.",
          "source": "Tatoeba #13071024 @dnnywld / #13070850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13071024",
