    {
      "slug": "ottobre-noun",
      "lemma": "ottobre",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5205,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5536471",
          "text": "Siamo qui da ottobre.",
          "translation": "Мы здесь с октября.",
          "source": "Tatoeba #5536471 @dnnywld / #5535800 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5536471",
          "cefr_level": "A1",
          "word_slugs": [
            "ottobre-noun"
          ]
        },
        {
          "id": "978345",
          "text": "Sono nato il 10 ottobre 1972.",
          "translation": "Я родился десятого октября тысяча девятьсот семьдесят второго года.",
          "source": "Tatoeba #978345 @riccioberto / #1444608 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/978345",
          "cefr_level": "A1",
          "word_slugs": [
            "ottobre-noun"
          ]
        },
        {
          "id": "5643654",
          "text": "In ottobre divento trentenne.",
          "translation": "В октябре мне исполняется тридцать.",
          "source": "Tatoeba #5643654 @dnnywld / #5642825 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643654",
          "cefr_level": "A1",
          "word_slugs": [
            "ottobre-noun"
          ]
        },
        {
          "id": "6213683",
          "text": "Ero a Boston in ottobre.",
          "translation": "Я была в Бостоне в октябре.",
          "source": "Tatoeba #6213683 @dnnywld / #6213604 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6213683",
          "cefr_level": "A1",
          "word_slugs": [
            "ottobre-noun"
          ]
        },
        {
          "id": "5774589",
          "text": "Era una mattina di ottobre.",
          "translation": "Стояло октябрьское утро.",
          "source": "Tatoeba #5774589 @dnnywld / #5774407 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5774589",
          "cefr_level": "A1",
          "word_slugs": [
            "ottobre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ottobre",
        "plural": "",
        "infinitive": ""
      }
