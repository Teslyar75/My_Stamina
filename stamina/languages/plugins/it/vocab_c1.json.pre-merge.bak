    {
      "slug": "entusiasmo-noun",
      "lemma": "entusiasmo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6431,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6953670",
          "text": "Lui parlava con grande entusiasmo.",
          "translation": "Он говорил с большим воодушевлением.",
          "source": "Tatoeba #6953670 @dnnywld / #2498688 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6953670",
          "cefr_level": "A1",
          "word_slugs": [
            "entusiasmo-noun"
          ]
        },
        {
          "id": "2959745",
          "text": "L'entusiasmo di Tom è contagioso.",
          "translation": "Энтузиазм Тома заразен.",
          "source": "Tatoeba #2959745 @Guybrush88 / #4388951 @girasole (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2959745",
          "cefr_level": "A1",
          "word_slugs": [
            "entusiasmo-noun"
          ]
        },
        {
          "id": "6361813",
          "text": "Tom apprese questa notizia senza entusiasmo.",
          "translation": "Том воспринял эту новость без энтузиазма.",
          "source": "Tatoeba #6361813 @dnnywld / #6361230 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361813",
          "cefr_level": "A1",
          "word_slugs": [
            "entusiasmo-noun"
          ]
        },
        {
          "id": "6361821",
          "text": "Loro accettarono questa proposta senza entusiasmo.",
          "translation": "Они восприняли это предложение без энтузиазма.",
          "source": "Tatoeba #6361821 @dnnywld / #6361229 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6361821",
          "cefr_level": "A1",
          "word_slugs": [
            "entusiasmo-noun"
          ]
        },
        {
          "id": "5513036",
          "text": "Con il solo entusiasmo non andrai lontano.",
          "translation": "На одном энтузиазме далеко не уедешь.",
          "source": "Tatoeba #5513036 @dnnywld / #5512979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5513036",
          "cefr_level": "A1",
          "word_slugs": [
            "entusiasmo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il entusiasmo",
        "plural": "",
        "infinitive": ""
      }
