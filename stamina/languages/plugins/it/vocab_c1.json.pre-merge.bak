          "text": "Io amo i matrimoni.",
          "translation": "Я люблю свадьбы.",
          "source": "Tatoeba #2436704 @Guybrush88 / #3197013 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2436704",
          "cefr_level": "A1",
          "word_slugs": [
            "matrimoni-noun"
          ]
        },
        {
          "id": "5559924",
          "text": "Siamo stati ai reciproci matrimoni.",
          "translation": "Мы были друг у друга на свадьбах.",
          "source": "Tatoeba #5559924 @dnnywld / #5559212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5559924",
          "cefr_level": "A1",
          "word_slugs": [
            "matrimoni-noun"
          ]
        },
        {
          "id": "5559922",
          "text": "Siamo andati ai reciproci matrimoni.",
          "translation": "Мы ходили друг к другу на свадьбу.",
          "source": "Tatoeba #5559922 @dnnywld / #5559213 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5559922",
          "cefr_level": "A1",
          "word_slugs": [
            "matrimoni-noun"
          ]
        },
        {
          "id": "5391689",
          "text": "Tom è contrario ai matrimoni gay.",
          "translation": "Том против однополых браков.",
          "source": "Tatoeba #5391689 @dnnywld / #5391652 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5391689",
          "cefr_level": "A1",
          "word_slugs": [
            "matrimoni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il matrimoni",
        "plural": "",
        "infinitive": ""
      }
