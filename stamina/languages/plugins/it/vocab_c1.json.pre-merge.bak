    {
      "slug": "silenzioso-adj",
      "lemma": "silenzioso",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6899,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5503150",
          "text": "Ieri lui era pensieroso e silenzioso.",
          "translation": "Вчера он был задумчив и молчалив.",
          "source": "Tatoeba #5503150 @dnnywld / #5503050 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5503150",
          "cefr_level": "A1",
          "word_slugs": [
            "silenzioso-adj"
          ]
        },
        {
          "id": "13948550",
          "text": "Il mio telefono è sempre in silenzioso.",
          "translation": "У меня телефон всегда стоит на беззвучном.",
          "source": "Tatoeba #13948550 @Guybrush88 / #11260159 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13948550",
          "cefr_level": "A1",
          "word_slugs": [
            "silenzioso-adj"
          ]
        },
        {
          "id": "5503152",
          "text": "In questo giorno lui è stato molto silenzioso.",
          "translation": "В этот день он был очень молчалив.",
          "source": "Tatoeba #5503152 @dnnywld / #5503046 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5503152",
          "cefr_level": "A1",
          "word_slugs": [
            "silenzioso-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il silenzioso",
        "plural": "",
