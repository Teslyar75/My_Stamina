      "examples": [
        {
          "id": "5971332",
          "text": "Pulite le finestre.",
          "translation": "Помойте окна.",
          "source": "Tatoeba #5971332 @dnnywld / #5969832 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971332",
          "cefr_level": "A1",
