      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "374433",
          "text": "Vive a Tokyo.",
          "translation": "Он живёт в Токио.",
          "source": "Tatoeba #374433 @Pharamp / #426169 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/374433",
          "cefr_level": "A1",
