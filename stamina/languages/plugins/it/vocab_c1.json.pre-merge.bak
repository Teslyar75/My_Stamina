      "examples": [
        {
          "id": "6055559",
          "text": "È stato estratto dal contesto.",
          "translation": "Это было выдернуто из контекста.",
          "source": "Tatoeba #6055559 @dnnywld / #6055233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6055559",
