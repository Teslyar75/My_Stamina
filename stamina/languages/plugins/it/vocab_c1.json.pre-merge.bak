    {
      "slug": "noci-noun",
      "lemma": "noci",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8699,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3222372",
          "text": "Tom è allergico alle noci.",
          "translation": "У Тома аллергия на орехи.",
          "source": "Tatoeba #3222372 @Guybrush88 / #3522989 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3222372",
          "cefr_level": "A1",
          "word_slugs": [
            "noci-noun"
          ]
        },
        {
          "id": "11856466",
          "text": "Gli scoiattoli seppelliscono le noci.",
          "translation": "Белки закапывают орехи.",
          "source": "Tatoeba #11856466 @dnnywld / #11855552 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11856466",
          "cefr_level": "A1",
          "word_slugs": [
            "noci-noun"
          ]
        },
        {
          "id": "6901925",
          "text": "Mi piacciono le noci di Macadamia.",
          "translation": "Люблю орехи макадамии.",
          "source": "Tatoeba #6901925 @dnnywld / #6901381 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6901925",
          "cefr_level": "A1",
          "word_slugs": [
            "noci-noun"
          ]
        },
        {
          "id": "3222371",
          "text": "Questo scoiattolo è allergico alle noci.",
          "translation": "У этой белки аллергия на орехи.",
          "source": "Tatoeba #3222371 @Guybrush88 / #3223420 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3222371",
          "cefr_level": "A1",
          "word_slugs": [
            "noci-noun"
          ]
        },
        {
          "id": "5942906",
          "text": "Gli ospiti hanno mangiato tutte le noci.",
          "translation": "Гости съели все орехи.",
          "source": "Tatoeba #5942906 @dnnywld / #5942847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5942906",
          "cefr_level": "A1",
          "word_slugs": [
            "noci-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la noci",
        "plural": "",
        "infinitive": ""
      }
    },
