      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5443515",
          "text": "Lascia il telecomando.",
          "translation": "Подкинь пульт.",
          "source": "Tatoeba #5443515 @dnnywld / #5327174 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5443515",
          "cefr_level": "A1",
