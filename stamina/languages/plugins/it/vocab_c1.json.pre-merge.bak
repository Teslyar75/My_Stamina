    {
      "slug": "banale-adj",
      "lemma": "banale",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8731,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5442592",
          "text": "Com'è banale.",
          "translation": "Как банально.",
          "source": "Tatoeba #5442592 @dnnywld / #4575976 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5442592",
          "cefr_level": "A1",
          "word_slugs": [
            "banale-adj"
          ]
        },
        {
          "id": "3269725",
          "text": "Questa è molto banale.",
          "translation": "Это очень банально.",
          "source": "Tatoeba #3269725 @Guybrush88 / #11994727 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3269725",
          "cefr_level": "A1",
          "word_slugs": [
            "banale-adj"
          ]
        },
        {
          "id": "10849169",
          "text": "Considerate questa canzone banale?",
          "translation": "Вы считаете эту песню банальной?",
          "source": "Tatoeba #10849169 @dnnywld / #10849093 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849169",
          "cefr_level": "A1",
          "word_slugs": [
            "banale-adj"
          ]
        },
        {
          "id": "1865795",
          "text": "La conclusione può sembrare banale: l'esperanto esiste.",
          "translation": "Вывод может показаться тривиальным: эсперанто существует.",
          "source": "Tatoeba #1865795 @al_ex_an_der / #1865788 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1865795",
          "cefr_level": "A1",
          "word_slugs": [
            "banale-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il banale",
        "plural": "",
