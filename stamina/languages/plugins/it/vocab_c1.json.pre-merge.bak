    {
      "slug": "partecipato-verb",
      "lemma": "partecipato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6624,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10802363",
          "text": "Chi ha partecipato?",
          "translation": "Кто участвовал?",
          "source": "Tatoeba #10802363 @dnnywld / #6315653 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10802363",
          "cefr_level": "A1",
          "word_slugs": [
            "partecipato-verb"
          ]
        },
        {
          "id": "898231",
          "text": "Ha partecipato alla corsa.",
          "translation": "Он принял участие в гонке.",
          "source": "Tatoeba #898231 @Guybrush88 / #513671 @papersaltserver (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/898231",
          "cefr_level": "A1",
          "word_slugs": [
            "partecipato-verb"
          ]
        },
        {
          "id": "4724753",
          "text": "Ho partecipato al seminario.",
          "translation": "Я посетил семинар.",
          "source": "Tatoeba #4724753 @Guybrush88 / #3938785 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4724753",
          "cefr_level": "A1",
          "word_slugs": [
            "partecipato-verb"
          ]
        },
        {
          "id": "10802370",
          "text": "Ho partecipato all'assemblea.",
          "translation": "Я участвовал в собрании.",
          "source": "Tatoeba #10802370 @dnnywld / #2236584 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10802370",
          "cefr_level": "A1",
          "word_slugs": [
            "partecipato-verb"
          ]
        },
        {
          "id": "4958419",
          "text": "Non ho partecipato alla conversazione.",
          "translation": "Я не участвовал в беседе.",
          "source": "Tatoeba #4958419 @Guybrush88 / #1062854 @omsnbnk (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4958419",
          "cefr_level": "A1",
          "word_slugs": [
            "partecipato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il partecipato",
