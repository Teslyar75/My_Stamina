    {
      "slug": "passerà-verb",
      "lemma": "passerà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5908,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12408773",
          "text": "Passerà entro due settimane.",
          "translation": "Это пройдёт само по себе через две недели.",
          "source": "Tatoeba #12408773 @Bernie75 / #12408766 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12408773",
          "cefr_level": "A1",
          "word_slugs": [
            "passerà-verb"
          ]
        },
        {
          "id": "5509604",
          "text": "Sono sicuro che questo passerà.",
          "translation": "Я уверен, что это пройдёт.",
          "source": "Tatoeba #5509604 @dnnywld / #5508961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5509604",
          "cefr_level": "A1",
          "word_slugs": [
            "passerà-verb"
          ]
        },
        {
          "id": "10846961",
          "text": "Tutto passa, passerà anche questa.",
          "translation": "Всё проходит, пройдёт и это.",
          "source": "Tatoeba #10846961 @dnnywld / #10587141 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846961",
          "cefr_level": "A1",
          "word_slugs": [
            "passerà-verb"
          ]
        },
        {
          "id": "6841946",
          "text": "Tom passerà l'esame di sicuro.",
          "translation": "Том непременно сдаст экзамен.",
          "source": "Tatoeba #6841946 @dnnywld / #6373040 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841946",
          "cefr_level": "A1",
          "word_slugs": [
            "passerà-verb"
          ]
        },
        {
          "id": "6841948",
          "text": "Lei passerà l'esame di sicuro.",
          "translation": "Она непременно сдаст экзамен.",
          "source": "Tatoeba #6841948 @dnnywld / #6373044 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841948",
          "cefr_level": "A1",
