    {
      "slug": "politici-adj",
      "lemma": "politici",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5088,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "3845121",
          "text": "Ma che politici abbiamo?",
          "translation": "Но какие у нас политики?",
          "source": "Tatoeba #3845121 @Guybrush88 / #3845131 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3845121",
          "cefr_level": "A1",
          "word_slugs": [
            "politici-adj"
          ]
        },
        {
          "id": "5982398",
          "text": "Quanti politici conosci di persona?",
          "translation": "Со сколькими политиками ты лично знаком?",
          "source": "Tatoeba #5982398 @dnnywld / #5982185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5982398",
          "cefr_level": "A1",
          "word_slugs": [
            "politici-adj"
          ]
        },
        {
          "id": "5982397",
          "text": "Quanti politici conoscete di persona?",
          "translation": "Со сколькими политиками Вы знакомы лично?",
          "source": "Tatoeba #5982397 @dnnywld / #5982186 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5982397",
          "cefr_level": "A1",
          "word_slugs": [
            "politici-adj"
          ]
        },
        {
          "id": "12994946",
          "text": "I politici non sono amici vostri.",
          "translation": "Политики вам не друзья.",
          "source": "Tatoeba #12994946 @dnnywld / #12994233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12994946",
          "cefr_level": "A1",
          "word_slugs": [
            "politici-adj"
          ]
        },
        {
          "id": "5397244",
          "text": "I politici non dicono mail il vero.",
          "translation": "Политики не всегда говорят правду.",
          "source": "Tatoeba #5397244 @dnnywld / #5397238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5397244",
          "cefr_level": "A1",
          "word_slugs": [
            "politici-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il politici",
        "plural": "",
        "infinitive": ""
      }
    },
