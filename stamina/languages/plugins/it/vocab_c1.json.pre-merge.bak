      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5627154",
          "text": "Ha lo stesso identico aspetto.",
          "translation": "Выглядит точно так же.",
          "source": "Tatoeba #5627154 @dnnywld / #5199475 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627154",
          "cefr_level": "A1",
          "word_slugs": [
            "identico-adj"
          ]
        },
        {
          "id": "5627196",
          "text": "Avevo un problema identico una volta.",
          "translation": "У меня когда-то была точно такая же проблема.",
          "source": "Tatoeba #5627196 @dnnywld / #5189855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627196",
          "cefr_level": "A1",
          "word_slugs": [
            "identico-adj"
          ]
        },
        {
          "id": "5627178",
          "text": "Questo orologio è identico a quello che ho perso.",
          "translation": "Это точно такие же часы, какие я потерял.",
          "source": "Tatoeba #5627178 @dnnywld / #3233090 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627178",
          "cefr_level": "A1",
          "word_slugs": [
            "identico-adj"
          ]
        },
        {
          "id": "3260835",
          "text": "Il punto di vista di Tom è quasi identico al mio.",
          "translation": "Точка зрения Тома почти совпадает с моей.",
          "source": "Tatoeba #3260835 @Guybrush88 / #2890187 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3260835",
          "cefr_level": "A1",
          "word_slugs": [
            "identico-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
