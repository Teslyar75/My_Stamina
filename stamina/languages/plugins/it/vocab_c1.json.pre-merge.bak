          ]
        },
        {
          "id": "10885186",
          "text": "È una marmellata fatta in casa.",
          "translation": "Это домашний джем.",
          "source": "Tatoeba #10885186 @dnnywld / #1511739 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10885186",
          "cefr_level": "A1",
