    {
      "slug": "guardavo-verb",
      "lemma": "guardavo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6487,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6324964",
          "text": "A volte guardavo il cielo.",
          "translation": "Иногда я смотрел на небо.",
          "source": "Tatoeba #6324964 @dnnywld / #6324310 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6324964",
          "cefr_level": "A1",
          "word_slugs": [
            "guardavo-verb"
          ]
        },
        {
          "id": "5997023",
          "text": "Quando ero giovane, guardavo spesso il baseball.",
          "translation": "Когда я был молодой, я часто смотрел бейсбол.",
          "source": "Tatoeba #5997023 @dnnywld / #473622 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5997023",
          "cefr_level": "A1",
          "word_slugs": [
            "guardavo-verb"
          ]
        },
        {
          "id": "2474425",
          "text": "Senza dire una parola, guardavo nel buio impenetrabile.",
          "translation": "Я молча смотрел в непроглядную тьму.",
          "source": "Tatoeba #2474425 @al_ex_an_der / #2474405 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2474425",
          "cefr_level": "A1",
          "word_slugs": [
            "guardavo-verb"
          ]
        },
        {
          "id": "2062997",
          "text": "Nella mia infanzia venivo spesso qui. Mi guardavo intorno e pensavo.",
          "translation": "В детстве я часто приходил сюда, смотрел вокруг и думал.",
          "source": "Tatoeba #2062997 @al_ex_an_der / #2062989 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2062997",
          "cefr_level": "A1",
          "word_slugs": [
            "guardavo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "guardavo",
        "plural": "",
        "infinitive": "guardavo"
      }
