    {
      "slug": "eterna-adj",
      "lemma": "eterna",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6204,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5612338",
          "text": "L'anima è eterna.",
          "translation": "Душа - вечна.",
          "source": "Tatoeba #5612338 @Guybrush88 / #2524221 @dimitris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5612338",
          "cefr_level": "A1",
          "word_slugs": [
            "eterna-adj"
          ]
        },
        {
          "id": "5497499",
          "text": "Credi nella vita eterna?",
          "translation": "Ты веришь в вечную жизнь?",
          "source": "Tatoeba #5497499 @dnnywld / #5497177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497499",
          "cefr_level": "A1",
          "word_slugs": [
            "eterna-adj"
          ]
        },
        {
          "id": "5497498",
          "text": "Credete nella vita eterna?",
          "translation": "Вы верите в вечную жизнь?",
          "source": "Tatoeba #5497498 @dnnywld / #5497178 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497498",
          "cefr_level": "A1",
          "word_slugs": [
            "eterna-adj"
          ]
        },
        {
          "id": "12371052",
          "text": "Né gioia eterna né dolore infinito.",
          "translation": "Ни радости вечной, ни печали бесконечной.",
          "source": "Tatoeba #12371052 @Bernie75 / #2760081 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12371052",
          "cefr_level": "A1",
          "word_slugs": [
            "eterna-adj"
          ]
        },
        {
          "id": "5984928",
          "text": "Madeira è un giardino fiorito dove la primavera regna eterna.",
          "translation": "Мадейра — это цветущий сад, где царит вечная весна.",
          "source": "Tatoeba #5984928 @dnnywld / #5984522 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5984928",
          "cefr_level": "A1",
          "word_slugs": [
            "eterna-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il eterna",
        "plural": "",
        "infinitive": ""
      }
