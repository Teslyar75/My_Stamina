    {
      "slug": "ballerina-noun",
      "lemma": "ballerina",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6975,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6858806",
          "text": "Sognava di diventare ballerina.",
          "translation": "Ей приснилось, что она стала балериной.",
          "source": "Tatoeba #6858806 @dnnywld / #6858725 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6858806",
          "cefr_level": "A1",
          "word_slugs": [
            "ballerina-noun"
          ]
        },
        {
          "id": "3514687",
          "text": "Aoi è diventata una ballerina.",
          "translation": "Аой стала танцовщицей.",
          "source": "Tatoeba #3514687 @Guybrush88 / #3621475 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3514687",
          "cefr_level": "A1",
          "word_slugs": [
            "ballerina-noun"
          ]
        },
        {
          "id": "10812400",
          "text": "La prima ballerina uscì dal teatro.",
          "translation": "Прима-балерина ушла из театра.",
          "source": "Tatoeba #10812400 @dnnywld / #10812399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10812400",
          "cefr_level": "A1",
          "word_slugs": [
            "ballerina-noun"
          ]
        },
        {
          "id": "10812401",
          "text": "La prima ballerina lasciò il teatro.",
          "translation": "Прима-балерина покинула театр.",
          "source": "Tatoeba #10812401 @dnnywld / #10812398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10812401",
          "cefr_level": "A1",
          "word_slugs": [
            "ballerina-noun"
          ]
        },
        {
          "id": "6810162",
          "text": "La ballerina si contorce come un serpente.",
          "translation": "Танцовщица извивается, как змея.",
          "source": "Tatoeba #6810162 @dnnywld / #6807739 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6810162",
          "cefr_level": "A1",
          "word_slugs": [
            "ballerina-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
