          "source": "Tatoeba #5401185 @dnnywld / #4148406 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5401185",
          "cefr_level": "A1",
          "word_slugs": [
            "riga-verb"
          ]
        },
        {
          "id": "6961755",
          "text": "C'è almeno una riga scritta dalla mano di Tom?",
          "translation": "Есть хоть одна строчка, написанная рукой Тома?",
          "source": "Tatoeba #6961755 @dnnywld / #6961699 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961755",
          "cefr_level": "A1",
          "word_slugs": [
            "riga-verb"
          ]
        },
        {
          "id": "6961758",
          "text": "C'è almeno una riga scritta da Tom di sua mano?",
          "translation": "Есть хоть одна строчка, написанная Томом от руки?",
          "source": "Tatoeba #6961758 @dnnywld / #6961697 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961758",
          "cefr_level": "A1",
          "word_slugs": [
            "riga-verb"
          ]
        }
      ],
