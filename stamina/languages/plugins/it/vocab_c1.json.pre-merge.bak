      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5700241",
          "text": "Cosa intendeva Tom?",
          "translation": "Что Том имел в виду?",
          "source": "Tatoeba #5700241 @dnnywld / #5699965 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5700241",
          "cefr_level": "A1",
          "word_slugs": [
            "intendeva-verb"
          ]
        },
        {
          "id": "5434444",
          "text": "Tom non intendeva tacere.",
          "translation": "Том не собирался молчать.",
          "source": "Tatoeba #5434444 @dnnywld / #4037550 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5434444",
          "cefr_level": "A1",
          "word_slugs": [
            "intendeva-verb"
          ]
        },
        {
          "id": "5610407",
          "text": "Tom intendeva proprio questo.",
          "translation": "Том действительно имел это в виду.",
          "source": "Tatoeba #5610407 @dnnywld / #5609885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5610407",
          "cefr_level": "A1",
          "word_slugs": [
            "intendeva-verb"
          ]
        },
        {
          "id": "5501311",
          "text": "È questo che intendeva Tom?",
          "translation": "Том это имел в виду?",
          "source": "Tatoeba #5501311 @dnnywld / #5501203 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5501311",
