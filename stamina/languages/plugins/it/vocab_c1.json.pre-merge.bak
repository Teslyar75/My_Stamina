      "cefr_level": "C1",
      "frequency_rank": 8317,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "863537",
          "text": "Non fumi, vero?",
          "translation": "Ты же не куришь?",
          "source": "Tatoeba #863537 @Guybrush88 / #7748360 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/863537",
          "cefr_level": "A1",
          "word_slugs": [
            "fumi-verb"
          ]
        },
        {
          "id": "5559912",
          "text": "Da quanto tempo fumi?",
          "translation": "Как долго ты куришь?",
          "source": "Tatoeba #5559912 @dnnywld / #5559231 @maaster (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5559912",
          "cefr_level": "A1",
          "word_slugs": [
            "fumi-verb"
          ]
        },
        {
          "id": "5767925",
          "text": "Pensi di essere figo perché fumi?",
          "translation": "Думаешь, если куришь, то крутой?",
          "source": "Tatoeba #5767925 @dnnywld / #5767661 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5767925",
          "cefr_level": "A1",
          "word_slugs": [
            "fumi-verb"
          ]
        },
        {
          "id": "6967735",
          "text": "\"Fumi?\" - \"Fumo, ma raramente. E tu? - \"Io smetto. Ma spesso\".",
          "translation": "\"Ты куришь?\" — \"Курю, но редко. А ты?\" — \"Бросаю. Но часто\".",
          "source": "Tatoeba #6967735 @dnnywld / #6844345 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6967735",
          "cefr_level": "A1",
          "word_slugs": [
            "fumi-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "fumi",
        "plural": "",
        "infinitive": "fumi"
      }
    },
    {
      "slug": "alzate-verb",
      "lemma": "alzate",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8318,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5604272",
          "text": "Alzate la cornetta.",
          "translation": "Снимите трубку.",
          "source": "Tatoeba #5604272 @dnnywld / #5604259 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5604272",
          "cefr_level": "A1",
          "word_slugs": [
            "alzate-verb"
          ]
        },
        {
          "id": "5489689",
          "text": "Vi alzate alle sei?",
          "translation": "Вы встаёте в шесть?",
          "source": "Tatoeba #5489689 @dnnywld / #5489675 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489689",
          "cefr_level": "A1",
          "word_slugs": [
            "alzate-verb"
          ]
        },
        {
          "id": "5666171",
          "text": "Tom uscì di casa con le mani alzate.",
          "translation": "Том вышел из дома с поднятыми руками.",
          "source": "Tatoeba #5666171 @dnnywld / #5666003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5666171",
          "cefr_level": "A1",
          "word_slugs": [
            "alzate-verb"
          ]
        },
        {
          "id": "5666160",
          "text": "Uscite uno alla volta con le mani alzate!",
          "translation": "Выходи по одному с поднятыми руками!",
          "source": "Tatoeba #5666160 @dnnywld / #5666005 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5666160",
          "cefr_level": "A1",
          "word_slugs": [
            "alzate-verb"
          ]
        },
        {
          "id": "5487696",
          "text": "\"A che ora vi alzate?\" - \"Alle 8 di mattina\".",
          "translation": "«Когда Вы встаёте?» — «В 8 утра».",
          "source": "Tatoeba #5487696 @dnnywld / #389086 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5487696",
          "cefr_level": "A1",
          "word_slugs": [
            "alzate-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "alzate",
        "plural": "",
        "infinitive": "alzate"
      }
    },
    {
      "slug": "educato-adj",
