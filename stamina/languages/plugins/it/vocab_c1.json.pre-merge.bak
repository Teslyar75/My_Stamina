    {
      "slug": "ritiro-noun",
      "lemma": "ritiro",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5174,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6881904",
          "text": "Ritiro tutto ciò che ho detto.",
          "translation": "Я забираю все свои слова обратно.",
          "source": "Tatoeba #6881904 @dnnywld / #6523253 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881904",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiro-noun"
          ]
        },
        {
          "id": "1575962",
          "text": "Ritiro tutto quello che ho detto.",
          "translation": "Я беру все свои слова обратно.",
          "source": "Tatoeba #1575962 @Guybrush88 / #4419241 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1575962",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiro-noun"
          ]
        },
        {
          "id": "2947922",
          "text": "Mi dispiace. Ritiro quello che ho detto.",
          "translation": "Извините. Беру свои слова обратно.",
          "source": "Tatoeba #2947922 @Guybrush88 / #556023 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2947922",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiro-noun"
          ]
        },
        {
          "id": "1739826",
          "text": "Se non era tua intenzione dire così, ritiro ciò che ho detto.",
          "translation": "Если ты не имел этого в виду, то я беру свои слова обратно.",
          "source": "Tatoeba #1739826 @Guybrush88 / #3800930 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1739826",
          "cefr_level": "A1",
          "word_slugs": [
            "ritiro-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
