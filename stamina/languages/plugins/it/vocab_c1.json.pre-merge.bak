        {
          "id": "2029000",
          "text": "Queste menzogne sono imperdonabili.",
          "translation": "Это непростительная ложь.",
          "source": "Tatoeba #2029000 @Sirio60 / #6020624 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2029000",
