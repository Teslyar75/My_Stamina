    {
      "slug": "rapinato-verb",
      "lemma": "rapinato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9331,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10808483",
          "text": "Ti hanno rapinato?",
          "translation": "Тебя ограбили?",
          "source": "Tatoeba #10808483 @dnnywld / #4342844 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10808483",
          "cefr_level": "A1",
          "word_slugs": [
            "rapinato-verb"
          ]
        },
        {
          "id": "10878719",
          "text": "Vi hanno mai rapinato?",
          "translation": "Вас когда-нибудь грабили?",
          "source": "Tatoeba #10878719 @dnnywld / #2619772 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878719",
          "cefr_level": "A1",
          "word_slugs": [
            "rapinato-verb"
          ]
        },
        {
          "id": "10878718",
          "text": "Aiuto! Mi hanno rapinato!",
          "translation": "Помогите! Грабят!",
          "source": "Tatoeba #10878718 @dnnywld / #6616390 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10878718",
          "cefr_level": "A1",
          "word_slugs": [
            "rapinato-verb"
          ]
        },
        {
          "id": "5498170",
          "text": "Una volta ci hanno rapinato.",
          "translation": "Нас однажды ограбили.",
          "source": "Tatoeba #5498170 @dnnywld / #5498153 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5498170",
          "cefr_level": "A1",
          "word_slugs": [
            "rapinato-verb"
          ]
        },
        {
          "id": "5510905",
          "text": "Hanno rapinato questa banca diverse volte.",
          "translation": "Этот банк грабили несколько раз.",
          "source": "Tatoeba #5510905 @dnnywld / #5510694 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5510905",
          "cefr_level": "A1",
          "word_slugs": [
            "rapinato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il rapinato",
        "plural": "",
        "infinitive": "rapinato"
      }
