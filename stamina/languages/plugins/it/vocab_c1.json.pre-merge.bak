    {
      "slug": "cambierà-verb",
      "lemma": "cambierà",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6347,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5472419",
          "text": "Ora cambierà tutto.",
          "translation": "Теперь всё изменится.",
          "source": "Tatoeba #5472419 @dnnywld / #4091121 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472419",
          "cefr_level": "A1",
          "word_slugs": [
            "cambierà-verb"
          ]
        },
        {
          "id": "4375",
          "text": "Non cambierà niente.",
          "translation": "Это ничего не изменит.",
          "source": "Tatoeba #4375 @meursault / #5431 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4375",
          "cefr_level": "A1",
          "word_slugs": [
            "cambierà-verb"
          ]
        },
        {
          "id": "12388952",
          "text": "Questo cambierà tutto.",
          "translation": "Это всё изменит.",
          "source": "Tatoeba #12388952 @Rovo / #12388798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12388952",
          "cefr_level": "A1",
          "word_slugs": [
            "cambierà-verb"
          ]
        },
        {
          "id": "5526910",
          "text": "Tom non cambierà mai.",
          "translation": "Том никогда не изменится.",
          "source": "Tatoeba #5526910 @dnnywld / #5525460 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5526910",
          "cefr_level": "A1",
          "word_slugs": [
            "cambierà-verb"
          ]
        },
        {
          "id": "5472430",
          "text": "Tom cambierà il mondo.",
          "translation": "Том изменит мир.",
          "source": "Tatoeba #5472430 @dnnywld / #4534913 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472430",
