    {
      "slug": "portò-verb",
      "lemma": "portò",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9821,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5688611",
          "text": "Tom portò la torta.",
          "translation": "Том принёс пирог.",
          "source": "Tatoeba #5688611 @dnnywld / #5215794 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688611",
          "cefr_level": "A1",
          "word_slugs": [
            "portò-verb"
          ]
        },
        {
          "id": "5688606",
          "text": "Tom portò una coperta.",
          "translation": "Том принёс одеяло.",
          "source": "Tatoeba #5688606 @dnnywld / #4766243 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688606",
          "cefr_level": "A1",
          "word_slugs": [
            "portò-verb"
          ]
        },
        {
          "id": "6904585",
          "text": "Lei lo portò allo zoo.",
          "translation": "Она повела его в зоопарк.",
          "source": "Tatoeba #6904585 @dnnywld / #2581315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904585",
          "cefr_level": "A1",
          "word_slugs": [
            "portò-verb"
          ]
        },
        {
          "id": "5688620",
          "text": "Bill mi portò il libro.",
          "translation": "Билл принёс мне книгу.",
          "source": "Tatoeba #5688620 @dnnywld / #2832408 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688620",
          "cefr_level": "A1",
          "word_slugs": [
            "portò-verb"
          ]
        },
        {
          "id": "5688751",
          "text": "Lui le portò dei fiori.",
          "translation": "Он принёс ей цветы.",
          "source": "Tatoeba #5688751 @dnnywld / #4302465 @whatnot (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5688751",
          "cefr_level": "A1",
