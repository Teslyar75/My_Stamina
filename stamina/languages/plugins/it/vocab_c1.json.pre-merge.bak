      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "Функция"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5536515",
          "text": "Disegnate il grafico della funzione y = 2x + 3.",
          "translation": "Постройте график функции y = 2x + 3.",
          "source": "Tatoeba #5536515 @dnnywld / #5535657 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5536515",
          "cefr_level": "A1",
          "word_slugs": [
            "funzione-noun"
          ]
        },
        {
          "id": "5551628",
          "text": "Il valore della funzione coseno si ripete con periodo 2π.",
          "translation": "Значения функции косинуса повторяются с периодом 2π.",
          "source": "Tatoeba #5551628 @dnnywld / #5551588 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5551628",
          "cefr_level": "A1",
          "word_slugs": [
            "funzione-noun"
          ]
        },
        {
          "id": "5526902",
          "text": "Per problemi tecnici la funzione ricerca è al momento disabilitata.",
          "translation": "По техническим причинам функция поиска в данный момент отключена.",
          "source": "Tatoeba #5526902 @dnnywld / #5525537 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5526902",
          "cefr_level": "A1",
          "word_slugs": [
            "funzione-noun"
          ]
        },
        {
          "id": "5632946",
          "text": "Calcolate il valore della funzione f(x) = x² nel punto x=3.",
          "translation": "Вычислите значение функции f(x) = x² для x = 3.",
          "source": "Tatoeba #5632946 @dnnywld / #5632699 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632946",
          "cefr_level": "A1",
          "word_slugs": [
            "funzione-noun"
          ]
        },
        {
          "id": "5627361",
          "text": "Determinate i punti di massimo e di minimo della seguente funzione.",
          "translation": "Найдите наибольшее и наименьшее значение следующей функции.",
          "source": "Tatoeba #5627361 @dnnywld / #3563670 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5627361",
          "cefr_level": "A1",
          "word_slugs": [
            "funzione-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la funzione",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "eterno-adj",
      "lemma": "eterno",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5422,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5499604",
          "text": "L'amore è eterno.",
          "translation": "Любовь бессмертна.",
          "source": "Tatoeba #5499604 @dnnywld / #5499578 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499604",
          "cefr_level": "A1",
          "word_slugs": [
            "eterno-adj"
          ]
        },
        {
          "id": "5542080",
          "text": "Non vivrò in eterno.",
          "translation": "Я не собираюсь жить вечно.",
          "source": "Tatoeba #5542080 @dnnywld / #5541091 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5542080",
          "cefr_level": "A1",
          "word_slugs": [
            "eterno-adj"
          ]
        },
        {
          "id": "5412102",
          "text": "Non posso nascondermi in eterno.",
          "translation": "Я не могу прятаться вечно.",
          "source": "Tatoeba #5412102 @dnnywld / #3668142 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5412102",
          "cefr_level": "A1",
          "word_slugs": [
            "eterno-adj"
          ]
        },
        {
          "id": "5512110",
          "text": "Lui si immerse nel sonno eterno.",
          "translation": "Он погрузился в вечный сон.",
          "source": "Tatoeba #5512110 @dnnywld / #5511096 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5512110",
          "cefr_level": "A1",
          "word_slugs": [
            "eterno-adj"
          ]
        },
        {
          "id": "6770165",
          "text": "Vedete, nessuna sofferenza dura in eterno.",
          "translation": "Поймите, что ни одно страдание не длится вечно.",
          "source": "Tatoeba #6770165 @dnnywld / #6770074 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770165",
          "cefr_level": "A1",
          "word_slugs": [
            "eterno-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il eterno",
        "plural": "",
        "infinitive": ""
      }
    },
