    {
      "slug": "modulo-noun",
      "lemma": "modulo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5106,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6142333",
          "text": "Avete compilato il modulo?",
          "translation": "Вы заполнили анкету?",
          "source": "Tatoeba #6142333 @dnnywld / #6141590 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6142333",
          "cefr_level": "A1",
          "word_slugs": [
            "modulo-noun"
          ]
        },
        {
          "id": "5845123",
          "text": "Questo modulo non è utilizzato.",
          "translation": "Эта форма не используется.",
          "source": "Tatoeba #5845123 @dnnywld / #2694486 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845123",
          "cefr_level": "A1",
          "word_slugs": [
            "modulo-noun"
          ]
        },
        {
          "id": "819231",
          "text": "Compila questo modulo, per favore.",
          "translation": "Заполни, пожалуйста, этот бланк.",
          "source": "Tatoeba #819231 @Guybrush88 / #5667750 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/819231",
          "cefr_level": "A1",
          "word_slugs": [
            "modulo-noun"
          ]
        },
        {
          "id": "6142332",
          "text": "Ho compilato il modulo, eccolo qua.",
          "translation": "Я заполнил анкету, вот она.",
          "source": "Tatoeba #6142332 @dnnywld / #6141595 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6142332",
          "cefr_level": "A1",
          "word_slugs": [
            "modulo-noun"
          ]
        },
        {
          "id": "10846268",
          "text": "Puoi spiegarmi come riempire questo modulo?",
          "translation": "Можешь объяснить мне, как заполнить этот бланк?",
          "source": "Tatoeba #10846268 @dnnywld / #5537209 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10846268",
          "cefr_level": "A1",
          "word_slugs": [
            "modulo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "modulo",
        "plural": "",
        "infinitive": ""
      }
