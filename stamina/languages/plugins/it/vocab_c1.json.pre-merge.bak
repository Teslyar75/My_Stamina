    {
      "slug": "bruciando-verb",
      "lemma": "bruciando",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8849,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "12381465",
          "text": "Sto bruciando i soldi.",
          "translation": "Я жгу деньги.",
          "source": "Tatoeba #12381465 @dnnywld / #12381370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12381465",
          "cefr_level": "A1",
          "word_slugs": [
            "bruciando-verb"
          ]
        },
        {
          "id": "5506749",
          "text": "La tua casa sta bruciando!",
          "translation": "У тебя дом горит!",
          "source": "Tatoeba #5506749 @dnnywld / #5506209 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506749",
          "cefr_level": "A1",
          "word_slugs": [
            "bruciando-verb"
          ]
        },
        {
          "id": "12381464",
          "text": "Sto bruciando i miei soldi.",
          "translation": "Я жгу свои деньги.",
          "source": "Tatoeba #12381464 @dnnywld / #12381371 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12381464",
          "cefr_level": "A1",
          "word_slugs": [
            "bruciando-verb"
          ]
        },
        {
          "id": "5506748",
          "text": "La vostra casa sta bruciando!",
          "translation": "У вас дом горит!",
          "source": "Tatoeba #5506748 @dnnywld / #5506210 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5506748",
          "cefr_level": "A1",
          "word_slugs": [
            "bruciando-verb"
          ]
        },
        {
          "id": "5451290",
          "text": "Nel parcheggio sta bruciando una macchina.",
          "translation": "На парковке горит машина.",
          "source": "Tatoeba #5451290 @dnnywld / #5451130 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5451290",
          "cefr_level": "A1",
          "word_slugs": [
            "bruciando-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
