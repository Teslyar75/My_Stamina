    {
      "slug": "prosciutto-noun",
      "lemma": "prosciutto",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7257,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5421429",
          "text": "Prendi del prosciutto.",
          "translation": "Возьми ветчины.",
          "source": "Tatoeba #5421429 @dnnywld / #3512546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5421429",
          "cefr_level": "A1",
          "word_slugs": [
            "prosciutto-noun"
          ]
        },
        {
          "id": "5421423",
          "text": "Prendete del prosciutto.",
          "translation": "Возьмите ветчины.",
          "source": "Tatoeba #5421423 @dnnywld / #3512545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5421423",
          "cefr_level": "A1",
          "word_slugs": [
            "prosciutto-noun"
          ]
        },
        {
          "id": "10859325",
          "text": "È rimasto il prosciutto?",
          "translation": "Ветчина осталась?",
          "source": "Tatoeba #10859325 @dnnywld / #8261114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10859325",
          "cefr_level": "A1",
          "word_slugs": [
            "prosciutto-noun"
          ]
        },
        {
          "id": "5479364",
          "text": "A Tom piacciono le uova al prosciutto.",
          "translation": "Том любит яичницу с ветчиной.",
          "source": "Tatoeba #5479364 @dnnywld / #5479347 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5479364",
          "cefr_level": "A1",
          "word_slugs": [
            "prosciutto-noun"
          ]
        },
        {
          "id": "5599103",
          "text": "Il maiale di oggi è il prosciutto di domani.",
          "translation": "Сегодняшние свиньи - это завтрашняя ветчина.",
          "source": "Tatoeba #5599103 @dnnywld / #3353029 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5599103",
          "cefr_level": "A1",
          "word_slugs": [
            "prosciutto-noun"
          ]
        }
      ],
