    {
      "slug": "proseguire-verb",
      "lemma": "proseguire",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6801,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "13561560",
          "text": "Può proseguire lui ora.",
          "translation": "Теперь он может продолжить.",
          "source": "Tatoeba #13561560 @Guybrush88 / #13564266 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13561560",
          "cefr_level": "A1",
          "word_slugs": [
            "proseguire-verb"
          ]
        },
        {
          "id": "5828015",
          "text": "Una volta che hai cominciato, devi proseguire.",
          "translation": "Однажды начав, ты должен продолжить.",
          "source": "Tatoeba #5828015 @dnnywld / #2454189 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5828015",
          "cefr_level": "A1",
          "word_slugs": [
            "proseguire-verb"
          ]
        },
        {
          "id": "7702724",
          "text": "Lui decise di restare e proseguire gli affari di suo padre.",
          "translation": "Он решил остаться и продолжить дело своего отца.",
          "source": "Tatoeba #7702724 @dnnywld / #7702369 @mytmpacc2015 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7702724",
          "cefr_level": "A1",
          "word_slugs": [
            "proseguire-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "proseguire",
        "plural": "",
        "infinitive": "proseguire"
      }
