    {
      "slug": "raggi-noun",
      "lemma": "raggi",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6005,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5408069",
          "text": "Proteggere dai raggi solari.",
          "translation": "Беречь от солнечных лучей.",
          "source": "Tatoeba #5408069 @dnnywld / #2102640 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408069",
          "cefr_level": "A1",
          "word_slugs": [
            "raggi-noun"
          ]
        },
        {
          "id": "5408087",
          "text": "Proteggere dai raggi solari diretti.",
          "translation": "Беречь от попадания прямых солнечных лучей.",
          "source": "Tatoeba #5408087 @dnnywld / #1544504 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408087",
          "cefr_level": "A1",
          "word_slugs": [
            "raggi-noun"
          ]
        },
        {
          "id": "5571266",
          "text": "La neve riflette i raggi ultravioletti.",
          "translation": "Снег отражает ультрафиолетовые лучи.",
          "source": "Tatoeba #5571266 @dnnywld / #5570378 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571266",
          "cefr_level": "A1",
          "word_slugs": [
            "raggi-noun"
          ]
        }
      ],
      "tags": [
