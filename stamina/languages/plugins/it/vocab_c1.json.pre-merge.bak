    {
      "slug": "notiziario-noun",
      "lemma": "notiziario",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7566,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5415942",
          "text": "Era al notiziario.",
          "translation": "Это было в новостях.",
          "source": "Tatoeba #5415942 @dnnywld / #3532629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415942",
          "cefr_level": "A1",
          "word_slugs": [
            "notiziario-noun"
          ]
        },
        {
          "id": "6950621",
          "text": "È il notiziario delle dieci.",
          "translation": "Это десятичасовые новости.",
          "source": "Tatoeba #6950621 @dnnywld / #3014606 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6950621",
          "cefr_level": "A1",
          "word_slugs": [
            "notiziario-noun"
          ]
        },
        {
          "id": "5995565",
          "text": "Tom sta guardando il notiziario.",
          "translation": "Том смотрит новости.",
          "source": "Tatoeba #5995565 @dnnywld / #5995305 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5995565",
          "cefr_level": "A1",
