          "cefr_level": "A1",
          "word_slugs": [
            "correttamente-adv"
          ]
        },
        {
          "id": "5982333",
          "text": "Tom agisce sempre correttamente.",
          "translation": "Том всегда поступает правильно.",
          "source": "Tatoeba #5982333 @dnnywld / #5982240 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5982333",
          "cefr_level": "A1",
          "word_slugs": [
