    {
      "slug": "ignorare-verb",
      "lemma": "ignorare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6321,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5605054",
          "text": "Non posso ignorare Tom.",
          "translation": "Я не могу не обращать на Тома внимания.",
          "source": "Tatoeba #5605054 @Guybrush88 / #5675291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5605054",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorare-verb"
          ]
        },
        {
          "id": "5985220",
          "text": "Non ignorare i suoi sentimenti.",
          "translation": "Не игнорируй её чувства.",
          "source": "Tatoeba #5985220 @dnnywld / #1011175 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5985220",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorare-verb"
          ]
        },
        {
          "id": "5516004",
          "text": "I fatti non si possono ignorare.",
          "translation": "Факты - вещь упрямая.",
          "source": "Tatoeba #5516004 @dnnywld / #5515933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5516004",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorare-verb"
          ]
        },
        {
          "id": "5502391",
          "text": "Non possiamo semplicemente ignorare il problema.",
          "translation": "Мы не можем просто игнорировать эту проблему.",
          "source": "Tatoeba #5502391 @dnnywld / #5502067 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5502391",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorare-verb"
          ]
        },
        {
          "id": "5620596",
          "text": "Tom è ignorato ad ignorare il baccano.",
          "translation": "Том привык не замечать шум.",
          "source": "Tatoeba #5620596 @dnnywld / #4802607 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5620596",
          "cefr_level": "A1",
          "word_slugs": [
            "ignorare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ignorare",
        "plural": "",
        "infinitive": "ignorare"
      }
