    {
      "slug": "freni-noun",
      "lemma": "freni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7804,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10861698",
          "text": "Sentii lo stridio dei freni.",
          "translation": "Я услышал визг тормозов.",
          "source": "Tatoeba #10861698 @dnnywld / #8523788 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10861698",
          "cefr_level": "A1",
          "word_slugs": [
            "freni-noun"
          ]
        },
        {
          "id": "5753099",
          "text": "Anche i freni non funzionano.",
          "translation": "Тормоза тоже не работают.",
          "source": "Tatoeba #5753099 @dnnywld / #5750200 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5753099",
          "cefr_level": "A1",
          "word_slugs": [
            "freni-noun"
          ]
        },
        {
          "id": "10861705",
          "text": "Sentivo lo stridio dei freni.",
          "translation": "Я слышал визг тормозов.",
          "source": "Tatoeba #10861705 @dnnywld / #8523789 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10861705",
          "cefr_level": "A1",
          "word_slugs": [
            "freni-noun"
          ]
        },
        {
          "id": "5462078",
          "text": "Comprerò la macchina solo nel caso in cui riparino prima i freni.",
          "translation": "Я куплю машину только в том случае, если они прежде отремонтируют тормоза.",
          "source": "Tatoeba #5462078 @dnnywld / #5461400 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5462078",
          "cefr_level": "A1",
          "word_slugs": [
            "freni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
