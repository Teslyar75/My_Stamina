    {
      "slug": "sostanza-noun",
      "lemma": "sostanza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5345,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "вещество"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "10861505",
          "text": "È una sostanza esplosiva?",
          "translation": "Это взрывчатые вещества?",
          "source": "Tatoeba #10861505 @dnnywld / #4741556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10861505",
          "cefr_level": "A1",
          "word_slugs": [
            "sostanza-noun"
          ]
        },
        {
          "id": "350335",
          "text": "Il sale è una sostanza utile.",
          "translation": "Соль - полезное вещество.",
          "source": "Tatoeba #350335 @martin / #573322 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350335",
          "cefr_level": "A1",
          "word_slugs": [
            "sostanza-noun"
          ]
        },
        {
          "id": "5862138",
          "text": "L'acqua è una sostanza liquida.",
          "translation": "Вода — жидкое вещество.",
          "source": "Tatoeba #5862138 @dnnywld / #5861978 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5862138",
          "cefr_level": "A1",
          "word_slugs": [
            "sostanza-noun"
          ]
        },
        {
          "id": "5820077",
          "text": "Questa sostanza si scioglie in acqua?",
          "translation": "Это вещество растворяется в воде?",
          "source": "Tatoeba #5820077 @dnnywld / #5818683 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5820077",
          "cefr_level": "A1",
          "word_slugs": [
            "sostanza-noun"
          ]
        },
        {
          "id": "6219062",
          "text": "Questa sostanza sta passando dallo stato liquido a quello gassoso.",
          "translation": "Это вещество переходит из жидкого состояния в газообразное.",
          "source": "Tatoeba #6219062 @dnnywld / #6218703 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6219062",
          "cefr_level": "A1",
          "word_slugs": [
            "sostanza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la sostanza",
        "plural": "",
