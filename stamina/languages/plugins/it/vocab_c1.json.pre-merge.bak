          ]
        },
        {
          "id": "6810232",
          "text": "Facendo attenzione, Maria pose il coniglio congelato nel microonde.",
          "translation": "Мария осторожно положила глубоко замороженного зайца в микроволновку.",
          "source": "Tatoeba #6810232 @dnnywld / #6807685 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6810232",
          "cefr_level": "A1",
          "word_slugs": [
            "microonde-noun"
          ]
        },
        {
          "id": "2799222",
          "text": "Un forno a microonde riscalda il cibo in un istante.",
          "translation": "Микроволновая печь разогревает еду мгновенно.",
          "source": "Tatoeba #2799222 @Guybrush88 / #3063798 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2799222",
          "cefr_level": "A1",
          "word_slugs": [
            "microonde-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
