      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10802370",
          "text": "Ho partecipato all'assemblea.",
          "translation": "Я участвовал в собрании.",
          "source": "Tatoeba #10802370 @dnnywld / #2236584 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10802370",
