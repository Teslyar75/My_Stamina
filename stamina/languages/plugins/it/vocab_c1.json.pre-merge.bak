    {
      "slug": "ridurre-verb",
      "lemma": "ridurre",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6809,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6956615",
          "text": "So come ridurre le perdite.",
          "translation": "Я знаю, как уменьшить потери.",
          "source": "Tatoeba #6956615 @dnnywld / #6956180 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6956615",
          "cefr_level": "A1",
          "word_slugs": [
            "ridurre-verb"
          ]
        },
        {
          "id": "6108754",
          "text": "Siamo riusciti a ridurre i costi.",
          "translation": "Нам удалось снизить расходы.",
          "source": "Tatoeba #6108754 @dnnywld / #6108685 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6108754",
          "cefr_level": "A1",
          "word_slugs": [
            "ridurre-verb"
          ]
        },
        {
          "id": "6831678",
          "text": "Hai bisogno di ridurre la velocità.",
          "translation": "Тебе нужно снизить скорость.",
          "source": "Tatoeba #6831678 @dnnywld / #6831555 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6831678",
          "cefr_level": "A1",
          "word_slugs": [
            "ridurre-verb"
          ]
        },
        {
          "id": "6908785",
          "text": "Dobbiamo ridurre al minimo i costi.",
          "translation": "Мы должны свести расходы к минимуму.",
          "source": "Tatoeba #6908785 @dnnywld / #2865712 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908785",
          "cefr_level": "A1",
          "word_slugs": [
            "ridurre-verb"
          ]
        },
        {
          "id": "6831677",
          "text": "Avete bisogno di ridurre la velocità.",
          "translation": "Вам нужно снизить скорость.",
          "source": "Tatoeba #6831677 @dnnywld / #6831556 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6831677",
          "cefr_level": "A1",
          "word_slugs": [
            "ridurre-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "ridurre",
        "plural": "",
        "infinitive": "ridurre"
