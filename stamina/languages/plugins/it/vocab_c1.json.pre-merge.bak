    {
      "slug": "nipoti-noun",
      "lemma": "nipoti",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7038,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "8919389",
          "text": "Abbiamo quattro nipoti.",
          "translation": "У нас четверо внуков.",
          "source": "Tatoeba #8919389 @carlosalberto / #8680237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8919389",
          "cefr_level": "A1",
          "word_slugs": [
            "nipoti-noun"
          ]
        },
        {
          "id": "3803775",
          "text": "Mi porto anche i nipoti.",
          "translation": "Я ещё и внуков приведу.",
          "source": "Tatoeba #3803775 @Guybrush88 / #3803878 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3803775",
          "cefr_level": "A1",
          "word_slugs": [
            "nipoti-noun"
          ]
        },
        {
          "id": "4532732",
          "text": "Tom e Mary hanno tre nipoti.",
          "translation": "У Тома и Марии трое внуков.",
          "source": "Tatoeba #4532732 @Guybrush88 / #4532921 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4532732",
          "cefr_level": "A1",
          "word_slugs": [
            "nipoti-noun"
          ]
        },
        {
          "id": "5451625",
          "text": "I nipoti mi chiamano per nome.",
          "translation": "Внуки называют меня по имени.",
          "source": "Tatoeba #5451625 @dnnywld / #4939338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5451625",
          "cefr_level": "A1",
          "word_slugs": [
            "nipoti-noun"
          ]
        },
        {
          "id": "6539855",
          "text": "Tom e John sono i miei nipoti.",
          "translation": "Том и Джон - мои племянники.",
          "source": "Tatoeba #6539855 @Guybrush88 / #7460925 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6539855",
          "cefr_level": "A1",
          "word_slugs": [
            "nipoti-noun"
          ]
        }
      ],
