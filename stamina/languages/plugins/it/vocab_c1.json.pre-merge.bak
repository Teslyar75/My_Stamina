    {
      "slug": "ingaggiato-verb",
      "lemma": "ingaggiato",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8631,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6463122",
          "text": "Hanno ingaggiato un insegnante.",
          "translation": "Они наняли преподавателя.",
          "source": "Tatoeba #6463122 @dnnywld / #6462852 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6463122",
          "cefr_level": "A1",
          "word_slugs": [
            "ingaggiato-verb"
          ]
        },
        {
          "id": "5437728",
          "text": "Non vi pentirete di averci ingaggiato.",
          "translation": "Вы не пожалеете, что взяли нас на работу.",
          "source": "Tatoeba #5437728 @dnnywld / #5436177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5437728",
          "cefr_level": "A1",
          "word_slugs": [
            "ingaggiato-verb"
          ]
        },
        {
          "id": "5437608",
          "text": "Mi hanno ingaggiato per uccidere il tuo amico.",
          "translation": "Меня наняли, чтобы я убил твоего друга.",
          "source": "Tatoeba #5437608 @dnnywld / #5436384 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5437608",
          "cefr_level": "A1",
          "word_slugs": [
            "ingaggiato-verb"
          ]
        },
        {
          "id": "5437645",
          "text": "Mary ha ingaggiato Tom per pitturarle la casa.",
          "translation": "Мэри наняла Тома, чтобы он покрасил её дом.",
          "source": "Tatoeba #5437645 @dnnywld / #5436351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5437645",
          "cefr_level": "A1",
          "word_slugs": [
            "ingaggiato-verb"
          ]
        },
        {
          "id": "5437609",
          "text": "Mi hanno ingaggiato per uccidere il vostro amico.",
          "translation": "Меня наняли, чтобы я убил вашего друга.",
          "source": "Tatoeba #5437609 @dnnywld / #5436383 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5437609",
          "cefr_level": "A1",
          "word_slugs": [
            "ingaggiato-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il ingaggiato",
        "plural": "",
        "infinitive": "ingaggiato"
      }
