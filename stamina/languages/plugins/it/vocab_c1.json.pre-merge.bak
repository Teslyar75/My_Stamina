    {
      "slug": "odiavo-verb",
      "lemma": "odiavo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8726,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5568717",
          "text": "Odiavo Tom per questo.",
          "translation": "Я ненавидел за это Тома.",
          "source": "Tatoeba #5568717 @dnnywld / #5568716 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5568717",
          "cefr_level": "A1",
          "word_slugs": [
            "odiavo-verb"
          ]
        },
        {
          "id": "3219671",
          "text": "Odiavo il calcio prima.",
          "translation": "Раньше я терпеть не мог футбол.",
          "source": "Tatoeba #3219671 @Guybrush88 / #3219769 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3219671",
          "cefr_level": "A1",
          "word_slugs": [
            "odiavo-verb"
          ]
        },
        {
          "id": "6326323",
          "text": "Odiavo Boston e tutto ciò che era collegato.",
          "translation": "Я ненавидел Бостон и всё, что с ним связано.",
          "source": "Tatoeba #6326323 @dnnywld / #6325696 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326323",
          "cefr_level": "A1",
          "word_slugs": [
            "odiavo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
