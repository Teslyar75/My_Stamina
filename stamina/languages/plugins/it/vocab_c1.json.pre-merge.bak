    {
      "slug": "verremo-verb",
      "lemma": "verremo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7731,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10780922",
          "text": "Verremo in tre.",
          "translation": "Нас приедет трое.",
          "source": "Tatoeba #10780922 @dnnywld / #6532936 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10780922",
          "cefr_level": "A1",
          "word_slugs": [
            "verremo-verb"
          ]
        },
        {
          "id": "6831976",
          "text": "Noi non verremo.",
          "translation": "Мы не придём.",
          "source": "Tatoeba #6831976 @dnnywld / #4647158 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6831976",
          "cefr_level": "A1",
          "word_slugs": [
            "verremo-verb"
          ]
        },
        {
          "id": "3555158",
          "text": "Verremo a trovarti.",
          "translation": "Мы придём тебя навестить.",
          "source": "Tatoeba #3555158 @Guybrush88 / #3656248 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3555158",
          "cefr_level": "A1",
          "word_slugs": [
            "verremo-verb"
          ]
        },
        {
          "id": "6831987",
          "text": "Verremo appena potremo.",
          "translation": "Мы придём, как только сможем.",
          "source": "Tatoeba #6831987 @dnnywld / #6566528 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6831987",
          "cefr_level": "A1",
          "word_slugs": [
            "verremo-verb"
          ]
        },
        {
          "id": "6831977",
          "text": "Verremo ad un accordo.",
          "translation": "Мы придём к согласию.",
          "source": "Tatoeba #6831977 @dnnywld / #3581211 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6831977",
          "cefr_level": "A1",
          "word_slugs": [
            "verremo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
