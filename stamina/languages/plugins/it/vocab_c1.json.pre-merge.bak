    {
      "slug": "massaggio-noun",
      "lemma": "massaggio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5729,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6363447",
          "text": "Vieni, ti faccio un massaggio!",
          "translation": "Иди, я сделаю тебе массаж!",
          "source": "Tatoeba #6363447 @dnnywld / #6363324 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6363447",
          "cefr_level": "A1",
          "word_slugs": [
            "massaggio-noun"
          ]
        },
        {
          "id": "5777182",
          "text": "Dai che ti faccio un massaggio.",
          "translation": "Давай массаж сделаю.",
          "source": "Tatoeba #5777182 @dnnywld / #5776993 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5777182",
          "cefr_level": "A1",
          "word_slugs": [
            "massaggio-noun"
          ]
        },
        {
          "id": "6393352",
          "text": "Mary fece un massaggio alle tempie di Tom.",
          "translation": "Мэри помассировала Тому виски.",
          "source": "Tatoeba #6393352 @dnnywld / #6392923 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6393352",
          "cefr_level": "A1",
          "word_slugs": [
            "massaggio-noun"
          ]
        },
        {
          "id": "5484150",
          "text": "Tom ha fatto a Mary un massaggio ai piedi.",
          "translation": "Том сделал Мэри массаж стоп.",
          "source": "Tatoeba #5484150 @dnnywld / #5483910 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5484150",
          "cefr_level": "A1",
          "word_slugs": [
            "massaggio-noun"
          ]
        },
        {
          "id": "3690535",
          "text": "Desiderava un massaggio come compenso per i suoi massaggi.",
          "translation": "Бетти обожает танцевать.",
          "source": "Tatoeba #3690535 @Guybrush88 / #1668184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3690535",
          "cefr_level": "A1",
          "word_slugs": [
            "massaggio-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il massaggio",
        "plural": "",
        "infinitive": ""
      }
