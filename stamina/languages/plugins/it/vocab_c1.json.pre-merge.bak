    {
      "slug": "porre-verb",
      "lemma": "porre",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5861,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6040704",
          "text": "Prego di porre domande sull'argomento.",
          "translation": "Прошу задавать вопросы по теме.",
          "source": "Tatoeba #6040704 @dnnywld / #6039800 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6040704",
          "cefr_level": "A1",
          "word_slugs": [
            "porre-verb"
          ]
        },
        {
          "id": "5827995",
          "text": "I cronisti continuarono a porre domande.",
          "translation": "Репортеры продолжили задавать вопросы.",
          "source": "Tatoeba #5827995 @dnnywld / #2177705 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5827995",
          "cefr_level": "A1",
          "word_slugs": [
            "porre-verb"
          ]
        },
        {
          "id": "6330911",
          "text": "Vorrei porre la domanda in maniera differente.",
          "translation": "Я хотел бы задать вопрос по-другому.",
          "source": "Tatoeba #6330911 @dnnywld / #6330811 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6330911",
          "cefr_level": "A1",
          "word_slugs": [
            "porre-verb"
          ]
        },
        {
          "id": "5519250",
          "text": "Ho deciso di porre fine alla nostra amicizia.",
          "translation": "Я решил положить конец нашей дружбе.",
          "source": "Tatoeba #5519250 @dnnywld / #5518843 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5519250",
          "cefr_level": "A1",
          "word_slugs": [
            "porre-verb"
          ]
        },
        {
          "id": "10320128",
          "text": "Solo la morte può porre fine alla nostra amicizia.",
          "translation": "Дружбу мою с тобою одна только смерть возьмёт.",
