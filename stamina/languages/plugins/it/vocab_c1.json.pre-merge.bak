    {
      "slug": "voluti-adj",
      "lemma": "voluti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7143,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5452854",
          "text": "Ci sono voluti ancora due minuti.",
          "translation": "Это заняло еще две минуты.",
          "source": "Tatoeba #5452854 @dnnywld / #4039850 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452854",
          "cefr_level": "A1",
          "word_slugs": [
            "voluti-adj"
          ]
        },
        {
          "id": "5452877",
          "text": "Ci sono voluti meno di cinque minuti.",
          "translation": "Это заняло меньше пяти минут.",
          "source": "Tatoeba #5452877 @dnnywld / #4193524 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5452877",
          "cefr_level": "A1",
          "word_slugs": [
            "voluti-adj"
          ]
        },
        {
          "id": "6854617",
          "text": "Mi ci sono voluti tre giorni per farlo.",
          "translation": "У меня ушло на это три дня.",
          "source": "Tatoeba #6854617 @dnnywld / #6681001 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6854617",
          "cefr_level": "A1",
          "word_slugs": [
            "voluti-adj"
          ]
        },
        {
          "id": "5655299",
          "text": "Ci sono voluti quarantasei anni per costruire questo tempio.",
          "translation": "Строительство этого храма заняло сорок шесть лет.",
          "source": "Tatoeba #5655299 @dnnywld / #5655235 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5655299",
          "cefr_level": "A1",
          "word_slugs": [
            "voluti-adj"
          ]
        },
        {
          "id": "1234310",
          "text": "Mi ci son voluti tre giorni per pulire la camera.",
          "translation": "У меня ушло три дня на уборку комнаты.",
          "source": "Tatoeba #1234310 @Guybrush88 / #2905279 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1234310",
          "cefr_level": "A1",
          "word_slugs": [
            "voluti-adj"
          ]
        }
