      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6952053",
          "text": "Siamo rimasti senza elettricità.",
          "translation": "Мы остались без электричества.",
          "source": "Tatoeba #6952053 @dnnywld / #6553432 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952053",
          "cefr_level": "A1",
          "word_slugs": [
            "elettricità-noun"
          ]
        },
        {
          "id": "6034756",
          "text": "L'acqua conduce l'elettricità.",
          "translation": "Вода проводит электричество.",
          "source": "Tatoeba #6034756 @Guybrush88 / #5258697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6034756",
          "cefr_level": "A1",
          "word_slugs": [
            "elettricità-noun"
          ]
        },
        {
          "id": "379323",
          "text": "I cavi trasmettono l'elettricità.",
          "translation": "Провода проводят электричество.",
          "source": "Tatoeba #379323 @Pharamp / #3284709 @averoes (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379323",
          "cefr_level": "A1",
          "word_slugs": [
            "elettricità-noun"
          ]
        },
        {
          "id": "945590",
          "text": "I metalli conducono l'elettricità.",
          "translation": "Металлы проводят электричество.",
          "source": "Tatoeba #945590 @Guybrush88 / #4999028 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/945590",
          "cefr_level": "A1",
          "word_slugs": [
            "elettricità-noun"
          ]
        },
        {
          "id": "2577380",
          "text": "Il rame conduce bene l'elettricità.",
          "translation": "Медь хорошо проводит электричество.",
          "source": "Tatoeba #2577380 @Guybrush88 / #4951980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2577380",
          "cefr_level": "A1",
          "word_slugs": [
            "elettricità-noun"
          ]
        }
