    {
      "slug": "magra-adj",
      "lemma": "magra",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9605,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6871393",
          "text": "Mary è alta e magra.",
          "translation": "Мэри высокая и худая.",
          "source": "Tatoeba #6871393 @dnnywld / #6867660 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871393",
          "cefr_level": "A1",
          "word_slugs": [
            "magra-adj"
          ]
        },
        {
          "id": "5483995",
          "text": "Sicuramente è una magra consolazione.",
          "translation": "Безусловно, это плохое утешение.",
          "source": "Tatoeba #5483995 @dnnywld / #5483619 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5483995",
          "cefr_level": "A1",
          "word_slugs": [
            "magra-adj"
          ]
        },
        {
          "id": "6851851",
          "text": "Lei era magra come un chiodo.",
          "translation": "Она была худая как щепка.",
          "source": "Tatoeba #6851851 @dnnywld / #6851731 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6851851",
          "cefr_level": "A1",
          "word_slugs": [
            "magra-adj"
          ]
        },
        {
          "id": "6851848",
          "text": "Lei era magra come un fiammifero.",
          "translation": "Она была худая как спичка.",
