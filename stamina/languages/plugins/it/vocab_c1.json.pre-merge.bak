    {
      "slug": "autostrada-noun",
      "lemma": "autostrada",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5693,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6939431",
          "text": "Lasciammo la foresta per l'autostrada.",
          "translation": "Мы вышли из леса к шоссе.",
          "source": "Tatoeba #6939431 @dnnywld / #6939376 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6939431",
          "cefr_level": "A1",
          "word_slugs": [
            "autostrada-noun"
          ]
        },
        {
          "id": "5473143",
          "text": "Lungo l'autostrada ci sono le case.",
          "translation": "Вдоль шоссе стоят дома.",
          "source": "Tatoeba #5473143 @dnnywld / #1395875 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5473143",
          "cefr_level": "A1",
          "word_slugs": [
            "autostrada-noun"
          ]
        },
        {
          "id": "10849698",
          "text": "Sono finito in un ingorgo in autostrada.",
          "translation": "Я попал в пробку на автостраде.",
          "source": "Tatoeba #10849698 @dnnywld / #2802143 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849698",
          "cefr_level": "A1",
          "word_slugs": [
            "autostrada-noun"
          ]
        },
        {
          "id": "2748008",
          "text": "C'è stato un terribile incidente in autostrada.",
          "translation": "На автостраде произошла ужасная катастрофа.",
          "source": "Tatoeba #2748008 @Guybrush88 / #3595307 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2748008",
          "cefr_level": "A1",
          "word_slugs": [
            "autostrada-noun"
          ]
        },
        {
          "id": "10849700",
          "text": "L'autostrada era bloccata a causa di un serio incidente.",
          "translation": "Автострада была перекрыта из-за серьезной аварии.",
          "source": "Tatoeba #10849700 @dnnywld / #3829181 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10849700",
          "cefr_level": "A1",
          "word_slugs": [
            "autostrada-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la autostrada",
        "plural": "",
        "infinitive": ""
      }
    },
