    {
      "slug": "sporche-adj",
      "lemma": "sporche",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8486,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10911247",
          "text": "Non stropicciarti mai gli occhi con mani sporche!",
          "translation": "Никогда не три глаза грязными руками!",
          "source": "Tatoeba #10911247 @dnnywld / #10911165 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10911247",
          "cefr_level": "A1",
          "word_slugs": [
            "sporche-adj"
          ]
        },
        {
          "id": "10911249",
          "text": "Non stropicciarti mai gli occhi con mani sporche.",
          "translation": "Никогда не три глаза грязными руками.",
          "source": "Tatoeba #10911249 @dnnywld / #10911156 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10911249",
          "cefr_level": "A1",
          "word_slugs": [
            "sporche-adj"
          ]
        },
        {
          "id": "5384896",
          "text": "Le mense delle scuole pubbliche sono spesso sporche.",
          "translation": "Столовые в общеобразовательных школах зачастую грязны.",
          "source": "Tatoeba #5384896 @dnnywld / #5384822 @lemeoejubsmgt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384896",
          "cefr_level": "A1",
          "word_slugs": [
            "sporche-adj"
          ]
        },
        {
          "id": "5647242",
          "text": "È decente entrare nella moschea con le calze sporche?",
          "translation": "Правильно ли входить в мечеть в грязных носках?",
          "source": "Tatoeba #5647242 @dnnywld / #5647089 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647242",
          "cefr_level": "A1",
          "word_slugs": [
            "sporche-adj"
          ]
        },
        {
          "id": "5508665",
          "text": "Tom ha visto delle impronte sporche sul tappeto bianco.",
          "translation": "Том увидел грязные следы на белом ковре.",
          "source": "Tatoeba #5508665 @dnnywld / #5508645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5508665",
          "cefr_level": "A1",
          "word_slugs": [
            "sporche-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il sporche",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "parlavano-verb",
      "lemma": "parlavano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8487,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5674191",
          "text": "Loro parlavano con me.",
          "translation": "Они со мной говорили.",
          "source": "Tatoeba #5674191 @dnnywld / #5673942 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5674191",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavano-verb"
          ]
        },
        {
          "id": "3814040",
          "text": "Parlavano solo in tedesco.",
          "translation": "Они говорили только по-немецки.",
          "source": "Tatoeba #3814040 @Guybrush88 / #2570282 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3814040",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavano-verb"
          ]
        },
        {
          "id": "5419175",
          "text": "Gli adulti parlavano tra loro.",
          "translation": "Взрослые разговаривали между собой.",
          "source": "Tatoeba #5419175 @dnnywld / #5382558 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419175",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavano-verb"
          ]
        },
        {
          "id": "7208412",
          "text": "I ragazzi parlavano di calcio.",
          "translation": "Мальчики говорили о футболе.",
          "source": "Tatoeba #7208412 @Guybrush88 / #10008097 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7208412",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavano-verb"
          ]
        },
        {
          "id": "3814041",
