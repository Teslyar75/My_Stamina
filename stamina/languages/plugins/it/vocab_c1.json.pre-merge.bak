    {
      "slug": "scienziato-noun",
      "lemma": "scienziato",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5652,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10856868",
          "text": "Tom è il capo scienziato.",
          "translation": "Том — ведущий учёный.",
          "source": "Tatoeba #10856868 @dnnywld / #7969807 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10856868",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziato-noun"
          ]
        },
        {
          "id": "6532822",
          "text": "Tom è diventato uno scienziato.",
          "translation": "Том стал учёным.",
          "source": "Tatoeba #6532822 @dnnywld / #6532656 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6532822",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziato-noun"
          ]
        },
        {
          "id": "5388136",
          "text": "Voglio diventare un grande scienziato.",
          "translation": "Я хочу стать большим учёным.",
          "source": "Tatoeba #5388136 @dnnywld / #5387928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388136",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziato-noun"
          ]
        },
        {
          "id": "6810648",
          "text": "Gli scienziato lo spiegano diversamente.",
          "translation": "Ученые объясняют это иначе.",
          "source": "Tatoeba #6810648 @dnnywld / #1385738 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6810648",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziato-noun"
          ]
        },
        {
          "id": "7426629",
          "text": "La scoperta dello scienziato ha fatto un vero clamore nel mondo scientifico.",
          "translation": "Открытие учёного стало настоящей сенсацией в научном мире.",
          "source": "Tatoeba #7426629 @dnnywld / #7426628 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7426629",
          "cefr_level": "A1",
          "word_slugs": [
            "scienziato-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il scienziato",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "finiscono-verb",
      "lemma": "finiscono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5653,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5394190",
          "text": "Ma le favole finiscono male?",
          "translation": "А сказки с плохим концом бывают?",
          "source": "Tatoeba #5394190 @dnnywld / #5394160 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5394190",
          "cefr_level": "A1",
          "word_slugs": [
            "finiscono-verb"
          ]
        },
        {
          "id": "5394195",
          "text": "Ma le favole non finiscono bene?",
          "translation": "А сказки с нехорошим концом бывают?",
          "source": "Tatoeba #5394195 @dnnywld / #5394157 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5394195",
          "cefr_level": "A1",
          "word_slugs": [
            "finiscono-verb"
          ]
        },
        {
          "id": "7729975",
          "text": "Le favole non sempre finiscono bene.",
          "translation": "Сказки далеко не всегда хорошо заканчиваются.",
          "source": "Tatoeba #7729975 @dnnywld / #7729414 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7729975",
          "cefr_level": "A1",
          "word_slugs": [
            "finiscono-verb"
          ]
        },
        {
          "id": "7729974",
          "text": "Questi scherzi non sempre finiscono bene.",
          "translation": "Такие шутки не всегда хорошо заканчиваются.",
          "source": "Tatoeba #7729974 @dnnywld / #7729415 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7729974",
          "cefr_level": "A1",
          "word_slugs": [
            "finiscono-verb"
          ]
        },
        {
          "id": "5489739",
          "text": "A che età i bambini finiscono la scuola?",
          "translation": "В каком возрасте дети оканчивают школу?",
          "source": "Tatoeba #5489739 @dnnywld / #5489152 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489739",
          "cefr_level": "A1",
          "word_slugs": [
            "finiscono-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "finiscono",
