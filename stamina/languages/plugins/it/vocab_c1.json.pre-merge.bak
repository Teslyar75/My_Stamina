    {
      "slug": "jet-noun",
      "lemma": "jet",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5666,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2181580",
          "text": "Tom ebbe un jet lag.",
          "translation": "Том страдал от смены часовых поясов.",
          "source": "Tatoeba #2181580 @Guybrush88 / #3290213 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2181580",
          "cefr_level": "A1",
          "word_slugs": [
            "jet-noun"
          ]
        },
        {
          "id": "10801675",
          "text": "Questi jet erano più veloci di un fulmine.",
          "translation": "Эти реактивные самолёты были быстрее молнии.",
          "source": "Tatoeba #10801675 @dnnywld / #10801636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10801675",
          "cefr_level": "A1",
          "word_slugs": [
            "jet-noun"
          ]
        },
        {
          "id": "5571115",
          "text": "Ieri a San Paolo è arrivato un jet dalla Russia.",
          "translation": "Вчера в Сан-Паулу прилетел реактивный самолёт из России.",
          "source": "Tatoeba #5571115 @dnnywld / #5570740 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5571115",
