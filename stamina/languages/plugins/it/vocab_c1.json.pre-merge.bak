    {
      "slug": "assente-adj",
      "lemma": "assente",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9649,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5542516",
          "text": "Chi è assente oggi?",
          "translation": "Кто сегодня отсутствует?",
          "source": "Tatoeba #5542516 @dnnywld / #5542494 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5542516",
          "cefr_level": "A1",
          "word_slugs": [
            "assente-adj"
          ]
        },
        {
          "id": "8604263",
          "text": "So che Tom è assente.",
          "translation": "Я знаю, что Том отсутствует.",
          "source": "Tatoeba #8604263 @dnnywld / #7109193 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8604263",
          "cefr_level": "A1",
          "word_slugs": [
            "assente-adj"
          ]
        },
        {
          "id": "5892275",
          "text": "Tom è assente da scuola.",
          "translation": "Том отсутствует в школе.",
          "source": "Tatoeba #5892275 @dnnywld / #5615082 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5892275",
          "cefr_level": "A1",
          "word_slugs": [
            "assente-adj"
          ]
        },
        {
          "id": "5473337",
          "text": "Tom è assente per malattia.",
          "translation": "Том на больничном.",
          "source": "Tatoeba #5473337 @dnnywld / #5473022 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5473337",
          "cefr_level": "A1",
          "word_slugs": [
            "assente-adj"
          ]
        },
        {
          "id": "6019366",
          "text": "Ieri ero assente da scuola.",
          "translation": "Я не был вчера в школе.",
          "source": "Tatoeba #6019366 @dnnywld / #6019246 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6019366",
          "cefr_level": "A1",
          "word_slugs": [
