    {
      "slug": "grecia-noun",
      "lemma": "Grecia",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9556,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "Греция"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2563618",
          "text": "Andrò in Grecia.",
          "translation": "Я отправлюсь в Грецию.",
          "source": "Tatoeba #2563618 @Guybrush88 / #2535851 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2563618",
          "cefr_level": "A1",
          "word_slugs": [
            "grecia-noun"
          ]
        },
        {
          "id": "3996848",
          "text": "La Grecia è un paese antico.",
          "translation": "Греция — древняя страна.",
          "source": "Tatoeba #3996848 @Guybrush88 / #3935514 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3996848",
          "cefr_level": "A1",
          "word_slugs": [
            "grecia-noun"
          ]
        },
        {
          "id": "617141",
          "text": "In Grecia ci sono molte isole.",
          "translation": "В Греции много островов.",
          "source": "Tatoeba #617141 @rado / #2583035 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/617141",
          "cefr_level": "A1",
          "word_slugs": [
            "grecia-noun"
          ]
        },
        {
          "id": "2802586",
          "text": "Qual è la capitale della Grecia?",
          "translation": "Какая столица Греции?",
          "source": "Tatoeba #2802586 @korobo4ka / #2802591 @korobo4ka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2802586",
          "cefr_level": "A1",
          "word_slugs": [
            "grecia-noun"
          ]
        },
        {
          "id": "4383815",
          "text": "La Grecia è un paese sviluppato.",
          "translation": "Греция - развитая страна.",
          "source": "Tatoeba #4383815 @Guybrush88 / #4384325 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4383815",
          "cefr_level": "A1",
          "word_slugs": [
            "grecia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
