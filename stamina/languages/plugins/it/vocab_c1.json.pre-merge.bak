    {
      "slug": "jeans-noun",
      "lemma": "jeans",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5640,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6367850",
          "text": "Ieri Tom non era in jeans.",
          "translation": "Том вчера был не в джинсах.",
          "source": "Tatoeba #6367850 @dnnywld / #6366892 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367850",
          "cefr_level": "A1",
          "word_slugs": [
            "jeans-noun"
          ]
        },
        {
          "id": "5474277",
          "text": "Tom di solito veste i jeans.",
          "translation": "Том обычно носит джинсы.",
          "source": "Tatoeba #5474277 @dnnywld / #5473901 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5474277",
          "cefr_level": "A1",
          "word_slugs": [
            "jeans-noun"
          ]
        },
        {
          "id": "6534774",
          "text": "Tom non vuole indossare dei jeans.",
          "translation": "Том не хочет носить джинсы.",
          "source": "Tatoeba #6534774 @Guybrush88 / #6893310 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6534774",
          "cefr_level": "A1",
          "word_slugs": [
            "jeans-noun"
          ]
        },
        {
          "id": "6854536",
          "text": "Tom si asciugò le mani sui jeans.",
          "translation": "Том вытер руку о джинсы.",
          "source": "Tatoeba #6854536 @dnnywld / #6852343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6854536",
          "cefr_level": "A1",
          "word_slugs": [
            "jeans-noun"
          ]
        },
        {
          "id": "6830114",
          "text": "Tom indossava un nuovo paio di jeans.",
          "translation": "Том был в новых джинсах.",
          "source": "Tatoeba #6830114 @dnnywld / #6829476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6830114",
          "cefr_level": "A1",
          "word_slugs": [
            "jeans-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il jeans",
        "plural": "",
        "infinitive": ""
      }
