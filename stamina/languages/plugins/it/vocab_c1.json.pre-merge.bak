    {
      "slug": "serratura-noun",
      "lemma": "serratura",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6638,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "1543498",
          "text": "La serratura è rotta.",
          "translation": "Замок сломан.",
          "source": "Tatoeba #1543498 @Guybrush88 / #3609054 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1543498",
          "cefr_level": "A1",
          "word_slugs": [
            "serratura-noun"
          ]
        },
        {
          "id": "11363245",
          "text": "Ha forzato la serratura",
          "translation": "Он взломал замок.",
          "source": "Tatoeba #11363245 @Bernie75 / #2736597 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11363245",
          "cefr_level": "A1",
          "word_slugs": [
            "serratura-noun"
          ]
        },
        {
          "id": "2585029",
          "text": "Tom ha scassinato la serratura.",
          "translation": "Том вскрыл замок.",
          "source": "Tatoeba #2585029 @Guybrush88 / #2585019 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2585029",
          "cefr_level": "A1",
          "word_slugs": [
            "serratura-noun"
          ]
        },
        {
          "id": "6000745",
          "text": "Chi ha la chiave di questa serratura?",
          "translation": "У кого есть ключ от этого замка?",
          "source": "Tatoeba #6000745 @dnnywld / #5999818 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6000745",
          "cefr_level": "A1",
          "word_slugs": [
            "serratura-noun"
          ]
        },
        {
          "id": "10754252",
          "text": "Uno dei bambini ha rotto la serratura.",
          "translation": "Один из детей сломал замок.",
          "source": "Tatoeba #10754252 @dnnywld / #4632040 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754252",
          "cefr_level": "A1",
          "word_slugs": [
            "serratura-noun"
          ]
        }
      ],
