      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3269566",
          "text": "Cominciate a correre.",
          "translation": "Начинайте бежать.",
          "source": "Tatoeba #3269566 @Guybrush88 / #2501566 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3269566",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciate-verb"
          ]
        },
        {
          "id": "6005688",
          "text": "Cominciate a lavorare.",
          "translation": "Приступайте к работе.",
          "source": "Tatoeba #6005688 @dnnywld / #5699530 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6005688",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciate-verb"
          ]
        },
        {
          "id": "11575859",
          "text": "Cominciate a cambiarlo.",
          "translation": "Начните это менять.",
          "source": "Tatoeba #11575859 @dnnywld / #11575661 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11575859",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciate-verb"
          ]
        },
        {
          "id": "5480259",
          "text": "Cominciate ad annoiarvi?",
          "translation": "Вам становится скучно?",
          "source": "Tatoeba #5480259 @dnnywld / #3895931 @Vic (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5480259",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciate-verb"
          ]
        },
        {
          "id": "5660266",
          "text": "Cominciate a farmi paura.",
          "translation": "Вы начинаете меня пугать.",
          "source": "Tatoeba #5660266 @dnnywld / #5659187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5660266",
          "cefr_level": "A1",
          "word_slugs": [
            "cominciate-verb"
          ]
        }
      ],
