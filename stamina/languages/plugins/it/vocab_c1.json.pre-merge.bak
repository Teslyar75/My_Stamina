    {
      "slug": "vietato-adj",
      "lemma": "vietato",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5773,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5696454",
          "text": "Non è vietato.",
          "translation": "Это не запрещено.",
          "source": "Tatoeba #5696454 @dnnywld / #5696095 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5696454",
          "cefr_level": "A1",
          "word_slugs": [
            "vietato-adj"
          ]
        },
        {
          "id": "6790779",
          "text": "Vietato l'ingresso.",
          "translation": "Вход запрещён.",
          "source": "Tatoeba #6790779 @dnnywld / #469889 @OlgaElwen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790779",
          "cefr_level": "A1",
          "word_slugs": [
            "vietato-adj"
          ]
        },
        {
          "id": "6871803",
          "text": "\"Tutto bene?\" - \"Vietato lamentarsi\".",
          "translation": "«Ты как?» — «Жаловаться запрещено».",
          "source": "Tatoeba #6871803 @dnnywld / #4587989 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6871803",
          "cefr_level": "A1",
          "word_slugs": [
            "vietato-adj"
          ]
        },
        {
          "id": "6365482",
          "text": "Ai bambini qui è vietato.",
          "translation": "Детям сюда нельзя.",
          "source": "Tatoeba #6365482 @dnnywld / #6179064 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6365482",
          "cefr_level": "A1",
          "word_slugs": [
            "vietato-adj"
          ]
        },
        {
          "id": "6365483",
          "text": "Alle donne qui è vietato.",
          "translation": "Женщинам сюда нельзя.",
          "source": "Tatoeba #6365483 @dnnywld / #6179063 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6365483",
          "cefr_level": "A1",
          "word_slugs": [
            "vietato-adj"
          ]
        }
      ],
      "tags": [
        "C1"
