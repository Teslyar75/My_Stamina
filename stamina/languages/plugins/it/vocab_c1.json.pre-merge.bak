          ]
        },
        {
          "id": "5501580",
          "text": "Non staccare gli occhi dalla valigia.",
          "translation": "Не упускай чемодан из виду.",
          "source": "Tatoeba #5501580 @dnnywld / #5501035 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5501580",
          "cefr_level": "A1",
          "word_slugs": [
            "staccare-verb"
          ]
        },
        {
          "id": "1872556",
          "text": "Tom non riusciva a staccare gli occhi da Mary.",
          "translation": "Том не мог свести глаз с Мэри.",
          "source": "Tatoeba #1872556 @hitori37 / #2899610 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1872556",
          "cefr_level": "A1",
          "word_slugs": [
            "staccare-verb"
          ]
        },
        {
          "id": "6908992",
          "text": "Tom non riesce a staccare gli occhi di dosso da Mary.",
          "translation": "Том не может отвести глаз от Мэри.",
          "source": "Tatoeba #6908992 @dnnywld / #2769068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908992",
          "cefr_level": "A1",
          "word_slugs": [
