      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "2811600",
          "text": "Le sue vene contengono acqua.",
          "translation": "Ваши вены содержат воду.",
          "source": "Tatoeba #2811600 @Guybrush88 / #8783926 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2811600",
          "cefr_level": "A1",
          "word_slugs": [
