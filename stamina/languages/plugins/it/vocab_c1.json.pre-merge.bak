    {
      "slug": "staccare-verb",
      "lemma": "staccare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8686,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5971361",
          "text": "Devi staccare il telefono.",
          "translation": "Тебе надо отключить телефон.",
          "source": "Tatoeba #5971361 @dnnywld / #5969686 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5971361",
          "cefr_level": "A1",
          "word_slugs": [
