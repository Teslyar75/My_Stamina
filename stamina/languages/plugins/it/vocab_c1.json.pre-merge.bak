      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2516163",
          "text": "Il soldato corre.",
          "translation": "Солдат бегает.",
          "source": "Tatoeba #2516163 @Guybrush88 / #3139854 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2516163",
          "cefr_level": "A1",
          "word_slugs": [
            "corre-verb"
          ]
        },
        {
          "id": "6025747",
          "text": "Il tempo corre veloce.",
          "translation": "Время быстро летит.",
          "source": "Tatoeba #6025747 @dnnywld / #6025631 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6025747",
          "cefr_level": "A1",
