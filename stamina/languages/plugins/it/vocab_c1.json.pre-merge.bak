      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5628597",
          "text": "È così improbabile.",
          "translation": "Это так невероятно.",
          "source": "Tatoeba #5628597 @dnnywld / #5628490 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5628597",
          "cefr_level": "A1",
