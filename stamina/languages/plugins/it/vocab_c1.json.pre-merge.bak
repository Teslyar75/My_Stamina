    {
      "slug": "tonno-noun",
      "lemma": "tonno",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9465,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13711648",
          "text": "Il tonno è un pesce.",
          "translation": "Тунец — это рыба.",
          "source": "Tatoeba #13711648 @Adelpa / #13711499 @gregoryguy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13711648",
          "cefr_level": "A1",
          "word_slugs": [
            "tonno-noun"
          ]
        },
        {
          "id": "5404534",
          "text": "Ai giapponesi piace il tonno.",
          "translation": "Японцы любят тунец.",
          "source": "Tatoeba #5404534 @dnnywld / #5404201 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5404534",
          "cefr_level": "A1",
          "word_slugs": [
            "tonno-noun"
          ]
        },
        {
          "id": "5880830",
          "text": "La pelle dello squalo è molto più ricca di quella del tonno.",
          "translation": "Кожа акулы гораздо грубее, чем у тунца.",
          "source": "Tatoeba #5880830 @dnnywld / #5880670 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5880830",
          "cefr_level": "A1",
          "word_slugs": [
            "tonno-noun"
          ]
        },
        {
          "id": "5880833",
          "text": "L'insalata russa è fatta di patate, olive, tonno e altri ortaggi.",
          "translation": "Русский салат делают из тунца, оливок, картофеля и других овощей.",
          "source": "Tatoeba #5880833 @dnnywld / #5880667 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5880833",
          "cefr_level": "A1",
          "word_slugs": [
            "tonno-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il tonno",
        "plural": "",
        "infinitive": ""
      }
    },
    {
      "slug": "urgenza-noun",
      "lemma": "urgenza",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9466,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "10791126",
          "text": "Chiama d'urgenza il dottore.",
          "translation": "Срочно вызывай врача.",
          "source": "Tatoeba #10791126 @dnnywld / #7773014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10791126",
          "cefr_level": "A1",
          "word_slugs": [
            "urgenza-noun"
          ]
        },
        {
          "id": "10791128",
          "text": "Chiamate d'urgenza il dottore.",
          "translation": "Срочно вызывайте врача.",
          "source": "Tatoeba #10791128 @dnnywld / #7773015 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10791128",
          "cefr_level": "A1",
          "word_slugs": [
            "urgenza-noun"
          ]
        },
        {
          "id": "7461265",
          "text": "Devi recarti d'urgenza in ospedale.",
          "translation": "Тебе надо срочно в больницу.",
          "source": "Tatoeba #7461265 @dnnywld / #7460938 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7461265",
          "cefr_level": "A1",
          "word_slugs": [
            "urgenza-noun"
          ]
        },
        {
          "id": "7461266",
          "text": "Deve recarsi d'urgenza in ospedale.",
          "translation": "Ей надо срочно в больницу.",
          "source": "Tatoeba #7461266 @dnnywld / #7460937 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7461266",
          "cefr_level": "A1",
          "word_slugs": [
            "urgenza-noun"
          ]
        },
        {
          "id": "7461262",
          "text": "Dovete recarvi d'urgenza in ospedale.",
          "translation": "Вам надо срочно в больницу.",
          "source": "Tatoeba #7461262 @dnnywld / #7460939 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7461262",
          "cefr_level": "A1",
          "word_slugs": [
            "urgenza-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la urgenza",
        "plural": "",
        "infinitive": ""
      }
