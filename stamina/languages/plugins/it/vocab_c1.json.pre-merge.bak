    {
      "slug": "dormono-verb",
      "lemma": "dormono",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8542,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5632282",
          "text": "I pesci dormono?",
          "translation": "Рыбы спят?",
          "source": "Tatoeba #5632282 @dnnywld / #1778186 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632282",
          "cefr_level": "A1",
          "word_slugs": [
            "dormono-verb"
          ]
        },
        {
          "id": "5907014",
          "text": "Dormono come bambini.",
          "translation": "Они спят как младенцы.",
          "source": "Tatoeba #5907014 @dnnywld / #5906378 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5907014",
          "cefr_level": "A1",
          "word_slugs": [
            "dormono-verb"
          ]
        },
        {
          "id": "4243205",
          "text": "Quando dormono i gufi?",
          "translation": "Когда совы спят?",
          "source": "Tatoeba #4243205 @Guybrush88 / #3461131 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4243205",
          "cefr_level": "A1",
          "word_slugs": [
            "dormono-verb"
          ]
        },
        {
          "id": "398670",
          "text": "Normalmente dormono in questa stanza.",
          "translation": "Они обычно спят в этой комнате.",
          "source": "Tatoeba #398670 @ver / #1336729 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398670",
          "cefr_level": "A1",
          "word_slugs": [
            "dormono-verb"
          ]
        },
        {
          "id": "5590151",
          "text": "Perché i bambini ancora non dormono?",
          "translation": "Почему дети до сих пор не спят?",
          "source": "Tatoeba #5590151 @dnnywld / #5590036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5590151",
          "cefr_level": "A1",
          "word_slugs": [
            "dormono-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
