    {
      "slug": "siede-verb",
      "lemma": "siede",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9027,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5499736",
          "text": "Tom siede qui?",
          "translation": "Том здесь сидит?",
          "source": "Tatoeba #5499736 @dnnywld / #5498950 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499736",
          "cefr_level": "A1",
          "word_slugs": [
            "siede-verb"
          ]
        },
        {
          "id": "5454680",
          "text": "Al corso di francese Tom siede dietro Mary.",
          "translation": "На французском Том сидит за Мэри.",
          "source": "Tatoeba #5454680 @dnnywld / #5454419 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5454680",
          "cefr_level": "A1",
          "word_slugs": [
            "siede-verb"
          ]
        },
        {
          "id": "5423586",
          "text": "Chi è quella persona che siede sulla panchina?",
          "translation": "Что это за человек сидит на скамейке?",
          "source": "Tatoeba #5423586 @dnnywld / #5423579 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5423586",
          "cefr_level": "A1",
          "word_slugs": [
            "siede-verb"
          ]
        },
        {
          "id": "5692875",
          "text": "Lei si siede spesso lì a leggere un libro.",
          "translation": "Она часто сидит там и читает книгу.",
          "source": "Tatoeba #5692875 @dnnywld / #5692709 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5692875",
          "cefr_level": "A1",
          "word_slugs": [
            "siede-verb"
          ]
        },
        {
          "id": "5607653",
          "text": "Il bambino si siede tra il padre e la madre.",
          "translation": "Ребёнок садится между отцом и матерью.",
          "source": "Tatoeba #5607653 @dnnywld / #5606215 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607653",
          "cefr_level": "A1",
          "word_slugs": [
            "siede-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "siede",
        "plural": "",
        "infinitive": "siede"
      }
