    {
      "slug": "cuccioli-noun",
      "lemma": "cuccioli",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7715,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "10754211",
          "text": "Che bei cuccioli!",
          "translation": "Какие красивые щенки!",
          "source": "Tatoeba #10754211 @dnnywld / #4632018 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10754211",
          "cefr_level": "A1",
          "word_slugs": [
            "cuccioli-noun"
          ]
        },
        {
          "id": "5464612",
          "text": "Mi piacciono molto i cuccioli.",
          "translation": "Я очень люблю щенков.",
          "source": "Tatoeba #5464612 @dnnywld / #5464012 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5464612",
          "cefr_level": "A1",
          "word_slugs": [
            "cuccioli-noun"
          ]
        },
        {
          "id": "5476928",
          "text": "Mary ama i gattini e i cuccioli di cane.",
          "translation": "Мэри любит котят и щенят.",
          "source": "Tatoeba #5476928 @dnnywld / #5475719 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5476928",
          "cefr_level": "A1",
          "word_slugs": [
            "cuccioli-noun"
          ]
        },
        {
          "id": "5535189",
          "text": "Il prossimo mese il mio gatto avrà i cuccioli.",
          "translation": "В следующем месяце у моей кошки будут котята.",
          "source": "Tatoeba #5535189 @dnnywld / #5535001 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5535189",
          "cefr_level": "A1",
          "word_slugs": [
            "cuccioli-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il cuccioli",
        "plural": "",
        "infinitive": ""
      }
    },
