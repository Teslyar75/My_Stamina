    {
      "slug": "parlavamo-verb",
      "lemma": "parlavamo",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7136,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5912934",
          "text": "Parlavamo in francese.",
          "translation": "Мы говорили по-французски.",
          "source": "Tatoeba #5912934 @dnnywld / #5912128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5912934",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavamo-verb"
          ]
        },
        {
          "id": "3814065",
          "text": "Parlavamo solo in tedesco.",
          "translation": "Мы говорили только по-немецки.",
          "source": "Tatoeba #3814065 @Guybrush88 / #2570295 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3814065",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavamo-verb"
          ]
        },
        {
          "id": "3814066",
          "text": "Noi parlavamo solo in tedesco.",
          "translation": "Мы говорили только по-немецки.",
          "source": "Tatoeba #3814066 @Guybrush88 / #2570295 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3814066",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavamo-verb"
          ]
        },
        {
          "id": "5925009",
          "text": "Questo è tutto quello di cui parlavamo.",
          "translation": "Это всё, о чём мы говорили.",
          "source": "Tatoeba #5925009 @dnnywld / #5924943 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5925009",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavamo-verb"
          ]
        },
        {
          "id": "6799343",
          "text": "Non volevamo che Tom capisse la nostra conversazione, perciò parlavamo in francese.",
          "translation": "Мы не хотели, чтобы Том понял наш разговор, поэтому говорили на французском.",
          "source": "Tatoeba #6799343 @dnnywld / #6799239 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6799343",
          "cefr_level": "A1",
          "word_slugs": [
            "parlavamo-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "parlavamo",
        "plural": "",
        "infinitive": "parlavamo"
      }
