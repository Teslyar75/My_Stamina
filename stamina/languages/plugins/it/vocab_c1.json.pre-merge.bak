    {
      "slug": "prenderai-verb",
      "lemma": "prenderai",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5624,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "1578276",
          "text": "Prenderai il raffreddore.",
          "translation": "Простудишься.",
          "source": "Tatoeba #1578276 @Guybrush88 / #5523836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1578276",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderai-verb"
          ]
        },
        {
          "id": "5442299",
          "text": "Mi prenderai con te?",
          "translation": "Возьмёшь меня с собой?",
          "source": "Tatoeba #5442299 @dnnywld / #5442216 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5442299",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderai-verb"
          ]
        },
        {
          "id": "5447569",
          "text": "Prenderai nota dell'indirizzo.",
          "translation": "Ты запишешь адрес.",
          "source": "Tatoeba #5447569 @dnnywld / #5447560 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5447569",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderai-verb"
          ]
        },
        {
          "id": "5601500",
          "text": "Se toccherai questo cavo prenderai la scossa.",
          "translation": "Если тронешь этот кабель, тебя током ударит.",
          "source": "Tatoeba #5601500 @dnnywld / #5601304 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5601500",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderai-verb"
          ]
        },
        {
          "id": "5441664",
          "text": "E lo prenderai per mano vino alla vecchiaia?",
          "translation": "Так и будешь его до старости за ручку водить?",
          "source": "Tatoeba #5441664 @dnnywld / #5441621 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5441664",
          "cefr_level": "A1",
          "word_slugs": [
            "prenderai-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "prenderai",
        "plural": "",
        "infinitive": "prenderai"
      }
