      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6150767",
          "text": "Voglio la bicicletta.",
          "translation": "Я хочу велосипед.",
          "source": "Tatoeba #6150767 @dnnywld / #5928462 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6150767",
          "cefr_level": "A1",
          "word_slugs": [
            "bicicletta-noun"
          ]
        },
        {
          "id": "664295",
          "text": "La bicicletta è mia.",
          "translation": "Велосипед мой.",
          "source": "Tatoeba #664295 @Guybrush88 / #3478155 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/664295",
          "cefr_level": "A1",
          "word_slugs": [
            "bicicletta-noun"
          ]
        },
        {
          "id": "6005692",
          "text": "Lui ha una bicicletta.",
          "translation": "У него велосипед.",
          "source": "Tatoeba #6005692 @dnnywld / #1452143 @Derbnik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6005692",
          "cefr_level": "A1",
