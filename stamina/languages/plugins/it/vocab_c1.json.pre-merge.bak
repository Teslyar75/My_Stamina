          "word_slugs": [
            "frutto-noun"
          ]
        },
        {
          "id": "3048845",
          "text": "Frutto proibito, più saporito.",
          "translation": "Запретный плод сладок.",
          "source": "Tatoeba #3048845 @Guybrush88 / #3283038 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3048845",
          "cefr_level": "A1",
          "word_slugs": [
            "frutto-noun"
          ]
        },
        {
          "id": "3157063",
          "text": "L'avocado è un frutto.",
          "translation": "Авокадо - это фрукт.",
          "source": "Tatoeba #3157063 @Guybrush88 / #3157068 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3157063",
