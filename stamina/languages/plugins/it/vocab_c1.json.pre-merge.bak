    {
      "slug": "pony-noun",
      "lemma": "pony",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8499,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5561604",
          "text": "Vuole comprare un pony.",
          "translation": "Она хочет купить пони.",
          "source": "Tatoeba #5561604 @Guybrush88 / #2518188 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5561604",
          "cefr_level": "A1",
          "word_slugs": [
            "pony-noun"
          ]
        },
        {
          "id": "3346846",
          "text": "Mary ama il suo pony.",
          "translation": "Мария любит своего пони.",
          "source": "Tatoeba #3346846 @Guybrush88 / #3346844 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3346846",
          "cefr_level": "A1",
          "word_slugs": [
            "pony-noun"
          ]
        },
        {
          "id": "5561606",
          "text": "Lei vuole comprare un pony.",
          "translation": "Она хочет купить пони.",
          "source": "Tatoeba #5561606 @Guybrush88 / #2518188 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5561606",
          "cefr_level": "A1",
          "word_slugs": [
            "pony-noun"
          ]
        },
        {
          "id": "2324296",
          "text": "Preferisco i pony agli unicorni.",
          "translation": "Я предпочитаю пони, а не единорогов.",
          "source": "Tatoeba #2324296 @Guybrush88 / #3304943 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2324296",
          "cefr_level": "A1",
          "word_slugs": [
            "pony-noun"
          ]
        },
        {
          "id": "1979210",
          "text": "Un pony è un piccolo cavallo.",
          "translation": "Пони — это маленькая лошадь.",
          "source": "Tatoeba #1979210 @Guybrush88 / #2263732 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1979210",
          "cefr_level": "A1",
          "word_slugs": [
            "pony-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
