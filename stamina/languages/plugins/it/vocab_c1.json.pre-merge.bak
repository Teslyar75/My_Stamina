    {
      "slug": "opinioni-noun",
      "lemma": "opinioni",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7126,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5986956",
          "text": "Apprezzo le loro opinioni.",
          "translation": "Я ценю их мнения.",
          "source": "Tatoeba #5986956 @dnnywld / #5986918 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5986956",
          "cefr_level": "A1",
          "word_slugs": [
            "opinioni-noun"
          ]
        },
        {
          "id": "5393555",
          "text": "Loro non cambiano le proprie opinioni.",
          "translation": "Они своего мнения не изменят.",
          "source": "Tatoeba #5393555 @dnnywld / #4040536 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5393555",
          "cefr_level": "A1",
          "word_slugs": [
            "opinioni-noun"
          ]
        },
        {
          "id": "2458076",
          "text": "Abbiamo avuto una divergenza di opinioni.",
          "translation": "У нас было расхождение во мнениях.",
          "source": "Tatoeba #2458076 @al_ex_an_der / #2458079 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2458076",
          "cefr_level": "A1",
          "word_slugs": [
            "opinioni-noun"
          ]
        },
        {
          "id": "3000754",
          "text": "Mia nonna aveva opinioni molto ragionevoli.",
          "translation": "У моей бабушки были очень разумные взгляды.",
          "source": "Tatoeba #3000754 @al_ex_an_der / #3000753 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3000754",
          "cefr_level": "A1",
          "word_slugs": [
            "opinioni-noun"
          ]
        },
        {
          "id": "6460629",
          "text": "Le nostre opinioni sono piuttosto differenti.",
          "translation": "Наши мнения отличаются.",
          "source": "Tatoeba #6460629 @Guybrush88 / #6460872 @ViolettaKoriagina (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6460629",
          "cefr_level": "A1",
          "word_slugs": [
            "opinioni-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la opinioni",
