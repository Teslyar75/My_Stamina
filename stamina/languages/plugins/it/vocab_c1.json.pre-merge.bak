    {
      "slug": "insistito-verb",
      "lemma": "insistito",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6104,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "631593",
          "text": "Abbiamo insistito sulla sua importanza.",
          "translation": "Мы настаивали на том, что это важно.",
          "source": "Tatoeba #631593 @Guybrush88 / #1792752 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/631593",
          "cefr_level": "A1",
          "word_slugs": [
            "insistito-verb"
          ]
        },
        {
          "id": "5640094",
          "text": "Tom ha insistito di andare lì.",
          "translation": "Том настоял на том, чтобы туда поехать.",
          "source": "Tatoeba #5640094 @dnnywld / #5640093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5640094",
          "cefr_level": "A1",
          "word_slugs": [
            "insistito-verb"
          ]
        },
        {
          "id": "5624350",
          "text": "Tom ha insistito per fare questo.",
          "translation": "Том настоял на том, чтобы это сделать.",
          "source": "Tatoeba #5624350 @dnnywld / #5623104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5624350",
          "cefr_level": "A1",
          "word_slugs": [
            "insistito-verb"
          ]
        },
        {
          "id": "908411",
          "text": "Hanno insistito perché prendessi parte alla riunione.",
          "translation": "Они настаивали на том, чтобы я принял участие в собрании.",
          "source": "Tatoeba #908411 @riccioberto / #1792756 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/908411",
          "cefr_level": "A1",
          "word_slugs": [
            "insistito-verb"
          ]
        },
        {
          "id": "5770409",
          "text": "Tom ha insistito che Mary rinunciasse al lavoro.",
          "translation": "Том настоял, чтобы Мэри бросила работу.",
          "source": "Tatoeba #5770409 @dnnywld / #5770115 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5770409",
          "cefr_level": "A1",
          "word_slugs": [
            "insistito-verb"
          ]
        }
      ],
      "tags": [
        "C1"
