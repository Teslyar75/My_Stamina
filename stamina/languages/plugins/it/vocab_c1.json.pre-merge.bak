    {
      "slug": "carlo-name",
      "lemma": "Carlo",
      "pos": "name",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5570,
      "frequency_band": "celi-c1",
      "translations": {
        "ru": [
          "Карл"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5427032",
          "text": "Carlo arrivò alla piattaforma troppo presto.",
          "translation": "Чарльз пришёл на платформу слишком рано.",
          "source": "Tatoeba #5427032 @dnnywld / #5426924 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5427032",
          "cefr_level": "A1",
          "word_slugs": [
            "carlo-name"
          ]
        },
        {
          "id": "11372126",
          "text": "Siamo qui nel nome di Gesù Cristo e Re Carlo.",
          "translation": "Мы здесь во имя Иисуса Христа и короля Карла.",
          "source": "Tatoeba #11372126 @dnnywld / #11372102 @Txoria (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11372126",
          "cefr_level": "A1",
          "word_slugs": [
            "carlo-name"
          ]
        },
        {
          "id": "5427059",
          "text": "A Vicebsk Carlo ha visitato il museo di Marc Chagall.",
          "translation": "В Витебске Чарльз наведался в музей Марка Шагала.",
          "source": "Tatoeba #5427059 @dnnywld / #5426895 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5427059",
          "cefr_level": "A1",
          "word_slugs": [
            "carlo-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il Carlo",
        "plural": "",
        "infinitive": ""
      }
