      "frequency_rank": 5974,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "2478438",
          "text": "Oggi è giovedì.",
          "translation": "Сегодня четверг.",
          "source": "Tatoeba #2478438 @Guybrush88 / #1865237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2478438",
          "cefr_level": "A1",
          "word_slugs": [
            "giovedì-noun"
          ]
        },
        {
          "id": "2181603",
          "text": "Ieri era giovedì.",
          "translation": "Вчера был четверг.",
          "source": "Tatoeba #2181603 @Guybrush88 / #376033 @reiji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2181603",
          "cefr_level": "A1",
          "word_slugs": [
            "giovedì-noun"
          ]
        },
        {
          "id": "5500083",
          "text": "Dopodomani è giovedì.",
          "translation": "Послезавтра четверг.",
          "source": "Tatoeba #5500083 @dnnywld / #5500026 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5500083",
          "cefr_level": "A1",
          "word_slugs": [
            "giovedì-noun"
          ]
        },
        {
          "id": "3961054",
          "text": "Piove da giovedì scorso.",
          "translation": "Дождь идёт с прошлого четверга.",
          "source": "Tatoeba #3961054 @Guybrush88 / #2369092 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3961054",
          "cefr_level": "A1",
          "word_slugs": [
            "giovedì-noun"
          ]
        },
        {
          "id": "5630194",
          "text": "Il giovedì cucino il pesce.",
          "translation": "По четвергам я готовлю рыбу.",
          "source": "Tatoeba #5630194 @dnnywld / #5629596 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5630194",
          "cefr_level": "A1",
          "word_slugs": [
            "giovedì-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
