    {
      "slug": "scambiare-verb",
      "lemma": "scambiare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7550,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5399273",
          "text": "Vorrei scambiare i loro posti.",
          "translation": "Я бы поменял их местами.",
          "source": "Tatoeba #5399273 @dnnywld / #5399239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5399273",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiare-verb"
          ]
        },
        {
          "id": "5599058",
          "text": "Vorrei scambiare una parola con Tom.",
          "translation": "Я хотел бы переговорить с Томом.",
          "source": "Tatoeba #5599058 @dnnywld / #5599032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5599058",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiare-verb"
          ]
        },
        {
          "id": "5563066",
          "text": "Vorrei scambiare i posti con Tom, ma non posso.",
          "translation": "Хотел бы я поменяться местами с Томом, но не могу.",
          "source": "Tatoeba #5563066 @dnnywld / #5560666 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5563066",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiare-verb"
          ]
        },
        {
          "id": "5464658",
          "text": "Puoi concedermi qualche minuto? Vorrei scambiare due parole con te.",
          "translation": "Можешь уделить мне несколько минут? Я хотел бы с тобой переговорить.",
          "source": "Tatoeba #5464658 @dnnywld / #5463906 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5464658",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiare-verb"
          ]
        },
        {
          "id": "5464637",
          "text": "Potete concedermi qualche minuto? Vorrei scambiare due parole con voi.",
          "translation": "Можете уделить мне несколько минут? Я хотел бы с вами переговорить.",
          "source": "Tatoeba #5464637 @dnnywld / #5463907 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5464637",
          "cefr_level": "A1",
          "word_slugs": [
            "scambiare-verb"
          ]
        }
