          ]
        },
        {
          "id": "3154621",
          "text": "Lui iniziò a cantare.",
          "translation": "Он начал петь.",
          "source": "Tatoeba #3154621 @Guybrush88 / #2516079 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3154621",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziò-verb"
          ]
        },
        {
          "id": "3998619",
          "text": "Tom iniziò a pregare.",
          "translation": "Том начал молиться.",
          "source": "Tatoeba #3998619 @Guybrush88 / #4592296 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3998619",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziò-verb"
          ]
        },
        {
          "id": "4649458",
          "text": "Tom iniziò a correre.",
          "translation": "Том побежал.",
          "source": "Tatoeba #4649458 @Guybrush88 / #2623295 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4649458",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziò-verb"
          ]
        },
        {
          "id": "6009376",
          "text": "Lei iniziò a ridacchiare.",
          "translation": "Она захихикала.",
          "source": "Tatoeba #6009376 @dnnywld / #6008662 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6009376",
          "cefr_level": "A1",
          "word_slugs": [
            "iniziò-verb"
          ]
        }
      ],
