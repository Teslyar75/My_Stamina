    {
      "slug": "cellulari-adj",
      "lemma": "cellulari",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5228,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5654847",
          "text": "Mi piacciono i cellulari android.",
          "translation": "Мне нравятся мобильные телефоны на Андроиде.",
          "source": "Tatoeba #5654847 @dnnywld / #5654716 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5654847",
          "cefr_level": "A1",
          "word_slugs": [
            "cellulari-adj"
          ]
        },
        {
          "id": "5482375",
          "text": "I cellulari non funzionano nei tunnel.",
          "translation": "Мобильные телефоны не работают в тоннеле.",
          "source": "Tatoeba #5482375 @dnnywld / #4070792 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5482375",
          "cefr_level": "A1",
          "word_slugs": [
            "cellulari-adj"
          ]
        },
        {
          "id": "5645765",
          "text": "I telefoni cellulari non utilizzano le pile.",
          "translation": "В сотовых телефонах не используются батарейки.",
          "source": "Tatoeba #5645765 @dnnywld / #5645262 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5645765",
          "cefr_level": "A1",
          "word_slugs": [
            "cellulari-adj"
          ]
        },
        {
          "id": "5605641",
          "text": "Ricordi ancora quanti telefoni cellulari hai avuto?",
          "translation": "Ты ещё помнишь, сколько у тебя было мобильных телефонов?",
          "source": "Tatoeba #5605641 @dnnywld / #5605368 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5605641",
          "cefr_level": "A1",
          "word_slugs": [
            "cellulari-adj"
          ]
        },
        {
          "id": "7137823",
          "text": "I cellulari di quel tipo si vendono molto bene.",
          "translation": "Мобильные телефоны такого типа очень хорошо продаются.",
          "source": "Tatoeba #7137823 @dnnywld / #7133469 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7137823",
          "cefr_level": "A1",
          "word_slugs": [
            "cellulari-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il cellulari",
        "plural": "",
        "infinitive": ""
      }
    },
