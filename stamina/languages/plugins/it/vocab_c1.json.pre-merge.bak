    {
      "slug": "aveste-verb",
      "lemma": "aveste",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5639,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5633885",
          "text": "Pensavo che aveste ragione.",
          "translation": "Я думал, вы правы.",
          "source": "Tatoeba #5633885 @Guybrush88 / #10790671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5633885",
          "cefr_level": "A1",
          "word_slugs": [
            "aveste-verb"
          ]
        },
        {
          "id": "5629567",
          "text": "Pensavo che ne aveste già uno.",
          "translation": "Я думал, у вас такое уже есть.",
          "source": "Tatoeba #5629567 @dnnywld / #5629156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629567",
          "cefr_level": "A1",
          "word_slugs": [
            "aveste-verb"
          ]
        },
        {
          "id": "5629569",
          "text": "Pensavo che ne aveste già una.",
          "translation": "Я думал, у вас такая уже есть.",
          "source": "Tatoeba #5629569 @dnnywld / #5629150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5629569",
          "cefr_level": "A1",
          "word_slugs": [
            "aveste-verb"
          ]
        },
        {
          "id": "5397263",
          "text": "Non volevo che mi aveste visto.",
          "translation": "Я не хотела, чтобы меня видели.",
          "source": "Tatoeba #5397263 @dnnywld / #5397114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5397263",
          "cefr_level": "A1",
          "word_slugs": [
            "aveste-verb"
          ]
        },
        {
          "id": "5653572",
          "text": "Pensavo che aveste già fatto questo.",
          "translation": "Я думал, вы это уже сделали.",
          "source": "Tatoeba #5653572 @dnnywld / #5653265 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5653572",
          "cefr_level": "A1",
          "word_slugs": [
            "aveste-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "aveste",
        "plural": "",
        "infinitive": "aveste"
      }
