    {
      "slug": "accetti-verb",
      "lemma": "accetti",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5649,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5445626",
          "text": "Accetti la mia offerta?",
          "translation": "Принимаешь моё предложение?",
          "source": "Tatoeba #5445626 @dnnywld / #2987433 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5445626",
          "cefr_level": "A1",
          "word_slugs": [
            "accetti-verb"
          ]
        },
        {
          "id": "5445639",
          "text": "Non accetti la mia offerta?",
          "translation": "Ты не принимаешь моё предложение?",
          "source": "Tatoeba #5445639 @dnnywld / #4533249 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5445639",
          "cefr_level": "A1",
          "word_slugs": [
            "accetti-verb"
          ]
        },
        {
          "id": "5643694",
          "text": "Accetti di bere qualcosa con me?",
          "translation": "Ты согласен выпить со мной?",
          "source": "Tatoeba #5643694 @dnnywld / #5643681 @Kaiomaar (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5643694",
          "cefr_level": "A1",
          "word_slugs": [
            "accetti-verb"
          ]
        },
        {
          "id": "6881336",
          "text": "Tom pensa che Mary accetti di farlo.",
          "translation": "Том думает, что Мэри согласится это сделать.",
          "source": "Tatoeba #6881336 @dnnywld / #6881064 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6881336",
          "cefr_level": "A1",
          "word_slugs": [
            "accetti-verb"
          ]
        },
        {
          "id": "4984418",
          "text": "Ora basta! O tu accetti o rifiuti la mia proposta.",
          "translation": "С меня довольно! Либо ты принимаешь моё предложение, либо нет.",
          "source": "Tatoeba #4984418 @ianna / #4984980 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4984418",
          "cefr_level": "A1",
          "word_slugs": [
            "accetti-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "accetti",
        "plural": "",
        "infinitive": "accetti"
      }
