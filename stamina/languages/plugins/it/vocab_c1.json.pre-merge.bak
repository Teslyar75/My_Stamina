          "word_slugs": [
            "finendo-verb"
          ]
        },
        {
          "id": "10851845",
          "text": "La benzina sta finendo.",
          "translation": "Бензин заканчивается.",
          "source": "Tatoeba #10851845 @dnnywld / #5207403 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10851845",
          "cefr_level": "A1",
          "word_slugs": [
            "finendo-verb"
          ]
        },
        {
          "id": "6893449",
          "text": "Tom sta finendo la pazienza.",
          "translation": "У Тома кончается терпение.",
          "source": "Tatoeba #6893449 @dnnywld / #6893422 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6893449",
          "cefr_level": "A1",
          "word_slugs": [
            "finendo-verb"
          ]
        },
        {
          "id": "6790321",
          "text": "Sto giusto finendo il rapporto.",
          "translation": "Я как раз заканчиваю отчет.",
          "source": "Tatoeba #6790321 @dnnywld / #4611120 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6790321",
          "cefr_level": "A1",
          "word_slugs": [
            "finendo-verb"
          ]
        }
      ],
      "tags": [
