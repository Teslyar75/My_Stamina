      "frequency_rank": 9129,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5391059",
          "text": "L'ha baciata?",
          "translation": "Ты её поцеловал?",
          "source": "Tatoeba #5391059 @dnnywld / #4575947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5391059",
          "cefr_level": "A1",
          "word_slugs": [
            "baciata-verb"
          ]
        },
        {
          "id": "5391058",
          "text": "L'hai baciata?",
          "translation": "Ты её целовал?",
          "source": "Tatoeba #5391058 @dnnywld / #5391050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5391058",
          "cefr_level": "A1",
          "word_slugs": [
            "baciata-verb"
          ]
        },
        {
          "id": "5391060",
          "text": "Perché l'hai baciata?",
          "translation": "Зачем ты её поцеловал?",
          "source": "Tatoeba #5391060 @dnnywld / #5391045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5391060",
          "cefr_level": "A1",
          "word_slugs": [
            "baciata-verb"
          ]
        },
        {
          "id": "5497464",
          "text": "Tom mi ha baciata solo una volta.",
          "translation": "Том меня только один раз поцеловал.",
          "source": "Tatoeba #5497464 @dnnywld / #5497205 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5497464",
          "cefr_level": "A1",
          "word_slugs": [
            "baciata-verb"
          ]
        },
        {
          "id": "5535702",
          "text": "\"L'hai baciata?\" - \"Si, l'ho baciata\".",
          "translation": "«Ты её поцеловала?» — «Да, я её поцеловала».",
          "source": "Tatoeba #5535702 @dnnywld / #4705679 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5535702",
          "cefr_level": "A1",
          "word_slugs": [
            "baciata-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
