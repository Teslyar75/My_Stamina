          ]
        },
        {
          "id": "5410544",
          "text": "Per televisione trasmettono ancora l'esibizione.",
          "translation": "Выступление снова покажут по телевизору.",
          "source": "Tatoeba #5410544 @dnnywld / #5409932 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5410544",
          "cefr_level": "A1",
          "word_slugs": [
            "esibizione-noun"
          ]
        },
        {
          "id": "5632155",
          "text": "Gli pettatori applaudivano vivamente la loro armoniosa esibizione.",
          "translation": "Зрители от души аплодировали их слаженному выступлению.",
          "source": "Tatoeba #5632155 @dnnywld / #5631185 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5632155",
          "cefr_level": "A1",
