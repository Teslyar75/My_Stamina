    {
      "slug": "conquistare-verb",
      "lemma": "conquistare",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6754,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6680345",
          "text": "Lui era determinato a conquistare il suo cuore.",
          "translation": "Он был полон решимости завоевать её сердце.",
          "source": "Tatoeba #6680345 @dnnywld / #6680182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6680345",
          "cefr_level": "A1",
          "word_slugs": [
            "conquistare-verb"
          ]
        },
        {
          "id": "6680415",
          "text": "Lui era determinato a conquistare il suo amore.",
          "translation": "Он был полон решимости завоевать её любовь.",
          "source": "Tatoeba #6680415 @dnnywld / #6680168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6680415",
          "cefr_level": "A1",
          "word_slugs": [
            "conquistare-verb"
          ]
        },
        {
          "id": "5626675",
          "text": "Ho provato inutilmente a conquistare il suo cuore.",
          "translation": "Я тщетно пытался отвоевать её сердце.",
          "source": "Tatoeba #5626675 @dnnywld / #5626609 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5626675",
          "cefr_level": "A1",
          "word_slugs": [
            "conquistare-verb"
          ]
        },
        {
          "id": "6785961",
          "text": "Lui voleva conquistare il mondo. Per quale motivo?",
          "translation": "Он хотел завоевать мир. Зачем?",
          "source": "Tatoeba #6785961 @dnnywld / #6785805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6785961",
          "cefr_level": "A1",
          "word_slugs": [
            "conquistare-verb"
          ]
        },
        {
          "id": "6680351",
          "text": "Tom era determinato a conquistare il cuore di Mary.",
          "translation": "Том был полон решимости завоевать сердце Мэри.",
          "source": "Tatoeba #6680351 @dnnywld / #6680181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6680351",
          "cefr_level": "A1",
          "word_slugs": [
            "conquistare-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "conquistare",
        "plural": "",
        "infinitive": "conquistare"
      }
    },
    {
      "slug": "costretti-adj",
      "lemma": "costretti",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6755,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5419418",
          "text": "Non sono costretti a rispondere.",
          "translation": "Они могут не отвечать.",
          "source": "Tatoeba #5419418 @dnnywld / #3060328 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5419418",
          "cefr_level": "A1",
          "word_slugs": [
            "costretti-adj"
          ]
        },
        {
          "id": "7078384",
          "text": "Siamo stati costretti ad andarcene.",
          "translation": "Мы были вынуждены уехать.",
          "source": "Tatoeba #7078384 @dnnywld / #7077928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7078384",
          "cefr_level": "A1",
          "word_slugs": [
            "costretti-adj"
          ]
        },
        {
          "id": "6786559",
          "text": "I coloni furono costretti a lasciare le loro terre.",
          "translation": "Поселенцы были вынуждены покинуть свои земли.",
          "source": "Tatoeba #6786559 @dnnywld / #4420643 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786559",
          "cefr_level": "A1",
          "word_slugs": [
            "costretti-adj"
          ]
        },
        {
          "id": "6786565",
          "text": "Molti armeni furono costretti ad abbandonare le loro terre.",
          "translation": "Многих армян заставили покинуть свои земли.",
          "source": "Tatoeba #6786565 @dnnywld / #5681541 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6786565",
          "cefr_level": "A1",
          "word_slugs": [
            "costretti-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il costretti",
        "plural": "",
        "infinitive": ""
      }
    },
