          "cefr_level": "A1",
          "word_slugs": [
            "bancomat-noun"
          ]
        },
        {
          "id": "14023515",
          "text": "Sto cercando un bancomat.",
          "translation": "Я ищу банкомат.",
          "source": "Tatoeba #14023515 @Guybrush88 / #7447080 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14023515",
          "cefr_level": "A1",
