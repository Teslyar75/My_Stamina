    {
      "slug": "dentista-noun",
      "lemma": "dentista",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5857,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5635571",
          "text": "Quanto spesso vai dal dentista?",
          "translation": "Как часто ты ходишь к зубному?",
          "source": "Tatoeba #5635571 @dnnywld / #4235659 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5635571",
          "cefr_level": "A1",
          "word_slugs": [
            "dentista-noun"
          ]
        },
        {
          "id": "7257646",
          "text": "Non voglio andare dal dentista.",
          "translation": "Я не хочу идти к зубному.",
          "source": "Tatoeba #7257646 @Guybrush88 / #4627274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7257646",
          "cefr_level": "A1",
          "word_slugs": [
            "dentista-noun"
          ]
        },
        {
          "id": "10840843",
          "text": "Ho preso appuntamento dal dentista.",
          "translation": "Я записан на приём к стоматологу.",
          "source": "Tatoeba #10840843 @dnnywld / #2418271 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10840843",
          "cefr_level": "A1",
          "word_slugs": [
            "dentista-noun"
          ]
        },
        {
          "id": "10840815",
          "text": "Devo prendere appuntamento dal dentista.",
          "translation": "Мне надо записаться к зубному.",
          "source": "Tatoeba #10840815 @dnnywld / #8580963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10840815",
          "cefr_level": "A1",
          "word_slugs": [
            "dentista-noun"
          ]
        },
        {
          "id": "2414779",
          "text": "Lei è sposata con un dentista.",
          "translation": "Она замужем за дантистом.",
          "source": "Tatoeba #2414779 @Guybrush88 / #2414374 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2414779",
          "cefr_level": "A1",
          "word_slugs": [
            "dentista-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "m",
        "singular": "il dentista",
