    {
      "slug": "lampada-noun",
      "lemma": "lampada",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6063,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6866744",
          "text": "Tom accese la lampada.",
          "translation": "Том зажёг лампу.",
          "source": "Tatoeba #6866744 @dnnywld / #6864601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6866744",
          "cefr_level": "A1",
          "word_slugs": [
            "lampada-noun"
          ]
        },
        {
          "id": "5552776",
          "text": "Questa lampada è nuova?",
          "translation": "Это новая лампа?",
          "source": "Tatoeba #5552776 @dnnywld / #5552467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5552776",
          "cefr_level": "A1",
          "word_slugs": [
            "lampada-noun"
          ]
        },
        {
          "id": "7529142",
          "text": "Mi piace questa lampada.",
          "translation": "Мне нравится эта лампа.",
          "source": "Tatoeba #7529142 @dnnywld / #7527655 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7529142",
          "cefr_level": "A1",
          "word_slugs": [
            "lampada-noun"
          ]
        },
        {
          "id": "1246894",
          "text": "Comprai una vecchia lampada.",
          "translation": "Я купил старую лампу.",
          "source": "Tatoeba #1246894 @Guybrush88 / #2988125 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246894",
          "cefr_level": "A1",
          "word_slugs": [
            "lampada-noun"
          ]
        },
        {
          "id": "5964789",
          "text": "Quanto costa quella lampada?",
          "translation": "Сколько стоит та лампа?",
          "source": "Tatoeba #5964789 @dnnywld / #5964743 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964789",
          "cefr_level": "A1",
          "word_slugs": [
            "lampada-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
