    {
      "slug": "vuote-adj",
      "lemma": "vuote",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6595,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "12805691",
          "text": "È arrivato a mani vuote.",
          "translation": "Он пришёл с пустыми руками.",
          "source": "Tatoeba #12805691 @dnnywld / #12804958 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12805691",
          "cefr_level": "A1",
          "word_slugs": [
            "vuote-adj"
          ]
        },
        {
          "id": "12805695",
          "text": "Sei uscito a mani vuote.",
          "translation": "Ты ушёл с пустыми руками.",
          "source": "Tatoeba #12805695 @dnnywld / #12804953 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12805695",
          "cefr_level": "A1",
          "word_slugs": [
            "vuote-adj"
          ]
        },
        {
          "id": "12805693",
          "text": "Siete usciti a mani vuote.",
          "translation": "Вы ушли с пустыми руками.",
          "source": "Tatoeba #12805693 @dnnywld / #12804955 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12805693",
          "cefr_level": "A1",
          "word_slugs": [
            "vuote-adj"
          ]
        },
        {
          "id": "10790813",
          "text": "Queste non sono vuote parole.",
          "translation": "Это не пустые слова.",
          "source": "Tatoeba #10790813 @dnnywld / #10790685 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10790813",
          "cefr_level": "A1",
          "word_slugs": [
            "vuote-adj"
          ]
        },
        {
          "id": "5426793",
          "text": "Le vostre polemiche sono vuote.",
          "translation": "Ваши споры пустые.",
          "source": "Tatoeba #5426793 @dnnywld / #4268127 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5426793",
          "cefr_level": "A1",
          "word_slugs": [
            "vuote-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": "f",
        "singular": "la vuote",
