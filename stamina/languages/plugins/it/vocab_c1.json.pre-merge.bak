            "urlato-verb"
          ]
        },
        {
          "id": "5566070",
          "text": "Tom ha urlato a Mary?",
          "translation": "Том орал на Мэри?",
          "source": "Tatoeba #5566070 @dnnywld / #5565090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5566070",
          "cefr_level": "A1",
          "word_slugs": [
            "urlato-verb"
          ]
        },
        {
          "id": "5586523",
          "text": "Non ho urlato verso Tom.",
          "translation": "Я не кричал на Тома.",
          "source": "Tatoeba #5586523 @dnnywld / #5586404 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5586523",
          "cefr_level": "A1",
          "word_slugs": [
            "urlato-verb"
          ]
        }
