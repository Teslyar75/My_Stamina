    {
      "slug": "necessita-verb",
      "lemma": "necessita",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8164,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5964923",
          "text": "La casa necessita di riparazioni.",
          "translation": "Дому нужен ремонт.",
          "source": "Tatoeba #5964923 @dnnywld / #5964677 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964923",
          "cefr_level": "A1",
          "word_slugs": [
            "necessita-verb"
          ]
        },
        {
          "id": "6854815",
          "text": "Questa bicicletta necessita di riparazione.",
          "translation": "Этот велосипед требует починки.",
          "source": "Tatoeba #6854815 @dnnywld / #656598 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6854815",
          "cefr_level": "A1",
          "word_slugs": [
            "necessita-verb"
          ]
        },
        {
          "id": "5964862",
          "text": "Il mio gatto necessita un'operazione.",
          "translation": "Моей кошке нужна операция.",
          "source": "Tatoeba #5964862 @dnnywld / #5964702 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964862",
          "cefr_level": "A1",
          "word_slugs": [
            "necessita-verb"
          ]
        },
        {
          "id": "5964859",
          "text": "Il mio cane necessita di un'operazione.",
          "translation": "Моей собаке нужна операция.",
          "source": "Tatoeba #5964859 @dnnywld / #5964704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964859",
          "cefr_level": "A1",
          "word_slugs": [
            "necessita-verb"
          ]
        },
        {
          "id": "6854862",
          "text": "Il mio orologio necessita solo di riparazioni minori.",
          "translation": "Мои часы нуждаются лишь в небольшой починке.",
          "source": "Tatoeba #6854862 @dnnywld / #2959244 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6854862",
          "cefr_level": "A1",
          "word_slugs": [
            "necessita-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "necessita",
        "plural": "",
        "infinitive": "necessita"
      }
