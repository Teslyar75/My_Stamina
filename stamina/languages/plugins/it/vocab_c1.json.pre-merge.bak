      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "6841927",
          "text": "La pulizia è un attributo indispensabile all'eleganza.",
          "translation": "Чистота — непременный атрибут элегантности.",
          "source": "Tatoeba #6841927 @dnnywld / #4018114 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841927",
          "cefr_level": "A1",
          "word_slugs": [
            "pulizia-noun"
          ]
        },
        {
          "id": "6961312",
          "text": "\"E le tue mani sono pulite?\" - \"Dubiti della pulizia delle mie mani?\".",
          "translation": "\"А руки у тебя чистые?\" — \"Ты сомневаешься в чистоте моих рук?\"",
          "source": "Tatoeba #6961312 @dnnywld / #6960478 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6961312",
          "cefr_level": "A1",
          "word_slugs": [
            "pulizia-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
