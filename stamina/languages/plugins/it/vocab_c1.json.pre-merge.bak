    {
      "slug": "regione-noun",
      "lemma": "regione",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6445,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "3246925",
          "text": "La Normandia è una regione francese.",
          "translation": "Нормандия является регионом Франции.",
          "source": "Tatoeba #3246925 @Guybrush88 / #6044361 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3246925",
          "cefr_level": "A1",
          "word_slugs": [
            "regione-noun"
          ]
        },
        {
          "id": "4557",
          "text": "Il fiume ha invaso tutta la regione.",
          "translation": "Река наводнила весь регион.",
          "source": "Tatoeba #4557 @Pharamp / #5494851 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4557",
          "cefr_level": "A1",
          "word_slugs": [
            "regione-noun"
          ]
        },
        {
          "id": "616105",
          "text": "Il riso è la coltura principale di questa regione.",
          "translation": "Рис - основная культура этого региона.",
          "source": "Tatoeba #616105 @rado / #12263535 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/616105",
          "cefr_level": "A1",
          "word_slugs": [
            "regione-noun"
          ]
        },
        {
          "id": "6921646",
          "text": "La popolazione della regione è diminuita di un terzo.",
          "translation": "Население региона сократилось на треть.",
          "source": "Tatoeba #6921646 @dnnywld / #6921581 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6921646",
          "cefr_level": "A1",
          "word_slugs": [
            "regione-noun"
          ]
        },
        {
          "id": "1905270",
          "text": "È quasi impossibile sopravvalutare l'importanza politica della Turchia nella regione.",
          "translation": "Политическое значение Турции в этом регионе трудно переоценить.",
          "source": "Tatoeba #1905270 @al_ex_an_der / #1905246 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1905270",
          "cefr_level": "A1",
          "word_slugs": [
            "regione-noun"
