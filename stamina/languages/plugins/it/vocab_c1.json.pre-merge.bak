    {
      "slug": "cercavano-verb",
      "lemma": "cercavano",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 8596,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "6300186",
          "text": "Cosa cercavano lì?",
          "translation": "Что они там искали?",
          "source": "Tatoeba #6300186 @dnnywld / #6300173 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6300186",
          "cefr_level": "A1",
          "word_slugs": [
            "cercavano-verb"
          ]
        },
        {
          "id": "6944412",
          "text": "Tom e Mary si cercavano a vicenda.",
          "translation": "Том и Мэри искали друг друга.",
          "source": "Tatoeba #6944412 @dnnywld / #6943781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6944412",
          "cefr_level": "A1",
          "word_slugs": [
            "cercavano-verb"
          ]
        },
        {
          "id": "6908811",
          "text": "Cercavano con tutte le forze di sbarcare il lunario.",
          "translation": "Они изо всех сил старались свести концы с концами.",
          "source": "Tatoeba #6908811 @dnnywld / #3788036 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6908811",
          "cefr_level": "A1",
          "word_slugs": [
            "cercavano-verb"
          ]
        },
        {
          "id": "5538193",
          "text": "Non siamo riusciti a capire quello che cercavano di dire.",
          "translation": "Мы не могли понять, что они пытаются сказать.",
          "source": "Tatoeba #5538193 @dnnywld / #5537742 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5538193",
          "cefr_level": "A1",
          "word_slugs": [
            "cercavano-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cercavano",
        "plural": "",
        "infinitive": "cercavano"
      }
    },
    {
      "slug": "ritornato-adj",
