    {
      "slug": "appoggio-noun",
      "lemma": "appoggio",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 5879,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5151868",
          "text": "Tom ha il mio appoggio.",
          "translation": "У Тома есть моя поддержка.",
          "source": "Tatoeba #5151868 @Guybrush88 / #6041142 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5151868",
          "cefr_level": "A1",
          "word_slugs": [
            "appoggio-noun"
          ]
        },
        {
          "id": "1792094",
          "text": "L'Algeria merita fiducia e appoggio.",
          "translation": "Алжир заслуживает доверия и поддержки.",
          "source": "Tatoeba #1792094 @al_ex_an_der / #1792102 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1792094",
          "cefr_level": "A1",
          "word_slugs": [
            "appoggio-noun"
          ]
        },
        {
          "id": "2585065",
          "text": "Noi abbiamo bisogno del tuo appoggio.",
          "translation": "Нам нужна твоя поддержка.",
          "source": "Tatoeba #2585065 @Guybrush88 / #3091701 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2585065",
          "cefr_level": "A1",
          "word_slugs": [
            "appoggio-noun"
          ]
        }
