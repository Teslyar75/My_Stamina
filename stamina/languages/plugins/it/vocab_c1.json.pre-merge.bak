    {
      "slug": "biasimo-noun",
      "lemma": "biasimo",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9826,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6886186",
          "text": "Non vi biasimo.",
          "translation": "Я вас не осуждаю.",
          "source": "Tatoeba #6886186 @dnnywld / #6885982 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886186",
          "cefr_level": "A1",
          "word_slugs": [
            "biasimo-noun"
          ]
        },
        {
          "id": "6886187",
          "text": "Non ti biasimo.",
          "translation": "Я тебя не осуждаю.",
          "source": "Tatoeba #6886187 @dnnywld / #6885981 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886187",
          "cefr_level": "A1",
          "word_slugs": [
            "biasimo-noun"
          ]
        },
        {
          "id": "6886188",
          "text": "Non biasimo nessuno.",
          "translation": "Я никого не осуждаю.",
          "source": "Tatoeba #6886188 @dnnywld / #6885980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6886188",
          "cefr_level": "A1",
          "word_slugs": [
            "biasimo-noun"
          ]
        },
        {
          "id": "5642445",
          "text": "Non biasimo Tom per aver fatto questo.",
          "translation": "Я не виню Тома за то, что он это сделал.",
          "source": "Tatoeba #5642445 @dnnywld / #5641872 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5642445",
          "cefr_level": "A1",
          "word_slugs": [
            "biasimo-noun"
          ]
        },
        {
          "id": "2488624",
          "text": "Lo so che non mi credi. E non ti biasimo per questo.",
          "translation": "Я знаю, что ты мне не веришь. И я тебя за это не осуждаю.",
          "source": "Tatoeba #2488624 @rado / #3327597 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2488624",
          "cefr_level": "A1",
          "word_slugs": [
            "biasimo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
