          "cefr_level": "A1",
          "word_slugs": [
            "monaco-noun"
          ]
        },
        {
          "id": "5448596",
          "text": "Monaco è la capitale della Baviera.",
          "translation": "Мюнхен — столица Баварии.",
          "source": "Tatoeba #5448596 @Guybrush88 / #5401164 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5448596",
