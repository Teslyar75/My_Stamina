    {
      "slug": "sgradevole-adj",
      "lemma": "sgradevole",
      "pos": "adj",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 9701,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "5387194",
          "text": "Tom è molto sgradevole.",
          "translation": "Том очень неприятный.",
          "source": "Tatoeba #5387194 @dnnywld / #5387175 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5387194",
          "cefr_level": "A1",
          "word_slugs": [
            "sgradevole-adj"
          ]
        },
        {
          "id": "3642624",
          "text": "La forfora è sgradevole da vedere.",
          "translation": "Перхоть неприятна на вид.",
          "source": "Tatoeba #3642624 @Guybrush88 / #3642650 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3642624",
          "cefr_level": "A1",
          "word_slugs": [
            "sgradevole-adj"
          ]
        },
        {
          "id": "2914884",
          "text": "Tom ha una voce alta e sgradevole.",
          "translation": "У Тома неприятный громкий голос.",
          "source": "Tatoeba #2914884 @Guybrush88 / #2761623 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2914884",
          "cefr_level": "A1",
          "word_slugs": [
            "sgradevole-adj"
          ]
        },
        {
          "id": "3642625",
          "text": "La forfora è molto sgradevole da vedere.",
          "translation": "Перхоть очень неприятна на вид.",
          "source": "Tatoeba #3642625 @Guybrush88 / #3642637 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3642625",
          "cefr_level": "A1",
