    {
      "slug": "cambiati-verb",
      "lemma": "cambiati",
      "pos": "verb",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 7613,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5472347",
          "text": "I piani sono cambiati.",
          "translation": "Планы изменились.",
          "source": "Tatoeba #5472347 @dnnywld / #5033131 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472347",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiati-verb"
          ]
        },
        {
          "id": "5472423",
          "text": "Voi non siete cambiati.",
          "translation": "Вы не изменились.",
          "source": "Tatoeba #5472423 @dnnywld / #4136543 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472423",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiati-verb"
          ]
        },
        {
          "id": "715610",
          "text": "Il carcere li ha cambiati?",
          "translation": "Изменила ли их тюрьма?",
          "source": "Tatoeba #715610 @Guybrush88 / #727016 @ivanov (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/715610",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiati-verb"
          ]
        },
        {
          "id": "5472438",
          "text": "I tempi sono senza dubbio cambiati.",
          "translation": "Времена безусловно изменились.",
          "source": "Tatoeba #5472438 @dnnywld / #4678465 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5472438",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiati-verb"
          ]
        },
        {
          "id": "7312064",
          "text": "I tubi andavano cambiati secoli fa.",
          "translation": "Трубы надо было давным-давно поменять.",
          "source": "Tatoeba #7312064 @dnnywld / #7311803 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7312064",
          "cefr_level": "A1",
          "word_slugs": [
            "cambiati-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "italian": {
        "gender": null,
        "singular": "cambiati",
        "plural": "",
