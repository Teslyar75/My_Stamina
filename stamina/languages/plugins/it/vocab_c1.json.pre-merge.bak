          ]
        },
        {
          "id": "6843175",
          "text": "Scrivi delle breve frasi.",
          "translation": "Пиши короткие предложения.",
          "source": "Tatoeba #6843175 @dnnywld / #6151349 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843175",
