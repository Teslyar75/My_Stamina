    {
      "slug": "durata-noun",
      "lemma": "durata",
      "pos": "noun",
      "language": "it",
      "cefr_level": "C1",
      "frequency_rank": 6068,
      "frequency_band": "celi-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "5392323",
          "text": "La conferenza è durata due ore.",
          "translation": "Лекция продлилась два часа.",
          "source": "Tatoeba #5392323 @dnnywld / #5391934 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5392323",
          "cefr_level": "A1",
          "word_slugs": [
            "durata-noun"
          ]
        },
        {
          "id": "3233440",
          "text": "La pioggia è durata cinque giorni.",
          "translation": "Дождь продолжался пять дней.",
          "source": "Tatoeba #3233440 @Guybrush88 / #2658349 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3233440",
          "cefr_level": "A1",
          "word_slugs": [
            "durata-noun"
          ]
        },
        {
          "id": "5891774",
          "text": "Questa è una soluzione di breve durata.",
          "translation": "Это кратковременное решение.",
          "source": "Tatoeba #5891774 @dnnywld / #5891669 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5891774",
          "cefr_level": "A1",
          "word_slugs": [
            "durata-noun"
          ]
        },
        {
          "id": "5622304",
          "text": "La nostra sfortuna non è durata a lungo.",
          "translation": "Наша неудача длилась недолго.",
          "source": "Tatoeba #5622304 @dnnywld / #5622106 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5622304",
          "cefr_level": "A1",
          "word_slugs": [
            "durata-noun"
          ]
        },
        {
          "id": "7947545",
          "text": "La Seconda Guerra Mondiale è durata dal 1939 al 1945.",
          "translation": "Вторая мировая война продолжалась с 1939 по 1945 год.",
          "source": "Tatoeba #7947545 @Guybrush88 / #9142766 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7947545",
          "cefr_level": "A1",
          "word_slugs": [
            "durata-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki it (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
