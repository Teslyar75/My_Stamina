    {
      "slug": "mauern-noun",
      "lemma": "Mauern",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5725,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of mauern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10625308",
          "text": "Die Mauern schweigen.",
          "translation": "Стены молчат.",
          "source": "Tatoeba #10625308 @maaster / #10626432 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10625308",
          "cefr_level": "A1",
          "word_slugs": [
            "mauern-noun"
          ]
        },
        {
          "id": "2430140",
          "text": "Die Mauern sind weiß.",
          "translation": "Стены белые.",
          "source": "Tatoeba #2430140 @al_ex_an_der / #2430144 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430140",
          "cefr_level": "A1",
          "word_slugs": [
            "mauern-noun"
          ]
        },
        {
          "id": "7273072",
          "text": "Florenz war von Mauern umgeben.",
          "translation": "Флоренция была окружена стенами.",
          "source": "Tatoeba #7273072 @Pfirsichbaeumchen / #7129378 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7273072",
          "cefr_level": "A1",
          "word_slugs": [
            "mauern-noun"
          ]
        },
        {
          "id": "13178946",
          "text": "Christen bauen Brücken, keine Mauern.",
          "translation": "Христиане строят мосты, а не стены.",
          "source": "Tatoeba #13178946 @Rovo / #13179002 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13178946",
          "cefr_level": "A1",
          "word_slugs": [
            "mauern-noun"
          ]
        },
        {
          "id": "1996062",
          "text": "Papa malte die Mauern weiß an.",
          "translation": "Папа покрасил стены в белый.",
          "source": "Tatoeba #1996062 @Reini / #8654301 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1996062",
          "cefr_level": "A1",
          "word_slugs": [
            "mauern-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
