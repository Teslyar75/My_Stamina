    {
      "slug": "umschlag-noun",
      "lemma": "Umschlag",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5647,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "конверт",
          "компресс"
        ],
        "en": [
          "envelope",
          "wrapper, cover of a book, dust jacket",
          "compress",
          "turnover"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "721404",
          "text": "Er öffnete den Umschlag.",
          "translation": "Он открыл конверт.",
          "source": "Tatoeba #721404 @stefz / #5866597 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/721404",
          "cefr_level": "A1",
          "word_slugs": [
            "umschlag-noun"
          ]
        },
        {
          "id": "403679",
          "text": "Er schnitt den Umschlag auf.",
          "translation": "Он взрезал конверт.",
          "source": "Tatoeba #403679 @xtofu80 / #576493 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/403679",
          "cefr_level": "A1",
          "word_slugs": [
            "umschlag-noun"
          ]
        },
        {
          "id": "6312029",
          "text": "Ich habe schon einen Umschlag.",
          "translation": "У меня уже есть конверт.",
          "source": "Tatoeba #6312029 @carlosalberto / #3675828 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6312029",
          "cefr_level": "A1",
          "word_slugs": [
            "umschlag-noun"
          ]
        },
        {
          "id": "13994881",
          "text": "Hast du den Umschlag geöffnet?",
          "translation": "Ты открыл конверт?",
          "source": "Tatoeba #13994881 @mhr / #13995207 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13994881",
          "cefr_level": "A1",
          "word_slugs": [
            "umschlag-noun"
          ]
        },
        {
          "id": "403684",
          "text": "Ich habe bereits einen Umschlag.",
          "translation": "У меня уже есть конверт.",
          "source": "Tatoeba #403684 @xtofu80 / #3675828 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/403684",
          "cefr_level": "A1",
          "word_slugs": [
            "umschlag-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
