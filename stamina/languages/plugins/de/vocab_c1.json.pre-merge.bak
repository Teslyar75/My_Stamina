    {
      "slug": "verängstigt-verb",
      "lemma": "verängstigt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5640,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of verängstigen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2976102",
          "text": "Du hast Tom verängstigt.",
          "translation": "Ты напугал Тома.",
          "source": "Tatoeba #2976102 @Pfirsichbaeumchen / #2495286 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2976102",
          "cefr_level": "A1",
          "word_slugs": [
            "verängstigt-verb"
          ]
        },
        {
          "id": "4936243",
          "text": "Tom wirkte verängstigt und besorgt.",
          "translation": "Том казался испуганным и озабоченным.",
          "source": "Tatoeba #4936243 @freddy1 / #4936862 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4936243",
          "cefr_level": "A1",
          "word_slugs": [
            "verängstigt-verb"
          ]
        },
        {
          "id": "10636906",
          "text": "Katzen schnauben, wenn sie böse oder verängstigt sind.",
          "translation": "Кошки фыркают, когда злятся или пугаются.",
          "source": "Tatoeba #10636906 @Pfirsichbaeumchen / #5471764 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10636906",
          "cefr_level": "A1",
          "word_slugs": [
            "verängstigt-verb"
          ]
        },
        {
          "id": "2433641",
          "text": "Dort blieb Tom stehen, keuchend, benommen und verängstigt.",
          "translation": "Там Том остановился, тяжело дыша, ошеломленный и испуганный.",
          "source": "Tatoeba #2433641 @al_ex_an_der / #2433631 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2433641",
          "cefr_level": "A1",
          "word_slugs": [
            "verängstigt-verb"
          ]
        }
      ],
