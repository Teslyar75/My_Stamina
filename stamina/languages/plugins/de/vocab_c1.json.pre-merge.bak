    {
      "slug": "mieten-verb",
      "lemma": "mieten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6818,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "арендовать",
          "снимать"
        ],
        "en": [
          "to hire, to rent"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11507611",
          "text": "Die möchten Fahrräder mieten.",
          "translation": "Они хотели бы взять напрокат велосипеды.",
          "source": "Tatoeba #11507611 @Pfirsichbaeumchen / #4332857 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11507611",
          "cefr_level": "A1",
          "word_slugs": [
            "mieten-verb"
          ]
        },
        {
          "id": "3646475",
          "text": "Ich werde ein Auto mieten.",
          "translation": "Я возьму напрокат машину.",
          "source": "Tatoeba #3646475 @al_ex_an_der / #3646990 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3646475",
          "cefr_level": "A1",
          "word_slugs": [
            "mieten-verb"
          ]
        },
        {
          "id": "747701",
          "text": "Ich möchte ein Haus mieten.",
          "translation": "Я хотел бы арендовать дом.",
          "source": "Tatoeba #747701 @Dejo / #1511965 @SunaLooch (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/747701",
          "cefr_level": "A1",
          "word_slugs": [
            "mieten-verb"
          ]
        },
        {
          "id": "3669537",
          "text": "Ich musste ein Auto mieten.",
          "translation": "Я должен был взять напрокат машину.",
          "source": "Tatoeba #3669537 @Esperantostern / #3670543 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3669537",
          "cefr_level": "A1",
          "word_slugs": [
            "mieten-verb"
          ]
        },
        {
          "id": "12190483",
          "text": "Ich will eine Jacht mieten.",
          "translation": "Я хочу арендовать яхту.",
          "source": "Tatoeba #12190483 @Pfirsichbaeumchen / #4617392 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12190483",
          "cefr_level": "A1",
          "word_slugs": [
            "mieten-verb"
          ]
        }
      ],
