    {
      "slug": "römischen-adj",
      "lemma": "römischen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9888,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of römisch:",
          "strong genitive masculine/neuter singular",
          "inflection of römisch:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8643471",
          "text": "In römischen Amphitheatern fanden Gladiatorenkämpfe statt.",
          "translation": "В римских амфитеатрах проходили бои гладиаторов.",
          "source": "Tatoeba #8643471 @Melang / #13440453 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8643471",
          "cefr_level": "A1",
          "word_slugs": [
            "römischen-adj"
          ]
        },
        {
          "id": "4895648",
          "text": "Was führte zum Untergang des Römischen Reiches?",
          "translation": "Что привело к падению Римской империи?",
          "source": "Tatoeba #4895648 @Pfirsichbaeumchen / #4943357 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4895648",
          "cefr_level": "A1",
          "word_slugs": [
            "römischen-adj"
          ]
        },
        {
          "id": "7273175",
          "text": "Die frühen Christen wurden vom Römischen Reich verfolgt.",
          "translation": "Ранние христиане подвергались гонениям со стороны Римской империи.",
          "source": "Tatoeba #7273175 @Pfirsichbaeumchen / #12444026 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7273175",
          "cefr_level": "A1",
          "word_slugs": [
            "römischen-adj"
          ]
        },
        {
          "id": "1234824",
          "text": "Tom kennt nicht den Unterschied zwischen Rom und dem Römischen Reich.",
          "translation": "Том не знает разницы между Римом и Римской империей.",
          "source": "Tatoeba #1234824 @al_ex_an_der / #1293780 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1234824",
          "cefr_level": "A1",
          "word_slugs": [
            "römischen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
