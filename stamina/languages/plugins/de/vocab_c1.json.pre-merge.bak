        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8275545",
          "text": "Es ist noch billiger.",
          "translation": "Это ещё дешевле.",
          "source": "Tatoeba #8275545 @felix63 / #10933090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8275545",
