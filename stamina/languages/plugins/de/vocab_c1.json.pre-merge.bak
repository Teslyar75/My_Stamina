    {
      "slug": "buchstäblich-adj",
      "lemma": "buchstäblich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6530,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "literal"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "11674051",
          "text": "Das ist buchstäblich vor ein paar Tagen passiert.",
          "translation": "Это случилось буквально несколько дней назад.",
          "source": "Tatoeba #11674051 @Pfirsichbaeumchen / #4088080 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11674051",
          "cefr_level": "A1",
          "word_slugs": [
            "buchstäblich-adj"
          ]
        },
        {
          "id": "2417606",
          "text": "Und da durchbohrt mich buchstäblich ein heftiger Schmerz.",
          "translation": "И тут меня буквально пронзает дикая боль.",
          "source": "Tatoeba #2417606 @al_ex_an_der / #2417601 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2417606",
          "cefr_level": "A1",
          "word_slugs": [
            "buchstäblich-adj"
          ]
        },
        {
          "id": "2346619",
          "text": "Die russische Sprache der Gegenwart ist buchstäblich mit Anglizismen vollgestopft.",
          "translation": "Современный русский язык буквально напичкан англицизмами.",
          "source": "Tatoeba #2346619 @al_ex_an_der / #2346617 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2346619",
          "cefr_level": "A1",
          "word_slugs": [
            "buchstäblich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
