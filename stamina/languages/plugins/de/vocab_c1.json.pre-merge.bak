      "gender": null,
      "examples": [
        {
          "id": "10812758",
          "text": "Was plant ihr?",
          "translation": "Что планируете?",
          "source": "Tatoeba #10812758 @toivo / #10812333 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10812758",
