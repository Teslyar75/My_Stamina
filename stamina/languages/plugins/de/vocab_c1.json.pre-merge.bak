          "cefr_level": "A1",
          "word_slugs": [
            "beeinflussen-verb"
          ]
        },
        {
          "id": "8371954",
          "text": "Ich will deine Entscheidung nicht beeinflussen.",
          "translation": "Не хочу влиять на твоё решение.",
