          "text": "Er kann tauchen.",
          "translation": "Он умеет нырять.",
          "source": "Tatoeba #1753625 @Pfirsichbaeumchen / #2828378 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1753625",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchen-verb"
          ]
        },
        {
          "id": "7636316",
          "text": "Tom kann tauchen.",
          "translation": "Том умеет нырять.",
          "source": "Tatoeba #7636316 @wolfgangth / #5529388 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7636316",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchen-verb"
          ]
        },
        {
          "id": "5706587",
          "text": "Tom kann gut tauchen.",
          "translation": "Том хорошо ныряет.",
          "source": "Tatoeba #5706587 @Pfirsichbaeumchen / #5530153 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5706587",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchen-verb"
          ]
        },
        {
          "id": "2935217",
          "text": "Die Möwen tauchen ins Meer ein.",
          "translation": "Чайки ныряют в море.",
          "source": "Tatoeba #2935217 @al_ex_an_der / #1976154 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2935217",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchen-verb"
          ]
        },
        {
          "id": "13372358",
          "text": "Ich habe tauchen gelernt, als ich fünf Jahre alt war.",
          "translation": "Я научился нырять, когда мне было пять лет.",
          "source": "Tatoeba #13372358 @mhr / #5529420 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13372358",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchen-verb"
          ]
        }
      ],
