          ]
        },
        {
          "id": "13809797",
          "text": "Wie übersetzt man „Ironie“?",
          "translation": "Как переводится \"ирония\"?",
          "source": "Tatoeba #13809797 @mhr / #13809804 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13809797",
          "cefr_level": "A1",
          "word_slugs": [
