      },
      "gender": null,
      "examples": [
        {
          "id": "12293349",
          "text": "Ich habe genug von euren Problemen.",
          "translation": "Я устал от ваших проблем.",
          "source": "Tatoeba #12293349 @Pfirsichbaeumchen / #12292601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12293349",
          "cefr_level": "A1",
          "word_slugs": [
            "problemen-noun"
          ]
        },
        {
          "id": "12293351",
          "text": "Ich habe genug von deinen Problemen.",
          "translation": "Я устал от твоих проблем.",
          "source": "Tatoeba #12293351 @Pfirsichbaeumchen / #12292600 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12293351",
          "cefr_level": "A1",
          "word_slugs": [
            "problemen-noun"
          ]
        },
        {
          "id": "827536",
          "text": "Bitte erzähle mir von deinen Problemen.",
          "translation": "Расскажи мне о своей проблеме, пожалуйста.",
          "source": "Tatoeba #827536 @cumori / #7166734 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/827536",
          "cefr_level": "A1",
          "word_slugs": [
            "problemen-noun"
          ]
        },
        {
          "id": "13448537",
          "text": "Ich will Ihnen von meinen Problemen erzählen.",
          "translation": "Я хочу рассказать Вам о своих проблемах.",
          "source": "Tatoeba #13448537 @Vortarulo / #13448584 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13448537",
          "cefr_level": "A1",
          "word_slugs": [
            "problemen-noun"
          ]
        },
        {
          "id": "2668067",
          "text": "Tom wollte von meinen Problemen nichts wissen.",
          "translation": "Том не хотел ничего знать о моих проблемах.",
          "source": "Tatoeba #2668067 @Pfirsichbaeumchen / #2668129 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2668067",
          "cefr_level": "A1",
          "word_slugs": [
            "problemen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
