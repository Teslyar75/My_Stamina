      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of klar:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of klar:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2430353",
          "text": "Wir benötigen eine klare Zukunftsvorstellung.",
          "translation": "Нам необходимо чёткое видение будущего.",
          "source": "Tatoeba #2430353 @al_ex_an_der / #2430349 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430353",
          "cefr_level": "A1",
          "word_slugs": [
            "klare-adj"
          ]
        },
        {
          "id": "3584336",
          "text": "Das ist eine ganz klare Sache.",
          "translation": "Это абсолютно понятная вещь.",
          "source": "Tatoeba #3584336 @brauchinet / #3586901 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584336",
          "cefr_level": "A1",
          "word_slugs": [
            "klare-adj"
          ]
        },
        {
          "id": "12733634",
          "text": "Ich bekam von ihm keine klare Antwort.",
          "translation": "Я не получил от него ясного ответа.",
          "source": "Tatoeba #12733634 @mhr / #12733641 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12733634",
          "cefr_level": "A1",
          "word_slugs": [
            "klare-adj"
          ]
        },
        {
          "id": "12733635",
          "text": "Ich bekam von ihr keine klare Antwort.",
          "translation": "Я не получил от неё ясного ответа.",
          "source": "Tatoeba #12733635 @mhr / #12733642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12733635",
          "cefr_level": "A1",
          "word_slugs": [
            "klare-adj"
          ]
        },
        {
          "id": "12733636",
          "text": "Ich habe von ihm keine klare Antwort bekommen.",
          "translation": "Я не получил от него ясного ответа.",
