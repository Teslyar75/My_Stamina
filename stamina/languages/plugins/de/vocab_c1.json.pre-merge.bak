      },
      "gender": "n",
      "examples": [
        {
          "id": "448400",
          "text": "Sein Vaterland ist Georgien.",
          "translation": "Его родина — Грузия.",
          "source": "Tatoeba #448400 @Pfirsichbaeumchen / #5237512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/448400",
          "cefr_level": "A1",
          "word_slugs": [
            "vaterland-noun"
          ]
        },
        {
          "id": "2176603",
          "text": "Brasilien ist mein Vaterland.",
          "translation": "Бразилия - моя родина.",
          "source": "Tatoeba #2176603 @Zaghawa / #4533467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2176603",
          "cefr_level": "A1",
          "word_slugs": [
            "vaterland-noun"
          ]
        },
        {
          "id": "11512176",
          "text": "Sein Vaterland ist Deutschland.",
          "translation": "Его родина - Германия.",
          "source": "Tatoeba #11512176 @Pfirsichbaeumchen / #1951132 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11512176",
          "cefr_level": "A1",
          "word_slugs": [
            "vaterland-noun"
          ]
        },
        {
          "id": "3574545",
          "text": "Wir verteidigen unser Vaterland.",
          "translation": "Мы защищаем нашу Родину.",
          "source": "Tatoeba #3574545 @al_ex_an_der / #3575089 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3574545",
          "cefr_level": "A1",
          "word_slugs": [
            "vaterland-noun"
          ]
        },
        {
          "id": "3265393",
          "text": "Unser Vaterland hat keine Zukunft.",
          "translation": "У нашей страны нет будущего.",
          "source": "Tatoeba #3265393 @Pfirsichbaeumchen / #2927610 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3265393",
          "cefr_level": "A1",
