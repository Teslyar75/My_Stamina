    {
      "slug": "armut-noun",
      "lemma": "Armut",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8195,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "poverty"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13922829",
          "text": "Er lebt in Armut.",
          "translation": "Он живёт в нищете.",
          "source": "Tatoeba #13922829 @IAlexI / #10862199 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13922829",
          "cefr_level": "A1",
          "word_slugs": [
            "armut-noun"
          ]
        },
        {
          "id": "1020183",
          "text": "Sie leben in Armut.",
          "translation": "Они живут в бедности.",
          "source": "Tatoeba #1020183 @al_ex_an_der / #2674426 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1020183",
          "cefr_level": "A1",
          "word_slugs": [
            "armut-noun"
          ]
        },
        {
          "id": "1979450",
          "text": "Ich lebte in Armut.",
          "translation": "Я жил в бедности.",
          "source": "Tatoeba #1979450 @Alois / #3668110 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1979450",
          "cefr_level": "A1",
          "word_slugs": [
            "armut-noun"
          ]
        },
        {
          "id": "758132",
          "text": "Tom wuchs in Armut auf.",
          "translation": "Том рос в бедности.",
          "source": "Tatoeba #758132 @Pfirsichbaeumchen / #1567048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/758132",
          "cefr_level": "A1",
          "word_slugs": [
            "armut-noun"
          ]
        },
        {
          "id": "2810241",
          "text": "Er schämt sich seiner Armut nicht.",
          "translation": "Он не стыдится своей бедности.",
          "source": "Tatoeba #2810241 @Pfirsichbaeumchen / #12174326 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2810241",
          "cefr_level": "A1",
          "word_slugs": [
            "armut-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
