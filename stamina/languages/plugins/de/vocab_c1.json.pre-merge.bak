    {
      "slug": "geschäften-noun",
      "lemma": "Geschäften",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9727,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Geschäft"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13013478",
          "text": "Ich bin zu den Geschäften gegangen.",
          "translation": "Я пошёл к магазинам.",
          "source": "Tatoeba #13013478 @Waldelfe / #13012775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13013478",
          "cefr_level": "A1",
          "word_slugs": [
            "geschäften-noun"
          ]
        },
        {
          "id": "1734778",
          "text": "Suchen Sie in den Geschäften Ihrer Stadt!",
          "translation": "Ищите в магазинах вашего города!",
          "source": "Tatoeba #1734778 @Balamax / #1734776 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1734778",
          "cefr_level": "A1",
          "word_slugs": [
            "geschäften-noun"
          ]
        },
        {
          "id": "6533164",
          "text": "Tom wurde müde, Mary in den Geschäften hinterherzulaufen.",
          "translation": "Том устал ходить за Марией по магазинам.",
          "source": "Tatoeba #6533164 @Espi / #6533162 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6533164",
          "cefr_level": "A1",
          "word_slugs": [
            "geschäften-noun"
          ]
        },
        {
          "id": "6151229",
          "text": "Im Monat vor Weihnachten ist in den Geschäften immer Hochbetrieb.",
          "translation": "На месяц до рождества всегда приходится пиковая нагрузка в магазинах.",
          "source": "Tatoeba #6151229 @raggione / #8365827 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6151229",
          "cefr_level": "A1",
          "word_slugs": [
            "geschäften-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
