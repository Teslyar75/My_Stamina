      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Schule"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3113538",
          "text": "Es wurden Schulen gebaut.",
          "translation": "Были построены школы.",
          "source": "Tatoeba #3113538 @pne / #5582358 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3113538",
          "cefr_level": "A1",
          "word_slugs": [
            "schulen-noun"
          ]
        },
        {
          "id": "12925501",
          "text": "Die Schulen sind geschlossen.",
          "translation": "Школы закрыты.",
          "source": "Tatoeba #12925501 @mhr / #1409545 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12925501",
          "cefr_level": "A1",
          "word_slugs": [
            "schulen-noun"
          ]
        },
        {
          "id": "9447113",
          "text": "Wir sind auf verschiedene Schulen gegangen.",
          "translation": "Мы ходили в разные школы.",
          "source": "Tatoeba #9447113 @Pfirsichbaeumchen / #9475583 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9447113",
          "cefr_level": "A1",
          "word_slugs": [
            "schulen-noun"
          ]
        },
        {
          "id": "10223996",
          "text": "Die Schulen und Universitäten sind geschlossen.",
          "translation": "Школы и университеты закрыты.",
          "source": "Tatoeba #10223996 @Pfirsichbaeumchen / #8596539 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10223996",
          "cefr_level": "A1",
          "word_slugs": [
            "schulen-noun"
          ]
        },
        {
          "id": "13341942",
          "text": "An Schulen gibt es oft viele Regeln.",
          "translation": "В школах часто много правил.",
          "source": "Tatoeba #13341942 @Waldelfe / #13341946 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13341942",
          "cefr_level": "A1",
          "word_slugs": [
            "schulen-noun"
          ]
        }
      ],
      "tags": [
