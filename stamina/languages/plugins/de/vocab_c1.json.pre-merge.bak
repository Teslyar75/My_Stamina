    {
      "slug": "angewiesen-verb",
      "lemma": "angewiesen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7410,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of anweisen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3123462",
          "text": "Europa ist auf russisches Gas angewiesen.",
          "translation": "Европа без российского газа обойтись не может.",
          "source": "Tatoeba #3123462 @al_ex_an_der / #3123460 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3123462",
          "cefr_level": "A1",
          "word_slugs": [
            "angewiesen-verb"
          ]
        },
        {
          "id": "11761732",
          "text": "Du bist nicht auf ihre Erlaubnis angewiesen.",
          "translation": "Тебе не нужно её разрешение.",
          "source": "Tatoeba #11761732 @Pfirsichbaeumchen / #7074545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11761732",
          "cefr_level": "A1",
          "word_slugs": [
            "angewiesen-verb"
          ]
        },
        {
          "id": "2768358",
          "text": "Diese Organisation ist vollständig auf freiwillige Spenden angewiesen.",
          "translation": "Эта организация полностью зависит от добровольных пожертвований.",
          "source": "Tatoeba #2768358 @Tamy / #415820 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2768358",
          "cefr_level": "A1",
          "word_slugs": [
