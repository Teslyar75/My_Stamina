    {
      "slug": "films-noun",
      "lemma": "Films",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6625,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Film"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8639032",
          "text": "Wer ist der Regisseur dieses Films?",
          "translation": "Кто режиссёр этого фильма?",
          "source": "Tatoeba #8639032 @Melang / #11511654 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8639032",
          "cefr_level": "A1",
          "word_slugs": [
            "films-noun"
          ]
        },
        {
          "id": "14046378",
          "text": "Mit gefiel nur das Ende des Films.",
          "translation": "Мне понравился только конец фильма.",
          "source": "Tatoeba #14046378 @landano / #14046381 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14046378",
          "cefr_level": "A1",
          "word_slugs": [
            "films-noun"
          ]
        },
        {
          "id": "14046380",
          "text": "Ich mochte nur das Ende des Films.",
          "translation": "Мне понравился только конец фильма.",
          "source": "Tatoeba #14046380 @landano / #14046381 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14046380",
          "cefr_level": "A1",
          "word_slugs": [
            "films-noun"
          ]
        },
        {
          "id": "13065589",
          "text": "Das Ende des Films hat mir gefallen.",
          "translation": "Мне понравилась концовка фильма.",
          "source": "Tatoeba #13065589 @Waldelfe / #13414712 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13065589",
          "cefr_level": "A1",
          "word_slugs": [
            "films-noun"
          ]
        },
        {
          "id": "10062240",
          "text": "Ich habe den Anfang des Films verpasst.",
          "translation": "Я пропустил начало фильма.",
          "source": "Tatoeba #10062240 @Melang / #7705308 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10062240",
          "cefr_level": "A1",
          "word_slugs": [
            "films-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
