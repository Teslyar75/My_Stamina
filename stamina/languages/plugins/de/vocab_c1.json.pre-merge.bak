    {
      "slug": "wärt-verb",
      "lemma": "wärt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5049,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person plural subjunctive II of sein"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3160234",
          "text": "Ihr wärt ein süßes Paar.",
          "translation": "Из вас получилась бы прекрасная пара.",
          "source": "Tatoeba #3160234 @Pfirsichbaeumchen / #8029467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3160234",
          "cefr_level": "A1",
          "word_slugs": [
            "wärt-verb"
          ]
        },
        {
          "id": "12580894",
          "text": "Ich dachte, ihr wärt im Bett.",
          "translation": "Я думал, вы в постели.",
          "source": "Tatoeba #12580894 @Waldelfe / #8936093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12580894",
          "cefr_level": "A1",
          "word_slugs": [
            "wärt-verb"
          ]
        },
        {
          "id": "12527539",
          "text": "Ich dachte, ihr wärt in Australien.",
          "translation": "Я думал, вы в Австралии.",
          "source": "Tatoeba #12527539 @Waldelfe / #8936069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12527539",
          "cefr_level": "A1",
          "word_slugs": [
            "wärt-verb"
          ]
        },
        {
          "id": "12538912",
          "text": "Ich dachte, ihr wärt meine Freunde.",
          "translation": "Я думал, вы мои друзья.",
          "source": "Tatoeba #12538912 @Waldelfe / #8936462 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12538912",
          "cefr_level": "A1",
          "word_slugs": [
            "wärt-verb"
          ]
        },
        {
          "id": "13738174",
          "text": "Wärt ihr lieber reich oder berühmt?",
          "translation": "Вы бы предпочли быть богатыми или знаменитыми?",
          "source": "Tatoeba #13738174 @Waldelfe / #13738206 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13738174",
          "cefr_level": "A1",
          "word_slugs": [
            "wärt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
