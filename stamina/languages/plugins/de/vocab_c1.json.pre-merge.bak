    {
      "slug": "ruht-verb",
      "lemma": "ruht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6695,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of ruhen:",
          "third-person singular present",
          "inflection of ruhen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12782798",
          "text": "Ruht euch ordentlich aus!",
          "translation": "Отдохните как следует.",
          "source": "Tatoeba #12782798 @mhr / #12782743 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12782798",
          "cefr_level": "A1",
          "word_slugs": [
            "ruht-verb"
          ]
        },
        {
          "id": "2517031",
          "text": "„Worauf ruht dein Blick?“ — „Auf gar nichts.“",
          "translation": "\"На что ты смотришь?\" - \"Ни на что\".",
          "source": "Tatoeba #2517031 @Pfirsichbaeumchen / #2516966 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2517031",
          "cefr_level": "A1",
          "word_slugs": [
            "ruht-verb"
          ]
        },
        {
          "id": "12205284",
          "text": "Tom ruht sich nach der Arbeit immer aus.",
          "translation": "Том всегда отдыхает после работы.",
          "source": "Tatoeba #12205284 @felix63 / #12205287 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12205284",
          "cefr_level": "A1",
          "word_slugs": [
            "ruht-verb"
          ]
        },
        {
          "id": "13679130",
          "text": "Die Arbeit am Bau ruht auch an Feiertagen nicht.",
          "translation": "Строительство не останавливается даже в праздники.",
          "source": "Tatoeba #13679130 @mhr / #13679045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13679130",
          "cefr_level": "A1",
          "word_slugs": [
            "ruht-verb"
          ]
        },
        {
          "id": "13679126",
          "text": "Die Arbeit am Bau ruht selbst an Feiertagen nicht.",
          "translation": "Строительство не останавливается даже в праздники.",
          "source": "Tatoeba #13679126 @mhr / #13679045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13679126",
          "cefr_level": "A1",
