    {
      "slug": "speziell-adj",
      "lemma": "speziell",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6819,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "особенный"
        ],
        "en": [
          "special",
          "particular, specific"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4748776",
          "text": "Du bist speziell.",
          "translation": "Ты особенный.",
          "source": "Tatoeba #4748776 @ruth_tatoeba / #2596886 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4748776",
          "cefr_level": "A1",
