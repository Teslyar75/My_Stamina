      "gender": null,
      "examples": [
        {
          "id": "2057181",
          "text": "An den Untersuchungen nahmen mehr als achttausend Menschen teil.",
          "translation": "В исследованиях приняли участие более восьми тысяч человек.",
          "source": "Tatoeba #2057181 @al_ex_an_der / #2057178 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2057181",
          "cefr_level": "A1",
          "word_slugs": [
