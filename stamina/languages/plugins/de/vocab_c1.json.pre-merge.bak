          ]
        },
        {
          "id": "12373658",
          "text": "Sie schaute gen Himmel.",
          "translation": "Она посмотрела на небо.",
          "source": "Tatoeba #12373658 @mhr / #1703288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12373658",
