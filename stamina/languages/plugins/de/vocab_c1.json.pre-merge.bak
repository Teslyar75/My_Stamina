    {
      "slug": "dergleichen-pron",
      "lemma": "dergleichen",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8500,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "such",
          "suchlike, the like"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1301251",
          "text": "Aber nichts dergleichen geschah.",
          "translation": "Но ничего подобного не случилось.",
          "source": "Tatoeba #1301251 @al_ex_an_der / #1729841 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1301251",
          "cefr_level": "A1",
          "word_slugs": [
            "dergleichen-pron"
          ]
        },
        {
          "id": "13844740",
          "text": "Ich habe nichts dergleichen gesagt.",
          "translation": "Я ничего подобного не говорил.",
          "source": "Tatoeba #13844740 @mhr / #13844646 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13844740",
          "cefr_level": "A1",
          "word_slugs": [
            "dergleichen-pron"
          ]
        },
        {
          "id": "1932133",
          "text": "Tom sagte, dass nichts dergleichen je wieder vorkäme.",
          "translation": "Том сказал, что подобное больше не повторится.",
          "source": "Tatoeba #1932133 @Pfirsichbaeumchen / #1944352 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1932133",
          "cefr_level": "A1",
          "word_slugs": [
            "dergleichen-pron"
          ]
        },
        {
          "id": "6150646",
          "text": "Ich kann mich nicht erinnern, dergleichen gesagt zu haben.",
          "translation": "Не припомню, чтобы я говорил что-то подобное.",
          "source": "Tatoeba #6150646 @Pfirsichbaeumchen / #8628863 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6150646",
          "cefr_level": "A1",
          "word_slugs": [
            "dergleichen-pron"
          ]
        }
      ],
