    {
      "slug": "schafe-noun",
      "lemma": "Schafe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5468,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Schaf (“sheep”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3584935",
          "text": "Seid ihr Schafe?",
          "translation": "Вы овцы?",
          "source": "Tatoeba #3584935 @Esperantostern / #6997967 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584935",
          "cefr_level": "A1",
          "word_slugs": [
            "schafe-noun"
          ]
        },
        {
          "id": "9545541",
          "text": "Ich habe viele Schafe.",
          "translation": "У меня много овец.",
          "source": "Tatoeba #9545541 @Yorwba / #9857621 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9545541",
          "cefr_level": "A1",
          "word_slugs": [
            "schafe-noun"
          ]
        },
        {
          "id": "8501341",
          "text": "Wir haben keine Schafe.",
          "translation": "У нас нет овец.",
          "source": "Tatoeba #8501341 @restcoser / #4592273 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8501341",
          "cefr_level": "A1",
          "word_slugs": [
            "schafe-noun"
          ]
        },
        {
          "id": "5369128",
          "text": "Die Schafe fressen Gras.",
          "translation": "Овцы едят траву.",
          "source": "Tatoeba #5369128 @Pfirsichbaeumchen / #4491620 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5369128",
          "cefr_level": "A1",
          "word_slugs": [
            "schafe-noun"
          ]
        },
        {
          "id": "1713532",
          "text": "Tom verkauft seine Schafe.",
          "translation": "Том продаёт своих овец.",
          "source": "Tatoeba #1713532 @Pfirsichbaeumchen / #2666889 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1713532",
          "cefr_level": "A1",
          "word_slugs": [
            "schafe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
