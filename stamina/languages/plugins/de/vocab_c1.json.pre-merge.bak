    {
      "slug": "fischer-noun",
      "lemma": "Fischer",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6616,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "agent noun of fischen",
          "fisher, fisherman (male or of unspecified gender)",
          "component part in various compound nouns, e.g. Amazonasfischer (“Amazon kingfisher”), Austernfischer (“oystercatcher”)",
          "component part in various compounds for different kinds of fishing boats, e.g. Grundschleppnetzfischer (“trawler”)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "12386214",
          "text": "Ich bin Fischer.",
          "translation": "Я рыбак.",
          "source": "Tatoeba #12386214 @mhr / #8814540 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12386214",
          "cefr_level": "A1",
          "word_slugs": [
            "fischer-noun"
          ]
        },
        {
          "id": "10843936",
          "text": "Tom ist Jäger und Fischer.",
          "translation": "Том — охотник и рыбак.",
          "source": "Tatoeba #10843936 @Pfirsichbaeumchen / #5461940 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10843936",
          "cefr_level": "A1",
          "word_slugs": [
            "fischer-noun"
          ]
        },
        {
          "id": "1557522",
          "text": "Er ist ein erfahrener Fischer.",
          "translation": "Он опытный рыбак.",
          "source": "Tatoeba #1557522 @jxan / #2307424 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1557522",
          "cefr_level": "A1",
          "word_slugs": [
            "fischer-noun"
          ]
        },
        {
          "id": "14058376",
          "text": "Der Fischer fing eine Forelle.",
          "translation": "Рыбак поймал форель.",
          "source": "Tatoeba #14058376 @mhr / #14058370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14058376",
          "cefr_level": "A1",
          "word_slugs": [
            "fischer-noun"
          ]
        },
        {
          "id": "14058375",
          "text": "Der Fischer hat eine Forelle gefangen.",
          "translation": "Рыбак поймал форель.",
          "source": "Tatoeba #14058375 @mhr / #14058370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14058375",
          "cefr_level": "A1",
          "word_slugs": [
            "fischer-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
