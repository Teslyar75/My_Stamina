    {
      "slug": "grau-noun",
      "lemma": "Grau",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7631,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "grey (color)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11491395",
          "text": "Ist deine Lieblingsfarbe Grau?",
          "translation": "Твой любимый цвет — серый?",
          "source": "Tatoeba #11491395 @Pfirsichbaeumchen / #11491393 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11491395",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-noun"
          ]
        },
        {
          "id": "725005",
          "text": "Herrn Grau gefiel seine Arbeit nicht.",
          "translation": "Господину Грею не нравилась его работа.",
          "source": "Tatoeba #725005 @Esperantostern / #3604529 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/725005",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-noun"
          ]
        },
        {
          "id": "2711797",
          "text": "Grau passt gut zu Rot.",
          "translation": "Серое хорошо сочетается с красным.",
          "source": "Tatoeba #2711797 @Pfirsichbaeumchen / #2711726 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2711797",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-noun"
          ]
        },
        {
          "id": "2455691",
          "text": "Grau, teurer Freund, ist alle Theorie. Und grün des Lebens goldner Baum.",
          "translation": "Теория, мой друг, суха, но зеленеет жизни древо.",
          "source": "Tatoeba #2455691 @Esperantostern / #2766324 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2455691",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
