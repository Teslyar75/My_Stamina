    {
      "slug": "vorhat-verb",
      "lemma": "vorhat",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6846,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular dependent present of vorhaben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7536455",
          "text": "Du musst Tom fragen, was er vorhat.",
          "translation": "Ты должен спросить Тома о его намерениях.",
          "source": "Tatoeba #7536455 @Pfirsichbaeumchen / #7536736 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7536455",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhat-verb"
          ]
        },
        {
          "id": "7678072",
          "text": "Tom hat uns nicht gesagt, wann er das vorhat.",
          "translation": "Том не сказал нам, когда он планирует это сделать.",
          "source": "Tatoeba #7678072 @Pfirsichbaeumchen / #7645894 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7678072",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhat-verb"
          ]
        },
        {
          "id": "7533425",
          "text": "Ich habe nicht die leiseste Ahnung, was Tom vorhat.",
          "translation": "Я не имею ни малейшего понятия о намерениях Тома.",
          "source": "Tatoeba #7533425 @Pfirsichbaeumchen / #7533989 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7533425",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhat-verb"
          ]
        },
        {
          "id": "2153185",
          "text": "Ich kann nicht glauben, dass Tom das wirklich vorhat.",
          "translation": "Не могу поверить, что Том действительно планирует это сделать.",
          "source": "Tatoeba #2153185 @Pfirsichbaeumchen / #2794898 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2153185",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhat-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
