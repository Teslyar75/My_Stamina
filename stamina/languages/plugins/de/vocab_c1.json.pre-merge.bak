    {
      "slug": "ballon-noun",
      "lemma": "Ballon",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8723,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "баллон"
        ],
        "en": [
          "balloon"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "8879362",
          "text": "Tom blies den Ballon auf.",
          "translation": "Том надул шарик.",
          "source": "Tatoeba #8879362 @Pfirsichbaeumchen / #5482483 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8879362",
          "cefr_level": "A1",
          "word_slugs": [
            "ballon-noun"
          ]
        },
        {
          "id": "1472986",
          "text": "Sie ließen einen Ballon aufsteigen.",
          "translation": "Они запустили воздушный шар.",
          "source": "Tatoeba #1472986 @al_ex_an_der / #13911953 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1472986",
          "cefr_level": "A1",
          "word_slugs": [
            "ballon-noun"
          ]
        },
        {
          "id": "757193",
          "text": "Der Ballon ist mit Luft gefüllt.",
          "translation": "Баллон наполнен воздухом.",
          "source": "Tatoeba #757193 @Pfirsichbaeumchen / #3516367 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/757193",
          "cefr_level": "A1",
          "word_slugs": [
            "ballon-noun"
          ]
        },
        {
          "id": "5076443",
          "text": "Tom füllte den Ballon mit Helium.",
          "translation": "Том наполнил шарик гелием.",
          "source": "Tatoeba #5076443 @dispy / #5107865 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5076443",
          "cefr_level": "A1",
          "word_slugs": [
            "ballon-noun"
          ]
        },
        {
          "id": "5845470",
          "text": "Tom schenkte Maria einen herzförmigen Ballon.",
          "translation": "Том подарил Мэри воздушный шарик в форме сердца.",
          "source": "Tatoeba #5845470 @Pfirsichbaeumchen / #5675488 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5845470",
          "cefr_level": "A1",
          "word_slugs": [
            "ballon-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
