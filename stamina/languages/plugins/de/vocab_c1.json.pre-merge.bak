    {
      "slug": "begrüsst-verb",
      "lemma": "begrüßt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8430,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of begrüssen:",
          "second-person singular/plural present",
          "inflection of begrüssen:",
          "third-person singular present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9701709",
          "text": "Ich habe die Gäste begrüßt.",
          "translation": "Я поздоровался с гостями.",
          "source": "Tatoeba #9701709 @Taam / #11194434 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9701709",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsst-verb"
          ]
        },
        {
          "id": "5887419",
          "text": "Warum begrüßt Tom dich nicht?",
          "translation": "Почему Том не здоровается с тобой?",
          "source": "Tatoeba #5887419 @Pfirsichbaeumchen / #5655960 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5887419",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsst-verb"
          ]
        },
        {
          "id": "8852866",
          "text": "Tom hat mich nicht einmal begrüßt.",
          "translation": "Том со мной даже не поздоровался.",
          "source": "Tatoeba #8852866 @wolfgangth / #7153522 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8852866",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsst-verb"
          ]
        },
        {
          "id": "1722748",
          "text": "Hast du das Pfirsichbäumchen je auf Deutsch begrüßt?",
          "translation": "Ты когда-нибудь здоровался с Pfirsichbäumchen на немецком?",
          "source": "Tatoeba #1722748 @Pfirsichbaeumchen / #4421493 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1722748",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsst-verb"
          ]
        },
        {
          "id": "2624446",
          "text": "Tom ging vorbei, ohne dass er uns begrüßt hätte!",
          "translation": "Том прошёл мимо, даже не поздоровавшись с нами!",
          "source": "Tatoeba #2624446 @Olya / #2624448 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2624446",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
