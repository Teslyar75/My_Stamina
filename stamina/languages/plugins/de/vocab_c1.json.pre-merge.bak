          ]
        },
        {
          "id": "13725064",
          "text": "Beide Triebwerke sind ausgefallen.",
          "translation": "Отказали оба двигателя.",
          "source": "Tatoeba #13725064 @Waldelfe / #11778244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13725064",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgefallen-verb"
          ]
        },
        {
          "id": "5017644",
          "text": "Tom ist ein Milchzahn ausgefallen.",
