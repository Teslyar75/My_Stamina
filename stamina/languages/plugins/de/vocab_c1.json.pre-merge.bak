          ]
        },
        {
          "id": "3096774",
          "text": "Bist du beschäftigt, so wie üblich?",
          "translation": "Занят, как обычно?",
          "source": "Tatoeba #3096774 @al_ex_an_der / #2311270 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3096774",
