    {
      "slug": "zufolge-prep",
      "lemma": "zufolge",
      "pos": "prep",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5089,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "according to"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3966207",
          "text": "Tom zufolge hat sich Maria selbst getötet.",
          "translation": "По словам Тома, Мэри убила сама себя.",
          "source": "Tatoeba #3966207 @Esperantostern / #4098130 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3966207",
          "cefr_level": "A1",
          "word_slugs": [
            "zufolge-prep"
          ]
        },
        {
          "id": "2352222",
          "text": "Dem Wetterbericht zufolge soll es morgen schneien.",
          "translation": "Согласно прогнозу погоды, завтра будет снег.",
          "source": "Tatoeba #2352222 @Pfirsichbaeumchen / #2039769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2352222",
          "cefr_level": "A1",
          "word_slugs": [
            "zufolge-prep"
          ]
        },
        {
          "id": "14040648",
          "text": "Der Handlung zufolge stirbt der Held am Ende.",
          "translation": "По сюжету герой в конце умирает.",
          "source": "Tatoeba #14040648 @mhr / #14040583 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14040648",
          "cefr_level": "A1",
          "word_slugs": [
            "zufolge-prep"
          ]
        },
        {
          "id": "13095450",
          "text": "Der Prognose zufolge setzt am Abend Regen ein.",
          "translation": "Согласно прогнозу, вечером начнётся дождь.",
          "source": "Tatoeba #13095450 @mhr / #13094673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13095450",
          "cefr_level": "A1",
          "word_slugs": [
            "zufolge-prep"
          ]
        },
        {
          "id": "13332710",
          "text": "Dem Wetterbericht zufolge soll es sehr heiß werden.",
          "translation": "Согласно прогнозу, будет очень жарко.",
          "source": "Tatoeba #13332710 @Waldelfe / #13332661 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13332710",
          "cefr_level": "A1",
          "word_slugs": [
            "zufolge-prep"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
