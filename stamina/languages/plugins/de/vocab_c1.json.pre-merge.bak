    {
      "slug": "verurteilen-verb",
      "lemma": "verurteilen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6443,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to convict, condemn, sentence",
          "to condemn, strongly denounce",
          "to judge, pass a moral judgment"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11223454",
          "text": "Es liegt mir fern, jemanden zu verurteilen.",
          "translation": "Я далёк от того, чтобы кого-то осуждать.",
          "source": "Tatoeba #11223454 @Pfirsichbaeumchen / #11223364 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11223454",
          "cefr_level": "A1",
          "word_slugs": [
            "verurteilen-verb"
          ]
        },
        {
          "id": "12391198",
          "text": "Wir verurteilen den Terrorismus in all seinen Formen.",
          "translation": "Мы осуждаем терроризм во всех его формах.",
          "source": "Tatoeba #12391198 @mhr / #12388227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12391198",
          "cefr_level": "A1",
          "word_slugs": [
            "verurteilen-verb"
          ]
        },
        {
          "id": "1300845",
          "text": "Das Gericht hatte nicht genügend Beweise, um ihn zu verurteilen.",
          "translation": "Суд не имел достаточных доказательств, чтобы осудить его.",
          "source": "Tatoeba #1300845 @enteka / #6922799 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1300845",
          "cefr_level": "A1",
          "word_slugs": [
            "verurteilen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
