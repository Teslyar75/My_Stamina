          ]
        },
        {
          "id": "13895620",
          "text": "Er hat das Geschenk aufgemacht.",
          "translation": "Он открыл подарок.",
          "source": "Tatoeba #13895620 @mhr / #7468618 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13895620",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgemacht-verb"
          ]
        },
        {
          "id": "13895634",
          "text": "Hast du das Fenster aufgemacht?",
          "translation": "Ты открыл окно?",
          "source": "Tatoeba #13895634 @mhr / #13319951 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13895634",
          "cefr_level": "A1",
          "word_slugs": [
