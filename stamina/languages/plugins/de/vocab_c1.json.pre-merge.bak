      "gender": null,
      "examples": [
        {
          "id": "12716669",
          "text": "Es ist dunkel. Schalte bitte die Lampe an!",
          "translation": "Темно. Включи, пожалуйста, лампу.",
          "source": "Tatoeba #12716669 @mhr / #12716654 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12716669",
          "cefr_level": "A1",
          "word_slugs": [
            "schalte-noun"
          ]
        },
        {
          "id": "6370170",
          "text": "Tom, mich friert. Schalte bitte die Heizung an!",
          "translation": "Том, я мёрзну. Включи, пожалуйста, отопление.",
          "source": "Tatoeba #6370170 @Pfirsichbaeumchen / #6370235 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6370170",
          "cefr_level": "A1",
          "word_slugs": [
            "schalte-noun"
          ]
        },
        {
          "id": "9196767",
          "text": "Schalte dein Gehirn aus!",
          "translation": "Выключи мозги.",
          "source": "Tatoeba #9196767 @Pfirsichbaeumchen / #7282743 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9196767",
          "cefr_level": "A1",
          "word_slugs": [
            "schalte-noun"
          ]
        },
        {
          "id": "12345569",
          "text": "Schalte das Telefon aus!",
          "translation": "Выключи телефон.",
          "source": "Tatoeba #12345569 @mhr / #6071591 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12345569",
          "cefr_level": "A1",
          "word_slugs": [
