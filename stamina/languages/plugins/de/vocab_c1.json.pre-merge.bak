    {
      "slug": "sprüche-noun",
      "lemma": "Sprüche",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9652,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Spruch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6839732",
          "text": "Maria gibt Sprüche von sich wie das delphische Orakel.",
          "translation": "Мария делает предсказания, как Дельфийский оракул.",
          "source": "Tatoeba #6839732 @raggione / #6840442 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6839732",
          "cefr_level": "A1",
          "word_slugs": [
            "sprüche-noun"
          ]
        },
        {
          "id": "13990867",
          "text": "Redewendungen, Sprüche und Sprichwörter können nicht wortwörtlich übersetzt werden.",
          "translation": "Фразеологические обороты, афоризмы и пословицы нельзя переводить дословно.",
          "source": "Tatoeba #13990867 @mhr / #13991202 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13990867",
          "cefr_level": "A1",
          "word_slugs": [
            "sprüche-noun"
          ]
        },
        {
          "id": "3230836",
          "text": "Es ist komisch, meine Sprüche aus dem Munde anderer zu hören.",
          "translation": "Забавно слышать свои цитаты из уст других.",
          "source": "Tatoeba #3230836 @Pfirsichbaeumchen / #3250128 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3230836",
          "cefr_level": "A1",
          "word_slugs": [
            "sprüche-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
