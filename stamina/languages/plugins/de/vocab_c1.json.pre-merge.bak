          "inflection of unglaublich:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of unglaublich:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "413894",
          "text": "Es ist eine unglaubliche Geschichte.",
          "translation": "Это невероятная история.",
          "source": "Tatoeba #413894 @MUIRIEL / #3280399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/413894",
          "cefr_level": "A1",
          "word_slugs": [
            "unglaubliche-adj"
          ]
        },
        {
          "id": "2811482",
          "text": "Er erzählte mir eine gänzlich unglaubliche Geschichte.",
          "translation": "Он рассказал мне совершенно невероятную историю.",
          "source": "Tatoeba #2811482 @al_ex_an_der / #3966856 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2811482",
          "cefr_level": "A1",
          "word_slugs": [
            "unglaubliche-adj"
          ]
        },
        {
          "id": "12899920",
          "text": "Lass dir diese unglaubliche Gelegenheit nicht entgehen!",
          "translation": "Не упусти эту невероятную возможность.",
          "source": "Tatoeba #12899920 @mhr / #12899854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12899920",
          "cefr_level": "A1",
          "word_slugs": [
            "unglaubliche-adj"
          ]
        },
        {
          "id": "12899911",
          "text": "Lasst euch diese unglaubliche Gelegenheit nicht entgehen!",
          "translation": "Не упустите эту невероятную возможность.",
          "source": "Tatoeba #12899911 @mhr / #12899859 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12899911",
          "cefr_level": "A1",
          "word_slugs": [
