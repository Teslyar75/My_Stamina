    {
      "slug": "blätter-noun",
      "lemma": "Blätter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7195,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative plural of Blatt",
          "genitive plural of Blatt",
          "accusative plural of Blatt"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6363057",
          "text": "Faultiere fressen Blätter.",
          "translation": "Ленивцы питаются листьями.",
          "source": "Tatoeba #6363057 @Pfirsichbaeumchen / #6363019 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6363057",
          "cefr_level": "A1",
          "word_slugs": [
            "blätter-noun"
          ]
        },
        {
          "id": "2397083",
          "text": "Die Blätter sind gelb.",
          "translation": "Листья жёлтые.",
          "source": "Tatoeba #2397083 @freddy1 / #4487566 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2397083",
          "cefr_level": "A1",
          "word_slugs": [
            "blätter-noun"
          ]
        },
        {
          "id": "11528467",
          "text": "Die Blätter fallen ab.",
          "translation": "Листья опадают.",
          "source": "Tatoeba #11528467 @Pfirsichbaeumchen / #11528501 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11528467",
          "cefr_level": "A1",
          "word_slugs": [
            "blätter-noun"
          ]
        },
        {
          "id": "6301592",
          "text": "Warum sind Blätter grün?",
