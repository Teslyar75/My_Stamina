    {
      "slug": "veranda-noun",
      "lemma": "Veranda",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7089,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "веранда"
        ],
        "en": [
          "veranda"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2363454",
          "text": "Lass die Kiste auf der Veranda.",
          "translation": "Оставь коробку на крыльце.",
          "source": "Tatoeba #2363454 @Espi / #5774700 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2363454",
          "cefr_level": "A1",
          "word_slugs": [
            "veranda-noun"
          ]
        },
        {
          "id": "8659220",
          "text": "Tom saß draußen auf der Veranda.",
          "translation": "Том сидел снаружи на веранде.",
          "source": "Tatoeba #8659220 @felix63 / #8680943 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8659220",
          "cefr_level": "A1",
          "word_slugs": [
            "veranda-noun"
          ]
        },
        {
          "id": "3215916",
          "text": "Ein Hund schläft auf der Veranda.",
          "translation": "Собака спит на крыльце.",
          "source": "Tatoeba #3215916 @Pfirsichbaeumchen / #3329876 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3215916",
          "cefr_level": "A1",
          "word_slugs": [
            "veranda-noun"
          ]
        },
        {
          "id": "6763410",
          "text": "Wollen wir auf der Veranda zu Abend essen?",
          "translation": "Поужинаем на веранде?",
          "source": "Tatoeba #6763410 @Pfirsichbaeumchen / #6150683 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6763410",
          "cefr_level": "A1",
          "word_slugs": [
            "veranda-noun"
          ]
        },
        {
          "id": "1894806",
          "text": "Tom saß auf der Veranda und las die Zeitung.",
          "translation": "Том сидел на веранде и читал газету.",
          "source": "Tatoeba #1894806 @Tamy / #5774702 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1894806",
          "cefr_level": "A1",
          "word_slugs": [
            "veranda-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
