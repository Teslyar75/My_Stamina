          ]
        },
        {
          "id": "971114",
          "text": "Zeichne mir ein Schaf.",
          "translation": "Нарисуй мне барашка.",
          "source": "Tatoeba #971114 @MUIRIEL / #3471546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/971114",
          "cefr_level": "A1",
          "word_slugs": [
            "schaf-noun"
          ]
        },
        {
          "id": "8108946",
          "text": "Jedes dritte Schaf ist krank.",
          "translation": "Каждая третья овца больна.",
          "source": "Tatoeba #8108946 @kutschektar / #8110351 @Takirabor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8108946",
          "cefr_level": "A1",
