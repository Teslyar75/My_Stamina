    {
      "slug": "gelegen-adj",
      "lemma": "gelegen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6338,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "situated",
          "convenient"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "9321396",
          "text": "Unser Haus ist günstig gelegen.",
          "translation": "Наш дом удобно расположен.",
          "source": "Tatoeba #9321396 @Pfirsichbaeumchen / #9408156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9321396",
          "cefr_level": "A1",
          "word_slugs": [
            "gelegen-adj"
          ]
        },
        {
          "id": "12622766",
          "text": "Das Hotel ist am Seeufer gelegen.",
          "translation": "Гостиница расположена на берегу озера.",
          "source": "Tatoeba #12622766 @mhr / #12622758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12622766",
          "cefr_level": "A1",
          "word_slugs": [
            "gelegen-adj"
          ]
        },
        {
          "id": "643893",
          "text": "Die Puppe hat auf dem Boden gelegen.",
          "translation": "Кукла лежала на полу.",
          "source": "Tatoeba #643893 @Pfirsichbaeumchen / #3268411 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/643893",
          "cefr_level": "A1",
          "word_slugs": [
            "gelegen-adj"
          ]
        },
        {
          "id": "1783317",
          "text": "Das Buch hat gestern noch da gelegen.",
          "translation": "Книга ещё вчера лежала здесь.",
          "source": "Tatoeba #1783317 @Esperantostern / #1783327 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1783317",
          "cefr_level": "A1",
          "word_slugs": [
            "gelegen-adj"
          ]
        },
        {
          "id": "1365812",
          "text": "Das Buch hat noch gestern dort gelegen.",
          "translation": "Книга ещё вчера лежала там.",
          "source": "Tatoeba #1365812 @al_ex_an_der / #6284839 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1365812",
          "cefr_level": "A1",
          "word_slugs": [
            "gelegen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
