    {
      "slug": "keks-noun",
      "lemma": "Keks",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6814,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "кекс"
        ],
        "en": [
          "cookie (US), biscuit (UK)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12176957",
          "text": "Nimm einen Keks.",
          "translation": "Возьми печенье.",
          "source": "Tatoeba #12176957 @Augustus / #5211616 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12176957",
          "cefr_level": "A1",
          "word_slugs": [
            "keks-noun"
          ]
        },
        {
          "id": "10692519",
          "text": "Gib mir einen Keks.",
          "translation": "Дай мне печенье.",
          "source": "Tatoeba #10692519 @carlosalberto / #10692522 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10692519",
          "cefr_level": "A1",
          "word_slugs": [
            "keks-noun"
          ]
        },
        {
          "id": "1314268",
          "text": "Unter dem Tisch ist ein Keks.",
          "translation": "Под столом печенье.",
          "source": "Tatoeba #1314268 @User4473 / #6386597 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1314268",
          "cefr_level": "A1",
          "word_slugs": [
            "keks-noun"
          ]
        },
        {
          "id": "2187651",
          "text": "Der Keks ist unter dem Tisch.",
          "translation": "Печенье под столом.",
          "source": "Tatoeba #2187651 @Vortarulo / #7011078 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2187651",
          "cefr_level": "A1",
          "word_slugs": [
            "keks-noun"
          ]
        },
        {
          "id": "1388418",
          "text": "Unter dem Tisch liegt ein Keks.",
          "translation": "Под столом лежит печенька.",
          "source": "Tatoeba #1388418 @al_ex_an_der / #3115933 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1388418",
          "cefr_level": "A1",
          "word_slugs": [
            "keks-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
