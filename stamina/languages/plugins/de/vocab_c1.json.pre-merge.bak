    {
      "slug": "stiess-verb",
      "lemma": "stieß",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9079,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of stossen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2109007",
          "text": "Tom stieß Maria vom Klippenrand.",
          "translation": "Том столкнул Мэри с края обрыва.",
          "source": "Tatoeba #2109007 @Pfirsichbaeumchen / #2048922 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2109007",
          "cefr_level": "A1",
          "word_slugs": [
            "stiess-verb"
          ]
        },
        {
          "id": "3472048",
          "text": "Tom stieß das Floß ins Wasser.",
          "translation": "Том столкнул плот в воду.",
          "source": "Tatoeba #3472048 @al_ex_an_der / #3470589 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3472048",
          "cefr_level": "A1",
          "word_slugs": [
            "stiess-verb"
          ]
        },
        {
          "id": "2624778",
          "text": "Peter I. stieß ein Fenster nach Europa auf.",
          "translation": "Пётр I прорубил окно в Европу.",
          "source": "Tatoeba #2624778 @Pfirsichbaeumchen / #2624765 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2624778",
          "cefr_level": "A1",
          "word_slugs": [
            "stiess-verb"
          ]
        },
        {
          "id": "2492390",
          "text": "Großmutter stieß mich zurück und stürzte zur Tür.",
          "translation": "Оттолкнув меня, бабушка бросилась к двери.",
          "source": "Tatoeba #2492390 @al_ex_an_der / #2492389 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2492390",
          "cefr_level": "A1",
          "word_slugs": [
            "stiess-verb"
          ]
        },
        {
          "id": "2625389",
          "text": "Peter der Erste stieß ein Fenster nach Europa auf.",
          "translation": "Пётр I прорубил окно в Европу.",
          "source": "Tatoeba #2625389 @Pfirsichbaeumchen / #2624765 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2625389",
          "cefr_level": "A1",
          "word_slugs": [
            "stiess-verb"
          ]
        }
      ],
