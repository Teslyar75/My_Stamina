    {
      "slug": "weisen-noun",
      "lemma": "Weisen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5339,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Weise",
          "genitive singular of Weiser",
          "accusative singular of Weiser",
          "dative plural of Weiser"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14085893",
          "text": "Die Weisen sprechen wenig.",
          "translation": "Мудрецы немногословны.",
          "source": "Tatoeba #14085893 @maaster / #14085896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14085893",
          "cefr_level": "A1",
          "word_slugs": [
            "weisen-noun"
          ]
        },
        {
          "id": "13670595",
          "text": "Die Weisen lernen aus den Fehlern Anderer.",
          "translation": "Мудрые учатся на чужих ошибках.",
          "source": "Tatoeba #13670595 @mhr / #13670600 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13670595",
          "cefr_level": "A1",
          "word_slugs": [
            "weisen-noun"
          ]
        },
        {
          "id": "2857842",
          "text": "Für den Weisen wird jeder Ort zum Vaterland.",
          "translation": "Для мудрецов любое место будет Отечеством.",
          "source": "Tatoeba #2857842 @Esperantostern / #2857919 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2857842",
          "cefr_level": "A1",
          "word_slugs": [
            "weisen-noun"
          ]
        },
        {
          "id": "3148577",
          "text": "Dieser Satz kann auf zwei Weisen verstanden werden.",
          "translation": "Это предложение можно понять двояко.",
          "source": "Tatoeba #3148577 @Pfirsichbaeumchen / #3147562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3148577",
          "cefr_level": "A1",
          "word_slugs": [
            "weisen-noun"
          ]
        },
        {
          "id": "1796494",
          "text": "Richtige Zeitplanung ist ein Rezept der Erfolgreichen; sinnvolle Zeitgestaltung eines der Weisen.",
          "translation": "Правильно планировать время - рецепт успешного человека, разумно же планировать его - мудреца.",
          "source": "Tatoeba #1796494 @Esperantostern / #2832257 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1796494",
          "cefr_level": "A1",
          "word_slugs": [
            "weisen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
