    {
      "slug": "nachfrage-noun",
      "lemma": "Nachfrage",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8595,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "спрос"
        ],
        "en": [
          "request, inquiry",
          "demand"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1000872",
          "text": "Der Preis schwankt je nach Nachfrage.",
          "translation": "Цена меняется вместе со спросом.",
          "source": "Tatoeba #1000872 @MUIRIEL / #13981401 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1000872",
          "cefr_level": "A1",
          "word_slugs": [
            "nachfrage-noun"
          ]
        },
        {
          "id": "13981547",
          "text": "Der Preis variiert je nach Nachfrage.",
          "translation": "Цена меняется вместе со спросом.",
          "source": "Tatoeba #13981547 @mhr / #13981401 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13981547",
          "cefr_level": "A1",
          "word_slugs": [
            "nachfrage-noun"
          ]
        },
        {
          "id": "10823987",
          "text": "Der Preis ändert sich entsprechend der Nachfrage.",
          "translation": "Цена меняется в соответствии со спросом.",
          "source": "Tatoeba #10823987 @toivo / #13481987 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10823987",
          "cefr_level": "A1",
          "word_slugs": [
            "nachfrage-noun"
          ]
        },
        {
          "id": "1166365",
          "text": "Der Preis ändert sich in Abhängigkeit von der Nachfrage.",
          "translation": "Цена меняется в соответствии со спросом.",
          "source": "Tatoeba #1166365 @Haehnchenpaella / #13481987 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1166365",
          "cefr_level": "A1",
          "word_slugs": [
            "nachfrage-noun"
          ]
        },
        {
          "id": "2228432",
          "text": "Es besteht in Japan keine Nachfrage nach diesem Artikel.",
          "translation": "Этот товар не пользуется спросом в Японии.",
          "source": "Tatoeba #2228432 @Pfirsichbaeumchen / #8837240 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2228432",
          "cefr_level": "A1",
          "word_slugs": [
            "nachfrage-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
