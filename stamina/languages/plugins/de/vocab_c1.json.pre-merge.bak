          ]
        },
        {
          "id": "358089",
          "text": "Verwechseln Sie nicht Österreich und Australien.",
          "translation": "Не путайте Австрию с Австралией.",
          "source": "Tatoeba #358089 @MUIRIEL / #436094 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/358089",
          "cefr_level": "A1",
          "word_slugs": [
            "verwechseln-noun"
          ]
        },
        {
          "id": "13946801",
          "text": "Verwechseln Sie einen Kometen nicht mit einem Asteroiden.",
          "translation": "Не путайте комету с астероидом.",
          "source": "Tatoeba #13946801 @mhr / #12479226 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13946801",
          "cefr_level": "A1",
          "word_slugs": [
            "verwechseln-noun"
          ]
        }
      ],
      "tags": [
