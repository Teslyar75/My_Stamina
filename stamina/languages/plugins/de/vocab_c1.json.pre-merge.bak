    {
      "slug": "fester-adj",
      "lemma": "fester",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5846,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of fest:",
          "strong/mixed nominative masculine singular",
          "inflection of fest:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3511663",
          "text": "Pappe ist fester als Papier.",
          "translation": "Картон крепче бумаги.",
          "source": "Tatoeba #3511663 @MisterTrouser / #3517625 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3511663",
          "cefr_level": "A1",
          "word_slugs": [
            "fester-adj"
          ]
        },
        {
          "id": "9936390",
          "text": "Unsere Umarmung wurde immer fester.",
          "translation": "Наши объятия становились все крепче.",
          "source": "Tatoeba #9936390 @GaryGaryGary / #4125207 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936390",
          "cefr_level": "A1",
          "word_slugs": [
            "fester-adj"
          ]
        },
        {
          "id": "1291043",
          "text": "Dies zu tun, ist mein fester Entschluss.",
          "translation": "Сделать это - моё твёрдое намерение.",
          "source": "Tatoeba #1291043 @al_ex_an_der / #12714178 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1291043",
          "cefr_level": "A1",
          "word_slugs": [
            "fester-adj"
          ]
        }
      ],
