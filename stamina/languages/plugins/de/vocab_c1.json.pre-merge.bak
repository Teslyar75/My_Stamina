    {
      "slug": "problemen-noun",
      "lemma": "Problemen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5413,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Problem"
