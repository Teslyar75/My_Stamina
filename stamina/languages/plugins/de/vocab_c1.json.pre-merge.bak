    {
      "slug": "zwecklos-adj",
      "lemma": "zwecklos",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9697,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "useless, futile"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "588701",
          "text": "Widerstand ist zwecklos.",
          "translation": "Сопротивление бесполезно.",
          "source": "Tatoeba #588701 @cost / #1971713 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/588701",
          "cefr_level": "A1",
          "word_slugs": [
            "zwecklos-adj"
          ]
        },
        {
          "id": "360784",
          "text": "Es ist zwecklos mit ihm zu streiten.",
          "translation": "С ним бесполезно спорить.",
          "source": "Tatoeba #360784 @Wolf / #2095421 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/360784",
          "cefr_level": "A1",
          "word_slugs": [
            "zwecklos-adj"
          ]
        },
        {
          "id": "12594910",
          "text": "Es ist zwecklos, sich mit einem dummen Menschen zu streiten.",
          "translation": "Спорить с глупым человеком бесполезно.",
          "source": "Tatoeba #12594910 @Waldelfe / #12594887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12594910",
          "cefr_level": "A1",
          "word_slugs": [
            "zwecklos-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der zwecklos",
        "nominative_pl": ""
      }
