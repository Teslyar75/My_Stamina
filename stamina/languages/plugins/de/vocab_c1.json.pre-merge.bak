    {
      "slug": "einsame-adj",
      "lemma": "einsame",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8224,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of einsam:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of einsam:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3030540",
          "text": "Eine einsame Birke steht auf einer weiten Ebene im Winterwind.",
          "translation": "На широкой равнине на зимнем ветру стоит одинокая берёза.",
          "source": "Tatoeba #3030540 @al_ex_an_der / #3030542 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3030540",
          "cefr_level": "A1",
          "word_slugs": [
            "einsame-adj"
          ]
        },
        {
          "id": "1648950",
          "text": "Die Galápagos-Riesenschildkröte, die als der einsame Georg bekannt war, ist tot.",
          "translation": "Умерла гигантская галапагосская черепаха, известная под именем Одинокий Джордж.",
          "source": "Tatoeba #1648950 @Pfirsichbaeumchen / #2819850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1648950",
          "cefr_level": "A1",
          "word_slugs": [
            "einsame-adj"
          ]
        }
      ],
