    {
      "slug": "georg-name",
      "lemma": "Georg",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7281,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a male given name, equivalent to English George"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11825240",
          "text": "Georg spricht vier Sprachen.",
          "translation": "Георг говорит на четырёх языках.",
          "source": "Tatoeba #11825240 @mhr / #9099460 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11825240",
          "cefr_level": "A1",
          "word_slugs": [
            "georg-name"
          ]
        },
        {
          "id": "4927813",
          "text": "Georg verheiratete sich mit meiner Schwester.",
          "translation": "Георг женился на моей сестре.",
          "source": "Tatoeba #4927813 @Esperantostern / #4933812 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4927813",
          "cefr_level": "A1",
          "word_slugs": [
            "georg-name"
          ]
        },
        {
          "id": "13646010",
          "text": "Georg der Siegreiche wird gewöhnlich zu Pferde dargestellt.",
