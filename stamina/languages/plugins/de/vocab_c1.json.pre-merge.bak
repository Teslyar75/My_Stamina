    {
      "slug": "gesammelt-verb",
      "lemma": "gesammelt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7356,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of sammeln"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13635783",
          "text": "Ich habe gute Bücher gesammelt.",
          "translation": "Я собирал хорошие книги.",
          "source": "Tatoeba #13635783 @mhr / #13635676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635783",
          "cefr_level": "A1",
          "word_slugs": [
            "gesammelt-verb"
          ]
        },
        {
          "id": "13597691",
          "text": "Ich habe früher Briefmarken gesammelt.",
          "translation": "Я раньше собирал марки.",
          "source": "Tatoeba #13597691 @Waldelfe / #8402420 @Smoky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13597691",
          "cefr_level": "A1",
          "word_slugs": [
            "gesammelt-verb"
          ]
        },
        {
          "id": "11502752",
          "text": "Tom hat als Kind Pokémon-Karten gesammelt.",
          "translation": "В детстве Том собирал карточки с покемонами.",
          "source": "Tatoeba #11502752 @Pfirsichbaeumchen / #6327208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11502752",
          "cefr_level": "A1",
          "word_slugs": [
            "gesammelt-verb"
          ]
        },
        {
          "id": "6793644",
          "text": "Haben Sie Beeren gesammelt, als Sie jung waren?",
          "translation": "Вы собирали ягоды, когда были молоды?",
          "source": "Tatoeba #6793644 @felix63 / #6793900 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6793644",
          "cefr_level": "A1",
          "word_slugs": [
