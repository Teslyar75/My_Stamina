    {
      "slug": "chinesisch-name",
      "lemma": "Chinesisch",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6071,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Chinese",
          "jargon (often used as the second element in compounds, e.g. “Patentchinesisch” is used for “patentese”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1713352",
          "text": "Ich lerne Chinesisch.",
          "translation": "Я учу китайский.",
          "source": "Tatoeba #1713352 @Pfirsichbaeumchen / #2716046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1713352",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesisch-name"
          ]
        },
        {
          "id": "3018981",
          "text": "Kannst du Chinesisch?",
          "translation": "Ты знаешь китайский?",
          "source": "Tatoeba #3018981 @pne / #3975421 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3018981",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesisch-name"
          ]
        },
        {
          "id": "11854778",
          "text": "Sie lernt Chinesisch.",
          "translation": "Она учит китайский.",
          "source": "Tatoeba #11854778 @mhr / #9930458 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11854778",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesisch-name"
          ]
        },
        {
          "id": "2222999",
