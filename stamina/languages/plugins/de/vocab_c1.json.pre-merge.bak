    {
      "slug": "gerechnet-verb",
      "lemma": "gerechnet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5690,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of rechnen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8769996",
          "text": "Damit hat Tom nicht gerechnet.",
          "translation": "Том этого не ожидал.",
          "source": "Tatoeba #8769996 @Pfirsichbaeumchen / #2481667 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8769996",
          "cefr_level": "A1",
          "word_slugs": [
            "gerechnet-verb"
          ]
        },
        {
          "id": "1982517",
          "text": "Damit hätte ich nicht gerechnet.",
          "translation": "Этого я не ожидал.",
          "source": "Tatoeba #1982517 @Alois / #2799288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1982517",
          "cefr_level": "A1",
          "word_slugs": [
            "gerechnet-verb"
          ]
        },
        {
          "id": "6760118",
          "text": "Es geschah, womit niemand gerechnet hätte.",
          "translation": "Случилось то, чего никто не ожидал.",
          "source": "Tatoeba #6760118 @Pfirsichbaeumchen / #5827602 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6760118",
          "cefr_level": "A1",
          "word_slugs": [
            "gerechnet-verb"
          ]
        },
        {
          "id": "9076192",
          "text": "Damit haben wir überhaupt nicht gerechnet.",
          "translation": "Мы этого совсем не ожидали.",
          "source": "Tatoeba #9076192 @Pfirsichbaeumchen / #9076189 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9076192",
          "cefr_level": "A1",
          "word_slugs": [
            "gerechnet-verb"
          ]
        },
        {
          "id": "2492154",
          "text": "Ich habe nie mit dieser Prämie gerechnet.",
          "translation": "Я никогда не рассчитывал на эту премию.",
          "source": "Tatoeba #2492154 @al_ex_an_der / #2492152 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2492154",
          "cefr_level": "A1",
          "word_slugs": [
            "gerechnet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
