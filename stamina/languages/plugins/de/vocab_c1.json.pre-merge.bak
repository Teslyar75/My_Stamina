    {
      "slug": "abzuholen-verb",
      "lemma": "abzuholen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6059,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of abholen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9459445",
          "text": "Tom bat mich, ihn abzuholen.",
          "translation": "Том попросил меня за ним заехать.",
          "source": "Tatoeba #9459445 @Pfirsichbaeumchen / #9459368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9459445",
          "cefr_level": "A1",
          "word_slugs": [
            "abzuholen-verb"
          ]
        },
        {
          "id": "685917",
          "text": "Vergiss nicht, mich morgen abzuholen.",
          "translation": "Не забудь завтра за мной заехать.",
          "source": "Tatoeba #685917 @MUIRIEL / #13262590 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/685917",
          "cefr_level": "A1",
          "word_slugs": [
            "abzuholen-verb"
          ]
        },
        {
          "id": "2436347",
          "text": "Unser Sohn war aus der Schule abzuholen.",
          "translation": "Надо было забрать сына из школы.",
          "source": "Tatoeba #2436347 @al_ex_an_der / #2436345 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2436347",
          "cefr_level": "A1",
          "word_slugs": [
            "abzuholen-verb"
          ]
        },
        {
          "id": "13710933",
          "text": "Ich bin gekommen, um die Kinder abzuholen.",
          "translation": "Я пришла за детьми.",
          "source": "Tatoeba #13710933 @mhr / #13710928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13710933",
          "cefr_level": "A1",
          "word_slugs": [
            "abzuholen-verb"
          ]
        },
        {
          "id": "1194476",
          "text": "Ich werde ihn darum bitten, mich vom Bahnhof abzuholen.",
          "translation": "Я попрошу его встретить меня на вокзале.",
          "source": "Tatoeba #1194476 @cumori / #9114725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1194476",
          "cefr_level": "A1",
          "word_slugs": [
            "abzuholen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
