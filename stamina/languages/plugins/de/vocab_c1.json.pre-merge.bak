          "cefr_level": "A1",
          "word_slugs": [
            "stiehlt-verb"
          ]
        },
        {
          "id": "13481018",
          "text": "Ein Dieb glaubt, jeder stiehlt.",
          "translation": "Вор думает, что все воруют.",
          "source": "Tatoeba #13481018 @Waldelfe / #13481136 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13481018",
