    {
      "slug": "zwang-noun",
      "lemma": "Zwang",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5014,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "принуждение"
        ],
        "en": [
          "compulsion, obligation, duress"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12406922",
          "text": "Ich habe das nur aus Zwang getan.",
          "translation": "Я сделал это исключительно по принуждению.",
          "source": "Tatoeba #12406922 @Waldelfe / #12407069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12406922",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-noun"
          ]
        },
        {
          "id": "6841882",
          "text": "Der Zwang befreit uns von der Qual der Wahl.",
          "translation": "Необходимость освобождает нас от мук выбора.",
          "source": "Tatoeba #6841882 @manese / #6842475 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841882",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-noun"
          ]
        },
        {
          "id": "741",
          "text": "Wenn Sie uns nicht zuhören, werden wir auf Zwang zurückgreifen müssen.",
          "translation": "Если Вы к нам не прислушаетесь, мы будем вынуждены применить насилие.",
          "source": "Tatoeba #741 @MUIRIEL / #2980249 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/741",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-noun"
          ]
        },
        {
          "id": "12735490",
          "text": "Zwang erzeugt keine Liebe.",
          "translation": "Насильно мил не будешь.",
          "source": "Tatoeba #12735490 @Bernie75 / #3207792 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12735490",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Zwang",
        "nominative_pl": ""
      }
    },
    {
      "slug": "zwang-verb",
      "lemma": "zwang",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5014,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of zwingen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7635531",
          "text": "Tom zwang mich zu gehen.",
          "translation": "Том заставил меня пойти.",
          "source": "Tatoeba #7635531 @wolfgangth / #5451046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7635531",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-verb"
          ]
        },
        {
          "id": "5321318",
          "text": "Maria zwang Tom zum Essen.",
          "translation": "Мэри заставила Тома есть.",
          "source": "Tatoeba #5321318 @Pfirsichbaeumchen / #5321328 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5321318",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-verb"
          ]
        },
        {
          "id": "7583025",
          "text": "Maria zwang sich zu lächeln.",
          "translation": "Мэри заставила себя улыбнуться.",
          "source": "Tatoeba #7583025 @raggione / #7583030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7583025",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-verb"
          ]
        },
        {
          "id": "5296636",
          "text": "Sie zwang ihn, sich hinzusetzen.",
          "translation": "Она заставила его сесть.",
          "source": "Tatoeba #5296636 @Sudajaengi / #1508454 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5296636",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-verb"
          ]
        },
        {
          "id": "7495781",
          "text": "Man zwang ihn dorthin zu gehen.",
          "translation": "Его вынудили туда пойти.",
          "source": "Tatoeba #7495781 @raggione / #7495827 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7495781",
          "cefr_level": "A1",
          "word_slugs": [
            "zwang-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
