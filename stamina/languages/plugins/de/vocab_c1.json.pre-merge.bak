    {
      "slug": "siegen-verb",
      "lemma": "siegen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6546,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "побеждать"
        ],
        "en": [
          "to be victorious, to win"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1658622",
          "text": "Ich mag siegen.",
          "translation": "Мне нравится побеждать.",
          "source": "Tatoeba #1658622 @Esperantostern / #5238041 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1658622",
          "cefr_level": "A1",
          "word_slugs": [
            "siegen-verb"
          ]
        },
        {
          "id": "1745995",
          "text": "Ich muss siegen.",
          "translation": "Я должен победить.",
          "source": "Tatoeba #1745995 @Pfirsichbaeumchen / #2843398 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1745995",
          "cefr_level": "A1",
          "word_slugs": [
            "siegen-verb"
          ]
        },
        {
          "id": "2023340",
          "text": "Ich will siegen.",
          "translation": "Я хочу победить.",
          "source": "Tatoeba #2023340 @Pfirsichbaeumchen / #4754255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2023340",
          "cefr_level": "A1",
          "word_slugs": [
            "siegen-verb"
          ]
        },
        {
          "id": "2110893",
          "text": "Wir werden siegen.",
          "translation": "Мы победим.",
          "source": "Tatoeba #2110893 @Esperantostern / #2112488 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2110893",
          "cefr_level": "A1",
          "word_slugs": [
            "siegen-verb"
          ]
        },
        {
          "id": "5114984",
          "text": "Wir können siegen.",
          "translation": "Мы можем победить.",
          "source": "Tatoeba #5114984 @al_ex_an_der / #4779769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5114984",
          "cefr_level": "A1",
          "word_slugs": [
            "siegen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
