    {
      "slug": "verdanke-verb",
      "lemma": "verdanke",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8076,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verdanken:",
          "first-person singular present",
          "inflection of verdanken:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2393855",
          "text": "Ich verdanke dir so viel.",
          "translation": "Я стольким тебе обязан.",
          "source": "Tatoeba #2393855 @brauchinet / #2529525 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2393855",
          "cefr_level": "A1",
          "word_slugs": [
            "verdanke-verb"
          ]
        },
        {
          "id": "678131",
          "text": "Meinen Erfolg verdanke ich deiner Hilfe.",
          "translation": "Своим успехом я обязана твоей помощи.",
          "source": "Tatoeba #678131 @Manfredo / #3131430 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/678131",
          "cefr_level": "A1",
          "word_slugs": [
            "verdanke-verb"
          ]
        },
        {
          "id": "1827772",
          "text": "Meinen Erfolg verdanke ich meinem Freund.",
          "translation": "Я обязан своим успехом моей подруге.",
          "source": "Tatoeba #1827772 @Tamy / #2700460 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1827772",
          "cefr_level": "A1",
          "word_slugs": [
            "verdanke-verb"
          ]
        },
        {
          "id": "421874",
          "text": "Was ich bin, verdanke ich meiner Mutter.",
          "translation": "Тем, кто я есть, я обязан своей матери.",
          "source": "Tatoeba #421874 @MUIRIEL / #8780027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/421874",
          "cefr_level": "A1",
          "word_slugs": [
            "verdanke-verb"
          ]
        },
        {
          "id": "2407698",
          "text": "Das, was ich heute bin, verdanke ich dir.",
          "translation": "За то, кем я сегодня являюсь, я благодарю тебя.",
          "source": "Tatoeba #2407698 @freddy1 / #5306221 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2407698",
          "cefr_level": "A1",
          "word_slugs": [
            "verdanke-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
