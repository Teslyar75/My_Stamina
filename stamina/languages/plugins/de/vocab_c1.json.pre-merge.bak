    {
      "slug": "aussehe-verb",
      "lemma": "aussehe",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7944,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of aussehen:",
          "first-person singular dependent present",
          "inflection of aussehen:",
          "first/third-person singular dependent subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3506226",
          "text": "Ich bin jünger, als ich aussehe.",
          "translation": "Я моложе, чем выгляжу.",
          "source": "Tatoeba #3506226 @Pfirsichbaeumchen / #3502979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3506226",
          "cefr_level": "A1",
          "word_slugs": [
            "aussehe-verb"
          ]
        },
        {
          "id": "2323631",
          "text": "Es gefällt mir nicht, wie ich aussehe.",
          "translation": "Мне не нравится, как я выгляжу.",
          "source": "Tatoeba #2323631 @Pfirsichbaeumchen / #10480352 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2323631",
          "cefr_level": "A1",
          "word_slugs": [
            "aussehe-verb"
          ]
        },
        {
          "id": "12406572",
          "text": "Ich bin nicht so jung, wie ich aussehe.",
          "translation": "Я не так молод, как выгляжу.",
          "source": "Tatoeba #12406572 @Waldelfe / #12406627 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12406572",
          "cefr_level": "A1",
          "word_slugs": [
            "aussehe-verb"
          ]
        },
        {
          "id": "5874125",
          "text": "Ich fragte ihn, warum er so traurig aussehe.",
          "translation": "Я спросил его, почему он такой грустный.",
          "source": "Tatoeba #5874125 @dasbeispielholz / #13201779 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5874125",
          "cefr_level": "A1",
          "word_slugs": [
            "aussehe-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
