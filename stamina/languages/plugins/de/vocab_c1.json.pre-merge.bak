    {
      "slug": "end-noun",
      "lemma": "end",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7143,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": "n",
      "examples": [
        {
          "id": "5562941",
          "text": "Dieser Film hat ein Happy End.",
          "translation": "Это фильм с хеппи-эндом.",
          "source": "Tatoeba #5562941 @raggione / #5563889 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5562941",
          "cefr_level": "A1",
          "word_slugs": [
            "end-noun"
          ]
        },
        {
          "id": "12393444",
          "text": "Im Leben gibt es kein Happy End.",
          "translation": "В жизни не бывает хэппи-энда.",
          "source": "Tatoeba #12393444 @mhr / #12393428 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12393444",
          "cefr_level": "A1",
          "word_slugs": [
            "end-noun"
          ]
        },
        {
          "id": "942851",
          "text": "Die meisten Hollywoodfilme haben ein Happy End.",
          "translation": "У большинства голливудских фильмов счастливый конец.",
          "source": "Tatoeba #942851 @Sudajaengi / #4933464 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/942851",
          "cefr_level": "A1",
          "word_slugs": [
            "end-noun"
          ]
        },
        {
          "id": "3297347",
          "text": "Ich mag lieber Romane mit einem Happy End.",
          "translation": "Мне больше нравятся романы с хэппи эндом.",
          "source": "Tatoeba #3297347 @raggione / #3357329 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3297347",
          "cefr_level": "A1",
          "word_slugs": [
            "end-noun"
          ]
        },
        {
          "id": "3527465",
          "text": "Alles versoffen bis ans End, macht ein richtiges Testament.",
          "translation": "Если всё имущество пропьёшь, сможешь составить отличное завещание.",
          "source": "Tatoeba #3527465 @Esperantostern / #3528711 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3527465",
          "cefr_level": "A1",
          "word_slugs": [
            "end-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
