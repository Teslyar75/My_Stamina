    {
      "slug": "gelb-adj",
      "lemma": "gelb",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5955,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "yellow",
          "related to the FDP (a libertarian and market-economy promoting political party in Germany)",
          "blond"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1426710",
          "text": "Sie sind gelb.",
          "translation": "Они жёлтые.",
          "source": "Tatoeba #1426710 @al_ex_an_der / #2013304 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1426710",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-adj"
          ]
        },
        {
          "id": "1704174",
          "text": "Blumen sind gelb.",
          "translation": "Цветы желтые.",
          "source": "Tatoeba #1704174 @Zaghawa / #2894313 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1704174",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-adj"
          ]
        },
        {
          "id": "967469",
          "text": "Eigelbe sind gelb.",
          "translation": "Яичные желтки жёлтого цвета.",
          "source": "Tatoeba #967469 @MUIRIEL / #3470680 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/967469",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-adj"
          ]
        },
        {
          "id": "2417889",
          "text": "Bananen sind gelb.",
          "translation": "Бананы жёлтые.",
          "source": "Tatoeba #2417889 @ieflicca / #1336724 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2417889",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-adj"
          ]
        },
        {
          "id": "10103450",
          "text": "Zitronen sind gelb.",
          "translation": "Лимоны жёлтые.",
          "source": "Tatoeba #10103450 @Melang / #3337883 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10103450",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
