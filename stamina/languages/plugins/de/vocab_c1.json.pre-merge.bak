          ]
        },
        {
          "id": "7453067",
          "text": "Tom wurde dreimal auf offener Straße ausgeraubt.",
          "translation": "Том был трижды ограблен на улице.",
          "source": "Tatoeba #7453067 @Pfirsichbaeumchen / #7454023 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7453067",
          "cefr_level": "A1",
