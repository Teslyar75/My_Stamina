          ]
        },
        {
          "id": "8873127",
          "text": "Tom ist ein guter Dichter.",
          "translation": "Том — хороший поэт.",
          "source": "Tatoeba #8873127 @wolfgangth / #10805936 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8873127",
