    {
      "slug": "wanne-noun",
      "lemma": "Wanne",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8062,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "ва́нна"
        ],
        "en": [
          "tub, flat-bottomed vessel",
          "for bathing or washing",
          "tub, flat-bottomed vessel",
          "for technical uses, especially to collect or hold liquids"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2720380",
          "text": "Ich bin in der Wanne.",
          "translation": "Я в ванне.",
          "source": "Tatoeba #2720380 @Pfirsichbaeumchen / #5553852 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2720380",
          "cefr_level": "A1",
          "word_slugs": [
            "wanne-noun"
          ]
        },
        {
          "id": "9958006",
          "text": "Er singt gerne in der Wanne.",
          "translation": "Ему нравится петь в ванной.",
          "source": "Tatoeba #9958006 @Pfirsichbaeumchen / #9957781 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9958006",
          "cefr_level": "A1",
          "word_slugs": [
            "wanne-noun"
          ]
        },
        {
          "id": "5589542",
          "text": "Es ist kein Wasser in der Wanne.",
          "translation": "В ванной нет воды.",
          "source": "Tatoeba #5589542 @raggione / #9005523 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5589542",
          "cefr_level": "A1",
          "word_slugs": [
            "wanne-noun"
          ]
        },
        {
          "id": "4165367",
          "text": "Tom stieg aus der Wanne und trocknete sich ab.",
          "translation": "Том вылез из ванны и вытерся.",
          "source": "Tatoeba #4165367 @Pfirsichbaeumchen / #10566751 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4165367",
          "cefr_level": "A1",
          "word_slugs": [
            "wanne-noun"
          ]
        }
      ],
