    {
      "slug": "umzugehen-verb",
      "lemma": "umzugehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8875,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of umgehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10171512",
          "text": "Tom wusste nicht mit dem Feuerlöscher umzugehen.",
          "translation": "Том не знал, как воспользоваться огнетушителем.",
          "source": "Tatoeba #10171512 @Pfirsichbaeumchen / #10171237 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10171512",
          "cefr_level": "A1",
          "word_slugs": [
            "umzugehen-verb"
          ]
        },
        {
          "id": "1661479",
          "text": "Wir suchen jemanden, der mit einem Rechner umzugehen weiß.",
          "translation": "Мы ищем кого-нибудь, кто умеет пользоваться компьютером.",
          "source": "Tatoeba #1661479 @Pfirsichbaeumchen / #634851 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1661479",
          "cefr_level": "A1",
          "word_slugs": [
            "umzugehen-verb"
          ]
        },
        {
          "id": "6294103",
          "text": "Sie hat die Kunst, mit schwierigen Kunden umzugehen, perfektioniert.",
          "translation": "Она усовершенствовала искусство обращения со сложными клиентами.",
          "source": "Tatoeba #6294103 @Naina / #6294340 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6294103",
          "cefr_level": "A1",
          "word_slugs": [
            "umzugehen-verb"
          ]
        }
      ],
