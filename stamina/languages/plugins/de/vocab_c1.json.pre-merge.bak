      "examples": [
        {
          "id": "4926402",
          "text": "Ich war in großer Verlegenheit.",
          "translation": "Я был в большом замешательстве.",
          "source": "Tatoeba #4926402 @al_ex_an_der / #5939833 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4926402",
          "cefr_level": "A1",
