    {
      "slug": "fortsetzung-noun",
      "lemma": "Fortsetzung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8859,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "продолжение"
        ],
        "en": [
          "continuation, resumption",
          "instalment"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13506572",
          "text": "Jeder Tag hat eine Fortsetzung.",
          "translation": "У каждого дня есть продолжение.",
          "source": "Tatoeba #13506572 @Waldelfe / #438575 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13506572",
          "cefr_level": "A1",
          "word_slugs": [
            "fortsetzung-noun"
          ]
        },
        {
          "id": "10843950",
          "text": "Diese Geschichte hat keine Fortsetzung.",
          "translation": "У этой истории нет продолжения.",
          "source": "Tatoeba #10843950 @Pfirsichbaeumchen / #9461061 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10843950",
          "cefr_level": "A1",
          "word_slugs": [
            "fortsetzung-noun"
          ]
        },
        {
          "id": "13644734",
          "text": "Die Fortsetzung dieser Geschichte erfahrt ihr morgen.",
          "translation": "Продолжение этой истории вы узнаете завтра.",
          "source": "Tatoeba #13644734 @mhr / #13644618 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13644734",
          "cefr_level": "A1",
          "word_slugs": [
            "fortsetzung-noun"
          ]
        },
        {
          "id": "5843366",
          "text": "Krieg ist die Fortsetzung der Politik mit anderen Mitteln.",
          "translation": "Война есть продолжение политики другими средствами.",
          "source": "Tatoeba #5843366 @Pfirsichbaeumchen / #5842634 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843366",
          "cefr_level": "A1",
          "word_slugs": [
            "fortsetzung-noun"
          ]
        },
        {
          "id": "2906991",
          "text": "Friede ist die Fortsetzung des Krieges mit anderen Mitteln.",
          "translation": "Мир - продолжение войны другими средствами.",
          "source": "Tatoeba #2906991 @Esperantostern / #2907392 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2906991",
          "cefr_level": "A1",
          "word_slugs": [
            "fortsetzung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Fortsetzung",
        "nominative_pl": ""
      }
