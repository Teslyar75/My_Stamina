      "gender": null,
      "examples": [
        {
          "id": "2936330",
          "text": "Sie trägt Ohrringe.",
          "translation": "Она носит серьги.",
          "source": "Tatoeba #2936330 @Manfredo / #5686407 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2936330",
          "cefr_level": "A1",
          "word_slugs": [
            "ohrringe-noun"
          ]
        },
        {
          "id": "3088444",
          "text": "Sind das meine Ohrringe?",
          "translation": "Это мои серёжки?",
          "source": "Tatoeba #3088444 @freddy1 / #3523386 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3088444",
          "cefr_level": "A1",
          "word_slugs": [
            "ohrringe-noun"
          ]
        },
        {
          "id": "7423175",
          "text": "Maria trägt nie Ohrringe.",
          "translation": "Мэри никогда не носит серёжки.",
          "source": "Tatoeba #7423175 @Pfirsichbaeumchen / #7423719 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7423175",
          "cefr_level": "A1",
          "word_slugs": [
            "ohrringe-noun"
          ]
        },
        {
          "id": "9153672",
          "text": "Ich habe Ohrringe gekauft.",
          "translation": "Я купил серьги.",
          "source": "Tatoeba #9153672 @nusia2302 / #9213099 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9153672",
          "cefr_level": "A1",
          "word_slugs": [
            "ohrringe-noun"
          ]
        },
        {
          "id": "4002910",
          "text": "Mir gefallen deine Ohrringe.",
          "translation": "Мне нравятся твои серёжки.",
          "source": "Tatoeba #4002910 @Pfirsichbaeumchen / #3996332 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4002910",
          "cefr_level": "A1",
