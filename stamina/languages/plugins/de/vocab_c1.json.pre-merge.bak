    {
      "slug": "gefeiert-verb",
      "lemma": "gefeiert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5917,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of feiern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13705499",
          "text": "Er hat nie Weihnachten gefeiert.",
          "translation": "Он никогда не отмечал Рождество.",
          "source": "Tatoeba #13705499 @Vortarulo / #13705500 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13705499",
          "cefr_level": "A1",
          "word_slugs": [
            "gefeiert-verb"
          ]
        },
        {
          "id": "5940078",
          "text": "Was wird in Deutschland am 3. Oktober gefeiert?",
          "translation": "Что празднуют в Германии 3 октября?",
          "source": "Tatoeba #5940078 @Pfirsichbaeumchen / #5808600 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5940078",
          "cefr_level": "A1",
          "word_slugs": [
            "gefeiert-verb"
          ]
        },
        {
          "id": "13776912",
          "text": "Der Tag der Zahl 𝜋 wird am 14. März gefeiert.",
          "translation": "День числа пи отмечается 14 марта.",
          "source": "Tatoeba #13776912 @Waldelfe / #13957264 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13776912",
          "cefr_level": "A1",
          "word_slugs": [
            "gefeiert-verb"
          ]
        },
        {
          "id": "13833031",
          "text": "Der Tag des Wissens wird am ersten September gefeiert.",
          "translation": "День знаний празднуется первого сентября.",
          "source": "Tatoeba #13833031 @mhr / #13833033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13833031",
          "cefr_level": "A1",
          "word_slugs": [
            "gefeiert-verb"
          ]
        },
        {
          "id": "13045779",
          "text": "Am 25. April wird der Tag des Kasachischen Fußballs gefeiert.",
          "translation": "Двадцать пятого апреля отмечается День казахстанского футбола.",
          "source": "Tatoeba #13045779 @mhr / #13045869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13045779",
          "cefr_level": "A1",
          "word_slugs": [
            "gefeiert-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
