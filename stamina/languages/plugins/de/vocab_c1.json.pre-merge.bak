    {
      "slug": "ratschlag-noun",
      "lemma": "Ratschlag",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9519,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
