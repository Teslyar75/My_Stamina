    {
      "slug": "perlen-noun",
      "lemma": "Perlen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8146,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Perle"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1421127",
          "text": "Wirf keine Perlen vor die Säue.",
          "translation": "Не мечи бисер перед свиньями.",
          "source": "Tatoeba #1421127 @kolonjano / #667591 @salikh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1421127",
          "cefr_level": "A1",
          "word_slugs": [
            "perlen-noun"
          ]
        },
        {
          "id": "2695727",
          "text": "Wirf keine Perlen vor die Säue!",
          "translation": "Не мечи бисер перед свиньями!",
          "source": "Tatoeba #2695727 @freddy1 / #5216362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2695727",
          "cefr_level": "A1",
          "word_slugs": [
            "perlen-noun"
          ]
        },
        {
          "id": "673961",
          "text": "Diese Perlen sind echt, nicht künstlich.",
          "translation": "Это настоящий жемчуг, а не искусственный.",
          "source": "Tatoeba #673961 @Pfirsichbaeumchen / #1954030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/673961",
          "cefr_level": "A1",
          "word_slugs": [
            "perlen-noun"
          ]
        },
        {
          "id": "664408",
          "text": "Man soll keine Perlen vor Schweine werfen.",
          "translation": "Не мечите бисер перед свиньями.",
