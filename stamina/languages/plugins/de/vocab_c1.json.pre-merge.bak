          "cefr_level": "A1",
          "word_slugs": [
            "basiert-verb"
          ]
        },
        {
          "id": "10770631",
          "text": "Seine Theorie basiert auf Tatsachen.",
          "translation": "Его теория основывается на фактах.",
          "source": "Tatoeba #10770631 @toivo / #3342950 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10770631",
          "cefr_level": "A1",
          "word_slugs": [
            "basiert-verb"
          ]
        },
        {
          "id": "1562770",
          "text": "Der Steuersatz basiert auf dem Einkommen.",
