    {
      "slug": "entwickelte-verb",
      "lemma": "entwickelte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9005,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of entwickeln:",
          "first/third-person singular preterite",
          "inflection of entwickeln:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7455637",
          "text": "Tom entwickelte Schuldgefühle.",
          "translation": "В Томе развилось чувство вины.",
          "source": "Tatoeba #7455637 @raggione / #7456004 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7455637",
          "cefr_level": "A1",
          "word_slugs": [
            "entwickelte-verb"
          ]
        },
        {
          "id": "790527",
          "text": "Darwin entwickelte die Evolutionstheorie.",
          "translation": "Дарвин развил теорию эволюции.",
          "source": "Tatoeba #790527 @Pfirsichbaeumchen / #883776 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/790527",
          "cefr_level": "A1",
          "word_slugs": [
            "entwickelte-verb"
          ]
        },
        {
          "id": "2460201",
          "text": "Das Französische entwickelte sich aus dem Latein.",
          "translation": "Французский язык развился из латыни.",
          "source": "Tatoeba #2460201 @fenris / #1601563 @mutternoise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2460201",
          "cefr_level": "A1",
          "word_slugs": [
            "entwickelte-verb"
          ]
        },
        {
          "id": "3370785",
          "text": "Ihre Freundschaft entwickelte sich langsam zu Liebe.",
          "translation": "Их дружба постепенно переросла в любовь.",
          "source": "Tatoeba #3370785 @Trinkschokolade / #3501477 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3370785",
          "cefr_level": "A1",
          "word_slugs": [
            "entwickelte-verb"
          ]
        },
        {
          "id": "2678393",
          "text": "Der Markt wuchs, und das Unternehmen entwickelte sich rasant.",
          "translation": "Рынок рос, и компания быстро развивалась.",
          "source": "Tatoeba #2678393 @al_ex_an_der / #2678392 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2678393",
          "cefr_level": "A1",
          "word_slugs": [
            "entwickelte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
