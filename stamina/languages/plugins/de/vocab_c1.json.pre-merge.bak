    {
      "slug": "schadet-verb",
      "lemma": "schadet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5845,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schaden:",
          "third-person singular present",
          "inflection of schaden:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2116178",
          "text": "Schweigen schadet selten.",
          "translation": "Молчание редко приносит вред.",
          "source": "Tatoeba #2116178 @Esperantostern / #11472794 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2116178",
          "cefr_level": "A1",
          "word_slugs": [
            "schadet-verb"
          ]
        },
        {
          "id": "6216189",
          "text": "Guter Wein schadet nie.",
          "translation": "Хорошее вино еще никому не навредило.",
          "source": "Tatoeba #6216189 @wxcraft / #7744176 @bredsky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6216189",
          "cefr_level": "A1",
          "word_slugs": [
            "schadet-verb"
          ]
        },
        {
          "id": "12201632",
          "text": "Ein Gläschen schadet nicht.",
          "translation": "Один стаканчик не повредит.",
          "source": "Tatoeba #12201632 @Pfirsichbaeumchen / #12201518 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12201632",
          "cefr_level": "A1",
          "word_slugs": [
            "schadet-verb"
          ]
        },
        {
          "id": "433323",
          "text": "Saufen schadet der Gesundheit.",
          "translation": "Пьянство вредит здоровью.",
          "source": "Tatoeba #433323 @Espi / #811646 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/433323",
          "cefr_level": "A1",
          "word_slugs": [
            "schadet-verb"
          ]
        },
        {
          "id": "445929",
          "text": "Rauchen schadet der Gesundheit.",
          "translation": "Курение вредит здоровью.",
          "source": "Tatoeba #445929 @MUIRIEL / #2510242 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/445929",
          "cefr_level": "A1",
          "word_slugs": [
            "schadet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
