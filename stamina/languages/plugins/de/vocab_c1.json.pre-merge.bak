    {
      "slug": "fragten-verb",
      "lemma": "fragten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6948,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of fragen:",
          "first/third-person plural preterite",
          "inflection of fragen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11759191",
          "text": "Wir fragten etwas.",
          "translation": "Мы кое о чём спросили.",
          "source": "Tatoeba #11759191 @mhr / #11760737 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11759191",
          "cefr_level": "A1",
          "word_slugs": [
            "fragten-verb"
          ]
        },
        {
          "id": "14027864",
          "text": "Tom fragten wir nicht.",
          "translation": "Мы Тома не спрашивали.",
          "source": "Tatoeba #14027864 @mhr / #13872127 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14027864",
          "cefr_level": "A1",
          "word_slugs": [
            "fragten-verb"
          ]
        },
        {
          "id": "761229",
          "text": "Wir fragten ihn, wie er heißt.",
          "translation": "Мы спросили у него, как его зовут.",
          "source": "Tatoeba #761229 @Dejo / #2343883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/761229",
          "cefr_level": "A1",
          "word_slugs": [
            "fragten-verb"
          ]
        },
        {
          "id": "949245",
          "text": "Sie fragten ihn nach früheren Erfahrungen.",
          "translation": "Они спросили его о предыдущем опыте.",
          "source": "Tatoeba #949245 @Sudajaengi / #8611517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/949245",
          "cefr_level": "A1",
          "word_slugs": [
            "fragten-verb"
          ]
        },
        {
          "id": "8627378",
          "text": "Sie fragten mich, ob ich ihnen helfen könne.",
          "translation": "Они спросили меня, могу ли я им помочь.",
          "source": "Tatoeba #8627378 @Melang / #7803315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8627378",
          "cefr_level": "A1",
          "word_slugs": [
            "fragten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "vortrag-noun",
      "lemma": "Vortrag",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6949,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "доклад"
        ],
        "en": [
          "talk, lecture"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3313866",
          "text": "Ihr Vortrag hat mir gefallen.",
          "translation": "Мне понравилась Ваша речь.",
          "source": "Tatoeba #3313866 @pne / #3197865 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3313866",
          "cefr_level": "A1",
          "word_slugs": [
            "vortrag-noun"
          ]
        },
        {
          "id": "3313865",
          "text": "Dein Vortrag hat mir gefallen.",
          "translation": "Мне понравилась твоя речь.",
          "source": "Tatoeba #3313865 @pne / #3197864 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3313865",
          "cefr_level": "A1",
          "word_slugs": [
            "vortrag-noun"
          ]
        },
        {
          "id": "3522227",
          "text": "Toms Vortrag war zum Einschlafen.",
          "translation": "От доклада Тома клонило в сон.",
          "source": "Tatoeba #3522227 @Pfirsichbaeumchen / #3524079 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3522227",
          "cefr_level": "A1",
          "word_slugs": [
            "vortrag-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Vortrag",
        "nominative_pl": ""
      }
    },
    {
      "slug": "amerikas-name",
      "lemma": "Amerikas",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6950,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Amerika"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "454018",
          "text": "Die Freiheitsstatue ist ein Symbol Amerikas.",
          "translation": "Статуя Свободы — символ Америки.",
          "source": "Tatoeba #454018 @Zaghawa / #895405 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454018",
          "cefr_level": "A1",
          "word_slugs": [
            "amerikas-name"
          ]
        },
        {
          "id": "13880006",
          "text": "Die Hauptstadt Russisch-Amerikas war Nowo-Archangelsk, heute Sitka.",
          "translation": "Столицей Русской Америки был Ново-Архангельск, ныне Ситка.",
          "source": "Tatoeba #13880006 @mhr / #13878931 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13880006",
          "cefr_level": "A1",
          "word_slugs": [
            "amerikas-name"
          ]
        },
        {
          "id": "13880013",
          "text": "Die Hauptstadt Russisch-Amerikas war Nowo-Archangelsk, das heutige Sitka.",
          "translation": "Столицей Русской Америки был Ново-Архангельск, ныне Ситка.",
          "source": "Tatoeba #13880013 @mhr / #13878931 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13880013",
          "cefr_level": "A1",
          "word_slugs": [
            "amerikas-name"
          ]
        },
        {
          "id": "5136604",
          "text": "Die Mission Amerikas ist es, den Kommunismus von der Welt zu tilgen.",
          "translation": "Миссия Америки - искоренить коммунизм в мире.",
          "source": "Tatoeba #5136604 @Pfirsichbaeumchen / #5136767 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5136604",
          "cefr_level": "A1",
          "word_slugs": [
            "amerikas-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
