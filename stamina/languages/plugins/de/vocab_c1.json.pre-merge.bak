      "examples": [
        {
          "id": "12944271",
          "text": "Befolgt die Regeln!",
          "translation": "Следуйте правилам.",
          "source": "Tatoeba #12944271 @mhr / #12944180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12944271",
