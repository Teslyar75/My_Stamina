        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4085808",
          "text": "Spürst du den Unterschied?",
          "translation": "Ты чувствуешь разницу?",
          "source": "Tatoeba #4085808 @Pfirsichbaeumchen / #4089324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4085808",
          "cefr_level": "A1",
          "word_slugs": [
            "spürst-verb"
          ]
        },
        {
          "id": "3777776",
          "text": "Ich spüre hier eine ungeheuer starke Energie. Spürst du sie auch?",
          "translation": "Я чувствую здесь мощную энергию. Ты чувствуешь?",
          "source": "Tatoeba #3777776 @al_ex_an_der / #3804758 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3777776",
          "cefr_level": "A1",
