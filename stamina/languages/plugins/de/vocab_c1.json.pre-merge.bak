    {
      "slug": "produziert-verb",
      "lemma": "produziert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7649,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of produzieren:",
          "third-person singular present",
          "inflection of produzieren:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2215458",
          "text": "Spanien produziert viele Apfelsinen.",
          "translation": "В Испании производится много апельсинов.",
          "source": "Tatoeba #2215458 @Zaghawa / #6325368 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2215458",
          "cefr_level": "A1",
          "word_slugs": [
            "produziert-verb"
          ]
        },
        {
          "id": "1878554",
          "text": "Die Gesellschaft produziert Elektroartikel.",
          "translation": "Компания производит электротовары.",
          "source": "Tatoeba #1878554 @samueldora / #11760546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1878554",
          "cefr_level": "A1",
          "word_slugs": [
            "produziert-verb"
          ]
        },
        {
          "id": "2112411",
          "text": "Unser Land produziert viel Zucker.",
          "translation": "В нашей стране производится много сахара.",
          "source": "Tatoeba #2112411 @kolonjano / #12672338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2112411",
          "cefr_level": "A1",
          "word_slugs": [
            "produziert-verb"
          ]
        },
        {
          "id": "2293117",
          "text": "China produziert noch zu viele Treibhausgase.",
          "translation": "Китай производит всё ещё слишком много парниковых газов.",
          "source": "Tatoeba #2293117 @al_ex_an_der / #2293138 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2293117",
          "cefr_level": "A1",
          "word_slugs": [
            "produziert-verb"
          ]
        },
        {
          "id": "10294672",
          "text": "Der Trabant wurde in Ostdeutschland produziert.",
          "translation": "Трабант производился в Восточной Германии.",
          "source": "Tatoeba #10294672 @Pfirsichbaeumchen / #10294789 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10294672",
          "cefr_level": "A1",
          "word_slugs": [
            "produziert-verb"
          ]
        }
      ],
