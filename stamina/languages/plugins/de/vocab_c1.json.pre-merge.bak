    {
      "slug": "millionär-noun",
      "lemma": "Millionär",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9990,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "миллионер"
        ],
        "en": [
          "millionaire (male or of unspecified gender)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2097580",
          "text": "Tom ist Millionär.",
          "translation": "Том миллионер.",
          "source": "Tatoeba #2097580 @Pfirsichbaeumchen / #4936690 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2097580",
          "cefr_level": "A1",
          "word_slugs": [
            "millionär-noun"
          ]
        },
        {
          "id": "13177211",
          "text": "Sie sind kein Millionär.",
          "translation": "Вы не миллионер.",
          "source": "Tatoeba #13177211 @Vortarulo / #4771607 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13177211",
          "cefr_level": "A1",
          "word_slugs": [
            "millionär-noun"
          ]
        },
        {
          "id": "5883852",
          "text": "Vom Tellerwäscher zum Millionär.",
          "translation": "Из грязи в князи.",
          "source": "Tatoeba #5883852 @xarxes / #3885690 @bijin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5883852",
          "cefr_level": "A1",
          "word_slugs": [
            "millionär-noun"
          ]
        },
        {
          "id": "2097713",
          "text": "Sie denken, ich bin Millionär.",
          "translation": "Они думают, что я миллионер.",
          "source": "Tatoeba #2097713 @Tamy / #4613241 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2097713",
          "cefr_level": "A1",
          "word_slugs": [
            "millionär-noun"
          ]
        },
        {
          "id": "2030566",
          "text": "Sie will einen Millionär heiraten.",
          "translation": "Она хочет выйти замуж за миллионера.",
          "source": "Tatoeba #2030566 @Pfirsichbaeumchen / #3885368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2030566",
          "cefr_level": "A1",
          "word_slugs": [
            "millionär-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Millionär",
        "nominative_pl": ""
      }
