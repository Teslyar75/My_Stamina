    {
      "slug": "sichere-verb",
      "lemma": "sichere",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5256,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of sichern:",
          "first-person singular present",
          "inflection of sichern:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1741160",
          "text": "Das ist eine sichere Bank.",
          "translation": "Это надёжный банк.",
          "source": "Tatoeba #1741160 @al_ex_an_der / #5657312 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1741160",
          "cefr_level": "A1",
          "word_slugs": [
            "sichere-verb"
          ]
        },
        {
          "id": "8826130",
          "text": "Ist Boston eine sichere Stadt?",
          "translation": "Бостон - безопасный город?",
          "source": "Tatoeba #8826130 @Pfirsichbaeumchen / #8826137 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8826130",
          "cefr_level": "A1",
          "word_slugs": [
            "sichere-verb"
          ]
        },
        {
          "id": "2726962",
          "text": "Tom betete für Marias sichere Rückkehr.",
          "translation": "Том молился за благополучное возвращение Мэри.",
          "source": "Tatoeba #2726962 @Pfirsichbaeumchen / #9290437 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2726962",
          "cefr_level": "A1",
          "word_slugs": [
            "sichere-verb"
          ]
        },
        {
          "id": "669610",
          "text": "Ein reines Gewissen ist das sichere Zeichen einer schlechten Erinnerung.",
          "translation": "Чистая совесть — верный признак плохой памяти.",
          "source": "Tatoeba #669610 @Esperantostern / #1992908 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/669610",
          "cefr_level": "A1",
          "word_slugs": [
            "sichere-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
