          "cefr_level": "A1",
          "word_slugs": [
            "amerikanischer-adj"
          ]
        },
        {
          "id": "2110720",
          "text": "„Wer ist Norman Finkelstein?“ – „Ein amerikanischer Politikwissenschaftler.“",
