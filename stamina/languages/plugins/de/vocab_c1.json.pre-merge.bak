    {
      "slug": "enttäuschung-noun",
      "lemma": "Enttäuschung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7628,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "разочарование"
        ],
        "en": [
          "disappointment, let-down, bummer, frustration",
          "disenchantment, disillusionment, disillusion",
          "anticlimax"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "403784",
          "text": "Ihre Enttäuschung war für alle offensichtlich.",
          "translation": "Её разочарование было очевидно всем.",
          "source": "Tatoeba #403784 @xtofu80 / #13829478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/403784",
          "cefr_level": "A1",
          "word_slugs": [
            "enttäuschung-noun"
          ]
        },
        {
          "id": "3304063",
          "text": "Zu meiner großen Enttäuschung kam sie nicht.",
          "translation": "К моему великому разочарованию, она не пришла.",
          "source": "Tatoeba #3304063 @Pfirsichbaeumchen / #13830238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3304063",
          "cefr_level": "A1",
          "word_slugs": [
            "enttäuschung-noun"
          ]
        },
        {
          "id": "14060987",
          "text": "Der Film erwies sich als große Enttäuschung.",
          "translation": "Фильм оказался большим разочарованием.",
          "source": "Tatoeba #14060987 @mhr / #14060986 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14060987",
          "cefr_level": "A1",
          "word_slugs": [
            "enttäuschung-noun"
          ]
        },
        {
          "id": "12188624",
          "text": "Er ließ sich seine Enttäuschung nicht anmerken.",
          "translation": "Он не показал своего разочарования.",
          "source": "Tatoeba #12188624 @Pfirsichbaeumchen / #13525144 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12188624",
          "cefr_level": "A1",
          "word_slugs": [
            "enttäuschung-noun"
          ]
        },
        {
          "id": "14060988",
          "text": "Der Film hat sich als große Enttäuschung erwiesen.",
          "translation": "Фильм оказался большим разочарованием.",
          "source": "Tatoeba #14060988 @mhr / #14060986 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14060988",
          "cefr_level": "A1",
          "word_slugs": [
            "enttäuschung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
