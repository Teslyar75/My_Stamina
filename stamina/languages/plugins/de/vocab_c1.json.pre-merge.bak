          ]
        },
        {
          "id": "7636874",
          "text": "Tom hat alles für dich geopfert.",
          "translation": "Том всем ради тебя пожертвовал.",
          "source": "Tatoeba #7636874 @wolfgangth / #7896637 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7636874",
          "cefr_level": "A1",
          "word_slugs": [
            "geopfert-verb"
          ]
        },
        {
          "id": "2433601",
          "text": "Ich habe viel für mein Land geopfert.",
          "translation": "Я многим пожертвовал ради своей страны.",
          "source": "Tatoeba #2433601 @Pfirsichbaeumchen / #14061838 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2433601",
          "cefr_level": "A1",
