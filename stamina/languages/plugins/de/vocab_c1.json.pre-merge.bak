      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6773,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "войти",
          "входить",
          "выбить ногами",
          "разломать ногами"
        ],
        "en": [
          "to enter, to come into",
          "to occur, to eventuate",
          "to join a club association etc. [with in (+ accusative)]",
          "to advocate, to support, to stand for, to champion [with für (+ accusative)]"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1341526",
          "text": "Darf ich eintreten?",
          "translation": "Можно войти?",
          "source": "Tatoeba #1341526 @al_ex_an_der / #844272 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1341526",
          "cefr_level": "A1",
          "word_slugs": [
            "eintreten-verb"
          ]
        },
        {
          "id": "13808835",
          "text": "Wolltest du eintreten?",
          "translation": "Ты хотела войти?",
          "source": "Tatoeba #13808835 @mhr / #12575398 @LanguagesLover (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13808835",
          "cefr_level": "A1",
          "word_slugs": [
            "eintreten-verb"
          ]
        },
        {
          "id": "13361458",
          "text": "Sie ließen uns nicht eintreten.",
          "translation": "Они не дали нам войти.",
          "source": "Tatoeba #13361458 @Naina / #12682262 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13361458",
          "cefr_level": "A1",
          "word_slugs": [
            "eintreten-verb"
          ]
        },
        {
          "id": "13808840",
          "text": "„Darf ich eintreten?“ – „Ja, natürlich.“",
          "translation": "«Можно войти?» – «Да, конечно».",
          "source": "Tatoeba #13808840 @mhr / #12297461 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13808840",
          "cefr_level": "A1",
          "word_slugs": [
            "eintreten-verb"
          ]
        },
        {
          "id": "13361457",
          "text": "Sie haben uns nicht eintreten lassen.",
          "translation": "Они не дали нам войти.",
          "source": "Tatoeba #13361457 @Naina / #12682262 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13361457",
          "cefr_level": "A1",
          "word_slugs": [
            "eintreten-verb"
          ]
        }
      ],
