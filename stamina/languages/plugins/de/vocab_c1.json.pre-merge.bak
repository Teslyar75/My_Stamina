      "gender": "m",
      "examples": [
        {
          "id": "13076796",
          "text": "Ich bin ziemlich unabhängig.",
          "translation": "Я очень независим.",
          "source": "Tatoeba #13076796 @Waldelfe / #6363112 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13076796",
          "cefr_level": "A1",
