    {
      "slug": "vorbeischauen-verb",
      "lemma": "vorbeischauen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9292,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to look past",
          "to swing by, to visit briefly (especially if not at a specific time)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1527789",
          "text": "Ich werde morgen bei ihm vorbeischauen.",
          "translation": "Я загляну к нему завтра.",
          "source": "Tatoeba #1527789 @Pfirsichbaeumchen / #2341481 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1527789",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbeischauen-verb"
          ]
        },
        {
          "id": "2997298",
          "text": "Nun ja, wir sind halt Nachbarn. Ich werde öfter mal vorbeischauen.",
          "translation": "Мы же соседи: я частенько буду заглядывать.",
          "source": "Tatoeba #2997298 @pne / #4420965 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2997298",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbeischauen-verb"
          ]
        },
        {
          "id": "1818935",
          "text": "Schön, dass Sie auf einen Sprung vorbeischauen in meiner bescheidenen Behausung!",
          "translation": "Я рад, что вы заскочили на минутку в моё скромное жилище.",
          "source": "Tatoeba #1818935 @Pfirsichbaeumchen / #4902545 @Hayabusa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1818935",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbeischauen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
