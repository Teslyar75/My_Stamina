          ]
        },
        {
          "id": "2424030",
          "text": "Ich habe eine ähnliche Erfahrung gemacht.",
          "translation": "У меня был подобный опыт.",
          "source": "Tatoeba #2424030 @al_ex_an_der / #2424024 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2424030",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnliche-adj"
          ]
        },
        {
          "id": "412305",
          "text": "Gold hat eine ähnliche Farbe wie Kupfer.",
