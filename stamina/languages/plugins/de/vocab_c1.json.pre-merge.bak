        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2880509",
          "text": "Haben Sie den Scheck schon ausgestellt?",
          "translation": "Вы уже выписали чек?",
          "source": "Tatoeba #2880509 @Dani6187 / #2763423 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2880509",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgestellt-verb"
          ]
        },
        {
          "id": "8634094",
          "text": "Im Museum sind Skulpturen aus der Antike ausgestellt.",
          "translation": "В музее выставлены античные скульптуры.",
          "source": "Tatoeba #8634094 @Melang / #8648210 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634094",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgestellt-verb"
          ]
        },
        {
          "id": "520254",
          "text": "Nach seinem Tod wurden seine Gemälde in diesem Museum ausgestellt.",
          "translation": "После его смерти его картины были выставлены в этом музее.",
          "source": "Tatoeba #520254 @MUIRIEL / #11866905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/520254",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgestellt-verb"
          ]
        }
      ],
