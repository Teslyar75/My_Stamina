    {
      "slug": "fingern-noun",
      "lemma": "Fingern",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6388,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Finger"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6952747",
          "text": "Sie schnippte mit den Fingern.",
          "translation": "Она щёлкнула пальцами.",
          "source": "Tatoeba #6952747 @Pfirsichbaeumchen / #10942618 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952747",
          "cefr_level": "A1",
          "word_slugs": [
            "fingern-noun"
          ]
        },
        {
          "id": "2815274",
          "text": "Hör auf, mit den Fingern zu knacken!",
          "translation": "Прекрати щёлкать пальцами.",
          "source": "Tatoeba #2815274 @Pfirsichbaeumchen / #5188988 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2815274",
          "cefr_level": "A1",
          "word_slugs": [
            "fingern-noun"
          ]
        },
        {
          "id": "1881387",
          "text": "Er fuhr mit den Fingern durch ihr Haar.",
          "translation": "Он провёл пальцами по её волосам.",
          "source": "Tatoeba #1881387 @Pfirsichbaeumchen / #12725465 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1881387",
          "cefr_level": "A1",
          "word_slugs": [
            "fingern-noun"
          ]
        },
        {
          "id": "2261612",
          "text": "Er kann mit seinen Fingern bis zehn zählen.",
          "translation": "Он может сосчитать на пальцах до десяти.",
          "source": "Tatoeba #2261612 @Pfirsichbaeumchen / #2262977 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2261612",
          "cefr_level": "A1",
          "word_slugs": [
            "fingern-noun"
          ]
        },
        {
          "id": "3534716",
          "text": "Ich sehe an euren Fingern, dass ihr raucht.",
          "translation": "Я по вашим пальцам вижу, что вы курите.",
          "source": "Tatoeba #3534716 @Pfirsichbaeumchen / #3534445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3534716",
          "cefr_level": "A1",
          "word_slugs": [
            "fingern-noun"
          ]
        }
      ],
