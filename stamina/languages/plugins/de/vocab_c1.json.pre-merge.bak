    {
      "slug": "verbrachte-verb",
      "lemma": "verbrachte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5458,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of verbringen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8726975",
          "text": "Sie verbrachte Weihnachten ganz allein.",
          "translation": "Она провела Рождество в одиночестве.",
          "source": "Tatoeba #8726975 @Melang / #10488693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8726975",
          "cefr_level": "A1",
          "word_slugs": [
            "verbrachte-verb"
          ]
        },
        {
          "id": "12738234",
          "text": "Er verbrachte die Nacht bei uns.",
          "translation": "Он провёл у нас ночь.",
          "source": "Tatoeba #12738234 @Waldelfe / #12738183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12738234",
          "cefr_level": "A1",
          "word_slugs": [
            "verbrachte-verb"
          ]
        },
        {
          "id": "622884",
          "text": "Er verbrachte den Abend mit Lesen.",
          "translation": "Он провел вечер за чтением.",
          "source": "Tatoeba #622884 @MUIRIEL / #1753361 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/622884",
          "cefr_level": "A1",
          "word_slugs": [
            "verbrachte-verb"
          ]
        },
        {
          "id": "1079958",
          "text": "Er verbrachte die Nacht im Karzer.",
          "translation": "Он провёл ночь в карцере.",
          "source": "Tatoeba #1079958 @Esperantostern / #5909440 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1079958",
          "cefr_level": "A1",
          "word_slugs": [
            "verbrachte-verb"
          ]
        },
        {
          "id": "4259966",
          "text": "Er verbrachte viel Zeit mit Lesen.",
          "translation": "Он провёл много времени за чтением.",
          "source": "Tatoeba #4259966 @Pfirsichbaeumchen / #5487147 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4259966",
          "cefr_level": "A1",
          "word_slugs": [
            "verbrachte-verb"
          ]
        }
