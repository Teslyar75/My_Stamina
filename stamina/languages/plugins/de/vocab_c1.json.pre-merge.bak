      "gender": "m",
      "examples": [
        {
          "id": "1945691",
          "text": "Diese Programme wurden sehr professionell auf einer ausgezeichneten methodischen Grundlage aufgebaut.",
          "translation": "Эти программы были разработаны очень профессионально, на отличной методологической базе.",
          "source": "Tatoeba #1945691 @al_ex_an_der / #1945682 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1945691",
          "cefr_level": "A1",
          "word_slugs": [
            "professionell-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
