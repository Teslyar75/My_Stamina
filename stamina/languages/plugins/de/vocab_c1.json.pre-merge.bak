          "source": "Tatoeba #840713 @samueldora / #637512 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/840713",
          "cefr_level": "A1",
          "word_slugs": [
            "ländern-noun"
          ]
        },
        {
          "id": "8597451",
          "text": "Sie kamen aus verschiedenen Ländern.",
          "translation": "Они приезжали из разных стран.",
          "source": "Tatoeba #8597451 @felix63 / #8602286 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8597451",
          "cefr_level": "A1",
          "word_slugs": [
            "ländern-noun"
          ]
        },
        {
          "id": "2442269",
          "text": "Apfelsinen wachsen in warmen Ländern.",
          "translation": "Апельсины растут в тёплых краях.",
          "source": "Tatoeba #2442269 @Pfirsichbaeumchen / #637512 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2442269",
          "cefr_level": "A1",
          "word_slugs": [
            "ländern-noun"
          ]
        }
      ],
