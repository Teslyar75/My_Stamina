          ]
        },
        {
          "id": "3584641",
          "text": "Wer wird das Land regieren?",
          "translation": "Кто будет управлять этой страной?",
          "source": "Tatoeba #3584641 @al_ex_an_der / #3586401 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584641",
          "cefr_level": "A1",
          "word_slugs": [
