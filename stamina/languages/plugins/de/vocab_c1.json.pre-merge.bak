    {
      "slug": "venus-name",
      "lemma": "Venus",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9506,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Venus",
          "Venus"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4506246",
          "text": "Die Venus ist ein Planet.",
          "translation": "Венера - это планета.",
          "source": "Tatoeba #4506246 @Esperantostern / #6389634 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4506246",
          "cefr_level": "A1",
          "word_slugs": [
            "venus-name"
          ]
        },
        {
          "id": "3135525",
          "text": "Die Venus hat keinen Mond.",
          "translation": "У Венеры нет луны.",
          "source": "Tatoeba #3135525 @Pfirsichbaeumchen / #1922263 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3135525",
          "cefr_level": "A1",
          "word_slugs": [
            "venus-name"
          ]
        },
        {
          "id": "4846443",
          "text": "Die Venus hat keine Monde.",
          "translation": "У Венеры нет спутников.",
          "source": "Tatoeba #4846443 @giftschatz / #5322749 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4846443",
          "cefr_level": "A1",
          "word_slugs": [
            "venus-name"
          ]
        },
        {
          "id": "13810812",
          "text": "Auf der Venus gibt es Vulkane.",
          "translation": "На Венере есть вулканы.",
          "source": "Tatoeba #13810812 @mhr / #13810665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13810812",
          "cefr_level": "A1",
          "word_slugs": [
            "venus-name"
          ]
        },
        {
          "id": "13856247",
          "text": "Venus ist kein Stern, sondern ein Planet.",
          "translation": "Венера не звезда, а планета.",
          "source": "Tatoeba #13856247 @Ioan_Cristian / #13858219 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13856247",
          "cefr_level": "A1",
          "word_slugs": [
            "venus-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
