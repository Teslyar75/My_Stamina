    {
      "slug": "schrecken-noun",
      "lemma": "Schrecken",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5828,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Schrecke"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1843697",
          "text": "Sie ist mit dem Schrecken davongekommen.",
          "translation": "Она отделалась испугом.",
          "source": "Tatoeba #1843697 @al_ex_an_der / #1843682 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1843697",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecken-noun"
          ]
        },
        {
          "id": "12786577",
          "text": "Du hast mir einen ganz schönen Schrecken eingejagt.",
          "translation": "Ты изрядно напугала меня.",
          "source": "Tatoeba #12786577 @mhr / #12785063 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12786577",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecken-noun"
          ]
        },
        {
          "id": "2265219",
          "text": "Lieber ein Ende mit Schrecken als ein Schrecken ohne Ende.",
          "translation": "Лучше ужасный конец, чем бесконечный ужас.",
          "source": "Tatoeba #2265219 @krevedko / #2265215 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2265219",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecken-noun"
          ]
        },
        {
          "id": "1215678",
          "text": "Lieber ein Ende mit Schrecken, als ein Schrecken ohne Ende.",
          "translation": "Лучше ужасный конец, чем ужас без конца.",
          "source": "Tatoeba #1215678 @PeterR / #2665825 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1215678",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecken-noun"
          ]
        },
        {
          "id": "1360131",
          "text": "Meine Tante, die alte Labertasche, ist der Schrecken jeder Familienfeier.",
          "translation": "Моя тётя, старая кошёлка - кошмар любого семейного праздника.",
          "source": "Tatoeba #1360131 @PeterR / #7534137 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1360131",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecken-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
