    {
      "slug": "wahres-adj",
      "lemma": "wahres",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5088,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of wahr"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1870238",
          "text": "Da ist was Wahres dran.",
          "translation": "В этом есть доля правды.",
          "source": "Tatoeba #1870238 @Pfirsichbaeumchen / #3478106 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1870238",
          "cefr_level": "A1",
          "word_slugs": [
            "wahres-adj"
          ]
        },
        {
          "id": "841027",
          "text": "Da ist etwas Wahres dran.",
          "translation": "Там есть определенная доля правды.",
          "source": "Tatoeba #841027 @Lucky73 / #470352 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/841027",
          "cefr_level": "A1",
          "word_slugs": [
            "wahres-adj"
          ]
        },
        {
          "id": "3692784",
          "text": "Sie durchlebte ein wahres Drama.",
          "translation": "Она пережила настоящую драму.",
          "source": "Tatoeba #3692784 @al_ex_an_der / #3692776 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3692784",
          "cefr_level": "A1",
          "word_slugs": [
            "wahres-adj"
          ]
        },
        {
          "id": "2655122",
          "text": "Endlich zeigte er sein wahres Gesicht.",
          "translation": "Он наконец показал своё истинное лицо.",
          "source": "Tatoeba #2655122 @Pfirsichbaeumchen / #12029437 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2655122",
          "cefr_level": "A1",
          "word_slugs": [
            "wahres-adj"
          ]
        },
        {
          "id": "10049010",
          "text": "Er hat endlich sein wahres Gesicht gezeigt.",
          "translation": "Он наконец показал своё истинное лицо.",
          "source": "Tatoeba #10049010 @wolfgangth / #12029437 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10049010",
          "cefr_level": "A1",
          "word_slugs": [
            "wahres-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
