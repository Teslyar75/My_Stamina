          ]
        },
        {
          "id": "1350334",
          "text": "Sie sind eine kleine Lügnerin.",
          "translation": "Вы мелкая лгунья.",
          "source": "Tatoeba #1350334 @Manfredo / #6480600 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1350334",
          "cefr_level": "A1",
