    {
      "slug": "hochzeiten-noun",
      "lemma": "Hochzeiten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9660,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Hochzeit"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2674478",
          "text": "Ich liebe Hochzeiten.",
          "translation": "Я люблю свадьбы.",
          "source": "Tatoeba #2674478 @Pfirsichbaeumchen / #3197013 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2674478",
          "cefr_level": "A1",
          "word_slugs": [
            "hochzeiten-noun"
          ]
        },
        {
          "id": "2739308",
          "text": "Tom war auf allen meinen drei Hochzeiten.",
          "translation": "Том был на всех трёх моих свадьбах.",
          "source": "Tatoeba #2739308 @Pfirsichbaeumchen / #7984650 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2739308",
          "cefr_level": "A1",
          "word_slugs": [
            "hochzeiten-noun"
          ]
        },
        {
          "id": "1294892",
          "text": "Man kann nicht auf zwei Hochzeiten tanzen.",
          "translation": "Нельзя усидеть на двух стульях.",
          "source": "Tatoeba #1294892 @enteka / #13617950 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1294892",
          "cefr_level": "A1",
          "word_slugs": [
            "hochzeiten-noun"
          ]
        },
        {
          "id": "3995885",
          "text": "Hochzeiten sind teuer.",
          "translation": "Свадьбы дорогие.",
          "source": "Tatoeba #3995885 @Esperantostern / #3252853 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3995885",
          "cefr_level": "A1",
          "word_slugs": [
            "hochzeiten-noun"
          ]
        }
      ],
