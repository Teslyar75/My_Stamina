      "examples": [
        {
          "id": "13708229",
          "text": "Sind Viren Lebewesen?",
          "translation": "Вирусы — живые существа?",
          "source": "Tatoeba #13708229 @rul / #13704716 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13708229",
          "cefr_level": "A1",
          "word_slugs": [
            "lebewesen-noun"
          ]
        },
        {
          "id": "12855629",
          "text": "Alle Lebewesen sterben irgendwann.",
          "translation": "Всё живое когда-нибудь умрёт.",
          "source": "Tatoeba #12855629 @mhr / #12855335 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12855629",
          "cefr_level": "A1",
          "word_slugs": [
            "lebewesen-noun"
          ]
        },
        {
          "id": "12855628",
          "text": "Alle Lebewesen werden irgendwann sterben.",
          "translation": "Всё живое когда-нибудь умрёт.",
          "source": "Tatoeba #12855628 @mhr / #12855335 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12855628",
          "cefr_level": "A1",
          "word_slugs": [
            "lebewesen-noun"
          ]
        },
        {
          "id": "1269364",
          "text": "Tiere, Pflanzen und Mikroben, alle sind Lebewesen.",
          "translation": "Животные, растения и микроорганизмы - это всё живые существа.",
          "source": "Tatoeba #1269364 @BraveSentry / #3570524 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1269364",
          "cefr_level": "A1",
          "word_slugs": [
            "lebewesen-noun"
          ]
        },
        {
          "id": "2124175",
          "text": "Das einzige Lebewesen, das lachen kann, ist der Mensch.",
          "translation": "Единственное животное, что умеет смеяться, - это человек.",
          "source": "Tatoeba #2124175 @al_ex_an_der / #2117894 @Elenkina (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2124175",
          "cefr_level": "A1",
          "word_slugs": [
            "lebewesen-noun"
          ]
        }
      ],
