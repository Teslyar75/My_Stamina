    {
      "slug": "jenem-pron",
      "lemma": "jenem",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5392,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative masculine singular of jener",
          "dative neuter singular of jener"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12939479",
          "text": "Ich war in jenem Bus.",
          "translation": "Я был в том автобусе.",
          "source": "Tatoeba #12939479 @Naina / #5914990 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12939479",
          "cefr_level": "A1",
          "word_slugs": [
            "jenem-pron"
          ]
        },
        {
          "id": "4916867",
          "text": "Es regnete an jenem Tag.",
          "translation": "В тот день шёл дождь.",
          "source": "Tatoeba #4916867 @Pfirsichbaeumchen / #4483583 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4916867",
          "cefr_level": "A1",
          "word_slugs": [
            "jenem-pron"
          ]
        },
        {
          "id": "11700100",
          "text": "An jenem Tag regnete es.",
          "translation": "В тот день шёл дождь.",
          "source": "Tatoeba #11700100 @mhr / #4483583 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11700100",
          "cefr_level": "A1",
          "word_slugs": [
            "jenem-pron"
          ]
        },
        {
          "id": "4489190",
          "text": "Es schneite an jenem Tag.",
          "translation": "В тот день шёл снег.",
          "source": "Tatoeba #4489190 @Pfirsichbaeumchen / #4483582 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4489190",
          "cefr_level": "A1",
          "word_slugs": [
            "jenem-pron"
          ]
        },
        {
          "id": "367872",
          "text": "Er arbeitet in jenem Labor.",
          "translation": "Он работает в лаборатории.",
          "source": "Tatoeba #367872 @xtofu80 / #2284057 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/367872",
          "cefr_level": "A1",
          "word_slugs": [
            "jenem-pron"
          ]
        }
