    {
      "slug": "us-noun",
      "lemma": "us",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5644,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of u"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12888434",
          "text": "Sind Sie US-Bürger?",
          "translation": "Вы граждане США?",
          "source": "Tatoeba #12888434 @Waldelfe / #9957589 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12888434",
          "cefr_level": "A1",
          "word_slugs": [
            "us-noun"
          ]
        },
        {
          "id": "13616220",
          "text": "Kanadier sind keine US-Amerikaner!",
          "translation": "Канадцы - это не американцы!",
          "source": "Tatoeba #13616220 @mhr / #13616196 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13616220",
          "cefr_level": "A1",
          "word_slugs": [
            "us-noun"
          ]
        },
        {
          "id": "13442947",
          "text": "Wie viele US-Bundesstaaten könnt ihr nennen?",
          "translation": "Сколько штатов США вы можете назвать?",
          "source": "Tatoeba #13442947 @mhr / #13442874 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13442947",
          "cefr_level": "A1",
          "word_slugs": [
            "us-noun"
          ]
        },
        {
          "id": "13442949",
          "text": "Wie viele US-Bundesstaaten kannst du nennen?",
          "translation": "Сколько штатов США ты можешь назвать?",
          "source": "Tatoeba #13442949 @mhr / #13442873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13442949",
          "cefr_level": "A1",
          "word_slugs": [
            "us-noun"
          ]
        },
        {
          "id": "13516109",
          "text": "Sie ist US-Amerikanerin, lebt aber in Großbritannien.",
          "translation": "Она американка из США, но живёт в Великобритании.",
          "source": "Tatoeba #13516109 @mhr / #13516039 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13516109",
          "cefr_level": "A1",
          "word_slugs": [
            "us-noun"
          ]
        }
      ],
