    {
      "slug": "persönlichkeit-noun",
      "lemma": "Persönlichkeit",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5158,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "личность"
        ],
        "en": [
          "personality",
          "personage"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "7636814",
          "text": "Tom hat eine starke Persönlichkeit.",
          "translation": "Том – сильная личность.",
          "source": "Tatoeba #7636814 @wolfgangth / #9946808 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7636814",
          "cefr_level": "A1",
          "word_slugs": [
            "persönlichkeit-noun"
          ]
        },
        {
          "id": "2806176",
          "text": "Er hat eine gespaltene Persönlichkeit.",
          "translation": "У него раздвоение личности.",
          "source": "Tatoeba #2806176 @Pfirsichbaeumchen / #351715 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2806176",
          "cefr_level": "A1",
          "word_slugs": [
            "persönlichkeit-noun"
          ]
        },
        {
          "id": "9353281",
          "text": "Sie ist eine sehr berühmte Persönlichkeit.",
          "translation": "Она очень известная личность.",
          "source": "Tatoeba #9353281 @Pfirsichbaeumchen / #9506952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9353281",
          "cefr_level": "A1",
          "word_slugs": [
            "persönlichkeit-noun"
          ]
        },
        {
          "id": "2711822",
          "text": "Ich halte Tom für keine herausragende Persönlichkeit.",
          "translation": "Я не считаю Тома великим человеком.",
          "source": "Tatoeba #2711822 @Pfirsichbaeumchen / #2711648 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2711822",
          "cefr_level": "A1",
          "word_slugs": [
            "persönlichkeit-noun"
          ]
        },
        {
          "id": "5347863",
          "text": "Hat sie eine gespaltene Persönlichkeit oder tut sie nur so?",
          "translation": "У нее раздвоение личности или она притворяется?",
          "source": "Tatoeba #5347863 @Pfirsichbaeumchen / #5346479 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5347863",
          "cefr_level": "A1",
          "word_slugs": [
            "persönlichkeit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Persönlichkeit",
        "nominative_pl": ""
      }
    },
