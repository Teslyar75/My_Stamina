          "source": "Tatoeba #8594758 @Pfirsichbaeumchen / #8596189 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8594758",
          "cefr_level": "A1",
          "word_slugs": [
            "braunen-adj"
          ]
        },
        {
          "id": "13341941",
          "text": "Ich habe keine braunen Augen.",
          "translation": "У меня не карие глаза.",
          "source": "Tatoeba #13341941 @Waldelfe / #9004447 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13341941",
          "cefr_level": "A1",
          "word_slugs": [
            "braunen-adj"
          ]
        },
        {
          "id": "8804742",
          "text": "Tom trägt einen braunen Mantel.",
          "translation": "Том в коричневом пальто.",
          "source": "Tatoeba #8804742 @Melang / #11566434 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8804742",
