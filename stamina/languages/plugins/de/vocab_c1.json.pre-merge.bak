    {
      "slug": "warme-adj",
      "lemma": "warme",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7048,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of warm:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of warm:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12175375",
          "text": "Ich trage warme Socken.",
          "translation": "Я в тёплых носках.",
          "source": "Tatoeba #12175375 @Pfirsichbaeumchen / #5914187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12175375",
          "cefr_level": "A1",
          "word_slugs": [
            "warme-adj"
          ]
        },
        {
          "id": "13865095",
          "text": "Tom trug warme Kleidung.",
          "translation": "Том был в тёплой одежде.",
          "source": "Tatoeba #13865095 @mhr / #13865117 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13865095",
          "cefr_level": "A1",
          "word_slugs": [
            "warme-adj"
          ]
        },
        {
          "id": "6974078",
          "text": "Nehmt warme Kleidung mit!",
          "translation": "Возьмите с собой тёплую одежду.",
          "source": "Tatoeba #6974078 @manese / #12326607 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6974078",
          "cefr_level": "A1",
          "word_slugs": [
            "warme-adj"
          ]
        },
        {
          "id": "352087",
          "text": "Ich mag warme Winter nicht.",
          "translation": "Я не люблю тёплые зимы.",
          "source": "Tatoeba #352087 @lilygilder / #2204948 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/352087",
          "cefr_level": "A1",
          "word_slugs": [
            "warme-adj"
          ]
        },
        {
          "id": "11700126",
          "text": "Hast du warme Kleidung dabei?",
          "translation": "Ты взял тёплую одежду?",
          "source": "Tatoeba #11700126 @Pfirsichbaeumchen / #9034704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11700126",
          "cefr_level": "A1",
          "word_slugs": [
            "warme-adj"
          ]
        }
      ],
