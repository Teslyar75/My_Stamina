      "examples": [
        {
          "id": "11469098",
          "text": "Khmer ist die offizielle Sprache Kambodschas.",
          "translation": "Кхмерский язык является официальным языком Камбоджи.",
          "source": "Tatoeba #11469098 @Adelpa / #11468971 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11469098",
          "cefr_level": "A1",
          "word_slugs": [
            "offizielle-adj"
          ]
        },
        {
          "id": "9946293",
          "text": "Thai ist die offizielle Landessprache Thailands.",
          "translation": "Тайский является официальным языком Таиланда.",
          "source": "Tatoeba #9946293 @Adelpa / #480098 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9946293",
          "cefr_level": "A1",
          "word_slugs": [
            "offizielle-adj"
          ]
        },
        {
          "id": "11505837",
          "text": "Du brauchst keine offizielle Rede vorzubereiten.",
          "translation": "Тебе не нужно готовить официальную речь.",
          "source": "Tatoeba #11505837 @Pfirsichbaeumchen / #2426043 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11505837",
          "cefr_level": "A1",
          "word_slugs": [
            "offizielle-adj"
          ]
        },
        {
          "id": "11820977",
          "text": "Deutsch ist die offizielle Sprache Deutschlands.",
          "translation": "Немецкий - официальный язык Германии.",
          "source": "Tatoeba #11820977 @Adelpa / #11820997 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11820977",
          "cefr_level": "A1",
          "word_slugs": [
            "offizielle-adj"
          ]
        },
        {
          "id": "13496021",
          "text": "Man muss eine offizielle Genehmigung einzuholen.",
          "translation": "Нужно получить официальное разрешение.",
          "source": "Tatoeba #13496021 @mhr / #13496008 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13496021",
          "cefr_level": "A1",
          "word_slugs": [
            "offizielle-adj"
          ]
        }
      ],
      "tags": [
