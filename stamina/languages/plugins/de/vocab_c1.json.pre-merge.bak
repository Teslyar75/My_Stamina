          ]
        },
        {
          "id": "662237",
          "text": "Der Mond ist hinter den Wolken unsichtbar.",
          "translation": "Луна не видна за тучами.",
          "source": "Tatoeba #662237 @stefz / #2903097 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/662237",
          "cefr_level": "A1",
