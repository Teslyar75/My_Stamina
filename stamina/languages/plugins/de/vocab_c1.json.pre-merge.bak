    {
      "slug": "freust-verb",
      "lemma": "freust",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5648,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of freuen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2202522",
          "text": "Worüber freust du dich so?",
          "translation": "Чему ты так радуешься?",
          "source": "Tatoeba #2202522 @Pfirsichbaeumchen / #710071 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2202522",
          "cefr_level": "A1",
          "word_slugs": [
            "freust-verb"
          ]
        },
        {
          "id": "2229356",
          "text": "Ich freue mich, dass du dich freust.",
          "translation": "Я рад, что ты рад.",
          "source": "Tatoeba #2229356 @Pfirsichbaeumchen / #2222644 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2229356",
          "cefr_level": "A1",
          "word_slugs": [
            "freust-verb"
          ]
        },
        {
          "id": "5984213",
          "text": "Du bekommst ein Brüderchen. Freust du dich?",
          "translation": "У тебя будет братик. Ты рада?",
          "source": "Tatoeba #5984213 @Pfirsichbaeumchen / #5814113 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5984213",
          "cefr_level": "A1",
          "word_slugs": [
            "freust-verb"
          ]
        },
        {
          "id": "6733386",
          "text": "Freust du dich, nach Deutschland zu fahren?",
          "translation": "Ты рад, что едешь в Германию?",
          "source": "Tatoeba #6733386 @felix63 / #6736851 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6733386",
          "cefr_level": "A1",
          "word_slugs": [
            "freust-verb"
          ]
        },
        {
          "id": "5896960",
          "text": "Du bekommst ein Schwesterchen. Freust du dich?",
          "translation": "У тебя будет сестричка. Ты рада?",
          "source": "Tatoeba #5896960 @Pfirsichbaeumchen / #5814114 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5896960",
          "cefr_level": "A1",
          "word_slugs": [
            "freust-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "hinsicht-noun",
      "lemma": "Hinsicht",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5649,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "regard, aspect, respect, viewpoint",
          "concern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4133407",
          "text": "Sie ist in jeder Hinsicht perfekt.",
          "translation": "Она совершенна во всех отношениях.",
          "source": "Tatoeba #4133407 @raggione / #4134796 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4133407",
          "cefr_level": "A1",
          "word_slugs": [
            "hinsicht-noun"
          ]
        },
        {
          "id": "2632954",
          "text": "Ich habe mich in der Hinsicht geirrt.",
          "translation": "Я ошибался относительно этого.",
          "source": "Tatoeba #2632954 @Pfirsichbaeumchen / #2632885 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2632954",
          "cefr_level": "A1",
          "word_slugs": [
            "hinsicht-noun"
          ]
        },
        {
          "id": "1794911",
          "text": "Dieses Buch ist in vielerlei Hinsicht einzigartig.",
          "translation": "Эта книга во многих отношениях уникальна.",
          "source": "Tatoeba #1794911 @al_ex_an_der / #1794901 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1794911",
          "cefr_level": "A1",
          "word_slugs": [
            "hinsicht-noun"
          ]
        },
        {
          "id": "7559966",
          "text": "Zeit ist in vielerlei Hinsicht wertvoller als Geld.",
          "translation": "Во многих отношениях время дороже денег.",
          "source": "Tatoeba #7559966 @Pfirsichbaeumchen / #2931662 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7559966",
          "cefr_level": "A1",
          "word_slugs": [
            "hinsicht-noun"
          ]
        },
        {
          "id": "1912717",
          "text": "In dieser Hinsicht unterscheidet sich meine Meinung von Ihrer.",
          "translation": "В этом отношении моё мнение отличается от вашего.",
          "source": "Tatoeba #1912717 @Tamy / #12368675 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1912717",
          "cefr_level": "A1",
          "word_slugs": [
            "hinsicht-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "ereignis-noun",
      "lemma": "Ereignis",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5650,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "event (occurrence of social or personal importance)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1326978",
          "text": "Wissen ist immer ein Ereignis.",
          "translation": "Познание - это всегда событие.",
          "source": "Tatoeba #1326978 @al_ex_an_der / #13153404 @Korovin_Ilya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1326978",
          "cefr_level": "A1",
          "word_slugs": [
            "ereignis-noun"
          ]
        },
        {
          "id": "2188881",
          "text": "Es ist ein unwichtiges Ereignis.",
          "translation": "Это незначительное происшествие.",
          "source": "Tatoeba #2188881 @Tamy / #4387585 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2188881",
          "cefr_level": "A1",
          "word_slugs": [
            "ereignis-noun"
          ]
        },
        {
          "id": "8644206",
          "text": "Dieses Ereignis wird in die Geschichte eingehen.",
          "translation": "Это событие войдёт в историю.",
          "source": "Tatoeba #8644206 @Melang / #11238098 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8644206",
          "cefr_level": "A1",
          "word_slugs": [
            "ereignis-noun"
          ]
        },
        {
          "id": "750590",
          "text": "Das Ereignis ist uns noch frisch in Erinnerung.",
          "translation": "Событие ещё свежо в нашей памяти.",
          "source": "Tatoeba #750590 @Dejo / #750594 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/750590",
          "cefr_level": "A1",
          "word_slugs": [
            "ereignis-noun"
          ]
        },
        {
          "id": "7856208",
          "text": "Wie hätte ich mir so ein Ereignis entgehen lassen können!",
          "translation": "Как же я мог пропустить такое событие!",
          "source": "Tatoeba #7856208 @Pfirsichbaeumchen / #7856157 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7856208",
          "cefr_level": "A1",
          "word_slugs": [
            "ereignis-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
