      "gender": null,
      "examples": [
        {
          "id": "13104336",
          "text": "Er hat die Chance genutzt.",
          "translation": "Он воспользовался случаем.",
          "source": "Tatoeba #13104336 @Biderl / #13125537 @Korovin_Ilya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13104336",
          "cefr_level": "A1",
          "word_slugs": [
            "genutzt-verb"
          ]
        },
        {
          "id": "13277520",
          "text": "Er hat die Zeit gut genutzt.",
          "translation": "Он использовал время с пользой.",
          "source": "Tatoeba #13277520 @Biderl / #13456403 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13277520",
          "cefr_level": "A1",
          "word_slugs": [
            "genutzt-verb"
          ]
        },
        {
          "id": "782477",
          "text": "Eine Sprache kann auf verschiedenen Wegen genutzt werden.",
          "translation": "Язык можно использовать по-разному.",
          "source": "Tatoeba #782477 @Chris / #976648 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/782477",
          "cefr_level": "A1",
          "word_slugs": [
            "genutzt-verb"
          ]
        },
        {
          "id": "331696",
          "text": "Die Energie aus Atomkraft kann zu friedlichen Zwecken genutzt werden.",
          "translation": "Атомная энергия может быть использована для мирных целей.",
          "source": "Tatoeba #331696 @SeeVogel / #810403 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/331696",
          "cefr_level": "A1",
          "word_slugs": [
            "genutzt-verb"
          ]
        },
        {
          "id": "10000281",
          "text": "Ich habe dir eine Chance gegeben, aber du hast sie nicht genutzt.",
          "translation": "Я дал тебе шанс, но ты им не воспользовался.",
          "source": "Tatoeba #10000281 @sakslane / #3678994 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10000281",
          "cefr_level": "A1",
          "word_slugs": [
            "genutzt-verb"
          ]
        }
      ],
