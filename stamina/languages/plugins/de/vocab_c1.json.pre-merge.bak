    {
      "slug": "wahlen-noun",
      "lemma": "Wahlen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9867,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Wahl"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13664291",
          "text": "Heute sind Wahlen.",
          "translation": "Сегодня выборы.",
          "source": "Tatoeba #13664291 @Vortarulo / #8263870 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13664291",
          "cefr_level": "A1",
          "word_slugs": [
            "wahlen-noun"
          ]
        },
        {
          "id": "8113366",
          "text": "In Russland fanden Wahlen statt.",
          "translation": "В России состоялись выборы.",
          "source": "Tatoeba #8113366 @kutschektar / #8119148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8113366",
          "cefr_level": "A1",
          "word_slugs": [
            "wahlen-noun"
          ]
        },
        {
          "id": "8309382",
          "text": "Nächsten Sonntag finden Wahlen statt.",
          "translation": "В следующее воскресенье выборы.",
          "source": "Tatoeba #8309382 @GuidoW / #8309407 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8309382",
          "cefr_level": "A1",
          "word_slugs": [
            "wahlen-noun"
          ]
        },
        {
          "id": "12901493",
          "text": "Die Wahlen finden im Januar statt.",
          "translation": "Выборы пройдут в январе.",
          "source": "Tatoeba #12901493 @mhr / #12901274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12901493",
          "cefr_level": "A1",
          "word_slugs": [
            "wahlen-noun"
          ]
        },
        {
          "id": "11759709",
          "text": "Die Wahlen finden am Sonntag statt.",
          "translation": "Выборы в воскресенье.",
          "source": "Tatoeba #11759709 @mhr / #7190060 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11759709",
          "cefr_level": "A1",
          "word_slugs": [
            "wahlen-noun"
          ]
        }
