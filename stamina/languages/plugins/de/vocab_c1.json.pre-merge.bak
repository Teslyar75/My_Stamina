        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12359007",
          "text": "Das sind meine Magazine.",
          "translation": "Это мои журналы.",
          "source": "Tatoeba #12359007 @Pfirsichbaeumchen / #10238884 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12359007",
          "cefr_level": "A1",
