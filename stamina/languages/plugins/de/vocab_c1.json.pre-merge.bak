    {
      "slug": "südlich-adj",
      "lemma": "südlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7971,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "южный"
        ],
        "en": [
          "south, southern"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12543752",
          "text": "Das ist noch weiter südlich.",
          "translation": "Это ещё южнее.",
          "source": "Tatoeba #12543752 @mhr / #12543707 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12543752",
          "cefr_level": "A1",
          "word_slugs": [
            "südlich-adj"
          ]
        },
        {
          "id": "8653544",
          "text": "Oregon liegt südlich von Washington.",
          "translation": "Орегон находится к югу от Вашингтона.",
          "source": "Tatoeba #8653544 @Melang / #8658648 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8653544",
          "cefr_level": "A1",
          "word_slugs": [
            "südlich-adj"
          ]
        },
        {
          "id": "370484",
          "text": "Frankreich liegt südlich von England.",
          "translation": "Франция находится к югу от Англии.",
          "source": "Tatoeba #370484 @Wolf / #6042419 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/370484",
          "cefr_level": "A1",
          "word_slugs": [
            "südlich-adj"
          ]
        },
        {
          "id": "3305822",
          "text": "Kap Deschnjow liegt fünfzig Kilometer südlich des Nordpolarkreises.",
          "translation": "Мыс Дежнёва находится в пятидесяти километрах южнее Северного полярного круга.",
          "source": "Tatoeba #3305822 @Pfirsichbaeumchen / #13024933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3305822",
          "cefr_level": "A1",
          "word_slugs": [
            "südlich-adj"
          ]
        },
        {
          "id": "1707428",
          "text": "In vielen afrikanischen Ländern südlich der Sahara herrscht Armut.",
          "translation": "Во многих африканских странах южнее Сахары царит бедность.",
          "source": "Tatoeba #1707428 @Pfirsichbaeumchen / #13887903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1707428",
          "cefr_level": "A1",
          "word_slugs": [
            "südlich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der südlich",
        "nominative_pl": ""
      }
