    {
      "slug": "gespenst-noun",
      "lemma": "Gespenst",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9806,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "ghost, spectre"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13738325",
          "text": "Das Gespenst hat keinen Kopf.",
          "translation": "У призрака нет головы.",
          "source": "Tatoeba #13738325 @Ioan_Cristian / #13738334 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13738325",
          "cefr_level": "A1",
          "word_slugs": [
            "gespenst-noun"
          ]
        },
        {
          "id": "4936158",
          "text": "Ich dachte, du wärst ein Gespenst.",
          "translation": "Я думал, ты, должно быть, призрак.",
          "source": "Tatoeba #4936158 @Esperantostern / #4936736 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4936158",
          "cefr_level": "A1",
          "word_slugs": [
            "gespenst-noun"
          ]
        },
        {
          "id": "3311629",
          "text": "Hast du jemals ein Gespenst gesehen?",
          "translation": "Ты когда-нибудь видел привидение?",
          "source": "Tatoeba #3311629 @al_ex_an_der / #4263942 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3311629",
          "cefr_level": "A1",
          "word_slugs": [
            "gespenst-noun"
          ]
        },
        {
          "id": "3833427",
          "text": "Du bist so bleich wie ein Gespenst.",
          "translation": "Ты бледный как привидение.",
          "source": "Tatoeba #3833427 @raggione / #1420322 @MikaM (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3833427",
          "cefr_level": "A1",
          "word_slugs": [
            "gespenst-noun"
          ]
        },
        {
          "id": "5710215",
          "text": "Das Gespenst trat durch die Mauer herein.",
          "translation": "Привидение прошло сквозь стену.",
          "source": "Tatoeba #5710215 @Esperantostern / #5711457 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5710215",
          "cefr_level": "A1",
          "word_slugs": [
            "gespenst-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
