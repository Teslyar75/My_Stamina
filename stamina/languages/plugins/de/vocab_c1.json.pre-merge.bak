      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5795,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nest",
          "small village"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8663586",
          "text": "Das Nest fiel zu Boden.",
          "translation": "Гнездо упало на землю.",
          "source": "Tatoeba #8663586 @Melang / #8824535 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8663586",
          "cefr_level": "A1",
          "word_slugs": [
            "nest-noun"
          ]
        },
        {
          "id": "12947790",
          "text": "Jeder Vogel baut ein Nest.",
          "translation": "Все птицы вьют гнёзда.",
          "source": "Tatoeba #12947790 @Tom9358 / #12997603 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12947790",
          "cefr_level": "A1",
          "word_slugs": [
            "nest-noun"
          ]
        },
        {
          "id": "8636805",
          "text": "Die Blaumeisen bauen ein Nest.",
          "translation": "Лазоревки вьют гнездо.",
          "source": "Tatoeba #8636805 @Melang / #8638593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636805",
          "cefr_level": "A1",
          "word_slugs": [
            "nest-noun"
          ]
        },
        {
          "id": "13015537",
          "text": "Der Vogel flog aus dem Nest.",
          "translation": "Птица вылетела из гнезда.",
          "source": "Tatoeba #13015537 @mhr / #13015502 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13015537",
          "cefr_level": "A1",
          "word_slugs": [
            "nest-noun"
          ]
        },
        {
          "id": "13700525",
          "text": "Das Küken fiel aus dem Nest.",
          "translation": "Птенец выпал из гнезда.",
          "source": "Tatoeba #13700525 @mhr / #13700441 @gregoryguy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13700525",
          "cefr_level": "A1",
          "word_slugs": [
            "nest-noun"
          ]
        }
      ],
