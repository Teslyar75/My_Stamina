    {
      "slug": "februar-noun",
      "lemma": "Februar",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6445,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "February (the short month following January and preceding March in the Roman, Julian, and Gregorian calendars, used in all three calendars for intercalation or addition of leap day"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12465053",
          "text": "Der Februar ist vorbei.",
          "translation": "Февраль прошёл.",
          "source": "Tatoeba #12465053 @Waldelfe / #12465061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12465053",
          "cefr_level": "A1",
          "word_slugs": [
            "februar-noun"
          ]
        },
        {
          "id": "10184339",
          "text": "Wir haben jetzt Februar.",
          "translation": "У нас сейчас февраль.",
          "source": "Tatoeba #10184339 @Pfirsichbaeumchen / #10184092 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10184339",
          "cefr_level": "A1",
          "word_slugs": [
            "februar-noun"
          ]
        },
        {
          "id": "1005408",
          "text": "Er wird im Februar siebzehn.",
          "translation": "В феврале ему будет семнадцать.",
          "source": "Tatoeba #1005408 @elgranjuego / #2766295 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1005408",
          "cefr_level": "A1",
          "word_slugs": [
            "februar-noun"
          ]
        },
        {
          "id": "6287510",
          "text": "Der Februar hat nur 28 Tage.",
          "translation": "В феврале только двадцать восемь дней.",
          "source": "Tatoeba #6287510 @Pfirsichbaeumchen / #3478840 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6287510",
          "cefr_level": "A1",
          "word_slugs": [
            "februar-noun"
          ]
        },
        {
          "id": "12443485",
          "text": "Ich habe im Februar Geburtstag.",
          "translation": "У меня день рождения в феврале.",
          "source": "Tatoeba #12443485 @Pfirsichbaeumchen / #12443486 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12443485",
          "cefr_level": "A1",
          "word_slugs": [
            "februar-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
