          "source": "Tatoeba #2980828 @pne / #561696 @pandabear (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2980828",
          "cefr_level": "A1",
          "word_slugs": [
            "öffnete-verb"
          ]
        },
        {
          "id": "12732189",
          "text": "Er öffnete das Heft.",
          "translation": "Он открыл тетрадь.",
          "source": "Tatoeba #12732189 @mhr / #12732168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12732189",
          "cefr_level": "A1",
          "word_slugs": [
            "öffnete-verb"
          ]
        },
        {
          "id": "656997",
          "text": "Die Tür öffnete sich.",
          "translation": "Дверь открылась.",
          "source": "Tatoeba #656997 @samueldora / #1729757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/656997",
          "cefr_level": "A1",
