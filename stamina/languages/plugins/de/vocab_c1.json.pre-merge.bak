    {
      "slug": "einstein-name",
      "lemma": "Einstein",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8656,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a surname, notably of Albert Einstein"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2890635",
          "text": "Einstein spielte gerne Geige.",
          "translation": "Эйнштейн любил играть на скрипке.",
          "source": "Tatoeba #2890635 @Pfirsichbaeumchen / #1271863 @Lich (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2890635",
          "cefr_level": "A1",
          "word_slugs": [
            "einstein-name"
          ]
        },
        {
          "id": "701415",
          "text": "Einstein spielte gerne Violine.",
          "translation": "Эйнштейн любил играть на скрипке.",
          "source": "Tatoeba #701415 @Esperantostern / #1271863 @Lich (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/701415",
          "cefr_level": "A1",
          "word_slugs": [
            "einstein-name"
          ]
        },
        {
          "id": "444315",
          "text": "Wissenschaftler wie Einstein sind selten.",
          "translation": "Такие учёные, как Эйнштейн, — редкость.",
          "source": "Tatoeba #444315 @MUIRIEL / #13690671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/444315",
          "cefr_level": "A1",
          "word_slugs": [
            "einstein-name"
          ]
        },
        {
          "id": "3581948",
          "text": "Einstein ist ein überaus kluger Papagei.",
          "translation": "Эйнштейн очень умный попугай.",
          "source": "Tatoeba #3581948 @Pfirsichbaeumchen / #3582944 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3581948",
          "cefr_level": "A1",
          "word_slugs": [
            "einstein-name"
          ]
        },
        {
          "id": "6999248",
          "text": "Albert Einstein wurde 1879 in Ulm geboren.",
          "translation": "Альберт Эйнштейн родился в 1879 году в Ульме.",
          "source": "Tatoeba #6999248 @Pfirsichbaeumchen / #7001898 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6999248",
          "cefr_level": "A1",
          "word_slugs": [
            "einstein-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Einstein",
        "nominative_pl": ""
      }
