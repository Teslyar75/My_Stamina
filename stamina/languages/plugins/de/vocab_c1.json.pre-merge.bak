        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1507923",
          "text": "Er erlag der Versuchung.",
          "translation": "Он поддался искушению.",
          "source": "Tatoeba #1507923 @Zaghawa / #1908202 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1507923",
          "cefr_level": "A1",
          "word_slugs": [
            "versuchung-noun"
          ]
        },
        {
          "id": "2364131",
          "text": "Folge nicht der Versuchung!",
          "translation": "Не поддавайся искушению!",
          "source": "Tatoeba #2364131 @al_ex_an_der / #2370473 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2364131",
          "cefr_level": "A1",
          "word_slugs": [
            "versuchung-noun"
          ]
        },
        {
          "id": "1691187",
          "text": "Führe mich nicht in Versuchung!",
          "translation": "Не вводи меня в искушение!",
          "source": "Tatoeba #1691187 @Pfirsichbaeumchen / #5709832 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1691187",
          "cefr_level": "A1",
          "word_slugs": [
            "versuchung-noun"
          ]
        },
        {
          "id": "1851553",
          "text": "Führen Sie mich nicht in Versuchung!",
          "translation": "Не вводите меня в искушение!",
          "source": "Tatoeba #1851553 @Pfirsichbaeumchen / #5709836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1851553",
          "cefr_level": "A1",
          "word_slugs": [
            "versuchung-noun"
          ]
        },
        {
          "id": "2216696",
          "text": "Er konnte der Versuchung nicht widerstehen.",
          "translation": "Он не мог устоять перед искушением.",
          "source": "Tatoeba #2216696 @al_ex_an_der / #2216708 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2216696",
          "cefr_level": "A1",
          "word_slugs": [
            "versuchung-noun"
          ]
        }
      ],
      "tags": [
