    {
      "slug": "untergang-noun",
      "lemma": "Untergang",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7419,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "fall, downfall, death, doom",
          "sinking",
          "setting"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1044139",
          "text": "Wir arbeiten von Sonnenaufgang bis -untergang.",
          "translation": "Мы работаем с рассвета до заката.",
          "source": "Tatoeba #1044139 @MUIRIEL / #9004875 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1044139",
          "cefr_level": "A1",
          "word_slugs": [
            "untergang-noun"
          ]
        },
        {
          "id": "4895648",
          "text": "Was führte zum Untergang des Römischen Reiches?",
          "translation": "Что привело к падению Римской империи?",
          "source": "Tatoeba #4895648 @Pfirsichbaeumchen / #4943357 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4895648",
          "cefr_level": "A1",
          "word_slugs": [
            "untergang-noun"
          ]
        },
        {
          "id": "5310724",
          "text": "Es gibt keine Hoffnung. Der Untergang ist unvermeidlich.",
          "translation": "Надежды нет. Крах неизбежен.",
          "source": "Tatoeba #5310724 @Pfirsichbaeumchen / #5940847 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5310724",
          "cefr_level": "A1",
          "word_slugs": [
            "untergang-noun"
          ]
        },
        {
          "id": "523540",
          "text": "Ein Atomkrieg würde den Untergang der Menschheit bedeuten.",
          "translation": "Атомная война означала бы гибель человечества.",
          "source": "Tatoeba #523540 @xtofu80 / #5940824 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/523540",
          "cefr_level": "A1",
          "word_slugs": [
            "untergang-noun"
          ]
        },
        {
          "id": "1534381",
          "text": "Hundert Jahre sind seit dem Untergang der Titanic vergangen.",
          "translation": "Прошло сто лет с тех пор, как затонул «Титаник».",
          "source": "Tatoeba #1534381 @Pfirsichbaeumchen / #1937486 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1534381",
          "cefr_level": "A1",
          "word_slugs": [
            "untergang-noun"
          ]
        }
      ],
