      "gender": "m",
      "examples": [
        {
          "id": "6776939",
          "text": "Der Student schreibt einen Aufsatz.",
          "translation": "Студент пишет сочинение.",
          "source": "Tatoeba #6776939 @ruth_tatoeba / #6792657 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6776939",
          "cefr_level": "A1",
          "word_slugs": [
