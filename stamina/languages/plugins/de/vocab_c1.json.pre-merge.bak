    {
      "slug": "übermorgen-adv",
      "lemma": "übermorgen",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5792,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "overmorrow, the day after tomorrow"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "371166",
          "text": "Kommen Sie übermorgen.",
          "translation": "Приходите послезавтра.",
          "source": "Tatoeba #371166 @MUIRIEL / #758676 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/371166",
          "cefr_level": "A1",
          "word_slugs": [
            "übermorgen-adv"
          ]
        },
        {
          "id": "8646226",
          "text": "Tom wird übermorgen 13.",
          "translation": "Послезавтра Тому исполняется тринадцать.",
          "source": "Tatoeba #8646226 @Pfirsichbaeumchen / #8554033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8646226",
          "cefr_level": "A1",
          "word_slugs": [
            "übermorgen-adv"
          ]
        },
        {
          "id": "13905308",
          "text": "Tom fährt übermorgen ab.",
          "translation": "Том послезавтра уезжает.",
          "source": "Tatoeba #13905308 @mhr / #10854753 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13905308",
          "cefr_level": "A1",
          "word_slugs": [
            "übermorgen-adv"
          ]
        },
        {
          "id": "1979928",
          "text": "Wir fahren übermorgen ab.",
          "translation": "Мы уезжаем послезавтра.",
          "source": "Tatoeba #1979928 @Alois / #3205963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1979928",
          "cefr_level": "A1",
          "word_slugs": [
            "übermorgen-adv"
          ]
        },
        {
          "id": "13384205",
          "text": "Wir sehen uns übermorgen!",
          "translation": "Увидимся послезавтра!",
          "source": "Tatoeba #13384205 @mhr / #13384790 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13384205",
          "cefr_level": "A1",
          "word_slugs": [
            "übermorgen-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
