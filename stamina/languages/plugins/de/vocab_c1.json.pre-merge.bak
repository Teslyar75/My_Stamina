    {
      "slug": "seide-noun",
      "lemma": "Seide",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9624,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "silk",
          "Any of several parasitic vines, of the genus Cuscuta, having small white flowers but no leaves."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "461422",
          "text": "Das Kleid ist aus Seide.",
          "translation": "Это платье из шёлка.",
          "source": "Tatoeba #461422 @MUIRIEL / #579610 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/461422",
          "cefr_level": "A1",
          "word_slugs": [
            "seide-noun"
          ]
        },
        {
          "id": "393042",
          "text": "Ihre Haare sind wie Seide.",
          "translation": "Её волосы словно шёлк.",
          "source": "Tatoeba #393042 @MUIRIEL / #500636 @drnm2 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/393042",
          "cefr_level": "A1",
          "word_slugs": [
            "seide-noun"
          ]
        },
        {
          "id": "393043",
          "text": "Seine Haare sind wie Seide.",
          "translation": "Волосы у него как шёлк.",
          "source": "Tatoeba #393043 @MUIRIEL / #12203287 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/393043",
          "cefr_level": "A1",
          "word_slugs": [
            "seide-noun"
          ]
        },
        {
          "id": "2890595",
          "text": "Dieses Kleid ist aus reiner Seide.",
          "translation": "Это платье из чистого шёлка.",
          "source": "Tatoeba #2890595 @Pfirsichbaeumchen / #2890443 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2890595",
          "cefr_level": "A1",
          "word_slugs": [
            "seide-noun"
          ]
        },
        {
          "id": "12730641",
          "text": "Traditionelle Kimonos werden oft aus Seide genäht.",
          "translation": "Традиционные кимоно часто шьются из шёлка.",
          "source": "Tatoeba #12730641 @mhr / #12730629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12730641",
          "cefr_level": "A1",
          "word_slugs": [
            "seide-noun"
          ]
        }
      ],
