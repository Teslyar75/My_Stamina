    {
      "slug": "stellten-verb",
      "lemma": "stellten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7820,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of stellen:",
          "first/third-person plural preterite",
          "inflection of stellen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5017132",
          "text": "Wir stellten uns ahnungslos.",
          "translation": "Мы делали вид, будто ни о чём не подозреваем.",
          "source": "Tatoeba #5017132 @al_ex_an_der / #5017177 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5017132",
          "cefr_level": "A1",
          "word_slugs": [
            "stellten-verb"
          ]
        },
        {
          "id": "5017126",
          "text": "Sie stellten sich ahnungslos.",
          "translation": "Они делали вид, будто ни о чём не подозревают.",
          "source": "Tatoeba #5017126 @al_ex_an_der / #5017172 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5017126",
          "cefr_level": "A1",
          "word_slugs": [
            "stellten-verb"
          ]
        },
        {
          "id": "1693407",
          "text": "Wir stellten uns einander vor.",
          "translation": "Мы представились друг другу.",
          "source": "Tatoeba #1693407 @Pfirsichbaeumchen / #4809724 @amina2901 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1693407",
          "cefr_level": "A1",
          "word_slugs": [
            "stellten-verb"
          ]
        },
        {
          "id": "10662390",
          "text": "Sie stellten sich unter eine Eiche.",
          "translation": "Они укрылись под дубом.",
          "source": "Tatoeba #10662390 @Pfirsichbaeumchen / #10987242 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10662390",
          "cefr_level": "A1",
          "word_slugs": [
            "stellten-verb"
          ]
        },
        {
          "id": "5023773",
          "text": "Wir stellten unser Zelt auf dem Feld auf.",
          "translation": "Мы разбили палатку на поле.",
          "source": "Tatoeba #5023773 @Esperantostern / #13900101 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5023773",
          "cefr_level": "A1",
          "word_slugs": [
            "stellten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
