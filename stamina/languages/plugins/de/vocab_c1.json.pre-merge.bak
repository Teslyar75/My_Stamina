    {
      "slug": "bildern-noun",
      "lemma": "Bildern",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7909,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Bild"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2230028",
          "text": "Wir denken in Wörtern und Bildern.",
          "translation": "Мы думаем словами и образами.",
          "source": "Tatoeba #2230028 @al_ex_an_der / #2230027 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2230028",
          "cefr_level": "A1",
          "word_slugs": [
            "bildern-noun"
          ]
        },
        {
          "id": "396871",
          "text": "Mir gefällt keines von den Bildern.",
          "translation": "Мне ни одна из этих картин не нравится.",
          "source": "Tatoeba #396871 @MikeMolto / #4552556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/396871",
          "cefr_level": "A1",
          "word_slugs": [
            "bildern-noun"
          ]
        },
        {
          "id": "1627167",
          "text": "Ich suchte nach einem Buch mit vielen Bildern.",
          "translation": "Я искал книгу с большим количеством картинок.",
          "source": "Tatoeba #1627167 @al_ex_an_der / #14087144 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1627167",
          "cefr_level": "A1",
          "word_slugs": [
            "bildern-noun"
          ]
        },
        {
          "id": "765393",
          "text": "Der Lehrer erklärte seine Theorie anhand von Bildern.",
          "translation": "Учитель объяснял свою теорию, используя иллюстрации.",
          "source": "Tatoeba #765393 @jakov / #2847433 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/765393",
          "cefr_level": "A1",
          "word_slugs": [
            "bildern-noun"
          ]
        },
        {
          "id": "341982",
          "text": "Sehen Sie den Unterschied zwischen diesen beiden Bildern?",
          "translation": "Вы видите разницу между этими двумя изображениями?",
          "source": "Tatoeba #341982 @lilygilder / #2130485 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341982",
          "cefr_level": "A1",
          "word_slugs": [
            "bildern-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
