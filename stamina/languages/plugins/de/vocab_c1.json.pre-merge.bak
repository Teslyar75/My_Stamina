    {
      "slug": "aufwecken-verb",
      "lemma": "aufwecken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9479,
      "frequency_band": "goethe-c1",
      "translations": {
