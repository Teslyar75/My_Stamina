          ]
        },
        {
          "id": "11493676",
          "text": "Lass mich dich umarmen.",
          "translation": "Дай я тебя обниму.",
          "source": "Tatoeba #11493676 @Bernie75 / #2804749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11493676",
          "cefr_level": "A1",
          "word_slugs": [
            "umarmen-verb"
          ]
        },
        {
          "id": "1846589",
          "text": "Lassen Sie sich umarmen!",
