    {
      "slug": "gelb-noun",
      "lemma": "Gelb",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5955,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "жёлтый"
        ],
        "en": [
          "yellow",
          "short for gelbe Karte",
          "ellipsis of Eigelb: yolk"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "2739597",
          "text": "Mir gefällt die Farbe Gelb.",
          "translation": "Мне нравится желтый цвет.",
          "source": "Tatoeba #2739597 @Pfirsichbaeumchen / #2739610 @Natalia_Su (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2739597",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-noun"
          ]
        },
        {
          "id": "9151506",
          "text": "Rot, Gelb und Blau sind Farben.",
          "translation": "Красный, жёлтый и синий — это цвета.",
          "source": "Tatoeba #9151506 @carlosalberto / #9155233 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9151506",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-noun"
          ]
        },
        {
          "id": "13735248",
          "text": "Wenn Sie Blau und Gelb mischen, entsteht die Farbe Grün.",
          "translation": "Если смешать синий и жёлтый, получится зелёный.",
          "source": "Tatoeba #13735248 @Biderl / #13735251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13735248",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-noun"
          ]
        },
        {
          "id": "13735242",
          "text": "Wenn Sie die Farben Blau und Gelb mischen, was bekommen Sie?",
          "translation": "Если смешать синий и жёлтый, какой цвет получится?",
          "source": "Tatoeba #13735242 @Biderl / #13735245 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13735242",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-noun"
          ]
        },
        {
          "id": "10018662",
          "text": "Die Flagge von Brasilien hat vier Farben: Grün, Gelb, Blau und Weiß.",
          "translation": "На флаге Бразилии четыре цвета: зелёный, жёлтый, синий и белый.",
          "source": "Tatoeba #10018662 @Melang / #6813941 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10018662",
          "cefr_level": "A1",
          "word_slugs": [
            "gelb-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Gelb",
        "nominative_pl": ""
      }
    },
