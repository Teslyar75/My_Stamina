      "translations": {
        "en": [
          "inflection of gefährden:",
          "third-person singular present",
          "inflection of gefährden:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5076680",
          "text": "Dieser Planet ist ernsthaft gefährdet.",
          "translation": "Эта планета подвергается серьёзной опасности.",
          "source": "Tatoeba #5076680 @al_ex_an_der / #5077557 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5076680",
          "cefr_level": "A1",
          "word_slugs": [
            "gefährdet-verb"
          ]
        },
        {
          "id": "1535955",
          "text": "Ich mag Rauchen nicht, weil es die Gesundheit gefährdet.",
          "translation": "Я не люблю курить, потому что это вредно для здоровья.",
          "source": "Tatoeba #1535955 @Manfredo / #1523121 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1535955",
          "cefr_level": "A1",
          "word_slugs": [
            "gefährdet-verb"
          ]
        },
        {
          "id": "5977928",
          "text": "Die isolationistische Politik des Präsidenten der USA gefährdet die Wirtschaft.",
          "translation": "Изоляционистская политика президента США опасна для экономики.",
          "source": "Tatoeba #5977928 @al_ex_an_der / #5978088 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5977928",
          "cefr_level": "A1",
          "word_slugs": [
            "gefährdet-verb"
          ]
        }
      ],
      "tags": [
