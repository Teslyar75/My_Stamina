    {
      "slug": "dachboden-noun",
      "lemma": "Dachboden",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8515,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "чердак"
        ],
        "en": [
          "attic"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2002983",
          "text": "Ich bin auf dem Dachboden.",
          "translation": "Я на чердаке.",
          "source": "Tatoeba #2002983 @Pfirsichbaeumchen / #3270150 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2002983",
          "cefr_level": "A1",
          "word_slugs": [
            "dachboden-noun"
          ]
        },
        {
          "id": "8059075",
          "text": "Tom spielt auf dem Dachboden.",
          "translation": "Том играет на чердаке.",
          "source": "Tatoeba #8059075 @Luiaard / #8104830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8059075",
          "cefr_level": "A1",
          "word_slugs": [
            "dachboden-noun"
          ]
        },
        {
          "id": "4784833",
          "text": "Ich fand es auf dem Dachboden.",
          "translation": "Я нашёл это на чердаке.",
          "source": "Tatoeba #4784833 @L3581 / #3267791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4784833",
          "cefr_level": "A1",
          "word_slugs": [
            "dachboden-noun"
          ]
        },
        {
          "id": "9455776",
          "text": "Auf dem Dachboden ist es kalt.",
          "translation": "На чердаке холодно.",
          "source": "Tatoeba #9455776 @Pfirsichbaeumchen / #9466013 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9455776",
          "cefr_level": "A1",
          "word_slugs": [
            "dachboden-noun"
          ]
        },
        {
          "id": "7057421",
          "text": "Was machst du auf dem Dachboden?",
          "translation": "Что ты делаешь на чердаке?",
          "source": "Tatoeba #7057421 @quicksanddiver / #7644428 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7057421",
          "cefr_level": "A1",
          "word_slugs": [
            "dachboden-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Dachboden",
        "nominative_pl": ""
      }
