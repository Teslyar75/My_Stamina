      "gender": "f",
      "examples": [
        {
          "id": "6554947",
          "text": "Wann beginnt die Besprechung?",
          "translation": "Когда начнётся собрание?",
          "source": "Tatoeba #6554947 @Pfirsichbaeumchen / #6555045 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6554947",
          "cefr_level": "A1",
          "word_slugs": [
            "besprechung-noun"
          ]
        },
        {
          "id": "2461783",
          "text": "Die Besprechung wurde abgesagt.",
          "translation": "Совещание было отменено.",
          "source": "Tatoeba #2461783 @Zaghawa / #6960571 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2461783",
          "cefr_level": "A1",
          "word_slugs": [
            "besprechung-noun"
          ]
        },
        {
          "id": "12757272",
          "text": "Ihr könnt die Besprechung nicht absagen.",
          "translation": "Вы не можете отменить встречу.",
          "source": "Tatoeba #12757272 @mhr / #12756725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12757272",
          "cefr_level": "A1",
          "word_slugs": [
            "besprechung-noun"
          ]
        },
        {
          "id": "12757279",
          "text": "Du kannst die Besprechung nicht absagen.",
          "translation": "Ты не можешь отменить собрание.",
          "source": "Tatoeba #12757279 @mhr / #12756724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12757279",
          "cefr_level": "A1",
          "word_slugs": [
            "besprechung-noun"
          ]
        },
        {
          "id": "12757266",
          "text": "Sie können die Besprechung nicht absagen.",
          "translation": "Вы не можете отменить встречу.",
          "source": "Tatoeba #12757266 @mhr / #12756725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12757266",
          "cefr_level": "A1",
