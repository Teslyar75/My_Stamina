      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10046241",
          "text": "Ich aß Reis.",
          "translation": "Я ел рис.",
          "source": "Tatoeba #10046241 @giefingl / #7367336 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10046241",
          "cefr_level": "A1",
