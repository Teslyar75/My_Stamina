          "inflection of träumen:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "918351",
          "text": "Ich träumte von ihm.",
          "translation": "Он мне снился.",
          "source": "Tatoeba #918351 @Fingerhut / #2220480 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/918351",
          "cefr_level": "A1",
          "word_slugs": [
            "träumte-verb"
          ]
        },
        {
          "id": "7346953",
          "text": "Tom träumte von Maria.",
          "translation": "Том мечтал о Мэри.",
          "source": "Tatoeba #7346953 @Yorwba / #4150538 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7346953",
          "cefr_level": "A1",
          "word_slugs": [
            "träumte-verb"
          ]
        },
        {
          "id": "8365340",
          "text": "Tom träumte, er träume.",
          "translation": "Тому приснилось, что ему снится сон.",
          "source": "Tatoeba #8365340 @brauchinet / #7260229 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8365340",
          "cefr_level": "A1",
          "word_slugs": [
            "träumte-verb"
          ]
        },
        {
          "id": "13805401",
          "text": "Ich schlief und träumte.",
          "translation": "Я спал и видел сон.",
          "source": "Tatoeba #13805401 @mhr / #13804956 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13805401",
          "cefr_level": "A1",
          "word_slugs": [
            "träumte-verb"
          ]
        },
        {
          "id": "742508",
          "text": "Er träumte von seiner Heimat.",
          "translation": "Ему снилась Родина.",
          "source": "Tatoeba #742508 @xtofu80 / #1491348 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/742508",
          "cefr_level": "A1",
          "word_slugs": [
            "träumte-verb"
          ]
        }
      ],
