    {
      "slug": "hilflos-adj",
      "lemma": "hilflos",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6805,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "беспомощный"
        ],
        "en": [
          "helpless"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3428809",
          "text": "Tom kam sich hilflos vor.",
          "translation": "Том чувствовал себя беспомощным.",
          "source": "Tatoeba #3428809 @Pfirsichbaeumchen / #3118340 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3428809",
          "cefr_level": "A1",
          "word_slugs": [
            "hilflos-adj"
          ]
        },
        {
          "id": "13284053",
          "text": "Ich fühlte mich so hilflos.",
          "translation": "Я чувствовал себя таким беспомощным.",
          "source": "Tatoeba #13284053 @Waldelfe / #13284060 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13284053",
          "cefr_level": "A1",
          "word_slugs": [
            "hilflos-adj"
          ]
        },
        {
          "id": "5235246",
          "text": "Ohne Maria wäre Tom vollkommen hilflos.",
          "translation": "Без Мэри Том был бы совершенно беспомощным.",
          "source": "Tatoeba #5235246 @Pfirsichbaeumchen / #6318813 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5235246",
          "cefr_level": "A1",
          "word_slugs": [
            "hilflos-adj"
          ]
        }
      ],
