        "nominative_sg": "das Biß",
        "nominative_pl": ""
      }
    },
    {
      "slug": "biss-verb",
      "lemma": "biss",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7563,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of beißen Formerly standard spelling of biss which was deprecated in the spelling reform (Rechtschreibreform) of 1996."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2711866",
          "text": "Sie biss ihn.",
          "translation": "Она его укусила.",
          "source": "Tatoeba #2711866 @Pfirsichbaeumchen / #2839340 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2711866",
          "cefr_level": "A1",
          "word_slugs": [
            "biss-verb"
          ]
        },
        {
          "id": "12464012",
          "text": "Samis Pferd biss ihn.",
          "translation": "Лошадь Сами укусила его.",
          "source": "Tatoeba #12464012 @mhr / #12463998 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12464012",
          "cefr_level": "A1",
          "word_slugs": [
            "biss-verb"
          ]
        },
        {
          "id": "12459064",
          "text": "Die Schlange biß mich.",
          "translation": "Змея меня ужалила.",
          "source": "Tatoeba #12459064 @Waldelfe / #9119897 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12459064",
          "cefr_level": "A1",
          "word_slugs": [
            "biss-verb"
          ]
        },
        {
          "id": "12464008",
          "text": "Samis Pferd biss Laila.",
          "translation": "Конь Сами укусил Лейлу.",
          "source": "Tatoeba #12464008 @mhr / #12464001 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12464008",
          "cefr_level": "A1",
          "word_slugs": [
            "biss-verb"
          ]
        },
        {
          "id": "1950288",
          "text": "Tom biss die Zähne zusammen.",
