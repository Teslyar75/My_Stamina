      "examples": [
        {
          "id": "7697492",
          "text": "Tom bat mich, dich einzuladen.",
          "translation": "Том попросил меня тебя пригласить.",
          "source": "Tatoeba #7697492 @wolfgangth / #7883969 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7697492",
          "cefr_level": "A1",
          "word_slugs": [
            "einzuladen-verb"
          ]
        },
        {
          "id": "7590129",
          "text": "Ich kann nicht umhin, ihn einzuladen.",
          "translation": "Я не могу его не пригласить.",
          "source": "Tatoeba #7590129 @Pfirsichbaeumchen / #7583873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7590129",
          "cefr_level": "A1",
          "word_slugs": [
            "einzuladen-verb"
          ]
        },
        {
          "id": "7590130",
          "text": "Ich kann nicht umhin, sie einzuladen.",
          "translation": "Я не могу её не пригласить.",
          "source": "Tatoeba #7590130 @Pfirsichbaeumchen / #7583874 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7590130",
          "cefr_level": "A1",
          "word_slugs": [
            "einzuladen-verb"
          ]
        },
        {
          "id": "12558117",
          "text": "Er war so freundlich, mich einzuladen.",
          "translation": "Он был настолько любезен, что пригласил меня.",
          "source": "Tatoeba #12558117 @Waldelfe / #3252300 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12558117",
          "cefr_level": "A1",
          "word_slugs": [
            "einzuladen-verb"
          ]
        },
        {
          "id": "14097238",
          "text": "Sie planen, sie zur Hochzeit einzuladen.",
          "translation": "Они планируют пригласить её на свадьбу.",
          "source": "Tatoeba #14097238 @Ioan_Cristian / #14097247 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14097238",
          "cefr_level": "A1",
          "word_slugs": [
            "einzuladen-verb"
          ]
        }
      ],
