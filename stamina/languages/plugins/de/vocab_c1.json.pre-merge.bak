    {
      "slug": "mitzuteilen-verb",
      "lemma": "mitzuteilen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8299,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of mitteilen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8220471",
          "text": "Ebendas habe ich ihr mitzuteilen versucht!",
          "translation": "Это я и пытался ей сказать.",
          "source": "Tatoeba #8220471 @Pfirsichbaeumchen / #6554602 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8220471",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzuteilen-verb"
          ]
        },
        {
          "id": "12387611",
          "text": "Sie hat ihm etwas sehr Wichtiges mitzuteilen.",
          "translation": "Ей нужно сказать ему кое-что очень важное.",
          "source": "Tatoeba #12387611 @Pfirsichbaeumchen / #8935067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12387611",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzuteilen-verb"
          ]
        },
        {
          "id": "2396448",
          "text": "Es wäre gut, ihm unsere neue Adresse mitzuteilen.",
          "translation": "Неплохо было бы сообщить ему наш новый адрес.",
          "source": "Tatoeba #2396448 @al_ex_an_der / #2396444 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2396448",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzuteilen-verb"
          ]
        },
        {
          "id": "7866485",
          "text": "Tom rief an, um mitzuteilen, er käme heute nicht.",
          "translation": "Том позвонил, чтобы сказать, что его здесь сегодня не будет.",
          "source": "Tatoeba #7866485 @Pfirsichbaeumchen / #7866092 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7866485",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzuteilen-verb"
          ]
        },
        {
          "id": "2396454",
          "text": "Wir täten gut daran, ihm unsere neue Adresse mitzuteilen.",
          "translation": "Неплохо было бы сообщить ему наш новый адрес.",
          "source": "Tatoeba #2396454 @al_ex_an_der / #2396444 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2396454",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzuteilen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "zurückkam-verb",
      "lemma": "zurückkam",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8300,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular dependent preterite of zurückkommen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "869741",
          "text": "Als ich zurückkam, war mein Auto verschwunden.",
          "translation": "Когда я вернулся, моя машина исчезла.",
          "source": "Tatoeba #869741 @MUIRIEL / #8596880 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/869741",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkam-verb"
          ]
        },
        {
          "id": "8692232",
          "text": "Als er nach Hause zurückkam, schliefen die Kinder bereits.",
          "translation": "Когда он вернулся домой, дети уже спали.",
          "source": "Tatoeba #8692232 @Pfirsichbaeumchen / #5040488 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8692232",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkam-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
