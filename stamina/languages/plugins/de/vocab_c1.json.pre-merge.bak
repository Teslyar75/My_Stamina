    {
      "slug": "neuesten-adj",
      "lemma": "neuesten",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6591,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of neu:",
          "strong genitive masculine/neuter singular superlative degree",
          "inflection of neu:",
          "weak/mixed genitive/dative all-gender singular superlative degree"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13735345",
          "text": "Alle hörten die neuesten Nachrichten.",
          "translation": "Все слышали последние новости.",
          "source": "Tatoeba #13735345 @mhr / #13735301 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13735345",
          "cefr_level": "A1",
          "word_slugs": [
            "neuesten-adj"
          ]
        },
        {
          "id": "13735347",
          "text": "Alle haben die neuesten Nachrichten gehört.",
          "translation": "Все слышали последние новости.",
          "source": "Tatoeba #13735347 @mhr / #13735301 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13735347",
          "cefr_level": "A1",
          "word_slugs": [
            "neuesten-adj"
          ]
        },
        {
          "id": "1394598",
          "text": "Die neuesten Bücher sind jene, die nicht altern.",
          "translation": "Самые новые книги - те, что не стареют.",
          "source": "Tatoeba #1394598 @Esperantostern / #8296036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1394598",
          "cefr_level": "A1",
          "word_slugs": [
            "neuesten-adj"
          ]
        },
        {
          "id": "11435068",
          "text": "Könnten Sie mich auf den neuesten Stand der Dinge bringen?",
          "translation": "Вы могли бы ввести меня в курс дела?",
          "source": "Tatoeba #11435068 @Bernie75 / #3980660 @tasarut (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11435068",
          "cefr_level": "A1",
          "word_slugs": [
            "neuesten-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
