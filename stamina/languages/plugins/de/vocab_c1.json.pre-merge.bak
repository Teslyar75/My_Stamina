          ]
        },
        {
          "id": "12755249",
          "text": "Das gelingt nicht immer.",
          "translation": "Это не всегда удаётся.",
          "source": "Tatoeba #12755249 @mhr / #12755169 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12755249",
