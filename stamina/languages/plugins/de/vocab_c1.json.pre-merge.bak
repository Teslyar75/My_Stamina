    {
      "slug": "rechnungen-noun",
      "lemma": "Rechnungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5005,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Rechnung"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12458639",
          "text": "Unsere Rechnungen bezahlt Tom.",
          "translation": "Наши счета оплачивает Том.",
          "source": "Tatoeba #12458639 @Waldelfe / #13933924 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12458639",
          "cefr_level": "A1",
          "word_slugs": [
            "rechnungen-noun"
          ]
        },
        {
          "id": "12312676",
          "text": "Ich bezahle jeden Monat meine Rechnungen.",
          "translation": "Я каждый месяц плачу по счетам.",
          "source": "Tatoeba #12312676 @Pfirsichbaeumchen / #13002830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12312676",
          "cefr_level": "A1",
          "word_slugs": [
            "rechnungen-noun"
          ]
        },
        {
          "id": "2917854",
          "text": "Du vergisst immer, die Rechnungen zu bezahlen.",
          "translation": "Ты всегда забываешь заплатить по счёту.",
          "source": "Tatoeba #2917854 @raggione / #2917864 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2917854",
          "cefr_level": "A1",
          "word_slugs": [
            "rechnungen-noun"
          ]
        },
        {
          "id": "2917855",
          "text": "Sie vergessen immer, die Rechnungen zu bezahlen.",
          "translation": "Вы всегда забываете заплатить по счёту.",
          "source": "Tatoeba #2917855 @raggione / #2917862 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2917855",
          "cefr_level": "A1",
          "word_slugs": [
            "rechnungen-noun"
          ]
        },
        {
          "id": "11999736",
          "text": "Ich bekomme vom Postboten nur noch Rechnungen eingeworfen.",
          "translation": "Почтальон мне теперь приносит одни счета.",
          "source": "Tatoeba #11999736 @truando / #11999804 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11999736",
          "cefr_level": "A1",
          "word_slugs": [
            "rechnungen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
