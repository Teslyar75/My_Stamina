    {
      "slug": "offiziellen-adj",
      "lemma": "offiziellen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9701,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of offiziell:",
          "strong genitive masculine/neuter singular",
          "inflection of offiziell:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4793651",
          "text": "All diese Sprachen zählen zu den offiziellen Schweizer Landessprachen.",
          "translation": "Все эти языки считаются официальными государственными языками Швейцарии.",
          "source": "Tatoeba #4793651 @AqQoyriq_1 / #4793658 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4793651",
          "cefr_level": "A1",
          "word_slugs": [
            "offiziellen-adj"
          ]
        },
        {
          "id": "1318267",
          "text": "Drei Viertel der Einwohner des Landes leben unter der offiziellen Armutsgrenze.",
          "translation": "Три четверти жителей страны живут ниже официальной черты бедности.",
          "source": "Tatoeba #1318267 @al_ex_an_der / #4995665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1318267",
          "cefr_level": "A1",
          "word_slugs": [
            "offiziellen-adj"
          ]
        },
        {
          "id": "1855962",
          "text": "Verehrte Nutzer des Weltnetzes, Tatoeba begrüßt Sie auf seiner offiziellen Website.",
          "translation": "Уважаемые пользователи Всемирной сети, Татоэба приветствует вас на своем официальном сайте.",
          "source": "Tatoeba #1855962 @al_ex_an_der / #1855953 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1855962",
          "cefr_level": "A1",
          "word_slugs": [
            "offiziellen-adj"
          ]
        }
      ],
      "tags": [
