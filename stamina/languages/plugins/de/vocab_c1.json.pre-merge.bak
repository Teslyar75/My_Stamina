          ]
        },
        {
          "id": "6301809",
          "text": "Er hat vierzehn Hüte.",
          "translation": "У него четырнадцать шляп.",
          "source": "Tatoeba #6301809 @rmateo / #6302095 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6301809",
          "cefr_level": "A1",
          "word_slugs": [
            "hüte-noun"
          ]
        },
        {
          "id": "5357440",
          "text": "Alle Männer trugen Hüte.",
          "translation": "Все мужчины носили шляпы.",
          "source": "Tatoeba #5357440 @brauchinet / #12789459 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5357440",
          "cefr_level": "A1",
          "word_slugs": [
            "hüte-noun"
          ]
        },
        {
          "id": "1561455",
          "text": "Ich mag keinen der Hüte.",
          "translation": "Мне не нравится ни одна из этих шляп.",
          "source": "Tatoeba #1561455 @al_ex_an_der / #809678 @supermoon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1561455",
          "cefr_level": "A1",
          "word_slugs": [
            "hüte-noun"
          ]
        }
