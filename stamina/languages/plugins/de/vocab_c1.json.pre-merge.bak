        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1615619",
          "text": "Ich kaute Kaugummi.",
          "translation": "Я жевал жевательную резинку.",
          "source": "Tatoeba #1615619 @Esperantostern / #2842451 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1615619",
          "cefr_level": "A1",
          "word_slugs": [
            "kaugummi-noun"
          ]
        },
        {
          "id": "13115981",
          "text": "Er kaut immer einen Kaugummi.",
          "translation": "Он постоянно жуёт жвачку.",
          "source": "Tatoeba #13115981 @brauchinet / #13180730 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13115981",
          "cefr_level": "A1",
          "word_slugs": [
            "kaugummi-noun"
          ]
        },
        {
          "id": "9824031",
          "text": "Es ist gefährlich, Kaugummi zu verschlucken.",
          "translation": "Опасно глотать жвачки.",
          "source": "Tatoeba #9824031 @GaryGaryGary / #2638265 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9824031",
          "cefr_level": "A1",
          "word_slugs": [
            "kaugummi-noun"
          ]
        },
        {
          "id": "13308587",
          "text": "Nimm sofort das Kaugummi aus dem Mund!",
          "translation": "Сейчас же вынь жвачку изо рта!",
          "source": "Tatoeba #13308587 @Pfirsichbaeumchen / #4811834 @Almi92 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13308587",
          "cefr_level": "A1",
          "word_slugs": [
            "kaugummi-noun"
          ]
        },
        {
          "id": "1907260",
          "text": "Wenn du einen Kaugummi im Mund hast, spuck ihn aus!",
          "translation": "Если у тебя во рту жвачка, выплюнь её.",
          "source": "Tatoeba #1907260 @Pfirsichbaeumchen / #3784039 @Tlustulimu (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1907260",
          "cefr_level": "A1",
          "word_slugs": [
            "kaugummi-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
