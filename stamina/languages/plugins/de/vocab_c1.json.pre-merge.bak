          "quick, rapid, swift"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1702730",
          "text": "Er lernt rasch.",
          "translation": "Он быстро учится.",
          "source": "Tatoeba #1702730 @al_ex_an_der / #2044225 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1702730",
          "cefr_level": "A1",
          "word_slugs": [
