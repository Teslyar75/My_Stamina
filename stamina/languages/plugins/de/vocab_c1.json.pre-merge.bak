      "examples": [
        {
          "id": "11871764",
          "text": "Wo sind deine Großeltern?",
          "translation": "Где твои дедушка с бабушкой?",
          "source": "Tatoeba #11871764 @lexiecalised / #11871766 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11871764",
          "cefr_level": "A1",
          "word_slugs": [
            "grosseltern-noun"
          ]
        },
        {
          "id": "7030407",
          "text": "Das sind meine Großeltern.",
          "translation": "Это мои дедушка и бабушка.",
          "source": "Tatoeba #7030407 @rmateo / #7030412 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7030407",
          "cefr_level": "A1",
          "word_slugs": [
