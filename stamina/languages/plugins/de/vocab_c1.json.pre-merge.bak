          ]
        },
        {
          "id": "1592163",
          "text": "Ich singe jetzt.",
          "translation": "Я сейчас пою.",
          "source": "Tatoeba #1592163 @Esperantostern / #3368963 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1592163",
