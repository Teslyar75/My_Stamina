    {
      "slug": "bremsen-noun",
      "lemma": "Bremsen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5352,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of bremsen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1600556",
          "text": "Wir haben keine Bremsen!",
          "translation": "У нас нет тормозов!",
          "source": "Tatoeba #1600556 @Pfirsichbaeumchen / #3759894 @Robertpaulson (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1600556",
          "cefr_level": "A1",
          "word_slugs": [
            "bremsen-noun"
          ]
        },
        {
          "id": "1333962",
          "text": "Die Bremsen waren kaputt.",
          "translation": "Тормоза не работали.",
          "source": "Tatoeba #1333962 @enteka / #2523432 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1333962",
          "cefr_level": "A1",
          "word_slugs": [
            "bremsen-noun"
          ]
        },
        {
          "id": "3019934",
          "text": "Die Bremsen funktionierten nicht.",
          "translation": "Тормоза не работали.",
          "source": "Tatoeba #3019934 @Pfirsichbaeumchen / #2523432 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3019934",
          "cefr_level": "A1",
          "word_slugs": [
            "bremsen-noun"
          ]
        },
        {
          "id": "12491696",
          "text": "Mit den Bremsen stimmt etwas nicht.",
          "translation": "Что-то не так с тормозами.",
          "source": "Tatoeba #12491696 @Waldelfe / #3461267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12491696",
          "cefr_level": "A1",
          "word_slugs": [
            "bremsen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
