      "gender": null,
      "examples": [
        {
          "id": "5133610",
          "text": "Welches Essen magst du am wenigsten?",
          "translation": "Какую еду ты меньше всего любишь?",
          "source": "Tatoeba #5133610 @dispy / #5304182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5133610",
          "cefr_level": "A1",
          "word_slugs": [
            "wenigsten-adj"
          ]
        },
        {
          "id": "770045",
          "text": "Es ist das am wenigsten interessante.",
          "translation": "Это самое неинтересное.",
          "source": "Tatoeba #770045 @marloncori / #3023044 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/770045",
          "cefr_level": "A1",
          "word_slugs": [
            "wenigsten-adj"
          ]
        },
        {
          "id": "12900647",
          "text": "Dieses Buch gefällt mir am wenigsten.",
          "translation": "Эта книга мне меньше всего нравится.",
          "source": "Tatoeba #12900647 @Waldelfe / #4656464 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12900647",
          "cefr_level": "A1",
          "word_slugs": [
            "wenigsten-adj"
          ]
        },
        {
          "id": "1240376",
          "text": "Sie hätte ich hier am wenigsten erwartet.",
          "translation": "Вас я здесь меньше всего ожидал увидеть.",
          "source": "Tatoeba #1240376 @al_ex_an_der / #4548860 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1240376",
          "cefr_level": "A1",
          "word_slugs": [
            "wenigsten-adj"
          ]
        },
        {
          "id": "1240352",
          "text": "Dich hätte ich hier am wenigsten erwartet.",
          "translation": "Тебя я здесь меньше всего ожидал увидеть.",
