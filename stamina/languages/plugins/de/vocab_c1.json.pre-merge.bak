      "gender": "n",
      "examples": [
        {
          "id": "3514359",
          "text": "Das Internet hat aus mir ein Ungeheuer gemacht.",
          "translation": "Интернет сделал меня монстром.",
          "source": "Tatoeba #3514359 @al_ex_an_der / #3514358 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3514359",
          "cefr_level": "A1",
          "word_slugs": [
