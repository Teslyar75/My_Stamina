    {
      "slug": "zurückzukehren-verb",
      "lemma": "zurückzukehren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6611,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of zurückkehren"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12905417",
          "text": "Tom plant, übermorgen zurückzukehren.",
          "translation": "Том собирается вернуться послезавтра.",
          "source": "Tatoeba #12905417 @mhr / #12905382 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12905417",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukehren-verb"
          ]
        },
        {
          "id": "13718541",
          "text": "Was hindert sie daran zurückzukehren?",
          "translation": "Что мешает ей вернуться?",
          "source": "Tatoeba #13718541 @mhr / #13718185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13718541",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukehren-verb"
          ]
        },
        {
          "id": "13718545",
          "text": "Was hindert ihn daran zurückzukehren?",
          "translation": "Что мешает ему вернуться?",
          "source": "Tatoeba #13718545 @mhr / #13718183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13718545",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukehren-verb"
          ]
        },
        {
          "id": "12905415",
          "text": "Tom hat vor, übermorgen zurückzukehren.",
          "translation": "Том собирается вернуться послезавтра.",
          "source": "Tatoeba #12905415 @mhr / #12905382 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12905415",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukehren-verb"
          ]
        },
        {
          "id": "13471496",
          "text": "Es ist besser, übermorgen zurückzukehren.",
          "translation": "Лучше вернуться послезавтра.",
          "source": "Tatoeba #13471496 @mhr / #13471160 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13471496",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukehren-verb"
          ]
        }
