          ]
        },
        {
          "id": "655280",
          "text": "Ich bin ein amerikanischer Student.",
          "translation": "Я американский студент.",
          "source": "Tatoeba #655280 @kokage / #2010600 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/655280",
          "cefr_level": "A1",
          "word_slugs": [
            "amerikanischer-adj"
          ]
        },
        {
          "id": "5958892",
          "text": "Das Schiff fährt unter amerikanischer Flagge.",
