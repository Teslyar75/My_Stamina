          "lemonade",
          "any carbonated soft drink, soda pop, fizzy drink (particularly kinds other than cola, though it may also be included)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1764357",
          "text": "Ich hatte Limonade.",
          "translation": "У меня был лимонад.",
          "source": "Tatoeba #1764357 @al_ex_an_der / #3155495 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1764357",
          "cefr_level": "A1",
          "word_slugs": [
            "limonade-noun"
          ]
        },
        {
          "id": "11540068",
          "text": "Ich trank Limonade.",
          "translation": "Я пил лимонад.",
          "source": "Tatoeba #11540068 @Pfirsichbaeumchen / #11539702 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11540068",
          "cefr_level": "A1",
          "word_slugs": [
            "limonade-noun"
          ]
        },
        {
          "id": "6710311",
          "text": "Maria trinkt eine Limonade.",
          "translation": "Мэри пьёт лимонад.",
          "source": "Tatoeba #6710311 @felix63 / #6710403 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6710311",
          "cefr_level": "A1",
          "word_slugs": [
            "limonade-noun"
          ]
        },
        {
          "id": "14006632",
          "text": "Die Limonade ist zu süß.",
          "translation": "Лимонад слишком сладкий.",
          "source": "Tatoeba #14006632 @Ioan_Cristian / #5617897 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14006632",
          "cefr_level": "A1",
          "word_slugs": [
            "limonade-noun"
          ]
        },
        {
          "id": "12885949",
          "text": "Die Limonade kostet fünfzig Cent.",
          "translation": "Лимонад стоит пятьдесят центов.",
          "source": "Tatoeba #12885949 @mhr / #12885433 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12885949",
          "cefr_level": "A1",
          "word_slugs": [
            "limonade-noun"
          ]
        }
      ],
      "tags": [
