          ]
        },
        {
          "id": "11759187",
          "text": "Wir haben die Tür aufgemacht.",
          "translation": "Мы открыли дверь.",
          "source": "Tatoeba #11759187 @mhr / #2987336 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11759187",
          "cefr_level": "A1",
          "word_slugs": [
