    {
      "slug": "vorgefallen-verb",
      "lemma": "vorgefallen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8942,
      "frequency_band": "goethe-c1",
      "translations": {
