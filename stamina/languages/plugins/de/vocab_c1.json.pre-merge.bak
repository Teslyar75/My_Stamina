    {
      "slug": "bogen-verb",
      "lemma": "bogen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6494,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person plural preterite of biegen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1204586",
          "text": "Sie bogen sich alle vor Lachen.",
          "translation": "Они все покатывались со смеху.",
          "source": "Tatoeba #1204586 @samueldora / #1948030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1204586",
          "cefr_level": "A1",
          "word_slugs": [
            "bogen-verb"
          ]
        }
      ],
      "tags": [
