          ]
        },
        {
          "id": "13445810",
          "text": "Was für Lehren können wir aus dieser Geschichte ziehen?",
          "translation": "Какие уроки мы можем извлечь из этой истории?",
          "source": "Tatoeba #13445810 @mhr / #13445557 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13445810",
          "cefr_level": "A1",
          "word_slugs": [
            "lehren-noun"
          ]
        },
        {
          "id": "372860",
          "text": "Lehren heißt lernen.",
          "translation": "Учить - это учиться.",
          "source": "Tatoeba #372860 @MUIRIEL / #1114766 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/372860",
          "cefr_level": "A1",
          "word_slugs": [
            "lehren-noun"
          ]
        },
        {
          "id": "466428",
          "text": "Lehren Sie Spanisch?",
          "translation": "Вы преподаёте испанский?",
          "source": "Tatoeba #466428 @mamat / #2758660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/466428",
          "cefr_level": "A1",
