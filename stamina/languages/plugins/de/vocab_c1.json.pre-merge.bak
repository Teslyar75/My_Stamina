    {
      "slug": "schlagt-verb",
      "lemma": "schlagt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7623,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person plural of schlagen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3276074",
          "text": "Was schlagt ihr vor?",
          "translation": "Что вы предлагаете?",
          "source": "Tatoeba #3276074 @Pfirsichbaeumchen / #3658562 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3276074",
          "cefr_level": "A1",
          "word_slugs": [
            "schlagt-verb"
          ]
        },
        {
          "id": "3106780",
          "text": "Schlagt Seite drei des Japanatlasses auf!",
          "translation": "Откройте атлас Японии на третьей странице.",
          "source": "Tatoeba #3106780 @Pfirsichbaeumchen / #745600 @nadya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3106780",
          "cefr_level": "A1",
          "word_slugs": [
            "schlagt-verb"
          ]
        },
        {
          "id": "703822",
          "text": "Schlagt euer Buch auf Seite zehn auf.",
          "translation": "Откройте книгу на десятой странице.",
          "source": "Tatoeba #703822 @Esperantostern / #13509123 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/703822",
          "cefr_level": "A1",
          "word_slugs": [
            "schlagt-verb"
          ]
        },
        {
          "id": "10289184",
          "text": "Schlagt in eurem Buch bitte Seite 8 auf.",
          "translation": "Откройте свои книги на восьмой странице, пожалуйста.",
          "source": "Tatoeba #10289184 @Pfirsichbaeumchen / #5968461 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10289184",
          "cefr_level": "A1",
          "word_slugs": [
            "schlagt-verb"
          ]
        }
