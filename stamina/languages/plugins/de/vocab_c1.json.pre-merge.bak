    {
      "slug": "blicke-noun",
      "lemma": "Blicke",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7651,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Blick"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11587741",
          "text": "Unsere Blicke haben sich gekreuzt.",
          "translation": "Наши взгляды встретились.",
          "source": "Tatoeba #11587741 @Adelpa / #5878147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11587741",
          "cefr_level": "A1",
          "word_slugs": [
            "blicke-noun"
          ]
        },
        {
          "id": "11587742",
          "text": "Unsere Blicke haben sich getroffen.",
          "translation": "Наши взгляды встретились.",
          "source": "Tatoeba #11587742 @Adelpa / #5878147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11587742",
          "cefr_level": "A1",
          "word_slugs": [
            "blicke-noun"
          ]
        },
        {
          "id": "4889317",
          "text": "Alle Blicke wandten sich zu ihr.",
          "translation": "Все взоры обратились на неё.",
          "source": "Tatoeba #4889317 @al_ex_an_der / #13606978 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4889317",
          "cefr_level": "A1",
          "word_slugs": [
            "blicke-noun"
          ]
        },
        {
          "id": "13607037",
          "text": "Alle Blicke richteten sich auf sie.",
          "translation": "Все взоры обратились на неё.",
          "source": "Tatoeba #13607037 @mhr / #13606978 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13607037",
          "cefr_level": "A1",
          "word_slugs": [
            "blicke-noun"
          ]
        },
        {
          "id": "674784",
          "text": "Wenn Blicke töten könnten, dann wäre ich jetzt schon tot.",
          "translation": "Если бы можно было убивать взглядом, то я бы уже умер.",
          "source": "Tatoeba #674784 @Esperantostern / #1049320 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/674784",
          "cefr_level": "A1",
          "word_slugs": [
            "blicke-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
