        ],
        "en": [
          "lattice, grid, mesh (of metal), grating, bars",
          "lattice",
          "bars (i.e. prison)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "12384032",
          "text": "Tom gehört hinter Gitter.",
          "translation": "Тому место за решёткой.",
          "source": "Tatoeba #12384032 @brauchinet / #12388436 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12384032",
          "cefr_level": "A1",
          "word_slugs": [
