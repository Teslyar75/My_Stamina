          ]
        },
        {
          "id": "8406369",
          "text": "Ich habe drei Kühe.",
          "translation": "У меня три коровы.",
          "source": "Tatoeba #8406369 @Adelpa / #5928471 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8406369",
