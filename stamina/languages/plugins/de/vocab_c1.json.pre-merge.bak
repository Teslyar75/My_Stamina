        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1635812",
          "text": "Niemals werde ich diese schreckliche Episode meiner Kindheit vergessen könnte.",
          "translation": "Я никогда не смогу забыть этот ужасный эпизод из своего детства.",
          "source": "Tatoeba #1635812 @al_ex_an_der / #8210329 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1635812",
          "cefr_level": "A1",
          "word_slugs": [
            "episode-noun"
          ]
        },
        {
          "id": "256",
          "text": "Aber im Ernst, die Episode 21 hat mich fast vor Lachen weinen lassen.",
          "translation": "На самом деле я смеялся до слёз над эпизодом 21.",
          "source": "Tatoeba #256 @MUIRIEL / #5586 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/256",
          "cefr_level": "A1",
          "word_slugs": [
            "episode-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Episode",
        "nominative_pl": ""
      }
