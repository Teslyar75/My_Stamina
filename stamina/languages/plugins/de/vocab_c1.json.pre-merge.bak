      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7018,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "444316",
          "text": "Er zitiert oft Shakespeare.",
          "translation": "Он часто цитирует Шекспира.",
          "source": "Tatoeba #444316 @MUIRIEL / #1497431 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/444316",
          "cefr_level": "A1",
          "word_slugs": [
            "shakespeare-name"
          ]
        },
        {
          "id": "4701286",
          "text": "Tom zitiert oft Shakespeare.",
          "translation": "Том часто цитирует Шекспира.",
          "source": "Tatoeba #4701286 @Esperantostern / #4709888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4701286",
          "cefr_level": "A1",
          "word_slugs": [
            "shakespeare-name"
          ]
        },
        {
          "id": "2328867",
          "text": "Was hat Shakespeare geschrieben?",
          "translation": "Что написал Шекспир?",
          "source": "Tatoeba #2328867 @BraveSentry / #2583123 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2328867",
          "cefr_level": "A1",
          "word_slugs": [
            "shakespeare-name"
          ]
        },
        {
          "id": "5647198",
          "text": "Ich lese etwas von Shakespeare.",
          "translation": "Я читаю кое-что из Шекспира.",
          "source": "Tatoeba #5647198 @Esperantostern / #5650997 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5647198",
          "cefr_level": "A1",
          "word_slugs": [
            "shakespeare-name"
          ]
        },
        {
          "id": "6173850",
          "text": "Er zitiert Shakespeare im Original.",
          "translation": "Он цитирует Шекспира на языке оригинала.",
          "source": "Tatoeba #6173850 @Pfirsichbaeumchen / #6142696 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6173850",
          "cefr_level": "A1",
          "word_slugs": [
            "shakespeare-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
