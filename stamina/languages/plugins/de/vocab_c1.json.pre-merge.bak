    {
      "slug": "höchst-adj",
      "lemma": "höchst",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5239,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "superlative degree of hoch: highest"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2458031",
          "text": "Das ist höchst wahrscheinlich Unsinn.",
          "translation": "Это, вероятно, ерунда.",
          "source": "Tatoeba #2458031 @al_ex_an_der / #2458026 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2458031",
          "cefr_level": "A1",
          "word_slugs": [
            "höchst-adj"
          ]
        },
        {
          "id": "13038184",
          "text": "Wir leben in einer höchst interessanten Zeit.",
          "translation": "Мы живём в интереснейшее время.",
          "source": "Tatoeba #13038184 @mhr / #13038167 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13038184",
          "cefr_level": "A1",
          "word_slugs": [
            "höchst-adj"
          ]
        },
        {
          "id": "568496",
          "text": "Ich habe gestern einen höchst interessanten Roman gelesen.",
          "translation": "Я вчера прочёл преинтереснейший роман.",
          "source": "Tatoeba #568496 @lilygilder / #4515821 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/568496",
          "cefr_level": "A1",
          "word_slugs": [
            "höchst-adj"
          ]
        },
        {
          "id": "3521558",
          "text": "Das ist ein Argument, das ich höchst befremdlich finde.",
          "translation": "Такой аргумент мне кажется в высшей степени странным.",
          "source": "Tatoeba #3521558 @Pfirsichbaeumchen / #3521628 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3521558",
          "cefr_level": "A1",
          "word_slugs": [
            "höchst-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
