      "gender": "m",
      "examples": [
        {
          "id": "1186687",
          "text": "Ich liebe dich unendlich.",
          "translation": "Я люблю тебя бесконечно.",
          "source": "Tatoeba #1186687 @al_ex_an_der / #12000233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1186687",
          "cefr_level": "A1",
          "word_slugs": [
            "unendlich-adj"
          ]
        },
        {
          "id": "708081",
          "text": "Das Universum ist unendlich.",
          "translation": "Вселенная бесконечна.",
          "source": "Tatoeba #708081 @MUIRIEL / #1223357 @poji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/708081",
          "cefr_level": "A1",
          "word_slugs": [
            "unendlich-adj"
          ]
        },
        {
          "id": "12824346",
          "text": "Der Weltraum scheint unendlich.",
          "translation": "Космос кажется бесконечным.",
          "source": "Tatoeba #12824346 @Waldelfe / #12503408 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12824346",
          "cefr_level": "A1",
          "word_slugs": [
            "unendlich-adj"
          ]
        },
        {
          "id": "4807252",
          "text": "Ist der Kosmos unendlich groß?",
          "translation": "Космос бесконечно большой?",
          "source": "Tatoeba #4807252 @brauchinet / #9147211 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4807252",
          "cefr_level": "A1",
          "word_slugs": [
            "unendlich-adj"
          ]
        },
        {
          "id": "10695687",
          "text": "Es gibt unendlich viele Zahlen.",
          "translation": "Чисел бесконечное множество.",
          "source": "Tatoeba #10695687 @Pfirsichbaeumchen / #12401942 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10695687",
          "cefr_level": "A1",
          "word_slugs": [
            "unendlich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der unendlich",
