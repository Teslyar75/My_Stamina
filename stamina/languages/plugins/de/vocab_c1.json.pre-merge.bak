    {
      "slug": "sicherstellen-verb",
      "lemma": "sicherstellen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6384,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to seize, confiscate a physical object as a measure to avert danger (a Gefahrenabwehrmaßnahme)",
          "to ensure, to make sure, to guarantee"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11206576",
          "text": "Ich will einfach sicherstellen, dass du vorbereitet bist.",
          "translation": "Я просто хочу убедиться, что ты готов.",
          "source": "Tatoeba #11206576 @Pfirsichbaeumchen / #8173521 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11206576",
          "cefr_level": "A1",
          "word_slugs": [
            "sicherstellen-verb"
          ]
        },
        {
          "id": "13766816",
          "text": "Ich will sicherstellen, dass wir nicht denselben Fehler wie Tom machen.",
          "translation": "Я хочу убедиться, что мы не сделаем ту же ошибку, что и Том.",
          "source": "Tatoeba #13766816 @mhr / #13766773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13766816",
          "cefr_level": "A1",
          "word_slugs": [
            "sicherstellen-verb"
          ]
        },
        {
          "id": "13766813",
          "text": "Ich will sicherstellen, dass wir nicht denselben Fehler wie Tom begehen.",
          "translation": "Я хочу убедиться, что мы не совершим ту же ошибку, что и Том.",
          "source": "Tatoeba #13766813 @mhr / #13766774 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13766813",
          "cefr_level": "A1",
          "word_slugs": [
            "sicherstellen-verb"
          ]
        },
        {
          "id": "13766818",
          "text": "Ich möchte sicherstellen, dass wir nicht denselben Fehler wie Tom machen.",
          "translation": "Я хочу убедиться, что мы не сделаем ту же ошибку, что и Том.",
          "source": "Tatoeba #13766818 @mhr / #13766773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13766818",
          "cefr_level": "A1",
          "word_slugs": [
            "sicherstellen-verb"
          ]
        },
        {
          "id": "13766814",
          "text": "Ich möchte sicherstellen, dass wir nicht denselben Fehler wie Tom begehen.",
          "translation": "Я хочу убедиться, что мы не совершим ту же ошибку, что и Том.",
          "source": "Tatoeba #13766814 @mhr / #13766774 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13766814",
