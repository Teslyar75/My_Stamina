      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to determine, to identify (a value or identity; through a calculation or other process)",
          "to investigate (by the police)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2739040",
          "text": "Wir werden in dieser Sache ermitteln.",
          "translation": "Мы расследуем это дело.",
          "source": "Tatoeba #2739040 @Pfirsichbaeumchen / #2739018 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2739040",
          "cefr_level": "A1",
          "word_slugs": [
            "ermitteln-verb"
          ]
        },
        {
          "id": "4517208",
          "text": "Wir ermitteln die Ursachen des Unfalls.",
          "translation": "Мы разузнаем всё по этому вопросу.",
          "source": "Tatoeba #4517208 @Esperantostern / #4903578 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4517208",
          "cefr_level": "A1",
          "word_slugs": [
            "ermitteln-verb"
          ]
        },
        {
          "id": "1862988",
          "text": "Bitte ermitteln Sie den Flächeninhalt des Dreiecks.",
          "translation": "Пожалуйста, определите площадь треугольника.",
          "source": "Tatoeba #1862988 @Zaghawa / #9151837 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1862988",
          "cefr_level": "A1",
          "word_slugs": [
            "ermitteln-verb"
          ]
        }
      ],
