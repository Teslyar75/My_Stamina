    {
      "slug": "ernte-noun",
      "lemma": "Ernte",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6536,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "harvest"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "598820",
          "text": "Der Regen vernichtete die Ernte.",
          "translation": "Дождь уничтожил урожай.",
          "source": "Tatoeba #598820 @Manfredo / #5802753 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/598820",
          "cefr_level": "A1",
          "word_slugs": [
            "ernte-noun"
          ]
        },
        {
          "id": "1058564",
          "text": "Wie die Saat, so die Ernte.",
          "translation": "Что посеешь, то и пожнёшь.",
          "source": "Tatoeba #1058564 @Esperantostern / #572307 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1058564",
          "cefr_level": "A1",
          "word_slugs": [
            "ernte-noun"
          ]
        },
        {
          "id": "2685359",
          "text": "Diese Felder erbringen eine gute Ernte.",
          "translation": "На этом поле хороший урожай.",
          "source": "Tatoeba #2685359 @Tamy / #5652400 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2685359",
          "cefr_level": "A1",
          "word_slugs": [
            "ernte-noun"
          ]
        },
        {
          "id": "6855758",
          "text": "Das Wetter war gut für die Ernte.",
          "translation": "Была хорошая погода для сбора урожая.",
          "source": "Tatoeba #6855758 @Esperantostern / #6858452 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6855758",
          "cefr_level": "A1",
          "word_slugs": [
            "ernte-noun"
          ]
        },
        {
          "id": "367478",
          "text": "Der Weizen ist reif für die Ernte.",
          "translation": "Пшеница созрела для сбора урожая.",
          "source": "Tatoeba #367478 @Wolf / #1221875 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/367478",
          "cefr_level": "A1",
          "word_slugs": [
            "ernte-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
