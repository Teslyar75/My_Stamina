    {
      "slug": "vorübergehend-verb",
      "lemma": "vorübergehend",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5630,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
