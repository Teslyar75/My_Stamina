        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "450626",
          "text": "Er hat feste Prinzipien.",
          "translation": "У него твёрдые принципы.",
          "source": "Tatoeba #450626 @Pfirsichbaeumchen / #4559193 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/450626",
          "cefr_level": "A1",
          "word_slugs": [
            "feste-adj"
          ]
        },
        {
          "id": "10502236",
          "text": "Tom hat eine feste Arbeit.",
          "translation": "У Тома есть стабильная работа.",
          "source": "Tatoeba #10502236 @Pfirsichbaeumchen / #7028299 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10502236",
          "cefr_level": "A1",
          "word_slugs": [
            "feste-adj"
          ]
        },
        {
          "id": "7564575",
          "text": "Tom hat keine feste Arbeit.",
          "translation": "У Тома нет постоянной работы.",
          "source": "Tatoeba #7564575 @Pfirsichbaeumchen / #7563764 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7564575",
          "cefr_level": "A1",
          "word_slugs": [
            "feste-adj"
          ]
        },
        {
          "id": "1293242",
          "text": "Hast du eine feste Freundin?",
          "translation": "У тебя есть постоянная девушка?",
          "source": "Tatoeba #1293242 @Esperantostern / #3804616 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1293242",
          "cefr_level": "A1",
          "word_slugs": [
            "feste-adj"
          ]
        },
        {
          "id": "8269236",
          "text": "Eine feste Arbeit ist besser als eine temporäre.",
          "translation": "Постоянная работа лучше временной.",
          "source": "Tatoeba #8269236 @kutschektar / #9021936 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8269236",
          "cefr_level": "A1",
          "word_slugs": [
            "feste-adj"
          ]
        }
      ],
