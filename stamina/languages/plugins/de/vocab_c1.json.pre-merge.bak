          "plural imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12855560",
          "text": "Wo schlaft ihr nachts?",
          "translation": "Где вы спите по ночам?",
          "source": "Tatoeba #12855560 @mhr / #12855552 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12855560",
          "cefr_level": "A1",
          "word_slugs": [
            "schlaft-verb"
          ]
        },
        {
          "id": "12004240",
          "text": "Warum schlaft ihr nicht?",
          "translation": "Вы почему не спите?",
          "source": "Tatoeba #12004240 @Augustus / #5606822 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12004240",
          "cefr_level": "A1",
          "word_slugs": [
            "schlaft-verb"
          ]
        },
        {
          "id": "7857718",
          "text": "Schlaft nicht zu dicht am Feuer!",
          "translation": "Не спите слишком близко к костру.",
          "source": "Tatoeba #7857718 @Pfirsichbaeumchen / #5360507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7857718",
          "cefr_level": "A1",
          "word_slugs": [
            "schlaft-verb"
          ]
        },
        {
          "id": "12551321",
          "text": "Ich wußte nicht, daß ihr schlaft.",
          "translation": "Я не знал, что вы спите.",
          "source": "Tatoeba #12551321 @Waldelfe / #7139624 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12551321",
          "cefr_level": "A1",
          "word_slugs": [
            "schlaft-verb"
          ]
        },
        {
          "id": "13445805",
          "text": "Warum schlaft ihr immer noch nicht?",
          "translation": "Вы чего до сих пор не спите?",
          "source": "Tatoeba #13445805 @mhr / #13445563 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13445805",
          "cefr_level": "A1",
          "word_slugs": [
            "schlaft-verb"
          ]
        }
      ],
