          "source": "Tatoeba #2283523 @Pfirsichbaeumchen / #1576481 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2283523",
          "cefr_level": "A1",
          "word_slugs": [
            "geradeaus-adv"
          ]
        },
        {
          "id": "2709146",
          "text": "Geht diese Straße geradeaus.",
          "translation": "Идите прямо по этой улице.",
          "source": "Tatoeba #2709146 @Tamy / #645844 @vlad2k (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2709146",
          "cefr_level": "A1",
          "word_slugs": [
            "geradeaus-adv"
          ]
        },
        {
          "id": "900104",
          "text": "Erst geradeaus, dann nach rechts, und dann?",
          "translation": "Сначала прямо, потом направо, а потом?",
          "source": "Tatoeba #900104 @Esperantostern / #3072414 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/900104",
          "cefr_level": "A1",
          "word_slugs": [
            "geradeaus-adv"
          ]
        }
