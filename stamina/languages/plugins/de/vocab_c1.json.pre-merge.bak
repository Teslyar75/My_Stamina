    {
      "slug": "vorzubereiten-verb",
      "lemma": "vorzubereiten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7627,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of vorbereiten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1939012",
          "text": "Ich begann, mich vorzubereiten.",
          "translation": "Я начал готовиться.",
          "source": "Tatoeba #1939012 @al_ex_an_der / #5130768 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1939012",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzubereiten-verb"
          ]
        },
        {
          "id": "7712539",
          "text": "Er ist beschäftigt, das Examen vorzubereiten.",
          "translation": "Он занят подготовкой к экзамену.",
          "source": "Tatoeba #7712539 @wolfgangth / #1927553 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7712539",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzubereiten-verb"
          ]
        },
        {
          "id": "11505837",
          "text": "Du brauchst keine offizielle Rede vorzubereiten.",
          "translation": "Тебе не нужно готовить официальную речь.",
          "source": "Tatoeba #11505837 @Pfirsichbaeumchen / #2426043 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11505837",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzubereiten-verb"
          ]
        },
        {
          "id": "12777919",
          "text": "Wir haben noch Zeit, um uns vorzubereiten.",
          "translation": "Ещё есть время подготовиться.",
          "source": "Tatoeba #12777919 @mhr / #12777909 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12777919",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzubereiten-verb"
          ]
        },
        {
          "id": "13949468",
          "text": "Ich habe kaum Zeit, um mich vorzubereiten.",
          "translation": "Я едва успеваю подготовиться.",
          "source": "Tatoeba #13949468 @Waldelfe / #13949495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13949468",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzubereiten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
