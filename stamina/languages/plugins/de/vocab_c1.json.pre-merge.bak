          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1907128",
          "text": "Das dauerte nicht lange.",
          "translation": "Это не заняло много времени.",
          "source": "Tatoeba #1907128 @Pfirsichbaeumchen / #4584190 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1907128",
          "cefr_level": "A1",
          "word_slugs": [
            "dauerte-verb"
          ]
        },
        {
          "id": "1487632",
          "text": "Der Krieg dauerte vier Jahre.",
          "translation": "Война продолжалась четыре года.",
          "source": "Tatoeba #1487632 @Esperantostern / #1775347 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1487632",
          "cefr_level": "A1",
          "word_slugs": [
            "dauerte-verb"
          ]
        },
        {
          "id": "1916310",
          "text": "Der Krieg dauerte zwei Jahre.",
          "translation": "Война длилась два года.",
          "source": "Tatoeba #1916310 @Esperantostern / #1434649 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1916310",
          "cefr_level": "A1",
          "word_slugs": [
            "dauerte-verb"
          ]
        },
        {
          "id": "2677944",
          "text": "Die Reise dauerte eine Woche.",
          "translation": "Поездка продолжалась неделю.",
          "source": "Tatoeba #2677944 @al_ex_an_der / #11830118 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2677944",
          "cefr_level": "A1",
          "word_slugs": [
            "dauerte-verb"
          ]
        },
        {
          "id": "8490521",
          "text": "Der Flug dauerte zwei Stunden.",
          "translation": "Полёт продолжался два часа.",
          "source": "Tatoeba #8490521 @felix63 / #13077104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8490521",
          "cefr_level": "A1",
          "word_slugs": [
            "dauerte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
