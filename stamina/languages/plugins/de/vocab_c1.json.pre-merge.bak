    {
      "slug": "bemerkte-verb",
      "lemma": "bemerkte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8354,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bemerken:",
          "first/third-person singular preterite",
          "inflection of bemerken:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13407179",
          "text": "Ich bemerkte Tom.",
          "translation": "Я заметил Тома.",
          "source": "Tatoeba #13407179 @mhr / #8815438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13407179",
          "cefr_level": "A1",
          "word_slugs": [
            "bemerkte-verb"
          ]
        },
        {
          "id": "7004131",
          "text": "Niemand bemerkte mich.",
          "translation": "Никто меня не заметил.",
          "source": "Tatoeba #7004131 @Pfirsichbaeumchen / #4320569 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7004131",
          "cefr_level": "A1",
          "word_slugs": [
            "bemerkte-verb"
          ]
        },
        {
          "id": "3500780",
          "text": "Mich bemerkte sie nicht.",
          "translation": "Меня она не заметила.",
