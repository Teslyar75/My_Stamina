      "gender": "f",
      "examples": [
        {
          "id": "13631520",
          "text": "Tom nimmt auf niemanden Rücksicht.",
          "translation": "Том ни с кем не считается.",
          "source": "Tatoeba #13631520 @felix63 / #13870502 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13631520",
