      },
      "gender": null,
      "examples": [
        {
          "id": "2415478",
          "text": "Diese Schublade klemmt.",
          "translation": "Этот ящик застрял.",
          "source": "Tatoeba #2415478 @Zaghawa / #3350339 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2415478",
          "cefr_level": "A1",
          "word_slugs": [
            "schublade-noun"
          ]
        },
        {
          "id": "11531058",
          "text": "Leeren Sie die Schublade.",
          "translation": "Освободите ящик.",
          "source": "Tatoeba #11531058 @Bernie75 / #3854367 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11531058",
          "cefr_level": "A1",
          "word_slugs": [
            "schublade-noun"
          ]
        },
        {
          "id": "12815019",
          "text": "Was ist in der mittleren Schublade?",
          "translation": "Что в среднем ящике?",
          "source": "Tatoeba #12815019 @Waldelfe / #9433566 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12815019",
          "cefr_level": "A1",
          "word_slugs": [
