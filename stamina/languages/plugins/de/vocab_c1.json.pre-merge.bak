      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6174,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "shore, shoreline",
          "bank"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3510178",
          "text": "Er stand unmittelbar am Ufer.",
          "translation": "Он стоял на самом берегу.",
          "source": "Tatoeba #3510178 @al_ex_an_der / #3510175 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3510178",
          "cefr_level": "A1",
          "word_slugs": [
            "ufer-noun"
          ]
        },
        {
          "id": "2290176",
          "text": "Der Fluss trat über die Ufer.",
          "translation": "Река вышла из берегов.",
          "source": "Tatoeba #2290176 @Pfirsichbaeumchen / #1738717 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2290176",
          "cefr_level": "A1",
          "word_slugs": [
            "ufer-noun"
          ]
        },
        {
          "id": "568487",
          "text": "Der Fluss trat über seine Ufer.",
          "translation": "Река вышла из берегов.",
          "source": "Tatoeba #568487 @xtofu80 / #1738717 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/568487",
          "cefr_level": "A1",
          "word_slugs": [
            "ufer-noun"
          ]
        },
        {
          "id": "2196948",
          "text": "Die Uferstraße liegt parallel zum Ufer.",
          "translation": "Набережная расположена параллельно берегу.",
          "source": "Tatoeba #2196948 @al_ex_an_der / #2196940 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2196948",
          "cefr_level": "A1",
          "word_slugs": [
            "ufer-noun"
          ]
        },
        {
          "id": "3558056",
          "text": "Ein Mann angelte am gegenüberliegenden Ufer.",
          "translation": "Какой-то мужчина ловил рыбу на противоположном берегу.",
          "source": "Tatoeba #3558056 @Manfredo / #3559084 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3558056",
          "cefr_level": "A1",
          "word_slugs": [
            "ufer-noun"
          ]
        }
      ],
