          ]
        },
        {
          "id": "2446154",
          "text": "Ich muss eine Fee finden.",
          "translation": "Мне нужно найти фею.",
          "source": "Tatoeba #2446154 @al_ex_an_der / #2446135 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2446154",
          "cefr_level": "A1",
