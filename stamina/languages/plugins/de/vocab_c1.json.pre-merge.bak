          "cefr_level": "A1",
          "word_slugs": [
            "aufgezogen-verb"
          ]
        },
        {
          "id": "1796279",
          "text": "Er wurde von seinen Großeltern aufgezogen.",
          "translation": "Он был воспитан бабушкой и дедушкой.",
          "source": "Tatoeba #1796279 @Pfirsichbaeumchen / #3874742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1796279",
          "cefr_level": "A1",
          "word_slugs": [
