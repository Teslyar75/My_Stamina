          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5489551",
          "text": "Sie mag russische Popmusik.",
          "translation": "Ей нравится русская попса.",
          "source": "Tatoeba #5489551 @wolfgangth / #398996 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489551",
          "cefr_level": "A1",
          "word_slugs": [
