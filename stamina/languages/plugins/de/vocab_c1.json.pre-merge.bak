    {
      "slug": "liebend-verb",
      "lemma": "liebend",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6461,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "present participle of lieben"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1552407",
          "text": "Er macht liebend gern aus einer Mücke einen Elefanten.",
          "translation": "Он любит делать из мухи слона.",
          "source": "Tatoeba #1552407 @Pfirsichbaeumchen / #3075044 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1552407",
          "cefr_level": "A1",
          "word_slugs": [
            "liebend-verb"
          ]
        },
        {
          "id": "5881026",
          "text": "Der Herzog erhob sich und küsste liebend seine Gemahlin.",
          "translation": "Герцог встал и с любовью поцеловал жену.",
          "source": "Tatoeba #5881026 @Pfirsichbaeumchen / #5474333 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5881026",
          "cefr_level": "A1",
          "word_slugs": [
            "liebend-verb"
          ]
        },
        {
          "id": "985430",
          "text": "Ich würde liebend gerne mit euch kommen, aber ich habe kein Geld.",
          "translation": "Мне бы очень хотелось пойти с вами, но у меня нет денег.",
          "source": "Tatoeba #985430 @MUIRIEL / #5008399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/985430",
          "cefr_level": "A1",
          "word_slugs": [
            "liebend-verb"
          ]
        },
        {
          "id": "5097708",
          "text": "Liebend gerne komme ich mit, ich habe heute Nachmittag eh nichts geplant.",
          "translation": "Я с большим удовольствием присоединюсь, я всё равно на сегодняшний вечер ничего не планировал.",
          "source": "Tatoeba #5097708 @ruth_tatoeba / #5098953 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5097708",
          "cefr_level": "A1",
          "word_slugs": [
            "liebend-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der liebend",
        "nominative_pl": ""
      }
    },
