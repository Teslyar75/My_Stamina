          ]
        },
        {
          "id": "8206893",
          "text": "Ich möchte mich nicht darauf einlassen.",
          "translation": "Я не хочу в это ввязываться.",
          "source": "Tatoeba #8206893 @raggione / #6594791 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8206893",
          "cefr_level": "A1",
          "word_slugs": [
            "einlassen-verb"
          ]
        },
        {
          "id": "9816383",
          "text": "Ich hätte mich nicht darauf einlassen sollen.",
          "translation": "Не надо было мне в это ввязываться.",
          "source": "Tatoeba #9816383 @schwetterling / #9816385 @schwetterling (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9816383",
          "cefr_level": "A1",
          "word_slugs": [
            "einlassen-verb"
          ]
        }
      ],
      "tags": [
