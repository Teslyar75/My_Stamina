    {
      "slug": "nationen-noun",
      "lemma": "Nationen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8816,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Nation"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10658468",
          "text": "Spanien war eine der mächstigsten Nationen.",
          "translation": "Испания была одной из самых могущественных наций.",
          "source": "Tatoeba #10658468 @Pfirsichbaeumchen / #1525171 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10658468",
          "cefr_level": "A1",
          "word_slugs": [
            "nationen-noun"
          ]
        },
        {
          "id": "1463425",
          "text": "Das Gebäude der Vereinten Nationen wurde 1952 gebaut.",
          "translation": "Здание ООН было построено в 1952 году.",
          "source": "Tatoeba #1463425 @Espi / #4381556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1463425",
          "cefr_level": "A1",
          "word_slugs": [
            "nationen-noun"
          ]
        },
        {
          "id": "140003",
          "text": "Die Vereinten Nationen sind eine internationale Organisation.",
          "translation": "ООН - международная организация.",
          "source": "Tatoeba #140003 @MUIRIEL / #11158066 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/140003",
          "cefr_level": "A1",
          "word_slugs": [
            "nationen-noun"
          ]
        },
        {
          "id": "3068397",
          "text": "Die Ukraine bittet den Sicherheitsrat der Vereinten Nationen um Hilfe.",
          "translation": "Украина просит помощи у Совета Безопасности Организации Объединенных Наций.",
          "source": "Tatoeba #3068397 @al_ex_an_der / #3068399 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3068397",
          "cefr_level": "A1",
          "word_slugs": [
            "nationen-noun"
          ]
        }
      ],
