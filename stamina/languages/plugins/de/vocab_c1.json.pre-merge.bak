            "bezaubernd-verb"
          ]
        },
        {
          "id": "4736274",
          "text": "Sie sind bezaubernd.",
          "translation": "Вы обворожительны.",
          "source": "Tatoeba #4736274 @Manfredo / #5549953 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4736274",
          "cefr_level": "A1",
          "word_slugs": [
            "bezaubernd-verb"
          ]
        },
        {
          "id": "12378609",
          "text": "Sie ist klug und bezaubernd.",
          "translation": "Она умна и очаровательна.",
          "source": "Tatoeba #12378609 @Bernie75 / #3319797 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12378609",
          "cefr_level": "A1",
          "word_slugs": [
            "bezaubernd-verb"
          ]
        },
        {
          "id": "13826272",
          "text": "Ihr kindliches Lachen ist bezaubernd.",
          "translation": "Её ребяческий смех очарователен.",
          "source": "Tatoeba #13826272 @mhr / #13826257 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13826272",
          "cefr_level": "A1",
          "word_slugs": [
            "bezaubernd-verb"
          ]
        },
        {
          "id": "1835587",
          "text": "Sie sieht sehr bezaubernd aus, so in weiß gekleidet.",
          "translation": "Она выглядит очаровательно, одетая в белое.",
          "source": "Tatoeba #1835587 @Tamy / #2962271 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1835587",
