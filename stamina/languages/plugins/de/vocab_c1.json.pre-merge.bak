    {
      "slug": "vorerst-adv",
      "lemma": "vorerst",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7347,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "for now, for the time being"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13922158",
          "text": "Vergiss das vorerst!",
          "translation": "Забудь пока об этом.",
          "source": "Tatoeba #13922158 @mhr / #13922166 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13922158",
          "cefr_level": "A1",
          "word_slugs": [
            "vorerst-adv"
          ]
        },
        {
          "id": "8014441",
          "text": "Wir sind vorerst in Sicherheit.",
          "translation": "Пока мы в безопасности.",
          "source": "Tatoeba #8014441 @Pfirsichbaeumchen / #4336242 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8014441",
          "cefr_level": "A1",
          "word_slugs": [
            "vorerst-adv"
          ]
        },
        {
          "id": "7885071",
          "text": "Wir haben ihm vorerst nichts gesagt.",
          "translation": "Мы ему пока не сказали.",
          "source": "Tatoeba #7885071 @Pfirsichbaeumchen / #7882479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7885071",
          "cefr_level": "A1",
          "word_slugs": [
            "vorerst-adv"
          ]
        },
        {
          "id": "13105152",
          "text": "Wir brauchen ihre Hilfe vorerst nicht.",
          "translation": "Нам пока не нужна её помощь.",
          "source": "Tatoeba #13105152 @Pfirsichbaeumchen / #13105148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13105152",
          "cefr_level": "A1",
          "word_slugs": [
            "vorerst-adv"
          ]
        },
        {
          "id": "13105153",
          "text": "Wir brauchen seine Hilfe vorerst nicht.",
          "translation": "Нам пока не нужна его помощь.",
          "source": "Tatoeba #13105153 @Pfirsichbaeumchen / #13105147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13105153",
          "cefr_level": "A1",
          "word_slugs": [
            "vorerst-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
