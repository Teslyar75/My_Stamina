          ]
        },
        {
          "id": "4902055",
          "text": "Tom hat mir viel über Sie berichtet.",
          "translation": "Том мне много о Вас рассказывал.",
          "source": "Tatoeba #4902055 @Zaghawa / #4658904 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4902055",
          "cefr_level": "A1",
          "word_slugs": [
            "berichtet-verb"
          ]
        },
        {
          "id": "13045781",
          "text": "Die Polizei hat uns vom Unfall berichtet.",
