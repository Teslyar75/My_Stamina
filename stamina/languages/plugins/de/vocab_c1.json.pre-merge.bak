    {
      "slug": "springe-verb",
      "lemma": "springe",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9163,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of springen:",
          "first-person singular present",
          "inflection of springen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1714617",
          "text": "Ich springe vor Freude.",
          "translation": "Я прыгаю от радости.",
          "source": "Tatoeba #1714617 @Pfirsichbaeumchen / #1942012 @Yanka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1714617",
          "cefr_level": "A1",
          "word_slugs": [
            "springe-verb"
          ]
        },
        {
          "id": "6797309",
          "text": "Wenn mein Wecker rasselt, springe ich sofort aus dem Bett.",
          "translation": "Когда мой будильник звенит, я тут же выпрыгиваю из постели.",
          "source": "Tatoeba #6797309 @raggione / #6798261 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797309",
          "cefr_level": "A1",
          "word_slugs": [
            "springe-verb"
          ]
        },
        {
          "id": "13932589",
          "text": "Wenn mein Wecker klingelt, springe ich sofort aus dem Bett.",
          "translation": "Когда у меня звонит будильник, я сразу выпрыгиваю из постели.",
          "source": "Tatoeba #13932589 @mhr / #13932582 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13932589",
          "cefr_level": "A1",
          "word_slugs": [
