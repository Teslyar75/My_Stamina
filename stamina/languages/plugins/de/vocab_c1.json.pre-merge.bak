        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4760647",
          "text": "Führst du oft Selbstgespräche?",
          "translation": "Ты часто разговариваешь сама с собой?",
          "source": "Tatoeba #4760647 @raggione / #7983772 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4760647",
          "cefr_level": "A1",
          "word_slugs": [
            "führst-verb"
          ]
        },
        {
          "id": "1049898",
          "text": "Du führst doch was im Schilde.",
          "translation": "Ты что-то замышляешь.",
          "source": "Tatoeba #1049898 @Sudajaengi / #565357 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1049898",
          "cefr_level": "A1",
          "word_slugs": [
            "führst-verb"
          ]
        },
        {
          "id": "1909144",
          "text": "Du führst dich auf wie ein Kind.",
          "translation": "Ты ведёшь себя как ребёнок.",
          "source": "Tatoeba #1909144 @Pfirsichbaeumchen / #4066474 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1909144",
          "cefr_level": "A1",
          "word_slugs": [
            "führst-verb"
          ]
        },
        {
          "id": "7977199",
          "text": "Wir wissen, was du im Schilde führst.",
          "translation": "Мы знаем, что ты замышляешь.",
          "source": "Tatoeba #7977199 @brauchinet / #12264872 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7977199",
          "cefr_level": "A1",
          "word_slugs": [
            "führst-verb"
          ]
        }
