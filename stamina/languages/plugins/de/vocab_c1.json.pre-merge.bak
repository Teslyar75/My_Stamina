          ]
        },
        {
          "id": "13717233",
          "text": "Die Raupe fraß alle Blätter.",
          "translation": "Гусеница съела все листья.",
          "source": "Tatoeba #13717233 @Rovo / #13759619 @Alex_M (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13717233",
