          ]
        },
        {
          "id": "12372272",
          "text": "Könntest du das Licht einschalten?",
          "translation": "Ты не мог бы включить свет?",
          "source": "Tatoeba #12372272 @Pfirsichbaeumchen / #12372183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12372272",
          "cefr_level": "A1",
