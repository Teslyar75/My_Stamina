      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9574,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of beruhen:",
          "third-person singular present",
          "inflection of beruhen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "736423",
          "text": "Wissenschaft beruht auf Beobachtung.",
          "translation": "Наука базируется на наблюдении.",
          "source": "Tatoeba #736423 @Manfredo / #4846928 @margo1kurilenko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/736423",
          "cefr_level": "A1",
          "word_slugs": [
            "beruht-verb"
          ]
        },
        {
          "id": "6682189",
          "text": "Die Teilnahme beruht auf freiwilliger Basis.",
          "translation": "Участие осуществляется на добровольной основе.",
          "source": "Tatoeba #6682189 @srovorake / #4404420 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6682189",
          "cefr_level": "A1",
          "word_slugs": [
            "beruht-verb"
          ]
        },
        {
          "id": "5941467",
          "text": "Dieser Roman beruht auf wahren Begebenheiten.",
          "translation": "В основе этого романа реальные события.",
          "source": "Tatoeba #5941467 @Pfirsichbaeumchen / #5657553 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5941467",
          "cefr_level": "A1",
          "word_slugs": [
            "beruht-verb"
          ]
        },
        {
          "id": "4268735",
          "text": "Die Kraft des Leberwurstbaumes beruht auf seinen Wurzeln.",
          "translation": "Сила баобаба - в его корнях.",
          "source": "Tatoeba #4268735 @Esperantostern / #4269803 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4268735",
          "cefr_level": "A1",
          "word_slugs": [
            "beruht-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
