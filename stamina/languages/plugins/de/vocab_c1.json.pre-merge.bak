        },
        {
          "id": "6449775",
          "text": "Mary trug ein blaues Kleid.",
          "translation": "Мэри была в синем платье.",
          "source": "Tatoeba #6449775 @ruth_tatoeba / #6794137 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6449775",
          "cefr_level": "A1",
          "word_slugs": [
            "blaues-adj"
          ]
        },
        {
          "id": "8085848",
          "text": "Sie hat ein blaues Fahrrad.",
          "translation": "У неё голубой велосипед.",
          "source": "Tatoeba #8085848 @Pfirsichbaeumchen / #1656139 @sonick_rnd (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8085848",
          "cefr_level": "A1",
