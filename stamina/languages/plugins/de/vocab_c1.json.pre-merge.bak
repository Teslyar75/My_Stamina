    {
      "slug": "schwache-adj",
      "lemma": "schwache",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9176,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schwach:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of schwach:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1412841",
          "text": "Ich habe eine schwache Blase.",
          "translation": "У меня слабый мочевой пузырь.",
          "source": "Tatoeba #1412841 @enteka / #2207202 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1412841",
          "cefr_level": "A1",
          "word_slugs": [
            "schwache-adj"
          ]
        },
        {
          "id": "1815779",
          "text": "Das ist nichts für schwache Nerven.",
          "translation": "Это не для слабонервных.",
          "source": "Tatoeba #1815779 @Pfirsichbaeumchen / #10485221 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1815779",
          "cefr_level": "A1",
          "word_slugs": [
            "schwache-adj"
          ]
        },
        {
          "id": "11831742",
          "text": "Dieses Video ist nichts für schwache Nerven.",
          "translation": "Это видео не для слабонервных.",
          "source": "Tatoeba #11831742 @Adelpa / #11831768 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11831742",
          "cefr_level": "A1",
          "word_slugs": [
            "schwache-adj"
          ]
        },
        {
          "id": "2815632",
          "text": "Diese Nachricht ist nichts für eine schwache Seele.",
          "translation": "Эта новость не для слабых духом.",
          "source": "Tatoeba #2815632 @al_ex_an_der / #11033713 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2815632",
          "cefr_level": "A1",
          "word_slugs": [
            "schwache-adj"
          ]
        },
        {
          "id": "5978079",
          "text": "Er ist ein schwacher Präsident, weil er eine schwache Persönlichkeit hat.",
          "translation": "Он слабый президент, потому что у него слабый характер.",
          "source": "Tatoeba #5978079 @al_ex_an_der / #5978083 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5978079",
          "cefr_level": "A1",
          "word_slugs": [
            "schwache-adj"
          ]
        }
      ],
