    {
      "slug": "korb-noun",
      "lemma": "Korb",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5714,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "basket, creel",
          "basket, creel",
          "hoop",
          "basket, creel"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "7706390",
          "text": "Das Obst ist im Korb.",
          "translation": "Фрукты в корзине.",
          "source": "Tatoeba #7706390 @Pfirsichbaeumchen / #7706375 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7706390",
          "cefr_level": "A1",
          "word_slugs": [
            "korb-noun"
          ]
        },
        {
          "id": "12014165",
          "text": "Im Korb ist ein Loch.",
          "translation": "В корзине дырка.",
          "source": "Tatoeba #12014165 @Pfirsichbaeumchen / #3965717 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12014165",
          "cefr_level": "A1",
          "word_slugs": [
            "korb-noun"
          ]
        },
        {
          "id": "13578949",
          "text": "Es war nichts im Korb.",
          "translation": "В корзине ничего не было.",
          "source": "Tatoeba #13578949 @Waldelfe / #8785829 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13578949",
          "cefr_level": "A1",
          "word_slugs": [
            "korb-noun"
          ]
        },
        {
          "id": "1220586",
          "text": "Sie gab ihm einen Korb.",
          "translation": "Она дала ему корзину.",
          "source": "Tatoeba #1220586 @MUIRIEL / #1319329 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1220586",
          "cefr_level": "A1",
          "word_slugs": [
            "korb-noun"
          ]
        },
        {
          "id": "938934",
          "text": "Der Korb war voller Äpfel.",
          "translation": "Корзина была полна яблок.",
          "source": "Tatoeba #938934 @Sudajaengi / #3613798 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/938934",
          "cefr_level": "A1",
          "word_slugs": [
            "korb-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Korb",
        "nominative_pl": ""
      }
