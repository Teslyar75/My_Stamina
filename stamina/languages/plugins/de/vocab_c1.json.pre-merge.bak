    {
      "slug": "frost-noun",
      "lemma": "Frost",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6217,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "frost; freezing weather (weather conditions below 0 °C)",
          "frost; ice; all the natural phenomena caused by such weather collectively",
          "a sensation of cold, especially due to illness"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1358862",
          "text": "Letzte Nacht gab es Frost.",
          "translation": "Прошлой ночью были заморозки.",
          "source": "Tatoeba #1358862 @al_ex_an_der / #2821801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1358862",
          "cefr_level": "A1",
          "word_slugs": [
            "frost-noun"
          ]
        },
        {
          "id": "11550806",
          "text": "Heute Morgen gab es starken Frost.",
          "translation": "Сегодня утром был сильный мороз.",
          "source": "Tatoeba #11550806 @Pfirsichbaeumchen / #11550811 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11550806",
          "cefr_level": "A1",
          "word_slugs": [
            "frost-noun"
          ]
        },
        {
          "id": "3524178",
          "text": "Der Frost ließ den Boden erstarren.",
          "translation": "Мороз сковал землю.",
          "source": "Tatoeba #3524178 @al_ex_an_der / #3524933 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3524178",
          "cefr_level": "A1",
          "word_slugs": [
            "frost-noun"
          ]
        },
        {
          "id": "12353755",
          "text": "Glaubt Tom noch an Väterchen Frost?",
          "translation": "Том ещё верит в Деда Мороза?",
          "source": "Tatoeba #12353755 @Pfirsichbaeumchen / #12353733 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12353755",
          "cefr_level": "A1",
          "word_slugs": [
            "frost-noun"
          ]
        },
        {
          "id": "1954134",
          "text": "Ein schöner Tag dank Frost und Sonne!",
          "translation": "Мороз и солнце; день чудесный!",
          "source": "Tatoeba #1954134 @al_ex_an_der / #1954103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1954134",
          "cefr_level": "A1",
          "word_slugs": [
            "frost-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
