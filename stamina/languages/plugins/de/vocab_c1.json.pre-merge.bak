    {
      "slug": "aufgehängt-verb",
      "lemma": "aufgehängt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8981,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of aufhängen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1112937",
          "text": "Mein PC hat sich aufgehängt.",
          "translation": "Мой компьютер завис.",
          "source": "Tatoeba #1112937 @Haehnchenpaella / #1730230 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1112937",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgehängt-verb"
          ]
        },
        {
          "id": "5428543",
          "text": "Hast du die Wäsche aufgehängt?",
          "translation": "Ты повесила белье?",
          "source": "Tatoeba #5428543 @nina99nv / #5428546 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5428543",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgehängt-verb"
          ]
        },
        {
          "id": "1718168",
          "text": "Hast du schon einmal Wäsche aufgehängt?",
          "translation": "Ты когда-нибудь вешал бельё?",
          "source": "Tatoeba #1718168 @Pfirsichbaeumchen / #8772187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1718168",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgehängt-verb"
          ]
        },
        {
          "id": "477222",
          "text": "Argh! Mein Computer hat sich wieder aufgehängt.",
          "translation": "А! Мой компьютер опять завис.",
          "source": "Tatoeba #477222 @landano / #1417909 @tien_oroniel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/477222",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgehängt-verb"
          ]
        },
        {
          "id": "3595801",
          "text": "Das Bild, das du gestern Nachmittag aufgehängt hast, ist heute Morgen heruntergefallen.",
          "translation": "Картина, которую ты повесил вчера после обеда, упала сегодня утром.",
          "source": "Tatoeba #3595801 @brauchinet / #3599918 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3595801",
          "cefr_level": "A1",
          "word_slugs": [
