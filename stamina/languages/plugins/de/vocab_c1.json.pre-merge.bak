      "gender": "f",
      "examples": [
        {
          "id": "1179483",
          "text": "Helen, das ist mein Vetter.",
          "translation": "Хелен, это мой двоюродный брат.",
          "source": "Tatoeba #1179483 @Haehnchenpaella / #3621361 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1179483",
          "cefr_level": "A1",
          "word_slugs": [
