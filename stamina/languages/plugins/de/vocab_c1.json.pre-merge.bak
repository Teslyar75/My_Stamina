    {
      "slug": "blinde-noun",
      "lemma": "Blinde",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8915,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "female equivalent of Blinder: blind woman"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "8820903",
          "text": "„Ich sehe“, sagte der Blinde.",
          "translation": "\"Вижу\", - сказал слепой.",
          "source": "Tatoeba #8820903 @mramosch / #8821070 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8820903",
          "cefr_level": "A1",
          "word_slugs": [
            "blinde-noun"
          ]
        },
        {
          "id": "13972179",
          "text": "In Russland können auch Blinde lesen.",
          "translation": "В России и слепые умеют читать.",
          "source": "Tatoeba #13972179 @mhr / #2853450 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13972179",
          "cefr_level": "A1",
          "word_slugs": [
            "blinde-noun"
          ]
        },
        {
          "id": "8059355",
          "text": "„Jetzt werden wir’s sehen!“ sprach der Blinde zu dem Tauben.",
          "translation": "\"Сейчас посмотрим!\" - сказал слепой глухому.",
          "source": "Tatoeba #8059355 @Pfirsichbaeumchen / #8059359 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8059355",
          "cefr_level": "A1",
          "word_slugs": [
            "blinde-noun"
          ]
        },
        {
          "id": "1707096",
          "text": "Freundlichkeit ist eine Sprache, die Taube hören und Blinde lesen können.",
          "translation": "Дружелюбие - это язык, который могут услышать глухие и прочесть слепые.",
          "source": "Tatoeba #1707096 @Esperantostern / #7483918 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1707096",
          "cefr_level": "A1",
          "word_slugs": [
            "blinde-noun"
          ]
        },
        {
          "id": "1825129",
          "text": "Blinde haben oft ein sehr gutes Gehör.",
          "translation": "У слепых часто очень хороший слух.",
          "source": "Tatoeba #1825129 @pne / #11243993 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1825129",
          "cefr_level": "A1",
          "word_slugs": [
            "blinde-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Blinde",
        "nominative_pl": ""
      }
    },
