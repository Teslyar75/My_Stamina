      "translations": {
        "ru": [
          "переночевать"
        ],
        "en": [
          "to stay overnight, to overnight, stay the night, sleep over"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "621675",
          "text": "Du kannst bei uns übernachten.",
          "translation": "Ты можешь у нас переночевать.",
          "source": "Tatoeba #621675 @Manfredo / #794220 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/621675",
          "cefr_level": "A1",
          "word_slugs": [
            "übernachten-verb"
          ]
        },
        {
          "id": "9144117",
          "text": "Tom wird hier nicht übernachten.",
          "translation": "Том не будет здесь ночевать.",
          "source": "Tatoeba #9144117 @Pfirsichbaeumchen / #9144108 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9144117",
          "cefr_level": "A1",
          "word_slugs": [
            "übernachten-verb"
          ]
        },
        {
          "id": "7577423",
          "text": "Ich werde in Potsdam übernachten.",
          "translation": "Я переночую в Потсдаме.",
          "source": "Tatoeba #7577423 @MisterTrouser / #11835688 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7577423",
          "cefr_level": "A1",
          "word_slugs": [
            "übernachten-verb"
          ]
        },
        {
          "id": "13113356",
          "text": "Ich möchte hier nicht übernachten.",
          "translation": "Не хочется здесь ночевать.",
          "source": "Tatoeba #13113356 @Yorwba / #13219446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13113356",
          "cefr_level": "A1",
          "word_slugs": [
            "übernachten-verb"
          ]
        },
        {
          "id": "3522651",
          "text": "Ich werde bei meiner Tante übernachten.",
          "translation": "Я переночую у тёти.",
          "source": "Tatoeba #3522651 @Pfirsichbaeumchen / #3522626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3522651",
          "cefr_level": "A1",
          "word_slugs": [
            "übernachten-verb"
          ]
        }
      ],
