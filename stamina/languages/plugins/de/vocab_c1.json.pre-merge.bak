      },
      "gender": null,
      "examples": [
        {
          "id": "12941001",
          "text": "Nicht das ist vorgefallen.",
          "translation": "Произошло не это.",
          "source": "Tatoeba #12941001 @mhr / #12940914 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12941001",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgefallen-verb"
          ]
        },
        {
          "id": "5912753",
          "text": "Was ist dort denn vorgefallen?",
          "translation": "Что же там произошло?",
          "source": "Tatoeba #5912753 @Pfirsichbaeumchen / #5724164 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5912753",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgefallen-verb"
          ]
        },
        {
          "id": "8923793",
          "text": "Sag mir bitte, was vorgefallen ist!",
          "translation": "Расскажи мне, пожалуйста, что произошло.",
          "source": "Tatoeba #8923793 @Pfirsichbaeumchen / #7167094 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8923793",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgefallen-verb"
          ]
        },
        {
          "id": "5280064",
          "text": "Weiß jemand, was wirklich vorgefallen ist?",
          "translation": "Кто-нибудь знает, что произошло на самом деле?",
          "source": "Tatoeba #5280064 @Pfirsichbaeumchen / #5279214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5280064",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgefallen-verb"
          ]
        },
        {
          "id": "12940996",
          "text": "Nicht das ist es, was vorgefallen ist.",
          "translation": "Это не то, что произошло.",
          "source": "Tatoeba #12940996 @mhr / #12940915 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12940996",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgefallen-verb"
          ]
        }
