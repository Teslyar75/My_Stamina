    {
      "slug": "insgesamt-adv",
      "lemma": "insgesamt",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6503,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "всего"
        ],
        "en": [
          "overall, altogether, in total, all in all, by and large, on the whole"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1008257",
          "text": "Wir sind insgesamt acht.",
          "translation": "Нас всего восемь человек.",
          "source": "Tatoeba #1008257 @MUIRIEL / #14027012 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1008257",
          "cefr_level": "A1",
          "word_slugs": [
            "insgesamt-adv"
          ]
        },
        {
          "id": "14069062",
          "text": "Ich habe insgesamt fünf Koffer.",
          "translation": "У меня всего пять чемоданов.",
          "source": "Tatoeba #14069062 @mhr / #14069046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14069062",
          "cefr_level": "A1",
          "word_slugs": [
            "insgesamt-adv"
          ]
        },
        {
          "id": "13856408",
          "text": "Das italienische Alphabet hat insgesamt 21 Buchstaben.",
          "translation": "Во итальянском алфавите в общей сложности двадцать одна буква.",
          "source": "Tatoeba #13856408 @mhr / #13856877 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13856408",
          "cefr_level": "A1",
          "word_slugs": [
            "insgesamt-adv"
          ]
        },
        {
          "id": "343604",
          "text": "Insgesamt scheint der Plan gut zu sein.",
          "translation": "В целом план кажется хорошим.",
          "source": "Tatoeba #343604 @MUIRIEL / #13072191 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/343604",
          "cefr_level": "A1",
          "word_slugs": [
            "insgesamt-adv"
          ]
        },
        {
          "id": "1527497",
          "text": "Wie viel Geld hast du insgesamt ausgegeben?",
          "translation": "Сколько в конечном итоге ты потратила?",
          "source": "Tatoeba #1527497 @al_ex_an_der / #1993442 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1527497",
          "cefr_level": "A1",
          "word_slugs": [
            "insgesamt-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
