    {
      "slug": "heimweg-noun",
      "lemma": "Heimweg",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8459,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "way home"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6770323",
          "text": "Der Heimweg war lang.",
          "translation": "Дорога домой была долгой.",
          "source": "Tatoeba #6770323 @Pfirsichbaeumchen / #5790821 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770323",
          "cefr_level": "A1",
          "word_slugs": [
            "heimweg-noun"
          ]
        },
        {
          "id": "4181832",
          "text": "Trödle auf dem Heimweg nicht.",
          "translation": "Не медли по дороге домой.",
          "source": "Tatoeba #4181832 @Dani6187 / #11066433 @Almi92 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4181832",
          "cefr_level": "A1",
          "word_slugs": [
            "heimweg-noun"
          ]
        },
        {
          "id": "8302136",
          "text": "Maria weinte auf dem Heimweg.",
          "translation": "Мария плакала по дороге домой.",
          "source": "Tatoeba #8302136 @Pfirsichbaeumchen / #11066543 @Almi92 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8302136",
          "cefr_level": "A1",
          "word_slugs": [
            "heimweg-noun"
          ]
        },
        {
          "id": "2984824",
          "text": "Auf dem Heimweg traf ich ihn.",
          "translation": "Я встретил его по дороге домой.",
          "source": "Tatoeba #2984824 @raggione / #1566643 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2984824",
          "cefr_level": "A1",
          "word_slugs": [
            "heimweg-noun"
          ]
        },
        {
          "id": "5539148",
          "text": "Tom traf Maria auf dem Heimweg.",
          "translation": "Том встретил Мэри по дороге домой.",
          "source": "Tatoeba #5539148 @Pfirsichbaeumchen / #5539335 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5539148",
          "cefr_level": "A1",
          "word_slugs": [
            "heimweg-noun"
          ]
        }
      ],
