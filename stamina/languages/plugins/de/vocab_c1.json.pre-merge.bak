    {
      "slug": "langem-adj",
      "lemma": "langem",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6336,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong dative masculine/neuter singular of lang"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2953984",
          "text": "Wir kennen uns seit langem.",
          "translation": "Мы давно друг друга знаем.",
          "source": "Tatoeba #2953984 @Tamy / #4299888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2953984",
          "cefr_level": "A1",
          "word_slugs": [
            "langem-adj"
          ]
        },
        {
          "id": "8379457",
          "text": "Ich kenne dich seit langem.",
          "translation": "Я давно тебя знаю.",
          "source": "Tatoeba #8379457 @driini / #9363692 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8379457",
          "cefr_level": "A1",
          "word_slugs": [
            "langem-adj"
          ]
        },
        {
          "id": "9075103",
          "text": "Sie kannte ihn seit langem.",
          "translation": "Она давно его знала.",
          "source": "Tatoeba #9075103 @wolfgangth / #13476436 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9075103",
          "cefr_level": "A1",
          "word_slugs": [
            "langem-adj"
          ]
        },
        {
          "id": "2140537",
          "text": "Ich kenne ihn schon seit langem.",
          "translation": "Я его давно знаю.",
          "source": "Tatoeba #2140537 @Pfirsichbaeumchen / #7941830 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2140537",
          "cefr_level": "A1",
          "word_slugs": [
            "langem-adj"
          ]
        },
        {
          "id": "12862595",
          "text": "Ich liebe sie schon seit langem.",
          "translation": "Я давно её люблю.",
          "source": "Tatoeba #12862595 @Waldelfe / #12862609 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12862595",
          "cefr_level": "A1",
          "word_slugs": [
            "langem-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
