    {
      "slug": "ausfindig-adv",
      "lemma": "ausfindig",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7679,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "only used in ausfindig machen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1894247",
          "text": "Wir wollen bloß Tom ausfindig machen.",
          "translation": "Мы просто хотим найти Тома.",
          "source": "Tatoeba #1894247 @Pfirsichbaeumchen / #2554258 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1894247",
          "cefr_level": "A1",
          "word_slugs": [
            "ausfindig-adv"
          ]
        },
        {
          "id": "4613162",
          "text": "Wir müssen Toms Versteck ausfindig machen.",
          "translation": "Нам нужно выяснить, где прячется Том.",
          "source": "Tatoeba #4613162 @Pfirsichbaeumchen / #4575094 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4613162",
          "cefr_level": "A1",
          "word_slugs": [
            "ausfindig-adv"
          ]
        },
        {
          "id": "398015",
          "text": "Wir konnten ihren Aufenthaltsort nicht ausfindig machen.",
          "translation": "Мы не могли определить ее местонахождение.",
          "source": "Tatoeba #398015 @xtofu80 / #621255 @wondersz1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398015",
          "cefr_level": "A1",
          "word_slugs": [
            "ausfindig-adv"
          ]
        },
        {
          "id": "10371673",
          "text": "Ich habe dein Haus nur mit Mühe ausfindig gemacht.",
          "translation": "Я с трудом смог отыскать твой дом.",
          "source": "Tatoeba #10371673 @Yorwba / #10465110 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10371673",
          "cefr_level": "A1",
          "word_slugs": [
            "ausfindig-adv"
          ]
        }
      ],
      "tags": [
