      },
      "gender": null,
      "examples": [
        {
          "id": "4322507",
          "text": "Schwangere empfinden gewöhnlich Übelkeit.",
          "translation": "Беременные обычно испытывают тошноту.",
          "source": "Tatoeba #4322507 @gubaer / #1821764 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4322507",
          "cefr_level": "A1",
          "word_slugs": [
            "empfinden-verb"
          ]
        },
        {
          "id": "4915177",
          "text": "Angst zu empfinden, ist vollkommen normal.",
          "translation": "Испытывать страх совершенно нормально.",
          "source": "Tatoeba #4915177 @al_ex_an_der / #8419703 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4915177",
          "cefr_level": "A1",
