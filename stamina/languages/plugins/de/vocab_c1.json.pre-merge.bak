      },
      "gender": null,
      "examples": [
        {
          "id": "2162343",
          "text": "Liebe und Hass sind gegensätzliche Emotionen.",
          "translation": "Любовь и ненависть - противоположные эмоции.",
          "source": "Tatoeba #2162343 @Vortarulo / #3333346 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2162343",
          "cefr_level": "A1",
          "word_slugs": [
            "emotionen-noun"
          ]
        },
        {
          "id": "3577615",
          "text": "Vielleicht sind wir ein Produkt unserer Emotionen.",
          "translation": "Возможно, мы продукты наших эмоций.",
          "source": "Tatoeba #3577615 @al_ex_an_der / #3577769 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3577615",
          "cefr_level": "A1",
          "word_slugs": [
            "emotionen-noun"
          ]
        },
        {
          "id": "12705499",
          "text": "Manchmal kann ich meine Emotionen nicht zurückhalten.",
          "translation": "Иногда я не могу сдержать эмоций.",
          "source": "Tatoeba #12705499 @Vortarulo / #5483 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12705499",
          "cefr_level": "A1",
          "word_slugs": [
            "emotionen-noun"
          ]
        },
        {
          "id": "13667523",
          "text": "Man darf sich nicht nur von Emotionen leiten lassen.",
          "translation": "Нельзя руководствоваться одними эмоциями.",
          "source": "Tatoeba #13667523 @mhr / #13667510 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13667523",
          "cefr_level": "A1",
          "word_slugs": [
            "emotionen-noun"
          ]
        },
        {
          "id": "13667522",
          "text": "Man darf sich nicht allein von Emotionen leiten lassen.",
          "translation": "Нельзя руководствоваться одними эмоциями.",
          "source": "Tatoeba #13667522 @mhr / #13667510 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13667522",
          "cefr_level": "A1",
          "word_slugs": [
            "emotionen-noun"
          ]
        }
      ],
