    {
      "slug": "flogen-verb",
      "lemma": "flogen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9885,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person plural preterite of fliegen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13002815",
          "text": "Möwen flogen über das Meer.",
          "translation": "Чайки летали над морем.",
          "source": "Tatoeba #13002815 @Vortarulo / #4954200 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13002815",
          "cefr_level": "A1",
          "word_slugs": [
            "flogen-verb"
          ]
        },
        {
          "id": "1031193",
          "text": "Wir flogen über den Atlantik.",
          "translation": "Мы перелетели Атлантику.",
          "source": "Tatoeba #1031193 @al_ex_an_der / #474634 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1031193",
          "cefr_level": "A1",
          "word_slugs": [
            "flogen-verb"
          ]
        },
        {
          "id": "8984905",
          "text": "Sie flogen durch die gesamte Galaxie.",
          "translation": "Они облетели всю Галактику.",
          "source": "Tatoeba #8984905 @carlosalberto / #4513846 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8984905",
          "cefr_level": "A1",
          "word_slugs": [
            "flogen-verb"
          ]
        },
        {
          "id": "3499581",
          "text": "Gefaltete Papierflieger flogen durch den Unterrichtsraum.",
          "translation": "Бумажные самолётики летали по классу.",
          "source": "Tatoeba #3499581 @al_ex_an_der / #3610176 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3499581",
          "cefr_level": "A1",
          "word_slugs": [
            "flogen-verb"
          ]
        },
        {
          "id": "2391164",
          "text": "Leichte Schneeflocken flogen in der frostigen Luft.",
          "translation": "Лёгкие снежинки летали в морозном воздухе.",
          "source": "Tatoeba #2391164 @al_ex_an_der / #2391159 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2391164",
          "cefr_level": "A1",
          "word_slugs": [
            "flogen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
