      "gender": "n",
      "examples": [
        {
          "id": "3352660",
          "text": "Diese Landschaft gefällt mir.",
          "translation": "Этот ландшафт мне нравится.",
          "source": "Tatoeba #3352660 @al_ex_an_der / #3352672 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3352660",
          "cefr_level": "A1",
          "word_slugs": [
            "landschaft-noun"
          ]
        },
        {
          "id": "3263595",
          "text": "Diese Landschaft ist sehr schön.",
          "translation": "Этот пейзаж очень красивый.",
          "source": "Tatoeba #3263595 @faehrmann / #3262969 @itoldyouso (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3263595",
          "cefr_level": "A1",
          "word_slugs": [
            "landschaft-noun"
          ]
        },
        {
          "id": "2381765",
          "text": "In diesem Buch finden Sie alles, was diese Landschaft einzigartig macht.",
          "translation": "В этой книге вы найдёте всё, что делает этот ландшафт уникальным.",
          "source": "Tatoeba #2381765 @al_ex_an_der / #2381773 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2381765",
          "cefr_level": "A1",
          "word_slugs": [
            "landschaft-noun"
          ]
        },
        {
          "id": "1234710",
          "text": "Tom kennt nicht den Unterschied zwischen einem Land und einer Landschaft.",
          "translation": "Том не знает разницы между страной и пейзажем.",
          "source": "Tatoeba #1234710 @al_ex_an_der / #1293707 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1234710",
          "cefr_level": "A1",
          "word_slugs": [
            "landschaft-noun"
          ]
        },
        {
          "id": "2522369",
          "text": "Von diesem Gipfel aus erschließen sich atemberaubende Aussichten auf die Landschaft ringsum.",
          "translation": "С этой вершины открываются потрясающие виды на окружающий ландшафт.",
          "source": "Tatoeba #2522369 @al_ex_an_der / #1853644 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2522369",
          "cefr_level": "A1",
          "word_slugs": [
            "landschaft-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Landschaft",
        "nominative_pl": ""
      }
    },
    {
      "slug": "funktion-noun",
      "lemma": "Funktion",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8660,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "функция"
        ],
        "en": [
          "role",
          "feature (beneficial capability of a piece of software)",
          "subroutine",
          "function"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13549516",
          "text": "Diese Funktion wird sehr nützlich sein.",
          "translation": "Эта функция будет очень полезной.",
          "source": "Tatoeba #13549516 @mhr / #13549248 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13549516",
          "cefr_level": "A1",
          "word_slugs": [
            "funktion-noun"
          ]
        },
        {
          "id": "13831851",
          "text": "Die Funktion des Herzens ist es, Blut zu pumpen.",
          "translation": "Функция сердца — перекачивать кровь.",
          "source": "Tatoeba #13831851 @mhr / #13831816 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13831851",
          "cefr_level": "A1",
          "word_slugs": [
            "funktion-noun"
          ]
        },
        {
          "id": "2991074",
          "text": "Soweit ich weiß, gibt es eine solche Funktion nicht.",
          "translation": "Насколько я знаю, такой функции нет.",
          "source": "Tatoeba #2991074 @Pfirsichbaeumchen / #3012952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2991074",
          "cefr_level": "A1",
          "word_slugs": [
            "funktion-noun"
          ]
        },
        {
          "id": "6960706",
          "text": "Die Funktion der Bremse ist es, das Auto zu stoppen.",
          "translation": "Функция тормозов заключается в том, чтобы останавливать автомобиль.",
          "source": "Tatoeba #6960706 @moskytoo / #12264950 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6960706",
          "cefr_level": "A1",
          "word_slugs": [
            "funktion-noun"
          ]
        },
        {
          "id": "2871962",
          "text": "Wenn das Leben zu stressig ist, schwächt das die sexuelle Funktion.",
          "translation": "Если жизнь излишне деловая, функция слабеет половая.",
          "source": "Tatoeba #2871962 @Esperantostern / #2847868 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2871962",
          "cefr_level": "A1",
          "word_slugs": [
            "funktion-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Funktion",
        "nominative_pl": ""
      }
    },
    {
      "slug": "anonym-adj",
      "lemma": "anonym",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8661,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "anonymous"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2229758",
          "text": "Ich möchte anonym bleiben.",
          "translation": "Я желаю остаться анонимным.",
          "source": "Tatoeba #2229758 @al_ex_an_der / #11354098 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2229758",
          "cefr_level": "A1",
          "word_slugs": [
            "anonym-adj"
          ]
        },
        {
          "id": "11354428",
          "text": "Ich wünsche, anonym zu bleiben.",
          "translation": "Я желаю остаться анонимным.",
          "source": "Tatoeba #11354428 @Pfirsichbaeumchen / #11354098 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11354428",
          "cefr_level": "A1",
          "word_slugs": [
            "anonym-adj"
          ]
        },
        {
          "id": "3577722",
          "text": "Der Autor wünschte anonym zu bleiben.",
          "translation": "Автор пожелал остаться неизвестным.",
          "source": "Tatoeba #3577722 @al_ex_an_der / #3577721 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3577722",
          "cefr_level": "A1",
          "word_slugs": [
            "anonym-adj"
          ]
        },
        {
          "id": "3108008",
          "text": "Das hat jemand anonym in einem Forum geschrieben.",
          "translation": "Кто-то написал это анонимно на форуме.",
          "source": "Tatoeba #3108008 @al_ex_an_der / #3108005 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3108008",
          "cefr_level": "A1",
          "word_slugs": [
            "anonym-adj"
          ]
        },
        {
          "id": "3577695",
          "text": "Heute ist bei uns ein Mensch zu Gast, der anonym bleiben möchte.",
          "translation": "Сегодня у нас в гостях человек, который пожелал остаться неизвестным.",
          "source": "Tatoeba #3577695 @al_ex_an_der / #3577687 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3577695",
          "cefr_level": "A1",
          "word_slugs": [
            "anonym-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der anonym",
        "nominative_pl": ""
      }
