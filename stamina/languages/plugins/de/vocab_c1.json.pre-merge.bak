    {
      "slug": "abgeschaltet-verb",
      "lemma": "abgeschaltet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9061,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of abschalten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3840484",
          "text": "Sein Handy war abgeschaltet.",
          "translation": "Его мобильный был выключен.",
          "source": "Tatoeba #3840484 @Zaghawa / #3634146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3840484",
          "cefr_level": "A1",
          "word_slugs": [
