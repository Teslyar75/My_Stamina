    {
      "slug": "enkelin-noun",
      "lemma": "Enkelin",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7490,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "внучка"
        ],
        "en": [
          "granddaughter"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1712703",
          "text": "Das ist Nina, deine Enkelin.",
          "translation": "Это Нина, твоя внучка.",
          "source": "Tatoeba #1712703 @Pfirsichbaeumchen / #2367058 @urusu_tom (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1712703",
          "cefr_level": "A1",
          "word_slugs": [
            "enkelin-noun"
          ]
        },
        {
          "id": "11031632",
          "text": "Meine Enkelin ist acht Jahre alt.",
          "translation": "Моей внучке восемь лет.",
          "source": "Tatoeba #11031632 @Pfirsichbaeumchen / #11032073 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11031632",
          "cefr_level": "A1",
          "word_slugs": [
            "enkelin-noun"
          ]
        },
        {
          "id": "10116834",
          "text": "Ich gratuliere! Sie haben eine Enkelin.",
          "translation": "Поздравляю! У вас внучка.",
          "source": "Tatoeba #10116834 @Pfirsichbaeumchen / #10116773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10116834",
          "cefr_level": "A1",
          "word_slugs": [
            "enkelin-noun"
          ]
        },
        {
          "id": "8232319",
          "text": "Ich bin die einzige Enkelin meiner Oma.",
          "translation": "Я у бабушки единственная внучка.",
          "source": "Tatoeba #8232319 @Pfirsichbaeumchen / #6212917 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8232319",
          "cefr_level": "A1",
          "word_slugs": [
            "enkelin-noun"
          ]
        },
        {
          "id": "1810171",
          "text": "Die alte Dame lächelte ihrer Enkelin zu.",
          "translation": "Пожилая дама улыбнулась своей внучке.",
          "source": "Tatoeba #1810171 @Tamy / #7483888 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1810171",
          "cefr_level": "A1",
          "word_slugs": [
            "enkelin-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
