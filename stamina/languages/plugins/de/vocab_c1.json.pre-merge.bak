      "gender": null,
      "examples": [
        {
          "id": "3530298",
          "text": "Er hat mich aufgezogen.",
          "translation": "Он вырастил меня.",
          "source": "Tatoeba #3530298 @Zaghawa / #3584673 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3530298",
          "cefr_level": "A1",
