    {
      "slug": "lebenszeichen-noun",
      "lemma": "Lebenszeichen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9732,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "sign of life"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2309215",
          "text": "Er gibt kein Lebenszeichen von sich.",
          "translation": "Он не подаёт никаких признаков жизни.",
          "source": "Tatoeba #2309215 @Pfirsichbaeumchen / #3600009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2309215",
          "cefr_level": "A1",
          "word_slugs": [
            "lebenszeichen-noun"
          ]
        },
        {
          "id": "5142924",
          "text": "Sie gab kein Lebenszeichen mehr von sich.",
          "translation": "Она уже не подавала признаков жизни.",
          "source": "Tatoeba #5142924 @brauchinet / #5142937 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5142924",
          "cefr_level": "A1",
          "word_slugs": [
            "lebenszeichen-noun"
          ]
        },
        {
          "id": "844",
          "text": "Ich bin am Leben, obwohl ich kein Lebenszeichen gebe.",
          "translation": "Я живой, хотя и не подаю признаков жизни.",
          "source": "Tatoeba #844 @MUIRIEL / #12006464 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/844",
          "cefr_level": "A1",
          "word_slugs": [
            "lebenszeichen-noun"
          ]
        }
