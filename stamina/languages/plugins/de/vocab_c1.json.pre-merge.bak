    {
      "slug": "vorgestern-adv",
      "lemma": "vorgestern",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8579,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "ereyesterday, the day before yesterday"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4901809",
          "text": "Kamst du vorgestern?",
          "translation": "Ты позавчера приехал?",
          "source": "Tatoeba #4901809 @Zaghawa / #2411680 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4901809",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgestern-adv"
          ]
        },
        {
          "id": "13563650",
          "text": "Vorgestern war Montag.",
          "translation": "Позавчера был понедельник.",
          "source": "Tatoeba #13563650 @Waldelfe / #10483304 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13563650",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgestern-adv"
          ]
        },
        {
          "id": "13644755",
          "text": "Vorgestern war Mittwoch.",
          "translation": "Позавчера была среда.",
          "source": "Tatoeba #13644755 @mhr / #13361961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13644755",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgestern-adv"
          ]
        },
        {
          "id": "7912466",
          "text": "Ich war vorgestern hier.",
          "translation": "Я был здесь позавчера.",
          "source": "Tatoeba #7912466 @Pfirsichbaeumchen / #8302724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7912466",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgestern-adv"
          ]
        },
        {
          "id": "8824572",
          "text": "Tom war vorgestern hier.",
          "translation": "Том был здесь позавчера.",
          "source": "Tatoeba #8824572 @wolfgangth / #8824584 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8824572",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgestern-adv"
          ]
        }
      ],
