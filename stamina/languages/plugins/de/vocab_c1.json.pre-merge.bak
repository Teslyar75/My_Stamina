    {
      "slug": "log-verb",
      "lemma": "log",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9601,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of lügen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2047799",
          "text": "Er log aus Angst.",
          "translation": "Он лгал от страха.",
          "source": "Tatoeba #2047799 @al_ex_an_der / #2047801 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2047799",
          "cefr_level": "A1",
          "word_slugs": [
            "log-verb"
          ]
        },
        {
          "id": "4959651",
          "text": "Ich wusste, er log.",
          "translation": "Я знал, что он солгал.",
          "source": "Tatoeba #4959651 @Zaghawa / #6117777 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4959651",
          "cefr_level": "A1",
          "word_slugs": [
            "log-verb"
          ]
        },
        {
          "id": "7529720",
          "text": "Alle wussten, dass Tom log.",
          "translation": "Все знали, что Том врал.",
          "source": "Tatoeba #7529720 @Pfirsichbaeumchen / #7529800 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7529720",
          "cefr_level": "A1",
          "word_slugs": [
            "log-verb"
          ]
        },
        {
          "id": "8740642",
          "text": "Sie log, um ihn zu schützen.",
          "translation": "Она солгала, чтобы защитить его.",
          "source": "Tatoeba #8740642 @Pfirsichbaeumchen / #8740640 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8740642",
          "cefr_level": "A1",
          "word_slugs": [
            "log-verb"
          ]
        },
        {
          "id": "7430875",
          "text": "Tom log, um Maria zu beschützen.",
          "translation": "Том солгал, чтобы защитить Марию.",
          "source": "Tatoeba #7430875 @Pfirsichbaeumchen / #9994781 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7430875",
          "cefr_level": "A1",
          "word_slugs": [
            "log-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
