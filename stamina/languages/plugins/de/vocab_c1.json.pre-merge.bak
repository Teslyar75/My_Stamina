    {
      "slug": "vertrete-verb",
      "lemma": "vertrete",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9308,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of vertreten:",
          "first-person singular present",
          "inflection of vertreten:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8886536",
          "text": "Ich vertrete meinen Vater.",
          "translation": "Я веду дела вместо моего отца.",
          "source": "Tatoeba #8886536 @Pfirsichbaeumchen / #8886860 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8886536",
          "cefr_level": "A1",
          "word_slugs": [
            "vertrete-verb"
          ]
        },
        {
          "id": "13937162",
          "text": "Ich vertrete linke Ansichten.",
          "translation": "Я придерживаюсь левых взглядов.",
          "source": "Tatoeba #13937162 @mhr / #13937159 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13937162",
          "cefr_level": "A1",
          "word_slugs": [
            "vertrete-verb"
          ]
        },
        {
          "id": "12871620",
          "text": "Der Direktor ist auf Urlaub. Ich vertrete ihn.",
          "translation": "Директор в отпуске. Я его замещаю.",
          "source": "Tatoeba #12871620 @mhr / #12870107 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12871620",
          "cefr_level": "A1",
          "word_slugs": [
            "vertrete-verb"
          ]
        }
