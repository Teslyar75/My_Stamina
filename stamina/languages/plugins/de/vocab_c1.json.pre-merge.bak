    {
      "slug": "gebucht-verb",
      "lemma": "gebucht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7576,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of buchen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2176353",
          "text": "Für wie viel Uhr haben wir gebucht?",
          "translation": "На какое время мы забронировали?",
          "source": "Tatoeba #2176353 @Manfredo / #12036460 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2176353",
          "cefr_level": "A1",
          "word_slugs": [
            "gebucht-verb"
          ]
        },
        {
          "id": "8634092",
          "text": "Sie haben die Reise im Reisebüro gebucht.",
          "translation": "Они забронировали поездку в турагентстве.",
          "source": "Tatoeba #8634092 @Melang / #8648211 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634092",
          "cefr_level": "A1",
          "word_slugs": [
            "gebucht-verb"
          ]
        },
        {
          "id": "8572357",
          "text": "Wir haben schon alles gebucht, bis auf Prag.",
          "translation": "Мы забронировали уже всё, кроме Праги.",
          "source": "Tatoeba #8572357 @Inego / #8572358 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8572357",
          "cefr_level": "A1",
          "word_slugs": [
            "gebucht-verb"
          ]
        },
        {
          "id": "8633687",
          "text": "Sie haben in diesem Hotel ein Zimmer mit Meerblick gebucht.",
          "translation": "Они забронировали в этой гостинице номер с видом на море.",
          "source": "Tatoeba #8633687 @Melang / #8648315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8633687",
          "cefr_level": "A1",
          "word_slugs": [
            "gebucht-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
