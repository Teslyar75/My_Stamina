          ]
        },
        {
          "id": "2778943",
          "text": "Wir haben Wichtigeres zu tun.",
          "translation": "У нас есть дела поважнее.",
          "source": "Tatoeba #2778943 @Pfirsichbaeumchen / #3603351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2778943",
          "cefr_level": "A1",
