      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5492,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of wachen:",
          "third-person singular present",
          "inflection of wachen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6017831",
          "text": "Kinder, wacht auf!",
          "translation": "Дети, просыпайтесь!",
          "source": "Tatoeba #6017831 @christian63 / #6023844 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6017831",
          "cefr_level": "A1",
          "word_slugs": [
            "wacht-verb"
          ]
        },
        {
          "id": "589952",
          "text": "Die Frau wacht auf.",
          "translation": "Женщина просыпается.",
          "source": "Tatoeba #589952 @cost / #2041564 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/589952",
          "cefr_level": "A1",
          "word_slugs": [
            "wacht-verb"
          ]
        },
        {
          "id": "7594681",
          "text": "Tom wacht früh auf.",
          "translation": "Том рано просыпается.",
          "source": "Tatoeba #7594681 @moskytoo / #7900415 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7594681",
          "cefr_level": "A1",
          "word_slugs": [
            "wacht-verb"
          ]
        },
        {
          "id": "10787873",
          "text": "Sie wacht frühmorgens auf.",
          "translation": "Она просыпается рано утром.",
          "source": "Tatoeba #10787873 @megamanenm / #13454495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10787873",
          "cefr_level": "A1",
          "word_slugs": [
            "wacht-verb"
          ]
        },
        {
          "id": "1547120",
          "text": "Tom wacht um elf auf.",
          "translation": "Том просыпается в одиннадцать.",
          "source": "Tatoeba #1547120 @al_ex_an_der / #5229459 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1547120",
          "cefr_level": "A1",
          "word_slugs": [
            "wacht-verb"
          ]
        }
