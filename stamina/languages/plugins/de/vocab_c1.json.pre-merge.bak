      "gender": null,
      "examples": [
        {
          "id": "2404410",
          "text": "Stelle mich deiner zukünftigen Frau vor!",
          "translation": "Познакомь меня со своей будущей женой.",
          "source": "Tatoeba #2404410 @Pfirsichbaeumchen / #9465749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2404410",
