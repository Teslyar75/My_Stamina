    {
      "slug": "yard-noun",
      "lemma": "Yard",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7914,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "yard (measure of length equal to ca. 91 cm)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12170752",
          "text": "Wieviel Fuß hat ein Yard?",
          "translation": "Сколько футов в ярде?",
          "source": "Tatoeba #12170752 @Pfirsichbaeumchen / #8439867 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12170752",
          "cefr_level": "A1",
          "word_slugs": [
            "yard-noun"
          ]
        },
        {
          "id": "2967259",
          "text": "Tom arbeitet bei Scotland Yard.",
          "translation": "Том работает на Скотленд-Ярд.",
          "source": "Tatoeba #2967259 @Pfirsichbaeumchen / #2975506 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2967259",
          "cefr_level": "A1",
          "word_slugs": [
            "yard-noun"
          ]
        },
        {
          "id": "2422550",
          "text": "Die Mauer ist dreißig Yard lang.",
          "translation": "Длина стены - тридцать ярдов.",
          "source": "Tatoeba #2422550 @Tamy / #11043692 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2422550",
          "cefr_level": "A1",
          "word_slugs": [
            "yard-noun"
          ]
        },
        {
          "id": "12582045",
          "text": "Ein Meter entspricht nicht ganz einem Yard.",
          "translation": "Метр - это не совсем ярд.",
          "source": "Tatoeba #12582045 @Waldelfe / #12582078 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12582045",
          "cefr_level": "A1",
          "word_slugs": [
            "yard-noun"
          ]
        },
        {
          "id": "12582118",
          "text": "Ein Yard ist ein bißchen kürzer als ein Meter.",
          "translation": "Ярд чуть меньше метра.",
