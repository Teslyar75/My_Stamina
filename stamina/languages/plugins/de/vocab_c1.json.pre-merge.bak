    {
      "slug": "wodurch-adv",
      "lemma": "wodurch",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8184,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "посредством чего"
        ],
        "en": [
          "whereby",
          "through what"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9638396",
          "text": "Wodurch kommt es zu statischer Aufladung?",
          "translation": "Как образуется статическое электричество?",
          "source": "Tatoeba #9638396 @Pfirsichbaeumchen / #9638405 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9638396",
          "cefr_level": "A1",
          "word_slugs": [
            "wodurch-adv"
          ]
        },
        {
          "id": "5319015",
          "text": "Wodurch unterscheidet sich Wissenschaft von Pseudowissenschaft?",
          "translation": "Чем наука отличается от псевдонауки?",
          "source": "Tatoeba #5319015 @Pfirsichbaeumchen / #5318082 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5319015",
          "cefr_level": "A1",
          "word_slugs": [
            "wodurch-adv"
          ]
        },
        {
          "id": "1109423",
          "text": "Wodurch kam es zum Fall der Berliner Mauer?",
          "translation": "Что привело к падению Берлинской стены?",
          "source": "Tatoeba #1109423 @Haehnchenpaella / #5001749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1109423",
          "cefr_level": "A1",
          "word_slugs": [
            "wodurch-adv"
          ]
        },
        {
          "id": "1172877",
          "text": "Ich sagte nichts, wodurch er noch wütender wurde.",
          "translation": "Я ничего не сказал, и это его ещё больше разозлило.",
          "source": "Tatoeba #1172877 @Sudajaengi / #10328122 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1172877",
          "cefr_level": "A1",
          "word_slugs": [
            "wodurch-adv"
          ]
        },
        {
          "id": "3174172",
          "text": "Tom ließ seine Tasse fallen, wodurch sie zerbrach.",
          "translation": "Том уронил свою чашку, и она разбилась.",
          "source": "Tatoeba #3174172 @Pfirsichbaeumchen / #12624532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3174172",
          "cefr_level": "A1",
          "word_slugs": [
            "wodurch-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
