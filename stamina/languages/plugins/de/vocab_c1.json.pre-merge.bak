    {
      "slug": "uhren-noun",
      "lemma": "Uhren",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8870,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Uhr \"clocks/watches\""
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "642470",
          "text": "Ich mag Uhren.",
          "translation": "Я люблю часы.",
          "source": "Tatoeba #642470 @jakov / #2358243 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/642470",
          "cefr_level": "A1",
          "word_slugs": [
            "uhren-noun"
          ]
        },
        {
          "id": "4459595",
          "text": "Tom sammelt antike Uhren.",
          "translation": "Том коллекционирует старинные часы.",
          "source": "Tatoeba #4459595 @Pfirsichbaeumchen / #4442693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4459595",
          "cefr_level": "A1",
          "word_slugs": [
            "uhren-noun"
          ]
        },
        {
          "id": "4801127",
          "text": "Ich reparierte die Uhren.",
          "translation": "Я ремонтировал часы.",
          "source": "Tatoeba #4801127 @Tamy / #11113150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4801127",
          "cefr_level": "A1",
          "word_slugs": [
            "uhren-noun"
          ]
        },
        {
          "id": "1104280",
          "text": "Lass uns unsere Uhren synchronisieren.",
          "translation": "Давайте сверим часы.",
          "source": "Tatoeba #1104280 @Haehnchenpaella / #1674386 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1104280",
          "cefr_level": "A1",
          "word_slugs": [
            "uhren-noun"
          ]
        },
        {
          "id": "1528327",
          "text": "Mir gefällt keine dieser beiden Uhren.",
          "translation": "Мне ни те ни другие часы не нравятся.",
          "source": "Tatoeba #1528327 @Pfirsichbaeumchen / #8576938 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1528327",
          "cefr_level": "A1",
          "word_slugs": [
            "uhren-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
