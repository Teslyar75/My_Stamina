            "ländern-noun"
          ]
        },
        {
          "id": "5962751",
          "text": "Blumen wachsen in warmen Ländern.",
          "translation": "Цветы растут в тёплых странах.",
          "source": "Tatoeba #5962751 @BlundaInte / #5962782 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5962751",
          "cefr_level": "A1",
          "word_slugs": [
            "ländern-noun"
          ]
        },
        {
          "id": "840713",
          "text": "Orangen wachsen in warmen Ländern.",
