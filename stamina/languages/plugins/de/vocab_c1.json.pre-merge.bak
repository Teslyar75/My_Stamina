      "gender": "n",
      "examples": [
        {
          "id": "10607304",
          "text": "Das ist kein Argument.",
          "translation": "Это не аргумент.",
          "source": "Tatoeba #10607304 @Adelpa / #4327189 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10607304",
          "cefr_level": "A1",
          "word_slugs": [
