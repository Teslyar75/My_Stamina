      "pos": "particle",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5688,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "only used in zu zweit."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13010532",
          "text": "Wir waren zu zweit.",
          "translation": "Мы были вдвоём.",
          "source": "Tatoeba #13010532 @Waldelfe / #5868553 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13010532",
          "cefr_level": "A1",
          "word_slugs": [
            "zweit-particle"
          ]
        },
        {
          "id": "11210771",
          "text": "Stellt euch zu zweit auf.",
          "translation": "Встаньте по двое.",
          "source": "Tatoeba #11210771 @felix63 / #11210798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11210771",
          "cefr_level": "A1",
          "word_slugs": [
            "zweit-particle"
          ]
        },
        {
          "id": "6595559",
          "text": "Sie entfernten sich zu zweit.",
          "translation": "Они ушли вдвоём.",
          "source": "Tatoeba #6595559 @Pfirsichbaeumchen / #6159676 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6595559",
          "cefr_level": "A1",
          "word_slugs": [
            "zweit-particle"
          ]
        },
        {
          "id": "7463036",
          "text": "Wir essen zu zweit zu Abend.",
          "translation": "Мы ужинаем вдвоём.",
          "source": "Tatoeba #7463036 @Pfirsichbaeumchen / #6150675 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7463036",
          "cefr_level": "A1",
          "word_slugs": [
            "zweit-particle"
          ]
        },
        {
          "id": "13509470",
          "text": "Wir werden nur zu zweit sein.",
          "translation": "Нас будет только двое.",
          "source": "Tatoeba #13509470 @Waldelfe / #13509466 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13509470",
          "cefr_level": "A1",
