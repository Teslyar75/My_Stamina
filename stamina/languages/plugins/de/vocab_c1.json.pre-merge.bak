      },
      "gender": null,
      "examples": [
        {
          "id": "1441975",
          "text": "Ich habe eine Krankheit, eine tödliche Krankheit.",
          "translation": "У меня болезнь, смертельная болезнь.",
          "source": "Tatoeba #1441975 @al_ex_an_der / #11536162 @kurzawhile (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1441975",
          "cefr_level": "A1",
          "word_slugs": [
            "tödliche-adj"
          ]
        },
        {
          "id": "833768",
          "text": "Mein Gott! Hilf mir diese tödliche Liebe zu überleben.",
          "translation": "\"Господи! Помоги мне выжить среди этой смертной любви.\"",
          "source": "Tatoeba #833768 @shanghainese / #833753 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/833768",
