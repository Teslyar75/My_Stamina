    {
      "slug": "festen-verb",
      "lemma": "festen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7401,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to celebrate, to party"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7269502",
          "text": "Maria hat einen festen Freund.",
          "translation": "У Мэри есть постоянный парень.",
          "source": "Tatoeba #7269502 @Pfirsichbaeumchen / #7028300 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7269502",
          "cefr_level": "A1",
          "word_slugs": [
            "festen-verb"
          ]
        },
        {
          "id": "10502235",
          "text": "Tom hat einen festen Arbeitsplatz.",
          "translation": "У Тома есть стабильная работа.",
          "source": "Tatoeba #10502235 @Pfirsichbaeumchen / #7028299 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10502235",
          "cefr_level": "A1",
          "word_slugs": [
            "festen-verb"
          ]
        },
        {
          "id": "2421193",
          "text": "Er ist nicht verheiratet, aber in festen Händen.",
          "translation": "Он не женат, но у него есть постоянная любовница.",
          "source": "Tatoeba #2421193 @al_ex_an_der / #2421190 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2421193",
          "cefr_level": "A1",
          "word_slugs": [
            "festen-verb"
          ]
        },
        {
          "id": "2505629",
          "text": "Ich richtete einen festen Blick auf meinen Gesprächspartner.",
          "translation": "Я пристально посмотрел на своего собеседника.",
          "source": "Tatoeba #2505629 @al_ex_an_der / #2505625 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2505629",
          "cefr_level": "A1",
          "word_slugs": [
            "festen-verb"
          ]
        }
      ],
      "tags": [
