    {
      "slug": "schoss-noun",
      "lemma": "Schoß",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5024,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "lap (area between the waist and knees of a seated person)",
          "bosom, womb",
          "fold, coattail"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13318549",
          "text": "Er saß bei seiner Mutter auf dem Schoß.",
          "translation": "Он сидел на коленях у матери.",
          "source": "Tatoeba #13318549 @Waldelfe / #11274237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13318549",
          "cefr_level": "A1",
          "word_slugs": [
            "schoss-noun"
          ]
        },
        {
          "id": "362790",
          "text": "Das Kind schlief auf dem Schoß seiner Mutter.",
          "translation": "Ребёнок спал на коленях у матери.",
          "source": "Tatoeba #362790 @Wolf / #1892231 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/362790",
          "cefr_level": "A1",
          "word_slugs": [
            "schoss-noun"
          ]
        }
      ],
