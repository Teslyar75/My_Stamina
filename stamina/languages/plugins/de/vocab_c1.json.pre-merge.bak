    {
      "slug": "veranstaltung-noun",
      "lemma": "Veranstaltung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8666,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "организация подготовка"
        ],
        "en": [
          "public event or community gathering with a specific theme or purpose and a specific duration"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "368664",
          "text": "Ich verschob die Veranstaltung.",
          "translation": "Я отложил мероприятие.",
          "source": "Tatoeba #368664 @xtofu80 / #3673361 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/368664",
          "cefr_level": "A1",
          "word_slugs": [
            "veranstaltung-noun"
          ]
        },
        {
          "id": "454060",
          "text": "Wir verschoben die Veranstaltung.",
          "translation": "Мы отложили это мероприятие.",
          "source": "Tatoeba #454060 @xtofu80 / #3400524 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454060",
          "cefr_level": "A1",
          "word_slugs": [
            "veranstaltung-noun"
          ]
        },
        {
          "id": "357140",
          "text": "Wer hat diese Veranstaltung ausgerichtet?",
          "translation": "Кто организовал это мероприятие?",
          "source": "Tatoeba #357140 @MUIRIEL / #1386174 @Nicksmet (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/357140",
          "cefr_level": "A1",
          "word_slugs": [
            "veranstaltung-noun"
          ]
        },
        {
          "id": "5253463",
          "text": "Die Veranstaltung lockte über 300 Menschen an.",
          "translation": "Событие привлекло более трёхсот человек.",
          "source": "Tatoeba #5253463 @Pfirsichbaeumchen / #5254022 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5253463",
          "cefr_level": "A1",
          "word_slugs": [
            "veranstaltung-noun"
          ]
        },
        {
          "id": "2119829",
          "text": "Die Veranstaltung findet bei jedem Wetter statt.",
          "translation": "Мероприятие пройдёт при любой погоде.",
          "source": "Tatoeba #2119829 @freddy1 / #8603582 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2119829",
          "cefr_level": "A1",
          "word_slugs": [
            "veranstaltung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Veranstaltung",
        "nominative_pl": ""
      }
    },
    {
