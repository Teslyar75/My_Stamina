    {
      "slug": "entschuldigst-verb",
      "lemma": "entschuldigst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9866,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of entschuldigen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12491474",
          "text": "Ich will, daß du dich bei mir entschuldigst.",
          "translation": "Я хочу, чтобы ты передо мной извинился.",
          "source": "Tatoeba #12491474 @Waldelfe / #12246275 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12491474",
          "cefr_level": "A1",
          "word_slugs": [
            "entschuldigst-verb"
          ]
        },
        {
          "id": "5251290",
          "text": "Ich möchte, dass du dich bei Tom entschuldigst.",
          "translation": "Я хотел бы, чтобы ты попросил у Тома прощения.",
          "source": "Tatoeba #5251290 @Pfirsichbaeumchen / #7807009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5251290",
          "cefr_level": "A1",
          "word_slugs": [
            "entschuldigst-verb"
          ]
        },
        {
          "id": "8378425",
          "text": "Sie wartet wahrscheinlich nur darauf, dass du dich entschuldigst.",
          "translation": "Может быть, она ждёт только того, чтобы ты извинился.",
          "source": "Tatoeba #8378425 @Pfirsichbaeumchen / #8380540 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8378425",
          "cefr_level": "A1",
          "word_slugs": [
            "entschuldigst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
