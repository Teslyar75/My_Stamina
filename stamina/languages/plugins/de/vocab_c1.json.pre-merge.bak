    {
      "slug": "verlorene-adj",
      "lemma": "verlorene",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6719,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verloren:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of verloren:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9994399",
          "text": "Der verlorene Sohn ist zurück.",
          "translation": "Блудный сын вернулся.",
          "source": "Tatoeba #9994399 @carlosalberto / #7724510 @fizdyuk (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9994399",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorene-adj"
          ]
        },
        {
          "id": "642901",
          "text": "Verlorene Zeit kann man nicht zurückholen.",
          "translation": "Потерянного времени не воротишь.",
          "source": "Tatoeba #642901 @Manfredo / #4418515 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/642901",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorene-adj"
          ]
        },
        {
          "id": "407155",
          "text": "Wir beeilten uns, um die verlorene Zeit aufzuholen.",
          "translation": "Мы торопились, чтобы компенсировать упущенное время.",
          "source": "Tatoeba #407155 @MUIRIEL / #2886750 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/407155",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorene-adj"
          ]
        },
        {
          "id": "1061767",
          "text": "Eine verlorene Hoffnung suche man nicht im Fundbüro.",
          "translation": "Потерянную надежду в бюро находок не отыскать.",
          "source": "Tatoeba #1061767 @Esperantostern / #1725266 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1061767",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorene-adj"
          ]
        },
        {
          "id": "344650",
          "text": "Ich muss hart arbeiten, um die verlorene Zeit aufzuholen.",
          "translation": "Я должен много работать, чтобы наверстать упущенное время.",
          "source": "Tatoeba #344650 @MUIRIEL / #9475491 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344650",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorene-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
