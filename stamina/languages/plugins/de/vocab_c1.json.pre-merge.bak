    {
      "slug": "wiederum-adv",
      "lemma": "wiederum",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9755,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "in turn, then again, on the other hand, to the contrary",
          "again, once more"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12938583",
          "text": "Die Arten werden wiederum in Unterarten unterteilt.",
          "translation": "Виды, в свою очередь, делятся на подвиды.",
          "source": "Tatoeba #12938583 @mhr / #12938406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12938583",
          "cefr_level": "A1",
          "word_slugs": [
            "wiederum-adv"
          ]
        },
        {
          "id": "4293394",
          "text": "So musste es kommen, dass Tom und Maria wiederum nicht heiraten können.",
          "translation": "Так и должно было случиться, что Том и Мария снова не могут пожениться.",
