    {
      "slug": "magische-adj",
      "lemma": "magische",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6670,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of magisch:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of magisch:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12691806",
          "text": "Er komponierte magische Musik.",
          "translation": "Он писал волшебную музыку.",
          "source": "Tatoeba #12691806 @mhr / #12691221 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12691806",
          "cefr_level": "A1",
          "word_slugs": [
            "magische-adj"
          ]
        },
        {
          "id": "12421264",
          "text": "Das ist eine magische Zahl.",
          "translation": "Это магическое число.",
          "source": "Tatoeba #12421264 @Waldelfe / #4068833 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12421264",
          "cefr_level": "A1",
          "word_slugs": [
            "magische-adj"
          ]
        },
        {
          "id": "2475074",
          "text": "Sie entdeckte an sich magische Fähigkeiten.",
          "translation": "Она открыла в себе магические способности.",
          "source": "Tatoeba #2475074 @al_ex_an_der / #2475071 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2475074",
          "cefr_level": "A1",
          "word_slugs": [
            "magische-adj"
          ]
        },
        {
          "id": "13901263",
          "text": "Das sind keine Buchstaben, sondern magische Symbole.",
          "translation": "Это не буквы, а магические символы.",
          "source": "Tatoeba #13901263 @mhr / #13900946 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13901263",
          "cefr_level": "A1",
          "word_slugs": [
            "magische-adj"
          ]
        },
        {
          "id": "389248",
          "text": "Ich werde dir demnächst sagen, ob 23 eine magische Zahl ist.",
          "translation": "Я тебе скоро скажу, волшебное ли число двадцать три.",
          "source": "Tatoeba #389248 @MUIRIEL / #11342431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/389248",
          "cefr_level": "A1",
          "word_slugs": [
            "magische-adj"
          ]
        }
      ],
