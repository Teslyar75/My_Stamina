    {
      "slug": "angesicht-noun",
      "lemma": "Angesicht",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5851,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "лицо",
          "лик"
        ],
        "en": [
          "face, visage, countenance",
          "face, confrontation"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "2792067",
          "text": "Wir standen im Angesicht des Todes.",
          "translation": "Мы стояли лицом к лицу со смертью.",
          "source": "Tatoeba #2792067 @Pfirsichbaeumchen / #639240 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2792067",
          "cefr_level": "A1",
          "word_slugs": [
            "angesicht-noun"
          ]
        },
        {
          "id": "2630140",
          "text": "Selbst im Angesicht der Gefahr blieb er ruhig.",
          "translation": "Он оставался спокоен даже перед лицом опасности.",
          "source": "Tatoeba #2630140 @Pfirsichbaeumchen / #12364512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2630140",
          "cefr_level": "A1",
          "word_slugs": [
            "angesicht-noun"
          ]
        },
        {
          "id": "1948727",
          "text": "Die Wahrheit hat ein schönes Angesicht, aber zerrissene Kleider.",
          "translation": "У правды красивое лицо, но рваная одежда.",
          "source": "Tatoeba #1948727 @Esperantostern / #8898450 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1948727",
          "cefr_level": "A1",
          "word_slugs": [
            "angesicht-noun"
          ]
        },
        {
          "id": "2459732",
          "text": "Im Angesicht der Gefahr stellte Tom seine Kühnheit unter Beweis.",
          "translation": "Том продемонстрировал свою смелость перед лицом опасности.",
          "source": "Tatoeba #2459732 @al_ex_an_der / #2459720 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2459732",
          "cefr_level": "A1",
          "word_slugs": [
            "angesicht-noun"
          ]
        },
        {
          "id": "2093821",
          "text": "Schauen wir den Tatsachen ins Angesicht: dieser Satz ist schlicht schlecht.",
          "translation": "Посмотрим правде в глаза: это предложение просто никуда не годится.",
          "source": "Tatoeba #2093821 @al_ex_an_der / #2093808 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2093821",
          "cefr_level": "A1",
          "word_slugs": [
            "angesicht-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Angesicht",
        "nominative_pl": ""
      }
    },
    {
