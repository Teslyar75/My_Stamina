      },
      "gender": null,
      "examples": [
        {
          "id": "8320605",
          "text": "Er isst braunen Reis.",
          "translation": "Он ест коричневый рис.",
          "source": "Tatoeba #8320605 @MisterTrouser / #10218219 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320605",
