      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3031483",
          "text": "Ich möchte alle Regeln infrage stellen, deren Sinn nicht erwiesen ist.",
          "translation": "Я хотел бы поставить под сомнение все правила, смысл которых не доказан.",
          "source": "Tatoeba #3031483 @freddy1 / #3032047 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3031483",
