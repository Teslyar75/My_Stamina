    {
      "slug": "zurückkomme-verb",
      "lemma": "zurückkomme",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7917,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of zurückkommen:",
          "first-person singular dependent present",
          "inflection of zurückkommen:",
          "first/third-person singular dependent subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3035263",
          "text": "Warte bis ich zurückkomme.",
          "translation": "Подожди, пока я вернусь.",
          "source": "Tatoeba #3035263 @al_ex_an_der / #2766409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3035263",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkomme-verb"
          ]
        },
        {
          "id": "455704",
          "text": "Warte hier, bis ich zurückkomme.",
          "translation": "Жди здесь, пока я не вернусь.",
          "source": "Tatoeba #455704 @Espi / #1863726 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455704",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkomme-verb"
          ]
        },
        {
          "id": "1844759",
          "text": "Bleib hier, bis ich zurückkomme!",
          "translation": "Будь здесь, пока я не вернусь.",
          "source": "Tatoeba #1844759 @Tamy / #11863865 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1844759",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkomme-verb"
          ]
        },
        {
          "id": "5251783",
          "text": "Bleib hier, bis ich zurückkomme.",
          "translation": "Оставайся здесь, пока я не вернусь.",
          "source": "Tatoeba #5251783 @Zurich899 / #3944156 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5251783",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkomme-verb"
          ]
        },
        {
          "id": "1844761",
          "text": "Warte bitte, bis ich zurückkomme.",
          "translation": "Подожди, пожалуйста, пока я вернусь.",
          "source": "Tatoeba #1844761 @Tamy / #9173059 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1844761",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkomme-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
