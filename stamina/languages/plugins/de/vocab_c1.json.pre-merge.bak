      },
      "gender": null,
      "examples": [
        {
          "id": "4617799",
          "text": "Das sind die Erwartungen.",
          "translation": "Таковы ожидания.",
          "source": "Tatoeba #4617799 @Tamy / #14106359 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4617799",
          "cefr_level": "A1",
          "word_slugs": [
