          ]
        },
        {
          "id": "12688222",
          "text": "Vergesst nicht, die Bildschirme auszuschalten!",
          "translation": "Не забудьте выключить мониторы.",
          "source": "Tatoeba #12688222 @mhr / #12687144 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12688222",
          "cefr_level": "A1",
          "word_slugs": [
            "auszuschalten-verb"
          ]
        },
        {
          "id": "3247290",
          "text": "Sie hat vergessen, das Licht auszuschalten.",
          "translation": "Она забыла выключить свет.",
          "source": "Tatoeba #3247290 @Pfirsichbaeumchen / #2819372 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3247290",
          "cefr_level": "A1",
          "word_slugs": [
