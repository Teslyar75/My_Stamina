            "wählte-verb"
          ]
        },
        {
          "id": "8046276",
          "text": "Er wählte das rote Auto.",
          "translation": "Он выбрал красный автомобиль.",
          "source": "Tatoeba #8046276 @raggione / #10140055 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8046276",
          "cefr_level": "A1",
          "word_slugs": [
            "wählte-verb"
          ]
        },
        {
          "id": "3675056",
          "text": "Er wählte sie zufällig aus.",
          "translation": "Он выбрал её случайно.",
          "source": "Tatoeba #3675056 @Esperantostern / #3675808 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3675056",
          "cefr_level": "A1",
          "word_slugs": [
            "wählte-verb"
          ]
        },
        {
          "id": "2728098",
          "text": "Ich wählte die falsche Antwort.",
          "translation": "Я выбрал неправильный ответ.",
          "source": "Tatoeba #2728098 @Pfirsichbaeumchen / #2313774 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2728098",
          "cefr_level": "A1",
          "word_slugs": [
            "wählte-verb"
          ]
        },
        {
          "id": "1798580",
          "text": "Schließlich wählte sie ein anderes Kätzchen aus.",
          "translation": "В конце концов она выбрала другого котёнка.",
          "source": "Tatoeba #1798580 @Tamy / #508122 @Kostia (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1798580",
          "cefr_level": "A1",
          "word_slugs": [
            "wählte-verb"
          ]
        }
