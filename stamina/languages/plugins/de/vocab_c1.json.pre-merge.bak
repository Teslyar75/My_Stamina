      "gender": null,
      "examples": [
        {
          "id": "2430387",
          "text": "Positive Überzeugungen sind unsere besten Verbündeten.",
          "translation": "Позитивные убеждения — наши лучшие союзники.",
          "source": "Tatoeba #2430387 @al_ex_an_der / #2430389 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430387",
          "cefr_level": "A1",
          "word_slugs": [
            "verbündeten-noun"
          ]
        },
        {
          "id": "13039568",
          "text": "Mit solchen Verbündeten braucht man keine Feinde.",
          "translation": "С такими союзниками и враги не нужны.",
          "source": "Tatoeba #13039568 @mhr / #13039556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13039568",
          "cefr_level": "A1",
          "word_slugs": [
