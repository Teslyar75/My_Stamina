    {
      "slug": "vorkommen-verb",
      "lemma": "vorkommen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5911,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "быть",
          "существовать"
        ],
        "en": [
          "to appear, to occur (in a given location or situation)",
          "to occur, to happen (with some regularity)",
          "to seem, to appear",
          "to seem, to appear"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1703245",
          "text": "Es wird nicht wieder vorkommen.",
          "translation": "Такого больше не произойдёт.",
          "source": "Tatoeba #1703245 @al_ex_an_der / #2576080 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1703245",
          "cefr_level": "A1",
          "word_slugs": [
            "vorkommen-verb"
          ]
        },
        {
          "id": "8211045",
          "text": "Ich möchte mir wichtig vorkommen.",
          "translation": "Я хотел бы чувствовать себя важным.",
          "source": "Tatoeba #8211045 @Pfirsichbaeumchen / #8111089 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8211045",
          "cefr_level": "A1",
          "word_slugs": [
            "vorkommen-verb"
          ]
        },
        {
          "id": "3093092",
          "text": "Es tut mir leid. Das wird nicht wieder vorkommen.",
          "translation": "Простите, это больше не повторится.",
          "source": "Tatoeba #3093092 @brauchinet / #3094757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3093092",
          "cefr_level": "A1",
          "word_slugs": [
            "vorkommen-verb"
          ]
        },
        {
          "id": "4046832",
          "text": "Mach dir keine Sorgen. Es wird nicht wieder vorkommen.",
          "translation": "Не беспокойся. Это не повторится.",
          "source": "Tatoeba #4046832 @g_j / #4046882 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4046832",
          "cefr_level": "A1",
          "word_slugs": [
            "vorkommen-verb"
          ]
        },
        {
          "id": "971274",
          "text": "Ich versichere Ihnen, dass so ein Fehler nicht wieder vorkommen wird.",
          "translation": "Уверяю Вас, что подобная ошибка никогда не повторится.",
          "source": "Tatoeba #971274 @MUIRIEL / #388739 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/971274",
          "cefr_level": "A1",
          "word_slugs": [
            "vorkommen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
