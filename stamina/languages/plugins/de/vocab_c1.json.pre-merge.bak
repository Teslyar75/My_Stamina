    {
      "slug": "abgegeben-verb",
      "lemma": "abgegeben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6067,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of abgeben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1699110",
          "text": "Hast du deine Hausaufgaben abgegeben?",
          "translation": "Ты сдал домашнюю работу?",
          "source": "Tatoeba #1699110 @Pfirsichbaeumchen / #11934414 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1699110",
          "cefr_level": "A1",
          "word_slugs": [
            "abgegeben-verb"
          ]
        },
        {
          "id": "2840504",
          "text": "Dieses Medikament wird rezeptfrei abgegeben.",
          "translation": "Это лекарство выдаётся без рецепта.",
          "source": "Tatoeba #2840504 @al_ex_an_der / #8306662 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2840504",
          "cefr_level": "A1",
          "word_slugs": [
            "abgegeben-verb"
          ]
        },
        {
          "id": "396569",
          "text": "Hast du dein Referat schon abgegeben?",
          "translation": "Ты уже сдал свой реферат?",
          "source": "Tatoeba #396569 @xtofu80 / #6960511 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/396569",
          "cefr_level": "A1",
          "word_slugs": [
            "abgegeben-verb"
          ]
        },
        {
          "id": "1752848",
          "text": "Er hat gestern seinen Löffel abgegeben.",
          "translation": "Он вчера умер.",
          "source": "Tatoeba #1752848 @al_ex_an_der / #376024 @reiji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1752848",
          "cefr_level": "A1",
          "word_slugs": [
            "abgegeben-verb"
          ]
        },
        {
          "id": "2842210",
          "text": "Dieses Medikament wird nur auf Rezept abgegeben.",
          "translation": "Этот препарат отпускается только по рецепту.",
          "source": "Tatoeba #2842210 @al_ex_an_der / #6960536 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2842210",
          "cefr_level": "A1",
          "word_slugs": [
            "abgegeben-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
