          "word_slugs": [
            "schönsten-adj"
          ]
        },
        {
          "id": "14045138",
          "text": "Spanien hat die schönsten Strände.",
          "translation": "В Испании самые красивые пляжи.",
          "source": "Tatoeba #14045138 @Ioan_Cristian / #14045307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14045138",
          "cefr_level": "A1",
          "word_slugs": [
            "schönsten-adj"
          ]
        },
        {
          "id": "13447468",
          "text": "Erzähl mir von deiner schönsten Kindheitserinnerung!",
          "translation": "Расскажи мне о самом прекрасном воспоминании детства.",
          "source": "Tatoeba #13447468 @mhr / #13447466 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13447468",
          "cefr_level": "A1",
          "word_slugs": [
            "schönsten-adj"
          ]
        },
        {
          "id": "6795090",
          "text": "Deine Augen sind die schönsten der Welt.",
          "translation": "Твои глаза самые красивые на свете.",
          "source": "Tatoeba #6795090 @Adelpa / #6796821 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6795090",
          "cefr_level": "A1",
          "word_slugs": [
            "schönsten-adj"
          ]
        },
        {
          "id": "4289593",
          "text": "Die einfachen Lösungen sind immer die schönsten.",
          "translation": "Простые решения всегда самые красивые.",
          "source": "Tatoeba #4289593 @raggione / #4289598 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4289593",
          "cefr_level": "A1",
          "word_slugs": [
            "schönsten-adj"
          ]
        }
      ],
