      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "возлюбленный",
          "любовник"
        ],
        "en": [
          "lover, romantic partner (male or of unspecified gender; now usually implying an affair, otherwise somewhat poetic)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3559094",
          "text": "Leider kommen meine Frau und mein Geliebter nicht sehr gut miteinander aus.",
          "translation": "К сожалению, моя жена и мой любовник не ладят друг с другом.",
          "source": "Tatoeba #3559094 @alik_farber / #3561367 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3559094",
