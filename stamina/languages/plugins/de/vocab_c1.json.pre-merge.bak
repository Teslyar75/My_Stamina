          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4049299",
          "text": "Es funktionierte im Film!",
          "translation": "В фильме это работало!",
          "source": "Tatoeba #4049299 @Esperantostern / #4064413 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4049299",
          "cefr_level": "A1",
