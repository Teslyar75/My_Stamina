          "невероятный"
        ],
        "en": [
          "unlikely, improbable",
          "unbelievable, incredible"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2652253",
          "text": "Ich bin unwahrscheinlich müde.",
          "translation": "Я невероятно устал.",
          "source": "Tatoeba #2652253 @Pfirsichbaeumchen / #2526192 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2652253",
          "cefr_level": "A1",
          "word_slugs": [
            "unwahrscheinlich-adj"
          ]
        },
        {
          "id": "13426706",
          "text": "Das ist ziemlich unwahrscheinlich.",
          "translation": "Это довольно маловероятно.",
          "source": "Tatoeba #13426706 @mhr / #13426590 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13426706",
          "cefr_level": "A1",
          "word_slugs": [
            "unwahrscheinlich-adj"
          ]
        },
        {
          "id": "12960845",
          "text": "Das ist vollkommen unwahrscheinlich!",
          "translation": "Это совершенно невероятно!",
          "source": "Tatoeba #12960845 @mhr / #12959867 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12960845",
          "cefr_level": "A1",
          "word_slugs": [
            "unwahrscheinlich-adj"
          ]
        },
        {
          "id": "9265595",
          "text": "Das Ergebnis war unwahrscheinlich gut.",
          "translation": "Результат был невероятно хорош.",
          "source": "Tatoeba #9265595 @Pfirsichbaeumchen / #9186944 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9265595",
          "cefr_level": "A1",
          "word_slugs": [
            "unwahrscheinlich-adj"
          ]
        },
        {
          "id": "2056903",
          "text": "Dennoch bin ich unwahrscheinlich stolz.",
          "translation": "Тем не менее, я невероятно горд.",
          "source": "Tatoeba #2056903 @al_ex_an_der / #2056898 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2056903",
          "cefr_level": "A1",
          "word_slugs": [
            "unwahrscheinlich-adj"
          ]
        }
      ],
