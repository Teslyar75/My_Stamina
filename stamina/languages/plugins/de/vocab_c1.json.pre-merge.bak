    {
      "slug": "überstehen-verb",
      "lemma": "überstehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6314,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "выносить",
          "вынести"
        ],
        "en": [
          "to endure, to overcome, to survive, to pull through"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2466507",
          "text": "Der Patient wird den Sommer nicht überstehen.",
          "translation": "Пациент не переживёт лето.",
          "source": "Tatoeba #2466507 @Tamy / #12155668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2466507",
          "cefr_level": "A1",
          "word_slugs": [
            "überstehen-verb"
          ]
        },
        {
          "id": "894842",
          "text": "Kann der Patient eine solch lange Operation überstehen?",
