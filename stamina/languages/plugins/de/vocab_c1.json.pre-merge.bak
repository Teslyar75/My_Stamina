    {
      "slug": "ansichten-noun",
      "lemma": "Ansichten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8959,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Ansicht"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13937162",
          "text": "Ich vertrete linke Ansichten.",
          "translation": "Я придерживаюсь левых взглядов.",
          "source": "Tatoeba #13937162 @mhr / #13937159 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13937162",
          "cefr_level": "A1",
          "word_slugs": [
            "ansichten-noun"
          ]
        },
        {
          "id": "8652001",
          "text": "Ich respektiere deine Ansichten.",
          "translation": "Я уважаю твои взгляды.",
          "source": "Tatoeba #8652001 @Melang / #8661884 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8652001",
          "cefr_level": "A1",
          "word_slugs": [
            "ansichten-noun"
          ]
        },
        {
          "id": "1709825",
          "text": "Unsere Ansichten gehen weit auseinander.",
          "translation": "Наши взгляды широко расходятся.",
          "source": "Tatoeba #1709825 @Zaghawa / #7726372 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1709825",
          "cefr_level": "A1",
          "word_slugs": [
            "ansichten-noun"
          ]
        },
        {
          "id": "3085243",
          "text": "In vielem haben wir ähnliche Ansichten.",
          "translation": "Во многом его взгляды схожи с моими.",
          "source": "Tatoeba #3085243 @al_ex_an_der / #3085238 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3085243",
          "cefr_level": "A1",
          "word_slugs": [
            "ansichten-noun"
          ]
        },
        {
          "id": "3000749",
          "text": "Meine Großmutter hatte sehr vernünftige Ansichten.",
          "translation": "У моей бабушки были очень разумные взгляды.",
          "source": "Tatoeba #3000749 @al_ex_an_der / #3000753 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3000749",
          "cefr_level": "A1",
          "word_slugs": [
            "ansichten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
