          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3545840",
          "text": "Verdunkelte Tugend scheint heller.",
          "translation": "Завуалированная добродетель светит ярче.",
          "source": "Tatoeba #3545840 @Esperantostern / #3546996 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3545840",
          "cefr_level": "A1",
          "word_slugs": [
            "heller-adj"
          ]
        },
        {
          "id": "2581476",
          "text": "Das Licht wurde immer heller.",
          "translation": "Свет становился всё ярче и ярче.",
          "source": "Tatoeba #2581476 @al_ex_an_der / #2581474 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2581476",
          "cefr_level": "A1",
          "word_slugs": [
            "heller-adj"
          ]
        },
        {
          "id": "1196689",
          "text": "Der Himmel ist heller geworden.",
          "translation": "Небо стало светлее.",
          "source": "Tatoeba #1196689 @Esperantostern / #13481313 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1196689",
          "cefr_level": "A1",
          "word_slugs": [
            "heller-adj"
          ]
        },
        {
          "id": "2581477",
          "text": "Das Licht wurde heller und heller.",
          "translation": "Свет становился всё ярче и ярче.",
          "source": "Tatoeba #2581477 @al_ex_an_der / #2581474 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2581477",
          "cefr_level": "A1",
          "word_slugs": [
            "heller-adj"
          ]
        },
        {
          "id": "9814694",
          "text": "Dieser neue Bildschirm ist viel heller.",
          "translation": "Этот новый экран гораздо ярче.",
          "source": "Tatoeba #9814694 @GaryGaryGary / #8163603 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9814694",
          "cefr_level": "A1",
          "word_slugs": [
            "heller-adj"
          ]
        }
