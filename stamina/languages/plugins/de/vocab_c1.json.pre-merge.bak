          ]
        },
        {
          "id": "2280790",
          "text": "Das Geheimnis guter Prosa liegt im Rhythmus der Sprache.",
          "translation": "Секрет хорошей прозы заключается в ритме языка.",
          "source": "Tatoeba #2280790 @al_ex_an_der / #2280801 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2280790",
          "cefr_level": "A1",
          "word_slugs": [
