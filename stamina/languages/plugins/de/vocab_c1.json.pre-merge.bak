          ]
        },
        {
          "id": "8942455",
          "text": "Maria wird nichts bemerken.",
          "translation": "Мэри ничего не заметит.",
          "source": "Tatoeba #8942455 @felix63 / #8950293 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8942455",
          "cefr_level": "A1",
