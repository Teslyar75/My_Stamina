      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to stand there",
          "to look, to come across as"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7333569",
          "text": "Du kannst nicht einfach dastehen und nichts tun.",
          "translation": "Ты не можешь просто стоять там и ничего не делать.",
          "source": "Tatoeba #7333569 @Pfirsichbaeumchen / #13864205 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7333569",
          "cefr_level": "A1",
          "word_slugs": [
            "dastehen-verb"
          ]
        },
        {
          "id": "7333548",
          "text": "Ich konnte nicht einfach dastehen und nichts tun.",
          "translation": "Я не мог просто стоять там и ничего не делать.",
          "source": "Tatoeba #7333548 @Pfirsichbaeumchen / #13864208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7333548",
          "cefr_level": "A1",
          "word_slugs": [
            "dastehen-verb"
          ]
        },
        {
          "id": "9479646",
          "text": "Tom hatte Angst, Fragen zu stellen, denn er wollte nicht dumm dastehen.",
          "translation": "Том боялся задавать вопросы, потому что не хотел показаться глупым.",
          "source": "Tatoeba #9479646 @Pfirsichbaeumchen / #8158071 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9479646",
          "cefr_level": "A1",
          "word_slugs": [
            "dastehen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
