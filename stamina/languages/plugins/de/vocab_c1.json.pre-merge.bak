          "pension, retirement pay"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3743120",
          "text": "Tom ging in Rente.",
          "translation": "Том ушел на пенсию.",
          "source": "Tatoeba #3743120 @zwhzwh / #3743116 @zwhzwh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3743120",
          "cefr_level": "A1",
          "word_slugs": [
            "rente-noun"
          ]
        },
        {
          "id": "8817940",
          "text": "Ich bin jetzt in Rente.",
          "translation": "Я теперь на пенсии.",
          "source": "Tatoeba #8817940 @wolfgangth / #4553655 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8817940",
          "cefr_level": "A1",
          "word_slugs": [
            "rente-noun"
          ]
        },
        {
          "id": "621469",
          "text": "Der Alte lebt von seiner Rente.",
          "translation": "Старик живёт на пенсию.",
          "source": "Tatoeba #621469 @kolonjano / #12631180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/621469",
          "cefr_level": "A1",
          "word_slugs": [
            "rente-noun"
          ]
        },
        {
          "id": "3766455",
          "text": "Wann bist du in Rente gegangen?",
          "translation": "Когда ты вышел на пенсию?",
          "source": "Tatoeba #3766455 @Jens_Odo / #3281803 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3766455",
          "cefr_level": "A1",
          "word_slugs": [
            "rente-noun"
          ]
        },
        {
          "id": "784609",
          "text": "Er ist mit 65 in Rente gegangen.",
          "translation": "Он вышел на пенсию в шестьдесят пять лет.",
          "source": "Tatoeba #784609 @MUIRIEL / #2522346 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/784609",
          "cefr_level": "A1",
          "word_slugs": [
            "rente-noun"
          ]
        }
      ],
