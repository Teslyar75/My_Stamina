      },
      "gender": null,
      "examples": [
        {
          "id": "4929489",
          "text": "Das kostete eine Menge.",
          "translation": "Это стоило кучу денег.",
          "source": "Tatoeba #4929489 @bonny37 / #3647056 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4929489",
