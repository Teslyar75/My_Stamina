    {
      "slug": "anfing-verb",
      "lemma": "anfing",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5281,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular dependent preterite of anfangen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10458640",
          "text": "Als ich damit anfing, hieß Tom mich innehalten.",
          "translation": "Когда я начал это делать, Том сказал мне, чтобы я перестал.",
          "source": "Tatoeba #10458640 @Pfirsichbaeumchen / #10456089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10458640",
          "cefr_level": "A1",
          "word_slugs": [
            "anfing-verb"
          ]
        },
        {
          "id": "3559030",
          "text": "Maria war so glücklich, dass sie zu tanzen anfing.",
          "translation": "Мария была такой счастливой, что начала танцевать.",
          "source": "Tatoeba #3559030 @Pfirsichbaeumchen / #3559072 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3559030",
          "cefr_level": "A1",
          "word_slugs": [
            "anfing-verb"
          ]
        },
        {
          "id": "10458642",
          "text": "Als ich damit anfing, sagte Tom, ich solle aufhören.",
          "translation": "Когда я начал это делать, Том сказал мне, чтобы я перестал.",
          "source": "Tatoeba #10458642 @Pfirsichbaeumchen / #10456089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10458642",
          "cefr_level": "A1",
          "word_slugs": [
            "anfing-verb"
          ]
        },
        {
          "id": "2299613",
          "text": "Ihre Freude war so groß, dass sie anfing zu tanzen.",
          "translation": "Её радость была так велика, что она принялась танцевать.",
          "source": "Tatoeba #2299613 @Pfirsichbaeumchen / #2284749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2299613",
          "cefr_level": "A1",
          "word_slugs": [
            "anfing-verb"
          ]
        },
        {
          "id": "6051302",
          "text": "Es war alles in Ordnung, bis Tom mit dem Trinken anfing.",
          "translation": "Все было хорошо, пока Том не начал пить.",
          "source": "Tatoeba #6051302 @Pfirsichbaeumchen / #4131851 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6051302",
          "cefr_level": "A1",
          "word_slugs": [
            "anfing-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
