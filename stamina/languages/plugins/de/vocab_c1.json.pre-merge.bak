    {
      "slug": "reichtum-noun",
      "lemma": "Reichtum",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6524,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "богатство"
        ],
        "en": [
          "wealth, richness",
          "riches",
          "affluence, abundance, treasure",
          "variety"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5883853",
          "text": "Von Lumpen zu Reichtum.",
          "translation": "Из грязи в князи.",
          "source": "Tatoeba #5883853 @xarxes / #3885690 @bijin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5883853",
          "cefr_level": "A1",
          "word_slugs": [
            "reichtum-noun"
          ]
        },
        {
          "id": "344369",
          "text": "Gesundheit ist wichtiger als Reichtum.",
          "translation": "Здоровье важнее богатства.",
          "source": "Tatoeba #344369 @MUIRIEL / #4066381 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344369",
          "cefr_level": "A1",
          "word_slugs": [
            "reichtum-noun"
          ]
        },
        {
          "id": "13737468",
          "text": "Bist du stolz auf deinen Reichtum?",
          "translation": "Ты гордишься своим богатством?",
          "source": "Tatoeba #13737468 @alabama / #13221213 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13737468",
          "cefr_level": "A1",
          "word_slugs": [
            "reichtum-noun"
          ]
        },
        {
          "id": "13609202",
          "text": "Kamele sind der einzige Reichtum der Nomaden.",
          "translation": "Верблюды – единственное богатство кочевников.",
          "source": "Tatoeba #13609202 @mhr / #13609188 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13609202",
          "cefr_level": "A1",
          "word_slugs": [
            "reichtum-noun"
          ]
        },
        {
          "id": "532296",
          "text": "Sein Reichtum hat ihn nicht glücklich gemacht.",
          "translation": "Богатство не сделало его счастливым.",
          "source": "Tatoeba #532296 @Manfredo / #5785360 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/532296",
          "cefr_level": "A1",
          "word_slugs": [
            "reichtum-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Reichtum",
        "nominative_pl": ""
      }
