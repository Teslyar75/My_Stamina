          ]
        },
        {
          "id": "9067141",
          "text": "Auf Toms Raumschiff gibt es künstliche Schwerkraft.",
          "translation": "На космическом корабле Тома искусственная гравитация.",
          "source": "Tatoeba #9067141 @Pfirsichbaeumchen / #6533599 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9067141",
          "cefr_level": "A1",
