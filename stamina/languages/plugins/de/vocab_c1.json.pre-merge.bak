          "source": "Tatoeba #1691092 @Pfirsichbaeumchen / #3248845 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1691092",
          "cefr_level": "A1",
          "word_slugs": [
