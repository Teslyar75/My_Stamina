      },
      "gender": null,
      "examples": [
        {
          "id": "4103077",
          "text": "Du hast teure Ohrringe an.",
          "translation": "На тебе дорогие серёжки.",
          "source": "Tatoeba #4103077 @raggione / #4103087 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4103077",
