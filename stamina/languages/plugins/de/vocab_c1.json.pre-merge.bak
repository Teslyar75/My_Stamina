    {
      "slug": "verleihen-verb",
      "lemma": "verleihen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8920,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to award (someone an honor, a medal, etc); to confer (a title or degree upon someone)",
          "to lend (something to someone, for a finite period of time)",
          "to vest (a power in someone), to give (a right to someone)",
          "to give (an attribute to something)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2159395",
          "text": "Ich bin außerstande, meinen Gefühlen Ausdruck zu verleihen.",
          "translation": "Я не в состоянии выразить свои чувства.",
          "source": "Tatoeba #2159395 @Pfirsichbaeumchen / #2159289 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2159395",
          "cefr_level": "A1",
          "word_slugs": [
            "verleihen-verb"
          ]
        },
        {
          "id": "2159388",
          "text": "Ich bin nicht imstande, meinen Gefühlen Ausdruck zu verleihen.",
          "translation": "Я не в состоянии выразить свои чувства.",
          "source": "Tatoeba #2159388 @Pfirsichbaeumchen / #2159289 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2159388",
          "cefr_level": "A1",
          "word_slugs": [
            "verleihen-verb"
          ]
        },
        {
          "id": "2118357",
          "text": "Mir fehlen die Worte, um meiner Dankbarkeit Ausdruck zu verleihen.",
          "translation": "У меня нет слов, чтобы выразить мою благодарность.",
          "source": "Tatoeba #2118357 @al_ex_an_der / #2118338 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2118357",
          "cefr_level": "A1",
          "word_slugs": [
            "verleihen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
