          ]
        },
        {
          "id": "6864341",
          "text": "Tom hatte überall Lippenstift im Gesicht.",
          "translation": "У Тома всё лицо было в губной помаде.",
          "source": "Tatoeba #6864341 @benbika / #8253559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6864341",
          "cefr_level": "A1",
          "word_slugs": [
            "lippenstift-noun"
          ]
        },
        {
          "id": "342255",
          "text": "Brian hat einen Lippenstift für Kate gekauft.",
          "translation": "Брайан купил Кейт помаду.",
          "source": "Tatoeba #342255 @MUIRIEL / #4641532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/342255",
          "cefr_level": "A1",
          "word_slugs": [
            "lippenstift-noun"
          ]
        },
        {
          "id": "1873265",
          "text": "Ich suche einen zu diesem Nagellack passenden Lippenstift.",
          "translation": "Я ищу губную помаду, которая бы подошла к этому лаку для ногтей.",
          "source": "Tatoeba #1873265 @Pfirsichbaeumchen / #408963 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1873265",
          "cefr_level": "A1",
          "word_slugs": [
