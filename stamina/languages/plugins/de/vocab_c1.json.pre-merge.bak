        },
        {
          "id": "13530926",
          "text": "Wie gedenken Sie das zu ändern?",
          "translation": "Как вы собираетесь это изменить?",
          "source": "Tatoeba #13530926 @Waldelfe / #5266378 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13530926",
          "cefr_level": "A1",
          "word_slugs": [
            "gedenken-verb"
          ]
        },
        {
          "id": "8273131",
          "text": "Und wann gedenken Sie es mir zu sagen?",
          "translation": "И когда вы собираетесь мне это сказать?",
          "source": "Tatoeba #8273131 @Pfirsichbaeumchen / #8273196 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8273131",
          "cefr_level": "A1",
          "word_slugs": [
            "gedenken-verb"
          ]
        },
        {
          "id": "13662970",
          "text": "Diese Menschen verdienen es, dass wir ihrer gedenken.",
          "translation": "Эти люди заслуживают того, чтобы мы о них помнили.",
          "source": "Tatoeba #13662970 @mhr / #13662968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13662970",
          "cefr_level": "A1",
          "word_slugs": [
            "gedenken-verb"
          ]
        },
        {
          "id": "13090986",
          "text": "Ich muß wissen, wann Sie das zu tun gedenken.",
          "translation": "Мне нужно знать, когда вы планируете это сделать.",
          "source": "Tatoeba #13090986 @Waldelfe / #6937616 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13090986",
          "cefr_level": "A1",
          "word_slugs": [
            "gedenken-verb"
          ]
        }
      ],
