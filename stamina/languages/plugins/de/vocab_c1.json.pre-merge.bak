    {
      "slug": "knöpfe-noun",
      "lemma": "Knöpfe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7943,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Knopf"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13258841",
          "text": "Diese Knöpfe sind klein.",
          "translation": "Эти пуговицы маленькие.",
          "source": "Tatoeba #13258841 @felix63 / #13261617 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13258841",
          "cefr_level": "A1",
          "word_slugs": [
            "knöpfe-noun"
          ]
        },
        {
          "id": "10495363",
          "text": "Ihr Rock hat drei Knöpfe.",
          "translation": "На её юбке три пуговицы.",
          "source": "Tatoeba #10495363 @Pfirsichbaeumchen / #13539935 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10495363",
          "cefr_level": "A1",
          "word_slugs": [
            "knöpfe-noun"
          ]
        },
        {
          "id": "13341403",
          "text": "Sie hat allen ihren Kindern beigebracht, Knöpfe anzunähen.",
          "translation": "Она научила всех своих детей пришивать пуговицы.",
          "source": "Tatoeba #13341403 @Waldelfe / #13328894 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13341403",
          "cefr_level": "A1",
