    {
      "slug": "verhaftung-noun",
      "lemma": "Verhaftung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5667,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "arrest, detention"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8864983",
          "text": "Ich verließ Australien, um einer Verhaftung zu entgehen.",
          "translation": "Я покинул Австралию, чтобы избежать ареста.",
          "source": "Tatoeba #8864983 @mramosch / #8865104 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8864983",
          "cefr_level": "A1",
          "word_slugs": [
            "verhaftung-noun"
          ]
        },
        {
          "id": "2436309",
          "text": "Wie haben Sie von der Verhaftung ihres Sohnes erfahren?",
          "translation": "Как вам стало известно об аресте сына?",
          "source": "Tatoeba #2436309 @al_ex_an_der / #2436307 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2436309",
          "cefr_level": "A1",
          "word_slugs": [
            "verhaftung-noun"
          ]
        },
        {
          "id": "2836640",
          "text": "Gleich nach meiner Verhaftung bin ich mehrmals verhört worden.",
          "translation": "Сразу же после моего ареста меня несколько раз допросили.",
          "source": "Tatoeba #2836640 @sigavax / #2836681 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2836640",
          "cefr_level": "A1",
          "word_slugs": [
