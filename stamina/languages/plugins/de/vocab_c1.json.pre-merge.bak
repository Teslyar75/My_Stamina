    {
      "slug": "heisser-adj",
      "lemma": "heißer",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5719,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of heiss:",
          "strong/mixed nominative masculine singular",
          "inflection of heiss:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "973812",
          "text": "Es wird täglich heißer.",
          "translation": "С каждым днём становится всё жарче.",
          "source": "Tatoeba #973812 @Sudajaengi / #1489739 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/973812",
          "cefr_level": "A1",
          "word_slugs": [
            "heisser-adj"
          ]
        },
        {
          "id": "905628",
          "text": "Heute ist ein heißer Tag.",
          "translation": "Сегодня жаркий день.",
          "source": "Tatoeba #905628 @Esperantostern / #5484287 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/905628",
          "cefr_level": "A1",
          "word_slugs": [
            "heisser-adj"
          ]
        },
        {
          "id": "11830779",
          "text": "Es ist heißer als gestern.",
          "translation": "Сегодня жарче, чем вчера.",
          "source": "Tatoeba #11830779 @Pfirsichbaeumchen / #11630409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11830779",
          "cefr_level": "A1",
          "word_slugs": [
