      "gender": null,
      "examples": [
        {
          "id": "372920",
          "text": "Was ist deine wirkliche Absicht?",
          "translation": "Что есть твоя действительная цель?",
          "source": "Tatoeba #372920 @xtofu80 / #598901 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/372920",
          "cefr_level": "A1",
          "word_slugs": [
            "wirkliche-adj"
          ]
        },
        {
          "id": "8834197",
          "text": "Ich habe eine wirkliche Dummheit begangen.",
          "translation": "Я совершил нечто по-настоящему глупое.",
          "source": "Tatoeba #8834197 @wolfgangth / #4398070 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8834197",
          "cefr_level": "A1",
          "word_slugs": [
            "wirkliche-adj"
          ]
        },
        {
          "id": "2804892",
          "text": "Die wirkliche Liebe beginnt, wo keine Gegenliebe mehr erwartet wird.",
          "translation": "Настоящая любовь начинается, когда уже не ждёшь её взаимности.",
          "source": "Tatoeba #2804892 @Esperantostern / #2805068 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2804892",
          "cefr_level": "A1",
          "word_slugs": [
            "wirkliche-adj"
          ]
        }
