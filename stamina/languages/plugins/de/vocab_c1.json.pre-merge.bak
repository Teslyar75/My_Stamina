    {
      "slug": "entstehen-verb",
      "lemma": "entstehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7365,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "возникать",
          "появляться"
        ],
        "en": [
          "to come into being, to arise, to be produced",
          "to develop"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2346598",
          "text": "Tagtäglich entstehen neue Wörter.",
          "translation": "Новые слова возникают ежедневно.",
          "source": "Tatoeba #2346598 @al_ex_an_der / #2346596 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2346598",
          "cefr_level": "A1",
          "word_slugs": [
            "entstehen-verb"
          ]
        },
        {
          "id": "6743151",
          "text": "Hier soll eine Fabrik entstehen.",
          "translation": "Здесь будет строиться завод.",
          "source": "Tatoeba #6743151 @Pfirsichbaeumchen / #5879137 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6743151",
          "cefr_level": "A1",
          "word_slugs": [
            "entstehen-verb"
          ]
        },
        {
          "id": "777235",
          "text": "Was könnte ein Planet brauchen, um Leben entstehen zu lassen?",
          "translation": "Что может потребоваться планете для зарождения жизни?",
          "source": "Tatoeba #777235 @Pfirsichbaeumchen / #777232 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/777235",
          "cefr_level": "A1",
          "word_slugs": [
            "entstehen-verb"
          ]
        },
        {
          "id": "1081209",
          "text": "Manchmal glaube ich, Fliegen entstehen, wenn Sonnenlicht auf Staubpartikel trifft.",
          "translation": "Иногда мне кажется, что мухи возникают, когда солнечный свет попадает на частицы пыли.",
          "source": "Tatoeba #1081209 @Vortarulo / #1525188 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1081209",
          "cefr_level": "A1",
          "word_slugs": [
            "entstehen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
