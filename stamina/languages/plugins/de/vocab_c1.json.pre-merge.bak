        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4736061",
          "text": "Ich mag Nudeln.",
          "translation": "Я люблю лапшу.",
          "source": "Tatoeba #4736061 @raggione / #2807804 @User55521 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4736061",
          "cefr_level": "A1",
          "word_slugs": [
            "nudeln-noun"
          ]
        },
        {
          "id": "349837",
          "text": "Ich esse Nudeln.",
          "translation": "Я ем макароны.",
          "source": "Tatoeba #349837 @human600 / #4414490 @michalina (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/349837",
          "cefr_level": "A1",
          "word_slugs": [
            "nudeln-noun"
          ]
        },
        {
          "id": "13636844",
          "text": "Tom ißt gerne Nudeln.",
          "translation": "Том любит макароны.",
          "source": "Tatoeba #13636844 @Waldelfe / #7073835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13636844",
          "cefr_level": "A1",
          "word_slugs": [
            "nudeln-noun"
          ]
        },
        {
          "id": "1211001",
          "text": "Ich esse gerade Nudeln.",
          "translation": "Я сейчас ем лапшу.",
          "source": "Tatoeba #1211001 @samueldora / #9156363 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1211001",
          "cefr_level": "A1",
          "word_slugs": [
            "nudeln-noun"
          ]
        },
        {
          "id": "14089939",
          "text": "Ich kann nur Nudeln kochen.",
          "translation": "Я только макароны умею варить.",
          "source": "Tatoeba #14089939 @maaster / #14089940 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14089939",
          "cefr_level": "A1",
          "word_slugs": [
            "nudeln-noun"
          ]
        }
      ],
