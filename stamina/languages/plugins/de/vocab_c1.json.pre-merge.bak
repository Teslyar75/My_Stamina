      "gender": null,
      "examples": [
        {
          "id": "3068281",
          "text": "Hast du Tom verziehen?",
          "translation": "Ты простил Тома?",
          "source": "Tatoeba #3068281 @Pfirsichbaeumchen / #3068358 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3068281",
