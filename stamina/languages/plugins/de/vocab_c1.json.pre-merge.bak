    {
      "slug": "weiterleben-verb",
      "lemma": "weiterleben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6812,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to live on, to continue to live, to survive"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3865118",
          "text": "Ich will weiterleben.",
          "translation": "Я хочу жить дальше.",
          "source": "Tatoeba #3865118 @Esperantostern / #4597120 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3865118",
          "cefr_level": "A1",
          "word_slugs": [
            "weiterleben-verb"
          ]
        },
        {
          "id": "11701325",
          "text": "Ich kann nicht weiterleben.",
          "translation": "Я не могу больше жить.",
          "source": "Tatoeba #11701325 @Pfirsichbaeumchen / #7800913 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11701325",
          "cefr_level": "A1",
          "word_slugs": [
            "weiterleben-verb"
          ]
        },
        {
          "id": "9068950",
          "text": "Er wollte einfach nicht weiterleben.",
          "translation": "Он просто не хотел больше жить.",
          "source": "Tatoeba #9068950 @maaster / #11674507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9068950",
          "cefr_level": "A1",
          "word_slugs": [
            "weiterleben-verb"
          ]
        },
        {
          "id": "14067238",
          "text": "Sie werden sich die Gesundheit ruinieren, wenn Sie so weiterleben.",
          "translation": "Вы испортите себе здоровье, если будете продолжать так жить.",
          "source": "Tatoeba #14067238 @mhr / #14066752 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067238",
          "cefr_level": "A1",
          "word_slugs": [
            "weiterleben-verb"
          ]
        },
        {
          "id": "1311118",
          "text": "Eine neue Art von Denken ist notwendig, wenn die Menschheit weiterleben will.",
          "translation": "Новый образ мыслей необходим, если человечество хочет жить дальше.",
          "source": "Tatoeba #1311118 @Esperantostern / #8590567 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1311118",
          "cefr_level": "A1",
          "word_slugs": [
            "weiterleben-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
