    {
      "slug": "erfordert-verb",
      "lemma": "erfordert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5531,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of erfordern:",
          "third-person singular present",
          "inflection of erfordern:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3304110",
          "text": "Englischlernen erfordert Geduld.",
          "translation": "Изучение английского требует терпения.",
          "source": "Tatoeba #3304110 @Pfirsichbaeumchen / #646379 @nami (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3304110",
          "cefr_level": "A1",
          "word_slugs": [
            "erfordert-verb"
          ]
        },
        {
          "id": "12505894",
          "text": "Diese Arbeit erfordert Übung.",
          "translation": "Эта работа требует практики.",
          "source": "Tatoeba #12505894 @mhr / #12505851 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12505894",
          "cefr_level": "A1",
          "word_slugs": [
            "erfordert-verb"
          ]
        },
        {
          "id": "8096512",
          "text": "Geige spielen erfordert viel Übung.",
          "translation": "Игра на скрипке требует много практики.",
          "source": "Tatoeba #8096512 @Pfirsichbaeumchen / #13409065 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8096512",
          "cefr_level": "A1",
          "word_slugs": [
            "erfordert-verb"
          ]
        },
        {
          "id": "10484541",
          "text": "Das erfordert eine besondere Fähigkeit.",
          "translation": "Здесь нужен особый навык.",
          "source": "Tatoeba #10484541 @carlosalberto / #4238633 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10484541",
          "cefr_level": "A1",
          "word_slugs": [
            "erfordert-verb"
          ]
        },
        {
          "id": "2379019",
          "text": "Die Situation erfordert drastische Maßnahmen.",
          "translation": "Ситуация требует радикальных мер.",
          "source": "Tatoeba #2379019 @duke / #14099836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2379019",
          "cefr_level": "A1",
          "word_slugs": [
            "erfordert-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
