          ]
        },
        {
          "id": "11514764",
          "text": "Die sind sehr elegant.",
          "translation": "Они очень элегантны.",
          "source": "Tatoeba #11514764 @Pfirsichbaeumchen / #11514559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11514764",
          "cefr_level": "A1",
          "word_slugs": [
            "elegant-adj"
          ]
        },
        {
          "id": "4919687",
          "text": "Ich kleide mich gern elegant.",
          "translation": "Я люблю элегантно одеваться.",
          "source": "Tatoeba #4919687 @al_ex_an_der / #13875492 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4919687",
          "cefr_level": "A1",
          "word_slugs": [
            "elegant-adj"
          ]
        },
        {
          "id": "6910367",
          "text": "Warum bist du so elegant gekleidet?",
          "translation": "Что это ты так элегантно одет?",
          "source": "Tatoeba #6910367 @Esperantostern / #13593007 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6910367",
          "cefr_level": "A1",
          "word_slugs": [
            "elegant-adj"
          ]
        },
        {
          "id": "12542285",
          "text": "Gekleidet war sie elegant, aber schlicht.",
          "translation": "Одета она была элегантно, но просто.",
          "source": "Tatoeba #12542285 @mhr / #12542178 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12542285",
          "cefr_level": "A1",
          "word_slugs": [
            "elegant-adj"
          ]
        }
