    {
      "slug": "ertrinken-noun",
      "lemma": "Ertrinken",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7333,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of ertrinken"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "455651",
          "text": "Sie war kurz vor dem Ertrinken.",
          "translation": "Она почти утонула.",
          "source": "Tatoeba #455651 @tokyomews / #1409074 @MikaM (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455651",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-noun"
          ]
        },
        {
          "id": "5853322",
          "text": "Ich habe Angst vor dem Ertrinken.",
          "translation": "Я боюсь утонуть.",
          "source": "Tatoeba #5853322 @Esperantostern / #5258438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5853322",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-noun"
          ]
        },
        {
          "id": "12247760",
          "text": "Er hat sie vor dem Ertrinken gerettet.",
          "translation": "Он спас её, когда она тонула.",
          "source": "Tatoeba #12247760 @Pfirsichbaeumchen / #10150321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12247760",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-noun"
          ]
        },
        {
          "id": "8894234",
          "text": "Er rettete einen Hund vor dem Ertrinken.",
          "translation": "Он спас собаку от утопления.",
          "source": "Tatoeba #8894234 @carlosalberto / #8894236 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8894234",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-noun"
          ]
        },
        {
          "id": "612539",
          "text": "Sie haben den Jungen vor dem Ertrinken gerettet.",
          "translation": "Они спасли тонувшего мальчика.",
          "source": "Tatoeba #612539 @Dejo / #8624016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/612539",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
