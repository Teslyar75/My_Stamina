    {
      "slug": "achtet-verb",
      "lemma": "achtet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8957,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of achten:",
          "third-person singular present",
          "inflection of achten:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2245107",
          "text": "Tom achtet dich.",
          "translation": "Том тебя уважает.",
          "source": "Tatoeba #2245107 @Pfirsichbaeumchen / #2965394 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2245107",
          "cefr_level": "A1",
          "word_slugs": [
            "achtet-verb"
          ]
        },
        {
          "id": "3579703",
          "text": "Niemand achtet mich.",
          "translation": "Никто меня не уважает.",
          "source": "Tatoeba #3579703 @Esperantostern / #3576812 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3579703",
          "cefr_level": "A1",
          "word_slugs": [
            "achtet-verb"
          ]
        },
        {
          "id": "11452356",
          "text": "Achtet nicht auf Tom!",
          "translation": "Не обращайте на Тома внимания.",
          "source": "Tatoeba #11452356 @Bernie75 / #3515823 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11452356",
          "cefr_level": "A1",
          "word_slugs": [
            "achtet-verb"
          ]
        },
        {
          "id": "1352780",
          "text": "Tom achtet seine Eltern.",
          "translation": "Том уважает своих родителей.",
          "source": "Tatoeba #1352780 @Esperantostern / #6876200 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1352780",
          "cefr_level": "A1",
          "word_slugs": [
            "achtet-verb"
          ]
        },
        {
          "id": "3877889",
          "text": "Nora achtet ihre Mutter.",
          "translation": "Нора уважает свою мать.",
          "source": "Tatoeba #3877889 @raggione / #6876201 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3877889",
          "cefr_level": "A1",
          "word_slugs": [
            "achtet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
