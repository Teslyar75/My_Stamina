    {
      "slug": "seltsames-adj",
      "lemma": "seltsames",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6082,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of seltsam"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "966184",
          "text": "Ist irgendetwas Seltsames passiert?",
          "translation": "Произошло что-то странное?",
          "source": "Tatoeba #966184 @MUIRIEL / #7532710 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/966184",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsames-adj"
          ]
        },
        {
          "id": "6111925",
          "text": "Was für ein seltsames Wetter!",
          "translation": "Какая странная погода!",
          "source": "Tatoeba #6111925 @Zaghawa / #6309079 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6111925",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsames-adj"
          ]
        },
        {
          "id": "8943296",
          "text": "Japan ist ein seltsames Land.",
          "translation": "Япония - странная страна.",
          "source": "Tatoeba #8943296 @Pfirsichbaeumchen / #13527756 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8943296",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsames-adj"
          ]
        },
        {
          "id": "3626038",
          "text": "Tom hörte ein seltsames Geräusch.",
          "translation": "Том услышал странный шум.",
          "source": "Tatoeba #3626038 @Pfirsichbaeumchen / #3625969 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3626038",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsames-adj"
          ]
        },
        {
          "id": "370104",
          "text": "Ich habe etwas Seltsames geträumt.",
          "translation": "Мне приснился странный сон.",
          "source": "Tatoeba #370104 @MUIRIEL / #598307 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/370104",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsames-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
