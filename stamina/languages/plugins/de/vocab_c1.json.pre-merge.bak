          "source": "Tatoeba #365425 @Wolf / #793044 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/365425",
          "cefr_level": "A1",
          "word_slugs": [
            "vulkan-name"
          ]
        },
        {
          "id": "1367056",
          "text": "Ich will einen Vulkan sehen.",
          "translation": "Я хочу увидеть вулкан.",
          "source": "Tatoeba #1367056 @boscowitch / #2656282 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1367056",
          "cefr_level": "A1",
          "word_slugs": [
            "vulkan-name"
          ]
        },
        {
          "id": "7866555",
          "text": "Tom hat den Vulkan bestiegen.",
          "translation": "Том забрался на вулкан.",
          "source": "Tatoeba #7866555 @raggione / #12081131 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7866555",
          "cefr_level": "A1",
          "word_slugs": [
            "vulkan-name"
          ]
        },
        {
          "id": "949636",
          "text": "Der Vulkan kann jederzeit ausbrechen.",
          "translation": "Вулкан может начать извергаться в любой момент.",
          "source": "Tatoeba #949636 @Fingerhut / #12594363 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/949636",
          "cefr_level": "A1",
          "word_slugs": [
            "vulkan-name"
          ]
        }
      ],
