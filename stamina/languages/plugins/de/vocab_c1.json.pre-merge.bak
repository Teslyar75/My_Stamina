          ]
        },
        {
          "id": "3481681",
          "text": "Ich liebe Bananen.",
          "translation": "Я люблю бананы.",
          "source": "Tatoeba #3481681 @Pfirsichbaeumchen / #3335862 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3481681",
          "cefr_level": "A1",
