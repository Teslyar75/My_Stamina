          ]
        },
        {
          "id": "12762550",
          "text": "Theoretisch ist so etwas möglich.",
          "translation": "Теоретически такое возможно.",
          "source": "Tatoeba #12762550 @mhr / #12762338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12762550",
          "cefr_level": "A1",
          "word_slugs": [
            "theoretisch-adj"
          ]
        },
        {
          "id": "206",
          "text": "Theoretisch mache ich gerade Mathe.",
          "translation": "Теоретически, я занимаюсь математикой.",
          "source": "Tatoeba #206 @kroko / #5538 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/206",
          "cefr_level": "A1",
          "word_slugs": [
            "theoretisch-adj"
          ]
        },
        {
          "id": "8368855",
          "text": "Theoretisch gibt es unendlich viel davon.",
          "translation": "Теоретически их бесконечное множество.",
          "source": "Tatoeba #8368855 @brauchinet / #8421875 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8368855",
          "cefr_level": "A1",
          "word_slugs": [
            "theoretisch-adj"
          ]
        },
        {
          "id": "1102",
          "text": "Alles ist theoretisch unmöglich, bis es gemacht wurde.",
          "translation": "Теоретически невозможно всё, пока это не сделано.",
          "source": "Tatoeba #1102 @MUIRIEL / #4487657 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1102",
