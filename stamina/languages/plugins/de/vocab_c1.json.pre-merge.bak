          ]
        },
        {
          "id": "9387883",
          "text": "Was stand an der Tafel?",
          "translation": "Что было на доске?",
          "source": "Tatoeba #9387883 @Pfirsichbaeumchen / #9487250 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9387883",
          "cefr_level": "A1",
          "word_slugs": [
            "tafel-noun"
          ]
        },
        {
          "id": "9636180",
          "text": "Im Klassenzimmer ist eine Tafel.",
          "translation": "В классе есть доска.",
          "source": "Tatoeba #9636180 @felix63 / #12835288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9636180",
          "cefr_level": "A1",
          "word_slugs": [
            "tafel-noun"
          ]
        },
        {
          "id": "3103531",
          "text": "Tom kaufte eine Tafel Schokolade.",
          "translation": "Том купил плитку шоколада.",
          "source": "Tatoeba #3103531 @Pfirsichbaeumchen / #2459504 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3103531",
          "cefr_level": "A1",
          "word_slugs": [
