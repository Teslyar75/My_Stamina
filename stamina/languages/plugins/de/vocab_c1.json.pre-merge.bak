    {
      "slug": "manchen-pron",
      "lemma": "manchen",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6273,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of manch:",
          "genitive masculine/neuter singular",
          "inflection of manch:",
          "accusative masculine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14010175",
          "text": "Manchen gefällt diese Idee.",
          "translation": "Некоторым эта идея нравится.",
          "source": "Tatoeba #14010175 @Waldelfe / #5966598 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14010175",
          "cefr_level": "A1",
          "word_slugs": [
            "manchen-pron"
          ]
        },
        {
          "id": "13737311",
          "text": "Manchen gefällt es, anderen nicht.",
          "translation": "Одним это нравится, другим — нет.",
          "source": "Tatoeba #13737311 @mhr / #13735574 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13737311",
          "cefr_level": "A1",
          "word_slugs": [
            "manchen-pron"
          ]
        },
        {
          "id": "8268304",
          "text": "In Deutschland ist es an manchen Stränden verboten, Sandburgen zu bauen.",
