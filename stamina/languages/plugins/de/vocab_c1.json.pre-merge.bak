      "gender": null,
      "examples": [
        {
          "id": "9419484",
          "text": "Der Server ist überlastet.",
          "translation": "Сервер перегружен.",
          "source": "Tatoeba #9419484 @Pfirsichbaeumchen / #3567703 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9419484",
          "cefr_level": "A1",
