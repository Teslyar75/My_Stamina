    {
      "slug": "gastfreundschaft-noun",
      "lemma": "Gastfreundschaft",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8928,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "гостеприимство"
        ],
        "en": [
          "hospitality"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1131508",
          "text": "Danke für eure Gastfreundschaft.",
          "translation": "Спасибо вам за гостеприимство.",
          "source": "Tatoeba #1131508 @MUIRIEL / #3106126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1131508",
          "cefr_level": "A1",
          "word_slugs": [
            "gastfreundschaft-noun"
          ]
        },
        {
          "id": "8302678",
          "text": "Sie sind bekannt für ihre Gastfreundschaft.",
          "translation": "Они известны своим гостеприимством.",
          "source": "Tatoeba #8302678 @felix63 / #12287337 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8302678",
          "cefr_level": "A1",
          "word_slugs": [
            "gastfreundschaft-noun"
          ]
        },
        {
          "id": "2810420",
          "text": "Zuallererst möchte ich Ihnen für Ihre Gastfreundschaft danken.",
          "translation": "Прежде всего, я бы хотел поблагодарить вас за гостеприимство.",
          "source": "Tatoeba #2810420 @Pfirsichbaeumchen / #2810381 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2810420",
          "cefr_level": "A1",
          "word_slugs": [
            "gastfreundschaft-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Gastfreundschaft",
        "nominative_pl": ""
      }
