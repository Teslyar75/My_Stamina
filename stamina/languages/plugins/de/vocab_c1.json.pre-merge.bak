    {
      "slug": "bewohner-noun",
      "lemma": "Bewohner",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6133,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "житель"
        ],
        "en": [
          "agent noun of bewohnen: inhabitant (someone who lives or dwells in a place, especially a room, house, institution)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1510158",
          "text": "Die Bewohner sind Selbstversorger.",
          "translation": "Жители на самообеспечении.",
          "source": "Tatoeba #1510158 @Dejo / #1510161 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1510158",
          "cefr_level": "A1",
          "word_slugs": [
            "bewohner-noun"
          ]
        },
        {
          "id": "1428719",
          "text": "Ich bin ein Bewohner der Erde.",
          "translation": "Я житель планеты Земля.",
          "source": "Tatoeba #1428719 @Manfredo / #13447305 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1428719",
          "cefr_level": "A1",
          "word_slugs": [
            "bewohner-noun"
          ]
        },
        {
          "id": "2763224",
          "text": "Bald ziehen hier die ersten Bewohner ein.",
          "translation": "Вскоре здесь заселятся новые жильцы.",
          "source": "Tatoeba #2763224 @al_ex_an_der / #2765937 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2763224",
          "cefr_level": "A1",
          "word_slugs": [
            "bewohner-noun"
          ]
        },
        {
          "id": "5067830",
          "text": "Die Bewohner des Gaza-Streifens trinken verschmutztes Wasser.",
          "translation": "Жители Газы потребляют загрязнённую воду.",
          "source": "Tatoeba #5067830 @al_ex_an_der / #5007175 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5067830",
          "cefr_level": "A1",
          "word_slugs": [
            "bewohner-noun"
          ]
        },
        {
          "id": "3392454",
          "text": "Viele Bewohner dieser Straße haben ein niedriges Bildungsniveau.",
          "translation": "Многие из живущих на этой улице имеют низкий уровень образования.",
          "source": "Tatoeba #3392454 @al_ex_an_der / #3409717 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3392454",
          "cefr_level": "A1",
          "word_slugs": [
            "bewohner-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Bewohner",
        "nominative_pl": ""
      }
    },
    {
      "slug": "entschied-verb",
      "lemma": "entschied",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
