    {
      "slug": "produkt-noun",
      "lemma": "Produkt",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6007,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "продукт",
          "изделие"
        ],
        "en": [
          "product",
          "product"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "13949279",
          "text": "Warum ist dieses Produkt so beliebt?",
          "translation": "Почему этот продукт так популярен?",
          "source": "Tatoeba #13949279 @mhr / #13948574 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13949279",
          "cefr_level": "A1",
          "word_slugs": [
            "produkt-noun"
          ]
        },
        {
          "id": "674108",
          "text": "Der Mensch ist ein Produkt seiner Umgebung.",
          "translation": "Человек - это продукт своего окружения.",
          "source": "Tatoeba #674108 @sigfrido / #3349602 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/674108",
          "cefr_level": "A1",
          "word_slugs": [
            "produkt-noun"
          ]
        },
        {
          "id": "2492470",
          "text": "Das ist lediglich ein Produkt deiner Fantasie.",
          "translation": "Это просто плод твоего воображения.",
          "source": "Tatoeba #2492470 @al_ex_an_der / #2492443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2492470",
          "cefr_level": "A1",
          "word_slugs": [
            "produkt-noun"
          ]
        },
        {
          "id": "3577615",
          "text": "Vielleicht sind wir ein Produkt unserer Emotionen.",
          "translation": "Возможно, мы продукты наших эмоций.",
          "source": "Tatoeba #3577615 @al_ex_an_der / #3577769 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3577615",
          "cefr_level": "A1",
          "word_slugs": [
            "produkt-noun"
          ]
        },
        {
          "id": "943406",
          "text": "Ist das Produkt aus der Werbung schon ausverkauft?",
          "translation": "Рекламируемый продукт уже распродан?",
          "source": "Tatoeba #943406 @chiyochan / #3126580 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/943406",
          "cefr_level": "A1",
          "word_slugs": [
            "produkt-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Produkt",
        "nominative_pl": ""
      }
    },
    {
      "slug": "tafel-noun",
