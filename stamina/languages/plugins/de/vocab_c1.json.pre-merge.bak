          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "981344",
          "text": "John ist ein amerikanischer Junge.",
          "translation": "Джон - американский мальчик.",
          "source": "Tatoeba #981344 @al_ex_an_der / #1463468 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/981344",
          "cefr_level": "A1",
          "word_slugs": [
