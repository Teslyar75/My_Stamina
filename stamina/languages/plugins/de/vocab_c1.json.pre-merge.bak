    {
      "slug": "schwager-noun",
      "lemma": "Schwager",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6553,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "шурин",
          "деверь"
        ],
        "en": [
          "brother-in-law",
          "in-law; a fairly distant relative by marriage"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "10042789",
          "text": "Tom ist Marias Schwager.",
          "translation": "Том — зять Мэри.",
          "source": "Tatoeba #10042789 @Pfirsichbaeumchen / #1881496 @Aleksander (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10042789",
          "cefr_level": "A1",
          "word_slugs": [
            "schwager-noun"
          ]
        },
        {
          "id": "1349725",
          "text": "Mein Schwager ist Polizist.",
          "translation": "Мой шурин - полицейский.",
          "source": "Tatoeba #1349725 @Esperantostern / #1446134 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1349725",
          "cefr_level": "A1",
          "word_slugs": [
            "schwager-noun"
          ]
        },
        {
          "id": "1705178",
          "text": "Zum Glück ist er nicht mein Schwager geworden.",
          "translation": "К счастью, он не стал моим деверем.",
          "source": "Tatoeba #1705178 @al_ex_an_der / #12842208 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1705178",
          "cefr_level": "A1",
          "word_slugs": [
            "schwager-noun"
          ]
        },
        {
          "id": "2679454",
          "text": "Er ist der Mann meiner Schwester. Er ist mein Schwager.",
          "translation": "Он муж моей сестры. Он мой зять.",
          "source": "Tatoeba #2679454 @Eldad / #2680238 @sobr_vamp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2679454",
          "cefr_level": "A1",
          "word_slugs": [
            "schwager-noun"
          ]
        },
        {
          "id": "10032807",
          "text": "„Gott mit Euch, Herr Schwager!“ – „Glaubt Ihr denn noch an einen?“",
          "translation": "«Бог с вами, дорогой шурин!» – «Так вы всё-таки в него верите?»",
          "source": "Tatoeba #10032807 @Pfirsichbaeumchen / #10032870 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10032807",
          "cefr_level": "A1",
          "word_slugs": [
            "schwager-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Schwager",
        "nominative_pl": ""
      }
    },
