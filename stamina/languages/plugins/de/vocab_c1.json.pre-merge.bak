          "nanny (female) (cf. männliches Kindermädchen (“male nanny or manny”))"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8076610",
          "text": "Bist du das neue Kindermädchen?",
          "translation": "Ты новая няня?",
          "source": "Tatoeba #8076610 @Pfirsichbaeumchen / #13511062 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8076610",
          "cefr_level": "A1",
          "word_slugs": [
            "kindermädchen-noun"
          ]
        },
        {
          "id": "8076609",
          "text": "Sind Sie das neue Kindermädchen?",
          "translation": "Вы новая няня?",
          "source": "Tatoeba #8076609 @Pfirsichbaeumchen / #13511061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8076609",
          "cefr_level": "A1",
          "word_slugs": [
            "kindermädchen-noun"
          ]
        },
        {
          "id": "2650570",
          "text": "Unser Kindermädchen hat sonntags Ausgang.",
          "translation": "У нашей няни в воскресенье выходной.",
          "source": "Tatoeba #2650570 @Olya / #2650571 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650570",
          "cefr_level": "A1",
          "word_slugs": [
            "kindermädchen-noun"
          ]
        },
        {
          "id": "13906659",
          "text": "Puschkins Kindermädchen hieß Arina Rodionowna.",
          "translation": "Няню Пушкина звали Арина Родионовна.",
          "source": "Tatoeba #13906659 @mhr / #13905410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13906659",
          "cefr_level": "A1",
          "word_slugs": [
            "kindermädchen-noun"
          ]
        },
        {
          "id": "10634863",
          "text": "Maria willigte ein, bei uns als Kindermädchen zu arbeiten.",
          "translation": "Мэри согласилась поработать у нас няней.",
          "source": "Tatoeba #10634863 @Pfirsichbaeumchen / #6285545 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10634863",
          "cefr_level": "A1",
          "word_slugs": [
            "kindermädchen-noun"
          ]
        }
