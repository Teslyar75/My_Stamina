      },
      "gender": null,
      "examples": [
        {
          "id": "4326522",
          "text": "Entspricht das deinen Vorstellungen?",
          "translation": "Соответствует ли это твоим ожиданиям?",
          "source": "Tatoeba #4326522 @raggione / #13751353 @Alex_M (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4326522",
          "cefr_level": "A1",
          "word_slugs": [
            "entspricht-verb"
          ]
        },
        {
          "id": "12296749",
          "text": "Dies entspricht nicht der Wahrheit.",
          "translation": "Это не соответствует действительности.",
          "source": "Tatoeba #12296749 @Bernie75 / #1441523 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12296749",
          "cefr_level": "A1",
          "word_slugs": [
            "entspricht-verb"
          ]
        },
        {
          "id": "13985975",
          "text": "Ein Dollar entspricht hundert Cent.",
          "translation": "Один доллар равен ста центам.",
          "source": "Tatoeba #13985975 @mhr / #13985951 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13985975",
          "cefr_level": "A1",
          "word_slugs": [
            "entspricht-verb"
          ]
        },
        {
          "id": "13985969",
          "text": "Ein Rubel entspricht hundert Kopeken.",
          "translation": "Один рубль равен ста копейкам.",
          "source": "Tatoeba #13985969 @mhr / #13985950 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13985969",
          "cefr_level": "A1",
          "word_slugs": [
            "entspricht-verb"
          ]
        },
        {
          "id": "10289134",
          "text": "Ein Fuß entspricht dreißig Zentimetern.",
          "translation": "Фут равен тридцати сантиметрам.",
          "source": "Tatoeba #10289134 @sakslane / #10289089 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10289134",
          "cefr_level": "A1",
          "word_slugs": [
            "entspricht-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
