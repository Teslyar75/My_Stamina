          ]
        },
        {
          "id": "11503168",
          "text": "Wehe den Ungläubigen!",
          "translation": "Горе неверным!",
          "source": "Tatoeba #11503168 @Pfirsichbaeumchen / #400782 @glavkos (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11503168",
          "cefr_level": "A1",
          "word_slugs": [
            "wehe-noun"
          ]
        },
        {
          "id": "2289103",
          "text": "Wehe, du legst jetzt den Hörer auf.",
          "translation": "Не вздумай положить трубку.",
