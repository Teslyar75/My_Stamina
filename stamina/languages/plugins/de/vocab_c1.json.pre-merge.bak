    {
      "slug": "reiter-noun",
      "lemma": "Reiter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5295,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "rider (one who rides a horse)",
          "mounted man-at-arms, cuirassier",
          "tab (navigational widget in a GUI)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "14021023",
          "text": "Das Pferd wirft den Reiter ab.",
          "translation": "Лошадь сбрасывает всадника.",
          "source": "Tatoeba #14021023 @Vortarulo / #14021033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14021023",
          "cefr_level": "A1",
          "word_slugs": [
            "reiter-noun"
          ]
        },
        {
          "id": "1292411",
          "text": "Ein gutes Pferd kennt seinen Reiter.",
          "translation": "Хорошая лошадь знает своего всадника.",
          "source": "Tatoeba #1292411 @Esperantostern / #1525492 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1292411",
          "cefr_level": "A1",
          "word_slugs": [
            "reiter-noun"
          ]
        },
        {
          "id": "1937916",
          "text": "Das Pferd ist oft klüger als sein Reiter.",
          "translation": "Лошадь часто умнее своего наездника.",
          "source": "Tatoeba #1937916 @Esperantostern / #5652288 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1937916",
          "cefr_level": "A1",
          "word_slugs": [
            "reiter-noun"
          ]
        },
        {
          "id": "8037494",
          "text": "Der Reiter hatte einen Säbel in der Hand.",
          "translation": "В руке у всадника была сабля.",
          "source": "Tatoeba #8037494 @Pfirsichbaeumchen / #4814303 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8037494",
          "cefr_level": "A1",
          "word_slugs": [
            "reiter-noun"
          ]
        },
        {
          "id": "4971633",
          "text": "Die Arbeit soll dein Pferd sein, nicht dein Reiter.",
          "translation": "Работа должна быть твоей лошадью, а не твоим наездником.",
          "source": "Tatoeba #4971633 @Esperantostern / #4974311 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4971633",
          "cefr_level": "A1",
          "word_slugs": [
            "reiter-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Reiter",
        "nominative_pl": ""
      }
