    {
      "slug": "abschliessen-verb",
      "lemma": "abschließen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5702,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "закончить"
        ],
        "en": [
          "to end, to finish or complete (one's studies, a task)",
          "to shut off",
          "to lock; to seal off",
          "to conclude (a contract, a deal), to finalise/finalize (a contract, an agreement)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8500874",
          "text": "Könnten sie abschließen?",
          "translation": "Вы не могли бы закрыть дверь на ключ?",
          "source": "Tatoeba #8500874 @restcoser / #4462687 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8500874",
          "cefr_level": "A1",
          "word_slugs": [
            "abschliessen-verb"
          ]
        },
        {
          "id": "13812478",
          "text": "Könntest du die Tür abschließen?",
          "translation": "Ты не мог бы запереть дверь?",
          "source": "Tatoeba #13812478 @mhr / #4462683 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13812478",
          "cefr_level": "A1",
          "word_slugs": [
            "abschliessen-verb"
          ]
        },
        {
          "id": "7441759",
          "text": "Kann Tom das Geschäft abschließen?",
          "translation": "Может ли Том заключить сделку?",
          "source": "Tatoeba #7441759 @Pfirsichbaeumchen / #7446523 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7441759",
          "cefr_level": "A1",
          "word_slugs": [
            "abschliessen-verb"
          ]
        },
        {
          "id": "756611",
          "text": "Ich möchte die Arbeit selbst abschließen.",
          "translation": "Я хочу сам завершить работу.",
          "source": "Tatoeba #756611 @Kuyo / #375949 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/756611",
          "cefr_level": "A1",
          "word_slugs": [
            "abschliessen-verb"
          ]
        },
        {
          "id": "2145493",
          "text": "Ich werde das in einer Stunde abschließen.",
          "translation": "Я закончу это в течение часа.",
          "source": "Tatoeba #2145493 @al_ex_an_der / #1408914 @MikaM (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2145493",
          "cefr_level": "A1",
          "word_slugs": [
            "abschliessen-verb"
          ]
        }
      ],
