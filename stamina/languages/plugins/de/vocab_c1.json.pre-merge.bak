          ]
        },
        {
          "id": "14016547",
          "text": "Ich habe mich dreimal verirrt.",
          "translation": "Я три раза заблудился.",
          "source": "Tatoeba #14016547 @Waldelfe / #13158569 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14016547",
          "cefr_level": "A1",
          "word_slugs": [
            "verirrt-verb"
          ]
        },
        {
          "id": "787719",
          "text": "Möglicherweise hat sie sich verirrt.",
