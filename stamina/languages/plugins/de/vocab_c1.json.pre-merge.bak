    {
      "slug": "abgerissen-verb",
      "lemma": "abgerissen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8793,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of abreißen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13639276",
          "text": "Unser altes Haus wurde abgerissen.",
          "translation": "Наш старый дом снесли.",
          "source": "Tatoeba #13639276 @carlosalberto / #13384465 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13639276",
          "cefr_level": "A1",
          "word_slugs": [
            "abgerissen-verb"
          ]
        },
        {
          "id": "1790611",
          "text": "Das Einkaufszentrum wird abgerissen werden.",
          "translation": "Торговый центр будет снесён.",
          "source": "Tatoeba #1790611 @Pfirsichbaeumchen / #1711706 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1790611",
          "cefr_level": "A1",
          "word_slugs": [
            "abgerissen-verb"
          ]
        },
        {
          "id": "3033652",
          "text": "Das alte Haus wird in zwei Tagen abgerissen.",
          "translation": "Старый дом будет снесён в два дня.",
          "source": "Tatoeba #3033652 @Pfirsichbaeumchen / #3033666 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3033652",
          "cefr_level": "A1",
          "word_slugs": [
            "abgerissen-verb"
          ]
        },
        {
          "id": "4584604",
          "text": "Wir sahen, dass man das alte Gebäude abgerissen hatte.",
          "translation": "Мы видели, что старое здание снесли.",
          "source": "Tatoeba #4584604 @Jens_Odo / #11367152 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4584604",
          "cefr_level": "A1",
          "word_slugs": [
            "abgerissen-verb"
          ]
        },
        {
          "id": "13667828",
          "text": "Gestern wurde das Haus, in dem Tom geboren wurde, abgerissen.",
          "translation": "Вчера снесли дом, в котором Том родился.",
          "source": "Tatoeba #13667828 @Waldelfe / #12892391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13667828",
          "cefr_level": "A1",
          "word_slugs": [
            "abgerissen-verb"
          ]
        }
      ],
