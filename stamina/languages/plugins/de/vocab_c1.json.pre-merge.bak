    {
      "slug": "gästen-noun",
      "lemma": "Gästen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8620,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Gast"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4098518",
          "text": "Sie haben das unseren Gästen gezeigt.",
          "translation": "Они показали это нашим гостям.",
          "source": "Tatoeba #4098518 @Esperantostern / #4098927 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4098518",
          "cefr_level": "A1",
          "word_slugs": [
            "gästen-noun"
          ]
        },
        {
          "id": "3008392",
          "text": "Unter den Gästen waren zwei Ausländerinnen.",
          "translation": "Среди гостей были две иностранки.",
          "source": "Tatoeba #3008392 @Pfirsichbaeumchen / #652735 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3008392",
          "cefr_level": "A1",
          "word_slugs": [
            "gästen-noun"
          ]
        },
        {
          "id": "870276",
          "text": "Meine Liebe, biete doch den Gästen Kaffee an!",
          "translation": "Милая, предложи гостям кофе.",
          "source": "Tatoeba #870276 @Manfredo / #467671 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/870276",
          "cefr_level": "A1",
          "word_slugs": [
            "gästen-noun"
          ]
        },
        {
          "id": "1630893",
          "text": "Er sollte sich entschuldigen, weil er unhöflich zu den Gästen war.",
          "translation": "Он должен извиниться, потому что он был груб с гостями.",
          "source": "Tatoeba #1630893 @Esperantostern / #5516186 @Vitalli (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1630893",
          "cefr_level": "A1",
          "word_slugs": [
            "gästen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
