          ]
        },
        {
          "id": "2220959",
          "text": "Ich bin keine Lügnerin.",
          "translation": "Я не лжец.",
          "source": "Tatoeba #2220959 @Pfirsichbaeumchen / #2570607 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2220959",
          "cefr_level": "A1",
          "word_slugs": [
            "lügnerin-noun"
          ]
        },
        {
          "id": "1671957",
          "text": "Sie ist eine gute Lügnerin.",
          "translation": "Она умеет врать.",
          "source": "Tatoeba #1671957 @Pfirsichbaeumchen / #4375243 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1671957",
          "cefr_level": "A1",
