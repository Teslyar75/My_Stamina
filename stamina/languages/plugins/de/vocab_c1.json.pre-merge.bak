    {
      "slug": "spezialität-noun",
      "lemma": "Spezialität",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8280,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "speciality"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "602778",
          "text": "Das ist seine Spezialität.",
          "translation": "Это его специальность.",
          "source": "Tatoeba #602778 @BraveSentry / #4060296 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/602778",
          "cefr_level": "A1",
          "word_slugs": [
            "spezialität-noun"
          ]
        },
        {
          "id": "5343654",
          "text": "Suppen sind ihre Spezialität.",
          "translation": "Супы - это ее фирменное блюдо.",
          "source": "Tatoeba #5343654 @nina99nv / #5343655 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5343654",
          "cefr_level": "A1",
          "word_slugs": [
            "spezialität-noun"
          ]
        },
        {
          "id": "1687919",
          "text": "Das ist die Spezialität des Hauses.",
          "translation": "Это фирменное блюдо.",
          "source": "Tatoeba #1687919 @Pfirsichbaeumchen / #3003193 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1687919",
          "cefr_level": "A1",
          "word_slugs": [
            "spezialität-noun"
          ]
        },
        {
          "id": "5388741",
          "text": "Es ist meine Spezialität, richtigzuliegen, wenn andere sich irren.",
          "translation": "Моя специальность – быть правым, когда другие ошибаются.",
          "source": "Tatoeba #5388741 @Yakuwari / #12347102 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5388741",
          "cefr_level": "A1",
          "word_slugs": [
            "spezialität-noun"
          ]
        },
        {
          "id": "10285501",
          "text": "Was ist die Punktzahl für diese Spezialität in diesem Jahr?",
          "translation": "Какой в этом году проходной балл для этой специальности?",
          "source": "Tatoeba #10285501 @carlosalberto / #4262865 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10285501",
          "cefr_level": "A1",
          "word_slugs": [
            "spezialität-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
