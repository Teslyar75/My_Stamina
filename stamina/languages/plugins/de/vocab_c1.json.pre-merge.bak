    {
      "slug": "todesstrafe-noun",
      "lemma": "Todesstrafe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7882,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "capital punishment, death penalty"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5928788",
          "text": "Ich bin gegen die Todesstrafe.",
          "translation": "Я против смертной казни.",
          "source": "Tatoeba #5928788 @brauchinet / #4704047 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5928788",
          "cefr_level": "A1",
          "word_slugs": [
            "todesstrafe-noun"
          ]
        },
        {
          "id": "620688",
          "text": "Sein Verbrechen verdiente die Todesstrafe.",
          "translation": "Его преступление заслуживало смертной казни.",
          "source": "Tatoeba #620688 @MUIRIEL / #11260020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/620688",
          "cefr_level": "A1",
          "word_slugs": [
            "todesstrafe-noun"
          ]
        },
        {
          "id": "1111045",
          "text": "Die Europäische Union hat die Todesstrafe abgeschafft.",
          "translation": "Европейский Союз отменил смертную казнь.",
          "source": "Tatoeba #1111045 @MUIRIEL / #2356007 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1111045",
          "cefr_level": "A1",
          "word_slugs": [
            "todesstrafe-noun"
          ]
        },
        {
          "id": "8892604",
          "text": "Die Todesstrafe wurde im vergangenen Jahr abgeschafft.",
          "translation": "Смертная казнь была отменена в прошлом году.",
          "source": "Tatoeba #8892604 @brauchinet / #8892639 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8892604",
          "cefr_level": "A1",
          "word_slugs": [
            "todesstrafe-noun"
          ]
        }
      ],
