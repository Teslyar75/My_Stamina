    {
      "slug": "münchen-name",
      "lemma": "München",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8348,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "Мю́нхен"
        ],
        "en": [
          "Munich (the capital and largest city of Bavaria, Germany)",
          "a rural district of the Upper Bavaria region, Bavaria, partially surrounding but not including the city of Munich, which nevertheless serves as its administrative seat"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6158263",
          "text": "Wo ist München?",
          "translation": "Где находится Мюнхен?",
          "source": "Tatoeba #6158263 @raggione / #6155874 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6158263",
          "cefr_level": "A1",
          "word_slugs": [
            "münchen-name"
          ]
        },
        {
          "id": "8044581",
          "text": "Willkommen in München!",
          "translation": "Добро пожаловать в Мюнхен!",
          "source": "Tatoeba #8044581 @felix63 / #13281054 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8044581",
          "cefr_level": "A1",
          "word_slugs": [
            "münchen-name"
          ]
        },
        {
          "id": "8991586",
          "text": "Wohnt Tom in München?",
          "translation": "Том живёт в Мюнхене?",
          "source": "Tatoeba #8991586 @felix63 / #8996524 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8991586",
          "cefr_level": "A1",
          "word_slugs": [
            "münchen-name"
          ]
        },
        {
          "id": "13959466",
          "text": "Ich mag München nicht.",
          "translation": "Я не люблю Мюнхен.",
          "source": "Tatoeba #13959466 @maaster / #13959545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13959466",
          "cefr_level": "A1",
          "word_slugs": [
            "münchen-name"
          ]
        },
        {
          "id": "10650561",
          "text": "München ist in Deutschland.",
          "translation": "Мюнхен - это в Германии.",
          "source": "Tatoeba #10650561 @Geeky_Green / #10671250 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10650561",
          "cefr_level": "A1",
          "word_slugs": [
            "münchen-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
