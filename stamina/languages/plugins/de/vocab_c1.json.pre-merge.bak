    {
      "slug": "lügnerin-noun",
      "lemma": "Lügnerin",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6277,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "врунья",
          "лгунья"
        ],
        "en": [
          "liar (female), liaress"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1697583",
          "text": "Sie ist keine Lügnerin.",
          "translation": "Она не обманщица.",
          "source": "Tatoeba #1697583 @Pfirsichbaeumchen / #5690140 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1697583",
          "cefr_level": "A1",
          "word_slugs": [
