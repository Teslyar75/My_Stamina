        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "6298213",
          "text": "Tom! Was zum Henker machst du da?",
          "translation": "Том! Что ты, блядь, делаешь?",
          "source": "Tatoeba #6298213 @Pfirsichbaeumchen / #4101167 @Igorzzz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6298213",
          "cefr_level": "A1",
          "word_slugs": [
            "henker-noun"
          ]
        },
        {
          "id": "2836914",
          "text": "Die Freiheit hoch, damit ihre Henker darunterschwärmen könnten!",
          "translation": "Была бы свобода, душители найдутся!",
          "source": "Tatoeba #2836914 @AqQoyriq / #2836822 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2836914",
          "cefr_level": "A1",
          "word_slugs": [
            "henker-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Henker",
        "nominative_pl": ""
      }
