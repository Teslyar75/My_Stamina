    {
      "slug": "schuhen-noun",
      "lemma": "Schuhen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6782,
      "frequency_band": "goethe-c1",
      "translations": {
