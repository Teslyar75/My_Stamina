    {
      "slug": "methoden-noun",
      "lemma": "Methoden",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5242,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Methode"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13360570",
          "text": "Andere Methoden kenne ich nicht.",
          "translation": "Я других способов не знаю.",
          "source": "Tatoeba #13360570 @mhr / #13360544 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13360570",
          "cefr_level": "A1",
          "word_slugs": [
            "methoden-noun"
          ]
        },
        {
          "id": "1104109",
          "text": "Das ist von allen Methoden die billigste.",
          "translation": "Это самый недорогой способ из всех.",
          "source": "Tatoeba #1104109 @Haehnchenpaella / #12222440 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1104109",
          "cefr_level": "A1",
          "word_slugs": [
            "methoden-noun"
          ]
        },
        {
          "id": "3186562",
          "text": "Er kennt viele Methoden, mit dem Rauchen aufzuhören.",
          "translation": "Он знает много способов бросить курить.",
          "source": "Tatoeba #3186562 @Pfirsichbaeumchen / #3186205 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3186562",
          "cefr_level": "A1",
          "word_slugs": [
            "methoden-noun"
          ]
        },
        {
          "id": "2430378",
          "text": "Die Methoden des positiven Denkens sind leicht zu erlernen.",
          "translation": "Методы позитивного мышления учатся легко.",
          "source": "Tatoeba #2430378 @al_ex_an_der / #2430382 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430378",
          "cefr_level": "A1",
          "word_slugs": [
            "methoden-noun"
          ]
        },
        {
          "id": "697882",
          "text": "Wissenschaft ist weit mehr als eine Sammlung von Fakten und Methoden.",
          "translation": "Наука - это нечто намного большее, чем собрание фактов и методов.",
          "source": "Tatoeba #697882 @jakov / #12239175 @Serg_K1ng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/697882",
          "cefr_level": "A1",
          "word_slugs": [
            "methoden-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
