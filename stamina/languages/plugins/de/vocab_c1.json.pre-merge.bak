      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "axe"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12877203",
          "text": "Das ist eine Axt.",
          "translation": "Это топор.",
          "source": "Tatoeba #12877203 @Waldelfe / #8917809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12877203",
          "cefr_level": "A1",
          "word_slugs": [
            "axt-noun"
          ]
        },
        {
          "id": "7000102",
          "text": "Tom schärfte seine Axt.",
          "translation": "Том наточил свой топор.",
          "source": "Tatoeba #7000102 @Pfirsichbaeumchen / #6570800 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7000102",
          "cefr_level": "A1",
          "word_slugs": [
            "axt-noun"
          ]
        },
        {
          "id": "13668071",
          "text": "Er hackt Holz mit einer Axt.",
          "translation": "Он колет дрова топором.",
          "source": "Tatoeba #13668071 @mhr / #13667630 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13668071",
          "cefr_level": "A1",
          "word_slugs": [
            "axt-noun"
          ]
        },
        {
          "id": "6804285",
          "text": "Wir fällen Bäume mit der Axt.",
          "translation": "Мы рубим деревья топором.",
          "source": "Tatoeba #6804285 @manese / #6804507 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804285",
          "cefr_level": "A1",
          "word_slugs": [
            "axt-noun"
          ]
        },
        {
          "id": "8247201",
          "text": "Tom hackte mit der Axt Feuerholz.",
          "translation": "Том нарубил топором дров.",
          "source": "Tatoeba #8247201 @Pfirsichbaeumchen / #6570142 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8247201",
          "cefr_level": "A1",
