      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5954,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "портной"
        ],
        "en": [
          "agent noun of schneiden: cutter (a person or device that cuts)",
          "tailor (male or of unspecified gender)",
          "daddy-longlegs, harvestman, water strider, cranefly, etc. (any long-legged arachnid or insect)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "7023715",
          "text": "Tom ist Schneider.",
          "translation": "Том - портной.",
          "source": "Tatoeba #7023715 @Pfirsichbaeumchen / #8622742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7023715",
          "cefr_level": "A1",
          "word_slugs": [
