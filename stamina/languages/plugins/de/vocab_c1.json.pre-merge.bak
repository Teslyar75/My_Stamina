        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "413724",
          "text": "Er schämt sich nicht für seine illegalen Handlungen.",
          "translation": "Ему не стыдно за свои незаконные действия.",
          "source": "Tatoeba #413724 @xtofu80 / #2932381 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/413724",
          "cefr_level": "A1",
          "word_slugs": [
