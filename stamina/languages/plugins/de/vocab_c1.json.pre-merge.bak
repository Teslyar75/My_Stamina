    {
      "slug": "prinzip-noun",
      "lemma": "Prinzip",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5335,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "principle"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11200774",
          "text": "Tom lügt aus Prinzip.",
          "translation": "Том врёт из принципа.",
          "source": "Tatoeba #11200774 @felix63 / #11833387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11200774",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzip-noun"
          ]
        },
        {
          "id": "12873253",
          "text": "Im Prinzip stimmt das.",
          "translation": "В принципе это правда.",
          "source": "Tatoeba #12873253 @mhr / #12873080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12873253",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzip-noun"
          ]
        },
        {
          "id": "13805680",
          "text": "Versteht ihr das Prinzip?",
          "translation": "Принцип вам понятен?",
          "source": "Tatoeba #13805680 @mhr / #13805672 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13805680",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzip-noun"
          ]
        },
        {
          "id": "13805686",
          "text": "Verstehst du das Prinzip?",
          "translation": "Принцип тебе понятен?",
          "source": "Tatoeba #13805686 @mhr / #13805671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13805686",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzip-noun"
          ]
        },
        {
          "id": "13775483",
          "text": "Das Prinzip ist verständlich.",
          "translation": "Принцип понятен.",
          "source": "Tatoeba #13775483 @mhr / #13775264 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13775483",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzip-noun"
          ]
        }
      ],
