      "gender": null,
      "examples": [
        {
          "id": "8734237",
          "text": "Ich schätze deine Bemühungen.",
          "translation": "Я ценю твои усилия.",
          "source": "Tatoeba #8734237 @maaster / #6104358 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8734237",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühungen-noun"
          ]
        },
        {
          "id": "2752254",
          "text": "Deine Bemühungen sind umsonst.",
          "translation": "Твои старания тщетны.",
          "source": "Tatoeba #2752254 @Pfirsichbaeumchen / #1510227 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2752254",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühungen-noun"
          ]
        },
        {
          "id": "12184502",
          "text": "Deren Bemühungen waren umsonst.",
          "translation": "Их усилия были напрасны.",
          "source": "Tatoeba #12184502 @Pfirsichbaeumchen / #12124239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12184502",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühungen-noun"
          ]
        },
        {
          "id": "12186528",
          "text": "Ihre Bemühungen waren vergebens.",
          "translation": "Её усилия были напрасны.",
          "source": "Tatoeba #12186528 @Pfirsichbaeumchen / #8152466 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12186528",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühungen-noun"
          ]
        },
        {
          "id": "1510229",
          "text": "Deine Bemühungen sind vergeblich.",
          "translation": "Твои старания тщетны.",
          "source": "Tatoeba #1510229 @Pfirsichbaeumchen / #1510227 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1510229",
          "cefr_level": "A1",
