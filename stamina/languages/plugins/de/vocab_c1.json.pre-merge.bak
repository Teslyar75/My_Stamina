    {
      "slug": "schlitten-noun",
      "lemma": "Schlitten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8571,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "санки"
        ],
        "en": [
          "sled, sledge, sleigh (any vehicle moving over snow or ice on parallel skids)",
          "any construction that slides on skids or rails",
          "a large, usually expensive car",
          "a person, usually female, seen as a sex object"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2520411",
          "text": "Mein Schlitten ist weiß.",
          "translation": "Мои сани белые.",
          "source": "Tatoeba #2520411 @europeanlanguages / #2518169 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2520411",
          "cefr_level": "A1",
          "word_slugs": [
            "schlitten-noun"
          ]
        },
        {
          "id": "9053911",
          "text": "Mach deinen Schlitten im Sommer bereit!",
          "translation": "Готовь сани летом!",
          "source": "Tatoeba #9053911 @carlosalberto / #3249263 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9053911",
          "cefr_level": "A1",
          "word_slugs": [
            "schlitten-noun"
          ]
        },
        {
          "id": "4451778",
          "text": "Im letzten Winter schenkte ihm sein Großvater einen Schlitten.",
          "translation": "Прошлой зимой дедушка подарил ему санки.",
          "source": "Tatoeba #4451778 @Esperantostern / #12112318 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4451778",
          "cefr_level": "A1",
          "word_slugs": [
            "schlitten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Schlitten",
        "nominative_pl": ""
      }
    },
    {
      "slug": "jahrhunderte-noun",
      "lemma": "Jahrhunderte",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8572,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Jahrhundert"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2771313",
          "text": "Die Jahrhunderte haben die Mauer geschwärzt.",
          "translation": "Века покрыли чёрной краской стены.",
          "source": "Tatoeba #2771313 @al_ex_an_der / #2772034 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2771313",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderte-noun"
          ]
        },
        {
          "id": "14003619",
          "text": "Der Bau des Mailänder Doms dauerte fast sechs Jahrhunderte.",
          "translation": "Строительство Миланского собора заняло почти шесть веков.",
          "source": "Tatoeba #14003619 @carlosalberto / #14003620 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14003619",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderte-noun"
          ]
        },
        {
          "id": "976017",
          "text": "Es gibt Schildkröten, die mehr als zwei Jahrhunderte alt sind.",
          "translation": "Бывают черепахи, которым больше двухсот лет.",
          "source": "Tatoeba #976017 @mayok / #9478073 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/976017",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderte-noun"
          ]
        },
        {
          "id": "13445925",
          "text": "Es wird Jahrzehnte, wenn nicht Jahrhunderte dauern, bis das möglich ist.",
          "translation": "Пройдут десятки, а то и сотни лет, прежде чем это станет возможным.",
          "source": "Tatoeba #13445925 @mhr / #13445870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13445925",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderte-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "talente-noun",
      "lemma": "Talente",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8573,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Talent"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "787485",
          "text": "Ich habe viele Talente.",
          "translation": "У меня много способностей.",
          "source": "Tatoeba #787485 @korntex / #784857 @ivanov (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/787485",
          "cefr_level": "A1",
          "word_slugs": [
            "talente-noun"
          ]
        },
        {
          "id": "2193050",
          "text": "Er steckt voller Talente.",
          "translation": "У него полно талантов.",
          "source": "Tatoeba #2193050 @Vortarulo / #1992438 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2193050",
          "cefr_level": "A1",
          "word_slugs": [
            "talente-noun"
          ]
        },
        {
          "id": "7022218",
          "text": "Tom hat zahlreiche Talente.",
          "translation": "У Тома множество талантов.",
          "source": "Tatoeba #7022218 @Pfirsichbaeumchen / #4812687 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7022218",
          "cefr_level": "A1",
          "word_slugs": [
            "talente-noun"
          ]
        },
        {
          "id": "369844",
          "text": "Wir müssen unsere Talente entfalten.",
          "translation": "Мы должны развивать свои таланты.",
          "source": "Tatoeba #369844 @MUIRIEL / #1892821 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/369844",
          "cefr_level": "A1",
          "word_slugs": [
            "talente-noun"
          ]
        },
        {
          "id": "1912650",
          "text": "Jeder von uns hat Talente und Begabungen.",
          "translation": "Каждый из нас обладает талантами и способностями.",
          "source": "Tatoeba #1912650 @Pfirsichbaeumchen / #1912634 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1912650",
          "cefr_level": "A1",
          "word_slugs": [
            "talente-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
