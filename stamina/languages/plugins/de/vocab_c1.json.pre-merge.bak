        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9082033",
          "text": "Er hat ein perfektes Alibi.",
          "translation": "У него идеальное алиби.",
          "source": "Tatoeba #9082033 @Adelpa / #10777737 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9082033",
          "cefr_level": "A1",
          "word_slugs": [
            "perfektes-adj"
          ]
        },
        {
          "id": "2302844",
          "text": "Sie sind ein perfektes Paar.",
          "translation": "Они идеальная пара.",
          "source": "Tatoeba #2302844 @Zaghawa / #2292596 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2302844",
          "cefr_level": "A1",
          "word_slugs": [
            "perfektes-adj"
          ]
        },
        {
          "id": "9082120",
          "text": "Sie hat ein perfektes Alibi.",
          "translation": "У неё идеальное алиби.",
          "source": "Tatoeba #9082120 @Adelpa / #10777735 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9082120",
          "cefr_level": "A1",
          "word_slugs": [
            "perfektes-adj"
          ]
        },
        {
          "id": "1474590",
          "text": "Wir waren ein perfektes Paar.",
          "translation": "Мы были идеальной парой.",
          "source": "Tatoeba #1474590 @al_ex_an_der / #4409607 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1474590",
          "cefr_level": "A1",
          "word_slugs": [
            "perfektes-adj"
          ]
        },
        {
          "id": "11451261",
          "text": "Es gibt kein perfektes Verbrechen.",
          "translation": "Идеальных преступлений не бывает.",
          "source": "Tatoeba #11451261 @Adelpa / #11451298 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11451261",
          "cefr_level": "A1",
          "word_slugs": [
            "perfektes-adj"
          ]
        }
      ],
