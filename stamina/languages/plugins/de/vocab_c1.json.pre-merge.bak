    {
      "slug": "zuverlässig-adj",
      "lemma": "zuverlässig",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9656,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
