    {
      "slug": "wilhelm-name",
      "lemma": "Wilhelm",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9817,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a male given name from Old High German, feminine equivalent Wilhelmina, Wilhelmine, and Minna, equivalent to English William; diminutive forms Willi, Willy"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "9979745",
          "text": "Marias Vater Karl Wilhelm gehört zu der Generation, die nichts wegwirft.",
          "translation": "Отец Марии, Карл-Вильгельм, принадлежит к поколению тех, кто ничего не выбрасывает.",
          "source": "Tatoeba #9979745 @Pfirsichbaeumchen / #9982890 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9979745",
          "cefr_level": "A1",
          "word_slugs": [
            "wilhelm-name"
          ]
        },
        {
          "id": "10361449",
          "text": "Karls Onkel Wilhelm spricht Deutsch, Französisch und Russisch, aber kein Englisch.",
          "translation": "Дядя Карла Вильгельм говорит по-немецки, по-французски и по-русски, а по-английски - нет.",
          "source": "Tatoeba #10361449 @Pfirsichbaeumchen / #10367743 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10361449",
          "cefr_level": "A1",
          "word_slugs": [
            "wilhelm-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Wilhelm",
        "nominative_pl": ""
      }
    },
    {
      "slug": "unbesorgt-adj",
