    {
      "slug": "läuten-verb",
      "lemma": "läuten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7315,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to ring, toll (a bell)",
          "to ring, toll",
          "to ring (at a door, front desk, etc.)",
          "to ring"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12855555",
          "text": "Bald wird die Glocke läuten.",
          "translation": "Скоро будет звенеть звонок.",
          "source": "Tatoeba #12855555 @mhr / #12855532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12855555",
          "cefr_level": "A1",
          "word_slugs": [
            "läuten-verb"
          ]
        },
        {
          "id": "406975",
          "text": "Ich hörte das Telefon läuten.",
          "translation": "Я слышал, как звонил телефон.",
          "source": "Tatoeba #406975 @MUIRIEL / #13819881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/406975",
          "cefr_level": "A1",
          "word_slugs": [
            "läuten-verb"
          ]
        },
        {
          "id": "10103431",
          "text": "Die Kirchenglocken läuten zur Mittagszeit.",
          "translation": "Церковные колокола звонят в полдень.",
          "source": "Tatoeba #10103431 @Melang / #13469551 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10103431",
          "cefr_level": "A1",
          "word_slugs": [
            "läuten-verb"
          ]
        },
        {
          "id": "13820309",
          "text": "Ich habe das Telefon läuten gehört.",
          "translation": "Я слышал, как звонил телефон.",
          "source": "Tatoeba #13820309 @mhr / #13819881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13820309",
          "cefr_level": "A1",
          "word_slugs": [
            "läuten-verb"
          ]
        },
        {
          "id": "6042290",
          "text": "Alle Kirchenglocken fingen zusammen an zu läuten.",
          "translation": "Все церковные колокола зазвонили одновременно.",
          "source": "Tatoeba #6042290 @raggione / #12260140 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6042290",
          "cefr_level": "A1",
          "word_slugs": [
            "läuten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
