    {
      "slug": "annähernd-verb",
      "lemma": "annähernd",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8379,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "present participle of annähern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14102297",
          "text": "Er hat annähernd ein halbes Tausend Rinder.",
          "translation": "У него около полутысячи голов крупного рогатого скота.",
          "source": "Tatoeba #14102297 @maaster / #14106014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14102297",
          "cefr_level": "A1",
          "word_slugs": [
            "annähernd-verb"
          ]
        },
        {
          "id": "13525356",
          "text": "Es ist besser, annähernd recht als völlig unrecht zu haben.",
          "translation": "Лучше быть приблизительно правым, чем точно неправым.",
          "source": "Tatoeba #13525356 @mhr / #13525253 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13525356",
          "cefr_level": "A1",
          "word_slugs": [
            "annähernd-verb"
          ]
        },
        {
          "id": "3435846",
          "text": "Übersetzen ist nicht annähernd so einfach, wie viele Leute vielleicht glauben.",
          "translation": "Переводить далеко не так просто, как многие могут подумать.",
          "source": "Tatoeba #3435846 @dinkel_girl / #5321291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3435846",
          "cefr_level": "A1",
          "word_slugs": [
            "annähernd-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
