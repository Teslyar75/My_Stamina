      },
      "gender": null,
      "examples": [
        {
          "id": "1562652",
          "text": "Bitte lenken Sie mich nicht von meiner Arbeit ab.",
          "translation": "Не отвлекайте меня от работы, пожалуйста.",
          "source": "Tatoeba #1562652 @al_ex_an_der / #10311507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1562652",
          "cefr_level": "A1",
          "word_slugs": [
            "lenken-verb"
          ]
        },
        {
          "id": "12978244",
          "text": "Die Sozialen Medien lenken euch von der Arbeit ab.",
          "translation": "Соцсети отвлекают вас от работы.",
          "source": "Tatoeba #12978244 @mhr / #12978170 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12978244",
          "cefr_level": "A1",
          "word_slugs": [
            "lenken-verb"
          ]
        },
        {
          "id": "12978185",
          "text": "Die Sozialen Netzwerke lenken euch von der Arbeit ab.",
          "translation": "Соцсети отвлекают вас от работы.",
          "source": "Tatoeba #12978185 @mhr / #12978170 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12978185",
          "cefr_level": "A1",
          "word_slugs": [
            "lenken-verb"
          ]
        }
      ],
