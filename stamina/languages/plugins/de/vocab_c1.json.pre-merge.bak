    {
      "slug": "rasieren-noun",
      "lemma": "Rasieren",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7416,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "бритьё"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "4007346",
          "text": "Tom schnitt sich beim Rasieren.",
          "translation": "Том порезался, когда брился.",
          "source": "Tatoeba #4007346 @pullnosemans / #4007385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4007346",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-noun"
          ]
        },
        {
          "id": "5775229",
          "text": "Baden und Rasieren ist laut Tom nichts für Männer.",
          "translation": "Том считает, что мыться и бриться – не по-мужски.",
          "source": "Tatoeba #5775229 @Pfirsichbaeumchen / #5775331 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5775229",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-noun"
          ]
        },
        {
          "id": "1639935",
          "text": "Wie viel Zeit verbringst du jeden Tag mit Rasieren?",
          "translation": "Сколько времени ты тратишь каждый день на бритьё?",
          "source": "Tatoeba #1639935 @Zaghawa / #4954290 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1639935",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-noun"
          ]
        },
        {
          "id": "4536291",
          "text": "Rasieren Sie sich jeden Tag?",
          "translation": "Вы каждый день бреетесь?",
          "source": "Tatoeba #4536291 @Pfirsichbaeumchen / #4719302 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4536291",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-noun"
          ]
        },
        {
          "id": "3047021",
          "text": "Rasieren Sie sich jeden Morgen?",
          "translation": "Вы бреетесь каждое утро?",
          "source": "Tatoeba #3047021 @Pfirsichbaeumchen / #3714319 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3047021",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Rasieren",
