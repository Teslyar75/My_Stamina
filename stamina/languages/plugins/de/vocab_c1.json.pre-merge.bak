    {
      "slug": "rasieren-verb",
      "lemma": "rasieren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7416,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "брить",
          "бриться"
        ],
        "en": [
          "to shave",
          "to discontinue in order to reduce spending etc., to cut back",
          "to raze, demolish, utterly destroy",
          "to be manifestly successful (against), to duppy, to kick (someone's) ass."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "455122",
          "text": "Ich muss mich rasieren.",
          "translation": "Мне нужно побриться.",
          "source": "Tatoeba #455122 @mramosch / #1460382 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455122",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-verb"
          ]
        },
        {
          "id": "12170346",
          "text": "Ich will mich rasieren.",
          "translation": "Я хочу побриться.",
          "source": "Tatoeba #12170346 @Augustus / #11216928 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12170346",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-verb"
          ]
        },
        {
          "id": "4536288",
          "text": "Wie oft rasieren Sie sich?",
          "translation": "Как часто Вы бреетесь?",
          "source": "Tatoeba #4536288 @Pfirsichbaeumchen / #9181646 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4536288",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-verb"
          ]
        },
        {
          "id": "6202666",
          "text": "Heute werde ich mich rasieren.",
          "translation": "Сегодня я побреюсь.",
          "source": "Tatoeba #6202666 @felix63 / #6202797 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6202666",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-verb"
          ]
        },
        {
          "id": "8347721",
          "text": "Ich hasse es, mich zu rasieren!",
          "translation": "Ненавижу бриться!",
          "source": "Tatoeba #8347721 @maaster / #12938464 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8347721",
          "cefr_level": "A1",
          "word_slugs": [
            "rasieren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
