    {
      "slug": "neffen-noun",
      "lemma": "Neffen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6309,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Neffe:",
          "genitive/dative/accusative singular",
          "inflection of Neffe:",
          "nominative/genitive/dative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9387011",
          "text": "Tom hat einen berühmten Neffen.",
          "translation": "У Тома знаменитый племянник.",
          "source": "Tatoeba #9387011 @Pfirsichbaeumchen / #9499687 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9387011",
          "cefr_level": "A1",
          "word_slugs": [
            "neffen-noun"
          ]
        },
        {
          "id": "13953125",
          "text": "Unsere Neffen haben zwei Hamster.",
          "translation": "У наших племянников два хомяка.",
          "source": "Tatoeba #13953125 @Ioan_Cristian / #13957391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13953125",
          "cefr_level": "A1",
          "word_slugs": [
            "neffen-noun"
          ]
        },
        {
          "id": "470023",
          "text": "All ihr Geld ging an ihren Neffen.",
          "translation": "Все её деньги отошли к её племяннику.",
          "source": "Tatoeba #470023 @Espi / #8747753 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/470023",
          "cefr_level": "A1",
          "word_slugs": [
            "neffen-noun"
          ]
        },
        {
          "id": "13953129",
          "text": "Ich gehe mit meinem Neffen ins Puppentheater.",
          "translation": "Я иду с племянником в кукольный театр.",
          "source": "Tatoeba #13953129 @Ioan_Cristian / #13957392 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13953129",
          "cefr_level": "A1",
          "word_slugs": [
            "neffen-noun"
          ]
        },
        {
          "id": "6770370",
          "text": "Kinder hat Maria nicht, dafür aber drei Neffen.",
          "translation": "Детей у Мэри нет, зато есть три племянника.",
          "source": "Tatoeba #6770370 @Pfirsichbaeumchen / #5735223 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770370",
          "cefr_level": "A1",
          "word_slugs": [
            "neffen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
