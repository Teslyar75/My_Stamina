    {
      "slug": "internationalen-adj",
      "lemma": "internationalen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7191,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of international:",
          "strong genitive masculine/neuter singular",
          "inflection of international:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "948025",
          "text": "Er ist Dolmetscher bei einer internationalen Bank.",
          "translation": "Он переводчик в международном банке.",
          "source": "Tatoeba #948025 @Sudajaengi / #1833191 @SilverBaby (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/948025",
          "cefr_level": "A1",
          "word_slugs": [
            "internationalen-adj"
          ]
        },
        {
          "id": "8634215",
          "text": "Er nimmt an einem internationalen Wettbewerb teil.",
          "translation": "Он принимает участие в международном конкурсе.",
          "source": "Tatoeba #8634215 @Melang / #8647867 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634215",
          "cefr_level": "A1",
          "word_slugs": [
            "internationalen-adj"
          ]
        },
        {
          "id": "12940994",
          "text": "Ja, ich kenne die Geschichte des Internationalen Frauentages.",
          "translation": "Да, я знаю историю Международного женского дня.",
          "source": "Tatoeba #12940994 @mhr / #12940921 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12940994",
          "cefr_level": "A1",
          "word_slugs": [
            "internationalen-adj"
          ]
        },
        {
          "id": "626248",
          "text": "Interlingua ist ein modernes Mittel zur internationalen Verständigung.",
          "translation": "Интерлингва - современный инструмент для международного общения.",
          "source": "Tatoeba #626248 @kolonjano / #12973261 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/626248",
          "cefr_level": "A1",
          "word_slugs": [
            "internationalen-adj"
          ]
        },
        {
          "id": "3758668",
          "text": "Interlingua ist ein modernes Mittel zur internationalen Kommunikation.",
          "translation": "Интерлингва - современный инструмент для международного общения.",
          "source": "Tatoeba #3758668 @Pfirsichbaeumchen / #12973261 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3758668",
          "cefr_level": "A1",
          "word_slugs": [
            "internationalen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "fielen-verb",
      "lemma": "fielen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7192,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of fallen:",
          "first/third-person plural preterite",
          "inflection of fallen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6635501",
          "text": "Es fielen zwei Schüsse.",
          "translation": "Раздалось два выстрела.",
          "source": "Tatoeba #6635501 @dirkz / #6633437 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6635501",
          "cefr_level": "A1",
          "word_slugs": [
            "fielen-verb"
          ]
        },
        {
          "id": "9429658",
          "text": "Sie fielen fast von den Stühlen.",
          "translation": "Они чуть со стульев не попадали.",
          "source": "Tatoeba #9429658 @Yorwba / #9459148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9429658",
          "cefr_level": "A1",
          "word_slugs": [
            "fielen-verb"
          ]
        },
        {
          "id": "12556850",
          "text": "Es fielen einige Äpfel vom Baum.",
          "translation": "С дерева упало несколько яблок.",
          "source": "Tatoeba #12556850 @Waldelfe / #600552 @loins (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12556850",
          "cefr_level": "A1",
          "word_slugs": [
            "fielen-verb"
          ]
        },
        {
          "id": "414002",
          "text": "Die Blätter fielen auf den Boden.",
          "translation": "Листья падали на землю.",
          "source": "Tatoeba #414002 @xtofu80 / #1507518 @tengo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/414002",
          "cefr_level": "A1",
          "word_slugs": [
            "fielen-verb"
          ]
        },
        {
          "id": "2132303",
          "text": "Drei Blutstropfen fielen auf den Schnee.",
          "translation": "На снег упали три капли крови.",
          "source": "Tatoeba #2132303 @al_ex_an_der / #11840331 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2132303",
          "cefr_level": "A1",
          "word_slugs": [
            "fielen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
