    {
      "slug": "ehrliche-adj",
      "lemma": "ehrliche",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7370,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
