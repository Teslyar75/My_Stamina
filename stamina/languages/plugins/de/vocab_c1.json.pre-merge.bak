      "gender": null,
      "examples": [
        {
          "id": "1945566",
          "text": "Ein Dreieck hat drei Ecken.",
          "translation": "У треугольника три угла.",
          "source": "Tatoeba #1945566 @al_ex_an_der / #1945565 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1945566",
          "cefr_level": "A1",
          "word_slugs": [
            "ecken-noun"
          ]
        },
        {
          "id": "1945568",
          "text": "Das Dreieck hat drei Ecken.",
          "translation": "У треугольника три угла.",
          "source": "Tatoeba #1945568 @al_ex_an_der / #1945565 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1945568",
          "cefr_level": "A1",
          "word_slugs": [
            "ecken-noun"
          ]
        },
        {
          "id": "11059072",
          "text": "Ein Quadrat hat vier Ecken.",
          "translation": "У квадрата четыре угла.",
          "source": "Tatoeba #11059072 @Yorwba / #2867438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11059072",
          "cefr_level": "A1",
          "word_slugs": [
            "ecken-noun"
          ]
        },
        {
          "id": "3749776",
          "text": "Dreiecke haben keine vier Ecken.",
          "translation": "Треугольники не могут иметь четыре угла.",
          "source": "Tatoeba #3749776 @Esperantostern / #9151790 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3749776",
          "cefr_level": "A1",
          "word_slugs": [
            "ecken-noun"
          ]
        },
        {
          "id": "12693255",
          "text": "Wie viele Ecken hat ein Dreieck?",
          "translation": "Сколько углов у треугольника?",
          "source": "Tatoeba #12693255 @mhr / #12693254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12693255",
          "cefr_level": "A1",
          "word_slugs": [
            "ecken-noun"
          ]
        }
