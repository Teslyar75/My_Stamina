      },
      "gender": null,
      "examples": [
        {
          "id": "8597051",
          "text": "Wir alle sehen die selbe Sonne.",
          "translation": "Мы все видим одно солнце.",
          "source": "Tatoeba #8597051 @Esperantostern / #8597057 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8597051",
