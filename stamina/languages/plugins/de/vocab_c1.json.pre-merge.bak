          ]
        },
        {
          "id": "2603959",
          "text": "Ich möchte dich einfach umarmen.",
          "translation": "Я просто хочу тебя обнять.",
          "source": "Tatoeba #2603959 @al_ex_an_der / #2603888 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2603959",
          "cefr_level": "A1",
          "word_slugs": [
            "umarmen-verb"
          ]
        },
        {
          "id": "2941930",
          "text": "Tom versuchte, Maria zu umarmen.",
          "translation": "Том попытался обнять Мэри.",
          "source": "Tatoeba #2941930 @Pfirsichbaeumchen / #3366036 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2941930",
