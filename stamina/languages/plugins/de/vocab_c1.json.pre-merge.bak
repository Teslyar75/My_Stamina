      "gender": null,
      "examples": [
        {
          "id": "11662454",
          "text": "Deutsche Männer können nicht flirten.",
          "translation": "Немецкие мужчины не умеют флиртовать.",
          "source": "Tatoeba #11662454 @Pfirsichbaeumchen / #6085616 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11662454",
          "cefr_level": "A1",
          "word_slugs": [
            "flirten-verb"
          ]
        },
        {
          "id": "2527709",
          "text": "Ich habe dich mit Mary flirten gesehen.",
          "translation": "Я видел, как ты заигрывал с Мэри.",
          "source": "Tatoeba #2527709 @brauchinet / #2529423 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2527709",
          "cefr_level": "A1",
          "word_slugs": [
            "flirten-verb"
          ]
        },
        {
          "id": "4987271",
          "text": "Ich weiß, dass eine Menge Jungen mit dir flirten wollen.",
          "translation": "Я знаю, что куча парней не прочь с тобой пофлиртовать.",
          "source": "Tatoeba #4987271 @Esperantostern / #5775081 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4987271",
          "cefr_level": "A1",
