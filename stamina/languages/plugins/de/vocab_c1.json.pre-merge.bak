    {
      "slug": "rahmen-noun",
      "lemma": "Rahmen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6714,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "рама"
        ],
        "en": [
          "frame, scope"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6465045",
          "text": "Der Rahmen dieser Brille ist gebrochen.",
          "translation": "У этих очков сломана оправа.",
          "source": "Tatoeba #6465045 @mraz / #7073466 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6465045",
          "cefr_level": "A1",
          "word_slugs": [
            "rahmen-noun"
          ]
        },
        {
          "id": "10812608",
          "text": "Der Rahmen ist wertvoller als das Gemälde.",
          "translation": "Рама дороже картины.",
          "source": "Tatoeba #10812608 @Yorwba / #12114651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10812608",
          "cefr_level": "A1",
          "word_slugs": [
            "rahmen-noun"
          ]
        },
        {
          "id": "13950732",
          "text": "Ich werde euch im Rahmen meiner Möglichkeiten helfen.",
          "translation": "Я буду помогать вам по мере своих возможностей.",
          "source": "Tatoeba #13950732 @mhr / #13950729 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13950732",
          "cefr_level": "A1",
          "word_slugs": [
            "rahmen-noun"
          ]
        },
        {
          "id": "538223",
          "text": "Ich werde Ihnen im Rahmen meiner Möglichkeiten helfen.",
          "translation": "Я буду помогать Вам по мере своих возможностей.",
          "source": "Tatoeba #538223 @xtofu80 / #13950736 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/538223",
          "cefr_level": "A1",
          "word_slugs": [
            "rahmen-noun"
          ]
        },
        {
          "id": "1945607",
          "text": "Im Rahmen des Projektes wurde eine Reihe von Rundtischgesprächen organisiert.",
          "translation": "В рамках проекта был организован ряд круглых столов.",
          "source": "Tatoeba #1945607 @al_ex_an_der / #1945602 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1945607",
          "cefr_level": "A1",
          "word_slugs": [
            "rahmen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
