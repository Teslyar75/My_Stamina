          "cefr_level": "A1",
          "word_slugs": [
            "verdreht-verb"
          ]
        },
        {
          "id": "2755917",
          "text": "Tom verdreht die Bedeutungen meiner Sätze immer ins Lächerliche.",
          "translation": "Том всегда переводит смысл моих предложений на смех.",
          "source": "Tatoeba #2755917 @Pfirsichbaeumchen / #3498423 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2755917",
