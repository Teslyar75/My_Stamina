          ]
        },
        {
          "id": "4061458",
          "text": "Konzentriere dich auf deine Ziele.",
          "translation": "Сосредоточься на своих целях.",
          "source": "Tatoeba #4061458 @hjoest / #4061470 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4061458",
          "cefr_level": "A1",
          "word_slugs": [
