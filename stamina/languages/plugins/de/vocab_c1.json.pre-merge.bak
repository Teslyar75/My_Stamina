    {
      "slug": "privatleben-noun",
      "lemma": "Privatleben",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6391,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "personal life, private life"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8870209",
          "text": "Mein Privatleben geht Sie nichts an!",
          "translation": "Моя личная жизнь вас не касается!",
          "source": "Tatoeba #8870209 @Pfirsichbaeumchen / #7810357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8870209",
          "cefr_level": "A1",
          "word_slugs": [
            "privatleben-noun"
          ]
        },
        {
          "id": "8870206",
          "text": "Mein Privatleben geht dich nichts an!",
          "translation": "Моя личная жизнь тебя не касается!",
          "source": "Tatoeba #8870206 @Pfirsichbaeumchen / #7810356 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8870206",
          "cefr_level": "A1",
          "word_slugs": [
            "privatleben-noun"
          ]
        },
        {
          "id": "8870210",
          "text": "Mein Privatleben geht euch nichts an!",
          "translation": "Моя личная жизнь вас не касается!",
          "source": "Tatoeba #8870210 @Pfirsichbaeumchen / #7810357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8870210",
          "cefr_level": "A1",
          "word_slugs": [
            "privatleben-noun"
          ]
        },
        {
          "id": "12393015",
          "text": "Er spricht nie über sein Privatleben.",
          "translation": "Он никогда не говорит о своей личной жизни.",
          "source": "Tatoeba #12393015 @Pfirsichbaeumchen / #10879907 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12393015",
          "cefr_level": "A1",
          "word_slugs": [
            "privatleben-noun"
          ]
        },
        {
          "id": "412989",
          "text": "Steck deine Nase nicht in mein Privatleben.",
          "translation": "Не суй свой нос в мою личную жизнь.",
          "source": "Tatoeba #412989 @MUIRIEL / #5148541 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/412989",
          "cefr_level": "A1",
          "word_slugs": [
            "privatleben-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
