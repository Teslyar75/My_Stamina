          ]
        },
        {
          "id": "8433176",
          "text": "Das werdet ihr mir büßen.",
          "translation": "Вы за это ответите.",
          "source": "Tatoeba #8433176 @faehrmann / #8433156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8433176",
          "cefr_level": "A1",
          "word_slugs": [
            "büssen-verb"
          ]
        },
        {
          "id": "7850290",
          "text": "Du wirst büßen für das, was du ihm angetan hast!",
          "translation": "Ты заплатишь за то, что с ним сделал.",
          "source": "Tatoeba #7850290 @Pfirsichbaeumchen / #5695472 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7850290",
          "cefr_level": "A1",
