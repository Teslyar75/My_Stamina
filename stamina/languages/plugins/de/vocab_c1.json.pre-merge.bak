    {
      "slug": "bedauern-verb",
      "lemma": "bedauern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5717,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to regret",
          "to pity"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1958739",
          "text": "Er wird es bedauern.",
          "translation": "Он еще пожалеет.",
          "source": "Tatoeba #1958739 @Tamy / #3348449 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1958739",
          "cefr_level": "A1",
          "word_slugs": [
            "bedauern-verb"
          ]
        },
        {
          "id": "7635633",
          "text": "Tom wird es bedauern.",
          "translation": "Том пожалеет об этом.",
          "source": "Tatoeba #7635633 @wolfgangth / #5056501 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7635633",
          "cefr_level": "A1",
          "word_slugs": [
            "bedauern-verb"
          ]
        },
        {
          "id": "7712078",
          "text": "Sie wird es bedauern.",
          "translation": "Она об этом пожалеет.",
          "source": "Tatoeba #7712078 @wolfgangth / #4421697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7712078",
          "cefr_level": "A1",
          "word_slugs": [
            "bedauern-verb"
          ]
        },
        {
          "id": "700644",
          "text": "Tue nichts, was du bedauern wirst.",
          "translation": "Не делай ничего, о чём пожалеешь.",
          "source": "Tatoeba #700644 @Esperantostern / #4231961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/700644",
          "cefr_level": "A1",
          "word_slugs": [
            "bedauern-verb"
          ]
        },
        {
          "id": "2512559",
          "text": "Er wird es früher oder später bedauern.",
          "translation": "Рано или поздно он ещё пожалеет об этом.",
          "source": "Tatoeba #2512559 @raggione / #2559101 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2512559",
          "cefr_level": "A1",
          "word_slugs": [
            "bedauern-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
