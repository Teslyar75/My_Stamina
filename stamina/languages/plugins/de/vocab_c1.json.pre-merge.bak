          "cefr_level": "A1",
          "word_slugs": [
            "einstein-noun"
          ]
        },
        {
          "id": "13780696",
          "text": "Albert Einstein ist ein sehr berühmter Wissenschaftler.",
          "translation": "Альберт Эйнштейн очень известный учёный.",
          "source": "Tatoeba #13780696 @Ioan_Cristian / #13780831 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13780696",
          "cefr_level": "A1",
