        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3608038",
          "text": "Sie wurde per Abstimmung ausgeschlossen.",
          "translation": "Она была исключена посредством голосования.",
          "source": "Tatoeba #3608038 @al_ex_an_der / #3614510 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3608038",
          "cefr_level": "A1",
          "word_slugs": [
            "abstimmung-noun"
          ]
        },
        {
          "id": "3101795",
          "text": "Diese Abstimmung erinnert an Wahlen zu Sowjetzeiten.",
          "translation": "Это голосование напоминает выборы советских времён.",
          "source": "Tatoeba #3101795 @al_ex_an_der / #3101794 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3101795",
          "cefr_level": "A1",
          "word_slugs": [
            "abstimmung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Abstimmung",
