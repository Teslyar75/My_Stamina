    {
      "slug": "ungerecht-adj",
      "lemma": "ungerecht",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7255,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "несправедливый"
        ],
        "en": [
          "unjust, unfair"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "593096",
          "text": "Das ist ungerecht.",
          "translation": "Это нечестно.",
          "source": "Tatoeba #593096 @MUIRIEL / #1623581 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/593096",
          "cefr_level": "A1",
          "word_slugs": [
            "ungerecht-adj"
          ]
        },
        {
          "id": "1796238",
          "text": "Das wäre ungerecht.",
          "translation": "Это было бы несправедливо.",
          "source": "Tatoeba #1796238 @Pfirsichbaeumchen / #2304052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1796238",
          "cefr_level": "A1",
          "word_slugs": [
            "ungerecht-adj"
          ]
        },
        {
          "id": "8056552",
          "text": "Es ist so ungerecht.",
          "translation": "Это так несправедливо.",
          "source": "Tatoeba #8056552 @Luiaard / #2409124 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8056552",
          "cefr_level": "A1",
          "word_slugs": [
            "ungerecht-adj"
          ]
        },
        {
          "id": "2576471",
          "text": "Erscheint dir das nicht ungerecht?",
          "translation": "Тебе это не кажется несправедливым?",
          "source": "Tatoeba #2576471 @al_ex_an_der / #2576470 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2576471",
          "cefr_level": "A1",
          "word_slugs": [
            "ungerecht-adj"
          ]
        },
        {
          "id": "3300903",
          "text": "Das ist ungerecht. Er hat angefangen.",
          "translation": "Так не честно. Он первый начал.",
          "source": "Tatoeba #3300903 @brauchinet / #10993442 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3300903",
          "cefr_level": "A1",
          "word_slugs": [
            "ungerecht-adj"
          ]
        }
      ],
