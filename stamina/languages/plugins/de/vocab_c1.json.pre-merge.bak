          ]
        },
        {
          "id": "10455246",
          "text": "Konzentriere dich auf die Gegenwart!",
          "translation": "Сосредоточься на настоящем.",
          "source": "Tatoeba #10455246 @maaster / #10455272 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10455246",
          "cefr_level": "A1",
