      "examples": [
        {
          "id": "666630",
          "text": "Glückliches neues Jahr!",
          "translation": "С Новым годом!",
          "source": "Tatoeba #666630 @Manfredo / #437406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/666630",
          "cefr_level": "A1",
          "word_slugs": [
            "glückliches-adj"
          ]
        },
        {
          "id": "8059324",
          "text": "Sie führte ein glückliches Leben.",
          "translation": "Она прожила счастливую жизнь.",
          "source": "Tatoeba #8059324 @Pfirsichbaeumchen / #817511 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8059324",
          "cefr_level": "A1",
          "word_slugs": [
            "glückliches-adj"
          ]
        },
        {
          "id": "783820",
          "text": "Auf ein langes und glückliches Leben!",
