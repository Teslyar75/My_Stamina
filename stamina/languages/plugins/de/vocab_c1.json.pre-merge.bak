          "source": "Tatoeba #4776686 @Germic / #444142 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4776686",
          "cefr_level": "A1",
          "word_slugs": [
            "toni-name"
          ]
        },
        {
