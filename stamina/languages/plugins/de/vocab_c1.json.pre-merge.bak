    {
      "slug": "sosse-noun",
      "lemma": "Soße",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7375,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Switzerland and Liechtenstein standard spelling of Soße"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "1512061",
          "text": "Probiert diese Soße.",
          "translation": "Попробуйте этот соус.",
          "source": "Tatoeba #1512061 @al_ex_an_der / #2239440 @KatrinI (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1512061",
          "cefr_level": "A1",
          "word_slugs": [
            "sosse-noun"
          ]
        },
        {
          "id": "1512062",
          "text": "Probieren Sie diese Soße.",
          "translation": "Попробуйте этот соус.",
          "source": "Tatoeba #1512062 @Zaghawa / #2239440 @KatrinI (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1512062",
          "cefr_level": "A1",
          "word_slugs": [
            "sosse-noun"
          ]
        },
        {
          "id": "643559",
          "text": "Probiere einmal diese Soße.",
          "translation": "Попробуй этот соус.",
          "source": "Tatoeba #643559 @Pfirsichbaeumchen / #446858 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/643559",
          "cefr_level": "A1",
          "word_slugs": [
            "sosse-noun"
          ]
        },
        {
          "id": "13929077",
          "text": "Achtung, diese Soße ist schärfer.",
          "translation": "Осторожно, этот соус острее.",
          "source": "Tatoeba #13929077 @Ioan_Cristian / #13931278 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13929077",
          "cefr_level": "A1",
          "word_slugs": [
            "sosse-noun"
          ]
        },
        {
          "id": "13567242",
          "text": "Gibst du mir das Rezept für diese Soße?",
          "translation": "Дашь мне рецепт этого соуса?",
          "source": "Tatoeba #13567242 @mhr / #13566757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13567242",
          "cefr_level": "A1",
          "word_slugs": [
            "sosse-noun"
          ]
        }
      ],
      "tags": [
