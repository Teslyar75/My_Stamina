    {
      "slug": "ausgebrochen-verb",
      "lemma": "ausgebrochen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7883,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of ausbrechen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10854726",
          "text": "Warum ist dieser Krieg ausgebrochen?",
          "translation": "Из-за чего началась эта война?",
          "source": "Tatoeba #10854726 @carlosalberto / #10854721 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10854726",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgebrochen-verb"
          ]
        },
        {
          "id": "13407556",
          "text": "Im Erdgeschoss ist ein Feuer ausgebrochen.",
          "translation": "На первом этаже начался пожар.",
          "source": "Tatoeba #13407556 @mhr / #13407445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13407556",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgebrochen-verb"
          ]
        },
        {
          "id": "13407554",
          "text": "Im ersten Stock ist ein Feuer ausgebrochen.",
          "translation": "На втором этаже вспыхнул пожар.",
          "source": "Tatoeba #13407554 @mhr / #13407446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13407554",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgebrochen-verb"
          ]
        },
        {
          "id": "10335973",
          "text": "Ein gefährlicher Verbrecher ist aus dem Gefängnis ausgebrochen.",
          "translation": "Из тюрьмы сбежал опасный преступник.",
          "source": "Tatoeba #10335973 @Yorwba / #8199188 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10335973",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgebrochen-verb"
          ]
        },
        {
          "id": "13404952",
          "text": "Einer von den Tigern ist aus dem Zoo ausgebrochen.",
          "translation": "Один из тигров сбежал из зоопарка.",
          "source": "Tatoeba #13404952 @Vortarulo / #2496364 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13404952",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgebrochen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
