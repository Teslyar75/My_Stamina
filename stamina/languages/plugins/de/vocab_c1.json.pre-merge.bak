      },
      "gender": null,
      "examples": [
        {
          "id": "1049110",
          "text": "Das Dorf ist von der Außenwelt abgeschnitten.",
          "translation": "Деревня отрезана от внешнего мира.",
          "source": "Tatoeba #1049110 @al_ex_an_der / #12716872 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1049110",
          "cefr_level": "A1",
          "word_slugs": [
