    {
      "slug": "marco-name",
      "lemma": "Marco",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5212,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a male given name from Italian"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1865121",
          "text": "Auf Wiedersehen, Marco!",
          "translation": "До свидания, Марко!",
          "source": "Tatoeba #1865121 @Zaghawa / #2211721 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1865121",
          "cefr_level": "A1",
          "word_slugs": [
            "marco-name"
          ]
        },
        {
          "id": "3869839",
          "text": "„Warum bist du traurig?“ – „Weil Marco gestern abgereist ist.“",
          "translation": "\"Ты почему грустная?\" - \"Потому что Марк вчера уехал\".",
          "source": "Tatoeba #3869839 @Giulio / #5474645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3869839",
          "cefr_level": "A1",
          "word_slugs": [
            "marco-name"
          ]
        },
        {
          "id": "7370511",
          "text": "Beim Kaffeetrinken hat Marco gemerkt, dass der Kaffee nicht gezuckert ist.",
          "translation": "Отпивая кофе, Марко заметил, что тот не сладкий.",
          "source": "Tatoeba #7370511 @sigavax / #7370534 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7370511",
          "cefr_level": "A1",
          "word_slugs": [
            "marco-name"
          ]
        }
      ],
      "tags": [
