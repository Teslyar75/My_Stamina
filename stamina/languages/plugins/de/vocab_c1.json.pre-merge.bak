      "gender": null,
      "examples": [
        {
          "id": "4870386",
          "text": "Oh, ein Schmetterling!",
          "translation": "Ой, бабочка!",
          "source": "Tatoeba #4870386 @Pfirsichbaeumchen / #4807827 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4870386",
