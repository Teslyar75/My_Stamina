        "en": [
          "to overcome, to get over"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2146951",
          "text": "Ist die Krise zu überwinden?",
          "translation": "Можно ли преодолеть кризис?",
          "source": "Tatoeba #2146951 @Pfirsichbaeumchen / #3891310 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2146951",
          "cefr_level": "A1",
          "word_slugs": [
            "überwinden-verb"
          ]
        },
        {
          "id": "2146927",
          "text": "Kann man die Krise überwinden?",
          "translation": "Можно ли преодолеть кризис?",
          "source": "Tatoeba #2146927 @al_ex_an_der / #3891310 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2146927",
          "cefr_level": "A1",
          "word_slugs": [
            "überwinden-verb"
          ]
        },
        {
          "id": "562358",
          "text": "Sie können ihre Angst überwinden.",
          "translation": "Они могут преодолеть свой страх.",
          "source": "Tatoeba #562358 @cost / #424955 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/562358",
          "cefr_level": "A1",
          "word_slugs": [
            "überwinden-verb"
          ]
        },
        {
          "id": "2581764",
          "text": "Sie müssen die Zweifel überwinden.",
          "translation": "Вы должны преодолеть сомнения.",
          "source": "Tatoeba #2581764 @al_ex_an_der / #2581760 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2581764",
          "cefr_level": "A1",
          "word_slugs": [
            "überwinden-verb"
          ]
        },
        {
          "id": "4444341",
          "text": "Sie müssen diese Hindernisse überwinden.",
          "translation": "Вам нужно преодолеть эти препятствия.",
          "source": "Tatoeba #4444341 @al_ex_an_der / #4444337 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4444341",
          "cefr_level": "A1",
          "word_slugs": [
            "überwinden-verb"
          ]
        }
