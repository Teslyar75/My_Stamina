    {
      "slug": "cm-abbrev",
      "lemma": "cm",
      "pos": "abbrev",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6407,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "11817248",
          "text": "Ich bin 185 cm groß.",
          "translation": "Мой рост - сто восемьдесят пять сантиметров.",
          "source": "Tatoeba #11817248 @Adelpa / #11817252 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11817248",
          "cefr_level": "A1",
          "word_slugs": [
            "cm-abbrev"
          ]
        },
        {
          "id": "13945927",
          "text": "Der Durchmesser beträgt etwa 3 cm.",
          "translation": "Диаметр - около трёх сантиметров.",
          "source": "Tatoeba #13945927 @Waldelfe / #12612986 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13945927",
          "cefr_level": "A1",
          "word_slugs": [
            "cm-abbrev"
          ]
        },
        {
          "id": "7731255",
          "text": "Ich bin 8 cm größer als du.",
          "translation": "Я на восемь сантиметров выше тебя.",
          "source": "Tatoeba #7731255 @Pfirsichbaeumchen / #12171346 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7731255",
          "cefr_level": "A1",
          "word_slugs": [
            "cm-abbrev"
          ]
        },
        {
          "id": "7731250",
          "text": "Tom ist 8 cm kleiner als Maria.",
          "translation": "Том на восемь сантиметров ниже Мэри.",
          "source": "Tatoeba #7731250 @Pfirsichbaeumchen / #7731257 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7731250",
          "cefr_level": "A1",
          "word_slugs": [
            "cm-abbrev"
          ]
        },
        {
          "id": "7731256",
          "text": "Tom ist 20 cm größer als Maria.",
          "translation": "Том на двадцать сантиметров выше Мэри.",
          "source": "Tatoeba #7731256 @Pfirsichbaeumchen / #7731267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7731256",
          "cefr_level": "A1",
