    {
      "slug": "unternommen-verb",
      "lemma": "unternommen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8611,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of unternehmen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10698942",
          "text": "Niemand hat etwas unternommen.",
          "translation": "Никто ничего не предпринял.",
          "source": "Tatoeba #10698942 @Pfirsichbaeumchen / #10698944 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10698942",
          "cefr_level": "A1",
          "word_slugs": [
            "unternommen-verb"
          ]
        },
        {
          "id": "1981488",
          "text": "Es musste etwas unternommen werden.",
          "translation": "Надо было что-то предпринять.",
          "source": "Tatoeba #1981488 @Tamy / #4428271 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1981488",
          "cefr_level": "A1",
          "word_slugs": [
            "unternommen-verb"
          ]
        },
        {
          "id": "14067484",
          "text": "Habt ihr diesbezüglich etwas unternommen?",
          "translation": "Вы что-нибудь сделали по этому поводу?",
          "source": "Tatoeba #14067484 @mhr / #14067210 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067484",
          "cefr_level": "A1",
          "word_slugs": [
            "unternommen-verb"
          ]
        },
        {
          "id": "14067483",
          "text": "Haben Sie diesbezüglich etwas unternommen?",
          "translation": "Вы что-нибудь сделали по этому поводу?",
          "source": "Tatoeba #14067483 @mhr / #14067210 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067483",
          "cefr_level": "A1",
          "word_slugs": [
            "unternommen-verb"
          ]
        },
        {
          "id": "11495313",
          "text": "Er hat einen Selbstmordversuch unternommen.",
          "translation": "Он совершил попытку самоубийства.",
          "source": "Tatoeba #11495313 @Bernie75 / #2382137 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11495313",
          "cefr_level": "A1",
          "word_slugs": [
            "unternommen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
