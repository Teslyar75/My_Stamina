          ]
        },
        {
          "id": "797858",
          "text": "Sie spielt Gitarre.",
          "translation": "Она играет на гитаре.",
          "source": "Tatoeba #797858 @Hans_Adler / #1223215 @poji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/797858",
          "cefr_level": "A1",
          "word_slugs": [
