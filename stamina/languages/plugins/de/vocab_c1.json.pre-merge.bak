      "lemma": "aufsetzen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8936,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to put on (something to be worn on the head)",
          "to put on (coffee or tea)",
          "to draft; to compose (a written document)",
          "to sit up"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2652735",
          "text": "Darf ich mal deine Brille aufsetzen?",
          "translation": "Можно мне надеть твои очки?",
          "source": "Tatoeba #2652735 @al_ex_an_der / #10197634 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2652735",
          "cefr_level": "A1",
          "word_slugs": [
            "aufsetzen-verb"
          ]
        },
        {
          "id": "5127894",
          "text": "Momentchen! Ich muss die Brille aufsetzen.",
          "translation": "Секундочку! Мне надо надеть очки.",
          "source": "Tatoeba #5127894 @Manfredo / #5126335 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5127894",
          "cefr_level": "A1",
          "word_slugs": [
            "aufsetzen-verb"
          ]
        },
        {
          "id": "7664503",
          "text": "So einen Hut würde ich nie aufsetzen.",
          "translation": "Я бы никогда такую шляпу не стал носить.",
          "source": "Tatoeba #7664503 @Pfirsichbaeumchen / #6630532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7664503",
          "cefr_level": "A1",
          "word_slugs": [
            "aufsetzen-verb"
          ]
        },
        {
          "id": "7769410",
          "text": "Ich muss mir die Brille aufsetzen. Ich kann sie einfach nicht sehen.",
          "translation": "Мне надо надеть очки. Я их просто не вижу.",
          "source": "Tatoeba #7769410 @raggione / #7769419 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7769410",
          "cefr_level": "A1",
          "word_slugs": [
            "aufsetzen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
