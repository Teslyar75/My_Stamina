    {
      "slug": "keineswegs-adv",
      "lemma": "keineswegs",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7199,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "in no way, by no means, not at all, not a bit"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3034468",
          "text": "Und das ist keineswegs übertrieben!",
          "translation": "И это не преувеличение!",
          "source": "Tatoeba #3034468 @al_ex_an_der / #3034459 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3034468",
          "cefr_level": "A1",
          "word_slugs": [
            "keineswegs-adv"
          ]
        },
        {
          "id": "4820294",
          "text": "Die Mülltrennung ist keineswegs ein Bagatellproblem.",
          "translation": "Проблема раздельного сбора мусора – вовсе не мелочь.",
          "source": "Tatoeba #4820294 @al_ex_an_der / #4820278 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4820294",
          "cefr_level": "A1",
          "word_slugs": [
            "keineswegs-adv"
          ]
        },
        {
          "id": "2054705",
          "text": "Manche meinen, solche Zufälle seien keineswegs zufällig.",
          "translation": "Есть мнение, что такие случайности совсем не случайны.",
          "source": "Tatoeba #2054705 @al_ex_an_der / #2054703 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2054705",
          "cefr_level": "A1",
          "word_slugs": [
            "keineswegs-adv"
          ]
        },
        {
          "id": "12604017",
          "text": "„Verstehen heißt verzeihen.“ – „Das heißt es keineswegs!“",
          "translation": "«Понять — значит простить». — «Совершенно не значит».",
          "source": "Tatoeba #12604017 @Waldelfe / #12602650 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12604017",
          "cefr_level": "A1",
          "word_slugs": [
            "keineswegs-adv"
          ]
        },
        {
          "id": "12604015",
          "text": "Das bedeutet keineswegs, daß ich dir verziehen habe.",
          "translation": "Это совершенно не значит, что я тебя простил.",
          "source": "Tatoeba #12604015 @Waldelfe / #12602651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12604015",
          "cefr_level": "A1",
          "word_slugs": [
            "keineswegs-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
