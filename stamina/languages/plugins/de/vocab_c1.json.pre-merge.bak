            "wecker-noun"
          ]
        },
        {
          "id": "4105370",
          "text": "Das ist mein Wecker.",
          "translation": "Это мой будильник.",
          "source": "Tatoeba #4105370 @Pfirsichbaeumchen / #4105391 @Eldad (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4105370",
          "cefr_level": "A1",
          "word_slugs": [
            "wecker-noun"
          ]
        },
        {
          "id": "8639272",
