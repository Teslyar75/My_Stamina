    {
      "slug": "klüger-adj",
      "lemma": "klüger",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7066,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "comparative degree of klug"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3498096",
          "text": "Tom ist klüger.",
          "translation": "Том умнее.",
          "source": "Tatoeba #3498096 @Pfirsichbaeumchen / #5878666 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3498096",
          "cefr_level": "A1",
          "word_slugs": [
            "klüger-adj"
          ]
        },
        {
          "id": "12481612",
          "text": "Ich will klüger werden.",
          "translation": "Я хочу стать умнее.",
          "source": "Tatoeba #12481612 @Waldelfe / #4780974 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12481612",
          "cefr_level": "A1",
          "word_slugs": [
            "klüger-adj"
          ]
        },
        {
          "id": "2900885",
          "text": "Ich bin klüger geworden.",
          "translation": "Я поумнел.",
          "source": "Tatoeba #2900885 @Pfirsichbaeumchen / #2496925 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2900885",
          "cefr_level": "A1",
          "word_slugs": [
            "klüger-adj"
          ]
        },
        {
          "id": "3441286",
          "text": "Werden die Menschen klüger?",
          "translation": "Люди становятся умнее?",
          "source": "Tatoeba #3441286 @al_ex_an_der / #3441285 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3441286",
          "cefr_level": "A1",
          "word_slugs": [
            "klüger-adj"
          ]
        },
        {
          "id": "689085",
          "text": "Er ist klüger als ich.",
          "translation": "Он умнее меня.",
          "source": "Tatoeba #689085 @pricejosephd / #443763 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/689085",
          "cefr_level": "A1",
          "word_slugs": [
            "klüger-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
