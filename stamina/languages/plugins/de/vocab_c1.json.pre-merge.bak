      },
      "gender": null,
      "examples": [
        {
          "id": "11569532",
          "text": "Sie hat rote Nägel.",
          "translation": "У неё красные ногти.",
          "source": "Tatoeba #11569532 @Pfirsichbaeumchen / #5637786 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11569532",
          "cefr_level": "A1",
          "word_slugs": [
            "nägel-noun"
          ]
        },
        {
          "id": "755263",
          "text": "Ihre Nägel sind rot.",
          "translation": "Её ногти красные.",
          "source": "Tatoeba #755263 @MUIRIEL / #2371514 @urusu_tom (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/755263",
          "cefr_level": "A1",
          "word_slugs": [
            "nägel-noun"
          ]
        },
        {
          "id": "10282584",
          "text": "Schneide dir die Nägel!",
          "translation": "Постриги ногти.",
          "source": "Tatoeba #10282584 @Pfirsichbaeumchen / #5769673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10282584",
          "cefr_level": "A1",
          "word_slugs": [
            "nägel-noun"
          ]
        },
        {
          "id": "2972275",
          "text": "Sie betrachtete ihre Nägel.",
          "translation": "Она рассматривала свои ногти.",
          "source": "Tatoeba #2972275 @Pfirsichbaeumchen / #4765729 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2972275",
          "cefr_level": "A1",
          "word_slugs": [
            "nägel-noun"
          ]
        },
        {
          "id": "2264892",
          "text": "Frauen färben oft ihre Nägel.",
          "translation": "Женщины часто красят ногти.",
          "source": "Tatoeba #2264892 @al_ex_an_der / #2264894 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2264892",
          "cefr_level": "A1",
          "word_slugs": [
            "nägel-noun"
          ]
        }
      ],
