    {
      "slug": "liefen-verb",
      "lemma": "liefen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7676,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of laufen:",
          "first/third-person plural preterite",
          "inflection of laufen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2221660",
          "text": "Wir liefen ungefähr fünf Meilen.",
          "translation": "Мы прошли около пяти миль.",
          "source": "Tatoeba #2221660 @Pfirsichbaeumchen / #11547761 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2221660",
          "cefr_level": "A1",
          "word_slugs": [
            "liefen-verb"
          ]
        },
        {
          "id": "2221656",
          "text": "Wir liefen ungefähr acht Kilometer.",
          "translation": "Мы прошли около восьми километров.",
          "source": "Tatoeba #2221656 @Pfirsichbaeumchen / #11547763 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2221656",
          "cefr_level": "A1",
          "word_slugs": [
            "liefen-verb"
          ]
        },
        {
          "id": "1295204",
          "text": "Tränen liefen mir über die Wangen.",
          "translation": "По щекам у меня бежали слёзы.",
          "source": "Tatoeba #1295204 @Esperantostern / #8433114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1295204",
          "cefr_level": "A1",
          "word_slugs": [
            "liefen-verb"
          ]
        },
        {
          "id": "1684048",
          "text": "Sie liefen nackt durch die Straßen.",
          "translation": "Они бегали голые по улицам.",
          "source": "Tatoeba #1684048 @Pfirsichbaeumchen / #12331237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684048",
          "cefr_level": "A1",
          "word_slugs": [
            "liefen-verb"
          ]
        },
        {
          "id": "2346632",
          "text": "Tränen liefen ihr über das Gesicht.",
          "translation": "Слёзы текли по её лицу.",
          "source": "Tatoeba #2346632 @Pfirsichbaeumchen / #2346648 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2346632",
          "cefr_level": "A1",
          "word_slugs": [
            "liefen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
