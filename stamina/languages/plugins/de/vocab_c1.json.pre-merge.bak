    {
      "slug": "einsamkeit-noun",
      "lemma": "Einsamkeit",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5927,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "одиночество"
        ],
        "en": [
          "loneliness",
          "solitude, lonesomeness, solitariness"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "7969755",
          "text": "Mir gefällt die Einsamkeit nicht.",
          "translation": "Я не люблю одиночество.",
          "source": "Tatoeba #7969755 @Pfirsichbaeumchen / #8017809 @Smoky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7969755",
          "cefr_level": "A1",
          "word_slugs": [
            "einsamkeit-noun"
          ]
        },
        {
          "id": "7873682",
          "text": "Meerschweinchen können an Einsamkeit sterben.",
          "translation": "Морские свинки могут умереть от одиночества.",
          "source": "Tatoeba #7873682 @Pfirsichbaeumchen / #13963082 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7873682",
          "cefr_level": "A1",
          "word_slugs": [
            "einsamkeit-noun"
          ]
        },
        {
          "id": "5665647",
          "text": "Sie konnte die Einsamkeit kaum ertragen.",
          "translation": "Она едва выдерживала одиночество.",
          "source": "Tatoeba #5665647 @maaster / #5665696 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5665647",
          "cefr_level": "A1",
          "word_slugs": [
            "einsamkeit-noun"
          ]
        },
        {
          "id": "2399447",
          "text": "Jetzt hat sie Angst vor der Einsamkeit.",
          "translation": "Теперь она боится одиночества.",
          "source": "Tatoeba #2399447 @al_ex_an_der / #6328814 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2399447",
          "cefr_level": "A1",
          "word_slugs": [
            "einsamkeit-noun"
          ]
        },
        {
          "id": "13618721",
          "text": "Ich habe schon immer die Einsamkeit geliebt.",
          "translation": "Я всегда любил одиночество.",
          "source": "Tatoeba #13618721 @Waldelfe / #11993332 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13618721",
          "cefr_level": "A1",
          "word_slugs": [
            "einsamkeit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
