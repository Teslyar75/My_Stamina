    {
      "slug": "fach-noun",
      "lemma": "Fach",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8075,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "compartment",
          "drawer",
          "subject"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10147946",
          "text": "Philosophie ist ein interessantes Fach.",
          "translation": "Философия - интересный предмет.",
          "source": "Tatoeba #10147946 @Yorwba / #12172254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10147946",
          "cefr_level": "A1",
          "word_slugs": [
            "fach-noun"
          ]
        },
        {
          "id": "3595530",
          "text": "Ich gestehe Unerfahrenheit in diesem Fach ein.",
          "translation": "Я признаю свою неосведомлённость в этой области.",
          "source": "Tatoeba #3595530 @al_ex_an_der / #3595597 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3595530",
          "cefr_level": "A1",
          "word_slugs": [
            "fach-noun"
          ]
        },
        {
          "id": "10828334",
          "text": "Die Linguistik ist ein sehr interessantes Fach.",
          "translation": "Лингвистика - очень интересная специальность.",
          "source": "Tatoeba #10828334 @Yorwba / #12114710 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10828334",
          "cefr_level": "A1",
          "word_slugs": [
            "fach-noun"
          ]
        },
        {
          "id": "4096911",
          "text": "Er hatte endlich alles unter Dach und Fach.",
          "translation": "У него всё было наконец готово.",
          "source": "Tatoeba #4096911 @brunoalbinus / #4097164 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4096911",
          "cefr_level": "A1",
          "word_slugs": [
            "fach-noun"
          ]
        },
        {
          "id": "12146072",
          "text": "Englisch ist das Fach, das ich am wenigsten mag.",
          "translation": "Английский - мой самый нелюбимый предмет.",
          "source": "Tatoeba #12146072 @Pfirsichbaeumchen / #8038017 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12146072",
          "cefr_level": "A1",
          "word_slugs": [
            "fach-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
