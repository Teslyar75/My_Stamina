    {
      "slug": "herab-adv",
      "lemma": "herab",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9590,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "down, downwards (to the own location downwards)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6645088",
          "text": "Er sieht auf Frauen herab.",
          "translation": "На женщин он смотрит свысока.",
          "source": "Tatoeba #6645088 @Felixjp / #416039 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6645088",
          "cefr_level": "A1",
          "word_slugs": [
            "herab-adv"
          ]
        },
        {
          "id": "3056886",
          "text": "Tom sieht auf Frauen herab.",
          "translation": "Том смотрит на женщин свысока.",
          "source": "Tatoeba #3056886 @freddy1 / #3056898 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3056886",
          "cefr_level": "A1",
          "word_slugs": [
            "herab-adv"
          ]
        },
        {
          "id": "10011923",
          "text": "Vom Dach des Hauses hängen Eiszapfen herab.",
          "translation": "С крыши дома свисают сосульки.",
          "source": "Tatoeba #10011923 @Pfirsichbaeumchen / #9830076 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10011923",
          "cefr_level": "A1",
          "word_slugs": [
            "herab-adv"
          ]
        },
        {
          "id": "3530805",
          "text": "Schaut nicht auf ihn herab, nur weil er arm ist.",
          "translation": "Не смотрите на него сверху вниз, только потому, что он бедный.",
          "source": "Tatoeba #3530805 @Zaghawa / #3530931 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3530805",
          "cefr_level": "A1",
          "word_slugs": [
            "herab-adv"
          ]
        },
        {
          "id": "3432680",
          "text": "Er sprach mit ihr in einer von oben herab belehrenden Art.",
          "translation": "Он говорил с ней свысока поучительным тоном.",
          "source": "Tatoeba #3432680 @al_ex_an_der / #3443706 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3432680",
          "cefr_level": "A1",
          "word_slugs": [
            "herab-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "friedrich-name",
      "lemma": "Friedrich",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9591,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a male given name from Old High German, equivalent to English Frederick."
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1787804",
          "text": "Friedrich Nietzsche war ein deutscher Philosoph.",
          "translation": "Фридрих Ницше был немецким философом.",
          "source": "Tatoeba #1787804 @Pfirsichbaeumchen / #3703811 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1787804",
          "cefr_level": "A1",
          "word_slugs": [
            "friedrich-name"
          ]
        },
        {
          "id": "6143694",
          "text": "König Friedrich liebte die Jagd, Wein, Frauen und Festgelage.",
          "translation": "Король Фредерик обожал охоту, вино, женщин и пиры.",
          "source": "Tatoeba #6143694 @Pfirsichbaeumchen / #14111726 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6143694",
          "cefr_level": "A1",
          "word_slugs": [
            "friedrich-name"
          ]
        },
        {
          "id": "3698241",
          "text": "Die hier vorliegende Münze ist ein Friedrich d’or von 1774.",
          "translation": "Представленная здесь монета — фридрихсдор 1774 года.",
          "source": "Tatoeba #3698241 @Pfirsichbaeumchen / #5888077 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3698241",
          "cefr_level": "A1",
          "word_slugs": [
            "friedrich-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Friedrich",
        "nominative_pl": ""
      }
    },
