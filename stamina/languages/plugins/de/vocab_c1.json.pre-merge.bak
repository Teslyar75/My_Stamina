    {
      "slug": "grauen-verb",
      "lemma": "grauen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6456,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to break, to dawn",
          "to dusk",
          "to become grey"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8816000",
          "text": "Tom hat einen grauen Wagen.",
          "translation": "У Тома серая машина.",
          "source": "Tatoeba #8816000 @felix63 / #8816276 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8816000",
          "cefr_level": "A1",
          "word_slugs": [
            "grauen-verb"
          ]
        },
        {
          "id": "689204",
          "text": "Der Alte hatte einen langen, grauen Bart.",
          "translation": "У старика была длинная седая борода.",
          "source": "Tatoeba #689204 @Manfredo / #2362673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/689204",
          "cefr_level": "A1",
          "word_slugs": [
            "grauen-verb"
          ]
        },
        {
          "id": "2342219",
          "text": "Er war mit einem grauen Mantel bekleidet.",
          "translation": "Он был одет в серое пальто.",
          "source": "Tatoeba #2342219 @al_ex_an_der / #2342220 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2342219",
          "cefr_level": "A1",
          "word_slugs": [
            "grauen-verb"
          ]
        },
        {
          "id": "3170870",
          "text": "Dürfte ich mir Ihren grauen Anzug ausleihen?",
          "translation": "Можно я одолжу у Вас Ваш серый костюм?",
          "source": "Tatoeba #3170870 @Pfirsichbaeumchen / #11982265 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3170870",
          "cefr_level": "A1",
          "word_slugs": [
            "grauen-verb"
          ]
        },
        {
          "id": "3170868",
          "text": "Dürfte ich mir deinen grauen Anzug ausleihen?",
          "translation": "Можно я одолжу у тебя твой серый костюм?",
          "source": "Tatoeba #3170868 @Pfirsichbaeumchen / #11982264 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3170868",
          "cefr_level": "A1",
          "word_slugs": [
            "grauen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
