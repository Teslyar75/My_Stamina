    {
      "slug": "zutiefst-adv",
      "lemma": "zutiefst",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7851,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "очень",
          "в высшей степени",
          "глубоко"
        ],
        "en": [
          "deeply"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12733876",
          "text": "Er war zutiefst schockiert.",
          "translation": "Он был глубоко потрясён.",
          "source": "Tatoeba #12733876 @Waldelfe / #2774887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12733876",
          "cefr_level": "A1",
          "word_slugs": [
            "zutiefst-adv"
          ]
        },
        {
          "id": "9057440",
          "text": "Sie war zutiefst schockiert.",
          "translation": "Она была глубоко потрясена.",
          "source": "Tatoeba #9057440 @Pfirsichbaeumchen / #2774888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9057440",
          "cefr_level": "A1",
          "word_slugs": [
            "zutiefst-adv"
          ]
        },
        {
          "id": "272",
          "text": "Ich verabscheue förmliches Schreiben zutiefst!",
          "translation": "Я терпеть не могу формальный стиль письма!",
          "source": "Tatoeba #272 @MUIRIEL / #5602 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/272",
          "cefr_level": "A1",
          "word_slugs": [
            "zutiefst-adv"
          ]
        },
        {
          "id": "989726",
          "text": "Seine Rede berührte das Publikum zutiefst.",
          "translation": "Его речь глубоко затронула аудиторию.",
          "source": "Tatoeba #989726 @al_ex_an_der / #1554132 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/989726",
          "cefr_level": "A1",
          "word_slugs": [
            "zutiefst-adv"
          ]
        },
        {
          "id": "757514",
          "text": "Zutiefst dankbar versuchte er seinen Dank auszudrücken.",
          "translation": "Он был очень благодарен и пытался это высказать.",
          "source": "Tatoeba #757514 @Esperantostern / #721986 @JeNNeR (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/757514",
          "cefr_level": "A1",
          "word_slugs": [
            "zutiefst-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
