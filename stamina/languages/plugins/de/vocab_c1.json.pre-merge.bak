          ]
        },
        {
          "id": "5164897",
          "text": "Ich drücke dir die Daumen!",
          "translation": "Держу за тебя кулачки!",
          "source": "Tatoeba #5164897 @Pfirsichbaeumchen / #5543316 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5164897",
          "cefr_level": "A1",
