    {
      "slug": "christen-noun",
      "lemma": "Christen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8328,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Christ:",
          "genitive/dative/accusative singular",
          "inflection of Christ:",
          "all-case plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "371122",
          "text": "Sie sind Christen.",
          "translation": "Они христиане.",
          "source": "Tatoeba #371122 @xtofu80 / #877323 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/371122",
          "cefr_level": "A1",
          "word_slugs": [
            "christen-noun"
          ]
        },
        {
          "id": "14071847",
          "text": "Georgien und Armenier sind Christen.",
          "translation": "Грузины и армяне — христиане.",
          "source": "Tatoeba #14071847 @mhr / #14070700 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14071847",
          "cefr_level": "A1",
          "word_slugs": [
            "christen-noun"
          ]
        },
        {
          "id": "340839",
          "text": "Die Christen glauben an Jesus Christus.",
          "translation": "Христиане верят в Иисуса Христа.",
          "source": "Tatoeba #340839 @MUIRIEL / #1060858 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/340839",
          "cefr_level": "A1",
          "word_slugs": [
            "christen-noun"
          ]
        },
        {
          "id": "7273175",
          "text": "Die frühen Christen wurden vom Römischen Reich verfolgt.",
          "translation": "Ранние христиане подвергались гонениям со стороны Римской империи.",
          "source": "Tatoeba #7273175 @Pfirsichbaeumchen / #12444026 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7273175",
          "cefr_level": "A1",
          "word_slugs": [
            "christen-noun"
          ]
        },
        {
          "id": "13178946",
          "text": "Christen bauen Brücken, keine Mauern.",
          "translation": "Христиане строят мосты, а не стены.",
          "source": "Tatoeba #13178946 @Rovo / #13179002 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13178946",
          "cefr_level": "A1",
          "word_slugs": [
            "christen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
