      "examples": [
        {
          "id": "741283",
          "text": "In ihren Flitterwochen machten sie eine Weltreise.",
          "translation": "В свой медовый месяц они совершили кругосветное путешествие.",
          "source": "Tatoeba #741283 @Manfredo / #6461359 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/741283",
          "cefr_level": "A1",
          "word_slugs": [
            "flitterwochen-noun"
          ]
        },
        {
          "id": "6931094",
          "text": "Wir wollen unsere Flitterwochen in Frankreich verbringen.",
          "translation": "Мы хотим провести медовый месяц во Франции.",
          "source": "Tatoeba #6931094 @Pfirsichbaeumchen / #10183298 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6931094",
          "cefr_level": "A1",
          "word_slugs": [
            "flitterwochen-noun"
          ]
        }
      ],
