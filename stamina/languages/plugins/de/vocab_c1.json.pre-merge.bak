    {
      "slug": "überein-adv",
      "lemma": "überein",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6633,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "equal, matching"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5156086",
          "text": "Wir stimmen im Grunde überein.",
          "translation": "Мы по существу одного мнения.",
          "source": "Tatoeba #5156086 @raggione / #5157251 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5156086",
          "cefr_level": "A1",
          "word_slugs": [
            "überein-adv"
          ]
        },
        {
          "id": "7464130",
          "text": "Ich stimme oft mit Tom überein.",
          "translation": "Я часто соглашаюсь с Томом.",
          "source": "Tatoeba #7464130 @Pfirsichbaeumchen / #7464303 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7464130",
          "cefr_level": "A1",
          "word_slugs": [
            "überein-adv"
          ]
        },
        {
          "id": "2454263",
          "text": "Ich stimme weitgehend mit ihr überein.",
          "translation": "По большей части я с ней согласен.",
          "source": "Tatoeba #2454263 @al_ex_an_der / #2454257 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2454263",
          "cefr_level": "A1",
          "word_slugs": [
            "überein-adv"
          ]
        },
        {
          "id": "2454261",
          "text": "Ich stimme größtenteils mit ihr überein.",
          "translation": "По большей части я с ней согласен.",
          "source": "Tatoeba #2454261 @al_ex_an_der / #2454257 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2454261",
          "cefr_level": "A1",
          "word_slugs": [
            "überein-adv"
          ]
        },
        {
          "id": "3100795",
          "text": "Darin stimme ich mit Ihnen vollkommen überein.",
          "translation": "В этом я совершенно с Вами согласен.",
          "source": "Tatoeba #3100795 @al_ex_an_der / #3100786 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3100795",
          "cefr_level": "A1",
          "word_slugs": [
            "überein-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
