    {
      "slug": "absoluter-adj",
      "lemma": "absoluter",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9557,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of absolut:",
          "strong/mixed nominative masculine singular",
          "inflection of absolut:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7010996",
          "text": "Das war absoluter Zufall.",
          "translation": "Это было совершенно случайно.",
          "source": "Tatoeba #7010996 @driini / #4066625 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7010996",
          "cefr_level": "A1",
          "word_slugs": [
            "absoluter-adj"
          ]
        },
        {
          "id": "2194874",
          "text": "Er ist ein absoluter Monarch.",
          "translation": "Он абсолютный монарх.",
          "source": "Tatoeba #2194874 @Vortarulo / #652341 @goldenmouse (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2194874",
          "cefr_level": "A1",
          "word_slugs": [
            "absoluter-adj"
          ]
        },
        {
          "id": "13407591",
          "text": "Der sogenannte Experte erwies sich als absoluter Amateur.",
          "translation": "Так называемый эксперт оказался совершеннейшим любителем.",
          "source": "Tatoeba #13407591 @mhr / #13407343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13407591",
          "cefr_level": "A1",
          "word_slugs": [
            "absoluter-adj"
          ]
        },
        {
          "id": "13407588",
          "text": "Der sogenannte Experte erwies sich als absoluter Dilettant.",
          "translation": "Так называемый эксперт оказался совершеннейшим дилетантом.",
          "source": "Tatoeba #13407588 @mhr / #13407344 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13407588",
          "cefr_level": "A1",
          "word_slugs": [
            "absoluter-adj"
          ]
        },
        {
          "id": "13407590",
          "text": "Der sogenannte Experte hat sich als absoluter Amateur erwiesen.",
          "translation": "Так называемый эксперт оказался совершеннейшим любителем.",
          "source": "Tatoeba #13407590 @mhr / #13407343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13407590",
