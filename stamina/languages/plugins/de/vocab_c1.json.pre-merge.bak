      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of entscheiden:",
          "second-person singular present",
          "inflection of entscheiden:",
          "second-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2053415",
          "text": "Wie entscheidest du gewöhnlich, was du isst?",
          "translation": "Как ты обычно решаешь, что кушать?",
          "source": "Tatoeba #2053415 @Pfirsichbaeumchen / #2053403 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2053415",
          "cefr_level": "A1",
          "word_slugs": [
            "entscheidest-verb"
          ]
        },
        {
          "id": "10461236",
          "text": "Ich weiß, dass du dich richtig entscheidest.",
          "translation": "Я знаю, что ты примешь верное решение.",
          "source": "Tatoeba #10461236 @virgil / #3743474 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10461236",
          "cefr_level": "A1",
          "word_slugs": [
            "entscheidest-verb"
          ]
        },
        {
          "id": "327",
          "text": "Du entscheidest, ob wir dahin gehen oder nicht.",
          "translation": "Ты решишь, пойдём ли мы туда или нет.",
          "source": "Tatoeba #327 @MUIRIEL / #2848572 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/327",
          "cefr_level": "A1",
          "word_slugs": [
            "entscheidest-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
