        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1924352",
          "text": "Sie sind grau.",
          "translation": "Они серые.",
          "source": "Tatoeba #1924352 @Zaghawa / #2233018 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1924352",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-adj"
          ]
        },
        {
          "id": "8320557",
          "text": "Die Maus ist grau.",
          "translation": "Мышь серая.",
          "source": "Tatoeba #8320557 @MisterTrouser / #10126988 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320557",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-adj"
          ]
        },
        {
          "id": "1287791",
          "text": "Die Lampe ist grau.",
          "translation": "Лампа серая.",
          "source": "Tatoeba #1287791 @Esperantostern / #1718873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1287791",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-adj"
          ]
        },
        {
          "id": "1506091",
          "text": "Ihr Haar wird grau.",
          "translation": "Она седеет.",
          "source": "Tatoeba #1506091 @samueldora / #4528221 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1506091",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-adj"
          ]
        },
        {
          "id": "3325844",
          "text": "Die Wolke ist grau.",
          "translation": "Облако серое.",
          "source": "Tatoeba #3325844 @al_ex_an_der / #3325843 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3325844",
          "cefr_level": "A1",
          "word_slugs": [
            "grau-adj"
          ]
        }
      ],
      "tags": [
