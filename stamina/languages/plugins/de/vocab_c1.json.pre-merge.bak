    {
      "slug": "sackgasse-noun",
      "lemma": "Sackgasse",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7426,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "тупик"
        ],
        "en": [
          "dead-end street; cul-de-sac",
          "dead end (something that does not lead one to the intended result)",
          "impasse (stagnation that one can only overcome by fundamentally changing one’s approach)",
          "stalemate; deadlock (stagnation that is due to an inability or unwillingness to reach a compromise)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "977",
          "text": "Das ist eine Sackgasse.",
          "translation": "Это тупик.",
          "source": "Tatoeba #977 @MUIRIEL / #445456 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/977",
          "cefr_level": "A1",
          "word_slugs": [
            "sackgasse-noun"
          ]
        },
        {
          "id": "13467864",
          "text": "Dies ist eine Sackgasse.",
          "translation": "Это тупик.",
          "source": "Tatoeba #13467864 @mhr / #445456 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13467864",
          "cefr_level": "A1",
          "word_slugs": [
            "sackgasse-noun"
          ]
        },
        {
          "id": "12494501",
          "text": "Das ist eine evolutionäre Sackgasse.",
          "translation": "Это эволюционный тупик.",
          "source": "Tatoeba #12494501 @mhr / #12492243 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12494501",
          "cefr_level": "A1",
          "word_slugs": [
            "sackgasse-noun"
          ]
        },
        {
          "id": "12566281",
          "text": "Das ist eine Sackgasse der Evolution.",
          "translation": "Это тупиковая ветвь эволюции.",
          "source": "Tatoeba #12566281 @mhr / #12565283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12566281",
          "cefr_level": "A1",
          "word_slugs": [
            "sackgasse-noun"
          ]
        },
        {
          "id": "3094816",
          "text": "Man muss ihnen helfen, einen Ausweg aus der Sackgasse zu finden.",
          "translation": "Надо помочь им найти выход из тупика.",
          "source": "Tatoeba #3094816 @al_ex_an_der / #3094813 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3094816",
          "cefr_level": "A1",
          "word_slugs": [
            "sackgasse-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Sackgasse",
        "nominative_pl": ""
      }
    },
    {
