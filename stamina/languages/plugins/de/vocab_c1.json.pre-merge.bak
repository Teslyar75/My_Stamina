      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8603,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of irren:",
          "third-person singular present",
          "inflection of irren:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1938313",
          "text": "Tom irrt sich.",
          "translation": "Том ошибается.",
          "source": "Tatoeba #1938313 @Pfirsichbaeumchen / #2501690 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1938313",
          "cefr_level": "A1",
          "word_slugs": [
            "irrt-verb"
          ]
        },
        {
          "id": "2977745",
          "text": "Sie irrt sich.",
          "translation": "Она неправа.",
          "source": "Tatoeba #2977745 @Pfirsichbaeumchen / #2552199 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2977745",
          "cefr_level": "A1",
          "word_slugs": [
            "irrt-verb"
          ]
        },
        {
          "id": "7697166",
          "text": "Maria irrt sich.",
          "translation": "Мэри ошибается.",
          "source": "Tatoeba #7697166 @wolfgangth / #6614250 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7697166",
          "cefr_level": "A1",
          "word_slugs": [
            "irrt-verb"
          ]
        },
        {
          "id": "1996500",
          "text": "Tom irrt sich nie.",
          "translation": "Том никогда не ошибается.",
          "source": "Tatoeba #1996500 @mrtaistoi / #1996499 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1996500",
          "cefr_level": "A1",
          "word_slugs": [
            "irrt-verb"
          ]
        },
        {
          "id": "3481837",
          "text": "Einer von uns irrt.",
          "translation": "Один из нас ошибается.",
          "source": "Tatoeba #3481837 @Pfirsichbaeumchen / #1866518 @estong (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3481837",
          "cefr_level": "A1",
          "word_slugs": [
            "irrt-verb"
          ]
        }
      ],
