      "gender": null,
      "examples": [
        {
          "id": "13265678",
          "text": "Mir wurden keine Handschellen angelegt.",
          "translation": "Мне не надели наручники.",
          "source": "Tatoeba #13265678 @Waldelfe / #13411146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13265678",
          "cefr_level": "A1",
          "word_slugs": [
            "angelegt-verb"
          ]
        },
        {
          "id": "8864981",
          "text": "Ich wurde verhaftet und mir wurden Handschellen angelegt.",
          "translation": "Я был арестован, и на меня одели наручники.",
          "source": "Tatoeba #8864981 @mramosch / #8865107 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8864981",
          "cefr_level": "A1",
          "word_slugs": [
            "angelegt-verb"
          ]
        },
        {
          "id": "13979096",
          "text": "Wir haben hinter dem Haus einen kleinen Garten angelegt.",
          "translation": "Мы разбили за домом небольшой огород.",
          "source": "Tatoeba #13979096 @mhr / #12432155 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13979096",
          "cefr_level": "A1",
          "word_slugs": [
            "angelegt-verb"
          ]
        },
        {
          "id": "13979098",
          "text": "Wir haben hinter dem Haus ein kleines Gärtchen angelegt.",
          "translation": "Мы разбили за домом маленький садик.",
          "source": "Tatoeba #13979098 @mhr / #13979086 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13979098",
          "cefr_level": "A1",
          "word_slugs": [
            "angelegt-verb"
          ]
        },
        {
          "id": "13979100",
          "text": "Wir haben hinter dem Haus einen kleinen Gemüsegarten angelegt.",
