    {
      "slug": "angesprochen-verb",
      "lemma": "angesprochen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8481,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of ansprechen"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "365595",
          "text": "Ein Fremder hat mich im Bus angesprochen.",
          "translation": "В автобусе со мной заговорил незнакомец.",
          "source": "Tatoeba #365595 @Wolf / #6838154 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/365595",
          "cefr_level": "A1",
          "word_slugs": [
            "angesprochen-verb"
          ]
        },
        {
          "id": "1851642",
          "text": "Sprich nicht, wenn du nicht angesprochen bist!",
          "translation": "Не говори, если к тебе не обращаются.",
          "source": "Tatoeba #1851642 @Pfirsichbaeumchen / #14010091 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1851642",
          "cefr_level": "A1",
          "word_slugs": [
            "angesprochen-verb"
          ]
        },
        {
          "id": "2465775",
          "text": "Es freut mich, dass ihr das angesprochen habt.",
          "translation": "Я рад, что вы об этом заговорили.",
          "source": "Tatoeba #2465775 @Zaghawa / #13503001 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2465775",
          "cefr_level": "A1",
          "word_slugs": [
            "angesprochen-verb"
          ]
        },
        {
          "id": "3066552",
          "text": "Ich habe die Dinge schon immer direkt angesprochen!",
          "translation": "Я всегда об этом прямо говорил!",
          "source": "Tatoeba #3066552 @al_ex_an_der / #3067669 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3066552",
          "cefr_level": "A1",
          "word_slugs": [
            "angesprochen-verb"
          ]
        },
        {
          "id": "1851643",
          "text": "Sprechen Sie nicht, wenn Sie nicht angesprochen sind!",
          "translation": "Не говорите, если к вам не обращаются.",
          "source": "Tatoeba #1851643 @Pfirsichbaeumchen / #14010092 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1851643",
          "cefr_level": "A1",
          "word_slugs": [
            "angesprochen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der angesprochen",
        "nominative_pl": ""
      }
    },
