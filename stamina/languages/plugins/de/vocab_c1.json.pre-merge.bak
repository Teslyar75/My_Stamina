    {
      "slug": "beobachtung-noun",
      "lemma": "Beobachtung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8498,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "наблюдение"
        ],
        "en": [
          "monitoring; surveillance; supervision",
          "observation",
          "sighting (of a bird, animal, UFO, etc.)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "736423",
          "text": "Wissenschaft beruht auf Beobachtung.",
          "translation": "Наука базируется на наблюдении.",
          "source": "Tatoeba #736423 @Manfredo / #4846928 @margo1kurilenko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/736423",
          "cefr_level": "A1",
          "word_slugs": [
            "beobachtung-noun"
          ]
        },
        {
          "id": "6484683",
          "text": "Er ist unter ständiger Beobachtung.",
          "translation": "Он находится под постоянным наблюдением.",
          "source": "Tatoeba #6484683 @Espi / #6489666 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6484683",
          "cefr_level": "A1",
          "word_slugs": [
            "beobachtung-noun"
          ]
        },
        {
          "id": "10521866",
          "text": "Die Verstrickung mit der Welt ist eine Beobachtung.",
          "translation": "Связь с миром представляет собой наблюдение.",
          "source": "Tatoeba #10521866 @carlosalberto / #10521870 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10521866",
          "cefr_level": "A1",
          "word_slugs": [
            "beobachtung-noun"
          ]
        },
        {
          "id": "3278571",
          "text": "Man behielt Tom zur Beobachtung über Nacht im Krankenhaus.",
          "translation": "Тома оставили на ночь в больнице под наблюдением.",
          "source": "Tatoeba #3278571 @Pfirsichbaeumchen / #3278736 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3278571",
          "cefr_level": "A1",
          "word_slugs": [
            "beobachtung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Beobachtung",
        "nominative_pl": ""
      }
    },
