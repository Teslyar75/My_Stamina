        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4995585",
          "text": "Tom entschied sich zu warten.",
          "translation": "Том решил подождать.",
          "source": "Tatoeba #4995585 @zoona / #4769691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4995585",
          "cefr_level": "A1",
          "word_slugs": [
            "entschied-verb"
          ]
        },
        {
          "id": "818843",
          "text": "Ich entschied, nicht zu gehen.",
          "translation": "Я решил не идти.",
          "source": "Tatoeba #818843 @Esperantostern / #508694 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/818843",
          "cefr_level": "A1",
          "word_slugs": [
            "entschied-verb"
          ]
        },
        {
          "id": "4933946",
          "text": "Man entschied, die Gesellschaft aufzulösen.",
          "translation": "Было решено это общество распустить.",
          "source": "Tatoeba #4933946 @Esperantostern / #4933957 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4933946",
          "cefr_level": "A1",
          "word_slugs": [
            "entschied-verb"
          ]
        },
        {
          "id": "623692",
          "text": "Er entschied sich, Arzt zu werden.",
          "translation": "Он решил быть врачом.",
          "source": "Tatoeba #623692 @virgil / #1031618 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/623692",
          "cefr_level": "A1",
          "word_slugs": [
            "entschied-verb"
          ]
        },
        {
          "id": "723720",
          "text": "Der Doktor entschied, sofort zu operieren.",
          "translation": "Доктор решил немедленно оперировать.",
          "source": "Tatoeba #723720 @Esperantostern / #2974408 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/723720",
          "cefr_level": "A1",
          "word_slugs": [
            "entschied-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
