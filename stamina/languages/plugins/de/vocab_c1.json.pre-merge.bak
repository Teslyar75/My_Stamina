    {
      "slug": "dar-adv",
      "lemma": "dar",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5626,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "only used in darstellen etc."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "817838",
          "text": "Eine Weltkarte stellt alle Länder dar.",
          "translation": "На карте мира отображены все страны.",
          "source": "Tatoeba #817838 @Zaghawa / #7014090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/817838",
          "cefr_level": "A1",
          "word_slugs": [
            "dar-adv"
          ]
        },
        {
          "id": "403693",
          "text": "Steinschlag stellt für Bergsteiger eine Gefahr dar.",
          "translation": "Лавины представляют для альпинистов опасность.",
          "source": "Tatoeba #403693 @xtofu80 / #598896 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/403693",
          "cefr_level": "A1",
          "word_slugs": [
            "dar-adv"
          ]
        },
        {
          "id": "2833712",
          "text": "Er legte in wenigen Worten seine Meinung dar.",
          "translation": "Он в нескольких словах выразил своё мнение.",
          "source": "Tatoeba #2833712 @Pfirsichbaeumchen / #2833563 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2833712",
          "cefr_level": "A1",
          "word_slugs": [
            "dar-adv"
          ]
        },
        {
          "id": "2420409",
          "text": "Dieser Artikel stellt eine Aufwiegelung zum Mord dar.",
          "translation": "Эта статья является подстрекательством к убийству.",
          "source": "Tatoeba #2420409 @al_ex_an_der / #2420406 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2420409",
          "cefr_level": "A1",
          "word_slugs": [
            "dar-adv"
          ]
        },
        {
          "id": "1919394",
          "text": "Dieses Gemälde stellt einen Sturm auf dem Meer dar.",
          "translation": "На этой картине представлена морская буря.",
          "source": "Tatoeba #1919394 @Tamy / #440945 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1919394",
          "cefr_level": "A1",
          "word_slugs": [
            "dar-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
