    {
      "slug": "unbekannten-adj",
      "lemma": "unbekannten",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5963,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of unbekannt:",
          "strong genitive masculine/neuter singular",
          "inflection of unbekannt:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "769443",
          "text": "Dieses Gedicht wurde von einem unbekannten Dichter geschrieben.",
          "translation": "Это стихотворение было написано неизвестным поэтом.",
          "source": "Tatoeba #769443 @Esperantostern / #12927446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/769443",
          "cefr_level": "A1",
          "word_slugs": [
            "unbekannten-adj"
          ]
        },
        {
          "id": "3587047",
          "text": "Im Magen der Toten habe ich Spuren einer unbekannten Substanz gefunden.",
          "translation": "В желудке покойного я обнаружил следы неизвестного вещества.",
          "source": "Tatoeba #3587047 @al_ex_an_der / #3588987 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3587047",
          "cefr_level": "A1",
          "word_slugs": [
            "unbekannten-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "unbekannten-noun",
      "lemma": "Unbekannten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5963,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Unbekannte"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3179566",
          "text": "Sie traut Unbekannten nicht.",
          "translation": "Она не доверяет незнакомым людям.",
          "source": "Tatoeba #3179566 @Pfirsichbaeumchen / #3165100 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3179566",
          "cefr_level": "A1",
          "word_slugs": [
            "unbekannten-noun"
          ]
        },
        {
          "id": "423836",
          "text": "Dieser Hund bellt alle Unbekannten an.",
          "translation": "Эта собака лает на всех незнакомых.",
          "source": "Tatoeba #423836 @MUIRIEL / #12709592 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/423836",
          "cefr_level": "A1",
          "word_slugs": [
            "unbekannten-noun"
          ]
        },
        {
          "id": "13442500",
          "text": "Wenn der Hund jemand Unbekannten sieht, bellt er.",
          "translation": "Когда собака видит кого-нибудь незнакомого, она лает.",
          "source": "Tatoeba #13442500 @mhr / #13442481 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13442500",
          "cefr_level": "A1",
          "word_slugs": [
            "unbekannten-noun"
          ]
        },
        {
          "id": "2770679",
          "text": "Mir, einer Unbekannten, versprichst zu viel du und zu schnell.",
          "translation": "Мне, незнакомке, прочишь ты столь многого столь скоро.",
          "source": "Tatoeba #2770679 @al_ex_an_der / #2772046 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2770679",
          "cefr_level": "A1",
          "word_slugs": [
            "unbekannten-noun"
          ]
        },
        {
          "id": "3774268",
          "text": "Am Grab des Unbekannten Soldaten wurden Blumen und Kränze niedergelegt.",
          "translation": "К могиле Неизвестного солдата возложили цветы и венки.",
          "source": "Tatoeba #3774268 @al_ex_an_der / #3774265 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3774268",
          "cefr_level": "A1",
          "word_slugs": [
            "unbekannten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
