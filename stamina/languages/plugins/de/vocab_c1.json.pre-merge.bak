      "gender": "m",
      "examples": [
        {
          "id": "3268449",
          "text": "Tom ist unsterblich.",
          "translation": "Том бессмертен.",
          "source": "Tatoeba #3268449 @freddy1 / #3281796 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3268449",
          "cefr_level": "A1",
          "word_slugs": [
            "unsterblich-adj"
          ]
        },
        {
          "id": "2663638",
          "text": "Die Seele ist unsterblich.",
          "translation": "Душа бессмертна.",
          "source": "Tatoeba #2663638 @Pfirsichbaeumchen / #3459458 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2663638",
          "cefr_level": "A1",
          "word_slugs": [
            "unsterblich-adj"
          ]
        },
        {
          "id": "1804393",
          "text": "Das Murmeltier ist unsterblich.",
          "translation": "Сурок бессмертен.",
          "source": "Tatoeba #1804393 @Tamy / #2314160 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1804393",
          "cefr_level": "A1",
          "word_slugs": [
            "unsterblich-adj"
          ]
        },
        {
          "id": "2066552",
          "text": "Niemand von uns ist unsterblich.",
          "translation": "Никто из нас не бессмертен.",
          "source": "Tatoeba #2066552 @Pfirsichbaeumchen / #10989901 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2066552",
          "cefr_level": "A1",
          "word_slugs": [
            "unsterblich-adj"
          ]
        },
        {
          "id": "8651947",
          "text": "Willst du wirklich unsterblich sein?",
          "translation": "Ты действительно хочешь быть бессмертным?",
          "source": "Tatoeba #8651947 @Melang / #13018434 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8651947",
          "cefr_level": "A1",
          "word_slugs": [
            "unsterblich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
