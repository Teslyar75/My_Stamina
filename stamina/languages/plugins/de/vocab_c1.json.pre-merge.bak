          ]
        },
        {
          "id": "2741636",
          "text": "Willkommen in Brasilien!",
          "translation": "Добро пожаловать в Бразилию!",
          "source": "Tatoeba #2741636 @jr / #8253535 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2741636",
          "cefr_level": "A1",
