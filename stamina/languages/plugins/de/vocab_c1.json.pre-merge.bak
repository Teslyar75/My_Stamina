    {
      "slug": "gehängt-verb",
      "lemma": "gehängt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7892,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
