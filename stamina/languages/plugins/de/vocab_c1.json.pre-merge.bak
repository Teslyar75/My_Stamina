    {
      "slug": "valentinstag-noun",
      "lemma": "Valentinstag",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8084,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Valentine's Day"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1083682",
          "text": "Heute ist Valentinstag.",
          "translation": "Сегодня День святого Валентина.",
          "source": "Tatoeba #1083682 @Espi / #1395413 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1083682",
          "cefr_level": "A1",
          "word_slugs": [
            "valentinstag-noun"
          ]
        },
        {
          "id": "2225590",
          "text": "Einen schönen Valentinstag!",
          "translation": "С Днем Святого Валентина!",
          "source": "Tatoeba #2225590 @Pfirsichbaeumchen / #1430448 @tania_soleil (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2225590",
          "cefr_level": "A1",
          "word_slugs": [
            "valentinstag-noun"
          ]
        },
        {
          "id": "2223099",
          "text": "Sie war allein am Valentinstag.",
          "translation": "В День святого Валентина она была одна.",
          "source": "Tatoeba #2223099 @Espi / #5197870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2223099",
          "cefr_level": "A1",
          "word_slugs": [
            "valentinstag-noun"
          ]
        },
        {
          "id": "6819865",
          "text": "Tom war am Valentinstag allein.",
          "translation": "Том был один на день Святого Валентина.",
          "source": "Tatoeba #6819865 @Pfirsichbaeumchen / #6820996 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6819865",
          "cefr_level": "A1",
          "word_slugs": [
            "valentinstag-noun"
          ]
        },
        {
          "id": "2478813",
          "text": "Wir haben uns am Valentinstag getrennt.",
          "translation": "Мы расстались в День святого Валентина.",
          "source": "Tatoeba #2478813 @Pfirsichbaeumchen / #7862147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2478813",
          "cefr_level": "A1",
          "word_slugs": [
            "valentinstag-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
