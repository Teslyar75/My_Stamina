          ]
        },
        {
          "id": "3061472",
          "text": "Was verstehst du unter Luxus?",
          "translation": "Что ты подразумеваешь под роскошью?",
          "source": "Tatoeba #3061472 @al_ex_an_der / #3061482 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3061472",
