    {
      "slug": "blauer-adj",
      "lemma": "blauer",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9502,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of blau:",
          "strong/mixed nominative masculine singular",
          "inflection of blau:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14071911",
          "text": "So ein blauer Himmel!",
          "translation": "Какое синее небо!",
          "source": "Tatoeba #14071911 @mhr / #777294 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14071911",
          "cefr_level": "A1",
          "word_slugs": [
            "blauer-adj"
          ]
        },
        {
          "id": "5942048",
          "text": "Was für ein blauer Himmel!",
          "translation": "Какое голубое небо!",
          "source": "Tatoeba #5942048 @Adelpa / #5942206 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5942048",
          "cefr_level": "A1",
          "word_slugs": [
            "blauer-adj"
          ]
        },
        {
          "id": "564411",
          "text": "Schwefel brennt mit blauer Flamme.",
          "translation": "Сера горит синим пламенем.",
          "source": "Tatoeba #564411 @MUIRIEL / #6454821 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/564411",
          "cefr_level": "A1",
          "word_slugs": [
            "blauer-adj"
          ]
        },
        {
          "id": "5939362",
          "text": "Dein blauer Anzug hängt im Schrank.",
          "translation": "Твой синий костюм висит в шкафу.",
          "source": "Tatoeba #5939362 @Pfirsichbaeumchen / #5488980 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5939362",
          "cefr_level": "A1",
          "word_slugs": [
            "blauer-adj"
          ]
        },
        {
          "id": "13540107",
          "text": "Früher war das Gras grüner, der Himmel blauer und die Sonne heller.",
          "translation": "Раньше трава была зеленее, небо голубее, а солнце ярче.",
          "source": "Tatoeba #13540107 @mhr / #13539870 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13540107",
          "cefr_level": "A1",
          "word_slugs": [
            "blauer-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
