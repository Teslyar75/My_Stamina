    {
      "slug": "verbreiten-verb",
      "lemma": "verbreiten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5991,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to put about, spread, circulate, disseminate sth.",
          "to spread, circulate, go around",
          "to expound (of a person) (to make a statement at length about something)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "781366",
          "text": "Neuigkeiten verbreiten sich schnell.",
          "translation": "Новости распространяются быстро.",
          "source": "Tatoeba #781366 @MUIRIEL / #2055696 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/781366",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreiten-verb"
          ]
        },
        {
          "id": "8631816",
          "text": "Küssen kann den Virus verbreiten.",
          "translation": "Вирус может передаваться через поцелуи.",
          "source": "Tatoeba #8631816 @Melang / #8632426 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8631816",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreiten-verb"
          ]
        },
        {
          "id": "411755",
          "text": "Schlechte Neuigkeiten verbreiten sich schnell.",
          "translation": "Плохие новости быстро распространяются.",
          "source": "Tatoeba #411755 @MUIRIEL / #1914616 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/411755",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreiten-verb"
          ]
        },
        {
          "id": "2525605",
          "text": "Diese Wildblumen verbreiten einen angenehmen Duft.",
          "translation": "Эти полевые цветы распространяют приятный аромат.",
          "source": "Tatoeba #2525605 @Tamy / #4951736 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2525605",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreiten-verb"
          ]
        },
        {
          "id": "1300820",
          "text": "Die schlechten Nachrichten verbreiten sich schnell.",
          "translation": "Плохие новости распространяются быстро.",
          "source": "Tatoeba #1300820 @enteka / #9027335 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1300820",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreiten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
