    {
      "slug": "och-intj",
      "lemma": "och",
      "pos": "intj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6952,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "expressing endearment, pity, consideration, etc."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6126767",
          "text": "„Och nö!“ – „Och doch!“",
          "translation": "\"О нет!\" - \"О да!\"",
          "source": "Tatoeba #6126767 @Pfirsichbaeumchen / #13556313 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6126767",
          "cefr_level": "A1",
          "word_slugs": [
            "och-intj"
          ]
        },
        {
          "id": "12423446",
          "text": "Och nö! Der schon wieder!",
          "translation": "О нет! Снова он!",
          "source": "Tatoeba #12423446 @Waldelfe / #12196926 @al42and (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12423446",
          "cefr_level": "A1",
          "word_slugs": [
            "och-intj"
          ]
        },
        {
          "id": "13441150",
          "text": "Och nö, ich fahre nicht. Was soll man da schon machen?",
          "translation": "Да ну, я не поеду. Что там делать-то?",
          "source": "Tatoeba #13441150 @mhr / #13441046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13441150",
          "cefr_level": "A1",
          "word_slugs": [
            "och-intj"
          ]
        },
        {
          "id": "13934456",
          "text": "\"Tom, geh noch mal kurz Pipi machen, bevor wir losfahren!\" - \"Och menno!\"",
          "translation": "\"Том, иди пописай на дорожку\". - \"Ну мам!\"",
          "source": "Tatoeba #13934456 @IAlexI / #3562354 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13934456",
          "cefr_level": "A1",
          "word_slugs": [
            "och-intj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
