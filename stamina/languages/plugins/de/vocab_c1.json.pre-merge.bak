          ]
        },
        {
          "id": "3482041",
          "text": "Bitte mache eine Kerze an.",
          "translation": "Зажги свечу, пожалуйста.",
          "source": "Tatoeba #3482041 @Zaghawa / #5196214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3482041",
          "cefr_level": "A1",
