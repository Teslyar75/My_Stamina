    {
      "slug": "unverzüglich-adj",
      "lemma": "unverzüglich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7815,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "immediate, instantaneous"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "10506579",
          "text": "Geh unverzüglich zum Arzt!",
          "translation": "Немедленно иди к врачу!",
          "source": "Tatoeba #10506579 @Pfirsichbaeumchen / #5665665 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10506579",
          "cefr_level": "A1",
          "word_slugs": [
            "unverzüglich-adj"
          ]
        },
        {
          "id": "7981903",
          "text": "Du musst mich unverzüglich anrufen.",
          "translation": "Тебе надо мне немедленно позвонить.",
          "source": "Tatoeba #7981903 @Pfirsichbaeumchen / #5776655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7981903",
          "cefr_level": "A1",
          "word_slugs": [
            "unverzüglich-adj"
          ]
        },
        {
          "id": "13804147",
          "text": "Sie müssen unverzüglich die Geiseln freilassen.",
          "translation": "Вы должны немедленно освободить заложников.",
          "source": "Tatoeba #13804147 @mhr / #13798348 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13804147",
          "cefr_level": "A1",
          "word_slugs": [
            "unverzüglich-adj"
          ]
        },
        {
          "id": "13804142",
          "text": "Die Geiseln müssen unverzüglich freigelassen werden.",
          "translation": "Заложники должны быть немедленно освобождены.",
          "source": "Tatoeba #13804142 @mhr / #13798349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13804142",
          "cefr_level": "A1",
          "word_slugs": [
            "unverzüglich-adj"
          ]
        },
        {
          "id": "11487942",
          "text": "Er verlangte, dass ich das Geld unverzüglich zurückgebe.",
          "translation": "Он потребовал, чтобы я немедленно вернул деньги.",
          "source": "Tatoeba #11487942 @Pfirsichbaeumchen / #552169 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11487942",
          "cefr_level": "A1",
          "word_slugs": [
            "unverzüglich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der unverzüglich",
        "nominative_pl": ""
      }
