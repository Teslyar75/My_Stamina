          "source": "Tatoeba #7900002 @felix63 / #7983841 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7900002",
          "cefr_level": "A1",
          "word_slugs": [
            "bluse-noun"
          ]
        },
        {
          "id": "3555547",
          "text": "Sie kaufte eine neue Bluse.",
          "translation": "Она купила новую блузку.",
          "source": "Tatoeba #3555547 @Esperantostern / #13572745 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3555547",
          "cefr_level": "A1",
          "word_slugs": [
            "bluse-noun"
          ]
        },
        {
          "id": "1295206",
          "text": "Die Bluse ist aus Baumwolle.",
          "translation": "Блузка из хлопка.",
          "source": "Tatoeba #1295206 @Esperantostern / #6608205 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1295206",
          "cefr_level": "A1",
          "word_slugs": [
            "bluse-noun"
          ]
        },
        {
          "id": "701831",
          "text": "Diese Bluse ist aus Baumwolle.",
          "translation": "Эта блузка из хлопка.",
          "source": "Tatoeba #701831 @Pfirsichbaeumchen / #439925 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/701831",
          "cefr_level": "A1",
