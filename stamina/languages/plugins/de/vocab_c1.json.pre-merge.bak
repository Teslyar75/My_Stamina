      },
      "gender": null,
      "examples": [
        {
          "id": "776593",
          "text": "Das Unwetter war auf seinem Höhepunkt.",
          "translation": "Гроза была на пике.",
          "source": "Tatoeba #776593 @User4473 / #4171337 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/776593",
          "cefr_level": "A1",
