      "gender": "n",
      "examples": [
        {
          "id": "1483465",
          "text": "Eine Pille für jede Krankheit.",
          "translation": "Пилюля от любой болезни.",
          "source": "Tatoeba #1483465 @Esperantostern / #1574736 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1483465",
          "cefr_level": "A1",
          "word_slugs": [
            "pille-noun"
          ]
        },
        {
          "id": "5238768",
          "text": "Tom muss die bittere Pille schlucken.",
          "translation": "Том должен проглотить эту горькую пилюлю.",
          "source": "Tatoeba #5238768 @Adelpa / #13881175 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5238768",
          "cefr_level": "A1",
          "word_slugs": [
            "pille-noun"
          ]
        },
        {
          "id": "5238761",
          "text": "Das ist eine bittere Pille zu schlucken.",
          "translation": "Это горькая пилюля, которую нужно проглотить.",
          "source": "Tatoeba #5238761 @Adelpa / #13881176 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5238761",
          "cefr_level": "A1",
          "word_slugs": [
            "pille-noun"
          ]
        },
        {
          "id": "7490494",
          "text": "Diese Pille enthält unter anderem Vitamin C.",
          "translation": "Эта таблетка содержит кроме всего прочего витамин С.",
          "source": "Tatoeba #7490494 @raggione / #7490723 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7490494",
          "cefr_level": "A1",
          "word_slugs": [
            "pille-noun"
          ]
        },
        {
          "id": "1775222",
          "text": "Die Wahrheit vergleicht man oft mit einer bitteren Pille.",
          "translation": "Правду часто сравнивают с горькой пилюлей.",
          "source": "Tatoeba #1775222 @al_ex_an_der / #1775220 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1775222",
