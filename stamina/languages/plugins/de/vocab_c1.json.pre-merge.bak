          "inflection of schulden:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "808183",
          "text": "Ihr schuldet mir 1.000 $.",
          "translation": "Вы должны мне тысячу долларов.",
          "source": "Tatoeba #808183 @al_ex_an_der / #5231658 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/808183",
          "cefr_level": "A1",
          "word_slugs": [
            "schuldet-verb"
          ]
        },
        {
          "id": "5064406",
          "text": "Tom schuldet Mary Geld.",
          "translation": "Том должен Мэри денег.",
          "source": "Tatoeba #5064406 @dispy / #5054347 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5064406",
          "cefr_level": "A1",
          "word_slugs": [
            "schuldet-verb"
          ]
        },
        {
          "id": "5329339",
          "text": "Ihr schuldet mir etwas.",
