      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8480,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Welpe",
          "dative singular of Welpe",
          "accusative singular of Welpe",
          "nominative plural of Welpe"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3345685",
          "text": "Was für süße Welpen!",
          "translation": "Какие милые щеночки!",
          "source": "Tatoeba #3345685 @Pfirsichbaeumchen / #3346623 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3345685",
          "cefr_level": "A1",
          "word_slugs": [
            "welpen-noun"
          ]
        },
        {
          "id": "10316186",
          "text": "Tom rettete den Welpen.",
          "translation": "Том спас щенка.",
          "source": "Tatoeba #10316186 @Pfirsichbaeumchen / #13940668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10316186",
          "cefr_level": "A1",
          "word_slugs": [
            "welpen-noun"
          ]
        },
        {
          "id": "12548127",
          "text": "Willst du diesen Welpen?",
          "translation": "Хочешь этого щенка?",
          "source": "Tatoeba #12548127 @Waldelfe / #13543161 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12548127",
          "cefr_level": "A1",
          "word_slugs": [
            "welpen-noun"
          ]
        },
        {
          "id": "12548128",
          "text": "Wollt ihr diesen Welpen?",
          "translation": "Хотите этого щенка?",
          "source": "Tatoeba #12548128 @Waldelfe / #13543162 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12548128",
          "cefr_level": "A1",
          "word_slugs": [
            "welpen-noun"
          ]
        },
        {
          "id": "12548129",
          "text": "Wollen Sie diesen Welpen?",
          "translation": "Хотите этого щенка?",
          "source": "Tatoeba #12548129 @Waldelfe / #13543162 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12548129",
          "cefr_level": "A1",
          "word_slugs": [
