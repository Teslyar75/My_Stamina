    {
      "slug": "beurteilen-verb",
      "lemma": "beurteilen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5878,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "судить"
        ],
        "en": [
          "to form an opinion on, to judge"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5665673",
          "text": "Ich kann es nicht beurteilen.",
          "translation": "Я не могу об этом судить.",
          "source": "Tatoeba #5665673 @raggione / #8273049 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5665673",
          "cefr_level": "A1",
          "word_slugs": [
            "beurteilen-verb"
          ]
        },
        {
          "id": "806410",
          "text": "Sie konnten mich nicht beurteilen.",
          "translation": "Они не могли судить меня.",
          "source": "Tatoeba #806410 @Esperantostern / #2431954 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/806410",
          "cefr_level": "A1",
          "word_slugs": [
            "beurteilen-verb"
          ]
        },
        {
          "id": "13681959",
          "text": "Es ist am einfachsten zu beurteilen.",
          "translation": "Судить легче всего.",
          "source": "Tatoeba #13681959 @carlosalberto / #7004361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13681959",
          "cefr_level": "A1",
          "word_slugs": [
            "beurteilen-verb"
          ]
        },
        {
          "id": "2943162",
          "text": "Wie beurteilen Sie die Arbeit des örtlichen Selbstwaltungssystems?",
          "translation": "Как вы оцениваете работу системы местного самоуправления?",
          "source": "Tatoeba #2943162 @al_ex_an_der / #2943161 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2943162",
          "cefr_level": "A1",
          "word_slugs": [
            "beurteilen-verb"
          ]
        },
        {
          "id": "6144407",
          "text": "Man darf einen Menschen nicht nach seiner Kleidung beurteilen.",
          "translation": "Не суди о человеке по его одежде.",
          "source": "Tatoeba #6144407 @Pfirsichbaeumchen / #6140986 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6144407",
          "cefr_level": "A1",
          "word_slugs": [
            "beurteilen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
