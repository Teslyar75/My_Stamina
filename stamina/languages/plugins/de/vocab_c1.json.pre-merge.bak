      "gender": null,
      "examples": [
        {
          "id": "13433227",
          "text": "Was für eine fantastische Idee!",
          "translation": "Какая фантастическая идея!",
          "source": "Tatoeba #13433227 @mhr / #13433217 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13433227",
          "cefr_level": "A1",
          "word_slugs": [
            "fantastische-adj"
          ]
        },
        {
          "id": "12899913",
          "text": "Lasst euch diese fantastische Gelegenheit nicht entgehen!",
          "translation": "Не упустите эту потрясающую возможность.",
          "source": "Tatoeba #12899913 @mhr / #12899856 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12899913",
          "cefr_level": "A1",
          "word_slugs": [
