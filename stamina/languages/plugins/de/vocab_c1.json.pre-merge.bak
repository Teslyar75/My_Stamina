          "cefr_level": "A1",
          "word_slugs": [
            "pfeifen-verb"
          ]
        },
        {
          "id": "7789006",
          "text": "Er kann nicht pfeifen.",
          "translation": "Он не умеет свистеть.",
          "source": "Tatoeba #7789006 @Tamy / #2339847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7789006",
