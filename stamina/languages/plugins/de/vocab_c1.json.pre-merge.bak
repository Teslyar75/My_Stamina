    {
      "slug": "herrschen-verb",
      "lemma": "herrschen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7445,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "царствовать"
        ],
        "en": [
          "to rule, to reign, to have dominion",
          "to exist, to be going on (of noticeable large-scale conditions or sentiments)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3074954",
          "text": "Im Lande herrschen Chaos und Anarchie.",
          "translation": "В стране царят хаос и анархия.",
          "source": "Tatoeba #3074954 @al_ex_an_der / #3074951 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3074954",
          "cefr_level": "A1",
          "word_slugs": [
            "herrschen-verb"
          ]
        },
        {
          "id": "2759040",
          "text": "Die Staaten blühen nur, wenn entweder Philosophen herrschen oder die Herrscher philosophieren.",
          "translation": "Государства процветают или тогда, когда господствуют философы, или тогда, когда господа философствуют.",
          "source": "Tatoeba #2759040 @Esperantostern / #2770178 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2759040",
          "cefr_level": "A1",
          "word_slugs": [
            "herrschen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
