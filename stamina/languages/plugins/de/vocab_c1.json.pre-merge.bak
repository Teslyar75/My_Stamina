    {
      "slug": "erfahre-verb",
      "lemma": "erfahre",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8563,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of erfahren:",
          "first-person singular present",
          "inflection of erfahren:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13641891",
          "text": "Ich erfahre es sowieso.",
          "translation": "Я всё равно узнаю.",
          "source": "Tatoeba #13641891 @frpzzd / #7929809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13641891",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahre-verb"
          ]
        },
        {
          "id": "12547442",
          "text": "Du weißt es nicht, also erfahre es!",
          "translation": "Не знаешь, так узнай.",
          "source": "Tatoeba #12547442 @Waldelfe / #8563839 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12547442",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahre-verb"
          ]
        },
        {
          "id": "9000449",
          "text": "Ich wollte nicht, dass Tom es erfahre.",
          "translation": "Я не хотел, чтобы Том об этом знал.",
          "source": "Tatoeba #9000449 @Pfirsichbaeumchen / #8998418 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9000449",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahre-verb"
          ]
        },
        {
          "id": "2432072",
          "text": "Mit Hilfe meiner Freunde erfahre ich eine Riesenmenge neuer und interessanter Dinge.",
          "translation": "С помощью моих друзей я узнаю очень много нового, интересного.",
          "source": "Tatoeba #2432072 @al_ex_an_der / #2432069 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2432072",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahre-verb"
          ]
        }
      ],
