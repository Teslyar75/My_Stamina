      "examples": [
        {
          "id": "1862719",
          "text": "Ist Wasser im Topf?",
          "translation": "В кастрюле есть вода?",
          "source": "Tatoeba #1862719 @Tamy / #5265937 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1862719",
          "cefr_level": "A1",
          "word_slugs": [
            "topf-noun"
          ]
        },
        {
          "id": "1718285",
          "text": "Der Topf kocht über.",
          "translation": "Кастрюля выкипает.",
          "source": "Tatoeba #1718285 @Pfirsichbaeumchen / #10650186 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1718285",
          "cefr_level": "A1",
          "word_slugs": [
            "topf-noun"
          ]
        },
        {
          "id": "925039",
          "text": "Die Suppe blubbert im Topf.",
          "translation": "Суп кипит в кастрюле.",
          "source": "Tatoeba #925039 @Esperantostern / #12454706 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/925039",
          "cefr_level": "A1",
          "word_slugs": [
            "topf-noun"
          ]
        },
        {
          "id": "10779693",
          "text": "Der Topf steht auf dem Herd.",
          "translation": "Кастрюля стоит на плите.",
          "source": "Tatoeba #10779693 @carlosalberto / #10779642 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10779693",
          "cefr_level": "A1",
          "word_slugs": [
            "topf-noun"
          ]
        },
        {
          "id": "1432991",
          "text": "Bob füllte den Topf mit Wasser.",
          "translation": "Боб налил в кастрюлю воды.",
          "source": "Tatoeba #1432991 @Manfredo / #5025954 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1432991",
          "cefr_level": "A1",
          "word_slugs": [
            "topf-noun"
          ]
        }
