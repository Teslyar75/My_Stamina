    {
      "slug": "verreist-verb",
      "lemma": "verreist",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8528,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verreisen:",
          "second-person singular/plural present",
          "inflection of verreisen:",
          "third-person singular present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8633688",
          "text": "Verreist du oft?",
          "translation": "Ты много путешествуешь?",
          "source": "Tatoeba #8633688 @Melang / #5534014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8633688",
          "cefr_level": "A1",
          "word_slugs": [
            "verreist-verb"
          ]
        },
        {
          "id": "2650339",
          "text": "Tom ist dienstlich verreist.",
          "translation": "Том уехал по делам службы.",
          "source": "Tatoeba #2650339 @Olya / #2650340 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650339",
          "cefr_level": "A1",
          "word_slugs": [
            "verreist-verb"
          ]
        },
        {
          "id": "7468176",
          "text": "Johanna verreist seltener als Elke.",
          "translation": "Ханна путешествует реже Алисы.",
          "source": "Tatoeba #7468176 @Pfirsichbaeumchen / #7468211 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7468176",
          "cefr_level": "A1",
          "word_slugs": [
            "verreist-verb"
          ]
        },
        {
          "id": "2976631",
          "text": "Ich weiß, dass Tom gern verreist.",
          "translation": "Я знаю, что Том любит путешествовать.",
          "source": "Tatoeba #2976631 @Pfirsichbaeumchen / #2965522 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2976631",
          "cefr_level": "A1",
          "word_slugs": [
            "verreist-verb"
          ]
        },
        {
          "id": "12156659",
          "text": "Tom verreist oft mit seinem Hund.",
          "translation": "Том часто путешествует вместе со своей собакой.",
          "source": "Tatoeba #12156659 @Augustus / #12156660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12156659",
          "cefr_level": "A1",
          "word_slugs": [
            "verreist-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
