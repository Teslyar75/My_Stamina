      "gender": null,
      "examples": [
        {
          "id": "2425926",
          "text": "Versprichst du es?",
          "translation": "Обещаешь?",
          "source": "Tatoeba #2425926 @bionicboy / #2742202 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2425926",
          "cefr_level": "A1",
