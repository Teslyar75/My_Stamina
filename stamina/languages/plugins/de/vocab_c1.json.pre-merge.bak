    {
      "slug": "lungen-noun",
      "lemma": "Lungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7244,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Lunge"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4423495",
          "text": "Die Amphibien haben Lungen.",
          "translation": "У амфибий есть лёгкие.",
          "source": "Tatoeba #4423495 @al_ex_an_der / #4423505 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4423495",
          "cefr_level": "A1",
          "word_slugs": [
            "lungen-noun"
          ]
        },
        {
          "id": "10041188",
          "text": "Wälder sind die Lungen der Erde.",
          "translation": "Леса — это лёгкие Земли.",
          "source": "Tatoeba #10041188 @sakslane / #10038763 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10041188",
          "cefr_level": "A1",
          "word_slugs": [
            "lungen-noun"
          ]
        },
        {
          "id": "6535956",
          "text": "Die eisige Luft brannte in seinen Lungen.",
          "translation": "Ледяной воздух обжигал его легкие.",
          "source": "Tatoeba #6535956 @brauchinet / #6548629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6535956",
          "cefr_level": "A1",
          "word_slugs": [
            "lungen-noun"
          ]
        },
        {
          "id": "6535957",
          "text": "Die eisige Luft brannte ihr in den Lungen.",
          "translation": "Ледяной воздух обжигал её легкие.",
          "source": "Tatoeba #6535957 @brauchinet / #6548630 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6535957",
          "cefr_level": "A1",
          "word_slugs": [
            "lungen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
