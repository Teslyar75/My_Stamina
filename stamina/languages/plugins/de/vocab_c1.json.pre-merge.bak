    {
      "slug": "solches-pron",
      "lemma": "solches",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7425,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of solch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13785306",
          "text": "Mir gefällt solches Wetter.",
          "translation": "Мне нравится такая погода.",
          "source": "Tatoeba #13785306 @Rovo / #8827199 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13785306",
          "cefr_level": "A1",
          "word_slugs": [
            "solches-pron"
          ]
        },
        {
          "id": "13604619",
          "text": "Niemand hat ein solches Ergebnis erwartet.",
          "translation": "Никто не ожидал такого результата.",
          "source": "Tatoeba #13604619 @mhr / #13604061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13604619",
          "cefr_level": "A1",
          "word_slugs": [
            "solches-pron"
          ]
        },
        {
          "id": "13539247",
          "text": "Im Tatarischen gibt es kein solches Wort.",
          "translation": "В татарском языке нет такого слова.",
          "source": "Tatoeba #13539247 @mhr / #13539251 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13539247",
          "cefr_level": "A1",
          "word_slugs": [
            "solches-pron"
          ]
        },
        {
          "id": "2931781",
          "text": "Tom will ein solches Risiko nicht eingehen.",
          "translation": "Том не хочет так рисковать.",
          "source": "Tatoeba #2931781 @Pfirsichbaeumchen / #2561413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2931781",
          "cefr_level": "A1",
          "word_slugs": [
            "solches-pron"
          ]
        },
        {
          "id": "10017907",
          "text": "Lieber sterben als ein solches Leben führen.",
          "translation": "Лучше умереть, чем жить такой жизнью.",
          "source": "Tatoeba #10017907 @Pfirsichbaeumchen / #2816584 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10017907",
          "cefr_level": "A1",
          "word_slugs": [
            "solches-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
