    {
      "slug": "ausrede-noun",
      "lemma": "Ausrede",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5379,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "отговорка"
        ],
        "en": [
          "excuse"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1229138",
          "text": "Das ist eine faule Ausrede!",
          "translation": "Это отговорка!",
          "source": "Tatoeba #1229138 @Esperantostern / #4936268 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1229138",
          "cefr_level": "A1",
          "word_slugs": [
            "ausrede-noun"
          ]
        },
        {
          "id": "7323293",
          "text": "Immer hast du eine Ausrede!",
          "translation": "У тебя всегда есть отговорка!",
          "source": "Tatoeba #7323293 @brauchinet / #7323633 @Rotor_AU (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7323293",
          "cefr_level": "A1",
          "word_slugs": [
            "ausrede-noun"
          ]
        },
        {
          "id": "3246309",
          "text": "Komme mir nicht mit so einer Ausrede!",
          "translation": "Не приходи ко мне с такой отговоркой!",
          "source": "Tatoeba #3246309 @raggione / #7470126 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3246309",
          "cefr_level": "A1",
          "word_slugs": [
            "ausrede-noun"
          ]
        },
        {
          "id": "1816407",
