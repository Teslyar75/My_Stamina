          "cefr_level": "A1",
          "word_slugs": [
            "ankommt-verb"
          ]
        },
        {
          "id": "3290157",
          "text": "Tom wartet darauf, dass Maria ankommt.",
          "translation": "Том ждёт, когда придёт Мэри.",
