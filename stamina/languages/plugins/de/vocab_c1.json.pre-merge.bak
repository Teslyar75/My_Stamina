          "careful, meticulous, thorough, diligent"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1314939",
          "text": "Er ist sehr sorgfältig.",
          "translation": "Он очень осторожен.",
          "source": "Tatoeba #1314939 @Zaghawa / #2014213 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1314939",
          "cefr_level": "A1",
          "word_slugs": [
            "sorgfältig-adj"
          ]
        },
        {
          "id": "457101",
          "text": "Er analysierte die Situation sorgfältig.",
          "translation": "Он тщательно проанализировал ситуацию.",
          "source": "Tatoeba #457101 @xtofu80 / #4936280 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/457101",
          "cefr_level": "A1",
          "word_slugs": [
            "sorgfältig-adj"
          ]
        },
        {
          "id": "392387",
          "text": "Der Putsch wurde sorgfältig durchgeführt.",
          "translation": "Переворот был выполнен тщательно.",
          "source": "Tatoeba #392387 @xtofu80 / #4936279 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/392387",
          "cefr_level": "A1",
          "word_slugs": [
            "sorgfältig-adj"
          ]
        },
        {
          "id": "6207507",
          "text": "Der Koch las sorgfältig das Rezept.",
          "translation": "Повар внимательно прочитал рецепт.",
          "source": "Tatoeba #6207507 @Pfirsichbaeumchen / #5780977 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6207507",
          "cefr_level": "A1",
          "word_slugs": [
            "sorgfältig-adj"
          ]
        },
        {
          "id": "3008382",
          "text": "Er hat den Angriff sorgfältig geplant.",
          "translation": "Он тщательно спланировал нападение.",
          "source": "Tatoeba #3008382 @Pfirsichbaeumchen / #3008383 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3008382",
          "cefr_level": "A1",
          "word_slugs": [
            "sorgfältig-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
