    {
      "slug": "medaille-noun",
      "lemma": "Medaille",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9131,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "medal"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7898354",
          "text": "Er verdient eine Medaille.",
          "translation": "Он заслуживает медали.",
          "source": "Tatoeba #7898354 @raggione / #7898355 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7898354",
          "cefr_level": "A1",
          "word_slugs": [
            "medaille-noun"
          ]
        },
        {
          "id": "772285",
          "text": "Jede Medaille hat zwei Seiten.",
          "translation": "У каждой медали две стороны.",
          "source": "Tatoeba #772285 @Esperantostern / #650860 @salikh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/772285",
          "cefr_level": "A1",
          "word_slugs": [
            "medaille-noun"
          ]
        },
        {
          "id": "1913526",
          "text": "Das ist die Kehrseite der Medaille.",
          "translation": "Это обратная сторона медали.",
          "source": "Tatoeba #1913526 @Tamy / #8174820 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1913526",
          "cefr_level": "A1",
          "word_slugs": [
            "medaille-noun"
          ]
        },
        {
          "id": "2299604",
          "text": "Jede Medaille hat auch eine Kehrseite.",
          "translation": "У всякой медали есть обратная сторона.",
          "source": "Tatoeba #2299604 @Pfirsichbaeumchen / #2285349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2299604",
          "cefr_level": "A1",
          "word_slugs": [
            "medaille-noun"
          ]
        },
        {
          "id": "1775219",
          "text": "Doch die Medaille hat noch eine zweite Seite.",
          "translation": "Но есть и другая сторона медали.",
          "source": "Tatoeba #1775219 @al_ex_an_der / #1775217 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1775219",
          "cefr_level": "A1",
          "word_slugs": [
            "medaille-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
