    {
      "slug": "ausgegeben-verb",
      "lemma": "ausgegeben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5473,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of ausgeben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4193288",
          "text": "Ich habe nichts ausgegeben.",
          "translation": "Я ничего не тратил.",
          "source": "Tatoeba #4193288 @Esperantostern / #4195639 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4193288",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgegeben-verb"
          ]
        },
        {
          "id": "11881378",
          "text": "Wie viel hast du ausgegeben?",
          "translation": "Сколько ты потратил?",
          "source": "Tatoeba #11881378 @Naina / #13648231 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11881378",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgegeben-verb"
          ]
        },
        {
          "id": "11881381",
          "text": "Wie viel habt ihr ausgegeben?",
          "translation": "Сколько вы потратили?",
          "source": "Tatoeba #11881381 @Naina / #13648232 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11881381",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgegeben-verb"
          ]
        },
        {
          "id": "5713393",
          "text": "Ich habe viel Geld ausgegeben.",
          "translation": "Я потратил много денег.",
          "source": "Tatoeba #5713393 @raggione / #7519324 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5713393",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgegeben-verb"
          ]
        },
        {
          "id": "8431508",
          "text": "Wie viel haben wir ausgegeben?",
          "translation": "Сколько мы потратили?",
          "source": "Tatoeba #8431508 @Luiaard / #7965726 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8431508",
