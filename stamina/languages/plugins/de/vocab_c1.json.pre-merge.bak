    {
      "slug": "braten-verb",
      "lemma": "braten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7121,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to pan-fry",
          "to roast; to grill; to broil"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6800391",
          "text": "Ich werde Fleisch braten.",
          "translation": "Я буду жарить мясо.",
          "source": "Tatoeba #6800391 @manese / #6805660 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6800391",
          "cefr_level": "A1",
          "word_slugs": [
            "braten-verb"
          ]
        },
        {
          "id": "5912736",
          "text": "Wir kochen Suppe und braten Fisch.",
          "translation": "Мы варим суп и жарим рыбу.",
          "source": "Tatoeba #5912736 @Pfirsichbaeumchen / #5767863 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5912736",
          "cefr_level": "A1",
          "word_slugs": [
            "braten-verb"
          ]
        },
        {
          "id": "4892878",
          "text": "Sie werden ein Schwein für das Fest braten.",
          "translation": "Они зажарят на праздник свинью.",
          "source": "Tatoeba #4892878 @Esperantostern / #5494847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4892878",
          "cefr_level": "A1",
          "word_slugs": [
            "braten-verb"
          ]
        }
      ],
      "tags": [
