    {
      "slug": "abgebrochen-verb",
      "lemma": "abgebrochen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6837,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of abbrechen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1589845",
          "text": "Der Türgriff ist abgebrochen.",
          "translation": "Дверная ручка сломана.",
          "source": "Tatoeba #1589845 @Grim_fandango / #2087278 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1589845",
          "cefr_level": "A1",
          "word_slugs": [
            "abgebrochen-verb"
          ]
        },
        {
          "id": "1585056",
          "text": "Mir ist der Nagel abgebrochen.",
          "translation": "У меня отломился ноготь.",
          "source": "Tatoeba #1585056 @Grim_fandango / #1591883 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1585056",
          "cefr_level": "A1",
          "word_slugs": [
            "abgebrochen-verb"
          ]
        },
        {
          "id": "9258321",
          "text": "Wer hat diese Rose abgebrochen?",
