    {
      "slug": "heldin-noun",
      "lemma": "Heldin",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9677,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "heroine"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6165301",
          "text": "Sie war eine wahre Heldin.",
          "translation": "Она была настоящей героиней.",
          "source": "Tatoeba #6165301 @Pfirsichbaeumchen / #4061593 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6165301",
          "cefr_level": "A1",
          "word_slugs": [
            "heldin-noun"
          ]
        },
        {
          "id": "449636",
          "text": "Die Heldin des Romans begang Suizid.",
          "translation": "Героиня романа покончила жизнь самоубийством.",
          "source": "Tatoeba #449636 @al_ex_an_der / #2870086 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/449636",
          "cefr_level": "A1",
          "word_slugs": [
            "heldin-noun"
          ]
        },
        {
          "id": "664914",
          "text": "Der Roman endet mit dem Tod der Heldin.",
          "translation": "Роман заканчивается смертью героини.",
          "source": "Tatoeba #664914 @Pfirsichbaeumchen / #1384911 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/664914",
          "cefr_level": "A1",
          "word_slugs": [
            "heldin-noun"
          ]
        },
        {
          "id": "11084581",
          "text": "Ich komme mir wie die Heldin in einem Liebesroman vor.",
          "translation": "Я чувствую себя героиней любовного романа.",
          "source": "Tatoeba #11084581 @Pfirsichbaeumchen / #3539867 @alexdiment (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11084581",
          "cefr_level": "A1",
          "word_slugs": [
            "heldin-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Heldin",
        "nominative_pl": ""
      }
