    {
      "slug": "flora-noun",
      "lemma": "Flora",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8809,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "растительный мир",
          "растительность"
        ],
        "en": [
          "flora (plants as a group; microorganisms)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5275350",
          "text": "Die einzigartige Flora und Fauna der Insel muss geschützt werden.",
          "translation": "Необходимо защитить уникальную флору и фауну острова.",
          "source": "Tatoeba #5275350 @Pfirsichbaeumchen / #5274419 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5275350",
          "cefr_level": "A1",
          "word_slugs": [
            "flora-noun"
          ]
        },
        {
          "id": "13856291",
          "text": "Ich habe viel über die Flora und die Fauna des Nationalparks gelernt.",
          "translation": "Я многое узнал о флоре и фауне национального парка.",
          "source": "Tatoeba #13856291 @Ioan_Cristian / #13856756 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13856291",
          "cefr_level": "A1",
          "word_slugs": [
            "flora-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
