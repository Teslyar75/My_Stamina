    {
      "slug": "spannend-verb",
      "lemma": "spannend",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5865,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "present participle of spannen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "366403",
          "text": "Ich fand das Spiel sehr spannend.",
          "translation": "По-моему, эта игра очень увлекательная.",
          "source": "Tatoeba #366403 @Wolf / #599803 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/366403",
          "cefr_level": "A1",
          "word_slugs": [
            "spannend-verb"
          ]
        },
        {
          "id": "1104307",
          "text": "Bücher zu lesen ist sehr spannend.",
          "translation": "Читать книги очень увлекательно.",
          "source": "Tatoeba #1104307 @Haehnchenpaella / #13945089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1104307",
          "cefr_level": "A1",
          "word_slugs": [
            "spannend-verb"
          ]
        },
        {
          "id": "12973113",
          "text": "Es wäre spannend, eure Meinung zu erfahren.",
          "translation": "Любопытно было бы узнать ваше мнение.",
          "source": "Tatoeba #12973113 @mhr / #12973053 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12973113",
          "cefr_level": "A1",
          "word_slugs": [
            "spannend-verb"
          ]
        },
        {
          "id": "12973102",
          "text": "Es wäre spannend, deine Meinung zu erfahren.",
          "translation": "Любопытно было бы узнать твоё мнение.",
          "source": "Tatoeba #12973102 @mhr / #12973055 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12973102",
          "cefr_level": "A1",
          "word_slugs": [
            "spannend-verb"
          ]
        },
        {
          "id": "2590799",
          "text": "Wir wollen den Unterricht effektiv, interessant und spannend gestalten.",
          "translation": "Мы хотим сделать обучение эффективным, интересным и увлекательным.",
          "source": "Tatoeba #2590799 @al_ex_an_der / #2590798 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2590799",
          "cefr_level": "A1",
          "word_slugs": [
            "spannend-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
