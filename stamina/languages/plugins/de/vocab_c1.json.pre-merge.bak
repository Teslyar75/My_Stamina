    {
      "slug": "schuppen-noun",
      "lemma": "Schuppen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5318,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сарай"
        ],
        "en": [
          "plural of Schuppe"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "14086920",
          "text": "Brennholz liegt noch im Schuppen.",
          "translation": "Дрова ещё в сарае есть.",
          "source": "Tatoeba #14086920 @mhr / #14086931 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14086920",
          "cefr_level": "A1",
          "word_slugs": [
            "schuppen-noun"
          ]
        },
        {
          "id": "13935743",
          "text": "Die Schuppen dieser Schlange sind schwarz.",
          "translation": "У этой змеи чёрная чешуя.",
          "source": "Tatoeba #13935743 @Ioan_Cristian / #13957445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13935743",
          "cefr_level": "A1",
          "word_slugs": [
            "schuppen-noun"
          ]
        },
        {
          "id": "14086919",
          "text": "Brennholz kannst du dir aus dem Schuppen holen.",
          "translation": "Дрова можешь принести из сарая.",
          "source": "Tatoeba #14086919 @mhr / #14086926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14086919",
          "cefr_level": "A1",
          "word_slugs": [
            "schuppen-noun"
          ]
        },
        {
          "id": "4423525",
          "text": "Die Körper der Reptilien sind mit Schuppen bedeckt.",
          "translation": "Тело рептилий покрыто чешуёй.",
          "source": "Tatoeba #4423525 @al_ex_an_der / #4423567 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4423525",
          "cefr_level": "A1",
          "word_slugs": [
            "schuppen-noun"
          ]
        },
        {
          "id": "605482",
          "text": "Da fiel es mir wie Schuppen von den Augen.",
          "translation": "И тогда у меня как будто завеса с глаз спала.",
          "source": "Tatoeba #605482 @virgil / #1993153 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/605482",
          "cefr_level": "A1",
          "word_slugs": [
            "schuppen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
