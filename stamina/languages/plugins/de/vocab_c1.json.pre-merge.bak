    {
      "slug": "binde-noun",
      "lemma": "Binde",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8569,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "бинт"
        ],
        "en": [
          "bandage",
          "ellipsis of Damenbinde; sanitary napkin, menstrual pad, maxi pad",
          "tie"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1371915",
          "text": "Binde dir die Schuhe!",
          "translation": "Завяжи шнурки.",
          "source": "Tatoeba #1371915 @NadineWohlfahrt / #1862790 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1371915",
          "cefr_level": "A1",
          "word_slugs": [
            "binde-noun"
          ]
        },
        {
          "id": "7728737",
          "text": "Binde dir den Schuh gut zu, sonst stolperst du.",
          "translation": "Завяжи шнурки как следует, а то споткнёшься.",
          "source": "Tatoeba #7728737 @brauchinet / #13524102 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7728737",
          "cefr_level": "A1",
          "word_slugs": [
            "binde-noun"
          ]
        },
        {
          "id": "13524404",
          "text": "Binde dir die Schnürsenkel ordentlich zu, sonst stolperst du.",
          "translation": "Завяжи шнурки как следует, а то споткнёшься.",
          "source": "Tatoeba #13524404 @mhr / #13524102 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13524404",
          "cefr_level": "A1",
          "word_slugs": [
            "binde-noun"
          ]
        }
      ],
      "tags": [
