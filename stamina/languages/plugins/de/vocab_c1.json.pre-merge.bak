      "examples": [
        {
          "id": "449734",
          "text": "Niemand bemerkte ihre Abwesenheit.",
          "translation": "Никто не заметил ее отсутствия.",
          "source": "Tatoeba #449734 @Espi / #1949702 @Yanka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/449734",
          "cefr_level": "A1",
          "word_slugs": [
