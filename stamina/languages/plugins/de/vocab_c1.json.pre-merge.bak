          "strong/mixed nominative/accusative neuter singular of froh"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "138825",
          "text": "Frohes neues Jahr!",
          "translation": "С Новым годом!",
          "source": "Tatoeba #138825 @MUIRIEL / #437406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/138825",
          "cefr_level": "A1",
          "word_slugs": [
            "frohes-adj"
          ]
        },
        {
          "id": "13678459",
          "text": "Frohes neues Jahr, Tatoeba!",
          "translation": "С Новым годом, Татоэба!",
          "source": "Tatoeba #13678459 @mhr / #13678006 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13678459",
          "cefr_level": "A1",
          "word_slugs": [
            "frohes-adj"
          ]
        },
        {
          "id": "2096631",
          "text": "Ich wünsche Ihnen ein frohes neues Jahr!",
          "translation": "Желаю вам счастливого Нового года!",
          "source": "Tatoeba #2096631 @Tamy / #1719455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2096631",
          "cefr_level": "A1",
          "word_slugs": [
            "frohes-adj"
          ]
        },
        {
          "id": "6805115",
          "text": "Ich wünsche allen meinen Freunden ein frohes und gesegnetes Osterfest.",
          "translation": "Желаю всем моим друзьям радостной и благословенной Пасхи.",
          "source": "Tatoeba #6805115 @ruth_tatoeba / #6805627 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6805115",
          "cefr_level": "A1",
          "word_slugs": [
            "frohes-adj"
          ]
        }
      ],
      "tags": [
