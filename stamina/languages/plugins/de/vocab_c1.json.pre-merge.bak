          ]
        },
        {
          "id": "1286131",
          "text": "Schalt den Fernseher aus.",
          "translation": "Выключи телевизор.",
          "source": "Tatoeba #1286131 @enteka / #412760 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1286131",
          "cefr_level": "A1",
          "word_slugs": [
            "schalt-verb"
          ]
        },
        {
          "id": "5054601",
          "text": "Sie schalt ihn seiner Verspätung wegen.",
          "translation": "Она отчитала его за опоздание.",
          "source": "Tatoeba #5054601 @al_ex_an_der / #2371203 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5054601",
          "cefr_level": "A1",
          "word_slugs": [
            "schalt-verb"
          ]
        },
        {
          "id": "13910451",
          "text": "Schalt den Fernseher ein! Ich will die Nachrichten schauen.",
          "translation": "Включи телевизор! Я хочу посмотреть новости.",
          "source": "Tatoeba #13910451 @Ioan_Cristian / #13910471 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13910451",
          "cefr_level": "A1",
          "word_slugs": [
            "schalt-verb"
          ]
        }
