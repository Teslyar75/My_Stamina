    {
      "slug": "eigenschaften-noun",
      "lemma": "Eigenschaften",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8051,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Eigenschaft"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10095038",
          "text": "Sie hat viele gute Eigenschaften.",
          "translation": "У неё много хороших качеств.",
          "source": "Tatoeba #10095038 @wolfgangth / #5269999 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10095038",
          "cefr_level": "A1",
          "word_slugs": [
            "eigenschaften-noun"
          ]
        },
        {
          "id": "12695783",
          "text": "Die Mango hat viele gesundheitsfördernde Eigenschaften.",
          "translation": "Манго имеет множество полезных свойств.",
          "source": "Tatoeba #12695783 @mhr / #12695303 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12695783",
          "cefr_level": "A1",
          "word_slugs": [
            "eigenschaften-noun"
          ]
        },
        {
          "id": "14017275",
          "text": "Das ist eine der Eigenschaften des Gehirns.",
          "translation": "Это одно из свойств мозга.",
          "source": "Tatoeba #14017275 @mhr / #14017271 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14017275",
          "cefr_level": "A1",
          "word_slugs": [
            "eigenschaften-noun"
          ]
        },
        {
          "id": "13425400",
          "text": "Welche deiner Eigenschaften würdest du gerne loswerden?",
          "translation": "От каких качеств в себе ты хотел бы избавиться?",
          "source": "Tatoeba #13425400 @mhr / #13423759 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13425400",
          "cefr_level": "A1",
          "word_slugs": [
            "eigenschaften-noun"
          ]
        },
        {
          "id": "12695782",
          "text": "Die Mango verfügt über eine Vielzahl gesundheitsfördernder Eigenschaften.",
          "translation": "Манго имеет множество полезных свойств.",
          "source": "Tatoeba #12695782 @mhr / #12695303 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12695782",
          "cefr_level": "A1",
          "word_slugs": [
            "eigenschaften-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
