          "nominative/accusative/genitive plural of Gerät"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13934467",
          "text": "Teure Geräte dürfen nicht stillstehen.",
          "translation": "Дорогостоящее оборудование не должно простаивать.",
          "source": "Tatoeba #13934467 @IAlexI / #12239798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13934467",
          "cefr_level": "A1",
          "word_slugs": [
            "geräte-noun"
          ]
        },
        {
          "id": "1983693",
          "text": "Diese Geräte sind leider sehr störanfällig.",
          "translation": "К сожалению, эти приборы очень ненадёжны.",
          "source": "Tatoeba #1983693 @Alois / #6916054 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1983693",
          "cefr_level": "A1",
          "word_slugs": [
            "geräte-noun"
          ]
        },
        {
          "id": "2625417",
          "text": "Bitte schalten Sie Ihre elektronischen Geräte aus.",
          "translation": "Пожалуйста, выключите ваши электронные приборы.",
          "source": "Tatoeba #2625417 @Olya / #2625411 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2625417",
          "cefr_level": "A1",
          "word_slugs": [
            "geräte-noun"
          ]
        },
        {
          "id": "13903169",
          "text": "Solche Geräte werden schon seit langem nicht mehr benutzt.",
          "translation": "Такие приборы давно не используют.",
          "source": "Tatoeba #13903169 @Waldelfe / #6638699 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13903169",
          "cefr_level": "A1",
          "word_slugs": [
            "geräte-noun"
          ]
        },
        {
          "id": "2503203",
          "text": "An den Wänden sehe ich Geräte, deren Bestimmung mir unbekannt ist.",
          "translation": "На стенах я вижу приборы, назначение которых мне неизвестно.",
          "source": "Tatoeba #2503203 @al_ex_an_der / #2503204 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2503203",
          "cefr_level": "A1",
          "word_slugs": [
            "geräte-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
