          "agent noun of hören",
          "receiver (radio/TV/telephone)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1675940",
          "text": "Sie nahm den Hörer ab.",
          "translation": "Она сняла трубку.",
          "source": "Tatoeba #1675940 @Pfirsichbaeumchen / #4512691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1675940",
          "cefr_level": "A1",
          "word_slugs": [
            "hörer-noun"
          ]
        },
        {
          "id": "14067101",
          "text": "Der Anrufer legte den Hörer auf.",
          "translation": "Звонивший повесил трубку.",
          "source": "Tatoeba #14067101 @mhr / #14066926 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067101",
          "cefr_level": "A1",
          "word_slugs": [
            "hörer-noun"
          ]
        },
        {
          "id": "13124151",
          "text": "Leg den Hörer auf die Telefongabel!",
          "translation": "Клади трубку!",
          "source": "Tatoeba #13124151 @Biderl / #13124171 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13124151",
          "cefr_level": "A1",
          "word_slugs": [
            "hörer-noun"
          ]
        },
        {
          "id": "2289103",
          "text": "Wehe, du legst jetzt den Hörer auf.",
          "translation": "Не вздумай положить трубку.",
          "source": "Tatoeba #2289103 @mrtaistoi / #10123625 @briefly (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2289103",
          "cefr_level": "A1",
          "word_slugs": [
            "hörer-noun"
          ]
        },
        {
          "id": "10477827",
          "text": "Er knallte den Hörer auf die Gabel.",
          "translation": "Он бросил трубку.",
          "source": "Tatoeba #10477827 @Pfirsichbaeumchen / #10477713 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10477827",
          "cefr_level": "A1",
          "word_slugs": [
            "hörer-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
