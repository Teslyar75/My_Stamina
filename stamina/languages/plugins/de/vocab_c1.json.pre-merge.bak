      "gender": null,
      "examples": [
        {
          "id": "349821",
          "text": "Judy hat mich angeschaut.",
          "translation": "Джуди смотрела на меня.",
          "source": "Tatoeba #349821 @human600 / #794817 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/349821",
