    {
      "slug": "zugleich-adv",
      "lemma": "zugleich",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8131,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "одновременно"
        ],
        "en": [
          "at the same time, simultaneously"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2134108",
          "text": "Er singt und arbeitet zugleich.",
          "translation": "Он поет и работает одновременно.",
          "source": "Tatoeba #2134108 @al_ex_an_der / #5428387 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2134108",
          "cefr_level": "A1",
          "word_slugs": [
            "zugleich-adv"
          ]
        },
        {
          "id": "5428372",
          "text": "Er liest und schreibt zugleich.",
          "translation": "Он читает и пишет одновременно.",
          "source": "Tatoeba #5428372 @nina99nv / #5428373 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5428372",
          "cefr_level": "A1",
          "word_slugs": [
            "zugleich-adv"
          ]
        },
        {
          "id": "662201",
          "text": "Sie lachten und weinten zugleich.",
          "translation": "Они смеялись и плакали одновременно.",
          "source": "Tatoeba #662201 @stefz / #5428379 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/662201",
          "cefr_level": "A1",
          "word_slugs": [
            "zugleich-adv"
          ]
        },
        {
          "id": "10967502",
          "text": "Ich lerne zwei Sprachen zugleich.",
          "translation": "Я учу два языка одновременно.",
          "source": "Tatoeba #10967502 @p0wcr / #10968494 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967502",
          "cefr_level": "A1",
          "word_slugs": [
            "zugleich-adv"
          ]
        },
        {
          "id": "1294930",
          "text": "Man kann nicht alles zugleich haben.",
          "translation": "Нельзя иметь всё и сразу.",
          "source": "Tatoeba #1294930 @enteka / #13617957 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1294930",
          "cefr_level": "A1",
          "word_slugs": [
            "zugleich-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
