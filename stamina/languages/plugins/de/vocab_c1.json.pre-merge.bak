    {
      "slug": "weggeworfen-verb",
      "lemma": "weggeworfen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7193,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of wegwerfen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13933824",
          "text": "Tom hat nie etwas weggeworfen.",
          "translation": "Том никогда ничего не выбрасывал.",
          "source": "Tatoeba #13933824 @mhr / #13933658 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13933824",
          "cefr_level": "A1",
          "word_slugs": [
            "weggeworfen-verb"
          ]
        },
        {
          "id": "2494063",
          "text": "Ich habe meine Schuhe weggeworfen.",
          "translation": "Я выбросил свои ботинки.",
          "source": "Tatoeba #2494063 @Pfirsichbaeumchen / #8449630 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2494063",
          "cefr_level": "A1",
          "word_slugs": [
            "weggeworfen-verb"
          ]
        },
        {
          "id": "10167167",
          "text": "Der Käse musste weggeworfen werden.",
          "translation": "Сыр пришлось выбросить.",
          "source": "Tatoeba #10167167 @Pfirsichbaeumchen / #7032980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10167167",
          "cefr_level": "A1",
          "word_slugs": [
            "weggeworfen-verb"
          ]
        },
        {
          "id": "3253596",
          "text": "Er hat viele alte Briefe weggeworfen.",
          "translation": "Он выбросил много старых писем.",
          "source": "Tatoeba #3253596 @Pfirsichbaeumchen / #3253456 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3253596",
          "cefr_level": "A1",
          "word_slugs": [
            "weggeworfen-verb"
          ]
        },
        {
          "id": "12029216",
          "text": "Sie haben den Sack nicht weggeworfen.",
          "translation": "Они не выбросили мешок.",
          "source": "Tatoeba #12029216 @Rovo / #12028950 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12029216",
          "cefr_level": "A1",
          "word_slugs": [
            "weggeworfen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
