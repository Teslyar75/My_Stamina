    {
      "slug": "automatisch-adj",
      "lemma": "automatisch",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7700,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "машинальный",
          "автоматический"
        ],
        "en": [
          "automatic"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "922818",
          "text": "Er lügt automatisch.",
          "translation": "Он врёт на автомате.",
          "source": "Tatoeba #922818 @Espi / #13459941 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/922818",
          "cefr_level": "A1",
          "word_slugs": [
            "automatisch-adj"
          ]
        },
        {
          "id": "2436338",
          "text": "Ich tat alles automatisch.",
          "translation": "Я делала всё на автомате.",
          "source": "Tatoeba #2436338 @al_ex_an_der / #2436335 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2436338",
          "cefr_level": "A1",
          "word_slugs": [
            "automatisch-adj"
          ]
        },
        {
          "id": "363282",
          "text": "Die Tür schließt automatisch.",
          "translation": "Дверь закрывается автоматически.",
          "source": "Tatoeba #363282 @Wolf / #1877322 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/363282",
          "cefr_level": "A1",
          "word_slugs": [
            "automatisch-adj"
          ]
        },
        {
          "id": "13079308",
          "text": "Dieser Vorgang ist automatisch.",
          "translation": "Этот процесс автоматический.",
          "source": "Tatoeba #13079308 @mhr / #13078451 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13079308",
          "cefr_level": "A1",
          "word_slugs": [
            "automatisch-adj"
          ]
        },
        {
          "id": "5384059",
          "text": "Die Türen schließen automatisch.",
          "translation": "Двери закрываются автоматически.",
          "source": "Tatoeba #5384059 @nina99nv / #5209311 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5384059",
          "cefr_level": "A1",
          "word_slugs": [
            "automatisch-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
