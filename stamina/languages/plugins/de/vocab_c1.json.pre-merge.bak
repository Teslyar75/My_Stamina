    {
      "slug": "oper-noun",
      "lemma": "Oper",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5603,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "opera (theatrical work, combining drama, music, song and sometimes dance)",
          "opera house, opera (theatre, or similar building, primarily used for staging opera)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8634463",
          "text": "Magst du die Oper?",
          "translation": "Ты любишь оперу?",
          "source": "Tatoeba #8634463 @Melang / #5595835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634463",
          "cefr_level": "A1",
          "word_slugs": [
            "oper-noun"
          ]
        },
        {
          "id": "12629071",
          "text": "Hat dir die Oper gefallen?",
          "translation": "Тебе понравилась опера?",
          "source": "Tatoeba #12629071 @Waldelfe / #12629089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12629071",
          "cefr_level": "A1",
          "word_slugs": [
            "oper-noun"
          ]
        },
        {
          "id": "12629073",
          "text": "Hat euch die Oper gefallen?",
