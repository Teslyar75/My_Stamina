      "gender": null,
      "examples": [
        {
          "id": "944558",
          "text": "Äpfel wachsen auf Bäumen.",
          "translation": "Яблоки растут на деревьях.",
          "source": "Tatoeba #944558 @mayok / #3675837 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/944558",
          "cefr_level": "A1",
          "word_slugs": [
            "bäumen-noun"
          ]
        },
        {
          "id": "6483167",
          "text": "Äpfel fallen von den Bäumen.",
          "translation": "Яблоки падают с деревьев.",
          "source": "Tatoeba #6483167 @Pfirsichbaeumchen / #5847414 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6483167",
          "cefr_level": "A1",
          "word_slugs": [
            "bäumen-noun"
          ]
        },
        {
          "id": "1694854",
          "text": "Geld wächst nicht auf Bäumen.",
          "translation": "Деньги не растут на деревьях.",
          "source": "Tatoeba #1694854 @Pfirsichbaeumchen / #1039781 @Vixen96 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1694854",
          "cefr_level": "A1",
          "word_slugs": [
            "bäumen-noun"
          ]
        },
        {
          "id": "4660459",
          "text": "Vögel zwitschern auf den Bäumen.",
          "translation": "На деревьях щебечут птицы.",
          "source": "Tatoeba #4660459 @tarsier / #11840269 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4660459",
          "cefr_level": "A1",
          "word_slugs": [
            "bäumen-noun"
          ]
        },
        {
          "id": "368648",
          "text": "Der Teich war von Bäumen umgeben.",
          "translation": "Пруд был окружён деревьями.",
          "source": "Tatoeba #368648 @xtofu80 / #538242 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/368648",
          "cefr_level": "A1",
          "word_slugs": [
            "bäumen-noun"
          ]
        }
