    {
      "slug": "demselben-pron",
      "lemma": "demselben",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5980,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative masculine of derselbe",
          "dative neuter of derselbe"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1699271",
          "text": "Sie kommen aus demselben Dorf.",
          "translation": "Они из одной деревни.",
          "source": "Tatoeba #1699271 @Pfirsichbaeumchen / #8547804 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1699271",
          "cefr_level": "A1",
          "word_slugs": [
            "demselben-pron"
          ]
        },
        {
          "id": "1699273",
          "text": "Sie kommen aus demselben Land.",
          "translation": "Они приехали из одной страны.",
          "source": "Tatoeba #1699273 @Pfirsichbaeumchen / #3668231 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1699273",
          "cefr_level": "A1",
          "word_slugs": [
            "demselben-pron"
          ]
        },
        {
          "id": "1985805",
          "text": "Wir schliefen in demselben Bett.",
          "translation": "Мы спали в одной постели.",
          "source": "Tatoeba #1985805 @Pfirsichbaeumchen / #2053905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1985805",
          "cefr_level": "A1",
          "word_slugs": [
            "demselben-pron"
          ]
        },
        {
          "id": "1985806",
          "text": "Sie schliefen in demselben Bett.",
          "translation": "Они спали в одной постели.",
          "source": "Tatoeba #1985806 @Pfirsichbaeumchen / #2762471 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1985806",
          "cefr_level": "A1",
          "word_slugs": [
            "demselben-pron"
          ]
        },
        {
          "id": "880055",
          "text": "Wir sind an demselben Tag geboren.",
          "translation": "Мы родились в один день.",
          "source": "Tatoeba #880055 @Esperantostern / #4991085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/880055",
          "cefr_level": "A1",
          "word_slugs": [
            "demselben-pron"
          ]
        }
      ],
