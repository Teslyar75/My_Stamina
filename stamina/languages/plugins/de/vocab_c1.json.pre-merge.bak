    {
      "slug": "häuschen-noun",
      "lemma": "Häuschen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9645,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "домик"
        ],
        "en": [
          "diminutive of Haus",
          "outhouse, privy, dunny; (euphemistic) toilet"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "12975432",
          "text": "Er hat ein wunderschönes Häuschen.",
          "translation": "У него чудесный домик.",
          "source": "Tatoeba #12975432 @Tom9358 / #12975548 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12975432",
          "cefr_level": "A1",
          "word_slugs": [
            "häuschen-noun"
          ]
        },
        {
          "id": "1509452",
          "text": "Sie leben in einem hölzernen Häuschen.",
          "translation": "Они живут в деревянном домике.",
          "source": "Tatoeba #1509452 @cubismus / #5537697 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1509452",
          "cefr_level": "A1",
          "word_slugs": [
            "häuschen-noun"
          ]
        },
        {
          "id": "13954805",
          "text": "Die Großmutter wohnte in einem Häuschen tief im Wald.",
          "translation": "Бабушка жила в маленьком домике в глубине леса.",
          "source": "Tatoeba #13954805 @Ioan_Cristian / #13957341 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13954805",
          "cefr_level": "A1",
          "word_slugs": [
            "häuschen-noun"
          ]
        },
        {
          "id": "3255807",
          "text": "Was sind wir doch niedlich in unserem hübschen Häuschen!",
          "translation": "Ах, какие мы умильные в нашем красивом домике!",
          "source": "Tatoeba #3255807 @al_ex_an_der / #3255812 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3255807",
          "cefr_level": "A1",
          "word_slugs": [
            "häuschen-noun"
          ]
        },
        {
          "id": "2430189",
          "text": "Zwischen den zwei Häuschen steht eine sehr alte und sehr große Linde.",
          "translation": "Между двумя домиками стоит очень старая и очень большая липа.",
          "source": "Tatoeba #2430189 @al_ex_an_der / #2430195 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430189",
          "cefr_level": "A1",
          "word_slugs": [
            "häuschen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
