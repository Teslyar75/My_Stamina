    {
      "slug": "beschrieben-verb",
      "lemma": "beschrieben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7072,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of beschreiben:",
          "first/third-person plural preterite",
          "inflection of beschreiben:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12743548",
          "text": "Sie hat sein Aussehen detailliert beschrieben.",
          "translation": "Она подробно описала его внешность.",
          "source": "Tatoeba #12743548 @mhr / #12743460 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12743548",
          "cefr_level": "A1",
          "word_slugs": [
            "beschrieben-verb"
          ]
        },
        {
          "id": "4154588",
          "text": "Diese Schönheit kann mit Worten nicht beschrieben werden.",
          "translation": "Эту красоту не описать словами.",
          "source": "Tatoeba #4154588 @pullnosemans / #5893514 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4154588",
          "cefr_level": "A1",
          "word_slugs": [
            "beschrieben-verb"
          ]
        },
        {
          "id": "1857970",
          "text": "Die haptischen Gefühle können nicht genau beschrieben werden.",
          "translation": "Осязательные ощущения не поддаются точному описанию.",
          "source": "Tatoeba #1857970 @Wadimiy / #1816248 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1857970",
          "cefr_level": "A1",
          "word_slugs": [
            "beschrieben-verb"
          ]
        },
        {
          "id": "13759437",
          "text": "Das geschah einige Jahre vor den Ereignissen, die ich beschrieben habe.",
          "translation": "Это произошло за несколько лет до описываемых мною событий.",
          "source": "Tatoeba #13759437 @mhr / #13758922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13759437",
          "cefr_level": "A1",
          "word_slugs": [
            "beschrieben-verb"
          ]
        },
        {
          "id": "13672435",
          "text": "Du hast ihn so gut beschrieben, dass ich ihn sofort erkannt habe.",
          "translation": "Ты так хорошо его описал, что я его сразу узнал.",
          "source": "Tatoeba #13672435 @mhr / #13672399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13672435",
          "cefr_level": "A1",
          "word_slugs": [
            "beschrieben-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
