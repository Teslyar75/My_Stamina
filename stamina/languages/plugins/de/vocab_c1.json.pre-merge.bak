          "cefr_level": "A1",
          "word_slugs": [
            "zoo-noun"
          ]
        },
        {
          "id": "3685561",
          "text": "Ich arbeite im Zoo.",
          "translation": "Я работаю в зоопарке.",
          "source": "Tatoeba #3685561 @Sudajaengi / #3954490 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3685561",
          "cefr_level": "A1",
          "word_slugs": [
            "zoo-noun"
          ]
        },
        {
          "id": "2753206",
          "text": "Willst du in den Zoo?",
          "translation": "Ты хочешь в зоопарк?",
