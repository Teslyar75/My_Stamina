    {
      "slug": "abzuhalten-verb",
      "lemma": "abzuhalten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9331,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of abhalten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3067598",
          "text": "Das Parlament der Krim hat beschlossen, ein Referendum abzuhalten.",
          "translation": "Крымский парламент принял решение провести референдум.",
          "source": "Tatoeba #3067598 @al_ex_an_der / #3067596 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3067598",
          "cefr_level": "A1",
          "word_slugs": [
            "abzuhalten-verb"
          ]
        },
        {
          "id": "5720931",
          "text": "Ich versuche ja nur, dich davon abzuhalten, einen großen Fehler zu begehen.",
          "translation": "Я просто пытаюсь помешать тебе совершить большую ошибку.",
          "source": "Tatoeba #5720931 @Pfirsichbaeumchen / #11668379 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5720931",
          "cefr_level": "A1",
          "word_slugs": [
            "abzuhalten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
