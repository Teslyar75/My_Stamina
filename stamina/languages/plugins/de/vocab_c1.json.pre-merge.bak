          "first-person singular present",
          "inflection of schalten:",
          "singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "360580",
          "text": "Bitte schalte den Fernseher aus.",
          "translation": "Выключи телевизор, пожалуйста.",
          "source": "Tatoeba #360580 @Wolf / #2305354 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/360580",
          "cefr_level": "A1",
          "word_slugs": [
            "schalte-verb"
          ]
        },
        {
          "id": "13931351",
          "text": "Bevor du gehst, schalte unbedingt das Licht aus!",
          "translation": "Перед уходом обязательно выключи свет.",
          "source": "Tatoeba #13931351 @mhr / #13931349 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13931351",
          "cefr_level": "A1",
          "word_slugs": [
            "schalte-verb"
          ]
        },
        {
          "id": "2869690",
          "text": "Ich schalte den Fernseher aus, wenn du nicht guckst.",
          "translation": "Я выключу телевизор, раз ты не смотришь.",
          "source": "Tatoeba #2869690 @Pfirsichbaeumchen / #2987774 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2869690",
          "cefr_level": "A1",
          "word_slugs": [
            "schalte-verb"
          ]
        },
        {
          "id": "1081824",
          "text": "Bitte schalte den Fernseher auf das dritte Programm um.",
          "translation": "Пожалуйста, включите телевизор на третьем канале.",
          "source": "Tatoeba #1081824 @Esperantostern / #2875393 @ainurshakirov (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1081824",
          "cefr_level": "A1",
          "word_slugs": [
            "schalte-verb"
          ]
        },
        {
          "id": "13705046",
          "text": "Wenn – oder falls – du weggehst, schalte nicht das Licht aus!",
          "translation": "Когда (и если) будешь уходить, не выключай свет.",
          "source": "Tatoeba #13705046 @mhr / #13705040 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13705046",
          "cefr_level": "A1",
          "word_slugs": [
            "schalte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
