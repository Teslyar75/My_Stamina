    {
      "slug": "pfoten-noun",
      "lemma": "Pfoten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7530,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Pfote"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "943062",
          "text": "Ein Hund hat vier Pfoten.",
          "translation": "У собаки четыре лапы.",
          "source": "Tatoeba #943062 @mayok / #2737775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/943062",
          "cefr_level": "A1",
          "word_slugs": [
            "pfoten-noun"
          ]
        },
        {
          "id": "6690239",
          "text": "Toms Hund hat vier Pfoten.",
          "translation": "У пса Тома четыре лапы.",
          "source": "Tatoeba #6690239 @manese / #6695356 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6690239",
          "cefr_level": "A1",
          "word_slugs": [
            "pfoten-noun"
          ]
        },
        {
          "id": "9803517",
          "text": "Die Katze leckte sich ihre Pfoten ab.",
          "translation": "Кошка лизала свои лапы.",
          "source": "Tatoeba #9803517 @GaryGaryGary / #1794185 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9803517",
          "cefr_level": "A1",
          "word_slugs": [
            "pfoten-noun"
          ]
        },
        {
          "id": "4867127",
          "text": "Katzen landen fast immer auf den Pfoten.",
          "translation": "Кошки почти всегда приземляются на лапы.",
          "source": "Tatoeba #4867127 @Pfirsichbaeumchen / #4853478 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4867127",
          "cefr_level": "A1",
          "word_slugs": [
            "pfoten-noun"
          ]
        },
        {
          "id": "4142688",
          "text": "Der Hase verließ sich auf die Schnelligkeit seiner Pfoten.",
          "translation": "Заяц положился на прыткость своих лап.",
          "source": "Tatoeba #4142688 @pullnosemans / #4143754 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4142688",
          "cefr_level": "A1",
          "word_slugs": [
            "pfoten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
