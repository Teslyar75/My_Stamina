    {
      "slug": "lecken-verb",
      "lemma": "lecken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7110,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "лизать"
        ],
        "en": [
          "to lick (with the tongue)",
          "to lick (to perform cunnilingus)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2185895",
          "text": "Das Essen war gut, die Finger zu lecken.",
          "translation": "Еда была - пальчики оближешь.",
          "source": "Tatoeba #2185895 @Esperantostern / #5018534 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2185895",
          "cefr_level": "A1",
          "word_slugs": [
            "lecken-verb"
          ]
        },
        {
          "id": "3307904",
          "text": "Hast du jemals versucht, an Seife zu lecken?",
          "translation": "Ты когда-нибудь пробовал лизать мыло?",
          "source": "Tatoeba #3307904 @al_ex_an_der / #3306870 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3307904",
          "cefr_level": "A1",
          "word_slugs": [
            "lecken-verb"
          ]
        },
        {
          "id": "4657169",
          "text": "Hüte dich vor Katzen, die vorne lecken und hinten kratzen.",
          "translation": "Бойся кошек, которые спереди лижут, а сзади царапают.",
          "source": "Tatoeba #4657169 @AqQoyriq_1 / #4657177 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4657169",
          "cefr_level": "A1",
          "word_slugs": [
            "lecken-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
