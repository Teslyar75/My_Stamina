          ]
        },
        {
          "id": "11506438",
          "text": "Das ist ein altes Sprichwort.",
          "translation": "Это старая пословица.",
          "source": "Tatoeba #11506438 @Adelpa / #11574301 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11506438",
          "cefr_level": "A1",
          "word_slugs": [
            "sprichwort-noun"
          ]
        },
        {
          "id": "1045095",
          "text": "In Wales haben sie ein Sprichwort.",
          "translation": "В Уэльсе есть одна пословица.",
          "source": "Tatoeba #1045095 @Esperantostern / #4532849 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1045095",
          "cefr_level": "A1",
          "word_slugs": [
            "sprichwort-noun"
          ]
        },
        {
          "id": "13421274",
          "text": "Ergänzen Sie das Sprichwort: „Ohne Mühe …“",
          "translation": "Продолжите пословицу: \"Без труда...\"",
          "source": "Tatoeba #13421274 @mhr / #13421026 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13421274",
          "cefr_level": "A1",
          "word_slugs": [
            "sprichwort-noun"
          ]
        }
      ],
