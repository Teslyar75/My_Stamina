          "cefr_level": "A1",
          "word_slugs": [
            "zögern-verb"
          ]
        },
        {
          "id": "455694",
          "text": "Sie antwortete ohne zu zögern.",
          "translation": "Она ответила без колебаний.",
          "source": "Tatoeba #455694 @xtofu80 / #10159091 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455694",
          "cefr_level": "A1",
          "word_slugs": [
            "zögern-verb"
          ]
        },
        {
          "id": "2469225",
          "text": "Er willigte ohne zu zögern ein.",
          "translation": "Он без раздумий согласился.",
          "source": "Tatoeba #2469225 @al_ex_an_der / #2469224 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2469225",
          "cefr_level": "A1",
          "word_slugs": [
            "zögern-verb"
          ]
        },
        {
          "id": "8898236",
          "text": "Ohne zu zögern akzeptierte Tom die Arbeitsstelle.",
          "translation": "Том без колебаний принял предложение о работе.",
          "source": "Tatoeba #8898236 @mramosch / #9091207 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8898236",
          "cefr_level": "A1",
          "word_slugs": [
            "zögern-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
