    {
      "slug": "binden-verb",
      "lemma": "binden",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6120,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "связывать",
          "завязывать",
          "связывать себя, быть обязанным"
        ],
        "en": [
          "to bind, to tie, to fasten something by means of a string etc.",
          "to tie, to fasten a string etc.",
          "to oblige, commit, bind",
          "to commit oneself, make a commitment (especially for marriage)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2024208",
          "text": "Tom kann keinen Schlips binden.",
          "translation": "Том не умеет завязывать галстук.",
          "source": "Tatoeba #2024208 @Malko66 / #3229974 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2024208",
          "cefr_level": "A1",
          "word_slugs": [
            "binden-verb"
          ]
        },
        {
          "id": "2024209",
          "text": "Tom kann keine Krawatte binden.",
          "translation": "Том не умеет завязывать галстук.",
          "source": "Tatoeba #2024209 @Malko66 / #3229974 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2024209",
          "cefr_level": "A1",
          "word_slugs": [
            "binden-verb"
          ]
        },
        {
          "id": "9432517",
          "text": "Kannst du einen Schlips binden?",
          "translation": "Ты умеешь завязывать галстуки?",
          "source": "Tatoeba #9432517 @Pfirsichbaeumchen / #9477391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9432517",
          "cefr_level": "A1",
          "word_slugs": [
            "binden-verb"
          ]
        },
        {
          "id": "9432519",
          "text": "Kannst du eine Krawatte binden?",
          "translation": "Ты умеешь завязывать галстуки?",
          "source": "Tatoeba #9432519 @Pfirsichbaeumchen / #9477391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9432519",
          "cefr_level": "A1",
          "word_slugs": [
            "binden-verb"
          ]
        },
        {
          "id": "6364720",
          "text": "In deinem Alter konnte ich mir schon die Schuhe binden.",
          "translation": "Я в твоём возрасте уже умела завязывать шнурки.",
