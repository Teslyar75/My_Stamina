    {
      "slug": "zusammenarbeit-noun",
      "lemma": "Zusammenarbeit",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6392,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "collaboration, cooperation, teamwork"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3115577",
          "text": "Ich danke dir für die gute Zusammenarbeit.",
          "translation": "Я благодарю тебя за хорошую совместную работу.",
          "source": "Tatoeba #3115577 @al_ex_an_der / #3115583 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3115577",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenarbeit-noun"
          ]
        },
        {
          "id": "3115576",
          "text": "Ich danke euch für die gute Zusammenarbeit.",
          "translation": "Я благодарю вас за хорошую совместную работу.",
          "source": "Tatoeba #3115576 @al_ex_an_der / #3115571 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3115576",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenarbeit-noun"
          ]
        },
        {
          "id": "3115574",
          "text": "Ich danke Ihnen für die gute Zusammenarbeit.",
          "translation": "Я благодарю вас за хорошую совместную работу.",
          "source": "Tatoeba #3115574 @al_ex_an_der / #3115571 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3115574",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenarbeit-noun"
          ]
        },
        {
          "id": "2227479",
          "text": "Ich möchte danksagen für eine fantastische Zusammenarbeit über viele Jahre.",
          "translation": "Я хочу сказать спасибо за фантастическое сотрудничество на протяжении многих лет.",
          "source": "Tatoeba #2227479 @al_ex_an_der / #2227486 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2227479",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenarbeit-noun"
          ]
        },
        {
          "id": "3263589",
          "text": "Die Basis für den Erfolg in der Zusammenarbeit ist gegenseitiger Anstand.",
          "translation": "Основа успеха в совместной работе - взаимная порядочность.",
          "source": "Tatoeba #3263589 @faehrmann / #3262976 @Abeotat1948 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3263589",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenarbeit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "hinauf-adv",
      "lemma": "hinauf",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6393,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "up; upward; upwards (from the own location upwards, in direction away from the speaker)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4277864",
          "text": "Geh die Treppe hinauf.",
          "translation": "Поднимайся по лестнице.",
          "source": "Tatoeba #4277864 @raggione / #5695498 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4277864",
          "cefr_level": "A1",
          "word_slugs": [
            "hinauf-adv"
          ]
        },
        {
          "id": "13014795",
          "text": "Ben geht die Treppe hinauf.",
          "translation": "Бен поднимается по лестнице.",
          "source": "Tatoeba #13014795 @Tom9358 / #13014800 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13014795",
          "cefr_level": "A1",
          "word_slugs": [
            "hinauf-adv"
          ]
        },
        {
          "id": "1779827",
          "text": "Wir gingen die Treppe hinauf.",
          "translation": "Мы поднялись по лестнице.",
          "source": "Tatoeba #1779827 @Pfirsichbaeumchen / #2772687 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1779827",
          "cefr_level": "A1",
          "word_slugs": [
            "hinauf-adv"
          ]
        },
        {
          "id": "2470726",
          "text": "Sie rannte die Treppe hinauf.",
          "translation": "Она взбежала по лестнице.",
          "source": "Tatoeba #2470726 @Pfirsichbaeumchen / #3529826 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2470726",
          "cefr_level": "A1",
          "word_slugs": [
            "hinauf-adv"
          ]
        },
        {
          "id": "1587472",
          "text": "Gehen Sie diese Treppe hinauf.",
          "translation": "Поднимитесь по этой лестнице.",
          "source": "Tatoeba #1587472 @kolonjano / #1587475 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1587472",
          "cefr_level": "A1",
          "word_slugs": [
            "hinauf-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
