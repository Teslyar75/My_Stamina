    {
      "slug": "rippen-noun",
      "lemma": "Rippen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7957,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Rippe"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7072271",
          "text": "Ich habe drei Rippen gebrochen.",
          "translation": "Я сломал три ребра.",
          "source": "Tatoeba #7072271 @Alexs / #7044397 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7072271",
          "cefr_level": "A1",
          "word_slugs": [
            "rippen-noun"
          ]
        },
        {
          "id": "8030426",
          "text": "Er hat sich zwei Rippen gebrochen; die Lunge wurde durchbohrt.",
          "translation": "Он сломал два ребра и получил прободение лёгкого.",
          "source": "Tatoeba #8030426 @manese / #8032278 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8030426",
          "cefr_level": "A1",
          "word_slugs": [
            "rippen-noun"
          ]
        },
        {
          "id": "3959486",
          "text": "Tom ist vom Dach gefallen und hat sich drei Rippen gebrochen.",
          "translation": "Том упал с крыши и сломал себе три ребра.",
          "source": "Tatoeba #3959486 @Pfirsichbaeumchen / #4007074 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3959486",
          "cefr_level": "A1",
          "word_slugs": [
            "rippen-noun"
          ]
        },
        {
          "id": "6367155",
          "text": "Tom hätte mir fast die Rippen gebrochen, als er mich umarmte.",
          "translation": "Том мне чуть рёбра не сломал, когда обнимал.",
          "source": "Tatoeba #6367155 @Pfirsichbaeumchen / #5520917 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6367155",
          "cefr_level": "A1",
          "word_slugs": [
            "rippen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
