    {
      "slug": "betracht-noun",
      "lemma": "Betracht",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5844,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "consideration"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1934495",
          "text": "Sie zogen jede Möglichkeit in Betracht.",
          "translation": "Они приняли во внимание любую возможность.",
          "source": "Tatoeba #1934495 @Alois / #1537391 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1934495",
          "cefr_level": "A1",
          "word_slugs": [
            "betracht-noun"
          ]
        },
        {
          "id": "679258",
          "text": "Sie haben jede Möglichkeit in Betracht gezogen.",
          "translation": "Они приняли во внимание любую возможность.",
          "source": "Tatoeba #679258 @Manfredo / #1537391 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/679258",
          "cefr_level": "A1",
          "word_slugs": [
            "betracht-noun"
          ]
        },
        {
          "id": "7484900",
          "text": "Ich wünsche, dass Sie das in Betracht ziehen.",
          "translation": "Я бы хотел, чтобы Вы это рассмотрели.",
          "source": "Tatoeba #7484900 @raggione / #7487061 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7484900",
          "cefr_level": "A1",
          "word_slugs": [
            "betracht-noun"
          ]
        },
        {
          "id": "740443",
          "text": "Du musst in Betracht ziehen, dass sie viel jünger ist als du.",
          "translation": "Тебе следует иметь в виду, что она намного моложе тебя.",
          "source": "Tatoeba #740443 @Manfredo / #2061187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/740443",
          "cefr_level": "A1",
          "word_slugs": [
            "betracht-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
