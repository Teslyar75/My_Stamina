    {
      "slug": "aufsicht-noun",
      "lemma": "Aufsicht",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8157,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "надзор",
          "контроль",
          "смотритель",
          "контролёр"
        ],
        "en": [
          "supervision, oversight"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2756641",
          "text": "Wir können Sie nicht ohne ärztliche Aufsicht lassen.",
          "translation": "Мы не можем оставить Вас без медицинского наблюдения.",
          "source": "Tatoeba #2756641 @marcelostockle / #4947460 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2756641",
          "cefr_level": "A1",
          "word_slugs": [
            "aufsicht-noun"
          ]
        },
        {
          "id": "2756599",
          "text": "Sie darf nicht ohne Aufsicht dieses Zimmer verlassen.",
          "translation": "Вам не позволено покидать эту комнату без присмотра.",
          "source": "Tatoeba #2756599 @marcelostockle / #4947459 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2756599",
          "cefr_level": "A1",
          "word_slugs": [
            "aufsicht-noun"
          ]
        },
        {
          "id": "2034117",
          "text": "Unter Aufsicht kümmert er sich viel besser um seine Kunden.",
          "translation": "Под присмотром он гораздо лучше заботится о своих клиентах.",
          "source": "Tatoeba #2034117 @al_ex_an_der / #4947466 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2034117",
          "cefr_level": "A1",
          "word_slugs": [
            "aufsicht-noun"
          ]
        }
      ],
      "tags": [
