      },
      "gender": null,
      "examples": [
        {
          "id": "13933867",
          "text": "Die Schönheit der Blume verstärkt ihren Duft.",
          "translation": "Красота цветка усиливает его аромат.",
          "source": "Tatoeba #13933867 @carlosalberto / #13933869 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13933867",
          "cefr_level": "A1",
