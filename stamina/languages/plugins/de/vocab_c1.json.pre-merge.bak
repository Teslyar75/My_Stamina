    {
      "slug": "becher-noun",
      "lemma": "Becher",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6383,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a cylindrical or slightly conical drinking vessel without a stem, typically with no handle, beaker"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "3647904",
          "text": "Wo sind die Becher?",
          "translation": "Где кружки?",
          "source": "Tatoeba #3647904 @Esperantostern / #5679005 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3647904",
          "cefr_level": "A1",
          "word_slugs": [
            "becher-noun"
          ]
        },
        {
          "id": "2884585",
          "text": "Ist das mein Becher?",
          "translation": "Это моя кружка?",
          "source": "Tatoeba #2884585 @raggione / #3332356 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2884585",
          "cefr_level": "A1",
          "word_slugs": [
            "becher-noun"
          ]
        },
        {
          "id": "1951095",
          "text": "Im Becher ersaufen mehr als im Meer.",
          "translation": "В бокалах тонет больше людей, чем в море.",
          "source": "Tatoeba #1951095 @Esperantostern / #3119734 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1951095",
          "cefr_level": "A1",
          "word_slugs": [
            "becher-noun"
          ]
        },
        {
          "id": "6743226",
          "text": "Sie trank aus einem großen Becher Milch.",
          "translation": "Она пила молоко из большой кружки.",
          "source": "Tatoeba #6743226 @Pfirsichbaeumchen / #6393527 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6743226",
          "cefr_level": "A1",
          "word_slugs": [
            "becher-noun"
          ]
        },
        {
          "id": "3238360",
          "text": "Julia stand auf Zehenspitzen, um an einen Becher im obersten Fach heranzukommen.",
          "translation": "Юля встала на носочки, чтобы достать кружку с верхней полки.",
          "source": "Tatoeba #3238360 @al_ex_an_der / #2506916 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3238360",
          "cefr_level": "A1",
          "word_slugs": [
            "becher-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Becher",
        "nominative_pl": ""
      }
