    {
      "slug": "deckt-verb",
      "lemma": "deckt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8634,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of decken:",
          "third-person singular present",
          "inflection of decken:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13712074",
          "text": "Papa deckt schon den Tisch.",
          "translation": "Папа уже накрывает на стол.",
          "source": "Tatoeba #13712074 @Ioan_Cristian / #13858111 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13712074",
          "cefr_level": "A1",
          "word_slugs": [
            "deckt-verb"
          ]
        },
        {
          "id": "13979939",
          "text": "Sie deckt den Tisch fürs Frühstück.",
          "translation": "Она накрывает на стол для завтрака.",
          "source": "Tatoeba #13979939 @mhr / #13979936 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13979939",
          "cefr_level": "A1",
          "word_slugs": [
            "deckt-verb"
          ]
        },
        {
          "id": "7423374",
          "text": "Tom deckt den Tisch fürs Abendessen.",
          "translation": "Том накрывает стол к ужину.",
          "source": "Tatoeba #7423374 @Pfirsichbaeumchen / #7423379 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7423374",
          "cefr_level": "A1",
          "word_slugs": [
            "deckt-verb"
          ]
        },
        {
          "id": "2848825",
          "text": "Haß erregt Hader; aber Liebe deckt zu alle Übertretungen.",
          "translation": "Ненависть возбуждает раздоры, но любовь покрывает все грехи.",
          "source": "Tatoeba #2848825 @carlosalberto / #2848812 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2848825",
          "cefr_level": "A1",
          "word_slugs": [
            "deckt-verb"
          ]
        },
        {
          "id": "942061",
          "text": "Der Preis für diesen Artikel deckt nicht seine Produktionskosten.",
          "translation": "Стоимость этого товара не покрывает затрат на его производство.",
          "source": "Tatoeba #942061 @Sudajaengi / #12372984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/942061",
          "cefr_level": "A1",
          "word_slugs": [
            "deckt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
