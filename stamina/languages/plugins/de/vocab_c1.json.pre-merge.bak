    {
      "slug": "speck-noun",
      "lemma": "Speck",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6288,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "шпик"
        ],
        "en": [
          "bacon, fatty cellular tissue under the porkrind",
          "adipose tissue, bodyfat"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3374212",
          "text": "Ich roch Speck.",
          "translation": "Я почувствовал запах сала.",
          "source": "Tatoeba #3374212 @Esperantostern / #6822961 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3374212",
          "cefr_level": "A1",
          "word_slugs": [
            "speck-noun"
          ]
        },
        {
          "id": "13079379",
          "text": "Ich mag Speck mit Eiern.",
          "translation": "Я люблю яичницу с ветчиной.",
          "source": "Tatoeba #13079379 @Vortarulo / #13079380 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13079379",
          "cefr_level": "A1",
          "word_slugs": [
            "speck-noun"
          ]
        },
        {
          "id": "1981344",
          "text": "Der Speck lässt von der Schwarte nicht.",
          "translation": "Сало от шкуры не отстаёт.",
          "source": "Tatoeba #1981344 @Esperantostern / #5670111 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1981344",
          "cefr_level": "A1",
          "word_slugs": [
            "speck-noun"
          ]
        },
        {
          "id": "1934393",
          "text": "Das ist doch kein fetter Speck, das ist nur Fett.",
          "translation": "Это уже не жирное сало, а только жир.",
          "source": "Tatoeba #1934393 @Beatminister / #8590192 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1934393",
          "cefr_level": "A1",
          "word_slugs": [
            "speck-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Speck",
        "nominative_pl": ""
      }
