    {
      "slug": "meiden-verb",
      "lemma": "meiden",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8958,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "избегать",
          "сторониться",
          "уклоняться"
        ],
        "en": [
          "to avoid, to keep away from",
          "to shun"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8357859",
          "text": "Tom ist sehr aggressiv; daher meiden ihn viele.",
          "translation": "Том очень агрессивен, поэтому многие люди избегают его.",
          "source": "Tatoeba #8357859 @Pfirsichbaeumchen / #8355599 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8357859",
          "cefr_level": "A1",
          "word_slugs": [
            "meiden-verb"
          ]
        },
        {
          "id": "2587349",
          "text": "Es gibt Personen, die man möglichst meiden sollte.",
          "translation": "Есть люди, которых по возможности следует избегать.",
          "source": "Tatoeba #2587349 @al_ex_an_der / #2587345 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2587349",
          "cefr_level": "A1",
          "word_slugs": [
            "meiden-verb"
          ]
        },
        {
          "id": "2587351",
          "text": "Es gibt Personen, die man nach Möglichkeit meiden sollte.",
          "translation": "Есть люди, которых по возможности следует избегать.",
          "source": "Tatoeba #2587351 @al_ex_an_der / #2587345 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2587351",
          "cefr_level": "A1",
          "word_slugs": [
            "meiden-verb"
          ]
        }
      ],
