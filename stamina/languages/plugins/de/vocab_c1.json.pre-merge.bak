      },
      "gender": null,
      "examples": [
        {
          "id": "8859448",
          "text": "Beschwert sich Tom?",
          "translation": "Том жалуется?",
          "source": "Tatoeba #8859448 @Pfirsichbaeumchen / #3056848 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8859448",
          "cefr_level": "A1",
          "word_slugs": [
            "beschwert-verb"
          ]
        },
        {
          "id": "4497693",
          "text": "Tom beschwert sich selten.",
          "translation": "Том редко жалуется.",
          "source": "Tatoeba #4497693 @Pfirsichbaeumchen / #4503651 @racoon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4497693",
          "cefr_level": "A1",
          "word_slugs": [
            "beschwert-verb"
          ]
        },
        {
          "id": "4158434",
          "text": "Worüber beschwert ihr euch?",
          "translation": "На что жалуетесь?",
          "source": "Tatoeba #4158434 @Pfirsichbaeumchen / #3846246 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4158434",
          "cefr_level": "A1",
          "word_slugs": [
            "beschwert-verb"
          ]
        },
        {
          "id": "7208335",
          "text": "Tom beschwert sich ständig.",
          "translation": "Том постоянно жалуется.",
