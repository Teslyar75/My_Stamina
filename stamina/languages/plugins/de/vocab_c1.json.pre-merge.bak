    {
      "slug": "objekt-noun",
      "lemma": "Objekt",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5101,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "объект"
        ],
        "en": [
          "object (inanimate being, thing)",
          "object (that around which an emotion or activity centers)",
          "asset, property (something of high value, especially real estate)",
          "object"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "2434680",
          "text": "Kannst du das Objekt beschreiben?",
          "translation": "Ты можешь описать предмет?",
          "source": "Tatoeba #2434680 @Tamy / #12530132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2434680",
          "cefr_level": "A1",
          "word_slugs": [
            "objekt-noun"
          ]
        },
        {
          "id": "12435902",
          "text": "Wir sahen ein seltsames Objekt am Himmel.",
          "translation": "Мы увидели в небе странный объект.",
          "source": "Tatoeba #12435902 @mayabe / #13199319 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12435902",
          "cefr_level": "A1",
          "word_slugs": [
            "objekt-noun"
          ]
        },
        {
          "id": "5932495",
          "text": "Die Sonne ist das hellste Objekt am Himmel.",
          "translation": "Солнце - самый яркий объект на небе.",
          "source": "Tatoeba #5932495 @brauchinet / #5932125 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5932495",
          "cefr_level": "A1",
          "word_slugs": [
            "objekt-noun"
          ]
        },
        {
          "id": "2406616",
          "text": "Im Englischen steht das Verb vor dem Objekt.",
          "translation": "В английском языке глагол предшествует дополнению.",
          "source": "Tatoeba #2406616 @Pfirsichbaeumchen / #445478 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2406616",
          "cefr_level": "A1",
          "word_slugs": [
            "objekt-noun"
          ]
        },
        {
          "id": "11373949",
          "text": "Was ist das für ein Objekt in deiner rechten Hand?",
          "translation": "Что за предмет у тебя в правой руке?",
          "source": "Tatoeba #11373949 @Bernie75 / #1708049 @ashulga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11373949",
          "cefr_level": "A1",
          "word_slugs": [
            "objekt-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Objekt",
        "nominative_pl": ""
      }
    },
    {
      "slug": "bedaure-verb",
      "lemma": "bedaure",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5102,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bedauern:",
          "first-person singular present",
          "inflection of bedauern:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5969815",
          "text": "Ich bedaure auch nichts.",
          "translation": "Я тоже ни о чём не жалею.",
          "source": "Tatoeba #5969815 @raggione / #5969828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5969815",
          "cefr_level": "A1",
          "word_slugs": [
            "bedaure-verb"
          ]
        },
        {
          "id": "844176",
          "text": "Ich bedaure dieses Missverständnis.",
          "translation": "Я сожалею из-за этого недоразумения.",
          "source": "Tatoeba #844176 @User4473 / #1587468 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/844176",
          "cefr_level": "A1",
          "word_slugs": [
            "bedaure-verb"
          ]
        },
        {
          "id": "8977428",
          "text": "Ich bedaure meine Entscheidung nicht.",
          "translation": "Я не жалею о своём решении.",
          "source": "Tatoeba #8977428 @Adelpa / #9095952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8977428",
          "cefr_level": "A1",
          "word_slugs": [
            "bedaure-verb"
          ]
        },
        {
          "id": "1223738",
          "text": "Er sagte, er bedaure seine Entscheidung.",
          "translation": "Он сказал, что жалеет о своём решении.",
          "source": "Tatoeba #1223738 @BraveSentry / #5266735 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1223738",
          "cefr_level": "A1",
          "word_slugs": [
            "bedaure-verb"
          ]
        },
        {
          "id": "1223737",
          "text": "Sie sagte, sie bedaure ihre Entscheidung.",
          "translation": "Она сказала, что жалеет о своём решении.",
          "source": "Tatoeba #1223737 @BraveSentry / #5266734 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1223737",
          "cefr_level": "A1",
          "word_slugs": [
            "bedaure-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "wobei-adv",
      "lemma": "wobei",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5103,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "при чём",
          "причём"
        ],
        "en": [
          "Introduces a comitative sentence, denoting a simultaneous event with the main clause. It frequently corresponds to English present participles (-ing) in adverbial use.",
          "Interrogative and relative adverbs: by what, about what",
          "Sometimes with verb in the second position. With concessive meaning when main and subordinate clauses are semantically incompatible."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "749405",
          "text": "Wobei ist der Fehler aufgetreten?",
          "translation": "При каких обстоятельствах возникла неисправность?",
          "source": "Tatoeba #749405 @kroko / #749412 @kroko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/749405",
          "cefr_level": "A1",
          "word_slugs": [
            "wobei-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "kokain-noun",
      "lemma": "Kokain",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5104,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "cocaine"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2520417",
          "text": "Das Kokain ist ein Rauschgift.",
          "translation": "Кокаин — это наркотик.",
          "source": "Tatoeba #2520417 @europeanlanguages / #2518178 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2520417",
          "cefr_level": "A1",
          "word_slugs": [
            "kokain-noun"
          ]
        },
        {
          "id": "880707",
          "text": "Er hat eine Überdosis Kokain genommen.",
          "translation": "Он принял излишнюю дозу кокаина.",
          "source": "Tatoeba #880707 @Esperantostern / #2371825 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/880707",
          "cefr_level": "A1",
          "word_slugs": [
            "kokain-noun"
          ]
        },
        {
          "id": "7533575",
          "text": "Abgesehen von dem gelegentlichen Genuss von Kokain hatte er keine Laster.",
          "translation": "Помимо случайного употребления кокаина, у него не было пороков.",
          "source": "Tatoeba #7533575 @Pfirsichbaeumchen / #7533960 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7533575",
          "cefr_level": "A1",
          "word_slugs": [
            "kokain-noun"
          ]
        },
        {
          "id": "2730883",
          "text": "Kokain ist eine Droge.",
          "translation": "Кокаин — наркотик.",
          "source": "Tatoeba #2730883 @Pfirsichbaeumchen / #2518177 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2730883",
          "cefr_level": "A1",
          "word_slugs": [
            "kokain-noun"
          ]
        }
      ],
      "tags": [
