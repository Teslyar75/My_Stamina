      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9380,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of kalt"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "678962",
          "text": "Bitte kaltes Wasser.",
          "translation": "Холодной воды, пожалуйста.",
          "source": "Tatoeba #678962 @Esperantostern / #417280 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/678962",
          "cefr_level": "A1",
          "word_slugs": [
            "kaltes-adj"
          ]
        },
        {
          "id": "4527041",
          "text": "Ich mag kaltes Bier.",
          "translation": "Я люблю холодное пиво.",
          "source": "Tatoeba #4527041 @Esperantostern / #5419844 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4527041",
          "cefr_level": "A1",
          "word_slugs": [
            "kaltes-adj"
          ]
        },
        {
          "id": "7794060",
          "text": "Ich möchte etwas Kaltes.",
