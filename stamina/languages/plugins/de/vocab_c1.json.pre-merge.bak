    {
      "slug": "einwohner-noun",
      "lemma": "Einwohner",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7704,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inhabitant (anyone who lives or dwells in something, especially a country, region, settlement)",
          "an inhabitant without the full rights of a citizen; now used in the form Inwohner in historic terminology"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "709748",
          "text": "Die Stadt hat viele Einwohner.",
          "translation": "В городе много жителей.",
          "source": "Tatoeba #709748 @Esperantostern / #5383460 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/709748",
          "cefr_level": "A1",
          "word_slugs": [
            "einwohner-noun"
          ]
        },
        {
          "id": "530653",
          "text": "10 % der Einwohner kommen aus Japan.",
          "translation": "10% жителей приехали из Японии.",
          "source": "Tatoeba #530653 @Pfirsichbaeumchen / #598926 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/530653",
          "cefr_level": "A1",
          "word_slugs": [
            "einwohner-noun"
          ]
        },
        {
          "id": "11195661",
          "text": "Istanbul hat über 16 Millionen Einwohner.",
          "translation": "Население Стамбула составляет более 16 миллионов человек.",
          "source": "Tatoeba #11195661 @Pfirsichbaeumchen / #10189370 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11195661",
          "cefr_level": "A1",
          "word_slugs": [
            "einwohner-noun"
          ]
        },
        {
          "id": "1358305",
          "text": "Brasilien hat fast 200 Millionen Einwohner.",
          "translation": "В Бразилии почти 200 миллионов жителей.",
          "source": "Tatoeba #1358305 @Manfredo / #6556454 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1358305",
          "cefr_level": "A1",
          "word_slugs": [
            "einwohner-noun"
          ]
        },
        {
          "id": "13828066",
          "text": "Linz hat über zweihunderttausend Einwohner.",
          "translation": "В Линце более двухсот тысяч жителей.",
          "source": "Tatoeba #13828066 @Ioan_Cristian / #13829126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13828066",
          "cefr_level": "A1",
          "word_slugs": [
            "einwohner-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Einwohner",
        "nominative_pl": ""
      }
