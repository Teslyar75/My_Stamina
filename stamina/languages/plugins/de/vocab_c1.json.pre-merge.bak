    {
      "slug": "holte-verb",
      "lemma": "holte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5336,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of holen:",
          "first/third-person singular preterite",
          "inflection of holen:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3472236",
          "text": "Tom holte Maria Wasser.",
          "translation": "Том принес Мэри воды.",
          "source": "Tatoeba #3472236 @Pfirsichbaeumchen / #4418278 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3472236",
          "cefr_level": "A1",
          "word_slugs": [
            "holte-verb"
          ]
        },
        {
          "id": "2739381",
          "text": "Tom holte ein Messer aus der Tasche.",
          "translation": "Том вытащил нож из кармана.",
          "source": "Tatoeba #2739381 @Pfirsichbaeumchen / #6891038 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2739381",
          "cefr_level": "A1",
          "word_slugs": [
            "holte-verb"
          ]
        },
        {
          "id": "867690",
          "text": "Perry holte eine wertvolle Information aus ihm heraus.",
          "translation": "Перри получил от него очень ценную информацию.",
          "source": "Tatoeba #867690 @Espi / #425221 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/867690",
          "cefr_level": "A1",
          "word_slugs": [
            "holte-verb"
          ]
        },
        {
          "id": "802259",
          "text": "Meine Mutter holte mich gewöhnlich ab, als ich in der Grundschule war.",
          "translation": "Когда я учился в начальной школе, меня обычно забирала мама.",
          "source": "Tatoeba #802259 @Esperantostern / #14049759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/802259",
          "cefr_level": "A1",
          "word_slugs": [
            "holte-verb"
          ]
        }
      ],
      "tags": [
