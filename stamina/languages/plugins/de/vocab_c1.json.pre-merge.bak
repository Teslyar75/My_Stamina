    {
      "slug": "gemocht-verb",
      "lemma": "gemocht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5525,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of mögen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3866969",
          "text": "Du hast Schokolade gemocht.",
          "translation": "Ты любил шоколад.",
          "source": "Tatoeba #3866969 @Esperantostern / #4921266 @venticello (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3866969",
          "cefr_level": "A1",
          "word_slugs": [
            "gemocht-verb"
          ]
        },
        {
          "id": "12492273",
          "text": "Er hat sie nie gemocht.",
          "translation": "Она никогда ему не нравилась.",
          "source": "Tatoeba #12492273 @Waldelfe / #8739668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12492273",
          "cefr_level": "A1",
          "word_slugs": [
            "gemocht-verb"
          ]
        },
        {
          "id": "406835",
          "text": "Hast du den Film gemocht?",
          "translation": "Тебе понравился фильм?",
          "source": "Tatoeba #406835 @MUIRIEL / #388150 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/406835",
          "cefr_level": "A1",
          "word_slugs": [
            "gemocht-verb"
          ]
        },
        {
          "id": "2440406",
          "text": "Ich habe sie nie gemocht.",
          "translation": "Мне она никогда не нравилась.",
          "source": "Tatoeba #2440406 @Pfirsichbaeumchen / #4902011 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2440406",
          "cefr_level": "A1",
          "word_slugs": [
            "gemocht-verb"
          ]
        },
        {
          "id": "2440407",
          "text": "Ich habe ihn nie gemocht.",
          "translation": "Мне он никогда не нравился.",
          "source": "Tatoeba #2440407 @Pfirsichbaeumchen / #4516313 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2440407",
