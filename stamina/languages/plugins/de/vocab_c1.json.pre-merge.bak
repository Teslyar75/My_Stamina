    {
      "slug": "ähnliches-adj",
      "lemma": "ähnliches",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6454,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of ähnlich"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6880295",
          "text": "Ich habe ein ähnliches Gefühl.",
          "translation": "У меня такое же чувство.",
          "source": "Tatoeba #6880295 @brauchinet / #6880359 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6880295",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnliches-adj"
          ]
        },
        {
          "id": "3262941",
          "text": "Ich habe ein ähnliches gesehen.",
          "translation": "Я видел похожее.",
          "source": "Tatoeba #3262941 @faehrmann / #13669745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3262941",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnliches-adj"
          ]
        },
        {
          "id": "4939078",
          "text": "Etwas Ähnliches ist Tom passiert.",
          "translation": "Нечто подобное случилось с Томом.",
          "source": "Tatoeba #4939078 @brauchinet / #4939130 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4939078",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnliches-adj"
          ]
        },
        {
          "id": "5316874",
          "text": "Ähnliches wird durch Ähnliches geheilt.",
          "translation": "Подобное лечится подобным.",
          "source": "Tatoeba #5316874 @Esperantostern / #9082438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5316874",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnliches-adj"
          ]
        },
        {
          "id": "1433134",
          "text": "Hast du jemals etwas Ähnliches gehört?",
          "translation": "Ты когда-нибудь слышал что-нибудь подобное?",
          "source": "Tatoeba #1433134 @Vortarulo / #2304714 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1433134",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnliches-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
