    {
      "slug": "neidisch-adj",
      "lemma": "neidisch",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5736,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "завистливый"
        ],
        "en": [
          "envious, jealous"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "454714",
          "text": "Sie ist auf meinen Erfolg neidisch.",
          "translation": "Она завидует моему успеху.",
          "source": "Tatoeba #454714 @xtofu80 / #351716 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454714",
          "cefr_level": "A1",
          "word_slugs": [
            "neidisch-adj"
          ]
        },
        {
          "id": "2380139",
          "text": "Sie waren alle auf mein neues Auto neidisch.",
          "translation": "Все они завидовали моей новой машине.",
          "source": "Tatoeba #2380139 @Pfirsichbaeumchen / #816368 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2380139",
          "cefr_level": "A1",
          "word_slugs": [
            "neidisch-adj"
          ]
        },
        {
          "id": "515321",
          "text": "Sie war neidisch auf den Erfolg ihres Vetters.",
          "translation": "Она завидовала успеху двоюродного брата.",
          "source": "Tatoeba #515321 @MUIRIEL / #11947666 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/515321",
          "cefr_level": "A1",
          "word_slugs": [
            "neidisch-adj"
          ]
        },
        {
          "id": "3679894",
          "text": "Sogar der Mond war auf ihre Schönheit neidisch.",
          "translation": "Даже луна завидовала её красоте.",
          "source": "Tatoeba #3679894 @brauchinet / #3681486 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3679894",
          "cefr_level": "A1",
          "word_slugs": [
            "neidisch-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
