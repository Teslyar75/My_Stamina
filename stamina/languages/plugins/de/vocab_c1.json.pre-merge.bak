    {
      "slug": "grossteil-noun",
      "lemma": "Großteil",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8999,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "большая часть"
        ],
        "en": [
          "Switzerland and Liechtenstein standard spelling of Großteil"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2126098",
          "text": "Es war zum Großteil seine eigene Schuld.",
          "translation": "По большей части он был сам виноват.",
          "source": "Tatoeba #2126098 @Tamy / #13361349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2126098",
          "cefr_level": "A1",
          "word_slugs": [
            "grossteil-noun"
          ]
        },
        {
          "id": "4010108",
          "text": "Tom lebte den Großteil seines Lebens in Boston.",
          "translation": "Том прожил в Бостоне большую часть своей жизни.",
          "source": "Tatoeba #4010108 @pullnosemans / #3948342 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4010108",
          "cefr_level": "A1",
          "word_slugs": [
            "grossteil-noun"
          ]
        },
        {
          "id": "655395",
          "text": "Ein Großteil der Studenten kam von der Westküste.",
          "translation": "Большая часть студентов прибыла с западного побережья.",
          "source": "Tatoeba #655395 @al_ex_an_der / #1993436 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/655395",
          "cefr_level": "A1",
          "word_slugs": [
            "grossteil-noun"
          ]
        },
        {
          "id": "4010104",
          "text": "Tom hat den Großteil seines Lebens in Boston gelebt.",
          "translation": "Том большую часть жизни прожил в Бостоне.",
          "source": "Tatoeba #4010104 @pullnosemans / #13655881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4010104",
          "cefr_level": "A1",
          "word_slugs": [
            "grossteil-noun"
          ]
        },
        {
          "id": "2491644",
          "text": "Tom verbringt einen Großteil seiner Zeit damit, Mary zu helfen.",
          "translation": "Том проводит большую часть своего времени, помогая Мэри.",
          "source": "Tatoeba #2491644 @Zaghawa / #3248878 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2491644",
          "cefr_level": "A1",
          "word_slugs": [
            "grossteil-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Großteil",
        "nominative_pl": ""
      }
