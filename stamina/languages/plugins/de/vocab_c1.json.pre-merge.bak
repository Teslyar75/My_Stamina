      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8751,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "наглый",
          "нахальный",
          "бесстыдный",
          "бессовестный"
        ],
        "en": [
          "impertinent (insolent, ill-mannered)",
          "exorbitant, steep"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3937718",
          "text": "Sei nicht unverschämt!",
          "translation": "Не будь наглым!",
          "source": "Tatoeba #3937718 @Dani6187 / #9976504 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3937718",
          "cefr_level": "A1",
          "word_slugs": [
            "unverschämt-adj"
          ]
        },
        {
          "id": "4575088",
          "text": "Sprich nicht so unverschämt.",
          "translation": "Не разговаривай так нахально.",
          "source": "Tatoeba #4575088 @Juri / #4575916 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4575088",
          "cefr_level": "A1",
          "word_slugs": [
            "unverschämt-adj"
          ]
        },
        {
          "id": "12890058",
          "text": "Ist sie unschuldig oder einfach unverschämt?",
          "translation": "Она невинная или просто бесстыжая?",
          "source": "Tatoeba #12890058 @Waldelfe / #6390317 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12890058",
          "cefr_level": "A1",
          "word_slugs": [
            "unverschämt-adj"
          ]
        },
        {
          "id": "756148",
          "text": "Er war so unverschämt, meinen Rat zu ignorieren.",
          "translation": "Он имел наглость проигнорировать мой совет.",
          "source": "Tatoeba #756148 @xtofu80 / #936072 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/756148",
          "cefr_level": "A1",
          "word_slugs": [
            "unverschämt-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
