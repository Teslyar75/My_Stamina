          ]
        },
        {
          "id": "11147128",
          "text": "Tom hat sehr hohe Erwartungen.",
          "translation": "У Тома очень высокие ожидания.",
          "source": "Tatoeba #11147128 @Pfirsichbaeumchen / #5520541 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11147128",
          "cefr_level": "A1",
