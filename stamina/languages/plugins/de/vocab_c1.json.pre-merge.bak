    {
      "slug": "gespürt-verb",
      "lemma": "gespürt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5241,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of spüren"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3778642",
          "text": "Ich habe nichts gespürt.",
          "translation": "Я ничего не почувствовала.",
          "source": "Tatoeba #3778642 @Esperantostern / #3541807 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3778642",
          "cefr_level": "A1",
          "word_slugs": [
            "gespürt-verb"
          ]
        },
        {
          "id": "2900888",
          "text": "Haben Sie den Widerstand gespürt?",
          "translation": "Вы ощущали сопротивление?",
          "source": "Tatoeba #2900888 @Pfirsichbaeumchen / #2507400 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2900888",
          "cefr_level": "A1",
          "word_slugs": [
            "gespürt-verb"
          ]
        },
        {
          "id": "2188337",
          "text": "Ich habe sofort gespürt, dass irgendetwas nicht stimmte.",
          "translation": "Я сразу почувствовал, что что-то не так.",
          "source": "Tatoeba #2188337 @Vortarulo / #3013806 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2188337",
          "cefr_level": "A1",
          "word_slugs": [
            "gespürt-verb"
          ]
        },
        {
          "id": "4127272",
          "text": "Eine Neugier ergriff mich, wie ich sie noch nie gespürt.",
          "translation": "Меня охватило любопытство, подобного которому я ещё не ощущал.",
          "source": "Tatoeba #4127272 @Pfirsichbaeumchen / #4136529 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4127272",
          "cefr_level": "A1",
          "word_slugs": [
            "gespürt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
