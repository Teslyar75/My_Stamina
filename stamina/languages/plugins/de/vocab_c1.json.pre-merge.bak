    {
      "slug": "ziege-noun",
      "lemma": "Ziege",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5676,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "goat",
          "a stupid, stubborn person (usually female)",
          "ziege (freshwater fish)",
          "GOAT (greatest of all time; or, an exceptionally talented person)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1714656",
          "text": "Ich melke meine Ziege.",
          "translation": "Я дою свою козу.",
          "source": "Tatoeba #1714656 @Pfirsichbaeumchen / #4922474 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1714656",
          "cefr_level": "A1",
          "word_slugs": [
            "ziege-noun"
          ]
        },
        {
          "id": "8887214",
          "text": "Hast du die Ziege gemolken?",
          "translation": "Ты подоил козу?",
          "source": "Tatoeba #8887214 @maaster / #8887384 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8887214",
          "cefr_level": "A1",
          "word_slugs": [
            "ziege-noun"
          ]
        },
        {
          "id": "4508666",
          "text": "Eine Ziege grast auf dem Feld.",
          "translation": "Коза пасётся на поле.",
          "source": "Tatoeba #4508666 @Esperantostern / #6689806 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4508666",
          "cefr_level": "A1",
          "word_slugs": [
            "ziege-noun"
          ]
        },
        {
          "id": "3148947",
          "text": "Die Ziege war die Kuh der Armen.",
          "translation": "Коза была коровой бедных.",
          "source": "Tatoeba #3148947 @faehrmann / #2847443 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3148947",
          "cefr_level": "A1",
          "word_slugs": [
            "ziege-noun"
          ]
        },
        {
          "id": "6380349",
          "text": "Die Ziege fraß ihr aus der Hand.",
          "translation": "Коза ела с её руки.",
          "source": "Tatoeba #6380349 @Pfirsichbaeumchen / #5218357 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6380349",
          "cefr_level": "A1",
