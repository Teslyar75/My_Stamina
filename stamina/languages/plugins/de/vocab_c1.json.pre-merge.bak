          ]
        },
        {
          "id": "2363318",
          "text": "Mary mag Nüsse.",
          "translation": "Мэри любит орехи.",
          "source": "Tatoeba #2363318 @Vortarulo / #5685446 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2363318",
          "cefr_level": "A1",
          "word_slugs": [
            "nüsse-noun"
          ]
        },
        {
          "id": "885289",
          "text": "Sie sammeln Nüsse.",
          "translation": "Они собирают орехи.",
          "source": "Tatoeba #885289 @jakov / #2467176 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/885289",
          "cefr_level": "A1",
          "word_slugs": [
