          "cefr_level": "A1",
          "word_slugs": [
            "japanische-name"
          ]
        },
        {
          "id": "4065792",
          "text": "Meine Muttersprache ist das Japanische.",
          "translation": "Мой родной язык — японский.",
          "source": "Tatoeba #4065792 @Pfirsichbaeumchen / #407904 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4065792",
          "cefr_level": "A1",
          "word_slugs": [
            "japanische-name"
          ]
        },
        {
          "id": "497267",
          "text": "Übersetze diesen Satz bitte ins Japanische.",
          "translation": "Пожалуйста, переведи это предложение на японский.",
