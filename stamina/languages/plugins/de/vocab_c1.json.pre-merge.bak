    {
      "slug": "journalisten-noun",
      "lemma": "Journalisten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7915,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Journalist",
          "dative singular of Journalist",
          "accusative singular of Journalist",
          "nominative plural of Journalist"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4413291",
          "text": "Wir sind Journalisten.",
          "translation": "Мы журналисты.",
          "source": "Tatoeba #4413291 @Dokuyaku / #2869551 @svetla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4413291",
          "cefr_level": "A1",
          "word_slugs": [
            "journalisten-noun"
          ]
        },
        {
          "id": "13972828",
          "text": "Wir brauchen mehr Journalisten.",
          "translation": "Нам нужно больше журналистов.",
          "source": "Tatoeba #13972828 @AaronAardvark / #13973524 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13972828",
          "cefr_level": "A1",
          "word_slugs": [
            "journalisten-noun"
          ]
        },
        {
          "id": "3034430",
          "text": "Die Journalisten sprechen bereits darüber.",
          "translation": "Об этом уже говорят журналисты.",
          "source": "Tatoeba #3034430 @al_ex_an_der / #3034428 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3034430",
          "cefr_level": "A1",
          "word_slugs": [
            "journalisten-noun"
          ]
        },
        {
          "id": "13696450",
          "text": "Er gab ein Statement für die Journalisten ab.",
          "translation": "Он сделал заявление для журналистов.",
          "source": "Tatoeba #13696450 @Juri / #12448122 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13696450",
          "cefr_level": "A1",
          "word_slugs": [
            "journalisten-noun"
          ]
        },
        {
          "id": "12870065",
          "text": "Heute haben wir ein Treffen mit ausländischen Journalisten.",
          "translation": "Сегодня у нас встреча с иностранными журналистами.",
          "source": "Tatoeba #12870065 @Waldelfe / #12870061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12870065",
          "cefr_level": "A1",
          "word_slugs": [
            "journalisten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
