    {
      "slug": "verlorenen-adj",
      "lemma": "verlorenen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9020,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verloren:",
          "strong genitive masculine/neuter singular",
          "inflection of verloren:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12593012",
          "text": "Ich habe den verlorenen Bleistift gefunden.",
          "translation": "Я нашёл потерянный карандаш.",
          "source": "Tatoeba #12593012 @Waldelfe / #3989016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12593012",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorenen-adj"
          ]
        },
        {
          "id": "1391351",
          "text": "Sie hat endlich ihre verlorenen Schlüssel gefunden.",
          "translation": "Она наконец нашла потерянные ключи.",
          "source": "Tatoeba #1391351 @Pfirsichbaeumchen / #9399366 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1391351",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorenen-adj"
          ]
        },
        {
          "id": "1935771",
          "text": "Ich habe den verlorenen Ball im Park gefunden.",
          "translation": "Я нашёл потерянный мяч в парке.",
          "source": "Tatoeba #1935771 @Alois / #13977897 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1935771",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorenen-adj"
          ]
        },
        {
          "id": "1065580",
          "text": "Sie fand den verlorenen Tag durch eine Zeitungsannonce.",
          "translation": "Она нашла потерянный день через объявление в газете.",
          "source": "Tatoeba #1065580 @Esperantostern / #2122807 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1065580",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorenen-adj"
          ]
        },
        {
          "id": "1835273",
          "text": "Sie begab sich auf die Suche nach ihrem verlorenen Kind.",
          "translation": "Она пустилась на поиски своего пропавшего ребёнка.",
          "source": "Tatoeba #1835273 @Tamy / #8187006 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1835273",
          "cefr_level": "A1",
          "word_slugs": [
            "verlorenen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
