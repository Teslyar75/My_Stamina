    {
      "slug": "formen-noun",
      "lemma": "Formen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6915,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Form"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13929958",
          "text": "Beide Formen sind gleichermaßen richtig.",
          "translation": "Обе формы одинаково правильны.",
          "source": "Tatoeba #13929958 @ninefi / #13932646 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13929958",
          "cefr_level": "A1",
          "word_slugs": [
            "formen-noun"
          ]
        },
        {
          "id": "13929959",
          "text": "Beide Formen sind gleichermaßen korrekt.",
          "translation": "Обе формы одинаково правильны.",
          "source": "Tatoeba #13929959 @ninefi / #13932646 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13929959",
          "cefr_level": "A1",
          "word_slugs": [
            "formen-noun"
          ]
        },
        {
          "id": "12391198",
          "text": "Wir verurteilen den Terrorismus in all seinen Formen.",
          "translation": "Мы осуждаем терроризм во всех его формах.",
          "source": "Tatoeba #12391198 @mhr / #12388227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12391198",
          "cefr_level": "A1",
          "word_slugs": [
            "formen-noun"
          ]
        },
        {
          "id": "3260181",
          "text": "Fungiert dieses Wort als Adverb, erlaubt die Akademie beide Formen.",
          "translation": "Когда это слово выполняет функции наречия, Академия позволяет обе формы.",
          "source": "Tatoeba #3260181 @al_ex_an_der / #3261020 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3260181",
          "cefr_level": "A1",
          "word_slugs": [
            "formen-noun"
          ]
        },
        {
          "id": "13727675",
          "text": "Diese Formen sind für die Kommunikation in jeder Sprache unerlässlich.",
          "translation": "Эти формы необходимы для общения на любом языке.",
          "source": "Tatoeba #13727675 @carlosalberto / #13727676 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13727675",
          "cefr_level": "A1",
          "word_slugs": [
            "formen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
