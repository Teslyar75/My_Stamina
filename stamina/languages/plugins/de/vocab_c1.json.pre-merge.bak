    {
      "slug": "schlauer-adj",
      "lemma": "schlauer",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5741,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schlau:",
          "strong/mixed nominative masculine singular",
          "inflection of schlau:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1946721",
          "text": "Tom ist ein schlauer Kopf.",
          "translation": "Том - светлая голова.",
          "source": "Tatoeba #1946721 @Pfirsichbaeumchen / #4955962 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1946721",
          "cefr_level": "A1",
          "word_slugs": [
            "schlauer-adj"
          ]
        },
        {
          "id": "3996458",
          "text": "Hinterher ist man immer schlauer.",
          "translation": "Задним умом все крепки.",
          "source": "Tatoeba #3996458 @Esperantostern / #3617292 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3996458",
          "cefr_level": "A1",
          "word_slugs": [
            "schlauer-adj"
          ]
        },
        {
          "id": "10132467",
          "text": "Er ist viel schlauer als ich.",
          "translation": "Он намного умнее меня.",
          "source": "Tatoeba #10132467 @wolfgangth / #2176441 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10132467",
          "cefr_level": "A1",
          "word_slugs": [
            "schlauer-adj"
          ]
        },
        {
          "id": "4944625",
          "text": "Er ist schlauer als alle anderen.",
          "translation": "Он хитрее всех.",
          "source": "Tatoeba #4944625 @Manfredo / #6404949 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4944625",
          "cefr_level": "A1",
          "word_slugs": [
            "schlauer-adj"
          ]
        },
        {
          "id": "1800553",
          "text": "Bücher lesen wird Sie schlauer machen.",
          "translation": "Чтение книг сделает Вас умнее.",
          "source": "Tatoeba #1800553 @Tamy / #5043006 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1800553",
          "cefr_level": "A1",
          "word_slugs": [
            "schlauer-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
