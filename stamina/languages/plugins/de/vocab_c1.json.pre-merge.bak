    {
      "slug": "ausgestellt-verb",
      "lemma": "ausgestellt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9159,
      "frequency_band": "goethe-c1",
      "translations": {
