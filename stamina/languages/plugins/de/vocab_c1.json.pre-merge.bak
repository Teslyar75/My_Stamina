    {
      "slug": "piloten-noun",
      "lemma": "Piloten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5285,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Pilot",
          "plural of Pilot"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "594402",
          "text": "Sie sind Piloten.",
          "translation": "Они пилоты.",
          "source": "Tatoeba #594402 @samueldora / #981770 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/594402",
          "cefr_level": "A1",
          "word_slugs": [
            "piloten-noun"
          ]
        },
        {
          "id": "13831593",
          "text": "Wir sind Piloten.",
          "translation": "Мы лётчики.",
          "source": "Tatoeba #13831593 @scaui0 / #11136270 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13831593",
          "cefr_level": "A1",
          "word_slugs": [
            "piloten-noun"
          ]
        },
        {
          "id": "1695911",
          "text": "Es besteht dringender Bedarf an erfahrenen Piloten.",
          "translation": "Срочно требуются опытные пилоты.",
          "source": "Tatoeba #1695911 @Pfirsichbaeumchen / #4415160 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1695911",
          "cefr_level": "A1",
          "word_slugs": [
            "piloten-noun"
          ]
        },
        {
          "id": "6573906",
          "text": "Tom und ich, wir sind Piloten. Wir interessieren uns nur für Flugzeuge.",
          "translation": "Мы с Томом пилоты. Нас интересуют только самолёты.",
          "source": "Tatoeba #6573906 @Pfirsichbaeumchen / #5525933 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6573906",
          "cefr_level": "A1",
          "word_slugs": [
            "piloten-noun"
          ]
        },
        {
          "id": "1047369",
          "text": "Piloten kommunizieren mit dem Flughafen per Funk.",
          "translation": "Пилоты связываются с аэропортом по радио.",
          "source": "Tatoeba #1047369 @tatomeimei / #6484448 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1047369",
          "cefr_level": "A1",
          "word_slugs": [
            "piloten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
