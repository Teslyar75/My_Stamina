    {
      "slug": "vergangenen-adj",
      "lemma": "vergangenen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7581,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of vergangen:",
          "strong genitive masculine/neuter singular",
          "inflection of vergangen:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3268203",
          "text": "Tom starb im vergangenen Jahr.",
          "translation": "Том умер в прошлом году.",
          "source": "Tatoeba #3268203 @al_ex_an_der / #3268194 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3268203",
          "cefr_level": "A1",
          "word_slugs": [
            "vergangenen-adj"
          ]
        },
        {
          "id": "3561614",
          "text": "Vergangenen Schmerz muss man vergessen.",
          "translation": "Нужно забыть прошедшую боль.",
          "source": "Tatoeba #3561614 @al_ex_an_der / #3561632 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3561614",
          "cefr_level": "A1",
          "word_slugs": [
            "vergangenen-adj"
          ]
        },
        {
          "id": "12391150",
          "text": "Im vergangenen Jahr starb mein Vater.",
          "translation": "В прошлом году у меня умер отец.",
          "source": "Tatoeba #12391150 @mhr / #8635883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12391150",
          "cefr_level": "A1",
          "word_slugs": [
            "vergangenen-adj"
          ]
        },
        {
          "id": "1606408",
          "text": "Er war im vergangenen Jahr in Kyōto.",
          "translation": "В прошлом году он был в Киото.",
          "source": "Tatoeba #1606408 @Pfirsichbaeumchen / #1580781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1606408",
          "cefr_level": "A1",
          "word_slugs": [
            "vergangenen-adj"
          ]
        },
        {
          "id": "2304804",
          "text": "Wo haben Sie im vergangenen Jahr gewohnt?",
          "translation": "Где вы жили в прошлом году?",
          "source": "Tatoeba #2304804 @Pfirsichbaeumchen / #826772 @Patissier (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2304804",
          "cefr_level": "A1",
          "word_slugs": [
            "vergangenen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
