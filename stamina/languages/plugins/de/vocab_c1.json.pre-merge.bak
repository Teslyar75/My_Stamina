    {
      "slug": "abhängig-adj",
      "lemma": "abhängig",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6240,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "зависимый"
