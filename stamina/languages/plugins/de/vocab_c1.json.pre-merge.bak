          ]
        },
        {
          "id": "8705811",
          "text": "Tom ist finanziell unabhängig.",
          "translation": "Том финансово независим.",
          "source": "Tatoeba #8705811 @Pfirsichbaeumchen / #5989574 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8705811",
          "cefr_level": "A1",
          "word_slugs": [
            "unabhängig-adj"
          ]
        },
        {
          "id": "442735",
          "text": "Er ist finanziell unabhängig geworden.",
          "translation": "Он стал финансово независимым.",
          "source": "Tatoeba #442735 @MUIRIEL / #4849185 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/442735",
          "cefr_level": "A1",
          "word_slugs": [
            "unabhängig-adj"
          ]
        },
        {
          "id": "12862091",
          "text": "Sie lebt unabhängig, seit sie 18 war.",
          "translation": "Она с восемнадцати лет живёт самостоятельно.",
          "source": "Tatoeba #12862091 @Waldelfe / #12988200 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12862091",
          "cefr_level": "A1",
          "word_slugs": [
            "unabhängig-adj"
          ]
        },
        {
          "id": "13741891",
          "text": "Ich will, daß Korsika unabhängig wird!",
          "translation": "Я хочу, чтобы Корсика стала независимой!",
          "source": "Tatoeba #13741891 @Waldelfe / #13768310 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13741891",
          "cefr_level": "A1",
          "word_slugs": [
            "unabhängig-adj"
          ]
        }
      ],
