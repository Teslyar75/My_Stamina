    {
      "slug": "risiken-noun",
      "lemma": "Risiken",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6175,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Risiko"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12925346",
          "text": "Er kannte die Risiken.",
          "translation": "Он знал о рисках.",
          "source": "Tatoeba #12925346 @mhr / #12925276 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12925346",
          "cefr_level": "A1",
          "word_slugs": [
            "risiken-noun"
          ]
        },
        {
          "id": "12925343",
          "text": "Wir kannten die Risiken.",
          "translation": "Мы знали о рисках.",
          "source": "Tatoeba #12925343 @mhr / #12925275 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12925343",
          "cefr_level": "A1",
          "word_slugs": [
            "risiken-noun"
          ]
        },
        {
          "id": "12983053",
          "text": "Auch eine Impfung birgt Risiken.",
          "translation": "Вакцинация тоже несёт в себе риски.",
          "source": "Tatoeba #12983053 @mhr / #12984319 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12983053",
          "cefr_level": "A1",
          "word_slugs": [
            "risiken-noun"
          ]
        },
        {
          "id": "1811030",
          "text": "Ich hasse es, Risiken einzugehen.",
          "translation": "Я ненавижу рисковать.",
          "source": "Tatoeba #1811030 @Tamy / #12203929 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1811030",
          "cefr_level": "A1",
          "word_slugs": [
            "risiken-noun"
          ]
        },
        {
          "id": "168",
          "text": "Um das zu tun, musst du Risiken eingehen.",
          "translation": "Ты должен рискнуть, чтобы сделать это.",
          "source": "Tatoeba #168 @MUIRIEL / #5500 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/168",
          "cefr_level": "A1",
          "word_slugs": [
            "risiken-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "schrie-verb",
      "lemma": "schrie",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6176,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schreien:",
          "first/third-person singular preterite",
          "inflection of schreien:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6618972",
          "text": "Tom schrie nicht.",
          "translation": "Том не кричал.",
          "source": "Tatoeba #6618972 @Felixjp / #6932275 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6618972",
          "cefr_level": "A1",
          "word_slugs": [
            "schrie-verb"
          ]
        },
        {
          "id": "12862800",
          "text": "Tom schrie etwas.",
          "translation": "Том что-то прокричал.",
          "source": "Tatoeba #12862800 @Waldelfe / #12855272 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12862800",
          "cefr_level": "A1",
          "word_slugs": [
            "schrie-verb"
          ]
        },
        {
          "id": "1255009",
          "text": "\"Feuer!\", schrie er.",
          "translation": "\"Пожар!\" - закричал он.",
          "source": "Tatoeba #1255009 @BraveSentry / #3199756 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1255009",
          "cefr_level": "A1",
          "word_slugs": [
            "schrie-verb"
          ]
        },
        {
          "id": "4357482",
          "text": "„Hilfe, Hilfe“, schrie sie.",
          "translation": "\"Помогите, помогите\", - закричала она.",
          "source": "Tatoeba #4357482 @Esperantostern / #12137773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4357482",
          "cefr_level": "A1",
          "word_slugs": [
            "schrie-verb"
          ]
        },
        {
          "id": "982054",
          "text": "Er schrie vor Schmerz auf.",
          "translation": "Он вскрикнул от боли.",
          "source": "Tatoeba #982054 @Sudajaengi / #6080930 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/982054",
          "cefr_level": "A1",
          "word_slugs": [
            "schrie-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "beeinflusst-verb",
      "lemma": "beeinflusst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6177,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of beeinflussen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13264291",
          "text": "Das Wetter beeinflusst meine Stimmung.",
          "translation": "Погода влияет на моё настроение.",
          "source": "Tatoeba #13264291 @maaster / #10968533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13264291",
          "cefr_level": "A1",
          "word_slugs": [
            "beeinflusst-verb"
          ]
        },
        {
          "id": "9952786",
          "text": "Alles, was wir sehen, beeinflusst uns irgendwie.",
          "translation": "Всё, что мы видим, как-то на нас влияет.",
          "source": "Tatoeba #9952786 @carlosalberto / #9952700 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9952786",
          "cefr_level": "A1",
          "word_slugs": [
            "beeinflusst-verb"
          ]
        },
        {
          "id": "1976836",
          "text": "Wie beeinflusst das Internet das menschliche Gedächtnis?",
          "translation": "Как повлияет интернет на человеческую память?",
          "source": "Tatoeba #1976836 @al_ex_an_der / #1976833 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1976836",
          "cefr_level": "A1",
          "word_slugs": [
            "beeinflusst-verb"
          ]
        },
        {
          "id": "146",
          "text": "Wahrscheinlich war es das, was ihre Entscheidung beeinflusst hat.",
          "translation": "Скорее всего, это и повлияло на их решение.",
          "source": "Tatoeba #146 @MUIRIEL / #5478 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/146",
          "cefr_level": "A1",
          "word_slugs": [
            "beeinflusst-verb"
          ]
        },
        {
          "id": "1523180",
          "text": "Diese Einstellung, die protestantische Arbeitsethik, beeinflusst Amerikaner noch heute.",
          "translation": "Эта установка, протестантская этика труда, оказывает влияние на американцев и сегодня.",
          "source": "Tatoeba #1523180 @samueldora / #1525355 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1523180",
          "cefr_level": "A1",
          "word_slugs": [
            "beeinflusst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
