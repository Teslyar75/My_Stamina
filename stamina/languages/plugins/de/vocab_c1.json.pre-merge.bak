          "cefr_level": "A1",
          "word_slugs": [
            "gedeckt-verb"
          ]
        },
        {
          "id": "920143",
          "text": "Das Dach ist mit gelben Ziegeln gedeckt.",
          "translation": "Крыша покрыта жёлтой черепицей.",
          "source": "Tatoeba #920143 @Esperantostern / #13669621 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/920143",
          "cefr_level": "A1",
