    {
      "slug": "menschlichkeit-noun",
      "lemma": "Menschlichkeit",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8460,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "человечество"
        ],
        "en": [
          "humanity (the condition or quality of being human)",
          "humanity (the quality of being humane)",
          "a human(e) trait or deed, e.g. a weakness or an act of sympathy"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2847906",
          "text": "Tierschutz ist Erziehung zur Menschlichkeit.",
          "translation": "Защита животных — это воспитание человечности.",
          "source": "Tatoeba #2847906 @Esperantostern / #13822271 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2847906",
          "cefr_level": "A1",
          "word_slugs": [
            "menschlichkeit-noun"
          ]
        },
        {
          "id": "11740211",
          "text": "Die Menschlichkeit hat ein grenzenloses Potenzial.",
          "translation": "У человечества безграничный потенциал.",
          "source": "Tatoeba #11740211 @mhr / #12416533 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11740211",
          "cefr_level": "A1",
          "word_slugs": [
            "menschlichkeit-noun"
          ]
        },
        {
          "id": "2903282",
          "text": "Das ist ein Verbrechen gegen die Menschlichkeit.",
          "translation": "Это преступление против человечности!",
          "source": "Tatoeba #2903282 @brauchinet / #4602369 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2903282",
          "cefr_level": "A1",
          "word_slugs": [
            "menschlichkeit-noun"
          ]
        },
        {
          "id": "138821",
          "text": "Krieg ist ein Verbrechen gegen die Menschlichkeit.",
          "translation": "Война — это преступление против человечности.",
          "source": "Tatoeba #138821 @MUIRIEL / #469540 @ArsWalrus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/138821",
          "cefr_level": "A1",
          "word_slugs": [
            "menschlichkeit-noun"
          ]
        },
        {
          "id": "11115098",
          "text": "Die Sklaverei ist ein Verbrechen gegen die Menschlichkeit.",
          "translation": "Порабощение — это преступление против человечества.",
          "source": "Tatoeba #11115098 @Pfirsichbaeumchen / #3760252 @Robertpaulson (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11115098",
          "cefr_level": "A1",
          "word_slugs": [
            "menschlichkeit-noun"
          ]
        }
      ],
