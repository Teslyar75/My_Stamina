    {
      "slug": "käufer-noun",
      "lemma": "Käufer",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5879,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "покупатель"
        ],
        "en": [
          "agent noun of kaufen; shopper, buyer"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1891586",
          "text": "Hat der Käufer immer recht?",
          "translation": "Покупатель всегда прав?",
          "source": "Tatoeba #1891586 @al_ex_an_der / #1891581 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1891586",
          "cefr_level": "A1",
          "word_slugs": [
            "käufer-noun"
          ]
        },
        {
          "id": "8627321",
          "text": "Ich hoffe, ich kann dafür einen Käufer finden.",
          "translation": "Я надеюсь, что смогу найти покупателя для этого.",
          "source": "Tatoeba #8627321 @Melang / #8687461 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8627321",
          "cefr_level": "A1",
          "word_slugs": [
            "käufer-noun"
          ]
        },
        {
          "id": "1759185",
          "text": "Der Käufer hat oft keine Ahnung, was er kauft.",
          "translation": "Покупатель часто не знает, что он покупает.",
          "source": "Tatoeba #1759185 @al_ex_an_der / #1759184 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1759185",
          "cefr_level": "A1",
          "word_slugs": [
            "käufer-noun"
          ]
        },
        {
          "id": "480342",
          "text": "Sie haben immer noch keinen Käufer für das Haus gefunden.",
          "translation": "Они всё ещё не нашли покупателя на этот дом.",
          "source": "Tatoeba #480342 @Ullalia / #13063036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/480342",
          "cefr_level": "A1",
          "word_slugs": [
            "käufer-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Käufer",
        "nominative_pl": ""
      }
