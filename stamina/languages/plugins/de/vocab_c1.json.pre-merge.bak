      "cefr_level": "C1",
      "frequency_rank": 8899,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "14016640",
          "text": "Nikolaus II. hatte es verdient.",
          "translation": "Николай II сам напросился.",
          "source": "Tatoeba #14016640 @rul / #13428078 @rul (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14016640",
          "cefr_level": "A1",
          "word_slugs": [
            "ii-noun"
          ]
        },
        {
          "id": "13414013",
          "text": "Ramses II. war ein ägyptischer Pharaoh.",
          "translation": "Рамзес II был египетским фараоном.",
          "source": "Tatoeba #13414013 @Vortarulo / #4859325 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13414013",
          "cefr_level": "A1",
          "word_slugs": [
            "ii-noun"
          ]
        },
        {
          "id": "344428",
          "text": "Elisabeth II. ist die Königin von England.",
          "translation": "Елизавета II - королева Англии.",
          "source": "Tatoeba #344428 @MUIRIEL / #8269048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344428",
          "cefr_level": "A1",
          "word_slugs": [
            "ii-noun"
          ]
        },
        {
          "id": "11145509",
          "text": "Nikolaus II. war der letzte russische Zar.",
          "translation": "Николай Второй был последним русским царём.",
          "source": "Tatoeba #11145509 @Pfirsichbaeumchen / #11147914 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11145509",
          "cefr_level": "A1",
          "word_slugs": [
            "ii-noun"
          ]
        },
        {
          "id": "6107623",
          "text": "Die Ägypter erbauten diesen Tempel zu Ehren von Pharao Ramses II.",
          "translation": "Египтяне построили этот храм в честь фараона Рамзеса Второго.",
          "source": "Tatoeba #6107623 @Pfirsichbaeumchen / #4535253 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6107623",
          "cefr_level": "A1",
          "word_slugs": [
            "ii-noun"
          ]
        }
