          "inflection of Same (“Sami person”):"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12491604",
          "text": "Vögel fressen Samen.",
          "translation": "Птицы едят семена.",
          "source": "Tatoeba #12491604 @Waldelfe / #13222826 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12491604",
          "cefr_level": "A1",
          "word_slugs": [
            "samen-noun"
          ]
        },
        {
          "id": "13348696",
          "text": "Die Samen sind auch eßbar.",
          "translation": "Семена также съедобны.",
          "source": "Tatoeba #13348696 @Waldelfe / #13403407 @yura (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13348696",
          "cefr_level": "A1",
          "word_slugs": [
            "samen-noun"
          ]
        },
        {
          "id": "2925862",
          "text": "Gibt es Wassermelonen ohne Samen?",
          "translation": "Есть ли арбузы без семечек?",
          "source": "Tatoeba #2925862 @mfabian / #3297778 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2925862",
          "cefr_level": "A1",
          "word_slugs": [
            "samen-noun"
          ]
        },
        {
          "id": "2761309",
          "text": "Aus dem kleinen Samen wurde ein großer Baum.",
          "translation": "Из маленького семечка выросло большое дерево.",
          "source": "Tatoeba #2761309 @al_ex_an_der / #7217636 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2761309",
          "cefr_level": "A1",
          "word_slugs": [
            "samen-noun"
          ]
        },
        {
          "id": "538103",
          "text": "Um zu keimen, brauchen Samen Luft und Wasser.",
          "translation": "Чтобы прорасти, семенам нужны воздух и вода.",
          "source": "Tatoeba #538103 @xtofu80 / #6330389 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/538103",
          "cefr_level": "A1",
          "word_slugs": [
            "samen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
