    {
      "slug": "gestattet-verb",
      "lemma": "gestattet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7159,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gestatten:",
          "third-person singular present",
          "inflection of gestatten:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "798160",
          "text": "Die Frage gestattet nur eine Deutung.",
          "translation": "Вопрос допускает только одну интерпретацию.",
          "source": "Tatoeba #798160 @Hans_Adler / #1136139 @mpffll (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/798160",
          "cefr_level": "A1",
          "word_slugs": [
            "gestattet-verb"
          ]
        },
        {
          "id": "3132392",
          "text": "Mein Vater gestattet mir nicht, nachts allein auszugehen.",
          "translation": "Мой отец не позволяет мне выходить ночью одному.",
          "source": "Tatoeba #3132392 @al_ex_an_der / #3132384 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3132392",
          "cefr_level": "A1",
          "word_slugs": [
            "gestattet-verb"
          ]
        },
        {
          "id": "4751535",
          "text": "Unbefugten ist das Betreten des Geländes nicht gestattet.",
          "translation": "Посторонним лицам вход на территорию запрещён.",
          "source": "Tatoeba #4751535 @raggione / #13934329 @Alex_M (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4751535",
          "cefr_level": "A1",
          "word_slugs": [
            "gestattet-verb"
          ]
        },
        {
          "id": "8695615",
          "text": "Reportern für die Presse ist der Zutritt nicht gestattet.",
          "translation": "Газетчикам не разрешили входить.",
          "source": "Tatoeba #8695615 @driini / #1576553 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8695615",
          "cefr_level": "A1",
          "word_slugs": [
            "gestattet-verb"
          ]
        },
        {
          "id": "2047793",
          "text": "Dieser Film ist für Jugendliche ab sechzehn Jahren gestattet.",
          "translation": "Этот фильм разрешён к просмотру лицам старше шестнадцати лет.",
          "source": "Tatoeba #2047793 @al_ex_an_der / #2047794 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2047793",
          "cefr_level": "A1",
          "word_slugs": [
            "gestattet-verb"
          ]
        }
