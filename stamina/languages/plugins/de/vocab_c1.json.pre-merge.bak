    {
      "slug": "ablegen-verb",
      "lemma": "ablegen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6477,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to take off",
          "to put aside",
          "to stop wearing",
          "to put aside"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1312764",
          "text": "Darf ich meinen Mantel ablegen?",
          "translation": "Могу я снять пальто?",
          "source": "Tatoeba #1312764 @al_ex_an_der / #1401477 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1312764",
          "cefr_level": "A1",
          "word_slugs": [
            "ablegen-verb"
          ]
        },
        {
          "id": "6770049",
          "text": "Ich muss niemandem Rechenschaft ablegen.",
          "translation": "Я ни перед кем не отчитываюсь.",
          "source": "Tatoeba #6770049 @Pfirsichbaeumchen / #6551115 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6770049",
          "cefr_level": "A1",
          "word_slugs": [
            "ablegen-verb"
          ]
        },
        {
          "id": "7193686",
          "text": "Wo kann ich meine Tasche ablegen?",
          "translation": "Куда я могу положить свою сумку?",
          "source": "Tatoeba #7193686 @Luiaard / #7912105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7193686",
          "cefr_level": "A1",
          "word_slugs": [
            "ablegen-verb"
          ]
        },
        {
          "id": "12159389",
          "text": "Du kannst deine Tasche hier ablegen.",
          "translation": "Можешь положить свою сумку сюда.",
          "source": "Tatoeba #12159389 @felix63 / #12159492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12159389",
          "cefr_level": "A1",
          "word_slugs": [
            "ablegen-verb"
          ]
        },
        {
          "id": "359561",
          "text": "Du musst diese schlechte Gewohnheit ablegen.",
          "translation": "Ты должен избавиться от этой дурной привычки.",
          "source": "Tatoeba #359561 @MUIRIEL / #2030677 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/359561",
          "cefr_level": "A1",
          "word_slugs": [
            "ablegen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
