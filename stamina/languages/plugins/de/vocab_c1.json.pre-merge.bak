    {
      "slug": "eingetroffen-verb",
      "lemma": "eingetroffen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7336,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of eintreffen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1246051",
          "text": "Der Abschleppwagen ist eingetroffen.",
          "translation": "Тягач прибыл.",
          "source": "Tatoeba #1246051 @PeterR / #2204561 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1246051",
          "cefr_level": "A1",
          "word_slugs": [
            "eingetroffen-verb"
          ]
        },
        {
          "id": "2974121",
          "text": "Ich bin gestern hier eingetroffen.",
          "translation": "Я прибыл сюда вчера.",
          "source": "Tatoeba #2974121 @Dani6187 / #407681 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2974121",
          "cefr_level": "A1",
          "word_slugs": [
            "eingetroffen-verb"
          ]
        },
        {
          "id": "12266690",
          "text": "Gestern ist er in Tokio eingetroffen.",
          "translation": "Вчера он приехал в Токио.",
          "source": "Tatoeba #12266690 @mhr / #2667462 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12266690",
          "cefr_level": "A1",
          "word_slugs": [
            "eingetroffen-verb"
          ]
        },
        {
          "id": "2463131",
          "text": "Es wurden mehrere Voraussagen gemacht. Doch keine dieser Voraussagen ist eingetroffen.",
          "translation": "Было сделано несколько предсказаний. Но ни одно из этих предсказаний не сбылось.",
          "source": "Tatoeba #2463131 @al_ex_an_der / #2463127 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2463131",
          "cefr_level": "A1",
          "word_slugs": [
            "eingetroffen-verb"
          ]
        }
