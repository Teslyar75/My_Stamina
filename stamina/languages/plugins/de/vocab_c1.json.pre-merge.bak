      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "учёба"
        ],
        "en": [
          "study (the act of studying in general)",
          "studies (higher education to get a degree at a university)",
          "study, examination (the act of looking at and examining minutely)",
          "university, school"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "773915",
          "text": "Wie läuft dein Studium?",
          "translation": "Как у тебя с учёбой?",
          "source": "Tatoeba #773915 @BraveSentry / #10631144 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/773915",
          "cefr_level": "A1",
          "word_slugs": [
            "studium-noun"
          ]
        },
        {
          "id": "14030301",
          "text": "Macht dir das Studium Spaß?",
          "translation": "Учёба приносит тебе удовольствие?",
          "source": "Tatoeba #14030301 @mhr / #14030350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14030301",
          "cefr_level": "A1",
          "word_slugs": [
            "studium-noun"
          ]
        },
        {
          "id": "8364220",
          "text": "Sie nimmt ihr Studium ernst.",
          "translation": "Она серьёзно относится к учёбе.",
          "source": "Tatoeba #8364220 @Luiaard / #13150720 @cointegrated (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8364220",
          "cefr_level": "A1",
          "word_slugs": [
            "studium-noun"
          ]
        },
        {
          "id": "7352597",
          "text": "Ich gehe zum Studium nach Boston.",
          "translation": "Я поеду учиться в Бостон.",
          "source": "Tatoeba #7352597 @Pfirsichbaeumchen / #6474612 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7352597",
          "cefr_level": "A1",
          "word_slugs": [
            "studium-noun"
          ]
        },
        {
          "id": "13782841",
          "text": "Ich konzentrierte mich auf mein Studium.",
          "translation": "Я сосредоточилась на занятиях.",
          "source": "Tatoeba #13782841 @Rovo / #13782847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13782841",
          "cefr_level": "A1",
          "word_slugs": [
            "studium-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
