    {
      "slug": "verheimlicht-verb",
      "lemma": "verheimlicht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8867,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verheimlichen:",
          "second-person plural present",
          "inflection of verheimlichen:",
          "third-person singular present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7525515",
          "text": "Verheimlicht ihr mir etwas?",
          "translation": "Вы что-то от меня скрываете?",
          "source": "Tatoeba #7525515 @Pfirsichbaeumchen / #7525517 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7525515",
          "cefr_level": "A1",
          "word_slugs": [
            "verheimlicht-verb"
          ]
        },
        {
          "id": "6845313",
          "text": "Tom verheimlicht Maria irgendetwas.",
          "translation": "Том что-то скрывает от Марии.",
          "source": "Tatoeba #6845313 @manese / #6845622 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6845313",
          "cefr_level": "A1",
          "word_slugs": [
            "verheimlicht-verb"
          ]
        },
        {
          "id": "13449759",
          "text": "Sie hat nichts vor ihnen verheimlicht.",
          "translation": "Она ничего от них не скрыла.",
          "source": "Tatoeba #13449759 @mhr / #13449559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13449759",
          "cefr_level": "A1",
          "word_slugs": [
            "verheimlicht-verb"
          ]
        },
        {
          "id": "7525541",
          "text": "Wie kommst du auf den Gedanken, dass Tom uns etwas verheimlicht?",
          "translation": "Как тебе вообще могло прийти в голову, что Том от нас что-то скрывает?",
          "source": "Tatoeba #7525541 @Pfirsichbaeumchen / #7525544 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7525541",
          "cefr_level": "A1",
          "word_slugs": [
            "verheimlicht-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
