    {
      "slug": "streichen-verb",
      "lemma": "streichen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5160,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "красить"
        ],
        "en": [
          "to stroke",
          "to cancel; to discard; to delete; to strike out; to cross out",
          "to spread; to rub; to apply",
          "to paint"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5956464",
          "text": "Ich will das Haus streichen.",
          "translation": "Я хочу покрасить дом.",
          "source": "Tatoeba #5956464 @list / #6158028 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5956464",
          "cefr_level": "A1",
          "word_slugs": [
            "streichen-verb"
          ]
        },
        {
          "id": "2328023",
          "text": "Sie streichen morgen den Zaun.",
          "translation": "Завтра покрасите забор.",
          "source": "Tatoeba #2328023 @Pfirsichbaeumchen / #13745257 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2328023",
          "cefr_level": "A1",
          "word_slugs": [
            "streichen-verb"
          ]
        },
        {
          "id": "2328034",
          "text": "Er wird morgen den Zaun streichen.",
          "translation": "Завтра он будет красить забор.",
          "source": "Tatoeba #2328034 @Pfirsichbaeumchen / #11274256 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2328034",
          "cefr_level": "A1",
          "word_slugs": [
            "streichen-verb"
          ]
        },
        {
          "id": "2328031",
          "text": "Sie wird morgen den Zaun streichen.",
          "translation": "Она покрасит забор завтра.",
          "source": "Tatoeba #2328031 @Pfirsichbaeumchen / #13745250 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2328031",
          "cefr_level": "A1",
          "word_slugs": [
            "streichen-verb"
          ]
        },
        {
          "id": "2328036",
          "text": "Du wirst morgen den Zaun streichen.",
          "translation": "Завтра покрасишь забор.",
          "source": "Tatoeba #2328036 @Pfirsichbaeumchen / #4976968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2328036",
          "cefr_level": "A1",
          "word_slugs": [
            "streichen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
