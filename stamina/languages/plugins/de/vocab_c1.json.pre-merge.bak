    {
      "slug": "messen-verb",
      "lemma": "messen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6808,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мерить",
          "измерять"
        ],
        "en": [
          "to measure (something) (to ascertain a quantity)",
          "to measure, to scrutinize (someone) (to look at judgingly)",
          "to compete",
          "to measure; to be a given size, height, width, length, etc."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12870045",
          "text": "Ich möchte Ihren Blutdruck messen.",
          "translation": "Я хотел бы проверить Ваше давление.",
          "source": "Tatoeba #12870045 @Waldelfe / #12870010 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12870045",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-verb"
          ]
        },
        {
          "id": "12870046",
          "text": "Ich möchte deinen Blutdruck messen.",
          "translation": "Я бы хотел проверить твоё кровяное давление.",
          "source": "Tatoeba #12870046 @Waldelfe / #5123479 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12870046",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-verb"
          ]
        },
        {
          "id": "10967405",
          "text": "Intelligenztests messen das abstrakte Denken.",
          "translation": "Тесты на интеллект измеряют абстрактное мышление.",
          "source": "Tatoeba #10967405 @p0wcr / #10968869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967405",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-verb"
          ]
        },
        {
          "id": "12638998",
          "text": "Ich werde jetzt Ihre Temperatur messen.",
          "translation": "Я сейчас измерю Вам температуру.",
          "source": "Tatoeba #12638998 @mhr / #12638933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12638998",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-verb"
          ]
        },
        {
          "id": "5974472",
          "text": "Die Windgeschwindigkeit lässt sich mit einem Schalenkreuzanemometer messen.",
          "translation": "Скорость ветра можно измерить с помощью чашечного анемометра.",
          "source": "Tatoeba #5974472 @raggione / #5976097 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5974472",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "messen-noun",
      "lemma": "Messen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6808,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of messen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14092543",
          "text": "Dieses Gerät dient zum Messen des Drucks.",
          "translation": "Это аппарат для измерения давления.",
          "source": "Tatoeba #14092543 @mhr / #14092540 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14092543",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-noun"
          ]
        },
        {
          "id": "14092542",
          "text": "Dieses Gerät dient zum Messen des Blutdrucks.",
          "translation": "Это аппарат для измерения давления.",
          "source": "Tatoeba #14092542 @mhr / #14092540 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14092542",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-noun"
          ]
        },
        {
          "id": "14092544",
          "text": "Ein Reifendruckmesser dient zum Messen des Reifendrucks.",
          "translation": "Автомобильный манометр служит для измерения давления в шинах.",
          "source": "Tatoeba #14092544 @mhr / #14092556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14092544",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-noun"
          ]
        },
        {
          "id": "14092545",
          "text": "Ein Reifendruckmessgerät dient zum Messen des Reifendrucks.",
          "translation": "Автомобильный манометр служит для измерения давления в шинах.",
          "source": "Tatoeba #14092545 @mhr / #14092556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14092545",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-noun"
          ]
        },
        {
          "id": "5974473",
          "text": "Zum Messen der Windgeschwindigkeit benutzt man im Allgemeinen ein Schalenkreuzanemometer.",
          "translation": "Для измерения скорости ветра, как правило, используют чашечный анемометр.",
          "source": "Tatoeba #5974473 @raggione / #5976087 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5974473",
          "cefr_level": "A1",
          "word_slugs": [
            "messen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
