    {
      "slug": "kamin-noun",
      "lemma": "Kamin",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6537,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "ками́н"
        ],
        "en": [
          "fireplace",
          "chimney"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12774079",
          "text": "Das ist ein moderner Kamin.",
          "translation": "Это современный камин.",
          "source": "Tatoeba #12774079 @mhr / #12773142 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12774079",
          "cefr_level": "A1",
          "word_slugs": [
            "kamin-noun"
          ]
        },
        {
          "id": "7423326",
          "text": "Ein Feuer knisterte im Kamin.",
          "translation": "В камине потрескивал огонь.",
          "source": "Tatoeba #7423326 @Pfirsichbaeumchen / #13944939 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7423326",
          "cefr_level": "A1",
          "word_slugs": [
            "kamin-noun"
          ]
        },
        {
          "id": "2593650",
          "text": "Im Kamin knisterte das Brennholz.",
          "translation": "В камине потрескивали дрова.",
          "source": "Tatoeba #2593650 @al_ex_an_der / #2593647 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2593650",
          "cefr_level": "A1",
          "word_slugs": [
            "kamin-noun"
          ]
        },
        {
          "id": "611421",
          "text": "Die Uhr ist über dem Kamin.",
          "translation": "Часы над камином.",
          "source": "Tatoeba #611421 @Dejo / #614668 @igor_chubin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/611421",
          "cefr_level": "A1",
          "word_slugs": [
            "kamin-noun"
          ]
        },
        {
          "id": "2459432",
          "text": "Der Kamin stößt schwarzen Qualm aus.",
          "translation": "Из камина валит черный дым.",
          "source": "Tatoeba #2459432 @Zaghawa / #4946553 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2459432",
          "cefr_level": "A1",
          "word_slugs": [
            "kamin-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
