    {
      "slug": "identisch-adj",
      "lemma": "identisch",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9509,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "идентичный",
          "одинаковый"
        ],
        "en": [
          "identical (to/with); the same as",
          "equivalent"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12771954",
          "text": "Alles ist mit etwas identisch.",
          "translation": "Всё идентично чему-то.",
          "source": "Tatoeba #12771954 @mhr / #12769547 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12771954",
          "cefr_level": "A1",
          "word_slugs": [
            "identisch-adj"
          ]
        },
        {
          "id": "7063265",
          "text": "Dein Stuhl ist identisch mit meinem.",
          "translation": "У тебя такой же стул, как у меня.",
          "source": "Tatoeba #7063265 @quicksanddiver / #10458916 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7063265",
          "cefr_level": "A1",
          "word_slugs": [
            "identisch-adj"
          ]
        },
        {
          "id": "13622465",
          "text": "Die sind identisch, abgesehen von der Farbe.",
          "translation": "Они одинаковые, если не считать цвета.",
          "source": "Tatoeba #13622465 @Waldelfe / #13622385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13622465",
          "cefr_level": "A1",
          "word_slugs": [
            "identisch-adj"
          ]
        },
        {
          "id": "13622471",
          "text": "Die sind identisch; nur die Farbe ist unterschiedlich.",
          "translation": "Они одинаковые, только цвет разный.",
          "source": "Tatoeba #13622471 @Waldelfe / #10919021 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13622471",
          "cefr_level": "A1",
          "word_slugs": [
            "identisch-adj"
          ]
        },
        {
          "id": "13622475",
          "text": "Die sind identisch; nur in der Farbe unterscheiden sie sich.",
          "translation": "Они одинаковые, только по цвету отличаются.",
          "source": "Tatoeba #13622475 @Waldelfe / #10919020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13622475",
          "cefr_level": "A1",
          "word_slugs": [
            "identisch-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der identisch",
