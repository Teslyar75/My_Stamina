    {
      "slug": "ausgabe-noun",
      "lemma": "Ausgabe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7967,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "раздача",
          "расход"
        ],
        "en": [
          "edition, issue (literary work)",
          "version, copy (of a book or booklet)",
          "expenditure, spending, expense",
          "output, readout, outputting"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13546920",
          "text": "Wir haben zu Hause dieselbe Ausgabe.",
          "translation": "У нас дома такое же издание.",
          "source": "Tatoeba #13546920 @mhr / #13546810 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13546920",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgabe-noun"
          ]
        },
        {
          "id": "13546925",
          "text": "Oh, ich habe genau dieselbe Ausgabe!",
          "translation": "О, у меня точно такое же издание!",
          "source": "Tatoeba #13546925 @mhr / #13546811 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13546925",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgabe-noun"
          ]
        },
        {
          "id": "13546931",
          "text": "Wir haben zu Hause die gleiche Ausgabe.",
          "translation": "У нас дома такое же издание.",
          "source": "Tatoeba #13546931 @mhr / #13546810 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13546931",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgabe-noun"
          ]
        },
        {
          "id": "13546934",
          "text": "Oh, ich habe genau die gleiche Ausgabe!",
          "translation": "О, у меня точно такое же издание!",
          "source": "Tatoeba #13546934 @mhr / #13546811 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13546934",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgabe-noun"
          ]
        },
        {
          "id": "7951513",
          "text": "Soviel ich weiß, ist das die neueste Ausgabe.",
          "translation": "Насколько я знаю, это самое последнее издание.",
          "source": "Tatoeba #7951513 @raggione / #13674086 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7951513",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgabe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
