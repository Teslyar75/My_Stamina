    {
      "slug": "bemühen-verb",
      "lemma": "bemühen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6737,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "стараться"
        ],
        "en": [
          "to make an effort",
          "to trouble oneself",
          "to employ, to cite, to trot out (of arguments, approaches, examples, now especially of ones considered trite or unconvincing)",
          "to betake oneself (to a location despite inconvenience)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12901449",
          "text": "Ich werde mich bemühen, ihr zu helfen.",
          "translation": "Я постараюсь ей помочь.",
          "source": "Tatoeba #12901449 @Waldelfe / #7921850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12901449",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühen-verb"
          ]
        },
        {
          "id": "1909299",
          "text": "Du musst dich einfach nur mehr bemühen!",
          "translation": "Тебе просто надо больше стараться!",
          "source": "Tatoeba #1909299 @Pfirsichbaeumchen / #5001553 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1909299",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühen-verb"
          ]
        },
        {
          "id": "11986849",
          "text": "Meine Kinder bemühen sich sehr, früh aufzustehen.",
          "translation": "Мои дети очень стараются рано вставать.",
          "source": "Tatoeba #11986849 @Pfirsichbaeumchen / #10487183 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11986849",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühen-verb"
          ]
        },
        {
          "id": "12159870",
          "text": "Wir bemühen uns, nach den Regeln zu spielen.",
          "translation": "Мы стараемся играть по правилам.",
          "source": "Tatoeba #12159870 @Pfirsichbaeumchen / #12159829 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12159870",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühen-verb"
          ]
        },
        {
          "id": "13701273",
          "text": "Wie oft bemühen Sie sich, anderen zu helfen?",
          "translation": "Как часто вы стараетесь помогать другим?",
          "source": "Tatoeba #13701273 @Waldelfe / #13701257 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13701273",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "bemühen-noun",
      "lemma": "Bemühen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6737,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of bemühen",
          "effort",
          "gerund of bemühen",
          "attempt, endeavor"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11227006",
          "text": "Bemühen Sie sich, mehr zu Fuß zu gehen.",
          "translation": "Старайтесь больше ходить пешком.",
          "source": "Tatoeba #11227006 @Pfirsichbaeumchen / #11226658 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11227006",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühen-noun"
          ]
        },
        {
          "id": "11227000",
          "text": "Bemühen Sie sich, öfter zu Fuß zu gehen.",
          "translation": "Старайтесь чаще ходить пешком.",
          "source": "Tatoeba #11227000 @Pfirsichbaeumchen / #11226660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11227000",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühen-noun"
          ]
        },
        {
          "id": "2588070",
          "text": "Bemühen Sie sich, darauf eine ehrliche Antwort zu geben!",
          "translation": "Постарайтесь дать на это честный ответ.",
          "source": "Tatoeba #2588070 @al_ex_an_der / #2588061 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2588070",
          "cefr_level": "A1",
          "word_slugs": [
            "bemühen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
