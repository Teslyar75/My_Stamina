    {
      "slug": "kassette-noun",
      "lemma": "Kassette",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8635,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "футляр",
          "кессон",
          "кассета"
        ],
        "en": [
          "cassette",
          "coffer"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4007660",
          "text": "Zeig mir die Kassette.",
          "translation": "Покажи мне кассету.",
          "source": "Tatoeba #4007660 @Zaghawa / #4007664 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4007660",
          "cefr_level": "A1",
          "word_slugs": [
            "kassette-noun"
          ]
        },
        {
          "id": "440187",
          "text": "Lass uns die Kassette anhören.",
          "translation": "Дайте нам послушать кассету.",
          "source": "Tatoeba #440187 @MUIRIEL / #1108928 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/440187",
          "cefr_level": "A1",
          "word_slugs": [
            "kassette-noun"
          ]
        },
        {
          "id": "440188",
          "text": "Lasst uns die Kassette anhören.",
          "translation": "Давайте послушаем эту кассету.",
          "source": "Tatoeba #440188 @MUIRIEL / #1569435 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/440188",
          "cefr_level": "A1",
