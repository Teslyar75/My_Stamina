          ]
        },
        {
          "id": "7611457",
          "text": "Mögt ihr Bananen?",
          "translation": "Вы любите бананы?",
          "source": "Tatoeba #7611457 @raggione / #7611492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7611457",
          "cefr_level": "A1",
          "word_slugs": [
