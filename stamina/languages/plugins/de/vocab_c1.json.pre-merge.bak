    {
      "slug": "arbeiteten-verb",
      "lemma": "arbeiteten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6629,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of arbeiten:",
          "first/third-person plural preterite",
          "inflection of arbeiten:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13015459",
          "text": "Wir arbeiteten viel.",
          "translation": "Мы много работали.",
          "source": "Tatoeba #13015459 @mhr / #13015307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13015459",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeiteten-verb"
          ]
        },
        {
          "id": "4486712",
          "text": "Wir arbeiteten für ihn.",
          "translation": "Мы на него работали.",
          "source": "Tatoeba #4486712 @raggione / #5053295 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4486712",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeiteten-verb"
          ]
        },
        {
          "id": "5057557",
          "text": "Wir arbeiteten für sie.",
          "translation": "Мы работали на неё.",
          "source": "Tatoeba #5057557 @raggione / #5057564 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5057557",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeiteten-verb"
          ]
        },
        {
          "id": "8828213",
          "text": "Wir arbeiteten immer zusammen.",
          "translation": "Мы всегда работали вместе.",
          "source": "Tatoeba #8828213 @wolfgangth / #8828216 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8828213",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeiteten-verb"
          ]
        },
        {
          "id": "6144376",
          "text": "Sie arbeiteten den ganzen Tag.",
          "translation": "Они работали весь день.",
          "source": "Tatoeba #6144376 @Pfirsichbaeumchen / #6144106 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6144376",
