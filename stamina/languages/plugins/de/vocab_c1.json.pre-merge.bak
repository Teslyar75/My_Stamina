    {
      "slug": "lehre-noun",
      "lemma": "Lehre",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6618,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "учение"
        ],
        "en": [
          "teaching, tenet",
          "apprenticeship",
          "doctrine",
          "lesson"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1532600",
          "text": "Es war mir eine Lehre.",
          "translation": "Я извлекла из этого урок.",
          "source": "Tatoeba #1532600 @Pfirsichbaeumchen / #2460240 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1532600",
          "cefr_level": "A1",
          "word_slugs": [
            "lehre-noun"
          ]
        },
        {
          "id": "2460246",
          "text": "Ich habe eine Lehre daraus gezogen.",
          "translation": "Я извлекла из этого урок.",
          "source": "Tatoeba #2460246 @al_ex_an_der / #2460240 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2460246",
          "cefr_level": "A1",
          "word_slugs": [
            "lehre-noun"
          ]
        },
        {
          "id": "2460765",
          "text": "Und hat er irgendeine Lehre daraus gezogen?",
          "translation": "Но вынес ли он какой-то урок из этого?",
          "source": "Tatoeba #2460765 @al_ex_an_der / #2460764 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2460765",
          "cefr_level": "A1",
          "word_slugs": [
            "lehre-noun"
          ]
        },
        {
          "id": "13726267",
          "text": "Der Konfuzianismus ist keine Religion, sondern eine Lehre.",
          "translation": "Конфуцианство — это не религия, а учение.",
          "source": "Tatoeba #13726267 @mhr / #13726042 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13726267",
          "cefr_level": "A1",
          "word_slugs": [
            "lehre-noun"
          ]
        },
        {
          "id": "1299921",
          "text": "Nun, meine Zuhörer, dieses schreckliche Beispiel möge euch eine Lehre sein!",
          "translation": "Что ж, слушатели мои, этот ужасный пример да будет вам уроком!",
          "source": "Tatoeba #1299921 @kolonjano / #11825494 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1299921",
          "cefr_level": "A1",
          "word_slugs": [
            "lehre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Lehre",
        "nominative_pl": ""
      }
    },
