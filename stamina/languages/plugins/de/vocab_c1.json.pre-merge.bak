      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7878,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "perfume (generally only in the sense of “odorous substance”, not “pleasant smell”)"
