          ]
        },
        {
          "id": "8059311",
          "text": "Tauben und Hühner sind Vögel.",
          "translation": "Голуби и куры — птицы.",
          "source": "Tatoeba #8059311 @Pfirsichbaeumchen / #4988242 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8059311",
