    {
      "slug": "insbesondere-adv",
      "lemma": "insbesondere",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9031,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "особенно",
          "в особенности",
          "прежде всего"
        ],
        "en": [
          "in particular, particularly"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12929730",
          "text": "Tom und Maria mögen Obst, insbesondere Äpfel.",
          "translation": "Том и Мэри любят фрукты, особенно яблоки.",
          "source": "Tatoeba #12929730 @felix63 / #12931201 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12929730",
          "cefr_level": "A1",
          "word_slugs": [
            "insbesondere-adv"
          ]
        },
        {
          "id": "387017",
          "text": "Insbesondere ist der Endomorphismenring von M ein kommutativer lokaler Ring.",
          "translation": "В частности, кольцо эндоморфизмов модуля M является коммутативным локальным кольцом.",
          "source": "Tatoeba #387017 @MUIRIEL / #636144 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/387017",
          "cefr_level": "A1",
          "word_slugs": [
            "insbesondere-adv"
          ]
        }
      ],
