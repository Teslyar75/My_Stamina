          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13750514",
          "text": "Er erinnerte sich an vieles.",
          "translation": "Он многое вспомнил.",
          "source": "Tatoeba #13750514 @mhr / #13750454 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13750514",
          "cefr_level": "A1",
          "word_slugs": [
            "erinnerte-verb"
          ]
        },
        {
          "id": "3428974",
          "text": "Tom erinnerte Maria an Johannes.",
          "translation": "Том напоминал Мэри Джона.",
          "source": "Tatoeba #3428974 @Pfirsichbaeumchen / #5246997 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3428974",
          "cefr_level": "A1",
          "word_slugs": [
            "erinnerte-verb"
          ]
        },
        {
          "id": "9144076",
          "text": "Ich erinnerte mich an ihre Worte.",
          "translation": "Я вспомнил её слова.",
          "source": "Tatoeba #9144076 @Pfirsichbaeumchen / #9144075 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9144076",
          "cefr_level": "A1",
          "word_slugs": [
