    {
      "slug": "überqueren-verb",
      "lemma": "überqueren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8329,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "переходить"
        ],
        "en": [
          "to cross, to traverse"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12581445",
          "text": "Wir überqueren den Fluss.",
          "translation": "Мы пересекаем реку.",
          "source": "Tatoeba #12581445 @mhr / #12581415 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12581445",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-verb"
          ]
        },
        {
          "id": "6554732",
          "text": "Tom wird den Fluss überqueren.",
          "translation": "Том переправится через реку.",
          "source": "Tatoeba #6554732 @Esperantostern / #6457481 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6554732",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-verb"
          ]
        },
        {
          "id": "9681704",
          "text": "Ich sah Tom die Straße überqueren.",
          "translation": "Я видел, как Том переходил улицу.",
          "source": "Tatoeba #9681704 @Pfirsichbaeumchen / #11309755 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9681704",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-verb"
          ]
        },
        {
          "id": "13651232",
          "text": "Kann man hier die Straße überqueren?",
          "translation": "Здесь можно переходить улицу?",
          "source": "Tatoeba #13651232 @Waldelfe / #6287285 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13651232",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-verb"
          ]
        },
        {
          "id": "404128",
          "text": "Ich habe ihn die Straße überqueren sehen.",
          "translation": "Я видел, как он переходил через дорогу.",
          "source": "Tatoeba #404128 @MUIRIEL / #3537513 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/404128",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "überqueren-noun",
      "lemma": "Überqueren",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8329,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of überqueren"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1905269",
          "text": "Seid vorsichtig beim Überqueren der Straße!",
          "translation": "Будь осторожен при переходе через улицу.",
          "source": "Tatoeba #1905269 @Tamy / #1781473 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1905269",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-noun"
          ]
        },
        {
          "id": "1187126",
          "text": "Er wurde beim Überqueren der Straße gesehen.",
          "translation": "Его видели переходящим улицу.",
          "source": "Tatoeba #1187126 @samueldora / #4609415 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1187126",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-noun"
          ]
        },
        {
          "id": "11504030",
          "text": "Tom half der Entenfamilie beim Überqueren der Straße.",
          "translation": "Том помог семье уток перейти через дорогу.",
          "source": "Tatoeba #11504030 @Pfirsichbaeumchen / #8913849 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11504030",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-noun"
          ]
        },
        {
          "id": "13053636",
          "text": "Halten Sie das Kind beim Überqueren der Straße fest an der Hand.",
          "translation": "Переходя улицу, крепко держите ребёнка за руку.",
          "source": "Tatoeba #13053636 @mhr / #13053593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13053636",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-noun"
          ]
        },
        {
          "id": "7063228",
          "text": "Überqueren Sie die Brücke.",
          "translation": "Перейдите через мост.",
          "source": "Tatoeba #7063228 @quicksanddiver / #10157272 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7063228",
          "cefr_level": "A1",
          "word_slugs": [
            "überqueren-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
