        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "6062026",
          "text": "Du bist mein Sklave.",
          "translation": "Ты мой раб.",
          "source": "Tatoeba #6062026 @wolfgangth / #6155186 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6062026",
          "cefr_level": "A1",
          "word_slugs": [
            "sklave-noun"
          ]
        },
        {
          "id": "13738557",
          "text": "Der Sklave muss arbeiten.",
          "translation": "Раб должен работать.",
          "source": "Tatoeba #13738557 @Vortarulo / #13743242 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13738557",
          "cefr_level": "A1",
          "word_slugs": [
            "sklave-noun"
          ]
        },
        {
          "id": "13801614",
          "text": "Der Mann ist ein Sklave.",
          "translation": "Этот мужчина - раб.",
          "source": "Tatoeba #13801614 @Rovo / #11817769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13801614",
          "cefr_level": "A1",
          "word_slugs": [
            "sklave-noun"
          ]
        },
        {
          "id": "1935313",
          "text": "Ich bin nicht dein Sklave.",
          "translation": "Я тебе не раб.",
          "source": "Tatoeba #1935313 @Pfirsichbaeumchen / #5565179 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1935313",
          "cefr_level": "A1",
          "word_slugs": [
            "sklave-noun"
          ]
        },
        {
          "id": "2220911",
          "text": "Das ist dein Sklave, oder?",
          "translation": "Это твой раб, да?",
          "source": "Tatoeba #2220911 @Vortarulo / #5695700 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2220911",
          "cefr_level": "A1",
