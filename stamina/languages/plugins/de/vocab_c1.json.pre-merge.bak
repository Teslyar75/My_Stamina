    {
      "slug": "bezahlte-verb",
      "lemma": "bezahlte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8316,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bezahlen:",
          "first/third-person singular preterite",
          "inflection of bezahlen:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "854943",
          "text": "Ich bezahlte ihm vier Dollar.",
          "translation": "Я заплатил ему четыре доллара.",
          "source": "Tatoeba #854943 @Zaghawa / #447318 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/854943",
          "cefr_level": "A1",
          "word_slugs": [
            "bezahlte-verb"
          ]
        },
        {
          "id": "4832361",
          "text": "Sie bezahlte ihm vier Dollar.",
          "translation": "Она заплатила ему четыре доллара.",
          "source": "Tatoeba #4832361 @Esperantostern / #5220760 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4832361",
          "cefr_level": "A1",
          "word_slugs": [
            "bezahlte-verb"
          ]
        },
        {
          "id": "1819165",
          "text": "Tom bezahlte eine Strafe von $300.",
          "translation": "Том заплатил штраф в триста долларов.",
          "source": "Tatoeba #1819165 @pne / #12960676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1819165",
          "cefr_level": "A1",
          "word_slugs": [
            "bezahlte-verb"
          ]
        },
        {
          "id": "2384978",
          "text": "Ich suche eine gut bezahlte Arbeit.",
          "translation": "Ищу хорошо оплачиваемую работу.",
          "source": "Tatoeba #2384978 @al_ex_an_der / #2384975 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2384978",
          "cefr_level": "A1",
          "word_slugs": [
            "bezahlte-verb"
          ]
        },
        {
          "id": "810200",
