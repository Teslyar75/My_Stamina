    {
      "slug": "bedarf-noun",
      "lemma": "Bedarf",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6676,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "потребность"
        ],
        "en": [
          "need (that which is desired or required)",
          "demand (amount of input that is required for something to function)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "11525359",
          "text": "Ich habe Bedarf, dass du hierbleibst.",
          "translation": "Мне нужно, чтобы ты остался здесь.",
          "source": "Tatoeba #11525359 @Pfirsichbaeumchen / #6460763 @milana (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11525359",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-noun"
          ]
        },
        {
          "id": "11525356",
          "text": "Ich habe Bedarf, dass Sie hierbleiben.",
          "translation": "Мне нужно, чтобы Вы остались здесь.",
          "source": "Tatoeba #11525356 @Pfirsichbaeumchen / #11525841 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11525356",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-noun"
          ]
        },
        {
          "id": "1312747",
          "text": "Es gibt einen dringenden Bedarf an Wasser.",
          "translation": "Срочно нужна вода.",
          "source": "Tatoeba #1312747 @al_ex_an_der / #1576230 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1312747",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-noun"
          ]
        },
        {
          "id": "1695911",
          "text": "Es besteht dringender Bedarf an erfahrenen Piloten.",
          "translation": "Срочно требуются опытные пилоты.",
          "source": "Tatoeba #1695911 @Pfirsichbaeumchen / #4415160 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1695911",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-noun"
          ]
        },
        {
          "id": "5475088",
          "text": "Die Leute haben keinen Bedarf an der Wahrheit.",
          "translation": "Людям не нужна правда.",
          "source": "Tatoeba #5475088 @Pfirsichbaeumchen / #5474735 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5475088",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Bedarf",
        "nominative_pl": ""
      }
    },
    {
      "slug": "bedarf-verb",
      "lemma": "bedarf",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6676,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first-person singular present indicative of bedürfen (“I need”)",
          "third-person singular present indicative of bedürfen (“he/she/it needs”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2885314",
          "text": "Dieser Satz bedarf einer Berichtigung.",
          "translation": "Это предложение нуждается в правке.",
          "source": "Tatoeba #2885314 @al_ex_an_der / #2885311 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2885314",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-verb"
          ]
        },
        {
          "id": "5018487",
          "text": "Die Kirche bedarf eines neuen Daches.",
          "translation": "Церкви требуется новая крыша.",
          "source": "Tatoeba #5018487 @al_ex_an_der / #6333798 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5018487",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-verb"
          ]
        },
        {
          "id": "1825285",
          "text": "Dies Königreich bedarf eines neuen Königs.",
          "translation": "Этому королевству нужен новый король.",
          "source": "Tatoeba #1825285 @Pfirsichbaeumchen / #6462719 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1825285",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-verb"
          ]
        },
        {
          "id": "13409787",
          "text": "Das Gebäude bedarf einer umfassenden Renovierung.",
          "translation": "Здание требует капитального ремонта.",
          "source": "Tatoeba #13409787 @mhr / #13409655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13409787",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-verb"
          ]
        },
        {
          "id": "2145442",
          "text": "In diesem Satz bedarf es keines Kommas.",
          "translation": "В этом предложении запятая не нужна.",
          "source": "Tatoeba #2145442 @al_ex_an_der / #13843645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2145442",
          "cefr_level": "A1",
          "word_slugs": [
            "bedarf-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
