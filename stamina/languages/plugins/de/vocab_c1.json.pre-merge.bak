          ]
        },
        {
          "id": "8782909",
          "text": "Ich gehe regelmäßig schwimmen.",
          "translation": "Я регулярно хожу плавать.",
          "source": "Tatoeba #8782909 @felix63 / #8785562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8782909",
          "cefr_level": "A1",
          "word_slugs": [
