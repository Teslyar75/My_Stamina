      "gender": null,
      "examples": [
        {
          "id": "1107102",
          "text": "Danke für die warmen Worte.",
          "translation": "Спасибо за тёплые слова.",
          "source": "Tatoeba #1107102 @Haehnchenpaella / #1799443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1107102",
          "cefr_level": "A1",
          "word_slugs": [
            "warmen-adj"
          ]
        },
        {
          "id": "13971130",
          "text": "Warmen Schnee gibt es nicht.",
          "translation": "Тёплого снега не бывает.",
          "source": "Tatoeba #13971130 @mhr / #13971126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13971130",
          "cefr_level": "A1",
          "word_slugs": [
            "warmen-adj"
          ]
        },
        {
          "id": "11087979",
          "text": "Tom trug einen warmen Mantel.",
          "translation": "На Томе было тёплое пальто.",
          "source": "Tatoeba #11087979 @Pfirsichbaeumchen / #11087980 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11087979",
          "cefr_level": "A1",
          "word_slugs": [
            "warmen-adj"
          ]
        },
        {
          "id": "474420",
          "text": "Reis wächst in warmen Ländern.",
          "translation": "Рис растёт в тёплых странах.",
          "source": "Tatoeba #474420 @Kleinchen42 / #515166 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/474420",
          "cefr_level": "A1",
          "word_slugs": [
            "warmen-adj"
          ]
        },
        {
          "id": "454233",
          "text": "Reis wächst in warmen Klimaten.",
          "translation": "Рис растет в теплом климате.",
          "source": "Tatoeba #454233 @al_ex_an_der / #1223087 @poji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454233",
          "cefr_level": "A1",
          "word_slugs": [
            "warmen-adj"
          ]
        }
      ],
