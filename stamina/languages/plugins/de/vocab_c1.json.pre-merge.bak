        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5962831",
          "text": "Wir brauchen Elektrizität.",
          "translation": "Нам нужно электричество.",
          "source": "Tatoeba #5962831 @arved / #6954308 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5962831",
          "cefr_level": "A1",
          "word_slugs": [
            "elektrizität-noun"
          ]
        },
        {
          "id": "406739",
          "text": "Kupfer leitet Elektrizität gut.",
          "translation": "Медь хорошо проводит электричество.",
          "source": "Tatoeba #406739 @xtofu80 / #4951980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/406739",
          "cefr_level": "A1",
          "word_slugs": [
            "elektrizität-noun"
          ]
        },
        {
          "id": "399652",
          "text": "Der Fluss versorgt die Stadt mit Elektrizität.",
          "translation": "Река обеспечивает город электроэнергией.",
          "source": "Tatoeba #399652 @xtofu80 / #2893555 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399652",
          "cefr_level": "A1",
          "word_slugs": [
            "elektrizität-noun"
          ]
        },
        {
          "id": "4784747",
          "text": "Die Maschine generierte riesige Mengen an Elektrizität.",
          "translation": "Машина производила огромные объёмы электричества.",
          "source": "Tatoeba #4784747 @L3581 / #4784913 @taranbo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4784747",
          "cefr_level": "A1",
          "word_slugs": [
            "elektrizität-noun"
          ]
        },
        {
          "id": "11836187",
          "text": "Aluminium leitet Elektrizität nicht so gut wie Kupfer.",
          "translation": "Алюминий проводит электричество не так хорошо, как медь.",
          "source": "Tatoeba #11836187 @Naina / #12072528 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11836187",
          "cefr_level": "A1",
          "word_slugs": [
            "elektrizität-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
