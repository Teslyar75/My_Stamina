          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11982070",
          "text": "Der Amerikaner träumt.",
          "translation": "Американец мечтает.",
          "source": "Tatoeba #11982070 @Naina / #12982835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11982070",
          "cefr_level": "A1",
          "word_slugs": [
            "träumt-verb"
          ]
        },
        {
          "id": "12697394",
          "text": "Träumt nicht – handelt!",
          "translation": "Не мечтайте - действуйте!",
          "source": "Tatoeba #12697394 @mhr / #12697156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12697394",
          "cefr_level": "A1",
          "word_slugs": [
            "träumt-verb"
          ]
        },
        {
          "id": "11982072",
          "text": "Die Amerikanerin träumt.",
          "translation": "Американка мечтает.",
          "source": "Tatoeba #11982072 @Naina / #12982836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11982072",
          "cefr_level": "A1",
          "word_slugs": [
            "träumt-verb"
          ]
        },
        {
          "id": "8237731",
          "text": "Tom dachte, er träumt.",
          "translation": "Том думал, что ему снится сон.",
          "source": "Tatoeba #8237731 @MisterTrouser / #9023004 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8237731",
          "cefr_level": "A1",
          "word_slugs": [
            "träumt-verb"
          ]
        },
        {
          "id": "13805405",
          "text": "Er schläft und träumt.",
          "translation": "Он спит и видит сон.",
          "source": "Tatoeba #13805405 @mhr / #13804953 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13805405",
          "cefr_level": "A1",
          "word_slugs": [
            "träumt-verb"
          ]
        }
      ],
      "tags": [
