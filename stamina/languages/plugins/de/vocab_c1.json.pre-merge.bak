    {
      "slug": "gefälscht-verb",
      "lemma": "gefälscht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7591,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of fälschen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9455672",
          "text": "Meine Unterschrift wurde gefälscht.",
          "translation": "Моя подпись была подделана.",
          "source": "Tatoeba #9455672 @Pfirsichbaeumchen / #9459099 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9455672",
          "cefr_level": "A1",
          "word_slugs": [
            "gefälscht-verb"
          ]
        },
        {
          "id": "1544230",
          "text": "Traue keiner Statistik, die du nicht selbst gefälscht hast.",
          "translation": "Не верь никакой статистике, если сам её не подделывал.",
          "source": "Tatoeba #1544230 @Pfirsichbaeumchen / #13950758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1544230",
          "cefr_level": "A1",
          "word_slugs": [
            "gefälscht-verb"
          ]
        },
        {
          "id": "2412659",
          "text": "Ich glaube nur an Statistiken, die ich selbst gefälscht habe.",
          "translation": "Я верю только той статистике, которую сфабриковал сам.",
          "source": "Tatoeba #2412659 @Esperantostern / #12060291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2412659",
          "cefr_level": "A1",
          "word_slugs": [
            "gefälscht-verb"
          ]
        }
