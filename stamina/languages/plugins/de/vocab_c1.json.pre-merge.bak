    {
      "slug": "verteidigt-verb",
      "lemma": "verteidigt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5697,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verteidigen:",
          "third-person singular present",
          "inflection of verteidigen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13784358",
          "text": "Ihr verteidigt sie.",
          "translation": "Вы их защищаете.",
          "source": "Tatoeba #13784358 @mhr / #13784347 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13784358",
          "cefr_level": "A1",
          "word_slugs": [
            "verteidigt-verb"
          ]
        },
        {
          "id": "1054903",
          "text": "Er verteidigt die Demokratie.",
          "translation": "Он защищает демократию.",
          "source": "Tatoeba #1054903 @MUIRIEL / #12890585 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1054903",
          "cefr_level": "A1",
          "word_slugs": [
            "verteidigt-verb"
          ]
        },
        {
          "id": "2874811",
          "text": "Er verteidigt und schützt seine Familie.",
          "translation": "Он защищает и бережёт свою семью.",
          "source": "Tatoeba #2874811 @Ahiru / #5138083 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2874811",
          "cefr_level": "A1",
          "word_slugs": [
            "verteidigt-verb"
          ]
        },
        {
          "id": "343403",
          "text": "Ken verteidigt immer seine Mutter, wenn seine Eltern sich streiten.",
          "translation": "Кен всегда заступается за мать, когда родители ссорятся.",
          "source": "Tatoeba #343403 @MUIRIEL / #5296140 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/343403",
          "cefr_level": "A1",
          "word_slugs": [
            "verteidigt-verb"
          ]
        }
      ],
