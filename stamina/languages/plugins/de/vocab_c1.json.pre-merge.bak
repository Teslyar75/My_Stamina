    {
      "slug": "getäuscht-verb",
      "lemma": "getäuscht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6123,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of täuschen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "418462",
          "text": "Er hat mich getäuscht.",
          "translation": "Он меня обманул.",
          "source": "Tatoeba #418462 @MUIRIEL / #2004879 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/418462",
          "cefr_level": "A1",
          "word_slugs": [
            "getäuscht-verb"
          ]
        },
        {
          "id": "341597",
          "text": "Seine Augen haben ihn getäuscht.",
          "translation": "Его подвели его глаза.",
          "source": "Tatoeba #341597 @MUIRIEL / #1587467 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341597",
          "cefr_level": "A1",
          "word_slugs": [
            "getäuscht-verb"
          ]
        },
        {
          "id": "13746209",
          "text": "Wir dachten, wir hätten Freunde, aber wir haben uns getäuscht.",
          "translation": "Мы думали, что у нас есть друзья, но мы ошибались.",
          "source": "Tatoeba #13746209 @felix63 / #13748861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13746209",
          "cefr_level": "A1",
          "word_slugs": [
            "getäuscht-verb"
          ]
        },
        {
          "id": "11164275",
          "text": "Ich bin froh, dass ich mich in dir nicht getäuscht habe.",
          "translation": "Я рад, что я не ошибся насчёт тебя.",
          "source": "Tatoeba #11164275 @Pfirsichbaeumchen / #11164272 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11164275",
          "cefr_level": "A1",
          "word_slugs": [
            "getäuscht-verb"
          ]
        },
        {
          "id": "11164281",
          "text": "Ich bin froh, dass ich mich in euch nicht getäuscht habe.",
          "translation": "Я рад, что я не ошибся насчёт вас.",
          "source": "Tatoeba #11164281 @Pfirsichbaeumchen / #11164273 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11164281",
          "cefr_level": "A1",
          "word_slugs": [
            "getäuscht-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
