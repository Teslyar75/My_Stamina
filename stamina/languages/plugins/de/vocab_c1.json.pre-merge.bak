      "examples": [
        {
          "id": "1839250",
          "text": "Im Taxi wurde ein Paar Handschuhe zurückgelassen.",
          "translation": "В такси была оставлена пара перчаток.",
          "source": "Tatoeba #1839250 @Zaghawa / #8601727 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1839250",
          "cefr_level": "A1",
