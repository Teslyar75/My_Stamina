    {
      "slug": "gestürzt-verb",
      "lemma": "gestürzt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5895,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of stürzen (“overturned”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12960842",
          "text": "Sie ist gestürzt.",
          "translation": "Она упала.",
          "source": "Tatoeba #12960842 @mhr / #12960635 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12960842",
          "cefr_level": "A1",
          "word_slugs": [
            "gestürzt-verb"
          ]
        },
        {
          "id": "3488659",
          "text": "Tom ist vom Pferd gestürzt.",
          "translation": "Том упал с лошади.",
          "source": "Tatoeba #3488659 @Pfirsichbaeumchen / #3488644 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3488659",
          "cefr_level": "A1",
          "word_slugs": [
            "gestürzt-verb"
          ]
        },
        {
          "id": "12338237",
          "text": "Wir haben seit 1954 keine Regierung gestürzt.",
          "translation": "Мы не свергали правительство с 1954 года.",
          "source": "Tatoeba #12338237 @mhr / #12338224 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12338237",
          "cefr_level": "A1",
          "word_slugs": [
            "gestürzt-verb"
          ]
        },
        {
          "id": "13573672",
          "text": "Du bist gestürzt und hast dir das Bein gebrochen.",
          "translation": "Ты упала и сломала ногу.",
          "source": "Tatoeba #13573672 @felix63 / #4350967 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13573672",
          "cefr_level": "A1",
          "word_slugs": [
            "gestürzt-verb"
          ]
        },
        {
          "id": "2447069",
          "text": "Ihr seid gestürzt und habt euch die Beine gebrochen.",
          "translation": "Вы упали и переломали себе ноги.",
          "source": "Tatoeba #2447069 @Pfirsichbaeumchen / #13573302 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2447069",
          "cefr_level": "A1",
          "word_slugs": [
            "gestürzt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
