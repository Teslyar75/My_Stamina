    {
      "slug": "futter-noun",
      "lemma": "Futter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6660,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "корм",
          "фураж"
        ],
        "en": [
          "fodder, food (for animals)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "969209",
          "text": "Gib dem Vogel Futter!",
          "translation": "Покорми птицу!",
          "source": "Tatoeba #969209 @Esperantostern / #1563735 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/969209",
          "cefr_level": "A1",
          "word_slugs": [
            "futter-noun"
          ]
        },
        {
          "id": "14067244",
          "text": "Mit welchem Futter füttert ihr euren Hund?",
          "translation": "Каким кормом вы кормите свою собаку?",
          "source": "Tatoeba #14067244 @mhr / #14066700 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067244",
          "cefr_level": "A1",
          "word_slugs": [
            "futter-noun"
          ]
        },
        {
          "id": "14067246",
          "text": "Mit welchem Futter fütterst du deinen Hund?",
          "translation": "Каким кормом ты кормишь свою собаку?",
          "source": "Tatoeba #14067246 @mhr / #14066699 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067246",
          "cefr_level": "A1",
          "word_slugs": [
            "futter-noun"
          ]
        },
        {
          "id": "4932080",
          "text": "Er hat vergessen dem Hund Futter zu geben.",
          "translation": "Он забыл дать корм собаке.",
          "source": "Tatoeba #4932080 @Hime / #4932517 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4932080",
          "cefr_level": "A1",
          "word_slugs": [
            "futter-noun"
          ]
        },
        {
          "id": "14067245",
