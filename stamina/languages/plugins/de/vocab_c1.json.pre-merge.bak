          ]
        },
        {
          "id": "11827555",
          "text": "Überlass das Reden ihr.",
          "translation": "Говорит пусть она.",
          "source": "Tatoeba #11827555 @Pfirsichbaeumchen / #14112077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11827555",
          "cefr_level": "A1",
          "word_slugs": [
            "überlass-verb"
          ]
        },
        {
          "id": "2777204",
          "text": "Bitte überlass alles mir!",
