    {
      "slug": "erlaube-verb",
      "lemma": "erlaube",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7332,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of erlauben:",
          "first-person singular present",
          "inflection of erlauben:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13141457",
          "text": "Okay, ich erlaube es.",
          "translation": "Хорошо, разрешаю.",
          "source": "Tatoeba #13141457 @Vortarulo / #13141638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13141457",
          "cefr_level": "A1",
          "word_slugs": [
            "erlaube-verb"
          ]
        },
        {
          "id": "1863517",
          "text": "Ich erlaube dir zu gehen.",
          "translation": "Я разрешаю тебе пойти.",
          "source": "Tatoeba #1863517 @Pfirsichbaeumchen / #3064929 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1863517",
          "cefr_level": "A1",
          "word_slugs": [
            "erlaube-verb"
          ]
        },
        {
          "id": "2943448",
          "text": "Erlaube dir, dich zu irren!",
          "translation": "Позволь себе ошибаться!",
          "source": "Tatoeba #2943448 @al_ex_an_der / #2943444 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2943448",
          "cefr_level": "A1",
          "word_slugs": [
            "erlaube-verb"
          ]
        },
        {
          "id": "4943731",
          "text": "Erlaube mir, dir zu helfen.",
          "translation": "Позволь мне тебе помочь.",
          "source": "Tatoeba #4943731 @Esperantostern / #4943880 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4943731",
          "cefr_level": "A1",
          "word_slugs": [
            "erlaube-verb"
          ]
        },
        {
          "id": "13755546",
          "text": "Erlaube dir, Fehler zu machen.",
          "translation": "Позволь себе совершать ошибки.",
          "source": "Tatoeba #13755546 @mhr / #13752839 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13755546",
          "cefr_level": "A1",
          "word_slugs": [
