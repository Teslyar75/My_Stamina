          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1388007",
          "text": "Wie alt schätzt du Tom?",
          "translation": "Как думаешь, сколько лет Тому?",
          "source": "Tatoeba #1388007 @al_ex_an_der / #2755217 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1388007",
          "cefr_level": "A1",
          "word_slugs": [
            "schätzt-verb"
          ]
        },
        {
          "id": "1386839",
          "text": "Wie alt schätzt du mich?",
          "translation": "Как думаешь, сколько мне лет?",
          "source": "Tatoeba #1386839 @enteka / #1398804 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1386839",
          "cefr_level": "A1",
          "word_slugs": [
            "schätzt-verb"
          ]
        },
        {
          "id": "1388008",
          "text": "Wie alt schätzt ihr Tom?",
          "translation": "Как вы думаете, сколько Тому лет?",
          "source": "Tatoeba #1388008 @al_ex_an_der / #2229824 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1388008",
          "cefr_level": "A1",
          "word_slugs": [
            "schätzt-verb"
          ]
        },
        {
          "id": "13618738",
          "text": "Er schätzt seine Freiheit zu sehr.",
          "translation": "Он слишком ценит свою свободу.",
          "source": "Tatoeba #13618738 @Waldelfe / #11845023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13618738",
          "cefr_level": "A1",
          "word_slugs": [
            "schätzt-verb"
          ]
        },
        {
          "id": "1599825",
          "text": "Er schätzt meine kleinen Witze nicht.",
          "translation": "Мои шуточки ему не по вкусу.",
          "source": "Tatoeba #1599825 @Zaghawa / #3503478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1599825",
          "cefr_level": "A1",
          "word_slugs": [
            "schätzt-verb"
          ]
        }
      ],
