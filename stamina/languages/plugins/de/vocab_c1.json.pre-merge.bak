        "en": [
          "terrace (raised, flat-topped bank of earth with sloping sides)",
          "patio, porch, veranda, terrace (platform that extends outwards from a building)",
          "roof terrace, roof garden (flat roof of a building, accessible to the residents)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4838643",
          "text": "Trage alle Stühle auf die Terrasse.",
          "translation": "Вынеси все стулья на террасу.",
          "source": "Tatoeba #4838643 @al_ex_an_der / #13227186 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4838643",
          "cefr_level": "A1",
          "word_slugs": [
