    {
      "slug": "voneinander-adv",
      "lemma": "voneinander",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6927,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "друг от друга"
        ],
        "en": [
          "from / of one another, from / of each other"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1068158",
          "text": "Tom und Mary sind voneinander abhängig.",
          "translation": "Том и Мэри зависят друг от друга.",
          "source": "Tatoeba #1068158 @Pfirsichbaeumchen / #1480916 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1068158",
          "cefr_level": "A1",
          "word_slugs": [
            "voneinander-adv"
          ]
        },
        {
          "id": "770087",
          "text": "Ich kann sie nicht voneinander unterscheiden.",
          "translation": "Я не могу их отличить друг от друга.",
          "source": "Tatoeba #770087 @marloncori / #2119666 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/770087",
          "cefr_level": "A1",
          "word_slugs": [
            "voneinander-adv"
          ]
        },
        {
          "id": "14061379",
          "text": "Sie unterscheiden sich in nichts voneinander.",
          "translation": "Они друг от друга ничем не отличаются.",
          "source": "Tatoeba #14061379 @mhr / #14046921 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14061379",
          "cefr_level": "A1",
          "word_slugs": [
            "voneinander-adv"
          ]
        },
        {
          "id": "5611955",
          "text": "In Kleinstädten wissen alle voneinander Bescheid.",
          "translation": "В маленьких городках все про всех всё знают.",
          "source": "Tatoeba #5611955 @raggione / #5609276 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5611955",
          "cefr_level": "A1",
          "word_slugs": [
            "voneinander-adv"
          ]
        },
        {
          "id": "13820945",
          "text": "Glauben und Wissen unterscheiden sich voneinander.",
          "translation": "Верить и знать — разные вещи.",
          "source": "Tatoeba #13820945 @Biderl / #13820985 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13820945",
          "cefr_level": "A1",
          "word_slugs": [
            "voneinander-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
