        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7429260",
          "text": "Gott erhörte Toms Gebete,",
          "translation": "Бог услышал молитвы Тома.",
          "source": "Tatoeba #7429260 @Pfirsichbaeumchen / #7421667 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7429260",
          "cefr_level": "A1",
          "word_slugs": [
            "gebete-noun"
          ]
        },
        {
          "id": "7429261",
          "text": "Gott erhörte ihre Gebete.",
          "translation": "Бог услышал её молитвы.",
          "source": "Tatoeba #7429261 @Pfirsichbaeumchen / #7421669 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7429261",
          "cefr_level": "A1",
          "word_slugs": [
            "gebete-noun"
          ]
        },
        {
          "id": "7429262",
          "text": "Gott erhörte seine Gebete.",
          "translation": "Бог услышал его молитвы.",
          "source": "Tatoeba #7429262 @Pfirsichbaeumchen / #7421668 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7429262",
          "cefr_level": "A1",
          "word_slugs": [
            "gebete-noun"
          ]
        },
        {
          "id": "1514838",
          "text": "Meine Gebete wurden erhört.",
          "translation": "Мои молитвы были услышаны.",
          "source": "Tatoeba #1514838 @Pfirsichbaeumchen / #2889433 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1514838",
          "cefr_level": "A1",
          "word_slugs": [
            "gebete-noun"
          ]
        },
        {
          "id": "8242360",
          "text": "Glaubst du, Gott hört unsere Gebete?",
          "translation": "Как ты думаешь, бог слышит наши молитвы?",
          "source": "Tatoeba #8242360 @Pfirsichbaeumchen / #6782637 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8242360",
          "cefr_level": "A1",
          "word_slugs": [
            "gebete-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
