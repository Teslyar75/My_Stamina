    {
      "slug": "meldete-verb",
      "lemma": "meldete",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9690,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of melden:",
