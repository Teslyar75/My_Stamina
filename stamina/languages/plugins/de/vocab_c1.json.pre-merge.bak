          ]
        },
        {
          "id": "4856346",
          "text": "Der Preis des Rohöls sinkt.",
          "translation": "Цена нефти падает.",
          "source": "Tatoeba #4856346 @al_ex_an_der / #4856316 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4856346",
          "cefr_level": "A1",
          "word_slugs": [
            "sinkt-verb"
          ]
        },
        {
          "id": "1315573",
          "text": "Die Zahl der Studenten sinkt.",
