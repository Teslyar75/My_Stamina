      "gender": null,
      "examples": [
        {
          "id": "13271461",
          "text": "Ruft uns an, wenn ihr ankommt!",
          "translation": "Позвоните нам, когда приедете.",
          "source": "Tatoeba #13271461 @Waldelfe / #4094854 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13271461",
          "cefr_level": "A1",
          "word_slugs": [
            "ankommt-verb"
          ]
        },
        {
          "id": "14061297",
          "text": "Ich will wissen, wann ihr ankommt.",
