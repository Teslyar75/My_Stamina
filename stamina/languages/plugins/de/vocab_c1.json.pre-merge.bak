    {
      "slug": "judith-name",
      "lemma": "Judith",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7735,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a female given name, equivalent to English Judith"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4132248",
