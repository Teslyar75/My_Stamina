          ]
        },
        {
          "id": "12889005",
          "text": "Ich benötige mehr Einzelheiten.",
          "translation": "Мне нужно больше подробностей.",
          "source": "Tatoeba #12889005 @mhr / #12888995 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12889005",
          "cefr_level": "A1",
          "word_slugs": [
            "einzelheiten-noun"
          ]
        },
        {
          "id": "13823920",
          "text": "Er verliert sich in Einzelheiten.",
          "translation": "Он тонет в подробностях.",
          "source": "Tatoeba #13823920 @mhr / #13823836 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13823920",
          "cefr_level": "A1",
          "word_slugs": [
