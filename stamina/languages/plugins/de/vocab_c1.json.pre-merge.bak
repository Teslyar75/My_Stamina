      "examples": [
        {
          "id": "1909068",
          "text": "Du riechst gut.",
          "translation": "Ты приятно пахнешь.",
          "source": "Tatoeba #1909068 @Pfirsichbaeumchen / #5211089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1909068",
