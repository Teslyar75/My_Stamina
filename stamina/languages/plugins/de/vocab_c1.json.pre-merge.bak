          "cefr_level": "A1",
          "word_slugs": [
            "uniformen-noun"
          ]
        },
        {
          "id": "772603",
          "text": "Offiziere der Marine tragen weiße Uniformen.",
          "translation": "Офицеры военно-морского флота носят белую форму.",
          "source": "Tatoeba #772603 @al_ex_an_der / #12631169 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/772603",
          "cefr_level": "A1",
          "word_slugs": [
            "uniformen-noun"
          ]
        },
        {
          "id": "9936370",
          "text": "Die Firma stellt ihnen Uniformen zur Verfügung.",
          "translation": "Фирма предоставляет им униформу.",
          "source": "Tatoeba #9936370 @GaryGaryGary / #661278 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936370",
          "cefr_level": "A1",
          "word_slugs": [
            "uniformen-noun"
          ]
        }
