    {
      "slug": "edgar-name",
      "lemma": "Edgar",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6548,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a male given name, equivalent to English Edgar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1831313",
          "text": "Ich bin Edgar Degas.",
          "translation": "Я Эдгар Дега.",
          "source": "Tatoeba #1831313 @Wauzl / #9085171 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1831313",
          "cefr_level": "A1",
