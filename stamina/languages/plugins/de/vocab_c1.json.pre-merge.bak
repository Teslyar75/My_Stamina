    {
      "slug": "ausnutzen-verb",
      "lemma": "ausnutzen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7696,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "использовать",
          "пользоваться",
          "эксплуатировать"
        ],
        "en": [
          "to exploit (use for one's advantage)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6694662",
          "text": "Diese Typen wollen dich nur ausnutzen.",
          "translation": "Эти люди просто хотят использовать тебя.",
          "source": "Tatoeba #6694662 @maaster / #6694684 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6694662",
          "cefr_level": "A1",
          "word_slugs": [
            "ausnutzen-verb"
          ]
        },
        {
          "id": "2351618",
          "text": "Man muss den richtigen Augenblick ausnutzen.",
          "translation": "Надо воспользоваться подходящим моментом.",
          "source": "Tatoeba #2351618 @al_ex_an_der / #2351616 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2351618",
          "cefr_level": "A1",
          "word_slugs": [
            "ausnutzen-verb"
          ]
        },
        {
          "id": "6119368",
          "text": "Wir müssen die Sonnenenergie bestmöglich ausnutzen.",
          "translation": "Нам необходимо максимально использовать солнечную энергию.",
          "source": "Tatoeba #6119368 @al_ex_an_der / #853222 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6119368",
          "cefr_level": "A1",
          "word_slugs": [
            "ausnutzen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
