    {
      "slug": "eilt-verb",
      "lemma": "eilt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9326,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of eilen:",
          "third-person singular present",
          "inflection of eilen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12235464",
          "text": "Das eilt nicht!",
          "translation": "Это не срочно!",
          "source": "Tatoeba #12235464 @mhr / #12235300 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12235464",
          "cefr_level": "A1",
          "word_slugs": [
            "eilt-verb"
          ]
        },
        {
          "id": "6837588",
          "text": "Es eilt überhaupt nicht.",
          "translation": "Это совсем не к спеху.",
          "source": "Tatoeba #6837588 @brauchinet / #8951899 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6837588",
          "cefr_level": "A1",
          "word_slugs": [
            "eilt-verb"
          ]
        },
        {
          "id": "1274003",
          "text": "Die Nachricht eilt von Mund zu Mund.",
          "translation": "Новость передаётся из уст в уста.",
          "source": "Tatoeba #1274003 @Espi / #5484957 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1274003",
          "cefr_level": "A1",
          "word_slugs": [
            "eilt-verb"
          ]
        },
        {
          "id": "4163990",
          "text": "Es eilt nicht. Wir haben jede Menge Zeit.",
          "translation": "Спешки нет. У нас полно времени.",
          "source": "Tatoeba #4163990 @Pfirsichbaeumchen / #14011046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4163990",
          "cefr_level": "A1",
          "word_slugs": [
            "eilt-verb"
          ]
        },
        {
          "id": "910470",
          "text": "Lassen Sie sich Zeit. Es eilt überhaupt nicht.",
          "translation": "Не спешите, не к чему спешить.",
          "source": "Tatoeba #910470 @Sudajaengi / #1629253 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/910470",
          "cefr_level": "A1",
          "word_slugs": [
            "eilt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
