    {
      "slug": "aufzugeben-verb",
      "lemma": "aufzugeben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5872,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of aufgeben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3013091",
          "text": "Das Wichtigste ist, nicht aufzugeben.",
          "translation": "Главное - не сдаваться.",
          "source": "Tatoeba #3013091 @Pfirsichbaeumchen / #3013861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3013091",
          "cefr_level": "A1",
          "word_slugs": [
            "aufzugeben-verb"
          ]
        },
        {
          "id": "917384",
          "text": "Es ist schwer, das Rauchen aufzugeben.",
          "translation": "Бросить курить трудно.",
          "source": "Tatoeba #917384 @Sudajaengi / #3390220 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/917384",
          "cefr_level": "A1",
          "word_slugs": [
            "aufzugeben-verb"
          ]
        },
        {
          "id": "444885",
          "text": "Vergiss bitte nicht, die Briefe aufzugeben.",
          "translation": "Пожалуйста, не забудь отправить письма.",
          "source": "Tatoeba #444885 @Espi / #8601267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/444885",
          "cefr_level": "A1",
          "word_slugs": [
            "aufzugeben-verb"
          ]
        },
        {
          "id": "381401",
          "text": "Er war fest entschlossen, das Rauchen aufzugeben.",
          "translation": "Он твёрдо решил бросить курить.",
          "source": "Tatoeba #381401 @Ole / #468241 @tensin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/381401",
          "cefr_level": "A1",
          "word_slugs": [
            "aufzugeben-verb"
          ]
        },
        {
          "id": "725133",
          "text": "Vergiss nicht, diesen Brief bei der Post aufzugeben.",
          "translation": "Не забудь отправить это письмо по почте.",
          "source": "Tatoeba #725133 @Esperantostern / #1774815 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/725133",
          "cefr_level": "A1",
          "word_slugs": [
            "aufzugeben-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
