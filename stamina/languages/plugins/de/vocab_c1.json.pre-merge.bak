    {
      "slug": "zurückzukommen-verb",
      "lemma": "zurückzukommen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8741,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of zurückkommen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13082026",
          "text": "Zurückzukommen war ein Fehler.",
          "translation": "Возвращение было ошибкой.",
          "source": "Tatoeba #13082026 @Rovo / #8412351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13082026",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukommen-verb"
          ]
        },
        {
          "id": "7564615",
          "text": "Tom wurde gebeten zurückzukommen.",
          "translation": "Тома попросили вернуться.",
          "source": "Tatoeba #7564615 @Pfirsichbaeumchen / #7564484 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7564615",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukommen-verb"
          ]
        },
        {
          "id": "12905418",
          "text": "Tom plant, übermorgen zurückzukommen.",
          "translation": "Том собирается вернуться послезавтра.",
          "source": "Tatoeba #12905418 @mhr / #12905382 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12905418",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukommen-verb"
          ]
        },
        {
          "id": "2480621",
          "text": "Er riet ihr, sofort zurückzukommen.",
          "translation": "Он посоветовал ей немедленно возвращаться.",
          "source": "Tatoeba #2480621 @al_ex_an_der / #2480619 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2480621",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukommen-verb"
          ]
        },
        {
          "id": "364984",
          "text": "Ich riet ihm, sofort zurückzukommen.",
          "translation": "Я посоветовал ему немедленно возвращаться.",
          "source": "Tatoeba #364984 @Wolf / #8305075 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/364984",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückzukommen-verb"
          ]
        }
