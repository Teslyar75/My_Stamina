          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "399164",
          "text": "Mein Zimmer ist im vierten Stock.",
          "translation": "Моя комната на четвёртом этаже.",
          "source": "Tatoeba #399164 @MUIRIEL / #400907 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399164",
          "cefr_level": "A1",
          "word_slugs": [
            "vierten-num"
          ]
        },
        {
          "id": "719797",
          "text": "Ich komme jeden vierten Juli hierher.",
          "translation": "Я прихожу сюда каждый год четвёртого июля.",
          "source": "Tatoeba #719797 @Esperantostern / #13023157 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/719797",
          "cefr_level": "A1",
          "word_slugs": [
            "vierten-num"
          ]
        },
        {
          "id": "10016342",
          "text": "Er ist aus dem vierten Stock gefallen.",
          "translation": "Он упал с пятого этажа.",
          "source": "Tatoeba #10016342 @Pfirsichbaeumchen / #10016329 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10016342",
          "cefr_level": "A1",
          "word_slugs": [
            "vierten-num"
          ]
        },
        {
          "id": "10016340",
          "text": "Sie ist aus dem vierten Stock gefallen.",
          "translation": "Она упала с пятого этажа.",
          "source": "Tatoeba #10016340 @Pfirsichbaeumchen / #10016331 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10016340",
          "cefr_level": "A1",
          "word_slugs": [
            "vierten-num"
          ]
        }
      ],
