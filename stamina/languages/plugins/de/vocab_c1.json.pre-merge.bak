          "cefr_level": "A1",
          "word_slugs": [
            "versprichst-verb"
          ]
        },
        {
          "id": "3874465",
          "text": "„Versprichst du's?“ – „Ja.“",
          "translation": "\"Обещаешь?\" - \"Да\".",
          "source": "Tatoeba #3874465 @raggione / #3874481 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3874465",
          "cefr_level": "A1",
          "word_slugs": [
            "versprichst-verb"
          ]
        },
        {
          "id": "13906666",
          "text": "Du hältst nicht, was du versprichst.",
          "translation": "Ты не держишь слово.",
          "source": "Tatoeba #13906666 @Biderl / #13906760 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13906666",
          "cefr_level": "A1",
          "word_slugs": [
            "versprichst-verb"
          ]
        }
