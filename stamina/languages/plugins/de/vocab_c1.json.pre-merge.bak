    {
      "slug": "ganzem-adj",
      "lemma": "ganzem",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8453,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong dative masculine/neuter singular of ganz"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13621260",
          "text": "Er liebt sie von ganzem Herzen.",
          "translation": "Он любит её всем сердцем.",
          "source": "Tatoeba #13621260 @Rovo / #2109866 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13621260",
          "cefr_level": "A1",
          "word_slugs": [
            "ganzem-adj"
          ]
        },
        {
          "id": "599208",
          "text": "Ich danke dir von ganzem Herzen.",
          "translation": "Благодарю тебя от всего сердца.",
          "source": "Tatoeba #599208 @samueldora / #3467932 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/599208",
          "cefr_level": "A1",
          "word_slugs": [
            "ganzem-adj"
          ]
        },
        {
          "id": "1692859",
          "text": "Ich stimme von ganzem Herzen zu.",
          "translation": "Согласен всей душой.",
          "source": "Tatoeba #1692859 @Pfirsichbaeumchen / #4521472 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1692859",
          "cefr_level": "A1",
          "word_slugs": [
            "ganzem-adj"
          ]
        },
        {
          "id": "2220247",
          "text": "Ich liebe ihn von ganzem Herzen.",
          "translation": "Я люблю его всем сердцем.",
          "source": "Tatoeba #2220247 @Pfirsichbaeumchen / #8310654 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2220247",
          "cefr_level": "A1",
          "word_slugs": [
            "ganzem-adj"
          ]
        },
        {
          "id": "4487570",
          "text": "Das hoffe ich von ganzem Herzen.",
          "translation": "Я надеюсь на это всем сердцем.",
          "source": "Tatoeba #4487570 @al_ex_an_der / #4487689 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4487570",
          "cefr_level": "A1",
          "word_slugs": [
            "ganzem-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
