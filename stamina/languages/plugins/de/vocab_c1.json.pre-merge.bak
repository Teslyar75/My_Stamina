          "text": "Die Halle war leer.",
          "translation": "Зал был пуст.",
          "source": "Tatoeba #4633997 @felvideki / #5372602 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4633997",
          "cefr_level": "A1",
          "word_slugs": [
            "halle-name"
          ]
        },
        {
          "id": "1871085",
          "text": "Die Halle war randvoll.",
          "translation": "Зал был переполнен.",
          "source": "Tatoeba #1871085 @Tamy / #5372609 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1871085",
          "cefr_level": "A1",
          "word_slugs": [
            "halle-name"
          ]
        },
        {
          "id": "785562",
          "text": "Er führte mich in die Halle hinein.",
          "translation": "Он проводил меня в зал.",
          "source": "Tatoeba #785562 @Esperantostern / #5372627 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/785562",
          "cefr_level": "A1",
          "word_slugs": [
            "halle-name"
          ]
        },
        {
          "id": "9311663",
          "text": "Halle ist auch eine Stadt in Deutschland.",
          "translation": "Галле также город в Германии.",
          "source": "Tatoeba #9311663 @felix63 / #13619054 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9311663",
          "cefr_level": "A1",
          "word_slugs": [
            "halle-name"
          ]
        },
        {
          "id": "3604097",
          "text": "Tom nahm den Besen aus dem Schrank in der Halle.",
          "translation": "Том взял метлу из шкафа в зале.",
          "source": "Tatoeba #3604097 @Zaghawa / #3604453 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3604097",
          "cefr_level": "A1",
          "word_slugs": [
            "halle-name"
          ]
        }
      ],
