    {
      "slug": "munter-adj",
      "lemma": "munter",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9224,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "merry, awake, brisk, cheery"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3626023",
          "text": "Tom ist jung und munter.",
          "translation": "Том молод и здоров.",
          "source": "Tatoeba #3626023 @Pfirsichbaeumchen / #3625989 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3626023",
          "cefr_level": "A1",
          "word_slugs": [
            "munter-adj"
          ]
        },
        {
          "id": "14074780",
          "text": "In der Weißdornhecke zwitscherten munter die Spatzen.",
          "translation": "В живой изгороди из боярышника оживлённо чирикали воробьи.",
          "source": "Tatoeba #14074780 @mhr / #10771493 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14074780",
          "cefr_level": "A1",
          "word_slugs": [
            "munter-adj"
          ]
        },
        {
          "id": "2740546",
          "text": "Ein Tasse starken Kaffees hilft mir, munter zu werden.",
          "translation": "Чашка крепкого кофе помогает мне проснуться.",
          "source": "Tatoeba #2740546 @al_ex_an_der / #2720403 @dipdowel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2740546",
          "cefr_level": "A1",
          "word_slugs": [
            "munter-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der munter",
        "nominative_pl": ""
      }
