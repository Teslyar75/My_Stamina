    {
      "slug": "mode-noun",
      "lemma": "Mode",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6278,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "vibrational mode (Form of oscillation of electromagnetic waves especially in waveguides)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6562351",
          "text": "Maria folgt der Mode.",
          "translation": "Мэри следит за модой.",
          "source": "Tatoeba #6562351 @Pfirsichbaeumchen / #5808509 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6562351",
          "cefr_level": "A1",
          "word_slugs": [
            "mode-noun"
          ]
        },
        {
          "id": "10820453",
          "text": "Die Mode ändert sich.",
          "translation": "Мода меняется.",
          "source": "Tatoeba #10820453 @carlosalberto / #10820252 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10820453",
          "cefr_level": "A1",
          "word_slugs": [
            "mode-noun"
          ]
        },
        {
          "id": "616832",
          "text": "Es ist aus der Mode.",
          "translation": "Это немодно.",
          "source": "Tatoeba #616832 @samueldora / #2113007 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/616832",
          "cefr_level": "A1",
          "word_slugs": [
            "mode-noun"
          ]
        },
        {
          "id": "353327",
          "text": "Lange Röcke sind in Mode.",
          "translation": "Длинные юбки в моде.",
          "source": "Tatoeba #353327 @MUIRIEL / #1525275 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/353327",
          "cefr_level": "A1",
          "word_slugs": [
            "mode-noun"
          ]
        },
        {
          "id": "1343980",
          "text": "Miniröcke sind aus der Mode.",
          "translation": "Мини-юбки вышли из моды.",
          "source": "Tatoeba #1343980 @PeterR / #1729837 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1343980",
          "cefr_level": "A1",
          "word_slugs": [
            "mode-noun"
          ]
        }
      ],
