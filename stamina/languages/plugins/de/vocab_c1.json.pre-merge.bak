    {
      "slug": "merkte-verb",
      "lemma": "merkte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6092,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of merken:",
          "first/third-person singular preterite",
          "inflection of merken:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12404520",
          "text": "Niemand merkte, was geschah.",
          "translation": "Никто не заметил, что происходит.",
          "source": "Tatoeba #12404520 @Pfirsichbaeumchen / #12404689 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12404520",
          "cefr_level": "A1",
          "word_slugs": [
            "merkte-verb"
          ]
        },
        {
          "id": "3074158",
          "text": "Tom merkte, dass Maria müde war.",
          "translation": "Том заметил, что Мэри устала.",
          "source": "Tatoeba #3074158 @raggione / #3074857 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3074158",
          "cefr_level": "A1",
          "word_slugs": [
            "merkte-verb"
          ]
        },
        {
          "id": "3074154",
          "text": "Tom merkte, dass Maria nicht zuhörte.",
          "translation": "Том заметил, что Мэри не слушала.",
          "source": "Tatoeba #3074154 @raggione / #4149517 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3074154",
          "cefr_level": "A1",
          "word_slugs": [
            "merkte-verb"
          ]
        },
        {
          "id": "12406787",
          "text": "Ich merkte nicht, daß ich verfolgt wurde.",
          "translation": "Я не заметил, что за мной следят.",
          "source": "Tatoeba #12406787 @Waldelfe / #12406817 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12406787",
          "cefr_level": "A1",
          "word_slugs": [
            "merkte-verb"
          ]
        },
        {
          "id": "10810496",
          "text": "Ich merkte nicht einmal, wie die Zeit verging.",
          "translation": "Я даже не заметил, как прошло время.",
          "source": "Tatoeba #10810496 @Yorwba / #7774750 @adem06 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10810496",
          "cefr_level": "A1",
          "word_slugs": [
            "merkte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
