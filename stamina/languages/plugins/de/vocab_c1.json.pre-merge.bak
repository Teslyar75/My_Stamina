          ]
        },
        {
          "id": "12899912",
          "text": "Lassen Sie sich diese fantastische Gelegenheit nicht entgehen!",
          "translation": "Не упустите эту потрясающую возможность.",
          "source": "Tatoeba #12899912 @mhr / #12899856 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12899912",
          "cefr_level": "A1",
          "word_slugs": [
