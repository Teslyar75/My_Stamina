    {
      "slug": "buddha-noun",
      "lemma": "Buddha",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8903,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "buddha"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1547089",
          "text": "Im Nichtwissen ist Buddha.",
          "translation": "В незнании - Будда.",
          "source": "Tatoeba #1547089 @Pfirsichbaeumchen / #2377005 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1547089",
          "cefr_level": "A1",
          "word_slugs": [
            "buddha-noun"
          ]
        },
        {
          "id": "3497640",
          "text": "Es gibt weder Gott noch Buddha.",
          "translation": "Не существует ни Бога, ни Будды.",
          "source": "Tatoeba #3497640 @al_ex_an_der / #895632 @pauldhunt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3497640",
          "cefr_level": "A1",
          "word_slugs": [
            "buddha-noun"
          ]
        },
        {
          "id": "361141",
          "text": "Es gibt keinen Gott und keinen Buddha.",
          "translation": "Не существует ни Бога, ни Будды.",
          "source": "Tatoeba #361141 @Kerstin / #895632 @pauldhunt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/361141",
          "cefr_level": "A1",
          "word_slugs": [
            "buddha-noun"
          ]
        },
        {
          "id": "408083",
          "text": "Der erkrankte alte Mann war in Wirklichkeit niemand anderes als der Buddha.",
          "translation": "Больной старик оказался не кем иным, как Буддой.",
          "source": "Tatoeba #408083 @xtofu80 / #2521737 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/408083",
          "cefr_level": "A1",
          "word_slugs": [
            "buddha-noun"
          ]
        }
      ],
