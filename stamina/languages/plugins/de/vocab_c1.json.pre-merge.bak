    {
      "slug": "beobachte-verb",
      "lemma": "beobachte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6491,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of beobachten:",
          "first-person singular present",
          "inflection of beobachten:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1743542",
          "text": "Ich beobachte dich.",
          "translation": "Я за тобой наблюдаю.",
          "source": "Tatoeba #1743542 @Pfirsichbaeumchen / #2771248 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1743542",
          "cefr_level": "A1",
          "word_slugs": [
            "beobachte-verb"
          ]
        },
        {
          "id": "4751887",
          "text": "Ich beobachte wilde Vögel.",
          "translation": "Я наблюдаю за дикими птицами.",
          "source": "Tatoeba #4751887 @bonny37 / #2492106 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4751887",
          "cefr_level": "A1",
          "word_slugs": [
            "beobachte-verb"
          ]
        },
        {
          "id": "12821983",
          "text": "Ich beobachte gern den Sonnenuntergang.",
          "translation": "Я люблю наблюдать за закатом.",
          "source": "Tatoeba #12821983 @Waldelfe / #10604513 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12821983",
          "cefr_level": "A1",
          "word_slugs": [
            "beobachte-verb"
          ]
        },
        {
          "id": "12821984",
          "text": "Ich beobachte gern, wie die Sonne untergeht.",
          "translation": "Я люблю наблюдать, как заходит солнце.",
          "source": "Tatoeba #12821984 @Waldelfe / #10604514 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12821984",
          "cefr_level": "A1",
          "word_slugs": [
            "beobachte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
