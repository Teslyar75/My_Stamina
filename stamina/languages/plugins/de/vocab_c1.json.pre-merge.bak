    {
      "slug": "fasziniert-verb",
      "lemma": "fasziniert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7368,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of faszinieren:",
          "third-person singular present",
          "inflection of faszinieren:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12478565",
          "text": "Tom hat mich fasziniert.",
          "translation": "Том меня очаровал.",
          "source": "Tatoeba #12478565 @Waldelfe / #12478649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12478565",
          "cefr_level": "A1",
          "word_slugs": [
            "fasziniert-verb"
          ]
        },
        {
          "id": "12597528",
          "text": "Die Welt fasziniert mich.",
          "translation": "Мир меня завораживает.",
          "source": "Tatoeba #12597528 @Adelpa / #12597508 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12597528",
          "cefr_level": "A1",
          "word_slugs": [
            "fasziniert-verb"
          ]
        },
        {
          "id": "6740935",
          "text": "Dieses Bild fasziniert mich.",
          "translation": "Эта картина меня завораживает.",
          "source": "Tatoeba #6740935 @Pfirsichbaeumchen / #6640409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6740935",
          "cefr_level": "A1",
          "word_slugs": [
            "fasziniert-verb"
          ]
        },
        {
          "id": "3506571",
          "text": "Wir waren von ihrer Stimme fasziniert.",
          "translation": "Мы были очарованы её голосом.",
          "source": "Tatoeba #3506571 @Pfirsichbaeumchen / #3506957 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3506571",
          "cefr_level": "A1",
          "word_slugs": [
            "fasziniert-verb"
          ]
        },
        {
          "id": "10728483",
          "text": "Etwas Unaussprechliches an dir fasziniert mich, Frau.",
          "translation": "Что-то невыразимое в тебе очаровывает меня, женщина.",
          "source": "Tatoeba #10728483 @carlosalberto / #10728489 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10728483",
          "cefr_level": "A1",
          "word_slugs": [
            "fasziniert-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
