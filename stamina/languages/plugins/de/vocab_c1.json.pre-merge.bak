    {
      "slug": "konferenz-noun",
      "lemma": "Konferenz",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6201,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "конференция"
        ],
        "en": [
          "conference"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1552574",
          "text": "Die Konferenz endete.",
          "translation": "Совещание закончилось.",
          "source": "Tatoeba #1552574 @Pfirsichbaeumchen / #12011667 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1552574",
          "cefr_level": "A1",
          "word_slugs": [
            "konferenz-noun"
          ]
        },
        {
          "id": "452203",
          "text": "Morgen endet die Konferenz.",
          "translation": "Конференция завершится завтра.",
          "source": "Tatoeba #452203 @Pfirsichbaeumchen / #405798 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/452203",
          "cefr_level": "A1",
          "word_slugs": [
            "konferenz-noun"
          ]
        },
        {
          "id": "13047118",
          "text": "Er ist auf einer Konferenz.",
          "translation": "Он на конференции.",
          "source": "Tatoeba #13047118 @Vortarulo / #2813227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13047118",
          "cefr_level": "A1",
          "word_slugs": [
            "konferenz-noun"
          ]
        },
        {
          "id": "8641530",
          "text": "Wann fängt die Konferenz an?",
          "translation": "Когда начинается конференция?",
          "source": "Tatoeba #8641530 @brauchinet / #8646182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8641530",
          "cefr_level": "A1",
          "word_slugs": [
            "konferenz-noun"
          ]
        },
        {
          "id": "4915347",
          "text": "Ich werde nicht auf die Konferenz kommen können.",
          "translation": "Я не смогу прийти на конференцию.",
          "source": "Tatoeba #4915347 @Pfirsichbaeumchen / #12783871 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4915347",
          "cefr_level": "A1",
          "word_slugs": [
            "konferenz-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Konferenz",
