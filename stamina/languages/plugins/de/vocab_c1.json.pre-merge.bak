    {
      "slug": "sturz-noun",
      "lemma": "Sturz",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8231,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "fall",
          "architrave, lintel",
          "clipping of Radsturz or Achssturz (“camber angle”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11155187",
          "text": "Ein Sturz aus der Höhe wäre tödlich.",
          "translation": "Падение с такой высоты было бы смертельным.",
          "source": "Tatoeba #11155187 @Pfirsichbaeumchen / #10190213 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11155187",
          "cefr_level": "A1",
          "word_slugs": [
            "sturz-noun"
          ]
        },
        {
          "id": "12816115",
          "text": "Ich wäre beim Sturz von der Brücke fast umgekommen.",
          "translation": "Я чуть не погиб, упав с моста.",
          "source": "Tatoeba #12816115 @Waldelfe / #8639946 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12816115",
          "cefr_level": "A1",
          "word_slugs": [
            "sturz-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "untergehen-verb",
      "lemma": "untergehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8233,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "потонуть",
          "затонуть",
          "идти ко дну",
          "пойти ко дну",
          "гибнуть",
          "погибнуть"
        ],
        "en": [
          "to set (of a heavenly body: to disappear below the horizon)",
          "to fall, to go down (to be defeated)",
          "to perish, to vanish",
          "to be drowned out"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10145053",
          "text": "Das Reich wird untergehen.",
          "translation": "Империя рухнет.",
          "source": "Tatoeba #10145053 @Pfirsichbaeumchen / #9944248 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10145053",
          "cefr_level": "A1",
          "word_slugs": [
            "untergehen-verb"
          ]
        },
        {
          "id": "14046005",
          "text": "Rußland wird niemals untergehen.",
          "translation": "Россия никогда не падёт.",
          "source": "Tatoeba #14046005 @Waldelfe / #13809002 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14046005",
          "cefr_level": "A1",
          "word_slugs": [
            "untergehen-verb"
          ]
        },
        {
          "id": "555716",
          "text": "Die Sonne wird bald untergehen.",
          "translation": "Солнце скоро зайдёт.",
          "source": "Tatoeba #555716 @MUIRIEL / #2268237 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/555716",
          "cefr_level": "A1",
          "word_slugs": [
            "untergehen-verb"
          ]
        },
        {
          "id": "3564151",
          "text": "Wird unsere Zivilisation eines Tages untergehen?",
          "translation": "Погибнет ли когда-нибудь наша цивилизация?",
          "source": "Tatoeba #3564151 @Mixtli / #3565281 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3564151",
          "cefr_level": "A1",
          "word_slugs": [
            "untergehen-verb"
          ]
        },
        {
          "id": "4905146",
          "text": "Heute Abend wird die Sonne um achtzehn Uhr und drei Minuten untergehen.",
          "translation": "Сегодня вечером солнце зайдёт в восемнадцать часов три минуты.",
          "source": "Tatoeba #4905146 @Esperantostern / #4905227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4905146",
          "cefr_level": "A1",
          "word_slugs": [
            "untergehen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
