    {
      "slug": "zogen-verb",
      "lemma": "zogen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5779,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person plural preterite of ziehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4771219",
          "text": "Wir zogen uns nicht an.",
          "translation": "Мы не одевались.",
          "source": "Tatoeba #4771219 @Tamy / #2723438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4771219",
          "cefr_level": "A1",
          "word_slugs": [
            "zogen-verb"
          ]
        },
        {
          "id": "6008631",
          "text": "Sie zogen sich warm an.",
          "translation": "Они тепло оделись.",
          "source": "Tatoeba #6008631 @raggione / #6008642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6008631",
          "cefr_level": "A1",
          "word_slugs": [
            "zogen-verb"
          ]
        },
        {
          "id": "3112965",
          "text": "Wir zogen in ein neues Haus.",
          "translation": "Мы переехали в новый дом.",
          "source": "Tatoeba #3112965 @freddy1 / #2978684 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3112965",
          "cefr_level": "A1",
          "word_slugs": [
            "zogen-verb"
          ]
        },
        {
          "id": "12866929",
          "text": "Sie zogen sich die Socken aus.",
          "translation": "Они сняли носки.",
          "source": "Tatoeba #12866929 @Waldelfe / #11833773 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12866929",
          "cefr_level": "A1",
          "word_slugs": [
            "zogen-verb"
          ]
        },
        {
          "id": "1934495",
          "text": "Sie zogen jede Möglichkeit in Betracht.",
          "translation": "Они приняли во внимание любую возможность.",
          "source": "Tatoeba #1934495 @Alois / #1537391 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1934495",
          "cefr_level": "A1",
          "word_slugs": [
            "zogen-verb"
          ]
        }
