            "venedig-name"
          ]
        },
        {
          "id": "7269474",
          "text": "Venedig ist eine romantische Stadt.",
          "translation": "Венеция - романтический город.",
          "source": "Tatoeba #7269474 @Pfirsichbaeumchen / #7028399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7269474",
          "cefr_level": "A1",
          "word_slugs": [
            "venedig-name"
          ]
        },
        {
          "id": "7233562",
          "text": "In Venedig gibt es viele Tauben.",
          "translation": "В Венеции много голубей.",
          "source": "Tatoeba #7233562 @Pfirsichbaeumchen / #8928129 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7233562",
          "cefr_level": "A1",
          "word_slugs": [
            "venedig-name"
          ]
        },
        {
          "id": "1757838",
          "text": "Er arbeitet als Gondoliere in Venedig.",
          "translation": "Он работает гондольером в Венеции.",
          "source": "Tatoeba #1757838 @Pfirsichbaeumchen / #4179440 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1757838",
          "cefr_level": "A1",
          "word_slugs": [
            "venedig-name"
          ]
        },
        {
          "id": "682754",
          "text": "Venedig in Italien ist eines der Weltwunder.",
          "translation": "Итальянская Венеция - одно из чудес света.",
          "source": "Tatoeba #682754 @al_ex_an_der / #3101124 @Khvalovsky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/682754",
          "cefr_level": "A1",
          "word_slugs": [
            "venedig-name"
          ]
        }
