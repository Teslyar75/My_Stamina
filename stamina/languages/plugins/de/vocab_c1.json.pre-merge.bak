    {
      "slug": "härter-adj",
      "lemma": "härter",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5292,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "comparative degree of hart"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "127407",
          "text": "Eisen ist härter als Gold.",
          "translation": "Железо твёрже, чем золото.",
          "source": "Tatoeba #127407 @MUIRIEL / #613275 @igor_chubin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/127407",
          "cefr_level": "A1",
          "word_slugs": [
            "härter-adj"
          ]
        },
        {
          "id": "12388083",
          "text": "Nichts ist härter als ein Diamant.",
          "translation": "Нет ничего твёрже алмаза.",
          "source": "Tatoeba #12388083 @Pfirsichbaeumchen / #497023 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12388083",
          "cefr_level": "A1",
          "word_slugs": [
            "härter-adj"
          ]
        },
        {
          "id": "10003930",
          "text": "Dieses Jahr wird noch härter als das vorige.",
          "translation": "Этот год будет ещё более суровым, чем предыдущий.",
          "source": "Tatoeba #10003930 @sakslane / #10003532 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10003930",
          "cefr_level": "A1",
          "word_slugs": [
            "härter-adj"
          ]
        },
        {
          "id": "3148972",
          "text": "Thomas arbeitet jetzt härter als im letzten Jahr.",
          "translation": "Том работает теперь больше, чем в прошлом году.",
          "source": "Tatoeba #3148972 @faehrmann / #2549897 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3148972",
          "cefr_level": "A1",
          "word_slugs": [
            "härter-adj"
          ]
        },
        {
          "id": "10003931",
          "text": "Dieses Jahr wird noch härter als das vorangegangene.",
          "translation": "Этот год будет ещё более суровым, чем предыдущий.",
          "source": "Tatoeba #10003931 @sakslane / #10003532 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10003931",
          "cefr_level": "A1",
          "word_slugs": [
            "härter-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
