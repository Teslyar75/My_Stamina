    {
      "slug": "sofia-name",
      "lemma": "Sofia",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8729,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "София"
        ],
        "en": [
          "a female given name, a less common variant of Sophia"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "13420874",
          "text": "Sofia ist die Hauptstadt Bulgariens.",
          "translation": "София - это столица Болгарии.",
          "source": "Tatoeba #13420874 @Vortarulo / #2639410 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13420874",
          "cefr_level": "A1",
          "word_slugs": [
            "sofia-name"
          ]
        },
        {
          "id": "2639388",
          "text": "Sofia ist die Hauptstadt von Bulgarien.",
          "translation": "София - это столица Болгарии.",
          "source": "Tatoeba #2639388 @Olya / #2639410 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2639388",
          "cefr_level": "A1",
          "word_slugs": [
            "sofia-name"
          ]
        },
        {
          "id": "10049827",
          "text": "Plowdiw liegt etwa 130 km südöstlich von Sofia.",
          "translation": "Пловдив расположен примерно в 130 километрах к юго-востоку от Софии.",
          "source": "Tatoeba #10049827 @sakslane / #13484707 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10049827",
          "cefr_level": "A1",
          "word_slugs": [
            "sofia-name"
          ]
        },
        {
          "id": "1282714",
          "text": "Es ist eine sechsstündige Fahrt von Sofia nach Varna.",
          "translation": "От Софии до Варны можно проехать за шесть часов.",
          "source": "Tatoeba #1282714 @Esperantostern / #4932137 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1282714",
          "cefr_level": "A1",
          "word_slugs": [
            "sofia-name"
          ]
        },
        {
          "id": "8154973",
          "text": "Von Sofia nach Warna sind es mit dem Auto sechs Stunden.",
          "translation": "От Софии до Варны шесть часов на машине.",
          "source": "Tatoeba #8154973 @Pfirsichbaeumchen / #3560190 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8154973",
          "cefr_level": "A1",
          "word_slugs": [
            "sofia-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
