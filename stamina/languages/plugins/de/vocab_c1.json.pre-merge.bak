        ],
        "en": [
          "Scotland (a constituent country of the United Kingdom)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "783565",
          "text": "Ich lebe in Schottland.",
          "translation": "Я живу в Шотландии.",
          "source": "Tatoeba #783565 @Chris / #2569785 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/783565",
          "cefr_level": "A1",
          "word_slugs": [
            "schottland-name"
          ]
        },
        {
          "id": "13452105",
          "text": "Mein Freund kommt aus Schottland.",
          "translation": "Мой друг из Шотландии.",
          "source": "Tatoeba #13452105 @Rovo / #13452069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13452105",
          "cefr_level": "A1",
          "word_slugs": [
            "schottland-name"
          ]
        },
        {
          "id": "1063732",
          "text": "Ihre Schwester lebt in Schottland.",
          "translation": "Её сестра живёт в Шотландии.",
          "source": "Tatoeba #1063732 @MUIRIEL / #5179827 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1063732",
          "cefr_level": "A1",
          "word_slugs": [
            "schottland-name"
          ]
        },
        {
          "id": "1063731",
          "text": "Seine Schwester lebt in Schottland.",
          "translation": "Сестра у него живёт в Шотландии.",
          "source": "Tatoeba #1063731 @MUIRIEL / #13987564 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1063731",
          "cefr_level": "A1",
          "word_slugs": [
            "schottland-name"
          ]
        },
        {
          "id": "5179718",
          "text": "Ihre Schwester wohnt in Schottland.",
          "translation": "Её сестра живёт в Шотландии.",
          "source": "Tatoeba #5179718 @J5lx / #5179827 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5179718",
          "cefr_level": "A1",
