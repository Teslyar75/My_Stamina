    {
      "slug": "einmalige-adj",
      "lemma": "einmalige",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9458,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of einmalig:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of einmalig:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12482841",
          "text": "Das ist eine einmalige Gelegenheit.",
          "translation": "Это уникальная возможность.",
          "source": "Tatoeba #12482841 @Waldelfe / #11509585 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12482841",
          "cefr_level": "A1",
          "word_slugs": [
            "einmalige-adj"
          ]
        },
        {
          "id": "12899919",
          "text": "Lasst euch diese einmalige Gelegenheit nicht entgehen!",
          "translation": "Не упустите эту исключительную возможность.",
          "source": "Tatoeba #12899919 @mhr / #12899855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12899919",
          "cefr_level": "A1",
          "word_slugs": [
            "einmalige-adj"
          ]
        },
        {
          "id": "12899918",
          "text": "Lassen Sie sich diese einmalige Gelegenheit nicht entgehen!",
          "translation": "Не упустите эту исключительную возможность.",
          "source": "Tatoeba #12899918 @mhr / #12899855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12899918",
          "cefr_level": "A1",
          "word_slugs": [
            "einmalige-adj"
          ]
        },
        {
          "id": "1912511",
          "text": "Ein jeder von uns besitzt einmalige Besonderheiten und Qualitäten.",
          "translation": "Каждый из нас обладает уникальными особенностями и качествами.",
          "source": "Tatoeba #1912511 @al_ex_an_der / #1912508 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1912511",
          "cefr_level": "A1",
          "word_slugs": [
            "einmalige-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "verstösst-verb",
      "lemma": "verstößt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9459,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second/third-person singular present of verstoßen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5099301",
          "text": "Verstößt das nicht gegen die Regeln?",
          "translation": "Не нарушает ли это правил?",
          "source": "Tatoeba #5099301 @Pfirsichbaeumchen / #5100418 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5099301",
          "cefr_level": "A1",
          "word_slugs": [
            "verstösst-verb"
          ]
        },
        {
          "id": "9860554",
          "text": "Dieser Satz verstößt gegen die Regeln der Grammatik.",
          "translation": "Это предложение нарушает правила грамматики.",
          "source": "Tatoeba #9860554 @Pfirsichbaeumchen / #9860543 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9860554",
          "cefr_level": "A1",
          "word_slugs": [
            "verstösst-verb"
          ]
        },
        {
          "id": "2911412",
          "text": "Leider verstößt dein Beitrag gegen die Regeln der Grammatik.",
          "translation": "К сожалению, твой вклад нарушает грамматические нормы.",
          "source": "Tatoeba #2911412 @al_ex_an_der / #2911213 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2911412",
          "cefr_level": "A1",
          "word_slugs": [
            "verstösst-verb"
          ]
        },
        {
          "id": "14052961",
          "text": "Es wird nichts Schlimmes passieren, wenn du einmal gegen die Regeln verstößt.",
          "translation": "Ничего страшного не произойдёт, если ты разок нарушишь правила.",
          "source": "Tatoeba #14052961 @mhr / #14052828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14052961",
          "cefr_level": "A1",
          "word_slugs": [
            "verstösst-verb"
          ]
        },
        {
          "id": "14052962",
          "text": "Es wird nichts Schlimmes geschehen, wenn du einmal gegen die Regeln verstößt.",
          "translation": "Ничего страшного не произойдёт, если ты разок нарушишь правила.",
          "source": "Tatoeba #14052962 @mhr / #14052828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14052962",
          "cefr_level": "A1",
          "word_slugs": [
            "verstösst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "ähnelt-verb",
      "lemma": "ähnelt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9460,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of ähneln:",
          "third-person singular present",
          "inflection of ähneln:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12880324",
          "text": "C# ähnelt Java.",
          "translation": "C# похож на Java.",
          "source": "Tatoeba #12880324 @mhr / #3571660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12880324",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnelt-verb"
          ]
        },
        {
          "id": "14081357",
          "text": "Er ähnelt mir nicht.",
          "translation": "Он не похож на меня.",
          "source": "Tatoeba #14081357 @mhr / #14081318 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14081357",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnelt-verb"
          ]
        },
        {
          "id": "5415279",
          "text": "Ihr ähnelt euch sehr.",
          "translation": "Вы очень похожи.",
          "source": "Tatoeba #5415279 @Zaghawa / #5415294 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5415279",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnelt-verb"
          ]
        },
        {
          "id": "2175565",
          "text": "Es ähnelt einem Apfel.",
          "translation": "Похоже на яблоко.",
          "source": "Tatoeba #2175565 @Tamy / #5119179 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2175565",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnelt-verb"
          ]
        },
        {
          "id": "948406",
          "text": "Er ähnelt seinem Vater.",
          "translation": "Он похож на своего отца.",
          "source": "Tatoeba #948406 @Sudajaengi / #1436299 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/948406",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnelt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
