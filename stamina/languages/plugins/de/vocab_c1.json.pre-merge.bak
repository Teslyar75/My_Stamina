        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8912895",
          "text": "Mary hat ihr Leben für uns riskiert.",
          "translation": "Мэри рисковала ради нас жизнью.",
          "source": "Tatoeba #8912895 @Ricardo14 / #9152846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8912895",
          "cefr_level": "A1",
          "word_slugs": [
            "riskiert-verb"
          ]
        },
        {
          "id": "1821264",
          "text": "Wer ja oder nein sagt, der riskiert immer den großen Irrtum.",
          "translation": "Тот, кто говорит \"да\" или \"нет\", всегда рискует совершить большую ошибку.",
          "source": "Tatoeba #1821264 @Pfirsichbaeumchen / #2787719 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1821264",
          "cefr_level": "A1",
          "word_slugs": [
            "riskiert-verb"
          ]
        }
      ],
