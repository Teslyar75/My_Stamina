    {
      "slug": "teresa-name",
      "lemma": "Teresa",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6759,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a female given name, variant of Theresa"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3752793",
          "text": "Wem hat Mutter Teresa geholfen?",
          "translation": "Кому помогала Мать Тереза?",
          "source": "Tatoeba #3752793 @Jens_Odo / #12141586 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3752793",
          "cefr_level": "A1",
          "word_slugs": [
            "teresa-name"
          ]
        },
        {
          "id": "688321",
          "text": "Mutter Teresa wurde 1910 in Jugoslawien geboren.",
          "translation": "Мать Тереза родилась в Югославии в 1910 году.",
          "source": "Tatoeba #688321 @MUIRIEL / #1525503 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/688321",
          "cefr_level": "A1",
          "word_slugs": [
            "teresa-name"
          ]
        },
        {
          "id": "2446370",
          "text": "Nein, ich heiße nicht Maria, sondern Teresa.",
          "translation": "Нет, меня зовут не Мария. Меня зовут Тереза.",
          "source": "Tatoeba #2446370 @Pfirsichbaeumchen / #1671321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2446370",
          "cefr_level": "A1",
          "word_slugs": [
            "teresa-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
