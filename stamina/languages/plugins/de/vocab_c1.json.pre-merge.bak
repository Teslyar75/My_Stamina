          ]
        },
        {
          "id": "3474425",
          "text": "Tom verließ rasch den Raum.",
          "translation": "Том быстро вышел из комнаты.",
          "source": "Tatoeba #3474425 @Pfirsichbaeumchen / #8442100 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3474425",
