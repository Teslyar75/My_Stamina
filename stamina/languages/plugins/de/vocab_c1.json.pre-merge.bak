    {
      "slug": "zurückkommst-verb",
      "lemma": "zurückkommst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9189,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular dependent present of zurückkommen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7088626",
          "text": "Versprich mir, dass du zurückkommst!",
          "translation": "Обещай мне, что вернёшься.",
          "source": "Tatoeba #7088626 @Pfirsichbaeumchen / #3885434 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7088626",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkommst-verb"
          ]
        },
        {
          "id": "1823850",
          "text": "Ich bleibe hier, bis du zurückkommst.",
          "translation": "Я побуду здесь, пока ты не вернёшься.",
          "source": "Tatoeba #1823850 @Zaghawa / #8428290 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1823850",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkommst-verb"
          ]
        },
        {
          "id": "12560729",
          "text": "Ich will einfach, daß du zurückkommst.",
          "translation": "Я просто хочу, чтобы ты вернулся.",
          "source": "Tatoeba #12560729 @Waldelfe / #12560720 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12560729",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkommst-verb"
          ]
        },
        {
          "id": "12582070",
          "text": "Ich werde warten, bis du zurückkommst.",
          "translation": "Я подожду, пока ты вернёшься.",
          "source": "Tatoeba #12582070 @Waldelfe / #12581975 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12582070",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkommst-verb"
          ]
        },
        {
          "id": "367062",
          "text": "Wenn du zurückkommst, werde ich schon weg sein.",
          "translation": "Когда ты вернёшься, меня здесь уже не будет.",
          "source": "Tatoeba #367062 @cburgmer / #2032083 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/367062",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückkommst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
