      "gender": null,
      "examples": [
        {
          "id": "6641267",
          "text": "Wir haben uns verabschiedet.",
          "translation": "Мы попрощались.",
          "source": "Tatoeba #6641267 @Felixjp / #3983616 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6641267",
          "cefr_level": "A1",
          "word_slugs": [
            "verabschiedet-verb"
          ]
        },
        {
          "id": "784141",
          "text": "Verabschiedet euch von euren Freunden.",
          "translation": "Попрощайтесь с друзьями.",
          "source": "Tatoeba #784141 @Hans_Adler / #14090135 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/784141",
          "cefr_level": "A1",
