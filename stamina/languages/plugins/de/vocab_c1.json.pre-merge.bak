    {
      "slug": "anstelle-prep",
      "lemma": "anstelle",
      "pos": "prep",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8085,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "instead of, in place of"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10782052",
          "text": "Verwende Zitronensaft anstelle von Essig.",
          "translation": "Используй лимонный сок вместо уксуса.",
          "source": "Tatoeba #10782052 @GaryGaryGary / #2766761 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10782052",
          "cefr_level": "A1",
          "word_slugs": [
            "anstelle-prep"
          ]
        },
        {
          "id": "6031704",
          "text": "Anstelle von Baumwolle pflanzten wir Erdnüsse.",
          "translation": "Вместо хлопка мы посадили арахис.",
          "source": "Tatoeba #6031704 @raggione / #6608206 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6031704",
          "cefr_level": "A1",
          "word_slugs": [
            "anstelle-prep"
          ]
        },
        {
          "id": "7464105",
          "text": "Anstelle von Butter habe ich Margarine genommen.",
          "translation": "Вместо масла я взял маргарин.",
          "source": "Tatoeba #7464105 @Pfirsichbaeumchen / #7464297 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7464105",
          "cefr_level": "A1",
          "word_slugs": [
            "anstelle-prep"
          ]
        },
        {
          "id": "2657204",
          "text": "Ich nehme Zwiebelringe anstelle von Pommes frites.",
          "translation": "Я возьму луковые колечки вместо картошки фри.",
          "source": "Tatoeba #2657204 @Pfirsichbaeumchen / #5274430 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2657204",
          "cefr_level": "A1",
          "word_slugs": [
            "anstelle-prep"
          ]
        },
        {
          "id": "1811245",
          "text": "Ich kaufte das schwarze Fahrrad anstelle des roten.",
          "translation": "Я купил чёрный велосипед вместо красного.",
          "source": "Tatoeba #1811245 @Pfirsichbaeumchen / #1778197 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1811245",
          "cefr_level": "A1",
          "word_slugs": [
            "anstelle-prep"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
