        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2847831",
          "text": "Er wurde während der Revolution gehängt.",
          "translation": "Он был повешен во время революции.",
          "source": "Tatoeba #2847831 @kaktuswasser / #2843694 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2847831",
          "cefr_level": "A1",
