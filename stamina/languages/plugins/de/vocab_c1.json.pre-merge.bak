      "examples": [
        {
          "id": "2410147",
          "text": "Sie entgingen ihrer Bestrafung.",
          "translation": "Они избежали наказания.",
          "source": "Tatoeba #2410147 @Pfirsichbaeumchen / #2408082 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2410147",
          "cefr_level": "A1",
          "word_slugs": [
