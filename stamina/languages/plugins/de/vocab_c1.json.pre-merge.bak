          "past participle of schmecken"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3013529",
          "text": "Hat die Suppe geschmeckt?",
          "translation": "Суп был вкусный?",
          "source": "Tatoeba #3013529 @Pfirsichbaeumchen / #3291753 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3013529",
          "cefr_level": "A1",
          "word_slugs": [
            "geschmeckt-verb"
          ]
        },
        {
          "id": "5709529",
          "text": "Hat das Essen geschmeckt?",
          "translation": "Вкусная была еда?",
          "source": "Tatoeba #5709529 @halfdan / #14073469 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5709529",
          "cefr_level": "A1",
          "word_slugs": [
            "geschmeckt-verb"
          ]
        },
        {
          "id": "12673648",
          "text": "Hat dir der Wein geschmeckt?",
          "translation": "Тебе понравилось вино?",
          "source": "Tatoeba #12673648 @Waldelfe / #13224976 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12673648",
          "cefr_level": "A1",
          "word_slugs": [
            "geschmeckt-verb"
          ]
        },
        {
          "id": "13538177",
          "text": "Die Pizza hat gut geschmeckt.",
          "translation": "Пицца была вкусная.",
          "source": "Tatoeba #13538177 @Vortarulo / #5384401 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13538177",
          "cefr_level": "A1",
          "word_slugs": [
            "geschmeckt-verb"
          ]
        },
        {
          "id": "11740139",
          "text": "Hat euch das Essen geschmeckt?",
          "translation": "Вам понравилась еда?",
          "source": "Tatoeba #11740139 @mhr / #1791928 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11740139",
          "cefr_level": "A1",
          "word_slugs": [
            "geschmeckt-verb"
          ]
        }
      ],
