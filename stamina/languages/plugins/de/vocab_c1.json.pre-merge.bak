    {
      "slug": "zweifeln-noun",
      "lemma": "Zweifeln",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7105,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Zweifel"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11098833",
          "text": "Zweifeln Sie noch immer?",
          "translation": "Вы ещё сомневаетесь?",
          "source": "Tatoeba #11098833 @Pfirsichbaeumchen / #8553809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11098833",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-noun"
          ]
        },
        {
          "id": "12478886",
          "text": "Zweifeln Sie nicht an sich!",
          "translation": "Не сомневайтесь в себе.",
          "source": "Tatoeba #12478886 @Waldelfe / #12478879 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12478886",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-noun"
          ]
        },
        {
          "id": "12478892",
          "text": "Zweifeln Sie nicht an Ihren Fähigkeiten!",
          "translation": "Не сомневайтесь в своих способностях.",
          "source": "Tatoeba #12478892 @Waldelfe / #12478891 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12478892",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-noun"
          ]
        },
        {
          "id": "1869028",
          "text": "Zweifeln Sie noch an dem, was ich gesagt habe?",
          "translation": "Вы всё ещё сомневаетесь в том, что я сказал?",
          "source": "Tatoeba #1869028 @Tamy / #4445233 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1869028",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
