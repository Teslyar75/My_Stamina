          ]
        },
        {
          "id": "13045780",
          "text": "Die Polizei hat uns von dem Unfall berichtet.",
          "translation": "Полиция сообщила нам о происшествии.",
          "source": "Tatoeba #13045780 @mhr / #10764961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13045780",
          "cefr_level": "A1",
          "word_slugs": [
