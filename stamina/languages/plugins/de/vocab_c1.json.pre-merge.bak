          "господствовать"
        ],
        "en": [
          "to master",
          "to dominate",
          "to restrain oneself"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1289757",
          "text": "Du musst dich beherrschen.",
          "translation": "Тебе надо держать себя в руках.",
          "source": "Tatoeba #1289757 @enteka / #3034410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1289757",
          "cefr_level": "A1",
          "word_slugs": [
            "beherrschen-verb"
          ]
        },
        {
          "id": "3034419",
          "text": "Sie müssen sich beherrschen.",
          "translation": "Вам надо держать себя в руках.",
          "source": "Tatoeba #3034419 @al_ex_an_der / #3034411 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3034419",
          "cefr_level": "A1",
          "word_slugs": [
            "beherrschen-verb"
          ]
        },
        {
          "id": "1841333",
          "text": "Ich kann mich nicht beherrschen.",
          "translation": "Я не могу себя контролировать.",
          "source": "Tatoeba #1841333 @Pfirsichbaeumchen / #5318102 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1841333",
          "cefr_level": "A1",
          "word_slugs": [
            "beherrschen-verb"
          ]
        },
        {
          "id": "3357212",
          "text": "Tom kann sich nicht beherrschen.",
          "translation": "Том не в состоянии себя контролировать.",
          "source": "Tatoeba #3357212 @Pfirsichbaeumchen / #3523476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3357212",
          "cefr_level": "A1",
          "word_slugs": [
            "beherrschen-verb"
          ]
        },
        {
          "id": "887995",
          "text": "Sie kann ihre Gefühle nicht beherrschen.",
          "translation": "Она не может контролировать свои чувства.",
          "source": "Tatoeba #887995 @Grobian / #642392 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/887995",
          "cefr_level": "A1",
          "word_slugs": [
            "beherrschen-verb"
          ]
        }
      ],
