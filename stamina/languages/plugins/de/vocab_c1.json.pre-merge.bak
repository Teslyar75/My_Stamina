    {
      "slug": "erregt-verb",
      "lemma": "erregt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6628,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of erregen:",
          "third-person singular present",
          "inflection of erregen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2503189",
          "text": "All dies erregt meine Neugier.",
          "translation": "Всё это возбуждает моё любопытство.",
          "source": "Tatoeba #2503189 @al_ex_an_der / #2503191 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2503189",
          "cefr_level": "A1",
          "word_slugs": [
            "erregt-verb"
          ]
        },
        {
          "id": "8137669",
          "text": "Ich will nicht, dass Tom sich erregt.",
          "translation": "Я не хочу, чтобы Том расстраивался.",
          "source": "Tatoeba #8137669 @Pfirsichbaeumchen / #2616768 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8137669",
          "cefr_level": "A1",
          "word_slugs": [
            "erregt-verb"
          ]
        },
        {
          "id": "2265937",
          "text": "Alles, was er sieht, erregt seine Neugier.",
          "translation": "Всё, что он видит, возбуждает его любопытство.",
          "source": "Tatoeba #2265937 @Pfirsichbaeumchen / #12273833 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2265937",
          "cefr_level": "A1",
          "word_slugs": [
            "erregt-verb"
          ]
        },
        {
          "id": "2848825",
          "text": "Haß erregt Hader; aber Liebe deckt zu alle Übertretungen.",
          "translation": "Ненависть возбуждает раздоры, но любовь покрывает все грехи.",
          "source": "Tatoeba #2848825 @carlosalberto / #2848812 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2848825",
          "cefr_level": "A1",
          "word_slugs": [
            "erregt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
