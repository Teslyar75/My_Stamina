      "gender": null,
      "examples": [
        {
          "id": "13648885",
          "text": "Ich leide an Migräne.",
          "translation": "Я страдаю от мигрени.",
          "source": "Tatoeba #13648885 @mhr / #13312803 @frpzzd (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13648885",
