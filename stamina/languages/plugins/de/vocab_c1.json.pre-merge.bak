      },
      "gender": null,
      "examples": [
        {
          "id": "3040140",
          "text": "Er öffnete die Tür.",
          "translation": "Он открыл дверь.",
          "source": "Tatoeba #3040140 @Pfirsichbaeumchen / #1013521 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3040140",
          "cefr_level": "A1",
          "word_slugs": [
            "öffnete-verb"
          ]
        },
        {
          "id": "2299163",
          "text": "Er öffnete den Mund.",
          "translation": "Он открыл рот.",
          "source": "Tatoeba #2299163 @Pfirsichbaeumchen / #3593034 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2299163",
          "cefr_level": "A1",
          "word_slugs": [
