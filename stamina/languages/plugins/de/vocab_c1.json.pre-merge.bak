          "cefr_level": "A1",
          "word_slugs": [
            "männliche-adj"
          ]
        },
        {
          "id": "11817695",
          "text": "Warum gibt es so wenige männliche Harfenspieler?",
          "translation": "Почему так мало мужчин-арфистов?",
