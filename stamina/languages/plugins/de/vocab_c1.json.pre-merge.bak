    {
      "slug": "cäsar-name",
      "lemma": "Cäsar",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7130,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Roman cognomen, especially referring to Gaius Julius Caesar",
          "a male given name of very rare usage"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12408083",
          "text": "Cäsar wurde ermordet.",
          "translation": "Цезарь был убит.",
          "source": "Tatoeba #12408083 @Waldelfe / #8170014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12408083",
          "cefr_level": "A1",
          "word_slugs": [
            "cäsar-name"
          ]
        },
        {
          "id": "3298782",
          "text": "Cäsar wurde in Rom geboren.",
          "translation": "Цезарь родился в Риме.",
          "source": "Tatoeba #3298782 @Pfirsichbaeumchen / #3298779 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3298782",
          "cefr_level": "A1",
          "word_slugs": [
            "cäsar-name"
          ]
        },
        {
          "id": "14059880",
          "text": "Ich erinnere mich an Cäsar.",
          "translation": "Я помню Цезаря.",
          "source": "Tatoeba #14059880 @Vortarulo / #14059886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14059880",
          "cefr_level": "A1",
          "word_slugs": [
            "cäsar-name"
          ]
        },
        {
          "id": "6942625",
          "text": "Cäsar baute eine Brücke über den Rhein.",
          "translation": "Цезарь построил мост через Рейн.",
          "source": "Tatoeba #6942625 @Esperantostern / #7001849 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6942625",
          "cefr_level": "A1",
          "word_slugs": [
            "cäsar-name"
          ]
        },
        {
          "id": "13709180",
          "text": "Cäsar verläßt Gallien, überquert den Rubikon und zieht nach Italien ein.",
          "translation": "Цезарь покидает Галлию, переходит Рубикон и вторгается в Италию.",
          "source": "Tatoeba #13709180 @Waldelfe / #2562831 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13709180",
          "cefr_level": "A1",
          "word_slugs": [
            "cäsar-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
