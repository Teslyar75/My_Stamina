    {
      "slug": "gewinnst-verb",
      "lemma": "gewinnst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6190,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of gewinnen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14081256",
          "text": "Weiter so und du gewinnst!",
          "translation": "Продолжай в том же духе и победишь!",
          "source": "Tatoeba #14081256 @Ioan_Cristian / #14092707 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14081256",
          "cefr_level": "A1",
          "word_slugs": [
            "gewinnst-verb"
          ]
        },
        {
          "id": "5957483",
          "text": "Ich kann nicht erlauben, dass du gewinnst.",
          "translation": "Я не могу позволить тебе выиграть.",
          "source": "Tatoeba #5957483 @arved / #12019989 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5957483",
          "cefr_level": "A1",
          "word_slugs": [
            "gewinnst-verb"
          ]
        },
        {
          "id": "563684",
          "text": "Welches Spiel ich auch mit dir spiele, du gewinnst nie.",
          "translation": "В какую бы игру я с тобой ни играл, ты никогда не выигрываешь.",
          "source": "Tatoeba #563684 @MUIRIEL / #4995446 @al_lastor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/563684",
          "cefr_level": "A1",
          "word_slugs": [
            "gewinnst-verb"
          ]
        }
      ],
