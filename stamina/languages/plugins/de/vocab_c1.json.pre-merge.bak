        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "758228",
          "text": "Fliegst du oft?",
          "translation": "Ты часто летаешь?",
          "source": "Tatoeba #758228 @Pfirsichbaeumchen / #6001688 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/758228",
          "cefr_level": "A1",
          "word_slugs": [
            "fliegst-verb"
          ]
        },
        {
          "id": "10588755",
          "text": "Wohin fliegst du?",
          "translation": "Куда летишь?",
          "source": "Tatoeba #10588755 @dirkz / #10120682 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10588755",
          "cefr_level": "A1",
          "word_slugs": [
            "fliegst-verb"
          ]
        },
        {
          "id": "10588756",
          "text": "Mit welcher Gesellschaft fliegst du?",
          "translation": "Ты какой авиакомпанией летишь?",
          "source": "Tatoeba #10588756 @dirkz / #8665379 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10588756",
          "cefr_level": "A1",
          "word_slugs": [
            "fliegst-verb"
          ]
        },
        {
          "id": "8721286",
          "text": "Fliegst du oder fährst du mit dem Zug?",
          "translation": "Ты летишь самолётом или едешь на поезде?",
          "source": "Tatoeba #8721286 @Yorwba / #11179283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8721286",
          "cefr_level": "A1",
          "word_slugs": [
            "fliegst-verb"
          ]
        },
        {
          "id": "10967349",
          "text": "Fliegst du oder fährst du mit der Bahn?",
          "translation": "Ты летишь самолётом или едешь на поезде?",
          "source": "Tatoeba #10967349 @toivo / #11179283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967349",
          "cefr_level": "A1",
          "word_slugs": [
            "fliegst-verb"
          ]
        }
