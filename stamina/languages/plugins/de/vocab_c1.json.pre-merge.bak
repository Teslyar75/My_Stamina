    {
      "slug": "ausbruch-noun",
      "lemma": "Ausbruch",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7639,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "outbreak, beginning (of an epidemic, war, etc)",
          "escape; breakout, breaking out (of prison, etc)",
          "eruption",
          "Ausbruch wine"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8220461",
          "text": "Tom floh vor Ausbruch des Krieges nach Kanada.",
          "translation": "Перед войной Том бежал в Канаду.",
          "source": "Tatoeba #8220461 @Pfirsichbaeumchen / #8173502 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8220461",
          "cefr_level": "A1",
          "word_slugs": [
            "ausbruch-noun"
          ]
        },
        {
          "id": "4881636",
          "text": "Der Ausbruch des Vulkans Vesuv zerstörte die Stadt Pompeji.",
          "translation": "Извержение вулкана Везувий разрушило город Помпеи.",
          "source": "Tatoeba #4881636 @Manfredo / #4883179 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4881636",
          "cefr_level": "A1",
          "word_slugs": [
            "ausbruch-noun"
          ]
        },
        {
          "id": "13514097",
          "text": "Möge der Friedensrat den Ausbruch neuer Kriege für immer verhindern!",
          "translation": "Пусть Совет Мира навсегда предотвратит возникновение новых войн!",
          "source": "Tatoeba #13514097 @carlosalberto / #13514104 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13514097",
          "cefr_level": "A1",
          "word_slugs": [
            "ausbruch-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "tuch-noun",
      "lemma": "Tuch",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7640,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сукно"
        ],
        "en": [
          "cloth; piece of fabric or tissue of any kind: scarf, kerchief, blanket, towel, etc."
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "1222808",
          "text": "Das ist wie ein rotes Tuch.",
          "translation": "Это всё равно что красная тряпка для быка.",
          "source": "Tatoeba #1222808 @Esperantostern / #2402553 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1222808",
          "cefr_level": "A1",
          "word_slugs": [
            "tuch-noun"
          ]
        },
        {
          "id": "2733325",
          "text": "Bring mir einen Meter schwarzes Tuch!",
          "translation": "Принеси мне один метр чёрной ткани!",
          "source": "Tatoeba #2733325 @Pfirsichbaeumchen / #5694958 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2733325",
          "cefr_level": "A1",
          "word_slugs": [
            "tuch-noun"
          ]
        },
        {
          "id": "6098544",
          "text": "Ich wickelte mich in ein Tuch ein.",
          "translation": "Я завернулся в полотенце.",
          "source": "Tatoeba #6098544 @Pfirsichbaeumchen / #4023517 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6098544",
          "cefr_level": "A1",
          "word_slugs": [
            "tuch-noun"
          ]
        },
        {
          "id": "340766",
          "text": "Sie hat ihre nassen Haare mit einem Tuch abgetrocknet.",
          "translation": "Она вытерла мокрые волосы полотенцем.",
          "source": "Tatoeba #340766 @tinacalysto / #7731198 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/340766",
          "cefr_level": "A1",
          "word_slugs": [
            "tuch-noun"
          ]
        },
        {
          "id": "12443209",
          "text": "Sie warf sich ein Tuch über die Schulter und verließ das Zimmer.",
          "translation": "Она перекинула через плечо полотенце и вышла из комнаты.",
          "source": "Tatoeba #12443209 @Pfirsichbaeumchen / #12443231 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12443209",
          "cefr_level": "A1",
          "word_slugs": [
            "tuch-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Tuch",
        "nominative_pl": ""
      }
    },
