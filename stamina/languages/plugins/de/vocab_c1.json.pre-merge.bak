    {
      "slug": "ludwig-name",
      "lemma": "Ludwig",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7046,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "Людовик"
        ],
        "en": [
          "a male given name from Middle High German, feminine equivalent Luise, Luisa, Louise, and Louisa; variant forms Lutz, Luis, Louis"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "915826",
          "text": "Ich heiße Ludwig.",
          "translation": "Меня зовут Людвиг.",
          "source": "Tatoeba #915826 @Fingerhut / #2527740 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/915826",
          "cefr_level": "A1",
          "word_slugs": [
            "ludwig-name"
          ]
        },
        {
          "id": "435972",
          "text": "Mein Name ist Ludwig.",
          "translation": "Меня зовут Людвиг.",
          "source": "Tatoeba #435972 @Espi / #2527740 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/435972",
          "cefr_level": "A1",
          "word_slugs": [
            "ludwig-name"
          ]
        },
        {
          "id": "10192778",
          "text": "Tom hält sich für Ludwig den Vierzehnten.",
          "translation": "Том принимает себя за Людовика Четырнадцатого.",
          "source": "Tatoeba #10192778 @Adelpa / #10755530 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10192778",
          "cefr_level": "A1",
          "word_slugs": [
            "ludwig-name"
          ]
        },
        {
          "id": "10303063",
          "text": "Das wenige Geld, das ich hatte, gab ich Ludwig.",
          "translation": "Те немногие деньги, что у меня были, я отдал Людвигу.",
          "source": "Tatoeba #10303063 @Pfirsichbaeumchen / #10303064 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10303063",
          "cefr_level": "A1",
          "word_slugs": [
            "ludwig-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Ludwig",
        "nominative_pl": ""
      }
    },
