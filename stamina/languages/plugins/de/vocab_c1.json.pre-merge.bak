        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1731276",
          "text": "In welcher Etage sind wir?",
          "translation": "На каком мы этаже?",
          "source": "Tatoeba #1731276 @al_ex_an_der / #5123938 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1731276",
          "cefr_level": "A1",
          "word_slugs": [
            "etage-noun"
          ]
        },
        {
          "id": "4332050",
          "text": "In welcher Etage wohnt er?",
          "translation": "На каком этаже он живёт?",
          "source": "Tatoeba #4332050 @Tlustulimu / #4332055 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4332050",
          "cefr_level": "A1",
          "word_slugs": [
            "etage-noun"
          ]
        },
        {
          "id": "12287827",
          "text": "In welcher Etage wohnt ihr?",
          "translation": "На каком этаже вы живёте?",
          "source": "Tatoeba #12287827 @mhr / #2078804 @Lathean (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12287827",
          "cefr_level": "A1",
          "word_slugs": [
            "etage-noun"
          ]
        },
        {
          "id": "2079486",
          "text": "Auf welcher Etage wohnst du?",
          "translation": "На каком этаже ты живёшь?",
          "source": "Tatoeba #2079486 @jast / #2341546 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2079486",
          "cefr_level": "A1",
          "word_slugs": [
            "etage-noun"
          ]
        },
        {
          "id": "2750739",
          "text": "Auf welcher Etage wohnen Sie?",
          "translation": "Вы на каком этаже живёте?",
          "source": "Tatoeba #2750739 @Zaghawa / #4332058 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2750739",
          "cefr_level": "A1",
          "word_slugs": [
            "etage-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
