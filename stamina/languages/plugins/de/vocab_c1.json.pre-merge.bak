    {
      "slug": "vergraben-verb",
      "lemma": "vergraben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5652,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "закапывать",
          "закопать"
        ],
        "en": [
          "to bury (to place in the ground)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10489006",
          "text": "Eichhörnchen vergraben Nüsse.",
          "translation": "Белки закапывают орехи.",
          "source": "Tatoeba #10489006 @Pfirsichbaeumchen / #11855552 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10489006",
          "cefr_level": "A1",
          "word_slugs": [
            "vergraben-verb"
          ]
        },
        {
          "id": "680030",
          "text": "Hunde vergraben oft Knochen.",
          "translation": "Собаки часто закапывают кости.",
          "source": "Tatoeba #680030 @Pfirsichbaeumchen / #3494330 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/680030",
          "cefr_level": "A1",
          "word_slugs": [
            "vergraben-verb"
          ]
        },
        {
          "id": "404584",
          "text": "Der Schatz war auf der Insel vergraben.",
          "translation": "Клад был зарыт на острове.",
          "source": "Tatoeba #404584 @xtofu80 / #10157259 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/404584",
          "cefr_level": "A1",
          "word_slugs": [
            "vergraben-verb"
          ]
        },
        {
          "id": "13754400",
          "text": "Ich habe ihn die tote Katze im Garten vergraben sehen.",
          "translation": "Я видел, как он закапывал мертвую кошку во дворе.",
          "source": "Tatoeba #13754400 @Waldelfe / #13754053 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13754400",
          "cefr_level": "A1",
          "word_slugs": [
            "vergraben-verb"
          ]
        },
        {
          "id": "12619508",
          "text": "Tom konnte sich nicht daran erinnern, wo er das Geld vergraben hatte.",
          "translation": "Том не мог вспомнить, где закопал деньги.",
          "source": "Tatoeba #12619508 @User132751 / #13494245 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12619508",
          "cefr_level": "A1",
          "word_slugs": [
            "vergraben-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
