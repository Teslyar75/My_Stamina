        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13565949",
          "text": "Er hat ein weißes Auto.",
          "translation": "У него белая машина.",
          "source": "Tatoeba #13565949 @Rovo / #13571665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13565949",
          "cefr_level": "A1",
          "word_slugs": [
            "weisses-adj"
          ]
        },
        {
          "id": "6617442",
          "text": "Wo ist mein weißes Hemd?",
          "translation": "Где моя белая рубашка?",
          "source": "Tatoeba #6617442 @rmateo / #8572796 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6617442",
          "cefr_level": "A1",
          "word_slugs": [
            "weisses-adj"
          ]
        },
        {
          "id": "8901555",
          "text": "Tom hat ein weißes Pferd.",
          "translation": "У Тома есть белая лошадь.",
          "source": "Tatoeba #8901555 @felix63 / #9146673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8901555",
          "cefr_level": "A1",
          "word_slugs": [
            "weisses-adj"
          ]
        },
        {
          "id": "2908735",
          "text": "Ich habe ein weißes Pferd.",
          "translation": "У меня есть белый конь.",
          "source": "Tatoeba #2908735 @al_ex_an_der / #2908741 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2908735",
          "cefr_level": "A1",
          "word_slugs": [
            "weisses-adj"
          ]
        },
        {
          "id": "8353879",
          "text": "Tom fährt ein weißes Auto.",
          "translation": "Том ездит на белой машине.",
          "source": "Tatoeba #8353879 @Luiaard / #5079774 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8353879",
