    {
      "slug": "tequila-noun",
      "lemma": "Tequila",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7668,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "текила"
        ],
        "en": [
          "tequila (an alcoholic liquor distilled from the fermented juice of the Central American century plant Agave tequilana)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12555662",
          "text": "Ich trinke oft Tequila.",
          "translation": "Я часто пью текилу.",
          "source": "Tatoeba #12555662 @Waldelfe / #8841236 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12555662",
          "cefr_level": "A1",
          "word_slugs": [
            "tequila-noun"
          ]
        },
        {
          "id": "8817233",
          "text": "Ich trinke selten Tequila.",
          "translation": "Я редко пью текилу.",
          "source": "Tatoeba #8817233 @mramosch / #7878456 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8817233",
          "cefr_level": "A1",
          "word_slugs": [
            "tequila-noun"
          ]
        },
        {
          "id": "3454836",
          "text": "Wollt ihr einen Shot Tequila?",
          "translation": "Хотите рюмку текилы?",
          "source": "Tatoeba #3454836 @Plusquamperfekt / #3454829 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3454836",
          "cefr_level": "A1",
          "word_slugs": [
            "tequila-noun"
          ]
        },
        {
          "id": "12654796",
          "text": "Du trinkst keinen Tequila mehr?",
          "translation": "Ты перестала пить текилу?",
          "source": "Tatoeba #12654796 @Waldelfe / #12988413 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12654796",
          "cefr_level": "A1",
          "word_slugs": [
            "tequila-noun"
          ]
        },
        {
          "id": "656754",
          "text": "Drei Bier und einen Tequila, bitte!",
          "translation": "Три пива и одну текилу, пожалуйста!",
          "source": "Tatoeba #656754 @MUIRIEL / #985037 @MsNice (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/656754",
          "cefr_level": "A1",
          "word_slugs": [
            "tequila-noun"
          ]
        }
