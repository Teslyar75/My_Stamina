      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of deutsch:",
          "strong/mixed nominative masculine singular",
          "inflection of deutsch:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1087976",
          "text": "Hans ist ein deutscher Name.",
          "translation": "Ганс - немецкое имя.",
          "source": "Tatoeba #1087976 @Katheriinne / #2498914 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1087976",
          "cefr_level": "A1",
          "word_slugs": [
            "deutscher-adj"
          ]
        },
        {
          "id": "1086925",
          "text": "Mein deutscher Freund heißt Hans.",
          "translation": "Моего немецкого друга зовут Ганс.",
          "source": "Tatoeba #1086925 @Shishir / #3211887 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1086925",
          "cefr_level": "A1",
          "word_slugs": [
            "deutscher-adj"
          ]
        },
        {
          "id": "2461495",
          "text": "Tom ist Amerikaner deutscher Abstammung.",
          "translation": "Том - американец немецкого происхождения.",
          "source": "Tatoeba #2461495 @Pfirsichbaeumchen / #2461623 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2461495",
          "cefr_level": "A1",
          "word_slugs": [
            "deutscher-adj"
          ]
        },
        {
          "id": "6146967",
          "text": "Das ist ein alter deutscher Brauch.",
          "translation": "Это старинный немецкий обычай.",
          "source": "Tatoeba #6146967 @Pfirsichbaeumchen / #4429505 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6146967",
          "cefr_level": "A1",
          "word_slugs": [
            "deutscher-adj"
          ]
        },
        {
