          ]
        },
        {
          "id": "1112954",
          "text": "In diesem Dorf lebte einmal ein gewisser ungezogener Junge.",
          "translation": "В этой деревне жил однажды один невоспитанный мальчик.",
          "source": "Tatoeba #1112954 @Haehnchenpaella / #3248859 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1112954",
          "cefr_level": "A1",
          "word_slugs": [
            "gewisser-adj"
          ]
        },
        {
          "id": "12912401",
          "text": "Ein gewisser Fernando gewann im Lotto und kaufte sich ein Auto.",
          "translation": "Некий Фернандо выиграл в лотерею и купил себе машину.",
          "source": "Tatoeba #12912401 @mhr / #12912398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12912401",
          "cefr_level": "A1",
          "word_slugs": [
            "gewisser-adj"
          ]
        },
        {
          "id": "12912404",
          "text": "Ein gewisser Fernando hat im Lotto gewonnen und sich ein Auto gekauft.",
          "translation": "Некий Фернандо выиграл в лотерею и купил себе машину.",
          "source": "Tatoeba #12912404 @mhr / #12912398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12912404",
          "cefr_level": "A1",
          "word_slugs": [
            "gewisser-adj"
          ]
        }
      ],
