    {
      "slug": "gratulieren-verb",
      "lemma": "gratulieren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6552,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "поздравлять"
        ],
        "en": [
          "to congratulate"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2837304",
          "text": "Gratulieren Sie mir nicht!",
          "translation": "Не поздравляйте меня.",
          "source": "Tatoeba #2837304 @Espi / #10279995 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2837304",
          "cefr_level": "A1",
          "word_slugs": [
            "gratulieren-verb"
          ]
        },
        {
          "id": "5594429",
          "text": "Lasst uns Tom gratulieren.",
          "translation": "Давайте поздравим Тома.",
          "source": "Tatoeba #5594429 @raggione / #5494473 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5594429",
          "cefr_level": "A1",
          "word_slugs": [
            "gratulieren-verb"
          ]
        },
        {
          "id": "8351446",
          "text": "Ich möchte dir gratulieren.",
          "translation": "Я хотел бы тебя поздравить.",
          "source": "Tatoeba #8351446 @felix63 / #10480902 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8351446",
          "cefr_level": "A1",
          "word_slugs": [
            "gratulieren-verb"
          ]
        },
        {
          "id": "12247799",
          "text": "Gratulieren Sie ihr von mir!",
          "translation": "Поздравьте её от меня.",
          "source": "Tatoeba #12247799 @Pfirsichbaeumchen / #12246283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12247799",
          "cefr_level": "A1",
          "word_slugs": [
            "gratulieren-verb"
          ]
        },
        {
          "id": "12249368",
          "text": "Gratulieren Sie denen von mir!",
          "translation": "Поздравьте их от меня.",
          "source": "Tatoeba #12249368 @Pfirsichbaeumchen / #12246285 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12249368",
          "cefr_level": "A1",
          "word_slugs": [
            "gratulieren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
