      },
      "gender": null,
      "examples": [
        {
          "id": "444671",
          "text": "Gehen Sie immer geradeaus!",
          "translation": "Идите всё время прямо!",
          "source": "Tatoeba #444671 @Espi / #5500144 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/444671",
          "cefr_level": "A1",
