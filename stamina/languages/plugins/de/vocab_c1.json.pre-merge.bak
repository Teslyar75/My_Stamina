      "gender": null,
      "examples": [
        {
          "id": "5686066",
          "text": "Wir haben verschiedene Bedürfnisse.",
          "translation": "У нас разные потребности.",
          "source": "Tatoeba #5686066 @eric2 / #5077379 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686066",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnisse-noun"
          ]
        },
        {
          "id": "5686065",
          "text": "Wir haben unterschiedliche Bedürfnisse.",
          "translation": "У нас разные потребности.",
          "source": "Tatoeba #5686065 @eric2 / #5077379 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5686065",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnisse-noun"
          ]
        },
        {
          "id": "2506265",
          "text": "Er achtete nicht auf die Bedürfnisse seines Körpers.",
          "translation": "Он не прислушивался к требованиям своего тела.",
          "source": "Tatoeba #2506265 @al_ex_an_der / #2506266 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2506265",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnisse-noun"
          ]
        },
        {
          "id": "926567",
          "text": "Der Architekt adaptierte das Haus an die Bedürfnisse alter Menschen.",
          "translation": "Архитектор приспособил дом под нужды пожилых людей.",
          "source": "Tatoeba #926567 @jakov / #5661380 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/926567",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnisse-noun"
          ]
        },
        {
          "id": "926573",
          "text": "Der Architekt passte das Haus an die Bedürfnisse alter Menschen an.",
          "translation": "Архитектор приспособил дом под нужды пожилых людей.",
          "source": "Tatoeba #926573 @jakov / #5661380 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/926573",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnisse-noun"
          ]
        }
