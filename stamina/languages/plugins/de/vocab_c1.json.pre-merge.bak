    {
      "slug": "warteten-verb",
      "lemma": "warteten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9819,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of warten:",
          "first/third-person plural preterite",
          "inflection of warten:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2244477",
          "text": "Sie warteten draußen.",
          "translation": "Они ждали снаружи.",
          "source": "Tatoeba #2244477 @Pfirsichbaeumchen / #4377704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2244477",
          "cefr_level": "A1",
          "word_slugs": [
            "warteten-verb"
          ]
        },
        {
          "id": "3871090",
          "text": "Wir warteten draußen.",
          "translation": "Мы ждали снаружи.",
          "source": "Tatoeba #3871090 @Giulio / #3871180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3871090",
          "cefr_level": "A1",
          "word_slugs": [
            "warteten-verb"
          ]
        },
        {
          "id": "818870",
          "text": "Wir warteten stundenlang.",
          "translation": "Мы ждали часами.",
          "source": "Tatoeba #818870 @Pfirsichbaeumchen / #5084245 @Julianushka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/818870",
          "cefr_level": "A1",
          "word_slugs": [
            "warteten-verb"
          ]
        },
        {
          "id": "8056550",
          "text": "Wir warteten auf Tom.",
          "translation": "Мы ждали Тома.",
          "source": "Tatoeba #8056550 @Luiaard / #3948289 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8056550",
          "cefr_level": "A1",
          "word_slugs": [
            "warteten-verb"
          ]
        },
        {
          "id": "9463486",
          "text": "Alle warteten auf Tom.",
          "translation": "Все ждали Тома.",
          "source": "Tatoeba #9463486 @Pfirsichbaeumchen / #9414220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9463486",
          "cefr_level": "A1",
          "word_slugs": [
            "warteten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
