    {
      "slug": "irland-name",
      "lemma": "Irland",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7913,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Ireland (a country in northwestern Europe)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8516782",
          "text": "Dublin ist in Irland.",
          "translation": "Дублин - это в Ирландии.",
          "source": "Tatoeba #8516782 @Luiaard / #8935107 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8516782",
          "cefr_level": "A1",
          "word_slugs": [
            "irland-name"
          ]
        },
        {
          "id": "11466809",
          "text": "Ich gehe nach Irland.",
          "translation": "Я поеду в Ирландию.",
          "source": "Tatoeba #11466809 @Pfirsichbaeumchen / #4520031 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11466809",
          "cefr_level": "A1",
          "word_slugs": [
            "irland-name"
          ]
        },
        {
          "id": "13946784",
          "text": "Du verwechselst Irland und Island.",
          "translation": "Ты путаешь Ирландию и Исландию.",
          "source": "Tatoeba #13946784 @mhr / #13946606 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13946784",
          "cefr_level": "A1",
          "word_slugs": [
            "irland-name"
          ]
        },
        {
          "id": "13946786",
          "text": "Sie verwechseln Irland und Island.",
          "translation": "Вы путаете Ирландию и Исландию.",
          "source": "Tatoeba #13946786 @mhr / #13946605 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13946786",
          "cefr_level": "A1",
          "word_slugs": [
            "irland-name"
          ]
        },
        {
          "id": "13946787",
          "text": "Ihr verwechselt Irland und Island.",
          "translation": "Вы путаете Ирландию и Исландию.",
          "source": "Tatoeba #13946787 @mhr / #13946605 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13946787",
