    {
      "slug": "verbringe-verb",
      "lemma": "verbringe",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7583,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verbringen:",
          "first-person singular present",
          "inflection of verbringen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10967430",
          "text": "Ich verbringe viel Zeit draußen.",
          "translation": "Я много времени провожу на улице.",
          "source": "Tatoeba #10967430 @p0wcr / #10968516 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967430",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringe-verb"
          ]
        },
        {
          "id": "7267520",
          "text": "Ich verbringe den Abend mit Tom.",
          "translation": "Я провожу вечер с Томом.",
          "source": "Tatoeba #7267520 @Pfirsichbaeumchen / #13452615 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7267520",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringe-verb"
          ]
        },
        {
          "id": "8601950",
          "text": "Ich verbringe gerne Zeit mit dir.",
          "translation": "Мне нравится проводить с тобой время.",
          "source": "Tatoeba #8601950 @Pfirsichbaeumchen / #4643741 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8601950",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringe-verb"
          ]
        },
        {
          "id": "725274",
          "text": "Ich verbringe das Wochenende in Tokio.",
          "translation": "Я проведу выходные в Токио.",
          "source": "Tatoeba #725274 @Dejo / #4618668 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/725274",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringe-verb"
          ]
        },
        {
          "id": "1360219",
          "text": "Ich verbringe meinen Urlaub am Strand.",
          "translation": "Я провожу свой отпуск на пляже.",
          "source": "Tatoeba #1360219 @Pfirsichbaeumchen / #4175861 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1360219",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringe-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
