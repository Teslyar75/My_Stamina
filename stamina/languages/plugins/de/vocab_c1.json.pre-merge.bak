      "gender": "m",
      "examples": [
        {
          "id": "10780247",
          "text": "Tom hört regelmäßig Podcasts.",
          "translation": "Том регулярно слушает подкасты.",
          "source": "Tatoeba #10780247 @Melang / #13486371 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10780247",
          "cefr_level": "A1",
          "word_slugs": [
