        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10061441",
          "text": "Wo ist die U-Bahn?",
          "translation": "Где тут метро?",
          "source": "Tatoeba #10061441 @felix63 / #12367869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10061441",
          "cefr_level": "A1",
          "word_slugs": [
            "u-noun"
          ]
        },
        {
          "id": "450265",
          "text": "Sie nahmen die U-Bahn.",
          "translation": "Они поехали на метро.",
          "source": "Tatoeba #450265 @Pfirsichbaeumchen / #3265648 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/450265",
          "cefr_level": "A1",
          "word_slugs": [
            "u-noun"
          ]
        },
        {
          "id": "1773068",
          "text": "Die U-Bahn ist rechts!",
          "translation": "Метро справа.",
          "source": "Tatoeba #1773068 @al_ex_an_der / #12367871 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1773068",
          "cefr_level": "A1",
          "word_slugs": [
            "u-noun"
          ]
        },
        {
          "id": "10362824",
          "text": "Nehmen wir die U-Bahn!",
          "translation": "Поехали на метро!",
          "source": "Tatoeba #10362824 @Yorwba / #10362848 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10362824",
          "cefr_level": "A1",
          "word_slugs": [
            "u-noun"
          ]
        },
        {
          "id": "6331595",
          "text": "Ich fahre gerne U-Bahn.",
          "translation": "Я люблю ездить на метро.",
          "source": "Tatoeba #6331595 @list / #12367868 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6331595",
          "cefr_level": "A1",
          "word_slugs": [
            "u-noun"
          ]
        }
      ],
