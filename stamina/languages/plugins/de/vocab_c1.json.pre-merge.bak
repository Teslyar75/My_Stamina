        {
          "id": "4939002",
          "text": "Benimm dich anständig.",
          "translation": "Веди себя прилично.",
          "source": "Tatoeba #4939002 @raggione / #1890495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4939002",
          "cefr_level": "A1",
          "word_slugs": [
            "benimm-noun"
          ]
        },
        {
          "id": "11602578",
          "text": "Benimm dich wie ein Mann.",
          "translation": "Веди себя по-мужски.",
          "source": "Tatoeba #11602578 @Adelpa / #2353598 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11602578",
          "cefr_level": "A1",
          "word_slugs": [
            "benimm-noun"
          ]
        },
        {
          "id": "7680395",
          "text": "Benimm dich während meiner Abwesenheit!",
          "translation": "Веди себя прилично, пока меня не будет.",
          "source": "Tatoeba #7680395 @Pfirsichbaeumchen / #6558214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7680395",
          "cefr_level": "A1",
          "word_slugs": [
            "benimm-noun"
          ]
        },
        {
          "id": "8213846",
          "text": "Benimm dich nicht wie ein Kind!",
          "translation": "Не веди себя как ребёнок.",
          "source": "Tatoeba #8213846 @Pfirsichbaeumchen / #3566690 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8213846",
          "cefr_level": "A1",
          "word_slugs": [
            "benimm-noun"
          ]
        },
        {
          "id": "2945209",
          "text": "Benimm dich nicht so, als ob du alles wüsstest.",
          "translation": "Не строй из себя всезнайку.",
          "source": "Tatoeba #2945209 @brauchinet / #3008275 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2945209",
          "cefr_level": "A1",
          "word_slugs": [
            "benimm-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
