    {
      "slug": "hofft-verb",
      "lemma": "hofft",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8040,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of hoffen:",
          "third-person singular present",
          "inflection of hoffen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5243187",
          "text": "Tom hofft, Anwalt zu werden.",
          "translation": "Том надеется стать адвокатом.",
          "source": "Tatoeba #5243187 @Pfirsichbaeumchen / #5243190 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5243187",
          "cefr_level": "A1",
          "word_slugs": [
            "hofft-verb"
          ]
        },
        {
          "id": "3407378",
          "text": "Was hofft ihr hier zu finden?",
          "translation": "Что вы надеетесь здесь найти?",
          "source": "Tatoeba #3407378 @Pfirsichbaeumchen / #5042638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3407378",
          "cefr_level": "A1",
          "word_slugs": [
            "hofft-verb"
          ]
        },
        {
          "id": "14018685",
          "text": "Sie hofft, dass du ihr hilfst.",
          "translation": "Она надеется, что ты ей поможешь.",
          "source": "Tatoeba #14018685 @carlosalberto / #14018675 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14018685",
          "cefr_level": "A1",
          "word_slugs": [
            "hofft-verb"
          ]
        },
        {
          "id": "10044570",
          "text": "Tom hofft, dass Mary John hilft.",
          "translation": "Том надеется, что Мэри поможет Джону.",
          "source": "Tatoeba #10044570 @sakslane / #10043738 @BW (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10044570",
          "cefr_level": "A1",
          "word_slugs": [
            "hofft-verb"
          ]
        },
        {
          "id": "8843452",
          "text": "Tom hofft, dass er gewinnen kann.",
          "translation": "Том надеется, что сможет выиграть.",
          "source": "Tatoeba #8843452 @wolfgangth / #6470810 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8843452",
          "cefr_level": "A1",
          "word_slugs": [
            "hofft-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
