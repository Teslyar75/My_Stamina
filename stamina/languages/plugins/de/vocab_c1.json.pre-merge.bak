    {
      "slug": "belästigt-verb",
      "lemma": "belästigt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6028,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of belästigen:",
