    {
      "slug": "erteilen-verb",
      "lemma": "erteilen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6712,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to issue to; to give to (especially orders)",
          "to grant"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5012048",
          "text": "Ich werde euch eine Lektion erteilen!",
          "translation": "Я покажу вам кузькину мать!",
          "source": "Tatoeba #5012048 @al_ex_an_der / #2287493 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5012048",
          "cefr_level": "A1",
          "word_slugs": [
            "erteilen-verb"
          ]
        },
        {
          "id": "7011321",
          "text": "Wir müssen Tom eine Lektion erteilen.",
          "translation": "Нам нужно преподать Тому урок.",
          "source": "Tatoeba #7011321 @Pfirsichbaeumchen / #5530214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7011321",
          "cefr_level": "A1",
          "word_slugs": [
            "erteilen-verb"
          ]
        },
        {
          "id": "5581228",
          "text": "Tom wollte Mary eine Lektion erteilen.",
          "translation": "Том хотел преподать Мэри урок.",
          "source": "Tatoeba #5581228 @BlundaInte / #5515541 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5581228",
          "cefr_level": "A1",
          "word_slugs": [
            "erteilen-verb"
          ]
        },
        {
          "id": "5346942",
          "text": "Erlaube uns, dir einen Rat zu erteilen.",
          "translation": "Позволь нам дать тебе совет.",
          "source": "Tatoeba #5346942 @Pfirsichbaeumchen / #5344021 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5346942",
          "cefr_level": "A1",
          "word_slugs": [
            "erteilen-verb"
          ]
        },
        {
          "id": "3524038",
          "text": "Wir werden ihnen allen eine gehörige Lektion erteilen.",
          "translation": "Мы преподадим им всем хороший урок.",
          "source": "Tatoeba #3524038 @al_ex_an_der / #3424922 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3524038",
          "cefr_level": "A1",
          "word_slugs": [
            "erteilen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
