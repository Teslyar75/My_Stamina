    {
      "slug": "ergreifen-verb",
      "lemma": "ergreifen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6130,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "брать / взять",
          "хватать / схватить",
          "трогать"
        ],
        "en": [
          "to seize, capture",
          "to take up (a job, etc.)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14079022",
          "text": "Ist es notwendig, Partei zu ergreifen?",
          "translation": "Обязательно принимать чью-то сторону?",
          "source": "Tatoeba #14079022 @mhr / #14078831 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14079022",
          "cefr_level": "A1",
          "word_slugs": [
            "ergreifen-verb"
          ]
        },
        {
          "id": "4089348",
          "text": "Ich dachte, du würdest die Gelegenheit ergreifen.",
          "translation": "Я подумал, ты ухватишься за эту возможность.",
          "source": "Tatoeba #4089348 @Dani6187 / #11712344 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4089348",
          "cefr_level": "A1",
          "word_slugs": [
            "ergreifen-verb"
          ]
        },
        {
          "id": "5644540",
          "text": "Er nutzte die Gelegenheit, um das Wort zu ergreifen.",
          "translation": "Он воспользовался возможностью взять слово.",
          "source": "Tatoeba #5644540 @Pfirsichbaeumchen / #5644538 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5644540",
          "cefr_level": "A1",
          "word_slugs": [
            "ergreifen-verb"
          ]
        }
      ],
