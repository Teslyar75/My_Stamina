    {
      "slug": "aufzubauen-verb",
      "lemma": "aufzubauen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6724,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of aufbauen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1406324",
          "text": "Lesen hilft dir dabei, dir einen Wortschatz aufzubauen.",
          "translation": "Чтение помогает к тому же наработать словарный запас.",
          "source": "Tatoeba #1406324 @al_ex_an_der / #3024714 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1406324",
          "cefr_level": "A1",
          "word_slugs": [
            "aufzubauen-verb"
          ]
        },
        {
          "id": "7590158",
          "text": "Mit 25 Jahren hatte Tom es geschafft, sich eine Familie aufzubauen.",
