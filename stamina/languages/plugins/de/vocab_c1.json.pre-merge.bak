    {
      "slug": "heirat-noun",
      "lemma": "Heirat",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5236,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "свадьба"
        ],
        "en": [
          "marrying; marriage; wedding (the act of marrying; the contracting of a marriage)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4963177",
          "text": "Erst Bildung, dann Heirat.",
          "translation": "Сначала учись, потом женись.",
          "source": "Tatoeba #4963177 @Esperantostern / #13648673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4963177",
          "cefr_level": "A1",
          "word_slugs": [
            "heirat-noun"
          ]
        },
        {
          "id": "1796551",
          "text": "Vor ihrer Heirat war Mary Tänzerin.",
          "translation": "До свадьбы Мэри была танцовщицей.",
          "source": "Tatoeba #1796551 @Tamy / #3100355 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1796551",
          "cefr_level": "A1",
          "word_slugs": [
            "heirat-noun"
          ]
        },
        {
          "id": "2876376",
          "text": "Meine Eltern sind gegen meine Heirat.",
          "translation": "Родители против моего замужества.",
          "source": "Tatoeba #2876376 @Pfirsichbaeumchen / #2869522 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2876376",
          "cefr_level": "A1",
          "word_slugs": [
            "heirat-noun"
          ]
        },
        {
          "id": "10472596",
          "text": "Ich soll zur Heirat gezwungen werden.",
          "translation": "Меня хотят насильно выдать замуж.",
          "source": "Tatoeba #10472596 @Pfirsichbaeumchen / #2825131 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10472596",
          "cefr_level": "A1",
          "word_slugs": [
            "heirat-noun"
          ]
        },
        {
          "id": "2881852",
          "text": "Meine Eltern waren gegen unsere Heirat.",
          "translation": "Мои родители были против нашего брака.",
          "source": "Tatoeba #2881852 @Pfirsichbaeumchen / #3013753 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2881852",
          "cefr_level": "A1",
          "word_slugs": [
            "heirat-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
