    {
      "slug": "sumpf-noun",
      "lemma": "Sumpf",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7609,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "swamp, marsh",
          "sump"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5663065",
          "text": "Dieses Insekt lebt im Sumpf.",
          "translation": "Это насекомое живёт в болоте.",
          "source": "Tatoeba #5663065 @list / #8096654 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5663065",
          "cefr_level": "A1",
          "word_slugs": [
            "sumpf-noun"
          ]
        },
        {
          "id": "5792677",
          "text": "Toms Leiche wurde im Sumpf gefunden.",
          "translation": "Труп Тома был найден в болоте.",
          "source": "Tatoeba #5792677 @maaster / #5897175 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5792677",
          "cefr_level": "A1",
          "word_slugs": [
            "sumpf-noun"
          ]
        },
        {
          "id": "13857155",
          "text": "Selbst in einem Palast träumt ein Frosch vom Sumpf.",
          "translation": "Лягушка и во дворце мечтает о болоте.",
          "source": "Tatoeba #13857155 @mhr / #13858519 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13857155",
          "cefr_level": "A1",
          "word_slugs": [
            "sumpf-noun"
          ]
        },
        {
          "id": "2445690",
          "text": "Man erwartet, dass der Wolkenkratzer im Sumpf versinken wird.",
          "translation": "Ожидается, что небоскрёб будет погружаться в болото.",
          "source": "Tatoeba #2445690 @al_ex_an_der / #2445694 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2445690",
          "cefr_level": "A1",
          "word_slugs": [
            "sumpf-noun"
          ]
        },
        {
          "id": "13858698",
          "text": "Selbst in einem Palast sehnt sich ein Frosch nach dem Sumpf.",
          "translation": "Лягушка и во дворце тоскует по болоту.",
          "source": "Tatoeba #13858698 @mhr / #13858521 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13858698",
          "cefr_level": "A1",
          "word_slugs": [
            "sumpf-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
