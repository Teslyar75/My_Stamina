      "gender": null,
      "examples": [
        {
          "id": "12423827",
          "text": "Wir warten darauf, bedient zu werden.",
          "translation": "Мы ждём, когда нас обслужат.",
          "source": "Tatoeba #12423827 @Waldelfe / #12423987 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12423827",
          "cefr_level": "A1",
          "word_slugs": [
            "bedient-verb"
          ]
        },
        {
          "id": "2456052",
          "text": "Unser Kurs bedient sich einer interaktiven Methode.",
          "translation": "Наш курс использует интерактивный метод.",
          "source": "Tatoeba #2456052 @al_ex_an_der / #2456068 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2456052",
          "cefr_level": "A1",
          "word_slugs": [
            "bedient-verb"
          ]
        },
        {
          "id": "5246913",
          "text": "Er weiß nicht, wie man eine Digitalkamera bedient.",
          "translation": "Он не знает, как пользоваться цифровым фотоаппаратом.",
          "source": "Tatoeba #5246913 @Sudajaengi / #6815411 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5246913",
          "cefr_level": "A1",
          "word_slugs": [
            "bedient-verb"
          ]
        },
        {
          "id": "8362022",
          "text": "Der Lehrer hat uns gezeigt, wie man einen Computer bedient.",
          "translation": "Преподаватель показал нам, как пользоваться компьютером.",
          "source": "Tatoeba #8362022 @manese / #2753819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8362022",
