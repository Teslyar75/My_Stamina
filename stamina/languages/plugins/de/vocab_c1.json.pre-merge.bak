    {
      "slug": "geteilt-verb",
      "lemma": "geteilt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6237,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of teilen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8215764",
          "text": "Sechs geteilt durch zwei ist drei.",
          "translation": "Шесть поделить на два равно трём.",
          "source": "Tatoeba #8215764 @Pfirsichbaeumchen / #4760781 @villard85 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8215764",
          "cefr_level": "A1",
          "word_slugs": [
            "geteilt-verb"
          ]
        },
        {
          "id": "8220946",
          "text": "Zwanzig geteilt durch zwei ist zehn.",
          "translation": "Двадцать разделить на два будет десять.",
          "source": "Tatoeba #8220946 @Pfirsichbaeumchen / #8106398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8220946",
          "cefr_level": "A1",
          "word_slugs": [
            "geteilt-verb"
          ]
        },
        {
          "id": "7636667",
          "text": "Tom hat seine Suppe mit mir geteilt.",
          "translation": "Том поделился со мной супом.",
          "source": "Tatoeba #7636667 @wolfgangth / #7897409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7636667",
          "cefr_level": "A1",
          "word_slugs": [
            "geteilt-verb"
          ]
        },
        {
          "id": "12322416",
          "text": "Sie hat mit mir ihre Probleme geteilt.",
          "translation": "Она поделилась со мной своими проблемами.",
          "source": "Tatoeba #12322416 @Pfirsichbaeumchen / #12322408 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12322416",
          "cefr_level": "A1",
          "word_slugs": [
            "geteilt-verb"
          ]
        },
        {
          "id": "899821",
          "text": "Ganz Gallien ist in drei Teile geteilt.",
          "translation": "Вся Галлия разделена на три части.",
          "source": "Tatoeba #899821 @Esperantostern / #2091727 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/899821",
          "cefr_level": "A1",
          "word_slugs": [
            "geteilt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
