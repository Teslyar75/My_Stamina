    {
      "slug": "schweig-verb",
      "lemma": "schweig",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9696,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "singular imperative of schweigen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "884323",
          "text": "Übersetz und schweig!",
          "translation": "Переводи и помалкивай!",
          "source": "Tatoeba #884323 @MUIRIEL / #2764710 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/884323",
          "cefr_level": "A1",
          "word_slugs": [
            "schweig-verb"
          ]
        },
        {
          "id": "3112657",
          "text": "Leide, schweig und vertrag; deine Not niemandem klag.",
          "translation": "Страдай, молчи и терпи - до твоей нужды никому нет дела.",
          "source": "Tatoeba #3112657 @Esperantostern / #7477719 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3112657",
          "cefr_level": "A1",
          "word_slugs": [
            "schweig-verb"
          ]
        },
        {
          "id": "13687771",
          "text": "Wenn du nicht die Wahrheit sagen willst, schweig lieber!",
          "translation": "Если не хочешь говорить правду, лучше молчи.",
          "source": "Tatoeba #13687771 @mhr / #13687673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13687771",
          "cefr_level": "A1",
          "word_slugs": [
            "schweig-verb"
          ]
        },
        {
          "id": "13687768",
          "text": "Wenn du nicht die Wahrheit sagen möchtest, schweig lieber!",
          "translation": "Если не хочешь говорить правду, лучше молчи.",
          "source": "Tatoeba #13687768 @mhr / #13687673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13687768",
          "cefr_level": "A1",
          "word_slugs": [
            "schweig-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
