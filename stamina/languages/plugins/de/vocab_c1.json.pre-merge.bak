    {
      "slug": "vergebe-verb",
      "lemma": "vergebe",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8638,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of vergeben:",
          "first-person singular present",
          "inflection of vergeben:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13044414",
          "text": "Ja, ich vergebe dir.",
          "translation": "Да, я тебя прощаю.",
          "source": "Tatoeba #13044414 @felix63 / #13261619 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13044414",
          "cefr_level": "A1",
          "word_slugs": [
            "vergebe-verb"
          ]
        },
        {
          "id": "7645739",
          "text": "Was soll Tom sagen, damit Maria ihm vergebe?",
          "translation": "Что Тому сказать, чтобы Мэри его простила?",
          "source": "Tatoeba #7645739 @Pfirsichbaeumchen / #7644103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7645739",
          "cefr_level": "A1",
          "word_slugs": [
            "vergebe-verb"
          ]
        },
        {
          "id": "10963221",
          "text": "Alice, ich vergebe dir, weil ich dich liebe.",
          "translation": "Алиса, я прощаю тебя, потому что люблю.",
          "source": "Tatoeba #10963221 @carlosalberto / #13779431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10963221",
          "cefr_level": "A1",
          "word_slugs": [
            "vergebe-verb"
          ]
        },
        {
          "id": "8849680",
          "text": "Gott vergebe mir für die Zeit, die ich vergeudet habe!",
          "translation": "Боже, прости меня за потерянное время!",
          "source": "Tatoeba #8849680 @Pfirsichbaeumchen / #8849809 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8849680",
          "cefr_level": "A1",
          "word_slugs": [
            "vergebe-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
