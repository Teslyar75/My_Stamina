    {
      "slug": "senf-noun",
      "lemma": "Senf",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9344,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "mustard"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8275787",
          "text": "Dieser Senf ist gelb.",
          "translation": "Эта горчица жёлтая.",
          "source": "Tatoeba #8275787 @Pfirsichbaeumchen / #5263593 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8275787",
          "cefr_level": "A1",
          "word_slugs": [
            "senf-noun"
          ]
        },
        {
          "id": "747567",
          "text": "Wollte nur meinen Senf dazugeben...",
          "translation": "Просто мои пять копеек...",
          "source": "Tatoeba #747567 @Vortarulo / #817531 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/747567",
          "cefr_level": "A1",
          "word_slugs": [
            "senf-noun"
          ]
        },
        {
          "id": "13875913",
          "text": "Ich habe vergessen, Senf zu kaufen.",
          "translation": "Я забыла купить горчицу.",
          "source": "Tatoeba #13875913 @Waldelfe / #5917263 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13875913",
          "cefr_level": "A1",
          "word_slugs": [
            "senf-noun"
          ]
        },
        {
          "id": "2233796",
          "text": "Maria muss immer ihren Senf dazugeben.",
          "translation": "Мэри всегда считает нужным вставить свои пять копеек.",
          "source": "Tatoeba #2233796 @Pfirsichbaeumchen / #14091607 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2233796",
          "cefr_level": "A1",
          "word_slugs": [
            "senf-noun"
          ]
        },
        {
          "id": "1399969",
          "text": "Monschau ist berühmt für seinen Senf und zahlreiche historische Gebäude.",
          "translation": "Моншау знаменит своей горчицей и многочисленными историческими зданиями.",
          "source": "Tatoeba #1399969 @Pfirsichbaeumchen / #5888260 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1399969",
          "cefr_level": "A1",
          "word_slugs": [
            "senf-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
