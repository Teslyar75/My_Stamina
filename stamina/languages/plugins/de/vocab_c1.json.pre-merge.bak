    {
      "slug": "forscher-noun",
      "lemma": "Forscher",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9995,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "исследователь"
        ],
        "en": [
          "agent noun of forschen: researcher"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8728012",
          "text": "Mein Großvater war Forscher.",
          "translation": "Мой дед был исследователем.",
          "source": "Tatoeba #8728012 @felix63 / #8728143 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8728012",
          "cefr_level": "A1",
          "word_slugs": [
            "forscher-noun"
          ]
        },
        {
          "id": "1846950",
          "text": "Im Laufe des Projekts wird der Forscher Analysetechniken entwickeln.",
          "translation": "В ходе реализации проекта исследователь будет развивать аналитические методы.",
          "source": "Tatoeba #1846950 @al_ex_an_der / #1846949 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1846950",
          "cefr_level": "A1",
          "word_slugs": [
            "forscher-noun"
          ]
        },
        {
          "id": "10967391",
          "text": "Der Forscher schrieb einen Artikel über die Bindungen zwischen Geschwistern.",
          "translation": "Исследователь написал статью о связи между братьями и сёстрами.",
          "source": "Tatoeba #10967391 @p0wcr / #10968958 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967391",
          "cefr_level": "A1",
          "word_slugs": [
            "forscher-noun"
          ]
        },
        {
          "id": "1846951",
          "text": "Während der Laufzeit des Projekts wird der Forscher Analysetechniken entwickeln.",
          "translation": "В течение срока действия проекта исследователи будут развивать аналитические методы.",
          "source": "Tatoeba #1846951 @al_ex_an_der / #1846953 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1846951",
          "cefr_level": "A1",
          "word_slugs": [
            "forscher-noun"
          ]
        },
        {
          "id": "1846932",
          "text": "Wahrscheinlich wird jeder Forscher seine eigene Theorie zur Erklärung dieses Phänomens entwickeln.",
          "translation": "Наверное, каждый исследователь будет развивать свою собственную теорию для объяснения этого явления.",
          "source": "Tatoeba #1846932 @al_ex_an_der / #1846897 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1846932",
          "cefr_level": "A1",
          "word_slugs": [
            "forscher-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Forscher",
        "nominative_pl": ""
      }
    },
