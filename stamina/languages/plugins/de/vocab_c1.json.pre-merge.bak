          ]
        },
        {
          "id": "2500312",
          "text": "Ich habe etwas Wichtigeres zu tun.",
          "translation": "У меня есть дела и поважней.",
          "source": "Tatoeba #2500312 @brauchinet / #2529488 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2500312",
