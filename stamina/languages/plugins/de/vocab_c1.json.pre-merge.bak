    {
      "slug": "belegt-verb",
      "lemma": "belegt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8021,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of belegen:",
          "third-person singular present",
          "inflection of belegen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2179609",
          "text": "Alle Zimmer sind belegt.",
          "translation": "Все номера заняты.",
          "source": "Tatoeba #2179609 @Pfirsichbaeumchen / #9490846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2179609",
          "cefr_level": "A1",
          "word_slugs": [
            "belegt-verb"
          ]
        },
        {
          "id": "6854880",
          "text": "Tom hat einen Französischkurs belegt.",
          "translation": "Том записался на курсы французского.",
          "source": "Tatoeba #6854880 @manese / #6855471 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6854880",
          "cefr_level": "A1",
          "word_slugs": [
            "belegt-verb"
          ]
        },
        {
          "id": "12039311",
          "text": "Deutschland hat wieder mal den letzten Platz belegt.",
          "translation": "Германия опять заняла последнее место.",
          "source": "Tatoeba #12039311 @Pfirsichbaeumchen / #13645645 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12039311",
          "cefr_level": "A1",
          "word_slugs": [
            "belegt-verb"
          ]
        },
        {
          "id": "13754135",
          "text": "Er wurde mit einer Geldbuße von zehntausend Yen belegt.",
          "translation": "Его оштрафовали на десять тысяч иен.",
          "source": "Tatoeba #13754135 @mhr / #13753855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13754135",
          "cefr_level": "A1",
          "word_slugs": [
            "belegt-verb"
          ]
        },
        {
          "id": "13754142",
          "text": "Er wurde mit einer Geldstrafe von zehntausend Yen belegt.",
          "translation": "Его оштрафовали на десять тысяч иен.",
          "source": "Tatoeba #13754142 @mhr / #13753855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13754142",
          "cefr_level": "A1",
          "word_slugs": [
            "belegt-verb"
          ]
        }
      ],
