    {
      "slug": "lautsprecher-noun",
      "lemma": "Lautsprecher",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5084,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "колонка"
        ],
        "en": [
          "loudspeaker",
          "loudhailer (electronic megaphone)",
          "public address system, PA system, PA, (UK) tannoy (an electronic voice-amplification apparatus, usually containing a set of two loudspeakers and a central control unit, used for si",
          "loudmouth, blatherskite"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6631571",
          "text": "Ich brauche neue Lautsprecher für meinen PC.",
          "translation": "Мне нужны новые динамики для ПК.",
          "source": "Tatoeba #6631571 @Micsmithel / #6948309 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6631571",
          "cefr_level": "A1",
          "word_slugs": [
            "lautsprecher-noun"
          ]
        },
        {
          "id": "13927004",
          "text": "Welcher dieser Lautsprecher hat den besseren Klang?",
          "translation": "У какого из этих динамиков звук лучше?",
          "source": "Tatoeba #13927004 @IAlexI / #7590383 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13927004",
          "cefr_level": "A1",
          "word_slugs": [
            "lautsprecher-noun"
          ]
        },
        {
          "id": "2913514",
          "text": "„Was ist los?“ – „Die Lautsprecher funktionieren nicht richtig.“",
          "translation": "«Что случилось?» — «Динамики плохо работают».",
          "source": "Tatoeba #2913514 @Pfirsichbaeumchen / #2933452 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2913514",
          "cefr_level": "A1",
          "word_slugs": [
            "lautsprecher-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Lautsprecher",
        "nominative_pl": ""
      }
    },
