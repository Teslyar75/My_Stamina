    {
      "slug": "herde-noun",
      "lemma": "Herde",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6305,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "стадо"
        ],
        "en": [
          "nominative/accusative/genitive plural of Herd (“stove, cooker, hearth”)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "7277917",
          "text": "Tom sah eine kleine Herde Elefanten.",
          "translation": "Том видел небольшое стадо слонов.",
          "source": "Tatoeba #7277917 @Pfirsichbaeumchen / #7074451 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7277917",
          "cefr_level": "A1",
          "word_slugs": [
            "herde-noun"
          ]
        },
        {
          "id": "8804598",
          "text": "Wieviele Schafe sind in dieser Herde?",
          "translation": "Сколько овец в этом стаде?",
          "source": "Tatoeba #8804598 @Melang / #2787693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8804598",
          "cefr_level": "A1",
          "word_slugs": [
            "herde-noun"
          ]
        },
        {
          "id": "10967495",
          "text": "Eine Herde Kühe stand auf dem Feld.",
          "translation": "В поле паслось стадо коров.",
          "source": "Tatoeba #10967495 @p0wcr / #10968502 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967495",
          "cefr_level": "A1",
          "word_slugs": [
            "herde-noun"
          ]
        },
        {
          "id": "455431",
          "text": "In jeder Herde gibt es ein schwarzes Schaf.",
          "translation": "В каждом стаде есть чёрная овца.",
          "source": "Tatoeba #455431 @MUIRIEL / #8610014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455431",
          "cefr_level": "A1",
          "word_slugs": [
            "herde-noun"
          ]
        },
        {
          "id": "3503382",
          "text": "Ein räudiges Schaf steckt die ganze Herde an.",
          "translation": "Одна паршивая овца портит всё стадо.",
          "source": "Tatoeba #3503382 @Esperantostern / #3503474 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3503382",
          "cefr_level": "A1",
          "word_slugs": [
            "herde-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Herde",
        "nominative_pl": ""
      }
    },
    {
      "slug": "zwerg-noun",
      "lemma": "Zwerg",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6306,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "гном"
        ],
        "en": [
          "dwarf (creature)",
          "dwarf, midget",
          "gnome"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2383244",
          "text": "Tom ist ein Zwerg.",
          "translation": "Том - гном.",
          "source": "Tatoeba #2383244 @BraveSentry / #3165667 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2383244",
          "cefr_level": "A1",
          "word_slugs": [
            "zwerg-noun"
          ]
        },
        {
          "id": "12561025",
          "text": "Ich bin kein Zwerg.",
          "translation": "Я не карлик.",
          "source": "Tatoeba #12561025 @Waldelfe / #12561037 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12561025",
          "cefr_level": "A1",
          "word_slugs": [
            "zwerg-noun"
          ]
        },
        {
          "id": "1876318",
          "text": "Der wirtschaftliche Riese Europa ist noch immer ein politischer Zwerg.",
          "translation": "Европа — экономический гигант, но по-прежнему политический карлик.",
          "source": "Tatoeba #1876318 @al_ex_an_der / #1876352 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1876318",
          "cefr_level": "A1",
          "word_slugs": [
            "zwerg-noun"
          ]
        },
        {
          "id": "1873545",
          "text": "Selbst wenn ich ein Zwerg wäre, wäre ich noch immer ein Riese.",
          "translation": "Даже если бы я был карликом, я всё равно был бы великаном.",
          "source": "Tatoeba #1873545 @al_ex_an_der / #1876217 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1873545",
          "cefr_level": "A1",
          "word_slugs": [
            "zwerg-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Zwerg",
        "nominative_pl": ""
      }
    },
