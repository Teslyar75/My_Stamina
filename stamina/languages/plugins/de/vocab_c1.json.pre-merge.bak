      "gender": null,
      "examples": [
        {
          "id": "9964227",
          "text": "Er war sehr geschickt im Umgang mit Messer und Gabel.",
          "translation": "Он очень ловко управлялся с ножом и вилкой.",
          "source": "Tatoeba #9964227 @GaryGaryGary / #3357441 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9964227",
          "cefr_level": "A1",
          "word_slugs": [
