      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "stroke (act of striking e.g. with a hand or a cutting weapon)",
          "feat, coup (quick and decisive act)",
          "practical joke, prank"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "444389",
          "text": "Von einem Streich fällt keine Eiche.",
          "translation": "От одного удара ни один дуб не упадёт.",
          "source": "Tatoeba #444389 @Espi / #499375 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/444389",
          "cefr_level": "A1",
          "word_slugs": [
            "streich-noun"
          ]
        },
        {
          "id": "10208698",
          "text": "Meine Augen spielen mir bestimmt einen Streich.",
          "translation": "Мои глаза, должно быть, обманывают меня.",
          "source": "Tatoeba #10208698 @Pfirsichbaeumchen / #4760821 @villard85 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10208698",
          "cefr_level": "A1",
          "word_slugs": [
            "streich-noun"
          ]
        },
        {
          "id": "11839494",
          "text": "Das Kopieren und Einfügen hat mir einen bösen Streich gespielt.",
          "translation": "Копипаст сыграл со мной злую шутку.",
          "source": "Tatoeba #11839494 @Pfirsichbaeumchen / #11838860 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11839494",
          "cefr_level": "A1",
          "word_slugs": [
            "streich-noun"
          ]
        },
        {
          "id": "12682478",
          "text": "Streich die Decke zuerst!",
          "translation": "Сначала покрась потолок.",
          "source": "Tatoeba #12682478 @mhr / #12685625 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12682478",
          "cefr_level": "A1",
          "word_slugs": [
            "streich-noun"
          ]
        }
      ],
