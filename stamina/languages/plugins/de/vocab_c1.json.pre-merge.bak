          "entry, entrance (door or area where one enters)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2417536",
          "text": "Was kostet der Eintritt?",
          "translation": "Сколько за вход?",
          "source": "Tatoeba #2417536 @Pfirsichbaeumchen / #2264255 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2417536",
