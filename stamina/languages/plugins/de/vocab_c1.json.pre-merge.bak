          "source": "Tatoeba #9258321 @felix63 / #12296068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9258321",
          "cefr_level": "A1",
          "word_slugs": [
            "abgebrochen-verb"
          ]
        },
        {
          "id": "3571525",
          "text": "Sie hat sich einen Nagel abgebrochen.",
          "translation": "Она сломала ноготь.",
          "source": "Tatoeba #3571525 @Pfirsichbaeumchen / #5146526 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3571525",
          "cefr_level": "A1",
          "word_slugs": [
            "abgebrochen-verb"
          ]
        },
        {
          "id": "5417480",
          "text": "Dem Farbstift ist die Mine abgebrochen.",
          "translation": "У карандаша сломался грифель.",
          "source": "Tatoeba #5417480 @Sciuro_Kvar / #5417739 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5417480",
