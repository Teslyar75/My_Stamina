      "gender": null,
      "examples": [
        {
          "id": "13976354",
          "text": "Tom wurde mit einem Dolch erstochen.",
          "translation": "Тома закололи кинжалом.",
          "source": "Tatoeba #13976354 @mhr / #13976327 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13976354",
          "cefr_level": "A1",
          "word_slugs": [
            "dolch-noun"
          ]
        },
        {
          "id": "3115795",
          "text": "Tom griff Maria mit einem Dolch an.",
          "translation": "Том напал на Мэри с кинжалом.",
          "source": "Tatoeba #3115795 @Pfirsichbaeumchen / #4447534 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3115795",
          "cefr_level": "A1",
          "word_slugs": [
