          "cefr_level": "A1",
          "word_slugs": [
            "unterschiedliche-adj"
          ]
        },
        {
          "id": "1785519",
          "text": "Ich habe eine unterschiedliche Meinung.",
          "translation": "У меня другое мнение.",
