    {
      "slug": "aufhörst-verb",
      "lemma": "aufhörst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9413,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular dependent present of aufhören"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5861889",
          "text": "Ich will, dass du aufhörst zu singen.",
          "translation": "Я хочу, чтобы ты перестал петь.",
          "source": "Tatoeba #5861889 @Pfirsichbaeumchen / #8931843 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5861889",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhörst-verb"
          ]
        },
        {
          "id": "4916853",
          "text": "Wenn du nicht aufhörst, sag ich’s Mama!",
          "translation": "Если не перестанешь, я маме расскажу.",
          "source": "Tatoeba #4916853 @Pfirsichbaeumchen / #3300360 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4916853",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhörst-verb"
          ]
        },
        {
          "id": "5645290",
          "text": "Wenn du nicht aufhörst, sage ich es Papa!",
          "translation": "Если не перестанешь, я папе расскажу!",
          "source": "Tatoeba #5645290 @Pfirsichbaeumchen / #5645128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5645290",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhörst-verb"
          ]
        },
        {
          "id": "5645291",
          "text": "Wenn du nicht aufhörst, sage ich es Mama!",
          "translation": "Если не перестанешь, я маме расскажу!",
          "source": "Tatoeba #5645291 @Pfirsichbaeumchen / #5645125 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5645291",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhörst-verb"
          ]
        },
        {
          "id": "8186222",
          "text": "Ich möchte, dass du aufhörst, so viel fernzusehen.",
          "translation": "Я хочу, чтобы ты перестал столько смотреть телевизор.",
          "source": "Tatoeba #8186222 @Pfirsichbaeumchen / #8934077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8186222",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhörst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
