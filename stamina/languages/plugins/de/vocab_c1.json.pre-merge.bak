    {
      "slug": "ansieht-verb",
      "lemma": "ansieht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7321,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular dependent present of ansehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11861021",
          "text": "Ich hasse es, wenn sie mich so ansieht.",
          "translation": "Терпеть не могу, когда она на меня так смотрит.",
          "source": "Tatoeba #11861021 @stickerkleber / #11861046 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11861021",
          "cefr_level": "A1",
          "word_slugs": [
            "ansieht-verb"
          ]
        },
        {
          "id": "2179579",
          "text": "Es gefällt mir nicht, wie er dich ansieht.",
          "translation": "Мне не нравится, как он на тебя смотрит.",
          "source": "Tatoeba #2179579 @Pfirsichbaeumchen / #3985778 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2179579",
