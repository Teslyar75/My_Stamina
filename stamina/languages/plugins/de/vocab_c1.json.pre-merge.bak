          ]
        },
        {
          "id": "746705",
          "text": "Er kann kein Dichter sein.",
          "translation": "Он не может быть поэтом.",
          "source": "Tatoeba #746705 @Esperantostern / #4577958 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/746705",
          "cefr_level": "A1",
