          ]
        },
        {
          "id": "8060483",
          "text": "Ich lerne mit Hilfe von Youtube-Videos Französisch.",
          "translation": "Я учу французский, используя видео на Youtube.",
          "source": "Tatoeba #8060483 @Pfirsichbaeumchen / #8646579 @Smoky (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8060483",
          "cefr_level": "A1",
          "word_slugs": [
            "videos-noun"
          ]
        },
        {
          "id": "9779936",
          "text": "Ich sehe mir gerne bei Youtube Videos in Esperanto an.",
          "translation": "Мне нравится смотреть видео на эсперанто на Ютубе.",
          "source": "Tatoeba #9779936 @Pfirsichbaeumchen / #5730516 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9779936",
          "cefr_level": "A1",
          "word_slugs": [
