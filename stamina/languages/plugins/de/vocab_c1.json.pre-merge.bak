    {
      "slug": "bewahre-verb",
      "lemma": "bewahre",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7975,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bewahren:",
          "first-person singular present",
          "inflection of bewahren:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "782077",
          "text": "Bewahre es an einem kühlen Ort auf.",
          "translation": "Храните его в прохладном месте.",
          "source": "Tatoeba #782077 @Hans_Adler / #1892824 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/782077",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahre-verb"
          ]
        },
        {
          "id": "14073862",
          "text": "Ich bewahre zu Hause kein Bargeld auf.",
          "translation": "Я не держу дома наличные.",
          "source": "Tatoeba #14073862 @mhr / #14073762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14073862",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahre-verb"
          ]
        },
        {
          "id": "710085",
          "text": "Bewahre das Geld an einem sicheren Ort auf.",
          "translation": "Держи деньги в надёжном месте.",
          "source": "Tatoeba #710085 @samueldora / #3035273 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/710085",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahre-verb"
          ]
        },
        {
          "id": "852560",
          "text": "Ich bewahre meinen Hammer in der Werkzeugkiste auf.",
          "translation": "Я храню молоток в ящике с инструментами.",
          "source": "Tatoeba #852560 @Esperantostern / #3812461 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/852560",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahre-verb"
          ]
        },
        {
          "id": "5253886",
          "text": "Bewahre nicht dein ganzes Geld in einer einzigen Hosentasche auf.",
          "translation": "Не держи все деньги в одном кармане.",
          "source": "Tatoeba #5253886 @Tamy / #12283305 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5253886",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahre-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
