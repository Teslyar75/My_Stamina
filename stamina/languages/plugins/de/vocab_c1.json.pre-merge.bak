    {
      "slug": "erschoss-verb",
      "lemma": "erschoss",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8349,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Formerly standard spelling of erschoss which was deprecated in the spelling reform (Rechtschreibreform) of 1996."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7452768",
          "text": "Tom erschoss beide Tiger.",
          "translation": "Том застрелил обоих тигров.",
          "source": "Tatoeba #7452768 @Pfirsichbaeumchen / #8734680 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7452768",
          "cefr_level": "A1",
          "word_slugs": [
            "erschoss-verb"
          ]
        },
        {
          "id": "776065",
          "text": "Der Jäger erschoss den Fuchs.",
          "translation": "Охотник застрелил лису.",
          "source": "Tatoeba #776065 @Esperantostern / #777058 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/776065",
          "cefr_level": "A1",
          "word_slugs": [
            "erschoss-verb"
          ]
        },
        {
          "id": "452536",
          "text": "Der Jäger erschoss einen Bären.",
          "translation": "Охотник выстрелил в медведя.",
          "source": "Tatoeba #452536 @Pfirsichbaeumchen / #1643193 @Hayabusa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/452536",
          "cefr_level": "A1",
          "word_slugs": [
            "erschoss-verb"
          ]
        },
        {
          "id": "11409668",
          "text": "Er erschoss den Liebhaber seiner Frau.",
          "translation": "Он застрелил любовника жены.",
          "source": "Tatoeba #11409668 @maaster / #11507590 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11409668",
          "cefr_level": "A1",
          "word_slugs": [
            "erschoss-verb"
          ]
        },
        {
          "id": "358093",
          "text": "Benjamin erschoss einen Bären mit dem Gewehr.",
          "translation": "Бенджамен застрелил из винтовки медведя.",
          "source": "Tatoeba #358093 @MUIRIEL / #13450961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/358093",
          "cefr_level": "A1",
          "word_slugs": [
            "erschoss-verb"
          ]
        }
      ],
