    {
      "slug": "versehentlich-adj",
      "lemma": "versehentlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8762,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "ошибочный"
        ],
        "en": [
          "due to a mistake, mistaken, accidental, unintentional"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12662656",
          "text": "Er hat versehentlich den Knopf gedrückt.",
          "translation": "Он случайно нажал кнопку.",
          "source": "Tatoeba #12662656 @mhr / #12656749 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12662656",
          "cefr_level": "A1",
          "word_slugs": [
            "versehentlich-adj"
          ]
        },
        {
          "id": "2761071",
          "text": "Tom hat versehentlich eine Münze verschluckt.",
          "translation": "Том случайно проглотил монетку.",
          "source": "Tatoeba #2761071 @Pfirsichbaeumchen / #2962507 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2761071",
          "cefr_level": "A1",
          "word_slugs": [
            "versehentlich-adj"
          ]
        },
        {
          "id": "13584348",
          "text": "Der Zeitreisende veränderte versehentlich den Lauf der Geschichte.",
          "translation": "Путешественник во времени случайно изменил ход истории.",
          "source": "Tatoeba #13584348 @carlosalberto / #13584367 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13584348",
          "cefr_level": "A1",
          "word_slugs": [
            "versehentlich-adj"
          ]
        },
        {
          "id": "3795898",
          "text": "Tom schnitt sich versehentlich beim Karottenschneiden in den Finger.",
          "translation": "Том нечаянно порезал себе палец, когда резал морковь.",
          "source": "Tatoeba #3795898 @Tickler / #5866263 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3795898",
          "cefr_level": "A1",
          "word_slugs": [
            "versehentlich-adj"
          ]
        },
        {
          "id": "504641",
          "text": "Als ich klein war, bin ich versehentlich auf einen Regenwurm getreten.",
          "translation": "Когда я была маленькой, я нечаянно наступила на дождевого червя.",
          "source": "Tatoeba #504641 @Robroy / #3566018 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/504641",
          "cefr_level": "A1",
          "word_slugs": [
            "versehentlich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der versehentlich",
        "nominative_pl": ""
      }
    },
