          "source": "Tatoeba #13601716 @Waldelfe / #13601495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13601716",
          "cefr_level": "A1",
          "word_slugs": [
            "pflanze-noun"
          ]
        },
        {
          "id": "5622305",
          "text": "Frost zerstört die Pflanze.",
          "translation": "Мороз губит растения.",
          "source": "Tatoeba #5622305 @list / #11982567 @Timolio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5622305",
          "cefr_level": "A1",
          "word_slugs": [
            "pflanze-noun"
          ]
        },
        {
          "id": "11763729",
          "text": "Diese Pflanze braucht Schatten.",
          "translation": "Этому растению нужна тень.",
          "source": "Tatoeba #11763729 @Adelpa / #13043639 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11763729",
          "cefr_level": "A1",
