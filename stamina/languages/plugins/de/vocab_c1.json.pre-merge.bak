    {
      "slug": "beitrag-noun",
      "lemma": "Beitrag",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6993,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "взнос"
        ],
        "en": [
          "contribution (something given or offered that adds to a larger whole)",
          "fee, dues (membership in a club or union)",
          "article",
          "post"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2204306",
          "text": "Tom leistete einen Beitrag.",
          "translation": "Том внес свой вклад.",
          "source": "Tatoeba #2204306 @Pfirsichbaeumchen / #9464080 @schwetterling (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2204306",
          "cefr_level": "A1",
          "word_slugs": [
            "beitrag-noun"
          ]
        },
        {
          "id": "9821236",
          "text": "Dieser Beitrag muss mal wieder nach oben geholt werden!",
          "translation": "Этот пост стоит вновь поднять в топ!",
          "source": "Tatoeba #9821236 @Pfirsichbaeumchen / #9795011 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9821236",
          "cefr_level": "A1",
          "word_slugs": [
            "beitrag-noun"
          ]
        },
        {
          "id": "2911412",
          "text": "Leider verstößt dein Beitrag gegen die Regeln der Grammatik.",
          "translation": "К сожалению, твой вклад нарушает грамматические нормы.",
          "source": "Tatoeba #2911412 @al_ex_an_der / #2911213 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2911412",
          "cefr_level": "A1",
          "word_slugs": [
            "beitrag-noun"
          ]
        },
        {
          "id": "481170",
          "text": "Eugene wird den Ig-Nobelpreis für seinen Beitrag zur Literatur erhalten.",
          "translation": "Евгений получит Шнобелевскую премию за свой вклад в литературу.",
          "source": "Tatoeba #481170 @MUIRIEL / #480851 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/481170",
          "cefr_level": "A1",
          "word_slugs": [
            "beitrag-noun"
          ]
        },
        {
          "id": "1371959",
          "text": "Er hat einen sehr großen Beitrag zur Erforschung von Krebserkrankungen geleistet.",
          "translation": "Он внёс огромный вклад в изучение раковых заболеваний.",
          "source": "Tatoeba #1371959 @al_ex_an_der / #912964 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1371959",
          "cefr_level": "A1",
          "word_slugs": [
            "beitrag-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Beitrag",
        "nominative_pl": ""
      }
    },
    {
