      "gender": null,
      "examples": [
        {
          "id": "13079379",
          "text": "Ich mag Speck mit Eiern.",
          "translation": "Я люблю яичницу с ветчиной.",
          "source": "Tatoeba #13079379 @Vortarulo / #13079380 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13079379",
          "cefr_level": "A1",
          "word_slugs": [
            "eiern-noun"
          ]
        },
        {
          "id": "12406825",
          "text": "Mayonnaise wird aus Eiern gemacht.",
          "translation": "Майонез делается из яиц.",
          "source": "Tatoeba #12406825 @Waldelfe / #12406831 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12406825",
          "cefr_level": "A1",
          "word_slugs": [
            "eiern-noun"
          ]
        },
        {
          "id": "12163450",
          "text": "Was ist mit Eiern? Brauchen wir welche?",
          "translation": "А яйца? Яйца нам нужны?",
          "source": "Tatoeba #12163450 @Pfirsichbaeumchen / #11632882 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12163450",
          "cefr_level": "A1",
          "word_slugs": [
            "eiern-noun"
          ]
        },
        {
