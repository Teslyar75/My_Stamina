    {
      "slug": "zivilisation-noun",
      "lemma": "Zivilisation",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5664,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "цивилизация"
        ],
        "en": [
          "civilisation"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "7441785",
          "text": "Tom lebt fernab jeglicher Zivilisation.",
          "translation": "Том живёт вдали от цивилизации.",
          "source": "Tatoeba #7441785 @Pfirsichbaeumchen / #7446441 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7441785",
          "cefr_level": "A1",
          "word_slugs": [
            "zivilisation-noun"
          ]
        },
        {
          "id": "3564151",
          "text": "Wird unsere Zivilisation eines Tages untergehen?",
          "translation": "Погибнет ли когда-нибудь наша цивилизация?",
          "source": "Tatoeba #3564151 @Mixtli / #3565281 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3564151",
          "cefr_level": "A1",
          "word_slugs": [
            "zivilisation-noun"
          ]
        },
        {
          "id": "12423250",
          "text": "Wir fanden Überbleibsel einer uralten Zivilisation.",
          "translation": "Мы обнаружили останки древней цивилизации.",
          "source": "Tatoeba #12423250 @Yorwba / #12423545 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12423250",
          "cefr_level": "A1",
          "word_slugs": [
            "zivilisation-noun"
          ]
        },
        {
          "id": "2322363",
          "text": "Griechenland war die Wiege der westlichen Zivilisation.",
          "translation": "Греция была колыбелью западной цивилизации.",
          "source": "Tatoeba #2322363 @Pfirsichbaeumchen / #2895069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2322363",
          "cefr_level": "A1",
          "word_slugs": [
            "zivilisation-noun"
          ]
        },
        {
          "id": "13867307",
          "text": "Der Nahe Osten ist die Wiege der Zivilisation.",
          "translation": "Ближний Восток — колыбель цивилизации.",
          "source": "Tatoeba #13867307 @mhr / #3368930 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13867307",
          "cefr_level": "A1",
          "word_slugs": [
            "zivilisation-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Zivilisation",
        "nominative_pl": ""
      }
    },
    {
      "slug": "tiefen-noun",
      "lemma": "Tiefen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5665,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Tiefe"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8108830",
          "text": "Das Leben hat Höhen und Tiefen.",
          "translation": "В жизни бывают взлёты и падения.",
          "source": "Tatoeba #8108830 @kutschektar / #898380 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8108830",
          "cefr_level": "A1",
          "word_slugs": [
            "tiefen-noun"
          ]
        },
        {
          "id": "1187",
          "text": "Im Leben gibt es Höhen und Tiefen.",
          "translation": "В жизни есть взлёты и падения.",
          "source": "Tatoeba #1187 @MUIRIEL / #7453433 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1187",
          "cefr_level": "A1",
          "word_slugs": [
            "tiefen-noun"
          ]
        },
        {
          "id": "483609",
          "text": "Das Leben hat seine Höhen und Tiefen.",
          "translation": "В жизни бывают свои взлёты и падения.",
          "source": "Tatoeba #483609 @Espi / #2094422 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/483609",
          "cefr_level": "A1",
          "word_slugs": [
            "tiefen-noun"
          ]
        },
        {
          "id": "2583212",
          "text": "Das Unterseeboot verbarg sich in den Tiefen des Ozeans.",
          "translation": "Подводная лодка скрылась в глубинах океана.",
          "source": "Tatoeba #2583212 @al_ex_an_der / #2583011 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2583212",
          "cefr_level": "A1",
          "word_slugs": [
            "tiefen-noun"
          ]
        },
        {
          "id": "353830",
          "text": "Gräm dich nicht. Das Leben hat seine Höhen und Tiefen.",
          "translation": "Не горюй. В жизни бывают свои взлёты и падения.",
          "source": "Tatoeba #353830 @lilygilder / #3306322 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/353830",
          "cefr_level": "A1",
          "word_slugs": [
            "tiefen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
