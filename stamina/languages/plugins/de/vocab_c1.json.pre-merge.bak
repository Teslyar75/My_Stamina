    {
      "slug": "halfen-verb",
      "lemma": "halfen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9988,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person plural preterite of helfen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8633985",
          "text": "Wir halfen ihm.",
          "translation": "Мы ему помогли.",
          "source": "Tatoeba #8633985 @Melang / #4513155 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8633985",
          "cefr_level": "A1",
          "word_slugs": [
            "halfen-verb"
          ]
        },
        {
          "id": "2221701",
          "text": "Wir halfen einander.",
          "translation": "Мы помогали друг другу.",
          "source": "Tatoeba #2221701 @Pfirsichbaeumchen / #2353941 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2221701",
          "cefr_level": "A1",
          "word_slugs": [
            "halfen-verb"
          ]
        },
        {
          "id": "3847687",
          "text": "Sie halfen einander.",
          "translation": "Они помогли друг другу.",
          "source": "Tatoeba #3847687 @raggione / #3659384 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3847687",
          "cefr_level": "A1",
          "word_slugs": [
            "halfen-verb"
          ]
        },
        {
          "id": "11140734",
          "text": "Alle halfen einander.",
          "translation": "Все выручали друг друга.",
          "source": "Tatoeba #11140734 @Pfirsichbaeumchen / #12838410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11140734",
          "cefr_level": "A1",
          "word_slugs": [
            "halfen-verb"
          ]
        },
        {
          "id": "2221703",
          "text": "Wir halfen uns gegenseitig.",
          "translation": "Мы помогли друг другу.",
          "source": "Tatoeba #2221703 @Pfirsichbaeumchen / #4449051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2221703",
          "cefr_level": "A1",
          "word_slugs": [
            "halfen-verb"
          ]
        }
