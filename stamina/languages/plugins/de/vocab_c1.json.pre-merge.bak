    {
      "slug": "sähe-verb",
      "lemma": "sähe",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8120,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular subjunctive II of sehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6817164",
          "text": "Maria meinte, ich sähe müde aus.",
          "translation": "Мария сказала, что я выглядел уставшим.",
          "source": "Tatoeba #6817164 @Pfirsichbaeumchen / #6818119 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6817164",
          "cefr_level": "A1",
          "word_slugs": [
            "sähe-verb"
          ]
        },
        {
          "id": "2217118",
          "text": "Ich dachte, ich sähe nicht recht.",
          "translation": "Я не мог поверить своим глазам.",
          "source": "Tatoeba #2217118 @Pfirsichbaeumchen / #407444 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2217118",
          "cefr_level": "A1",
          "word_slugs": [
            "sähe-verb"
          ]
        },
        {
          "id": "7635870",
          "text": "Tom tat so, als sähe er mich nicht.",
          "translation": "Том сделал вид, что не видит меня.",
          "source": "Tatoeba #7635870 @wolfgangth / #5151143 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7635870",
          "cefr_level": "A1",
          "word_slugs": [
            "sähe-verb"
          ]
        },
        {
          "id": "12284834",
          "text": "Sie tat so, als sähe sie ihn nicht.",
          "translation": "Она сделала вид, что не видит его.",
          "source": "Tatoeba #12284834 @Pfirsichbaeumchen / #9019792 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12284834",
          "cefr_level": "A1",
          "word_slugs": [
            "sähe-verb"
          ]
        },
        {
          "id": "2817209",
          "text": "Tom tat so, als sähe er Maria nicht.",
          "translation": "Том сделал вид, что не видит Мэри.",
          "source": "Tatoeba #2817209 @Pfirsichbaeumchen / #2817241 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2817209",
          "cefr_level": "A1",
          "word_slugs": [
            "sähe-verb"
          ]
        }
      ],
      "tags": [
        "C1"
