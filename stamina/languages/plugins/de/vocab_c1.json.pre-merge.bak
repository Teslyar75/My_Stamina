    {
      "slug": "wesentlich-adj",
      "lemma": "wesentlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6896,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "значительный"
        ],
        "en": [
          "essential (concerning the essence or true nature of something)",
          "crucial, principal, significant (of fundamental importance)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12296283",
          "text": "Dies hier ist wesentlich teurer.",
          "translation": "Этот существенно дороже.",
          "source": "Tatoeba #12296283 @mhr / #12416474 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12296283",
          "cefr_level": "A1",
          "word_slugs": [
            "wesentlich-adj"
          ]
        },
        {
          "id": "12296338",
          "text": "Dieser hier ist wesentlich teurer.",
          "translation": "Этот значительно дороже.",
          "source": "Tatoeba #12296338 @mhr / #12416472 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12296338",
          "cefr_level": "A1",
          "word_slugs": [
            "wesentlich-adj"
          ]
        },
        {
          "id": "13913820",
          "text": "Er ist wesentlich jünger als du.",
          "translation": "Он намного моложе тебя.",
          "source": "Tatoeba #13913820 @mhr / #13913805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13913820",
          "cefr_level": "A1",
          "word_slugs": [
            "wesentlich-adj"
          ]
        },
        {
          "id": "12366311",
          "text": "Tom ist wesentlich älter als wir.",
          "translation": "Том намного старше нас.",
          "source": "Tatoeba #12366311 @mhr / #7557528 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12366311",
          "cefr_level": "A1",
          "word_slugs": [
            "wesentlich-adj"
          ]
        },
        {
          "id": "13913818",
          "text": "Er ist wesentlich jünger als ihr.",
          "translation": "Он намного моложе вас.",
          "source": "Tatoeba #13913818 @mhr / #13913807 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13913818",
          "cefr_level": "A1",
          "word_slugs": [
