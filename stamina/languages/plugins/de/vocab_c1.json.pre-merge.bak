      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of ausziehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5170864",
          "text": "Du warst ausgezogen.",
          "translation": "Ты был неодет.",
          "source": "Tatoeba #5170864 @Tamy / #6671131 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5170864",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgezogen-verb"
          ]
        },
        {
          "id": "7522102",
          "text": "Ich habe das Hemd ausgezogen.",
          "translation": "Я снял рубашку.",
          "source": "Tatoeba #7522102 @Pfirsichbaeumchen / #7522108 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7522102",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgezogen-verb"
          ]
        },
        {
          "id": "13448737",
          "text": "Ich habe ihr den BH ausgezogen.",
          "translation": "Я снял с неё лифчик.",
          "source": "Tatoeba #13448737 @Vortarulo / #13448759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13448737",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgezogen-verb"
          ]
        },
        {
          "id": "10048976",
          "text": "Sie hat mir das Hemd ausgezogen.",
          "translation": "Она сняла с меня рубашку.",
          "source": "Tatoeba #10048976 @maaster / #12386220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10048976",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgezogen-verb"
          ]
        },
        {
          "id": "12519248",
          "text": "Ich habe schon meine Schuhe ausgezogen.",
          "translation": "Я уже разулся.",
          "source": "Tatoeba #12519248 @Naina / #12528644 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12519248",
