    {
      "slug": "sozialen-adj",
      "lemma": "sozialen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9126,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of sozial:",
          "strong genitive masculine/neuter singular",
          "inflection of sozial:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13698681",
          "text": "Ich bin nicht in den sozialen Netzwerken unterwegs.",
          "translation": "Я не бываю в соцсетях.",
          "source": "Tatoeba #13698681 @mhr / #13698615 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13698681",
          "cefr_level": "A1",
          "word_slugs": [
            "sozialen-adj"
          ]
        },
        {
          "id": "12978244",
          "text": "Die Sozialen Medien lenken euch von der Arbeit ab.",
          "translation": "Соцсети отвлекают вас от работы.",
          "source": "Tatoeba #12978244 @mhr / #12978170 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12978244",
          "cefr_level": "A1",
          "word_slugs": [
            "sozialen-adj"
          ]
        },
        {
          "id": "12978185",
          "text": "Die Sozialen Netzwerke lenken euch von der Arbeit ab.",
          "translation": "Соцсети отвлекают вас от работы.",
          "source": "Tatoeba #12978185 @mhr / #12978170 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12978185",
          "cefr_level": "A1",
          "word_slugs": [
            "sozialen-adj"
          ]
        },
        {
          "id": "13508754",
          "text": "Ungleichheit dieses Ausmaßes wird unweigerlich zu sozialen Unruhen führen.",
          "translation": "Такой уровень неравенства не может не привести к социальному напряжению.",
          "source": "Tatoeba #13508754 @Yorwba / #13875833 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13508754",
          "cefr_level": "A1",
          "word_slugs": [
            "sozialen-adj"
          ]
        },
        {
          "id": "13875915",
          "text": "Ein derartiges Ausmaß an Ungleichheit wird unweigerlich zu sozialen Spannungen führen.",
          "translation": "Такой уровень неравенства не может не привести к социальному напряжению.",
          "source": "Tatoeba #13875915 @mhr / #13875833 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13875915",
          "cefr_level": "A1",
          "word_slugs": [
            "sozialen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
