    {
      "slug": "fünfte-adj",
      "lemma": "fünfte",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6816,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "fifth"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3029136",
          "text": "Wer war der fünfte von ihnen?",
          "translation": "Кто из них был пятым?",
          "source": "Tatoeba #3029136 @al_ex_an_der / #3029132 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3029136",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfte-adj"
          ]
        },
        {
          "id": "1055552",
          "text": "Du bist das fünfte Rad am Wagen.",
          "translation": "Ты как собаке пятая нога!",
          "source": "Tatoeba #1055552 @Esperantostern / #3857024 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1055552",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfte-adj"
          ]
        },
        {
          "id": "1684956",
          "text": "Dies ist das fünfte Konzert dieses Orchesters.",
          "translation": "Это пятый концерт этого оркестра.",
          "source": "Tatoeba #1684956 @Zaghawa / #1277717 @Lich (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684956",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfte-adj"
          ]
        },
        {
          "id": "13382608",
          "text": "Heute ist Donnerstag, der fünfte September zweitausenddreizehn.",
          "translation": "Сегодня четверг, пятое сентября две тысячи тринадцатого года.",
          "source": "Tatoeba #13382608 @mhr / #13384918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13382608",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfte-adj"
          ]
        },
        {
          "id": "989595",
          "text": "Der fünfte Mai ist der Tag der Kinder.",
          "translation": "Пятое мая - День детей.",
          "source": "Tatoeba #989595 @MUIRIEL / #2400640 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/989595",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfte-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
