    {
      "slug": "rühren-verb",
      "lemma": "rühren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5848,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "шевелить"
        ],
        "en": [
          "to stir, to mix (a liquid or powder as in cooking)",
          "to stir; to move; to cause an emotion, especially sentimentality or compassion",
          "to stir (oneself); to move slightly",
          "to stand at ease"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13781528",
          "text": "Hierher rühren alle deine Probleme.",
          "translation": "Отсюда все твои проблемы.",
          "source": "Tatoeba #13781528 @mhr / #13781517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13781528",
          "cefr_level": "A1",
          "word_slugs": [
            "rühren-verb"
          ]
        },
        {
          "id": "13783666",
          "text": "Hier rühren alle deine Probleme her.",
          "translation": "Отсюда все твои проблемы.",
          "source": "Tatoeba #13783666 @mhr / #13781517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13783666",
          "cefr_level": "A1",
          "word_slugs": [
            "rühren-verb"
          ]
        },
        {
          "id": "7462988",
          "text": "Ich habe Rückenschmerzen. Ich kann mich kaum rühren.",
          "translation": "У меня болит спина. Я едва могу пошевелиться.",
          "source": "Tatoeba #7462988 @Pfirsichbaeumchen / #7498761 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7462988",
          "cefr_level": "A1",
          "word_slugs": [
            "rühren-verb"
          ]
        },
        {
          "id": "13440169",
          "text": "Geben Sie Reis hinzu und rühren Sie gut um.",
          "translation": "Добавьте рис и тщательно перемешайте.",
          "source": "Tatoeba #13440169 @mhr / #13440118 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13440169",
          "cefr_level": "A1",
          "word_slugs": [
            "rühren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "geregelt-verb",
      "lemma": "geregelt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5849,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of regeln"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12873241",
          "text": "Du dachtest, alles sei geregelt.",
          "translation": "Ты думал, что всё улажено.",
          "source": "Tatoeba #12873241 @mhr / #12873090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12873241",
          "cefr_level": "A1",
          "word_slugs": [
            "geregelt-verb"
          ]
        },
        {
          "id": "12873239",
          "text": "Du dachtest, dass alles geregelt sei.",
          "translation": "Ты думал, что всё улажено.",
          "source": "Tatoeba #12873239 @mhr / #12873090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12873239",
          "cefr_level": "A1",
          "word_slugs": [
            "geregelt-verb"
          ]
        },
        {
          "id": "12873236",
          "text": "Du hast gedacht, dass alles geregelt ist.",
          "translation": "Ты думал, что всё улажено.",
          "source": "Tatoeba #12873236 @mhr / #12873090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12873236",
          "cefr_level": "A1",
          "word_slugs": [
            "geregelt-verb"
          ]
        },
        {
          "id": "12873237",
          "text": "Du hast gedacht, dass alles geregelt sei.",
          "translation": "Ты думал, что всё улажено.",
          "source": "Tatoeba #12873237 @mhr / #12873090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12873237",
          "cefr_level": "A1",
          "word_slugs": [
            "geregelt-verb"
          ]
        },
        {
          "id": "13998439",
          "text": "Ich weiß nicht, wie ich das geregelt kriegen werde.",
          "translation": "Не знаю, как я буду это разруливать.",
