    {
      "slug": "unwohl-adj",
      "lemma": "unwohl",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8596,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "unwell, indisposed, mildly sick",
          "uncomfortable"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "7778311",
          "text": "Ich fühle mich unwohl.",
          "translation": "Мне неудобно.",
          "source": "Tatoeba #7778311 @BerlinJakarta / #6333891 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7778311",
          "cefr_level": "A1",
          "word_slugs": [
            "unwohl-adj"
          ]
        },
        {
          "id": "11517046",
          "text": "Mary fühlte sich unwohl.",
          "translation": "Мэри чувствовала себя неуютно.",
          "source": "Tatoeba #11517046 @Bernie75 / #3868415 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11517046",
          "cefr_level": "A1",
          "word_slugs": [
            "unwohl-adj"
          ]
        },
        {
          "id": "562520",
          "text": "Ich fühle mich in der Gegenwart meines Vaters unwohl.",
          "translation": "Я чувствую себя неловко в присутствии отца.",
          "source": "Tatoeba #562520 @al_ex_an_der / #14073918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/562520",
          "cefr_level": "A1",
          "word_slugs": [
            "unwohl-adj"
          ]
        },
        {
          "id": "1819533",
          "text": "Ich fühlte mich sehr unwohl, weil ich ihre Frage nicht beantworten konnte.",
          "translation": "Я почувствовал себя очень неловко, потому что не мог ей ответить.",
          "source": "Tatoeba #1819533 @al_ex_an_der / #1819527 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1819533",
          "cefr_level": "A1",
          "word_slugs": [
            "unwohl-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der unwohl",
        "nominative_pl": ""
      }
    },
    {
      "slug": "pony-noun",
      "lemma": "Pony",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8597,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "пони"
        ],
        "en": [
          "bangs, fringe (way of cutting the front portion of the hair)",
          "the front portion of the hair as such, the hair above the forehead"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "10012974",
          "text": "Worin unterscheidet sich ein Pferd von einem Pony?",
          "translation": "Чем лошадь отличается от пони?",
          "source": "Tatoeba #10012974 @sakslane / #10012093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10012974",
          "cefr_level": "A1",
          "word_slugs": [
            "pony-noun"
          ]
        },
        {
          "id": "13806494",
          "text": "Mary liebt ihr Pony, und ihr Pony liebt auch sie.",
          "translation": "Мэри любит своего пони, и пони тоже любит её.",
          "source": "Tatoeba #13806494 @Vortarulo / #3956188 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13806494",
          "cefr_level": "A1",
          "word_slugs": [
            "pony-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Pony",
        "nominative_pl": ""
      }
    },
    {
      "slug": "materie-noun",
      "lemma": "Materie",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8598,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "материя"
        ],
        "en": [
          "matter",
          "subject matter, the practical realities and collected knowledge regarding the topic at hand",
          "matter, material (as opposed to the form, or the immaterial)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2133990",
          "text": "Ich möchte in diese Materie nicht tiefer eindringen.",
          "translation": "Я не хотел бы углубляться в этот вопрос.",
          "source": "Tatoeba #2133990 @al_ex_an_der / #4876684 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2133990",
          "cefr_level": "A1",
          "word_slugs": [
            "materie-noun"
          ]
        },
        {
          "id": "1880243",
          "text": "Die Materie, sehen Sie, verschwindet, es bleibt nur der Geist.",
          "translation": "Материя, видите ли, исчезает, остается один дух.",
          "source": "Tatoeba #1880243 @sixtynine / #1880223 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1880243",
          "cefr_level": "A1",
          "word_slugs": [
            "materie-noun"
          ]
        },
        {
          "id": "13457910",
          "text": "Materie besteht aus Atomen.",
          "translation": "Материя состоит из атомов.",
          "source": "Tatoeba #13457910 @Vortarulo / #5009291 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13457910",
          "cefr_level": "A1",
          "word_slugs": [
            "materie-noun"
          ]
        },
        {
          "id": "13668553",
          "text": "Materie besteht hauptsächlich aus Leere.",
          "translation": "Материя состоит главным образом из пустоты.",
          "source": "Tatoeba #13668553 @mhr / #13668566 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13668553",
          "cefr_level": "A1",
          "word_slugs": [
            "materie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Materie",
        "nominative_pl": ""
      }
    },
