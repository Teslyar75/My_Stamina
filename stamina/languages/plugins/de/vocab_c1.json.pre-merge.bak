      "gender": "f",
      "examples": [
        {
          "id": "4963177",
          "text": "Erst Bildung, dann Heirat.",
          "translation": "Сначала учись, потом женись.",
          "source": "Tatoeba #4963177 @Esperantostern / #13648673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4963177",
          "cefr_level": "A1",
          "word_slugs": [
            "bildung-noun"
          ]
        },
        {
          "id": "1645600",
          "text": "Du hast den Vorteil einer guten Bildung.",
          "translation": "У тебя есть преимущество в виде хорошего образования.",
          "source": "Tatoeba #1645600 @Zaghawa / #13193798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1645600",
          "cefr_level": "A1",
          "word_slugs": [
            "bildung-noun"
          ]
        },
        {
          "id": "1645604",
          "text": "Ihr habt den Vorteil einer guten Bildung.",
          "translation": "У вас есть преимущество в виде хорошего образования.",
          "source": "Tatoeba #1645604 @Zaghawa / #13193797 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1645604",
          "cefr_level": "A1",
          "word_slugs": [
            "bildung-noun"
          ]
        },
        {
          "id": "1645603",
          "text": "Sie haben den Vorteil einer guten Bildung.",
          "translation": "У Вас есть преимущество в виде хорошего образования.",
          "source": "Tatoeba #1645603 @Zaghawa / #13193799 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1645603",
          "cefr_level": "A1",
          "word_slugs": [
            "bildung-noun"
          ]
        },
        {
          "id": "13495873",
          "text": "Die Reichen und Mächtigen kontrollieren oft die Bildung.",
          "translation": "Богатые и могущественные часто контролируют образование.",
          "source": "Tatoeba #13495873 @mhr / #13495972 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13495873",
          "cefr_level": "A1",
          "word_slugs": [
            "bildung-noun"
          ]
        }
      ],
