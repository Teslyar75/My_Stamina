          ]
        },
        {
          "id": "676682",
          "text": "Er machte eine sehr wertvolle Entdeckung.",
          "translation": "Он сделал очень ценное открытие.",
          "source": "Tatoeba #676682 @samueldora / #410518 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/676682",
          "cefr_level": "A1",
          "word_slugs": [
            "wertvolle-adj"
          ]
        },
        {
          "id": "2431191",
          "text": "Heute habe ich eine wertvolle Lektion gelernt.",
