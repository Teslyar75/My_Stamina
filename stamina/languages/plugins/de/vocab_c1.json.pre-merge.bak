    {
      "slug": "ärgern-verb",
      "lemma": "ärgern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5528,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "злить"
        ],
        "en": [
          "to annoy, to make angry",
          "to be annoyed, to be angry, to get annoyed, to get angry"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12282680",
          "text": "Sie ärgern sich wahrscheinlich.",
          "translation": "Вы, наверное, злитесь.",
          "source": "Tatoeba #12282680 @mhr / #12282580 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12282680",
          "cefr_level": "A1",
          "word_slugs": [
            "ärgern-verb"
          ]
        },
        {
          "id": "3292703",
          "text": "Hör auf, mich zu ärgern!",
          "translation": "Хватит меня злить!",
          "source": "Tatoeba #3292703 @freddy1 / #3292705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3292703",
          "cefr_level": "A1",
          "word_slugs": [
            "ärgern-verb"
          ]
        },
        {
          "id": "3846148",
          "text": "Versuch nicht, mich zu ärgern!",
          "translation": "Не пытайся меня разозлить.",
          "source": "Tatoeba #3846148 @Tamy / #9343338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3846148",
          "cefr_level": "A1",
          "word_slugs": [
            "ärgern-verb"
          ]
        },
        {
          "id": "3846152",
          "text": "Versucht nicht, mich zu ärgern!",
          "translation": "Не пытайтесь меня разозлить.",
          "source": "Tatoeba #3846152 @Tamy / #9343339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3846152",
          "cefr_level": "A1",
          "word_slugs": [
            "ärgern-verb"
          ]
        },
        {
          "id": "3846149",
          "text": "Versuchen Sie nicht, mich zu ärgern!",
