    {
      "slug": "natürlichen-adj",
      "lemma": "natürlichen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9158,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of natürlich:",
          "strong genitive masculine/neuter singular",
          "inflection of natürlich:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1475697",
          "text": "Er starb eines natürlichen Todes.",
          "translation": "Он умер естественной смертью.",
          "source": "Tatoeba #1475697 @Manfredo / #2809399 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1475697",
          "cefr_level": "A1",
          "word_slugs": [
            "natürlichen-adj"
          ]
        },
        {
          "id": "7635914",
          "text": "Tom starb eines natürlichen Todes.",
          "translation": "Том умер естественной смертью.",
          "source": "Tatoeba #7635914 @wolfgangth / #3268174 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7635914",
          "cefr_level": "A1",
          "word_slugs": [
            "natürlichen-adj"
          ]
        },
        {
          "id": "7697328",
          "text": "Tom starb keines natürlichen Todes.",
          "translation": "Том умер не своей смертью.",
          "source": "Tatoeba #7697328 @wolfgangth / #13950649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7697328",
          "cefr_level": "A1",
          "word_slugs": [
            "natürlichen-adj"
          ]
        },
        {
          "id": "13828469",
          "text": "Japan ist arm an natürlichen Ressourcen.",
          "translation": "Япония бедна природными ресурсами.",
          "source": "Tatoeba #13828469 @mhr / #13828626 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13828469",
          "cefr_level": "A1",
          "word_slugs": [
            "natürlichen-adj"
          ]
        },
        {
          "id": "2231562",
          "text": "Er ist eines natürlichen Todes gestorben.",
          "translation": "Он умер естественной смертью.",
          "source": "Tatoeba #2231562 @Zaghawa / #2809399 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2231562",
          "cefr_level": "A1",
          "word_slugs": [
            "natürlichen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
