    {
      "slug": "sowohl-conj",
      "lemma": "sowohl",
      "pos": "conj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5479,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "обе"
        ],
        "en": [
          "both (only in combination with a contrasting second element, see derived terms)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2388790",
          "text": "Mary mag sowohl Tom als auch John.",
          "translation": "Мэри нравится и Том, и Джон.",
          "source": "Tatoeba #2388790 @brauchinet / #3671450 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2388790",
          "cefr_level": "A1",
          "word_slugs": [
            "sowohl-conj"
          ]
        },
        {
          "id": "1808584",
          "text": "Er mag sowohl Musik als auch Sport.",
          "translation": "Он любит и музыку, и спорт.",
          "source": "Tatoeba #1808584 @pne / #5514426 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1808584",
          "cefr_level": "A1",
          "word_slugs": [
            "sowohl-conj"
          ]
        },
        {
          "id": "1715994",
          "text": "Tom kennt sowohl Mary als auch John.",
          "translation": "Том знаком и с Мэри, и с Джоном.",
          "source": "Tatoeba #1715994 @marcelostockle / #5514419 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1715994",
          "cefr_level": "A1",
          "word_slugs": [
            "sowohl-conj"
          ]
        },
        {
          "id": "13802061",
          "text": "Ich habe sowohl Tee als auch Kaffee.",
          "translation": "У меня есть и чай, и кофе.",
          "source": "Tatoeba #13802061 @kumakyoo / #12961876 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13802061",
          "cefr_level": "A1",
          "word_slugs": [
            "sowohl-conj"
          ]
        },
        {
          "id": "398018",
          "text": "Ich mag sowohl Hunde als auch Katzen.",
          "translation": "Я и собак, и кошек люблю.",
          "source": "Tatoeba #398018 @xtofu80 / #13476429 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398018",
          "cefr_level": "A1",
          "word_slugs": [
            "sowohl-conj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
