    {
      "slug": "entschluss-noun",
      "lemma": "Entschluß",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9593,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "resolution, conclusion",
          "decision, resolve, determination"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5258237",
          "text": "Tom erläuterte seinen Entschluss.",
          "translation": "Том объяснил своё решение.",
          "source": "Tatoeba #5258237 @Pfirsichbaeumchen / #5258234 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5258237",
          "cefr_level": "A1",
          "word_slugs": [
            "entschluss-noun"
          ]
        },
        {
          "id": "1704632",
          "text": "Es war ein weiser Entschluss.",
          "translation": "Это было мудрое решение.",
          "source": "Tatoeba #1704632 @al_ex_an_der / #2792200 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1704632",
          "cefr_level": "A1",
          "word_slugs": [
            "entschluss-noun"
          ]
        },
        {
          "id": "3591330",
          "text": "Das ist ein weiser Entschluss.",
          "translation": "Это мудрое решение.",
          "source": "Tatoeba #3591330 @freddy1 / #3602722 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3591330",
          "cefr_level": "A1",
          "word_slugs": [
            "entschluss-noun"
          ]
        },
        {
          "id": "12435788",
          "text": "Ich traf diesen Entschluß selbst.",
          "translation": "Я сама приняла это решение.",
          "source": "Tatoeba #12435788 @Waldelfe / #13851806 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12435788",
          "cefr_level": "A1",
          "word_slugs": [
            "entschluss-noun"
          ]
        },
        {
          "id": "7460458",
          "text": "Ist das dein endgültiger Entschluss?",
          "translation": "Это твоё окончательное решение?",
          "source": "Tatoeba #7460458 @Pfirsichbaeumchen / #5825885 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7460458",
          "cefr_level": "A1",
