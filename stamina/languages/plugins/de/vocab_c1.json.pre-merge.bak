    {
      "slug": "ausschliesslich-adj",
      "lemma": "ausschließlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9724,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "исключительный"
        ],
        "en": [
          "Switzerland and Liechtenstein standard spelling of ausschließlich"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5912751",
          "text": "Sie liest ausschließlich Lehrbücher.",
          "translation": "Она не читает никаких книг, кроме учебников.",
          "source": "Tatoeba #5912751 @Pfirsichbaeumchen / #5905856 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5912751",
          "cefr_level": "A1",
          "word_slugs": [
            "ausschliesslich-adj"
          ]
        },
        {
          "id": "14008004",
          "text": "Känguruhs fressen fast ausschließlich Gras.",
          "translation": "Кенгуру питаются почти исключительно травой.",
          "source": "Tatoeba #14008004 @Waldelfe / #14008006 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14008004",
          "cefr_level": "A1",
          "word_slugs": [
            "ausschliesslich-adj"
          ]
        },
        {
          "id": "12351717",
          "text": "Ich schreibe ausschließlich in meiner Muttersprache.",
          "translation": "Я пишу исключительно на своём родном языке.",
          "source": "Tatoeba #12351717 @Pfirsichbaeumchen / #12351708 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12351717",
          "cefr_level": "A1",
          "word_slugs": [
            "ausschliesslich-adj"
          ]
        },
        {
          "id": "12587898",
          "text": "Dieser Bäcker verwendet ausschließlich natürliche Hefe.",
          "translation": "Этот пекарь использует исключительно натуральные дрожжи.",
          "source": "Tatoeba #12587898 @mhr / #12587888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12587898",
          "cefr_level": "A1",
          "word_slugs": [
            "ausschliesslich-adj"
          ]
        },
        {
          "id": "12587899",
          "text": "Dieser Bäcker verwendet ausschließlich natürliche Hefen.",
          "translation": "Этот пекарь использует исключительно натуральные дрожжи.",
          "source": "Tatoeba #12587899 @mhr / #12587888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12587899",
          "cefr_level": "A1",
          "word_slugs": [
            "ausschliesslich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
