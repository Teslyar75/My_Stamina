      "gender": null,
      "examples": [
        {
          "id": "13805384",
          "text": "Ziehe deine schmutzigen Arbeitsklamotten aus!",
          "translation": "Сними грязную рабочую одежду!",
          "source": "Tatoeba #13805384 @maaster / #13805947 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13805384",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutzigen-adj"
          ]
        },
        {
          "id": "10053840",
          "text": "Wohin soll ich die schmutzigen Socken legen?",
          "translation": "Куда я должен положить грязные носки?",
          "source": "Tatoeba #10053840 @sakslane / #7039212 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10053840",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutzigen-adj"
          ]
        },
        {
          "id": "3399657",
          "text": "Reibe dir nie mit schmutzigen Händen die Augen!",
          "translation": "Никогда не три глаза грязными руками!",
          "source": "Tatoeba #3399657 @Pfirsichbaeumchen / #10911165 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3399657",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutzigen-adj"
          ]
        },
        {
          "id": "5967768",
          "text": "Trink nicht das Wasser aus dem schmutzigen Glas!",
          "translation": "Не пей воду из грязного стакана!",
          "source": "Tatoeba #5967768 @Ronja / #5968000 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5967768",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutzigen-adj"
          ]
        },
        {
          "id": "4584930",
          "text": "Trinke nicht das Wasser aus dem schmutzigen Glas.",
          "translation": "Не пей воду из грязного стакана.",
          "source": "Tatoeba #4584930 @Esperantostern / #4589405 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4584930",
