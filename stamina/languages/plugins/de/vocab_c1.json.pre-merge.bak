          "source": "Tatoeba #7881648 @wolfgangth / #9821113 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7881648",
          "cefr_level": "A1",
          "word_slugs": [
            "käfer-noun"
          ]
        },
        {
          "id": "9812436",
          "text": "Tom hat einen Käfer gegessen.",
          "translation": "Том съел жука.",
          "source": "Tatoeba #9812436 @maaster / #10118444 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9812436",
          "cefr_level": "A1",
          "word_slugs": [
            "käfer-noun"
          ]
        },
        {
          "id": "3084334",
          "text": "Ich habe einen Käfer verschluckt!",
          "translation": "Я проглотил жука!",
          "source": "Tatoeba #3084334 @Pfirsichbaeumchen / #10118441 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3084334",
