    {
      "slug": "englischen-adj",
      "lemma": "englischen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7328,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of englisch:",
          "strong genitive masculine/neuter singular",
          "inflection of englisch:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10006155",
          "text": "Ich würde es vom englischen Satz abtrennen.",
          "translation": "Я бы от английского предложения отсоединил.",
          "source": "Tatoeba #10006155 @Pfirsichbaeumchen / #10006153 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10006155",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-adj"
          ]
        },
        {
          "id": "5741084",
          "text": "Er widmete sich dem Studium der englischen Literatur.",
          "translation": "Он посвятил себя изучению английской литературы.",
          "source": "Tatoeba #5741084 @Pfirsichbaeumchen / #1541028 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5741084",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-adj"
          ]
        },
        {
          "id": "5709362",
          "text": "Unregelmäßige Verben sind ein Teil der englischen Sprache.",
          "translation": "Неправильные глаголы – часть английского языка.",
          "source": "Tatoeba #5709362 @halfdan / #10483525 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5709362",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-adj"
          ]
        },
        {
          "id": "13062685",
          "text": "Das ist ein französischer Film mit englischen Untertiteln.",
          "translation": "Это французский фильм с английскими субтитрами.",
          "source": "Tatoeba #13062685 @Vortarulo / #13062704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13062685",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-adj"
          ]
        },
        {
          "id": "3044006",
          "text": "Wie viele Wörter gibt es in der englischen Sprache?",
          "translation": "Сколько слов в английском языке?",
          "source": "Tatoeba #3044006 @pne / #3044011 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3044006",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
