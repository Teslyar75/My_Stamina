    {
      "slug": "eingereicht-verb",
      "lemma": "eingereicht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9820,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of einreichen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2796438",
          "text": "Tom hat bereits Beschwerde eingereicht.",
          "translation": "Том уже подал жалобу.",
          "source": "Tatoeba #2796438 @Pfirsichbaeumchen / #7764320 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2796438",
          "cefr_level": "A1",
          "word_slugs": [
            "eingereicht-verb"
          ]
        },
        {
          "id": "7714860",
          "text": "Wann hat Tom seine Kündigung eingereicht?",
          "translation": "Когда Том подал заявление об увольнении?",
          "source": "Tatoeba #7714860 @Pfirsichbaeumchen / #7764367 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7714860",
          "cefr_level": "A1",
          "word_slugs": [
            "eingereicht-verb"
          ]
        },
        {
          "id": "3531522",
          "text": "Alle Aufsätze müssen rechtzeitig eingereicht werden.",
          "translation": "Все сочинения должны быть сданы вовремя.",
          "source": "Tatoeba #3531522 @Pfirsichbaeumchen / #7764329 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3531522",
          "cefr_level": "A1",
          "word_slugs": [
            "eingereicht-verb"
          ]
        },
        {
          "id": "942986",
          "text": "Der Bericht soll bis zum Ende dieser Woche eingereicht werden.",
          "translation": "Доклад должен быть сдан до конца недели.",
          "source": "Tatoeba #942986 @chiyochan / #7764369 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/942986",
          "cefr_level": "A1",
          "word_slugs": [
            "eingereicht-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
