      "gender": null,
      "examples": [
        {
          "id": "10063327",
          "text": "Magst du Brasilien?",
          "translation": "Тебе нравится Бразилия?",
          "source": "Tatoeba #10063327 @wolfgangth / #8261354 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10063327",
          "cefr_level": "A1",
