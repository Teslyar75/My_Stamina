          ]
        },
        {
          "id": "402355",
          "text": "Der Aktienmarkt befindet sich in einem schlimmen Zustand.",
          "translation": "Рынок акций находится в плохом состоянии.",
          "source": "Tatoeba #402355 @xtofu80 / #2355876 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/402355",
          "cefr_level": "A1",
          "word_slugs": [
            "schlimmen-adj"
          ]
        },
        {
          "id": "12572508",
          "text": "Maria treibt sich gern mit den schlimmen Jungs herum.",
          "translation": "Мэри любит тусоваться с плохими парнями.",
          "source": "Tatoeba #12572508 @Waldelfe / #4754416 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12572508",
          "cefr_level": "A1",
          "word_slugs": [
            "schlimmen-adj"
          ]
        }
