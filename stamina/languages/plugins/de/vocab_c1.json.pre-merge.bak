    {
      "slug": "ärmel-noun",
      "lemma": "Ärmel",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7918,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "рукав"
        ],
        "en": [
          "sleeve"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "9998214",
          "text": "Der Pullover hat lange Ärmel.",
          "translation": "У свитера длинные рукава.",
          "source": "Tatoeba #9998214 @Melang / #13524091 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9998214",
          "cefr_level": "A1",
          "word_slugs": [
            "ärmel-noun"
          ]
        },
        {
          "id": "9455340",
          "text": "Toms linker Ärmel war zerrissen.",
          "translation": "У Тома был порван левый рукав.",
          "source": "Tatoeba #9455340 @Pfirsichbaeumchen / #9470185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9455340",
          "cefr_level": "A1",
          "word_slugs": [
            "ärmel-noun"
          ]
        },
        {
          "id": "9176918",
          "text": "Ich habe ein As im Ärmel.",
          "translation": "У меня туз под рукавом.",
          "source": "Tatoeba #9176918 @Pfirsichbaeumchen / #2948750 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9176918",
          "cefr_level": "A1",
          "word_slugs": [
            "ärmel-noun"
          ]
        },
        {
          "id": "5218880",
          "text": "Was hast du in deinem Ärmel?",
          "translation": "Что у тебя в рукаве?",
          "source": "Tatoeba #5218880 @jaz1313 / #5218955 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5218880",
          "cefr_level": "A1",
          "word_slugs": [
            "ärmel-noun"
          ]
        },
        {
          "id": "12810201",
          "text": "Wir haben noch mehr Trümpfe im Ärmel.",
          "translation": "У нас есть ещё козыри в рукаве.",
          "source": "Tatoeba #12810201 @mhr / #12809147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12810201",
          "cefr_level": "A1",
          "word_slugs": [
            "ärmel-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Ärmel",
        "nominative_pl": ""
      }
    },
    {
      "slug": "fliessen-verb",
      "lemma": "fliessen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7919,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "течь"
        ],
        "en": [
          "Switzerland and Liechtenstein standard spelling of fließen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13724361",
          "text": "In Dagestan fließen 6225 Flüsse.",
          "translation": "В Дагестане протекает 6225 рек.",
          "source": "Tatoeba #13724361 @mhr / #13724121 @AvAdam05 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13724361",
          "cefr_level": "A1",
          "word_slugs": [
            "fliessen-verb"
          ]
        },
        {
          "id": "2151172",
          "text": "Donau und Rhein fließen nicht zusammen.",
          "translation": "Дунай и Рейн не сливаются.",
          "source": "Tatoeba #2151172 @Esperantostern / #14011734 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2151172",
          "cefr_level": "A1",
          "word_slugs": [
            "fliessen-verb"
          ]
        },
        {
          "id": "13857217",
          "text": "In Tatarstan fließen die Flüsse Wolga, Kama, Belaja und Wjatka.",
          "translation": "В Татарстане протекают реки Волга, Кама, Белая и Вятка.",
          "source": "Tatoeba #13857217 @mhr / #13858515 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13857217",
          "cefr_level": "A1",
          "word_slugs": [
            "fliessen-verb"
          ]
        },
        {
          "id": "13857219",
          "text": "Durch Tatarstan fließen die Flüsse Wolga, Kama, Belaja und Wjatka.",
          "translation": "Через Татарстан протекают реки Волга, Кама, Белая и Вятка.",
          "source": "Tatoeba #13857219 @mhr / #13858514 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13857219",
          "cefr_level": "A1",
          "word_slugs": [
            "fliessen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
