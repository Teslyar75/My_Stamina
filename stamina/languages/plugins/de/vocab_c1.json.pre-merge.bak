          "cefr_level": "A1",
          "word_slugs": [
            "formel-noun"
          ]
        },
        {
          "id": "12774576",
          "text": "Die Formel von Schwefelsäure lautet H₂SO₄.",
          "translation": "Формула серной кислоты - H₂SO₄.",
          "source": "Tatoeba #12774576 @Waldelfe / #12774206 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12774576",
          "cefr_level": "A1",
          "word_slugs": [
            "formel-noun"
          ]
        },
        {
          "id": "2698698",
          "text": "Die chemische Formel für Wasser ist H₂O.",
          "translation": "Химическая формула воды - H₂O.",
          "source": "Tatoeba #2698698 @Pfirsichbaeumchen / #2698442 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2698698",
          "cefr_level": "A1",
          "word_slugs": [
            "formel-noun"
          ]
        }
