    {
      "slug": "geschirr-noun",
      "lemma": "Geschirr",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8358,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "посуда"
        ],
        "en": [
          "dishware",
          "vessel, container",
          "harness"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "3327293",
          "text": "Wo ist das Geschirr?",
          "translation": "Где посуда?",
          "source": "Tatoeba #3327293 @al_ex_an_der / #3327294 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3327293",
          "cefr_level": "A1",
          "word_slugs": [
            "geschirr-noun"
          ]
        },
        {
          "id": "13458434",
          "text": "Wasch das Geschirr ab!",
          "translation": "Помой посуду!",
          "source": "Tatoeba #13458434 @mhr / #13516068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13458434",
          "cefr_level": "A1",
          "word_slugs": [
            "geschirr-noun"
          ]
        },
        {
          "id": "3327199",
          "text": "Das Geschirr ist schmutzig.",
          "translation": "Посуда грязная.",
          "source": "Tatoeba #3327199 @al_ex_an_der / #3327201 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3327199",
          "cefr_level": "A1",
          "word_slugs": [
            "geschirr-noun"
          ]
        },
        {
          "id": "12388031",
          "text": "Das Geschirr ist gewaschen.",
          "translation": "Посуда помыта.",
          "source": "Tatoeba #12388031 @mhr / #11841163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12388031",
          "cefr_level": "A1",
          "word_slugs": [
            "geschirr-noun"
          ]
        },
        {
          "id": "1662911",
          "text": "Tom spült das Geschirr ab.",
          "translation": "Том моет посуду.",
          "source": "Tatoeba #1662911 @Pfirsichbaeumchen / #2738012 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1662911",
          "cefr_level": "A1",
          "word_slugs": [
            "geschirr-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
