      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "масса"
        ],
        "en": [
          "Switzerland and Liechtenstein standard spelling of Maße"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2599862",
          "text": "Die Maße müssen stimmen.",
          "translation": "Измерения должны быть точными.",
          "source": "Tatoeba #2599862 @raggione / #2600875 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2599862",
          "cefr_level": "A1",
          "word_slugs": [
            "masse-noun"
          ]
        },
        {
          "id": "13524428",
          "text": "Welche Maße hat das Regal?",
          "translation": "Какие размеры у полки?",
          "source": "Tatoeba #13524428 @mhr / #13523552 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13524428",
          "cefr_level": "A1",
          "word_slugs": [
            "masse-noun"
          ]
        },
        {
          "id": "523469",
          "text": "Was sind die Maße des Regals?",
          "translation": "Какие размеры у полки?",
          "source": "Tatoeba #523469 @xtofu80 / #13523552 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/523469",
          "cefr_level": "A1",
          "word_slugs": [
            "masse-noun"
          ]
        },
        {
          "id": "3605564",
          "text": "In gewissem Maße stimme ich Ihnen zu.",
          "translation": "До некоторой степени я с вами согласен.",
          "source": "Tatoeba #3605564 @Pfirsichbaeumchen / #3605351 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3605564",
          "cefr_level": "A1",
          "word_slugs": [
            "masse-noun"
          ]
        },
        {
          "id": "11629709",
          "text": "Was er sagt, stimmt in gewissem Maße.",
          "translation": "То, что он говорит, в какой-то степени правда.",
          "source": "Tatoeba #11629709 @Pfirsichbaeumchen / #2498890 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11629709",
          "cefr_level": "A1",
          "word_slugs": [
            "masse-noun"
          ]
        }
      ],
      "tags": [
