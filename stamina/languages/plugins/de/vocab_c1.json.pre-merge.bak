          ]
        },
        {
          "id": "1227236",
          "text": "Ich bin aus Brasilien.",
          "translation": "Я из Бразилии.",
          "source": "Tatoeba #1227236 @Espi / #1501816 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1227236",
