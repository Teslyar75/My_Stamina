    {
      "slug": "hinfahren-verb",
      "lemma": "hinfahren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5521,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to give a ride [auxiliary haben] (to drive for someone else to reach a destination)",
          "to drive [auxiliary sein] (to drive to a specified location)",
          "to drive away, to drive off",
          "to decease"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6173835",
          "text": "Wir müssen nirgendwo hinfahren.",
          "translation": "Нам не нужно никуда ехать.",
          "source": "Tatoeba #6173835 @Pfirsichbaeumchen / #5913969 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6173835",
          "cefr_level": "A1",
          "word_slugs": [
            "hinfahren-verb"
          ]
        },
        {
          "id": "12855848",
          "text": "Mit wem wirst du dort hinfahren?",
          "translation": "С кем ты туда поедешь?",
          "source": "Tatoeba #12855848 @mhr / #12855838 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12855848",
          "cefr_level": "A1",
          "word_slugs": [
            "hinfahren-verb"
          ]
        },
        {
          "id": "1743307",
          "text": "Lasst uns mit dem Auto hinfahren.",
          "translation": "Поехали туда на машине.",
          "source": "Tatoeba #1743307 @jakov / #10946726 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1743307",
          "cefr_level": "A1",
          "word_slugs": [
            "hinfahren-verb"
          ]
        },
        {
          "id": "11700104",
          "text": "Du kannst da mit dem Bus hinfahren.",
          "translation": "Туда можно доехать на автобусе.",
          "source": "Tatoeba #11700104 @Pfirsichbaeumchen / #11630446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11700104",
          "cefr_level": "A1",
          "word_slugs": [
            "hinfahren-verb"
          ]
        },
        {
          "id": "7787384",
          "text": "Wir können mit der U-Bahn hinfahren.",
          "translation": "Мы можем поехать туда на метро.",
          "source": "Tatoeba #7787384 @brauchinet / #8454202 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7787384",
          "cefr_level": "A1",
          "word_slugs": [
            "hinfahren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "bedingung-noun",
      "lemma": "Bedingung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5522,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "условие"
        ],
        "en": [
          "requirement, prerequisite",
          "condition, term"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3543714",
          "text": "Ich habe nur eine Bedingung.",
          "translation": "У меня только одно условие.",
          "source": "Tatoeba #3543714 @annalog / #3542483 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3543714",
          "cefr_level": "A1",
          "word_slugs": [
            "bedingung-noun"
          ]
        },
        {
          "id": "12816029",
          "text": "Ich helfe dir unter einer Bedingung.",
          "translation": "Я помогу тебе при одном условии.",
          "source": "Tatoeba #12816029 @Waldelfe / #12835473 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12816029",
          "cefr_level": "A1",
          "word_slugs": [
            "bedingung-noun"
          ]
        },
        {
          "id": "12816030",
          "text": "Ich helfe euch unter einer Bedingung.",
          "translation": "Я помогу вам при одном условии.",
          "source": "Tatoeba #12816030 @Waldelfe / #12835474 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12816030",
          "cefr_level": "A1",
          "word_slugs": [
            "bedingung-noun"
          ]
        },
        {
          "id": "12816031",
          "text": "Ich helfe Ihnen unter einer Bedingung.",
          "translation": "Я помогу Вам при одном условии.",
          "source": "Tatoeba #12816031 @Waldelfe / #12835475 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12816031",
          "cefr_level": "A1",
          "word_slugs": [
            "bedingung-noun"
          ]
        },
        {
          "id": "636",
          "text": "Ich akzeptiere, aber nur unter einer Bedingung.",
          "translation": "Я согласен, но только при некоторых условиях.",
          "source": "Tatoeba #636 @MUIRIEL / #598646 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/636",
          "cefr_level": "A1",
          "word_slugs": [
            "bedingung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Bedingung",
        "nominative_pl": ""
      }
    },
    {
      "slug": "empfinde-verb",
