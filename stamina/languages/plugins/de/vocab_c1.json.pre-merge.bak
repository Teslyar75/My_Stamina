      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "powder (in most of its senses)",
          "money"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "2339777",
          "text": "Der Schnee ist wie Pulver.",
          "translation": "Снег как пыль.",
          "source": "Tatoeba #2339777 @Pfirsichbaeumchen / #11568947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2339777",
          "cefr_level": "A1",
          "word_slugs": [
            "pulver-noun"
          ]
        },
        {
          "id": "789795",
          "text": "Zement ist ein graues Pulver.",
          "translation": "Цемент — это порошок серого цвета.",
          "source": "Tatoeba #789795 @Manfredo / #3948743 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/789795",
          "cefr_level": "A1",
          "word_slugs": [
            "pulver-noun"
          ]
        },
        {
          "id": "1728589",
          "text": "Der hat auch nicht das Pulver erfunden.",
          "translation": "Он тоже не семи пядей во лбу.",
          "source": "Tatoeba #1728589 @Esperantostern / #12425647 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1728589",
          "cefr_level": "A1",
          "word_slugs": [
            "pulver-noun"
          ]
        },
        {
          "id": "1847071",
          "text": "Wisst ihr, wer das Pulver erfunden hat?",
          "translation": "Вы знаете, кто изобрёл порох?",
          "source": "Tatoeba #1847071 @Esperantostern / #2848094 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1847071",
          "cefr_level": "A1",
          "word_slugs": [
            "pulver-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
