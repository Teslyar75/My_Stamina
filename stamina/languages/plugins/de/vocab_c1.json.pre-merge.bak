    {
      "slug": "ähnlichkeit-noun",
      "lemma": "Ähnlichkeit",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8359,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сходство",
          "подобие"
        ],
        "en": [
          "similarity, resemblance"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "9829812",
          "text": "Die Ähnlichkeit ist signifikant.",
          "translation": "Сходство значительное.",
          "source": "Tatoeba #9829812 @GaryGaryGary / #4350756 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9829812",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnlichkeit-noun"
          ]
        },
        {
          "id": "12947010",
          "text": "Dieser Busfahrer hat Ähnlichkeit mit Obama.",
          "translation": "Этот водитель автобуса похож на Обаму.",
          "source": "Tatoeba #12947010 @mhr / #12946307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12947010",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnlichkeit-noun"
          ]
        },
        {
          "id": "2903809",
          "text": "Der Unterschied ist das Gegenteil der Ähnlichkeit.",
          "translation": "Отличие - противоположность похожести.",
          "source": "Tatoeba #2903809 @al_ex_an_der / #2904451 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2903809",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnlichkeit-noun"
          ]
        },
        {
          "id": "1075798",
          "text": "Jede Ähnlichkeit mit wirklichen Menschen, lebendig oder tot, ist reiner Zufall.",
          "translation": "Любое сходство с реальными людьми, ныне живущими или умершими, является случайным.",
          "source": "Tatoeba #1075798 @Esperantostern / #12835526 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1075798",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnlichkeit-noun"
          ]
        },
        {
          "id": "3431814",
          "text": "Die große Ähnlichkeit zwischen der Filmfigur und dem realen Menschen ist frappierend.",
          "translation": "То значительное сходство между героем фильма и реальным человеком поразительно.",
          "source": "Tatoeba #3431814 @al_ex_an_der / #3443697 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3431814",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnlichkeit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Ähnlichkeit",
        "nominative_pl": ""
      }
    },
    {
      "slug": "feiglinge-noun",
      "lemma": "Feiglinge",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8360,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Feigling"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1286509",
          "text": "Ich kann Feiglinge nicht ausstehen.",
          "translation": "Терпеть не могу трусов.",
          "source": "Tatoeba #1286509 @Esperantostern / #8687101 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1286509",
          "cefr_level": "A1",
          "word_slugs": [
            "feiglinge-noun"
          ]
        },
        {
          "id": "4987690",
          "text": "Ich weiß, dass ihr alle Feiglinge seid.",
          "translation": "Я знаю, что все вы трусы.",
          "source": "Tatoeba #4987690 @atwupack / #4987426 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4987690",
          "cefr_level": "A1",
          "word_slugs": [
            "feiglinge-noun"
          ]
        },
        {
          "id": "5061871",
          "text": "Ihr seid nichts als Feiglinge! Hört ihr? Nichts als Feiglinge!",
          "translation": "Вы просто трусы! Слышите? Просто трусы!",
          "source": "Tatoeba #5061871 @al_ex_an_der / #4940770 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5061871",
          "cefr_level": "A1",
          "word_slugs": [
            "feiglinge-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
