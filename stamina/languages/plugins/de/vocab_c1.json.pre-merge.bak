      "slug": "mass-noun",
      "lemma": "Mass",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9432,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мера"
        ],
        "en": [
          "measure (standard against which something can be judged)",
          "size",
          "extent"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "432565",
          "text": "Es ist ein Maß in den Dingen.",
          "translation": "Во всём нужна мера.",
          "source": "Tatoeba #432565 @jerom / #1893398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/432565",
          "cefr_level": "A1",
          "word_slugs": [
            "mass-noun"
          ]
        },
        {
          "id": "9822887",
          "text": "Ich weiß, wann das Maß voll ist.",
          "translation": "Я свою меру знаю.",
          "source": "Tatoeba #9822887 @Aythyaferina / #2767702 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9822887",
          "cefr_level": "A1",
          "word_slugs": [
            "mass-noun"
          ]
        },
        {
          "id": "6794171",
          "text": "Kein Maß an Alkohol vermochte Toms gebrochenes Herz zu heilen.",
          "translation": "Никакое количество спиртного не могло залечить разбитое сердце Тома.",
          "source": "Tatoeba #6794171 @Pfirsichbaeumchen / #6805690 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6794171",
          "cefr_level": "A1",
          "word_slugs": [
            "mass-noun"
          ]
        },
        {
          "id": "1135770",
          "text": "Die Anwendung erlaubt ein schnelles Ausrechnen des Body Mass Index – BMI.",
          "translation": "Данное приложение позволяет быстро рассчитать коэффициент индекса массы тела — ИМТ.",
          "source": "Tatoeba #1135770 @Vortarulo / #1173344 @Noitebranca (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1135770",
          "cefr_level": "A1",
          "word_slugs": [
            "mass-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
