          "cefr_level": "A1",
          "word_slugs": [
            "scherze-noun"
          ]
        },
        {
          "id": "12398286",
          "text": "Ihre Scherze sagen nicht allen zu.",
          "translation": "Её шутки не всем нравятся.",
