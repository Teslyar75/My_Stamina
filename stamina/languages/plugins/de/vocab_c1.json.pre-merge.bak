    {
      "slug": "pfeil-noun",
      "lemma": "Pfeil",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5611,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "arrow (missile)",
