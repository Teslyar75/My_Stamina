    {
      "slug": "kluge-name",
      "lemma": "Kluge",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7899,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "7285791",
          "text": "Kluge kleine Katzen kratzen keine Krokodile.",
          "translation": "Умные маленькие кошки не царапают крокодилов.",
          "source": "Tatoeba #7285791 @Gezeit / #7285793 @Gezeit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7285791",
          "cefr_level": "A1",
          "word_slugs": [
            "kluge-name"
          ]
        },
        {
          "id": "13411291",
          "text": "Kluge Gedanken verfolgten ihn, aber er war schneller.",
          "translation": "Умные мысли преследовали его, но он был быстрее.",
          "source": "Tatoeba #13411291 @mhr / #13411193 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13411291",
          "cefr_level": "A1",
          "word_slugs": [
            "kluge-name"
          ]
        },
        {
          "id": "13411292",
          "text": "Kluge Gedanken verfolgten ihn, doch er war schneller.",
          "translation": "Умные мысли преследовали его, но он был быстрее.",
          "source": "Tatoeba #13411292 @mhr / #13411193 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13411292",
          "cefr_level": "A1",
          "word_slugs": [
            "kluge-name"
          ]
        },
        {
          "id": "13662193",
          "text": "Der Kluge ändert seine Meinung, der Dummkopf niemals.",
          "translation": "Мудрец меняет своё мнение, дурак — никогда.",
          "source": "Tatoeba #13662193 @mhr / #13662126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13662193",
          "cefr_level": "A1",
          "word_slugs": [
            "kluge-name"
          ]
        },
        {
          "id": "2592039",
          "text": "Du bist sowohl eine Schöne als auch eine Kluge.",
          "translation": "Ты и красавица, и умница.",
          "source": "Tatoeba #2592039 @al_ex_an_der / #2592038 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2592039",
          "cefr_level": "A1",
          "word_slugs": [
            "kluge-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Kluge",
        "nominative_pl": ""
      }
    },
