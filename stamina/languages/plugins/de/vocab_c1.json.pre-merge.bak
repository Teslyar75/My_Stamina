    {
      "slug": "anderthalb-num",
      "lemma": "anderthalb",
      "pos": "num",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7658,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "полтора"
        ],
        "en": [
          "one and a half (1+¹⁄₂), sesqui-"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6207514",
          "text": "Anderthalb Stunden sind neunzig Minuten.",
          "translation": "Полтора часа — это девяносто минут.",
          "source": "Tatoeba #6207514 @Pfirsichbaeumchen / #5472405 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6207514",
          "cefr_level": "A1",
          "word_slugs": [
            "anderthalb-num"
          ]
        },
        {
          "id": "9060836",
          "text": "Er überlebte sie nur anderthalb Jahre.",
          "translation": "Он пережил её всего на полтора года.",
          "source": "Tatoeba #9060836 @carlosalberto / #9060570 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9060836",
          "cefr_level": "A1",
          "word_slugs": [
            "anderthalb-num"
          ]
        },
        {
          "id": "8607179",
          "text": "Tom ist vor anderthalb Jahren gestorben.",
          "translation": "Том умер полтора года назад.",
          "source": "Tatoeba #8607179 @Pfirsichbaeumchen / #5295290 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8607179",
          "cefr_level": "A1",
          "word_slugs": [
            "anderthalb-num"
          ]
        },
        {
          "id": "6627175",
          "text": "Ich lerne seit anderthalb Jahren Türkisch.",
          "translation": "Я учу турецкий полтора года.",
          "source": "Tatoeba #6627175 @ruth_tatoeba / #13143067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6627175",
          "cefr_level": "A1",
          "word_slugs": [
            "anderthalb-num"
          ]
        },
        {
          "id": "13510276",
          "text": "Bis zum Winter sind es noch anderthalb Monate.",
          "translation": "До зимы ещё полтора месяца.",
          "source": "Tatoeba #13510276 @mhr / #13509788 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13510276",
          "cefr_level": "A1",
          "word_slugs": [
            "anderthalb-num"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
