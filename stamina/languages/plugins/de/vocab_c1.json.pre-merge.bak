    {
      "slug": "kürze-noun",
      "lemma": "Kürze",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6157,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "краткость (krátkost)"
        ],
        "en": [
          "brevity",
          "shortness"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "522530",
          "text": "In der Kürze liegt die Würze.",
          "translation": "Краткость — сестра таланта.",
          "source": "Tatoeba #522530 @samueldora / #917458 @ascolto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/522530",
          "cefr_level": "A1",
          "word_slugs": [
            "kürze-noun"
          ]
        },
        {
          "id": "520703",
          "text": "Sie wird in Kürze hier eintreffen.",
          "translation": "Она скоро будет.",
          "source": "Tatoeba #520703 @lilygilder / #12374061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/520703",
          "cefr_level": "A1",
          "word_slugs": [
            "kürze-noun"
          ]
        },
        {
          "id": "1512954",
          "text": "Das Flugzeug wird in Kürze landen.",
          "translation": "Самолёт в скором времени приземлится.",
          "source": "Tatoeba #1512954 @Pfirsichbaeumchen / #11272852 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1512954",
          "cefr_level": "A1",
          "word_slugs": [
            "kürze-noun"
          ]
        },
        {
          "id": "2059870",
          "text": "Tom antwortete mit einem echt britischem Hang zur Kürze.",
          "translation": "Том ответил с подлинно британской краткостью.",
          "source": "Tatoeba #2059870 @al_ex_an_der / #2059868 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2059870",
          "cefr_level": "A1",
          "word_slugs": [
            "kürze-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
