    {
      "slug": "richte-verb",
      "lemma": "richte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5337,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of richten:",
          "first-person singular present",
          "inflection of richten:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9271005",
          "text": "Richte deine Krawatte!",
          "translation": "Поправь галстук.",
          "source": "Tatoeba #9271005 @Pfirsichbaeumchen / #3470530 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9271005",
          "cefr_level": "A1",
          "word_slugs": [
            "richte-verb"
          ]
        },
        {
          "id": "2493702",
          "text": "Richte deiner Familie Grüße aus!",
          "translation": "Передавай привет семье.",
          "source": "Tatoeba #2493702 @Pfirsichbaeumchen / #2493247 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2493702",
          "cefr_level": "A1",
          "word_slugs": [
            "richte-verb"
          ]
        },
        {
          "id": "13743038",
          "text": "Richte ihr Grüße von mir aus!",
          "translation": "Передавай ей привет от меня.",
          "source": "Tatoeba #13743038 @mhr / #13743036 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13743038",
          "cefr_level": "A1",
          "word_slugs": [
            "richte-verb"
          ]
        },
        {
          "id": "757190",
          "text": "Richte die Videokamera auf die Gruppe da!",
          "translation": "Направь камеру на ту группу.",
          "source": "Tatoeba #757190 @Pfirsichbaeumchen / #3516364 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/757190",
          "cefr_level": "A1",
          "word_slugs": [
            "richte-verb"
          ]
        },
        {
          "id": "2109045",
          "text": "Richte Tom aus, dass ich seiner Hilfe nicht bedarf!",
          "translation": "Передай Тому, что я в его помощи не нуждаюсь!",
          "source": "Tatoeba #2109045 @Pfirsichbaeumchen / #3782754 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2109045",
          "cefr_level": "A1",
          "word_slugs": [
            "richte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
