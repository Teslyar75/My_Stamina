    {
      "slug": "hündchen-noun",
      "lemma": "Hündchen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8158,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "щенок"
        ],
        "en": [
          "doggy, puppy"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "3308751",
          "text": "Das Hündchen hat vier Pfötchen.",
          "translation": "У щенка четыре лапки.",
          "source": "Tatoeba #3308751 @al_ex_an_der / #5042600 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3308751",
          "cefr_level": "A1",
          "word_slugs": [
            "hündchen-noun"
          ]
        },
        {
          "id": "11514398",
          "text": "Auf der Straße ist ein Hündchen.",
          "translation": "На дороге собачка.",
          "source": "Tatoeba #11514398 @Pfirsichbaeumchen / #11514394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11514398",
          "cefr_level": "A1",
          "word_slugs": [
            "hündchen-noun"
          ]
        },
        {
          "id": "13734376",
          "text": "Warum folgst du mir wie ein Hündchen? Mach doch was! Lies, zeichne!",
          "translation": "Ну что ты за мной хвостиком ходишь? Иди займись чем-нибудь. Почитай, порисуй.",
          "source": "Tatoeba #13734376 @carlosalberto / #13734323 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13734376",
          "cefr_level": "A1",
          "word_slugs": [
            "hündchen-noun"
          ]
        }
      ],
      "tags": [
