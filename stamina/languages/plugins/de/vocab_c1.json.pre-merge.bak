    {
      "slug": "chinesische-adj",
      "lemma": "chinesische",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7016,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of chinesisch:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of chinesisch:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4654432",
          "text": "Ich kenne chinesische Zeichen.",
          "translation": "Я знаю китайские иероглифы.",
          "source": "Tatoeba #4654432 @AC / #7992116 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4654432",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesische-adj"
          ]
        },
        {
          "id": "2030549",
          "text": "Das ist eine chinesische Firma.",
          "translation": "Это китайская компания.",
          "source": "Tatoeba #2030549 @Pfirsichbaeumchen / #2285980 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2030549",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesische-adj"
          ]
        },
        {
          "id": "3430356",
          "text": "Magst du die chinesische Küche?",
          "translation": "Тебе нравится китайская кухня?",
          "source": "Tatoeba #3430356 @Hikaru / #3511894 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3430356",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesische-adj"
          ]
        },
        {
          "id": "585471",
          "text": "Auldey ist eine chinesische Marke.",
          "translation": "\"Auldey\" — это китайская марка.",
          "source": "Tatoeba #585471 @kroko / #478973 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/585471",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesische-adj"
          ]
        },
        {
          "id": "12313889",
          "text": "Die chinesische Wirtschaft wächst schnell.",
          "translation": "Китайская экономика быстро растёт.",
          "source": "Tatoeba #12313889 @Augustus / #12720849 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12313889",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesische-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
