      "gender": null,
      "examples": [
        {
          "id": "11126411",
          "text": "Wo sind meine Ringe?",
          "translation": "Где мои кольца?",
          "source": "Tatoeba #11126411 @carlosalberto / #11126407 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11126411",
          "cefr_level": "A1",
          "word_slugs": [
            "ringe-noun"
          ]
        },
        {
          "id": "11580229",
          "text": "Der Saturn hat Ringe.",
          "translation": "У Сатурна есть кольца.",
          "source": "Tatoeba #11580229 @Pfirsichbaeumchen / #3123886 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11580229",
          "cefr_level": "A1",
          "word_slugs": [
            "ringe-noun"
          ]
        },
        {
          "id": "9995721",
          "text": "Saturn hat schöne Ringe.",
          "translation": "У Сатурна красивые кольца.",
          "source": "Tatoeba #9995721 @carlosalberto / #9995728 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9995721",
          "cefr_level": "A1",
          "word_slugs": [
            "ringe-noun"
          ]
        },
        {
          "id": "9175975",
          "text": "Meine Freundin liebt Ringe.",
          "translation": "Моя девушка любит кольца.",
          "source": "Tatoeba #9175975 @carlosalberto / #9175978 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9175975",
          "cefr_level": "A1",
          "word_slugs": [
            "ringe-noun"
          ]
        },
        {
          "id": "1267196",
          "text": "Du hast Ringe unter den Augen.",
          "translation": "У тебя круги под глазами.",
          "source": "Tatoeba #1267196 @Esperantostern / #3492939 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1267196",
          "cefr_level": "A1",
          "word_slugs": [
            "ringe-noun"
          ]
        }
      ],
