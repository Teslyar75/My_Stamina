    {
      "slug": "verbirgt-verb",
      "lemma": "verbirgt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9363,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular present of verbergen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2665065",
          "text": "Der Igel verbirgt seinen Kopf.",
          "translation": "Ёж прячет свою голову.",
          "source": "Tatoeba #2665065 @al_ex_an_der / #2665061 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2665065",
          "cefr_level": "A1",
          "word_slugs": [
            "verbirgt-verb"
          ]
        },
        {
          "id": "2262282",
          "text": "Tom verbirgt ein schreckliches Geheimnis.",
          "translation": "Том скрывает ужасную тайну.",
          "source": "Tatoeba #2262282 @Zaghawa / #6107708 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2262282",
          "cefr_level": "A1",
          "word_slugs": [
            "verbirgt-verb"
          ]
        },
        {
          "id": "3173373",
          "text": "Tom verbirgt die Wahrheit vor uns.",
          "translation": "Том скрывает от нас правду.",
          "source": "Tatoeba #3173373 @dinkel_girl / #3175229 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3173373",
          "cefr_level": "A1",
          "word_slugs": [
            "verbirgt-verb"
          ]
        },
        {
          "id": "2439029",
          "text": "In beiden Definitionen verbirgt sich ein Widerspruch.",
          "translation": "В обоих определениях имеется скрытое противоречие.",
          "source": "Tatoeba #2439029 @al_ex_an_der / #2439033 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2439029",
          "cefr_level": "A1",
          "word_slugs": [
            "verbirgt-verb"
          ]
        },
        {
          "id": "2463162",
          "text": "Er sagt nicht das, was er denkt. Er verbirgt etwas.",
          "translation": "Он не говорит того, что думает. Он что-то скрывает.",
          "source": "Tatoeba #2463162 @al_ex_an_der / #2463160 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2463162",
          "cefr_level": "A1",
          "word_slugs": [
            "verbirgt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
