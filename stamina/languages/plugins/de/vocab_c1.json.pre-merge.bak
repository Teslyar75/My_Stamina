    {
      "slug": "gemäss-adj",
      "lemma": "gemäß",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7671,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "соответствующий"
        ],
        "en": [
          "Switzerland and Liechtenstein standard spelling of gemäß"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1561828",
          "text": "Wir haben ihn gemäß der Regel bestraft.",
          "translation": "Мы наказали его согласно правилу.",
          "source": "Tatoeba #1561828 @Zaghawa / #3119160 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1561828",
          "cefr_level": "A1",
          "word_slugs": [
            "gemäss-adj"
          ]
        },
        {
          "id": "408450",
          "text": "Wir bauen Ihr Haus gemäß Ihren Wünschen.",
          "translation": "Мы строим Ваш дом согласно Вашим пожеланиям.",
          "source": "Tatoeba #408450 @xtofu80 / #3119156 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/408450",
          "cefr_level": "A1",
          "word_slugs": [
            "gemäss-adj"
          ]
        },
        {
          "id": "3063282",
          "text": "Ich habe den Satz gemäß Ihrer Empfehlung geändert.",
          "translation": "Я изменил предложение в соответствии с Вашей рекомендацией.",
          "source": "Tatoeba #3063282 @al_ex_an_der / #3063290 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3063282",
          "cefr_level": "A1",
          "word_slugs": [
