        ],
        "en": [
          "warmth",
          "heat"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2133130",
          "text": "Ich will Wärme!",
          "translation": "Я хочу тепла!",
          "source": "Tatoeba #2133130 @Zaghawa / #6594251 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2133130",
          "cefr_level": "A1",
          "word_slugs": [
            "wärme-noun"
          ]
        },
        {
          "id": "1438359",
          "text": "Milch wird durch Wärme sauer.",
          "translation": "Молоко в жару киснет.",
          "source": "Tatoeba #1438359 @Manfredo / #13606908 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1438359",
          "cefr_level": "A1",
          "word_slugs": [
            "wärme-noun"
          ]
        },
        {
          "id": "1536690",
          "text": "Die Sonne gibt Licht und Wärme.",
          "translation": "Солнце даёт свет и тепло.",
          "source": "Tatoeba #1536690 @samueldora / #2893135 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1536690",
          "cefr_level": "A1",
          "word_slugs": [
            "wärme-noun"
          ]
        },
        {
          "id": "2311011",
          "text": "Ich genieße die Wärme der Sonnenstrahlen.",
          "translation": "Я наслаждаюсь теплом солнечных лучей.",
          "source": "Tatoeba #2311011 @al_ex_an_der / #2310991 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2311011",
          "cefr_level": "A1",
          "word_slugs": [
            "wärme-noun"
          ]
        },
        {
          "id": "12802306",
          "text": "Die Kälte lehrt, die Wärme zu schätzen.",
          "translation": "Холод учит ценить тепло.",
          "source": "Tatoeba #12802306 @mhr / #11292296 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12802306",
          "cefr_level": "A1",
          "word_slugs": [
            "wärme-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
