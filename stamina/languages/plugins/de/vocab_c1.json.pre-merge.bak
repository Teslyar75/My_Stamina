      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7479,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "пошлина"
        ],
        "en": [
          "inch (unit of length equal to 2.54 centimeters)",
          "any of a number of historical German units of length generally ranging between about 2 and 3 centimeters"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "7371680",
          "text": "Der Zoll wird die Fracht beschlagnahmen.",
          "translation": "Таможня арестует груз.",
          "source": "Tatoeba #7371680 @sigavax / #7371684 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7371680",
          "cefr_level": "A1",
          "word_slugs": [
            "zoll-noun"
          ]
        },
        {
          "id": "11885254",
          "text": "Er ist drei Zoll größer als ich.",
          "translation": "Он выше меня на три дюйма.",
          "source": "Tatoeba #11885254 @mhr / #862232 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11885254",
          "cefr_level": "A1",
          "word_slugs": [
            "zoll-noun"
          ]
        },
        {
          "id": "11885257",
          "text": "Sie ist drei Zoll größer als ich.",
          "translation": "Она на три дюйма выше меня.",
          "source": "Tatoeba #11885257 @mhr / #12415330 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11885257",
          "cefr_level": "A1",
          "word_slugs": [
            "zoll-noun"
          ]
        },
        {
          "id": "12582311",
          "text": "Ich komme mit euren Zoll und Yard nicht zurecht.",
          "translation": "Я не разбираюсь в этих ваших дюймах и ярдах.",
          "source": "Tatoeba #12582311 @Waldelfe / #12582240 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12582311",
          "cefr_level": "A1",
          "word_slugs": [
            "zoll-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
