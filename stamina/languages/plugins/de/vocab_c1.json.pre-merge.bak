    {
      "slug": "gelangt-verb",
      "lemma": "gelangt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7844,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gelangen:",
          "third-person singular present",
          "inflection of gelangen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13764660",
          "text": "Dorthin gelangt kein Sonnenlicht.",
          "translation": "Туда не доходит солнечный свет.",
          "source": "Tatoeba #13764660 @mhr / #13764574 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13764660",
          "cefr_level": "A1",
          "word_slugs": [
            "gelangt-verb"
          ]
        },
        {
          "id": "3588889",
          "text": "Wie bist du in mein Zimmer gelangt?",
          "translation": "Как ты попал в мою комнату?",
          "source": "Tatoeba #3588889 @sigavax / #3588763 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3588889",
          "cefr_level": "A1",
          "word_slugs": [
            "gelangt-verb"
          ]
        },
        {
          "id": "4258807",
          "text": "Wie bist du zu diesem Schluss gelangt?",
          "translation": "Как ты пришёл к такому выводу?",
          "source": "Tatoeba #4258807 @Pfirsichbaeumchen / #4257814 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4258807",
          "cefr_level": "A1",
          "word_slugs": [
            "gelangt-verb"
          ]
        },
        {
          "id": "10077427",
          "text": "Dorthin gelangt man nur über den Seeweg.",
          "translation": "Туда можно добраться только морем.",
          "source": "Tatoeba #10077427 @sakslane / #10074279 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10077427",
          "cefr_level": "A1",
          "word_slugs": [
            "gelangt-verb"
          ]
        },
        {
          "id": "1589946",
          "text": "Weißt du, wie man zu Toms Haus gelangt?",
          "translation": "Ты знаешь, как добраться до дома Тома?",
          "source": "Tatoeba #1589946 @Grim_fandango / #2852192 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1589946",
          "cefr_level": "A1",
          "word_slugs": [
            "gelangt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
