    {
      "slug": "baten-verb",
      "lemma": "baten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9185,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person plural preterite of bitten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "879521",
          "text": "Sie baten um eine Gehaltserhöhung.",
          "translation": "Они просили повысить зарплату.",
          "source": "Tatoeba #879521 @Pfirsichbaeumchen / #895105 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/879521",
          "cefr_level": "A1",
          "word_slugs": [
            "baten-verb"
          ]
        },
        {
          "id": "7855136",
          "text": "Ich tat, worum Sie mich baten.",
          "translation": "Я сделал то, о чём вы меня просили.",
          "source": "Tatoeba #7855136 @Pfirsichbaeumchen / #7854898 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7855136",
          "cefr_level": "A1",
          "word_slugs": [
            "baten-verb"
          ]
        },
        {
          "id": "1908137",
          "text": "Die Inselbewohner baten uns um Hilfe.",
          "translation": "Жители острова попросили нас о помощи.",
          "source": "Tatoeba #1908137 @Tamy / #11258304 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1908137",
          "cefr_level": "A1",
          "word_slugs": [
            "baten-verb"
          ]
        },
        {
          "id": "2340354",
          "text": "Sie baten Maria, auf die Kinder aufzupassen.",
