          "galley proof"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "12466531",
          "text": "Tom hat eine Fahne.",
          "translation": "От Тома несёт выпивкой.",
          "source": "Tatoeba #12466531 @Waldelfe / #13933627 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12466531",
          "cefr_level": "A1",
          "word_slugs": [
            "fahne-noun"
          ]
        },
        {
          "id": "6932852",
          "text": "Er hatte eine Fahne.",
          "translation": "От него несло спиртным.",
          "source": "Tatoeba #6932852 @Pfirsichbaeumchen / #5390950 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6932852",
          "cefr_level": "A1",
          "word_slugs": [
            "fahne-noun"
          ]
        },
        {
          "id": "12089202",
          "text": "Die Fahne ist schwarz.",
          "translation": "Флаг чёрный.",
          "source": "Tatoeba #12089202 @Augustus / #8313072 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12089202",
          "cefr_level": "A1",
          "word_slugs": [
            "fahne-noun"
          ]
        },
        {
          "id": "12900660",
          "text": "Die Fahne weht am Mast.",
          "translation": "Флаг развевается на флагштоке.",
          "source": "Tatoeba #12900660 @Waldelfe / #10253890 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12900660",
          "cefr_level": "A1",
          "word_slugs": [
            "fahne-noun"
          ]
        },
        {
          "id": "442146",
          "text": "Diese Fahne ist sehr schön.",
          "translation": "Этот флаг очень красивый.",
          "source": "Tatoeba #442146 @jerom / #1877937 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/442146",
          "cefr_level": "A1",
          "word_slugs": [
