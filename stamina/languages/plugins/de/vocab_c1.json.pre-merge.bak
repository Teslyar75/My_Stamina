    {
      "slug": "nördlich-adj",
      "lemma": "nördlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7618,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "северный"
        ],
        "en": [
          "north, northern"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6817233",
          "text": "Freiburg liegt nördlich von Basel.",
          "translation": "Фрайбург находится к северу от Базеля.",
          "source": "Tatoeba #6817233 @felix63 / #11744286 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6817233",
          "cefr_level": "A1",
          "word_slugs": [
            "nördlich-adj"
          ]
        },
        {
          "id": "13490005",
          "text": "Das Nildelta liegt nördlich von Kairo.",
          "translation": "Дельта Нила расположена к северу от Каира.",
          "source": "Tatoeba #13490005 @mhr / #13490007 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13490005",
          "cefr_level": "A1",
          "word_slugs": [
            "nördlich-adj"
          ]
        },
        {
          "id": "8880054",
          "text": "Schottland ist ein Land nördlich von England.",
          "translation": "Шотландия – страна к северу от Англии.",
          "source": "Tatoeba #8880054 @carlosalberto / #8880058 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8880054",
          "cefr_level": "A1",
          "word_slugs": [
            "nördlich-adj"
          ]
        },
        {
          "id": "1921238",
          "text": "Die Stadt liegt fünfzig Meilen nördlich von London.",
          "translation": "Город расположен в пятидесяти милях севернее Лондона.",
          "source": "Tatoeba #1921238 @Tamy / #13276320 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1921238",
          "cefr_level": "A1",
          "word_slugs": [
            "nördlich-adj"
          ]
        },
        {
          "id": "2456453",
          "text": "Die nächste Tankstelle befindet sich nur hundert Kilometer nördlich.",
          "translation": "Ближайшая автозаправочная станция находится всего в сотне километров к северу.",
          "source": "Tatoeba #2456453 @al_ex_an_der / #2456459 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2456453",
          "cefr_level": "A1",
          "word_slugs": [
            "nördlich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der nördlich",
        "nominative_pl": ""
      }
    },
