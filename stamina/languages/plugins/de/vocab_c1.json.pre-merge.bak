          "source": "Tatoeba #2973404 @al_ex_an_der / #2973406 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2973404",
          "cefr_level": "A1",
          "word_slugs": [
