          "cefr_level": "A1",
          "word_slugs": [
            "mississippi-name"
          ]
        },
        {
          "id": "435587",
          "text": "Der Mississippi ist der längste Fluss in den Vereinigten Staaten.",
          "translation": "Миссисипи — самая длинная река в Соединённых Штатах.",
          "source": "Tatoeba #435587 @jerom / #435593 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/435587",
          "cefr_level": "A1",
          "word_slugs": [
            "mississippi-name"
          ]
        }
