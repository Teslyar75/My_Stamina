    {
      "slug": "knien-noun",
      "lemma": "Knien",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6514,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Knie"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1444732",
          "text": "Das Wasser reichte mir bis zu den Knien.",
          "translation": "Вода дошла мне до колен.",
          "source": "Tatoeba #1444732 @hectorM / #5360634 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1444732",
          "cefr_level": "A1",
          "word_slugs": [
            "knien-noun"
          ]
        },
        {
          "id": "12003936",
          "text": "Sie sitzt bei ihrem Vater auf den Knien.",
          "translation": "Она сидит у отца на коленях.",
          "source": "Tatoeba #12003936 @Pfirsichbaeumchen / #12003905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12003936",
          "cefr_level": "A1",
          "word_slugs": [
            "knien-noun"
          ]
        },
        {
          "id": "4463158",
          "text": "Die sind nur deshalb groß, weil wir auf den Knien liegen.",
          "translation": "Они велики только потому, что мы стоим на коленях.",
          "source": "Tatoeba #4463158 @Pfirsichbaeumchen / #4463151 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4463158",
          "cefr_level": "A1",
          "word_slugs": [
            "knien-noun"
          ]
        },
        {
          "id": "4059444",
          "text": "Ich bin bereit, dich auf den Knien um Verzeihung zu bitten.",
          "translation": "Я готов на коленях молить тебя о прощении.",
          "source": "Tatoeba #4059444 @Esperantostern / #4064244 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4059444",
          "cefr_level": "A1",
          "word_slugs": [
            "knien-noun"
          ]
        },
        {
          "id": "8470900",
          "text": "Unterwegs gab es Stellen, wo der Schnee bis zu den Knien reichte.",
          "translation": "По пути встречались места, где снег был по колено.",
          "source": "Tatoeba #8470900 @Inego / #8470903 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8470900",
          "cefr_level": "A1",
          "word_slugs": [
            "knien-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
