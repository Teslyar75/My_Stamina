          "word_slugs": [
            "befolgt-verb"
          ]
        },
        {
          "id": "3057960",
          "text": "Hast du Toms Rat befolgt?",
          "translation": "Ты последовал совету Тома?",
          "source": "Tatoeba #3057960 @Manfredo / #3058149 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3057960",
