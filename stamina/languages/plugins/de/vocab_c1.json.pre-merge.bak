    {
      "slug": "verhindert-verb",
      "lemma": "verhindert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5378,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verhindern:",
          "third-person singular present",
          "inflection of verhindern:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2650333",
          "text": "Tom ist dienstlich verhindert.",
          "translation": "Тома задержали служебные дела.",
          "source": "Tatoeba #2650333 @Olya / #2650335 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650333",
          "cefr_level": "A1",
          "word_slugs": [
            "verhindert-verb"
          ]
        },
        {
          "id": "13813349",
          "text": "Der Nachtfrost verhindert einstweilen ein Hochwasser.",
          "translation": "Ночной минус пока сдерживает половодье.",
          "source": "Tatoeba #13813349 @mhr / #13813238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13813349",
          "cefr_level": "A1",
          "word_slugs": [
            "verhindert-verb"
          ]
        },
        {
          "id": "13813339",
          "text": "Der leichte Nachtfrost verhindert eine schnelle Schneeschmelze.",
          "translation": "Небольшой ночной минус сдерживает быстрое таяние снега.",
          "source": "Tatoeba #13813339 @mhr / #13813239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13813339",
          "cefr_level": "A1",
          "word_slugs": [
            "verhindert-verb"
          ]
        },
        {
          "id": "13813340",
          "text": "Ein leichter Nachtfrost verhindert eine schnelle Schneeschmelze.",
          "translation": "Небольшой ночной минус сдерживает быстрое таяние снега.",
          "source": "Tatoeba #13813340 @mhr / #13813239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13813340",
          "cefr_level": "A1",
          "word_slugs": [
            "verhindert-verb"
          ]
        },
        {
          "id": "13813342",
          "text": "Der leichte Nachtfrost verhindert ein schnelles Schmelzen des Schnees.",
          "translation": "Небольшой ночной минус сдерживает быстрое таяние снега.",
          "source": "Tatoeba #13813342 @mhr / #13813239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13813342",
          "cefr_level": "A1",
          "word_slugs": [
            "verhindert-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
