      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "rabbi (Jewish religious scholar)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1494874",
          "text": "Tom ist Rabbi.",
          "translation": "Том - раввин.",
          "source": "Tatoeba #1494874 @al_ex_an_der / #3143447 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1494874",
