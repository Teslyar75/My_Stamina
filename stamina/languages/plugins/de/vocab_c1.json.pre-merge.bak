          ]
        },
        {
          "id": "10046418",
          "text": "Wir müssen die Regeln befolgen.",
          "translation": "Мы должны соблюдать правила.",
          "source": "Tatoeba #10046418 @Melang / #1415296 @axxeny (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10046418",
          "cefr_level": "A1",
          "word_slugs": [
            "befolgen-verb"
          ]
        },
        {
          "id": "1944541",
          "text": "Tom muss unsere Regeln befolgen.",
          "translation": "Том должен следовать нашим правилам.",
          "source": "Tatoeba #1944541 @Pfirsichbaeumchen / #5627229 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1944541",
          "cefr_level": "A1",
          "word_slugs": [
            "befolgen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
