    {
      "slug": "aufgestellt-verb",
      "lemma": "aufgestellt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8267,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of aufstellen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5989958",
          "text": "Sie haben eine Liste aufgestellt.",
          "translation": "Они составили список.",
          "source": "Tatoeba #5989958 @dasbeispielholz / #6640306 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5989958",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgestellt-verb"
          ]
        },
        {
          "id": "8827804",
          "text": "Wir haben einen Tätigkeitsplan aufgestellt.",
          "translation": "Мы наметили план действий.",
          "source": "Tatoeba #8827804 @Pfirsichbaeumchen / #4826718 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8827804",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgestellt-verb"
          ]
        },
        {
          "id": "368327",
          "text": "Sie hat einen neuen Weltrekord aufgestellt.",
          "translation": "Она установила новый мировой рекорд.",
          "source": "Tatoeba #368327 @Wolf / #2962218 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/368327",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgestellt-verb"
          ]
        },
        {
          "id": "5679602",
          "text": "Habt ihr euren Christbaum schon aufgestellt?",
          "translation": "Вы уже установили ёлку?",
          "source": "Tatoeba #5679602 @brauchinet / #5679613 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5679602",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgestellt-verb"
          ]
        },
        {
          "id": "1312595",
          "text": "Habt ihr schon den Weihnachtsbaum aufgestellt?",
          "translation": "Вы уже поставили ёлку?",
          "source": "Tatoeba #1312595 @Pfirsichbaeumchen / #10177639 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1312595",
          "cefr_level": "A1",
