    {
      "slug": "herzschlag-noun",
      "lemma": "Herzschlag",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7127,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "heartbeat",
          "heart attack"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2052593",
          "text": "Ich lausche deinem Herzschlag.",
          "translation": "Я слушаю стук твоего сердца.",
          "source": "Tatoeba #2052593 @al_ex_an_der / #2052591 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2052593",
          "cefr_level": "A1",
          "word_slugs": [
            "herzschlag-noun"
          ]
        },
        {
          "id": "6832801",
          "text": "Meine Herzschlag wird schneller.",
          "translation": "Моё сердце стало биться быстрее.",
