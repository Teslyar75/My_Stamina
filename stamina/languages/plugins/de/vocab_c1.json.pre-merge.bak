      "gender": null,
      "examples": [
        {
          "id": "2217877",
          "text": "Das ist ein Alptraum.",
          "translation": "Это плохой сон.",
          "source": "Tatoeba #2217877 @Pfirsichbaeumchen / #3030903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2217877",
          "cefr_level": "A1",
          "word_slugs": [
            "alptraum-noun"
          ]
        },
        {
          "id": "4908754",
          "text": "Der Alptraum ist endlich vorbei.",
          "translation": "Наконец кошмар закончился.",
          "source": "Tatoeba #4908754 @Pfirsichbaeumchen / #4905871 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4908754",
          "cefr_level": "A1",
          "word_slugs": [
