          ]
        },
        {
          "id": "9125362",
          "text": "Viren springen von einem Wirt zum nächsten über.",
          "translation": "Вирусы переходят от одного переносчика к другому.",
          "source": "Tatoeba #9125362 @Pfirsichbaeumchen / #8157848 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9125362",
