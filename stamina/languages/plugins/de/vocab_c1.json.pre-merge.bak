    {
      "slug": "grösster-adj",
      "lemma": "größter",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6531,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gross:",
          "strong/mixed nominative masculine singular superlative degree",
          "inflection of gross:",
          "strong genitive/dative feminine singular superlative degree"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2152066",
          "text": "Das ist mein größter Wunsch.",
          "translation": "Это моё самое большое желание.",
          "source": "Tatoeba #2152066 @rirarosenrot / #10235925 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2152066",
          "cefr_level": "A1",
          "word_slugs": [
            "grösster-adj"
          ]
        },
        {
          "id": "3707816",
          "text": "Mein Sohn ist mein größter Kopfschmerz.",
          "translation": "Мой сын - моя самая большая головная боль.",
          "source": "Tatoeba #3707816 @Pfirsichbaeumchen / #2844210 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3707816",
          "cefr_level": "A1",
          "word_slugs": [
            "grösster-adj"
          ]
        },
        {
          "id": "2343745",
          "text": "Mein größter Wunsch: „Schreibt möglichst einfach!“",
          "translation": "Моё самое большое желание: \"Пишите как можно проще!\"",
          "source": "Tatoeba #2343745 @al_ex_an_der / #2343739 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2343745",
          "cefr_level": "A1",
          "word_slugs": [
            "grösster-adj"
          ]
        },
        {
          "id": "2414381",
          "text": "Oft ist der Mensch sein größter Feind.",
          "translation": "Часто человек сам себе злейший враг.",
          "source": "Tatoeba #2414381 @Esperantostern / #3281119 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2414381",
          "cefr_level": "A1",
          "word_slugs": [
            "grösster-adj"
          ]
        }
      ],
