          "cefr_level": "A1",
          "word_slugs": [
            "hauptsächlich-adv"
          ]
        },
        {
          "id": "12558347",
          "text": "Hauptsächlich übersetze ich aus dem Französischen.",
          "translation": "Я в основном перевожу с французского.",
          "source": "Tatoeba #12558347 @mhr / #12558242 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12558347",
          "cefr_level": "A1",
          "word_slugs": [
            "hauptsächlich-adv"
          ]
        },
        {
          "id": "12558349",
          "text": "Ich übersetze hauptsächlich aus dem Französischen.",
          "translation": "Я в основном перевожу с французского.",
          "source": "Tatoeba #12558349 @mhr / #12558242 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12558349",
          "cefr_level": "A1",
          "word_slugs": [
            "hauptsächlich-adv"
          ]
        },
        {
          "id": "2095576",
          "text": "Diese Briefe sind hauptsächlich von meiner Mutter.",
          "translation": "Эти письма в основном от моей матери.",
          "source": "Tatoeba #2095576 @Esperantostern / #1521056 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2095576",
          "cefr_level": "A1",
          "word_slugs": [
            "hauptsächlich-adv"
          ]
        },
        {
          "id": "13064554",
          "text": "Braunbären ernähren sich hauptsächlich von pflanzlicher Kost.",
          "translation": "Бурые медведи в основном питаются растительной пищей.",
          "source": "Tatoeba #13064554 @mhr / #13064387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13064554",
          "cefr_level": "A1",
          "word_slugs": [
            "hauptsächlich-adv"
          ]
        }
