    {
      "slug": "kämen-verb",
      "lemma": "kämen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7589,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person plural subjunctive II of kommen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3474514",
          "text": "Tom sagte, Sie kämen nicht.",
          "translation": "Том сказал, что вы не придёте.",
          "source": "Tatoeba #3474514 @Pfirsichbaeumchen / #3473029 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3474514",
          "cefr_level": "A1",
          "word_slugs": [
            "kämen-verb"
          ]
        },
        {
          "id": "7885057",
          "text": "Sie sagten, sie kämen später.",
          "translation": "Они сказали, что опоздают.",
          "source": "Tatoeba #7885057 @Pfirsichbaeumchen / #7882650 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7885057",
          "cefr_level": "A1",
          "word_slugs": [
            "kämen-verb"
          ]
        },
        {
          "id": "12264908",
          "text": "Ich dachte, Sie kämen allein.",
          "translation": "Я думал, Вы придёте одна.",
          "source": "Tatoeba #12264908 @Pfirsichbaeumchen / #12264903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12264908",
          "cefr_level": "A1",
          "word_slugs": [
            "kämen-verb"
          ]
        },
        {
          "id": "6842896",
          "text": "Ich hätte nicht gedacht, dass Sie kämen.",
          "translation": "Я не думал, что вы придёте.",
          "source": "Tatoeba #6842896 @Pfirsichbaeumchen / #2329465 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6842896",
          "cefr_level": "A1",
          "word_slugs": [
            "kämen-verb"
          ]
        },
        {
          "id": "2090784",
          "text": "Ich hätte es gern, wenn Sie mit uns kämen.",
          "translation": "Я хотел бы, чтобы Вы пошли вместе с нами.",
          "source": "Tatoeba #2090784 @Pfirsichbaeumchen / #2085680 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2090784",
          "cefr_level": "A1",
          "word_slugs": [
            "kämen-verb"
          ]
        }
      ],
