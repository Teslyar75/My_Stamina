    {
      "slug": "abgrund-noun",
      "lemma": "Abgrund",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8405,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "abyss, precipice"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2337148",
          "text": "Sie fiel in einen Abgrund.",
          "translation": "Она упала в пропасть.",
          "source": "Tatoeba #2337148 @freddy1 / #5615198 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2337148",
          "cefr_level": "A1",
          "word_slugs": [
            "abgrund-noun"
          ]
        },
        {
          "id": "2404330",
          "text": "Jeder Mensch ist ein Abgrund.",
          "translation": "Каждый человек — это бездна.",
          "source": "Tatoeba #2404330 @Esperantostern / #5615197 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2404330",
          "cefr_level": "A1",
          "word_slugs": [
            "abgrund-noun"
          ]
        },
        {
          "id": "2186429",
          "text": "Ein bodenloser Abgrund wird dich verschlingen.",
          "translation": "Тебя поглотит бездонная пропасть.",
          "source": "Tatoeba #2186429 @al_ex_an_der / #5615200 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2186429",
          "cefr_level": "A1",
          "word_slugs": [
            "abgrund-noun"
          ]
        },
        {
          "id": "2493262",
          "text": "Der Abgrund des Meeres sog mich in die Tiefe.",
          "translation": "Морская бездна затягивала меня всё глубже и глубже.",
          "source": "Tatoeba #2493262 @al_ex_an_der / #2493254 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2493262",
          "cefr_level": "A1",
          "word_slugs": [
            "abgrund-noun"
          ]
        },
        {
          "id": "3297369",
          "text": "Ein Kleinbus mit 18 Personen an Bord stürzte in Dagestan in einen Abgrund.",
          "translation": "В Дагестане в пропасть рухнул микроавтобус, в котором находились восемнадцать человек.",
          "source": "Tatoeba #3297369 @Trinkschokolade / #3297355 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3297369",
          "cefr_level": "A1",
          "word_slugs": [
            "abgrund-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "zeichnungen-noun",
      "lemma": "Zeichnungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8406,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Zeichnung"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5935147",
          "text": "Diese Zeichnungen sind für Maria.",
          "translation": "Эти рисунки для Мэри.",
          "source": "Tatoeba #5935147 @Pfirsichbaeumchen / #5461991 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5935147",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnungen-noun"
          ]
        },
        {
          "id": "2854714",
          "text": "Seine Zeichnungen hingen an der Wand.",
          "translation": "Его рисунки висели на стене.",
          "source": "Tatoeba #2854714 @alik_farber / #2308376 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2854714",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnungen-noun"
          ]
        },
        {
          "id": "12722526",
          "text": "Das sind die Zeichnungen meines Sohnes.",
          "translation": "Это рисунки моего сына.",
          "source": "Tatoeba #12722526 @mhr / #12722512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12722526",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnungen-noun"
          ]
        },
        {
          "id": "12722532",
          "text": "Das sind die Zeichnungen meiner Tochter.",
          "translation": "Это рисунки моей дочери.",
          "source": "Tatoeba #12722532 @mhr / #12722513 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12722532",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnungen-noun"
          ]
        },
        {
          "id": "5952422",
          "text": "Für wen sind diese Zeichnungen? Für Maria?",
          "translation": "Для кого эти рисунки? Для Мэри?",
          "source": "Tatoeba #5952422 @Pfirsichbaeumchen / #5461989 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5952422",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnungen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "sinken-verb",
      "lemma": "sinken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8407,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "тонуть",
          "спускаться"
        ],
        "en": [
          "to sink; to submerge; to set; to fall from the sky",
          "to fall; to drop; to decline"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12737641",
          "text": "Schiffe können sinken.",
          "translation": "Корабли могут затонуть.",
          "source": "Tatoeba #12737641 @Waldelfe / #12738281 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12737641",
          "cefr_level": "A1",
          "word_slugs": [
            "sinken-verb"
          ]
        },
        {
          "id": "579334",
          "text": "Das Schiff wird sinken!",
          "translation": "Корабль потонет!",
          "source": "Tatoeba #579334 @jakov / #378103 @Dorenda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/579334",
          "cefr_level": "A1",
          "word_slugs": [
            "sinken-verb"
          ]
        },
        {
          "id": "7234297",
          "text": "Tom fing an zu sinken.",
          "translation": "Том начал тонуть.",
          "source": "Tatoeba #7234297 @Pfirsichbaeumchen / #7221938 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7234297",
          "cefr_level": "A1",
          "word_slugs": [
            "sinken-verb"
          ]
        },
        {
          "id": "10967399",
          "text": "Das Boot wird nicht sinken.",
          "translation": "Корабль не утонет.",
          "source": "Tatoeba #10967399 @p0wcr / #10968861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967399",
          "cefr_level": "A1",
          "word_slugs": [
            "sinken-verb"
          ]
        },
        {
          "id": "3680089",
          "text": "Man darf den Mut nicht sinken lassen.",
          "translation": "Нельзя падать духом.",
          "source": "Tatoeba #3680089 @freddy1 / #3680090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3680089",
          "cefr_level": "A1",
          "word_slugs": [
            "sinken-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
