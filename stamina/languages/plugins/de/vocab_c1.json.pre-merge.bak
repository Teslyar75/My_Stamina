        {
          "id": "13981378",
          "text": "Die FISA ist die Internationale Automobilsportföderation.",
          "translation": "FISA — это Международная федерация автоспорта.",
          "source": "Tatoeba #13981378 @mhr / #13981362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13981378",
          "cefr_level": "A1",
          "word_slugs": [
            "internationale-noun"
          ]
        },
        {
          "id": "2718907",
          "text": "Am 21. März ist der Internationale Tag gegen Rassismus.",
          "translation": "21 марта - Международный день борьбы с расизмом.",
          "source": "Tatoeba #2718907 @Pfirsichbaeumchen / #2983849 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2718907",
          "cefr_level": "A1",
          "word_slugs": [
            "internationale-noun"
          ]
        },
        {
          "id": "12898986",
          "text": "Der 21. Februar ist der Internationale Tag der Muttersprache.",
          "translation": "21 февраля - Международный день родного языка.",
          "source": "Tatoeba #12898986 @mhr / #12898778 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12898986",
          "cefr_level": "A1",
          "word_slugs": [
            "internationale-noun"
          ]
        },
        {
          "id": "13803804",
          "text": "Heute ist der Internationale Tag zur Bekämpfung von Islamophobie.",
          "translation": "Сегодня международный день борьбы с исламофобией.",
          "source": "Tatoeba #13803804 @mhr / #13803800 @TATAR1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13803804",
          "cefr_level": "A1",
          "word_slugs": [
            "internationale-noun"
          ]
        },
        {
          "id": "13803805",
          "text": "Heute ist der Internationale Tag zur Bekämpfung von Islamfeindlichkeit.",
          "translation": "Сегодня международный день борьбы с исламофобией.",
          "source": "Tatoeba #13803805 @mhr / #13803800 @TATAR1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13803805",
          "cefr_level": "A1",
          "word_slugs": [
            "internationale-noun"
          ]
        }
