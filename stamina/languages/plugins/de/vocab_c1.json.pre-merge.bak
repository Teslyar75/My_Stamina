    {
      "slug": "werkzeug-noun",
      "lemma": "Werkzeug",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5026,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "tool",
          "tools"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2343062",
          "text": "Wir brauchen Werkzeug.",
          "translation": "Нам нужен инструмент.",
          "source": "Tatoeba #2343062 @Espi / #6954281 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2343062",
          "cefr_level": "A1",
          "word_slugs": [
            "werkzeug-noun"
          ]
        },
        {
          "id": "7428407",
          "text": "Ich habe mir neues Werkzeug gekauft.",
          "translation": "Я купил себе новые инструменты.",
          "source": "Tatoeba #7428407 @brauchinet / #9227093 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7428407",
          "cefr_level": "A1",
          "word_slugs": [
            "werkzeug-noun"
          ]
        },
        {
          "id": "13614043",
          "text": "Dieses Werkzeug wurde von Tom erfunden.",
          "translation": "Этот инструмент изобрёл Том.",
          "source": "Tatoeba #13614043 @Vortarulo / #13614055 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13614043",
          "cefr_level": "A1",
          "word_slugs": [
            "werkzeug-noun"
          ]
        },
        {
          "id": "10311051",
          "text": "Jede Arbeit braucht ihr eigenes Werkzeug.",
          "translation": "Для каждой работы нужен свой инструмент.",
          "source": "Tatoeba #10311051 @Pfirsichbaeumchen / #10311052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10311051",
          "cefr_level": "A1",
          "word_slugs": [
            "werkzeug-noun"
          ]
        },
        {
          "id": "1443751",
          "text": "Ein schlechter Handwerker beschuldigt sein Werkzeug.",
          "translation": "Плохому танцору ноги мешают.",
          "source": "Tatoeba #1443751 @Esperantostern / #3589476 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1443751",
          "cefr_level": "A1",
          "word_slugs": [
            "werkzeug-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
