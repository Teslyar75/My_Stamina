          ]
        },
        {
          "id": "1528343",
          "text": "Was kostet der Eintritt bitte?",
          "translation": "Будьте добры, сколько стоит вход?",
          "source": "Tatoeba #1528343 @Pfirsichbaeumchen / #7007755 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1528343",
          "cefr_level": "A1",
          "word_slugs": [
