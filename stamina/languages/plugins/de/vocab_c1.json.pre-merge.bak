    {
      "slug": "günstig-adj",
      "lemma": "günstig",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8908,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "недорого",
          "дёшево"
        ],
        "en": [
          "favourable, propitious, opportune",
          "convenient, expedient",
          "good value, cheap, inexpensive"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "9249489",
          "text": "Marias Kleid war günstig.",
          "translation": "Платье у Мэри было дешёвое.",
          "source": "Tatoeba #9249489 @Pfirsichbaeumchen / #9119834 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9249489",
          "cefr_level": "A1",
          "word_slugs": [
            "günstig-adj"
          ]
        },
        {
          "id": "9321396",
          "text": "Unser Haus ist günstig gelegen.",
          "translation": "Наш дом удобно расположен.",
          "source": "Tatoeba #9321396 @Pfirsichbaeumchen / #9408156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9321396",
          "cefr_level": "A1",
          "word_slugs": [
            "günstig-adj"
          ]
        },
        {
          "id": "2908974",
          "text": "Das Wetter war nicht günstig für uns.",
          "translation": "Погода не благоприятствовала нам.",
          "source": "Tatoeba #2908974 @al_ex_an_der / #2908973 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2908974",
          "cefr_level": "A1",
          "word_slugs": [
            "günstig-adj"
          ]
        },
        {
          "id": "8083683",
          "text": "Orangen sind nicht so günstig wie Bananen.",
          "translation": "Апельсины не так дёшевы, как бананы.",
          "source": "Tatoeba #8083683 @Luiaard / #10122879 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8083683",
          "cefr_level": "A1",
          "word_slugs": [
            "günstig-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der günstig",
        "nominative_pl": ""
      }
