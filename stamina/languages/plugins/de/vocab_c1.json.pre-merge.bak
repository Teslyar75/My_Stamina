    {
      "slug": "ursprünglich-adj",
      "lemma": "ursprünglich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7822,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "original, initial, first",
          "original, authentic, genuine, unadulterated"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "11247937",
          "text": "Ich stamme ursprünglich aus Deutschland.",
          "translation": "Я родом из Германии.",
          "source": "Tatoeba #11247937 @Chitra25 / #11248216 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11247937",
          "cefr_level": "A1",
          "word_slugs": [
            "ursprünglich-adj"
          ]
        },
        {
          "id": "10857004",
          "text": "Ursprünglich sind wir alle aus Afrika.",
          "translation": "Мы все родом из Африки.",
          "source": "Tatoeba #10857004 @kotik / #10857023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10857004",
          "cefr_level": "A1",
          "word_slugs": [
            "ursprünglich-adj"
          ]
        },
        {
          "id": "12820117",
          "text": "Dieses Gebäude war ursprünglich ein Kloster.",
          "translation": "Это строение первоначально было монастырём.",
          "source": "Tatoeba #12820117 @mhr / #11419116 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12820117",
          "cefr_level": "A1",
          "word_slugs": [
            "ursprünglich-adj"
          ]
        },
        {
          "id": "13051848",
          "text": "Ursprünglich ist dieses Gedicht auf Französisch verfasst worden.",
          "translation": "Изначально это стихотворение было написано по-французски.",
          "source": "Tatoeba #13051848 @mhr / #13051116 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13051848",
          "cefr_level": "A1",
          "word_slugs": [
            "ursprünglich-adj"
          ]
        }
      ],
      "tags": [
