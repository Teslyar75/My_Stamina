    {
      "slug": "mythos-noun",
      "lemma": "Mythos",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9722,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "миф"
        ],
        "en": [
          "myth, mythos (narrative of importance to a particular group or culture)",
          "myth (something invented or made up)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1907073",
          "text": "Das ist ein Mythos.",
          "translation": "Это миф.",
          "source": "Tatoeba #1907073 @Pfirsichbaeumchen / #3291425 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1907073",
          "cefr_level": "A1",
          "word_slugs": [
            "mythos-noun"
          ]
        },
        {
          "id": "13454575",
          "text": "Dass arme Leute faul sind, ist ein Mythos.",
          "translation": "То, что бедные люди ленивы, - миф.",
          "source": "Tatoeba #13454575 @mhr / #13454560 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13454575",
          "cefr_level": "A1",
          "word_slugs": [
            "mythos-noun"
          ]
        },
        {
          "id": "13454573",
          "text": "Dass arme Leute faul seien, ist ein Mythos.",
          "translation": "То, что бедные люди ленивы, - миф.",
          "source": "Tatoeba #13454573 @mhr / #13454560 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13454573",
          "cefr_level": "A1",
          "word_slugs": [
            "mythos-noun"
          ]
        },
        {
          "id": "13454577",
