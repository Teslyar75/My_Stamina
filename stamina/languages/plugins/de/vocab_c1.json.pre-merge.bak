    {
      "slug": "hörer-noun",
      "lemma": "Hörer",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9356,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "agent noun of hören",
