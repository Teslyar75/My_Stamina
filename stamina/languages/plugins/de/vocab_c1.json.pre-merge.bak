            "hebt-verb"
          ]
        },
        {
          "id": "8320764",
          "text": "Sie hebt ihr Bein.",
          "translation": "Она поднимает ногу.",
          "source": "Tatoeba #8320764 @MisterTrouser / #11836417 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320764",
          "cefr_level": "A1",
          "word_slugs": [
            "hebt-verb"
          ]
        },
        {
          "id": "8320716",
          "text": "Er hebt seinen Arm.",
          "translation": "Он поднимает руку.",
          "source": "Tatoeba #8320716 @MisterTrouser / #11836413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320716",
          "cefr_level": "A1",
          "word_slugs": [
            "hebt-verb"
          ]
        },
        {
          "id": "8320717",
          "text": "Sie hebt ihren Arm.",
          "translation": "Она поднимает руку.",
          "source": "Tatoeba #8320717 @MisterTrouser / #11836415 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320717",
          "cefr_level": "A1",
          "word_slugs": [
            "hebt-verb"
          ]
        },
        {
          "id": "8320837",
          "text": "Er hebt seinen Fuß.",
          "translation": "Он поднимает ногу.",
          "source": "Tatoeba #8320837 @MisterTrouser / #11836411 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320837",
