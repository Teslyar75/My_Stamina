          ]
        },
        {
          "id": "3057962",
          "text": "Haben Sie Toms Rat befolgt?",
          "translation": "Вы последовали совету Тома?",
          "source": "Tatoeba #3057962 @Manfredo / #3058150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3057962",
          "cefr_level": "A1",
