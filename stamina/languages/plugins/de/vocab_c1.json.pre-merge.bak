      "gender": null,
      "examples": [
        {
          "id": "3141001",
          "text": "Er initiierte einst die Gründung eines nationalen Zahlungssystems.",
          "translation": "Он когда-то инициировал создание национальной платёжной системы.",
          "source": "Tatoeba #3141001 @al_ex_an_der / #3141000 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3141001",
          "cefr_level": "A1",
          "word_slugs": [
            "nationalen-adj"
          ]
        },
        {
          "id": "1620937",
          "text": "Die aufblühende Literatur begünstigte die Herausbildung einer nationalen Identität.",
          "translation": "Расцвет литературы способствовал формированию национального самосознания.",
          "source": "Tatoeba #1620937 @al_ex_an_der / #1912979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1620937",
          "cefr_level": "A1",
