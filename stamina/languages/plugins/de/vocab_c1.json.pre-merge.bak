          "word_slugs": [
            "zuverlässig-adj"
          ]
        },
        {
          "id": "14059317",
          "text": "Die Uhr ist genau und zuverlässig.",
          "translation": "Часы точные и надёжные.",
          "source": "Tatoeba #14059317 @mhr / #14059322 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14059317",
          "cefr_level": "A1",
          "word_slugs": [
