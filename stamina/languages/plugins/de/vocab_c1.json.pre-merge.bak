    {
      "slug": "offenen-adj",
      "lemma": "offenen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5161,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of offen:",
          "strong genitive masculine/neuter singular",
          "inflection of offen:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1259693",
          "text": "Ich küsse mit offenen Augen.",
          "translation": "Я целуюсь с открытыми глазами.",
          "source": "Tatoeba #1259693 @Esperantostern / #816229 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1259693",
          "cefr_level": "A1",
          "word_slugs": [
            "offenen-adj"
          ]
        },
        {
          "id": "1842028",
          "text": "Ich liebe ihren offenen Charakter.",
          "translation": "Я люблю её прямой характер.",
          "source": "Tatoeba #1842028 @Esperantostern / #1993176 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1842028",
          "cefr_level": "A1",
          "word_slugs": [
            "offenen-adj"
          ]
        },
        {
          "id": "7663985",
          "text": "Tom lag mit offenen Augen im Bett.",
          "translation": "Том лежал в постели с открытыми глазами.",
          "source": "Tatoeba #7663985 @Pfirsichbaeumchen / #7657534 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7663985",
          "cefr_level": "A1",
          "word_slugs": [
            "offenen-adj"
          ]
        },
        {
          "id": "1427600",
          "text": "Wir haben ihn mit offenen Armen aufgenommen.",
          "translation": "Мы приняли его с распростёртыми объятиями.",
          "source": "Tatoeba #1427600 @Espi / #3844479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1427600",
          "cefr_level": "A1",
          "word_slugs": [
            "offenen-adj"
          ]
        },
        {
          "id": "5844382",
          "text": "Tom ging zum Tag der offenen Tür der Universität.",
          "translation": "Том пошёл на День открытых дверей в университет.",
          "source": "Tatoeba #5844382 @Pfirsichbaeumchen / #8172201 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5844382",
          "cefr_level": "A1",
          "word_slugs": [
            "offenen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
