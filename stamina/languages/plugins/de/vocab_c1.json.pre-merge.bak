    {
      "slug": "hierfür-adv",
      "lemma": "hierfür",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8249,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "for this (purpose), therefore"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2659892",
          "text": "Der Grund hierfür ist klar.",
          "translation": "Причина тому ясна.",
          "source": "Tatoeba #2659892 @Pfirsichbaeumchen / #3286695 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2659892",
          "cefr_level": "A1",
          "word_slugs": [
            "hierfür-adv"
          ]
        },
        {
          "id": "4296027",
          "text": "Die Gründe hierfür sind bekannt.",
          "translation": "Причины этого известны.",
          "source": "Tatoeba #4296027 @al_ex_an_der / #4296088 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4296027",
          "cefr_level": "A1",
          "word_slugs": [
            "hierfür-adv"
          ]
        },
        {
          "id": "13425465",
          "text": "Hierfür gibt es wahrscheinlich eine Erklärung.",
          "translation": "Этому, вероятно, есть объяснение.",
          "source": "Tatoeba #13425465 @mhr / #13425424 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13425465",
          "cefr_level": "A1",
          "word_slugs": [
            "hierfür-adv"
          ]
        },
        {
          "id": "2659889",
          "text": "Der Grund hierfür liegt auf der Hand.",
          "translation": "Причина тому лежит на поверхности.",
          "source": "Tatoeba #2659889 @Pfirsichbaeumchen / #3286696 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2659889",
          "cefr_level": "A1",
          "word_slugs": [
            "hierfür-adv"
          ]
        },
        {
          "id": "3137047",
          "text": "Die Verantwortung hierfür liegt beim früheren Präsidenten und seiner nächsten Umgebung.",
          "translation": "Ответственность за это лежит на бывшем президенте и его ближайшем окружении.",
          "source": "Tatoeba #3137047 @al_ex_an_der / #3137048 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3137047",
          "cefr_level": "A1",
          "word_slugs": [
            "hierfür-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
