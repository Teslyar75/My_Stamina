    {
      "slug": "schwachen-noun",
      "lemma": "Schwachen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8081,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "7914056",
          "text": "Der Starke muss dem Schwachen helfen.",
          "translation": "Сильный должен помогать слабому.",
          "source": "Tatoeba #7914056 @list / #447741 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7914056",
          "cefr_level": "A1",
          "word_slugs": [
            "schwachen-noun"
          ]
        },
        {
          "id": "636495",
          "text": "Er war immer auf der Seite der Schwachen, gegen die Starken.",
          "translation": "Он всегда был на стороне слабых против сильных.",
          "source": "Tatoeba #636495 @Manfredo / #13480202 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/636495",
          "cefr_level": "A1",
          "word_slugs": [
            "schwachen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
