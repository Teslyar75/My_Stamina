    {
      "slug": "wolke-noun",
      "lemma": "Wolke",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7397,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "cloud (a visible mass of water droplets suspended in the air)",
          "cloud, made of steam, ash, smoke or anything that resembles such a mass (may also be Schwaden or Schwade in this sense)",
          "nebula, enormous masses of interstellar dust and hydrogen in outerspace (may also be Nebel in this sense)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "3325844",
          "text": "Die Wolke ist grau.",
          "translation": "Облако серое.",
          "source": "Tatoeba #3325844 @al_ex_an_der / #3325843 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3325844",
          "cefr_level": "A1",
          "word_slugs": [
            "wolke-noun"
          ]
        },
        {
          "id": "2581817",
          "text": "Die Wolke war pechschwarz.",
          "translation": "Туча была черной как смоль.",
          "source": "Tatoeba #2581817 @al_ex_an_der / #2581814 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2581817",
          "cefr_level": "A1",
          "word_slugs": [
            "wolke-noun"
          ]
        },
        {
          "id": "2992926",
          "text": "Am Himmel war keine Wolke.",
          "translation": "На небе не было ни облака.",
          "source": "Tatoeba #2992926 @Esperantostern / #2992920 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2992926",
          "cefr_level": "A1",
          "word_slugs": [
