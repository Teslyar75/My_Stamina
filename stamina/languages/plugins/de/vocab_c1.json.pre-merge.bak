        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13012503",
          "text": "Habe ich mich verhört?",
          "translation": "Я ослышался?",
          "source": "Tatoeba #13012503 @Waldelfe / #13708060 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13012503",
          "cefr_level": "A1",
          "word_slugs": [
            "verhört-verb"
          ]
        },
        {
          "id": "14038479",
          "text": "Leider hast du dich verhört.",
          "translation": "К сожалению, ты ослышался.",
          "source": "Tatoeba #14038479 @mhr / #14038371 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14038479",
          "cefr_level": "A1",
          "word_slugs": [
            "verhört-verb"
          ]
        },
        {
          "id": "14038481",
          "text": "Leider habt ihr euch verhört.",
          "translation": "К сожалению, вы ослышались.",
          "source": "Tatoeba #14038481 @mhr / #14038369 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14038481",
          "cefr_level": "A1",
          "word_slugs": [
            "verhört-verb"
          ]
        },
        {
          "id": "14038480",
          "text": "Leider haben Sie sich verhört.",
          "translation": "К сожалению, Вы ослышались.",
          "source": "Tatoeba #14038480 @mhr / #14038370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14038480",
          "cefr_level": "A1",
          "word_slugs": [
            "verhört-verb"
          ]
        },
        {
          "id": "2836640",
          "text": "Gleich nach meiner Verhaftung bin ich mehrmals verhört worden.",
          "translation": "Сразу же после моего ареста меня несколько раз допросили.",
          "source": "Tatoeba #2836640 @sigavax / #2836681 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2836640",
          "cefr_level": "A1",
          "word_slugs": [
            "verhört-verb"
          ]
        }
      ],
      "tags": [
