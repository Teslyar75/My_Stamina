    {
      "slug": "töne-noun",
      "lemma": "Töne",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9338,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Ton"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "915066",
          "text": "Sie schlug hohe Töne auf dem Klavier an.",
          "translation": "Она извлекла из фортепиано высокие звуки.",
          "source": "Tatoeba #915066 @Espi / #2962439 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/915066",
          "cefr_level": "A1",
          "word_slugs": [
            "töne-noun"
          ]
        },
        {
          "id": "9936368",
          "text": "Hunde hören Töne mit viel höheren Frequenzen als Menschen.",
          "translation": "Собаки слышат звуки на гораздо более высоких частотах, чем люди.",
          "source": "Tatoeba #9936368 @GaryGaryGary / #5658116 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936368",
          "cefr_level": "A1",
          "word_slugs": [
            "töne-noun"
          ]
        },
        {
          "id": "758772",
          "text": "Die Japaner erfreut der Gesang der Vögel und die Töne der Insekten.",
          "translation": "Японцев радует пение птиц и насекомых.",
          "source": "Tatoeba #758772 @Esperantostern / #10800587 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/758772",
          "cefr_level": "A1",
          "word_slugs": [
            "töne-noun"
          ]
        }
