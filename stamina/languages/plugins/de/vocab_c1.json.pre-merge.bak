          "source": "Tatoeba #10061717 @felix63 / #10328697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10061717",
          "cefr_level": "A1",
          "word_slugs": [
            "tanze-verb"
          ]
        },
        {
          "id": "4626386",
          "text": "Ich tanze nicht für sie.",
          "translation": "Я для них не танцую.",
          "source": "Tatoeba #4626386 @Tamy / #13211976 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4626386",
          "cefr_level": "A1",
          "word_slugs": [
            "tanze-verb"
          ]
        },
        {
          "id": "11144712",
          "text": "Tut mir leid, ich tanze nicht.",
          "translation": "Простите, я не танцую.",
          "source": "Tatoeba #11144712 @carlosalberto / #11144705 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11144712",
          "cefr_level": "A1",
          "word_slugs": [
            "tanze-verb"
          ]
        }
      ],
