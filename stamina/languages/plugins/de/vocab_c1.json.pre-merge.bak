      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "greed"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2583398",
          "text": "Die Schlange verschlang das Kaninchen mit großer Gier.",
          "translation": "Змея проглотила кролика с большой жадностью.",
          "source": "Tatoeba #2583398 @al_ex_an_der / #2583397 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2583398",
          "cefr_level": "A1",
          "word_slugs": [
            "gier-noun"
          ]
        },
        {
          "id": "2583401",
          "text": "Eine Schlange verschlang mit großer Gier ein Kaninchen.",
          "translation": "Змея проглотила кролика с большой жадностью.",
          "source": "Tatoeba #2583401 @al_ex_an_der / #2583397 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2583401",
          "cefr_level": "A1",
          "word_slugs": [
            "gier-noun"
          ]
        },
        {
          "id": "848597",
          "text": "Die Gier des Menschen ist sein Baseballschläger im Kampf gegen sein Herz.",
          "translation": "Алчность человека — это его бейсбольная бита в битве против своего сердца.",
          "source": "Tatoeba #848597 @MUIRIEL / #848606 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/848597",
          "cefr_level": "A1",
          "word_slugs": [
            "gier-noun"
          ]
        },
        {
          "id": "3975668",
          "text": "Gier ist stets ein guter Motivator.",
          "translation": "Жадность всегда является хорошим мотиватором.",
          "source": "Tatoeba #3975668 @Pfirsichbaeumchen / #10791139 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3975668",
          "cefr_level": "A1",
          "word_slugs": [
