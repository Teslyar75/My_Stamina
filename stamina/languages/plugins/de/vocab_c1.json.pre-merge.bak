    {
      "slug": "abfall-noun",
      "lemma": "Abfall",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9203,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "waste, garbage, rubbish, litter",
          "decrease, decline, drop",
          "apostasy",
          "shutter, lid"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10229091",
          "text": "Vorsicht! Das ist radioaktiver Abfall.",
          "translation": "Внимание! Это радиоактивные отходы.",
          "source": "Tatoeba #10229091 @manese / #13750883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10229091",
          "cefr_level": "A1",
          "word_slugs": [
            "abfall-noun"
          ]
        },
        {
          "id": "1109401",
          "text": "Ein neues Verfahren soll Abfall mittels Enzymen in Rohstoffe verwandeln.",
          "translation": "Новый процесс должен превращать отходы в сырьё с помощью энзимов.",
          "source": "Tatoeba #1109401 @Haehnchenpaella / #2932326 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1109401",
          "cefr_level": "A1",
          "word_slugs": [
            "abfall-noun"
          ]
        },
        {
          "id": "3546574",
          "text": "Die Arbeitsaufgabe besteht hauptsächlich darin, Unterholz zu entfernen und Abfall wegzuräumen.",
          "translation": "Рабочее задание состоит главным образом в том, чтобы удалить подлесок и убрать мусор.",
          "source": "Tatoeba #3546574 @al_ex_an_der / #3546970 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3546574",
          "cefr_level": "A1",
          "word_slugs": [
            "abfall-noun"
          ]
        }
      ],
      "tags": [
