    {
      "slug": "gewaltig-adj",
      "lemma": "gewaltig",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6470,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сильний"
        ],
        "en": [
          "enormous, huge",
          "massive, mighty"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "9514204",
          "text": "Diese Kirche ist gewaltig.",
          "translation": "Эта церковь огромная.",
          "source": "Tatoeba #9514204 @Pfirsichbaeumchen / #9512688 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9514204",
          "cefr_level": "A1",
          "word_slugs": [
            "gewaltig-adj"
          ]
        },
        {
          "id": "13913772",
          "text": "Die Erschütterung war gewaltig.",
          "translation": "Потрясение было ужасным.",
          "source": "Tatoeba #13913772 @mhr / #13913238 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13913772",
          "cefr_level": "A1",
          "word_slugs": [
            "gewaltig-adj"
          ]
        },
        {
          "id": "8231780",
          "text": "Es gibt einen Unterschied, und der ist gewaltig.",
          "translation": "Разница есть, и она огромна.",
          "source": "Tatoeba #8231780 @Pfirsichbaeumchen / #8231623 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8231780",
          "cefr_level": "A1",
          "word_slugs": [
            "gewaltig-adj"
          ]
        },
        {
          "id": "2527698",
          "text": "Tom und Mary gehen mir langsam gewaltig auf die Eier.",
          "translation": "Том и Мэри меня уже порядочно достали.",
          "source": "Tatoeba #2527698 @brauchinet / #2529424 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2527698",
          "cefr_level": "A1",
          "word_slugs": [
            "gewaltig-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
