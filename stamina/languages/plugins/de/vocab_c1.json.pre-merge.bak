    {
      "slug": "schwieriger-adj",
      "lemma": "schwieriger",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5284,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schwierig:",
          "strong/mixed nominative masculine singular",
          "inflection of schwierig:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11182895",
          "text": "Je schwieriger, desto besser.",
          "translation": "Чем труднее, тем лучше.",
          "source": "Tatoeba #11182895 @Boshnjanin / #11183944 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11182895",
          "cefr_level": "A1",
          "word_slugs": [
            "schwieriger-adj"
          ]
        },
        {
          "id": "2499464",
          "text": "Das Atmen wurde immer schwieriger.",
          "translation": "Дыхание становилось все затрудненнее.",
          "source": "Tatoeba #2499464 @al_ex_an_der / #2499465 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2499464",
          "cefr_level": "A1",
          "word_slugs": [
            "schwieriger-adj"
          ]
        },
        {
          "id": "13659450",
          "text": "Der Rückweg ist immer schwieriger.",
          "translation": "Обратная дорога всегда труднее.",
          "source": "Tatoeba #13659450 @mhr / #13658893 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13659450",
          "cefr_level": "A1",
          "word_slugs": [
            "schwieriger-adj"
          ]
        },
        {
          "id": "12387703",
          "text": "Der Unterricht wird immer schwieriger.",
          "translation": "Уроки становятся всё труднее и труднее.",
          "source": "Tatoeba #12387703 @Pfirsichbaeumchen / #2512841 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12387703",
          "cefr_level": "A1",
          "word_slugs": [
            "schwieriger-adj"
          ]
        },
        {
          "id": "12492278",
          "text": "Griechisch ist schwieriger als Latein.",
          "translation": "Греческий сложнее латыни.",
          "source": "Tatoeba #12492278 @Waldelfe / #7133546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12492278",
          "cefr_level": "A1",
          "word_slugs": [
            "schwieriger-adj"
          ]
        }
