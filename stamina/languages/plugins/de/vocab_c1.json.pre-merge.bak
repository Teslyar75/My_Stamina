    {
      "slug": "seltsamen-adj",
      "lemma": "seltsamen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6608,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of seltsam:",
          "strong genitive masculine/neuter singular",
          "inflection of seltsam:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "645598",
          "text": "Er hat einen seltsamen Namen.",
          "translation": "У него странное имя.",
          "source": "Tatoeba #645598 @Pfirsichbaeumchen / #370370 @reiji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/645598",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsamen-adj"
          ]
        },
        {
          "id": "797798",
          "text": "Sie trug einen seltsamen Hut.",
          "translation": "Она была в странной шляпе.",
          "source": "Tatoeba #797798 @al_ex_an_der / #8281021 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/797798",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsamen-adj"
          ]
        },
        {
          "id": "759522",
          "text": "Er hatte einen seltsamen Traum.",
          "translation": "Ему приснился странный сон.",
          "source": "Tatoeba #759522 @Manfredo / #11234142 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/759522",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsamen-adj"
          ]
        },
        {
          "id": "1684213",
          "text": "Tom starb unter seltsamen Umständen.",
          "translation": "Том умер при странных обстоятельствах.",
          "source": "Tatoeba #1684213 @Pfirsichbaeumchen / #1722141 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684213",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsamen-adj"
          ]
        },
        {
          "id": "4206799",
          "text": "Er ist eines seltsamen Todes gestorben.",
          "translation": "Он умер странной смертью.",
          "source": "Tatoeba #4206799 @MisterTrouser / #11835680 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4206799",
          "cefr_level": "A1",
          "word_slugs": [
            "seltsamen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
