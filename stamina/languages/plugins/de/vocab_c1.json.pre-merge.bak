    {
      "slug": "sofern-conj",
      "lemma": "sofern",
      "pos": "conj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7982,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "provided (that), if"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8310632",
          "text": "Sofern du bezahlst, trinke ich.",
          "translation": "Если ты проставляешься, я выпью.",
          "source": "Tatoeba #8310632 @felix63 / #12337996 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8310632",
          "cefr_level": "A1",
          "word_slugs": [
            "sofern-conj"
          ]
        },
        {
          "id": "1912689",
          "text": "Du wirst dort rechtzeitig ankommen, sofern du nicht den Zug verpasst.",
          "translation": "Ты доберёшься туда вовремя, если только на поезд не опоздаешь.",
          "source": "Tatoeba #1912689 @Tamy / #3254047 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1912689",
          "cefr_level": "A1",
          "word_slugs": [
            "sofern-conj"
          ]
        },
        {
          "id": "1912691",
          "text": "Ihr werdet dort rechtzeitig ankommen, sofern ihr nicht den Zug verpasst.",
          "translation": "Вы доберётесь туда вовремя, если только на поезд не опоздаете.",
          "source": "Tatoeba #1912691 @Tamy / #3254041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1912691",
          "cefr_level": "A1",
          "word_slugs": [
            "sofern-conj"
          ]
        },
        {
          "id": "1912690",
          "text": "Sie werden dort rechtzeitig ankommen, sofern Sie nicht den Zug verpassen.",
          "translation": "Вы доберётесь туда вовремя, если только на поезд не опоздаете.",
          "source": "Tatoeba #1912690 @Tamy / #3254041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1912690",
          "cefr_level": "A1",
          "word_slugs": [
            "sofern-conj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
