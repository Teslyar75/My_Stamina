    {
      "slug": "erholen-verb",
      "lemma": "erholen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5998,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "отдыхать"
        ],
        "en": [
          "to relax, to recover, to recuperate"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2623083",
          "text": "Wo sie sich erholen, weiß niemand.",
          "translation": "Где они отдыхают, никто не знает.",
          "source": "Tatoeba #2623083 @Olya / #2623084 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2623083",
          "cefr_level": "A1",
          "word_slugs": [
            "erholen-verb"
          ]
        },
        {
          "id": "13681454",
          "text": "Vielleicht musst du dich nur erholen.",
          "translation": "Может быть, тебе просто нужно отдохнуть.",
          "source": "Tatoeba #13681454 @mhr / #13681392 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13681454",
          "cefr_level": "A1",
          "word_slugs": [
            "erholen-verb"
          ]
        },
        {
          "id": "13681452",
          "text": "Vielleicht müsst ihr euch nur erholen.",
          "translation": "Может быть, вам просто нужно отдохнуть.",
          "source": "Tatoeba #13681452 @mhr / #13681393 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13681452",
          "cefr_level": "A1",
          "word_slugs": [
            "erholen-verb"
          ]
        },
        {
          "id": "2625243",
          "text": "Im Winter erholen wir uns im Gebirge.",
          "translation": "Зимой мы отдыхаем в горах.",
          "source": "Tatoeba #2625243 @Olya / #2625244 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2625243",
          "cefr_level": "A1",
          "word_slugs": [
            "erholen-verb"
          ]
        },
        {
          "id": "2135539",
          "text": "Sie wird sich bald von dem Schock erholen.",
          "translation": "Она скоро оправится от шока.",
