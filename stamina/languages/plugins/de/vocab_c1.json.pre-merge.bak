    {
      "slug": "weisen-verb",
      "lemma": "weisen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5339,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to point",
          "to indicate; to show"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11557267",
          "text": "Die Fenster meines Zimmers weisen zum Hof hin.",
          "translation": "Окна моей комнаты выходят во двор.",
          "source": "Tatoeba #11557267 @Pfirsichbaeumchen / #8545863 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11557267",
          "cefr_level": "A1",
          "word_slugs": [
            "weisen-verb"
          ]
        },
        {
          "id": "785515",
          "text": "Höre auf die weisen Ratschläge dessen, der eine große Erfahrung hat.",
          "translation": "Слушай мудрые советы тех, у кого большой опыт.",
          "source": "Tatoeba #785515 @Esperantostern / #1115340 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/785515",
          "cefr_level": "A1",
          "word_slugs": [
            "weisen-verb"
          ]
        }
      ],
      "tags": [
