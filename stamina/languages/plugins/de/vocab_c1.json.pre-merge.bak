      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5597,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "eagle",
          "eagle, as used on a coat of arms"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13801606",
          "text": "Es ist ein Adler!",
          "translation": "Это орёл!",
          "source": "Tatoeba #13801606 @Rovo / #13801607 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13801606",
          "cefr_level": "A1",
          "word_slugs": [
            "adler-noun"
          ]
        },
        {
          "id": "3682373",
          "text": "Der Adler ist weiß.",
          "translation": "Орёл белый.",
          "source": "Tatoeba #3682373 @Vortarulo / #3420221 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3682373",
          "cefr_level": "A1",
          "word_slugs": [
            "adler-noun"
          ]
        },
        {
          "id": "587386",
          "text": "Ein Adler fliegt am Himmel.",
          "translation": "В небе летит орёл.",
          "source": "Tatoeba #587386 @Manfredo / #609918 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/587386",
          "cefr_level": "A1",
          "word_slugs": [
            "adler-noun"
          ]
        },
        {
          "id": "6624254",
          "text": "Der Adler hatte einen gebrochenen Flügel.",
          "translation": "У орла было сломанное крыло.",
          "source": "Tatoeba #6624254 @Pfirsichbaeumchen / #7073518 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6624254",
          "cefr_level": "A1",
          "word_slugs": [
            "adler-noun"
          ]
        },
        {
          "id": "13970383",
          "text": "Hoch oben am Himmel flog ein Adler.",
          "translation": "Высоко в небе парил орёл.",
          "source": "Tatoeba #13970383 @mhr / #2370644 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13970383",
          "cefr_level": "A1",
          "word_slugs": [
            "adler-noun"
          ]
        }
      ],
      "tags": [
        "C1"
