      "examples": [
        {
          "id": "13449331",
          "text": "Waren dort ihre Verwandten?",
          "translation": "Там были её родственники?",
          "source": "Tatoeba #13449331 @Biderl / #13449869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13449331",
