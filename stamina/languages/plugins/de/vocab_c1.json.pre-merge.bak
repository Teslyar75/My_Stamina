          ]
        },
        {
          "id": "2981819",
          "text": "Sie versuchte, mich zu verführen.",
          "translation": "Она пыталась меня соблазнить.",
          "source": "Tatoeba #2981819 @Zaghawa / #10620453 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2981819",
