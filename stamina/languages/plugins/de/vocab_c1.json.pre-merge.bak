      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of ehemalig:",
          "strong genitive masculine/neuter singular",
          "inflection of ehemalig:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10118714",
          "text": "Das ist ein Brief von meiner ehemaligen Lehrerin.",
          "translation": "Это письмо от моей бывшей учительницы.",
          "source": "Tatoeba #10118714 @wolfgangth / #14062191 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10118714",
          "cefr_level": "A1",
          "word_slugs": [
