    {
      "slug": "pflege-noun",
      "lemma": "Pflege",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8558,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "care",
          "fostering (of a child)",
          "maintenance (i. e. of a machine)",
          "cultivation (i. e. of art, language)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1041904",
          "text": "Sie benötigen eine tägliche Pflege.",
