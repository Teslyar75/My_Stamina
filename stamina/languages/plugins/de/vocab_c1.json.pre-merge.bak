      "gender": null,
      "examples": [
        {
          "id": "9936368",
          "text": "Hunde hören Töne mit viel höheren Frequenzen als Menschen.",
          "translation": "Собаки слышат звуки на гораздо более высоких частотах, чем люди.",
          "source": "Tatoeba #9936368 @GaryGaryGary / #5658116 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936368",
          "cefr_level": "A1",
          "word_slugs": [
            "höheren-adj"
          ]
        },
        {
          "id": "3803136",
          "text": "Männer, deren Mütter Brustkrebs hatten, unterliegen einem höheren Risiko, Prostatakrebs zu entwickeln.",
          "translation": "Мужчины, чьи матери страдали раком груди, более подвержены раку простаты.",
          "source": "Tatoeba #3803136 @Tickler / #10338019 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3803136",
          "cefr_level": "A1",
