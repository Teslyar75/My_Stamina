    {
      "slug": "heilig-adj",
      "lemma": "heilig",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6465,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "holy",
          "sacred"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "913969",
          "text": "Nichts ist heilig.",
          "translation": "Ничто не свято.",
          "source": "Tatoeba #913969 @Esperantostern / #2285062 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/913969",
          "cefr_level": "A1",
          "word_slugs": [
            "heilig-adj"
          ]
        },
        {
          "id": "9701864",
          "text": "Die Ehe ist heilig.",
          "translation": "Брак - это святое.",
          "source": "Tatoeba #9701864 @Taam / #11194212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9701864",
          "cefr_level": "A1",
          "word_slugs": [
            "heilig-adj"
          ]
        },
        {
          "id": "4902294",
          "text": "Ist dieses Tier heilig?",
          "translation": "Это животное священно?",
          "source": "Tatoeba #4902294 @al_ex_an_der / #4902292 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4902294",
          "cefr_level": "A1",
          "word_slugs": [
            "heilig-adj"
          ]
        },
        {
          "id": "10990279",
          "text": "In Spanien ist die Siesta heilig.",
          "translation": "Сиеста в Испании - это святое.",
          "source": "Tatoeba #10990279 @Pfirsichbaeumchen / #10990271 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10990279",
          "cefr_level": "A1",
          "word_slugs": [
            "heilig-adj"
          ]
        },
        {
          "id": "387252",
          "text": "Für viele Leute in Indien sind Kühe heilig.",
          "translation": "Для многих в Индии коровы священны.",
          "source": "Tatoeba #387252 @MUIRIEL / #12953537 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/387252",
          "cefr_level": "A1",
          "word_slugs": [
            "heilig-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
