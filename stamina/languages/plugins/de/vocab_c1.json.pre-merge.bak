    {
      "slug": "küsse-noun",
      "lemma": "Küsse",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5372,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative plural of Kuss",
          "genitive plural of Kuss",
          "accusative plural of Kuss"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12748854",
          "text": "Gib mir tausend Küsse.",
          "translation": "Дай мне тысячу поцелуев.",
          "source": "Tatoeba #12748854 @Adelpa / #12748777 @Adelpa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12748854",
          "cefr_level": "A1",
          "word_slugs": [
            "küsse-noun"
          ]
        },
        {
          "id": "7725727",
          "text": "Ich vermisse seine Küsse.",
          "translation": "Я скучаю по его поцелуям.",
          "source": "Tatoeba #7725727 @Pfirsichbaeumchen / #4579778 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7725727",
          "cefr_level": "A1",
          "word_slugs": [
            "küsse-noun"
          ]
        },
        {
          "id": "6838216",
          "text": "Ihre Küsse wurden immer leidenschaftlicher.",
          "translation": "Их поцелуи становились всё более страстными.",
          "source": "Tatoeba #6838216 @Pfirsichbaeumchen / #6838224 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6838216",
          "cefr_level": "A1",
          "word_slugs": [
            "küsse-noun"
          ]
        },
        {
          "id": "10338929",
          "text": "Sie tauschten Küsse und Umarmungen aus.",
          "translation": "Они обменялись поцелуями и объятиями.",
          "source": "Tatoeba #10338929 @Pfirsichbaeumchen / #10185067 @Walentinio (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10338929",
          "cefr_level": "A1",
          "word_slugs": [
            "küsse-noun"
          ]
        },
        {
          "id": "2962717",
          "text": "Küsse sind das, was von der Sprache des Paradieses übrig geblieben ist.",
          "translation": "Поцелуи - это то, что осталось от языка рая.",
          "source": "Tatoeba #2962717 @Rovo / #12439660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2962717",
          "cefr_level": "A1",
          "word_slugs": [
            "küsse-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "küsse-verb",
      "lemma": "küsse",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5372,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of küssen:",
          "first-person singular present",
          "inflection of küssen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1259693",
          "text": "Ich küsse mit offenen Augen.",
          "translation": "Я целуюсь с открытыми глазами.",
          "source": "Tatoeba #1259693 @Esperantostern / #816229 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1259693",
          "cefr_level": "A1",
          "word_slugs": [
            "küsse-verb"
          ]
        },
        {
          "id": "6169700",
          "text": "Wenn du die Augen schließt, küsse ich dich.",
          "translation": "Если ты закроешь глаза, я тебя поцелую.",
          "source": "Tatoeba #6169700 @list / #11684665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6169700",
          "cefr_level": "A1",
          "word_slugs": [
            "küsse-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
