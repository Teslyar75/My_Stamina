    {
      "slug": "brett-noun",
      "lemma": "Brett",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5277,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "доска"
        ],
        "en": [
          "board, plank",
          "energetic, forceful track"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "13971847",
          "text": "Die Tasse steht auf dem Brett.",
          "translation": "Чашка стоит на полке.",
          "source": "Tatoeba #13971847 @rul / #13971809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13971847",
          "cefr_level": "A1",
          "word_slugs": [
            "brett-noun"
          ]
        },
        {
          "id": "10263920",
          "text": "Dame wird auf dem gleichen Brett wie Schach gespielt.",
          "translation": "В шашки играют на той же доске, что и в шахматы.",
          "source": "Tatoeba #10263920 @Pfirsichbaeumchen / #10275854 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10263920",
          "cefr_level": "A1",
          "word_slugs": [
            "brett-noun"
          ]
        },
        {
          "id": "3503414",
          "text": "Man soll das Brett bohren, wo es am dünnsten ist.",
          "translation": "Нужно сверлить доску там, где она тоньше всего.",
          "source": "Tatoeba #3503414 @Esperantostern / #3503481 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3503414",
          "cefr_level": "A1",
          "word_slugs": [
            "brett-noun"
          ]
        },
        {
          "id": "2367096",
          "text": "Der letzte Pfeil, den er warf, prallte vom Brett ab.",
          "translation": "Последняя стрела, которую он выпустил, отскочила от доски.",
          "source": "Tatoeba #2367096 @Rekholder / #2885177 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2367096",
          "cefr_level": "A1",
          "word_slugs": [
            "brett-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Brett",
        "nominative_pl": ""
      }
    },
    {
      "slug": "manieren-noun",
      "lemma": "Manieren",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5278,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Manier",
          "manners"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5789514",
          "text": "Wo sind deine Manieren?",
          "translation": "Где твои манеры?",
          "source": "Tatoeba #5789514 @dasbeispielholz / #2757515 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5789514",
          "cefr_level": "A1",
          "word_slugs": [
            "manieren-noun"
          ]
        },
        {
          "id": "4633728",
          "text": "Er hat schlechte Manieren.",
          "translation": "У него плохие манеры.",
          "source": "Tatoeba #4633728 @Tamy / #4633761 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4633728",
          "cefr_level": "A1",
          "word_slugs": [
            "manieren-noun"
          ]
        },
        {
          "id": "628149",
          "text": "Sie hat sehr gute Manieren.",
          "translation": "У неё очень хорошие манеры.",
          "source": "Tatoeba #628149 @meloncurtains / #1216624 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/628149",
          "cefr_level": "A1",
          "word_slugs": [
            "manieren-noun"
          ]
        },
        {
          "id": "399035",
          "text": "Ich bewundere seine aristokratischen Manieren.",
          "translation": "Я восхищаюсь его аристократическими манерами.",
          "source": "Tatoeba #399035 @xtofu80 / #407836 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399035",
          "cefr_level": "A1",
          "word_slugs": [
            "manieren-noun"
          ]
        },
        {
          "id": "6855883",
          "text": "Wir werden Tom die Manieren schon beibringen.",
          "translation": "Мы научим Тома хорошим манерам.",
          "source": "Tatoeba #6855883 @raggione / #6858379 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6855883",
          "cefr_level": "A1",
          "word_slugs": [
            "manieren-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
