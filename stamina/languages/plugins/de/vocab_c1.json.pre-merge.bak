    {
      "slug": "bewahrt-verb",
      "lemma": "bewahrt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6437,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of bewahren"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3062420",
          "text": "Bewahrt die Einheit der Ukraine!",
          "translation": "Сохраните единство Украины!",
          "source": "Tatoeba #3062420 @al_ex_an_der / #3062423 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3062420",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahrt-verb"
          ]
        },
        {
          "id": "13805350",
          "text": "Wie bewahrt man Rosinen richtig auf?",
          "translation": "Как правильно хранить изюм?",
          "source": "Tatoeba #13805350 @mhr / #13805125 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13805350",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahrt-verb"
          ]
        },
        {
          "id": "12851601",
          "text": "Kleidung bewahrt man in Schränken auf.",
          "translation": "Одежду хранят в шкафах.",
          "source": "Tatoeba #12851601 @mhr / #12851593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12851601",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahrt-verb"
          ]
        },
        {
          "id": "12851708",
          "text": "In Schränken bewahrt man Kleidung auf.",
          "translation": "В шкафах хранят одежду.",
          "source": "Tatoeba #12851708 @mhr / #6056787 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12851708",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahrt-verb"
          ]
        },
        {
          "id": "12851598",
          "text": "„Wozu sind Schränke da?“ – „In Schränken bewahrt man Kleidung auf.“",
          "translation": "\"Для чего нужны шкафы?\" - \"В шкафах хранят одежду\".",
          "source": "Tatoeba #12851598 @mhr / #12851588 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12851598",
          "cefr_level": "A1",
          "word_slugs": [
            "bewahrt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
