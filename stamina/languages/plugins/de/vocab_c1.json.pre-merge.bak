          "source": "Tatoeba #3606049 @al_ex_an_der / #2519419 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3606049",
          "cefr_level": "A1",
          "word_slugs": [
            "jahreszeit-noun"
          ]
        },
        {
          "id": "13564845",
          "text": "Welche Jahreszeit ist gerade?",
