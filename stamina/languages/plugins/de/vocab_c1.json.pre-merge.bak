    {
      "slug": "ausprobieren-verb",
      "lemma": "ausprobieren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5771,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to try out"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8490622",
          "text": "Du solltest es ausprobieren.",
          "translation": "Тебе стоит попробовать это.",
          "source": "Tatoeba #8490622 @driini / #3444022 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8490622",
          "cefr_level": "A1",
          "word_slugs": [
            "ausprobieren-verb"
          ]
        },
        {
          "id": "392932",
          "text": "Lasst uns etwas ausprobieren!",
          "translation": "Давайте что-нибудь попробуем!",
          "source": "Tatoeba #392932 @MUIRIEL / #5409 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/392932",
          "cefr_level": "A1",
          "word_slugs": [
            "ausprobieren-verb"
          ]
        },
        {
          "id": "8234233",
          "text": "Ich würde es gern ausprobieren.",
          "translation": "Я бы хотел попробовать.",
          "source": "Tatoeba #8234233 @driini / #2607146 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8234233",
          "cefr_level": "A1",
          "word_slugs": [
            "ausprobieren-verb"
          ]
        },
        {
          "id": "12939374",
          "text": "Ich werde etwas Neues ausprobieren.",
          "translation": "Я попробую что-то новое.",
          "source": "Tatoeba #12939374 @Waldelfe / #8391653 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12939374",
          "cefr_level": "A1",
          "word_slugs": [
            "ausprobieren-verb"
          ]
        },
        {
          "id": "2745919",
          "text": "Tom will nichts anderes ausprobieren.",
          "translation": "Том не хочет пробовать ничего другого.",
          "source": "Tatoeba #2745919 @Pfirsichbaeumchen / #4956689 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2745919",
          "cefr_level": "A1",
          "word_slugs": [
            "ausprobieren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
