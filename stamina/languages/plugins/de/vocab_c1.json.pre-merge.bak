          "magazine (published in regular intervals)",
          "periodical",
          "chronogram"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2127309",
          "text": "Wo ist meine Zeitschrift?",
          "translation": "Где мой журнал?",
          "source": "Tatoeba #2127309 @Vortarulo / #5027683 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2127309",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitschrift-noun"
          ]
        },
        {
          "id": "457214",
          "text": "Ich lese eine Zeitschrift.",
          "translation": "Я читаю журнал.",
          "source": "Tatoeba #457214 @MUIRIEL / #2530124 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/457214",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitschrift-noun"
          ]
        },
        {
          "id": "5027708",
          "text": "Bringe mir die Zeitschrift.",
          "translation": "Принеси мне журнал.",
          "source": "Tatoeba #5027708 @al_ex_an_der / #5027664 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5027708",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitschrift-noun"
          ]
        },
        {
          "id": "675449",
          "text": "Diese Zeitschrift nicht wegwerfen!",
          "translation": "Не выбрасывай этот журнал.",
          "source": "Tatoeba #675449 @Pfirsichbaeumchen / #3159967 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/675449",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitschrift-noun"
          ]
        },
        {
          "id": "1070976",
          "text": "Die Zeitschrift erscheint wöchentlich.",
          "translation": "Журнал выходит еженедельно.",
          "source": "Tatoeba #1070976 @MUIRIEL / #5027797 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1070976",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitschrift-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
