      "gender": null,
      "examples": [
        {
          "id": "13416171",
          "text": "Die Wohnungen hier sind sehr billig.",
          "translation": "Квартиры здесь очень дешёвые.",
          "source": "Tatoeba #13416171 @frpzzd / #7701318 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13416171",
          "cefr_level": "A1",
          "word_slugs": [
            "wohnungen-noun"
          ]
        },
        {
          "id": "4724526",
          "text": "Dieses Gebäude hat 5 Etagen und 20 Wohnungen.",
          "translation": "В этом здании пять этажей и двадцать квартир.",
          "source": "Tatoeba #4724526 @bonny37 / #4810163 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4724526",
          "cefr_level": "A1",
          "word_slugs": [
            "wohnungen-noun"
          ]
        },
        {
          "id": "5913692",
          "text": "Auf jeder Etage gibt es vier Wohnungen.",
          "translation": "На каждом этаже четыре квартиры.",
          "source": "Tatoeba #5913692 @Pfirsichbaeumchen / #5887856 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5913692",
          "cefr_level": "A1",
          "word_slugs": [
            "wohnungen-noun"
          ]
        },
        {
          "id": "3026608",
          "text": "Geräumige Wohnungen kosten in Tokio ein Vermögen.",
          "translation": "Просторные квартиры стоят в Токио целое состояние.",
          "source": "Tatoeba #3026608 @Esperantostern / #8358760 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3026608",
          "cefr_level": "A1",
          "word_slugs": [
            "wohnungen-noun"
          ]
        },
        {
          "id": "13951135",
          "text": "Auf jeder Etage befinden sich je vier Wohnungen.",
          "translation": "На каждом этаже по четыре квартиры.",
          "source": "Tatoeba #13951135 @mhr / #13950936 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13951135",
          "cefr_level": "A1",
