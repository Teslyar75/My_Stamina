          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1016794",
          "text": "Ich sende positive Wellen. Ommmmmm.",
          "translation": "Я посылаю позитивные волны. Аум-м-м-м.",
          "source": "Tatoeba #1016794 @MUIRIEL / #9115636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1016794",
          "cefr_level": "A1",
          "word_slugs": [
            "positive-adj"
          ]
        },
        {
          "id": "6039133",
          "text": "Sie haben eine positive Antwort bekommen.",
          "translation": "Вы получили положительный ответ.",
          "source": "Tatoeba #6039133 @christian63 / #6039542 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6039133",
          "cefr_level": "A1",
          "word_slugs": [
            "positive-adj"
          ]
        },
        {
          "id": "12437126",
          "text": "Wir haben viele positive Rückmeldungen erhalten.",
          "translation": "Мы получили множество положительных откликов.",
          "source": "Tatoeba #12437126 @Waldelfe / #13524081 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12437126",
          "cefr_level": "A1",
          "word_slugs": [
            "positive-adj"
          ]
        },
        {
          "id": "12466908",
          "text": "Für manche ist die Null eine positive Zahl.",
          "translation": "Для некоторых ноль - положительное число.",
          "source": "Tatoeba #12466908 @Pfirsichbaeumchen / #12467542 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12466908",
          "cefr_level": "A1",
          "word_slugs": [
            "positive-adj"
          ]
        },
        {
          "id": "12003931",
          "text": "Ich bemühe mich, eine positive Einstellung zu bewahren.",
          "translation": "Стараюсь сохранять позитивное настроение.",
          "source": "Tatoeba #12003931 @Pfirsichbaeumchen / #9115151 @Chus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12003931",
          "cefr_level": "A1",
          "word_slugs": [
            "positive-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
