    {
      "slug": "bären-noun",
      "lemma": "Bären",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5017,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Bär:",
          "genitive/accusative/dative singular",
          "inflection of Bär:",
          "all-case plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13039842",
          "text": "Ich mag Bären.",
          "translation": "Я люблю медведей.",
          "source": "Tatoeba #13039842 @Waldelfe / #13039840 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13039842",
          "cefr_level": "A1",
          "word_slugs": [
            "bären-noun"
          ]
        },
        {
          "id": "13577288",
          "text": "Tom sah den Bären.",
          "translation": "Том видел медведя.",
          "source": "Tatoeba #13577288 @mhr / #8458879 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13577288",
          "cefr_level": "A1",
          "word_slugs": [
            "bären-noun"
          ]
        },
        {
          "id": "10710054",
          "text": "Koalas sind keine Bären.",
          "translation": "Коалы не медведи.",
          "source": "Tatoeba #10710054 @Pfirsichbaeumchen / #10031488 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10710054",
          "cefr_level": "A1",
          "word_slugs": [
            "bären-noun"
          ]
        },
        {
          "id": "12187488",
          "text": "Er schoss den Bären an.",
          "translation": "Он подстрелил медведя.",
          "source": "Tatoeba #12187488 @mhr / #8651546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12187488",
          "cefr_level": "A1",
          "word_slugs": [
            "bären-noun"
          ]
        },
        {
          "id": "803671",
          "text": "Ich habe Angst vor Bären.",
          "translation": "Я боюсь медведей.",
          "source": "Tatoeba #803671 @Espi / #2767044 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/803671",
          "cefr_level": "A1",
          "word_slugs": [
            "bären-noun"
          ]
        }
