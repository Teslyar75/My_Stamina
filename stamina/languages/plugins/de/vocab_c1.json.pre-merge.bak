    {
      "slug": "verreisen-verb",
      "lemma": "verreisen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8036,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "уехать она уехала"
        ],
        "en": [
          "to take a trip, travel, go out of town"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2705316",
          "text": "Ich werde verreisen.",
          "translation": "Я поеду в путешествие.",
          "source": "Tatoeba #2705316 @Pfirsichbaeumchen / #3496668 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2705316",
          "cefr_level": "A1",
          "word_slugs": [
            "verreisen-verb"
          ]
        },
        {
          "id": "2238149",
          "text": "Wollen wir nicht zusammen verreisen?",
          "translation": "Давайте путешествовать вместе?",
          "source": "Tatoeba #2238149 @Pfirsichbaeumchen / #2973988 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2238149",
          "cefr_level": "A1",
          "word_slugs": [
            "verreisen-verb"
          ]
        },
        {
          "id": "7574975",
          "text": "Ich liebe es, im Winter zu verreisen.",
          "translation": "Я люблю путешествовать зимой.",
          "source": "Tatoeba #7574975 @driini / #5651606 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7574975",
          "cefr_level": "A1",
          "word_slugs": [
            "verreisen-verb"
          ]
        },
        {
          "id": "8354073",
          "text": "Nächsten Monat verreisen wir noch einmal zusammen.",
          "translation": "В следующем месяце мы опять поедем вместе.",
          "source": "Tatoeba #8354073 @Pfirsichbaeumchen / #8357895 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8354073",
          "cefr_level": "A1",
          "word_slugs": [
            "verreisen-verb"
          ]
        },
        {
          "id": "2345489",
          "text": "Ob wir verreisen werden, hängt vom Wetter ab.",
          "translation": "Поедем ли мы в путешествие - зависит от погоды.",
          "source": "Tatoeba #2345489 @Tamy / #790443 @tony (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2345489",
          "cefr_level": "A1",
          "word_slugs": [
            "verreisen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
