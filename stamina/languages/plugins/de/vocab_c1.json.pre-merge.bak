      "examples": [
        {
          "id": "2460803",
          "text": "Man kann hieraus einige Lehren ziehen.",
          "translation": "Из этого можно извлечь пару уроков.",
          "source": "Tatoeba #2460803 @al_ex_an_der / #2460801 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2460803",
          "cefr_level": "A1",
          "word_slugs": [
