    {
      "slug": "enthält-verb",
      "lemma": "enthält",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5280,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular present of enthalten - he/she/it contains, comprises"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2061160",
          "text": "Fleisch enthält Proteine.",
          "translation": "Мясо содержит протеины.",
          "source": "Tatoeba #2061160 @Manfredo / #2061154 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2061160",
          "cefr_level": "A1",
          "word_slugs": [
            "enthält-verb"
          ]
        },
        {
          "id": "13397987",
          "text": "Jeder Wein enthält Hefe.",
          "translation": "И на солнце есть пятна.",
          "source": "Tatoeba #13397987 @carlosalberto / #653514 @salikh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13397987",
          "cefr_level": "A1",
          "word_slugs": [
            "enthält-verb"
          ]
        },
        {
          "id": "9905487",
          "text": "Reis enthält kein Gluten.",
          "translation": "Рис не содержит глютена.",
          "source": "Tatoeba #9905487 @Pfirsichbaeumchen / #9849422 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9905487",
          "cefr_level": "A1",
          "word_slugs": [
            "enthält-verb"
          ]
        },
        {
          "id": "1922326",
          "text": "Enthält Coca-Cola Koffein?",
          "translation": "Кока-кола содержит кофеин?",
          "source": "Tatoeba #1922326 @Pfirsichbaeumchen / #3505499 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1922326",
          "cefr_level": "A1",
          "word_slugs": [
            "enthält-verb"
          ]
        },
        {
          "id": "340935",
          "text": "Dieses Glas enthält Wasser.",
          "translation": "В этом стакане есть вода.",
          "source": "Tatoeba #340935 @MUIRIEL / #2932363 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/340935",
          "cefr_level": "A1",
          "word_slugs": [
            "enthält-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
