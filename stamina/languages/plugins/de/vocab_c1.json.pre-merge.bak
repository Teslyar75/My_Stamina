    {
      "slug": "analyse-noun",
      "lemma": "Analyse",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5422,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
