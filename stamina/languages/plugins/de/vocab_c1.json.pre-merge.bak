    {
      "slug": "modernen-adj",
      "lemma": "modernen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7684,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of modern:",
          "strong genitive masculine/neuter singular",
          "inflection of modern:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5891422",
          "text": "Ich bin kein Freund der modernen Kunst.",
          "translation": "Я не любитель современного искусства.",
          "source": "Tatoeba #5891422 @Pfirsichbaeumchen / #5792172 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5891422",
          "cefr_level": "A1",
          "word_slugs": [
            "modernen-adj"
          ]
        },
        {
          "id": "1959044",
          "text": "Für einen modernen Mann ist das kein Kompliment.",
          "translation": "Для современного мужчины это не комплимент.",
          "source": "Tatoeba #1959044 @al_ex_an_der / #1959043 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1959044",
          "cefr_level": "A1",
          "word_slugs": [
            "modernen-adj"
          ]
        },
        {
          "id": "10037210",
          "text": "Die Alchimie war die Vorläuferin der modernen Chemie.",
          "translation": "Алхимия была предшественницей современной химии.",
          "source": "Tatoeba #10037210 @Pfirsichbaeumchen / #12245780 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10037210",
          "cefr_level": "A1",
          "word_slugs": [
            "modernen-adj"
          ]
        },
        {
          "id": "12801255",
          "text": "Geduld ist ein wichtiger Charakterzug des modernen Menschen.",
          "translation": "Терпеливость — важная черта современного человека.",
          "source": "Tatoeba #12801255 @mhr / #12799446 @LanguagesLover (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12801255",
          "cefr_level": "A1",
          "word_slugs": [
            "modernen-adj"
          ]
        },
        {
          "id": "13948567",
          "text": "Das gegenwärtige Bildungssystem wird den modernen Anforderungen nicht gerecht.",
          "translation": "Действующая система образования не отвечает современным требованиям.",
          "source": "Tatoeba #13948567 @Rovo / #13948337 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13948567",
          "cefr_level": "A1",
          "word_slugs": [
            "modernen-adj"
          ]
        }
      ],
      "tags": [
