    {
      "slug": "frisches-adj",
      "lemma": "frisches",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7698,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of frisch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6030337",
          "text": "Trinke frisches Wasser!",
          "translation": "Пей свежую воду!",
          "source": "Tatoeba #6030337 @list / #6332878 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6030337",
          "cefr_level": "A1",
          "word_slugs": [
            "frisches-adj"
          ]
        },
        {
          "id": "8320607",
          "text": "Er isst frisches Obst.",
          "translation": "Он ест свежие фрукты.",
          "source": "Tatoeba #8320607 @MisterTrouser / #11835742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320607",
          "cefr_level": "A1",
          "word_slugs": [
            "frisches-adj"
          ]
        },
        {
          "id": "8320606",
          "text": "Ich esse frisches Obst.",
          "translation": "Я ем свежие фрукты.",
          "source": "Tatoeba #8320606 @MisterTrouser / #7208275 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320606",
          "cefr_level": "A1",
          "word_slugs": [
            "frisches-adj"
          ]
        },
        {
          "id": "7247644",
          "text": "Frisches Brot mag jeder.",
          "translation": "Свежий хлеб все любят.",
          "source": "Tatoeba #7247644 @Pfirsichbaeumchen / #6855561 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7247644",
          "cefr_level": "A1",
          "word_slugs": [
            "frisches-adj"
          ]
        },
        {
          "id": "8320608",
          "text": "Sie essen frisches Obst.",
          "translation": "Они едят свежие фрукты.",
          "source": "Tatoeba #8320608 @MisterTrouser / #11835954 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320608",
          "cefr_level": "A1",
          "word_slugs": [
            "frisches-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
