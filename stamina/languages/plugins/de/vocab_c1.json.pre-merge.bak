    {
      "slug": "öffentlichen-adj",
      "lemma": "öffentlichen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5504,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of öffentlich:",
          "strong genitive masculine/neuter singular",
          "inflection of öffentlich:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8511146",
          "text": "Ich hasse die öffentlichen Verkehrsmittel.",
          "translation": "Ненавижу общественный транспорт.",
          "source": "Tatoeba #8511146 @Luiaard / #12394039 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8511146",
          "cefr_level": "A1",
          "word_slugs": [
            "öffentlichen-adj"
          ]
        },
        {
          "id": "8630545",
          "text": "Tom nutzt die öffentlichen Verkehrsmittel.",
          "translation": "Том пользуется общественным транспортом.",
          "source": "Tatoeba #8630545 @Pfirsichbaeumchen / #12394099 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8630545",
          "cefr_level": "A1",
          "word_slugs": [
            "öffentlichen-adj"
          ]
        },
        {
          "id": "2755872",
          "text": "Rauchen ist in allen öffentlichen Gebäuden verboten.",
          "translation": "Во всех общественных зданиях курение запрещено.",
          "source": "Tatoeba #2755872 @Pfirsichbaeumchen / #10341568 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2755872",
          "cefr_level": "A1",
          "word_slugs": [
            "öffentlichen-adj"
          ]
        },
        {
          "id": "2755869",
          "text": "Rauchen ist in allen öffentlichen Gebäuden untersagt.",
          "translation": "Во всех общественных зданиях курение запрещено.",
          "source": "Tatoeba #2755869 @Pfirsichbaeumchen / #10341568 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2755869",
          "cefr_level": "A1",
          "word_slugs": [
            "öffentlichen-adj"
          ]
        },
        {
          "id": "6542096",
          "text": "Wissen Sie, wie man dort mit öffentlichen Verkehrsmitteln hinkommt?",
          "translation": "Вы знаете, как добраться туда общественным транспортом?",
          "source": "Tatoeba #6542096 @raggione / #7669414 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6542096",
          "cefr_level": "A1",
          "word_slugs": [
            "öffentlichen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
