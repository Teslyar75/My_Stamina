    {
      "slug": "sternen-noun",
      "lemma": "Sternen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6735,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Stern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1104177",
          "text": "Dieses Buch handelt von Sternen.",
          "translation": "В этой книге говорится о звёздах.",
          "source": "Tatoeba #1104177 @Haehnchenpaella / #11147097 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1104177",
          "cefr_level": "A1",
          "word_slugs": [
            "sternen-noun"
          ]
        },
        {
          "id": "2819488",
          "text": "Sie schliefen unter den Sternen.",
          "translation": "Они спали под звёздами.",
          "source": "Tatoeba #2819488 @Pfirsichbaeumchen / #3363255 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2819488",
          "cefr_level": "A1",
          "word_slugs": [
            "sternen-noun"
          ]
        },
        {
          "id": "432561",
          "text": "Durch das Raue zu den Sternen.",
          "translation": "Через тернии - к звёздам.",
          "source": "Tatoeba #432561 @jerom / #736365 @JeNNeR (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/432561",
          "cefr_level": "A1",
          "word_slugs": [
            "sternen-noun"
          ]
        },
        {
          "id": "2819487",
          "text": "Wir haben unter den Sternen geschlafen.",
          "translation": "Мы ночевали под открытым небом.",
          "source": "Tatoeba #2819487 @Pfirsichbaeumchen / #5809826 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2819487",
          "cefr_level": "A1",
          "word_slugs": [
            "sternen-noun"
          ]
        },
        {
          "id": "415141",
          "text": "Astronomie handelt von Sternen und Planeten.",
          "translation": "Астрономия занимается звёздами и планетами.",
          "source": "Tatoeba #415141 @konny / #993207 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/415141",
          "cefr_level": "A1",
          "word_slugs": [
            "sternen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
