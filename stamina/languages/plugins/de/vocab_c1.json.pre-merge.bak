        ],
        "en": [
          "to fish"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1311362",
          "text": "Sie gingen fischen.",
          "translation": "Они пошли ловить рыбу.",
          "source": "Tatoeba #1311362 @Pfirsichbaeumchen / #2518554 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1311362",
          "cefr_level": "A1",
          "word_slugs": [
            "fischen-verb"
          ]
        },
        {
          "id": "707486",
          "text": "Mein Vater ging fischen.",
          "translation": "Мой отец ушел на рыбалку.",
          "source": "Tatoeba #707486 @comrad / #467626 @Miko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/707486",
          "cefr_level": "A1",
          "word_slugs": [
            "fischen-verb"
          ]
        },
        {
          "id": "13767803",
          "text": "Ich ging heute nicht fischen.",
          "translation": "Я сегодня не пошёл на рыбалку.",
          "source": "Tatoeba #13767803 @Naina / #13770148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13767803",
          "cefr_level": "A1",
          "word_slugs": [
            "fischen-verb"
          ]
        },
        {
          "id": "477138",
          "text": "Ich ging oft mit ihm fischen.",
          "translation": "Я часто ходил с ним на рыбалку.",
          "source": "Tatoeba #477138 @Ullalia / #8299624 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/477138",
          "cefr_level": "A1",
          "word_slugs": [
            "fischen-verb"
          ]
        },
        {
          "id": "13767802",
          "text": "Ich bin heute nicht fischen gegangen.",
          "translation": "Я сегодня не пошёл на рыбалку.",
          "source": "Tatoeba #13767802 @Naina / #13770148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13767802",
          "cefr_level": "A1",
          "word_slugs": [
            "fischen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
