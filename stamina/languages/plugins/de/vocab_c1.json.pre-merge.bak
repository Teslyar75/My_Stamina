    {
      "slug": "ameisen-noun",
      "lemma": "Ameisen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8919,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Ameise"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12281760",
          "text": "Ich mag Ameisen.",
          "translation": "Мне нравятся муравьи.",
          "source": "Tatoeba #12281760 @mhr / #4069176 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12281760",
          "cefr_level": "A1",
          "word_slugs": [
            "ameisen-noun"
          ]
        },
        {
          "id": "1848291",
          "text": "Haben Ameisen Ohren?",
          "translation": "У муравьев есть уши?",
          "source": "Tatoeba #1848291 @Tlustulimu / #1848299 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1848291",
          "cefr_level": "A1",
          "word_slugs": [
            "ameisen-noun"
          ]
        },
        {
          "id": "13091574",
          "text": "Grünspechte lieben Ameisen.",
          "translation": "Зелёные дятлы любят муравьёв.",
          "source": "Tatoeba #13091574 @Adelpa / #13091617 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13091574",
          "cefr_level": "A1",
          "word_slugs": [
            "ameisen-noun"
          ]
        },
        {
          "id": "2025774",
          "text": "Zucker zieht Ameisen an.",
          "translation": "Сахар привлекает муравьёв.",
          "source": "Tatoeba #2025774 @Pfirsichbaeumchen / #2616420 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2025774",
          "cefr_level": "A1",
          "word_slugs": [
            "ameisen-noun"
          ]
        },
        {
          "id": "5329721",
          "text": "Zertritt die Ameisen nicht!",
          "translation": "Не топчи муравьёв!",
          "source": "Tatoeba #5329721 @Manfredo / #10118410 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5329721",
          "cefr_level": "A1",
          "word_slugs": [
            "ameisen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
