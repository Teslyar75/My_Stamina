    {
      "slug": "angelegt-verb",
      "lemma": "angelegt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7122,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
