    {
      "slug": "rückseite-noun",
      "lemma": "Rückseite",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8279,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "оборот",
          "обратная сторона",
          "тыл"
        ],
        "en": [
          "back, reverse side"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1737281",
          "text": "Schreibe die Absenderadresse auf die Rückseite!",
          "translation": "Напиши на обратной стороне адрес отправителя.",
          "source": "Tatoeba #1737281 @al_ex_an_der / #4942506 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1737281",
          "cefr_level": "A1",
          "word_slugs": [
            "rückseite-noun"
          ]
        },
        {
          "id": "3127715",
          "text": "Ich schrieb die Adresse auf die Rückseite des Umschlags.",
          "translation": "Я написал адрес на обратной стороне конверта.",
          "source": "Tatoeba #3127715 @samueldora / #7815177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3127715",
          "cefr_level": "A1",
          "word_slugs": [
            "rückseite-noun"
          ]
        },
        {
          "id": "2497371",
          "text": "Auf der Rückseite des Mondes gibt es einen geheimen Stützpunkt.",
          "translation": "На обратной стороне Луны есть секретная база.",
          "source": "Tatoeba #2497371 @Pfirsichbaeumchen / #2495387 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2497371",
          "cefr_level": "A1",
          "word_slugs": [
            "rückseite-noun"
          ]
        },
        {
          "id": "367889",
          "text": "Ich habe seine Adresse auf die Rückseite des Briefumschlags geschrieben.",
          "translation": "Я написал его адрес на обратной стороне конверта.",
          "source": "Tatoeba #367889 @lilygilder / #2752842 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/367889",
          "cefr_level": "A1",
          "word_slugs": [
            "rückseite-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
