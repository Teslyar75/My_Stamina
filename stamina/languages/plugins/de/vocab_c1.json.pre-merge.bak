      },
      "gender": null,
      "examples": [
        {
          "id": "8594754",
          "text": "Alle trugen Handschuhe.",
          "translation": "Все были в перчатках.",
          "source": "Tatoeba #8594754 @Pfirsichbaeumchen / #8594797 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8594754",
          "cefr_level": "A1",
