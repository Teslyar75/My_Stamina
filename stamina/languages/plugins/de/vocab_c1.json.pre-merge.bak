    {
      "slug": "wirklichen-adj",
      "lemma": "wirklichen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9854,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of wirklich:",
          "strong genitive masculine/neuter singular",
          "inflection of wirklich:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12650941",
          "text": "Den wirklichen Grund kennt keiner.",
          "translation": "Истинной причины не знает никто.",
          "source": "Tatoeba #12650941 @Waldelfe / #12650880 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12650941",
          "cefr_level": "A1",
          "word_slugs": [
            "wirklichen-adj"
          ]
        },
        {
          "id": "7789070",
          "text": "Ich weiß nicht, wer meine wirklichen Eltern sind.",
          "translation": "Я не знаю, кто мои настоящие родители.",
          "source": "Tatoeba #7789070 @raggione / #6146013 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7789070",
          "cefr_level": "A1",
          "word_slugs": [
            "wirklichen-adj"
          ]
        },
        {
          "id": "8871306",
          "text": "Ich weiß nicht, was seine wirklichen Absichten waren.",
          "translation": "Я не знаю, каковы были его истинные намерения.",
          "source": "Tatoeba #8871306 @mramosch / #8880488 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8871306",
          "cefr_level": "A1",
          "word_slugs": [
            "wirklichen-adj"
          ]
        },
        {
          "id": "2219494",
          "text": "Das hat nichts mit dem wirklichen Leben zu tun.",
          "translation": "Это не имеет никакого отношения к реальной жизни.",
          "source": "Tatoeba #2219494 @Zaghawa / #3169595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2219494",
          "cefr_level": "A1",
          "word_slugs": [
            "wirklichen-adj"
          ]
        },
        {
          "id": "1075798",
          "text": "Jede Ähnlichkeit mit wirklichen Menschen, lebendig oder tot, ist reiner Zufall.",
          "translation": "Любое сходство с реальными людьми, ныне живущими или умершими, является случайным.",
          "source": "Tatoeba #1075798 @Esperantostern / #12835526 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1075798",
          "cefr_level": "A1",
          "word_slugs": [
            "wirklichen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
