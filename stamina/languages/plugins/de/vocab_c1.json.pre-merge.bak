    {
      "slug": "bräutigam-noun",
      "lemma": "Bräutigam",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7015,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "bridegroom (a man with regard to his wedding)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8634583",
          "text": "Er ist der Bräutigam.",
          "translation": "Он жених.",
          "source": "Tatoeba #8634583 @Melang / #8640297 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634583",
          "cefr_level": "A1",
          "word_slugs": [
            "bräutigam-noun"
          ]
        },
        {
          "id": "8634587",
          "text": "Braut und Bräutigam treten gemeinsam vor den Altar.",
          "translation": "Жених и невеста предстают перед алтарём.",
          "source": "Tatoeba #8634587 @Melang / #8640296 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634587",
          "cefr_level": "A1",
          "word_slugs": [
            "bräutigam-noun"
          ]
        },
        {
          "id": "1818373",
          "text": "Der Bräutigam ließ die Braut vor dem Altar stehen.",
          "translation": "Жених бросил невесту перед алтарём.",
          "source": "Tatoeba #1818373 @Pfirsichbaeumchen / #8291051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1818373",
          "cefr_level": "A1",
          "word_slugs": [
            "bräutigam-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
