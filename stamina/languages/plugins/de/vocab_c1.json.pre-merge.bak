          ]
        },
        {
          "id": "1546085",
          "text": "Er hat sich gestern beim Wettkampf verletzt.",
          "translation": "Вчера он травмировался на соревнованиях.",
          "source": "Tatoeba #1546085 @Pfirsichbaeumchen / #6680425 @alina88 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1546085",
          "cefr_level": "A1",
          "word_slugs": [
            "wettkampf-noun"
          ]
        },
        {
          "id": "8234125",
          "text": "Wir haben uns einige Wochen auf den Wettkampf vorbereitet.",
          "translation": "Мы готовились к конкурсу несколько недель.",
          "source": "Tatoeba #8234125 @Pfirsichbaeumchen / #6403647 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8234125",
          "cefr_level": "A1",
          "word_slugs": [
            "wettkampf-noun"
          ]
        }
      ],
