      },
      "gender": null,
      "examples": [
        {
          "id": "13602594",
          "text": "Das ist die heutige Zeitung.",
          "translation": "Это сегодняшняя газета.",
          "source": "Tatoeba #13602594 @mhr / #3287464 @Shady_arc (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13602594",
          "cefr_level": "A1",
          "word_slugs": [
            "heutige-adj"
          ]
        },
        {
          "id": "13602595",
          "text": "Ist das die heutige Zeitung?",
          "translation": "Это сегодняшняя газета?",
          "source": "Tatoeba #13602595 @mhr / #1352480 @arseniiv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13602595",
          "cefr_level": "A1",
          "word_slugs": [
            "heutige-adj"
          ]
        },
        {
          "id": "1819145",
          "text": "Heutige Katzen fressen keine Mäuse.",
          "translation": "Современные кошки не едят мышей.",
          "source": "Tatoeba #1819145 @pne / #2765244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1819145",
          "cefr_level": "A1",
          "word_slugs": [
            "heutige-adj"
          ]
        },
        {
          "id": "2334935",
          "text": "Das heutige Spiel ist entscheidend.",
          "translation": "Сегодняшняя игра — решающая.",
          "source": "Tatoeba #2334935 @freddy1 / #2419748 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2334935",
          "cefr_level": "A1",
          "word_slugs": [
            "heutige-adj"
          ]
        },
        {
          "id": "698207",
