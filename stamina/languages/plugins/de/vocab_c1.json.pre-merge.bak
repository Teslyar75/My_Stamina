    {
      "slug": "figuren-noun",
      "lemma": "Figuren",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6320,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Figur"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1946657",
          "text": "Welche geometrischen Figuren haben wir bereits untersucht?",
          "translation": "Какие геометрические фигуры нами уже изучены?",
          "source": "Tatoeba #1946657 @al_ex_an_der / #1946656 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1946657",
          "cefr_level": "A1",
          "word_slugs": [
            "figuren-noun"
          ]
        },
        {
          "id": "11092834",
          "text": "Die meisten Figuren im Anime haben große Augen.",
          "translation": "У большинства персонажей аниме большие глаза.",
          "source": "Tatoeba #11092834 @Pfirsichbaeumchen / #5687345 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11092834",
          "cefr_level": "A1",
          "word_slugs": [
            "figuren-noun"
          ]
        },
        {
          "id": "1946659",
          "text": "Welche geometrischen Figuren wurden von uns bereits untersucht?",
          "translation": "Какие геометрические фигуры нами уже изучены?",
          "source": "Tatoeba #1946659 @al_ex_an_der / #1946656 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1946659",
          "cefr_level": "A1",
          "word_slugs": [
            "figuren-noun"
          ]
        },
        {
          "id": "6012844",
          "text": "Um uns herum gibt es viele verschiedene geometrische Figuren.",
          "translation": "Вокруг нас много различных геометрических фигур.",
          "source": "Tatoeba #6012844 @Esperantostern / #1881978 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6012844",
          "cefr_level": "A1",
          "word_slugs": [
            "figuren-noun"
          ]
        },
        {
          "id": "3552952",
          "text": "Marias Bilder zeigen oft Figuren inmitten eines dichten Nebels.",
          "translation": "На картинах Марии часто изображены фигуры среди густого тумана.",
          "source": "Tatoeba #3552952 @al_ex_an_der / #3553102 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3552952",
          "cefr_level": "A1",
          "word_slugs": [
            "figuren-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
