    {
      "slug": "zellen-noun",
      "lemma": "Zellen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5140,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Zelle"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1650787",
          "text": "Neuronen sind Zellen.",
          "translation": "Нейроны - это клетки.",
          "source": "Tatoeba #1650787 @marcelostockle / #10227093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1650787",
          "cefr_level": "A1",
          "word_slugs": [
            "zellen-noun"
          ]
        },
        {
          "id": "13652736",
          "text": "Unser Körper besteht aus Zellen.",
          "translation": "Наше тело состоит из клеток.",
          "source": "Tatoeba #13652736 @mhr / #12262648 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13652736",
          "cefr_level": "A1",
          "word_slugs": [
            "zellen-noun"
          ]
        },
        {
          "id": "6322422",
          "text": "Unsere Körper bestehen aus Zellen.",
          "translation": "Наши тела состоят из клеток.",
          "source": "Tatoeba #6322422 @raggione / #6319470 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6322422",
          "cefr_level": "A1",
          "word_slugs": [
            "zellen-noun"
          ]
        },
        {
          "id": "364464",
          "text": "Ein menschlicher Körper besteht aus unzähligen Zellen.",
          "translation": "Человеческое тело состоит из бесчисленного количества клеток.",
          "source": "Tatoeba #364464 @Wolf / #1799417 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/364464",
          "cefr_level": "A1",
          "word_slugs": [
            "zellen-noun"
          ]
        },
        {
          "id": "729100",
          "text": "Der menschliche Körper besteht aus Milliarden kleiner Zellen.",
          "translation": "Тело человека состоит из миллиардов мельчайших клеток.",
          "source": "Tatoeba #729100 @Manfredo / #3863994 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/729100",
          "cefr_level": "A1",
          "word_slugs": [
            "zellen-noun"
          ]
        }
      ],
