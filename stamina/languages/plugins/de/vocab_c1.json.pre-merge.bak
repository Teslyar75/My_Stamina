    {
      "slug": "geniesst-verb",
      "lemma": "genießt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5079,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of geniessen:",
