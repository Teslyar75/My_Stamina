    {
      "slug": "gehandelt-verb",
      "lemma": "gehandelt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6218,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of handeln"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13972812",
          "text": "Sie haben nicht schnell gehandelt.",
          "translation": "Действовали они не быстро.",
          "source": "Tatoeba #13972812 @AaronAardvark / #13973455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13972812",
          "cefr_level": "A1",
          "word_slugs": [
            "gehandelt-verb"
          ]
        },
        {
          "id": "10040774",
          "text": "Ein wahrer Freund hätte anders gehandelt.",
          "translation": "Настоящий друг поступил бы по-другому.",
          "source": "Tatoeba #10040774 @Pfirsichbaeumchen / #5727108 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10040774",
          "cefr_level": "A1",
          "word_slugs": [
            "gehandelt-verb"
          ]
        },
        {
          "id": "3105993",
          "text": "Sie haben verantwortungslos und unprofessionell gehandelt.",
          "translation": "Вы действовали безответственно и непрофессионально.",
          "source": "Tatoeba #3105993 @al_ex_an_der / #3105995 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3105993",
          "cefr_level": "A1",
          "word_slugs": [
            "gehandelt-verb"
          ]
        },
        {
          "id": "13084954",
          "text": "An meiner Stelle hätten Sie genauso gehandelt.",
          "translation": "На моём месте вы поступили бы так же.",
          "source": "Tatoeba #13084954 @Waldelfe / #7097156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13084954",
          "cefr_level": "A1",
          "word_slugs": [
            "gehandelt-verb"
          ]
        },
        {
          "id": "13084955",
          "text": "An meiner Stelle hättest du genauso gehandelt.",
          "translation": "На моём месте ты поступил бы так же.",
          "source": "Tatoeba #13084955 @Waldelfe / #7097153 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13084955",
          "cefr_level": "A1",
          "word_slugs": [
            "gehandelt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
