    {
      "slug": "begannen-verb",
      "lemma": "begannen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7325,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person plural preterite of beginnen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6134019",
          "text": "Wir begannen frühmorgens.",
          "translation": "Мы начали рано утром.",
          "source": "Tatoeba #6134019 @Espi / #11042395 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6134019",
          "cefr_level": "A1",
          "word_slugs": [
            "begannen-verb"
          ]
        },
        {
          "id": "11504166",
          "text": "Wir begannen zu singen.",
          "translation": "Мы запели.",
          "source": "Tatoeba #11504166 @Adelpa / #4858716 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11504166",
          "cefr_level": "A1",
          "word_slugs": [
            "begannen-verb"
          ]
        },
        {
          "id": "3074447",
          "text": "Wir begannen zu sprechen.",
          "translation": "Мы начали говорить.",
          "source": "Tatoeba #3074447 @faehrmann / #2589526 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3074447",
          "cefr_level": "A1",
          "word_slugs": [
            "begannen-verb"
          ]
        },
        {
          "id": "3766427",
          "text": "Sie begannen beide zu kichern.",
          "translation": "Они оба захихикали.",
          "source": "Tatoeba #3766427 @Jens_Odo / #3282120 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3766427",
          "cefr_level": "A1",
          "word_slugs": [
            "begannen-verb"
          ]
        },
        {
          "id": "12220936",
          "text": "Die Mädchen begannen zu lachen.",
          "translation": "Девочки засмеялись.",
          "source": "Tatoeba #12220936 @mhr / #4865863 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12220936",
          "cefr_level": "A1",
          "word_slugs": [
            "begannen-verb"
          ]
        }
      ],
