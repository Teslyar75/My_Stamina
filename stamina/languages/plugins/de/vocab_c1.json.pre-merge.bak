    {
      "slug": "galaxie-noun",
      "lemma": "Galaxie",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6698,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "галактика"
        ],
        "en": [
          "galaxy (huge gravitationally bound system of stars)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "900242",
          "text": "Unsere Galaxie wird Milchstraße genannt.",
          "translation": "Наша галактика называется Млечный Путь.",
          "source": "Tatoeba #900242 @Espi / #2130223 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/900242",
          "cefr_level": "A1",
          "word_slugs": [
            "galaxie-noun"
          ]
        },
        {
          "id": "8984905",
          "text": "Sie flogen durch die gesamte Galaxie.",
          "translation": "Они облетели всю Галактику.",
          "source": "Tatoeba #8984905 @carlosalberto / #4513846 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8984905",
          "cefr_level": "A1",
          "word_slugs": [
            "galaxie-noun"
          ]
        },
        {
          "id": "13518709",
          "text": "Wie viele Exoplaneten hat unsere Galaxie?",
          "translation": "Сколько в нашей галактике экзопланет?",
          "source": "Tatoeba #13518709 @Vortarulo / #13518712 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13518709",
          "cefr_level": "A1",
          "word_slugs": [
            "galaxie-noun"
          ]
        },
        {
          "id": "14052409",
          "text": "Eine einzige Chance ist eine Galaxie der Hoffnung.",
          "translation": "Единственный шанс - это целая галактика надежды.",
          "source": "Tatoeba #14052409 @Waldelfe / #10123817 @dimitris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14052409",
          "cefr_level": "A1",
          "word_slugs": [
            "galaxie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
