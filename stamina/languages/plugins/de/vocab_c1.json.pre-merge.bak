          ]
        },
        {
          "id": "2489128",
          "text": "Tom hat sich ein chinesisch-japanisches Wörterbuch gekauft.",
          "translation": "Том купил китайско-японский словарь.",
          "source": "Tatoeba #2489128 @Pfirsichbaeumchen / #2489411 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2489128",
