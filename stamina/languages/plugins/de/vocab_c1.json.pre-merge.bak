      "frequency_rank": 6895,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "глотать",
          "проглатывать"
        ],
        "en": [
          "to swallow",
          "to gulp (swallow one's spittle out of fear etc.)",
          "to gobble up (annex, e.g. another company)",
          "to swallow; to accept; to put up with"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5238768",
          "text": "Tom muss die bittere Pille schlucken.",
          "translation": "Том должен проглотить эту горькую пилюлю.",
          "source": "Tatoeba #5238768 @Adelpa / #13881175 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5238768",
          "cefr_level": "A1",
          "word_slugs": [
