    {
      "slug": "philosophie-noun",
      "lemma": "Philosophie",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7598,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "philosophy (study of thought)",
          "philosophy (study of thought)",
          "name of the school subject taken by pupils who choose not to attend religious education",
          "philosophy (one's manner of thinking)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10018746",
          "text": "Mein Hobby ist Philosophie.",
          "translation": "Моё хобби - философия.",
          "source": "Tatoeba #10018746 @Melang / #10018748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10018746",
          "cefr_level": "A1",
          "word_slugs": [
            "philosophie-noun"
          ]
        },
        {
          "id": "13768214",
          "text": "Wozu dient die Philosophie?",
          "translation": "Зачем нужна философия?",
          "source": "Tatoeba #13768214 @mhr / #6362585 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13768214",
          "cefr_level": "A1",
          "word_slugs": [
            "philosophie-noun"
          ]
        },
        {
          "id": "13005661",
          "text": "Ich habe meine eigene Philosophie.",
          "translation": "У меня своя собственная философия.",
          "source": "Tatoeba #13005661 @maaster / #13006549 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13005661",
          "cefr_level": "A1",
          "word_slugs": [
            "philosophie-noun"
          ]
        },
        {
          "id": "8643536",
          "text": "Tom interessiert sich für Philosophie.",
          "translation": "Том интересуется философией.",
          "source": "Tatoeba #8643536 @Melang / #13525133 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8643536",
          "cefr_level": "A1",
          "word_slugs": [
            "philosophie-noun"
          ]
        },
        {
          "id": "12859371",
          "text": "Das ist eine sehr bequeme Philosophie.",
          "translation": "Это очень удобная философия.",
          "source": "Tatoeba #12859371 @mhr / #12857921 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12859371",
          "cefr_level": "A1",
          "word_slugs": [
            "philosophie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
