    {
      "slug": "reiches-noun",
      "lemma": "Reiches",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9008,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Reich"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4895648",
          "text": "Was führte zum Untergang des Römischen Reiches?",
          "translation": "Что привело к падению Римской империи?",
          "source": "Tatoeba #4895648 @Pfirsichbaeumchen / #4943357 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4895648",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-noun"
          ]
        },
        {
          "id": "12738253",
          "text": "Die Hauptstadt des Bosporanischen Reiches war Pantikapaion.",
          "translation": "Столицей Боспорского царства был город Пантикапей.",
          "source": "Tatoeba #12738253 @Waldelfe / #12737078 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12738253",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-noun"
          ]
        },
        {
          "id": "3107520",
          "text": "Die Türkei ist der Erbe des Osmanischen Reiches.",
          "translation": "Турция - наследница Османской империи.",
          "source": "Tatoeba #3107520 @Manfredo / #12314481 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3107520",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-noun"
          ]
        },
        {
          "id": "10609070",
          "text": "Ich bin Milo, Herrscher des Reiches der Befellten!",
          "translation": "Я Майлз, владыка шерстяного царства!",
          "source": "Tatoeba #10609070 @Pfirsichbaeumchen / #10609076 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10609070",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-noun"
          ]
        },
        {
          "id": "10769128",
          "text": "Er erklärte sich zum Kaiser des Deutschen Reiches.",
          "translation": "Он провозгласил себя кайзером Германской империи.",
          "source": "Tatoeba #10769128 @Yorwba / #10774249 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10769128",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "reiches-adj",
      "lemma": "reiches",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9008,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of reich"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "568382",
          "text": "Japan ist ein reiches Land.",
          "translation": "Япония — богатая страна.",
          "source": "Tatoeba #568382 @Zaghawa / #568422 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/568382",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-adj"
          ]
        },
        {
          "id": "9062269",
          "text": "Maria ist ein reiches Mädchen.",
          "translation": "Мэри богатая девушка.",
          "source": "Tatoeba #9062269 @Pfirsichbaeumchen / #8658057 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9062269",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-adj"
          ]
        },
        {
          "id": "345556",
          "text": "Er hat ein reiches Mädchen geheiratet.",
          "translation": "Он женился на богатой девушке.",
          "source": "Tatoeba #345556 @MUIRIEL / #2077370 @sinichka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/345556",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-adj"
          ]
        },
        {
          "id": "7636833",
          "text": "Tom hat ein reiches Mädchen geheiratet.",
          "translation": "Том женился на богатой девушке.",
          "source": "Tatoeba #7636833 @wolfgangth / #5495471 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7636833",
          "cefr_level": "A1",
          "word_slugs": [
            "reiches-adj"
          ]
        }
      ],
