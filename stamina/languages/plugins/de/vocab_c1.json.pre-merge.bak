    {
      "slug": "vorname-noun",
      "lemma": "Vorname",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8371,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "given name (name chosen for a child by its parents)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2027467",
          "text": "Mir gefällt dein Vorname.",
          "translation": "Мне нравится твоё имя.",
          "source": "Tatoeba #2027467 @Tamy / #5680005 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2027467",
          "cefr_level": "A1",
          "word_slugs": [
            "vorname-noun"
          ]
        },
        {
          "id": "8720540",
          "text": "Maria ist mein dritter Vorname.",
          "translation": "Мэри - моё третье имя.",
          "source": "Tatoeba #8720540 @Pfirsichbaeumchen / #8720538 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8720540",
          "cefr_level": "A1",
          "word_slugs": [
            "vorname-noun"
          ]
        },
        {
          "id": "2085924",
          "text": "In Frankreich steht der Vorname vor dem Familiennamen.",
          "translation": "Во Франции имя идёт перед фамилией.",
          "source": "Tatoeba #2085924 @Zaghawa / #2813226 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2085924",
          "cefr_level": "A1",
          "word_slugs": [
            "vorname-noun"
          ]
        },
        {
          "id": "2672275",
          "text": "Der am häufigsten vorkommende Vorname der Welt ist Mohammed.",
          "translation": "Самое распространенное имя в мире - это Мохаммед.",
          "source": "Tatoeba #2672275 @Pfirsichbaeumchen / #2869783 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2672275",
          "cefr_level": "A1",
          "word_slugs": [
            "vorname-noun"
          ]
        },
        {
          "id": "13969831",
          "text": "Vorname? Familienname? Geburtsdatum und -ort?",
          "translation": "Имя? Фамилия? Дата и место рождения?",
          "source": "Tatoeba #13969831 @Vortarulo / #6893163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13969831",
          "cefr_level": "A1",
          "word_slugs": [
            "vorname-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
