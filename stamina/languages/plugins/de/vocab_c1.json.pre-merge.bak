    {
      "slug": "länge-noun",
      "lemma": "Länge",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9212,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "длина"
        ],
        "en": [
          "length",
          "longitude"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "442455",
          "text": "Maximale Länge: 200 Wörter.",
          "translation": "Максимальная длина: двести слов.",
          "source": "Tatoeba #442455 @MUIRIEL / #11250885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/442455",
          "cefr_level": "A1",
          "word_slugs": [
            "länge-noun"
          ]
        },
        {
          "id": "12272623",
          "text": "Die Länge der Brücke beträgt 100 Meter.",
          "translation": "Длина моста — 100 метров.",
          "source": "Tatoeba #12272623 @mhr / #889007 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12272623",
          "cefr_level": "A1",
          "word_slugs": [
            "länge-noun"
          ]
        },
        {
          "id": "719872",
          "text": "Die Länge dieses Schiffs beträgt 30 Meter.",
          "translation": "Длина этого судна - тридцать метров.",
          "source": "Tatoeba #719872 @kayro / #13439580 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/719872",
          "cefr_level": "A1",
          "word_slugs": [
            "länge-noun"
          ]
        },
        {
          "id": "1921061",
          "text": "Teilen Sie die Länge und Breite durch zehn.",
          "translation": "Разделите его длину и ширину на десять.",
          "source": "Tatoeba #1921061 @Tamy / #13823627 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1921061",
          "cefr_level": "A1",
          "word_slugs": [
            "länge-noun"
          ]
        },
        {
          "id": "719708",
          "text": "Heute haben Tag und Nacht die gleiche Länge.",
          "translation": "Сегодня день равен ночи.",
          "source": "Tatoeba #719708 @Manfredo / #12283367 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/719708",
          "cefr_level": "A1",
          "word_slugs": [
            "länge-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
