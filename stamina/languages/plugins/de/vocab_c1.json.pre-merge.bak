          ]
        },
        {
          "id": "12525566",
          "text": "Sie sind eine kluge Frau.",
          "translation": "Вы умная женщина.",
          "source": "Tatoeba #12525566 @Waldelfe / #12099559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12525566",
          "cefr_level": "A1",
          "word_slugs": [
            "kluge-adj"
          ]
        },
        {
          "id": "7419580",
          "text": "Maria ist eine kluge Frau.",
          "translation": "Мэри - умная женщина.",
          "source": "Tatoeba #7419580 @Pfirsichbaeumchen / #7425412 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7419580",
          "cefr_level": "A1",
          "word_slugs": [
            "kluge-adj"
          ]
        },
        {
          "id": "1704634",
          "text": "Das war eine kluge Entscheidung.",
          "translation": "Это было мудрое решение.",
          "source": "Tatoeba #1704634 @al_ex_an_der / #2792200 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1704634",
          "cefr_level": "A1",
          "word_slugs": [
            "kluge-adj"
          ]
        },
        {
          "id": "11672375",
          "text": "Papageien sind sehr kluge Vögel.",
          "translation": "Попугаи очень умные птицы.",
          "source": "Tatoeba #11672375 @Pfirsichbaeumchen / #5002085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11672375",
          "cefr_level": "A1",
