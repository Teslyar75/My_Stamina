    {
      "slug": "samuel-name",
      "lemma": "Samuel",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6606,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Samuel",
          "a male given name from Biblical Hebrew, equivalent to English Samuel"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5020203",
          "text": "Samuel, was tust du?",
          "translation": "Самуил, ты что делаешь?",
          "source": "Tatoeba #5020203 @UliDolbarge / #5021394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5020203",
          "cefr_level": "A1",
          "word_slugs": [
            "samuel-name"
          ]
        },
        {
          "id": "5020202",
          "text": "Samuel, was machst du?",
          "translation": "Самуил, ты что делаешь?",
          "source": "Tatoeba #5020202 @UliDolbarge / #5021394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5020202",
          "cefr_level": "A1",
          "word_slugs": [
            "samuel-name"
          ]
        },
        {
          "id": "5962747",
          "text": "Samuel hilft jedem, der ihn fragt.",
          "translation": "Самуэль помогает каждому, кто его попросит.",
          "source": "Tatoeba #5962747 @BlundaInte / #5962785 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5962747",
          "cefr_level": "A1",
          "word_slugs": [
            "samuel-name"
          ]
        },
        {
          "id": "507874",
          "text": "Samuel hilft allen, die ihn darum bitten.",
          "translation": "Сэмюэл помогает всем, кто его об этом просит.",
          "source": "Tatoeba #507874 @MUIRIEL / #2507391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/507874",
          "cefr_level": "A1",
          "word_slugs": [
            "samuel-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
