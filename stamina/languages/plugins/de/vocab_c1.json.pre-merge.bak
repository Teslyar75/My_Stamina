          ]
        },
        {
          "id": "784081",
          "text": "Er ist kein gewöhnlicher Schüler.",
          "translation": "Он не обычный ученик.",
          "source": "Tatoeba #784081 @Hans_Adler / #10806788 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/784081",
          "cefr_level": "A1",
          "word_slugs": [
            "gewöhnlicher-adj"
          ]
        },
        {
          "id": "4796586",
          "text": "Gestern war ein gewöhnlicher Tag.",
          "translation": "Вчера был обычный день.",
          "source": "Tatoeba #4796586 @Esperantostern / #13858274 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4796586",
          "cefr_level": "A1",
          "word_slugs": [
            "gewöhnlicher-adj"
          ]
        },
        {
          "id": "13458977",
          "text": "Es war ein ganz gewöhnlicher Tag.",
          "translation": "Это был самый обычный день.",
          "source": "Tatoeba #13458977 @mhr / #6385239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13458977",
          "cefr_level": "A1",
