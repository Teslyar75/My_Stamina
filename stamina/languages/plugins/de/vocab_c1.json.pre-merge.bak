    {
      "slug": "prüfungen-noun",
      "lemma": "Prüfungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8604,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Prüfung"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6573814",
          "text": "Wir lernen für die Prüfungen.",
          "translation": "Мы готовимся к экзаменам.",
          "source": "Tatoeba #6573814 @Pfirsichbaeumchen / #5790728 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6573814",
          "cefr_level": "A1",
          "word_slugs": [
            "prüfungen-noun"
          ]
        },
        {
          "id": "3530442",
          "text": "Du hast alle Prüfungen absolviert.",
          "translation": "Ты сдал все экзамены.",
          "source": "Tatoeba #3530442 @Zaghawa / #3584658 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3530442",
          "cefr_level": "A1",
          "word_slugs": [
            "prüfungen-noun"
          ]
        },
        {
          "id": "7218005",
          "text": "Die Prüfungen sind endlich vorbei.",
          "translation": "Экзамены наконец закончились.",
          "source": "Tatoeba #7218005 @Pfirsichbaeumchen / #6852413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7218005",
          "cefr_level": "A1",
          "word_slugs": [
            "prüfungen-noun"
          ]
        },
        {
          "id": "2624382",
          "text": "Tom hat Angst vor den Prüfungen.",
          "translation": "Том боится экзаменов.",
          "source": "Tatoeba #2624382 @Olya / #2624384 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2624382",
          "cefr_level": "A1",
          "word_slugs": [
            "prüfungen-noun"
          ]
        },
        {
          "id": "415",
          "text": "Ich denke, dass Prüfungen die Erziehung ruinieren.",
          "translation": "Я думаю, что экзамены портят образование.",
          "source": "Tatoeba #415 @MUIRIEL / #5625 @zmoo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/415",
          "cefr_level": "A1",
          "word_slugs": [
            "prüfungen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
