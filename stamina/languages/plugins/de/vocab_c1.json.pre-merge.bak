          "spoon",
          "hare's ear"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "785326",
          "text": "Ich mag Löffel.",
          "translation": "Мне нравятся ложки.",
          "source": "Tatoeba #785326 @Pfirsichbaeumchen / #4509785 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/785326",
          "cefr_level": "A1",
          "word_slugs": [
            "löffel-noun"
          ]
        },
        {
          "id": "7133097",
          "text": "Drei Löffel fehlen.",
          "translation": "Не хватает трёх ложек.",
          "source": "Tatoeba #7133097 @raggione / #10189478 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7133097",
          "cefr_level": "A1",
          "word_slugs": [
            "löffel-noun"
          ]
        },
        {
          "id": "749709",
          "text": "Gib mir den Löffel.",
