    {
      "slug": "ober-noun",
      "lemma": "Ober",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9420,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "официант",
          "дама",
          "старший валет"
        ],
        "en": [
          "waiter (usually the head waiter, but sometimes any waiter)",
          "over knave, queen"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6967227",
          "text": "Herr Ober, wir würden gern zahlen!",
          "translation": "Официант, мы хотели бы заплатить!",
          "source": "Tatoeba #6967227 @felix63 / #8548264 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6967227",
          "cefr_level": "A1",
          "word_slugs": [
            "ober-noun"
          ]
        },
        {
          "id": "1544464",
          "text": "Herr Ober, ich benötige ein Messer.",
          "translation": "Официант, мне нужен нож.",
          "source": "Tatoeba #1544464 @Esperantostern / #1542599 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1544464",
          "cefr_level": "A1",
          "word_slugs": [
            "ober-noun"
          ]
        },
        {
          "id": "634782",
          "text": "Herr Ober! Bringen Sie mir bitte Wasser.",
          "translation": "Официант, принесите мне воды, пожалуйста.",
          "source": "Tatoeba #634782 @Dejo / #2242893 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/634782",
          "cefr_level": "A1",
          "word_slugs": [
            "ober-noun"
          ]
        },
        {
          "id": "2752547",
          "text": "Das britische Parlament besteht aus dem Ober- und dem Unterhaus.",
          "translation": "Британский Парламент состоит из Палаты лордов и Палаты общин.",
          "source": "Tatoeba #2752547 @Pfirsichbaeumchen / #2752486 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2752547",
          "cefr_level": "A1",
          "word_slugs": [
            "ober-noun"
          ]
        },
        {
          "id": "2752548",
          "text": "Das britische Parlament teilt sich in das Ober- und das Unterhaus auf.",
          "translation": "Британский Парламент разделён на Палату лордов и Палату общин.",
          "source": "Tatoeba #2752548 @Pfirsichbaeumchen / #2752469 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2752548",
          "cefr_level": "A1",
          "word_slugs": [
            "ober-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
