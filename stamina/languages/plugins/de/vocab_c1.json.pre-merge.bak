    {
      "slug": "wurm-noun",
      "lemma": "Wurm",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7057,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "worm",
          "maggot, grub",
          "any crawling animal, e.g. a reptile",
          "dragon, lindworm, wyrm"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "12183754",
          "text": "Tom zerquetschte den Wurm.",
          "translation": "Том раздавил червяка.",
          "source": "Tatoeba #12183754 @petersauer / #6163377 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12183754",
          "cefr_level": "A1",
          "word_slugs": [
            "wurm-noun"
          ]
        },
        {
          "id": "1734284",
          "text": "Er windet sich wie ein Wurm.",
          "translation": "Он извивается как червяк.",
          "source": "Tatoeba #1734284 @Esperantostern / #6386378 @xmoffx (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1734284",
          "cefr_level": "A1",
          "word_slugs": [
            "wurm-noun"
          ]
        },
        {
          "id": "871945",
          "text": "Der Wurm ist unter der Haut als schmerzhafter Strang palpierbar.",
          "translation": "Червь под кожей прощупывается как болезненный тяж.",
          "source": "Tatoeba #871945 @esocom / #1521351 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/871945",
          "cefr_level": "A1",
          "word_slugs": [
            "wurm-noun"
          ]
        },
        {
          "id": "871947",
          "text": "Versuchen Sie den Wurm herauszuziehen, indem Sie ihn auf ein Streichhölzchen drehen.",
          "translation": "Попытайтесь удалить червя, наматывая его на спичку.",
          "source": "Tatoeba #871947 @esocom / #1464881 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/871947",
          "cefr_level": "A1",
          "word_slugs": [
            "wurm-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Wurm",
        "nominative_pl": ""
      }
    },
