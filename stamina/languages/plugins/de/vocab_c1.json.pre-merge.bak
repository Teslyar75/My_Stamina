    {
      "slug": "bewundern-verb",
      "lemma": "bewundern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7862,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "восхищаться ( восхититься )"
        ],
        "en": [
          "to admire, to highly respect (something of high quality)",
          "to admire oneself (e.g. in a mirror), to preen oneself (look at oneself lengthily, perhaps making minor adjustments)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2999867",
          "text": "Viele bewundern ihn.",
          "translation": "Многие восхищаются им.",
          "source": "Tatoeba #2999867 @pne / #4863711 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2999867",
          "cefr_level": "A1",
          "word_slugs": [
            "bewundern-verb"
          ]
        },
        {
          "id": "2804559",
          "text": "Alle bewundern Henry.",
          "translation": "Все восхищаются Генри.",
          "source": "Tatoeba #2804559 @freddy1 / #4863710 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2804559",
          "cefr_level": "A1",
          "word_slugs": [
            "bewundern-verb"
          ]
        },
        {
          "id": "3847693",
          "text": "Sie bewundern einander.",
          "translation": "Они восхищаются друг другом.",
          "source": "Tatoeba #3847693 @raggione / #1601547 @mutternoise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3847693",
          "cefr_level": "A1",
          "word_slugs": [
            "bewundern-verb"
          ]
        },
        {
          "id": "13745252",
          "text": "Wir bewundern ihren Mut.",
          "translation": "Мы восхищаемся её храбростью.",
          "source": "Tatoeba #13745252 @mhr / #13745232 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13745252",
          "cefr_level": "A1",
          "word_slugs": [
            "bewundern-verb"
          ]
        },
        {
          "id": "13745255",
          "text": "Wir bewundern seinen Mut.",
          "translation": "Мы восхищаемся его храбростью.",
          "source": "Tatoeba #13745255 @mhr / #13745231 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13745255",
          "cefr_level": "A1",
