      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9987,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to keep, stick to, follow, observe, maintain, abide by, comply with",
          "an appointment, promise etc.",
          "to keep, stick to, follow, observe, maintain, abide by, comply with",
          "a plan, course, speed etc."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2362597",
          "text": "Sie müssen strenge Bettruhe einhalten.",
          "translation": "Вы должны соблюдать строгий постельный режим",
          "source": "Tatoeba #2362597 @nimfeo / #13937047 @belka_strelka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2362597",
          "cefr_level": "A1",
          "word_slugs": [
            "einhalten-verb"
          ]
        },
        {
          "id": "11182317",
          "text": "Wir müssen die Verkehrsregeln einhalten.",
          "translation": "Мы должны соблюдать правила уличного движения",
          "source": "Tatoeba #11182317 @Boshnjanin / #13937044 @belka_strelka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11182317",
          "cefr_level": "A1",
          "word_slugs": [
            "einhalten-verb"
          ]
        },
        {
          "id": "6761078",
          "text": "Es gibt Regeln; die muss man einhalten, sonst bricht Chaos aus.",
          "translation": "Есть правила, их нужно выполнять. Иначе наступит хаос.",
          "source": "Tatoeba #6761078 @Pfirsichbaeumchen / #6177060 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6761078",
          "cefr_level": "A1",
          "word_slugs": [
            "einhalten-verb"
          ]
        },
        {
          "id": "10274190",
          "text": "Wenn man anderthalb Meter nicht einhalten kann, muss man eine Maske tragen.",
          "translation": "Если вы не можете соблюдать дистанцию в полтора метра, вы должны носить маску.",
          "source": "Tatoeba #10274190 @kotik / #10274194 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10274190",
          "cefr_level": "A1",
          "word_slugs": [
            "einhalten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
