    {
      "slug": "taktik-noun",
      "lemma": "Taktik",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9010,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "tactics, strategy (art of anticipation and planning)",
          "tactic, strategy, policy (plan, approach)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9402786",
          "text": "Sie wechselte die Taktik.",
          "translation": "Она изменила тактику.",
          "source": "Tatoeba #9402786 @Yorwba / #9461478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9402786",
          "cefr_level": "A1",
          "word_slugs": [
            "taktik-noun"
          ]
        },
        {
          "id": "2421304",
          "text": "Seine Taktik ist mehr als durchsichtig.",
          "translation": "Его тактика более чем прозрачна.",
          "source": "Tatoeba #2421304 @al_ex_an_der / #2421315 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2421304",
          "cefr_level": "A1",
          "word_slugs": [
            "taktik-noun"
          ]
        },
        {
          "id": "2421277",
          "text": "Er glaubt, ich durchschaue seine Taktik nicht.",
          "translation": "Он считает, что я не понимаю его тактику.",
          "source": "Tatoeba #2421277 @al_ex_an_der / #2421291 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2421277",
          "cefr_level": "A1",
          "word_slugs": [
            "taktik-noun"
          ]
        },
        {
          "id": "4800256",
          "text": "Niemand weiß, welche Taktik sie anwenden werden.",
          "translation": "Никто не знает, какую тактику они применят.",
          "source": "Tatoeba #4800256 @al_ex_an_der / #13454172 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4800256",
          "cefr_level": "A1",
          "word_slugs": [
            "taktik-noun"
          ]
        },
        {
          "id": "3071310",
          "text": "Hier ist eine neue militärische Taktik zu erkennen: die Charmeoffensive.",
          "translation": "Вот новая военная тактика для сведения: атака обаянием.",
          "source": "Tatoeba #3071310 @al_ex_an_der / #3071846 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3071310",
          "cefr_level": "A1",
          "word_slugs": [
            "taktik-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
