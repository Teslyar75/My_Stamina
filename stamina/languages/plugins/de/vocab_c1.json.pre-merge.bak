    {
      "slug": "vollen-adj",
      "lemma": "vollen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6017,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of voll:",
          "strong genitive masculine/neuter singular",
          "inflection of voll:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12499114",
          "text": "Könnten Sie Ihren vollen Namen nennen?",
          "translation": "Не могли бы вы назвать своё полное имя?",
          "source": "Tatoeba #12499114 @Waldelfe / #12499106 @scriptin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12499114",
          "cefr_level": "A1",
          "word_slugs": [
            "vollen-adj"
          ]
        },
        {
          "id": "369984",
          "text": "Pass in vollen Zügen auf Taschendiebe auf.",
          "translation": "Берегись карманников в переполненных поездах.",
          "source": "Tatoeba #369984 @Wolf / #4767987 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/369984",
          "cefr_level": "A1",
          "word_slugs": [
            "vollen-adj"
          ]
        },
        {
          "id": "8108940",
          "text": "Wiederholung ist die Mutter der vollen Fertigkeit.",
          "translation": "Повторение — мать учения.",
          "source": "Tatoeba #8108940 @kutschektar / #981758 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8108940",
          "cefr_level": "A1",
          "word_slugs": [
            "vollen-adj"
          ]
        },
        {
          "id": "5711501",
          "text": "Trotz seines vollen Terminkalenders findet Tom immer Zeit für seine Kinder.",
          "translation": "Несмотря на свой плотный график, Том всегда находит время для своих детей.",
          "source": "Tatoeba #5711501 @Pfirsichbaeumchen / #4479594 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5711501",
          "cefr_level": "A1",
          "word_slugs": [
            "vollen-adj"
          ]
        },
        {
          "id": "1446039",
          "text": "Redefreiheit gibt niemandem das Recht, in einem vollen Theater \"Feuer\" zu rufen.",
          "translation": "Свобода слова не даёт права кричать \"Пожар!\" в переполненном театре.",
          "source": "Tatoeba #1446039 @Esperantostern / #11147863 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1446039",
          "cefr_level": "A1",
          "word_slugs": [
            "vollen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
