    {
      "slug": "beherrschen-verb",
      "lemma": "beherrschen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5043,
      "frequency_band": "goethe-c1",
      "translations": {
