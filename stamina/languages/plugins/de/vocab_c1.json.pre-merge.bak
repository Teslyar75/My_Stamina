    {
      "slug": "auswirkungen-noun",
      "lemma": "Auswirkungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7788,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Auswirkung"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8825371",
          "text": "Das Klima hatte Auswirkungen auf ihre Gesundheit.",
          "translation": "Климат сказался на их здоровье.",
          "source": "Tatoeba #8825371 @mramosch / #13468109 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8825371",
          "cefr_level": "A1",
          "word_slugs": [
            "auswirkungen-noun"
          ]
        },
        {
          "id": "8825372",
          "text": "Das Klima hatte Auswirkungen auf Ihre Gesundheit.",
          "translation": "Климат сказался на Вашем здоровье.",
          "source": "Tatoeba #8825372 @mramosch / #13468110 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8825372",
          "cefr_level": "A1",
          "word_slugs": [
            "auswirkungen-noun"
          ]
        },
        {
          "id": "8825334",
          "text": "Das Klima hatte Auswirkungen auf seine Gesundheit.",
          "translation": "Климат сказался на его здоровье.",
          "source": "Tatoeba #8825334 @mramosch / #11621137 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8825334",
          "cefr_level": "A1",
          "word_slugs": [
            "auswirkungen-noun"
          ]
        },
        {
          "id": "4802232",
          "text": "Es war an sich unbedeutend, hatte jedoch unermessliche Auswirkungen.",
          "translation": "Само по себе это мало что значило, но последствия были колоссальны.",
          "source": "Tatoeba #4802232 @al_ex_an_der / #10473481 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4802232",
          "cefr_level": "A1",
          "word_slugs": [
            "auswirkungen-noun"
          ]
        }
      ],
