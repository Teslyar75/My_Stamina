    {
      "slug": "erraten-verb",
      "lemma": "erraten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7431,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "угадать"
        ],
        "en": [
          "to determine (something) through advice or empathy",
          "to guess (something) correctly, to divine"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3847195",
          "text": "Wie hast du das erraten?",
          "translation": "Как ты догадалась?",
          "source": "Tatoeba #3847195 @nGerman / #6211156 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3847195",
          "cefr_level": "A1",
          "word_slugs": [
            "erraten-verb"
          ]
        },
        {
          "id": "2498492",
          "text": "Das ließ sich nicht erraten.",
          "translation": "Этого нельзя было предугадать.",
          "source": "Tatoeba #2498492 @al_ex_an_der / #2498490 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2498492",
          "cefr_level": "A1",
          "word_slugs": [
            "erraten-verb"
          ]
        },
        {
          "id": "734787",
          "text": "Kannst du mein Alter erraten?",
          "translation": "Ты можешь угадать мой возраст?",
          "source": "Tatoeba #734787 @Manfredo / #12919373 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/734787",
          "cefr_level": "A1",
          "word_slugs": [
            "erraten-verb"
          ]
        },
        {
          "id": "3531319",
          "text": "Sie haben es richtig erraten.",
          "translation": "Вы угадали правильно.",
          "source": "Tatoeba #3531319 @max2525 / #2112477 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3531319",
          "cefr_level": "A1",
          "word_slugs": [
            "erraten-verb"
          ]
        },
        {
          "id": "12919365",
          "text": "Können Sie mein Alter erraten?",
          "translation": "Можете угадать, сколько мне лет?",
          "source": "Tatoeba #12919365 @glossboss / #12919368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12919365",
          "cefr_level": "A1",
          "word_slugs": [
            "erraten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
