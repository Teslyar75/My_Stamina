    {
      "slug": "wäldern-noun",
      "lemma": "Wäldern",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8737,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Wald"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8656353",
          "text": "Wildtiere leben in Wäldern.",
          "translation": "Дикие звери живут в лесах.",
          "source": "Tatoeba #8656353 @Melang / #8656549 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8656353",
          "cefr_level": "A1",
          "word_slugs": [
            "wäldern-noun"
          ]
        },
        {
          "id": "365854",
          "text": "Die Vögel sangen in den Wäldern.",
          "translation": "Птицы пели в лесах.",
          "source": "Tatoeba #365854 @Wolf / #8217706 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/365854",
          "cefr_level": "A1",
          "word_slugs": [
            "wäldern-noun"
          ]
        },
        {
          "id": "8218045",
          "text": "In den Wäldern sangen die Vögel.",
          "translation": "В лесах пели птицы.",
          "source": "Tatoeba #8218045 @Pfirsichbaeumchen / #8217713 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8218045",
          "cefr_level": "A1",
          "word_slugs": [
            "wäldern-noun"
          ]
        },
        {
          "id": "1165295",
          "text": "Die Erde ist mit Wäldern bedeckt.",
          "translation": "Земля покрыта лесами.",
          "source": "Tatoeba #1165295 @benutzer / #417389 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1165295",
          "cefr_level": "A1",
          "word_slugs": [
            "wäldern-noun"
          ]
        },
        {
          "id": "1238000",
          "text": "In unseren Wäldern leben keine Bären.",
          "translation": "В наших лесах медведи не водятся.",
          "source": "Tatoeba #1238000 @al_ex_an_der / #13491761 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1238000",
          "cefr_level": "A1",
          "word_slugs": [
            "wäldern-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
