    {
      "slug": "berühmte-adj",
      "lemma": "berühmte",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5283,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of berühmt:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of berühmt:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1177085",
          "text": "Der berühmte Pianist lächelte.",
          "translation": "Знаменитый пианист улыбнулся.",
          "source": "Tatoeba #1177085 @Sudajaengi / #3363980 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1177085",
          "cefr_level": "A1",
          "word_slugs": [
            "berühmte-adj"
          ]
        },
        {
          "id": "383854",
          "text": "Es sind sehr berühmte Leute.",
          "translation": "Это очень известные люди.",
          "source": "Tatoeba #383854 @MUIRIEL / #1868984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/383854",
          "cefr_level": "A1",
          "word_slugs": [
            "berühmte-adj"
          ]
        },
        {
          "id": "4775185",
          "text": "Dies ist eine berühmte Bronzestatue.",
          "translation": "Это знаменитая бронзовая статуя.",
          "source": "Tatoeba #4775185 @Manfredo / #8636368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4775185",
          "cefr_level": "A1",
          "word_slugs": [
            "berühmte-adj"
          ]
        },
        {
          "id": "6321632",
          "text": "Sie war eine berühmte Schauspielerin.",
          "translation": "Она была известной актрисой.",
          "source": "Tatoeba #6321632 @Pfirsichbaeumchen / #6161090 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6321632",
          "cefr_level": "A1",
          "word_slugs": [
            "berühmte-adj"
          ]
        },
        {
          "id": "10372833",
          "text": "Ist Maria eine berühmte Schauspielerin?",
          "translation": "Мэри - известная актриса?",
          "source": "Tatoeba #10372833 @Pfirsichbaeumchen / #10372838 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10372833",
          "cefr_level": "A1",
          "word_slugs": [
            "berühmte-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
