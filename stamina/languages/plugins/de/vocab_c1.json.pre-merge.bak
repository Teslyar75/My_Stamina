    {
      "slug": "seither-adv",
      "lemma": "seither",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8327,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "с тех пор"
        ],
        "en": [
          "since then (from that point in time onwards)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "851111",
          "text": "Bist du seither hier gewesen?",
          "translation": "Ты бывал здесь с тех пор?",
          "source": "Tatoeba #851111 @Esperantostern / #10145028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/851111",
          "cefr_level": "A1",
          "word_slugs": [
            "seither-adv"
          ]
        },
        {
          "id": "802822",
          "text": "Ich habe ihn seither nicht gesehen.",
          "translation": "С тех пор я его не видел.",
          "source": "Tatoeba #802822 @MUIRIEL / #473237 @Iolanda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/802822",
          "cefr_level": "A1",
          "word_slugs": [
            "seither-adv"
          ]
        },
        {
          "id": "1048493",
          "text": "Sie ist seither im Ausland geblieben.",
          "translation": "С тех пор она осталась за границей.",
          "source": "Tatoeba #1048493 @Sudajaengi / #1670500 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1048493",
          "cefr_level": "A1",
          "word_slugs": [
            "seither-adv"
          ]
        },
        {
          "id": "9733202",
          "text": "Mein Englischniveau ist seither deutlich gesunken.",
          "translation": "Мой уровень английского с тех пор значительно снизился.",
          "source": "Tatoeba #9733202 @GaryGaryGary / #8418428 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9733202",
          "cefr_level": "A1",
          "word_slugs": [
            "seither-adv"
          ]
        },
        {
          "id": "352549",
          "text": "Ich habe sie seither nicht mehr gesehen.",
          "translation": "С тех пор я её больше не видел.",
          "source": "Tatoeba #352549 @MUIRIEL / #3187411 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/352549",
          "cefr_level": "A1",
          "word_slugs": [
            "seither-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
