    {
      "slug": "leugnen-verb",
      "lemma": "leugnen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6418,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "отрицать",
          "оспаривать",
          "отвергать"
        ],
        "en": [
          "to deny (assert the untruth of)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8378454",
          "text": "Maria wollte es leugnen.",
          "translation": "Мария хотела это отрицать.",
          "source": "Tatoeba #8378454 @Pfirsichbaeumchen / #8380532 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8378454",
          "cefr_level": "A1",
          "word_slugs": [
            "leugnen-verb"
          ]
        },
        {
          "id": "14007573",
          "text": "Diese Tatsache kann niemand leugnen.",
          "translation": "Никто не может отрицать этот факт.",
          "source": "Tatoeba #14007573 @Waldelfe / #2123722 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14007573",
          "cefr_level": "A1",
          "word_slugs": [
            "leugnen-verb"
          ]
        },
        {
          "id": "4895362",
          "text": "Offensichtliches zu leugnen ist dumm.",
          "translation": "Глупо отрицать очевидное.",
          "source": "Tatoeba #4895362 @al_ex_an_der / #4895361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4895362",
          "cefr_level": "A1",
          "word_slugs": [
            "leugnen-verb"
          ]
        },
        {
          "id": "4508659",
          "text": "Es ist sinnlos, das zu leugnen.",
          "translation": "Нет смысла это отрицать.",
          "source": "Tatoeba #4508659 @Esperantostern / #6566577 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4508659",
          "cefr_level": "A1",
          "word_slugs": [
            "leugnen-verb"
          ]
        },
        {
          "id": "11498313",
          "text": "Das lässt sich nicht länger leugnen.",
          "translation": "Этого уже нельзя отрицать.",
          "source": "Tatoeba #11498313 @Bernie75 / #2765005 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11498313",
          "cefr_level": "A1",
          "word_slugs": [
            "leugnen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
