          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1589556",
          "text": "Ich habe einen leichten Schlaf.",
          "translation": "У меня чуткий сон.",
          "source": "Tatoeba #1589556 @Zaghawa / #2773380 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1589556",
          "cefr_level": "A1",
