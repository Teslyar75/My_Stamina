    {
      "slug": "herkomme-verb",
      "lemma": "herkomme",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9323,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of herkommen:",
          "first-person singular dependent present",
          "inflection of herkommen:",
          "first/third-person singular dependent subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11043371",
          "text": "Wo ich herkomme, ist das völlig normal.",
          "translation": "Там, откуда я родом, это совершенно нормально.",
          "source": "Tatoeba #11043371 @Pfirsichbaeumchen / #8127093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11043371",
          "cefr_level": "A1",
          "word_slugs": [
            "herkomme-verb"
          ]
        },
        {
          "id": "11043372",
          "text": "Da, wo ich herkomme, ist das völlig normal.",
          "translation": "Там, откуда я родом, это совершенно нормально.",
          "source": "Tatoeba #11043372 @Pfirsichbaeumchen / #8127093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11043372",
          "cefr_level": "A1",
          "word_slugs": [
            "herkomme-verb"
          ]
        },
        {
          "id": "13595352",
          "text": "Minus zwanzig Grad? Wo ich herkomme, ist das gar nichts!",
          "translation": "Минус двадцать? Там, откуда я родом, это вообще ни о чём.",
          "source": "Tatoeba #13595352 @mhr / #13452365 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13595352",
          "cefr_level": "A1",
          "word_slugs": [
            "herkomme-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
