    {
      "slug": "bogen-noun",
      "lemma": "Bogen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6494,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "кривая",
          "дуга"
        ],
        "en": [
          "bow (weapon)",
          "bow (for playing stringed instruments)",
          "arch",
          "curve, arc"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "6088906",
          "text": "Gib mir deinen Bogen.",
          "translation": "Дай мне свой лук.",
          "source": "Tatoeba #6088906 @Pfirsichbaeumchen / #6088933 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6088906",
          "cefr_level": "A1",
          "word_slugs": [
            "bogen-noun"
          ]
        },
        {
          "id": "2171599",
          "text": "Ein Bogen ohne Pfeile ist nutzlos.",
          "translation": "Лук без стрел бесполезен.",
          "source": "Tatoeba #2171599 @Pfirsichbaeumchen / #2355914 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2171599",
          "cefr_level": "A1",
          "word_slugs": [
            "bogen-noun"
          ]
        },
        {
          "id": "522694",
          "text": "Ein Bogen ist ohne Pfeile nicht zu benutzen.",
          "translation": "Лук без стрел - бесполезная вещь.",
          "source": "Tatoeba #522694 @Espi / #12427280 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/522694",
          "cefr_level": "A1",
          "word_slugs": [
            "bogen-noun"
          ]
        },
        {
          "id": "1341617",
          "text": "Sie flog davon wie ein Pfeil vom gespannten Bogen.",
          "translation": "Она полетела, как стрела из натянутого лука.",
          "source": "Tatoeba #1341617 @al_ex_an_der / #5991174 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1341617",
          "cefr_level": "A1",
          "word_slugs": [
            "bogen-noun"
          ]
        },
        {
          "id": "3331597",
          "text": "Hier macht der Fluss einen leichten Bogen nach links.",
          "translation": "Река в этом месте немного изгибается влево.",
          "source": "Tatoeba #3331597 @freddy1 / #10643439 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3331597",
          "cefr_level": "A1",
          "word_slugs": [
            "bogen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Bogen",
        "nominative_pl": ""
      }
    },
    {
      "slug": "duft-noun",
      "lemma": "Duft",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6495,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "благоухание"
        ],
        "en": [
          "aroma, fragrance"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "11669036",
          "text": "Jede Blume hat ihren Duft.",
          "translation": "У каждого цветка свой аромат.",
          "source": "Tatoeba #11669036 @Adelpa / #11671141 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11669036",
          "cefr_level": "A1",
          "word_slugs": [
            "duft-noun"
          ]
        },
        {
          "id": "1970424",
          "text": "Ich mag den Duft deiner Haut.",
          "translation": "Мне нравится, как пахнет твоя кожа.",
          "source": "Tatoeba #1970424 @al_ex_an_der / #14007016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1970424",
          "cefr_level": "A1",
          "word_slugs": [
            "duft-noun"
          ]
        },
        {
          "id": "3054078",
          "text": "Auch ich mag diesen Duft sehr.",
          "translation": "Я тоже люблю этот аромат.",
          "source": "Tatoeba #3054078 @al_ex_an_der / #3054077 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3054078",
          "cefr_level": "A1",
          "word_slugs": [
            "duft-noun"
          ]
        },
        {
          "id": "1790669",
          "text": "Die Blume hat einen starken Duft.",
          "translation": "У цветка сильный аромат.",
          "source": "Tatoeba #1790669 @Pfirsichbaeumchen / #5304547 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1790669",
          "cefr_level": "A1",
          "word_slugs": [
            "duft-noun"
          ]
        },
        {
          "id": "12988779",
          "text": "Ich rieche den Duft von Apfelsinen.",
          "translation": "Я чувствую запах апельсинов.",
          "source": "Tatoeba #12988779 @mhr / #12988535 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12988779",
          "cefr_level": "A1",
          "word_slugs": [
            "duft-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Duft",
        "nominative_pl": ""
      }
    },
