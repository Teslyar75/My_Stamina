      "frequency_rank": 5296,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "feeling, sense",
          "gerund of empfinden"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1684377",
          "text": "Ich verstehe dein Empfinden.",
          "translation": "Я понимаю твои чувства.",
          "source": "Tatoeba #1684377 @lisha / #661287 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684377",
          "cefr_level": "A1",
          "word_slugs": [
            "empfinden-noun"
          ]
        },
        {
          "id": "7494032",
          "text": "Meinem Empfinden nach ist das ein guter Gesichtspunkt.",
          "translation": "По моим ощущениям, это мнение достойно внимания.",
          "source": "Tatoeba #7494032 @raggione / #7494540 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7494032",
          "cefr_level": "A1",
          "word_slugs": [
            "empfinden-noun"
          ]
        }
      ],
      "tags": [
