    {
      "slug": "plane-verb",
      "lemma": "plane",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8086,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of planen:",
          "first-person singular present",
          "inflection of planen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13564088",
          "text": "Ich plane Häuser.",
          "translation": "Я проектирую дома.",
          "source": "Tatoeba #13564088 @maaster / #13564113 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13564088",
          "cefr_level": "A1",
          "word_slugs": [
            "plane-verb"
          ]
        },
        {
          "id": "13075710",
          "text": "Ich plane nicht auszugehen.",
          "translation": "Я не планирую выходить.",
          "source": "Tatoeba #13075710 @mhr / #13075632 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13075710",
          "cefr_level": "A1",
          "word_slugs": [
            "plane-verb"
          ]
        },
        {
          "id": "13075712",
          "text": "Ich plane nicht, irgendwohin auszugehen.",
          "translation": "Я не планирую никуда выходить.",
          "source": "Tatoeba #13075712 @mhr / #13075631 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13075712",
          "cefr_level": "A1",
          "word_slugs": [
            "plane-verb"
          ]
        },
        {
          "id": "13867141",
          "text": "Ich plane, den Fuji zu besteigen.",
          "translation": "Я планирую подняться на гору Фудзи.",
          "source": "Tatoeba #13867141 @mhr / #13867163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13867141",
          "cefr_level": "A1",
          "word_slugs": [
            "plane-verb"
          ]
        },
        {
          "id": "13568919",
          "text": "Bevor du anfängst, plane deine Arbeit!",
          "translation": "Прежде чем начать, спланируй свою работу.",
          "source": "Tatoeba #13568919 @mhr / #13568697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13568919",
          "cefr_level": "A1",
          "word_slugs": [
            "plane-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
