      "gender": null,
      "examples": [
        {
          "id": "7854540",
          "text": "Tom wird nichts bemerken.",
          "translation": "Том ничего не заметит.",
          "source": "Tatoeba #7854540 @Pfirsichbaeumchen / #7854535 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7854540",
          "cefr_level": "A1",
