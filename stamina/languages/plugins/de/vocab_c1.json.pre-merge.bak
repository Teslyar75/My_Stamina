    {
      "slug": "erwartete-adj",
      "lemma": "erwartete",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8227,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of erwartet:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of erwartet:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7837269",
          "text": "Tom erwartete niemanden.",
          "translation": "Том никого не ждал.",
          "source": "Tatoeba #7837269 @Pfirsichbaeumchen / #5699909 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7837269",
          "cefr_level": "A1",
          "word_slugs": [
            "erwartete-adj"
          ]
        },
        {
          "id": "8653642",
          "text": "Ich erwartete keine Hilfe.",
          "translation": "Я не ожидал никакой помощи.",
          "source": "Tatoeba #8653642 @Melang / #8657815 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8653642",
          "cefr_level": "A1",
          "word_slugs": [
            "erwartete-adj"
          ]
        },
        {
          "id": "2293175",
          "text": "Tom erwartete von Maria nichts.",
          "translation": "Том ничего от Мэри не ожидал.",
          "source": "Tatoeba #2293175 @Pfirsichbaeumchen / #2293165 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2293175",
          "cefr_level": "A1",
          "word_slugs": [
            "erwartete-adj"
          ]
        },
        {
          "id": "4904084",
          "text": "Keiner erwartete etwas von mir.",
          "translation": "Никто ничего от меня не ждал.",
          "source": "Tatoeba #4904084 @al_ex_an_der / #4904077 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4904084",
          "cefr_level": "A1",
          "word_slugs": [
            "erwartete-adj"
          ]
        },
        {
          "id": "4172905",
          "text": "Niemand erwartete, dass Tom gewänne.",
          "translation": "Никто не ожидал, что Том выиграет.",
          "source": "Tatoeba #4172905 @Pfirsichbaeumchen / #12002463 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4172905",
          "cefr_level": "A1",
          "word_slugs": [
            "erwartete-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
