          "cefr_level": "A1",
          "word_slugs": [
            "anfangs-noun"
          ]
        },
        {
          "id": "9237417",
          "text": "Anfangs mochte ich Tom nicht.",
          "translation": "Сперва Том мне не понравился.",
          "source": "Tatoeba #9237417 @Pfirsichbaeumchen / #2649835 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9237417",
          "cefr_level": "A1",
          "word_slugs": [
            "anfangs-noun"
          ]
        },
        {
          "id": "612022",
          "text": "Anfangs glaubte ich ihm nicht.",
          "translation": "Сначала я ему не верил.",
          "source": "Tatoeba #612022 @Manfredo / #3710349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/612022",
          "cefr_level": "A1",
          "word_slugs": [
            "anfangs-noun"
          ]
        },
        {
          "id": "4095428",
          "text": "Anfangs glaubte ich Tom nicht.",
          "translation": "Поначалу я не поверила Тому.",
          "source": "Tatoeba #4095428 @Pfirsichbaeumchen / #4095192 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4095428",
