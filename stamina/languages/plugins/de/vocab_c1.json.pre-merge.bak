    {
      "slug": "elisabeth-name",
      "lemma": "Elisabeth",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7013,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "Елизавета"
        ],
        "en": [
          "Elizabeth (biblical character)",
          "a female given name from Biblical Hebrew"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "689485",
          "text": "Königin Elisabeth starb im Jahre 1603.",
          "translation": "Королева Елизавета умерла в 1603 году.",
          "source": "Tatoeba #689485 @Manfredo / #1407225 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/689485",
          "cefr_level": "A1",
          "word_slugs": [
            "elisabeth-name"
          ]
        },
        {
          "id": "11937413",
          "text": "Elisabeth ist unabhängig von ihren Eltern.",
          "translation": "Элизабет независима от родителей.",
          "source": "Tatoeba #11937413 @Pfirsichbaeumchen / #4141452 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11937413",
          "cefr_level": "A1",
          "word_slugs": [
            "elisabeth-name"
          ]
        },
        {
          "id": "344428",
          "text": "Elisabeth II. ist die Königin von England.",
          "translation": "Елизавета II - королева Англии.",
          "source": "Tatoeba #344428 @MUIRIEL / #8269048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344428",
          "cefr_level": "A1",
          "word_slugs": [
            "elisabeth-name"
          ]
        },
        {
          "id": "5039639",
          "text": "Elisabeth die Zweite ist Königin von England.",
          "translation": "Елизавета Вторая - королева Англии.",
          "source": "Tatoeba #5039639 @Pfirsichbaeumchen / #5039636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5039639",
          "cefr_level": "A1",
          "word_slugs": [
            "elisabeth-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
