    {
      "slug": "geschlecht-noun",
      "lemma": "Geschlecht",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7789,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "пол"
        ],
        "en": [
          "sex",
          "gender",
          "sex organ",
          "genus, type, race"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "1080345",
          "text": "Manche Fische können ihr Geschlecht wechseln.",
          "translation": "Некоторые рыбы могут менять пол.",
          "source": "Tatoeba #1080345 @MUIRIEL / #13613733 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1080345",
          "cefr_level": "A1",
          "word_slugs": [
            "geschlecht-noun"
          ]
        },
        {
          "id": "10116825",
          "text": "Wollen Sie das Geschlecht des Kindes wissen?",
          "translation": "Вы хотите знать пол ребёнка?",
          "source": "Tatoeba #10116825 @Pfirsichbaeumchen / #10116781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10116825",
          "cefr_level": "A1",
          "word_slugs": [
            "geschlecht-noun"
          ]
        },
        {
          "id": "8730791",
          "text": "Im Ungarischen gibt es kein grammatikalisches Geschlecht.",
          "translation": "В венгерском языке нет грамматического рода.",
          "source": "Tatoeba #8730791 @Adelpa / #8730808 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8730791",
          "cefr_level": "A1",
          "word_slugs": [
            "geschlecht-noun"
          ]
        },
        {
          "id": "3162240",
          "text": "Sie müssen ihr Alter und ihr Geschlecht angeben.",
          "translation": "Вы должны указать свой возраст и пол.",
          "source": "Tatoeba #3162240 @al_ex_an_der / #3179936 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3162240",
          "cefr_level": "A1",
          "word_slugs": [
            "geschlecht-noun"
          ]
        },
        {
          "id": "10116824",
          "text": "Wir wollten das Geschlecht unseres Kindes nicht im voraus wissen.",
          "translation": "Мы не хотели заранее знать пол ребёнка.",
          "source": "Tatoeba #10116824 @Pfirsichbaeumchen / #10116782 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10116824",
          "cefr_level": "A1",
          "word_slugs": [
            "geschlecht-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Geschlecht",
        "nominative_pl": ""
      }
    },
    {
      "slug": "buchhalter-noun",
      "lemma": "Buchhalter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7790,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
