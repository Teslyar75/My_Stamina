      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of verbreiten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13872367",
          "text": "Wer verbreitet diese Lügen?",
          "translation": "Кто распространяет эту ложь?",
          "source": "Tatoeba #13872367 @Waldelfe / #13872372 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13872367",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreitet-verb"
          ]
        },
        {
          "id": "441993",
          "text": "Wer hat diese Gerüchte verbreitet?",
          "translation": "Кто распустил эти слухи?",
          "source": "Tatoeba #441993 @jerom / #2791063 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/441993",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreitet-verb"
          ]
        },
        {
          "id": "8941613",
          "text": "Wie hat sich dieses Gerücht verbreitet?",
          "translation": "Как распространился этот слух?",
          "source": "Tatoeba #8941613 @felix63 / #8951077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8941613",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreitet-verb"
          ]
        },
        {
          "id": "12901888",
          "text": "Das Gerücht hat sich sofort verbreitet.",
          "translation": "Слух мгновенно распространился.",
          "source": "Tatoeba #12901888 @mhr / #12901819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12901888",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreitet-verb"
          ]
        },
        {
          "id": "13566606",
          "text": "Die Nachricht hat sich schnell verbreitet.",
          "translation": "Новость быстро распространилась.",
          "source": "Tatoeba #13566606 @Rovo / #7222055 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13566606",
          "cefr_level": "A1",
          "word_slugs": [
            "verbreitet-verb"
          ]
        }
