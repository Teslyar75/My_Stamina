    {
      "slug": "wälder-noun",
      "lemma": "Wälder",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8093,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Wald \"forests\""
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10292432",
          "text": "Unsere Wälder verdienen unseren Schutz.",
          "translation": "Наши леса заслуживают нашей защиты.",
          "source": "Tatoeba #10292432 @Pfirsichbaeumchen / #13870834 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10292432",
          "cefr_level": "A1",
          "word_slugs": [
            "wälder-noun"
          ]
        },
        {
          "id": "2743741",
          "text": "Ringsum liegen Wälder unendlich weit und unendlich still.",
          "translation": "Вокруг лежат леса бесконечно большие и бесконечно тихие.",
          "source": "Tatoeba #2743741 @al_ex_an_der / #2983745 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2743741",
          "cefr_level": "A1",
          "word_slugs": [
            "wälder-noun"
          ]
        },
        {
          "id": "8636790",
          "text": "Die Wälder in dieser Region bestehen hauptsächlich aus Nadelbäumen.",
          "translation": "В этом регионе леса главным образом состоят из хвойных деревьев.",
          "source": "Tatoeba #8636790 @Melang / #8638723 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636790",
          "cefr_level": "A1",
          "word_slugs": [
            "wälder-noun"
          ]
        },
        {
          "id": "6892865",
          "text": "Diana ist die schöne Göttin des Mondes und der Wälder.",
          "translation": "Диана — прекрасная богиня Луны и лесов.",
          "source": "Tatoeba #6892865 @raggione / #6942988 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6892865",
          "cefr_level": "A1",
          "word_slugs": [
            "wälder-noun"
          ]
        },
        {
          "id": "2425875",
          "text": "Es gibt auf der Erde Berge, Wälder, Felder, Tiere und Menschen.",
          "translation": "На Земле есть горы, леса, поля, животные и люди.",
          "source": "Tatoeba #2425875 @bionicboy / #2524332 @dimitris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2425875",
          "cefr_level": "A1",
          "word_slugs": [
            "wälder-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
