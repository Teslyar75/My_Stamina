    {
      "slug": "schaffte-verb",
      "lemma": "schaffte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7251,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schaffen:",
          "first/third-person singular preterite",
          "inflection of schaffen:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7712148",
          "text": "Sie schaffte es.",
          "translation": "Ей это удалось.",
          "source": "Tatoeba #7712148 @wolfgangth / #6996968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7712148",
          "cefr_level": "A1",
          "word_slugs": [
            "schaffte-verb"
          ]
        },
        {
          "id": "5203651",
          "text": "Er schaffte es, dort rechtzeitig anzukommen.",
          "translation": "Ему удалось прийти туда вовремя.",
          "source": "Tatoeba #5203651 @raggione / #5203789 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5203651",
          "cefr_level": "A1",
          "word_slugs": [
            "schaffte-verb"
          ]
        },
        {
          "id": "823116",
          "text": "Er schaffte es, den Berg zu besteigen.",
          "translation": "Ему удалось подняться на гору.",
          "source": "Tatoeba #823116 @Pfirsichbaeumchen / #2214165 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/823116",
          "cefr_level": "A1",
          "word_slugs": [
            "schaffte-verb"
          ]
        },
        {
          "id": "12877079",
          "text": "Sie schaffte es, ihre Ängste zu überwinden.",
          "translation": "Ей удалось преодолеть свои страхи.",
          "source": "Tatoeba #12877079 @mhr / #12875538 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12877079",
          "cefr_level": "A1",
          "word_slugs": [
            "schaffte-verb"
          ]
        },
        {
          "id": "5064386",
          "text": "Er schaffte es nicht, seinen Plan auszuführen.",
          "translation": "Ему не удалось осуществить свой план.",
          "source": "Tatoeba #5064386 @dispy / #5058839 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5064386",
          "cefr_level": "A1",
          "word_slugs": [
            "schaffte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
