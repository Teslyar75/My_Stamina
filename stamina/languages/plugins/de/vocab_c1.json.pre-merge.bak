    {
      "slug": "erschlagen-verb",
      "lemma": "erschlagen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7912,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to slay, to strike dead",
          "to swamp; to overwhelm"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13399960",
          "text": "Man muß nicht jede Mücke erschlagen.",
          "translation": "Необязательно убивать каждого комара.",
          "source": "Tatoeba #13399960 @Waldelfe / #12187492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13399960",
          "cefr_level": "A1",
          "word_slugs": [
            "erschlagen-verb"
          ]
        },
        {
          "id": "13399971",
          "text": "Man muß nicht sämtliche Mücken erschlagen.",
          "translation": "Необязательно убивать всех комаров.",
          "source": "Tatoeba #13399971 @Waldelfe / #12187493 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13399971",
          "cefr_level": "A1",
          "word_slugs": [
            "erschlagen-verb"
          ]
        },
        {
          "id": "13399966",
          "text": "Es muß nicht jede Mücke erschlagen werden.",
          "translation": "Не каждого комара нужно прихлопывать.",
          "source": "Tatoeba #13399966 @Waldelfe / #3207968 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13399966",
          "cefr_level": "A1",
          "word_slugs": [
            "erschlagen-verb"
          ]
        },
        {
          "id": "13399961",
          "text": "Es tut nicht not, jede Mücke zu erschlagen.",
          "translation": "Не каждого комара нужно прихлопывать.",
          "source": "Tatoeba #13399961 @Waldelfe / #3207968 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13399961",
          "cefr_level": "A1",
          "word_slugs": [
            "erschlagen-verb"
          ]
        },
        {
          "id": "13399963",
          "text": "Es ist nicht nötig, jede Mücke zu erschlagen.",
          "translation": "Необязательно убивать каждого комара.",
          "source": "Tatoeba #13399963 @Waldelfe / #12187492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13399963",
          "cefr_level": "A1",
          "word_slugs": [
            "erschlagen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
