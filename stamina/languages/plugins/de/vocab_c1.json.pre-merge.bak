    {
      "slug": "niederlage-noun",
      "lemma": "Niederlage",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6732,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "поражение"
        ],
        "en": [
          "defeat, loss"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3517295",
          "text": "Tom erkannte seine Niederlage an.",
          "translation": "Том признал своё поражение.",
          "source": "Tatoeba #3517295 @al_ex_an_der / #3517292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3517295",
          "cefr_level": "A1",
          "word_slugs": [
            "niederlage-noun"
          ]
        },
        {
          "id": "959953",
          "text": "Tom hat seine Niederlage anerkannt.",
          "translation": "Том признал своё поражение.",
          "source": "Tatoeba #959953 @Sudajaengi / #3517292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/959953",
          "cefr_level": "A1",
          "word_slugs": [
            "niederlage-noun"
          ]
        },
        {
          "id": "1345420",
          "text": "Eine Niederlage bietet immer eine Chance zu wachsen.",
          "translation": "Поражение всегда дает возможность для роста.",
          "source": "Tatoeba #1345420 @al_ex_an_der / #1345418 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1345420",
          "cefr_level": "A1",
          "word_slugs": [
            "niederlage-noun"
          ]
        },
        {
          "id": "761165",
          "text": "Muiriel hatte keine andere Wahl als ihre Niederlage zu akzeptieren.",
          "translation": "У Мюйриэль не было иного выхода, кроме как признать поражение.",
          "source": "Tatoeba #761165 @MUIRIEL / #13187337 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/761165",
          "cefr_level": "A1",
          "word_slugs": [
            "niederlage-noun"
          ]
        },
        {
          "id": "14094187",
          "text": "Die Niederlage der extremen Rechten ist der Sieg des gesunden Menschenverstands.",
          "translation": "Поражение крайне правых — это победа здравого смысла.",
          "source": "Tatoeba #14094187 @carlosalberto / #14094181 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14094187",
          "cefr_level": "A1",
          "word_slugs": [
            "niederlage-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Niederlage",
        "nominative_pl": ""
      }
    },
    {
      "slug": "zehen-noun",
      "lemma": "Zehen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6733,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Zeh",
          "plural of Zehe"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6021636",
          "text": "Ein Fuß hat fünf Zehen.",
          "translation": "На ноге пять пальцев.",
          "source": "Tatoeba #6021636 @raggione / #6023742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6021636",
          "cefr_level": "A1",
          "word_slugs": [
            "zehen-noun"
          ]
        },
        {
          "id": "7480257",
          "text": "Ihm sind alle Zehen abgefroren.",
          "translation": "Он отморозил все пальцы на ногах.",
          "source": "Tatoeba #7480257 @Pfirsichbaeumchen / #5790849 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7480257",
          "cefr_level": "A1",
          "word_slugs": [
            "zehen-noun"
          ]
        },
        {
          "id": "6021638",
          "text": "Wie viele Zehen hat ein Straußenfuß?",
          "translation": "Сколько пальцев на ноге у страуса?",
          "source": "Tatoeba #6021638 @raggione / #6023745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6021638",
          "cefr_level": "A1",
          "word_slugs": [
            "zehen-noun"
          ]
        },
        {
          "id": "8088770",
          "text": "Du bist mir gerade auf die Zehen gestiegen.",
          "translation": "Ты мне только что на ногу наступил.",
          "source": "Tatoeba #8088770 @brauchinet / #12318699 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8088770",
          "cefr_level": "A1",
          "word_slugs": [
            "zehen-noun"
          ]
        },
        {
          "id": "1720277",
          "text": "Meine Hände reichen mit Leichtigkeit an meine Zehen.",
          "translation": "Я легко достаю руками до пальцев ног.",
          "source": "Tatoeba #1720277 @Pfirsichbaeumchen / #4641385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1720277",
          "cefr_level": "A1",
          "word_slugs": [
            "zehen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
