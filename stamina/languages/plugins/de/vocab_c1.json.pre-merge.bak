    {
      "slug": "loszuwerden-verb",
      "lemma": "loszuwerden",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5419,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of loswerden"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1288246",
          "text": "Er versucht, die Ameisen loszuwerden.",
          "translation": "Он пытается избавиться от муравьёв.",
          "source": "Tatoeba #1288246 @enteka / #5215726 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1288246",
          "cefr_level": "A1",
          "word_slugs": [
            "loszuwerden-verb"
          ]
        },
        {
          "id": "1549134",
          "text": "Er versuchte die Ameisen loszuwerden.",
          "translation": "Он пытался избавиться от муравьёв.",
          "source": "Tatoeba #1549134 @Zaghawa / #10118422 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1549134",
          "cefr_level": "A1",
          "word_slugs": [
            "loszuwerden-verb"
          ]
        },
        {
          "id": "1350306",
          "text": "Alles, was ich möchte, ist, dich loszuwerden.",
          "translation": "Всё, чего я хочу, - это избавиться от тебя.",
          "source": "Tatoeba #1350306 @Manfredo / #1670292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1350306",
          "cefr_level": "A1",
          "word_slugs": [
            "loszuwerden-verb"
          ]
        },
        {
          "id": "2586826",
          "text": "Was hindert Sie daran, solche Menschen loszuwerden?",
          "translation": "Что мешает вам избавиться от таких людей?",
          "source": "Tatoeba #2586826 @al_ex_an_der / #2586821 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2586826",
          "cefr_level": "A1",
          "word_slugs": [
            "loszuwerden-verb"
          ]
        },
        {
          "id": "362179",
          "text": "Es ist nicht leicht, eine schlechte Angewohnheit loszuwerden.",
          "translation": "От плохой привычки избавиться непросто.",
          "source": "Tatoeba #362179 @Wolf / #495119 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/362179",
          "cefr_level": "A1",
          "word_slugs": [
            "loszuwerden-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "unnötig-adj",
      "lemma": "unnötig",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5420,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "unnecessary"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2199002",
          "text": "Das ist unnötig.",
          "translation": "В этом нет необходимости.",
          "source": "Tatoeba #2199002 @Pfirsichbaeumchen / #2804771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2199002",
          "cefr_level": "A1",
          "word_slugs": [
            "unnötig-adj"
          ]
        },
        {
          "id": "14095021",
          "text": "Das ist total unnötig!",
          "translation": "Это совершенно бесполезно!",
          "source": "Tatoeba #14095021 @Ioan_Cristian / #14095051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14095021",
          "cefr_level": "A1",
          "word_slugs": [
            "unnötig-adj"
          ]
        },
        {
          "id": "3541877",
          "text": "Das war absolut unnötig.",
          "translation": "В этом не было никакой необходимости.",
          "source": "Tatoeba #3541877 @al_ex_an_der / #9992885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3541877",
          "cefr_level": "A1",
          "word_slugs": [
            "unnötig-adj"
          ]
        },
        {
          "id": "8123397",
          "text": "Ich denke, das ist unnötig.",
          "translation": "Я думаю, это излишне.",
          "source": "Tatoeba #8123397 @Pfirsichbaeumchen / #3866349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8123397",
          "cefr_level": "A1",
          "word_slugs": [
            "unnötig-adj"
          ]
        },
        {
          "id": "3407409",
          "text": "Was wir getan haben, war unnötig.",
          "translation": "В том, что мы сделали, не было необходимости.",
          "source": "Tatoeba #3407409 @Pfirsichbaeumchen / #12001762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3407409",
          "cefr_level": "A1",
          "word_slugs": [
            "unnötig-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der unnötig",
        "nominative_pl": ""
      }
    },
    {
      "slug": "begleite-verb",
      "lemma": "begleite",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5421,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of begleiten:",
          "first-person singular present",
          "inflection of begleiten:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8322328",
          "text": "Kommen Sie, ich begleite Sie.",
          "translation": "Пойдёмте, я Вас провожу.",
          "source": "Tatoeba #8322328 @felix63 / #9301478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8322328",
          "cefr_level": "A1",
          "word_slugs": [
            "begleite-verb"
          ]
        },
        {
          "id": "6996280",
          "text": "Wenn du Lust hast, begleite mich!",
          "translation": "Присоединяйся ко мне, если хочешь!",
          "source": "Tatoeba #6996280 @list / #9994754 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6996280",
          "cefr_level": "A1",
          "word_slugs": [
            "begleite-verb"
          ]
        },
        {
          "id": "1128460",
          "text": "Ich begleite dich bis zum Bahnhof.",
          "translation": "Я сопровожу тебя до вокзала.",
          "source": "Tatoeba #1128460 @xtofu80 / #2217708 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1128460",
          "cefr_level": "A1",
          "word_slugs": [
            "begleite-verb"
          ]
        },
        {
          "id": "7071618",
          "text": "Ich begleite Sie bis zum Supermarkt.",
          "translation": "Я провожу Вас до супермаркета.",
          "source": "Tatoeba #7071618 @raggione / #12612365 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7071618",
          "cefr_level": "A1",
          "word_slugs": [
            "begleite-verb"
          ]
        },
        {
          "id": "7071617",
          "text": "Ich begleite dich bis zum Supermarkt.",
          "translation": "Я провожу тебя до супермаркета.",
          "source": "Tatoeba #7071617 @raggione / #12612361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7071617",
          "cefr_level": "A1",
          "word_slugs": [
            "begleite-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
