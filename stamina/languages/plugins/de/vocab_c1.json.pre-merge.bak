      "cefr_level": "C1",
      "frequency_rank": 6033,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of überprüfen:",
          "first-person singular present",
          "inflection of überprüfen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13785931",
          "text": "Überprüfe die Einstellungen!",
          "translation": "Проверь настройки.",
          "source": "Tatoeba #13785931 @mhr / #13785780 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13785931",
          "cefr_level": "A1",
