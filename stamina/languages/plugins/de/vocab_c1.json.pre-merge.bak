        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6464868",
          "text": "Tom hat 450 g Käse gekauft.",
          "translation": "Том купил 450 граммов сыра.",
          "source": "Tatoeba #6464868 @Pfirsichbaeumchen / #9231306 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6464868",
          "cefr_level": "A1",
          "word_slugs": [
            "g-abbrev"
          ]
        },
        {
          "id": "13846153",
          "text": "Das menschliche Gehirn wiegt ca. 1500 g.",
          "translation": "Человеческий мозг весит около 1500 грамм.",
          "source": "Tatoeba #13846153 @Waldelfe / #3641643 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13846153",
          "cefr_level": "A1",
          "word_slugs": [
            "g-abbrev"
          ]
        },
        {
          "id": "2924828",
          "text": "Man verrühre drei Eier mit 225 g Zucker.",
          "translation": "Смешайте три яйца с 225 граммами сахара.",
          "source": "Tatoeba #2924828 @Pfirsichbaeumchen / #2927632 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2924828",
          "cefr_level": "A1",
          "word_slugs": [
            "g-abbrev"
          ]
        },
        {
          "id": "6765068",
          "text": "Ich brauche etwa 300–400 g von dieser Wurst.",
          "translation": "Мне нужно граммов 300-400 этой колбасы.",
          "source": "Tatoeba #6765068 @Pfirsichbaeumchen / #5489040 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6765068",
          "cefr_level": "A1",
          "word_slugs": [
            "g-abbrev"
          ]
        }
      ],
