    {
      "slug": "räder-noun",
      "lemma": "Räder",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9437,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Rad"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12816142",
          "text": "Die Räder drehten sich.",
          "translation": "Колёса крутились.",
          "source": "Tatoeba #12816142 @Waldelfe / #13476757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12816142",
          "cefr_level": "A1",
          "word_slugs": [
            "räder-noun"
          ]
        },
        {
          "id": "8230529",
          "text": "Fahrräder haben zwei Räder.",
          "translation": "У велосипедов два колеса.",
          "source": "Tatoeba #8230529 @Luiaard / #6689511 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8230529",
          "cefr_level": "A1",
          "word_slugs": [
            "räder-noun"
          ]
        },
        {
          "id": "789231",
          "text": "Ein Auto hat vier Räder.",
          "translation": "У автомобиля четыре колеса.",
          "source": "Tatoeba #789231 @Pfirsichbaeumchen / #2370643 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/789231",
          "cefr_level": "A1",
          "word_slugs": [
            "räder-noun"
          ]
        },
        {
          "id": "13875502",
          "text": "Toms Auto hat vier Räder.",
          "translation": "У автомобиля Тома четыре колеса.",
          "source": "Tatoeba #13875502 @maaster / #13875524 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13875502",
          "cefr_level": "A1",
          "word_slugs": [
            "räder-noun"
          ]
        },
        {
          "id": "1498655",
          "text": "Sein Auto hat keine Räder.",
          "translation": "У его автомобиля нет колёс.",
          "source": "Tatoeba #1498655 @Zaghawa / #2851089 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1498655",
