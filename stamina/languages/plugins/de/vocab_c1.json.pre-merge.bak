    {
      "slug": "assistenten-noun",
      "lemma": "Assistenten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7727,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Assistent",
          "plural of Assistent"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "637495",
          "text": "Ich suche einen Assistenten.",
          "translation": "Я ищу ассистента.",
          "source": "Tatoeba #637495 @samueldora / #6203915 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/637495",
          "cefr_level": "A1",
          "word_slugs": [
            "assistenten-noun"
          ]
        },
        {
          "id": "3481283",
          "text": "Meine Assistenten dokumentieren alles, was geschieht.",
          "translation": "Мои помощники документируют всё происходящее.",
          "source": "Tatoeba #3481283 @al_ex_an_der / #3481281 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3481283",
          "cefr_level": "A1",
          "word_slugs": [
            "assistenten-noun"
          ]
        },
        {
          "id": "8016413",
          "text": "Setzen Sie sich mit meinem Assistenten in Verbindung, wenn Sie Fragen haben.",
          "translation": "Если у Вас возникнут вопросы, свяжитесь с моим ассистентом.",
          "source": "Tatoeba #8016413 @raggione / #8016490 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8016413",
          "cefr_level": "A1",
          "word_slugs": [
            "assistenten-noun"
          ]
        }
      ],
