          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8824534",
          "text": "Tom wählte sofort die 911.",
          "translation": "Том сразу позвонил 911.",
          "source": "Tatoeba #8824534 @Pfirsichbaeumchen / #4782925 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8824534",
          "cefr_level": "A1",
