          "source": "Tatoeba #2159395 @Pfirsichbaeumchen / #2159289 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2159395",
          "cefr_level": "A1",
          "word_slugs": [
