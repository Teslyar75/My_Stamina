          ]
        },
        {
          "id": "13603634",
          "text": "Sie hätten Toms Gesichtsausdruck sehen sollen!",
          "translation": "Нужно было видеть выражение лица Тома.",
          "source": "Tatoeba #13603634 @Waldelfe / #6616764 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13603634",
          "cefr_level": "A1",
          "word_slugs": [
