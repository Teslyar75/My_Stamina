    {
      "slug": "langeweile-noun",
      "lemma": "Langeweile",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9700,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "скука"
        ],
        "en": [
          "boredom, ennui, tedium"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3289082",
          "text": "Einmal zählte Christoph Kolumbus aus Langeweile von eins bis unendlich – und zurück.",
          "translation": "Однажды Христофор Колумб со скуки посчитал от единицы до бесконечности и обратно.",
          "source": "Tatoeba #3289082 @Pfirsichbaeumchen / #8640293 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3289082",
          "cefr_level": "A1",
          "word_slugs": [
            "langeweile-noun"
          ]
        },
        {
          "id": "1984850",
          "text": "Langeweile kenne ich nicht.",
          "translation": "Скука мне не знакома.",
          "source": "Tatoeba #1984850 @Alois / #9358162 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1984850",
          "cefr_level": "A1",
          "word_slugs": [
            "langeweile-noun"
          ]
        }
      ],
      "tags": [
