        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "404901",
          "text": "Er ist weltweit berühmt.",
          "translation": "Он всемирно знаменит.",
          "source": "Tatoeba #404901 @xtofu80 / #4955927 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/404901",
          "cefr_level": "A1",
          "word_slugs": [
            "weltweit-adj"
          ]
        },
        {
          "id": "13785976",
          "text": "Ihr Name ist weltweit bekannt.",
          "translation": "Её имя известно по всему миру.",
          "source": "Tatoeba #13785976 @mhr / #13785857 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13785976",
          "cefr_level": "A1",
          "word_slugs": [
            "weltweit-adj"
          ]
        },
        {
          "id": "2489165",
          "text": "Die Produkte werden weltweit verkauft.",
          "translation": "Продукция продаётся по всему миру.",
          "source": "Tatoeba #2489165 @Tamy / #6978533 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2489165",
          "cefr_level": "A1",
          "word_slugs": [
            "weltweit-adj"
          ]
        },
        {
          "id": "13842668",
          "text": "Fliegen sind weltweit verbreitete Insekten.",
          "translation": "Мухи — насекомые, распространённые во всём мире.",
          "source": "Tatoeba #13842668 @carlosalberto / #13842669 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13842668",
          "cefr_level": "A1",
          "word_slugs": [
            "weltweit-adj"
          ]
        },
        {
          "id": "10013822",
          "text": "Dieses Virus ist weltweit ein Problem.",
          "translation": "Этот вирус - общемировая проблема.",
          "source": "Tatoeba #10013822 @carlosalberto / #10016502 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10013822",
          "cefr_level": "A1",
          "word_slugs": [
            "weltweit-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
