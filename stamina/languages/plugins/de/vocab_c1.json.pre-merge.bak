          ]
        },
        {
          "id": "8634567",
          "text": "Ich habe ältere Schwestern.",
          "translation": "У меня есть старшие сёстры.",
          "source": "Tatoeba #8634567 @Melang / #8640341 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634567",
          "cefr_level": "A1",
          "word_slugs": [
            "ältere-adj"
          ]
        },
        {
          "id": "1833183",
          "text": "Du hast zwei ältere Brüder.",
