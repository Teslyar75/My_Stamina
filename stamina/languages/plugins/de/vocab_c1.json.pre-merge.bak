    {
      "slug": "umher-adv",
      "lemma": "umher",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8186,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "around, round, about"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2250758",
          "text": "Ich lief ziellos umher.",
          "translation": "Я бесцельно слонялся вокруг.",
          "source": "Tatoeba #2250758 @Pfirsichbaeumchen / #2229596 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2250758",
          "cefr_level": "A1",
          "word_slugs": [
            "umher-adv"
          ]
        },
        {
          "id": "12847823",
          "text": "Ich wandere ziellos umher.",
          "translation": "Я бесцельно брожу.",
          "source": "Tatoeba #12847823 @mhr / #12847819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12847823",
          "cefr_level": "A1",
          "word_slugs": [
            "umher-adv"
          ]
        },
        {
          "id": "12416903",
          "text": "Überall flattern Schmetterlinge umher.",
          "translation": "Повсюду порхают бабочки.",
          "source": "Tatoeba #12416903 @mhr / #11839051 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12416903",
          "cefr_level": "A1",
          "word_slugs": [
            "umher-adv"
          ]
        },
        {
          "id": "2403969",
          "text": "Sie wanderte im Wald umher.",
          "translation": "Она бродила по лесу.",
          "source": "Tatoeba #2403969 @Pfirsichbaeumchen / #2403039 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2403969",
          "cefr_level": "A1",
          "word_slugs": [
            "umher-adv"
          ]
        },
        {
          "id": "12847825",
          "text": "Ich wandere ohne Ziel umher.",
          "translation": "Я брожу без цели.",
          "source": "Tatoeba #12847825 @mhr / #12847816 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12847825",
          "cefr_level": "A1",
          "word_slugs": [
            "umher-adv"
          ]
        }
