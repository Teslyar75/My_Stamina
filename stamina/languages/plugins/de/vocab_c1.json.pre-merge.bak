    {
      "slug": "zwingt-verb",
      "lemma": "zwingt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5925,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of zwingen:",
          "third-person singular present",
          "inflection of zwingen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11781224",
          "text": "Zwingt uns nicht dazu!",
          "translation": "Не заставляйте нас это делать.",
          "source": "Tatoeba #11781224 @Pfirsichbaeumchen / #8408694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11781224",
          "cefr_level": "A1",
          "word_slugs": [
            "zwingt-verb"
          ]
        },
        {
          "id": "10177341",
          "text": "Niemand zwingt dich hierzubleiben.",
          "translation": "Никто тебя не заставляет здесь оставаться.",
          "source": "Tatoeba #10177341 @Pfirsichbaeumchen / #10170693 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10177341",
          "cefr_level": "A1",
          "word_slugs": [
            "zwingt-verb"
          ]
        },
        {
          "id": "12487919",
          "text": "Zwingt mich nicht zu tanzen!",
          "translation": "Не заставляй меня танцевать.",
          "source": "Tatoeba #12487919 @Waldelfe / #8716178 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12487919",
          "cefr_level": "A1",
          "word_slugs": [
            "zwingt-verb"
          ]
        },
        {
          "id": "3295389",
          "text": "Niemand zwingt dich zu kommen.",
          "translation": "Тебя никто не заставляет приходить.",
          "source": "Tatoeba #3295389 @al_ex_an_der / #3295400 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3295389",
          "cefr_level": "A1",
          "word_slugs": [
            "zwingt-verb"
          ]
        },
        {
          "id": "4466179",
          "text": "Niemand zwingt dich zu bleiben.",
          "translation": "Тебя никто не заставляет оставаться.",
          "source": "Tatoeba #4466179 @brauchinet / #4472712 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4466179",
          "cefr_level": "A1",
          "word_slugs": [
            "zwingt-verb"
          ]
        }
      ],
