      },
      "gender": "f",
      "examples": [
        {
          "id": "13012501",
          "text": "Ich mag Käfer.",
          "translation": "Я люблю жуков.",
          "source": "Tatoeba #13012501 @Waldelfe / #12931020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13012501",
          "cefr_level": "A1",
          "word_slugs": [
            "käfer-noun"
          ]
        },
        {
          "id": "1137133",
          "text": "Der Käfer ist durstig.",
