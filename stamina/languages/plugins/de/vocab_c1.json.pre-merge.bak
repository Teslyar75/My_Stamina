    {
      "slug": "vorwand-noun",
      "lemma": "Vorwand",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8490,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "предлог"
        ],
        "en": [
          "pretext",
          "excuse"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "454712",
          "text": "Das ist nichts weiter als ein Vorwand zum Faulenzen.",
          "translation": "Это всего лишь предлог, чтобы бездельничать.",
          "source": "Tatoeba #454712 @xtofu80 / #1670512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454712",
          "cefr_level": "A1",
          "word_slugs": [
            "vorwand-noun"
          ]
        },
        {
          "id": "2351279",
          "text": "Ich würde eher sagen: Das ist kein Grund, sondern ein Vorwand.",
          "translation": "Точнее я бы назвал это не причиной, а отговоркой.",
          "source": "Tatoeba #2351279 @al_ex_an_der / #2351283 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2351279",
          "cefr_level": "A1",
          "word_slugs": [
            "vorwand-noun"
          ]
        },
        {
          "id": "9829882",
          "text": "Er hat sich einen Vorwand ausgedacht, um sich mit mir zu prügeln.",
          "translation": "Он придумал предлог для драки со мной.",
          "source": "Tatoeba #9829882 @GaryGaryGary / #4769229 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9829882",
          "cefr_level": "A1",
          "word_slugs": [
            "vorwand-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Vorwand",
        "nominative_pl": ""
      }
    },
