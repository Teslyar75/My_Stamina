    {
      "slug": "helle-adj",
      "lemma": "helle",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9313,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "clever, smart, bright"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "341549",
          "text": "Ich mag helle Farben.",
          "translation": "Мне нравятся светлые тона.",
          "source": "Tatoeba #341549 @MUIRIEL / #739196 @ivanov (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341549",
          "cefr_level": "A1",
          "word_slugs": [
            "helle-adj"
          ]
        },
        {
          "id": "7993909",
          "text": "Der Mond schien helle.",
          "translation": "Луна была яркая.",
          "source": "Tatoeba #7993909 @Pfirsichbaeumchen / #6403244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7993909",
          "cefr_level": "A1",
          "word_slugs": [
            "helle-adj"
          ]
        },
        {
          "id": "3474589",
          "text": "Tom ist nicht allzu helle.",
          "translation": "Том не очень умен.",
          "source": "Tatoeba #3474589 @Pfirsichbaeumchen / #3308996 @D15c05tu (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3474589",
          "cefr_level": "A1",
          "word_slugs": [
            "helle-adj"
          ]
        },
        {
          "id": "741416",
          "text": "Sie tragen gerne helle Farben.",
          "translation": "Им нравится носить яркие цвета.",
          "source": "Tatoeba #741416 @Pfirsichbaeumchen / #826455 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/741416",
          "cefr_level": "A1",
          "word_slugs": [
            "helle-adj"
          ]
        },
        {
          "id": "8240216",
          "text": "Maria hat helle Haut und kurze Löckchen.",
          "translation": "У Мэри светлая кожа и короткие кудряшки.",
          "source": "Tatoeba #8240216 @Pfirsichbaeumchen / #5626071 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8240216",
          "cefr_level": "A1",
          "word_slugs": [
            "helle-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der helle",
        "nominative_pl": ""
      }
    },
