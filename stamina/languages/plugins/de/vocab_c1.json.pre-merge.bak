          ]
        },
        {
          "id": "340425",
          "text": "Ich habe das Radio abgeschaltet.",
          "translation": "Я выключила радио.",
          "source": "Tatoeba #340425 @fendtwick / #6002025 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/340425",
          "cefr_level": "A1",
          "word_slugs": [
            "abgeschaltet-verb"
          ]
        },
        {
          "id": "14096301",
          "text": "Die Springbrunnen hat man schon für den Winter abgeschaltet.",
          "translation": "Фонтаны уже отключили на зиму.",
          "source": "Tatoeba #14096301 @mhr / #14096287 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14096301",
          "cefr_level": "A1",
          "word_slugs": [
            "abgeschaltet-verb"
          ]
        },
        {
          "id": "14096300",
          "text": "Die Springbrunnen sind schon für den Winter abgeschaltet worden.",
          "translation": "Фонтаны уже отключили на зиму.",
          "source": "Tatoeba #14096300 @mhr / #14096287 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14096300",
          "cefr_level": "A1",
