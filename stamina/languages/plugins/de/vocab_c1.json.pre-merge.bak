    {
      "slug": "fähre-noun",
      "lemma": "Fähre",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8616,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "ferry"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8404375",
          "text": "Wo ist die Fähre?",
          "translation": "Где тут паром?",
          "source": "Tatoeba #8404375 @felix63 / #12656192 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8404375",
          "cefr_level": "A1",
          "word_slugs": [
            "fähre-noun"
          ]
        },
        {
          "id": "3014318",
          "text": "Ich warte auf die Fähre.",
          "translation": "Я жду паром.",
          "source": "Tatoeba #3014318 @raggione / #2871006 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3014318",
          "cefr_level": "A1",
          "word_slugs": [
            "fähre-noun"
          ]
        },
        {
          "id": "6087520",
          "text": "Die Fähre ist in den Hafen eingelaufen.",
          "translation": "Паром вошёл в гавань.",
          "source": "Tatoeba #6087520 @raggione / #14053757 @Alex_M (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6087520",
          "cefr_level": "A1",
          "word_slugs": [
            "fähre-noun"
          ]
        },
        {
          "id": "13699432",
          "text": "Die Fähre verkehrt zwischen Dover und Calais.",
          "translation": "Паром курсирует между Дувром и Кале.",
          "source": "Tatoeba #13699432 @mhr / #13699435 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13699432",
          "cefr_level": "A1",
          "word_slugs": [
            "fähre-noun"
          ]
        },
        {
          "id": "13422111",
          "text": "Die Fähre legt jeden Morgen um acht Uhr ab.",
          "translation": "Паром отплывает каждое утро в восемь часов.",
          "source": "Tatoeba #13422111 @mhr / #13422097 @frpzzd (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13422111",
          "cefr_level": "A1",
          "word_slugs": [
            "fähre-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
