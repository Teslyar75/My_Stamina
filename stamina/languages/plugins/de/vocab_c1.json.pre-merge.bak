    {
      "slug": "quarantäne-noun",
      "lemma": "Quarantäne",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8031,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "карантин"
        ],
        "en": [
          "quarantine"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8630274",
          "text": "Ich befinde mich in Quarantäne.",
          "translation": "Я на карантине.",
          "source": "Tatoeba #8630274 @Pfirsichbaeumchen / #4704073 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8630274",
          "cefr_level": "A1",
          "word_slugs": [
            "quarantäne-noun"
          ]
        },
        {
          "id": "8504407",
          "text": "Man stellte das ganze Schiff unter Quarantäne.",
          "translation": "Всё судно было посажено на карантин.",
          "source": "Tatoeba #8504407 @Espi / #10782621 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8504407",
          "cefr_level": "A1",
          "word_slugs": [
            "quarantäne-noun"
          ]
        },
        {
          "id": "5036458",
          "text": "Das Leben ist eine Quarantäne für das Paradies.",
          "translation": "Жизнь - это карантин перед раем.",
          "source": "Tatoeba #5036458 @Esperantostern / #5687410 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5036458",
          "cefr_level": "A1",
          "word_slugs": [
            "quarantäne-noun"
          ]
        },
        {
          "id": "9927858",
          "text": "Für wie viele Selbstmorde wird diese Quarantäne wohl verantwortlich sein?",
          "translation": "Сколько самоубийств вызовет этот карантин?",
          "source": "Tatoeba #9927858 @manese / #9928232 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9927858",
          "cefr_level": "A1",
          "word_slugs": [
            "quarantäne-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
