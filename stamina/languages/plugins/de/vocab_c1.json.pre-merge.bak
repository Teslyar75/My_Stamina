    {
      "slug": "begräbnis-noun",
      "lemma": "Begräbnis",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8108,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "похороны",
          "погребение"
        ],
        "en": [
          "funeral, burial",
          "place of burial"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "1292347",
          "text": "Das ist dein Begräbnis.",
          "translation": "Это твои похороны.",
          "source": "Tatoeba #1292347 @Esperantostern / #6771289 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1292347",
          "cefr_level": "A1",
          "word_slugs": [
            "begräbnis-noun"
          ]
        },
        {
          "id": "7455584",
          "text": "Das Begräbnis war gestern.",
          "translation": "Похороны были вчера.",
          "source": "Tatoeba #7455584 @raggione / #1535626 @zalaim (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7455584",
          "cefr_level": "A1",
          "word_slugs": [
            "begräbnis-noun"
          ]
        },
        {
          "id": "7455588",
          "text": "Ich war nicht bei seinem Begräbnis.",
          "translation": "Я не присутствовал на его похоронах.",
          "source": "Tatoeba #7455588 @raggione / #7456010 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7455588",
          "cefr_level": "A1",
          "word_slugs": [
            "begräbnis-noun"
          ]
        },
        {
          "id": "7413115",
          "text": "Ich weiß nicht, ob sie zum Begräbnis werden kommen können.",
          "translation": "Не знаю, смогут ли они прийти на похороны.",
          "source": "Tatoeba #7413115 @brauchinet / #13655854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7413115",
          "cefr_level": "A1",
          "word_slugs": [
            "begräbnis-noun"
          ]
        },
        {
          "id": "7455596",
          "text": "Sie haben Toms Leichnam ausgegraben und gaben ihm ein würdiges Begräbnis.",
          "translation": "Они похоронили Тома и устроили ему достойные проводы.",
          "source": "Tatoeba #7455596 @raggione / #7456008 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7455596",
          "cefr_level": "A1",
          "word_slugs": [
            "begräbnis-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Begräbnis",
        "nominative_pl": ""
      }
    },
