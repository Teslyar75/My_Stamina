    {
      "slug": "widmen-verb",
      "lemma": "widmen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8247,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to dedicate, to devote",
          "to attend"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14107445",
          "text": "Wir widmen diesen Film unseren Eltern.",
          "translation": "Мы посвящаем этот фильм нашим родителям.",
          "source": "Tatoeba #14107445 @mhr / #14107438 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14107445",
          "cefr_level": "A1",
          "word_slugs": [
            "widmen-verb"
          ]
        },
        {
          "id": "3386087",
          "text": "Ich möchte dieses Lied meiner Mutter widmen.",
          "translation": "Я хотел бы посвятить эту песню своей маме.",
          "source": "Tatoeba #3386087 @Pfirsichbaeumchen / #11061152 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3386087",
          "cefr_level": "A1",
          "word_slugs": [
            "widmen-verb"
          ]
        },
        {
          "id": "1873758",
          "text": "Es ist notwendig, der Grammatik mehr Aufmerksamkeit zu widmen.",
          "translation": "Необходимо обращать больше внимания на грамматику.",
          "source": "Tatoeba #1873758 @al_ex_an_der / #1873721 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1873758",
          "cefr_level": "A1",
          "word_slugs": [
            "widmen-verb"
          ]
        },
        {
          "id": "12849689",
          "text": "In diesem Jahr wollen sie dem Studium mehr Zeit widmen.",
          "translation": "В этом году они хотят уделять больше времени учёбе.",
          "source": "Tatoeba #12849689 @mhr / #12849511 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12849689",
          "cefr_level": "A1",
          "word_slugs": [
            "widmen-verb"
          ]
        },
        {
          "id": "1428680",
          "text": "Könnten Sie mir ein paar Minuten Ihrer kostbaren Zeit widmen?",
          "translation": "Вы не могли бы уделить мне несколько минут Вашего драгоценного времени?",
          "source": "Tatoeba #1428680 @Manfredo / #14112778 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1428680",
          "cefr_level": "A1",
          "word_slugs": [
            "widmen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
