    {
      "slug": "verzweiflung-noun",
      "lemma": "Verzweiflung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6709,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "отчаяние"
        ],
        "en": [
          "desperation"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "7441772",
          "text": "Tom fiel großer Verzweiflung anheim.",
          "translation": "Том погрузился в глубокое отчаяние.",
          "source": "Tatoeba #7441772 @Pfirsichbaeumchen / #7446488 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7441772",
          "cefr_level": "A1",
          "word_slugs": [
            "verzweiflung-noun"
          ]
        },
        {
          "id": "1080710",
          "text": "Er weinte bitterliche Tränen der Verzweiflung.",
          "translation": "Он плакал горькими слезами отчаяния.",
          "source": "Tatoeba #1080710 @MUIRIEL / #12425997 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1080710",
          "cefr_level": "A1",
          "word_slugs": [
            "verzweiflung-noun"
          ]
        },
        {
          "id": "13789931",
          "text": "In völliger Verzweiflung rief ich meinen Vater an.",
          "translation": "В полнейшем отчаянии я позвонил отцу.",
          "source": "Tatoeba #13789931 @mhr / #13789514 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13789931",
          "cefr_level": "A1",
          "word_slugs": [
            "verzweiflung-noun"
          ]
        },
        {
          "id": "4160410",
          "text": "Man konnte die Verzweiflung in Marias Stimme hören.",
          "translation": "В голосе Марии слышалось отчаяние.",
          "source": "Tatoeba #4160410 @Pfirsichbaeumchen / #4160494 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4160410",
          "cefr_level": "A1",
          "word_slugs": [
            "verzweiflung-noun"
          ]
        },
        {
          "id": "2521793",
          "text": "Angst kann helfen, kann jedoch auch zur Verzweiflung führen.",
          "translation": "Страх может помочь, а может и привести в отчаяние.",
          "source": "Tatoeba #2521793 @al_ex_an_der / #1902287 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2521793",
          "cefr_level": "A1",
          "word_slugs": [
            "verzweiflung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Verzweiflung",
        "nominative_pl": ""
      }
    },
