      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "смертельный"
        ],
        "en": [
          "deadly, mortal, lethal, fatal"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1248659",
          "text": "Diese Krankheit ist tödlich.",
          "translation": "Это смертельная болезнь.",
          "source": "Tatoeba #1248659 @Esperantostern / #13077116 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1248659",
          "cefr_level": "A1",
          "word_slugs": [
            "tödlich-adj"
          ]
        },
        {
          "id": "7635559",
          "text": "Tom wurde tödlich verwundet.",
          "translation": "Том был смертельно ранен.",
          "source": "Tatoeba #7635559 @wolfgangth / #4196934 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7635559",
          "cefr_level": "A1",
          "word_slugs": [
            "tödlich-adj"
          ]
        },
        {
          "id": "7434790",
          "text": "Ein Fehler wäre tödlich gewesen.",
          "translation": "Ошибка могла бы стоить жизни.",
          "source": "Tatoeba #7434790 @raggione / #7436033 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7434790",
          "cefr_level": "A1",
          "word_slugs": [
            "tödlich-adj"
          ]
        },
        {
          "id": "2963611",
          "text": "Reisen ist tödlich für Vorurteile.",
          "translation": "Путешествия смертельны для предрассудков.",
          "source": "Tatoeba #2963611 @Esperantostern / #2966171 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2963611",
          "cefr_level": "A1",
          "word_slugs": [
            "tödlich-adj"
          ]
        },
        {
          "id": "3149145",
          "text": "Er war tödlich an Krebs erkrankt.",
          "translation": "Он был смертельно болен раком.",
          "source": "Tatoeba #3149145 @Pfirsichbaeumchen / #2695581 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3149145",
          "cefr_level": "A1",
          "word_slugs": [
            "tödlich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
