      "examples": [
        {
          "id": "8862522",
          "text": "Herr Schmidt ist angekommen.",
          "translation": "Господин Смит приехал.",
          "source": "Tatoeba #8862522 @wolfgangth / #9494311 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8862522",
          "cefr_level": "A1",
