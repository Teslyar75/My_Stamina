    {
      "slug": "gutem-adj",
      "lemma": "gutem",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5674,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong dative masculine/neuter singular of gut"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13935543",
          "text": "Gesundheit beginnt mit gutem Schlaf.",
          "translation": "Здоровье начинается с хорошего сна.",
          "source": "Tatoeba #13935543 @mhr / #13935609 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13935543",
          "cefr_level": "A1",
          "word_slugs": [
            "gutem-adj"
          ]
        },
        {
          "id": "12425009",
          "text": "Dieses Auto ist in gutem Zustand.",
          "translation": "Этот автомобиль находится в хорошем состоянии.",
          "source": "Tatoeba #12425009 @felix63 / #12425010 @felix63 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12425009",
          "cefr_level": "A1",
          "word_slugs": [
            "gutem-adj"
          ]
        },
        {
          "id": "2040040",
          "text": "Ich bestätigte dies mit gutem Gewissen.",
          "translation": "Я подтвердил это со спокойной совестью.",
          "source": "Tatoeba #2040040 @al_ex_an_der / #2040039 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2040040",
          "cefr_level": "A1",
          "word_slugs": [
            "gutem-adj"
          ]
        },
        {
          "id": "8350828",
          "text": "Ich habe es aus gutem Grund getan.",
          "translation": "Я сделал это не зря.",
          "source": "Tatoeba #8350828 @Pfirsichbaeumchen / #10362617 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8350828",
          "cefr_level": "A1",
          "word_slugs": [
            "gutem-adj"
          ]
        },
        {
          "id": "3452741",
          "text": "Möbel aus gutem Material verkaufen sich gut.",
          "translation": "Мебель, сделанная из хороших материалов, продаётся хорошо.",
          "source": "Tatoeba #3452741 @Manfredo / #3454469 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3452741",
          "cefr_level": "A1",
          "word_slugs": [
            "gutem-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
