      "gender": null,
      "examples": [
        {
          "id": "1555543",
          "text": "Tom benimmt sich sonderbar.",
          "translation": "Том странно себя ведёт.",
          "source": "Tatoeba #1555543 @Pfirsichbaeumchen / #2269257 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1555543",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmt-verb"
          ]
        },
        {
          "id": "1486026",
          "text": "Ihr Kind benimmt sich gut.",
          "translation": "Её ребёнок хорошо себя ведёт.",
          "source": "Tatoeba #1486026 @Zaghawa / #2005099 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1486026",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmt-verb"
          ]
        },
        {
          "id": "2309285",
          "text": "Er benimmt sich sehr natürlich.",
          "translation": "Он ведёт себя очень естественно.",
          "source": "Tatoeba #2309285 @Pfirsichbaeumchen / #2365418 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2309285",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmt-verb"
          ]
        },
        {
          "id": "1854312",
          "text": "Er benimmt sich manchmal seltsam.",
          "translation": "Он иногда ведёт себя странно.",
          "source": "Tatoeba #1854312 @Zaghawa / #11153966 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1854312",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmt-verb"
          ]
        },
        {
          "id": "7637073",
          "text": "Tom benimmt sich wie ein Kind.",
          "translation": "Том ведёт себя как ребёнок.",
          "source": "Tatoeba #7637073 @wolfgangth / #1670354 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7637073",
          "cefr_level": "A1",
