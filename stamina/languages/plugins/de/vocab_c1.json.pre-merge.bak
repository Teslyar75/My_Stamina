    {
      "slug": "beneide-verb",
      "lemma": "beneide",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8423,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of beneiden:",
          "first-person singular present",
          "inflection of beneiden:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "741466",
          "text": "Ich beneide ihn.",
          "translation": "Я ему завидую.",
          "source": "Tatoeba #741466 @Manfredo / #1678812 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/741466",
          "cefr_level": "A1",
          "word_slugs": [
            "beneide-verb"
          ]
        },
        {
          "id": "2489634",
          "text": "Ich beneide Tom.",
          "translation": "Я завидую Тому.",
          "source": "Tatoeba #2489634 @Pfirsichbaeumchen / #2489628 @ichigo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2489634",
          "cefr_level": "A1",
          "word_slugs": [
            "beneide-verb"
          ]
        },
        {
          "id": "2696029",
          "text": "Ich beneide sie.",
          "translation": "Я ей завидую.",
          "source": "Tatoeba #2696029 @Pfirsichbaeumchen / #4854376 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2696029",
          "cefr_level": "A1",
          "word_slugs": [
            "beneide-verb"
          ]
        },
        {
          "id": "5333097",
          "text": "Wie ich dich beneide!",
          "translation": "Как я тебе завидую!",
          "source": "Tatoeba #5333097 @Pfirsichbaeumchen / #540748 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5333097",
          "cefr_level": "A1",
          "word_slugs": [
            "beneide-verb"
          ]
        },
        {
          "id": "893873",
          "text": "Ich beneide dich sehr.",
          "translation": "Я тебе так завидую.",
          "source": "Tatoeba #893873 @xtofu80 / #5143145 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/893873",
          "cefr_level": "A1",
          "word_slugs": [
            "beneide-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
