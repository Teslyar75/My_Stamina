        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7590144",
          "text": "Uns verbindet eine Freundschaft.",
          "translation": "Нас связывает дружба.",
          "source": "Tatoeba #7590144 @Pfirsichbaeumchen / #7583279 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7590144",
          "cefr_level": "A1",
          "word_slugs": [
            "verbindet-verb"
          ]
        },
        {
          "id": "8634374",
          "text": "Die Krankenschwester verbindet die Wunde.",
          "translation": "Медицинская сестра перевязывает рану.",
          "source": "Tatoeba #8634374 @Melang / #8641918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634374",
          "cefr_level": "A1",
          "word_slugs": [
            "verbindet-verb"
          ]
        },
        {
          "id": "2263481",
          "text": "Die Schulter verbindet Arm und Rumpf.",
          "translation": "Плечо соединяет руку и туловище.",
          "source": "Tatoeba #2263481 @al_ex_an_der / #2263482 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2263481",
          "cefr_level": "A1",
          "word_slugs": [
            "verbindet-verb"
          ]
        },
        {
          "id": "6326991",
          "text": "Das Internet verbindet Menschen auf der ganzen Welt.",
          "translation": "Интернет объединяет людей по всему миру.",
          "source": "Tatoeba #6326991 @felix63 / #6327048 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326991",
          "cefr_level": "A1",
          "word_slugs": [
            "verbindet-verb"
          ]
        },
        {
          "id": "519673",
          "text": "Der Panama-Kanal verbindet den Atlantik mit dem Pazifik.",
          "translation": "Панамский канал соединяет Атлантический океан с Тихим.",
          "source": "Tatoeba #519673 @xtofu80 / #8299550 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/519673",
          "cefr_level": "A1",
          "word_slugs": [
            "verbindet-verb"
          ]
        }
      ],
