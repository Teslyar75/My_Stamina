        {
          "id": "9514151",
          "text": "Pusten Sie die Kerze aus!",
          "translation": "Задуйте свечу.",
          "source": "Tatoeba #9514151 @Pfirsichbaeumchen / #9513337 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9514151",
          "cefr_level": "A1",
          "word_slugs": [
            "kerze-noun"
          ]
        },
        {
          "id": "12356317",
          "text": "Ich zündete die Kerze an.",
