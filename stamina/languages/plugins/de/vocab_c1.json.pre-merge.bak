    {
      "slug": "frühstücken-noun",
      "lemma": "Frühstücken",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6411,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Frühstück"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8496696",
          "text": "Wir haben kaum Zeit zum Frühstücken.",
          "translation": "Мы едва успеваем позавтракать.",
          "source": "Tatoeba #8496696 @Yorwba / #13455926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8496696",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-noun"
          ]
        },
        {
          "id": "5795746",
          "text": "Nach dem Frühstücken trinke ich einen kleinen Kaffee und kleide mich an.",
          "translation": "После завтрака я пью немного кофе и одеваюсь.",
          "source": "Tatoeba #5795746 @list / #5820458 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5795746",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-noun"
          ]
        },
        {
          "id": "9858862",
          "text": "Frühstücken Sie gewöhnlich?",
          "translation": "Вы обычно завтракаете?",
          "source": "Tatoeba #9858862 @Pfirsichbaeumchen / #10194108 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9858862",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-noun"
          ]
        },
        {
          "id": "4049358",
          "text": "Frühstücken Sie jeden Tag?",
          "translation": "Вы каждый день завтракаете?",
          "source": "Tatoeba #4049358 @Pfirsichbaeumchen / #9073549 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4049358",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-noun"
          ]
        },
        {
          "id": "6841168",
          "text": "Frühstücken Sie jeden Morgen zur gleichen Stunde?",
          "translation": "Вы завтракаете по утрам в одно и то же время?",
          "source": "Tatoeba #6841168 @Pfirsichbaeumchen / #6842486 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841168",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
