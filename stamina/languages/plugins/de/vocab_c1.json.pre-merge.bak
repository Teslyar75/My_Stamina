          ]
        },
        {
          "id": "378551",
          "text": "Werft keine Steine.",
          "translation": "Не бросайте камни.",
          "source": "Tatoeba #378551 @MUIRIEL / #13241163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/378551",
          "cefr_level": "A1",
          "word_slugs": [
            "werft-noun"
          ]
        },
        {
          "id": "1702768",
          "text": "Werft eure Waffen weg!",
          "translation": "Бросайте оружие!",
          "source": "Tatoeba #1702768 @al_ex_an_der / #1953850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1702768",
          "cefr_level": "A1",
          "word_slugs": [
            "werft-noun"
          ]
        },
        {
          "id": "7158454",
          "text": "Werft die einfach weg.",
          "translation": "Просто выбросьте их.",
          "source": "Tatoeba #7158454 @Luiaard / #7912950 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7158454",
          "cefr_level": "A1",
