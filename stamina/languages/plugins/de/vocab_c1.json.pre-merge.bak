      "gender": null,
      "examples": [
        {
          "id": "1823219",
          "text": "Es wimmelt wie in einem Ameisenhaufen.",
          "translation": "Кишмя кишит.",
          "source": "Tatoeba #1823219 @al_ex_an_der / #1823221 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1823219",
          "cefr_level": "A1",
          "word_slugs": [
            "wimmelt-verb"
          ]
        },
        {
          "id": "2690086",
          "text": "Auf der Straße wimmelt es von Leuten.",
          "translation": "Улица была полна людей.",
          "source": "Tatoeba #2690086 @kolonjano / #12378916 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2690086",
          "cefr_level": "A1",
          "word_slugs": [
            "wimmelt-verb"
          ]
        },
        {
          "id": "615360",
          "text": "In meinem Zimmer wimmelt es vor Gefahren.",
          "translation": "Моя комната кишит опасностями.",
          "source": "Tatoeba #615360 @virgil / #565361 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/615360",
          "cefr_level": "A1",
          "word_slugs": [
            "wimmelt-verb"
          ]
        },
        {
          "id": "1823258",
          "text": "In der Welt wimmelt es von Schwätzern und Lügnern.",
          "translation": "Мир кишмя кишит вралями и лжецами.",
          "source": "Tatoeba #1823258 @al_ex_an_der / #1823255 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1823258",
          "cefr_level": "A1",
          "word_slugs": [
            "wimmelt-verb"
          ]
        }
      ],
