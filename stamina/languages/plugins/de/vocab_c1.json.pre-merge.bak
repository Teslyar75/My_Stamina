    {
      "slug": "produktion-noun",
      "lemma": "Produktion",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6645,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "производство"
        ],
        "en": [
          "production"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5013356",
          "text": "Die meisten dieser Produkte stammen aus heimischer Produktion.",
          "translation": "Большинство этих продуктов отечественного производства.",
          "source": "Tatoeba #5013356 @Dani6187 / #2549955 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5013356",
          "cefr_level": "A1",
          "word_slugs": [
            "produktion-noun"
          ]
        },
        {
          "id": "12847828",
          "text": "Das Unternehmen will die Produktion in diesem Jahr steigern.",
          "translation": "Предприятие хочет в этом году увеличить производство.",
          "source": "Tatoeba #12847828 @mhr / #12847810 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12847828",
          "cefr_level": "A1",
          "word_slugs": [
            "produktion-noun"
          ]
        },
        {
          "id": "2877456",
          "text": "Diese Firma ist bekannt für ihre qualitativ hochwertige Produktion.",
          "translation": "Эта фирма известна своей высококачественной продукцией.",
          "source": "Tatoeba #2877456 @al_ex_an_der / #2804991 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2877456",
          "cefr_level": "A1",
          "word_slugs": [
            "produktion-noun"
          ]
        },
        {
          "id": "5607787",
          "text": "Im Laufe von zehn Jahren hat sich die Produktion vervierfacht.",
          "translation": "За десять лет производство выросло в 4 раза.",
          "source": "Tatoeba #5607787 @Pfirsichbaeumchen / #5607772 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5607787",
          "cefr_level": "A1",
          "word_slugs": [
            "produktion-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Produktion",
        "nominative_pl": ""
      }
    },
    {
      "slug": "füreinander-adv",
      "lemma": "füreinander",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6646,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "друг для друга",
          "друг за друга"
        ],
        "en": [
          "for each other / one another"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4882563",
          "text": "Die sind füreinander gemacht.",
          "translation": "Они созданы друг для друга.",
          "source": "Tatoeba #4882563 @Pfirsichbaeumchen / #4595276 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4882563",
          "cefr_level": "A1",
          "word_slugs": [
            "füreinander-adv"
          ]
        },
        {
          "id": "9729437",
          "text": "Ihr seid wie füreinander geschaffen!",
          "translation": "Вы будто созданы друг для друга!",
          "source": "Tatoeba #9729437 @Pfirsichbaeumchen / #13893283 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9729437",
          "cefr_level": "A1",
          "word_slugs": [
            "füreinander-adv"
          ]
        },
        {
          "id": "11078742",
          "text": "Wir waren nicht füreinander bestimmt.",
          "translation": "Мы не были созданы друг для друга.",
          "source": "Tatoeba #11078742 @Pfirsichbaeumchen / #14101942 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11078742",
          "cefr_level": "A1",
          "word_slugs": [
            "füreinander-adv"
          ]
        },
        {
          "id": "1588101",
          "text": "Die beiden scheinen wie füreinander gemacht.",
          "translation": "Похоже, эти двое просто созданы друг для друга.",
          "source": "Tatoeba #1588101 @Pfirsichbaeumchen / #2055112 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1588101",
          "cefr_level": "A1",
          "word_slugs": [
            "füreinander-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
