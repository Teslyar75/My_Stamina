      "gender": null,
      "examples": [
        {
          "id": "4005486",
          "text": "Versteckst du was?",
          "translation": "Ты что-то скрываешь?",
          "source": "Tatoeba #4005486 @pullnosemans / #4350207 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4005486",
          "cefr_level": "A1",
