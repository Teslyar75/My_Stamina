    {
      "slug": "kranken-noun",
      "lemma": "Kranken",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5027,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Kranker",
          "plural of Kranker",
          "plural of Kranke"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "778580",
          "text": "Bringen Sie den Kranken in Rückenlage!",
          "translation": "Положите больного на спину!",
          "source": "Tatoeba #778580 @Pfirsichbaeumchen / #778255 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/778580",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-noun"
          ]
        },
        {
          "id": "778254",
          "text": "Legen Sie den Kranken auf den Rücken!",
          "translation": "Положите больного на спину!",
          "source": "Tatoeba #778254 @Pfirsichbaeumchen / #778255 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/778254",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-noun"
          ]
        },
        {
          "id": "5732740",
          "text": "Die Krankenschwester gab dem Kranken eine Spritze.",
          "translation": "Медсестра сделала пациенту укол.",
          "source": "Tatoeba #5732740 @dispy / #7092495 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5732740",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-noun"
          ]
        },
        {
          "id": "4849636",
          "text": "Mit dem Kranken geht es jetzt zu Ende.",
          "translation": "Больной сейчас скончается.",
          "source": "Tatoeba #4849636 @al_ex_an_der / #4849627 @al_lastor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4849636",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-noun"
          ]
        },
        {
          "id": "4720458",
          "text": "Dem Gesunden fehlt viel, dem Kranken nur eins.",
          "translation": "Здоровому человеку не хватает многого, больному - только одного.",
          "source": "Tatoeba #4720458 @Esperantostern / #10652541 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4720458",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "kranken-verb",
      "lemma": "kranken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5027,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "болеть"
        ],
        "en": [
          "to be ailing (from), to be held back (by), to be suffering (from) [with an (+ dative)] (to struggle with a non-catastrophic but severely limiting issue)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2664129",
          "text": "Die Jungen nahmen sich des kranken Igels an.",
          "translation": "Мальчики взяли больного ёжика себе.",
          "source": "Tatoeba #2664129 @freddy1 / #6317583 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2664129",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-verb"
          ]
        },
        {
          "id": "563430",
          "text": "Der Arzt beugte sich über den kranken Jungen.",
          "translation": "Доктор склонился над больным мальчиком.",
          "source": "Tatoeba #563430 @MUIRIEL / #2255547 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/563430",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-verb"
          ]
        },
        {
          "id": "2089255",
          "text": "Er kommt jeden Tag seinen kranken Freund besuchen.",
          "translation": "Он каждый день приходит навестить своего больного друга.",
          "source": "Tatoeba #2089255 @Zaghawa / #7760491 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2089255",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-verb"
          ]
        },
        {
          "id": "7352583",
          "text": "Maria saß die ganze Nacht am Bett ihres kranken Sohnes.",
          "translation": "Мария всю ночь просидела у постели больного сына.",
          "source": "Tatoeba #7352583 @Pfirsichbaeumchen / #6964287 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7352583",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-verb"
          ]
        },
        {
          "id": "2089252",
          "text": "Er kommt jeden Tag, um seinen kranken Freund zu besuchen.",
          "translation": "Он каждый день приходит навестить своего больного друга.",
          "source": "Tatoeba #2089252 @Zaghawa / #7760491 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2089252",
          "cefr_level": "A1",
          "word_slugs": [
            "kranken-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
