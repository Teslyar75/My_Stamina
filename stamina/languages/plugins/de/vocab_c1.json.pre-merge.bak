    {
      "slug": "verdorben-verb",
      "lemma": "verdorben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6644,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of verderben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5257355",
          "text": "Du hast alles verdorben!",
          "translation": "Ты всё испортил.",
          "source": "Tatoeba #5257355 @Pfirsichbaeumchen / #1890225 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5257355",
          "cefr_level": "A1",
          "word_slugs": [
            "verdorben-verb"
          ]
        },
        {
          "id": "13322655",
          "text": "Er hat allen die Laune verdorben.",
          "translation": "Он испортил всем настроение.",
          "source": "Tatoeba #13322655 @Waldelfe / #13322664 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13322655",
          "cefr_level": "A1",
          "word_slugs": [
            "verdorben-verb"
          ]
        },
        {
          "id": "353389",
          "text": "Das hat ihm den Appetit verdorben.",
          "translation": "Это испортило ему аппетит.",
          "source": "Tatoeba #353389 @MUIRIEL / #1031569 @Mira (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/353389",
          "cefr_level": "A1",
          "word_slugs": [
            "verdorben-verb"
          ]
        },
        {
          "id": "982043",
          "text": "Die Hälfte der Äpfel ist verdorben.",
          "translation": "Половина яблок гнилая.",
          "source": "Tatoeba #982043 @Sudajaengi / #8863064 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/982043",
          "cefr_level": "A1",
          "word_slugs": [
            "verdorben-verb"
          ]
        },
        {
          "id": "13191676",
          "text": "Die Lebensmittel im Kühlschrank sind verdorben.",
          "translation": "Продукты в холодильнике испортились.",
          "source": "Tatoeba #13191676 @Biderl / #13191727 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13191676",
          "cefr_level": "A1",
          "word_slugs": [
            "verdorben-verb"
          ]
        }
      ],
      "tags": [
