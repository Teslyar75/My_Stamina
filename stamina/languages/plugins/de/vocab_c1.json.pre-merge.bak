      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of laut:",
          "strong genitive masculine/neuter singular",
          "inflection of laut:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2272353",
          "text": "Wie lauten deine Initialen?",
          "translation": "Какие у тебя инициалы?",
          "source": "Tatoeba #2272353 @Pfirsichbaeumchen / #12272135 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2272353",
          "cefr_level": "A1",
          "word_slugs": [
            "lauten-adj"
          ]
        },
        {
          "id": "2289334",
          "text": "Wie lauten deine Pflichten?",
          "translation": "Каковы твои обязанности?",
          "source": "Tatoeba #2289334 @Pfirsichbaeumchen / #6879871 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2289334",
          "cefr_level": "A1",
          "word_slugs": [
            "lauten-adj"
          ]
        },
        {
          "id": "12421462",
          "text": "Wie lauten die Spielregeln?",
          "translation": "Каковы правила игры?",
          "source": "Tatoeba #12421462 @Waldelfe / #13606993 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12421462",
          "cefr_level": "A1",
          "word_slugs": [
            "lauten-adj"
          ]
        },
        {
          "id": "824605",
          "text": "Ich wurde plötzlich von einem lauten Geräusch geweckt.",
          "translation": "Я был внезапно разбужен громким звуком.",
          "source": "Tatoeba #824605 @Zaghawa / #10214986 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/824605",
          "cefr_level": "A1",
          "word_slugs": [
            "lauten-adj"
          ]
        },
        {
          "id": "10619486",
          "text": "Dieser Satz sollte so lauten: „Ich werde ein neues kaufen.“",
          "translation": "Это предложение должно звучать так: \"Я куплю новый\".",
          "source": "Tatoeba #10619486 @Pfirsichbaeumchen / #11874106 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10619486",
          "cefr_level": "A1",
          "word_slugs": [
            "lauten-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
