      "gender": null,
      "examples": [
        {
          "id": "842031",
          "text": "Unbefugter Zutritt verboten.",
          "translation": "Несанкционированный проход запрещён.",
          "source": "Tatoeba #842031 @Espi / #886837 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/842031",
          "cefr_level": "A1",
          "word_slugs": [
