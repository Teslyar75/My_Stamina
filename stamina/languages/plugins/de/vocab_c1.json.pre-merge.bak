    {
      "slug": "kranker-adj",
      "lemma": "kranker",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9076,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of krank:",
          "strong/mixed nominative masculine singular",
          "inflection of krank:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5058552",
          "text": "Ich bin ein schwer kranker Mensch.",
          "translation": "Я тяжело больной человек.",
          "source": "Tatoeba #5058552 @al_ex_an_der / #5058549 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5058552",
          "cefr_level": "A1",
          "word_slugs": [
            "kranker-adj"
          ]
        },
        {
          "id": "5174520",
          "text": "Ein kranker Geist geht allzeit irr.",
          "translation": "Больная душа всегда ошибается.",
          "source": "Tatoeba #5174520 @Pfirsichbaeumchen / #5174485 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5174520",
          "cefr_level": "A1",
          "word_slugs": [
            "kranker-adj"
          ]
        },
        {
          "id": "3655696",
          "text": "Er bemerkte nicht, dass im Nebenzimmer ein kranker Mann schlief.",
          "translation": "Он не заметил, что в соседней комнате спит больной мужчина.",
          "source": "Tatoeba #3655696 @ndphyl / #5003114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3655696",
          "cefr_level": "A1",
          "word_slugs": [
            "kranker-adj"
          ]
        }
      ],
      "tags": [
