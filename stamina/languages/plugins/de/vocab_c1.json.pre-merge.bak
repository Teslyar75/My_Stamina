    {
      "slug": "beschuldigen-verb",
      "lemma": "beschuldigen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6663,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to accuse, to blame"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13052730",
          "text": "Wir beschuldigen immer Andere.",
          "translation": "Мы всегда обвиняем других.",
          "source": "Tatoeba #13052730 @mhr / #13052576 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13052730",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigen-verb"
          ]
        },
        {
          "id": "13892340",
          "text": "Manche beschuldigen die Politiker.",
          "translation": "Некоторые винят политиков.",
          "source": "Tatoeba #13892340 @mhr / #13892260 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13892340",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigen-verb"
          ]
        },
        {
          "id": "13052732",
          "text": "Wir beschuldigen immer die Anderen.",
          "translation": "Мы всегда обвиняем других.",
          "source": "Tatoeba #13052732 @mhr / #13052576 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13052732",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigen-verb"
          ]
        },
        {
          "id": "11549793",
          "text": "Sie wollen nur jemanden, den sie beschuldigen können.",
          "translation": "Им просто нужен кто-то, кого они могут обвинить.",
          "source": "Tatoeba #11549793 @Grmpy / #11549924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11549793",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigen-verb"
          ]
        },
        {
          "id": "5095942",
          "text": "Bitte beschuldigen Sie mich nicht dessen, was ich nicht getan habe.",
          "translation": "Пожалуйста, не обвиняйте меня в том, чего я не делал.",
          "source": "Tatoeba #5095942 @al_ex_an_der / #5094587 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5095942",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigen-verb"
          ]
        }
      ],
      "tags": [
