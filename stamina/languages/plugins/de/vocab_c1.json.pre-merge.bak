    {
      "slug": "wunderbaren-adj",
      "lemma": "wunderbaren",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6697,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of wunderbar:",
          "strong genitive masculine/neuter singular",
          "inflection of wunderbar:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1807368",
          "text": "Wir leben in einer wunderbaren Zeit.",
          "translation": "Мы живём в замечательное время.",
          "source": "Tatoeba #1807368 @Esperantostern / #5552143 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1807368",
          "cefr_level": "A1",
          "word_slugs": [
            "wunderbaren-adj"
          ]
        },
        {
          "id": "4698771",
          "text": "Die Welt ist voll von wunderbaren Büchern, die keiner liest.",
          "translation": "Мир полон чудесных книг, которых никто не читает.",
          "source": "Tatoeba #4698771 @Esperantostern / #13098879 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4698771",
          "cefr_level": "A1",
          "word_slugs": [
            "wunderbaren-adj"
          ]
        },
        {
          "id": "12026020",
          "text": "Ich hoffe, dass das der Beginn einer wunderbaren Freundschaft ist.",
          "translation": "Я надеюсь, что это начало прекрасной дружбы.",
          "source": "Tatoeba #12026020 @Pfirsichbaeumchen / #4067572 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12026020",
          "cefr_level": "A1",
          "word_slugs": [
            "wunderbaren-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
