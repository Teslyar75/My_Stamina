          ]
        },
        {
          "id": "13922163",
          "text": "Sie aß Fleisch.",
          "translation": "Она поела мяса.",
          "source": "Tatoeba #13922163 @mhr / #13447647 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13922163",
