      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9865,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verbieten:",
          "first-person singular present",
          "inflection of verbieten:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12406911",
          "text": "Das verbiete ich dir!",
          "translation": "Я тебе запрещаю!",
          "source": "Tatoeba #12406911 @Waldelfe / #12407080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12406911",
          "cefr_level": "A1",
          "word_slugs": [
