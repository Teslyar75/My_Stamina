    {
      "slug": "fürsten-noun",
      "lemma": "Fürsten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9334,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Fürst:",
          "genitive/dative/accusative singular",
          "inflection of Fürst:",
          "nominative/genitive/dative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "783766",
          "text": "Gib unsern Fürsten Fried und gut Regiment.",
          "translation": "Дай нашему начальству жизнь тихую и безмятежную во всяком благо­честии и чистоте.",
          "source": "Tatoeba #783766 @BraveSentry / #2874236 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/783766",
          "cefr_level": "A1",
          "word_slugs": [
            "fürsten-noun"
          ]
        },
        {
          "id": "13800634",
          "text": "Keiner weiß, wo sich das Grab des Fürsten befindet.",
          "translation": "Никто не знает, где находится могила князя.",
          "source": "Tatoeba #13800634 @maaster / #13800881 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13800634",
          "cefr_level": "A1",
          "word_slugs": [
            "fürsten-noun"
          ]
        },
        {
          "id": "9979765",
          "text": "Dieser junge Mann ist ein Nachkomme eines russischen Fürsten.",
          "translation": "Этот юноша — потомок русского князя.",
          "source": "Tatoeba #9979765 @GaryGaryGary / #5751492 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9979765",
          "cefr_level": "A1",
          "word_slugs": [
            "fürsten-noun"
          ]
        }
      ],
      "tags": [
