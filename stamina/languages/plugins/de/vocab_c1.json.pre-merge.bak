            "lenkt-verb"
          ]
        },
        {
          "id": "444153",
          "text": "Der Mann denkt, die Frau lenkt.",
          "translation": "Муж предполагает, жена располагает.",
          "source": "Tatoeba #444153 @jerom / #2790445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/444153",
          "cefr_level": "A1",
          "word_slugs": [
            "lenkt-verb"
          ]
        },
        {
          "id": "1562651",
          "text": "Bitte lenkt mich nicht von meiner Arbeit ab.",
          "translation": "Не отвлекайте меня от работы, пожалуйста.",
          "source": "Tatoeba #1562651 @al_ex_an_der / #10311507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1562651",
