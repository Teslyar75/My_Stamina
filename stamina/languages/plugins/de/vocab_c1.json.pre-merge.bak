    {
      "slug": "riesiger-adj",
      "lemma": "riesiger",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8556,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of riesig:",
