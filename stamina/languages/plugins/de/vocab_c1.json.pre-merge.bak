    {
      "slug": "sodass-conj",
      "lemma": "sodass",
      "pos": "conj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5144,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "так что"
        ],
        "en": [
          "so that",
          "such that"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1194580",
          "text": "Es war sehr kalt, sodass meine Zähne klapperten.",
          "translation": "Было так холодно, что у меня зубы стучали.",
          "source": "Tatoeba #1194580 @Esperantostern / #4464403 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1194580",
          "cefr_level": "A1",
          "word_slugs": [
            "sodass-conj"
          ]
        },
        {
          "id": "14112188",
          "text": "Gebt ihm Geld, sodass er sich Brot kaufen kann.",
          "translation": "Дайте ему денег, чтобы он мог купить хлеб.",
          "source": "Tatoeba #14112188 @mhr / #14113239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14112188",
