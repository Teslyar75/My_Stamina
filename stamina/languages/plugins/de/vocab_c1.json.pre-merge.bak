    {
      "slug": "vorbeigekommen-verb",
      "lemma": "vorbeigekommen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8011,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of vorbeikommen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12086712",
          "text": "Ist Tom vorbeigekommen?",
          "translation": "Том заходил?",
          "source": "Tatoeba #12086712 @Pfirsichbaeumchen / #12086839 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12086712",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbeigekommen-verb"
          ]
        },
        {
          "id": "4942710",
          "text": "Niemand ist vorbeigekommen.",
          "translation": "Никто не прошёл мимо.",
          "source": "Tatoeba #4942710 @Hans_Adler / #11835684 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4942710",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbeigekommen-verb"
          ]
        },
        {
          "id": "12170008",
          "text": "Ich werde ihnen sagen, dass du vorbeigekommen bist.",
          "translation": "Я скажу им, что ты заходила.",
          "source": "Tatoeba #12170008 @mhr / #4036300 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12170008",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbeigekommen-verb"
          ]
        },
        {
          "id": "13320359",
          "text": "Wenn ich Zeit gehabt hätte, wäre ich vorbeigekommen.",
          "translation": "Если бы у меня было время, я бы к вам зашёл.",
          "source": "Tatoeba #13320359 @Waldelfe / #12505372 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13320359",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbeigekommen-verb"
          ]
        },
        {
          "id": "14068260",
          "text": "Sie ist heute vorbeigekommen und hat nach dir gefragt.",
          "translation": "Она приходила сегодня, спрашивала о тебе.",
          "source": "Tatoeba #14068260 @mhr / #14068185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14068260",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbeigekommen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "stärken-verb",
      "lemma": "stärken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8012,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "усиливать"
        ],
        "en": [
          "to strengthen (to add to the power or effect of something)",
          "to have a meal or drink (especially before, during or after a physically demanding task)",
          "to starch (to treat a piece of clothing with starch to make it stiffer)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4829473",
          "text": "Ich will meine Muskeln stärken.",
          "translation": "Я хочу укрепить свои мускулы.",
          "source": "Tatoeba #4829473 @al_ex_an_der / #4829472 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4829473",
          "cefr_level": "A1",
          "word_slugs": [
            "stärken-verb"
          ]
        },
        {
          "id": "2943457",
          "text": "Um das Selbstwertgefühl zu stärken, ist es erforderlich seine Stärken zu entwickeln.",
          "translation": "Чтобы повысить самооценку, необходимо развивать свои сильные стороны.",
          "source": "Tatoeba #2943457 @al_ex_an_der / #2943455 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2943457",
          "cefr_level": "A1",
          "word_slugs": [
            "stärken-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "stärken-noun",
      "lemma": "Stärken",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8012,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Stärke"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2409639",
          "text": "Was sind deine Stärken?",
          "translation": "В чём твои сильные стороны?",
          "source": "Tatoeba #2409639 @samueldora / #13881980 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2409639",
          "cefr_level": "A1",
          "word_slugs": [
            "stärken-noun"
          ]
        },
        {
          "id": "13925786",
          "text": "Jeder hat seine Stärken.",
          "translation": "У каждого есть сильные стороны.",
          "source": "Tatoeba #13925786 @IAlexI / #758688 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13925786",
          "cefr_level": "A1",
          "word_slugs": [
            "stärken-noun"
          ]
        },
        {
          "id": "14082389",
          "text": "Jeder Schüler hat seine Stärken.",
          "translation": "У каждого ученика есть свои сильные стороны.",
          "source": "Tatoeba #14082389 @Biderl / #14082393 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14082389",
          "cefr_level": "A1",
          "word_slugs": [
            "stärken-noun"
          ]
        },
        {
          "id": "3612145",
          "text": "Was, glaubst du, sind meine Stärken?",
          "translation": "Как ты думаешь, какие мои сильные стороны?",
          "source": "Tatoeba #3612145 @Trinkschokolade / #3612878 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3612145",
          "cefr_level": "A1",
          "word_slugs": [
            "stärken-noun"
          ]
        },
        {
          "id": "398902",
          "text": "Jeder hat seine Stärken und Schwächen.",
          "translation": "У каждого есть сильные и слабые стороны.",
          "source": "Tatoeba #398902 @MUIRIEL / #5585 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398902",
          "cefr_level": "A1",
          "word_slugs": [
            "stärken-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
