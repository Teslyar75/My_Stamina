          ]
        },
        {
          "id": "12372275",
          "text": "Könntet ihr das Licht einschalten?",
          "translation": "Вы не могли бы включить свет?",
          "source": "Tatoeba #12372275 @Pfirsichbaeumchen / #12372184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12372275",
