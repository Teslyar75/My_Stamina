          "source": "Tatoeba #7794060 @driini / #5313920 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7794060",
          "cefr_level": "A1",
          "word_slugs": [
            "kaltes-adj"
          ]
