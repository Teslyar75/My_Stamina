    {
      "slug": "länder-noun",
      "lemma": "Länder",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6202,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Land (lands, countries)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3082735",
          "text": "Tom besuchte vier Länder.",
          "translation": "Том побывал в четырёх странах.",
          "source": "Tatoeba #3082735 @Pfirsichbaeumchen / #6546488 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3082735",
          "cefr_level": "A1",
          "word_slugs": [
            "länder-noun"
          ]
        },
        {
          "id": "10460730",
          "text": "Ich mag europäische Länder.",
          "translation": "Мне нравятся страны Европы.",
          "source": "Tatoeba #10460730 @Rovo / #10460982 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10460730",
          "cefr_level": "A1",
          "word_slugs": [
            "länder-noun"
          ]
        },
        {
          "id": "809528",
          "text": "Andere Länder, andere Sitten.",
          "translation": "Другие страны - другие нравы.",
          "source": "Tatoeba #809528 @TomSFox / #10948358 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/809528",
          "cefr_level": "A1",
          "word_slugs": [
            "länder-noun"
          ]
        },
        {
          "id": "1223143",
          "text": "Andere Länder; andere Sitten.",
          "translation": "Другие страны - другие нравы.",
          "source": "Tatoeba #1223143 @al_ex_an_der / #10948358 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1223143",
          "cefr_level": "A1",
          "word_slugs": [
            "länder-noun"
          ]
        },
        {
          "id": "705372",
          "text": "Andere Länder – andere Sitten.",
          "translation": "Другие страны - другие нравы.",
          "source": "Tatoeba #705372 @virgil / #10948358 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/705372",
          "cefr_level": "A1",
          "word_slugs": [
            "länder-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
