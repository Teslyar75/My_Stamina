    {
      "slug": "julius-name",
      "lemma": "Julius",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7771,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "Юлий"
        ],
        "en": [
          "a male given name from Latin"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2425804",
          "text": "Ich heiße Julius.",
          "translation": "Меня зовут Юлиус.",
          "source": "Tatoeba #2425804 @bionicboy / #2425808 @bionicboy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2425804",
          "cefr_level": "A1",
          "word_slugs": [
            "julius-name"
          ]
        },
        {
          "id": "13973053",
          "text": "Mein Name ist Julius.",
          "translation": "Меня зовут Юлиус.",
          "source": "Tatoeba #13973053 @AaronAardvark / #2425808 @bionicboy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13973053",
          "cefr_level": "A1",
          "word_slugs": [
            "julius-name"
          ]
        },
        {
          "id": "1008241",
          "text": "Julius Caesar war ein römischer Imperator.",
          "translation": "Юлий Цезарь был римским императором.",
          "source": "Tatoeba #1008241 @MUIRIEL / #2758545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1008241",
          "cefr_level": "A1",
          "word_slugs": [
            "julius-name"
          ]
        },
        {
          "id": "1210449",
          "text": "Der große römische Held, Julius Cesar, wurde ermordet.",
          "translation": "Великий римский герой Юлий Цезарь был убит.",
          "source": "Tatoeba #1210449 @franzc424 / #13586857 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1210449",
          "cefr_level": "A1",
          "word_slugs": [
            "julius-name"
          ]
        },
        {
          "id": "13973052",
          "text": "Julius ist ein lateinischer Name dessen Bedeutung man nicht genau kennt.",
          "translation": "Юлиус — имя латинского происхождения, чьё значение точно не известно.",
          "source": "Tatoeba #13973052 @AaronAardvark / #13973665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13973052",
          "cefr_level": "A1",
          "word_slugs": [
            "julius-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Julius",
        "nominative_pl": ""
      }
    },
