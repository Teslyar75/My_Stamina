          "cefr_level": "A1",
          "word_slugs": [
            "verschoben-verb"
          ]
        },
        {
          "id": "841968",
          "text": "Er hat seine Abreise auf morgen verschoben.",
          "translation": "Он отложил свой отъезд до завтра.",
          "source": "Tatoeba #841968 @MUIRIEL / #1706399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/841968",
          "cefr_level": "A1",
          "word_slugs": [
            "verschoben-verb"
          ]
        },
        {
          "id": "2735195",
          "text": "Tom hat seine Abreise auf Sonntag verschoben.",
          "translation": "Том отложил свой отъезд до воскресенья.",
