          "to wake up"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8630463",
          "text": "Nicht die Katze aufwecken!",
          "translation": "Не разбуди кошку.",
          "source": "Tatoeba #8630463 @Pfirsichbaeumchen / #8587974 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8630463",
          "cefr_level": "A1",
          "word_slugs": [
            "aufwecken-verb"
          ]
        },
        {
          "id": "6106163",
          "text": "Ich will ihn nicht aufwecken.",
          "translation": "Я не хочу его будить.",
          "source": "Tatoeba #6106163 @Esperantostern / #4020141 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6106163",
          "cefr_level": "A1",
          "word_slugs": [
            "aufwecken-verb"
          ]
        },
        {
          "id": "3313837",
          "text": "Ich wollte dich nicht aufwecken.",
          "translation": "Я не хотел тебя разбудить.",
          "source": "Tatoeba #3313837 @freddy1 / #4073472 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3313837",
          "cefr_level": "A1",
          "word_slugs": [
            "aufwecken-verb"
          ]
        },
        {
          "id": "13879335",
          "text": "Sie wollte Mama nicht aufwecken.",
          "translation": "Она не хотела будить маму.",
          "source": "Tatoeba #13879335 @Naina / #13879487 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13879335",
          "cefr_level": "A1",
          "word_slugs": [
            "aufwecken-verb"
          ]
        },
        {
          "id": "13919708",
          "text": "Ich möchte Tom selbst aufwecken.",
          "translation": "Я хотел бы сам разбудить Тома.",
          "source": "Tatoeba #13919708 @IAlexI / #4881514 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13919708",
          "cefr_level": "A1",
          "word_slugs": [
            "aufwecken-verb"
          ]
        }
      ],
