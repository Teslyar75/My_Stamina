      "gender": null,
      "examples": [
        {
          "id": "927975",
          "text": "Der Weg teilt sich hier.",
          "translation": "Здесь дорога разделяется.",
          "source": "Tatoeba #927975 @Sudajaengi / #3293999 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/927975",
          "cefr_level": "A1",
