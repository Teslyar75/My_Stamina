          ]
        },
        {
          "id": "1994261",
          "text": "Nicht den Rasen betreten.",
          "translation": "По газону не ходить.",
          "source": "Tatoeba #1994261 @Reini / #1452236 @chispa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1994261",
          "cefr_level": "A1",
          "word_slugs": [
            "rasen-noun"
          ]
        },
        {
          "id": "7636249",
          "text": "Tom lag auf dem Rasen.",
          "translation": "Том лежал на траве.",
          "source": "Tatoeba #7636249 @wolfgangth / #11066510 @Almi92 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7636249",
          "cefr_level": "A1",
