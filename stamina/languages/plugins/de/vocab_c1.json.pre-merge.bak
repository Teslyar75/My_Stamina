        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "407631",
          "text": "Zwei Stühle waren frei.",
          "translation": "Два стула были незаняты.",
          "source": "Tatoeba #407631 @xtofu80 / #407634 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/407631",
          "cefr_level": "A1",
          "word_slugs": [
            "stühle-noun"
          ]
        },
        {
          "id": "5329877",
          "text": "Gibt es genügend Stühle?",
          "translation": "Стульев достаточно?",
          "source": "Tatoeba #5329877 @Adelpa / #5329885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5329877",
          "cefr_level": "A1",
          "word_slugs": [
            "stühle-noun"
          ]
        },
        {
          "id": "5936303",
          "text": "Wie viele Stühle fehlen?",
          "translation": "Сколько стульев не хватает?",
          "source": "Tatoeba #5936303 @Pfirsichbaeumchen / #5459434 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5936303",
          "cefr_level": "A1",
          "word_slugs": [
            "stühle-noun"
          ]
        },
        {
          "id": "4781708",
          "text": "Haben wir genügend Stühle?",
          "translation": "У нас хватает стульев?",
          "source": "Tatoeba #4781708 @bonny37 / #5431911 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4781708",
          "cefr_level": "A1",
          "word_slugs": [
            "stühle-noun"
          ]
        },
        {
          "id": "1104274",
          "text": "Diese Stühle sind unbequem.",
          "translation": "Эти стулья неудобные.",
          "source": "Tatoeba #1104274 @Haehnchenpaella / #3765116 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1104274",
          "cefr_level": "A1",
