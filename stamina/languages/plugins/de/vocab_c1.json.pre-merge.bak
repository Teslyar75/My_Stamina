    {
      "slug": "sichtbar-adj",
      "lemma": "sichtbar",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9085,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "видимый",
          "зримый"
        ],
        "en": [
          "visible"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13848570",
          "text": "Die Fahrbahnmarkierung ist kaum sichtbar.",
          "translation": "Дорожная разметка едва различима.",
          "source": "Tatoeba #13848570 @mhr / #13848553 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13848570",
          "cefr_level": "A1",
          "word_slugs": [
            "sichtbar-adj"
          ]
        },
        {
          "id": "9235533",
          "text": "Der Mond ist nicht immer sichtbar.",
          "translation": "Луну не всегда видно.",
          "source": "Tatoeba #9235533 @felix63 / #10581380 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9235533",
          "cefr_level": "A1",
          "word_slugs": [
            "sichtbar-adj"
          ]
        },
        {
          "id": "2724521",
          "text": "Nach und nach werden Erfolge sichtbar.",
          "translation": "Постепенно успехи становятся заметными.",
          "source": "Tatoeba #2724521 @al_ex_an_der / #5584840 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2724521",
          "cefr_level": "A1",
          "word_slugs": [
            "sichtbar-adj"
          ]
        },
        {
          "id": "3538069",
          "text": "Heute ist der Fuji sehr gut sichtbar.",
          "translation": "Сегодня очень хорошо видно гору Фудзи.",
          "source": "Tatoeba #3538069 @Pfirsichbaeumchen / #3538019 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3538069",
          "cefr_level": "A1",
          "word_slugs": [
            "sichtbar-adj"
          ]
        },
        {
          "id": "13464374",
          "text": "Schwarze Löcher sind mit bloßem Auge nicht sichtbar.",
          "translation": "Чёрные дыры не видны невооружённым глазом.",
          "source": "Tatoeba #13464374 @mhr / #8400489 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13464374",
          "cefr_level": "A1",
          "word_slugs": [
            "sichtbar-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der sichtbar",
        "nominative_pl": ""
      }
