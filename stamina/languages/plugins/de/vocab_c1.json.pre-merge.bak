          "cefr_level": "A1",
          "word_slugs": [
            "französischen-noun"
          ]
        },
        {
          "id": "2451807",
          "text": "Ich bin nicht gut im Französischen.",
          "translation": "Я не очень хорошо знаю французский.",
          "source": "Tatoeba #2451807 @Pfirsichbaeumchen / #2529088 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2451807",
          "cefr_level": "A1",
          "word_slugs": [
            "französischen-noun"
          ]
        },
        {
          "id": "12558347",
          "text": "Hauptsächlich übersetze ich aus dem Französischen.",
          "translation": "Я в основном перевожу с французского.",
          "source": "Tatoeba #12558347 @mhr / #12558242 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12558347",
          "cefr_level": "A1",
          "word_slugs": [
            "französischen-noun"
          ]
        }
