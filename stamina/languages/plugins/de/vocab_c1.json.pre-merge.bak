    {
      "slug": "schimmer-noun",
      "lemma": "Schimmer",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8281,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gleam, glimmer, flicker",
          "clue"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13968897",
          "text": "Ich schwöre, davon hatte ich keinen blassen Schimmer!",
          "translation": "Я знать не знал об этом, честное слово!",
          "source": "Tatoeba #13968897 @mhr / #13968497 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13968897",
          "cefr_level": "A1",
          "word_slugs": [
            "schimmer-noun"
          ]
        },
        {
          "id": "13968787",
          "text": "Davon hatte ich ehrlich gesagt keinen blassen Schimmer!",
          "translation": "Я, честно говоря, и знать не знал об этом!",
          "source": "Tatoeba #13968787 @mhr / #13968885 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13968787",
          "cefr_level": "A1",
          "word_slugs": [
            "schimmer-noun"
          ]
        },
        {
          "id": "2480666",
          "text": "Sie hat keinen blassen Schimmer, mit wem sie zusammen ist.",
          "translation": "Она и понятия не имеет, с кем она.",
          "source": "Tatoeba #2480666 @al_ex_an_der / #2478710 @Art4704 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2480666",
          "cefr_level": "A1",
          "word_slugs": [
            "schimmer-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
