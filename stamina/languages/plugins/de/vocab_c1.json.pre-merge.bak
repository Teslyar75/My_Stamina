          ]
        },
        {
          "id": "9309941",
          "text": "Es hatte niemand eine Taschenlampe.",
          "translation": "Ни у кого не было фонарика.",
          "source": "Tatoeba #9309941 @Pfirsichbaeumchen / #4627387 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9309941",
          "cefr_level": "A1",
          "word_slugs": [
            "taschenlampe-noun"
          ]
        },
        {
          "id": "3553316",
          "text": "Du wirst eine Taschenlampe brauchen.",
