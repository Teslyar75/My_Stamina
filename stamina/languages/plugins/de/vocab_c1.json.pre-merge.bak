    {
      "slug": "chinesischen-noun",
      "lemma": "Chinesischen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7567,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Chinesisch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10600985",
          "text": "Im Unterschied zum Chinesischen ist das Indonesische keine Tonsprache.",
          "translation": "В отличие от китайского, индонезийский - это не тональный язык.",
          "source": "Tatoeba #10600985 @Pfirsichbaeumchen / #10001824 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10600985",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesischen-noun"
          ]
        },
        {
          "id": "2883376",
          "text": "Es ist nicht immer leicht, das Japanische vom Chinesischen zu unterscheiden.",
          "translation": "Не всегда легко отличить японский от китайского.",
          "source": "Tatoeba #2883376 @Manfredo / #5309980 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2883376",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesischen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "chinesischen-adj",
      "lemma": "chinesischen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7567,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of chinesisch:",
          "strong genitive masculine/neuter singular",
          "inflection of chinesisch:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "533382",
          "text": "Die chinesischen Schriftzeichen sind sehr schön.",
          "translation": "Китайское письмо очень красивое.",
          "source": "Tatoeba #533382 @samueldora / #598858 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/533382",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesischen-adj"
          ]
        },
        {
          "id": "2217620",
          "text": "Die Stabilität der chinesischen Wirtschaft wird stark überschätzt.",
          "translation": "Устойчивость экономики Китая сильно переоценена.",
          "source": "Tatoeba #2217620 @al_ex_an_der / #2217619 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2217620",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesischen-adj"
          ]
        },
        {
          "id": "1585272",
          "text": "Wir waren noch nie bei einer chinesischen Hochzeit gewesen.",
          "translation": "Мы никогда не были на китайской свадьбе.",
          "source": "Tatoeba #1585272 @Zaghawa / #4685556 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1585272",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesischen-adj"
          ]
        },
        {
          "id": "2708038",
          "text": "Dieses Ingrediens wird in der traditionellen chinesischen Medizin verwendet.",
          "translation": "Этот ингредиент используется в традиционной китайской медицине.",
          "source": "Tatoeba #2708038 @Pfirsichbaeumchen / #13980329 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2708038",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesischen-adj"
          ]
        },
        {
          "id": "796695",
          "text": "Zwischen der chinesischen und der italienischen Grammatik besteht ein großer Unterschied.",
          "translation": "Между китайской и итальянской грамматикой есть большая разница.",
          "source": "Tatoeba #796695 @Manfredo / #2117634 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/796695",
          "cefr_level": "A1",
          "word_slugs": [
            "chinesischen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
