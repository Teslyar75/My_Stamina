        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5150646",
          "text": "Sie regt sich über Kleinigkeiten auf.",
          "translation": "Она заводится по мелочам.",
          "source": "Tatoeba #5150646 @raggione / #6029730 @kukla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5150646",
          "cefr_level": "A1",
