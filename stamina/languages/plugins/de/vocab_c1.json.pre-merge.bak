      "gender": null,
      "examples": [
        {
          "id": "8634535",
          "text": "Erholt euch gut!",
          "translation": "Хорошего вам отдыха!",
          "source": "Tatoeba #8634535 @Melang / #8640665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634535",
