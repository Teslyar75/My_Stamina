      },
      "gender": "m",
      "examples": [
        {
          "id": "709675",
          "text": "Mutti hat den Tisch gedeckt.",
          "translation": "Мама накрыла на стол.",
          "source": "Tatoeba #709675 @Manfredo / #5590188 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/709675",
