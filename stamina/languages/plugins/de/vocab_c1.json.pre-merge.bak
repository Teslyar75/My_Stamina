            "versprichst-verb"
          ]
        },
        {
          "id": "8449156",
          "text": "Versprichst du es mir?",
          "translation": "Ты мне это обещаешь?",
          "source": "Tatoeba #8449156 @driini / #8449157 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8449156",
