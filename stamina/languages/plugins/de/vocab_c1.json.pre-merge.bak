    {
      "slug": "römer-noun",
      "lemma": "Römer",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6223,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "римлянин"
        ],
        "en": [
          "rummer (kind of drinking glass, commonly used for wine in Germany; often made partially from coloured glass)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8399961",
          "text": "Die Römer trugen Togas.",
          "translation": "Римляне ходили в тогах.",
          "source": "Tatoeba #8399961 @Pfirsichbaeumchen / #11931759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8399961",
          "cefr_level": "A1",
          "word_slugs": [
            "römer-noun"
          ]
        },
        {
          "id": "4867073",
          "text": "Die Römer sprachen Latein.",
          "translation": "Римляне говорили на латинском.",
          "source": "Tatoeba #4867073 @Pfirsichbaeumchen / #4856504 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4867073",
          "cefr_level": "A1",
          "word_slugs": [
            "römer-noun"
          ]
        },
        {
          "id": "5045795",
          "text": "Die Römer zerstörten Karthago.",
          "translation": "Римляне разрушили Карфаген.",
          "source": "Tatoeba #5045795 @al_ex_an_der / #5045847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5045795",
          "cefr_level": "A1",
          "word_slugs": [
            "römer-noun"
          ]
        },
        {
          "id": "8433178",
          "text": "Die Römer begannen die Schlacht.",
          "translation": "Римляне начали битву.",
          "source": "Tatoeba #8433178 @faehrmann / #8433150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8433178",
          "cefr_level": "A1",
          "word_slugs": [
