    {
      "slug": "kern-noun",
      "lemma": "Kern",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5915,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "ядро"
        ],
        "en": [
          "kernel",
          "grain",
          "core, nucleus",
          "nucleus"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12421557",
          "text": "Kirschen haben einen Kern.",
          "translation": "У вишни есть косточки.",
          "source": "Tatoeba #12421557 @Waldelfe / #12383243 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12421557",
          "cefr_level": "A1",
          "word_slugs": [
            "kern-noun"
          ]
        },
        {
          "id": "12421556",
          "text": "In Kirschen ist ein Kern.",
          "translation": "В вишнях есть косточки.",
          "source": "Tatoeba #12421556 @Waldelfe / #12383244 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12421556",
          "cefr_level": "A1",
          "word_slugs": [
            "kern-noun"
          ]
        },
        {
          "id": "2836663",
          "text": "Kommen wir zum Kern der Sache.",
          "translation": "Перейдём к сути дела.",
          "source": "Tatoeba #2836663 @sigavax / #2836676 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2836663",
          "cefr_level": "A1",
          "word_slugs": [
            "kern-noun"
          ]
        },
        {
          "id": "911858",
          "text": "Dies ist der Kern des Problems.",
          "translation": "Это суть проблемы.",
          "source": "Tatoeba #911858 @Sudajaengi / #553053 @stariy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/911858",
          "cefr_level": "A1",
          "word_slugs": [
            "kern-noun"
          ]
        },
        {
          "id": "2678246",
          "text": "Habe ich den Kern der Frage richtig erfasst?",
          "translation": "Правильно ли я понял суть вопроса?",
          "source": "Tatoeba #2678246 @al_ex_an_der / #2678244 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2678246",
          "cefr_level": "A1",
          "word_slugs": [
            "kern-noun"
          ]
        }
