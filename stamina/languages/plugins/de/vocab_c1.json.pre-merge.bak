          ]
        },
        {
          "id": "13993294",
          "text": "Ich leide selbst unter meinem Charakter.",
          "translation": "Я сам страдаю от своего характера.",
          "source": "Tatoeba #13993294 @Rovo / #13992324 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13993294",
