    {
      "slug": "nickerchen-noun",
      "lemma": "Nickerchen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7241,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "дремота"
        ],
        "en": [
          "nap, catnap, snooze"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "4230612",
          "text": "Ich möchte ein Nickerchen machen.",
          "translation": "Я хотел бы вздремнуть.",
          "source": "Tatoeba #4230612 @Esperantostern / #7586313 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4230612",
          "cefr_level": "A1",
          "word_slugs": [
            "nickerchen-noun"
          ]
        },
        {
          "id": "3596913",
          "text": "Ich könnte jetzt ein Nickerchen vertragen.",
          "translation": "Я б вздремнул сейчас.",
          "source": "Tatoeba #3596913 @al_ex_an_der / #3597339 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3596913",
          "cefr_level": "A1",
          "word_slugs": [
            "nickerchen-noun"
          ]
        },
        {
          "id": "1766532",
          "text": "Meine Mutter macht jeden Nachmittag ein Nickerchen.",
          "translation": "Моя мать дремлет после обеда каждый день.",
          "source": "Tatoeba #1766532 @Esperantostern / #2974084 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1766532",
          "cefr_level": "A1",
          "word_slugs": [
            "nickerchen-noun"
          ]
        },
        {
          "id": "102",
          "text": "Es kann sein, dass ich bald aufgebe und stattdessen ein Nickerchen mache.",
          "translation": "Я, может, скоро сдамся и вместо этого пойду вздремну.",
          "source": "Tatoeba #102 @ludoviko / #5434 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/102",
          "cefr_level": "A1",
          "word_slugs": [
            "nickerchen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
