    {
      "slug": "urteilen-verb",
      "lemma": "urteilen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5959,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to judge"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7273039",
          "text": "Es wird niemand über dich urteilen.",
          "translation": "Никто тебя не осудит.",
          "source": "Tatoeba #7273039 @Pfirsichbaeumchen / #7234090 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7273039",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-verb"
          ]
        },
        {
          "id": "13973719",
          "text": "Von außen kann man leicht urteilen.",
          "translation": "Со стороны легко судить.",
          "source": "Tatoeba #13973719 @mhr / #13973682 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13973719",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-verb"
          ]
        },
        {
          "id": "2498551",
          "text": "Lerne, nicht nach Äußerlichkeiten zu urteilen.",
          "translation": "Учись не судить по наружности.",
          "source": "Tatoeba #2498551 @al_ex_an_der / #2498547 @zalaim (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2498551",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-verb"
          ]
        },
        {
          "id": "6952984",
          "text": "Dem Akzent nach zu urteilen, sind das Russen.",
          "translation": "Судя по акценту, они русские.",
          "source": "Tatoeba #6952984 @Pfirsichbaeumchen / #13661547 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952984",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-verb"
          ]
        },
        {
          "id": "2134486",
          "text": "Dem nach zu urteilen, was sie sagt, ist er schuldig.",
          "translation": "Судя по тому, что она говорит, он виновен.",
          "source": "Tatoeba #2134486 @sismic / #2134482 @sismic (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2134486",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "urteilen-noun",
      "lemma": "Urteilen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5959,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Urteil"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12822760",
          "text": "Urteilen wir nicht!",
          "translation": "Не будем судить.",
          "source": "Tatoeba #12822760 @Waldelfe / #12822685 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12822760",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-noun"
          ]
        },
        {
          "id": "1390717",
          "text": "Urteilen Sie selbst!",
          "translation": "Судите сами.",
          "source": "Tatoeba #1390717 @enteka / #13112696 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1390717",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-noun"
          ]
        },
        {
          "id": "2942534",
          "text": "Urteilen Sie nicht vorschnell!",
          "translation": "Не судите поспешно!",
          "source": "Tatoeba #2942534 @al_ex_an_der / #2942531 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2942534",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-noun"
          ]
        },
        {
          "id": "1910749",
          "text": "Urteilen Sie nicht zu kategorisch!",
          "translation": "Не судите слишком категорично!",
          "source": "Tatoeba #1910749 @al_ex_an_der / #1910744 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1910749",
          "cefr_level": "A1",
          "word_slugs": [
            "urteilen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
