      "gender": "f",
      "examples": [
        {
          "id": "2291443",
          "text": "Die Zeremonie war eindrucksvoll.",
          "translation": "Церемония была впечатляющей.",
          "source": "Tatoeba #2291443 @Pfirsichbaeumchen / #7095012 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2291443",
          "cefr_level": "A1",
          "word_slugs": [
            "zeremonie-noun"
          ]
        },
        {
          "id": "13647416",
          "text": "Wo fand die Zeremonie statt?",
          "translation": "Где была церемония?",
          "source": "Tatoeba #13647416 @felix63 / #13656443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13647416",
          "cefr_level": "A1",
          "word_slugs": [
            "zeremonie-noun"
          ]
        },
        {
          "id": "632961",
          "text": "Die Zeremonie wird morgen stattfinden.",
          "translation": "Церемония состоится завтра.",
          "source": "Tatoeba #632961 @Manfredo / #388151 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/632961",
          "cefr_level": "A1",
          "word_slugs": [
            "zeremonie-noun"
          ]
        },
        {
          "id": "1223704",
          "text": "Wirst du an der Zeremonie teilnehmen?",
          "translation": "Ты примешь участие в церемонии?",
          "source": "Tatoeba #1223704 @BraveSentry / #5587647 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1223704",
          "cefr_level": "A1",
          "word_slugs": [
            "zeremonie-noun"
          ]
        },
        {
          "id": "2405955",
          "text": "Sie haben die ganze Zeremonie gefilmt.",
          "translation": "Они засняли всю церемонию.",
          "source": "Tatoeba #2405955 @Pfirsichbaeumchen / #2649757 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2405955",
          "cefr_level": "A1",
          "word_slugs": [
            "zeremonie-noun"
          ]
        }
      ],
