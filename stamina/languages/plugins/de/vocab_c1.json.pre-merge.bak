    {
      "slug": "sahne-noun",
      "lemma": "Sahne",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8568,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "cream (milkfat)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6387391",
          "text": "Für mich Kaffee mit Sahne.",
          "translation": "Мне кофе со сливками.",
          "source": "Tatoeba #6387391 @Pfirsichbaeumchen / #5918262 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6387391",
          "cefr_level": "A1",
          "word_slugs": [
            "sahne-noun"
          ]
        },
        {
          "id": "2991389",
          "text": "Ich benötige zweihundertfünfzig Milliliter Sahne.",
          "translation": "Мне нужно двести пятьдесят миллилитров сливок.",
          "source": "Tatoeba #2991389 @al_ex_an_der / #2991390 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2991389",
          "cefr_level": "A1",
          "word_slugs": [
            "sahne-noun"
          ]
        },
        {
          "id": "8577425",
          "text": "Er isst Erdbeeren immer mit Sahne.",
          "translation": "Он всегда ест клубнику со сливками.",
          "source": "Tatoeba #8577425 @wolfgangth / #11790482 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8577425",
          "cefr_level": "A1",
          "word_slugs": [
            "sahne-noun"
          ]
        },
        {
          "id": "8760623",
          "text": "Trinkst du deinen Kaffee mit Sahne?",
          "translation": "Ты кофе со сливками пьёшь?",
          "source": "Tatoeba #8760623 @Pfirsichbaeumchen / #9187503 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8760623",
          "cefr_level": "A1",
          "word_slugs": [
            "sahne-noun"
          ]
        },
        {
          "id": "8545929",
          "text": "Ich mag Erdbeeren sehr gerne mit Sahne.",
          "translation": "Я очень люблю клубнику со сливками.",
          "source": "Tatoeba #8545929 @felix63 / #8555747 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8545929",
          "cefr_level": "A1",
          "word_slugs": [
            "sahne-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
