          ]
        },
        {
          "id": "2485074",
          "text": "Ich hasse Insekten.",
          "translation": "Ненавижу насекомых.",
          "source": "Tatoeba #2485074 @Pfirsichbaeumchen / #4530518 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2485074",
          "cefr_level": "A1",
          "word_slugs": [
            "insekten-noun"
          ]
        },
        {
          "id": "3296301",
          "text": "Mögen Sie Insekten?",
          "translation": "Вам нравятся насекомые?",
          "source": "Tatoeba #3296301 @al_ex_an_der / #3235303 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3296301",
