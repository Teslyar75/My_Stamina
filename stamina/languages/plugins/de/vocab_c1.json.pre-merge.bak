          "cefr_level": "A1",
          "word_slugs": [
            "werfe-verb"
          ]
        },
        {
          "id": "10687558",
          "text": "Ich werfe den Ball und mein Hund holt ihn wieder.",
          "translation": "Я бросаю мячик, а моя собака его приносит.",
          "source": "Tatoeba #10687558 @felix63 / #13757513 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10687558",
          "cefr_level": "A1",
