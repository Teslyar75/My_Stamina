    {
      "slug": "ausserirdischen-noun",
      "lemma": "Außerirdischen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7167,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Außerirdische",
          "plural of Außerirdische"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4606824",
          "text": "Tom wurde von Außerirdischen entführt.",
          "translation": "Тома похитили инопланетяне.",
          "source": "Tatoeba #4606824 @Pfirsichbaeumchen / #4600058 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4606824",
          "cefr_level": "A1",
          "word_slugs": [
            "ausserirdischen-noun"
          ]
        },
        {
          "id": "1587489",
          "text": "Marie fühlt, dass die Außerirdischen sie beobachten.",
          "translation": "Мэри чувствует, что инопланетяне наблюдают за ней.",
          "source": "Tatoeba #1587489 @Manfredo / #1566949 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1587489",
          "cefr_level": "A1",
          "word_slugs": [
            "ausserirdischen-noun"
          ]
        },
        {
          "id": "10553059",
          "text": "Was tätest du, wenn du einem Außerirdischen begegnetest?",
          "translation": "Что бы ты сделал, если встретил инопланетянина?",
          "source": "Tatoeba #10553059 @Pfirsichbaeumchen / #7063466 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10553059",
          "cefr_level": "A1",
          "word_slugs": [
            "ausserirdischen-noun"
          ]
        },
        {
          "id": "1000679",
          "text": "Ich schwöre dir, dass ich einen Außerirdischen gesehen habe!",
          "translation": "Клянусь, я видел инопланетянина.",
          "source": "Tatoeba #1000679 @Pfirsichbaeumchen / #1995904 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1000679",
          "cefr_level": "A1",
          "word_slugs": [
            "ausserirdischen-noun"
          ]
        },
        {
          "id": "10553239",
          "text": "Was tätest du, wenn du einem Außerirdischen begegnen würdest?",
          "translation": "Что бы ты сделал, если встретил инопланетянина?",
          "source": "Tatoeba #10553239 @Pfirsichbaeumchen / #7063466 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10553239",
          "cefr_level": "A1",
          "word_slugs": [
            "ausserirdischen-noun"
          ]
        }
      ],
