    {
      "slug": "ignoriert-verb",
      "lemma": "ignoriert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5777,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of ignorieren:",
          "third-person singular present",
          "inflection of ignorieren:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6816014",
          "text": "Er ignoriert mich.",
          "translation": "Он меня игнорирует.",
          "source": "Tatoeba #6816014 @Pfirsichbaeumchen / #6175501 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6816014",
          "cefr_level": "A1",
          "word_slugs": [
            "ignoriert-verb"
          ]
        },
        {
          "id": "12905691",
          "text": "Ich habe Tom ignoriert.",
          "translation": "Я проигнорировал Тома.",
          "source": "Tatoeba #12905691 @papago / #5883872 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12905691",
          "cefr_level": "A1",
          "word_slugs": [
            "ignoriert-verb"
          ]
        },
        {
          "id": "7413753",
          "text": "Sie haben mich ignoriert.",
          "translation": "Они меня проигнорировали.",
          "source": "Tatoeba #7413753 @Yorwba / #11210749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7413753",
