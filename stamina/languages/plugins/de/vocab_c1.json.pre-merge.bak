    {
      "slug": "feiert-verb",
      "lemma": "feiert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7861,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of feiern:",
          "third-person singular present",
          "inflection of feiern:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12536807",
          "text": "Was feiert ihr?",
          "translation": "Что вы празднуете?",
          "source": "Tatoeba #12536807 @Waldelfe / #4137049 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12536807",
          "cefr_level": "A1",
          "word_slugs": [
            "feiert-verb"
          ]
        },
        {
          "id": "2195834",
          "text": "Er feiert gerne.",
          "translation": "Он любит тусить.",
          "source": "Tatoeba #2195834 @Pfirsichbaeumchen / #3337745 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2195834",
          "cefr_level": "A1",
          "word_slugs": [
            "feiert-verb"
          ]
        },
        {
          "id": "5685584",
          "text": "Feiert ihr Weihnachten?",
          "translation": "Вы празднуете Рождество?",
          "source": "Tatoeba #5685584 @eric2 / #5680349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5685584",
          "cefr_level": "A1",
          "word_slugs": [
            "feiert-verb"
          ]
        },
        {
          "id": "5887788",
          "text": "Wie feiert ihr Geburtstage?",
          "translation": "Как вы празднуете дни рождения?",
          "source": "Tatoeba #5887788 @Pfirsichbaeumchen / #5397681 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5887788",
          "cefr_level": "A1",
          "word_slugs": [
            "feiert-verb"
          ]
        },
        {
          "id": "8098072",
          "text": "Er feiert seinen Namenstag.",
