    {
      "slug": "spritze-noun",
      "lemma": "Spritze",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5484,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "шприц"
        ],
        "en": [
          "syringe",
          "injection"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12275473",
          "text": "In der Spritze war Blut.",
          "translation": "В шприце была кровь.",
          "source": "Tatoeba #12275473 @Yorwba / #12475347 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12275473",
          "cefr_level": "A1",
          "word_slugs": [
            "spritze-noun"
          ]
        },
        {
          "id": "5732740",
          "text": "Die Krankenschwester gab dem Kranken eine Spritze.",
          "translation": "Медсестра сделала пациенту укол.",
          "source": "Tatoeba #5732740 @dispy / #7092495 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5732740",
          "cefr_level": "A1",
          "word_slugs": [
            "spritze-noun"
          ]
        },
        {
          "id": "2869437",
          "text": "Vor der Operation gab man ihm eine Spritze.",
          "translation": "Перед операцией ему сделали укол.",
          "source": "Tatoeba #2869437 @Dani6187 / #497167 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2869437",
          "cefr_level": "A1",
          "word_slugs": [
            "spritze-noun"
          ]
        },
        {
          "id": "8670805",
          "text": "Ich schlucke Arzneien lieber, als eine Spritze zu bekommen.",
          "translation": "Я предпочту принять лекарство, чем получить укол.",
          "source": "Tatoeba #8670805 @driini / #1395432 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8670805",
          "cefr_level": "A1",
          "word_slugs": [
            "spritze-noun"
          ]
        },
        {
          "id": "1833450",
          "text": "Ich zittere vor Angst, wenn ich nur an eine Spritze denke.",
          "translation": "Меня трясёт от страха при мысли об уколе.",
          "source": "Tatoeba #1833450 @Wauzl / #1464539 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1833450",
          "cefr_level": "A1",
          "word_slugs": [
            "spritze-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
