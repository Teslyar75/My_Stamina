    {
      "slug": "bedürfnis-noun",
      "lemma": "Bedürfnis",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7946,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "потребность"
        ],
        "en": [
          "desire, urge",
          "need, necessity"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "10060091",
          "text": "Ich hatte das Bedürfnis, etwas zu tun.",
          "translation": "Я чувствовал необходимость что-то сделать.",
          "source": "Tatoeba #10060091 @Pfirsichbaeumchen / #10059200 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10060091",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnis-noun"
          ]
        },
        {
          "id": "13877414",
          "text": "Ein sattes Tier verspürt kein Bedürfnis nach Nahrung.",
          "translation": "Сытое животное не испытывает потребности в пище.",
          "source": "Tatoeba #13877414 @mhr / #13877353 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13877414",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnis-noun"
          ]
        },
        {
          "id": "2987729",
          "text": "Seit einigen Tagen verspüre ich das Bedürfnis, dir zu schreiben.",
          "translation": "Вот уже несколько дней я чувствую потребность написать тебе.",
          "source": "Tatoeba #2987729 @al_ex_an_der / #2987733 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2987729",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnis-noun"
          ]
        },
        {
          "id": "11984967",
          "text": "Er wollte niemanden sehen, hatte aber das Bedürfnis, mit jemandem zu sprechen.",
          "translation": "Ему не хотелось никого видеть, но нужно было с кем-то поговорить.",
          "source": "Tatoeba #11984967 @Pfirsichbaeumchen / #11984775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11984967",
          "cefr_level": "A1",
          "word_slugs": [
            "bedürfnis-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Bedürfnis",
        "nominative_pl": ""
      }
    },
    {
      "slug": "nähen-verb",
      "lemma": "nähen",
      "pos": "verb",
      "language": "de",
