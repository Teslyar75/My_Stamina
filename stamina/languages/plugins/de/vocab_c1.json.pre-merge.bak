    {
      "slug": "sonnenuntergang-noun",
      "lemma": "Sonnenuntergang",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5602,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "sunset (time of day)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12408160",
          "text": "Es ist bald Sonnenuntergang.",
          "translation": "Скоро закат.",
          "source": "Tatoeba #12408160 @Waldelfe / #5151600 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12408160",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenuntergang-noun"
          ]
        },
        {
          "id": "12316296",
          "text": "Der Sonnenuntergang setzt ein.",
          "translation": "Солнце начинает садиться.",
