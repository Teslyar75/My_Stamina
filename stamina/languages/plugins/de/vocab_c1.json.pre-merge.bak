      "gender": null,
      "examples": [
        {
          "id": "14076859",
          "text": "Ich habe es gern, wenn alles gut ausgeht.",
          "translation": "Я люблю, когда всё хорошо заканчивается.",
          "source": "Tatoeba #14076859 @mhr / #14076854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14076859",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgeht-verb"
          ]
        },
        {
          "id": "912508",
          "text": "Sie wollte nicht, dass er mit anderen Frauen ausgeht.",
          "translation": "Она не хотела, чтобы он встречался с другими женщинами.",
          "source": "Tatoeba #912508 @Esperantostern / #3655009 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/912508",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgeht-verb"
          ]
        },
        {
          "id": "7482317",
          "text": "Tom will nicht, dass Maria mit anderen Männern ausgeht.",
          "translation": "Том не хочет, чтобы Мэри встречалась с другими мужчинами.",
          "source": "Tatoeba #7482317 @Pfirsichbaeumchen / #7483015 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7482317",
          "cefr_level": "A1",
