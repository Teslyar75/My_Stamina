    {
      "slug": "feder-noun",
      "lemma": "Feder",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8052,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "feather",
          "spring (of a machine or gadget)",
          "quill pen",
          "nib (of a fountain pen)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "1903792",
          "text": "Ich schreibe mit einer Feder.",
          "translation": "Я пишу пером.",
          "source": "Tatoeba #1903792 @Pfirsichbaeumchen / #5672227 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1903792",
          "cefr_level": "A1",
          "word_slugs": [
            "feder-noun"
          ]
        },
        {
          "id": "1863446",
          "text": "Du hast eine Feder im Haar.",
          "translation": "У тебя перо в волосах.",
          "source": "Tatoeba #1863446 @Pfirsichbaeumchen / #2974464 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1863446",
          "cefr_level": "A1",
          "word_slugs": [
            "feder-noun"
          ]
        },
        {
          "id": "672278",
          "text": "Die Feder ist mächtiger als das Schwert.",
          "translation": "Перо сильнее меча.",
          "source": "Tatoeba #672278 @samueldora / #2459315 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/672278",
          "cefr_level": "A1",
          "word_slugs": [
            "feder-noun"
          ]
        },
        {
          "id": "3037687",
          "text": "Seiner Feder entstammt eine Vielzahl von Romanen.",
          "translation": "Из-под его пера вышло множество романов.",
          "source": "Tatoeba #3037687 @al_ex_an_der / #1383494 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3037687",
          "cefr_level": "A1",
          "word_slugs": [
            "feder-noun"
          ]
        },
        {
          "id": "784130",
          "text": "Ich fühlte mich so leicht wie eine Feder.",
          "translation": "Я ощущал себя лёгким как перышко.",
          "source": "Tatoeba #784130 @Pfirsichbaeumchen / #13590021 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/784130",
          "cefr_level": "A1",
          "word_slugs": [
            "feder-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Feder",
        "nominative_pl": ""
      }
