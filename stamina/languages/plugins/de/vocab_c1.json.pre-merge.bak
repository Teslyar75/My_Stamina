      },
      "gender": "n",
      "examples": [
        {
          "id": "8089249",
          "text": "Die Torte ist frisch.",
          "translation": "Торт свежий.",
          "source": "Tatoeba #8089249 @Luiaard / #8100377 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8089249",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-noun"
          ]
        },
        {
          "id": "9271016",
          "text": "Ich möchte Torte essen.",
          "translation": "Я хочу поесть торта.",
          "source": "Tatoeba #9271016 @Pfirsichbaeumchen / #6450786 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9271016",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-noun"
          ]
        },
        {
          "id": "7633367",
          "text": "Die Torte ist zu süß.",
          "translation": "Торт слишком сладкий.",
          "source": "Tatoeba #7633367 @Pfirsichbaeumchen / #7633088 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7633367",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-noun"
          ]
        },
        {
          "id": "5789525",
          "text": "Willst du noch etwas Torte?",
          "translation": "Хочешь ещё немного торта?",
          "source": "Tatoeba #5789525 @dasbeispielholz / #6671847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5789525",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-noun"
          ]
        },
        {
          "id": "5050038",
          "text": "Wer will noch ein Stück Torte?",
          "translation": "Кто хочет ещё кусок торта?",
          "source": "Tatoeba #5050038 @Manfredo / #5050051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5050038",
          "cefr_level": "A1",
          "word_slugs": [
            "torte-noun"
          ]
        }
