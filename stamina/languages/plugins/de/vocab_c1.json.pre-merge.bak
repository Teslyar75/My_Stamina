    {
      "slug": "räuber-noun",
      "lemma": "Räuber",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5596,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "разбойник",
          "грабитель"
        ],
        "en": [
          "agent noun of rauben",
          "robber, thief",
          "agent noun of rauben",
          "pirate"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "682957",
          "text": "Mein Vater kämpfte mit dem Räuber.",
          "translation": "Мой отец боролся с грабителем.",
          "source": "Tatoeba #682957 @Manfredo / #9276521 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/682957",
          "cefr_level": "A1",
          "word_slugs": [
            "räuber-noun"
          ]
        },
        {
          "id": "13067412",
          "text": "Das war der schlimmste der Räuber.",
          "translation": "Это был самый ужасный из разбойников.",
          "source": "Tatoeba #13067412 @Pfirsichbaeumchen / #13067388 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13067412",
          "cefr_level": "A1",
          "word_slugs": [
            "räuber-noun"
          ]
        },
        {
          "id": "5227209",
          "text": "Die Jungen spielten Räuber und Gendarm.",
          "translation": "Мальчишки играли в казаки-разбойники.",
          "source": "Tatoeba #5227209 @Pfirsichbaeumchen / #4347886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5227209",
          "cefr_level": "A1",
          "word_slugs": [
            "räuber-noun"
          ]
        },
        {
          "id": "4007171",
          "text": "Tom jagte dem Räuber nach und ergriff ihn.",
          "translation": "Том погнался за грабителем и схватил его.",
          "source": "Tatoeba #4007171 @pullnosemans / #5895218 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4007171",
          "cefr_level": "A1",
          "word_slugs": [
            "räuber-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
