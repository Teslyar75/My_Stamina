    {
      "slug": "leuchtet-verb",
      "lemma": "leuchtet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8600,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of leuchten:",
          "third-person singular present",
          "inflection of leuchten:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1790434",
          "text": "Hell leuchtet die Sonne.",
          "translation": "Солнце светит ясно.",
          "source": "Tatoeba #1790434 @al_ex_an_der / #1788590 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1790434",
          "cefr_level": "A1",
          "word_slugs": [
            "leuchtet-verb"
          ]
        },
        {
          "id": "2020545",
          "text": "Nur mein Kleid leuchtet weiß auf der Stuhllehne.",
          "translation": "Только моё платье белеет на спинке стула.",
          "source": "Tatoeba #2020545 @al_ex_an_der / #2020638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2020545",
          "cefr_level": "A1",
          "word_slugs": [
            "leuchtet-verb"
          ]
        },
        {
          "id": "2475015",
          "text": "Bitte unterlassen Sie das Rauchen, solange diese Anzeige leuchtet.",
          "translation": "Пожалуйста, воздержитесь от курения, пока это объявление не погаснет.",
          "source": "Tatoeba #2475015 @al_ex_an_der / #2475001 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2475015",
          "cefr_level": "A1",
          "word_slugs": [
            "leuchtet-verb"
          ]
        },
        {
          "id": "2475011",
          "text": "Bitte verzichten Sie auf das Rauchen, solange diese Anzeige leuchtet.",
          "translation": "Пожалуйста, воздержитесь от курения, пока это объявление не погаснет.",
          "source": "Tatoeba #2475011 @al_ex_an_der / #2475001 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2475011",
          "cefr_level": "A1",
          "word_slugs": [
            "leuchtet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
