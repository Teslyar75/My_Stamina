      "gender": "f",
      "examples": [
        {
          "id": "12645727",
          "text": "Die Wirtschaft wächst schnell.",
          "translation": "Экономика быстро растёт.",
          "source": "Tatoeba #12645727 @mhr / #12645761 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12645727",
          "cefr_level": "A1",
          "word_slugs": [
            "wirtschaft-noun"
          ]
        },
        {
          "id": "12313889",
          "text": "Die chinesische Wirtschaft wächst schnell.",
          "translation": "Китайская экономика быстро растёт.",
          "source": "Tatoeba #12313889 @Augustus / #12720849 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12313889",
          "cefr_level": "A1",
          "word_slugs": [
            "wirtschaft-noun"
          ]
        },
        {
          "id": "3012075",
          "text": "Diese Regierung ruiniert unsere Wirtschaft.",
          "translation": "Это правительство разрушает нашу экономику.",
          "source": "Tatoeba #3012075 @al_ex_an_der / #6880680 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3012075",
          "cefr_level": "A1",
          "word_slugs": [
            "wirtschaft-noun"
          ]
        },
        {
          "id": "12383911",
          "text": "Das ist schlecht für die Wirtschaft.",
          "translation": "Это плохо для экономики.",
          "source": "Tatoeba #12383911 @Pfirsichbaeumchen / #8564422 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12383911",
          "cefr_level": "A1",
          "word_slugs": [
            "wirtschaft-noun"
          ]
        },
        {
          "id": "13773282",
          "text": "Der Krieg zehrt an unserer Wirtschaft.",
          "translation": "Война истощает нашу экономику.",
          "source": "Tatoeba #13773282 @Waldelfe / #5215251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13773282",
          "cefr_level": "A1",
          "word_slugs": [
            "wirtschaft-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
