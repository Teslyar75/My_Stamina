    {
      "slug": "gesunden-adj",
      "lemma": "gesunden",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9236,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gesund:",
          "strong genitive masculine/neuter singular",
          "inflection of gesund:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4139949",
          "text": "Kaufe gesunden Menschenverstand.",
          "translation": "Куплю здравый смысл.",
          "source": "Tatoeba #4139949 @AqQoyriq_1 / #4139175 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4139949",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunden-adj"
          ]
        },
        {
          "id": "878234",
          "text": "Ein gesunder Geist in einem gesunden Körper.",
          "translation": "В здоровом теле — здоровый дух.",
          "source": "Tatoeba #878234 @Esperantostern / #2735348 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/878234",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunden-adj"
          ]
        },
        {
          "id": "459787",
          "text": "Franklin war bekannt für seinen gesunden Menschenverstand.",
          "translation": "Франклин был известен своим здравым смыслом.",
          "source": "Tatoeba #459787 @al_ex_an_der / #414887 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/459787",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunden-adj"
          ]
        },
        {
          "id": "4720458",
          "text": "Dem Gesunden fehlt viel, dem Kranken nur eins.",
          "translation": "Здоровому человеку не хватает многого, больному - только одного.",
          "source": "Tatoeba #4720458 @Esperantostern / #10652541 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4720458",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunden-adj"
          ]
        },
        {
          "id": "4578585",
          "text": "Ein gesundes Herz führt zu einem gesunden Leben.",
          "translation": "Здоровое сердце - здоровая жизнь.",
          "source": "Tatoeba #4578585 @Esperantostern / #13276290 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4578585",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunden-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
