    {
      "slug": "geerbt-verb",
      "lemma": "geerbt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8613,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of erben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11372119",
          "text": "Tom hat viel Geld geerbt.",
          "translation": "Том получил в наследство много денег.",
          "source": "Tatoeba #11372119 @Bernie75 / #3807681 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11372119",
          "cefr_level": "A1",
          "word_slugs": [
            "geerbt-verb"
          ]
        },
        {
          "id": "10106708",
          "text": "Tom hat das von seiner Mama geerbt.",
          "translation": "Том унаследовал это от мамы.",
          "source": "Tatoeba #10106708 @Pfirsichbaeumchen / #10106323 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10106708",
          "cefr_level": "A1",
          "word_slugs": [
            "geerbt-verb"
          ]
        },
        {
          "id": "10106963",
          "text": "Tom hat das von seiner Mutter geerbt.",
          "translation": "Том унаследовал это от матери.",
          "source": "Tatoeba #10106963 @Pfirsichbaeumchen / #10106325 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10106963",
          "cefr_level": "A1",
          "word_slugs": [
            "geerbt-verb"
          ]
        },
        {
          "id": "8904718",
          "text": "Ich habe den Besitz meines Vaters geerbt.",
          "translation": "Я унаследовал имущество своего отца.",
          "source": "Tatoeba #8904718 @Pfirsichbaeumchen / #8905976 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8904718",
          "cefr_level": "A1",
          "word_slugs": [
            "geerbt-verb"
          ]
        },
        {
          "id": "13701845",
          "text": "Ich habe dieses Haus von meinem Großvater geerbt.",
          "translation": "Этот дом достался мне в наследство от дедушки.",
          "source": "Tatoeba #13701845 @carlosalberto / #12845577 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13701845",
          "cefr_level": "A1",
          "word_slugs": [
            "geerbt-verb"
          ]
        }
      ],
      "tags": [
