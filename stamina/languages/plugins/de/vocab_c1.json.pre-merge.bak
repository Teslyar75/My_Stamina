    {
      "slug": "beantwortet-verb",
      "lemma": "beantwortet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5127,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of beantworten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13738688",
          "text": "Beantwortet die Fragen!",
          "translation": "Ответьте на вопросы.",
          "source": "Tatoeba #13738688 @mhr / #12282311 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13738688",
          "cefr_level": "A1",
          "word_slugs": [
            "beantwortet-verb"
          ]
        },
        {
          "id": "13217822",
          "text": "Beantwortet meine Nachricht!",
          "translation": "Ответьте на моё сообщение!",
          "source": "Tatoeba #13217822 @Waldelfe / #13217828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13217822",
          "cefr_level": "A1",
