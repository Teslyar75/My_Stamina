    {
      "slug": "israel-name",
      "lemma": "Israel",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6860,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Israel (a country in Western Asia in the Middle East, at the eastern shore of the Mediterranean; official name: Staat Israel)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2573638",
          "text": "Ich komme aus Israel.",
          "translation": "Я из Израиля.",
          "source": "Tatoeba #2573638 @VirtuOZ / #3421018 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2573638",
          "cefr_level": "A1",
          "word_slugs": [
            "israel-name"
          ]
        },
        {
          "id": "2179636",
          "text": "Juden leben in Israel.",
          "translation": "Евреи живут в Израиле.",
          "source": "Tatoeba #2179636 @sismic / #2110995 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2179636",
          "cefr_level": "A1",
          "word_slugs": [
            "israel-name"
          ]
        },
        {
          "id": "7857613",
          "text": "Was weißt du über Israel?",
          "translation": "Что ты знаешь об Израиле?",
          "source": "Tatoeba #7857613 @Pfirsichbaeumchen / #3075096 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7857613",
          "cefr_level": "A1",
          "word_slugs": [
            "israel-name"
          ]
        },
        {
          "id": "14051697",
          "text": "Ich lebe nicht in Israel.",
          "translation": "Я не живу в Израиле.",
          "source": "Tatoeba #14051697 @mhr / #14050809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14051697",
          "cefr_level": "A1",
          "word_slugs": [
            "israel-name"
          ]
        },
        {
          "id": "7857614",
          "text": "Was wisst ihr über Israel?",
          "translation": "Что вы знаете об Израиле?",
          "source": "Tatoeba #7857614 @Pfirsichbaeumchen / #4628385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7857614",
          "cefr_level": "A1",
          "word_slugs": [
            "israel-name"
          ]
        }
