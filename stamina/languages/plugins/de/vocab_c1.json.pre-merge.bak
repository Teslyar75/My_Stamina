    {
      "slug": "linien-noun",
      "lemma": "Linien",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8874,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Linie"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "959296",
          "text": "Er zeichnet gerade Linien.",
          "translation": "Он чертит прямые линии.",
          "source": "Tatoeba #959296 @MUIRIEL / #10164321 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/959296",
          "cefr_level": "A1",
          "word_slugs": [
            "linien-noun"
          ]
        },
        {
          "id": "697995",
          "text": "Parallele Linien schneiden sich nicht.",
          "translation": "Параллельные линии не пересекаются.",
          "source": "Tatoeba #697995 @xtofu80 / #4864632 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/697995",
          "cefr_level": "A1",
          "word_slugs": [
            "linien-noun"
          ]
        },
        {
          "id": "405189",
          "text": "Diese Linien kreuzen sich im rechten Winkel.",
          "translation": "Эти линии пересекаются под прямым углом.",
          "source": "Tatoeba #405189 @xtofu80 / #6815424 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/405189",
          "cefr_level": "A1",
          "word_slugs": [
            "linien-noun"
          ]
        },
        {
          "id": "10603622",
          "text": "Die blauen Linien auf den Karten sind Flüsse.",
          "translation": "Голубые линии на картах - реки.",
          "source": "Tatoeba #10603622 @Adelpa / #10603881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10603622",
          "cefr_level": "A1",
          "word_slugs": [
            "linien-noun"
          ]
        },
        {
          "id": "404727",
          "text": "Die zwei Linien kreuzen sich im rechten Winkel.",
          "translation": "Две линии пересекаются, образуя прямой угол.",
          "source": "Tatoeba #404727 @xtofu80 / #6773694 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/404727",
          "cefr_level": "A1",
          "word_slugs": [
            "linien-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
