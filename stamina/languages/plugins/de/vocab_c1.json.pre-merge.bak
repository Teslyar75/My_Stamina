    {
      "slug": "junges-adj",
      "lemma": "junges",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5539,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of jung"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6328664",
          "text": "Laurie ist ein junges Mädchen.",
          "translation": "Лори - молодая девушка.",
          "source": "Tatoeba #6328664 @Zaghawa / #6328679 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6328664",
          "cefr_level": "A1",
          "word_slugs": [
            "junges-adj"
          ]
        },
        {
          "id": "13247182",
          "text": "Tom pflanzte ein junges Pfirsichbäumchen.",
          "translation": "Том посадил молодое персиковое деревце.",
          "source": "Tatoeba #13247182 @Ooneykcall / #13247132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13247182",
          "cefr_level": "A1",
          "word_slugs": [
            "junges-adj"
          ]
        },
        {
          "id": "399445",
          "text": "Ihr Verhalten ist unnormal für ein junges Mädchen.",
          "translation": "Ваше поведение не нормально для молодой девушки.",
          "source": "Tatoeba #399445 @xtofu80 / #13663489 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399445",
          "cefr_level": "A1",
          "word_slugs": [
            "junges-adj"
          ]
        },
        {
          "id": "920127",
          "text": "Ihr Betragen ist nicht normal für ein junges Mädchen.",
          "translation": "Её поведение не нормально для молодой девушки.",
          "source": "Tatoeba #920127 @Esperantostern / #4849170 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/920127",
          "cefr_level": "A1",
          "word_slugs": [
            "junges-adj"
          ]
        },
        {
          "id": "1852901",
          "text": "Ich hatte noch nie zuvor so ein schönes junges Mädchen gesehen.",
          "translation": "Я ещё никогда не видел такой красивой девушки.",
          "source": "Tatoeba #1852901 @Zaghawa / #11877888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1852901",
          "cefr_level": "A1",
          "word_slugs": [
            "junges-adj"
          ]
        }
