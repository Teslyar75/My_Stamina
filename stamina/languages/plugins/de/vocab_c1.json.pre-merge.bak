      "gender": null,
      "examples": [
        {
          "id": "2323650",
          "text": "Ein Auto fuhr vorüber.",
          "translation": "Проехала машина.",
          "source": "Tatoeba #2323650 @BraveSentry / #4945682 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2323650",
          "cefr_level": "A1",
          "word_slugs": [
            "vorüber-adv"
          ]
        },
        {
          "id": "1955678",
          "text": "Der Winter geht vorüber.",
          "translation": "Зима пройдёт.",
          "source": "Tatoeba #1955678 @al_ex_an_der / #1955669 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1955678",
          "cefr_level": "A1",
          "word_slugs": [
            "vorüber-adv"
          ]
        },
        {
          "id": "397931",
          "text": "Der Tag ist fast vorüber.",
