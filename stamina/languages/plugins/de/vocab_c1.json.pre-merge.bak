      "gender": null,
      "examples": [
        {
          "id": "8231377",
          "text": "Das ist eine natürliche Reaktion.",
          "translation": "Это естественная реакция.",
          "source": "Tatoeba #8231377 @Pfirsichbaeumchen / #8231365 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8231377",
          "cefr_level": "A1",
          "word_slugs": [
            "natürliche-adj"
          ]
        },
        {
          "id": "410049",
          "text": "Megs Haare haben natürliche Locken.",
          "translation": "У Мег волосы вьются от природы.",
          "source": "Tatoeba #410049 @MUIRIEL / #13762166 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/410049",
          "cefr_level": "A1",
          "word_slugs": [
            "natürliche-adj"
          ]
        },
        {
          "id": "12385800",
          "text": "Mir ist natürliche Schönheit lieber.",
          "translation": "Я предпочитаю натуральную красоту.",
          "source": "Tatoeba #12385800 @Bernie75 / #12385795 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12385800",
          "cefr_level": "A1",
          "word_slugs": [
            "natürliche-adj"
          ]
        },
        {
          "id": "12385799",
          "text": "Ich bevorzuge die natürliche Schönheit.",
          "translation": "Я предпочитаю натуральную красоту.",
          "source": "Tatoeba #12385799 @Bernie75 / #12385795 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12385799",
          "cefr_level": "A1",
          "word_slugs": [
            "natürliche-adj"
          ]
        },
        {
          "id": "765605",
          "text": "Sei x eine ganze natürliche Zahl.",
