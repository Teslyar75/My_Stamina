    {
      "slug": "bezeichnet-verb",
      "lemma": "bezeichnet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7358,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bezeichnen:",
          "third-person singular present",
          "inflection of bezeichnen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13041311",
          "text": "Baskisch wird als isolierte Sprache bezeichnet.",
          "translation": "Баскский язык называют изолированным языком.",
          "source": "Tatoeba #13041311 @mhr / #13041332 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13041311",
          "cefr_level": "A1",
          "word_slugs": [
            "bezeichnet-verb"
          ]
        },
        {
          "id": "13625364",
          "text": "Exoplaneten bezeichnet man auch als extrasolare Planeten.",
          "translation": "Экзопланеты называют также экстрасолнечными планетами.",
          "source": "Tatoeba #13625364 @mhr / #13625332 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13625364",
          "cefr_level": "A1",
          "word_slugs": [
            "bezeichnet-verb"
          ]
        },
        {
          "id": "13625369",
          "text": "Exoplaneten werden auch als extrasolare Planeten bezeichnet.",
          "translation": "Экзопланеты называют также экстрасолнечными планетами.",
          "source": "Tatoeba #13625369 @mhr / #13625332 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13625369",
          "cefr_level": "A1",
          "word_slugs": [
            "bezeichnet-verb"
          ]
        },
        {
          "id": "5045691",
          "text": "Deutsch wird mitunter als die Sprache Goethes bezeichnet.",
          "translation": "Немецкий язык иногда называют языком Гёте.",
          "source": "Tatoeba #5045691 @al_ex_an_der / #5045642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5045691",
          "cefr_level": "A1",
          "word_slugs": [
            "bezeichnet-verb"
          ]
        },
        {
          "id": "8565637",
          "text": "Maria bezeichnet ihre erste Liebe als „süßsaure Erinnerung“.",
          "translation": "Мэри называет первую любовь «сладко-кислым воспоминанием».",
          "source": "Tatoeba #8565637 @Pfirsichbaeumchen / #8450827 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8565637",
          "cefr_level": "A1",
          "word_slugs": [
            "bezeichnet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
