          "source": "Tatoeba #8081037 @Luiaard / #4704060 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8081037",
          "cefr_level": "A1",
          "word_slugs": [
            "legal-adj"
          ]
        },
        {
          "id": "11973081",
          "text": "Sklaverei war dort legal.",
          "translation": "Рабство там было узаконено.",
          "source": "Tatoeba #11973081 @Naina / #12728746 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11973081",
          "cefr_level": "A1",
          "word_slugs": [
            "legal-adj"
          ]
        },
        {
          "id": "11973082",
          "text": "Sklaverei ist dort legal gewesen.",
          "translation": "Рабство там было узаконено.",
          "source": "Tatoeba #11973082 @Naina / #12728746 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11973082",
          "cefr_level": "A1",
          "word_slugs": [
            "legal-adj"
          ]
        },
        {
          "id": "3835108",
          "text": "Prostitution ist legal in Deutschland.",
          "translation": "Проституция в Германии легальна.",
          "source": "Tatoeba #3835108 @futuro / #3703110 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3835108",
          "cefr_level": "A1",
          "word_slugs": [
            "legal-adj"
          ]
        },
        {
          "id": "2275700",
          "text": "Die gleichgeschlechtliche Ehe ist hier legal.",
          "translation": "Однополые браки здесь легальны.",
          "source": "Tatoeba #2275700 @Pfirsichbaeumchen / #2894898 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2275700",
          "cefr_level": "A1",
