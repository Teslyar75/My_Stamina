    {
      "slug": "mittagspause-noun",
      "lemma": "Mittagspause",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8418,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "lunchbreak, lunch hour (A break at work for having lunch, usually at a fixed time around noon and unpaid.)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6637792",
          "text": "Was? Du machst schon Mittagspause?",
          "translation": "Как? У тебя уже обеденный перерыв?",
          "source": "Tatoeba #6637792 @felix63 / #6638141 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6637792",
          "cefr_level": "A1",
          "word_slugs": [
            "mittagspause-noun"
          ]
        },
        {
          "id": "7552388",
          "text": "Meine Mittagspause ist fast vorbei.",
          "translation": "Мой обеденный перерыв почти закончился.",
          "source": "Tatoeba #7552388 @Luiaard / #7911431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7552388",
          "cefr_level": "A1",
          "word_slugs": [
            "mittagspause-noun"
          ]
        },
        {
          "id": "6636990",
          "text": "Sie haben eineinhalb Stunden Mittagspause.",
          "translation": "У них полуторачасовой обеденный перерыв.",
          "source": "Tatoeba #6636990 @felix63 / #6637264 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6636990",
          "cefr_level": "A1",
          "word_slugs": [
            "mittagspause-noun"
          ]
        },
        {
          "id": "12786552",
          "text": "Um wie viel Uhr hast du Mittagspause?",
          "translation": "Во сколько у тебя обеденный перерыв?",
          "source": "Tatoeba #12786552 @mhr / #12785456 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12786552",
          "cefr_level": "A1",
          "word_slugs": [
            "mittagspause-noun"
          ]
        },
        {
          "id": "12786554",
          "text": "Um wie viel Uhr habt ihr Mittagspause?",
          "translation": "Во сколько у вас обеденный перерыв?",
          "source": "Tatoeba #12786554 @mhr / #12785455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12786554",
          "cefr_level": "A1",
          "word_slugs": [
            "mittagspause-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
