          ]
        },
        {
          "id": "3703408",
          "text": "Regt euch nicht auf. Das ist nichts.",
          "translation": "Не волнуйтесь. Это пустяк.",
          "source": "Tatoeba #3703408 @Esperantostern / #5168016 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3703408",
          "cefr_level": "A1",
          "word_slugs": [
