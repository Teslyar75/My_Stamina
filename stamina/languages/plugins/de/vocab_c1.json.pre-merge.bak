        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9359838",
          "text": "Das war ein Gedicht.",
          "translation": "Это было стихотворение.",
          "source": "Tatoeba #9359838 @Pfirsichbaeumchen / #9500242 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9359838",
          "cefr_level": "A1",
          "word_slugs": [
            "gedicht-noun"
          ]
        },
        {
          "id": "12230943",
          "text": "Er lernte ein Gedicht.",
          "translation": "Он учил стихотворение.",
          "source": "Tatoeba #12230943 @mhr / #2287158 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12230943",
          "cefr_level": "A1",
          "word_slugs": [
            "gedicht-noun"
          ]
        },
        {
          "id": "5993099",
          "text": "Wir kennen das Gedicht.",
          "translation": "Мы знаем стихотворение.",
          "source": "Tatoeba #5993099 @raggione / #6072362 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5993099",
          "cefr_level": "A1",
          "word_slugs": [
            "gedicht-noun"
          ]
        },
        {
          "id": "12507436",
          "text": "Er übersetzte ein Gedicht.",
          "translation": "Он перевёл стихотворение.",
          "source": "Tatoeba #12507436 @Naina / #13916924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12507436",
          "cefr_level": "A1",
          "word_slugs": [
            "gedicht-noun"
          ]
        },
        {
          "id": "769434",
          "text": "Wer schrieb dieses Gedicht?",
          "translation": "Кто написал это стихотворение?",
          "source": "Tatoeba #769434 @Esperantostern / #1392010 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/769434",
          "cefr_level": "A1",
