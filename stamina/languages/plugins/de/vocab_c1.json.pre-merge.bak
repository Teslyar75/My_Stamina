    {
      "slug": "benannt-verb",
      "lemma": "benannt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8429,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of benennen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "661765",
          "text": "Ich wurde nach meinem Onkel benannt.",
          "translation": "Меня назвали в честь моего дяди.",
          "source": "Tatoeba #661765 @kolonjano / #12741897 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/661765",
          "cefr_level": "A1",
          "word_slugs": [
            "benannt-verb"
          ]
        },
        {
          "id": "2363616",
          "text": "Sie war nach ihrer Tante, Alice, benannt.",
          "translation": "Её назвали Алисой в честь тёти.",
          "source": "Tatoeba #2363616 @novaq / #13701776 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2363616",
          "cefr_level": "A1",
          "word_slugs": [
            "benannt-verb"
          ]
        },
        {
          "id": "13489387",
          "text": "Diese Stadt wurde nach meinem Urgroßvater benannt.",
          "translation": "Этот город был назван в честь моего прадеда.",
          "source": "Tatoeba #13489387 @Waldelfe / #5404730 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13489387",
          "cefr_level": "A1",
          "word_slugs": [
            "benannt-verb"
          ]
        },
        {
          "id": "12659608",
          "text": "Ihm zu Ehren ist sogar eine Straße benannt.",
          "translation": "В его честь даже названа улица.",
          "source": "Tatoeba #12659608 @mhr / #12659055 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12659608",
          "cefr_level": "A1",
          "word_slugs": [
            "benannt-verb"
          ]
        },
        {
          "id": "2485534",
          "text": "Das Kind wurde nach seinem Großvater Alfred benannt.",
          "translation": "Ребёнка назвали Альфредом в честь деда.",
          "source": "Tatoeba #2485534 @Tamy / #7807554 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2485534",
          "cefr_level": "A1",
          "word_slugs": [
            "benannt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
