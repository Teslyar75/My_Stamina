    {
      "slug": "irgendjemanden-pron",
      "lemma": "irgendjemanden",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9091,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "accusative of irgendjemand"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13674625",
          "text": "Störe ich irgendjemanden?",
          "translation": "Я никому не мешаю?",
          "source": "Tatoeba #13674625 @Vortarulo / #13674687 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13674625",
          "cefr_level": "A1",
          "word_slugs": [
            "irgendjemanden-pron"
          ]
        },
        {
          "id": "12671801",
          "text": "Fragen Sie irgendjemanden.",
          "translation": "Спросите у кого угодно.",
          "source": "Tatoeba #12671801 @mhr / #12674250 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12671801",
          "cefr_level": "A1",
          "word_slugs": [
            "irgendjemanden-pron"
          ]
        },
        {
          "id": "13660445",
          "text": "An irgendjemanden erinnern Sie mich.",
          "translation": "Кого-то Вы мне напоминаете.",
          "source": "Tatoeba #13660445 @mhr / #12003416 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13660445",
          "cefr_level": "A1",
          "word_slugs": [
            "irgendjemanden-pron"
          ]
        },
        {
          "id": "13434043",
          "text": "Warum bitten wir nicht irgendjemanden?",
          "translation": "Почему бы нам кого-нибудь не попросить?",
          "source": "Tatoeba #13434043 @mhr / #13433862 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13434043",
          "cefr_level": "A1",
          "word_slugs": [
            "irgendjemanden-pron"
          ]
        },
        {
          "id": "13434045",
          "text": "Warum fragen wir nicht irgendjemanden?",
          "translation": "Почему бы нам у кого-нибудь не спросить?",
          "source": "Tatoeba #13434045 @mhr / #13433861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13434045",
          "cefr_level": "A1",
          "word_slugs": [
            "irgendjemanden-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
