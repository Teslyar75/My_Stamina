          ]
        },
        {
          "id": "3263500",
          "text": "Er hat alles für dich geopfert.",
          "translation": "Он ради тебя всем пожертвовал.",
          "source": "Tatoeba #3263500 @Pfirsichbaeumchen / #10323085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3263500",
          "cefr_level": "A1",
          "word_slugs": [
