    {
      "slug": "letztens-adv",
      "lemma": "letztens",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7829,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "недавно"
        ],
        "en": [
          "recently; the other day",
          "lastly; finally"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2150783",
          "text": "Ich habe letztens deinen Bruder gesehen.",
          "translation": "Я недавно видел твоего брата.",
          "source": "Tatoeba #2150783 @Lars224 / #1670708 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2150783",
          "cefr_level": "A1",
          "word_slugs": [
            "letztens-adv"
          ]
        },
        {
          "id": "753146",
          "text": "Das ist der Junge, von dem ich letztens sprach.",
          "translation": "Это тот мальчик, о котором я на днях говорил.",
          "source": "Tatoeba #753146 @Pfirsichbaeumchen / #10934826 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/753146",
          "cefr_level": "A1",
          "word_slugs": [
            "letztens-adv"
          ]
        },
        {
          "id": "731337",
          "text": "Das ist derselbe Bleistift, den ich letztens verloren habe.",
          "translation": "Это такой же карандаш, как тот, что я на днях потерял.",
          "source": "Tatoeba #731337 @Dejo / #12829985 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/731337",
          "cefr_level": "A1",
          "word_slugs": [
            "letztens-adv"
          ]
        },
        {
          "id": "1548511",
          "text": "Ich traf das Mädchen erneut, das ich letztens im Park getroffen habe.",
          "translation": "Я снова встретил девочку, которую в последний раз встретил в парке.",
          "source": "Tatoeba #1548511 @Pfirsichbaeumchen / #1591575 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1548511",
          "cefr_level": "A1",
          "word_slugs": [
            "letztens-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
