    {
      "slug": "premierminister-noun",
      "lemma": "Premierminister",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5179,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "prime minister"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "642652",
          "text": "Der Premierminister ist zurückgetreten.",
          "translation": "Премьер-министр подал в отставку.",
          "source": "Tatoeba #642652 @al_ex_an_der / #1854388 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/642652",
          "cefr_level": "A1",
          "word_slugs": [
            "premierminister-noun"
          ]
        },
        {
          "id": "406374",
          "text": "Der Premierminister ernennt sein Kabinett.",
          "translation": "Премьер-министр назначает кабинет министров.",
          "source": "Tatoeba #406374 @xtofu80 / #13915251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/406374",
          "cefr_level": "A1",
          "word_slugs": [
            "premierminister-noun"
          ]
        },
        {
          "id": "799115",
          "text": "Der Premierminister traf sich mit der Presse.",
          "translation": "Премьер-министр встретился с прессой.",
          "source": "Tatoeba #799115 @xtofu80 / #4230187 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/799115",
          "cefr_level": "A1",
          "word_slugs": [
            "premierminister-noun"
          ]
        },
        {
          "id": "4818830",
          "text": "Ich habe heute mit dem Premierminister telefoniert.",
          "translation": "Я сегодня разговаривал по телефону с премьер-министром.",
          "source": "Tatoeba #4818830 @al_ex_an_der / #4818827 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4818830",
          "cefr_level": "A1",
          "word_slugs": [
            "premierminister-noun"
          ]
        },
        {
          "id": "435402",
          "text": "Aber Sie haben vollkommen Recht, Herr Premierminister!",
          "translation": "Но Вы совершенно правы, господин премьер-министр!",
          "source": "Tatoeba #435402 @jerom / #5471619 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/435402",
          "cefr_level": "A1",
          "word_slugs": [
            "premierminister-noun"
          ]
        }
