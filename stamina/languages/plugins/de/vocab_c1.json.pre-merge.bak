    {
      "slug": "verliessen-verb",
      "lemma": "verließen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8006,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verlassen:",
          "first/third-person plural preterite",
          "inflection of verlassen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12306246",
          "text": "Alle verließen den Saal.",
          "translation": "Все вышли из зала.",
          "source": "Tatoeba #12306246 @Pfirsichbaeumchen / #12306204 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12306246",
          "cefr_level": "A1",
          "word_slugs": [
            "verliessen-verb"
          ]
        },
        {
          "id": "398579",
          "text": "Sie verließen das sinkende Schiff.",
          "translation": "Они покинули тонущий корабль.",
          "source": "Tatoeba #398579 @xtofu80 / #618583 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398579",
          "cefr_level": "A1",
          "word_slugs": [
            "verliessen-verb"
          ]
        },
        {
          "id": "12582237",
          "text": "Sie verließen das Land sehr jung.",
          "translation": "Они покинули страну, будучи очень молодыми.",
          "source": "Tatoeba #12582237 @Waldelfe / #12582219 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12582237",
          "cefr_level": "A1",
          "word_slugs": [
            "verliessen-verb"
          ]
        },
        {
          "id": "1618427",
          "text": "Wir verließen das Haus am frühen Morgen.",
          "translation": "Ранним утром мы покинули дом.",
          "source": "Tatoeba #1618427 @Pfirsichbaeumchen / #6454033 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1618427",
          "cefr_level": "A1",
          "word_slugs": [
            "verliessen-verb"
          ]
        },
        {
          "id": "3551985",
          "text": "Alle Passagiere verließen in großer Eile das Flugzeug.",
          "translation": "Все пассажиры покинули в большой спешке самолёт.",
          "source": "Tatoeba #3551985 @al_ex_an_der / #3595399 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3551985",
          "cefr_level": "A1",
          "word_slugs": [
            "verliessen-verb"
          ]
        }
      ],
