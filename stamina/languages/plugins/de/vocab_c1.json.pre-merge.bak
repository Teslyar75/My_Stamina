      "gender": null,
      "examples": [
        {
          "id": "7108924",
          "text": "Tom mähte den Rasen.",
          "translation": "Том постриг газон.",
          "source": "Tatoeba #7108924 @Pfirsichbaeumchen / #6314387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7108924",
          "cefr_level": "A1",
