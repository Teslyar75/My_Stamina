      },
      "gender": null,
      "examples": [
        {
          "id": "4019020",
          "text": "Tom mag Nüsse.",
          "translation": "Том любит орехи.",
          "source": "Tatoeba #4019020 @pullnosemans / #4241799 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4019020",
