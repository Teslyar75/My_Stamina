    {
      "slug": "lache-noun",
      "lemma": "Lache",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7012,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "смех",
          "хохот"
        ],
        "en": [
          "loud laughter",
          "one's laugh (a person's particular way of laughing)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2810979",
          "text": "Lache das Leben an! Vielleicht lacht es wieder zurück.",
          "translation": "Улыбнись жизни — и, может быть, она улыбнётся тебе в ответ.",
          "source": "Tatoeba #2810979 @Esperantostern / #4421077 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2810979",
          "cefr_level": "A1",
          "word_slugs": [
            "lache-noun"
          ]
        }
      ],
      "tags": [
