    {
      "slug": "hasen-noun",
      "lemma": "Hasen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7405,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Hase:",
          "genitive/dative/accusative singular",
          "inflection of Hase:",
          "nominative/genitive/dative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1187990",
          "text": "Ich mag Hasen.",
          "translation": "Мне нравятся зайцы.",
          "source": "Tatoeba #1187990 @Tlustulimu / #2570836 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1187990",
          "cefr_level": "A1",
          "word_slugs": [
            "hasen-noun"
          ]
        },
        {
          "id": "12287975",
          "text": "Tom mag keine Hasen.",
          "translation": "Том не любит зайцев.",
          "source": "Tatoeba #12287975 @\\N / #6375529 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12287975",
          "cefr_level": "A1",
          "word_slugs": [
            "hasen-noun"
          ]
        },
        {
          "id": "1056466",
          "text": "Viele Hunde sind des Hasen Tod.",
          "translation": "Где много гончих, там зайцу смерть.",
          "source": "Tatoeba #1056466 @Esperantostern / #2819861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1056466",
          "cefr_level": "A1",
          "word_slugs": [
            "hasen-noun"
          ]
        },
        {
          "id": "2743656",
          "text": "Der Jäger lauert einem Hasen auf.",
          "translation": "Охотник поджидает зайца.",
          "source": "Tatoeba #2743656 @al_ex_an_der / #5846593 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2743656",
          "cefr_level": "A1",
          "word_slugs": [
            "hasen-noun"
          ]
        },
        {
          "id": "2105203",
          "text": "Wer zwei Hasen jagt, wird keinen fangen.",
          "translation": "За двумя зайцами погонишься — ни одного не поймаешь.",
          "source": "Tatoeba #2105203 @Pfirsichbaeumchen / #1885198 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2105203",
          "cefr_level": "A1",
          "word_slugs": [
            "hasen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
