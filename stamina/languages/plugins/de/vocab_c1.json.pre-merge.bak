      "gender": "f",
      "examples": [
        {
          "id": "369882",
          "text": "Er deckte die Korruption in der städtischen Regierung auf.",
          "translation": "Он обнаружил коррупцию в городской власти.",
          "source": "Tatoeba #369882 @kriskelvin / #2916953 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/369882",
          "cefr_level": "A1",
          "word_slugs": [
            "korruption-noun"
          ]
        },
        {
          "id": "6093662",
          "text": "Die Korruption stellt in vielen Ländern der Welt ein Problem dar.",
          "translation": "Коррупция является проблемой во многих странах мира.",
          "source": "Tatoeba #6093662 @Pfirsichbaeumchen / #5215834 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6093662",
          "cefr_level": "A1",
          "word_slugs": [
            "korruption-noun"
          ]
        },
        {
          "id": "10968705",
          "text": "Korruption und Politik sind Geschwister.",
          "translation": "Коррупция и политика - родные сёстры.",
          "source": "Tatoeba #10968705 @maaster / #10970780 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10968705",
          "cefr_level": "A1",
          "word_slugs": [
            "korruption-noun"
          ]
        }
      ],
      "tags": [
