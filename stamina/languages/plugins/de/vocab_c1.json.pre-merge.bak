        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "355349",
          "text": "Ich hänge an dir.",
          "translation": "Я привязан к тебе.",
          "source": "Tatoeba #355349 @MUIRIEL / #5167508 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/355349",
          "cefr_level": "A1",
          "word_slugs": [
            "hänge-verb"
          ]
        },
        {
          "id": "3327177",
          "text": "Ich hänge die Wäsche auf.",
          "translation": "Я вешаю бельё.",
          "source": "Tatoeba #3327177 @al_ex_an_der / #3327180 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3327177",
          "cefr_level": "A1",
          "word_slugs": [
            "hänge-verb"
          ]
        },
        {
          "id": "12570694",
          "text": "Ich hänge immer noch finanziell von meinen Eltern ab.",
          "translation": "Я всё ещё финансово завишу от родителей.",
          "source": "Tatoeba #12570694 @Waldelfe / #12570721 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12570694",
          "cefr_level": "A1",
          "word_slugs": [
            "hänge-verb"
          ]
        },
        {
          "id": "1976744",
          "text": "Ich hänge gerade ein Porträt meiner Großmutter an die Wand.",
          "translation": "Я вешаю на стену портрет бабушки.",
          "source": "Tatoeba #1976744 @al_ex_an_der / #5145694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1976744",
          "cefr_level": "A1",
          "word_slugs": [
