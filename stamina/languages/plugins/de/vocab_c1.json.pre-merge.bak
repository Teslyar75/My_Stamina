      "gender": null,
      "examples": [
        {
          "id": "6004254",
          "text": "Ich habe die Tür aufgemacht.",
          "translation": "Я открыл дверь.",
          "source": "Tatoeba #6004254 @nina99nv / #2665754 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6004254",
