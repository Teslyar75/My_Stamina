          "inflection of komisch:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "917142",
          "text": "Das ist wirklich ein komischer Geselle!",
          "translation": "Он действительно странный товарищ!",
          "source": "Tatoeba #917142 @Sudajaengi / #12678891 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/917142",
          "cefr_level": "A1",
          "word_slugs": [
            "komischer-adj"
          ]
        },
        {
          "id": "11665937",
          "text": "Da ist so ein komischer Hund im Garten.",
          "translation": "В саду какая-то странная собака.",
          "source": "Tatoeba #11665937 @Pfirsichbaeumchen / #11629127 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11665937",
          "cefr_level": "A1",
