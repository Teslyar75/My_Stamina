    {
      "slug": "silber-noun",
      "lemma": "Silber",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5645,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "silver (chemical element with the symbol Ag)",
          "argent"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8657168",
          "text": "Ist das aus Silber?",
          "translation": "Это из серебра?",
          "source": "Tatoeba #8657168 @felix63 / #8680978 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8657168",
          "cefr_level": "A1",
          "word_slugs": [
            "silber-noun"
          ]
        },
        {
          "id": "6645572",
          "text": "Das ist kein Silber.",
          "translation": "Это не серебро.",
          "source": "Tatoeba #6645572 @Felixjp / #5631244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6645572",
          "cefr_level": "A1",
          "word_slugs": [
            "silber-noun"
          ]
        },
        {
          "id": "572951",
          "text": "Gold ist schwerer als Silber.",
          "translation": "Золото тяжелее, чем серебро.",
          "source": "Tatoeba #572951 @MUIRIEL / #1387718 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/572951",
          "cefr_level": "A1",
          "word_slugs": [
            "silber-noun"
          ]
        },
        {
          "id": "8636626",
          "text": "Dieser Löffel ist aus Silber.",
          "translation": "Эта ложка серебряная.",
          "source": "Tatoeba #8636626 @felix63 / #10577799 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636626",
          "cefr_level": "A1",
          "word_slugs": [
            "silber-noun"
          ]
        },
        {
          "id": "6314091",
          "text": "Gold ist wertvoller als Silber.",
          "translation": "Золото дороже серебра.",
          "source": "Tatoeba #6314091 @Pfirsichbaeumchen / #6143211 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6314091",
          "cefr_level": "A1",
          "word_slugs": [
            "silber-noun"
          ]
        }
      ],
      "tags": [
