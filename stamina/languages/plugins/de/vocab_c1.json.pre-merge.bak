    {
      "slug": "zögern-noun",
      "lemma": "Zögern",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6080,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of zögern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7536451",
          "text": "Ich hoffe, du kannst mein Zögern in dieser Angelegenheit verstehen.",
          "translation": "Я надеюсь, ты сможешь понять неуверенность в этом вопросе.",
          "source": "Tatoeba #7536451 @Pfirsichbaeumchen / #7536741 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7536451",
          "cefr_level": "A1",
          "word_slugs": [
            "zögern-noun"
          ]
        },
        {
          "id": "4240273",
          "text": "Zögern Sie nicht, mich zu kontaktieren!",
          "translation": "Не стесняйтесь обращаться ко мне.",
          "source": "Tatoeba #4240273 @Pfirsichbaeumchen / #3140961 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4240273",
          "cefr_level": "A1",
          "word_slugs": [
            "zögern-noun"
          ]
        },
        {
          "id": "959998",
          "text": "Zögern Sie nicht, zu fragen, wenn Sie etwas nicht verstehen.",
          "translation": "Не стесняйтесь задавать вопросы, если чего-то не понимаете.",
          "source": "Tatoeba #959998 @Sudajaengi / #11170102 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/959998",
          "cefr_level": "A1",
          "word_slugs": [
            "zögern-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
