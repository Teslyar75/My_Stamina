    {
      "slug": "ruhestand-noun",
      "lemma": "Ruhestand",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5981,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "retirement"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6158645",
          "text": "Ich bin schon im Ruhestand.",
          "translation": "Я уже на пенсии.",
          "source": "Tatoeba #6158645 @felix63 / #5336313 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6158645",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhestand-noun"
          ]
        },
        {
          "id": "5720955",
          "text": "Tom ist Polizist im Ruhestand.",
          "translation": "Том - полицейский в отставке.",
          "source": "Tatoeba #5720955 @Pfirsichbaeumchen / #5114640 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5720955",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhestand-noun"
          ]
        },
        {
          "id": "8690604",
          "text": "Ich bin altersbedingt im Ruhestand.",
          "translation": "Я ушел на пенсию по старости.",
          "source": "Tatoeba #8690604 @Yorwba / #9803342 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8690604",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhestand-noun"
          ]
        },
        {
          "id": "3766459",
          "text": "Seit wann bist du im Ruhestand?",
          "translation": "Когда ты вышел в отставку?",
          "source": "Tatoeba #3766459 @Jens_Odo / #3281802 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3766459",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhestand-noun"
          ]
        },
        {
          "id": "3766457",
          "text": "Wann bist du in den Ruhestand gegangen?",
          "translation": "Когда ты вышел в отставку?",
          "source": "Tatoeba #3766457 @Jens_Odo / #3281802 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3766457",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhestand-noun"
          ]
        }
