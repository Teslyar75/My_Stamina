          "inflection of scherzen:",
          "first-person singular present",
          "inflection of scherzen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "903455",
          "text": "Ich scherze nicht.",
          "translation": "Я не шучу.",
          "source": "Tatoeba #903455 @Sudajaengi / #547766 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/903455",
          "cefr_level": "A1",
          "word_slugs": [
            "scherze-verb"
          ]
        },
        {
          "id": "1766295",
          "text": "Glauben Sie, ich scherze?",
          "translation": "Вы думаете, я шучу?",
          "source": "Tatoeba #1766295 @Zaghawa / #3562500 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1766295",
          "cefr_level": "A1",
          "word_slugs": [
            "scherze-verb"
          ]
        },
        {
          "id": "6358903",
          "text": "Ich dachte erst, er scherze.",
          "translation": "Сначала я думал, что он шутит.",
          "source": "Tatoeba #6358903 @Pfirsichbaeumchen / #4995280 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6358903",
          "cefr_level": "A1",
          "word_slugs": [
            "scherze-verb"
          ]
        },
        {
          "id": "6146971",
          "text": "Anfangs glaubte ich, Tom scherze.",
          "translation": "Сначала я думал, что Том шутит.",
          "source": "Tatoeba #6146971 @Pfirsichbaeumchen / #8296288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6146971",
          "cefr_level": "A1",
          "word_slugs": [
            "scherze-verb"
          ]
        },
        {
          "id": "9089154",
          "text": "Tom glaubte, Maria scherze nur, aber dem war nicht so.",
          "translation": "Том думал, что Мэри просто шутит, но она не шутила.",
          "source": "Tatoeba #9089154 @Pfirsichbaeumchen / #8250323 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9089154",
          "cefr_level": "A1",
          "word_slugs": [
            "scherze-verb"
          ]
        }
      ],
      "tags": [
