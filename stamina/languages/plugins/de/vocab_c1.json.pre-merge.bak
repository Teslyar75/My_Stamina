      },
      "gender": null,
      "examples": [
        {
          "id": "13631453",
          "text": "Wann hat er es dir geliehen?",
          "translation": "Когда он тебе его одолжил?",
          "source": "Tatoeba #13631453 @mhr / #13631158 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13631453",
          "cefr_level": "A1",
          "word_slugs": [
            "geliehen-verb"
          ]
        },
        {
          "id": "13660926",
          "text": "Wozu hast du Tom Geld geliehen?",
          "translation": "Зачем ты одолжил Тому деньги?",
          "source": "Tatoeba #13660926 @mhr / #13660933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13660926",
          "cefr_level": "A1",
          "word_slugs": [
            "geliehen-verb"
          ]
        },
        {
          "id": "1315709",
          "text": "Er hat mir zwei Bücher geliehen.",
          "translation": "Он одолжил мне две книги.",
