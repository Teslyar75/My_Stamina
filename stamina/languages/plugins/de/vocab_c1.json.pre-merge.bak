      "examples": [
        {
          "id": "13778786",
          "text": "Das ist eine leichte Verletzung.",
          "translation": "Это лёгкое ранение.",
          "source": "Tatoeba #13778786 @Naina / #13778790 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13778786",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzung-noun"
          ]
        },
        {
          "id": "7803713",
          "text": "Der Fußballspieler täuschte eine Verletzung vor.",
          "translation": "Футболист симулировал травму.",
          "source": "Tatoeba #7803713 @Pfirsichbaeumchen / #7803693 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7803713",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzung-noun"
          ]
        },
        {
          "id": "7349942",
          "text": "Wegen Verletzung setze ich beim nächsten Spiel aus.",
          "translation": "Из-за травмы я пропущу следующую игру.",
          "source": "Tatoeba #7349942 @Pfirsichbaeumchen / #6996159 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7349942",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzung-noun"
          ]
        },
        {
          "id": "4643101",
          "text": "Wie hast du dir denn solch eine Verletzung zugezogen?",
          "translation": "Как это ты ухитрился так пораниться?",
          "source": "Tatoeba #4643101 @Pfirsichbaeumchen / #4643623 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4643101",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzung-noun"
          ]
        },
        {
          "id": "10969065",
          "text": "Das Risiko einer Verletzung ist minimal in diesem Sport.",
          "translation": "Риск получения травмы в этом виде спорта минимален.",
          "source": "Tatoeba #10969065 @p0wcr / #10970801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10969065",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzung-noun"
          ]
        }
