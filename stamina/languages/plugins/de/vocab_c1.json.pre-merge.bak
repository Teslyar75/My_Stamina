    {
      "slug": "einiger-adj",
      "lemma": "einiger",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5572,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of einig:",
          "strong/mixed nominative masculine singular",
          "inflection of einig:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10258582",
          "text": "Talent ist das Vorrecht einiger weniger.",
          "translation": "Талант - это удел немногих.",
          "source": "Tatoeba #10258582 @carlosalberto / #6464659 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10258582",
          "cefr_level": "A1",
          "word_slugs": [
            "einiger-adj"
          ]
        },
        {
          "id": "3208252",
          "text": "Ich arbeite hier schon seit einiger Zeit.",
          "translation": "Я здесь работаю уже некоторое время.",
          "source": "Tatoeba #3208252 @Pfirsichbaeumchen / #3030981 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3208252",
          "cefr_level": "A1",
          "word_slugs": [
            "einiger-adj"
          ]
        },
        {
          "id": "10455414",
          "text": "Wir sind schon seit einiger Zeit zusammen.",
          "translation": "Мы уже какое-то время встречаемся.",
          "source": "Tatoeba #10455414 @Pfirsichbaeumchen / #6888037 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10455414",
          "cefr_level": "A1",
          "word_slugs": [
            "einiger-adj"
          ]
        },
        {
          "id": "3289594",
          "text": "Das lässt sich mittels einiger Beispiele illustrieren.",
          "translation": "Это может быть проиллюстрировано несколькими примерами.",
          "source": "Tatoeba #3289594 @al_ex_an_der / #3289591 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3289594",
          "cefr_level": "A1",
          "word_slugs": [
            "einiger-adj"
          ]
        },
        {
          "id": "6157172",
          "text": "Er hat das Bild vor einiger Zeit gemalt.",
          "translation": "Он написал эту картину какое-то время назад.",
          "source": "Tatoeba #6157172 @raggione / #8565864 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6157172",
          "cefr_level": "A1",
          "word_slugs": [
            "einiger-adj"
          ]
        }
      ],
      "tags": [
        "C1"
