      },
      "gender": null,
      "examples": [
        {
          "id": "13731733",
          "text": "Ich habe die Kanister gefüllt.",
          "translation": "Я наполнял канистры.",
          "source": "Tatoeba #13731733 @mhr / #12255578 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13731733",
          "cefr_level": "A1",
