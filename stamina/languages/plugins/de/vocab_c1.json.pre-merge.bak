    {
      "slug": "ansicht-noun",
      "lemma": "Ansicht",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5454,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мнение",
          "взгляд"
        ],
        "en": [
          "view (a depiction of a subject, especially from a specific perspective)",
          "view (a depiction of a subject, especially from a specific perspective)",
          "view (a state of the user interface in which data is displayed and arranged in a specific way)",
          "view; opinion"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8837920",
          "text": "Das ist meine Ansicht.",
          "translation": "Это моя точка зрения.",
          "source": "Tatoeba #8837920 @Pfirsichbaeumchen / #2998582 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8837920",
          "cefr_level": "A1",
          "word_slugs": [
            "ansicht-noun"
          ]
        },
        {
          "id": "451173",
          "text": "Ich bin anderer Ansicht.",
          "translation": "Я другого мнения.",
          "source": "Tatoeba #451173 @Pfirsichbaeumchen / #1265925 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/451173",
          "cefr_level": "A1",
          "word_slugs": [
            "ansicht-noun"
          ]
        },
        {
          "id": "4906808",
          "text": "Ich respektiere deine Ansicht.",
          "translation": "Я уважаю твоё мнение.",
          "source": "Tatoeba #4906808 @Zaghawa / #2557755 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4906808",
          "cefr_level": "A1",
          "word_slugs": [
            "ansicht-noun"
          ]
        },
        {
          "id": "13597522",
          "text": "Nicht alle teilen diese Ansicht.",
          "translation": "Не все разделяют эту точку зрения.",
          "source": "Tatoeba #13597522 @mhr / #8174657 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13597522",
          "cefr_level": "A1",
          "word_slugs": [
            "ansicht-noun"
          ]
        },
        {
          "id": "2650740",
          "text": "Tom sperrt sich gegen diese Ansicht.",
          "translation": "Том никак не хочет признавать правильность этого мнения.",
          "source": "Tatoeba #2650740 @Olya / #2650742 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650740",
          "cefr_level": "A1",
          "word_slugs": [
            "ansicht-noun"
          ]
        }
      ],
      "tags": [
