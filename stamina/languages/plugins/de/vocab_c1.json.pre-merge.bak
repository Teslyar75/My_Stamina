          "strong/mixed nominative/accusative neuter singular of schwer"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7636620",
          "text": "Tom hatte ein schweres Leben.",
          "translation": "У Тома была трудная жизнь.",
          "source": "Tatoeba #7636620 @wolfgangth / #4160733 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7636620",
          "cefr_level": "A1",
          "word_slugs": [
            "schweres-adj"
          ]
        },
        {
          "id": "13672294",
          "text": "Mord ist ein sehr schweres Verbrechen.",
          "translation": "Убийство очень тяжкое преступление.",
          "source": "Tatoeba #13672294 @Pfirsichbaeumchen / #13670480 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13672294",
          "cefr_level": "A1",
          "word_slugs": [
            "schweres-adj"
          ]
        },
        {
          "id": "13602621",
          "text": "Der heutigen Zeitung zufolge gab es gestern in Chile ein schweres Erdbeben.",
          "translation": "По сообщению сегодняшней газеты, вчера в Чили было сильное землетрясение.",
          "source": "Tatoeba #13602621 @mhr / #1511005 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13602621",
          "cefr_level": "A1",
          "word_slugs": [
            "schweres-adj"
          ]
        }
