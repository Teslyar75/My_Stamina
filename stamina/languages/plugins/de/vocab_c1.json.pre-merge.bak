          ]
        },
        {
          "id": "3301179",
          "text": "Tom küsste Maria in den Nacken.",
          "translation": "Том поцеловал Мэри в шею.",
          "source": "Tatoeba #3301179 @Pfirsichbaeumchen / #3008308 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3301179",
          "cefr_level": "A1",
          "word_slugs": [
            "nacken-noun"
          ]
        },
        {
          "id": "4020178",
          "text": "Mein Nacken tut ein bisschen weh.",
          "translation": "У меня шея побаливает.",
          "source": "Tatoeba #4020178 @pullnosemans / #6897427 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4020178",
