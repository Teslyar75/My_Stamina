    {
      "slug": "tische-noun",
      "lemma": "Tische",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9984,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Tisch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2057381",
          "text": "Manche Tische sind rund.",
          "translation": "Некоторые столы круглые.",
          "source": "Tatoeba #2057381 @al_ex_an_der / #4945430 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2057381",
          "cefr_level": "A1",
          "word_slugs": [
            "tische-noun"
          ]
        },
        {
          "id": "5941647",
          "text": "Da stehen Tische und Stühle.",
          "translation": "Там стоят столы и стулья.",
          "source": "Tatoeba #5941647 @Pfirsichbaeumchen / #5836589 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5941647",
          "cefr_level": "A1",
          "word_slugs": [
            "tische-noun"
          ]
        },
        {
          "id": "1293525",
          "text": "In diesem Zimmer gibt es Tische.",
          "translation": "В комнате есть столы.",
          "source": "Tatoeba #1293525 @sascha / #498280 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1293525",
          "cefr_level": "A1",
          "word_slugs": [
            "tische-noun"
          ]
        },
        {
          "id": "412225",
          "text": "Sie benutzen keine Stühle und Tische.",
          "translation": "Они не пользуются столом и стульями.",
          "source": "Tatoeba #412225 @MUIRIEL / #412229 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/412225",
          "cefr_level": "A1",
          "word_slugs": [
            "tische-noun"
          ]
        },
        {
          "id": "9989539",
          "text": "Zu Tische saßen ein Mann, eine Frau und ein Mädchen.",
          "translation": "За столом сидели мужчина, женщина и девочка.",
          "source": "Tatoeba #9989539 @Pfirsichbaeumchen / #9180819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9989539",
          "cefr_level": "A1",
          "word_slugs": [
            "tische-noun"
          ]
        }
      ],
