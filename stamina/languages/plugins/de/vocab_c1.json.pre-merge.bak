    {
      "slug": "ausgesehen-verb",
      "lemma": "ausgesehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6523,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of aussehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5215749",
          "text": "Tom hat krank ausgesehen.",
          "translation": "Том выглядел больным.",
          "source": "Tatoeba #5215749 @brauchinet / #4950019 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5215749",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgesehen-verb"
          ]
        },
        {
          "id": "5369007",
          "text": "Tom hat sehr gut ausgesehen.",
          "translation": "Том очень хорошо выглядел.",
          "source": "Tatoeba #5369007 @Pfirsichbaeumchen / #5558409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5369007",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgesehen-verb"
          ]
        },
        {
          "id": "12576950",
          "text": "Tom sagt, daß Maria nicht müde ausgesehen habe.",
          "translation": "Том говорит, что Мэри не выглядела уставшей.",
          "source": "Tatoeba #12576950 @Waldelfe / #12576606 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12576950",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgesehen-verb"
          ]
        },
        {
          "id": "7481609",
          "text": "Ich finde, du hast mit glattem Haar besser ausgesehen.",
          "translation": "Мне кажется, ты выглядел лучше с прямыми волосами.",
          "source": "Tatoeba #7481609 @Yorwba / #7481628 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7481609",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgesehen-verb"
          ]
        },
        {
          "id": "10800207",
          "text": "Sie hätte anders ausgesehen, wenn ich die gemacht hätte.",
          "translation": "Она бы выглядела по-другому, если бы я её делал.",
          "source": "Tatoeba #10800207 @kotik / #10800226 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10800207",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgesehen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
