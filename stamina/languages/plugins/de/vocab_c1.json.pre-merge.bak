    {
      "slug": "bittest-verb",
      "lemma": "bittest",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8690,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bitten:",
          "second-person singular present",
          "inflection of bitten:",
          "second-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "343060",
          "text": "Wenn du ihn bittest, hilft er dir.",
          "translation": "Если ты его попросишь, он тебе поможет.",
          "source": "Tatoeba #343060 @MUIRIEL / #3153559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/343060",
          "cefr_level": "A1",
          "word_slugs": [
            "bittest-verb"
          ]
        },
        {
          "id": "3556019",
          "text": "Warum bittest du Tom nicht um Hilfe?",
          "translation": "Почему ты не попросишь Тома о помощи?",
          "source": "Tatoeba #3556019 @Pfirsichbaeumchen / #3556025 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3556019",
          "cefr_level": "A1",
          "word_slugs": [
            "bittest-verb"
          ]
        },
        {
          "id": "2968222",
          "text": "Tom wird alles tun, worum du ihn bittest.",
          "translation": "Том сделает всё, о чём ты его попросишь.",
          "source": "Tatoeba #2968222 @Pfirsichbaeumchen / #2968483 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2968222",
          "cefr_level": "A1",
          "word_slugs": [
            "bittest-verb"
          ]
        },
        {
          "id": "6611293",
          "text": "Tom wird kommen, wenn du ihn darum bittest.",
          "translation": "Том придёт, если ты его об этом попросишь.",
          "source": "Tatoeba #6611293 @Felixjp / #7083078 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6611293",
          "cefr_level": "A1",
          "word_slugs": [
            "bittest-verb"
          ]
        },
        {
          "id": "1823131",
          "text": "Warum bittest du nicht einfach deine Eltern um Geld?",
          "translation": "Почему бы тебе просто не попросить денег у родителей?",
          "source": "Tatoeba #1823131 @Pfirsichbaeumchen / #3104973 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1823131",
          "cefr_level": "A1",
          "word_slugs": [
            "bittest-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
