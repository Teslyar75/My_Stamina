    {
      "slug": "schmutz-noun",
      "lemma": "Schmutz",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8800,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "грязь"
        ],
        "en": [
          "dirt",
          "fat",
          "a cocktail with equal parts beer and cola"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5282517",
          "text": "Tom spielt gern im Schmutz.",
          "translation": "Тому нравится играть в грязи.",
          "source": "Tatoeba #5282517 @Pfirsichbaeumchen / #8860605 @iiujik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5282517",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutz-noun"
          ]
        },
        {
          "id": "1291412",
          "text": "Seife hilft gegen den Schmutz.",
          "translation": "Мыло помогает от грязи.",
          "source": "Tatoeba #1291412 @Esperantostern / #9144430 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1291412",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutz-noun"
          ]
        },
        {
          "id": "2284962",
          "text": "Er hat alles in den Schmutz gezogen.",
          "translation": "Он втоптал всё в грязь.",
          "source": "Tatoeba #2284962 @al_ex_an_der / #2284864 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2284962",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutz-noun"
          ]
        },
        {
          "id": "3108493",
          "text": "Auf der Straße gibt es Pfützen und Schmutz.",
          "translation": "На улице лужи и грязь.",
          "source": "Tatoeba #3108493 @al_ex_an_der / #3107742 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3108493",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutz-noun"
          ]
        },
        {
          "id": "3108982",
          "text": "Diese alten verfallenen Häuser passen ausgezeichnet zum Schmutz auf der Straße.",
          "translation": "Эти старые обшарпанные дома отлично гармонируют с грязью на улице.",
          "source": "Tatoeba #3108982 @al_ex_an_der / #3107750 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3108982",
          "cefr_level": "A1",
          "word_slugs": [
            "schmutz-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Schmutz",
        "nominative_pl": ""
      }
