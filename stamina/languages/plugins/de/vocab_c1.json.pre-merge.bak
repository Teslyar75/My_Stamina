          "cefr_level": "A1",
          "word_slugs": [
            "enthalten-verb"
          ]
        },
        {
          "id": "13773285",
          "text": "Orangen enthalten viele Vitamine.",
          "translation": "В апельсинах много витаминов.",
          "source": "Tatoeba #13773285 @Waldelfe / #4856514 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13773285",
          "cefr_level": "A1",
          "word_slugs": [
            "enthalten-verb"
          ]
        },
        {
          "id": "2973404",
          "text": "Alle Wörterbücher enthalten Fehler.",
