    {
      "slug": "ausleihen-verb",
      "lemma": "ausleihen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6893,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "одолжить",
          "одалживать"
        ],
        "en": [
          "to borrow",
          "to lend"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "387223",
          "text": "Darf ich Ihr Auto ausleihen?",
          "translation": "Можно мне одолжить Вашу машину?",
          "source": "Tatoeba #387223 @MUIRIEL / #468495 @tensin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/387223",
          "cefr_level": "A1",
          "word_slugs": [
            "ausleihen-verb"
          ]
        },
        {
          "id": "387243",
          "text": "Darf ich das Buch ausleihen?",
          "translation": "Я могу одолжить эту книгу?",
          "source": "Tatoeba #387243 @MUIRIEL / #412683 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/387243",
          "cefr_level": "A1",
          "word_slugs": [
            "ausleihen-verb"
          ]
        },
        {
          "id": "13811297",
          "text": "Werdet ihr sie ihr ausleihen?",
          "translation": "Вы их ей одолжите?",
          "source": "Tatoeba #13811297 @mhr / #13811289 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13811297",
          "cefr_level": "A1",
          "word_slugs": [
            "ausleihen-verb"
          ]
        },
        {
          "id": "13811298",
          "text": "Werdet ihr sie ihm ausleihen?",
          "translation": "Вы их ему одолжите?",
          "source": "Tatoeba #13811298 @mhr / #13811288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13811298",
          "cefr_level": "A1",
          "word_slugs": [
            "ausleihen-verb"
          ]
        },
        {
          "id": "13811301",
          "text": "Werden Sie sie ihm ausleihen?",
          "translation": "Вы их ему одолжите?",
          "source": "Tatoeba #13811301 @mhr / #13811288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13811301",
          "cefr_level": "A1",
