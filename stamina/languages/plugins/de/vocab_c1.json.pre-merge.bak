      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "traffic ticket",
          "parking ticket"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4234827",
          "text": "Hast du schon einmal einen Strafzettel für Schnellfahren bekommen?",
          "translation": "Ты когда-нибудь получал штраф за превышение скорости?",
          "source": "Tatoeba #4234827 @brauchinet / #4934054 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4234827",
          "cefr_level": "A1",
          "word_slugs": [
            "strafzettel-noun"
          ]
        },
        {
          "id": "13257565",
          "text": "Wenn ihr hier geparkt hättet, dann hättet ihr einen Strafzettel bekommen.",
          "translation": "Если бы вы припарковали свою машину здесь, вас оштрафовали бы.",
          "source": "Tatoeba #13257565 @Waldelfe / #2010647 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13257565",
          "cefr_level": "A1",
          "word_slugs": [
            "strafzettel-noun"
          ]
        },
        {
          "id": "13257566",
          "text": "Wenn Sie hier geparkt hätten, dann hätten Sie einen Strafzettel bekommen.",
          "translation": "Если бы вы припарковали свою машину здесь, вас оштрафовали бы.",
          "source": "Tatoeba #13257566 @Waldelfe / #2010647 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13257566",
