          "cefr_level": "A1",
          "word_slugs": [
            "liter-noun"
          ]
        },
        {
          "id": "12306479",
          "text": "Das ist eine 1-Liter-Flasche.",
          "translation": "Это литровая бутылка.",
          "source": "Tatoeba #12306479 @Pfirsichbaeumchen / #12304947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12306479",
          "cefr_level": "A1",
          "word_slugs": [
            "liter-noun"
          ]
        },
        {
          "id": "8425848",
          "text": "Ich brauche einen Liter Milch.",
          "translation": "Мне нужен литр молока.",
          "source": "Tatoeba #8425848 @felix63 / #8425886 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8425848",
          "cefr_level": "A1",
          "word_slugs": [
            "liter-noun"
          ]
        },
        {
          "id": "12506939",
          "text": "Wir brauchen zwei Liter Milch.",
          "translation": "Нам нужно два литра молока.",
          "source": "Tatoeba #12506939 @mhr / #6819623 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12506939",
          "cefr_level": "A1",
          "word_slugs": [
            "liter-noun"
          ]
        },
        {
          "id": "2732719",
          "text": "Diese Flasche fasst einen Liter.",
          "translation": "Это литровая бутылка.",
          "source": "Tatoeba #2732719 @brauchinet / #12304947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2732719",
          "cefr_level": "A1",
          "word_slugs": [
            "liter-noun"
          ]
        }
      ],
