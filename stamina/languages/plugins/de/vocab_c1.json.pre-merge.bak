      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "committee"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3613699",
          "text": "Bist du im Komitee?",
          "translation": "Ты состоишь в комитете?",
          "source": "Tatoeba #3613699 @Jan_Schreiber / #4658623 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3613699",
          "cefr_level": "A1",
          "word_slugs": [
            "komitee-noun"
          ]
        },
        {
          "id": "3613695",
          "text": "Sind Sie im Komitee?",
          "translation": "Вы состоите в комитете?",
          "source": "Tatoeba #3613695 @Jan_Schreiber / #12428391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3613695",
          "cefr_level": "A1",
          "word_slugs": [
            "komitee-noun"
          ]
        },
        {
          "id": "3613701",
          "text": "Seid ihr im Komitee?",
          "translation": "Вы состоите в комитете?",
          "source": "Tatoeba #3613701 @Jan_Schreiber / #12428391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3613701",
          "cefr_level": "A1",
          "word_slugs": [
            "komitee-noun"
          ]
        },
        {
          "id": "1573037",
          "text": "Das Komitee besteht aus vier Mitgliedern.",
          "translation": "Комитет состоит из четырёх членов.",
          "source": "Tatoeba #1573037 @nemoli / #8000436 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1573037",
          "cefr_level": "A1",
          "word_slugs": [
            "komitee-noun"
          ]
        },
        {
          "id": "11549722",
          "text": "Wir werden dem Komitee unsere Idee präsentieren.",
          "translation": "Мы представим нашу идею комитету.",
          "source": "Tatoeba #11549722 @Grmpy / #11549747 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11549722",
          "cefr_level": "A1",
          "word_slugs": [
            "komitee-noun"
          ]
        }
