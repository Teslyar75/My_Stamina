    {
      "slug": "unterscheidet-verb",
      "lemma": "unterscheidet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9417,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of unterscheiden:",
          "third-person singular present",
          "inflection of unterscheiden:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13698793",
          "text": "Mein Plan unterscheidet sich von eurem.",
          "translation": "Мой план отличается от вашего.",
          "source": "Tatoeba #13698793 @mhr / #13698590 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13698793",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheidet-verb"
          ]
        },
        {
          "id": "402313",
          "text": "Mein Plan unterscheidet sich von deinem.",
          "translation": "Мой план отличается от твоего.",
          "source": "Tatoeba #402313 @xtofu80 / #2806907 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/402313",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheidet-verb"
          ]
        },
        {
          "id": "11773394",
          "text": "Äußerlich unterscheidet es sich nicht sehr.",
          "translation": "Внешне оно не сильно отличается.",
          "source": "Tatoeba #11773394 @mhr / #11773017 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11773394",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheidet-verb"
          ]
        },
        {
          "id": "1079141",
          "text": "Meine Meinung unterscheidet sich von deiner.",
          "translation": "Моё мнение отличается от твоего.",
          "source": "Tatoeba #1079141 @Esperantostern / #824051 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1079141",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheidet-verb"
          ]
        },
        {
          "id": "12903562",
          "text": "Worin unterscheidet sich Raub von Diebstahl?",
          "translation": "Чем грабёж отличается от кражи?",
          "source": "Tatoeba #12903562 @mhr / #12903397 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12903562",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheidet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
