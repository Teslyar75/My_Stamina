          ]
        },
        {
          "id": "13922874",
          "text": "Glaubst du, das ist von Dauer?",
          "translation": "Думаешь, это надолго?",
          "source": "Tatoeba #13922874 @IAlexI / #8101396 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13922874",
          "cefr_level": "A1",
          "word_slugs": [
            "dauer-noun"
          ]
        },
        {
          "id": "7886583",
          "text": "Nichts auf der Welt ist von Dauer.",
          "translation": "В мире нет ничего постоянного.",
          "source": "Tatoeba #7886583 @Pfirsichbaeumchen / #7870448 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7886583",
          "cefr_level": "A1",
          "word_slugs": [
            "dauer-noun"
          ]
        },
        {
          "id": "3070884",
          "text": "Toms Liebe zu Maria wird wohl nicht von langer Dauer sein.",
          "translation": "Любовь Тома к Мэри, вероятно, не будет долгой.",
          "source": "Tatoeba #3070884 @Pfirsichbaeumchen / #2763393 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3070884",
          "cefr_level": "A1",
          "word_slugs": [
            "dauer-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
