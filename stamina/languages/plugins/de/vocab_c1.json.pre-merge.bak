      "frequency_rank": 8234,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of gelingen",
          "singular imperative of gelangen",
          "first-person singular present of gelangen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2973637",
          "text": "Tom gelang die Flucht.",
          "translation": "Тому удалось сбежать.",
          "source": "Tatoeba #2973637 @Pfirsichbaeumchen / #2973427 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2973637",
          "cefr_level": "A1",
          "word_slugs": [
            "gelang-verb"
          ]
        },
        {
          "id": "2854873",
          "text": "Mir gelang es, einzutreten.",
          "translation": "Мне удалось войти.",
          "source": "Tatoeba #2854873 @alik_farber / #1772302 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2854873",
          "cefr_level": "A1",
          "word_slugs": [
            "gelang-verb"
          ]
        },
        {
          "id": "3850533",
          "text": "Es gelang mir hineinzukommen.",
          "translation": "Мне удалось войти.",
          "source": "Tatoeba #3850533 @Tickler / #1772302 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3850533",
          "cefr_level": "A1",
          "word_slugs": [
            "gelang-verb"
          ]
        },
        {
          "id": "2973638",
          "text": "Es gelang Tom zu fliehen.",
          "translation": "Тому удалось сбежать.",
          "source": "Tatoeba #2973638 @Pfirsichbaeumchen / #2973427 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2973638",
          "cefr_level": "A1",
          "word_slugs": [
            "gelang-verb"
          ]
        },
        {
          "id": "4890549",
          "text": "Es gelang, Tom zu retten.",
          "translation": "Тома удалось спасти.",
          "source": "Tatoeba #4890549 @Pfirsichbaeumchen / #8364989 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4890549",
          "cefr_level": "A1",
          "word_slugs": [
            "gelang-verb"
          ]
        }
      ],
