          ]
        },
        {
          "id": "4913345",
          "text": "Siehst du das Lamm auf der Weide?",
          "translation": "Видишь ягнёнка на пастбище?",
          "source": "Tatoeba #4913345 @Esperantostern / #6860406 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4913345",
          "cefr_level": "A1",
          "word_slugs": [
            "lamm-name"
          ]
        },
        {
          "id": "748676",
          "text": "Das Lamm wurde von dem Wolf gerissen.",
          "translation": "Ягнёнка убил волк.",
          "source": "Tatoeba #748676 @samueldora / #13030878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/748676",
          "cefr_level": "A1",
          "word_slugs": [
            "lamm-name"
          ]
        },
        {
          "id": "13031081",
          "text": "Das Lamm wurde von einem Wolf getötet.",
          "translation": "Ягнёнка убил волк.",
          "source": "Tatoeba #13031081 @mhr / #13030878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13031081",
          "cefr_level": "A1",
          "word_slugs": [
            "lamm-name"
          ]
        },
        {
          "id": "12163629",
          "text": "Ein Lamm ist ein Jungtier eines Schafs.",
          "translation": "Ягнёнок - детёныш овцы.",
          "source": "Tatoeba #12163629 @mhr / #10755952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12163629",
          "cefr_level": "A1",
          "word_slugs": [
            "lamm-name"
          ]
        }
