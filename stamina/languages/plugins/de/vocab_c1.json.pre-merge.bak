    {
      "slug": "paare-noun",
      "lemma": "Paare",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8118,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Paar"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3388271",
          "text": "Viele Paare streiten sich um Nichtigkeiten.",
          "translation": "Много пар ссорятся по пустякам.",
          "source": "Tatoeba #3388271 @Pfirsichbaeumchen / #6029812 @kukla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3388271",
          "cefr_level": "A1",
          "word_slugs": [
            "paare-noun"
          ]
        },
        {
          "id": "803759",
          "text": "Alle bildeten Paare und begannen zu tanzen.",
          "translation": "Все разбились по парам и начали танцевать.",
          "source": "Tatoeba #803759 @Espi / #413031 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/803759",
          "cefr_level": "A1",
          "word_slugs": [
            "paare-noun"
          ]
        },
        {
          "id": "10116823",
          "text": "Manche Paare wollen das Geschlecht des Kindes nicht im voraus wissen.",
          "translation": "Некоторые пары не хотят заранее знать пол ребёнка.",
          "source": "Tatoeba #10116823 @Pfirsichbaeumchen / #10116783 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10116823",
          "cefr_level": "A1",
          "word_slugs": [
            "paare-noun"
          ]
        },
        {
          "id": "10116822",
          "text": "Manche Paare bitten darum, ihnen das Geschlecht des Kindes nicht zu sagen.",
          "translation": "Некоторые пары просят не говорить им пол ребёнка.",
          "source": "Tatoeba #10116822 @Pfirsichbaeumchen / #10116784 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10116822",
          "cefr_level": "A1",
          "word_slugs": [
            "paare-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
