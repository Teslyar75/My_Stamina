        {
          "id": "2413461",
          "text": "Das war eine unbedachte Handlung.",
          "translation": "Это был необдуманный поступок.",
          "source": "Tatoeba #2413461 @al_ex_an_der / #2413458 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2413461",
          "cefr_level": "A1",
          "word_slugs": [
            "handlung-noun"
          ]
        },
        {
          "id": "14040648",
          "text": "Der Handlung zufolge stirbt der Held am Ende.",
          "translation": "По сюжету герой в конце умирает.",
          "source": "Tatoeba #14040648 @mhr / #14040583 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14040648",
          "cefr_level": "A1",
          "word_slugs": [
            "handlung-noun"
          ]
        },
        {
          "id": "14040650",
          "text": "Der Handlung zufolge stirbt der Protagonist am Ende.",
          "translation": "По сюжету герой в конце умирает.",
          "source": "Tatoeba #14040650 @mhr / #14040583 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14040650",
          "cefr_level": "A1",
          "word_slugs": [
            "handlung-noun"
          ]
        },
        {
          "id": "369784",
          "text": "Das ist eine kriminelle Handlung und du wirst sicherlich dafür bestraft werden!",
          "translation": "Это уголовное преступление, и ты несомненно будешь за это наказан!",
          "source": "Tatoeba #369784 @kriskelvin / #2932379 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/369784",
          "cefr_level": "A1",
          "word_slugs": [
            "handlung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
