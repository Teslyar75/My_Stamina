          "third-person singular present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13635405",
          "text": "Er belästigt mich mit Fragen.",
          "translation": "Он донимает меня вопросами.",
          "source": "Tatoeba #13635405 @mhr / #13635363 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635405",
          "cefr_level": "A1",
          "word_slugs": [
            "belästigt-verb"
          ]
        },
        {
          "id": "6639441",
          "text": "Nun, ihr habt einen Mann belästigt!",
          "translation": "Ну что вы пристали к человеку!",
          "source": "Tatoeba #6639441 @Esperantostern / #6639331 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6639441",
          "cefr_level": "A1",
          "word_slugs": [
            "belästigt-verb"
          ]
        },
        {
          "id": "3630214",
          "text": "Ich habe gesehen, wie Tom Miri belästigt.",
          "translation": "Я видел, как Том пристаёт к Мэри.",
          "source": "Tatoeba #3630214 @max2525 / #3630189 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3630214",
          "cefr_level": "A1",
          "word_slugs": [
            "belästigt-verb"
          ]
        },
        {
          "id": "1848728",
          "text": "Es tut mir leid, dass ich Sie belästigt habe!",
          "translation": "Прошу прощения, что побеспокоил Вас.",
          "source": "Tatoeba #1848728 @Pfirsichbaeumchen / #2056089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1848728",
          "cefr_level": "A1",
          "word_slugs": [
            "belästigt-verb"
          ]
        },
        {
          "id": "1848727",
          "text": "Es tut mir leid, dass ich dich belästigt habe!",
          "translation": "Прости, что побеспокоил тебя.",
          "source": "Tatoeba #1848727 @Pfirsichbaeumchen / #2056091 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1848727",
          "cefr_level": "A1",
          "word_slugs": [
            "belästigt-verb"
          ]
        }
      ],
