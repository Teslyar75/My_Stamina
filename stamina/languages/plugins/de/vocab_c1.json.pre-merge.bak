    {
      "slug": "zigarre-noun",
      "lemma": "Zigarre",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7757,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сигара"
        ],
        "en": [
          "cigar"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8259491",
          "text": "Er raucht eine Zigarre.",
          "translation": "Он курит сигару.",
          "source": "Tatoeba #8259491 @felix63 / #8612234 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8259491",
          "cefr_level": "A1",
          "word_slugs": [
            "zigarre-noun"
          ]
        },
        {
          "id": "3835882",
          "text": "Das ist eine kubanische Zigarre.",
          "translation": "Это кубинская сигара.",
          "source": "Tatoeba #3835882 @Pfirsichbaeumchen / #3835879 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3835882",
          "cefr_level": "A1",
          "word_slugs": [
            "zigarre-noun"
          ]
        },
        {
          "id": "12987392",
          "text": "Er hat immer eine Zigarre im Mund.",
          "translation": "У него всегда сигара во рту.",
          "source": "Tatoeba #12987392 @maaster / #12987417 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12987392",
          "cefr_level": "A1",
          "word_slugs": [
            "zigarre-noun"
          ]
        },
        {
          "id": "666489",
          "text": "Er rauchte nach dem Mittagessen eine Zigarre.",
          "translation": "После обеда он выкуривал сигару.",
          "source": "Tatoeba #666489 @Manfredo / #6555240 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/666489",
          "cefr_level": "A1",
          "word_slugs": [
            "zigarre-noun"
          ]
        },
        {
          "id": "13326536",
          "text": "Ich habe meine Zigarre noch nicht zu Ende geraucht.",
          "translation": "Я ещё не докурил сигару.",
          "source": "Tatoeba #13326536 @Waldelfe / #3993406 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13326536",
