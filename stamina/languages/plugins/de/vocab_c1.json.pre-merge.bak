    {
      "slug": "krach-noun",
      "lemma": "Krach",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5607,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "крах"
        ],
        "en": [
          "crash",
          "loud noise, ruckus",
          "trouble, quarrel, fight (angry disagreement, especially with someone one already has a close connection to)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9990269",
          "text": "Tom macht zu viel Krach.",
          "translation": "Том слишком шумит.",
          "source": "Tatoeba #9990269 @Pfirsichbaeumchen / #7559016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9990269",
          "cefr_level": "A1",
          "word_slugs": [
            "krach-noun"
          ]
        },
        {
          "id": "9265799",
          "text": "Unsere Nachbarn machen immer Krach.",
          "translation": "Наши соседи постоянно шумят.",
          "source": "Tatoeba #9265799 @Pfirsichbaeumchen / #10762019 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9265799",
          "cefr_level": "A1",
          "word_slugs": [
            "krach-noun"
          ]
        },
        {
          "id": "2771586",
          "text": "Ich kann keinen Krach machen. Das Baby schläft.",
          "translation": "Я не могу шуметь. Ребёнок спит.",
          "source": "Tatoeba #2771586 @Pfirsichbaeumchen / #2771593 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2771586",
          "cefr_level": "A1",
          "word_slugs": [
            "krach-noun"
          ]
        },
        {
          "id": "13054399",
          "text": "Versuch, keinen Krach zu machen, wenn du zurückkommst.",
          "translation": "Постарайся не шуметь, когда вернёшься.",
          "source": "Tatoeba #13054399 @mhr / #13054015 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13054399",
          "cefr_level": "A1",
          "word_slugs": [
            "krach-noun"
          ]
        },
        {
          "id": "3767536",
          "text": "Mach bitte nicht so viel Krach! Ich versuche zu arbeiten.",
          "translation": "Не шуми так, будь добр. Я пытаюсь поработать.",
          "source": "Tatoeba #3767536 @Pfirsichbaeumchen / #3768454 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3767536",
          "cefr_level": "A1",
          "word_slugs": [
            "krach-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
