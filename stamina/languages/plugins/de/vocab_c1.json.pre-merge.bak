      "slug": "substanz-noun",
      "lemma": "Substanz",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9093,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "substance, matter, material",
          "substance (concrete arguments or points being presented)",
          "stock (that which has already been built up or stockpiled)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4425736",
          "text": "Nagellack ist eine wasserfeste Substanz.",
          "translation": "Лак для ногтей - это водостойкая субстанция.",
          "source": "Tatoeba #4425736 @brauchinet / #4425761 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4425736",
          "cefr_level": "A1",
          "word_slugs": [
            "substanz-noun"
          ]
        },
        {
          "id": "4158732",
          "text": "Die Substanz kann auch Pflanzen vernichten.",
          "translation": "Вещество может также уничтожить растения.",
          "source": "Tatoeba #4158732 @Esperantostern / #4864598 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4158732",
          "cefr_level": "A1",
          "word_slugs": [
            "substanz-noun"
          ]
        },
        {
          "id": "3587047",
          "text": "Im Magen der Toten habe ich Spuren einer unbekannten Substanz gefunden.",
          "translation": "В желудке покойного я обнаружил следы неизвестного вещества.",
          "source": "Tatoeba #3587047 @al_ex_an_der / #3588987 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3587047",
          "cefr_level": "A1",
          "word_slugs": [
            "substanz-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
