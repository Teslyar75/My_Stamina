    {
      "slug": "konntet-verb",
      "lemma": "konntet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9807,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person plural preterite of können"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8802806",
          "text": "Konntet ihr Tom helfen?",
          "translation": "Вы смогли помочь Тому?",
          "source": "Tatoeba #8802806 @Pfirsichbaeumchen / #6360866 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8802806",
          "cefr_level": "A1",
          "word_slugs": [
            "konntet-verb"
          ]
        },
        {
          "id": "12905965",
          "text": "Ich freue mich, daß ihr kommen konntet.",
          "translation": "Я рада, что вы смогли прийти.",
          "source": "Tatoeba #12905965 @Waldelfe / #8586556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12905965",
          "cefr_level": "A1",
          "word_slugs": [
            "konntet-verb"
          ]
        },
        {
          "id": "13541369",
          "text": "Konntet ihr Tom überreden, euch zu helfen?",
          "translation": "Вы смогли уговорить Тома помочь вам?",
          "source": "Tatoeba #13541369 @Waldelfe / #9143936 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13541369",
          "cefr_level": "A1",
          "word_slugs": [
            "konntet-verb"
          ]
        },
        {
          "id": "13098564",
          "text": "Wie konntet ihr es noch einmal dazu kommen lassen?",
          "translation": "Как вы могли позволить этому снова случиться?",
          "source": "Tatoeba #13098564 @Waldelfe / #13099914 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13098564",
          "cefr_level": "A1",
          "word_slugs": [
            "konntet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
