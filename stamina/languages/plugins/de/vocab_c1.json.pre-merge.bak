          ]
        },
        {
          "id": "376093",
          "text": "Tante Wang, ich bin's.",
          "translation": "Тётя Ванг, это я.",
          "source": "Tatoeba #376093 @MUIRIEL / #468109 @tensin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/376093",
