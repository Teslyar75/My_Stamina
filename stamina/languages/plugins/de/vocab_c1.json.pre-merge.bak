          ]
        },
        {
          "id": "3070216",
          "text": "Wie lautet Toms ganzer Name?",
          "translation": "Какое у Тома полное имя?",
          "source": "Tatoeba #3070216 @Pfirsichbaeumchen / #3523526 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3070216",
          "cefr_level": "A1",
          "word_slugs": [
            "ganzer-adj"
          ]
        },
        {
          "id": "10496868",
          "text": "Ich liebe ihn von ganzer Seele.",
