    {
      "slug": "ungeheuer-adj",
      "lemma": "ungeheuer",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5451,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "enormous",
          "monstrous"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3603985",
          "text": "Sie liebt euch ungeheuer.",
          "translation": "Она вас ужасно любит.",
          "source": "Tatoeba #3603985 @Zaghawa / #3604457 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3603985",
          "cefr_level": "A1",
          "word_slugs": [
            "ungeheuer-adj"
          ]
        },
        {
          "id": "3063453",
          "text": "Sitzt eine Frau am Steuer, wird die Fahrt oft ungeheuer.",
          "translation": "Женщина за рулём – жди беды.",
          "source": "Tatoeba #3063453 @Esperantostern / #10462250 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3063453",
          "cefr_level": "A1",
          "word_slugs": [
            "ungeheuer-adj"
          ]
        },
        {
          "id": "3777776",
          "text": "Ich spüre hier eine ungeheuer starke Energie. Spürst du sie auch?",
          "translation": "Я чувствую здесь мощную энергию. Ты чувствуешь?",
          "source": "Tatoeba #3777776 @al_ex_an_der / #3804758 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3777776",
          "cefr_level": "A1",
          "word_slugs": [
            "ungeheuer-adj"
          ]
        }
      ],
      "tags": [
