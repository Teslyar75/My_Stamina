      "gender": null,
      "examples": [
        {
          "id": "1521420",
          "text": "Der Arzt hat seinen Tod festgestellt.",
          "translation": "Врач констатировал его смерть.",
          "source": "Tatoeba #1521420 @Esperantostern / #1521437 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1521420",
          "cefr_level": "A1",
