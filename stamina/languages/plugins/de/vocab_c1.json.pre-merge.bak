      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "стадион"
        ],
        "en": [
          "stadium (venue for sporting events)",
          "stadion (Ancient Greek unit of length)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "12159876",
          "text": "Sie ist im Stadion.",
          "translation": "Она на стадионе.",
          "source": "Tatoeba #12159876 @mhr / #12308029 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12159876",
          "cefr_level": "A1",
          "word_slugs": [
            "stadion-noun"
          ]
        },
        {
          "id": "13769323",
          "text": "Das Stadion ist leer.",
          "translation": "На стадионе пусто.",
          "source": "Tatoeba #13769323 @felix63 / #13769468 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13769323",
          "cefr_level": "A1",
          "word_slugs": [
            "stadion-noun"
          ]
        },
        {
          "id": "6595409",
          "text": "Wir gehen ins Stadion.",
          "translation": "Мы идём на стадион.",
          "source": "Tatoeba #6595409 @Pfirsichbaeumchen / #6592320 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6595409",
          "cefr_level": "A1",
          "word_slugs": [
            "stadion-noun"
          ]
        },
        {
          "id": "878252",
          "text": "Ich bin im Stadion gewesen.",
          "translation": "Я был на стадионе.",
          "source": "Tatoeba #878252 @Esperantostern / #6736898 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/878252",
          "cefr_level": "A1",
          "word_slugs": [
            "stadion-noun"
          ]
        },
        {
          "id": "6197207",
          "text": "Bist du ins Stadion gegangen?",
          "translation": "Ты ходил на стадион?",
          "source": "Tatoeba #6197207 @carlosalberto / #7873244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6197207",
          "cefr_level": "A1",
          "word_slugs": [
            "stadion-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
