    {
      "slug": "genügen-verb",
      "lemma": "genügen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8259,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to suffice, to be enough"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12182365",
          "text": "Gut, das wird genügen.",
          "translation": "Всё, достаточно.",
          "source": "Tatoeba #12182365 @mhr / #4378147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12182365",
          "cefr_level": "A1",
          "word_slugs": [
            "genügen-verb"
          ]
        },
        {
          "id": "4963597",
          "text": "Zwei Gramm Pfeffer genügen.",
          "translation": "Два грамма перца достаточно.",
          "source": "Tatoeba #4963597 @Manfredo / #4963605 @russica (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4963597",
          "cefr_level": "A1",
          "word_slugs": [
            "genügen-verb"
          ]
        },
        {
          "id": "8381732",
          "text": "Es würde genügen, die Gehälter anzuheben.",
          "translation": "Достаточно было бы поднять зарплаты.",
          "source": "Tatoeba #8381732 @brauchinet / #14102220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8381732",
          "cefr_level": "A1",
          "word_slugs": [
            "genügen-verb"
          ]
        },
        {
          "id": "13954440",
          "text": "„Wie viele Pizzen sollen wir bestellen?“ – „Ich glaube, vier genügen.“",
          "translation": "«Сколько пицц заказывать?» — «Я думаю, четырёх хватит».",
          "source": "Tatoeba #13954440 @mhr / #13954429 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13954440",
          "cefr_level": "A1",
          "word_slugs": [
            "genügen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
