      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7236,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "bathtub"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8616214",
          "text": "Ich putze die Badewanne.",
          "translation": "Я мою ванну.",
          "source": "Tatoeba #8616214 @felix63 / #10769164 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8616214",
