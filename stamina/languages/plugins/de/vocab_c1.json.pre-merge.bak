      "gender": null,
      "examples": [
        {
          "id": "13486729",
          "text": "Die Ressourcen der Welt sind begrenzt.",
          "translation": "Мировые ресурсы ограничены.",
          "source": "Tatoeba #13486729 @mhr / #13486586 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13486729",
          "cefr_level": "A1",
          "word_slugs": [
            "ressourcen-noun"
          ]
        },
        {
          "id": "13747141",
          "text": "Die Ressourcen der Erde sind begrenzt.",
          "translation": "Ресурсы Земли ограничены.",
          "source": "Tatoeba #13747141 @mhr / #10166571 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13747141",
          "cefr_level": "A1",
          "word_slugs": [
            "ressourcen-noun"
          ]
        },
        {
          "id": "13828469",
          "text": "Japan ist arm an natürlichen Ressourcen.",
