    {
      "slug": "sklaverei-noun",
      "lemma": "Sklaverei",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9735,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "рабство"
        ],
        "en": [
          "slavery"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "11653066",
          "text": "Warum gibt es Sklaverei?",
          "translation": "Почему существует рабство?",
          "source": "Tatoeba #11653066 @Adelpa / #11657814 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11653066",
          "cefr_level": "A1",
          "word_slugs": [
            "sklaverei-noun"
          ]
        },
        {
          "id": "13860925",
          "text": "Worin unterscheidet sich Dienst von Sklaverei?",
          "translation": "Чем служение отличается от рабства?",
          "source": "Tatoeba #13860925 @mhr / #13860524 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13860925",
          "cefr_level": "A1",
          "word_slugs": [
            "sklaverei-noun"
          ]
        },
        {
          "id": "11115098",
          "text": "Die Sklaverei ist ein Verbrechen gegen die Menschlichkeit.",
          "translation": "Порабощение — это преступление против человечества.",
          "source": "Tatoeba #11115098 @Pfirsichbaeumchen / #3760252 @Robertpaulson (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11115098",
          "cefr_level": "A1",
          "word_slugs": [
            "sklaverei-noun"
          ]
        },
        {
          "id": "849551",
          "text": "Die Vereinigten Staaten von Amerika haben die Sklaverei abgeschafft.",
          "translation": "Соединённые Штаты Америки отменили рабство.",
          "source": "Tatoeba #849551 @MUIRIEL / #892605 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/849551",
          "cefr_level": "A1",
          "word_slugs": [
            "sklaverei-noun"
          ]
        },
        {
          "id": "2492160",
          "text": "Die Sklaverei wurde in den Vereinigten Staaten erst 1865 abgeschafft.",
          "translation": "Рабство в Соединённых Штатах было отменено только в 1865 году.",
          "source": "Tatoeba #2492160 @Pfirsichbaeumchen / #8565816 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2492160",
          "cefr_level": "A1",
          "word_slugs": [
            "sklaverei-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Sklaverei",
        "nominative_pl": ""
      }
