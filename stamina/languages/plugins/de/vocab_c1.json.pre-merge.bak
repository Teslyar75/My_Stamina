    {
      "slug": "bauten-verb",
      "lemma": "bauten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9060,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bauen:",
          "first/third-person plural preterite",
          "inflection of bauen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "481752",
          "text": "Sie bauten eine Brücke.",
          "translation": "Они построили мост.",
          "source": "Tatoeba #481752 @Espi / #660692 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/481752",
          "cefr_level": "A1",
          "word_slugs": [
            "bauten-verb"
          ]
        },
        {
          "id": "8610622",
          "text": "Sie bauten zusammen einen Schneemann.",
          "translation": "Они вместе слепили снеговика.",
          "source": "Tatoeba #8610622 @Pfirsichbaeumchen / #3884109 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8610622",
          "cefr_level": "A1",
          "word_slugs": [
            "bauten-verb"
          ]
        },
        {
          "id": "6785815",
          "text": "Tom und Maria bauten einen Schneemann.",
          "translation": "Том и Мэри слепили снеговика.",
          "source": "Tatoeba #6785815 @Pfirsichbaeumchen / #3884113 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6785815",
          "cefr_level": "A1",
          "word_slugs": [
            "bauten-verb"
          ]
        },
        {
          "id": "3555530",
          "text": "Die zwei Vögel bauten ein Nest ohne Baugenehmigung.",
          "translation": "Две птицы свивали гнездо без разрешения на строительство.",
          "source": "Tatoeba #3555530 @Esperantostern / #3556626 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3555530",
          "cefr_level": "A1",
          "word_slugs": [
            "bauten-verb"
          ]
        },
        {
          "id": "688355",
          "text": "Die Dorfbewohner bauten eine hölzerne Brücke über den Fluss.",
          "translation": "Жители деревни построили деревянный мост через реку.",
          "source": "Tatoeba #688355 @Manfredo / #2357096 @Wezzel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/688355",
          "cefr_level": "A1",
          "word_slugs": [
            "bauten-verb"
          ]
        }
      ],
