    {
      "slug": "fortsetzen-verb",
      "lemma": "fortsetzen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8434,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "продолжать / продолжить"
        ],
        "en": [
          "to continue with something"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2344250",
          "text": "Im Beisein dieser Leute können wir unser Gespräch nicht fortsetzen.",
          "translation": "Мы не можем продолжать разговор в присутствии этих людей.",
          "source": "Tatoeba #2344250 @al_ex_an_der / #2343620 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2344250",
          "cefr_level": "A1",
          "word_slugs": [
            "fortsetzen-verb"
          ]
        },
        {
          "id": "2443796",
          "text": "Ich werde die Ausübung meines Mandats bis zum letzten Tag fortsetzen.",
          "translation": "Я буду продолжать выполнять свой мандат до последнего дня.",
