    {
      "slug": "erregen-verb",
      "lemma": "erregen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8425,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "возбуждать"
        ],
        "en": [
          "to thrill; arouse; excite; titillate",
          "to cause; elicit; evoke; bring forth; stimulate into action"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12738260",
          "text": "Versuch nicht, mein Mitleid zu erregen!",
          "translation": "Не пытайся меня разжалобить.",
          "source": "Tatoeba #12738260 @Waldelfe / #12737026 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12738260",
          "cefr_level": "A1",
          "word_slugs": [
            "erregen-verb"
          ]
        },
        {
          "id": "12738261",
          "text": "Versucht nicht, mein Mitleid zu erregen!",
          "translation": "Не пытайтесь меня разжалобить.",
          "source": "Tatoeba #12738261 @Waldelfe / #12737027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12738261",
          "cefr_level": "A1",
          "word_slugs": [
            "erregen-verb"
          ]
        },
        {
          "id": "12738262",
          "text": "Versuchen Sie nicht, mein Mitleid zu erregen!",
          "translation": "Не пытайтесь меня разжалобить.",
          "source": "Tatoeba #12738262 @Waldelfe / #12737027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12738262",
          "cefr_level": "A1",
          "word_slugs": [
            "erregen-verb"
          ]
        },
        {
          "id": "8005921",
          "text": "Mit seinem neuen Haarschnitt wird Tom Aufsehen erregen.",
          "translation": "Новая стрижка Тома произведёт фурор.",
          "source": "Tatoeba #8005921 @raggione / #8016543 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8005921",
          "cefr_level": "A1",
          "word_slugs": [
            "erregen-verb"
          ]
        },
        {
          "id": "12416304",
          "text": "Es war offensichtlich, daß er versuchte, ihre Aufmerksamkeit zu erregen.",
          "translation": "Было очевидно, что он пытается завладеть её вниманием.",
          "source": "Tatoeba #12416304 @Waldelfe / #4090431 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12416304",
          "cefr_level": "A1",
          "word_slugs": [
            "erregen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
