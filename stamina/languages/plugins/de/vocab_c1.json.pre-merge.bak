          "to call back, to ring back"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1355449",
          "text": "Soll ich Ken zurückrufen?",
          "translation": "Мне перезвонить Кену?",
          "source": "Tatoeba #1355449 @Pfirsichbaeumchen / #13286212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1355449",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückrufen-verb"
          ]
        },
        {
          "id": "1855885",
          "text": "Muss ich Ken zurückrufen?",
          "translation": "Мне перезвонить Кену?",
          "source": "Tatoeba #1855885 @Zaghawa / #13286212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1855885",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückrufen-verb"
          ]
        },
        {
          "id": "849082",
          "text": "Ich werde um 4 Uhr zurückrufen.",
          "translation": "Я перезвоню в четыре часа.",
          "source": "Tatoeba #849082 @Esperantostern / #576536 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/849082",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückrufen-verb"
          ]
        },
        {
          "id": "366364",
          "text": "Ich werde ihn später zurückrufen.",
          "translation": "Я перезвоню ему позднее.",
          "source": "Tatoeba #366364 @Wolf / #3052745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/366364",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückrufen-verb"
          ]
        },
        {
          "id": "579314",
          "text": "Ich werde dich zurückrufen müssen.",
          "translation": "Я должен буду тебе перезвонить.",
          "source": "Tatoeba #579314 @jakov / #598976 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/579314",
          "cefr_level": "A1",
          "word_slugs": [
            "zurückrufen-verb"
          ]
        }
      ],
