          ]
        },
        {
          "id": "1081711",
          "text": "In jedem Theater gibt es eine Garderobe.",
          "translation": "В каждом театре есть гардероб.",
          "source": "Tatoeba #1081711 @Esperantostern / #3089896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1081711",
          "cefr_level": "A1",
          "word_slugs": [
            "garderobe-noun"
          ]
        },
        {
          "id": "1081705",
          "text": "Ich habe meine Überkleidung in der Garderobe abgegeben.",
          "translation": "Я сдал верхнюю одежду в гардероб.",
          "source": "Tatoeba #1081705 @Esperantostern / #6960541 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1081705",
          "cefr_level": "A1",
          "word_slugs": [
            "garderobe-noun"
          ]
        }
      ],
