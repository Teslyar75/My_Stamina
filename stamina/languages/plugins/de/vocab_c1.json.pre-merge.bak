    {
      "slug": "zeitplan-noun",
      "lemma": "Zeitplan",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6986,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "timetable, schedule"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6742198",
          "text": "Hat sich unser Zeitplan geändert?",
          "translation": "У нас изменилось расписание?",
          "source": "Tatoeba #6742198 @Pfirsichbaeumchen / #6032662 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6742198",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitplan-noun"
          ]
        },
        {
          "id": "1699450",
          "text": "Der neue Zeitplan ist ein Horror!",
          "translation": "Новое расписание - это кошмар!",
          "source": "Tatoeba #1699450 @al_ex_an_der / #1716194 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1699450",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitplan-noun"
          ]
        },
        {
          "id": "13888536",
          "text": "Ich werde dir den Zeitplan zeigen.",
          "translation": "Я покажу тебе расписание.",
          "source": "Tatoeba #13888536 @mhr / #13888453 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13888536",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitplan-noun"
          ]
        },
        {
          "id": "13888527",
          "text": "Ich werde euch den Zeitplan zeigen.",
          "translation": "Я покажу вам расписание.",
          "source": "Tatoeba #13888527 @mhr / #13888454 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13888527",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitplan-noun"
          ]
        },
        {
          "id": "3598341",
          "text": "Wir sind 3 Stunden hinter dem Zeitplan.",
          "translation": "Мы на три часа отстаём от графика.",
          "source": "Tatoeba #3598341 @Esperantostern / #3607893 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3598341",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitplan-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
