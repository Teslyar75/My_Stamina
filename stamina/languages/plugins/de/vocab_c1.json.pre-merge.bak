    {
      "slug": "zähnen-noun",
      "lemma": "Zähnen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6956,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Zahn"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2711815",
          "text": "Tom knirscht im Schlaf mit den Zähnen.",
          "translation": "Том скрежещет зубами во сне.",
          "source": "Tatoeba #2711815 @Pfirsichbaeumchen / #2711636 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2711815",
          "cefr_level": "A1",
          "word_slugs": [
            "zähnen-noun"
          ]
        },
        {
          "id": "4797501",
          "text": "Leonor hat die Flasche mit den Zähnen geöffnet.",
          "translation": "Леонор открыла бутылку зубами.",
          "source": "Tatoeba #4797501 @tarsier / #14108719 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4797501",
          "cefr_level": "A1",
          "word_slugs": [
            "zähnen-noun"
          ]
        },
        {
          "id": "9975684",
          "text": "Diese Männer waren bis zu den Zähnen bewaffnet.",
          "translation": "Эти мужчины были вооружены до зубов.",
          "source": "Tatoeba #9975684 @giefingl / #5298790 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9975684",
          "cefr_level": "A1",
          "word_slugs": [
            "zähnen-noun"
          ]
        },
        {
          "id": "913639",
          "text": "Das ist keine Kunst. Das ist eine Vagina mit Zähnen.",
          "translation": "Это не искусство, это зубастое влагалище.",
          "source": "Tatoeba #913639 @Sudajaengi / #2285865 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/913639",
          "cefr_level": "A1",
          "word_slugs": [
            "zähnen-noun"
          ]
        }
