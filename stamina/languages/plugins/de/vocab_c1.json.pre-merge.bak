          ]
        },
        {
          "id": "9814683",
          "text": "Mein Bildschirm hat einen Sprung.",
          "translation": "У меня экран треснул.",
          "source": "Tatoeba #9814683 @GaryGaryGary / #8635100 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9814683",
          "cefr_level": "A1",
          "word_slugs": [
            "bildschirm-noun"
          ]
        },
        {
          "id": "14049156",
          "text": "Wisch den Bildschirm jeden Tag ab!",
          "translation": "Протирай экран каждый день.",
          "source": "Tatoeba #14049156 @mhr / #14049039 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14049156",
          "cefr_level": "A1",
          "word_slugs": [
            "bildschirm-noun"
          ]
        },
        {
          "id": "9814694",
          "text": "Dieser neue Bildschirm ist viel heller.",
          "translation": "Этот новый экран гораздо ярче.",
          "source": "Tatoeba #9814694 @GaryGaryGary / #8163603 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9814694",
          "cefr_level": "A1",
          "word_slugs": [
            "bildschirm-noun"
          ]
        },
        {
          "id": "13848898",
          "text": "Schalten Sie den Bildschirm aus und ein!",
          "translation": "Выключите и включите экран.",
          "source": "Tatoeba #13848898 @mhr / #13848890 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13848898",
          "cefr_level": "A1",
          "word_slugs": [
            "bildschirm-noun"
          ]
        }
