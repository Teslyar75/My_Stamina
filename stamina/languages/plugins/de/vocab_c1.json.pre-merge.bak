    {
      "slug": "erfahrungen-noun",
      "lemma": "Erfahrungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5156,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Erfahrung"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "949245",
          "text": "Sie fragten ihn nach früheren Erfahrungen.",
          "translation": "Они спросили его о предыдущем опыте.",
          "source": "Tatoeba #949245 @Sudajaengi / #8611517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/949245",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahrungen-noun"
          ]
        },
        {
          "id": "1634018",
          "text": "Sie hat nie schlechte Erfahrungen gemacht.",
          "translation": "У неё никогда не было плохого опыта.",
          "source": "Tatoeba #1634018 @al_ex_an_der / #2903811 @Werther (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1634018",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahrungen-noun"
          ]
        },
        {
          "id": "1955935",
          "text": "Sprichst du ausgehend von eigenen Erfahrungen?",
          "translation": "Ты говоришь на основании своего собственного опыта?",
          "source": "Tatoeba #1955935 @al_ex_an_der / #1955882 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1955935",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahrungen-noun"
          ]
        },
        {
          "id": "2510652",
          "text": "Sagst du das aus eigener Erfahrungen heraus?",
          "translation": "Ты говоришь это, исходя из своего опыта?",
          "source": "Tatoeba #2510652 @al_ex_an_der / #1911762 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2510652",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahrungen-noun"
          ]
        },
        {
          "id": "2510650",
          "text": "Sagst du das vor dem Hintergrund eigener Erfahrungen?",
          "translation": "Ты говоришь это, исходя из своего опыта?",
          "source": "Tatoeba #2510650 @al_ex_an_der / #1911762 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2510650",
          "cefr_level": "A1",
          "word_slugs": [
            "erfahrungen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
