    {
      "slug": "mitteln-noun",
      "lemma": "Mitteln",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8496,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Mittel"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5843366",
          "text": "Krieg ist die Fortsetzung der Politik mit anderen Mitteln.",
          "translation": "Война есть продолжение политики другими средствами.",
          "source": "Tatoeba #5843366 @Pfirsichbaeumchen / #5842634 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843366",
          "cefr_level": "A1",
          "word_slugs": [
            "mitteln-noun"
          ]
        },
        {
          "id": "2906991",
          "text": "Friede ist die Fortsetzung des Krieges mit anderen Mitteln.",
          "translation": "Мир - продолжение войны другими средствами.",
          "source": "Tatoeba #2906991 @Esperantostern / #2907392 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2906991",
          "cefr_level": "A1",
          "word_slugs": [
            "mitteln-noun"
          ]
        },
        {
          "id": "3527039",
          "text": "Der neue Krieg gegen den Terrorismus wird mit allen verfügbaren Mitteln geführt.",
          "translation": "Новая война против терроризма будет вестись всеми имеющимися средствами.",
          "source": "Tatoeba #3527039 @al_ex_an_der / #3527218 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3527039",
          "cefr_level": "A1",
          "word_slugs": [
            "mitteln-noun"
          ]
        }
