    {
      "slug": "bohnen-noun",
      "lemma": "Bohnen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5669,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Bohne (“bean”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3561457",
          "text": "Ich mag Bohnen.",
          "translation": "Я люблю бобы.",
          "source": "Tatoeba #3561457 @al_ex_an_der / #3451837 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3561457",
          "cefr_level": "A1",
          "word_slugs": [
            "bohnen-noun"
          ]
        },
        {
          "id": "13886940",
          "text": "Wir werden Bohnen essen.",
          "translation": "Мы поедим фасоли.",
          "source": "Tatoeba #13886940 @mhr / #13886522 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13886940",
          "cefr_level": "A1",
          "word_slugs": [
            "bohnen-noun"
          ]
        },
        {
          "id": "13581744",
          "text": "Wie viel kostet ein Kilo Bohnen?",
          "translation": "Сколько стоит килограмм фасоли?",
          "source": "Tatoeba #13581744 @mhr / #13581557 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13581744",
          "cefr_level": "A1",
          "word_slugs": [
            "bohnen-noun"
          ]
        },
        {
          "id": "13581741",
          "text": "Wie viel kostet ein Kilogramm Bohnen?",
          "translation": "Сколько стоит килограмм фасоли?",
          "source": "Tatoeba #13581741 @mhr / #13581557 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13581741",
          "cefr_level": "A1",
          "word_slugs": [
            "bohnen-noun"
          ]
        },
        {
          "id": "3648692",
          "text": "Bringen Sie mir einen Lammbraten mit grünen Bohnen, Kartoffeln und Soße!",
          "translation": "Принесите мне жареную баранину с зелёной фасолью, картофелем и соусом!",
          "source": "Tatoeba #3648692 @al_ex_an_der / #3648720 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3648692",
          "cefr_level": "A1",
          "word_slugs": [
            "bohnen-noun"
          ]
        }
      ],
