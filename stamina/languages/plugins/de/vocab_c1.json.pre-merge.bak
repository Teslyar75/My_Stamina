    {
      "slug": "kräften-noun",
      "lemma": "Kräften",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6889,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Kraft"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10060235",
          "text": "Sie schrie aus allen Kräften.",
          "translation": "Она кричала изо всех сил.",
          "source": "Tatoeba #10060235 @sakslane / #10059890 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10060235",
          "cefr_level": "A1",
          "word_slugs": [
            "kräften-noun"
          ]
        },
        {
          "id": "7533592",
          "text": "Ich muss wieder zu Kräften kommen.",
          "translation": "Мне нужно восстановить свои силы.",
          "source": "Tatoeba #7533592 @Pfirsichbaeumchen / #7533933 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7533592",
          "cefr_level": "A1",
          "word_slugs": [
            "kräften-noun"
          ]
        },
        {
          "id": "14099382",
          "text": "Iss! Du musst wieder zu Kräften kommen.",
          "translation": "Ешь! Тебе надо силы восстанавливать.",
          "source": "Tatoeba #14099382 @mhr / #14099377 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14099382",
          "cefr_level": "A1",
          "word_slugs": [
            "kräften-noun"
          ]
        },
        {
          "id": "12903567",
          "text": "Mit vereinten Kräften gelang es uns, ihn nach Hause zu schleppen.",
          "translation": "Общими усилиями нам удалось дотащить его до дома.",
          "source": "Tatoeba #12903567 @mhr / #12903549 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12903567",
          "cefr_level": "A1",
          "word_slugs": [
            "kräften-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
