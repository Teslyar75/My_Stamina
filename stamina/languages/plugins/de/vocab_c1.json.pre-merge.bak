          ]
        },
        {
          "id": "10060240",
          "text": "Der Zutritt ist immer noch verboten.",
          "translation": "Вход всё ещё запрещён.",
          "source": "Tatoeba #10060240 @sakslane / #10059213 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10060240",
          "cefr_level": "A1",
          "word_slugs": [
            "zutritt-noun"
          ]
        },
        {
          "id": "10060243",
          "text": "Der Zutritt ist nach wie vor verboten.",
          "translation": "Вход по-прежнему запрещён.",
