    {
      "slug": "derzeit-adv",
      "lemma": "derzeit",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6122,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сегодня",
          "сейчас"
        ],
        "en": [
          "currently, at present (implying that this state is likely temporary)",
          "back then, at the time"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6569209",
          "text": "Tom ist derzeit Student.",
          "translation": "Том сейчас студент.",
          "source": "Tatoeba #6569209 @Pfirsichbaeumchen / #6566685 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6569209",
          "cefr_level": "A1",
          "word_slugs": [
            "derzeit-adv"
          ]
        },
        {
          "id": "5408902",
          "text": "Derzeit ist sie Studentin.",
          "translation": "На данный момент она студентка.",
          "source": "Tatoeba #5408902 @nina99nv / #5408905 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408902",
          "cefr_level": "A1",
          "word_slugs": [
            "derzeit-adv"
          ]
        },
        {
          "id": "2244767",
          "text": "Ich lebe derzeit in Moskau.",
          "translation": "В настоящее время я живу в Москве.",
          "source": "Tatoeba #2244767 @Pfirsichbaeumchen / #2244197 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2244767",
          "cefr_level": "A1",
          "word_slugs": [
            "derzeit-adv"
          ]
        },
        {
          "id": "1940760",
          "text": "Tom ist derzeit ohne Arbeit.",
          "translation": "Том в настоящее время без работы.",
          "source": "Tatoeba #1940760 @Pfirsichbaeumchen / #5408782 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1940760",
          "cefr_level": "A1",
          "word_slugs": [
            "derzeit-adv"
          ]
        },
        {
          "id": "9303971",
          "text": "Derzeit bin ich auf Jobsuche.",
          "translation": "Я сейчас нахожусь в поисках работы.",
          "source": "Tatoeba #9303971 @Adelpa / #10137489 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9303971",
          "cefr_level": "A1",
          "word_slugs": [
            "derzeit-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
