      "gender": null,
      "examples": [
        {
          "id": "403815",
          "text": "Er ist das jüngste Kind.",
          "translation": "Он самый младший ребёнок.",
          "source": "Tatoeba #403815 @xtofu80 / #13542312 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/403815",
