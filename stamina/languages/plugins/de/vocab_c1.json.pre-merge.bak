          ]
        },
        {
          "id": "12905423",
          "text": "Mit der Zeit wurde es zur Gewohnheit.",
          "translation": "Со временем это вошло в привычку.",
          "source": "Tatoeba #12905423 @mhr / #12905405 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12905423",
          "cefr_level": "A1",
          "word_slugs": [
