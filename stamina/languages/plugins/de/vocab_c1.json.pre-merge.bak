    {
      "slug": "logik-noun",
      "lemma": "Logik",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6738,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "логика"
        ],
        "en": [
          "logic"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "11180028",
          "text": "Sie haben eine seltsame Logik.",
          "translation": "Странная у вас какая-то логика.",
          "source": "Tatoeba #11180028 @Pfirsichbaeumchen / #11179815 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11180028",
          "cefr_level": "A1",
          "word_slugs": [
            "logik-noun"
          ]
        },
        {
          "id": "1206730",
          "text": "Wir verstanden ihre Logik nicht.",
          "translation": "Мы не понимали её логики.",
          "source": "Tatoeba #1206730 @MUIRIEL / #5102478 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1206730",
          "cefr_level": "A1",
          "word_slugs": [
            "logik-noun"
          ]
        },
        {
          "id": "1206729",
          "text": "Wir verstanden seine Logik nicht.",
          "translation": "Мы не понимали его логики.",
          "source": "Tatoeba #1206729 @MUIRIEL / #5102477 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1206729",
          "cefr_level": "A1",
          "word_slugs": [
            "logik-noun"
          ]
        },
        {
          "id": "2213896",
          "text": "Die Logik wird stark überbewertet.",
          "translation": "Логику сильно переоценивают.",
          "source": "Tatoeba #2213896 @al_ex_an_der / #2213898 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2213896",
          "cefr_level": "A1",
          "word_slugs": [
            "logik-noun"
          ]
        },
        {
          "id": "1767322",
          "text": "Für Logik ist hier kein Platz.",
          "translation": "Здесь нет места логике.",
          "source": "Tatoeba #1767322 @Pfirsichbaeumchen / #2463981 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1767322",
          "cefr_level": "A1",
          "word_slugs": [
            "logik-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Logik",
        "nominative_pl": ""
      }
    },
