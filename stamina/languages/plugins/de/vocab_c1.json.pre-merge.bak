    {
      "slug": "hotelzimmer-noun",
      "lemma": "Hotelzimmer",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7565,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "hotel room"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2279995",
          "text": "Die Hotelzimmer sind unglaublich gut konzipiert.",
          "translation": "Номера невероятно хорошо спроектированы.",
          "source": "Tatoeba #2279995 @al_ex_an_der / #2279991 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2279995",
          "cefr_level": "A1",
          "word_slugs": [
            "hotelzimmer-noun"
          ]
        },
        {
          "id": "8298480",
          "text": "In diesem Hotelzimmer gibt es eine Klimaanlage.",
          "translation": "В этом гостиничном номере есть кондиционер.",
          "source": "Tatoeba #8298480 @Pfirsichbaeumchen / #6854022 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8298480",
          "cefr_level": "A1",
          "word_slugs": [
            "hotelzimmer-noun"
          ]
        },
        {
          "id": "743944",
          "text": "Kann ich mein Hotelzimmer um eine Nacht verlängern?",
          "translation": "Могу ли я продлить моё пребывание в гостиничной комнате на ночь?",
          "source": "Tatoeba #743944 @xtofu80 / #1049304 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/743944",
          "cefr_level": "A1",
          "word_slugs": [
            "hotelzimmer-noun"
          ]
        },
        {
          "id": "1515103",
          "text": "Ich will keinen Wucherpreis für ein Hotelzimmer bezahlen.",
          "translation": "Я не желаю платить бешеные деньги за номер в отеле.",
          "source": "Tatoeba #1515103 @Pfirsichbaeumchen / #3576659 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1515103",
          "cefr_level": "A1",
          "word_slugs": [
            "hotelzimmer-noun"
          ]
        },
        {
          "id": "8633686",
          "text": "Von unserem Hotelzimmer aus, können wir das Meer sehen.",
          "translation": "Из окон нашего гостиничного номера видно море.",
          "source": "Tatoeba #8633686 @Melang / #8648283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8633686",
          "cefr_level": "A1",
          "word_slugs": [
            "hotelzimmer-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
