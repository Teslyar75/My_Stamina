    {
      "slug": "empfehlung-noun",
      "lemma": "Empfehlung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7836,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "рекомендация"
        ],
        "en": [
          "recommendation"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2234651",
          "text": "Was ist deine Empfehlung?",
          "translation": "Что ты посоветуешь?",
          "source": "Tatoeba #2234651 @Pfirsichbaeumchen / #4211631 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2234651",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlung-noun"
          ]
        },
        {
          "id": "2313474",
          "text": "Ich bin deiner Empfehlung gefolgt.",
          "translation": "Я последовал твоим рекомендациям.",
          "source": "Tatoeba #2313474 @al_ex_an_der / #2313472 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2313474",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlung-noun"
          ]
        },
        {
          "id": "1760245",
          "text": "Das war eine Empfehlung, kein Befehl.",
          "translation": "Это была рекомендация, а не приказ.",
          "source": "Tatoeba #1760245 @al_ex_an_der / #13038204 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1760245",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlung-noun"
          ]
        },
        {
          "id": "3692734",
          "text": "Dank Ihrer Empfehlung bekam Tom die Stelle.",
          "translation": "Том получил работу благодаря вашей рекомендации.",
          "source": "Tatoeba #3692734 @al_ex_an_der / #3060851 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3692734",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlung-noun"
          ]
        },
        {
          "id": "3502909",
          "text": "Das ist keine Forderung, sondern eine Empfehlung.",
          "translation": "Это не требование, а пожелание.",
          "source": "Tatoeba #3502909 @Pfirsichbaeumchen / #3503519 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3502909",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Empfehlung",
        "nominative_pl": ""
