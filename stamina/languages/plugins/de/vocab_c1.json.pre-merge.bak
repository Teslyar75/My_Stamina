    {
      "slug": "städten-noun",
      "lemma": "Städten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9641,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Stadt"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13940859",
          "text": "Die meisten Menschen leben in Städten.",
          "translation": "Большинство людей живут в городах.",
          "source": "Tatoeba #13940859 @mhr / #13940118 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13940859",
          "cefr_level": "A1",
          "word_slugs": [
            "städten-noun"
          ]
        },
        {
          "id": "3445219",
          "text": "Der Bahnhof liegt zwischen den zwei Städten.",
          "translation": "Станция находится между двумя городами.",
          "source": "Tatoeba #3445219 @Manfredo / #13590198 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3445219",
          "cefr_level": "A1",
          "word_slugs": [
            "städten-noun"
          ]
        },
        {
          "id": "3451696",
          "text": "Die Hälfte der Weltbevölkerung lebt in Städten.",
          "translation": "Половина мирового населения проживает в городах.",
          "source": "Tatoeba #3451696 @Pfirsichbaeumchen / #3510141 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3451696",
          "cefr_level": "A1",
          "word_slugs": [
            "städten-noun"
          ]
        },
        {
          "id": "8387418",
          "text": "Alle Freunde von Tom studieren in anderen Städten.",
          "translation": "Все друзья Тома учатся в других городах.",
          "source": "Tatoeba #8387418 @Pfirsichbaeumchen / #5362114 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8387418",
          "cefr_level": "A1",
          "word_slugs": [
            "städten-noun"
          ]
        },
        {
          "id": "8374990",
          "text": "Über die Hälfte der Weltbevölkerung lebt in Städten.",
          "translation": "Более половины населения Земли проживает в городах.",
          "source": "Tatoeba #8374990 @Pfirsichbaeumchen / #8374993 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8374990",
          "cefr_level": "A1",
          "word_slugs": [
            "städten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
