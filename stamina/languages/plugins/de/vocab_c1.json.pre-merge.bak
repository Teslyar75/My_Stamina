    {
      "slug": "allgemeinen-adj",
      "lemma": "allgemeinen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9954,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of allgemein:",
          "strong genitive masculine/neuter singular",
          "inflection of allgemein:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5152101",
          "text": "Im Allgemeinen mögen Kinder Eis.",
          "translation": "Обычно дети любят мороженое.",
          "source": "Tatoeba #5152101 @dispy / #5153473 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5152101",
          "cefr_level": "A1",
          "word_slugs": [
            "allgemeinen-adj"
          ]
        },
        {
          "id": "1957142",
          "text": "Mir ist im Allgemeinen alles gleich.",
          "translation": "Мне по большому счёту всё равно.",
          "source": "Tatoeba #1957142 @al_ex_an_der / #1957139 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1957142",
          "cefr_level": "A1",
          "word_slugs": [
            "allgemeinen-adj"
          ]
        },
        {
          "id": "750614",
          "text": "Dicke Menschen schwitzen im Allgemeinen viel.",
          "translation": "Полные люди обычно много потеют.",
          "source": "Tatoeba #750614 @xtofu80 / #14032007 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/750614",
          "cefr_level": "A1",
          "word_slugs": [
            "allgemeinen-adj"
          ]
        },
        {
          "id": "7898112",
          "text": "Im Allgemeinen wiederholt sich die Geschichte.",
          "translation": "Вообще, история повторяется.",
          "source": "Tatoeba #7898112 @raggione / #7898114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7898112",
          "cefr_level": "A1",
          "word_slugs": [
            "allgemeinen-adj"
          ]
        },
        {
          "id": "11514336",
          "text": "Das Klima hier ist im allgemeinen mild.",
          "translation": "Климат здесь в целом мягкий.",
          "source": "Tatoeba #11514336 @Pfirsichbaeumchen / #11514347 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11514336",
          "cefr_level": "A1",
          "word_slugs": [
            "allgemeinen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
