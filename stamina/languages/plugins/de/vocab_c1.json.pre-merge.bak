      "gender": null,
      "examples": [
        {
          "id": "13148627",
          "text": "Eine Meile besteht aus ungefähr 1600 Metern.",
          "translation": "Миля - это около 1600 метров.",
          "source": "Tatoeba #13148627 @frpzzd / #8174462 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13148627",
          "cefr_level": "A1",
          "word_slugs": [
            "metern-noun"
          ]
        },
        {
          "id": "12680660",
          "text": "Eine schwedische Meile entspricht zehntausend Metern.",
          "translation": "Шведская миля равна десяти тысячам метрам.",
          "source": "Tatoeba #12680660 @mhr / #12680651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12680660",
          "cefr_level": "A1",
          "word_slugs": [
            "metern-noun"
          ]
        },
        {
          "id": "448523",
          "text": "Dieser Berg hat eine Höhe von 3000 Metern.",
          "translation": "Высота этой горы - три тысячи метров.",
          "source": "Tatoeba #448523 @MUIRIEL / #4577444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/448523",
          "cefr_level": "A1",
          "word_slugs": [
            "metern-noun"
          ]
        },
        {
          "id": "440161",
          "text": "Der Teich hat einen Durchmesser von 100 Metern.",
          "translation": "Диаметр пруда - сто метров.",
          "source": "Tatoeba #440161 @MUIRIEL / #12940815 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/440161",
          "cefr_level": "A1",
          "word_slugs": [
            "metern-noun"
          ]
        },
        {
          "id": "2600779",
          "text": "Oberhalb von zweitausend Metern wachsen keine Bäume.",
          "translation": "Выше двух тысяч метров деревья не растут.",
          "source": "Tatoeba #2600779 @Pfirsichbaeumchen / #1440075 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2600779",
          "cefr_level": "A1",
