    {
      "slug": "körpers-noun",
      "lemma": "Körpers",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7620,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Körper"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1699216",
          "text": "Ich schäme mich meines Körpers.",
          "translation": "Я стыжусь своего тела.",
          "source": "Tatoeba #1699216 @Pfirsichbaeumchen / #3036694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1699216",
          "cefr_level": "A1",
          "word_slugs": [
            "körpers-noun"
          ]
        },
        {
          "id": "6476577",
          "text": "Tom schämt sich seines Körpers.",
          "translation": "Том стесняется своего тела.",
          "source": "Tatoeba #6476577 @Pfirsichbaeumchen / #5684474 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6476577",
          "cefr_level": "A1",
          "word_slugs": [
            "körpers-noun"
          ]
        },
        {
          "id": "3570377",
          "text": "Beachten Sie die Signale Ihres Körpers!",
          "translation": "Обратите внимание на сигналы вашего тела!",
