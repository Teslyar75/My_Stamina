          ]
        },
        {
          "id": "5412297",
          "text": "Yann aß Brot.",
          "translation": "Ян ел хлеб.",
          "source": "Tatoeba #5412297 @halfdan / #5703610 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5412297",
          "cefr_level": "A1",
          "word_slugs": [
            "ass-adj"
          ]
        },
        {
          "id": "1496800",
          "text": "Tom aß allein.",
          "translation": "Том поел один.",
          "source": "Tatoeba #1496800 @Pfirsichbaeumchen / #5888314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1496800",
          "cefr_level": "A1",
