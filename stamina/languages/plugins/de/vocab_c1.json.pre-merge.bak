    {
      "slug": "gefährlicher-adj",
      "lemma": "gefährlicher",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6262,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gefährlich:",
