    {
      "slug": "kalten-adj",
      "lemma": "kalten",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5685,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of kalt:",
          "strong genitive masculine/neuter singular",
          "inflection of kalt:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8285536",
          "text": "Ich mag kalten Braten.",
          "translation": "Я люблю холодное жаркое.",
          "source": "Tatoeba #8285536 @felix63 / #13277758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8285536",
          "cefr_level": "A1",
          "word_slugs": [
            "kalten-adj"
          ]
        },
        {
          "id": "383247",
          "text": "Ich mag keinen kalten Kaffee.",
          "translation": "Не люблю холодный кофе.",
          "source": "Tatoeba #383247 @Ole / #3214076 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/383247",
          "cefr_level": "A1",
          "word_slugs": [
            "kalten-adj"
          ]
        },
        {
          "id": "9393764",
          "text": "Tom trinkt keinen kalten Tee.",
          "translation": "Том не пьёт холодный чай.",
          "source": "Tatoeba #9393764 @Pfirsichbaeumchen / #9446647 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9393764",
          "cefr_level": "A1",
          "word_slugs": [
            "kalten-adj"
          ]
        },
        {
          "id": "2761880",
          "text": "Ich will keinen kalten Tee trinken.",
          "translation": "Я не хочу пить холодный чай.",
          "source": "Tatoeba #2761880 @Pfirsichbaeumchen / #2239450 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2761880",
          "cefr_level": "A1",
          "word_slugs": [
            "kalten-adj"
          ]
        },
        {
          "id": "968152",
          "text": "Sie starb in einer kalten Dezembernacht.",
          "translation": "Она умерла холодной декабрьской ночью.",
          "source": "Tatoeba #968152 @Esperantostern / #3604871 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/968152",
          "cefr_level": "A1",
          "word_slugs": [
            "kalten-adj"
          ]
        }
      ],
