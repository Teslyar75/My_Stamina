    {
      "slug": "erziehung-noun",
      "lemma": "Erziehung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7402,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "воспитание"
        ],
        "en": [
          "education; upbringing; character formation (process of imparting basic knowledge, judgment, morals, and manners, especially to a child)",
          "training (of a pet)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2847906",
          "text": "Tierschutz ist Erziehung zur Menschlichkeit.",
          "translation": "Защита животных — это воспитание человечности.",
          "source": "Tatoeba #2847906 @Esperantostern / #13822271 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2847906",
          "cefr_level": "A1",
          "word_slugs": [
            "erziehung-noun"
          ]
        },
        {
          "id": "803619",
          "text": "Er gab seinen Kindern eine gute Erziehung.",
          "translation": "Он дал своим детям хорошее образование.",
          "source": "Tatoeba #803619 @Hans_Adler / #917921 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/803619",
          "cefr_level": "A1",
          "word_slugs": [
            "erziehung-noun"
          ]
        },
        {
          "id": "1645599",
          "text": "Du hast den Vorteil einer guten Erziehung.",
          "translation": "У тебя есть преимущество в виде хорошего воспитания.",
          "source": "Tatoeba #1645599 @Zaghawa / #13193810 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1645599",
          "cefr_level": "A1",
          "word_slugs": [
            "erziehung-noun"
          ]
        },
        {
          "id": "1645602",
          "text": "Ihr habt den Vorteil einer guten Erziehung.",
          "translation": "У вас есть преимущество в виде хорошего воспитания.",
          "source": "Tatoeba #1645602 @Zaghawa / #13193809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1645602",
          "cefr_level": "A1",
          "word_slugs": [
            "erziehung-noun"
          ]
        },
        {
          "id": "1645601",
