    {
      "slug": "keines-pron",
      "lemma": "keines",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6125,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of keiner:",
          "neuter nominative",
          "inflection of keiner:",
          "masculine/neuter genitive"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4977786",
          "text": "Keines von beiden war wahr.",
          "translation": "Ни то ни другое не было правдой.",
          "source": "Tatoeba #4977786 @Manfredo / #4978177 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4977786",
          "cefr_level": "A1",
          "word_slugs": [
            "keines-pron"
          ]
        },
        {
          "id": "987718",
          "text": "Ich mag keines dieser Fotos.",
          "translation": "Мне ни одна из этих фотографий не нравится.",
          "source": "Tatoeba #987718 @MUIRIEL / #2400963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/987718",
          "cefr_level": "A1",
          "word_slugs": [
            "keines-pron"
          ]
        },
        {
          "id": "449664",
          "text": "Keines dieser Autos gehört mir.",
          "translation": "Ни одна из этих машин мне не принадлежит.",
          "source": "Tatoeba #449664 @MUIRIEL / #5605354 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/449664",
          "cefr_level": "A1",
          "word_slugs": [
            "keines-pron"
          ]
        },
        {
          "id": "7697328",
          "text": "Tom starb keines natürlichen Todes.",
          "translation": "Том умер не своей смертью.",
          "source": "Tatoeba #7697328 @wolfgangth / #13950649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7697328",
          "cefr_level": "A1",
          "word_slugs": [
            "keines-pron"
          ]
        },
        {
          "id": "396871",
          "text": "Mir gefällt keines von den Bildern.",
          "translation": "Мне ни одна из этих картин не нравится.",
          "source": "Tatoeba #396871 @MikeMolto / #4552556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/396871",
          "cefr_level": "A1",
          "word_slugs": [
            "keines-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der keines",
        "nominative_pl": ""
      }
    },
