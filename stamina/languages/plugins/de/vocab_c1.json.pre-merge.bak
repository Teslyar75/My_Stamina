    {
      "slug": "reite-verb",
      "lemma": "reite",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7155,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of reiten:",
          "first-person singular present",
          "inflection of reiten:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8072729",
          "text": "Ich reite gern.",
          "translation": "Я люблю ездить верхом.",
          "source": "Tatoeba #8072729 @Luiaard / #8104036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8072729",
          "cefr_level": "A1",
          "word_slugs": [
            "reite-verb"
          ]
        },
        {
          "id": "8898254",
          "text": "Ich reite, seit ich ein Kind bin.",
          "translation": "Я езжу верхом с детства.",
          "source": "Tatoeba #8898254 @mramosch / #9432003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8898254",
          "cefr_level": "A1",
          "word_slugs": [
            "reite-verb"
          ]
        },
        {
          "id": "6691402",
          "text": "Ab und zu reite ich gerne ein Pferd.",
          "translation": "Я люблю время от времени ездить верхом.",
          "source": "Tatoeba #6691402 @srovorake / #6690823 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6691402",
          "cefr_level": "A1",
          "word_slugs": [
            "reite-verb"
          ]
        },
        {
          "id": "2265954",
          "text": "Auf dem Pferd reite nicht: das wirft dich ab!",
          "translation": "Не катайся на лошади: она тебя сбросит!",
          "source": "Tatoeba #2265954 @Pfirsichbaeumchen / #8612684 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2265954",
          "cefr_level": "A1",
          "word_slugs": [
            "reite-verb"
          ]
        }
      ],
