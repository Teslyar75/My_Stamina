      "slug": "marina-noun",
      "lemma": "Marina",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8180,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "marina (harbor for small boats)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11532593",
          "text": "Ich heiße Marina.",
          "translation": "Меня зовут Марина.",
          "source": "Tatoeba #11532593 @Pfirsichbaeumchen / #8029692 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11532593",
          "cefr_level": "A1",
          "word_slugs": [
            "marina-noun"
          ]
        },
        {
          "id": "13322686",
          "text": "Übermorgen hat Marina Geburtstag.",
          "translation": "Послезавтра у Марины день рождения.",
          "source": "Tatoeba #13322686 @Waldelfe / #2798949 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13322686",
          "cefr_level": "A1",
          "word_slugs": [
            "marina-noun"
          ]
        },
        {
          "id": "10806854",
          "text": "Toms erste Frau hieß Marina.",
          "translation": "Первую жену Тома звали Марина.",
          "source": "Tatoeba #10806854 @carlosalberto / #10806849 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10806854",
          "cefr_level": "A1",
          "word_slugs": [
            "marina-noun"
          ]
        },
        {
          "id": "13385848",
          "text": "Tom sah Marina die Treppe hinaufgehen.",
          "translation": "Том видел, как Марина поднимается по ступенькам.",
          "source": "Tatoeba #13385848 @Waldelfe / #13189449 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13385848",
          "cefr_level": "A1",
          "word_slugs": [
            "marina-noun"
          ]
        },
        {
          "id": "13053166",
          "text": "Marina ist älter als Katharina.",
          "translation": "Марина старше Катерины.",
          "source": "Tatoeba #13053166 @Waldelfe / #13189450 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13053166",
          "cefr_level": "A1",
          "word_slugs": [
            "marina-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
