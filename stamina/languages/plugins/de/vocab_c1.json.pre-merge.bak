    {
      "slug": "schuf-verb",
      "lemma": "schuf",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9875,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of schaffen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "341085",
          "text": "Gott schuf die Welt.",
          "translation": "Бог создал мир.",
          "source": "Tatoeba #341085 @tinacalysto / #626579 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341085",
          "cefr_level": "A1",
          "word_slugs": [
            "schuf-verb"
          ]
        },
        {
          "id": "2895463",
          "text": "Gott schuf Himmel und Erde.",
          "translation": "Бог сотворил небо и землю.",
          "source": "Tatoeba #2895463 @Pfirsichbaeumchen / #2832616 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2895463",
          "cefr_level": "A1",
          "word_slugs": [
            "schuf-verb"
          ]
        },
        {
          "id": "14006099",
          "text": "Das menschliche Bewusstsein schuf die Sprache.",
          "translation": "Человеческое сознание создало язык.",
          "source": "Tatoeba #14006099 @mhr / #14006097 @kitler (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14006099",
          "cefr_level": "A1",
          "word_slugs": [
            "schuf-verb"
          ]
        },
        {
          "id": "1220454",
          "text": "Sie war nackt wie Gott sie schuf.",
          "translation": "Она была в чём мать родила.",
          "source": "Tatoeba #1220454 @Esperantostern / #6103866 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1220454",
          "cefr_level": "A1",
          "word_slugs": [
            "schuf-verb"
          ]
        },
        {
          "id": "625783",
          "text": "Im Anfang schuf Gott Himmel und Erde.",
          "translation": "В начале Бог создал небо и землю.",
          "source": "Tatoeba #625783 @kolonjano / #811810 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/625783",
          "cefr_level": "A1",
          "word_slugs": [
            "schuf-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
