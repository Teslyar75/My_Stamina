    {
      "slug": "verwechseln-verb",
      "lemma": "verwechseln",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9312,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "путать"
        ],
        "en": [
          "to mix up; to confuse or mistake something for something else"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3846797",
          "text": "Ich glaube, Sie verwechseln mich.",
          "translation": "Я думаю, Вы меня с кем-то путаете.",
          "source": "Tatoeba #3846797 @Tickler / #12462497 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3846797",
          "cefr_level": "A1",
          "word_slugs": [
            "verwechseln-verb"
          ]
        },
        {
          "id": "13946786",
          "text": "Sie verwechseln Irland und Island.",
          "translation": "Вы путаете Ирландию и Исландию.",
          "source": "Tatoeba #13946786 @mhr / #13946605 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13946786",
          "cefr_level": "A1",
          "word_slugs": [
            "verwechseln-verb"
          ]
        },
        {
          "id": "13946797",
          "text": "Sie verwechseln Inder und Indianer.",
          "translation": "Вы путаете индийцев и индейцев.",
          "source": "Tatoeba #13946797 @mhr / #13946608 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13946797",
          "cefr_level": "A1",
          "word_slugs": [
            "verwechseln-verb"
          ]
        },
        {
          "id": "3494976",
          "text": "Sie verwechseln Ursache und Wirkung.",
          "translation": "Вы путаете причину и следствие.",
          "source": "Tatoeba #3494976 @al_ex_an_der / #12629700 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3494976",
          "cefr_level": "A1",
          "word_slugs": [
            "verwechseln-verb"
          ]
        },
        {
          "id": "13946789",
          "text": "Sie verwechseln den Libanon und Libyen.",
          "translation": "Вы путаете Ливан и Ливию.",
          "source": "Tatoeba #13946789 @mhr / #13946604 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13946789",
          "cefr_level": "A1",
          "word_slugs": [
            "verwechseln-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "verwechseln-noun",
      "lemma": "Verwechseln",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9312,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
