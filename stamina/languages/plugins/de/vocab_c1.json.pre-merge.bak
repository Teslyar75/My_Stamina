          ]
        },
        {
          "id": "13603632",
          "text": "Du hättest Toms Gesichtsausdruck sehen sollen!",
          "translation": "Нужно было видеть выражение лица Тома.",
          "source": "Tatoeba #13603632 @Waldelfe / #6616764 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13603632",
