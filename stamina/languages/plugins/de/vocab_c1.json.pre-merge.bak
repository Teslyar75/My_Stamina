    {
      "slug": "seltene-adj",
      "lemma": "seltene",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9370,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of selten:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of selten:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "707560",
          "text": "Ich sammle seltene Münzen.",
          "translation": "Я собираю редкие монеты.",
          "source": "Tatoeba #707560 @Manfredo / #4413628 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/707560",
          "cefr_level": "A1",
          "word_slugs": [
            "seltene-adj"
          ]
        },
        {
          "id": "3042874",
          "text": "Tom hat eine seltene Krankheit.",
          "translation": "У Тома редкое заболевание.",
          "source": "Tatoeba #3042874 @Pfirsichbaeumchen / #3037778 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3042874",
          "cefr_level": "A1",
          "word_slugs": [
            "seltene-adj"
          ]
        },
        {
          "id": "2419010",
          "text": "Ich habe eine seltene Blutgruppe.",
          "translation": "У меня редкая группа крови.",
          "source": "Tatoeba #2419010 @al_ex_an_der / #2419009 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2419010",
          "cefr_level": "A1",
          "word_slugs": [
            "seltene-adj"
          ]
        },
        {
          "id": "7747954",
          "text": "Es ist eine sehr seltene Erkrankung.",
          "translation": "Это очень редкая болезнь.",
          "source": "Tatoeba #7747954 @brauchinet / #7752931 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7747954",
          "cefr_level": "A1",
          "word_slugs": [
            "seltene-adj"
          ]
        },
        {
          "id": "600495",
          "text": "Geduld ist eine seltene Tugend heutzutage.",
          "translation": "Терпение — редкая добродетель в наше время.",
          "source": "Tatoeba #600495 @Manfredo / #5802643 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/600495",
          "cefr_level": "A1",
          "word_slugs": [
            "seltene-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
