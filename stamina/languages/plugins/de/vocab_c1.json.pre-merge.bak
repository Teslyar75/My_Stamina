      },
      "gender": null,
      "examples": [
        {
          "id": "1314629",
          "text": "Er hat zehn Kühe.",
          "translation": "У него десять коров.",
          "source": "Tatoeba #1314629 @Pfirsichbaeumchen / #2730816 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1314629",
