    {
      "slug": "erstaunt-verb",
      "lemma": "erstaunt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7637,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of erstaunen:",
          "second-person plural present",
          "inflection of erstaunen:",
          "third-person singular present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5171047",
          "text": "Ich war erstaunt.",
          "translation": "Я была удивлена.",
          "source": "Tatoeba #5171047 @Tamy / #2562877 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5171047",
          "cefr_level": "A1",
          "word_slugs": [
            "erstaunt-verb"
          ]
        },
        {
          "id": "353283",
          "text": "Sein Gedächtnis erstaunt mich.",
          "translation": "Его память меня удивляет.",
          "source": "Tatoeba #353283 @MUIRIEL / #4509791 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/353283",
          "cefr_level": "A1",
          "word_slugs": [
            "erstaunt-verb"
          ]
        },
        {
          "id": "344606",
          "text": "Mich erstaunt deine verantwortungslose Einstellung.",
          "translation": "Меня поражает твоё безответственное отношение.",
          "source": "Tatoeba #344606 @MUIRIEL / #8365049 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344606",
          "cefr_level": "A1",
          "word_slugs": [
            "erstaunt-verb"
          ]
        },
        {
          "id": "2909227",
          "text": "Er muss sehr erstaunt gewesen sein.",
          "translation": "Он, наверное, был очень удивлён.",
          "source": "Tatoeba #2909227 @al_ex_an_der / #12476643 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2909227",
          "cefr_level": "A1",
          "word_slugs": [
            "erstaunt-verb"
          ]
        },
        {
          "id": "12967737",
          "text": "Sie war wahrscheinlich sehr erstaunt, oder?",
          "translation": "Она, наверное, очень удивилась?",
          "source": "Tatoeba #12967737 @mhr / #12967709 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12967737",
          "cefr_level": "A1",
          "word_slugs": [
            "erstaunt-verb"
          ]
        }
      ],
