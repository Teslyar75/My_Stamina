          ]
        },
        {
          "id": "13539912",
          "text": "Tom verdiente viel Geld.",
          "translation": "Том зарабатывал много денег.",
          "source": "Tatoeba #13539912 @mhr / #13540182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13539912",
          "cefr_level": "A1",
