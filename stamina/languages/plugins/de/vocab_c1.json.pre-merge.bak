          "word_slugs": [
            "kriminellen-noun"
          ]
        },
        {
          "id": "478051",
          "text": "F. stellt sich auf die Seite des Kriminellen.",
          "translation": "Ф. становится на сторону преступника.",
          "source": "Tatoeba #478051 @MUIRIEL / #478358 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/478051",
