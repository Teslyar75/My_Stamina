    {
      "slug": "beschäftigen-verb",
      "lemma": "beschäftigen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6061,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to occupy, to keep occupied, to employ, to engage (possess or use the time, capacity or service of)",
          "to keep oneself busy, to keep oneself occupied",
          "to concern oneself"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7011000",
          "text": "Versuch, ihn zu beschäftigen.",
          "translation": "Попробуй его чем-нибудь занять.",
          "source": "Tatoeba #7011000 @driini / #13690387 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7011000",
          "cefr_level": "A1",
          "word_slugs": [
            "beschäftigen-verb"
          ]
        },
        {
          "id": "13901740",
          "text": "Wir beschäftigen uns mit Cybersicherheit.",
          "translation": "Мы занимаемся кибербезопасностью.",
          "source": "Tatoeba #13901740 @mhr / #13901688 @Qvadratus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13901740",
          "cefr_level": "A1",
          "word_slugs": [
            "beschäftigen-verb"
          ]
        },
        {
          "id": "8055626",
          "text": "Womit beschäftigen Sie sich am liebsten?",
          "translation": "Чем вы больше всего любите заниматься?",
          "source": "Tatoeba #8055626 @Pfirsichbaeumchen / #2807092 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8055626",
          "cefr_level": "A1",
          "word_slugs": [
            "beschäftigen-verb"
          ]
        },
        {
          "id": "2899702",
          "text": "Ich werde mich sofort damit beschäftigen.",
          "translation": "Я немедленно этим займусь.",
          "source": "Tatoeba #2899702 @Manfredo / #5010390 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2899702",
          "cefr_level": "A1",
          "word_slugs": [
            "beschäftigen-verb"
          ]
        },
        {
          "id": "13411602",
          "text": "Jetzt kann ich mich mit dir beschäftigen.",
          "translation": "Теперь я могу заняться тобой.",
          "source": "Tatoeba #13411602 @Waldelfe / #13411593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13411602",
          "cefr_level": "A1",
          "word_slugs": [
            "beschäftigen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
