        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "4640252",
          "text": "Im Saal war niemand.",
          "translation": "В зале никого не было.",
          "source": "Tatoeba #4640252 @Tamy / #13977987 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4640252",
          "cefr_level": "A1",
          "word_slugs": [
            "saal-noun"
          ]
        },
        {
          "id": "6765302",
          "text": "Im Saal wird getanzt.",
          "translation": "В зале танцуют.",
          "source": "Tatoeba #6765302 @Pfirsichbaeumchen / #5472220 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6765302",
          "cefr_level": "A1",
          "word_slugs": [
            "saal-noun"
          ]
        },
        {
          "id": "12306246",
          "text": "Alle verließen den Saal.",
          "translation": "Все вышли из зала.",
          "source": "Tatoeba #12306246 @Pfirsichbaeumchen / #12306204 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12306246",
          "cefr_level": "A1",
          "word_slugs": [
            "saal-noun"
          ]
        },
        {
          "id": "13972800",
          "text": "Dieser Saal war voller Leute.",
          "translation": "В этом зале было полно народа.",
          "source": "Tatoeba #13972800 @AaronAardvark / #13973244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13972800",
          "cefr_level": "A1",
          "word_slugs": [
            "saal-noun"
          ]
        },
        {
          "id": "1872783",
          "text": "Es waren viele Leute im Saal.",
          "translation": "В зале было много народа.",
          "source": "Tatoeba #1872783 @Tamy / #9087783 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1872783",
          "cefr_level": "A1",
          "word_slugs": [
            "saal-noun"
          ]
        }
      ],
      "tags": [
