    {
      "slug": "mittags-adv",
      "lemma": "mittags",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8304,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "at midday"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5466582",
          "text": "Er kam erst mittags.",
          "translation": "До полудня он не пришёл.",
          "source": "Tatoeba #5466582 @Pfirsichbaeumchen / #7590015 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5466582",
          "cefr_level": "A1",
          "word_slugs": [
            "mittags-adv"
          ]
        },
        {
          "id": "4049331",
          "text": "Was isst du mittags gewöhnlich?",
          "translation": "Что ты обычно ешь на обед?",
          "source": "Tatoeba #4049331 @Pfirsichbaeumchen / #4049619 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4049331",
          "cefr_level": "A1",
          "word_slugs": [
            "mittags-adv"
          ]
        },
        {
          "id": "3944829",
          "text": "Wann esst ihr mittags üblicherweise?",
          "translation": "Когда вы обычно обедаете?",
          "source": "Tatoeba #3944829 @Zaghawa / #3944840 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3944829",
          "cefr_level": "A1",
          "word_slugs": [
            "mittags-adv"
          ]
        },
        {
          "id": "11787226",
          "text": "Ich habe bis zwölf Uhr mittags geschlafen.",
          "translation": "Я спал до двенадцати часов дня.",
          "source": "Tatoeba #11787226 @Pfirsichbaeumchen / #5902547 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11787226",
          "cefr_level": "A1",
          "word_slugs": [
            "mittags-adv"
          ]
        },
        {
          "id": "8386840",
          "text": "„Wollen wir bis morgen warten?“ – „Gut, aber nur bis mittags.“",
          "translation": "\"Подождём до завтра?\" — \"Хорошо, но только до полудня\".",
          "source": "Tatoeba #8386840 @Pfirsichbaeumchen / #6210183 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8386840",
          "cefr_level": "A1",
          "word_slugs": [
            "mittags-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
