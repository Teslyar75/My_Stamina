    {
      "slug": "quatschen-verb",
      "lemma": "quatschen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7699,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "болтать"
        ],
        "en": [
          "to talk nonsense",
          "to chatter, babble"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1772985",
          "text": "Tote quatschen nicht.",
          "translation": "Мёртвые не болтают.",
          "source": "Tatoeba #1772985 @al_ex_an_der / #1772975 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1772985",
          "cefr_level": "A1",
          "word_slugs": [
            "quatschen-verb"
          ]
        },
        {
          "id": "921266",
          "text": "Übersetze, statt zu quatschen!",
          "translation": "Переводи, вместо того чтобы трепаться!",
          "source": "Tatoeba #921266 @sacredceltic / #11661534 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/921266",
          "cefr_level": "A1",
          "word_slugs": [
            "quatschen-verb"
          ]
        },
        {
          "id": "12902089",
          "text": "Die Nachbarn quatschen abends gern.",
          "translation": "Соседи любят болтать по вечерам.",
          "source": "Tatoeba #12902089 @Waldelfe / #12901220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12902089",
          "cefr_level": "A1",
          "word_slugs": [
            "quatschen-verb"
          ]
        },
        {
          "id": "13804048",
          "text": "Jetzt können wir ein bisschen quatschen.",
          "translation": "Теперь мы можем немного поболтать.",
          "source": "Tatoeba #13804048 @mhr / #13803103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13804048",
          "cefr_level": "A1",
          "word_slugs": [
            "quatschen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
