      },
      "gender": null,
      "examples": [
        {
          "id": "3109340",
          "text": "Du hast nicht die geringste Chance.",
          "translation": "У тебя нет ни малейшего шанса.",
          "source": "Tatoeba #3109340 @Pfirsichbaeumchen / #5628914 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3109340",
          "cefr_level": "A1",
          "word_slugs": [
            "geringste-adj"
          ]
        },
        {
          "id": "2878860",
          "text": "Es besteht nicht die geringste Gefahr.",
          "translation": "Нет ни малейшей опасности.",
          "source": "Tatoeba #2878860 @raggione / #2878874 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2878860",
          "cefr_level": "A1",
          "word_slugs": [
            "geringste-adj"
          ]
        },
        {
          "id": "3421584",
          "text": "Dies ist das geringste deiner Probleme.",
          "translation": "Это самая меньшая из твоих проблем.",
          "source": "Tatoeba #3421584 @Plusquamperfekt / #5628917 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3421584",
          "cefr_level": "A1",
          "word_slugs": [
            "geringste-adj"
          ]
        },
        {
          "id": "2023909",
          "text": "Was bedeutet das? Ich habe nicht die geringste Ahnung.",
          "translation": "Что это значит? Не имею ни малейшего представления.",
          "source": "Tatoeba #2023909 @al_ex_an_der / #2024100 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2023909",
          "cefr_level": "A1",
          "word_slugs": [
            "geringste-adj"
          ]
        },
        {
          "id": "12399990",
          "text": "Ich habe nicht die geringste Ahnung, was das bedeutet.",
          "translation": "Я не имею ни малейшего понятия, что это значит.",
          "source": "Tatoeba #12399990 @Adelpa / #9133737 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12399990",
          "cefr_level": "A1",
