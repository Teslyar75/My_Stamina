      "gender": null,
      "examples": [
        {
          "id": "8728916",
          "text": "Die Läden sind heute zu.",
          "translation": "Магазины закрыты сегодня.",
          "source": "Tatoeba #8728916 @maaster / #8728984 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8728916",
          "cefr_level": "A1",
