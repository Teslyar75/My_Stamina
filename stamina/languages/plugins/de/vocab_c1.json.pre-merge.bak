          ]
        },
        {
          "id": "9936360",
          "text": "Der Gipfel ist mit Schnee bedeckt.",
          "translation": "Вершина покрыта снегом.",
          "source": "Tatoeba #9936360 @GaryGaryGary / #2535463 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936360",
          "cefr_level": "A1",
