    {
      "slug": "quer-adj",
      "lemma": "quer",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7846,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "crosswise, cross"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "8676786",
          "text": "Ich reise quer durch Sibirien.",
          "translation": "Я путешествую по Сибири.",
          "source": "Tatoeba #8676786 @manese / #12969938 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8676786",
          "cefr_level": "A1",
          "word_slugs": [
            "quer-adj"
          ]
        },
        {
          "id": "1780005",
          "text": "Ich reiste kreuz und quer durch Europa.",
          "translation": "Я путешествовал по всей Европе.",
          "source": "Tatoeba #1780005 @Pfirsichbaeumchen / #3587973 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1780005",
          "cefr_level": "A1",
          "word_slugs": [
            "quer-adj"
          ]
        },
        {
          "id": "7835490",
          "text": "Tom reiste kreuz und quer durch Südostasien.",
          "translation": "Том объездил юго-восточную Азию вдоль и поперёк.",
          "source": "Tatoeba #7835490 @Pfirsichbaeumchen / #12099697 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7835490",
          "cefr_level": "A1",
          "word_slugs": [
            "quer-adj"
          ]
        },
        {
          "id": "1030243",
          "text": "Wenn das funktioniert, fress ich einen Besen quer.",
          "translation": "Если это сработает, я съем свою шляпу.",
          "source": "Tatoeba #1030243 @Hans07 / #4941102 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1030243",
          "cefr_level": "A1",
          "word_slugs": [
            "quer-adj"
          ]
        },
        {
          "id": "6164020",
          "text": "Ich bin kreuz und quer durch die Vereinigten Staaten gereist.",
          "translation": "Я путешествовал по всем Соединённым Штатам.",
          "source": "Tatoeba #6164020 @Pfirsichbaeumchen / #6163970 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6164020",
          "cefr_level": "A1",
          "word_slugs": [
            "quer-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
