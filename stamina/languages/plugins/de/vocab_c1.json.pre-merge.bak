      "gender": null,
      "examples": [
        {
          "id": "11262980",
          "text": "Eine Meile sind etwa 1600 Meter.",
          "translation": "Миля - это примерно тысяча шестьсот метров.",
          "source": "Tatoeba #11262980 @Pfirsichbaeumchen / #11262775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11262980",
          "cefr_level": "A1",
          "word_slugs": [
            "meile-noun"
          ]
        },
        {
          "id": "13148627",
          "text": "Eine Meile besteht aus ungefähr 1600 Metern.",
          "translation": "Миля - это около 1600 метров.",
          "source": "Tatoeba #13148627 @frpzzd / #8174462 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13148627",
          "cefr_level": "A1",
          "word_slugs": [
            "meile-noun"
          ]
        },
        {
          "id": "12680659",
          "text": "Eine schwedische Meile entspricht zehn Kilometern.",
          "translation": "Шведская миля равна десяти километрам.",
          "source": "Tatoeba #12680659 @mhr / #12680652 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12680659",
          "cefr_level": "A1",
          "word_slugs": [
            "meile-noun"
          ]
        },
        {
          "id": "12680660",
          "text": "Eine schwedische Meile entspricht zehntausend Metern.",
          "translation": "Шведская миля равна десяти тысячам метрам.",
          "source": "Tatoeba #12680660 @mhr / #12680651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12680660",
          "cefr_level": "A1",
          "word_slugs": [
            "meile-noun"
          ]
        },
        {
          "id": "2664001",
          "text": "Von hier ist es ungefähr eine Meile bis zum Bahnhof.",
          "translation": "Отсюда примерно одна миля до вокзала.",
          "source": "Tatoeba #2664001 @Espi / #7498897 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2664001",
          "cefr_level": "A1",
          "word_slugs": [
            "meile-noun"
          ]
        }
