    {
      "slug": "unterbrochen-verb",
      "lemma": "unterbrochen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5850,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of unterbrechen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11126525",
          "text": "Unser Gespräch wurde unterbrochen.",
          "translation": "Наш разговор был прерван.",
          "source": "Tatoeba #11126525 @Pfirsichbaeumchen / #8913485 @yatomoya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11126525",
          "cefr_level": "A1",
          "word_slugs": [
            "unterbrochen-verb"
          ]
        },
        {
          "id": "13041154",
          "text": "Die nächtliche Stille wurde durch Hundegebell unterbrochen.",
          "translation": "Ночную тишину разорвал лай собак.",
          "source": "Tatoeba #13041154 @mhr / #13041023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13041154",
          "cefr_level": "A1",
          "word_slugs": [
            "unterbrochen-verb"
          ]
        },
        {
          "id": "3515152",
          "text": "Er hat dich unterbrochen. Das ist sehr unhöflich!",
          "translation": "Он тебя перебил. Это очень невежливо!",
          "source": "Tatoeba #3515152 @Manfredo / #3515155 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3515152",
          "cefr_level": "A1",
          "word_slugs": [
            "unterbrochen-verb"
          ]
        },
        {
          "id": "13035110",
          "text": "Die Arbeiten mussten aufgrund der Wetterbedingungen unterbrochen werden.",
          "translation": "Работы пришлось прервать из-за метеоусловий.",
          "source": "Tatoeba #13035110 @mhr / #13034970 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13035110",
          "cefr_level": "A1",
          "word_slugs": [
            "unterbrochen-verb"
          ]
        },
        {
          "id": "13035111",
          "text": "Die Arbeiten mussten aufgrund der Witterungsbedingungen unterbrochen werden.",
          "translation": "Работы пришлось прервать из-за метеоусловий.",
          "source": "Tatoeba #13035111 @mhr / #13034970 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13035111",
          "cefr_level": "A1",
          "word_slugs": [
            "unterbrochen-verb"
          ]
        }
      ],
      "tags": [
