    {
      "slug": "aufeinander-adv",
      "lemma": "aufeinander",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6763,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "one another, each other"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "792041",
          "text": "Wartet, schießt nicht aufeinander!",
          "translation": "Подождите, не стреляйте друг в друга!",
          "source": "Tatoeba #792041 @Hans_Adler / #5296794 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/792041",
          "cefr_level": "A1",
          "word_slugs": [
            "aufeinander-adv"
          ]
        },
        {
          "id": "8672840",
          "text": "Tom und Maria waren wütend aufeinander.",
          "translation": "Том и Мэри злились друг на друга.",
          "source": "Tatoeba #8672840 @Pfirsichbaeumchen / #8676294 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8672840",
          "cefr_level": "A1",
          "word_slugs": [
            "aufeinander-adv"
          ]
        },
        {
          "id": "8374074",
          "text": "Die Mädchen hacken schon wieder aufeinander herum.",
          "translation": "Девочки опять начали докапываться друг до друга.",
          "source": "Tatoeba #8374074 @Pfirsichbaeumchen / #8374984 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8374074",
          "cefr_level": "A1",
          "word_slugs": [
            "aufeinander-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
