          ]
        },
        {
          "id": "3144016",
          "text": "Wie teuer ist der Eintritt?",
          "translation": "Сколько стоит вход?",
          "source": "Tatoeba #3144016 @Pfirsichbaeumchen / #2468179 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3144016",
