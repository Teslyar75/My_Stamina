      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7488,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular present of laden"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8286124",
          "text": "Tom lädt uns alle ein.",
          "translation": "Том зовёт нас всех в гости.",
          "source": "Tatoeba #8286124 @Pfirsichbaeumchen / #6395758 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8286124",
          "cefr_level": "A1",
          "word_slugs": [
            "lädt-verb"
          ]
        },
        {
          "id": "9243291",
          "text": "Mein Telefon lädt sich gerade auf.",
          "translation": "Мой телефон заряжается.",
          "source": "Tatoeba #9243291 @Pfirsichbaeumchen / #9192677 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9243291",
          "cefr_level": "A1",
          "word_slugs": [
            "lädt-verb"
          ]
        },
        {
          "id": "12452136",
          "text": "Tom lädt uns vielleicht nicht ein.",
          "translation": "Возможно, Том нас не пригласит.",
          "source": "Tatoeba #12452136 @Waldelfe / #12452141 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12452136",
          "cefr_level": "A1",
          "word_slugs": [
            "lädt-verb"
          ]
        },
        {
          "id": "13597196",
          "text": "Warum lädt dein Handyakku so langsam?",
          "translation": "Почему у тебя батарея на телефоне так медленно заряжается?",
          "source": "Tatoeba #13597196 @mhr / #13597160 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13597196",
          "cefr_level": "A1",
          "word_slugs": [
            "lädt-verb"
          ]
        },
        {
          "id": "2418549",
          "text": "Man lädt mich nicht zu Partys ein.",
          "translation": "Меня не приглашают на вечеринки.",
          "source": "Tatoeba #2418549 @Manfredo / #5910254 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2418549",
          "cefr_level": "A1",
          "word_slugs": [
            "lädt-verb"
          ]
        }
