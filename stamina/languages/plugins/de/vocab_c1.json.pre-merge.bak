    {
      "slug": "zeitalter-noun",
      "lemma": "Zeitalter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9172,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "эпоха",
          "эра"
        ],
        "en": [
          "age; era (historic period of time)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "5408690",
          "text": "Wir leben im nuklearen Zeitalter.",
          "translation": "Мы живём в ядерный век.",
          "source": "Tatoeba #5408690 @sarefo / #5882459 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5408690",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitalter-noun"
          ]
        },
        {
          "id": "454781",
          "text": "Wir leben im Zeitalter der Kernenergie.",
          "translation": "Мы живём в век ядерной энергии.",
          "source": "Tatoeba #454781 @MUIRIEL / #1525392 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/454781",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitalter-noun"
          ]
        },
        {
          "id": "10015724",
          "text": "Wir leben im Zeitalter der Fake News.",
          "translation": "Мы живём в эпоху фейковых новостей.",
          "source": "Tatoeba #10015724 @sakslane / #10014338 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10015724",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitalter-noun"
          ]
        },
        {
          "id": "9841735",
          "text": "Das Zeitalter der Dinosaurier ist lange her.",
          "translation": "Эпоха динозавров была давным-давно.",
          "source": "Tatoeba #9841735 @Pfirsichbaeumchen / #3335346 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9841735",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitalter-noun"
          ]
        },
        {
          "id": "5964319",
          "text": "Im Viktorianischen Zeitalter trugen die Frauen Korsette.",
          "translation": "В викторианскую эпоху женщины носили корсеты.",
          "source": "Tatoeba #5964319 @Pfirsichbaeumchen / #5803461 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5964319",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitalter-noun"
          ]
        }
