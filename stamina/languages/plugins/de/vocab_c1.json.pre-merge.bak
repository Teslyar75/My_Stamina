    {
      "slug": "verhält-verb",
      "lemma": "verhält",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7644,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular present active of verhalten he/she/it behaves"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "520283",
          "text": "Er verhält sich seltsam.",
          "translation": "Он ведёт себя странно.",
          "source": "Tatoeba #520283 @MUIRIEL / #790525 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/520283",
          "cefr_level": "A1",
          "word_slugs": [
            "verhält-verb"
          ]
        },
        {
          "id": "6820721",
          "text": "Kein Mensch verhält sich so.",
          "translation": "Никто так себя не ведёт.",
          "source": "Tatoeba #6820721 @list / #13200418 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6820721",
          "cefr_level": "A1",
          "word_slugs": [
            "verhält-verb"
          ]
        },
        {
          "id": "2486626",
          "text": "Er verhält sich wie ein Außerirdischer.",
          "translation": "Он ведёт себя как инопланетянин.",
          "source": "Tatoeba #2486626 @al_ex_an_der / #2486625 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2486626",
          "cefr_level": "A1",
          "word_slugs": [
            "verhält-verb"
          ]
        },
        {
          "id": "343626",
          "text": "Dass sie sich so verhält, ist seltsam.",
          "translation": "Странно, что она так себя ведёт.",
          "source": "Tatoeba #343626 @MUIRIEL / #6671769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/343626",
          "cefr_level": "A1",
          "word_slugs": [
            "verhält-verb"
          ]
        },
        {
          "id": "9501298",
          "text": "Er verhält sich in letzter Zeit merkwürdig.",
          "translation": "Он в последнее время странно себя ведёт.",
          "source": "Tatoeba #9501298 @Pfirsichbaeumchen / #9500537 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9501298",
          "cefr_level": "A1",
          "word_slugs": [
            "verhält-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
