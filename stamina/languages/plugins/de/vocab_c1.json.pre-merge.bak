      "gender": null,
      "examples": [
        {
          "id": "570797",
          "text": "Ein schrecklicher Tag!",
          "translation": "Ужасный день!",
          "source": "Tatoeba #570797 @MUIRIEL / #12236990 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/570797",
          "cefr_level": "A1",
          "word_slugs": [
