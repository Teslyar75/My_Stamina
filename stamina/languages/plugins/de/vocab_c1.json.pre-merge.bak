    {
      "slug": "hindurch-adv",
      "lemma": "hindurch",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9367,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "through, throughout"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2447820",
          "text": "Tom weinte die ganze Nacht hindurch.",
          "translation": "Том проплакал всю ночь.",
          "source": "Tatoeba #2447820 @al_ex_an_der / #2356904 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2447820",
          "cefr_level": "A1",
          "word_slugs": [
            "hindurch-adv"
          ]
        },
        {
          "id": "6373318",
          "text": "Er hat den ganzen Tag hindurch gearbeitet.",
          "translation": "Он проработал весь день.",
          "source": "Tatoeba #6373318 @eric2 / #1700475 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6373318",
          "cefr_level": "A1",
          "word_slugs": [
            "hindurch-adv"
          ]
        },
        {
          "id": "7883807",
          "text": "Der Mensch lernt das ganze Leben hindurch.",
          "translation": "Человек учится всю жизнь.",
          "source": "Tatoeba #7883807 @list / #7884573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7883807",
          "cefr_level": "A1",
          "word_slugs": [
            "hindurch-adv"
          ]
        },
        {
          "id": "1944284",
          "text": "Die ganze Nacht hindurch hörte es nicht auf zu regnen.",
          "translation": "Дождь не прекращался всю ночь.",
          "source": "Tatoeba #1944284 @al_ex_an_der / #1944281 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1944284",
          "cefr_level": "A1",
          "word_slugs": [
            "hindurch-adv"
          ]
        }
      ],
