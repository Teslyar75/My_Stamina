    {
      "slug": "kellnerin-noun",
      "lemma": "Kellnerin",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6501,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "официантка"
        ],
        "en": [
          "waitress, waiter (female)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2696878",
          "text": "Maria ist Kellnerin.",
          "translation": "Мэри — официантка.",
          "source": "Tatoeba #2696878 @Pfirsichbaeumchen / #2816613 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2696878",
          "cefr_level": "A1",
          "word_slugs": [
            "kellnerin-noun"
          ]
        },
        {
          "id": "7357208",
          "text": "Die Kellnerin sah nichts.",
          "translation": "Официантка ничего не видела.",
          "source": "Tatoeba #7357208 @Esperantostern / #12072094 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7357208",
          "cefr_level": "A1",
          "word_slugs": [
            "kellnerin-noun"
          ]
        },
        {
          "id": "563846",
          "text": "Eine schöne Kellnerin bediente uns.",
          "translation": "Нас обслуживала хорошенькая официантка.",
          "source": "Tatoeba #563846 @Manfredo / #5405816 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/563846",
          "cefr_level": "A1",
          "word_slugs": [
            "kellnerin-noun"
          ]
        },
        {
          "id": "12249383",
          "text": "Sie entschuldigte sich bei der Kellnerin.",
          "translation": "Она извинилась перед официанткой.",
          "source": "Tatoeba #12249383 @mayabe / #12249385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12249383",
          "cefr_level": "A1",
          "word_slugs": [
            "kellnerin-noun"
          ]
        },
        {
          "id": "13405078",
          "text": "Die Kellnerin stellt Teller auf den Tisch.",
          "translation": "Официантка ставит тарелки на стол.",
          "source": "Tatoeba #13405078 @Vortarulo / #13611198 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13405078",
          "cefr_level": "A1",
          "word_slugs": [
            "kellnerin-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Kellnerin",
        "nominative_pl": ""
      }
