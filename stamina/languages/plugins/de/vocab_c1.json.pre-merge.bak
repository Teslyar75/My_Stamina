    {
      "slug": "hinterliess-verb",
      "lemma": "hinterließ",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6439,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of hinterlassen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3440979",
          "text": "Tom hinterließ eine Nachricht.",
          "translation": "Том оставил сообщение.",
          "source": "Tatoeba #3440979 @freddy1 / #4479787 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3440979",
          "cefr_level": "A1",
          "word_slugs": [
            "hinterliess-verb"
          ]
        },
        {
          "id": "13558366",
          "text": "Er hinterließ eine große Lücke.",
          "translation": "Он оставил после себя огромную пустоту.",
          "source": "Tatoeba #13558366 @Rovo / #13558384 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13558366",
          "cefr_level": "A1",
          "word_slugs": [
            "hinterliess-verb"
          ]
        },
        {
          "id": "8110276",
          "text": "Sie hinterließ mir eine Nachricht.",
          "translation": "Она оставила мне записку.",
          "source": "Tatoeba #8110276 @Pfirsichbaeumchen / #5207578 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8110276",
          "cefr_level": "A1",
          "word_slugs": [
            "hinterliess-verb"
          ]
        },
        {
          "id": "1323849",
          "text": "Er hinterließ ihr alles durch sein Testament.",
          "translation": "В своём завещании он всё оставил ей.",
          "source": "Tatoeba #1323849 @samueldora / #13974596 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1323849",
          "cefr_level": "A1",
          "word_slugs": [
            "hinterliess-verb"
          ]
        },
        {
          "id": "741305",
          "text": "Der Briefträger hinterließ einen Brief für sie.",
          "translation": "Почтальон оставил для неё письмо.",
          "source": "Tatoeba #741305 @Manfredo / #1927864 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/741305",
          "cefr_level": "A1",
          "word_slugs": [
            "hinterliess-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
