    {
      "slug": "passte-verb",
      "lemma": "passte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9546,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of passen:",
          "first/third-person singular preterite",
          "inflection of passen:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "640693",
          "text": "Sie passte auf meinen Hund auf.",
          "translation": "Она позаботилась о моей собаке.",
          "source": "Tatoeba #640693 @Manfredo / #14030693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/640693",
          "cefr_level": "A1",
          "word_slugs": [
            "passte-verb"
          ]
        },
        {
          "id": "726792",
          "text": "Er passte sich den Umständen an.",
          "translation": "Он подстроился под обстоятельства.",
          "source": "Tatoeba #726792 @tatomeimei / #645458 @nami (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/726792",
          "cefr_level": "A1",
          "word_slugs": [
            "passte-verb"
          ]
        },
        {
          "id": "371117",
          "text": "Seine Kleidung passte nicht zu seinem Alter.",
          "translation": "Он был одет не по возрасту.",
          "source": "Tatoeba #371117 @xtofu80 / #8299453 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/371117",
          "cefr_level": "A1",
          "word_slugs": [
            "passte-verb"
          ]
        },
        {
          "id": "596886",
          "text": "Er passte sich an sein neues Leben an.",
          "translation": "Он приспособился к новой жизни.",
          "source": "Tatoeba #596886 @cost / #2629347 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/596886",
          "cefr_level": "A1",
          "word_slugs": [
            "passte-verb"
          ]
        },
        {
          "id": "3939763",
          "text": "Der Rock passte nicht, daher musste ich ihn ändern.",
          "translation": "Юбка плохо сидела, поэтому мне пришлось её переделать.",
          "source": "Tatoeba #3939763 @Dani6187 / #2450042 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3939763",
          "cefr_level": "A1",
          "word_slugs": [
            "passte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
