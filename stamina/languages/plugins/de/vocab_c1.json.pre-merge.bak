    {
      "slug": "benimmst-verb",
      "lemma": "benimmst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7100,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of benehmen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1909145",
          "text": "Du benimmst dich wie ein Kind.",
          "translation": "Ты ведёшь себя как ребёнок.",
          "source": "Tatoeba #1909145 @Pfirsichbaeumchen / #4066474 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1909145",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmst-verb"
          ]
        },
        {
          "id": "3380157",
          "text": "Du benimmst dich wie ein Idiot.",
          "translation": "Ты ведёшь себя как дурак.",
          "source": "Tatoeba #3380157 @freddy1 / #3539897 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3380157",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmst-verb"
          ]
        },
        {
          "id": "5594825",
          "text": "Du benimmst dich wie ein Kleinkind.",
          "translation": "Ты ведёшь себя как маленький ребёнок.",
          "source": "Tatoeba #5594825 @list / #5594840 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5594825",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmst-verb"
          ]
        },
        {
          "id": "6952695",
          "text": "Warum benimmst du dich so merkwürdig?",
          "translation": "Почему ты так странно себя ведёшь?",
          "source": "Tatoeba #6952695 @Pfirsichbaeumchen / #6949243 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6952695",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmst-verb"
          ]
        },
        {
          "id": "3036781",
          "text": "Erkläre mir, warum du dich so benimmst!",
          "translation": "Объясни мне, почему ты так себя ведёшь.",
          "source": "Tatoeba #3036781 @Pfirsichbaeumchen / #3036689 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3036781",
          "cefr_level": "A1",
          "word_slugs": [
            "benimmst-verb"
          ]
        }
