          "inflection of dicht:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "450228",
          "text": "Der Nebel wird dichter.",
          "translation": "Туман сгущается.",
          "source": "Tatoeba #450228 @al_ex_an_der / #2970276 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/450228",
          "cefr_level": "A1",
          "word_slugs": [
            "dichter-adj"
          ]
        },
        {
          "id": "9777125",
          "text": "Ringsherum herrschte dichter Nebel.",
          "translation": "Вокруг стоял густой туман.",
          "source": "Tatoeba #9777125 @GaryGaryGary / #2013782 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9777125",
          "cefr_level": "A1",
          "word_slugs": [
            "dichter-adj"
          ]
        },
        {
          "id": "4046237",
          "text": "Der Schnee fiel immer dichter.",
          "translation": "Снег становился всё плотнее.",
          "source": "Tatoeba #4046237 @Esperantostern / #5626543 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4046237",
          "cefr_level": "A1",
          "word_slugs": [
            "dichter-adj"
          ]
        },
        {
          "id": "543590",
          "text": "Der Nebel wurde schnell dichter.",
          "translation": "Туман быстро сгущался.",
          "source": "Tatoeba #543590 @al_ex_an_der / #1464672 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/543590",
          "cefr_level": "A1",
          "word_slugs": [
            "dichter-adj"
          ]
        },
        {
          "id": "3715375",
          "text": "Heute fällt in meiner Stadt dichter Schnee.",
          "translation": "Сегодня у нас в городе идёт густой снег.",
          "source": "Tatoeba #3715375 @kolonjano / #3715123 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3715375",
          "cefr_level": "A1",
          "word_slugs": [
            "dichter-adj"
          ]
        }
