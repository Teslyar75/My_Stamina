      "gender": null,
      "examples": [
        {
          "id": "14081240",
          "text": "Das Training war sehr anstrengend. Ich konnte kaum atmen.",
          "translation": "Тренировка была очень утомительной. Я еле дышал.",
          "source": "Tatoeba #14081240 @Ioan_Cristian / #14092715 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14081240",
          "cefr_level": "A1",
          "word_slugs": [
            "anstrengend-verb"
          ]
        },
        {
          "id": "1226279",
          "text": "Gleichzeitig zu studieren und zu arbeiten ist sehr anstrengend.",
          "translation": "Трудно совмещать учёбу и работу.",
          "source": "Tatoeba #1226279 @al_ex_an_der / #1993467 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1226279",
          "cefr_level": "A1",
          "word_slugs": [
