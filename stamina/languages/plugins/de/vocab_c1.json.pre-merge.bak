      "gender": null,
      "examples": [
        {
          "id": "13100551",
          "text": "Das ist die neueste Technologie.",
          "translation": "Это новейшая технология.",
          "source": "Tatoeba #13100551 @mhr / #13100516 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13100551",
          "cefr_level": "A1",
          "word_slugs": [
            "neueste-adj"
          ]
        },
        {
          "id": "7951513",
          "text": "Soviel ich weiß, ist das die neueste Ausgabe.",
          "translation": "Насколько я знаю, это самое последнее издание.",
          "source": "Tatoeba #7951513 @raggione / #13674086 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7951513",
          "cefr_level": "A1",
          "word_slugs": [
            "neueste-adj"
          ]
        },
        {
          "id": "3245741",
          "text": "Wie ärgerlich! Die neueste Auflage von Toms Kindheitserinnerungen ist schon wieder vergriffen.",
          "translation": "Как досадно! Новейший тираж детских воспоминаний Тома снова весь раскупили.",
          "source": "Tatoeba #3245741 @raggione / #3246178 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3245741",
          "cefr_level": "A1",
          "word_slugs": [
            "neueste-adj"
          ]
        }
      ],
