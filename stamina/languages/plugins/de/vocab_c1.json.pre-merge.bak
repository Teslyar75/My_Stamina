    {
      "slug": "folgende-adj",
      "lemma": "folgende",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7069,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of folgend:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of folgend:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6935535",
          "text": "Ich würde die folgende Änderung vorschlagen.",
          "translation": "Я бы предложил следующее изменение.",
          "source": "Tatoeba #6935535 @moskytoo / #8812629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6935535",
          "cefr_level": "A1",
          "word_slugs": [
            "folgende-adj"
          ]
        },
        {
          "id": "3298077",
          "text": "Meine bevorzugte Übersetzung ist die folgende.",
          "translation": "Мне больше всего нравится этот перевод.",
          "source": "Tatoeba #3298077 @al_ex_an_der / #3298075 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3298077",
          "cefr_level": "A1",
          "word_slugs": [
            "folgende-adj"
          ]
        },
        {
          "id": "1846958",
          "text": "Während der Projektlaufzeit sind folgende Arbeiten auszuführen.",
          "translation": "В течение срока действия проекта должны быть выполнены следующие работы.",
          "source": "Tatoeba #1846958 @al_ex_an_der / #1846956 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1846958",
          "cefr_level": "A1",
          "word_slugs": [
            "folgende-adj"
          ]
        },
        {
          "id": "1846959",
          "text": "Während der Projektlaufzeit müssen folgende Arbeiten ausgeführt werden.",
          "translation": "В течение срока действия проекта должны быть выполнены следующие работы.",
          "source": "Tatoeba #1846959 @al_ex_an_der / #1846956 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1846959",
          "cefr_level": "A1",
          "word_slugs": [
            "folgende-adj"
          ]
        },
        {
          "id": "1991518",
          "text": "Der folgende Satz ist wahr. Der vorhergehende Satz ist falsch.",
          "translation": "Следующее предложение истинно. Предыдущее предложение ложно.",
          "source": "Tatoeba #1991518 @Tamy / #4459327 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1991518",
          "cefr_level": "A1",
          "word_slugs": [
            "folgende-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
