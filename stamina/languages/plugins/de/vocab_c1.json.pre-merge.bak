    {
      "slug": "johannes-name",
      "lemma": "Johannes",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7928,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "John.",
          "a male given name from Late Latin Iōhannēs [in turn from Koine Greek Ἰωάννης (Iōánnēs), in turn from Biblical Hebrew יוֹחָנָן (Yôḥānān, “God is gracious”)], equivalent to English J"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3460344",
          "text": "Bist du Johannes?",
          "translation": "Ты Джон?",
          "source": "Tatoeba #3460344 @Pfirsichbaeumchen / #1423541 @MikaM (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3460344",
          "cefr_level": "A1",
          "word_slugs": [
            "johannes-name"
          ]
        },
        {
          "id": "3753183",
          "text": "Johannes ist traurig.",
          "translation": "Йоханн грустит.",
          "source": "Tatoeba #3753183 @Esperantostern / #4407027 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3753183",
          "cefr_level": "A1",
          "word_slugs": [
            "johannes-name"
          ]
        },
        {
          "id": "2190057",
          "text": "Johannes hat fünf Äpfel.",
          "translation": "У Джона пять яблок.",
          "source": "Tatoeba #2190057 @Pfirsichbaeumchen / #3775508 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2190057",
          "cefr_level": "A1",
          "word_slugs": [
            "johannes-name"
          ]
        },
        {
          "id": "9941941",
          "text": "Johannes kam früh zurück.",
          "translation": "Жан вернулся рано.",
          "source": "Tatoeba #9941941 @manese / #10182114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9941941",
          "cefr_level": "A1",
          "word_slugs": [
            "johannes-name"
          ]
        },
        {
          "id": "10481459",
          "text": "Hast du Johannes gesehen?",
          "translation": "Ты Жана видел?",
          "source": "Tatoeba #10481459 @Pfirsichbaeumchen / #10481227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10481459",
          "cefr_level": "A1",
