          ]
        },
        {
          "id": "6469964",
          "text": "Tom sammelte alte Münzen.",
          "translation": "Том коллекционировал старинные монеты.",
          "source": "Tatoeba #6469964 @wolfgangth / #5518708 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6469964",
          "cefr_level": "A1",
          "word_slugs": [
            "münzen-noun"
          ]
        },
        {
          "id": "707560",
          "text": "Ich sammle seltene Münzen.",
