          ]
        },
        {
          "id": "11071378",
          "text": "Meine Tochter Christina ist heute 19 Jahre alt geworden.",
          "translation": "Моей дочери Кристине сегодня исполнилось девятнадцать лет.",
          "source": "Tatoeba #11071378 @Pfirsichbaeumchen / #11071496 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11071378",
          "cefr_level": "A1",
