    {
      "slug": "stumm-adj",
      "lemma": "stumm",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7951,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "немой"
        ],
        "en": [
          "mute; dumb (unable to speak)",
          "silent (not speaking); with verbs or adverbs expressing a grade or temporary state",
          "non-verbal, not explicitly expressed; silent",
          "mute; silent (unpronounced)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "8244917",
          "text": "Tom wurde stumm.",
          "translation": "Том стал немым.",
          "source": "Tatoeba #8244917 @MisterTrouser / #13874929 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8244917",
          "cefr_level": "A1",
          "word_slugs": [
            "stumm-adj"
          ]
        },
        {
          "id": "1003992",
          "text": "Sie war blind, taub und stumm.",
          "translation": "Она была слепоглухонемой.",
          "source": "Tatoeba #1003992 @Pfirsichbaeumchen / #3342338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1003992",
          "cefr_level": "A1",
          "word_slugs": [
            "stumm-adj"
          ]
        },
        {
          "id": "1825111",
          "text": "Helen Keller war blind, taub und stumm.",
          "translation": "Хелен Келлер была слепой, глухой и немой.",
          "source": "Tatoeba #1825111 @pne / #6934924 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1825111",
          "cefr_level": "A1",
          "word_slugs": [
            "stumm-adj"
          ]
        },
        {
          "id": "2996242",
          "text": "Tom lächelte! Alle waren vor Erstaunen stumm.",
          "translation": "Том улыбнулся! Все онемели от удивления.",
          "source": "Tatoeba #2996242 @Pfirsichbaeumchen / #3008855 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2996242",
          "cefr_level": "A1",
          "word_slugs": [
            "stumm-adj"
          ]
        },
        {
          "id": "1234614",
          "text": "Tom kennt nicht den Unterschied zwischen taub und stumm.",
          "translation": "Том не знает разницы между глухотой и немотой.",
          "source": "Tatoeba #1234614 @al_ex_an_der / #1293693 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1234614",
          "cefr_level": "A1",
          "word_slugs": [
            "stumm-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der stumm",
        "nominative_pl": ""
      }
    },
