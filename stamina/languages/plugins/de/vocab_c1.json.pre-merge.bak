    {
      "slug": "mörderin-noun",
      "lemma": "Mörderin",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8059,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "убийца"
        ],
        "en": [
          "murderer, assassin, assassinator, cutthroat, killer, slayer (all female)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3477569",
          "text": "Ich weiß, wer die Mörderin ist.",
          "translation": "Я знаю, кто убийца.",
          "source": "Tatoeba #3477569 @Pfirsichbaeumchen / #3477505 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3477569",
          "cefr_level": "A1",
          "word_slugs": [
            "mörderin-noun"
          ]
        },
        {
          "id": "6547982",
          "text": "Die Zeit ist die Mörderin Nummer 1.",
          "translation": "Время - убийца номер один.",
          "source": "Tatoeba #6547982 @Pfirsichbaeumchen / #6553443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6547982",
          "cefr_level": "A1",
          "word_slugs": [
            "mörderin-noun"
          ]
        },
        {
          "id": "13616598",
          "text": "Die alte Frau Hansen ist die Mörderin. Wer hätte das gedacht!",
          "translation": "Старушка фрау Хансен – убийца. Кто бы мог подумать!",
          "source": "Tatoeba #13616598 @maaster / #13617190 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13616598",
          "cefr_level": "A1",
          "word_slugs": [
            "mörderin-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
