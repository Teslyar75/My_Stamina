      },
      "gender": null,
      "examples": [
        {
          "id": "13539914",
          "text": "Tom verdiente viel.",
          "translation": "Том много зарабатывал.",
          "source": "Tatoeba #13539914 @mhr / #13540177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13539914",
          "cefr_level": "A1",
