          ]
        },
        {
          "id": "11531917",
          "text": "Das ist der Gipfel der Dummheit.",
          "translation": "Это верх глупости.",
          "source": "Tatoeba #11531917 @Bernie75 / #2902994 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11531917",
          "cefr_level": "A1",
