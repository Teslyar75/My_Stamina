    {
      "slug": "kommunikation-noun",
      "lemma": "Kommunikation",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5411,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "communication, exchange of signs",
          "the imparting or sharing between of anything, communication",
          "Holy Communion or the incarnation of Christ believed to take place therein, communication",
          "connecting street, communication"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7046798",
          "text": "Was ist Gewaltfreie Kommunikation?",
          "translation": "Что такое ненасильственное общение?",
          "source": "Tatoeba #7046798 @list / #8050722 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7046798",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunikation-noun"
          ]
        },
        {
          "id": "13814785",
          "text": "Spontane Kommunikation ist nicht meine Stärke.",
          "translation": "Спонтанная коммуникация не моя сильная сторона.",
          "source": "Tatoeba #13814785 @mhr / #13814280 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13814785",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunikation-noun"
          ]
        },
        {
          "id": "397842",
          "text": "Die englische Sprache ist ein Mittel der Kommunikation.",
          "translation": "Английский язык является средством коммуникации.",
          "source": "Tatoeba #397842 @xtofu80 / #599863 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/397842",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunikation-noun"
          ]
        },
        {
          "id": "12700636",
          "text": "Sprache ist ein Mittel der Kommunikation zwischen Menschen.",
          "translation": "Язык - средство коммуникации между людьми.",
          "source": "Tatoeba #12700636 @carlosalberto / #11268804 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12700636",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunikation-noun"
          ]
        },
        {
          "id": "546",
          "text": "Was die Welt verändert, ist Kommunikation, nicht Information.",
          "translation": "Мир меняет коммуникация, а не информация.",
          "source": "Tatoeba #546 @MUIRIEL / #400667 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/546",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunikation-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
