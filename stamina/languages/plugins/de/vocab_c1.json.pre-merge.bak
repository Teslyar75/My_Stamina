          ]
        },
        {
          "id": "3262944",
          "text": "Ich habe eine ähnliche gesehen.",
          "translation": "Я видел похожую.",
          "source": "Tatoeba #3262944 @faehrmann / #13669744 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3262944",
          "cefr_level": "A1",
          "word_slugs": [
            "ähnliche-adj"
          ]
        },
        {
          "id": "3085243",
          "text": "In vielem haben wir ähnliche Ansichten.",
          "translation": "Во многом его взгляды схожи с моими.",
          "source": "Tatoeba #3085243 @al_ex_an_der / #3085238 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3085243",
          "cefr_level": "A1",
          "word_slugs": [
