    {
      "slug": "hoffnungen-noun",
      "lemma": "Hoffnungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5730,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Hoffnung (“hopes”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1206468",
          "text": "Alle Hoffnungen sind vernichtet.",
          "translation": "Все надежды разрушены.",
          "source": "Tatoeba #1206468 @Esperantostern / #4946815 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1206468",
          "cefr_level": "A1",
          "word_slugs": [
            "hoffnungen-noun"
          ]
        },
        {
          "id": "1706291",
          "text": "Alle Hoffnungen hatten sich verflüchtigt.",
          "translation": "Все надежды испарились.",
          "source": "Tatoeba #1706291 @al_ex_an_der / #13759928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1706291",
          "cefr_level": "A1",
          "word_slugs": [
            "hoffnungen-noun"
          ]
        },
        {
          "id": "11108255",
          "text": "Ich setze in Tom große Hoffnungen.",
          "translation": "Я возлагаю на Тома большие надежды.",
          "source": "Tatoeba #11108255 @Pfirsichbaeumchen / #5204791 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11108255",
          "cefr_level": "A1",
          "word_slugs": [
            "hoffnungen-noun"
          ]
        },
        {
          "id": "1569304",
          "text": "Mach dir nicht zu viele Hoffnungen.",
          "translation": "Не возлагай слишком больших надежд.",
          "source": "Tatoeba #1569304 @Pfirsichbaeumchen / #2482112 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1569304",
          "cefr_level": "A1",
          "word_slugs": [
            "hoffnungen-noun"
          ]
        },
        {
          "id": "591977",
          "text": "Ich will keine falschen Hoffnungen wecken.",
          "translation": "Я не хочу пробуждать ложных надежд.",
          "source": "Tatoeba #591977 @cost / #2779146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/591977",
          "cefr_level": "A1",
          "word_slugs": [
            "hoffnungen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
