    {
      "slug": "serviert-verb",
      "lemma": "serviert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6464,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of servieren:",
          "third-person singular present",
          "inflection of servieren:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "761408",
          "text": "Wann wird das Abendessen serviert?",
          "translation": "Когда подадут ужин?",
          "source": "Tatoeba #761408 @Pfirsichbaeumchen / #11383504 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/761408",
          "cefr_level": "A1",
          "word_slugs": [
            "serviert-verb"
          ]
        },
        {
          "id": "823360",
          "text": "Nach dem Essen wird Kaffee serviert.",
          "translation": "После еды подадут кофе.",
          "source": "Tatoeba #823360 @Pfirsichbaeumchen / #11058633 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/823360",
          "cefr_level": "A1",
          "word_slugs": [
            "serviert-verb"
          ]
        },
        {
          "id": "8726820",
          "text": "Das Frühstück wird um 8 Uhr serviert.",
          "translation": "Завтрак подают в восемь часов.",
          "source": "Tatoeba #8726820 @Melang / #10126935 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8726820",
          "cefr_level": "A1",
          "word_slugs": [
            "serviert-verb"
          ]
        },
        {
          "id": "13075746",
          "text": "Das Abendessen wird um acht Uhr serviert.",
          "translation": "Ужин подадут в восемь часов.",
          "source": "Tatoeba #13075746 @mhr / #13075617 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13075746",
          "cefr_level": "A1",
          "word_slugs": [
            "serviert-verb"
          ]
        },
        {
          "id": "1653870",
          "text": "Das Abendessen wird neun Uhr dreißig serviert.",
          "translation": "Ужин подают в девять тридцать.",
          "source": "Tatoeba #1653870 @al_ex_an_der / #8256970 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1653870",
          "cefr_level": "A1",
          "word_slugs": [
            "serviert-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
