          "cefr_level": "A1",
          "word_slugs": [
            "backen-verb"
          ]
        },
        {
          "id": "8636749",
          "text": "Kannst du einen Kuchen backen?",
          "translation": "Ты можешь испечь пирог?",
          "source": "Tatoeba #8636749 @Melang / #8639050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636749",
