    {
      "slug": "verursachen-verb",
      "lemma": "verursachen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6005,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to cause, to induce"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6120506",
          "text": "Rauchen kann Brustkrebs verursachen.",
          "translation": "Курение может вызвать рак груди.",
          "source": "Tatoeba #6120506 @Pfirsichbaeumchen / #2749010 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6120506",
          "cefr_level": "A1",
          "word_slugs": [
            "verursachen-verb"
          ]
        },
        {
          "id": "14067202",
          "text": "Der Sturm wird Schäden verursachen.",
          "translation": "Буря причинит ущерб.",
          "source": "Tatoeba #14067202 @mhr / #14066768 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067202",
          "cefr_level": "A1",
          "word_slugs": [
            "verursachen-verb"
          ]
        },
        {
          "id": "12728903",
          "text": "Viren können schwere Krankheiten verursachen.",
          "translation": "Вирусы могут вызывать серьёзные болезни.",
          "source": "Tatoeba #12728903 @mhr / #12728896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12728903",
          "cefr_level": "A1",
          "word_slugs": [
            "verursachen-verb"
          ]
        },
        {
          "id": "2277934",
          "text": "Sonne und Mond verursachen die Gezeiten.",
          "translation": "Солнце и Луна вызывают приливы и отливы.",
          "source": "Tatoeba #2277934 @brauchinet / #6797524 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2277934",
          "cefr_level": "A1",
          "word_slugs": [
            "verursachen-verb"
          ]
        },
        {
          "id": "2262141",
          "text": "Ein wenig stärkerer Regen könnte Überschwemmungen verursachen.",
          "translation": "Чуть более сильный дождь мог бы вызвать наводнения.",
          "source": "Tatoeba #2262141 @Zaghawa / #12432778 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2262141",
          "cefr_level": "A1",
          "word_slugs": [
            "verursachen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
