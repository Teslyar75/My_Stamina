    {
      "slug": "bildet-verb",
      "lemma": "bildet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7974,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bilden:",
          "third-person singular present",
          "inflection of bilden:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2650642",
          "text": "Tom bildet den Spott für alle.",
          "translation": "Том является всеобщим посмешищем.",
          "source": "Tatoeba #2650642 @Olya / #2650643 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650642",
          "cefr_level": "A1",
          "word_slugs": [
            "bildet-verb"
          ]
        },
        {
          "id": "1361688",
          "text": "Bildet einen Satz mit drei Verben!",
          "translation": "Составьте предложение с тремя глаголами.",
          "source": "Tatoeba #1361688 @al_ex_an_der / #12268623 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1361688",
          "cefr_level": "A1",
          "word_slugs": [
            "bildet-verb"
          ]
        },
        {
          "id": "2650648",
          "text": "Maria bildet sich viel auf ihre Schönheit ein.",
          "translation": "Мария мнит себя красавицей.",
          "source": "Tatoeba #2650648 @Olya / #2650649 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650648",
          "cefr_level": "A1",
          "word_slugs": [
            "bildet-verb"
          ]
        },
        {
          "id": "2233550",
          "text": "Bildet einen Kreis, und haltet euch bei den Händen!",
          "translation": "Встаньте в круг и возьмитесь за руки!",
          "source": "Tatoeba #2233550 @Pfirsichbaeumchen / #2340138 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2233550",
          "cefr_level": "A1",
          "word_slugs": [
            "bildet-verb"
          ]
        },
        {
          "id": "3529228",
          "text": "Russland bildet die Vorhut der revolutionären Aktion in Europa.",
          "translation": "Россия представляет собой авангард революционной борьбы в Европе.",
          "source": "Tatoeba #3529228 @al_ex_an_der / #3531000 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3529228",
          "cefr_level": "A1",
          "word_slugs": [
            "bildet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
