      "examples": [
        {
          "id": "9399929",
          "text": "Dieser Text ist unverständlich.",
          "translation": "Этот текст невозможно понять.",
          "source": "Tatoeba #9399929 @felix63 / #9998861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9399929",
          "cefr_level": "A1",
          "word_slugs": [
            "unverständlich-adj"
          ]
        },
        {
          "id": "13808450",
          "text": "Dieser Satz ist vollkommen unverständlich.",
          "translation": "Это предложение совершенно непонятно.",
          "source": "Tatoeba #13808450 @Waldelfe / #13853079 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13808450",
          "cefr_level": "A1",
          "word_slugs": [
