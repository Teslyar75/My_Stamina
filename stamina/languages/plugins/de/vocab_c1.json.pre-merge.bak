    {
      "slug": "wünschst-verb",
      "lemma": "wünschst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7561,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of wünschen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2707766",
          "text": "Was wünschst du dir zum Geburtstag?",
          "translation": "Что ты хочешь на день рождения?",
          "source": "Tatoeba #2707766 @Pfirsichbaeumchen / #2897021 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2707766",
          "cefr_level": "A1",
          "word_slugs": [
            "wünschst-verb"
          ]
        },
        {
          "id": "8236082",
          "text": "Was wünschst du deinen Eltern zu Weihnachten?",
          "translation": "Что ты желаешь родителям на Рождество?",
          "source": "Tatoeba #8236082 @Pfirsichbaeumchen / #6566333 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8236082",
          "cefr_level": "A1",
          "word_slugs": [
            "wünschst-verb"
          ]
        },
        {
          "id": "7463716",
          "text": "Was wünschst du deinen Freunden zum neuen Jahr?",
          "translation": "Что ты желаешь друзьям на Новый год?",
          "source": "Tatoeba #7463716 @Pfirsichbaeumchen / #6566332 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7463716",
          "cefr_level": "A1",
          "word_slugs": [
            "wünschst-verb"
          ]
        },
        {
          "id": "677934",
          "text": "\"Wünschst du dir das wirklich?\", fragte das kleine weiße Kaninchen.",
          "translation": "\"Ты действительно этого хочешь?\" - спросил маленький белый кролик.",
          "source": "Tatoeba #677934 @ELPHONY / #2124251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/677934",
          "cefr_level": "A1",
          "word_slugs": [
            "wünschst-verb"
          ]
        },
        {
          "id": "2249922",
          "text": "Sei du selbst die Veränderung, die du dir wünschst für diese Welt.",
          "translation": "Будь сам тем изменением, которое ты хочешь видеть в мире.",
          "source": "Tatoeba #2249922 @Esperantostern / #3882426 @perf124 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2249922",
          "cefr_level": "A1",
          "word_slugs": [
            "wünschst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
