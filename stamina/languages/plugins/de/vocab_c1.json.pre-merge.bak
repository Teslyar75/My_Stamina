    {
      "slug": "führten-verb",
      "lemma": "führten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7308,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of führen:",
          "first/third-person plural preterite",
          "inflection of führen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "691807",
          "text": "Ihre Bemühungen führten zu nichts.",
          "translation": "Ваши усилия ни к чему не привели.",
          "source": "Tatoeba #691807 @Manfredo / #4960407 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/691807",
          "cefr_level": "A1",
          "word_slugs": [
            "führten-verb"
          ]
        },
        {
          "id": "401748",
          "text": "Deine Bemühungen führten zum Erfolg.",
          "translation": "Твои усилия привели к успеху.",
          "source": "Tatoeba #401748 @xtofu80 / #879211 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/401748",
          "cefr_level": "A1",
          "word_slugs": [
            "führten-verb"
          ]
        },
        {
          "id": "1801002",
          "text": "Die Besitzer der Wohnung führten alle Arbeiten selbst aus.",
          "translation": "Все работы были выполнены самостоятельно владельцами квартиры.",
          "source": "Tatoeba #1801002 @al_ex_an_der / #1800993 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1801002",
          "cefr_level": "A1",
          "word_slugs": [
            "führten-verb"
          ]
        },
        {
          "id": "13584921",
          "text": "Sie führten eine Untersuchung durch, um herauszufinden, was geschehen ist.",
          "translation": "Они провели расследование, чтобы выяснить, что произошло.",
          "source": "Tatoeba #13584921 @mhr / #13584460 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13584921",
          "cefr_level": "A1",
          "word_slugs": [
            "führten-verb"
          ]
        },
        {
          "id": "1851887",
          "text": "Wir führten einen freundschaftlichen und konstruktiven Meinungsaustausch zu verschiedenen Themen.",
          "translation": "Мы провели дружеский и конструктивный обмен мнениями по различным вопросам.",
          "source": "Tatoeba #1851887 @al_ex_an_der / #1851872 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1851887",
          "cefr_level": "A1",
          "word_slugs": [
            "führten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
