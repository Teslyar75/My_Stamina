          ]
        },
        {
          "id": "2580850",
          "text": "Mein Gehör ist schlechter geworden.",
          "translation": "Я стал хуже слышать.",
          "source": "Tatoeba #2580850 @al_ex_an_der / #1534050 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2580850",
