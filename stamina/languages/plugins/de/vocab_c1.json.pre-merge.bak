        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4951299",
          "text": "Das ist starker Tobak.",
          "translation": "Это уже слишком.",
          "source": "Tatoeba #4951299 @raggione / #4951372 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4951299",
          "cefr_level": "A1",
