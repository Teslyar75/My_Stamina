    {
      "slug": "handys-noun",
      "lemma": "Handys",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5503,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Handy",
          "plural of Handy"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2453935",
          "text": "Android ist ein für Handys entwickeltes Betriebssystem.",
          "translation": "Андроид — это операционная система, разработанная для мобильных телефонов.",
          "source": "Tatoeba #2453935 @brauchinet / #2529506 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2453935",
          "cefr_level": "A1",
          "word_slugs": [
            "handys-noun"
          ]
        },
        {
          "id": "621903",
          "text": "Der Akku meines Handys funktioniert nicht mehr gut.",
          "translation": "Аккумулятор моего телефона уже не работает нормально.",
          "source": "Tatoeba #621903 @kolonjano / #3523046 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/621903",
          "cefr_level": "A1",
          "word_slugs": [
            "handys-noun"
          ]
        },
        {
          "id": "8934157",
          "text": "Endlich! Adobe lässt den Scheiß mit dem Flash für Handys.",
          "translation": "Наконец-то! Adobe бросает поддерживать этот херовый Flash для мобильников.",
          "source": "Tatoeba #8934157 @manese / #9525704 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8934157",
          "cefr_level": "A1",
          "word_slugs": [
            "handys-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
