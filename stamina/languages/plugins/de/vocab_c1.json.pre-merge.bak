    {
      "slug": "aufräumen-verb",
      "lemma": "aufräumen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5606,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "убрать"
        ],
        "en": [
          "to tidy up"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "359528",
          "text": "Ich muss mein Zimmer aufräumen.",
          "translation": "Мне нужно сделать уборку в своей комнате.",
          "source": "Tatoeba #359528 @MUIRIEL / #800406 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/359528",
          "cefr_level": "A1",
          "word_slugs": [
            "aufräumen-verb"
          ]
        },
        {
          "id": "9422095",
          "text": "Du musst dein Zimmer aufräumen.",
          "translation": "Ты должен убраться у себя в комнате.",
          "source": "Tatoeba #9422095 @Yorwba / #9459320 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9422095",
          "cefr_level": "A1",
          "word_slugs": [
            "aufräumen-verb"
          ]
        },
        {
          "id": "353314",
          "text": "Er musste sein Zimmer aufräumen.",
          "translation": "Ему надо было убраться у себя в комнате.",
          "source": "Tatoeba #353314 @MUIRIEL / #4461615 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/353314",
          "cefr_level": "A1",
          "word_slugs": [
            "aufräumen-verb"
          ]
        },
        {
          "id": "705954",
          "text": "Ich muss meine Wohnung aufräumen.",
          "translation": "Мне нужно убраться в своей квартире.",
          "source": "Tatoeba #705954 @Pfirsichbaeumchen / #4246497 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/705954",
          "cefr_level": "A1",
          "word_slugs": [
            "aufräumen-verb"
          ]
        },
        {
          "id": "13464553",
          "text": "Lasst uns unser Zimmer aufräumen.",
          "translation": "Давайте уберёмся в нашей комнате.",
          "source": "Tatoeba #13464553 @Tom9358 / #12783099 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13464553",
          "cefr_level": "A1",
          "word_slugs": [
            "aufräumen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
