    {
      "slug": "ohnehin-adv",
      "lemma": "ohnehin",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6070,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "in any case, anyway, either way",
          "already (further exacerbating the existing situation)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11112001",
          "text": "Ich wollte ohnehin nicht dahin.",
          "translation": "Я всё равно не хотел туда ехать.",
          "source": "Tatoeba #11112001 @Pfirsichbaeumchen / #7862968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11112001",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnehin-adv"
          ]
        },
        {
          "id": "9005646",
          "text": "Wir wollen ohnehin nicht wiederkommen.",
          "translation": "Мы в любом случае не хотим возвращаться.",
          "source": "Tatoeba #9005646 @Pfirsichbaeumchen / #8996424 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9005646",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnehin-adv"
          ]
        },
        {
          "id": "2493969",
          "text": "Du wolltest ja ohnehin nie lernen.",
          "translation": "Всё равно ты никогда не хотел учиться.",
          "source": "Tatoeba #2493969 @Pfirsichbaeumchen / #2493897 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2493969",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnehin-adv"
          ]
        },
        {
          "id": "13879947",
          "text": "Ich werde ohnehin schon schief angeschaut.",
          "translation": "На меня и так уже косо смотрят.",
          "source": "Tatoeba #13879947 @mhr / #13879922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13879947",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnehin-adv"
          ]
        },
        {
          "id": "13875382",
          "text": "Ich mag sie ohnehin nicht besonders leiden.",
          "translation": "Мне она всё равно не очень нравится.",
          "source": "Tatoeba #13875382 @Waldelfe / #6702810 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13875382",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnehin-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
