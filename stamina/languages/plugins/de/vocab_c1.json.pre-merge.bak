    {
      "slug": "nagel-noun",
      "lemma": "Nagel",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6583,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "нагель"
        ],
        "en": [
          "A nail, the horny plate on fingers and toes of humans and certain animals which mostly consists of keratin.",
          "A nail, a man-made pointed fastener used for joining different materials by penetrating them."
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "1550127",
          "text": "Im Reifen steckte ein Nagel.",
          "translation": "В покрышке торчал гвоздь.",
          "source": "Tatoeba #1550127 @Pfirsichbaeumchen / #10626219 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1550127",
          "cefr_level": "A1",
          "word_slugs": [
            "nagel-noun"
          ]
        },
        {
          "id": "755458",
          "text": "Der Nagel zerriss seine Jacke.",
          "translation": "Гвоздь порвал его пиджак.",
          "source": "Tatoeba #755458 @Pfirsichbaeumchen / #1933942 @Aleksander (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/755458",
          "cefr_level": "A1",
          "word_slugs": [
            "nagel-noun"
          ]
        },
        {
          "id": "1585056",
          "text": "Mir ist der Nagel abgebrochen.",
          "translation": "У меня отломился ноготь.",
          "source": "Tatoeba #1585056 @Grim_fandango / #1591883 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1585056",
          "cefr_level": "A1",
          "word_slugs": [
            "nagel-noun"
          ]
        },
        {
          "id": "4724533",
          "text": "Ich habe einen abgebrochenen Nagel.",
          "translation": "У меня ноготь сломан.",
          "source": "Tatoeba #4724533 @bonny37 / #12783479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4724533",
          "cefr_level": "A1",
          "word_slugs": [
            "nagel-noun"
          ]
        },
        {
          "id": "1550129",
          "text": "Der Nagel ging durch die Wand.",
          "translation": "Гвоздь пробил стену.",
          "source": "Tatoeba #1550129 @Pfirsichbaeumchen / #1191670 @Keiden (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1550129",
          "cefr_level": "A1",
          "word_slugs": [
            "nagel-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
