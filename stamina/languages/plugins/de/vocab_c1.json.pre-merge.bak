    {
      "slug": "süchtig-adj",
      "lemma": "süchtig",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8038,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "addicted"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1530557",
          "text": "Es macht auf seltsame Weise süchtig.",
          "translation": "Странным образом это вызывает привыкание.",
          "source": "Tatoeba #1530557 @Pfirsichbaeumchen / #1530565 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1530557",
          "cefr_level": "A1",
          "word_slugs": [
            "süchtig-adj"
          ]
        },
        {
          "id": "2966999",
          "text": "Ich heiße Tom und ich bin süchtig.",
          "translation": "Меня зовут Том, и я наркоман.",
          "source": "Tatoeba #2966999 @Pfirsichbaeumchen / #2960924 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2966999",
          "cefr_level": "A1",
          "word_slugs": [
            "süchtig-adj"
          ]
        },
        {
          "id": "11523358",
          "text": "Hör auf zu trinken! Du bist süchtig!",
          "translation": "Прекращай пить! У тебя зависимость!",
          "source": "Tatoeba #11523358 @Bernie75 / #2005861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11523358",
          "cefr_level": "A1",
          "word_slugs": [
            "süchtig-adj"
          ]
        }
      ],
