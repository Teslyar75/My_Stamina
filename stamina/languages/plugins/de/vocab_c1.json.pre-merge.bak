          "cefr_level": "A1",
          "word_slugs": [
            "winkel-noun"
          ]
        },
        {
          "id": "3519712",
          "text": "Maria kennt hier jeden Winkel.",
          "translation": "Мэри здесь каждый уголок знает.",
          "source": "Tatoeba #3519712 @al_ex_an_der / #3519861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3519712",
          "cefr_level": "A1",
          "word_slugs": [
            "winkel-noun"
          ]
        },
        {
          "id": "3046014",
          "text": "Messe jeden Winkel des Dreieckes.",
          "translation": "Измерь все углы треугольника.",
          "source": "Tatoeba #3046014 @Manfredo / #9151779 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3046014",
          "cefr_level": "A1",
