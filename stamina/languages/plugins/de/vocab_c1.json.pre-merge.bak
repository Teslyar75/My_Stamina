    {
      "slug": "positive-adj",
      "lemma": "positive",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8288,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
