    {
      "slug": "münze-noun",
      "lemma": "Münze",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5968,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "money, in its senses as",
          "a coin, a metallic piece of currency",
          "money, in its senses as",
          "coinage, a system of currency"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7413772",
          "text": "Wirf eine Münze.",
          "translation": "Подбрось монету.",
          "source": "Tatoeba #7413772 @Yorwba / #5887413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7413772",
          "cefr_level": "A1",
          "word_slugs": [
            "münze-noun"
          ]
        },
        {
          "id": "7413774",
          "text": "Werft eine Münze.",
          "translation": "Подбросьте монету.",
          "source": "Tatoeba #7413774 @Yorwba / #5887414 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7413774",
          "cefr_level": "A1",
          "word_slugs": [
            "münze-noun"
          ]
        },
        {
          "id": "2238186",
          "text": "Hast du eine Münze?",
          "translation": "У тебя есть монета?",
          "source": "Tatoeba #2238186 @Vortarulo / #5666502 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2238186",
          "cefr_level": "A1",
          "word_slugs": [
            "münze-noun"
          ]
        },
        {
          "id": "12450440",
          "text": "Das ist eine Münze.",
          "translation": "Это монета.",
          "source": "Tatoeba #12450440 @Waldelfe / #13476275 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12450440",
          "cefr_level": "A1",
          "word_slugs": [
            "münze-noun"
          ]
        },
        {
          "id": "7413773",
          "text": "Werfen Sie eine Münze.",
          "translation": "Подбросьте монету.",
          "source": "Tatoeba #7413773 @Yorwba / #5887414 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7413773",
          "cefr_level": "A1",
