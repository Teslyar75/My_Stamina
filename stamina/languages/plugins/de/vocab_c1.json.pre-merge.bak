    {
      "slug": "anzunehmen-verb",
      "lemma": "anzunehmen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5904,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of annehmen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1843975",
          "text": "Sich anzunehmen ist nicht leicht.",
          "translation": "Принять самого себя нелегко.",
          "source": "Tatoeba #1843975 @al_ex_an_der / #7677640 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1843975",
          "cefr_level": "A1",
          "word_slugs": [
            "anzunehmen-verb"
          ]
        },
        {
          "id": "12411814",
          "text": "Ich bin bereit, Kritik anzunehmen.",
          "translation": "Я готов принять критику.",
          "source": "Tatoeba #12411814 @Waldelfe / #10634558 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12411814",
          "cefr_level": "A1",
          "word_slugs": [
            "anzunehmen-verb"
          ]
        },
        {
          "id": "631691",
          "text": "Sie weigerte sich, Geld anzunehmen.",
          "translation": "Она отказалась принять деньги.",
          "source": "Tatoeba #631691 @kolonjano / #1591813 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/631691",
          "cefr_level": "A1",
          "word_slugs": [
            "anzunehmen-verb"
          ]
        },
        {
          "id": "12774023",
          "text": "Schlechte Angewohnheiten anzunehmen ist einfach.",
          "translation": "Вредные привычки приобрести легко.",
          "source": "Tatoeba #12774023 @mhr / #12773984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12774023",
          "cefr_level": "A1",
          "word_slugs": [
            "anzunehmen-verb"
          ]
        },
        {
          "id": "13336648",
          "text": "Ich riete euch, das Angebot anzunehmen.",
          "translation": "Я бы посоветовал вам принять предложение.",
          "source": "Tatoeba #13336648 @Waldelfe / #13324091 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13336648",
          "cefr_level": "A1",
          "word_slugs": [
            "anzunehmen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
