    {
      "slug": "merke-verb",
      "lemma": "merke",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5190,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of merken:",
          "first-person singular present",
          "inflection of merken:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13814052",
          "text": "Merke dir den Weg.",
          "translation": "Запомни дорогу.",
          "source": "Tatoeba #13814052 @Rovo / #13814072 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13814052",
          "cefr_level": "A1",
          "word_slugs": [
            "merke-verb"
          ]
        },
        {
          "id": "3684566",
          "text": "Merke dir diese Regeln!",
          "translation": "Запомни эти правила.",
          "source": "Tatoeba #3684566 @raggione / #2774665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3684566",
          "cefr_level": "A1",
          "word_slugs": [
            "merke-verb"
          ]
        },
        {
          "id": "653392",
          "text": "Hunde sind keine Menschen. Das merke dir als allererstes!",
          "translation": "Собаки - это не люди. Прежде всего, запомни это.",
          "source": "Tatoeba #653392 @Pfirsichbaeumchen / #2576050 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/653392",
          "cefr_level": "A1",
          "word_slugs": [
            "merke-verb"
          ]
        },
        {
          "id": "4059954",
          "text": "Ich bin zwar nicht nachtragend, aber ich merke mir alles.",
          "translation": "Хоть я и не злопамятна, но всё запоминаю.",
          "source": "Tatoeba #4059954 @Pfirsichbaeumchen / #4060634 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4059954",
          "cefr_level": "A1",
          "word_slugs": [
            "merke-verb"
          ]
        }
      ],
