    {
      "slug": "jedermann-pron",
      "lemma": "jedermann",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9089,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "everyone"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3507932",
          "text": "Jedermann muss das wissen.",
          "translation": "Это должен знать всякий.",
          "source": "Tatoeba #3507932 @al_ex_an_der / #3507928 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3507932",
          "cefr_level": "A1",
          "word_slugs": [
            "jedermann-pron"
          ]
        },
        {
          "id": "3531317",
          "text": "Jedermann hat Tom zugeschaut.",
          "translation": "Все смотрели на Тома.",
          "source": "Tatoeba #3531317 @max2525 / #2590752 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3531317",
          "cefr_level": "A1",
          "word_slugs": [
            "jedermann-pron"
          ]
        },
        {
          "id": "6859261",
          "text": "Sie gibt jedermann eine sorgfältige Diagnose.",
          "translation": "Она ставит каждому хорошо продуманный диагноз.",
          "source": "Tatoeba #6859261 @raggione / #6859282 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6859261",
          "cefr_level": "A1",
          "word_slugs": [
            "jedermann-pron"
          ]
        },
        {
          "id": "12420213",
          "text": "Ich weiß, daß meine Musik nichts für jedermann ist.",
          "translation": "Я знаю, что моя музыка не для всех.",
          "source": "Tatoeba #12420213 @Waldelfe / #13487575 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12420213",
          "cefr_level": "A1",
          "word_slugs": [
            "jedermann-pron"
          ]
        },
        {
          "id": "2978583",
          "text": "Das ist ein Gesetz, deshalb ist es auf jedermann anwendbar.",
          "translation": "Это закон, поэтому он применим к каждому.",
          "source": "Tatoeba #2978583 @gubaer / #2580135 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2978583",
          "cefr_level": "A1",
          "word_slugs": [
            "jedermann-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
