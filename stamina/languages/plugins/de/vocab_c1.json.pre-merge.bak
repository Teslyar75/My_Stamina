      "gender": "m",
      "examples": [
        {
          "id": "12767760",
          "text": "Sie fühlt sich fremd.",
          "translation": "Она чувствует себя чужой.",
          "source": "Tatoeba #12767760 @mhr / #12767368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12767760",
          "cefr_level": "A1",
          "word_slugs": [
            "fremd-adj"
          ]
        },
        {
          "id": "1720244",
          "text": "Ich war fremd in Boston.",
          "translation": "Я был чужим в Бостоне.",
          "source": "Tatoeba #1720244 @Pfirsichbaeumchen / #6741431 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1720244",
          "cefr_level": "A1",
          "word_slugs": [
            "fremd-adj"
          ]
        },
        {
          "id": "13635439",
          "text": "Einem Philosophen sollte Snobismus fremd sein.",
          "translation": "Философу должен быть чужд снобизм.",
          "source": "Tatoeba #13635439 @mhr / #13634936 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635439",
          "cefr_level": "A1",
          "word_slugs": [
            "fremd-adj"
          ]
        },
        {
          "id": "7463270",
          "text": "Alles, was Tom sah, war ihm fremd.",
          "translation": "Всё, что Том видел, было для него чужим.",
          "source": "Tatoeba #7463270 @felix63 / #12419074 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7463270",
          "cefr_level": "A1",
          "word_slugs": [
            "fremd-adj"
          ]
        },
        {
          "id": "13635442",
          "text": "Dem Philosophen sollte der Snobismus fremd sein.",
          "translation": "Философу должен быть чужд снобизм.",
          "source": "Tatoeba #13635442 @mhr / #13634936 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635442",
          "cefr_level": "A1",
          "word_slugs": [
            "fremd-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
