    {
      "slug": "meist-adj",
      "lemma": "meist",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5128,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "superlative degree of viel (“much; many”); most"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4701164",
          "text": "Tom ist sonntags meist zuhause.",
          "translation": "По воскресеньям Том по большей части дома.",
          "source": "Tatoeba #4701164 @dannylow / #4701176 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4701164",
          "cefr_level": "A1",
          "word_slugs": [
            "meist-adj"
          ]
        },
        {
          "id": "2946000",
          "text": "Verbrecher sind meist naiv wie Kinder.",
          "translation": "Чаще всего преступники наивны как дети.",
          "source": "Tatoeba #2946000 @al_ex_an_der / #2945996 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2946000",
          "cefr_level": "A1",
          "word_slugs": [
            "meist-adj"
          ]
        },
        {
          "id": "6388969",
          "text": "Ich komme meist um sieben Uhr herum nach Hause.",
          "translation": "Я в основном возвращаюсь домой около семи.",
          "source": "Tatoeba #6388969 @Pfirsichbaeumchen / #2812240 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6388969",
          "cefr_level": "A1",
          "word_slugs": [
            "meist-adj"
          ]
        },
        {
          "id": "455262",
          "text": "Das Wasser in Seen und Flüssen ist meist Süßwasser.",
          "translation": "Вода в реках и озёрах чаще всего пресная.",
          "source": "Tatoeba #455262 @xtofu80 / #10321638 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455262",
          "cefr_level": "A1",
          "word_slugs": [
            "meist-adj"
          ]
        },
        {
          "id": "2694293",
          "text": "Die Wahrheit liegt meist am Rande, nicht in der Mitte.",
          "translation": "Истина чаще всего находится с краю, а не в центре.",
          "source": "Tatoeba #2694293 @Esperantostern / #3766405 @coolmona (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2694293",
          "cefr_level": "A1",
          "word_slugs": [
            "meist-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der meist",
        "nominative_pl": ""
      }
    },
