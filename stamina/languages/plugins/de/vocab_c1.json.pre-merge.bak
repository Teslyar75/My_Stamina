          ]
        },
        {
          "id": "5708529",
          "text": "Tom hatte einen leichten Herzinfarkt.",
          "translation": "У Тома случился лёгкий сердечный приступ.",
          "source": "Tatoeba #5708529 @Pfirsichbaeumchen / #4036409 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5708529",
          "cefr_level": "A1",
          "word_slugs": [
            "leichten-adj"
          ]
        },
        {
          "id": "1916587",
          "text": "Diese Milch hat einen leichten Stich.",
          "translation": "Это молоко скисло.",
          "source": "Tatoeba #1916587 @Zaghawa / #2576281 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1916587",
          "cefr_level": "A1",
          "word_slugs": [
            "leichten-adj"
          ]
        },
        {
          "id": "11137414",
          "text": "Tom hat einen leichten deutschen Akzent.",
          "translation": "У Тома лёгкий немецкий акцент.",
          "source": "Tatoeba #11137414 @Pfirsichbaeumchen / #6943649 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11137414",
          "cefr_level": "A1",
          "word_slugs": [
