    {
      "slug": "araber-noun",
      "lemma": "Araber",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8205,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Arab, person from Arabia",
          "Arabian horse"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "6794511",
          "text": "Bist du Araber?",
          "translation": "Ты араб?",
          "source": "Tatoeba #6794511 @Pfirsichbaeumchen / #2943392 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6794511",
          "cefr_level": "A1",
          "word_slugs": [
            "araber-noun"
          ]
        },
        {
          "id": "518447",
          "text": "Wir sind Araber.",
          "translation": "Мы арабы.",
          "source": "Tatoeba #518447 @Espi / #404588 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/518447",
          "cefr_level": "A1",
          "word_slugs": [
            "araber-noun"
          ]
        },
        {
          "id": "5262688",
          "text": "Nicht alle Muslime sind Araber.",
          "translation": "Не все мусульмане - арабы.",
          "source": "Tatoeba #5262688 @Pfirsichbaeumchen / #5262068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5262688",
          "cefr_level": "A1",
          "word_slugs": [
            "araber-noun"
          ]
        },
        {
          "id": "13776114",
          "text": "Ich bin kein Araber, sondern Kurde.",
          "translation": "Я не араб, а курд.",
          "source": "Tatoeba #13776114 @mhr / #13777280 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13776114",
          "cefr_level": "A1",
          "word_slugs": [
            "araber-noun"
          ]
        },
        {
          "id": "2576294",
          "text": "Gebildete Araber begannen Norditalien auf Einladung der dortigen Herrscher zu besuchen.",
          "translation": "Образованные арабы стали посещать Северную Италию по приглашению тамошних властителей.",
          "source": "Tatoeba #2576294 @al_ex_an_der / #2576283 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2576294",
          "cefr_level": "A1",
          "word_slugs": [
            "araber-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Araber",
        "nominative_pl": ""
      }
    },
