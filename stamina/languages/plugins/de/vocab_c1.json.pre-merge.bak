    {
      "slug": "oberfläche-noun",
      "lemma": "Oberfläche",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5010,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "поверхность"
        ],
        "en": [
          "surface"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "10937778",
          "text": "Die Oberfläche des Sees war glatt.",
          "translation": "Поверхность озера была гладкой.",
          "source": "Tatoeba #10937778 @maaster / #10937781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10937778",
          "cefr_level": "A1",
          "word_slugs": [
            "oberfläche-noun"
          ]
        },
        {
          "id": "12713993",
          "text": "Die Oberfläche muss absolut glatt sein.",
          "translation": "Поверхность должна быть абсолютно гладкой.",
          "source": "Tatoeba #12713993 @mhr / #12713960 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12713993",
          "cefr_level": "A1",
          "word_slugs": [
            "oberfläche-noun"
          ]
        },
        {
          "id": "13052700",
          "text": "Die Blütenblätter trieben auf der Oberfläche des Wassers.",
          "translation": "Лепестки плавали на поверхности воды.",
          "source": "Tatoeba #13052700 @mhr / #13052616 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13052700",
          "cefr_level": "A1",
          "word_slugs": [
            "oberfläche-noun"
          ]
        },
        {
          "id": "13052699",
          "text": "Die Blütenblätter schwammen auf der Oberfläche des Wassers.",
          "translation": "Лепестки плавали на поверхности воды.",
          "source": "Tatoeba #13052699 @mhr / #13052616 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13052699",
          "cefr_level": "A1",
          "word_slugs": [
            "oberfläche-noun"
          ]
        },
        {
          "id": "947298",
          "text": "Deine Lippen sind so sanft wie die Oberfläche eines Kaktusses.",
          "translation": "Твои губы мягкие, как поверхность кактуса.",
          "source": "Tatoeba #947298 @Sudajaengi / #2962214 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/947298",
          "cefr_level": "A1",
          "word_slugs": [
            "oberfläche-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Oberfläche",
        "nominative_pl": ""
      }
    },
    {
