      "gender": null,
      "examples": [
        {
          "id": "7233557",
          "text": "Venedig ist eine schöne Stadt.",
          "translation": "Венеция — красивый город.",
          "source": "Tatoeba #7233557 @Pfirsichbaeumchen / #14097599 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7233557",
          "cefr_level": "A1",
