    {
      "slug": "sessel-noun",
      "lemma": "Sessel",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9180,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "кресло"
        ],
        "en": [
          "armchair, easy chair (comfortable chair with supports for the arms or elbows)",
          "chair (any item of furniture used for sitting by one person)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "8320888",
          "text": "Ich sitze im Sessel.",
          "translation": "Я сижу в кресле.",
          "source": "Tatoeba #8320888 @MisterTrouser / #12995854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320888",
          "cefr_level": "A1",
          "word_slugs": [
            "sessel-noun"
          ]
        },
        {
          "id": "8259392",
          "text": "Dieser Sessel ist sehr bequem.",
          "translation": "Это кресло очень удобное.",
          "source": "Tatoeba #8259392 @felix63 / #13273929 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8259392",
          "cefr_level": "A1",
          "word_slugs": [
            "sessel-noun"
          ]
        },
        {
          "id": "8819431",
          "text": "Warum sitzt du in meinem Sessel?",
          "translation": "Почему ты сидишь в моём кресле?",
          "source": "Tatoeba #8819431 @Pfirsichbaeumchen / #8819428 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8819431",
          "cefr_level": "A1",
          "word_slugs": [
            "sessel-noun"
          ]
        },
        {
          "id": "4431037",
          "text": "Ich finde diesen Sessel nicht bequem.",
          "translation": "Это кресло мне кажется неудобным.",
          "source": "Tatoeba #4431037 @Pfirsichbaeumchen / #4461372 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4431037",
          "cefr_level": "A1",
          "word_slugs": [
            "sessel-noun"
          ]
        },
        {
          "id": "3326109",
          "text": "Dort steht ein Sofa und ein Sessel.",
          "translation": "Там стоят диван и кресло.",
          "source": "Tatoeba #3326109 @al_ex_an_der / #2739531 @Natalia_Su (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3326109",
          "cefr_level": "A1",
          "word_slugs": [
            "sessel-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Sessel",
        "nominative_pl": ""
      }
    },
