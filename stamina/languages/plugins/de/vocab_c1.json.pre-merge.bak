    {
      "slug": "geopfert-verb",
      "lemma": "geopfert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5930,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of opfern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9950160",
          "text": "Tom hat mir die Dame geopfert.",
          "translation": "Том пожертвовал мне ферзя.",
          "source": "Tatoeba #9950160 @carlosalberto / #4138598 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9950160",
          "cefr_level": "A1",
          "word_slugs": [
