          "a municipality of Bavaria, Germany"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "531707",
          "text": "Ich heiße Wang.",
          "translation": "Меня зовут Ванг.",
          "source": "Tatoeba #531707 @samueldora / #481868 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/531707",
