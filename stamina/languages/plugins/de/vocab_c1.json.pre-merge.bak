            "freundes-noun"
          ]
        },
        {
          "id": "12004329",
          "text": "Tom ist ein Freund meines Freundes.",
          "translation": "Том — друг моего друга.",
          "source": "Tatoeba #12004329 @mhr / #1436430 @Avelesy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12004329",
          "cefr_level": "A1",
          "word_slugs": [
            "freundes-noun"
          ]
        },
        {
          "id": "10458489",
          "text": "Die Frau deines Freundes hasst mich.",
          "translation": "Жена твоего друга меня ненавидит.",
          "source": "Tatoeba #10458489 @koala / #10458561 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10458489",
          "cefr_level": "A1",
