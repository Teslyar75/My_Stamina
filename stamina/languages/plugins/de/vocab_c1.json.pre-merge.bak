    {
      "slug": "heran-adv",
      "lemma": "heran",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5526,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "вперед",
          "поближе",
          "сюда"
        ],
        "en": [
          "near, close to the speaker, over to (to the direction of the speaker or an object)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2020597",
          "text": "Ein Sturm zieht heran.",
          "translation": "Надвигается шторм.",
          "source": "Tatoeba #2020597 @al_ex_an_der / #2020602 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2020597",
          "cefr_level": "A1",
          "word_slugs": [
            "heran-adv"
          ]
        },
        {
          "id": "3562712",
          "text": "Sie schafften Wasser heran.",
          "translation": "Они принесли воды.",
          "source": "Tatoeba #3562712 @Esperantostern / #2906344 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3562712",
          "cefr_level": "A1",
          "word_slugs": [
            "heran-adv"
          ]
        },
        {
          "id": "12593912",
          "text": "An Marias Kochkünste kommt keiner heran.",
          "translation": "В искусстве готовки Марии нет равных.",
          "source": "Tatoeba #12593912 @Waldelfe / #12593929 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12593912",
          "cefr_level": "A1",
          "word_slugs": [
            "heran-adv"
          ]
        },
        {
          "id": "1935383",
          "text": "Sie schlich sich von hinten an mich heran.",
          "translation": "Она подкралась ко мне сзади.",
          "source": "Tatoeba #1935383 @Pfirsichbaeumchen / #12940935 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1935383",
          "cefr_level": "A1",
          "word_slugs": [
            "heran-adv"
          ]
        },
        {
          "id": "2229354",
          "text": "Die Katze schlich sich an den Vogel heran.",
          "translation": "Кошка подкралась к птице.",
          "source": "Tatoeba #2229354 @Pfirsichbaeumchen / #4420944 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2229354",
          "cefr_level": "A1",
          "word_slugs": [
            "heran-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
