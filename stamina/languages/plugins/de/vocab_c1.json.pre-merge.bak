          ]
        },
        {
          "id": "12885038",
          "text": "Das, was du suchst, liegt in der obersten Schublade.",
          "translation": "То, что ты ищешь, лежит в верхнем ящике.",
          "source": "Tatoeba #12885038 @Waldelfe / #14106185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12885038",
          "cefr_level": "A1",
          "word_slugs": [
            "obersten-adj"
          ]
        },
        {
          "id": "3238360",
          "text": "Julia stand auf Zehenspitzen, um an einen Becher im obersten Fach heranzukommen.",
          "translation": "Юля встала на носочки, чтобы достать кружку с верхней полки.",
          "source": "Tatoeba #3238360 @al_ex_an_der / #2506916 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3238360",
