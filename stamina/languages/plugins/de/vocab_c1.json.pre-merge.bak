          ]
        },
        {
          "id": "7902527",
          "text": "Mir gelingt nichts.",
          "translation": "У меня ничего не получается.",
          "source": "Tatoeba #7902527 @brauchinet / #3846846 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7902527",
          "cefr_level": "A1",
