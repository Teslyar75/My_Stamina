      },
      "gender": null,
      "examples": [
        {
          "id": "1011",
          "text": "Der Mensch denkt, Gott lenkt.",
          "translation": "Человек предполагает, а Бог располагает.",
          "source": "Tatoeba #1011 @MUIRIEL / #379790 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1011",
          "cefr_level": "A1",
