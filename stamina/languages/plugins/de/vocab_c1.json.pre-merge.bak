    {
      "slug": "exakt-adj",
      "lemma": "exakt",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5237,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "exact"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13277269",
          "text": "Ich glaube exakt, was Politiker im Fernsehen sagen.",
          "translation": "Я буквально верю тому, что говорят политики по телевизору.",
          "source": "Tatoeba #13277269 @Stuhr / #13277273 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13277269",
          "cefr_level": "A1",
          "word_slugs": [
            "exakt-adj"
          ]
        },
        {
          "id": "3017855",
          "text": "Bist du dir sicher, dass du exakt zweihundertsiebzigtausend Haare hast?",
          "translation": "Ты уверен, что у тебя ровно двести семьдесят тысяч волос?",
          "source": "Tatoeba #3017855 @brauchinet / #3017886 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3017855",
          "cefr_level": "A1",
          "word_slugs": [
            "exakt-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der exakt",
        "nominative_pl": ""
      }
    },
    {
      "slug": "widerstehen-verb",
      "lemma": "widerstehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5238,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "устоять",
          "выдерживать"
        ],
        "en": [
          "to withstand, to resist"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5074345",
          "text": "Ich kann dir nicht widerstehen.",
          "translation": "Я не могу устоять перед тобой.",
          "source": "Tatoeba #5074345 @Manfredo / #5081706 @Julianushka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5074345",
          "cefr_level": "A1",
          "word_slugs": [
            "widerstehen-verb"
          ]
        },
        {
          "id": "2216696",
          "text": "Er konnte der Versuchung nicht widerstehen.",
          "translation": "Он не мог устоять перед искушением.",
          "source": "Tatoeba #2216696 @al_ex_an_der / #2216708 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2216696",
          "cefr_level": "A1",
          "word_slugs": [
            "widerstehen-verb"
          ]
        },
        {
          "id": "2216717",
          "text": "Sie konnte der Versuchung nicht widerstehen.",
          "translation": "Она не могла устоять перед искушением.",
          "source": "Tatoeba #2216717 @al_ex_an_der / #2216719 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2216717",
          "cefr_level": "A1",
          "word_slugs": [
            "widerstehen-verb"
          ]
        },
        {
          "id": "2242823",
          "text": "Tom weiß, dass Mary Schokoladeneis nicht widerstehen kann.",
          "translation": "Том знает, что Мэри падка до шоколадного мороженого.",
          "source": "Tatoeba #2242823 @Vortarulo / #4956209 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2242823",
          "cefr_level": "A1",
          "word_slugs": [
            "widerstehen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
