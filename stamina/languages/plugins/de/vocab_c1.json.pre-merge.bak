          ]
        },
        {
          "id": "636466",
          "text": "Das Flugzeug landete sicher.",
          "translation": "Самолёт благополучно приземлился.",
          "source": "Tatoeba #636466 @Manfredo / #6479326 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/636466",
