    {
      "slug": "karton-noun",
      "lemma": "Karton",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9900,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "картон",
          "коробка"
        ],
        "en": [
          "carton; cardboard box (e.g. a moving box)",
          "cardboard, paperboard",
          "cartoon (preliminary sketch)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "2685373",
          "text": "Öffne diesen Karton, bitte!",
          "translation": "Открой эту коробку, пожалуйста.",
          "source": "Tatoeba #2685373 @Tamy / #5490770 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2685373",
          "cefr_level": "A1",
          "word_slugs": [
            "karton-noun"
          ]
        },
        {
          "id": "12741127",
          "text": "In dem Karton waren drei Welpen.",
          "translation": "В коробке было три щенка.",
          "source": "Tatoeba #12741127 @Pfirsichbaeumchen / #13903120 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12741127",
          "cefr_level": "A1",
          "word_slugs": [
            "karton-noun"
          ]
        },
        {
          "id": "4447892",
          "text": "Der Karton lässt sich nicht zerreißen.",
          "translation": "Картон не удаётся разорвать.",
          "source": "Tatoeba #4447892 @raggione / #7522794 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4447892",
          "cefr_level": "A1",
          "word_slugs": [
            "karton-noun"
          ]
        },
        {
          "id": "677013",
          "text": "Ich weiß, was in dem Karton ist.",
          "translation": "Я знаю, что в коробке.",
          "source": "Tatoeba #677013 @Zaghawa / #1678114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/677013",
          "cefr_level": "A1",
          "word_slugs": [
            "karton-noun"
          ]
        },
        {
          "id": "9066545",
          "text": "Könntest du diesen Karton ins Wohnzimmer bringen?",
          "translation": "Ты не мог бы отнести эту коробку в гостиную?",
          "source": "Tatoeba #9066545 @Pfirsichbaeumchen / #9135085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9066545",
          "cefr_level": "A1",
          "word_slugs": [
            "karton-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Karton",
        "nominative_pl": ""
      }
