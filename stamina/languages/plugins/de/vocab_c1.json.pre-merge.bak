          "cefr_level": "A1",
          "word_slugs": [
            "ozean-noun"
          ]
        },
        {
          "id": "13470750",
          "text": "Ich möchte den Ozean sehen.",
          "translation": "Я хочу увидеть океан.",
          "source": "Tatoeba #13470750 @Vortarulo / #6480776 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13470750",
