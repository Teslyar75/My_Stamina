    {
      "slug": "kollegin-noun",
      "lemma": "Kollegin",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6519,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "коллега"
        ],
        "en": [
          "female equivalent of Kollege"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12988059",
          "text": "Ich bin eine Kollegin von Tom.",
          "translation": "Я коллега Тома.",
          "source": "Tatoeba #12988059 @Tom9358 / #12988067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12988059",
          "cefr_level": "A1",
          "word_slugs": [
            "kollegin-noun"
          ]
        },
        {
          "id": "4874992",
          "text": "Die neue Kollegin grüßt mich nie.",
          "translation": "Новая коллега никогда со мной не здоровается.",
          "source": "Tatoeba #4874992 @elifcakir / #5012385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4874992",
          "cefr_level": "A1",
          "word_slugs": [
            "kollegin-noun"
          ]
        },
        {
          "id": "1103355",
          "text": "Die Mutter unserer Kollegin ist gestorben.",
          "translation": "У нашей коллеги умерла мать.",
          "source": "Tatoeba #1103355 @Haehnchenpaella / #4769454 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1103355",
          "cefr_level": "A1",
          "word_slugs": [
            "kollegin-noun"
          ]
        },
        {
          "id": "10957645",
          "text": "Das ist eine ehemalige Kollegin von mir.",
          "translation": "Это моя бывшая коллега.",
          "source": "Tatoeba #10957645 @Yorwba / #13418908 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10957645",
          "cefr_level": "A1",
          "word_slugs": [
            "kollegin-noun"
          ]
        },
        {
          "id": "1552762",
          "text": "Meine Kollegin und ihr Mann sind beide Amerikaner.",
          "translation": "И моя коллега, и её муж — американцы.",
          "source": "Tatoeba #1552762 @Espi / #14025936 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1552762",
          "cefr_level": "A1",
          "word_slugs": [
            "kollegin-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Kollegin",
        "nominative_pl": ""
      }
