    {
      "slug": "weichen-verb",
      "lemma": "weichen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8000,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to move farther away, to make room, to yield",
          "to be replaced, to disappear [with dative ‘in favor of something’] (especially of buildings/shops and sentiments)",
          "to wane, to decrease"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3068295",
          "text": "Sie weichen mir aus.",
          "translation": "Она меня избегает.",
          "source": "Tatoeba #3068295 @Pfirsichbaeumchen / #4488197 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3068295",
          "cefr_level": "A1",
          "word_slugs": [
            "weichen-verb"
          ]
        },
        {
          "id": "1955676",
          "text": "Der Winter wird weichen.",
          "translation": "Зима пройдёт.",
          "source": "Tatoeba #1955676 @al_ex_an_der / #1955669 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1955676",
          "cefr_level": "A1",
          "word_slugs": [
            "weichen-verb"
          ]
        },
        {
          "id": "3540649",
          "text": "Ich werde nicht weichen.",
          "translation": "Я не смягчусь.",
          "source": "Tatoeba #3540649 @brauchinet / #4945832 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3540649",
          "cefr_level": "A1",
          "word_slugs": [
            "weichen-verb"
          ]
        },
        {
          "id": "6553533",
          "text": "Ich träume von einem heißen Bad und einem weichen Bett.",
          "translation": "Я мечтаю о горячей ванне и мягкой постели.",
          "source": "Tatoeba #6553533 @Pfirsichbaeumchen / #6550060 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6553533",
