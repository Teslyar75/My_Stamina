          ]
        },
        {
          "id": "9167497",
          "text": "Tom ist ein gefährlicher Mensch.",
          "translation": "Том - опасный человек.",
          "source": "Tatoeba #9167497 @Pfirsichbaeumchen / #3989104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9167497",
          "cefr_level": "A1",
          "word_slugs": [
            "gefährlicher-adj"
          ]
        },
        {
          "id": "1036924",
          "text": "Die Welt ist ein gefährlicher Ort.",
          "translation": "Мир — это опасное место.",
          "source": "Tatoeba #1036924 @riccioberto / #1036914 @riccioberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1036924",
          "cefr_level": "A1",
          "word_slugs": [
            "gefährlicher-adj"
          ]
        },
        {
          "id": "1690730",
          "text": "Es ist gefährlicher, als ich dachte.",
          "translation": "Это опасней, чем я думал.",
          "source": "Tatoeba #1690730 @Pfirsichbaeumchen / #2894315 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1690730",
          "cefr_level": "A1",
          "word_slugs": [
            "gefährlicher-adj"
          ]
        },
        {
          "id": "3614222",
          "text": "Ihr seid gefährlicher als eine Drachenrotte.",
          "translation": "Вы опасней стаи драконов.",
          "source": "Tatoeba #3614222 @al_ex_an_der / #3614613 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3614222",
          "cefr_level": "A1",
          "word_slugs": [
            "gefährlicher-adj"
          ]
        }
