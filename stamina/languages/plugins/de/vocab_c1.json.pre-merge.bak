    {
      "slug": "ankam-verb",
      "lemma": "ankam",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6496,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular dependent preterite of ankommen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1129993",
          "text": "Als Markus ankam, schlief ich.",
          "translation": "Когда пришёл Маркус, я спал.",
          "source": "Tatoeba #1129993 @Esperantostern / #2576180 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1129993",
          "cefr_level": "A1",
          "word_slugs": [
            "ankam-verb"
          ]
        },
        {
          "id": "8809039",
          "text": "Er war der Erste, der ankam.",
          "translation": "Он пришёл первым.",
          "source": "Tatoeba #8809039 @wolfgangth / #3174851 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8809039",
          "cefr_level": "A1",
          "word_slugs": [
            "ankam-verb"
          ]
        },
        {
          "id": "10296529",
          "text": "Als ich ankam, war niemand da.",
          "translation": "Когда я пришёл, никого не было.",
          "source": "Tatoeba #10296529 @Pfirsichbaeumchen / #10297338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10296529",
          "cefr_level": "A1",
          "word_slugs": [
            "ankam-verb"
          ]
        },
        {
          "id": "786657",
          "text": "Er war der drittletzte, der ankam.",
          "translation": "Он пришёл третьим с конца.",
          "source": "Tatoeba #786657 @Hans_Adler / #11504567 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/786657",
          "cefr_level": "A1",
          "word_slugs": [
            "ankam-verb"
          ]
        },
        {
          "id": "1764777",
          "text": "Er starb, bevor der Rettungswagen ankam.",
          "translation": "Он умер до приезда скорой.",
          "source": "Tatoeba #1764777 @Esperantostern / #10566791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1764777",
          "cefr_level": "A1",
          "word_slugs": [
            "ankam-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
