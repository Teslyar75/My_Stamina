    {
      "slug": "glaubten-verb",
      "lemma": "glaubten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6346,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of glauben:",
          "first/third-person plural preterite",
          "inflection of glauben:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6619530",
          "text": "Sie glaubten Tom.",
          "translation": "Они верили Тому.",
          "source": "Tatoeba #6619530 @Felixjp / #4753286 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6619530",
          "cefr_level": "A1",
          "word_slugs": [
            "glaubten-verb"
          ]
        },
        {
          "id": "12982154",
          "text": "Toms Eltern glaubten ihm.",
          "translation": "Родители Тома ему поверили.",
          "source": "Tatoeba #12982154 @Naina / #5253757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12982154",
          "cefr_level": "A1",
          "word_slugs": [
            "glaubten-verb"
          ]
        },
        {
          "id": "1860348",
          "text": "Fast alle glaubten das Gerücht.",
          "translation": "Почти все поверили этому слуху.",
          "source": "Tatoeba #1860348 @Tamy / #8291905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1860348",
          "cefr_level": "A1",
          "word_slugs": [
            "glaubten-verb"
          ]
        },
        {
          "id": "940207",
          "text": "Zunächst glaubten sie ihm nicht.",
          "translation": "Сначала они ему не поверили.",
          "source": "Tatoeba #940207 @Sudajaengi / #2055973 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/940207",
          "cefr_level": "A1",
          "word_slugs": [
            "glaubten-verb"
          ]
        },
        {
          "id": "3681889",
          "text": "Wir glaubten, ihr seiet verheiratet.",
          "translation": "Мы думали, вы женаты.",
          "source": "Tatoeba #3681889 @brauchinet / #12963836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3681889",
          "cefr_level": "A1",
          "word_slugs": [
            "glaubten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
