      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verkleiden:",
          "third-person singular present",
          "inflection of verkleiden:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6540672",
          "text": "Tom war als Vampir verkleidet.",
          "translation": "Том был одет в костюм вампира.",
          "source": "Tatoeba #6540672 @Pfirsichbaeumchen / #6403795 @ranwise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6540672",
          "cefr_level": "A1",
          "word_slugs": [
            "verkleidet-verb"
          ]
        },
        {
          "id": "8028641",
          "text": "Tom war als Eichhörnchen verkleidet.",
          "translation": "Том был одет в костюм белочки.",
          "source": "Tatoeba #8028641 @Pfirsichbaeumchen / #8030216 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8028641",
          "cefr_level": "A1",
          "word_slugs": [
            "verkleidet-verb"
          ]
        },
        {
          "id": "603361",
          "text": "Sie waren alle als Clown verkleidet.",
          "translation": "Все они были одеты как клоуны.",
          "source": "Tatoeba #603361 @Manfredo / #13161702 @Korovin_Ilya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/603361",
          "cefr_level": "A1",
          "word_slugs": [
            "verkleidet-verb"
          ]
        },
        {
          "id": "7547017",
          "text": "Tom hat sich als Zauberer verkleidet.",
          "translation": "Том оделся волшебником.",
          "source": "Tatoeba #7547017 @Pfirsichbaeumchen / #7367520 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7547017",
          "cefr_level": "A1",
          "word_slugs": [
            "verkleidet-verb"
          ]
        },
        {
          "id": "3069306",
          "text": "Das Auditorium ist innen vollständig mit Holz verkleidet.",
          "translation": "Аудитория внутри полностью покрыта деревом.",
