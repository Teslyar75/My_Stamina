          "to express",
          "to express (oneself)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "222",
          "text": "Kann man das anders ausdrücken?",
          "translation": "Можно сформулировать это по-другому?",
          "source": "Tatoeba #222 @kroko / #5554 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/222",
          "cefr_level": "A1",
          "word_slugs": [
            "ausdrücken-verb"
          ]
        },
        {
          "id": "369164",
          "text": "Lass es mich anders ausdrücken.",
          "translation": "Давай я сформулирую иначе.",
          "source": "Tatoeba #369164 @Wolf / #3812555 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/369164",
          "cefr_level": "A1",
          "word_slugs": [
            "ausdrücken-verb"
          ]
        },
        {
          "id": "3608212",
          "text": "Lass mich das anders ausdrücken.",
          "translation": "Позволь мне выразиться по-другому.",
          "source": "Tatoeba #3608212 @Esperantostern / #5427707 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3608212",
          "cefr_level": "A1",
          "word_slugs": [
            "ausdrücken-verb"
          ]
        },
        {
          "id": "10483330",
          "text": "Niemand würde sich so ausdrücken.",
          "translation": "Никто бы так не выразился.",
          "source": "Tatoeba #10483330 @Ooneykcall / #10483337 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10483330",
          "cefr_level": "A1",
          "word_slugs": [
            "ausdrücken-verb"
          ]
        },
        {
          "id": "12595160",
          "text": "Worte können es nicht ausdrücken.",
          "translation": "Словами этого не выразить.",
          "source": "Tatoeba #12595160 @Waldelfe / #12595165 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12595160",
          "cefr_level": "A1",
          "word_slugs": [
            "ausdrücken-verb"
          ]
        }
      ],
