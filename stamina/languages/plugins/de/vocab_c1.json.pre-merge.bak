          ]
        },
        {
          "id": "12281766",
          "text": "Lass uns im Schatten eine Pause einlegen!",
          "translation": "Давай передохнём в тени.",
          "source": "Tatoeba #12281766 @mhr / #8250104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12281766",
          "cefr_level": "A1",
