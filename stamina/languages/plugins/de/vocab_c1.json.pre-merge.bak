    {
      "slug": "weste-noun",
      "lemma": "Weste",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6539,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "жилет"
        ],
        "en": [
          "waistcoat, vest (usually sleeveless garment worn over a shirt)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1228361",
          "text": "Er hat eine weiße Weste.",
          "translation": "У него есть белый жилет.",
          "source": "Tatoeba #1228361 @Esperantostern / #7522125 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1228361",
          "cefr_level": "A1",
          "word_slugs": [
            "weste-noun"
          ]
        },
        {
          "id": "3584361",
          "text": "Vor den Fernsehkameras erschien er in Tarnanzug und kugelsicherer Weste.",
          "translation": "Перед телекамерами он появился в камуфляже и бронежилете.",
          "source": "Tatoeba #3584361 @al_ex_an_der / #3584358 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584361",
          "cefr_level": "A1",
          "word_slugs": [
            "weste-noun"
          ]
        },
        {
          "id": "3584392",
          "text": "Eine kugelsichere Weste ist eine Schutzkleidung, die den Torso vor Projektilen schützt.",
          "translation": "Пуленепробиваемый жилет — это защитная одежда, которая защищает торс от пуль.",
          "source": "Tatoeba #3584392 @al_ex_an_der / #3586409 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584392",
          "cefr_level": "A1",
          "word_slugs": [
            "weste-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Weste",
        "nominative_pl": ""
      }
    },
    {
      "slug": "sahst-verb",
      "lemma": "sahst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6540,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular preterite of sehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8653514",
          "text": "Sahst du sie heute?",
          "translation": "Ты их сегодня видел?",
          "source": "Tatoeba #8653514 @Melang / #7920503 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8653514",
          "cefr_level": "A1",
          "word_slugs": [
            "sahst-verb"
          ]
        },
        {
          "id": "14106849",
          "text": "Du sahst einen Raben.",
          "translation": "Ты видел ворона.",
          "source": "Tatoeba #14106849 @mhr / #14106867 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14106849",
          "cefr_level": "A1",
          "word_slugs": [
            "sahst-verb"
          ]
        },
        {
          "id": "9559931",
          "text": "Du sahst glücklich aus.",
          "translation": "Ты выглядел счастливым.",
          "source": "Tatoeba #9559931 @kby / #13263487 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9559931",
          "cefr_level": "A1",
          "word_slugs": [
            "sahst-verb"
          ]
        },
        {
          "id": "1293349",
          "text": "Wann sahst du meinen Vater zuletzt?",
          "translation": "Когда ты последний раз видел моего отца?",
          "source": "Tatoeba #1293349 @al_ex_an_der / #1293792 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1293349",
          "cefr_level": "A1",
          "word_slugs": [
            "sahst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "kennzeichen-noun",
      "lemma": "Kennzeichen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6541,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "помета",
          "признак"
        ],
        "en": [
          "characteristic, mark",
          "earmark, marking, tag",
          "registration identifier"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "13810820",
          "text": "Haben Sie dieses Auto gesehen? Und haben Sie das Kennzeichen behalten?",
          "translation": "Вы видели эту машину? А номер запомнили?",
          "source": "Tatoeba #13810820 @mhr / #13810655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13810820",
          "cefr_level": "A1",
          "word_slugs": [
            "kennzeichen-noun"
          ]
        },
        {
          "id": "13810817",
          "text": "Haben Sie das Auto gesehen? Und haben Sie sich das Kennzeichen gemerkt?",
          "translation": "Вы видели эту машину? А номер запомнили?",
          "source": "Tatoeba #13810817 @mhr / #13810655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13810817",
          "cefr_level": "A1",
          "word_slugs": [
            "kennzeichen-noun"
          ]
        },
        {
          "id": "13810814",
          "text": "Das Auto habe ich gesehen, aber das Kennzeichen habe ich nicht behalten.",
          "translation": "Машину я видел, но номер не запомнил.",
          "source": "Tatoeba #13810814 @mhr / #13810656 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13810814",
          "cefr_level": "A1",
          "word_slugs": [
            "kennzeichen-noun"
          ]
        },
        {
          "id": "13810818",
          "text": "Haben Sie dieses Auto gesehen? Und haben Sie sich das Kennzeichen gemerkt?",
          "translation": "Вы видели эту машину? А номер запомнили?",
          "source": "Tatoeba #13810818 @mhr / #13810655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13810818",
          "cefr_level": "A1",
          "word_slugs": [
            "kennzeichen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Kennzeichen",
        "nominative_pl": ""
      }
