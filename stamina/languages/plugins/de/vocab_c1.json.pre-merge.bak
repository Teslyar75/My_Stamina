    {
      "slug": "aufenthalt-noun",
      "lemma": "Aufenthalt",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6796,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "пребывание",
          "остановка"
        ],
        "en": [
          "stay; residence; presence (the state of being in a place)",
          "sojourn; stop (a short stay)",
          "residence (a place where one lives or stays)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1555033",
          "text": "Wie war Ihr Aufenthalt?",
          "translation": "Каким было Ваше пребывание?",
          "source": "Tatoeba #1555033 @al_ex_an_der / #1537444 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1555033",
          "cefr_level": "A1",
          "word_slugs": [
            "aufenthalt-noun"
          ]
        },
        {
          "id": "1540557",
          "text": "Kann ich meinen Aufenthalt verlängern?",
          "translation": "Можно ли продлить моё пребывание?",
          "source": "Tatoeba #1540557 @Zaghawa / #3567322 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1540557",
          "cefr_level": "A1",
          "word_slugs": [
            "aufenthalt-noun"
          ]
        },
        {
          "id": "455334",
          "text": "Sie verlängerte ihren Aufenthalt um 5 Tage.",
          "translation": "Она продлила свое пребывание на 5 дней.",
          "source": "Tatoeba #455334 @xtofu80 / #13490433 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455334",
          "cefr_level": "A1",
          "word_slugs": [
            "aufenthalt-noun"
          ]
        },
        {
          "id": "11863162",
          "text": "Wir wünschen Ihnen einen angenehmen Aufenthalt.",
          "translation": "Желаем Вам приятного пребывания.",
          "source": "Tatoeba #11863162 @dozugeo / #11863284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11863162",
          "cefr_level": "A1",
          "word_slugs": [
            "aufenthalt-noun"
          ]
        },
        {
          "id": "702234",
          "text": "Ich würde gern meinen Aufenthalt in Amerika verlängern.",
          "translation": "Я бы охотно продолжил своё пребывание в Америке.",
          "source": "Tatoeba #702234 @Manfredo / #884516 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/702234",
          "cefr_level": "A1",
          "word_slugs": [
            "aufenthalt-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
