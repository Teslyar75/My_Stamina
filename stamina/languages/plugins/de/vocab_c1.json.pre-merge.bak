    {
      "slug": "krieges-noun",
      "lemma": "Krieges",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5233,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Krieg"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1500455",
          "text": "Mars ist der Gott des Krieges.",
          "translation": "Марс - бог войны.",
          "source": "Tatoeba #1500455 @Pfirsichbaeumchen / #2836369 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1500455",
          "cefr_level": "A1",
          "word_slugs": [
            "krieges-noun"
          ]
        },
        {
          "id": "3868813",
          "text": "Wir stehen am Rande eines Krieges.",
          "translation": "Мы находимся на грани войны.",
          "source": "Tatoeba #3868813 @Pfirsichbaeumchen / #11671710 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3868813",
          "cefr_level": "A1",
          "word_slugs": [
            "krieges-noun"
          ]
        },
        {
          "id": "10178880",
          "text": "Er war während des Krieges Soldat.",
          "translation": "Во время войны он был солдатом.",
          "source": "Tatoeba #10178880 @wolfgangth / #10178883 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10178880",
          "cefr_level": "A1",
          "word_slugs": [
            "krieges-noun"
          ]
        },
        {
          "id": "6108101",
          "text": "Die Schweiz war während des Krieges neutral.",
          "translation": "Швейцария во время войны была нейтральной.",
          "source": "Tatoeba #6108101 @Pfirsichbaeumchen / #5291767 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6108101",
          "cefr_level": "A1",
          "word_slugs": [
            "krieges-noun"
          ]
        },
        {
          "id": "1448811",
          "text": "Die Stadt wurde während des Krieges zerstört.",
          "translation": "Город был разрушен во время войны.",
          "source": "Tatoeba #1448811 @Manfredo / #2817477 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1448811",
          "cefr_level": "A1",
          "word_slugs": [
            "krieges-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
