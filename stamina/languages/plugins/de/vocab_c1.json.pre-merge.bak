    {
      "slug": "setzten-verb",
      "lemma": "setzten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8364,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of setzen:",
          "first/third-person plural preterite",
          "inflection of setzen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2980050",
          "text": "Alle setzten sich.",
          "translation": "Все сели.",
          "source": "Tatoeba #2980050 @pne / #3095244 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2980050",
          "cefr_level": "A1",
          "word_slugs": [
            "setzten-verb"
          ]
        },
        {
          "id": "9210614",
          "text": "Zwei Mädchen setzten sich.",
          "translation": "Две девушки сели.",
          "source": "Tatoeba #9210614 @Yorwba / #12198711 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9210614",
          "cefr_level": "A1",
          "word_slugs": [
            "setzten-verb"
          ]
        },
        {
          "id": "12479963",
          "text": "Wir setzten uns neben ihn.",
          "translation": "Мы сели рядом с ним.",
          "source": "Tatoeba #12479963 @Waldelfe / #12477488 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12479963",
          "cefr_level": "A1",
          "word_slugs": [
            "setzten-verb"
          ]
        },
        {
          "id": "9353963",
          "text": "Die beiden Mädchen setzten sich.",
          "translation": "Обе девочки сели.",
          "source": "Tatoeba #9353963 @Pfirsichbaeumchen / #9504711 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9353963",
          "cefr_level": "A1",
          "word_slugs": [
            "setzten-verb"
          ]
        },
        {
          "id": "12855544",
          "text": "Wir setzten das Gespräch einfach fort.",
          "translation": "Мы просто продолжили разговор.",
          "source": "Tatoeba #12855544 @mhr / #12855540 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12855544",
          "cefr_level": "A1",
          "word_slugs": [
            "setzten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
