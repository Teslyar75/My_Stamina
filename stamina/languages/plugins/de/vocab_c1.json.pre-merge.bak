    {
      "slug": "jegliche-pron",
      "lemma": "jegliche",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6990,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative feminine singular of jeglicher"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3569405",
          "text": "Jegliche Hoffnung war dahin.",
          "translation": "Всякая надежда пропала.",
          "source": "Tatoeba #3569405 @al_ex_an_der / #13759930 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3569405",
          "cefr_level": "A1",
          "word_slugs": [
            "jegliche-pron"
          ]
        },
        {
          "id": "13804064",
          "text": "Wir haben jegliche Hoffnung verloren.",
          "translation": "Мы потеряли всякую надежду.",
          "source": "Tatoeba #13804064 @mhr / #13802985 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13804064",
          "cefr_level": "A1",
          "word_slugs": [
            "jegliche-pron"
          ]
        },
        {
          "id": "10194085",
          "text": "Schlaf ist besser als jegliche Medizin.",
          "translation": "Сон лучше всякого лекарства.",
          "source": "Tatoeba #10194085 @Pfirsichbaeumchen / #10194012 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10194085",
          "cefr_level": "A1",
          "word_slugs": [
            "jegliche-pron"
          ]
        },
        {
          "id": "3059099",
          "text": "Ich beantworte gern jegliche weiteren Fragen.",
          "translation": "Я с удовольствием отвечу на любые дополнительные вопросы.",
          "source": "Tatoeba #3059099 @al_ex_an_der / #3059094 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3059099",
          "cefr_level": "A1",
          "word_slugs": [
            "jegliche-pron"
          ]
        },
        {
          "id": "4925049",
          "text": "Jegliche Schönheit einer Blume erwächst aus ihrer Einzigartigkeit.",
          "translation": "Вся красота цветка заключается в его неповторимости.",
          "source": "Tatoeba #4925049 @al_ex_an_der / #4925045 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4925049",
          "cefr_level": "A1",
          "word_slugs": [
            "jegliche-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
