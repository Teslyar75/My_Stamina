      "gender": null,
      "examples": [
        {
          "id": "6889145",
          "text": "Ich mag diese Jahreszeit.",
          "translation": "Мне нравится это время года.",
          "source": "Tatoeba #6889145 @felix63 / #2519416 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6889145",
          "cefr_level": "A1",
