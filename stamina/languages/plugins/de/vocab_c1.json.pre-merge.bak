    {
      "slug": "korea-name",
      "lemma": "Korea",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8290,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "Корея"
        ],
        "en": [
          "Korea (a geographic region in East Asia, consisting of two countries, commonly known as South Korea and North Korea; formerly a single country)",
          "Korea (a peninsula in East Asia, containing the countries of North Korea and South Korea; in full, Korean Peninsula)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "3553325",
          "text": "Ich will nach Korea.",
          "translation": "Я хочу поехать в Корею.",
          "source": "Tatoeba #3553325 @Pfirsichbaeumchen / #1079204 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3553325",
          "cefr_level": "A1",
          "word_slugs": [
            "korea-name"
          ]
        },
        {
          "id": "12593267",
          "text": "Ich bin in Korea geboren.",
          "translation": "Я родилась в Корее.",
          "source": "Tatoeba #12593267 @Waldelfe / #5362515 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12593267",
          "cefr_level": "A1",
          "word_slugs": [
            "korea-name"
          ]
        },
        {
          "id": "5262096",
          "text": "Japan und Korea sind Nachbarn.",
          "translation": "Япония и Корея - соседи.",
          "source": "Tatoeba #5262096 @Sudajaengi / #2816517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5262096",
          "cefr_level": "A1",
          "word_slugs": [
            "korea-name"
          ]
        },
        {
          "id": "13707835",
          "text": "In Korea lernte ich Koreanisch.",
          "translation": "В Корее я учил корейский.",
          "source": "Tatoeba #13707835 @mhr / #13708003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13707835",
          "cefr_level": "A1",
          "word_slugs": [
            "korea-name"
          ]
        },
        {
          "id": "14069809",
          "text": "In Korea spricht man Koreanisch.",
          "translation": "В Корее говорят по-корейски.",
          "source": "Tatoeba #14069809 @mhr / #14070177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14069809",
          "cefr_level": "A1",
          "word_slugs": [
            "korea-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Korea",
        "nominative_pl": ""
      }
