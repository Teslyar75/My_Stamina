    {
      "slug": "uhrzeit-noun",
      "lemma": "Uhrzeit",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7756,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "time, time of day (time according to the clock)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13666764",
          "text": "Wie ändert man die Uhrzeit?",
          "translation": "Как поменять время?",
          "source": "Tatoeba #13666764 @Biderl / #13668036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13666764",
          "cefr_level": "A1",
          "word_slugs": [
            "uhrzeit-noun"
          ]
        },
        {
          "id": "11860981",
          "text": "Ich wollte die genaue Uhrzeit wissen.",
          "translation": "Я хотел знать точное время.",
          "source": "Tatoeba #11860981 @stickerkleber / #11860998 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11860981",
          "cefr_level": "A1",
          "word_slugs": [
            "uhrzeit-noun"
          ]
        },
        {
          "id": "8599146",
          "text": "Wer ruft denn um diese Uhrzeit an?",
          "translation": "Кто это звонит в такое время?",
          "source": "Tatoeba #8599146 @Roujin / #4181453 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8599146",
          "cefr_level": "A1",
          "word_slugs": [
            "uhrzeit-noun"
          ]
        },
        {
          "id": "944701",
          "text": "Können Sie mir bitte die Uhrzeit sagen?",
          "translation": "Не подскажете, который час?",
          "source": "Tatoeba #944701 @Sudajaengi / #944707 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/944701",
          "cefr_level": "A1",
          "word_slugs": [
            "uhrzeit-noun"
          ]
        },
        {
          "id": "3074059",
          "text": "Ich würde gerne die genaue Uhrzeit erfahren.",
          "translation": "Я бы хотел знать точное время.",
          "source": "Tatoeba #3074059 @faehrmann / #2449426 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3074059",
          "cefr_level": "A1",
          "word_slugs": [
            "uhrzeit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
