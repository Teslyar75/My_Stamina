      "translations": {
        "en": [
          "fifteen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "344978",
          "text": "Nur fünfzehn Minuten.",
          "translation": "Только пятнадцать минут.",
          "source": "Tatoeba #344978 @lilygilder / #2244201 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344978",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfzehn-num"
          ]
        },
        {
          "id": "1368523",
          "text": "Ich wartete fünfzehn Minuten.",
          "translation": "Я ждал пятнадцать минут.",
          "source": "Tatoeba #1368523 @al_ex_an_der / #1368522 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1368523",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfzehn-num"
          ]
        },
        {
          "id": "13382557",
          "text": "Es ist zwei Uhr fünfzehn.",
          "translation": "Сейчас пятнадцать минут третьего.",
          "source": "Tatoeba #13382557 @mhr / #4363432 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13382557",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfzehn-num"
          ]
        },
        {
          "id": "2463197",
          "text": "Drei mal fünf ist fünfzehn.",
          "translation": "Трижды пять будет пятнадцать.",
          "source": "Tatoeba #2463197 @Zaghawa / #4750798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2463197",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfzehn-num"
          ]
        },
        {
          "id": "8326948",
          "text": "Mein Sohn ist erst fünfzehn.",
          "translation": "Моему сыну всего пятнадцать.",
          "source": "Tatoeba #8326948 @felix63 / #10569003 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8326948",
          "cefr_level": "A1",
          "word_slugs": [
            "fünfzehn-num"
          ]
        }
      ],
