        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "547126",
          "text": "Das Herz besteht aus Muskeln.",
          "translation": "Сердце состоит из мышц.",
          "source": "Tatoeba #547126 @xtofu80 / #1574678 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/547126",
          "cefr_level": "A1",
          "word_slugs": [
            "muskeln-noun"
          ]
        },
        {
          "id": "10826374",
          "text": "Seine Muskeln sind aus Stahl.",
          "translation": "У него стальные мускулы.",
          "source": "Tatoeba #10826374 @maaster / #10826412 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10826374",
          "cefr_level": "A1",
          "word_slugs": [
            "muskeln-noun"
          ]
        },
        {
          "id": "4829473",
          "text": "Ich will meine Muskeln stärken.",
          "translation": "Я хочу укрепить свои мускулы.",
          "source": "Tatoeba #4829473 @al_ex_an_der / #4829472 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4829473",
          "cefr_level": "A1",
          "word_slugs": [
            "muskeln-noun"
          ]
        },
        {
          "id": "13268701",
          "text": "Frauen mögen Männer mit Muskeln.",
          "translation": "Женщины любят мужчин с мускулами.",
          "source": "Tatoeba #13268701 @Biderl / #13268707 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13268701",
          "cefr_level": "A1",
          "word_slugs": [
            "muskeln-noun"
          ]
        },
        {
          "id": "365342",
          "text": "Das heiße Bad entspannte meine Muskeln.",
          "translation": "Тёплая ванна расслабила мои мускулы.",
          "source": "Tatoeba #365342 @Wolf / #1903033 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/365342",
          "cefr_level": "A1",
          "word_slugs": [
            "muskeln-noun"
          ]
        }
