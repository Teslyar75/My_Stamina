    {
      "slug": "aussiehst-verb",
      "lemma": "aussiehst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6179,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular dependent present of aussehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6643706",
          "text": "Ich weiß, wie du aussiehst.",
          "translation": "Я знаю, как ты выглядишь.",
          "source": "Tatoeba #6643706 @Felixjp / #13963476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6643706",
          "cefr_level": "A1",
          "word_slugs": [
            "aussiehst-verb"
          ]
        },
        {
          "id": "14033513",
          "text": "Ich beginne zu vergessen, wie du aussiehst.",
          "translation": "Я начинаю забывать, как ты выглядишь.",
          "source": "Tatoeba #14033513 @frpzzd / #7743471 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14033513",
