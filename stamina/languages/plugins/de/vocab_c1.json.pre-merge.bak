    {
      "slug": "heilt-verb",
      "lemma": "heilt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7787,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of heilen:",
          "second-person plural present",
          "inflection of heilen:",
          "third-person singular present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14100686",
          "text": "Die Zeit heilt Wunden.",
          "translation": "Время лечит раны.",
          "source": "Tatoeba #14100686 @mhr / #3253298 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14100686",
          "cefr_level": "A1",
          "word_slugs": [
            "heilt-verb"
          ]
        },
        {
          "id": "1818339",
          "text": "Diese Wunde heilt rasch.",
          "translation": "Эта рана быстро заживает.",
          "source": "Tatoeba #1818339 @Esperantostern / #12762115 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1818339",
          "cefr_level": "A1",
          "word_slugs": [
            "heilt-verb"
          ]
        },
        {
          "id": "342098",
          "text": "Die Zeit heilt alle Wunden.",
          "translation": "Время всё лечит.",
          "source": "Tatoeba #342098 @lilygilder / #2269393 @krevedko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/342098",
          "cefr_level": "A1",
          "word_slugs": [
            "heilt-verb"
          ]
        },
        {
          "id": "1818338",
          "text": "Die Zeit heilt viele Wunden.",
          "translation": "Время лечит многие раны.",
          "source": "Tatoeba #1818338 @Esperantostern / #5123884 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1818338",
          "cefr_level": "A1",
          "word_slugs": [
            "heilt-verb"
          ]
        },
        {
          "id": "13804025",
          "text": "Die Wunde ist nicht sehr tief, sie heilt schnell.",
          "translation": "Рана не очень глубокая, быстро заживает.",
          "source": "Tatoeba #13804025 @mhr / #13804742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13804025",
          "cefr_level": "A1",
          "word_slugs": [
            "heilt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
