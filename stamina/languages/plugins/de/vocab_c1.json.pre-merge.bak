    {
      "slug": "tageslicht-noun",
      "lemma": "Tageslicht",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8160,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "дневной свет"
        ],
        "en": [
          "daylight (light from the sun)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "10458336",
          "text": "Alle Pflanzen brauchen Wasser und Tageslicht.",
          "translation": "Всем растениям нужны вода и дневной свет.",
          "source": "Tatoeba #10458336 @Adelpa / #10458338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10458336",
          "cefr_level": "A1",
          "word_slugs": [
            "tageslicht-noun"
          ]
        },
        {
          "id": "3584751",
          "text": "Sehr große Fenster sorgen für reichlich Tageslicht.",
          "translation": "Очень большие окна обеспечивают высокий уровень освещённости.",
          "source": "Tatoeba #3584751 @al_ex_an_der / #3586276 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584751",
          "cefr_level": "A1",
          "word_slugs": [
            "tageslicht-noun"
          ]
        },
        {
          "id": "3584741",
          "text": "Zu dieser Wohnung gehört ein großes Bad mit Tageslicht.",
          "translation": "В этой квартире есть большая ванная комната с естественным освещением.",
          "source": "Tatoeba #3584741 @al_ex_an_der / #3584778 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584741",
          "cefr_level": "A1",
          "word_slugs": [
            "tageslicht-noun"
          ]
        },
        {
          "id": "13739330",
          "text": "Sie haben Angst, dass die Wahrheit ans Tageslicht kommt.",
          "translation": "Они боятся, что правда всплывёт наружу.",
          "source": "Tatoeba #13739330 @maaster / #13739786 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13739330",
          "cefr_level": "A1",
          "word_slugs": [
            "tageslicht-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Tageslicht",
        "nominative_pl": ""
      }
