          "cefr_level": "A1",
          "word_slugs": [
            "vorüber-adv"
          ]
        },
        {
          "id": "10204917",
          "text": "Der Tag war schnell vorüber.",
          "translation": "День прошёл быстро.",
          "source": "Tatoeba #10204917 @Pfirsichbaeumchen / #10204753 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10204917",
          "cefr_level": "A1",
          "word_slugs": [
            "vorüber-adv"
          ]
        },
        {
          "id": "10204915",
          "text": "Die Woche war schnell vorüber.",
          "translation": "Неделя прошла быстро.",
          "source": "Tatoeba #10204915 @Pfirsichbaeumchen / #10204754 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10204915",
