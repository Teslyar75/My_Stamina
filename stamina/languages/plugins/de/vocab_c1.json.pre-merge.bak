        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7302757",
          "text": "Was, wenn er anfängt, Fragen zu stellen?",
          "translation": "А если он начнёт задавать вопросы?",
          "source": "Tatoeba #7302757 @Pfirsichbaeumchen / #7483095 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7302757",
          "cefr_level": "A1",
          "word_slugs": [
            "anfängt-verb"
          ]
        },
        {
          "id": "7302759",
          "text": "Was, wenn sie anfängt, Fragen zu stellen?",
          "translation": "А если она начнёт задавать вопросы?",
          "source": "Tatoeba #7302759 @Pfirsichbaeumchen / #7483092 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7302759",
          "cefr_level": "A1",
          "word_slugs": [
            "anfängt-verb"
          ]
        },
        {
          "id": "7302761",
          "text": "Was, wenn Tom anfängt, Fragen zu stellen?",
          "translation": "А если Том начнёт задавать вопросы?",
          "source": "Tatoeba #7302761 @Pfirsichbaeumchen / #7483089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7302761",
          "cefr_level": "A1",
          "word_slugs": [
            "anfängt-verb"
          ]
        },
        {
          "id": "13897064",
          "text": "Wenn es anfängt zu kochen, lass es noch etwa fünfzehn Minuten weiterkochen.",
          "translation": "Как только закипит, дай покипеть ещё минут пятнадцать.",
          "source": "Tatoeba #13897064 @mhr / #13897059 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13897064",
          "cefr_level": "A1",
          "word_slugs": [
            "anfängt-verb"
          ]
        },
        {
          "id": "13897070",
          "text": "Wenn es anfängt zu kochen, lasst es noch etwa fünfzehn Minuten weiterkochen.",
          "translation": "Как только закипит, дайте покипеть ещё около пятнадцати минут.",
          "source": "Tatoeba #13897070 @mhr / #13897057 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13897070",
          "cefr_level": "A1",
          "word_slugs": [
            "anfängt-verb"
          ]
        }
      ],
