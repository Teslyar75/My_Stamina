    {
      "slug": "weigern-verb",
      "lemma": "weigern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9853,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to refuse"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14009404",
          "text": "Sie weigern sich, mir zuzuhören.",
          "translation": "Они отказываются меня слушать.",
          "source": "Tatoeba #14009404 @mhr / #14009402 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14009404",
          "cefr_level": "A1",
          "word_slugs": [
            "weigern-verb"
          ]
        },
        {
          "id": "12509510",
          "text": "Tom wird sich weigern zu gehen.",
          "translation": "Том откажется идти.",
          "source": "Tatoeba #12509510 @Waldelfe / #12503314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12509510",
          "cefr_level": "A1",
          "word_slugs": [
            "weigern-verb"
          ]
        },
        {
          "id": "12509511",
          "text": "Tom wird sich weigern zu fahren.",
          "translation": "Том откажется ехать.",
          "source": "Tatoeba #12509511 @Waldelfe / #12503315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12509511",
          "cefr_level": "A1",
          "word_slugs": [
            "weigern-verb"
          ]
        },
        {
          "id": "12509516",
          "text": "Tom wird sich weigern, dahin zu gehen.",
          "translation": "Том откажется идти.",
          "source": "Tatoeba #12509516 @Waldelfe / #12503314 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12509516",
          "cefr_level": "A1",
          "word_slugs": [
            "weigern-verb"
          ]
        },
        {
          "id": "12509517",
          "text": "Tom wird sich weigern, dahin zu fahren.",
          "translation": "Том откажется ехать.",
          "source": "Tatoeba #12509517 @Waldelfe / #12503315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12509517",
