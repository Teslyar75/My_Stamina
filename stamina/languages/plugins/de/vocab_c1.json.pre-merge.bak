    {
      "slug": "biss-noun",
      "lemma": "Biß",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7563,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "укус"
        ],
        "en": [
          "Formerly standard spelling of Biss which was deprecated in the spelling reform (Rechtschreibreform) of 1996."
        ]
      },
      "gender": "n",
      "examples": [],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
