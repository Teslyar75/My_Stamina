    {
      "slug": "geradezu-adv",
      "lemma": "geradezu",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7953,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "downright",
          "almost"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6596220",
          "text": "Im Sommerlager herrschte eine geradezu militärische Disziplin.",
          "translation": "В летнем лагере была почти военная дисциплина.",
          "source": "Tatoeba #6596220 @Pfirsichbaeumchen / #6295372 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6596220",
          "cefr_level": "A1",
          "word_slugs": [
            "geradezu-adv"
          ]
        },
        {
          "id": "770857",
          "text": "Ihn ein Genie zu nennen ist geradezu abstrus.",
          "translation": "Называть его гением просто абсурдно.",
          "source": "Tatoeba #770857 @xtofu80 / #11143759 @mutskt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/770857",
          "cefr_level": "A1",
          "word_slugs": [
            "geradezu-adv"
          ]
        },
        {
          "id": "3481777",
          "text": "Maria ist nicht pummelig: sie ist geradezu fett.",
          "translation": "Мэри не пухленькая, а откровенно толстая.",
          "source": "Tatoeba #3481777 @Pfirsichbaeumchen / #5888202 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3481777",
          "cefr_level": "A1",
          "word_slugs": [
            "geradezu-adv"
          ]
        },
        {
          "id": "4927848",
          "text": "Die Grammatik des Esperanto ist geradezu genial einfach.",
          "translation": "Грамматика эсперанто невероятно проста.",
          "source": "Tatoeba #4927848 @Esperantostern / #4933339 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4927848",
          "cefr_level": "A1",
          "word_slugs": [
            "geradezu-adv"
          ]
        },
        {
          "id": "2993565",
          "text": "Normalgroße Menschen erscheinen neben Tom geradezu zwergenhaft klein.",
          "translation": "Люди обычного роста кажутся рядом с Томом прямо-таки карликами.",
          "source": "Tatoeba #2993565 @Pfirsichbaeumchen / #3008853 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2993565",
          "cefr_level": "A1",
          "word_slugs": [
            "geradezu-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "mitzunehmen-verb",
      "lemma": "mitzunehmen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7954,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of mitnehmen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6589338",
          "text": "Wir haben vergessen Geld mitzunehmen.",
          "translation": "Мы забыли взять деньги.",
          "source": "Tatoeba #6589338 @Juri / #6589075 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6589338",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzunehmen-verb"
          ]
        },
        {
          "id": "9681709",
          "text": "Vergiss nicht, eine Kamera mitzunehmen!",
          "translation": "Не забудь взять с собою фотоаппарат.",
          "source": "Tatoeba #9681709 @Pfirsichbaeumchen / #1787079 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9681709",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzunehmen-verb"
          ]
        },
        {
          "id": "2198089",
          "text": "Vergiss nicht, einen Fotoapparat mitzunehmen.",
          "translation": "Не забудь взять с собой фотоаппарат.",
          "source": "Tatoeba #2198089 @Tamy / #8584283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2198089",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzunehmen-verb"
          ]
        },
        {
          "id": "3322210",
          "text": "Tom hat vergessen, seinen Schirm mitzunehmen.",
          "translation": "Том забыл взять с собой зонтик.",
          "source": "Tatoeba #3322210 @Pfirsichbaeumchen / #2468227 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3322210",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzunehmen-verb"
          ]
        },
        {
          "id": "9681708",
          "text": "Vergessen Sie nicht, eine Kamera mitzunehmen!",
          "translation": "Не забудьте взять с собой фотоаппарат.",
          "source": "Tatoeba #9681708 @Pfirsichbaeumchen / #8584286 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9681708",
          "cefr_level": "A1",
          "word_slugs": [
            "mitzunehmen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
