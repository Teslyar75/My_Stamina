    {
      "slug": "unterscheiden-verb",
      "lemma": "unterscheiden",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5689,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "различать"
        ],
        "en": [
          "to distinguish, differentiate",
          "to differ, be different, distinct"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13631817",
          "text": "Wir unterscheiden uns von ihnen.",
          "translation": "Мы отличаемся от них.",
          "source": "Tatoeba #13631817 @mhr / #13631815 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13631817",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheiden-verb"
          ]
        },
        {
          "id": "13638469",
          "text": "Kannst du die beiden unterscheiden?",
          "translation": "Ты можешь отличить одно от другого?",
          "source": "Tatoeba #13638469 @Biderl / #11124611 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13638469",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheiden-verb"
          ]
        },
        {
          "id": "863918",
          "text": "Pferde unterscheiden sich von Eseln.",
          "translation": "Лошади отличаются от ослов.",
          "source": "Tatoeba #863918 @Esperantostern / #2014401 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/863918",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheiden-verb"
          ]
        },
        {
          "id": "713157",
          "text": "Hunde können keine Farben unterscheiden.",
          "translation": "Собаки не различают цвета.",
          "source": "Tatoeba #713157 @Esperantostern / #3473468 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/713157",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheiden-verb"
          ]
        },
        {
          "id": "2935629",
          "text": "Kannst du Wahrheit und Lüge unterscheiden?",
          "translation": "Ты можешь отличить правду от лжи?",
          "source": "Tatoeba #2935629 @al_ex_an_der / #3296247 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2935629",
          "cefr_level": "A1",
          "word_slugs": [
            "unterscheiden-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
