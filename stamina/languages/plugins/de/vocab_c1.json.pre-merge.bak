    {
      "slug": "beherrscht-verb",
      "lemma": "beherrscht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7745,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of beherrschen:",
          "third-person singular present",
          "inflection of beherrschen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1076601",
          "text": "Geld beherrscht die Welt.",
          "translation": "Деньги правят миром.",
          "source": "Tatoeba #1076601 @sacredceltic / #1077045 @redscorp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1076601",
          "cefr_level": "A1",
          "word_slugs": [
            "beherrscht-verb"
          ]
        },
        {
          "id": "2835953",
          "text": "Er beherrscht fünf Sprachen.",
          "translation": "Он владеет пятью языками.",
          "source": "Tatoeba #2835953 @Pfirsichbaeumchen / #2828106 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2835953",
          "cefr_level": "A1",
          "word_slugs": [
            "beherrscht-verb"
          ]
        },
        {
          "id": "12753375",
          "text": "Welche Programmiersprachen beherrscht ihr?",
