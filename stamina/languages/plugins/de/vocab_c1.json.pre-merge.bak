      "gender": null,
      "examples": [
        {
          "id": "2265939",
          "text": "Alles ist von Staub bedeckt.",
          "translation": "Всё покрыто пылью.",
          "source": "Tatoeba #2265939 @Pfirsichbaeumchen / #3940953 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2265939",
          "cefr_level": "A1",
