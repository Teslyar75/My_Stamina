      },
      "gender": null,
      "examples": [
        {
          "id": "2409637",
          "text": "Er ist noch nicht erschienen.",
          "translation": "Он ещё не появлялся.",
          "source": "Tatoeba #2409637 @samueldora / #12158823 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2409637",
          "cefr_level": "A1",
          "word_slugs": [
            "erschienen-verb"
          ]
        },
        {
          "id": "12713131",
          "text": "Im Lehrplan erschienen neue Fächer.",
          "translation": "В учебной программе появились новые предметы.",
          "source": "Tatoeba #12713131 @mhr / #12705034 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12713131",
          "cefr_level": "A1",
          "word_slugs": [
            "erschienen-verb"
          ]
        },
        {
          "id": "3475663",
          "text": "Tom ist nicht zum Essen erschienen.",
          "translation": "Том не появился во время еды.",
          "source": "Tatoeba #3475663 @freddy1 / #3476994 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3475663",
          "cefr_level": "A1",
          "word_slugs": [
            "erschienen-verb"
          ]
        },
        {
          "id": "998827",
          "text": "Plötzlich erschienen drei Hunde vor uns.",
          "translation": "Внезапно перед нами возникли три собаки.",
          "source": "Tatoeba #998827 @Pfirsichbaeumchen / #1212419 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/998827",
          "cefr_level": "A1",
          "word_slugs": [
