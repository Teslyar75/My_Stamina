        ],
        "en": [
          "preacher",
          "Ecclesiastes"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2786980",
          "text": "Ich, der Prediger, war König über Israel zu Jerusalem.",
          "translation": "Я, Экклесиаст, был царём над Израилем в Иерусалиме.",
          "source": "Tatoeba #2786980 @Pfirsichbaeumchen / #2786571 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2786980",
          "cefr_level": "A1",
          "word_slugs": [
            "prediger-noun"
          ]
        },
        {
          "id": "2787325",
          "text": "Eitelkeit der Eitelkeiten! spricht der Prediger. Eitelkeit der Eitelkeiten! Alles ist Eitelkeit.",
          "translation": "Суета сует, сказал Екклесиаст, суета сует, - всё суета!",
          "source": "Tatoeba #2787325 @Pfirsichbaeumchen / #2787334 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2787325",
          "cefr_level": "A1",
          "word_slugs": [
            "prediger-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Prediger",
        "nominative_pl": ""
      }
