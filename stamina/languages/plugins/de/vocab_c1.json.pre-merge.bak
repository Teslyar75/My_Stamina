          ]
        },
        {
          "id": "2981410",
          "text": "Die Uhr geht genau und zuverlässig.",
          "translation": "Часы идут точно и надёжно.",
          "source": "Tatoeba #2981410 @pne / #14059323 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2981410",
