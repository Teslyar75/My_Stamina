      "gender": "f",
      "examples": [
        {
          "id": "6876829",
          "text": "Du hattest recht: Tom ist ein Vollidiot.",
          "translation": "Ты был прав. Том - полный идиот.",
          "source": "Tatoeba #6876829 @Pfirsichbaeumchen / #6569863 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6876829",
          "cefr_level": "A1",
          "word_slugs": [
