          "source": "Tatoeba #11587562 @Pfirsichbaeumchen / #4409800 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11587562",
          "cefr_level": "A1",
          "word_slugs": [
