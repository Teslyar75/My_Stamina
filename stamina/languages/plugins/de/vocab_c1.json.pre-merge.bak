    {
      "slug": "händchen-noun",
      "lemma": "Händchen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8755,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "diminutive of Hand",
          "skill, magic touch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2510673",
          "text": "Wir haben nur Händchen gehalten.",
          "translation": "Мы только за руки держались.",
          "source": "Tatoeba #2510673 @makija / #3067767 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2510673",
          "cefr_level": "A1",
          "word_slugs": [
            "händchen-noun"
          ]
        },
        {
          "id": "9447520",
          "text": "Ich habe Tom und Maria Händchen halten sehen.",
          "translation": "Я видел, как Том с Мэри держались за руки.",
          "source": "Tatoeba #9447520 @Pfirsichbaeumchen / #5521317 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9447520",
          "cefr_level": "A1",
          "word_slugs": [
            "händchen-noun"
          ]
        },
        {
          "id": "12576858",
          "text": "Pärchen halten hier gewöhnlich nicht in aller Öffentlichkeit Händchen.",
          "translation": "Здесь парочки обычно не держатся за руки прилюдно.",
          "source": "Tatoeba #12576858 @Waldelfe / #4958636 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12576858",
          "cefr_level": "A1",
          "word_slugs": [
            "händchen-noun"
          ]
        },
        {
          "id": "12576859",
          "text": "Hier halten Pärchen gewöhnlich nicht in aller Öffentlichkeit Händchen.",
          "translation": "Здесь парочки обычно не держатся за руки прилюдно.",
          "source": "Tatoeba #12576859 @Waldelfe / #4958636 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12576859",
          "cefr_level": "A1",
