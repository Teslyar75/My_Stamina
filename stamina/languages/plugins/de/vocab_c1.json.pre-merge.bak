    {
      "slug": "zeitverschwendung-noun",
      "lemma": "Zeitverschwendung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5453,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "waste of time (meaningless or fruitless activity)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "351755",
          "text": "Das ist Zeitverschwendung.",
          "translation": "Это пустая трата времени.",
          "source": "Tatoeba #351755 @MUIRIEL / #1711368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/351755",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitverschwendung-noun"
          ]
        },
        {
          "id": "2190044",
          "text": "Das war Zeitverschwendung.",
          "translation": "Это была потеря времени.",
          "source": "Tatoeba #2190044 @Pfirsichbaeumchen / #3281862 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2190044",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitverschwendung-noun"
          ]
        },
        {
          "id": "1882797",
          "text": "Schule ist Zeitverschwendung.",
          "translation": "Школа - это пустая трата времени.",
          "source": "Tatoeba #1882797 @Pfirsichbaeumchen / #11249627 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1882797",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitverschwendung-noun"
          ]
        },
        {
          "id": "2534947",
          "text": "Was für eine Zeitverschwendung!",
          "translation": "Какая потеря времени!",
          "source": "Tatoeba #2534947 @raggione / #2534320 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2534947",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitverschwendung-noun"
          ]
        },
        {
          "id": "574652",
          "text": "Das ist reine Zeitverschwendung.",
          "translation": "Это пустая трата времени.",
          "source": "Tatoeba #574652 @Pfirsichbaeumchen / #1711368 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/574652",
          "cefr_level": "A1",
          "word_slugs": [
            "zeitverschwendung-noun"
          ]
        }
      ],
