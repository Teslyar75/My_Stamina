    {
      "slug": "berufung-noun",
      "lemma": "Berufung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6983,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "призвание",
          "ссылка"
        ],
        "en": [
          "appointment",
          "vocation",
          "appeal"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "4910873",
          "text": "Er fand seine wahre Berufung.",
          "translation": "Он нашёл своё истинное призвание.",
          "source": "Tatoeba #4910873 @al_ex_an_der / #13637915 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4910873",
          "cefr_level": "A1",
          "word_slugs": [
            "berufung-noun"
          ]
        },
        {
          "id": "6792531",
          "text": "Es ist möglich, Berufung einzulegen.",
          "translation": "Можно подать апелляцию.",
          "source": "Tatoeba #6792531 @brauchinet / #6793193 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6792531",
          "cefr_level": "A1",
          "word_slugs": [
            "berufung-noun"
          ]
        },
        {
          "id": "13637968",
          "text": "Er hat seine wahre Berufung gefunden.",
          "translation": "Он нашёл своё истинное призвание.",
          "source": "Tatoeba #13637968 @mhr / #13637915 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13637968",
          "cefr_level": "A1",
          "word_slugs": [
            "berufung-noun"
          ]
        },
        {
          "id": "6792526",
          "text": "Man kann bei Gericht Berufung einlegen.",
          "translation": "Можно подать апелляцию в суд.",
          "source": "Tatoeba #6792526 @brauchinet / #6793192 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6792526",
          "cefr_level": "A1",
          "word_slugs": [
            "berufung-noun"
          ]
        }
      ],
