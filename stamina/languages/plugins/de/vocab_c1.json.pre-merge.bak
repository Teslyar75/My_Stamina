    {
      "slug": "glücklichen-adj",
      "lemma": "glücklichen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8183,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of glücklich:",
          "strong genitive masculine/neuter singular",
          "inflection of glücklich:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11078948",
          "text": "Beschriebest du dich als glücklichen Menschen?",
          "translation": "Ты бы описал себя как счастливого человека?",
          "source": "Tatoeba #11078948 @Pfirsichbaeumchen / #12601928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11078948",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklichen-adj"
          ]
        },
        {
          "id": "11078950",
          "text": "Beschrieben Sie sich als glücklichen Menschen?",
          "translation": "Вы бы описали себя как счастливого человека?",
          "source": "Tatoeba #11078950 @Pfirsichbaeumchen / #12601926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11078950",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklichen-adj"
          ]
        },
        {
          "id": "12602274",
          "text": "Würdest du dich als glücklichen Menschen beschreiben?",
          "translation": "Ты бы описал себя как счастливого человека?",
          "source": "Tatoeba #12602274 @mhr / #12601928 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12602274",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklichen-adj"
          ]
        },
        {
          "id": "12602275",
          "text": "Würden Sie sich als glücklichen Menschen beschreiben?",
          "translation": "Вы бы описали себя как счастливого человека?",
          "source": "Tatoeba #12602275 @mhr / #12601926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12602275",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklichen-adj"
          ]
        },
        {
          "id": "13375335",
          "text": "Ich bin unter ihnen keinen glücklichen Menschen begegnet.",
          "translation": "Я не встречал среди них счастливых людей.",
          "source": "Tatoeba #13375335 @mhr / #13375067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13375335",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklichen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
