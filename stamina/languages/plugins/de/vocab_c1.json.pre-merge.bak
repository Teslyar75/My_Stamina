          "cefr_level": "A1",
          "word_slugs": [
            "jenem-unknown"
          ]
        },
        {
          "id": "4489190",
          "text": "Es schneite an jenem Tag.",
          "translation": "В тот день шёл снег.",
          "source": "Tatoeba #4489190 @Pfirsichbaeumchen / #4483582 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4489190",
