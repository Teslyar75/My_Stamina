            "felder-noun"
          ]
        },
        {
          "id": "13453620",
          "text": "Das Dorf umgeben endlose Felder.",
          "translation": "Деревню окружают бескрайние поля.",
          "source": "Tatoeba #13453620 @mhr / #13452919 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13453620",
          "cefr_level": "A1",
          "word_slugs": [
            "felder-noun"
          ]
        },
        {
