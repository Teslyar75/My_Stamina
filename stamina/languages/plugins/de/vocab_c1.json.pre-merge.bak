    {
      "slug": "verrät-verb",
      "lemma": "verrät",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7019,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular present of verraten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9977731",
          "text": "Ein Zauberer verrät niemals seine Tricks.",
          "translation": "Фокусник никогда не раскрывает своих секретов.",
          "source": "Tatoeba #9977731 @Pfirsichbaeumchen / #13927829 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9977731",
          "cefr_level": "A1",
          "word_slugs": [
            "verrät-verb"
          ]
        },
        {
          "id": "5188997",
          "text": "Ein trunkener Mund verrät des Herzens Grund.",
          "translation": "Пьяные уста выдают всё, что носишь в глубине сердца.",
          "source": "Tatoeba #5188997 @AqQoyriq_1 / #5189000 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5188997",
          "cefr_level": "A1",
          "word_slugs": [
            "verrät-verb"
          ]
        },
        {
          "id": "396969",
          "text": "Ein echter Gentleman verrät seine Freunde nicht.",
          "translation": "Настоящий джентльмен своих друзей не предаёт.",
          "source": "Tatoeba #396969 @MUIRIEL / #5390903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/396969",
          "cefr_level": "A1",
          "word_slugs": [
            "verrät-verb"
          ]
        },
        {
          "id": "6213625",
          "text": "Wie wird man reich? Tom verrät uns das Geheimnis.",
          "translation": "Как разбогатеть? Том раскрывает нам секрет.",
          "source": "Tatoeba #6213625 @felix63 / #10246181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6213625",
          "cefr_level": "A1",
          "word_slugs": [
            "verrät-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
