        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8243027",
          "text": "Er will ein rotes Auto.",
          "translation": "Он хочет красную машину.",
          "source": "Tatoeba #8243027 @manese / #4942130 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8243027",
          "cefr_level": "A1",
          "word_slugs": [
            "rotes-adj"
          ]
        },
        {
          "id": "9017221",
          "text": "Tom hat ein rotes Auto.",
          "translation": "У Тома красный автомобиль.",
          "source": "Tatoeba #9017221 @Pfirsichbaeumchen / #9032396 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9017221",
          "cefr_level": "A1",
          "word_slugs": [
            "rotes-adj"
          ]
        },
        {
          "id": "360629",
          "text": "Sie trug ein rotes Kleid.",
