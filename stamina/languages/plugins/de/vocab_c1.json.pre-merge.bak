    {
      "slug": "ältesten-adj",
      "lemma": "ältesten",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7726,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "superlative degree of alt"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6377266",
          "text": "Welches deiner Geschwister ist am ältesten?",
          "translation": "Кто из твоих братьев и сестёр старше всех?",
          "source": "Tatoeba #6377266 @raggione / #6377297 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6377266",
          "cefr_level": "A1",
          "word_slugs": [
            "ältesten-adj"
          ]
        },
        {
          "id": "7269526",
          "text": "Rom ist eine der ältesten Städte Europas.",
          "translation": "Рим - один из самых древних городов в Европе.",
          "source": "Tatoeba #7269526 @Pfirsichbaeumchen / #7028035 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7269526",
          "cefr_level": "A1",
          "word_slugs": [
            "ältesten-adj"
          ]
        },
        {
          "id": "13525431",
          "text": "Arles ist eine der ältesten Städte Frankreichs.",
          "translation": "Арль - один из древнейших городов Франции.",
          "source": "Tatoeba #13525431 @mhr / #13525427 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13525431",
          "cefr_level": "A1",
          "word_slugs": [
            "ältesten-adj"
          ]
        },
        {
          "id": "13968794",
          "text": "Das ist eines der ältesten Häuser im Stadtviertel.",
          "translation": "Это один из самых старых домов в районе.",
          "source": "Tatoeba #13968794 @mhr / #13968514 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13968794",
          "cefr_level": "A1",
          "word_slugs": [
            "ältesten-adj"
          ]
        },
        {
          "id": "769517",
          "text": "Ich werde oft mit meinem ältesten Bruder verglichen.",
          "translation": "Меня часто сравнивают с моим старшим братом.",
          "source": "Tatoeba #769517 @Esperantostern / #4821421 @alexdiment (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/769517",
          "cefr_level": "A1",
          "word_slugs": [
            "ältesten-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
