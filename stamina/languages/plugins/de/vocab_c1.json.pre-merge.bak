      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "шить"
        ],
        "en": [
          "to sew"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5984571",
          "text": "Kannst du nähen?",
          "translation": "Ты умеешь шить?",
          "source": "Tatoeba #5984571 @Pfirsichbaeumchen / #6000227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5984571",
          "cefr_level": "A1",
          "word_slugs": [
            "nähen-verb"
          ]
        },
        {
          "id": "358602",
          "text": "Sie kann sehr gut nähen.",
          "translation": "Она очень хорошо шьёт.",
          "source": "Tatoeba #358602 @MUIRIEL / #1049322 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/358602",
          "cefr_level": "A1",
          "word_slugs": [
            "nähen-verb"
          ]
        },
        {
          "id": "5984569",
          "text": "Maria kann sehr gut nähen.",
          "translation": "Мэри очень хорошо шьёт.",
          "source": "Tatoeba #5984569 @Pfirsichbaeumchen / #5424673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5984569",
          "cefr_level": "A1",
          "word_slugs": [
            "nähen-verb"
          ]
        },
        {
          "id": "6804282",
          "text": "Wir nähen mit einer Nadel.",
          "translation": "Мы шьём иглой.",
          "source": "Tatoeba #6804282 @manese / #6804509 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804282",
          "cefr_level": "A1",
          "word_slugs": [
            "nähen-verb"
          ]
        },
        {
          "id": "3634970",
          "text": "Sie fragte, ob ich nähen könne.",
          "translation": "Она спросила, умею ли я шить.",
          "source": "Tatoeba #3634970 @a_coder / #13328744 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3634970",
          "cefr_level": "A1",
          "word_slugs": [
            "nähen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
