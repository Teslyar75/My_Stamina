    {
      "slug": "niere-noun",
      "lemma": "Niere",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7634,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "kidney (organ)",
          "kidney as food",
          "testicle"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "13432700",
          "text": "Tom braucht eine Niere.",
          "translation": "Тому нужна почка.",
          "source": "Tatoeba #13432700 @Vortarulo / #10771460 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13432700",
          "cefr_level": "A1",
          "word_slugs": [
            "niere-noun"
          ]
        },
        {
          "id": "7446237",
          "text": "Ich brauche eine neue Niere.",
          "translation": "Мне нужна новая почка.",
          "source": "Tatoeba #7446237 @raggione / #7446403 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7446237",
          "cefr_level": "A1",
          "word_slugs": [
            "niere-noun"
          ]
        },
        {
          "id": "6765290",
          "text": "Tom ist bereit, seine Niere hinzugeben, um seine Mutter zu retten.",
          "translation": "Том готов отдать свою почку, чтобы спасти мать.",
          "source": "Tatoeba #6765290 @Pfirsichbaeumchen / #6483274 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6765290",
          "cefr_level": "A1",
          "word_slugs": [
            "niere-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Niere",
        "nominative_pl": ""
      }
    },
    {
      "slug": "kratzen-verb",
      "lemma": "kratzen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7635,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to scratch (rub a surface with a sharp, pointy rough object, especially to remove itching)",
          "to remove by scratching, to scrape something off",
          "to scratch (rub a surface with a sharp, pointy rough object, especially to remove itching)",
          "to produce a noise by scratching"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7285791",
          "text": "Kluge kleine Katzen kratzen keine Krokodile.",
          "translation": "Умные маленькие кошки не царапают крокодилов.",
          "source": "Tatoeba #7285791 @Gezeit / #7285793 @Gezeit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7285791",
          "cefr_level": "A1",
          "word_slugs": [
            "kratzen-verb"
          ]
        },
        {
          "id": "12209159",
          "text": "Kannst du mir mal den Rücken kratzen?",
          "translation": "Можешь мне спину почесать?",
          "source": "Tatoeba #12209159 @Pfirsichbaeumchen / #12209168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12209159",
          "cefr_level": "A1",
          "word_slugs": [
            "kratzen-verb"
          ]
        },
        {
          "id": "2151142",
          "text": "Ich kann eine Katze am Fenster kratzen hören.",
          "translation": "Мне слышно, как кошка скребётся в окно.",
          "source": "Tatoeba #2151142 @Esperantostern / #4439513 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2151142",
          "cefr_level": "A1",
          "word_slugs": [
            "kratzen-verb"
          ]
        },
        {
          "id": "12999683",
          "text": "„Ich kann meinen Besitzer nicht kratzen“, sagte die Katze.",
          "translation": "\"Я не могу царапать своего хозяина\", - сказал кот.",
          "source": "Tatoeba #12999683 @Yorwba / #2197560 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12999683",
          "cefr_level": "A1",
          "word_slugs": [
            "kratzen-verb"
          ]
        },
        {
          "id": "351840",
          "text": "Wenn du die Katze ärgerst, wird sie dich bestimmt kratzen.",
          "translation": "Если разозлишь кошку, она тебя обязательно поцарапает.",
