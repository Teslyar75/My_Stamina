    {
      "slug": "befolgen-verb",
      "lemma": "befolgen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6027,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "следовать",
          "последовать"
        ],
        "en": [
          "to observe, follow, obey (orders, laws, rules etc); to comply with or abide by"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12159866",
          "text": "Wir befolgen die Regeln.",
          "translation": "Мы следуем правилам.",
          "source": "Tatoeba #12159866 @Pfirsichbaeumchen / #12160357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12159866",
          "cefr_level": "A1",
          "word_slugs": [
            "befolgen-verb"
          ]
        },
        {
          "id": "2801080",
          "text": "Man muss das Gesetz befolgen.",
          "translation": "Надо соблюдать закон.",
          "source": "Tatoeba #2801080 @freddy1 / #5253069 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2801080",
          "cefr_level": "A1",
          "word_slugs": [
            "befolgen-verb"
          ]
        },
        {
          "id": "3795011",
          "text": "Du musst die Regeln befolgen.",
          "translation": "Ты должен следовать правилам.",
          "source": "Tatoeba #3795011 @Tickler / #10949172 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3795011",
          "cefr_level": "A1",
          "word_slugs": [
