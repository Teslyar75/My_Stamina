    {
      "slug": "dampf-noun",
      "lemma": "Dampf",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7052,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "steam",
          "vapor / vapour"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1562215",
          "text": "Wasser wird zu Dampf.",
          "translation": "Вода превращается в пар.",
          "source": "Tatoeba #1562215 @Okidokay / #2459357 @naXa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1562215",
          "cefr_level": "A1",
          "word_slugs": [
            "dampf-noun"
          ]
        },
        {
          "id": "3583147",
          "text": "Ich muss Dampf ablassen.",
          "translation": "Мне нужно выпустить пар.",
          "source": "Tatoeba #3583147 @gubaer / #2119701 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3583147",
          "cefr_level": "A1",
          "word_slugs": [
            "dampf-noun"
          ]
        },
        {
          "id": "5317144",
          "text": "Wasser verwandelt sich zu Dampf.",
          "translation": "Вода превращается в пар.",
          "source": "Tatoeba #5317144 @raggione / #2459357 @naXa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5317144",
          "cefr_level": "A1",
          "word_slugs": [
            "dampf-noun"
          ]
        },
        {
          "id": "12126289",
          "text": "Eine Wolke ist kondensierter Dampf.",
          "translation": "Облако - это конденсированный пар.",
          "source": "Tatoeba #12126289 @Lundian / #12126421 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12126289",
          "cefr_level": "A1",
          "word_slugs": [
            "dampf-noun"
          ]
        },
        {
          "id": "1717079",
          "text": "Er ist Hans Dampf in allen Gassen.",
          "translation": "Он мастер на все руки.",
          "source": "Tatoeba #1717079 @Esperantostern / #4864955 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1717079",
          "cefr_level": "A1",
          "word_slugs": [
            "dampf-noun"
          ]
        }
      ],
      "tags": [
