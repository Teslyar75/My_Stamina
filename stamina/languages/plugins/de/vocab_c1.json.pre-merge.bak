    {
      "slug": "kragen-noun",
      "lemma": "Kragen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8080,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "воротник"
        ],
        "en": [
          "collar",
          "neck"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4657143",
          "text": "Samt am Kragen, Kleie im Magen.",
          "translation": "Бархат на воротнике, отруби в желудке.",
          "source": "Tatoeba #4657143 @AqQoyriq_1 / #4657154 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4657143",
          "cefr_level": "A1",
          "word_slugs": [
            "kragen-noun"
          ]
        },
        {
          "id": "8919810",
          "text": "Tom muss zur Arbeit Schlips und Kragen tragen.",
          "translation": "Том должен носить на работе галстук и воротничок.",
          "source": "Tatoeba #8919810 @Pfirsichbaeumchen / #8920375 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8919810",
          "cefr_level": "A1",
          "word_slugs": [
            "kragen-noun"
          ]
        },
        {
          "id": "3212322",
          "text": "Es lohnt sich nicht, Kopf und Kragen zu riskieren.",
          "translation": "Не стоит рисковать головой.",
          "source": "Tatoeba #3212322 @al_ex_an_der / #3212324 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3212322",
          "cefr_level": "A1",
          "word_slugs": [
            "kragen-noun"
          ]
        },
        {
          "id": "3212340",
          "text": "Bestechungen am Arbeitsplatz können Beamten Kopf und Kragen kosten.",
          "translation": "Взятки на рабочем месте могут стоить чиновникам головы.",
          "source": "Tatoeba #3212340 @al_ex_an_der / #3212333 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3212340",
          "cefr_level": "A1",
          "word_slugs": [
            "kragen-noun"
          ]
        },
        {
          "id": "3285220",
          "text": "Das geht in Ordnung. Denn sonst geht's dir an den Kragen!",
          "translation": "Ну ладно. А то смотри у меня!",
          "source": "Tatoeba #3285220 @al_ex_an_der / #3285175 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3285220",
          "cefr_level": "A1",
          "word_slugs": [
            "kragen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Kragen",
        "nominative_pl": ""
      }
    },
    {
      "slug": "schwachen-adj",
      "lemma": "schwachen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8081,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schwach:",
          "strong genitive masculine/neuter singular",
          "inflection of schwach:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11501709",
          "text": "Sie hat einen schwachen Magen.",
          "translation": "У неё слабый желудок.",
          "source": "Tatoeba #11501709 @omniglotman / #11501721 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11501709",
          "cefr_level": "A1",
          "word_slugs": [
            "schwachen-adj"
          ]
        },
        {
          "id": "5978077",
          "text": "Er ist ein schwacher Präsident, weil er einen schwachen Charakter hat.",
          "translation": "Он слабый президент, потому что у него слабый характер.",
          "source": "Tatoeba #5978077 @al_ex_an_der / #5978083 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5978077",
          "cefr_level": "A1",
          "word_slugs": [
            "schwachen-adj"
          ]
        }
      ],
      "tags": [
