    {
      "slug": "servieren-verb",
      "lemma": "servieren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6729,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "подавать на стол",
          "сервировать",
          "подавать",
          "передавать"
        ],
        "en": [
          "to serve (food); to wait (at table)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3074475",
          "text": "Bitte servieren Sie den Kaffee.",
          "translation": "Подай кофе, пожалуйста.",
          "source": "Tatoeba #3074475 @faehrmann / #755292 @JeNNeR (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3074475",
          "cefr_level": "A1",
          "word_slugs": [
            "servieren-verb"
          ]
        },
        {
          "id": "2743197",
          "text": "Wann werden sie das Abendessen servieren?",
          "translation": "Когда подадут ужин?",
          "source": "Tatoeba #2743197 @Zaghawa / #11383504 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2743197",
          "cefr_level": "A1",
          "word_slugs": [
            "servieren-verb"
          ]
        },
        {
          "id": "352608",
          "text": "Lassen Sie den Kuchen abkühlen, bevor Sie ihn servieren.",
          "translation": "Перед подачей на стол остудите пирог.",
          "source": "Tatoeba #352608 @MUIRIEL / #13872005 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/352608",
          "cefr_level": "A1",
          "word_slugs": [
            "servieren-verb"
          ]
        },
        {
          "id": "612041",
          "text": "Es ist besser, den Weißwein vor dem Servieren zu kühlen.",
          "translation": "Перед подачей белое вино лучше охладить.",
          "source": "Tatoeba #612041 @Manfredo / #12471879 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/612041",
          "cefr_level": "A1",
          "word_slugs": [
            "servieren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
