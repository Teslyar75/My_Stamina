    {
      "slug": "städte-noun",
      "lemma": "Städte",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5748,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Stadt"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6617408",
          "text": "Die Städte gefallen mir.",
          "translation": "Города мне нравятся.",
          "source": "Tatoeba #6617408 @manese / #10147753 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6617408",
          "cefr_level": "A1",
          "word_slugs": [
            "städte-noun"
          ]
        },
        {
          "id": "8322862",
          "text": "Unsere Städte sind dreckig.",
          "translation": "Города у нас грязные.",
          "source": "Tatoeba #8322862 @Luiaard / #10147761 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8322862",
          "cefr_level": "A1",
          "word_slugs": [
            "städte-noun"
          ]
        },
        {
          "id": "4834523",
          "text": "Ich mag keine großen Städte.",
          "translation": "Я не люблю большие города.",
          "source": "Tatoeba #4834523 @LanguageBreaker / #3289103 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4834523",
          "cefr_level": "A1",
          "word_slugs": [
            "städte-noun"
          ]
        },
        {
          "id": "2997683",
          "text": "Wie werden zukünftige Städte aussehen?",
          "translation": "Как будут выглядеть будущие города?",
          "source": "Tatoeba #2997683 @al_ex_an_der / #2997704 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2997683",
          "cefr_level": "A1",
          "word_slugs": [
            "städte-noun"
          ]
        },
        {
          "id": "1697920",
          "text": "Die zwei Städte trennt ein Fluss.",
          "translation": "Два города разделены рекой.",
