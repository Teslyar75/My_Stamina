    {
      "slug": "lebensmittel-noun",
      "lemma": "Lebensmittel",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6942,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "any item or substance intended for human consumption (excluding drugs other than alcohol), food, comestible",
          "groceries; roughly, though not usually including housewares"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4932055",
          "text": "Tom benötigte Lebensmittel.",
          "translation": "Том нуждался в провизии.",
          "source": "Tatoeba #4932055 @Hime / #4932549 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4932055",
          "cefr_level": "A1",
          "word_slugs": [
            "lebensmittel-noun"
          ]
        },
        {
          "id": "9049769",
          "text": "David ging Lebensmittel kaufen.",
          "translation": "Давид пошёл за продуктами.",
          "source": "Tatoeba #9049769 @Pfirsichbaeumchen / #9049771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9049769",
          "cefr_level": "A1",
          "word_slugs": [
            "lebensmittel-noun"
          ]
        },
        {
          "id": "11998270",
          "text": "Die Lebensmittel wurden teurer.",
          "translation": "Продукты подорожали.",
          "source": "Tatoeba #11998270 @mhr / #2872567 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11998270",
          "cefr_level": "A1",
          "word_slugs": [
            "lebensmittel-noun"
          ]
        },
        {
          "id": "369876",
          "text": "Milch ist ein gutes Lebensmittel.",
          "translation": "Молоко — хороший продукт.",
          "source": "Tatoeba #369876 @kriskelvin / #14110946 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/369876",
          "cefr_level": "A1",
          "word_slugs": [
            "lebensmittel-noun"
          ]
        },
        {
          "id": "11144725",
          "text": "Nie Lebensmittel im Zelt aufbewahren!",
          "translation": "Никогда не храните пищу в палатке.",
          "source": "Tatoeba #11144725 @Pfirsichbaeumchen / #7850879 @mytmpacc2015 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11144725",
          "cefr_level": "A1",
          "word_slugs": [
            "lebensmittel-noun"
          ]
        }
      ],
      "tags": [
