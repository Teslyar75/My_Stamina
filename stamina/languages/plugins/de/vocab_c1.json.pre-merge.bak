    {
      "slug": "finanzielle-adj",
      "lemma": "finanzielle",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8695,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of finanziell:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of finanziell:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "451513",
          "text": "Er hat finanzielle Probleme.",
          "translation": "У него проблемы с финансами.",
          "source": "Tatoeba #451513 @MUIRIEL / #536897 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/451513",
          "cefr_level": "A1",
          "word_slugs": [
            "finanzielle-adj"
          ]
        },
        {
          "id": "3070333",
          "text": "Ein solches Projekt braucht eine solide finanzielle Grundlage.",
          "translation": "Такой проект требует прочной денежной основы.",
          "source": "Tatoeba #3070333 @al_ex_an_der / #3070335 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3070333",
          "cefr_level": "A1",
          "word_slugs": [
            "finanzielle-adj"
          ]
        },
        {
          "id": "731251",
          "text": "Die finanzielle Lage wird von Woche zu Woche schlechter.",
          "translation": "Финансовая ситуация становится хуже неделя за неделей.",
          "source": "Tatoeba #731251 @Manfredo / #1601720 @mutternoise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/731251",
          "cefr_level": "A1",
          "word_slugs": [
            "finanzielle-adj"
          ]
        },
        {
          "id": "707538",
          "text": "Die Opfer des Hurrikans erhielten finanzielle Unterstützung von der Regierung.",
          "translation": "Жертвы урагана получили финансовую помощь со стороны государства.",
          "source": "Tatoeba #707538 @Pfirsichbaeumchen / #6982025 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/707538",
          "cefr_level": "A1",
          "word_slugs": [
            "finanzielle-adj"
          ]
        },
        {
          "id": "5805646",
          "text": "Tom versuchte wegzuhören, als Maria und Johannes ihre finanzielle Situation besprachen.",
          "translation": "Том старался не слушать, когда Мэри и Джон обсуждали свою финансовую ситуацию.",
          "source": "Tatoeba #5805646 @Pfirsichbaeumchen / #11080851 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5805646",
          "cefr_level": "A1",
          "word_slugs": [
            "finanzielle-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
