    {
      "slug": "anspruch-noun",
      "lemma": "Anspruch",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5395,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "требование",
          "претензия",
          "притязание"
        ],
        "en": [
          "verbal noun of ansprechen",
          "entitlement, demand, expectation of what should come from someone or something",
          "claim, the right against a subject of law that an action is performed or omitted by it",
          "the raised procedural form of a claim that the defendant do or omit something"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5297958",
          "text": "Der Bau könnte Monate in Anspruch nehmen.",
          "translation": "Строительство может занять несколько месяцев.",
          "source": "Tatoeba #5297958 @Sudajaengi / #13935388 @Alex_M (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5297958",
          "cefr_level": "A1",
          "word_slugs": [
            "anspruch-noun"
          ]
        },
        {
          "id": "12017441",
          "text": "Wieviel Zeit wird das in Anspruch nehmen?",
          "translation": "Сколько это потребует времени?",
          "source": "Tatoeba #12017441 @Pfirsichbaeumchen / #5279163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12017441",
          "cefr_level": "A1",
          "word_slugs": [
            "anspruch-noun"
          ]
        },
        {
          "id": "12242966",
          "text": "Diese Arbeit nimmt viel Zeit in Anspruch.",
          "translation": "Эта работа занимает много времени.",
          "source": "Tatoeba #12242966 @mhr / #12242308 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12242966",
          "cefr_level": "A1",
          "word_slugs": [
            "anspruch-noun"
          ]
        },
        {
          "id": "13306902",
          "text": "Das würde nicht allzuviel Zeit in Anspruch nehmen.",
          "translation": "Это заняло бы не слишком много времени.",
          "source": "Tatoeba #13306902 @Waldelfe / #9034642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13306902",
          "cefr_level": "A1",
          "word_slugs": [
            "anspruch-noun"
          ]
        },
        {
          "id": "7525450",
          "text": "Das wird nicht mehr als 20 Minuten in Anspruch nehmen.",
          "translation": "Это займёт не больше двадцати минут.",
          "source": "Tatoeba #7525450 @Pfirsichbaeumchen / #6208515 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7525450",
          "cefr_level": "A1",
          "word_slugs": [
            "anspruch-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Anspruch",
        "nominative_pl": ""
      }
    },
