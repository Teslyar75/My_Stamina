      "lemma": "eintritt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7686,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular dependent present of eintreten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13830149",
          "text": "Er klopft immer an die Tür, bevor er eintritt.",
          "translation": "Он всегда стучит в дверь, прежде чем войти.",
          "source": "Tatoeba #13830149 @carlosalberto / #13830147 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13830149",
          "cefr_level": "A1",
          "word_slugs": [
            "eintritt-verb"
          ]
        },
        {
          "id": "12910180",
          "text": "Ich will nicht, daß mein Land in die Europäische Union eintritt.",
          "translation": "Я не хочу, чтобы моя страна входила в Евросоюз.",
          "source": "Tatoeba #12910180 @Waldelfe / #12089979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12910180",
          "cefr_level": "A1",
          "word_slugs": [
            "eintritt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
