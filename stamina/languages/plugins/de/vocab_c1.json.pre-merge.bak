    {
      "slug": "mahlzeit-noun",
      "lemma": "Mahlzeit",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6036,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "трапеза",
          "приём пищи"
        ],
        "en": [
          "meal",
          "mealtime"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3866210",
          "text": "Brot gehört zu einer Mahlzeit dazu.",
          "translation": "Без хлеба еда не еда.",
          "source": "Tatoeba #3866210 @Pfirsichbaeumchen / #3865948 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3866210",
          "cefr_level": "A1",
          "word_slugs": [
            "mahlzeit-noun"
          ]
        },
        {
          "id": "2260457",
          "text": "Benutzen Sie Zahnseide nach jeder Mahlzeit.",
          "translation": "Пользуйтесь зубной нитью после каждого приёма пищи.",
          "source": "Tatoeba #2260457 @brauchinet / #4303367 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2260457",
          "cefr_level": "A1",
          "word_slugs": [
            "mahlzeit-noun"
          ]
        },
        {
          "id": "3866213",
          "text": "Ohne Brot ist eine Mahlzeit keine Mahlzeit.",
          "translation": "Без хлеба еда не еда.",
          "source": "Tatoeba #3866213 @Pfirsichbaeumchen / #3865948 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3866213",
          "cefr_level": "A1",
          "word_slugs": [
            "mahlzeit-noun"
          ]
        },
        {
          "id": "591468",
          "text": "Nehmen Sie das Medikament nach jeder Mahlzeit.",
          "translation": "Принимайте лекарство после каждого приёма пищи.",
          "source": "Tatoeba #591468 @Manfredo / #5804041 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/591468",
          "cefr_level": "A1",
          "word_slugs": [
            "mahlzeit-noun"
          ]
        },
        {
          "id": "353118",
          "text": "Nehmen Sie dieses Medikament vor jeder Mahlzeit.",
          "translation": "Принимайте это лекарство каждый раз перед едой.",
          "source": "Tatoeba #353118 @MUIRIEL / #886320 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/353118",
          "cefr_level": "A1",
          "word_slugs": [
            "mahlzeit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Mahlzeit",
        "nominative_pl": ""
      }
    },
