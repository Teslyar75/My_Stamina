    {
      "slug": "besitze-verb",
      "lemma": "besitze",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6968,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of besitzen:",
          "first-person singular present",
          "inflection of besitzen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "502452",
          "text": "Ich besitze mehrere Silbermünzen.",
          "translation": "У меня есть несколько серебряных монет.",
          "source": "Tatoeba #502452 @xtofu80 / #1460906 @beshine (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/502452",
          "cefr_level": "A1",
          "word_slugs": [
            "besitze-verb"
          ]
        },
        {
          "id": "1102131",
          "text": "Ich besitze endlich ein komplettes Set!",
          "translation": "Наконец-то я получил весь набор!",
          "source": "Tatoeba #1102131 @Haehnchenpaella / #1525059 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1102131",
          "cefr_level": "A1",
          "word_slugs": [
            "besitze-verb"
          ]
        },
        {
          "id": "1014055",
          "text": "Ich besitze einige sehr alte Briefmarken.",
          "translation": "У меня есть несколько очень старых марок.",
          "source": "Tatoeba #1014055 @MUIRIEL / #12174212 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1014055",
          "cefr_level": "A1",
          "word_slugs": [
            "besitze-verb"
          ]
        },
        {
          "id": "4454351",
          "text": "Ich besitze eine Sammlung von Hermelinfigürchen.",
          "translation": "У меня есть коллекция фигурок горностаев.",
          "source": "Tatoeba #4454351 @rocco_granata / #4454239 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4454351",
          "cefr_level": "A1",
          "word_slugs": [
            "besitze-verb"
          ]
        },
        {
          "id": "2927056",
          "text": "Ein Violinist, den ich kenne, sagt, er besitze eine Stradivari.",
          "translation": "Один мой знакомый скрипач говорит, что у него есть страдивари.",
          "source": "Tatoeba #2927056 @Pfirsichbaeumchen / #13946443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2927056",
          "cefr_level": "A1",
          "word_slugs": [
            "besitze-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
