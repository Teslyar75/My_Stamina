          ]
        },
        {
          "id": "1818339",
          "text": "Diese Wunde heilt rasch.",
          "translation": "Эта рана быстро заживает.",
          "source": "Tatoeba #1818339 @Esperantostern / #12762115 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1818339",
          "cefr_level": "A1",
          "word_slugs": [
            "rasch-adj"
          ]
        },
        {
          "id": "12607793",
          "text": "Ich entfernte mich rasch.",
          "translation": "Я быстро удалился.",
          "source": "Tatoeba #12607793 @Waldelfe / #14101882 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12607793",
          "cefr_level": "A1",
          "word_slugs": [
            "rasch-adj"
          ]
        },
        {
          "id": "910861",
          "text": "Sie gewöhnten einander rasch.",
