            "lande-noun"
          ]
        },
        {
          "id": "2943149",
          "text": "Im Lande sind Veränderungen unvermeidlich.",
          "translation": "Изменения в стране неизбежны.",
          "source": "Tatoeba #2943149 @al_ex_an_der / #2943148 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2943149",
          "cefr_level": "A1",
