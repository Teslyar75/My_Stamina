      },
      "gender": "n",
      "examples": [
        {
          "id": "1206373",
          "text": "Er hat ein gutes Gehör.",
          "translation": "У него хороший слух.",
          "source": "Tatoeba #1206373 @Esperantostern / #5913651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1206373",
