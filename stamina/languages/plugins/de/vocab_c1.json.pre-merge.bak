    {
      "slug": "überdenken-verb",
      "lemma": "überdenken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7045,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to reconsider, to rethink",
          "to think over, to consider"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13907837",
          "text": "Du musst deinen Tagesablauf überdenken.",
          "translation": "Тебе надо пересмотреть свой режим дня.",
          "source": "Tatoeba #13907837 @mhr / #13907724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13907837",
          "cefr_level": "A1",
          "word_slugs": [
            "überdenken-verb"
          ]
        },
        {
          "id": "13907841",
          "text": "Sie müssen Ihren Tagesablauf überdenken.",
          "translation": "Вам надо пересмотреть свой режим дня.",
          "source": "Tatoeba #13907841 @mhr / #13907723 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13907841",
          "cefr_level": "A1",
          "word_slugs": [
            "überdenken-verb"
          ]
        },
        {
          "id": "3006818",
          "text": "Ich möchte, dass Sie Ihre Entscheidung noch einmal überdenken.",
          "translation": "Я бы хотел, чтобы вы обдумали ваше решение ещё раз.",
          "source": "Tatoeba #3006818 @raggione / #4505032 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3006818",
          "cefr_level": "A1",
          "word_slugs": [
            "überdenken-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
