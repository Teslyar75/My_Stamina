    {
      "slug": "vorzustellen-verb",
      "lemma": "vorzustellen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5749,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of vorstellen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6460956",
          "text": "Ich bat sie, ihn mir vorzustellen.",
          "translation": "Я попросил её представить его мне.",
          "source": "Tatoeba #6460956 @Pfirsichbaeumchen / #7274114 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6460956",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzustellen-verb"
          ]
        },
        {
          "id": "8705991",
          "text": "Ich bat ihn, sie mir vorzustellen.",
          "translation": "Я попросил его представить её мне.",
          "source": "Tatoeba #8705991 @Pfirsichbaeumchen / #7274110 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8705991",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzustellen-verb"
          ]
        },
        {
          "id": "1822326",
          "text": "Bitte erlauben Sie mir, mich vorzustellen.",
          "translation": "Разрешите представиться.",
          "source": "Tatoeba #1822326 @Tamy / #698000 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1822326",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzustellen-verb"
          ]
        },
        {
          "id": "5263009",
          "text": "Es ist fast unmöglich, sich das vorzustellen.",
          "translation": "Это почти невозможно себе представить.",
          "source": "Tatoeba #5263009 @Pfirsichbaeumchen / #5263002 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5263009",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzustellen-verb"
          ]
        },
        {
          "id": "937531",
          "text": "Ich hatte keine Gelegenheit, mich ihr vorzustellen.",
          "translation": "У меня не было возможности ей представиться.",
          "source": "Tatoeba #937531 @Sudajaengi / #12694850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/937531",
          "cefr_level": "A1",
          "word_slugs": [
            "vorzustellen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
