    {
      "slug": "brüdern-noun",
      "lemma": "Brüdern",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7537,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Bruder"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5239804",
          "text": "Tom ist einer von Marias Brüdern.",
          "translation": "Том - один из братьев Мэри.",
          "source": "Tatoeba #5239804 @Pfirsichbaeumchen / #5239279 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5239804",
          "cefr_level": "A1",
          "word_slugs": [
            "brüdern-noun"
          ]
        },
        {
          "id": "8857843",
          "text": "Tom spielt draußen mit seinen Brüdern.",
          "translation": "Том играет на улице со своими братьями.",
          "source": "Tatoeba #8857843 @Pfirsichbaeumchen / #9263153 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8857843",
          "cefr_level": "A1",
          "word_slugs": [
            "brüdern-noun"
          ]
        },
        {
          "id": "374336",
          "text": "Ich werde oft mit meinen Brüdern verglichen.",
          "translation": "Меня часто сравнивают с братьями.",
          "source": "Tatoeba #374336 @Liface / #10888322 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/374336",
          "cefr_level": "A1",
          "word_slugs": [
            "brüdern-noun"
          ]
        },
        {
          "id": "784086",
          "text": "Er hielt sein Versprechen und half seinen Brüdern.",
