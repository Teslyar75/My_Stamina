    {
      "slug": "wurzeln-noun",
      "lemma": "Wurzeln",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7055,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Wurzel \"roots\""
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5072959",
          "text": "Maria hat polnische Wurzeln.",
          "translation": "У Марии польские корни.",
          "source": "Tatoeba #5072959 @al_ex_an_der / #5073876 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5072959",
          "cefr_level": "A1",
          "word_slugs": [
            "wurzeln-noun"
          ]
        },
        {
          "id": "8986680",
          "text": "Quadratische Gleichungen haben zwei Wurzeln.",
          "translation": "Квадратные уравнения имеют два корня.",
          "source": "Tatoeba #8986680 @Pfirsichbaeumchen / #12303249 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8986680",
          "cefr_level": "A1",
          "word_slugs": [
            "wurzeln-noun"
          ]
        },
        {
          "id": "12157829",
          "text": "Viele englische Wörter haben lateinische Wurzeln.",
          "translation": "У многих английских слов латинские корни.",
          "source": "Tatoeba #12157829 @Pfirsichbaeumchen / #12157822 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12157829",
          "cefr_level": "A1",
          "word_slugs": [
            "wurzeln-noun"
          ]
        },
        {
          "id": "4268735",
          "text": "Die Kraft des Leberwurstbaumes beruht auf seinen Wurzeln.",
          "translation": "Сила баобаба - в его корнях.",
          "source": "Tatoeba #4268735 @Esperantostern / #4269803 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4268735",
          "cefr_level": "A1",
          "word_slugs": [
            "wurzeln-noun"
          ]
        },
        {
          "id": "12786531",
          "text": "Ein Baum ohne starke Wurzeln bringt keine guten Früchte hervor.",
          "translation": "Дерево без крепких корней не даст хороших плодов.",
          "source": "Tatoeba #12786531 @mhr / #12785659 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12786531",
          "cefr_level": "A1",
          "word_slugs": [
            "wurzeln-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
