    {
      "slug": "zusammenhalten-verb",
      "lemma": "zusammenhalten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7952,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to hold together, to keep together",
          "to stick together (to remain united, to stay together in association or alliance)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5499605",
          "text": "Wir müssen zusammenhalten.",
          "translation": "Мы должны держаться вместе.",
          "source": "Tatoeba #5499605 @Pfirsichbaeumchen / #4108307 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5499605",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenhalten-verb"
          ]
        },
        {
          "id": "1721568",
          "text": "Wir sollten alle zusammenhalten.",
          "translation": "Мы должны были держаться вместе.",
          "source": "Tatoeba #1721568 @Pfirsichbaeumchen / #2852301 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1721568",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenhalten-verb"
          ]
        },
        {
          "id": "2826889",
          "text": "Tom und ich müssen zusammenhalten.",
          "translation": "Мы с Томом должны держаться вместе.",
          "source": "Tatoeba #2826889 @Pfirsichbaeumchen / #7004463 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2826889",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenhalten-verb"
          ]
        },
        {
          "id": "3005035",
          "text": "In Zeiten wie diesen sollten wir alle zusammenhalten.",
          "translation": "В такие времена мы все должны держаться вместе.",
          "source": "Tatoeba #3005035 @Pfirsichbaeumchen / #13289564 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3005035",
          "cefr_level": "A1",
          "word_slugs": [
            "zusammenhalten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
