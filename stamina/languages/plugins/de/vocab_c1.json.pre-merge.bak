          "source": "Tatoeba #5099304 @Pfirsichbaeumchen / #5100412 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5099304",
          "cefr_level": "A1",
          "word_slugs": [
            "gereicht-verb"
          ]
        },
        {
          "id": "1290553",
          "text": "Das Foto wurde von Hand zu Hand gereicht.",
          "translation": "Фотография передавалась из рук в руки.",
          "source": "Tatoeba #1290553 @enteka / #5973695 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1290553",
          "cefr_level": "A1",
          "word_slugs": [
            "gereicht-verb"
          ]
        },
        {
          "id": "12181327",
          "text": "Borschtsch wird oft mit Dill und saurer Sahne gereicht.",
          "translation": "Борщ часто подаётся с укропом и сметаной.",
          "source": "Tatoeba #12181327 @Pfirsichbaeumchen / #5388191 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12181327",
          "cefr_level": "A1",
          "word_slugs": [
            "gereicht-verb"
          ]
        }
      ],
