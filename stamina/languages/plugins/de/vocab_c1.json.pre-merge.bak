    {
      "slug": "immerzu-adv",
      "lemma": "immerzu",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8256,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "incessantly"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2422302",
          "text": "Er liest immerzu.",
          "translation": "Он постоянно читает.",
          "source": "Tatoeba #2422302 @Esperantostern / #4947034 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2422302",
          "cefr_level": "A1",
          "word_slugs": [
            "immerzu-adv"
          ]
        },
        {
          "id": "2069755",
          "text": "Er lobt sie immerzu.",
          "translation": "Он постоянно хвалит её.",
          "source": "Tatoeba #2069755 @Pfirsichbaeumchen / #2069726 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2069755",
          "cefr_level": "A1",
          "word_slugs": [
            "immerzu-adv"
          ]
        },
        {
          "id": "851291",
          "text": "Die Katze miaut immerzu.",
          "translation": "Кошка беспрестанно мяучит.",
          "source": "Tatoeba #851291 @Esperantostern / #4947036 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/851291",
          "cefr_level": "A1",
          "word_slugs": [
            "immerzu-adv"
          ]
        },
        {
          "id": "936361",
          "text": "Ich fühle mich immerzu schläfrig.",
          "translation": "Я постоянно чувствую себя сонным.",
          "source": "Tatoeba #936361 @Sudajaengi / #2340670 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/936361",
          "cefr_level": "A1",
          "word_slugs": [
            "immerzu-adv"
          ]
        },
        {
          "id": "1182875",
          "text": "Immerzu verwechsle ich Backbord und Steuerbord.",
          "translation": "Я всегда путаю, где левый борт, а где правый.",
          "source": "Tatoeba #1182875 @Sudajaengi / #12821575 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1182875",
          "cefr_level": "A1",
          "word_slugs": [
            "immerzu-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
