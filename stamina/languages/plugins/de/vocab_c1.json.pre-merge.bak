    {
      "slug": "fasst-verb",
      "lemma": "fasst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5975,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of fassen:",
          "second/third-person singular present",
          "inflection of fassen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4942975",
          "text": "Fasst euch kurz.",
          "translation": "Будьте кратки.",
          "source": "Tatoeba #4942975 @Hans_Adler / #14004573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4942975",
          "cefr_level": "A1",
          "word_slugs": [
            "fasst-verb"
          ]
        },
        {
          "id": "2176624",
          "text": "Der Bus fasst 50 Leute.",
          "translation": "Автобус вмещает пятьдесят человек.",
          "source": "Tatoeba #2176624 @Zaghawa / #8101496 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2176624",
          "cefr_level": "A1",
          "word_slugs": [
            "fasst-verb"
          ]
        },
        {
          "id": "1453475",
          "text": "Fasst meine Sachen nicht an!",
          "translation": "Не трогайте мои вещи.",
          "source": "Tatoeba #1453475 @al_ex_an_der / #1993145 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1453475",
          "cefr_level": "A1",
          "word_slugs": [
            "fasst-verb"
          ]
        },
        {
          "id": "2732719",
          "text": "Diese Flasche fasst einen Liter.",
          "translation": "Это литровая бутылка.",
          "source": "Tatoeba #2732719 @brauchinet / #12304947 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2732719",
          "cefr_level": "A1",
          "word_slugs": [
            "fasst-verb"
          ]
        },
        {
          "id": "979633",
          "text": "Dieser Aufzug fasst acht Personen.",
          "translation": "Этот лифт вмещает восемь человек.",
          "source": "Tatoeba #979633 @Sudajaengi / #4903525 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/979633",
          "cefr_level": "A1",
          "word_slugs": [
