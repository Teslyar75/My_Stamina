      "gender": null,
      "examples": [
        {
          "id": "12074315",
          "text": "Wir sind vernünftige Leute.",
          "translation": "Мы разумные люди.",
          "source": "Tatoeba #12074315 @Pfirsichbaeumchen / #4292651 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12074315",
          "cefr_level": "A1",
