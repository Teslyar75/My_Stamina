    {
      "slug": "zusätzlich-adj",
      "lemma": "zusätzlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8731,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "дополнительный",
          "дополнительно"
        ],
        "en": [
          "additional, extra, supplementary",
          "ancillary"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4793641",
          "text": "Neben Schweizerdeutsch wird in der Schweiz zusätzlich Französisch, Italienisch und Rätoromanisch gesprochen.",
          "translation": "Наряду с швейцарским немецким языком, в Швейцарии разговаривают ещё на французском, итальянском и ретороманском языках.",
