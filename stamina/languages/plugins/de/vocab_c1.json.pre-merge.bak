    {
      "slug": "büssen-verb",
      "lemma": "büßen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5684,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
