    {
      "slug": "datei-noun",
      "lemma": "Datei",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8130,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "файл"
        ],
        "en": [
          "file",
          "file, register"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "14017312",
          "text": "Hier ist die Datei.",
          "translation": "Вот файл.",
          "source": "Tatoeba #14017312 @Vortarulo / #5049368 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14017312",
          "cefr_level": "A1",
          "word_slugs": [
            "datei-noun"
          ]
        },
        {
          "id": "2977576",
          "text": "Die Datei ist beschädigt.",
          "translation": "Файл повреждён.",
          "source": "Tatoeba #2977576 @Pfirsichbaeumchen / #2394478 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2977576",
          "cefr_level": "A1",
          "word_slugs": [
            "datei-noun"
          ]
        },
        {
          "id": "5912571",
          "text": "Ich habe die Datei gelöscht.",
          "translation": "Я удалил тот файл.",
          "source": "Tatoeba #5912571 @Pfirsichbaeumchen / #5882543 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5912571",
          "cefr_level": "A1",
          "word_slugs": [
            "datei-noun"
          ]
        },
        {
          "id": "12946968",
          "text": "Bitte verschlüsselt die Datei nicht.",
          "translation": "Пожалуйста, не шифруйте файл.",
          "source": "Tatoeba #12946968 @mhr / #12946462 @saxaham23 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12946968",
          "cefr_level": "A1",
          "word_slugs": [
            "datei-noun"
          ]
        },
        {
          "id": "13679361",
          "text": "Die Datei ist natürlich passwortgeschützt.",
          "translation": "Файл, естественно, запаролен.",
          "source": "Tatoeba #13679361 @mhr / #13679263 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13679361",
          "cefr_level": "A1",
          "word_slugs": [
            "datei-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
