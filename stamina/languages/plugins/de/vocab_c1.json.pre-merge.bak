    {
      "slug": "dicken-adj",
      "lemma": "dicken",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5263,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of dick:",
          "strong genitive masculine/neuter singular",
          "inflection of dick:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1513409",
          "text": "Die Insel war in dicken Nebel eingehüllt.",
          "translation": "Остров был окутан густым туманом.",
          "source": "Tatoeba #1513409 @sprohaska / #6487824 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1513409",
          "cefr_level": "A1",
          "word_slugs": [
            "dicken-adj"
          ]
        },
        {
          "id": "14092509",
          "text": "Die Sonne verschwand hinter einer dicken Wolkenschicht.",
          "translation": "Солнце скрылось за плотным слоем облаков.",
          "source": "Tatoeba #14092509 @mhr / #14092504 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14092509",
          "cefr_level": "A1",
          "word_slugs": [
            "dicken-adj"
          ]
        },
        {
          "id": "10655242",
          "text": "Der Erdboden ist mit einer dicken Tonschicht überzogen.",
          "translation": "Есть толстый слой глины над почвой.",
          "source": "Tatoeba #10655242 @annalog / #7526967 @Kuznechik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10655242",
          "cefr_level": "A1",
          "word_slugs": [
            "dicken-adj"
          ]
        }
      ],
