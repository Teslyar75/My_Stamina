      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "самурай"
        ],
        "en": [
          "samurai"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3308007",
          "text": "Was ist der Unterschied zwischen einem Samurai und einem Ninja?",
          "translation": "А в чём разница между самураем и ниндзя?",
          "source": "Tatoeba #3308007 @Pfirsichbaeumchen / #3307699 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3308007",
          "cefr_level": "A1",
          "word_slugs": [
            "samurai-noun"
          ]
        },
        {
          "id": "3308008",
          "text": "Worin liegt der Unterschied zwischen einem Samurai und einem Ninja?",
          "translation": "А в чём разница между самураем и ниндзя?",
          "source": "Tatoeba #3308008 @Pfirsichbaeumchen / #3307699 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3308008",
          "cefr_level": "A1",
          "word_slugs": [
            "samurai-noun"
          ]
        },
        {
          "id": "9358540",
          "text": "Samurai lebten nach einem Ehrenkodex.",
          "translation": "Самураи жили по кодексу чести.",
          "source": "Tatoeba #9358540 @Pfirsichbaeumchen / #9500283 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9358540",
          "cefr_level": "A1",
          "word_slugs": [
            "samurai-noun"
          ]
        },
        {
          "id": "9358549",
          "text": "Samurai lebten nach einem Ehrenkodex, der „Bushidō“ hieß.",
          "translation": "Самураи жили по кодексу чести - бусидо.",
          "source": "Tatoeba #9358549 @Pfirsichbaeumchen / #9500287 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9358549",
          "cefr_level": "A1",
          "word_slugs": [
            "samurai-noun"
          ]
        }
      ],
      "tags": [
