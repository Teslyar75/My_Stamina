      "frequency_rank": 6922,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "скромный"
        ],
        "en": [
          "modest, humble (of a person)",
          "limited, disappointing, little (of qualities, especially success/growth)",
          "euphemistic form of beschissen (“shitty”)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3558503",
          "text": "Tom ist bescheiden.",
          "translation": "Том скромный.",
          "source": "Tatoeba #3558503 @fleur74 / #5560514 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3558503",
          "cefr_level": "A1",
          "word_slugs": [
            "bescheiden-adj"
          ]
        },
        {
          "id": "7193648",
          "text": "Du bist bescheiden.",
          "translation": "Ты скромный.",
          "source": "Tatoeba #7193648 @Luiaard / #5225384 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7193648",
          "cefr_level": "A1",
          "word_slugs": [
            "bescheiden-adj"
          ]
        },
        {
          "id": "7193649",
          "text": "Ihr seid bescheiden.",
          "translation": "Вы скромные.",
          "source": "Tatoeba #7193649 @Luiaard / #13670206 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7193649",
          "cefr_level": "A1",
          "word_slugs": [
            "bescheiden-adj"
          ]
        },
        {
          "id": "7193651",
          "text": "Sie sind bescheiden.",
          "translation": "Они скромные.",
          "source": "Tatoeba #7193651 @Luiaard / #13670207 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7193651",
          "cefr_level": "A1",
          "word_slugs": [
            "bescheiden-adj"
          ]
        },
        {
          "id": "2217073",
          "text": "Sei nicht so bescheiden!",
          "translation": "Не будь таким скромным.",
          "source": "Tatoeba #2217073 @Pfirsichbaeumchen / #2305216 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2217073",
          "cefr_level": "A1",
