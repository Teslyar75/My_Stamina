    {
      "slug": "anfangs-adv",
      "lemma": "anfangs",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5634,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сначала"
        ],
        "en": [
          "initially, at the beginning"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11114929",
          "text": "Tom hasste Boston anfangs.",
          "translation": "Том сначала ненавидел Бостон.",
          "source": "Tatoeba #11114929 @Benze / #11114685 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11114929",
          "cefr_level": "A1",
          "word_slugs": [
            "anfangs-adv"
          ]
        },
        {
          "id": "402389",
          "text": "Er mochte sie anfangs nicht.",
          "translation": "Поначалу она ему не нравилась.",
          "source": "Tatoeba #402389 @MUIRIEL / #2770410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/402389",
          "cefr_level": "A1",
          "word_slugs": [
            "anfangs-adv"
          ]
        },
        {
          "id": "11945481",
          "text": "Wir dachten das anfangs auch.",
          "translation": "Мы тоже поначалу так думали.",
          "source": "Tatoeba #11945481 @Pfirsichbaeumchen / #10074163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11945481",
          "cefr_level": "A1",
          "word_slugs": [
            "anfangs-adv"
          ]
        },
        {
          "id": "4701150",
          "text": "Ich habe Tom anfangs nicht geglaubt.",
          "translation": "Поначалу я Тому не поверил.",
          "source": "Tatoeba #4701150 @dannylow / #4702805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4701150",
          "cefr_level": "A1",
          "word_slugs": [
            "anfangs-adv"
          ]
        },
        {
          "id": "1538458",
          "text": "Am Anfang wird es schwer sein, aber alles ist anfangs schwer.",
          "translation": "Сначала это будет трудно, но лиха беда начало.",
          "source": "Tatoeba #1538458 @nemoli / #5652322 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1538458",
          "cefr_level": "A1",
          "word_slugs": [
            "anfangs-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
