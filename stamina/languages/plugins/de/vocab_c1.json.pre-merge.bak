      "gender": "m",
      "examples": [
        {
          "id": "402920",
          "text": "Er ist zu empfindlich.",
          "translation": "Он слишком чувствительный.",
          "source": "Tatoeba #402920 @MUIRIEL / #1190907 @Imp (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/402920",
          "cefr_level": "A1",
