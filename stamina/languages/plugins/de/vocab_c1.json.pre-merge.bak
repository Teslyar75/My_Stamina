        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "156",
          "text": "Wie viele enge Freunde hast du?",
          "translation": "Сколько у тебя близких друзей?",
          "source": "Tatoeba #156 @MUIRIEL / #5488 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/156",
          "cefr_level": "A1",
          "word_slugs": [
            "enge-adj"
          ]
        },
        {
          "id": "2976780",
          "text": "Tom und Mary sind enge Freunde.",
          "translation": "Том и Мэри - большие друзья.",
          "source": "Tatoeba #2976780 @Handkaes / #6690817 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2976780",
          "cefr_level": "A1",
          "word_slugs": [
            "enge-adj"
          ]
        },
        {
          "id": "3407382",
          "text": "Ich habe sehr wenige richtig enge Freunde.",
          "translation": "У меня очень мало действительно близких друзей.",
          "source": "Tatoeba #3407382 @Pfirsichbaeumchen / #12728908 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3407382",
          "cefr_level": "A1",
