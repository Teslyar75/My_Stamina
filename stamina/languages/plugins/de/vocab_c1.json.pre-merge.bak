    {
      "slug": "geringsten-adj",
      "lemma": "geringsten",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7306,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gering:",
          "strong genitive masculine/neuter singular superlative degree",
          "inflection of gering:",
          "weak/mixed genitive/dative all-gender singular superlative degree"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "446931",
          "text": "Ich bezweifle es nicht im Geringsten.",
          "translation": "Я в этом совсем не сомневаюсь.",
          "source": "Tatoeba #446931 @al_ex_an_der / #433372 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/446931",
          "cefr_level": "A1",
          "word_slugs": [
            "geringsten-adj"
          ]
        },
        {
          "id": "2666962",
          "text": "Das kümmert mich nicht im Geringsten.",
          "translation": "Это меня нисколько не волнует.",
          "source": "Tatoeba #2666962 @Olya / #2666963 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2666962",
          "cefr_level": "A1",
          "word_slugs": [
            "geringsten-adj"
          ]
        },
        {
          "id": "603989",
          "text": "Ich habe nicht den geringsten Zweifel.",
          "translation": "У меня нет ни малейшего сомнения.",
          "source": "Tatoeba #603989 @BraveSentry / #2139004 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/603989",
          "cefr_level": "A1",
          "word_slugs": [
            "geringsten-adj"
          ]
        },
        {
          "id": "12764191",
          "text": "Daran gibt es nicht den geringsten Zweifel.",
          "translation": "В этом нет ни тени сомнения.",
          "source": "Tatoeba #12764191 @mhr / #12764171 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12764191",
          "cefr_level": "A1",
          "word_slugs": [
            "geringsten-adj"
          ]
        },
        {
          "id": "1238410",
          "text": "Sie nahm den Weg des geringsten Widerstands.",
          "translation": "Она пошла по пути наименьшего сопротивления.",
          "source": "Tatoeba #1238410 @Esperantostern / #1591379 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1238410",
          "cefr_level": "A1",
          "word_slugs": [
            "geringsten-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
