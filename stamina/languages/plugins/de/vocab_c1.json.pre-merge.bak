    {
      "slug": "themen-noun",
      "lemma": "Themen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9934,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Thema"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1906874",
          "text": "Wir sprechen über verschiedene Themen.",
          "translation": "Мы говорим на разные темы.",
          "source": "Tatoeba #1906874 @Zaghawa / #5146703 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1906874",
          "cefr_level": "A1",
          "word_slugs": [
            "themen-noun"
          ]
        },
        {
          "id": "1906875",
          "text": "Wir sprachen über verschiedene Themen.",
          "translation": "Мы говорили на разные темы.",
          "source": "Tatoeba #1906875 @Zaghawa / #4281672 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1906875",
          "cefr_level": "A1",
          "word_slugs": [
            "themen-noun"
          ]
        },
        {
          "id": "1572654",
          "text": "Wir haben wichtige Themen zu besprechen.",
          "translation": "Нам нужно обсудить важные вопросы.",
          "source": "Tatoeba #1572654 @al_ex_an_der / #1572659 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1572654",
          "cefr_level": "A1",
          "word_slugs": [
            "themen-noun"
          ]
        },
        {
          "id": "2283468",
          "text": "Viviana hat wichtige Themen zu besprechen.",
          "translation": "Вивиана хочет обсудить важные вопросы.",
          "source": "Tatoeba #2283468 @Pfirsichbaeumchen / #1572642 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2283468",
          "cefr_level": "A1",
          "word_slugs": [
            "themen-noun"
          ]
        },
        {
          "id": "2943389",
          "text": "Wir können solche Themen nicht ignorieren.",
          "translation": "Мы не можем пройти мимо подобных тем.",
          "source": "Tatoeba #2943389 @al_ex_an_der / #2943386 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2943389",
          "cefr_level": "A1",
          "word_slugs": [
            "themen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
