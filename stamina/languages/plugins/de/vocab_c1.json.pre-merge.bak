    {
      "slug": "erobern-verb",
      "lemma": "erobern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6595,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "завоевать"
        ],
        "en": [
          "to conquer, to capture",
          "to win"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1842676",
          "text": "Ich versuche ihr Herz zu erobern.",
          "translation": "Я пытаюсь завоевать её сердце.",
          "source": "Tatoeba #1842676 @al_ex_an_der / #6465423 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1842676",
          "cefr_level": "A1",
          "word_slugs": [
            "erobern-verb"
          ]
        },
        {
          "id": "3123819",
          "text": "Tom versuchte, Marias Herz zu erobern.",
          "translation": "Том пытался завоевать сердце Мэри.",
          "source": "Tatoeba #3123819 @Pfirsichbaeumchen / #3878068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3123819",
          "cefr_level": "A1",
          "word_slugs": [
            "erobern-verb"
          ]
        },
        {
          "id": "12427728",
          "text": "Tom sagt, er will die Welt erobern.",
          "translation": "Том говорит, что хочет завоевать мир.",
          "source": "Tatoeba #12427728 @Waldelfe / #3518101 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12427728",
          "cefr_level": "A1",
          "word_slugs": [
            "erobern-verb"
          ]
        },
        {
          "id": "13652449",
          "text": "Strebe nicht danach, die Welt zu erobern; strebe danach, sie kennenzulernen.",
          "translation": "Не стремись покорить мир, стремись познать его.",
          "source": "Tatoeba #13652449 @mhr / #13652259 @Qvadratus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13652449",
          "cefr_level": "A1",
          "word_slugs": [
            "erobern-verb"
          ]
        },
        {
          "id": "13652453",
          "text": "Strebe nicht danach, die Welt zu erobern, sondern strebe danach, sie kennenzulernen.",
          "translation": "Не стремись покорить мир, стремись познать его.",
          "source": "Tatoeba #13652453 @mhr / #13652259 @Qvadratus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13652453",
          "cefr_level": "A1",
          "word_slugs": [
            "erobern-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
