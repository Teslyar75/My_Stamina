          ]
        },
        {
          "id": "2634379",
          "text": "Hast du dich je rasiert?",
          "translation": "Ты когда-нибудь брился?",
          "source": "Tatoeba #2634379 @Pfirsichbaeumchen / #1784160 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2634379",
