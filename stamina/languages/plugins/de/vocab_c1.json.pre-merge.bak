    {
      "slug": "gewitter-noun",
      "lemma": "Gewitter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9098,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "thunderstorm, lightning storm"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8636813",
          "text": "Ein Gewitter zieht auf.",
          "translation": "Надвигается гроза.",
          "source": "Tatoeba #8636813 @Melang / #5631248 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636813",
          "cefr_level": "A1",
          "word_slugs": [
            "gewitter-noun"
          ]
        },
        {
          "id": "6837336",
          "text": "Hast du Angst vor Gewitter?",
          "translation": "Ты боишься грозы?",
          "source": "Tatoeba #6837336 @rmateo / #6840426 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6837336",
          "cefr_level": "A1",
          "word_slugs": [
            "gewitter-noun"
          ]
        },
        {
          "id": "2445224",
          "text": "Heute Nacht wird es ein Gewitter geben.",
          "translation": "Ночью будет гроза.",
          "source": "Tatoeba #2445224 @al_ex_an_der / #2445222 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2445224",
          "cefr_level": "A1",
          "word_slugs": [
            "gewitter-noun"
          ]
        },
        {
          "id": "6867362",
          "text": "Haben Sie heute Nacht das Gewitter gehört?",
          "translation": "Вы слышали грозу сегодня ночью?",
          "source": "Tatoeba #6867362 @felix63 / #6878392 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6867362",
          "cefr_level": "A1",
          "word_slugs": [
            "gewitter-noun"
          ]
        },
        {
          "id": "2333927",
          "text": "Gegenwärtig haben wir einen Wolkenbruch und Gewitter.",
          "translation": "Сейчас у нас ливень с грозой.",
          "source": "Tatoeba #2333927 @freddy1 / #14032764 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2333927",
          "cefr_level": "A1",
          "word_slugs": [
            "gewitter-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
