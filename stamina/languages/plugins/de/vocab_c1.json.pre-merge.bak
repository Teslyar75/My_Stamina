        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1579338",
          "text": "Wir segeln nach Dänemark.",
          "translation": "Мы плывём в Данию.",
          "source": "Tatoeba #1579338 @Esperantostern / #12058863 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1579338",
          "cefr_level": "A1",
          "word_slugs": [
            "segeln-verb"
          ]
        },
        {
          "id": "825047",
          "text": "Wir segeln am Montag nach San Francisco.",
          "translation": "В понедельник мы отплываем в Сан-Франциско.",
          "source": "Tatoeba #825047 @Pfirsichbaeumchen / #6712560 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/825047",
          "cefr_level": "A1",
          "word_slugs": [
            "segeln-verb"
          ]
        },
        {
          "id": "8634072",
          "text": "Wie viele Tage dauert es, nach Boston zu segeln?",
          "translation": "Сколько суток плыть до Бостона?",
