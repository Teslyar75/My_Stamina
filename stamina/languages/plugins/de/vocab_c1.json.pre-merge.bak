    {
      "slug": "erwachsener-noun",
      "lemma": "Erwachsener",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7026,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "взрослый человек"
        ],
        "en": [
          "inflection of Erwachsene:",
          "strong genitive/dative singular",
          "inflection of Erwachsene:",
          "strong genitive plural"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5078591",
          "text": "Dieser Junge redet wie ein Erwachsener.",
          "translation": "Этот мальчик разговаривает как взрослый.",
          "source": "Tatoeba #5078591 @UliDolbarge / #5079121 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5078591",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsener-noun"
          ]
        },
        {
          "id": "12906784",
          "text": "Bist du ein Erwachsener oder ein Kind?",
          "translation": "Ты взрослый или ребёнок?",
          "source": "Tatoeba #12906784 @Waldelfe / #12906787 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12906784",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsener-noun"
          ]
        },
        {
          "id": "13924671",
          "text": "Tom denkt schon wie ein Erwachsener nach.",
          "translation": "Том рассуждает совсем как взрослый.",
          "source": "Tatoeba #13924671 @IAlexI / #6316411 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13924671",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsener-noun"
          ]
        },
        {
          "id": "2453165",
          "text": "Die Lehrerin fragt ihn, was er als Erwachsener werden wolle.",
          "translation": "Учительница спрашивает его, кем он хочет стать, когда вырастет.",
          "source": "Tatoeba #2453165 @al_ex_an_der / #2453192 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2453165",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsener-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Erwachsener",
        "nominative_pl": ""
      }
