    {
      "slug": "zudem-adv",
      "lemma": "zudem",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8230,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "к тому же",
          "кроме того"
        ],
        "en": [
          "moreover, furthermore"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2830505",
          "text": "Zudem regnete es auch noch.",
          "translation": "К тому же ещё и дождь шёл.",
          "source": "Tatoeba #2830505 @Pfirsichbaeumchen / #2827398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2830505",
          "cefr_level": "A1",
          "word_slugs": [
            "zudem-adv"
          ]
        },
        {
          "id": "1612060",
          "text": "An diesem Tag war es kalt, und zudem begann es zu regnen.",
          "translation": "Мало того, что в тот день было холодно, так еще и дождь пошел.",
          "source": "Tatoeba #1612060 @Esperantostern / #561780 @pandabear (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1612060",
          "cefr_level": "A1",
          "word_slugs": [
            "zudem-adv"
          ]
        }
      ],
