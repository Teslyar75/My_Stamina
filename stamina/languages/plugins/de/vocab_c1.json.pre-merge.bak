    {
      "slug": "wage-noun",
      "lemma": "Wage",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6544,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "obsolete spelling of Waage"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3507188",
          "text": "Wage bloß nicht zu weinen!",
          "translation": "Не смей даже плакать!",
          "source": "Tatoeba #3507188 @al_ex_an_der / #3507199 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3507188",
          "cefr_level": "A1",
          "word_slugs": [
            "wage-noun"
          ]
        },
        {
          "id": "6728964",
          "text": "Wage es nicht, das zu tun!",
          "translation": "Не смей этого делать.",
          "source": "Tatoeba #6728964 @Pfirsichbaeumchen / #4939653 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6728964",
          "cefr_level": "A1",
          "word_slugs": [
            "wage-noun"
          ]
        },
        {
          "id": "8096644",
          "text": "Wage es nicht, darauf zu antworten!",
          "translation": "Не смей отвечать на это.",
          "source": "Tatoeba #8096644 @Pfirsichbaeumchen / #4463455 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8096644",
          "cefr_level": "A1",
          "word_slugs": [
            "wage-noun"
          ]
        }
      ],
      "tags": [
