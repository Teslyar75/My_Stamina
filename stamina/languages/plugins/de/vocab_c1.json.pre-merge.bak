        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9115645",
          "text": "Hast du saubere Hände?",
          "translation": "У тебя чистые руки?",
          "source": "Tatoeba #9115645 @Adelpa / #2605485 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9115645",
          "cefr_level": "A1",
          "word_slugs": [
            "saubere-adj"
          ]
        },
        {
          "id": "1700847",
          "text": "Wir atmen saubere Luft.",
          "translation": "Мы дышим чистым воздухом.",
          "source": "Tatoeba #1700847 @Esperantostern / #1709351 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1700847",
          "cefr_level": "A1",
          "word_slugs": [
            "saubere-adj"
          ]
        },
        {
          "id": "6608889",
          "text": "Haben wir saubere Löffel?",
          "translation": "У нас есть чистые ложки?",
          "source": "Tatoeba #6608889 @Esperantostern / #2924378 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6608889",
          "cefr_level": "A1",
          "word_slugs": [
            "saubere-adj"
          ]
        },
        {
          "id": "12336496",
          "text": "Er trug eine saubere Hose.",
          "translation": "Он был в чистых брюках.",
          "source": "Tatoeba #12336496 @Pfirsichbaeumchen / #12336504 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12336496",
          "cefr_level": "A1",
          "word_slugs": [
            "saubere-adj"
          ]
        },
        {
          "id": "379831",
          "text": "Katzen sind sehr saubere Tiere.",
          "translation": "Кошки - очень чистоплотные животные.",
          "source": "Tatoeba #379831 @MUIRIEL / #1459625 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379831",
          "cefr_level": "A1",
          "word_slugs": [
            "saubere-adj"
          ]
        }
      ],
      "tags": [
