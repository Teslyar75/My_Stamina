    {
      "slug": "wärme-noun",
      "lemma": "Wärme",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6558,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
