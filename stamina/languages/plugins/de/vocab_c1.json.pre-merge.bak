    {
      "slug": "müsse-verb",
      "lemma": "müsse",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7107,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular subjunctive I of müssen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3254447",
          "text": "Tom sagte, ich müsse warten.",
          "translation": "Том сказал, что мне надо подождать.",
          "source": "Tatoeba #3254447 @Pfirsichbaeumchen / #3254439 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3254447",
          "cefr_level": "A1",
          "word_slugs": [
            "müsse-verb"
          ]
        },
        {
          "id": "3518810",
          "text": "Tom fürchtete, Maria müsse sterben.",
          "translation": "Том боялся, что Мария может умереть.",
          "source": "Tatoeba #3518810 @Pfirsichbaeumchen / #3519113 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3518810",
          "cefr_level": "A1",
          "word_slugs": [
            "müsse-verb"
          ]
        },
        {
          "id": "13399391",
          "text": "Es hieß, ich müsse das nicht.",
          "translation": "Мне сказали, я не обязан этого делать.",
          "source": "Tatoeba #13399391 @Waldelfe / #10475342 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13399391",
          "cefr_level": "A1",
          "word_slugs": [
            "müsse-verb"
          ]
        },
        {
          "id": "12586873",
          "text": "Er sagte, er müsse ihr helfen.",
          "translation": "Он сказал, что ему надо ей помочь.",
          "source": "Tatoeba #12586873 @Waldelfe / #13491780 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12586873",
          "cefr_level": "A1",
          "word_slugs": [
            "müsse-verb"
          ]
        },
        {
          "id": "12703910",
          "text": "Sie sagte, sie müsse ihm helfen.",
          "translation": "Она сказала, что ей надо ему помочь.",
          "source": "Tatoeba #12703910 @Waldelfe / #13491781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12703910",
          "cefr_level": "A1",
          "word_slugs": [
            "müsse-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
