    {
      "slug": "massnahmen-noun",
      "lemma": "Maßnahmen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7510,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Maßnahme"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "543872",
          "text": "Sofortige Maßnahmen sind notwendig.",
          "translation": "Необходимы срочные меры.",
          "source": "Tatoeba #543872 @xtofu80 / #1682822 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/543872",
          "cefr_level": "A1",
          "word_slugs": [
            "massnahmen-noun"
          ]
        },
        {
          "id": "1576178",
          "text": "Es sind sofortige Maßnahmen notwendig.",
          "translation": "Необходимы срочные меры.",
          "source": "Tatoeba #1576178 @Pfirsichbaeumchen / #1682822 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1576178",
          "cefr_level": "A1",
          "word_slugs": [
            "massnahmen-noun"
          ]
        },
        {
          "id": "2379019",
          "text": "Die Situation erfordert drastische Maßnahmen.",
          "translation": "Ситуация требует радикальных мер.",
          "source": "Tatoeba #2379019 @duke / #14099836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2379019",
          "cefr_level": "A1",
          "word_slugs": [
            "massnahmen-noun"
          ]
        },
        {
          "id": "2193584",
          "text": "Drastische Zeiten erfordern drastische Maßnahmen.",
          "translation": "Отчаянные времена требуют отчаянных мер.",
          "source": "Tatoeba #2193584 @Pfirsichbaeumchen / #2233221 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2193584",
          "cefr_level": "A1",
          "word_slugs": [
            "massnahmen-noun"
          ]
        },
        {
          "id": "12863674",
          "text": "Diese Maßnahmen förderten die Verbreitung der Alphabetisierung der Bevölkerung.",
          "translation": "Эти меры способствовали распространению грамотности среди населения.",
          "source": "Tatoeba #12863674 @mhr / #12863621 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12863674",
          "cefr_level": "A1",
          "word_slugs": [
            "massnahmen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
