    {
      "slug": "ertrinken-verb",
      "lemma": "ertrinken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7333,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "утопать"
        ],
        "en": [
          "to drown"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10655261",
          "text": "Fliegen ertrinken in Honig.",
          "translation": "В меду тонут мухи.",
          "source": "Tatoeba #10655261 @annalog / #8364341 @BW (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10655261",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-verb"
          ]
        },
        {
          "id": "1907351",
          "text": "Sie hätten ertrinken können!",
          "translation": "Они могли утонуть!",
          "source": "Tatoeba #1907351 @Pfirsichbaeumchen / #5143192 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1907351",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-verb"
          ]
        },
        {
          "id": "10655259",
          "text": "Die Fliegen ertrinken im Honig.",
          "translation": "В меду тонут мухи.",
          "source": "Tatoeba #10655259 @annalog / #8364341 @BW (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10655259",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-verb"
          ]
        },
        {
          "id": "1787473",
          "text": "Sie war kurz davor zu ertrinken.",
          "translation": "Она чуть не утонула.",
          "source": "Tatoeba #1787473 @Pfirsichbaeumchen / #816373 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1787473",
          "cefr_level": "A1",
          "word_slugs": [
            "ertrinken-verb"
          ]
        }
      ],
