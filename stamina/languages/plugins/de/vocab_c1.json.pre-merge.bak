    {
      "slug": "wechselt-verb",
      "lemma": "wechselt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9219,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of wechseln:",
          "third-person singular present",
          "inflection of wechseln:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "357465",
          "text": "In England wechselt das Wetter oft.",
          "translation": "В Англии погода часто меняется.",
          "source": "Tatoeba #357465 @MUIRIEL / #7863453 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/357465",
          "cefr_level": "A1",
          "word_slugs": [
            "wechselt-verb"
          ]
        },
        {
          "id": "9348053",
          "text": "Tom wechselt jeden Tag die Kleidung.",
          "translation": "Том меняет одежду каждый день.",
          "source": "Tatoeba #9348053 @Pfirsichbaeumchen / #9346828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9348053",
          "cefr_level": "A1",
          "word_slugs": [
            "wechselt-verb"
          ]
        },
        {
          "id": "1811295",
          "text": "Das Wetter wechselt häufig in England.",
          "translation": "Погода в Англии часто меняется.",
          "source": "Tatoeba #1811295 @Tamy / #14003690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1811295",
          "cefr_level": "A1",
          "word_slugs": [
            "wechselt-verb"
          ]
        },
        {
          "id": "1104375",
          "text": "Das Wetter wechselt von Stunde zu Stunde.",
          "translation": "Погода меняется каждый час.",
          "source": "Tatoeba #1104375 @Haehnchenpaella / #9096443 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1104375",
          "cefr_level": "A1",
          "word_slugs": [
            "wechselt-verb"
          ]
        },
        {
          "id": "5936305",
          "text": "Marias Laune wechselt minütlich: bald lacht sie, bald weint sie.",
          "translation": "Настроение у Мэри меняется поминутно: она то плачет, то смеётся.",
          "source": "Tatoeba #5936305 @Pfirsichbaeumchen / #5514446 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5936305",
          "cefr_level": "A1",
          "word_slugs": [
            "wechselt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "erforschen-verb",
      "lemma": "erforschen",
      "pos": "verb",
      "language": "de",
