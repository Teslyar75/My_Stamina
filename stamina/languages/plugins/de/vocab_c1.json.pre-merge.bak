      "gender": null,
      "examples": [
        {
          "id": "8572773",
          "text": "Auf seinem Grab lagen Blumen.",
          "translation": "У него на могиле лежали цветы.",
          "source": "Tatoeba #8572773 @felix63 / #8572785 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8572773",
          "cefr_level": "A1",
          "word_slugs": [
            "lagen-verb"
          ]
        },
        {
          "id": "3507171",
          "text": "Auf dem Tisch lagen allerlei Bücher.",
          "translation": "На столе лежали всякие книги.",
          "source": "Tatoeba #3507171 @al_ex_an_der / #3507172 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3507171",
          "cefr_level": "A1",
          "word_slugs": [
            "lagen-verb"
          ]
        },
        {
          "id": "5233717",
          "text": "Überall auf dem Landweg lagen Kuhfladen.",
          "translation": "По всей проселочной дороге лежал коровий навоз.",
          "source": "Tatoeba #5233717 @Pfirsichbaeumchen / #11067739 @Almi92 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5233717",
          "cefr_level": "A1",
          "word_slugs": [
            "lagen-verb"
          ]
        },
        {
          "id": "7891483",
          "text": "Kleider lagen über den Fußboden verstreut.",
          "translation": "По полу была разбросана одежда.",
          "source": "Tatoeba #7891483 @raggione / #6680216 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7891483",
          "cefr_level": "A1",
          "word_slugs": [
            "lagen-verb"
          ]
        },
        {
          "id": "674704",
          "text": "Auf dem Tisch lagen vier Stücke Käse.",
          "translation": "На столе лежало четыре кусочка сыра.",
          "source": "Tatoeba #674704 @samueldora / #10793210 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/674704",
          "cefr_level": "A1",
          "word_slugs": [
            "lagen-verb"
          ]
        }
