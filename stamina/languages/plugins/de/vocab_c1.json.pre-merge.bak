    {
      "slug": "dienste-noun",
      "lemma": "Dienste",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5143,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Dienst"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2650311",
          "text": "Der Mantel tat mir gute Dienste.",
          "translation": "Пальто сослужило мне хорошую службу.",
          "source": "Tatoeba #2650311 @Olya / #2650312 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650311",
          "cefr_level": "A1",
          "word_slugs": [
            "dienste-noun"
          ]
        },
        {
          "id": "812738",
          "text": "Luft, Wasser, Feuer, Erden muss dir zu Dienste werden.",
          "translation": "Да служат тебе воздух, вода, огонь и земля.",
          "source": "Tatoeba #812738 @BraveSentry / #3235525 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/812738",
          "cefr_level": "A1",
          "word_slugs": [
            "dienste-noun"
          ]
        },
        {
          "id": "2908906",
          "text": "Ihr Liebhaber ist ein Spion im Dienste der britischen Regierung.",
          "translation": "Её любовник - шпион, работающий на британское правительство.",
          "source": "Tatoeba #2908906 @Pfirsichbaeumchen / #2908677 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2908906",
          "cefr_level": "A1",
          "word_slugs": [
            "dienste-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
