    {
      "slug": "rückweg-noun",
      "lemma": "Rückweg",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8456,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "way back"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7217956",
          "text": "Kauf auf dem Rückweg Milch!",
          "translation": "По дороге домой купи молока.",
          "source": "Tatoeba #7217956 @Pfirsichbaeumchen / #10535773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7217956",
          "cefr_level": "A1",
          "word_slugs": [
            "rückweg-noun"
          ]
        },
        {
          "id": "13659457",
          "text": "Der Rückweg ist immer schwerer.",
          "translation": "Обратная дорога всегда труднее.",
          "source": "Tatoeba #13659457 @mhr / #13658893 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13659457",
          "cefr_level": "A1",
          "word_slugs": [
            "rückweg-noun"
          ]
        },
        {
          "id": "13659450",
          "text": "Der Rückweg ist immer schwieriger.",
          "translation": "Обратная дорога всегда труднее.",
          "source": "Tatoeba #13659450 @mhr / #13658893 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13659450",
          "cefr_level": "A1",
          "word_slugs": [
            "rückweg-noun"
          ]
        },
        {
          "id": "13659453",
          "text": "Der Rückweg ist immer anstrengender.",
          "translation": "Обратная дорога всегда труднее.",
          "source": "Tatoeba #13659453 @mhr / #13658893 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13659453",
          "cefr_level": "A1",
          "word_slugs": [
            "rückweg-noun"
          ]
        },
        {
          "id": "1519359",
          "text": "Pass auf deinem Rückweg nach Hause auf.",
          "translation": "Будь осторожен по дороге домой.",
          "source": "Tatoeba #1519359 @Espi / #380983 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1519359",
          "cefr_level": "A1",
          "word_slugs": [
            "rückweg-noun"
          ]
        }
