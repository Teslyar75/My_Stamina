          ]
        },
        {
          "id": "2514770",
          "text": "Das übertraf meine Erwartungen.",
          "translation": "Это превзошло все мои ожидания.",
          "source": "Tatoeba #2514770 @Pfirsichbaeumchen / #8967971 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2514770",
          "cefr_level": "A1",
          "word_slugs": [
