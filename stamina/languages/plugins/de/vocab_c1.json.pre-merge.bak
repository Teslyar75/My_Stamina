    {
      "slug": "mordwaffe-noun",
      "lemma": "Mordwaffe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8694,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "murder weapon"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5094147",
          "text": "Die Mordwaffe wurde nie gefunden.",
          "translation": "Орудие убийства так и не было найдено.",
          "source": "Tatoeba #5094147 @Manfredo / #10876516 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5094147",
          "cefr_level": "A1",
          "word_slugs": [
            "mordwaffe-noun"
          ]
        },
        {
          "id": "5094148",
          "text": "Die Mordwaffe ist nie gefunden worden.",
          "translation": "Орудие убийства никогда не было найдено.",
          "source": "Tatoeba #5094148 @Manfredo / #5781688 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5094148",
          "cefr_level": "A1",
          "word_slugs": [
            "mordwaffe-noun"
          ]
        },
        {
          "id": "10290333",
          "text": "Der Mörder hat auf der Mordwaffe seine Fingerabdrücke hinterlassen.",
          "translation": "Убийца оставил на орудии преступления свои отпечатки пальцев.",
          "source": "Tatoeba #10290333 @Pfirsichbaeumchen / #12444030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10290333",
          "cefr_level": "A1",
          "word_slugs": [
            "mordwaffe-noun"
          ]
        },
        {
          "id": "8859885",
          "text": "Das Geld und die Mordwaffe wurden bei Tom auf dem Dachboden gefunden.",
          "translation": "Деньги и орудие убийства были найдены у Тома на чердаке.",
          "source": "Tatoeba #8859885 @Pfirsichbaeumchen / #8863025 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8859885",
          "cefr_level": "A1",
          "word_slugs": [
            "mordwaffe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
