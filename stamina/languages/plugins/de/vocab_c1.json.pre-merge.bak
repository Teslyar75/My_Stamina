        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "8244914",
          "text": "Zebras haben Streifen.",
          "translation": "У зебр полоски.",
          "source": "Tatoeba #8244914 @MisterTrouser / #12431743 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8244914",
          "cefr_level": "A1",
          "word_slugs": [
            "streifen-noun"
          ]
        },
        {
          "id": "6326881",
          "text": "Warum haben Zebras Streifen?",
          "translation": "Почему у зебр полоски?",
          "source": "Tatoeba #6326881 @Pfirsichbaeumchen / #5050964 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326881",
          "cefr_level": "A1",
          "word_slugs": [
            "streifen-noun"
          ]
        },
        {
          "id": "13269771",
          "text": "Welche Tiere haben Streifen?",
          "translation": "У каких животных есть полоски?",
          "source": "Tatoeba #13269771 @felix63 / #13269796 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13269771",
          "cefr_level": "A1",
          "word_slugs": [
            "streifen-noun"
          ]
        },
        {
          "id": "8934197",
          "text": "Haben Zebras unterschiedliche Streifen?",
          "translation": "У зебр разные полоски?",
          "source": "Tatoeba #8934197 @manese / #13658402 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8934197",
          "cefr_level": "A1",
          "word_slugs": [
            "streifen-noun"
          ]
        },
        {
          "id": "7669003",
          "text": "Sie trägt einen Rock mit roten Streifen.",
          "translation": "На ней юбка с красными полосками.",
          "source": "Tatoeba #7669003 @list / #13577348 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7669003",
          "cefr_level": "A1",
          "word_slugs": [
            "streifen-noun"
          ]
        }
      ],
      "tags": [
