    {
      "slug": "hawaii-name",
      "lemma": "Hawaii",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6219,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Hawaii, Hawaii Island (an island of Hawaii archipelago, Pacific Ocean, of Hawaii County, State of Hawaii, United States)",
          "Hawaii (an insular state of the United States, formerly a territory)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13681474",
          "text": "Das ist doch Hawaii!",
          "translation": "Так это же Гавайи!",
          "source": "Tatoeba #13681474 @mhr / #13681319 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13681474",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        },
        {
          "id": "5313683",
          "text": "Ich will nach Hawaii.",
          "translation": "Я хочу на Гавайи.",
          "source": "Tatoeba #5313683 @Pfirsichbaeumchen / #5652409 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5313683",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        },
        {
          "id": "1252407",
          "text": "Gibt es Bier auf Hawaii?",
          "translation": "На Гавайях есть пиво?",
          "source": "Tatoeba #1252407 @Esperantostern / #10121257 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1252407",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        },
        {
          "id": "1053586",
          "text": "Ich möchte nach Hawaii fahren.",
          "translation": "Я бы хотел поехать на Гавайи.",
          "source": "Tatoeba #1053586 @mayok / #2354014 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1053586",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        },
        {
          "id": "3791788",
          "text": "Sein Geld verdampfte in Hawaii.",
          "translation": "Его деньги испарились на Гавайях.",
          "source": "Tatoeba #3791788 @Esperantostern / #9406402 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3791788",
          "cefr_level": "A1",
          "word_slugs": [
            "hawaii-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
