    {
      "slug": "schwor-verb",
      "lemma": "schwor",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9883,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of schwören",
          "first/third-person singular preterite of schwären"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12596465",
          "text": "Sie schwor, das nie wieder zu tun.",
          "translation": "Она поклялась никогда так больше не делать.",
          "source": "Tatoeba #12596465 @Waldelfe / #12596472 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12596465",
          "cefr_level": "A1",
          "word_slugs": [
            "schwor-verb"
          ]
        },
        {
          "id": "3328343",
          "text": "Er schwor sich, mit dem Rauchen aufzuhören.",
          "translation": "Он поклялся, что бросит курить.",
          "source": "Tatoeba #3328343 @Pfirsichbaeumchen / #8745918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3328343",
          "cefr_level": "A1",
          "word_slugs": [
            "schwor-verb"
          ]
        },
        {
          "id": "955610",
          "text": "Er schwor seiner Verlobten Treue bis zum Tod.",
          "translation": "Он поклялся своей невесте в верности до самой смерти.",
          "source": "Tatoeba #955610 @Manfredo / #2026512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/955610",
          "cefr_level": "A1",
          "word_slugs": [
            "schwor-verb"
          ]
        },
        {
          "id": "12596464",
          "text": "Sie schwor, daß sie das nie wieder tun würde.",
          "translation": "Она поклялась, что больше никогда так не будет.",
          "source": "Tatoeba #12596464 @Waldelfe / #12596474 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12596464",
          "cefr_level": "A1",
          "word_slugs": [
            "schwor-verb"
          ]
        },
        {
          "id": "8813279",
          "text": "Der Kaiser schwor, die Abtrünnigen ein für allemal niederzuwerfen.",
          "translation": "Император поклялся раз и навсегда разгромить сепаратистов.",
          "source": "Tatoeba #8813279 @Pfirsichbaeumchen / #8798149 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8813279",
          "cefr_level": "A1",
          "word_slugs": [
            "schwor-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "schlägerei-noun",
      "lemma": "Schlägerei",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9884,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "драка"
        ],
        "en": [
          "fight; brawl"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "14076507",
          "text": "Im Haus gab es eine Schlägerei.",
          "translation": "В доме произошла драка.",
          "source": "Tatoeba #14076507 @mhr / #14076441 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14076507",
          "cefr_level": "A1",
          "word_slugs": [
            "schlägerei-noun"
          ]
        },
        {
          "id": "14076508",
          "text": "Im Haus hat es eine Schlägerei gegeben.",
          "translation": "В доме произошла драка.",
          "source": "Tatoeba #14076508 @mhr / #14076441 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14076508",
          "cefr_level": "A1",
          "word_slugs": [
            "schlägerei-noun"
          ]
        },
        {
          "id": "7058312",
          "text": "Tom hat bei der Schlägerei ein Paar Zähne eingebüßt.",
          "translation": "Том лишился пары зубов в драке.",
          "source": "Tatoeba #7058312 @quicksanddiver / #12143797 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7058312",
          "cefr_level": "A1",
          "word_slugs": [
            "schlägerei-noun"
          ]
        },
        {
          "id": "13927768",
          "text": "Infolge der Schlägerei wurde die Videokamera des Operators zerstört.",
          "translation": "В результате потасовки оператору разбили видеокамеру.",
          "source": "Tatoeba #13927768 @IAlexI / #4445442 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13927768",
          "cefr_level": "A1",
          "word_slugs": [
            "schlägerei-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Schlägerei",
        "nominative_pl": ""
      }
