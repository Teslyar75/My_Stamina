      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6065,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of spüren:",
          "third-person singular present",
          "inflection of spüren:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12478738",
          "text": "Er spürt nichts.",
          "translation": "Он ничего не чувствует.",
          "source": "Tatoeba #12478738 @Waldelfe / #12478689 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12478738",
          "cefr_level": "A1",
          "word_slugs": [
            "spürt-verb"
          ]
        },
        {
          "id": "3924198",
          "text": "Spürt ihr nichts?",
          "translation": "Вы ничего не чувствуете?",
          "source": "Tatoeba #3924198 @Tamy / #5217819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3924198",
          "cefr_level": "A1",
          "word_slugs": [
            "spürt-verb"
          ]
        },
        {
          "id": "4085809",
          "text": "Spürt ihr den Unterschied?",
          "translation": "Вы чувствуете разницу?",
          "source": "Tatoeba #4085809 @Pfirsichbaeumchen / #4089323 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4085809",
          "cefr_level": "A1",
          "word_slugs": [
            "spürt-verb"
          ]
        },
        {
          "id": "7525501",
          "text": "Tom spürt, dass irgendetwas mit ihm nicht stimmt. Er wird immer vergesslicher.",
          "translation": "Том чувствует, что что-то с ним не так. Он стал всё забывать.",
          "source": "Tatoeba #7525501 @Pfirsichbaeumchen / #5443757 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7525501",
          "cefr_level": "A1",
          "word_slugs": [
            "spürt-verb"
          ]
        }
      ],
