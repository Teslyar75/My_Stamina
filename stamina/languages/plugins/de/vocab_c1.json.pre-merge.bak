    {
      "slug": "region-noun",
      "lemma": "Region",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7480,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "регион"
        ],
        "en": [
          "region"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "9305311",
          "text": "Diese Region ist reich an Kupfer.",
          "translation": "Этот регион богат медью.",
          "source": "Tatoeba #9305311 @felix63 / #10137555 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9305311",
          "cefr_level": "A1",
          "word_slugs": [
            "region-noun"
          ]
        },
        {
          "id": "4918309",
          "text": "Das Klima dieser Region ist gemäßigt.",
          "translation": "Климат в этом регионе умеренный.",
          "source": "Tatoeba #4918309 @al_ex_an_der / #8442043 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4918309",
          "cefr_level": "A1",
          "word_slugs": [
            "region-noun"
          ]
        },
        {
          "id": "6112085",
          "text": "Ich wuchs in einer gebirgigen Region auf.",
          "translation": "Я вырос в горной области.",
          "source": "Tatoeba #6112085 @Esperantostern / #11896086 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6112085",
          "cefr_level": "A1",
          "word_slugs": [
            "region-noun"
          ]
        },
        {
          "id": "5920460",
          "text": "Die Mancha ist eine Region im Zentrum Spaniens.",
          "translation": "Ла-Манча — область в центре Испании.",
          "source": "Tatoeba #5920460 @brauchinet / #13623262 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5920460",
          "cefr_level": "A1",
          "word_slugs": [
            "region-noun"
          ]
        },
        {
          "id": "3482508",
          "text": "Wie schätzen Sie die Situation in der Region ein?",
          "translation": "Как Вы оцениваете ситуацию в регионе?",
          "source": "Tatoeba #3482508 @al_ex_an_der / #3482474 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3482508",
          "cefr_level": "A1",
          "word_slugs": [
            "region-noun"
          ]
        }
      ],
      "tags": [
