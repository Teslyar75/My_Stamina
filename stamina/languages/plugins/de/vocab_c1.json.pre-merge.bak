      },
      "gender": null,
      "examples": [
        {
          "id": "13722411",
          "text": "Wenn du willst, dass man dich versteht, drück dich klarer aus!",
          "translation": "Если хочешь, чтобы тебя поняли, выражайся яснее.",
          "source": "Tatoeba #13722411 @mhr / #13722405 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13722411",
          "cefr_level": "A1",
          "word_slugs": [
