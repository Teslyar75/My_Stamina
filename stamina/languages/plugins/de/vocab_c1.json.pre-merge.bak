    {
      "slug": "zeichnung-noun",
      "lemma": "Zeichnung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8857,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "рисунок"
        ],
        "en": [
          "drawing",
          "subscription"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "9936351",
          "text": "Das ist Toms Zeichnung.",
          "translation": "Это рисунок Тома.",
          "source": "Tatoeba #9936351 @GaryGaryGary / #7244211 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936351",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnung-noun"
          ]
        },
        {
          "id": "2969490",
          "text": "Seine Zeichnung gefällt mir.",
          "translation": "Его рисунок мне нравится.",
          "source": "Tatoeba #2969490 @kroko / #2969507 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2969490",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnung-noun"
          ]
        },
        {
          "id": "9936353",
          "text": "Gefällt dir diese Zeichnung?",
          "translation": "Тебе нравится этот рисунок?",
          "source": "Tatoeba #9936353 @GaryGaryGary / #1681746 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936353",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnung-noun"
          ]
        },
        {
          "id": "9936355",
          "text": "Schau dir diese Zeichnung an.",
          "translation": "Посмотри на этот рисунок.",
          "source": "Tatoeba #9936355 @GaryGaryGary / #2868765 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9936355",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnung-noun"
          ]
        },
        {
          "id": "1194371",
          "text": "Die Zeichnung ist voller Harmonie und Anmut.",
          "translation": "Рисунок полон гармонии и благодати.",
          "source": "Tatoeba #1194371 @Esperantostern / #1574652 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1194371",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
