      "gender": null,
      "examples": [
        {
          "id": "788369",
          "text": "Sofort nach dem Läuten kam der Lehrer in die Klasse.",
          "translation": "Сразу после звонка в класс вошёл учитель.",
          "source": "Tatoeba #788369 @Manfredo / #12086922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/788369",
          "cefr_level": "A1",
          "word_slugs": [
            "läuten-noun"
          ]
        },
        {
          "id": "797711",
          "text": "Läuten Sie, wenn Sie mich brauchen.",
          "translation": "Позвоните, когда я вам понадоблюсь.",
          "source": "Tatoeba #797711 @Hans_Adler / #6302540 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/797711",
          "cefr_level": "A1",
