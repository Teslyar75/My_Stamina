      },
      "gender": null,
      "examples": [
        {
          "id": "2632629",
          "text": "Ich kenne alle Einzelheiten.",
          "translation": "Я знаю все детали.",
          "source": "Tatoeba #2632629 @Pfirsichbaeumchen / #2632465 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2632629",
          "cefr_level": "A1",
          "word_slugs": [
            "einzelheiten-noun"
          ]
        },
        {
          "id": "12889004",
          "text": "Ich brauche mehr Einzelheiten.",
          "translation": "Мне нужно больше подробностей.",
          "source": "Tatoeba #12889004 @mhr / #12888995 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12889004",
          "cefr_level": "A1",
          "word_slugs": [
