        {
          "id": "2167523",
          "text": "Das ist eine Pflanze.",
          "translation": "Это растение.",
          "source": "Tatoeba #2167523 @al_ex_an_der / #5655182 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2167523",
          "cefr_level": "A1",
          "word_slugs": [
            "pflanze-noun"
          ]
        },
        {
          "id": "3099468",
          "text": "Die Pflanze ist blau.",
          "translation": "Растение синее.",
          "source": "Tatoeba #3099468 @Rovo / #7982274 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3099468",
          "cefr_level": "A1",
          "word_slugs": [
