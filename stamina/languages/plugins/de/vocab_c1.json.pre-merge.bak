    {
      "slug": "lache-verb",
      "lemma": "lache",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7012,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of lachen:",
          "first-person singular present",
          "inflection of lachen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12395895",
          "text": "Ich lache nie.",
          "translation": "Я никогда не смеюсь.",
          "source": "Tatoeba #12395895 @Pfirsichbaeumchen / #8917652 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12395895",
          "cefr_level": "A1",
          "word_slugs": [
            "lache-verb"
          ]
        },
        {
          "id": "1538464",
          "text": "Warum ich lache?",
          "translation": "Почему я смеюсь?",
          "source": "Tatoeba #1538464 @nemoli / #1730108 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1538464",
          "cefr_level": "A1",
          "word_slugs": [
            "lache-verb"
          ]
        },
        {
          "id": "1538465",
          "text": "Warum lache ich?",
          "translation": "Почему я смеюсь?",
          "source": "Tatoeba #1538465 @nemoli / #1730108 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1538465",
          "cefr_level": "A1",
          "word_slugs": [
            "lache-verb"
          ]
        },
        {
          "id": "2384061",
          "text": "Ich lache gerne.",
          "translation": "Я люблю смеяться.",
          "source": "Tatoeba #2384061 @Esperantostern / #2998559 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2384061",
          "cefr_level": "A1",
          "word_slugs": [
            "lache-verb"
          ]
        },
        {
          "id": "1661290",
          "text": "Ich lache über dich.",
          "translation": "Я над тобой смеюсь.",
          "source": "Tatoeba #1661290 @Pfirsichbaeumchen / #7285546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1661290",
          "cefr_level": "A1",
