      "gender": "n",
      "examples": [
        {
          "id": "8433187",
          "text": "Ihr sei Ehre dafür und Lob.",
          "translation": "Честь ей за это и хвала.",
          "source": "Tatoeba #8433187 @faehrmann / #8433085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8433187",
