    {
      "slug": "gegenstand-noun",
      "lemma": "Gegenstand",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8159,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "предмет"
        ],
        "en": [
          "object, item, thing, article",
          "subject, topic",
          "in the technical language of civil law statutes, either a corporeal object or a subjective right",
          "more broadly, since law of obligations lacks a numerus clausus, an object of agreement, that which is the deal"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4834410",
          "text": "Wie heißt dieser Gegenstand?",
          "translation": "Как называется этот предмет?",
          "source": "Tatoeba #4834410 @LanguageBreaker / #6167174 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4834410",
          "cefr_level": "A1",
          "word_slugs": [
            "gegenstand-noun"
          ]
        },
        {
          "id": "13938053",
          "text": "Ein Buch ist ein Gegenstand.",
          "translation": "Книга — это предмет.",
          "source": "Tatoeba #13938053 @mhr / #13938032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13938053",
          "cefr_level": "A1",
          "word_slugs": [
            "gegenstand-noun"
          ]
        },
        {
          "id": "767255",
          "text": "Wofür wird dieser Gegenstand benutzt?",
          "translation": "Для чего используется этот предмет?",
          "source": "Tatoeba #767255 @al_ex_an_der / #1585992 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/767255",
          "cefr_level": "A1",
          "word_slugs": [
            "gegenstand-noun"
          ]
        },
        {
          "id": "2434682",
          "text": "Könnt ihr den Gegenstand beschreiben?",
          "translation": "Вы можете описать этот предмет?",
          "source": "Tatoeba #2434682 @Tamy / #12530131 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2434682",
          "cefr_level": "A1",
          "word_slugs": [
            "gegenstand-noun"
          ]
        },
        {
          "id": "12531981",
          "text": "Kannst du den Gegenstand beschreiben?",
          "translation": "Ты можешь описать предмет?",
          "source": "Tatoeba #12531981 @mhr / #12530132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12531981",
          "cefr_level": "A1",
          "word_slugs": [
            "gegenstand-noun"
          ]
        }
      ],
