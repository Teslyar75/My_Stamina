    {
      "slug": "anrief-verb",
      "lemma": "anrief",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8522,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular dependent preterite of anrufen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14031836",
          "text": "Er schlief noch, als ich anrief.",
          "translation": "Когда я позвонил, он ещё спал.",
          "source": "Tatoeba #14031836 @mhr / #13971821 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14031836",
          "cefr_level": "A1",
          "word_slugs": [
            "anrief-verb"
          ]
        },
        {
          "id": "11665828",
          "text": "Er war nicht zu Hause, als ich anrief.",
          "translation": "Его не было дома, когда я позвонил.",
          "source": "Tatoeba #11665828 @Pfirsichbaeumchen / #11665631 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11665828",
          "cefr_level": "A1",
          "word_slugs": [
            "anrief-verb"
          ]
        },
        {
          "id": "11665824",
          "text": "Er war nicht zu Hause, als ich ihn anrief.",
          "translation": "Его не было дома, когда я ему звонил.",
          "source": "Tatoeba #11665824 @Pfirsichbaeumchen / #11665633 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11665824",
          "cefr_level": "A1",
          "word_slugs": [
            "anrief-verb"
          ]
        },
        {
          "id": "13650670",
          "text": "Ich arbeitete gerade in der Garage, als er anrief.",
          "translation": "Когда он позвонил, я работал в гараже.",
          "source": "Tatoeba #13650670 @mhr / #13651084 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13650670",
          "cefr_level": "A1",
          "word_slugs": [
            "anrief-verb"
          ]
        },
        {
          "id": "927852",
          "text": "Ich wollte gerade außer Haus gehen, als Tom anrief.",
          "translation": "Я выходил из дома, когда Том мне позвонил.",
          "source": "Tatoeba #927852 @Sudajaengi / #1121443 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/927852",
          "cefr_level": "A1",
          "word_slugs": [
            "anrief-verb"
          ]
        }
      ],
