    {
      "slug": "piraten-noun",
      "lemma": "Piraten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5476,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Pirat",
          "plural of Pirat"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12581478",
          "text": "Meine Vorfahren waren Piraten.",
          "translation": "Мои предки были пиратами.",
          "source": "Tatoeba #12581478 @mhr / #12581467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12581478",
          "cefr_level": "A1",
          "word_slugs": [
            "piraten-noun"
          ]
        },
        {
          "id": "1823150",
          "text": "Wir wurden von Piraten angegriffen!",
          "translation": "На нас напали пираты!",
          "source": "Tatoeba #1823150 @Pfirsichbaeumchen / #2300479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1823150",
          "cefr_level": "A1",
          "word_slugs": [
            "piraten-noun"
          ]
        },
        {
          "id": "2634369",
          "text": "Den Piraten blieb nichts anderes übrig, als sich zu ergeben.",
          "translation": "Пиратам ничего не оставалось, кроме как сдаться.",
          "source": "Tatoeba #2634369 @Pfirsichbaeumchen / #12222450 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2634369",
          "cefr_level": "A1",
          "word_slugs": [
            "piraten-noun"
          ]
        },
        {
          "id": "787702",
          "text": "Piraten, Seeräuber und Freibeuter sind keine Synonyme.",
          "translation": "Пираты, морские разбойники и флибустьеры - это не синонимы.",
          "source": "Tatoeba #787702 @BraveSentry / #2873991 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/787702",
          "cefr_level": "A1",
          "word_slugs": [
            "piraten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
