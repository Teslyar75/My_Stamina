    {
      "slug": "ausgedacht-verb",
      "lemma": "ausgedacht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5060,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of ausdenken"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11510653",
          "text": "Das hast Du dir ausgedacht.",
          "translation": "Ты всё выдумываешь.",
          "source": "Tatoeba #11510653 @Bernie75 / #2730263 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11510653",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgedacht-verb"
          ]
        },
        {
          "id": "8332784",
          "text": "Wer hat sich das ausgedacht?",
          "translation": "Кто это выдумал?",
          "source": "Tatoeba #8332784 @Luiaard / #2498002 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8332784",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgedacht-verb"
          ]
        },
        {
          "id": "6634595",
          "text": "Das hast du dir gut ausgedacht.",
          "translation": "Это ты хорошо придумал.",
          "source": "Tatoeba #6634595 @eric2 / #6450501 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6634595",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgedacht-verb"
          ]
        },
        {
          "id": "12817239",
          "text": "Wer hat sich diese Regeln ausgedacht?",
          "translation": "Кто придумал эти правила?",
          "source": "Tatoeba #12817239 @mhr / #5568357 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12817239",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgedacht-verb"
          ]
        },
        {
          "id": "13523293",
          "text": "Sieh mal, was ich mir ausgedacht habe!",
          "translation": "Смотри, что я придумал!",
          "source": "Tatoeba #13523293 @mhr / #13523198 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13523293",
          "cefr_level": "A1",
          "word_slugs": [
            "ausgedacht-verb"
          ]
        }
      ],
      "tags": [
