    {
      "slug": "kasse-noun",
      "lemma": "Kasse",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5006,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "касса"
        ],
        "en": [
          "cash register, cash box",
          "cash desk, (supermarket) checkout, (film etc.) box office",
          "ellipsis of Krankenkasse; health insurance institution"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "983676",
          "text": "Die Kasse stimmt heute nicht.",
          "translation": "Касса не сходится сегодня.",
          "source": "Tatoeba #983676 @Esperantostern / #4932194 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/983676",
          "cefr_level": "A1",
          "word_slugs": [
            "kasse-noun"
          ]
        },
        {
          "id": "1048497",
          "text": "Er ist ständig knapp bei Kasse.",
          "translation": "Ему постоянно не хватает денег.",
          "source": "Tatoeba #1048497 @Sudajaengi / #2380639 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1048497",
          "cefr_level": "A1",
          "word_slugs": [
            "kasse-noun"
          ]
        },
        {
          "id": "3467087",
          "text": "Zahlen Sie bitte an der Kasse im Erdgeschoss.",
          "translation": "Оплатите, пожалуйста, в кассе на первом этаже.",
          "source": "Tatoeba #3467087 @Trinkschokolade / #5420418 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3467087",
          "cefr_level": "A1",
          "word_slugs": [
            "kasse-noun"
          ]
        },
        {
          "id": "346960",
          "text": "Das Problem ist, dass wir knapp bei Kasse sind.",
          "translation": "Проблема в том, что у нас не хватает денег.",
          "source": "Tatoeba #346960 @lilygilder / #524454 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/346960",
          "cefr_level": "A1",
          "word_slugs": [
            "kasse-noun"
          ]
        },
        {
          "id": "558645",
          "text": "Im Moment bin ich ein bisschen knapp bei Kasse.",
          "translation": "У меня сейчас туговато с деньгами.",
          "source": "Tatoeba #558645 @cost / #12671361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/558645",
          "cefr_level": "A1",
          "word_slugs": [
            "kasse-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
