      "lemma": "Teich",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9064,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "pond (natural or man-made)",
          "ellipsis of großer Teich (“Atlantic Ocean”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1486055",
          "text": "Der Teich fror zu.",
          "translation": "Пруд замёрз.",
          "source": "Tatoeba #1486055 @Zaghawa / #1271288 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1486055",
          "cefr_level": "A1",
          "word_slugs": [
            "teich-noun"
          ]
        },
        {
          "id": "11572483",
          "text": "Im Teich sind Karpfen.",
          "translation": "В пруду водятся карпы.",
          "source": "Tatoeba #11572483 @Pfirsichbaeumchen / #11572534 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11572483",
          "cefr_level": "A1",
          "word_slugs": [
            "teich-noun"
          ]
        },
        {
          "id": "12379167",
          "text": "Im Teich baden Kinder.",
          "translation": "В пруду купаются дети.",
          "source": "Tatoeba #12379167 @mhr / #11608404 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12379167",
          "cefr_level": "A1",
          "word_slugs": [
            "teich-noun"
          ]
        },
        {
          "id": "568986",
          "text": "Der Teich ist zugefroren.",
          "translation": "Пруд замёрз.",
          "source": "Tatoeba #568986 @Pfirsichbaeumchen / #1271288 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/568986",
          "cefr_level": "A1",
          "word_slugs": [
            "teich-noun"
          ]
        },
        {
          "id": "13600804",
          "text": "Im Teich schwimmen Enten.",
          "translation": "В пруду плавают утки.",
          "source": "Tatoeba #13600804 @mhr / #13600966 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13600804",
          "cefr_level": "A1",
          "word_slugs": [
            "teich-noun"
          ]
        }
