    {
      "slug": "struktur-noun",
      "lemma": "Struktur",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8746,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "структура"
        ],
        "en": [
          "structure"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13053756",
          "text": "Tom studiert die Struktur des Gehirns.",
          "translation": "Том изучает структуру мозга.",
          "source": "Tatoeba #13053756 @mhr / #13053762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13053756",
          "cefr_level": "A1",
          "word_slugs": [
            "struktur-noun"
          ]
        },
        {
          "id": "10041118",
          "text": "Die Struktur der Wirtschaft hat sich verändert.",
          "translation": "Изменилась структура экономики.",
          "source": "Tatoeba #10041118 @sakslane / #10039614 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10041118",
          "cefr_level": "A1",
          "word_slugs": [
            "struktur-noun"
          ]
        },
        {
          "id": "9990998",
          "text": "Der Hauptvorteil dieses Buches ist seine praktische Struktur.",
          "translation": "Главным достоинством этой книги является её удобная структура.",
          "source": "Tatoeba #9990998 @carlosalberto / #9989521 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9990998",
          "cefr_level": "A1",
          "word_slugs": [
            "struktur-noun"
          ]
        },
        {
          "id": "2601023",
          "text": "Ich habe gründlich darüber nachgedacht, wie die Struktur der Website aussehen soll.",
          "translation": "Я детально продумал, как должна выглядеть структура этого сайта.",
          "source": "Tatoeba #2601023 @al_ex_an_der / #2593830 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2601023",
          "cefr_level": "A1",
          "word_slugs": [
            "struktur-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
