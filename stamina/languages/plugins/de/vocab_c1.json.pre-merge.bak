    {
      "slug": "zeichnen-noun",
      "lemma": "Zeichnen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6930,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "рисование",
          "обучение рисованию"
        ],
        "en": [
          "gerund of zeichnen"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "10072842",
          "text": "Ich liebe das Zeichnen über alles.",
          "translation": "Больше всего на свете я люблю рисовать.",
          "source": "Tatoeba #10072842 @sakslane / #10072579 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10072842",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnen-noun"
          ]
        },
        {
          "id": "6594739",
          "text": "Meine größte Leidenschaft ist das Zeichnen.",
          "translation": "Моё самое главное увлечение — рисование.",
          "source": "Tatoeba #6594739 @Pfirsichbaeumchen / #5584638 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6594739",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnen-noun"
          ]
        },
        {
          "id": "6321634",
          "text": "Maria bringt ihren Kindern das Zeichnen bei.",
          "translation": "Мэри учит своих детей рисовать.",
          "source": "Tatoeba #6321634 @Pfirsichbaeumchen / #5482296 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6321634",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnen-noun"
          ]
        },
        {
          "id": "14069043",
          "text": "Kann man das Zeichnen jedem beliebigen Menschen beibringen?",
          "translation": "Можно ли научить рисовать любого человека?",
          "source": "Tatoeba #14069043 @mhr / #14069030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14069043",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnen-noun"
          ]
        },
        {
          "id": "10072765",
          "text": "Mehr als alles in der Welt liebe ich das Zeichnen.",
          "translation": "Больше всего на свете я люблю рисовать.",
          "source": "Tatoeba #10072765 @sakslane / #10072579 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10072765",
          "cefr_level": "A1",
          "word_slugs": [
            "zeichnen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Zeichnen",
        "nominative_pl": ""
      }
