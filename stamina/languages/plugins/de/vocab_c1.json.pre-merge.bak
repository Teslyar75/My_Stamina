    {
      "slug": "afghanistan-name",
      "lemma": "Afghanistan",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6549,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Afghanistan (a landlocked country between Central Asia and South Asia)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5517153",
          "text": "Afghanistan ist ein Binnenland.",
          "translation": "Афганистан - страна, не имеющая выхода к морю.",
          "source": "Tatoeba #5517153 @Pfirsichbaeumchen / #5517028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5517153",
          "cefr_level": "A1",
          "word_slugs": [
            "afghanistan-name"
          ]
        },
        {
          "id": "1805789",
          "text": "Kabul ist die Hauptstadt von Afghanistan.",
          "translation": "Кабул - столица Афганистана.",
          "source": "Tatoeba #1805789 @xtofu80 / #12834223 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1805789",
          "cefr_level": "A1",
          "word_slugs": [
            "afghanistan-name"
          ]
        },
        {
          "id": "12430341",
          "text": "Welche Sprache spricht man in Afghanistan?",
          "translation": "На каком языке говорят в Афганистане?",
          "source": "Tatoeba #12430341 @Waldelfe / #10178805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12430341",
          "cefr_level": "A1",
          "word_slugs": [
            "afghanistan-name"
          ]
        },
        {
          "id": "12430339",
          "text": "Welche Sprache wird in Afghanistan gesprochen?",
          "translation": "На каком языке говорят в Афганистане?",
          "source": "Tatoeba #12430339 @Waldelfe / #10178805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12430339",
          "cefr_level": "A1",
          "word_slugs": [
            "afghanistan-name"
          ]
        },
        {
          "id": "5517163",
          "text": "Afghanistan ist ein Land ohne Zugang zum Meer.",
          "translation": "Афганистан - страна, не имеющая выхода к морю.",
          "source": "Tatoeba #5517163 @Pfirsichbaeumchen / #5517028 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5517163",
          "cefr_level": "A1",
          "word_slugs": [
            "afghanistan-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
