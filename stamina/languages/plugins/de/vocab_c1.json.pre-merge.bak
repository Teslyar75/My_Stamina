      },
      "gender": null,
      "examples": [
        {
          "id": "361416",
          "text": "Meine Lippen sind versiegelt.",
          "translation": "Мой рот на замке.",
          "source": "Tatoeba #361416 @Wolf / #3694279 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/361416",
          "cefr_level": "A1",
