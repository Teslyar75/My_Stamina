          ]
        },
        {
          "id": "2527116",
          "text": "Sind die Läden samstags geöffnet?",
          "translation": "Магазины по субботам работают?",
          "source": "Tatoeba #2527116 @raggione / #5026030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2527116",
          "cefr_level": "A1",
          "word_slugs": [
            "läden-noun"
          ]
        },
        {
          "id": "13470738",
          "text": "Alle Läden haben jetzt geschlossen.",
