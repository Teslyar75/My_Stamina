    {
      "slug": "potter-noun",
      "lemma": "potter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8337,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "2916440",
          "text": "Mir gefallen die Harry-Potter-Bücher.",
          "translation": "Мне нравятся книги о Гарри Поттере.",
          "source": "Tatoeba #2916440 @Pfirsichbaeumchen / #2915250 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2916440",
          "cefr_level": "A1",
          "word_slugs": [
            "potter-noun"
          ]
        },
        {
          "id": "5561477",
          "text": "Welches Harry-Potter-Buch findest du am besten?",
          "translation": "Какую книгу о Гарри Поттере ты считаешь самой лучшей?",
          "source": "Tatoeba #5561477 @Pfirsichbaeumchen / #5661000 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5561477",
          "cefr_level": "A1",
          "word_slugs": [
            "potter-noun"
          ]
        },
        {
          "id": "2430285",
          "text": "Ich habe schon alle Harry-Potter-Bücher gelesen.",
          "translation": "Я уже прочитал все книги о Гарри Поттере.",
          "source": "Tatoeba #2430285 @Odelaine / #6023141 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430285",
          "cefr_level": "A1",
          "word_slugs": [
            "potter-noun"
          ]
        },
        {
          "id": "2916446",
          "text": "Ich glaube, dass die Harry-Potter-Reihe länger ist als die Bibel.",
          "translation": "Я думаю, что сериал про Гарри Поттера длиннее Библии.",
          "source": "Tatoeba #2916446 @Pfirsichbaeumchen / #2915386 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2916446",
          "cefr_level": "A1",
          "word_slugs": [
            "potter-noun"
          ]
        }
      ],
