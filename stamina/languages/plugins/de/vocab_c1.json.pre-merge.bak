    {
      "slug": "klagen-verb",
      "lemma": "klagen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6054,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "оплакивать"
        ],
        "en": [
          "to complain (to express feelings of pain, dissatisfaction, or resentment)",
          "to wail, lament",
          "to sue",
          "to sue someone"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5224075",
          "text": "Hör auf, über das Wetter zu klagen!",
          "translation": "Перестань жаловаться на погоду.",
          "source": "Tatoeba #5224075 @Pfirsichbaeumchen / #4581137 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5224075",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-verb"
          ]
        },
        {
          "id": "2527703",
          "text": "Die Leute klagen oft über das Wetter.",
          "translation": "Люди часто жалуются на погоду.",
          "source": "Tatoeba #2527703 @Pfirsichbaeumchen / #2527095 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2527703",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-verb"
          ]
        },
        {
          "id": "6742199",
          "text": "Maria fing an, zu jammern und zu klagen.",
          "translation": "Мэри принялась охать и причитать.",
          "source": "Tatoeba #6742199 @Pfirsichbaeumchen / #5871463 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6742199",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-verb"
          ]
        },
        {
          "id": "3507093",
          "text": "Er tut den ganzen Tag nichts anderes, als zu klagen.",
          "translation": "С утра до вечера он не делает ничего, кроме как жалуется.",
          "source": "Tatoeba #3507093 @al_ex_an_der / #445538 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3507093",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "klagen-noun",
      "lemma": "Klagen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6054,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of klagen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8135598",
          "text": "Tom hat keine Klagen.",
          "translation": "У Тома нет жалоб.",
          "source": "Tatoeba #8135598 @Pfirsichbaeumchen / #5518669 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8135598",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-noun"
          ]
        },
        {
          "id": "6290916",
          "text": "Ich habe eure Klagen satt.",
          "translation": "Я сыт по горло вашими жалобами.",
          "source": "Tatoeba #6290916 @Zaghawa / #3624484 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6290916",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-noun"
          ]
        },
        {
          "id": "6290917",
          "text": "Ich bin Ihrer Klagen müde.",
          "translation": "Я устал от Ваших жалоб.",
          "source": "Tatoeba #6290917 @Zaghawa / #6328718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6290917",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-noun"
          ]
        },
        {
          "id": "6713531",
          "text": "Ich habe keine Klagen von Tom gehört.",
          "translation": "Я не слышал от Тома жалоб.",
          "source": "Tatoeba #6713531 @Pfirsichbaeumchen / #5153747 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6713531",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-noun"
          ]
        },
        {
          "id": "3507090",
          "text": "Er ist von früh bis abends in einem fort am Klagen.",
          "translation": "С утра до вечера он не делает ничего, кроме как жалуется.",
          "source": "Tatoeba #3507090 @al_ex_an_der / #445538 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3507090",
          "cefr_level": "A1",
          "word_slugs": [
            "klagen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
