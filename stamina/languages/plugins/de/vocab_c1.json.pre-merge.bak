    {
      "slug": "beleidigen-verb",
      "lemma": "beleidigen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5505,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to offend, to insult, to annoy"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3293915",
          "text": "Beleidigen Sie mich nicht!",
          "translation": "Не оскорбляйте меня.",
          "source": "Tatoeba #3293915 @Manfredo / #2607083 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3293915",
          "cefr_level": "A1",
          "word_slugs": [
            "beleidigen-verb"
          ]
        },
        {
          "id": "7089645",
          "text": "Warum beleidigen Sie mich?",
          "translation": "Почему Вы меня оскорбляете?",
          "source": "Tatoeba #7089645 @EzRhil / #12503250 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7089645",
          "cefr_level": "A1",
          "word_slugs": [
            "beleidigen-verb"
          ]
        },
        {
          "id": "3064243",
          "text": "Tom wollte niemanden beleidigen.",
          "translation": "Том никого не хотел обидеть.",
          "source": "Tatoeba #3064243 @Pfirsichbaeumchen / #2784487 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3064243",
          "cefr_level": "A1",
          "word_slugs": [
            "beleidigen-verb"
          ]
        },
        {
          "id": "2441366",
          "text": "Ich wollte dich nicht beleidigen.",
          "translation": "Я не хотел тебя обидеть.",
          "source": "Tatoeba #2441366 @Pfirsichbaeumchen / #3075308 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2441366",
          "cefr_level": "A1",
          "word_slugs": [
            "beleidigen-verb"
          ]
        },
        {
          "id": "12478734",
          "text": "Beleidigen Sie nicht meinen Sohn!",
          "translation": "Не оскорбляйте моего сына.",
          "source": "Tatoeba #12478734 @Waldelfe / #12478731 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12478734",
          "cefr_level": "A1",
          "word_slugs": [
            "beleidigen-verb"
          ]
        }
      ],
      "tags": [
