    {
      "slug": "blutet-verb",
      "lemma": "blutet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6000,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bluten:",
          "third-person singular present",
          "inflection of bluten:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1081446",
          "text": "Der Hund blutet.",
          "translation": "У собаки течёт кровь.",
          "source": "Tatoeba #1081446 @al_ex_an_der / #4758731 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1081446",
          "cefr_level": "A1",
          "word_slugs": [
            "blutet-verb"
          ]
        },
        {
          "id": "481832",
          "text": "Mein Knie blutet.",
          "translation": "Моё колено кровоточит.",
          "source": "Tatoeba #481832 @Espi / #1489755 @heccele (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/481832",
          "cefr_level": "A1",
          "word_slugs": [
            "blutet-verb"
          ]
        },
        {
          "id": "664890",
          "text": "Ihre Nase blutet.",
          "translation": "У неё идёт кровь из носа.",
          "source": "Tatoeba #664890 @Zaghawa / #5480728 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/664890",
          "cefr_level": "A1",
          "word_slugs": [
            "blutet-verb"
          ]
        },
        {
          "id": "664893",
          "text": "Deine Nase blutet.",
          "translation": "У тебя кровь из носа идёт.",
          "source": "Tatoeba #664893 @Zaghawa / #2761431 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/664893",
          "cefr_level": "A1",
          "word_slugs": [
            "blutet-verb"
          ]
        },
        {
          "id": "950371",
          "text": "Seine Nase blutet.",
          "translation": "У него идет кровь из носа.",
          "source": "Tatoeba #950371 @Espi / #1039664 @Vixen96 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/950371",
