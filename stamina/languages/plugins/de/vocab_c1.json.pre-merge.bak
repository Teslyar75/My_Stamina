      },
      "gender": null,
      "examples": [
        {
          "id": "370458",
          "text": "Das Schiff sinkt.",
          "translation": "Корабль тонет.",
          "source": "Tatoeba #370458 @Wolf / #1371487 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/370458",
          "cefr_level": "A1",
