        {
          "id": "362305",
          "text": "Wir bieten billige, vorgefertigte Häuser.",
          "translation": "Мы предлагаем недорогие сборные дома.",
          "source": "Tatoeba #362305 @Wolf / #6876210 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/362305",
          "cefr_level": "A1",
          "word_slugs": [
            "billige-verb"
          ]
        },
        {
          "id": "9435363",
          "text": "Dieser billige Wein ist überraschend süffig.",
          "translation": "Это дешёвое вино на удивление неплохое.",
          "source": "Tatoeba #9435363 @Pfirsichbaeumchen / #13742987 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9435363",
          "cefr_level": "A1",
          "word_slugs": [
            "billige-verb"
          ]
        },
        {
          "id": "12313754",
          "text": "Tom kauft immer billige Lebensmittel, um Geld zu sparen.",
          "translation": "Том всегда покупает дешёвые продукты, чтобы сэкономить деньги.",
          "source": "Tatoeba #12313754 @mhr / #12416200 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12313754",
          "cefr_level": "A1",
          "word_slugs": [
            "billige-verb"
          ]
        },
        {
          "id": "12101531",
          "text": "Ich habe billige Buntstifte gefunden und meinem Sohn welche gekauft.",
          "translation": "Я нашёл недорогие цветные карандаши и купил своему сыну.",
          "source": "Tatoeba #12101531 @Pfirsichbaeumchen / #7896808 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12101531",
          "cefr_level": "A1",
          "word_slugs": [
            "billige-verb"
          ]
        }
      ],
