          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6596337",
          "text": "Tom weigert sich zu essen.",
          "translation": "Том отказывается от еды.",
          "source": "Tatoeba #6596337 @felix63 / #6761017 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6596337",
          "cefr_level": "A1",
          "word_slugs": [
            "weigert-verb"
          ]
        },
        {
          "id": "8098143",
          "text": "Tom weigert sich zu reden.",
          "translation": "Том отказывается разговаривать.",
          "source": "Tatoeba #8098143 @Pfirsichbaeumchen / #5148578 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8098143",
          "cefr_level": "A1",
          "word_slugs": [
            "weigert-verb"
          ]
        },
        {
          "id": "10654104",
          "text": "Er weigert sich zu kommen.",
          "translation": "Он отказывается приезжать.",
          "source": "Tatoeba #10654104 @Pfirsichbaeumchen / #10496959 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10654104",
          "cefr_level": "A1",
          "word_slugs": [
            "weigert-verb"
          ]
        },
        {
          "id": "3866143",
          "text": "Tom weigert sich, uns zu helfen.",
          "translation": "Том отказывается нам помогать.",
          "source": "Tatoeba #3866143 @Pfirsichbaeumchen / #3866018 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3866143",
          "cefr_level": "A1",
          "word_slugs": [
            "weigert-verb"
          ]
        },
        {
          "id": "12763631",
          "text": "Sie weigert sich, ihnen zu glauben.",
          "translation": "Она отказывается им верить.",
          "source": "Tatoeba #12763631 @mhr / #12763147 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12763631",
          "cefr_level": "A1",
          "word_slugs": [
            "weigert-verb"
          ]
        }
      ],
