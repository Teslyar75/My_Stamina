    {
      "slug": "verkehrt-verb",
      "lemma": "verkehrt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6434,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of verkehren"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6645468",
          "text": "Dein Buch ist verkehrt herum.",
          "translation": "Твоя книга вверх ногами.",
          "source": "Tatoeba #6645468 @Felixjp / #5005798 @dimitris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6645468",
          "cefr_level": "A1",
          "word_slugs": [
            "verkehrt-verb"
          ]
        },
        {
          "id": "2047821",
          "text": "Der Zug verkehrt täglich außer sonntags.",
          "translation": "Поезд ходит каждый день, кроме воскресенья.",
          "source": "Tatoeba #2047821 @al_ex_an_der / #2047823 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2047821",
          "cefr_level": "A1",
          "word_slugs": [
            "verkehrt-verb"
          ]
        },
        {
          "id": "3995776",
          "text": "Du trägst deinen Pullover verkehrt herum!",
          "translation": "Ты одел свитер задом наперёд.",
          "source": "Tatoeba #3995776 @Esperantostern / #6695208 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3995776",
          "cefr_level": "A1",
          "word_slugs": [
            "verkehrt-verb"
          ]
        },
        {
          "id": "8850055",
          "text": "Tom hatte seinen Pullover verkehrt herum an.",
          "translation": "У Тома был свитер наизнанку.",
          "source": "Tatoeba #8850055 @wolfgangth / #6533616 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8850055",
          "cefr_level": "A1",
          "word_slugs": [
            "verkehrt-verb"
          ]
        },
        {
          "id": "13699432",
          "text": "Die Fähre verkehrt zwischen Dover und Calais.",
          "translation": "Паром курсирует между Дувром и Кале.",
          "source": "Tatoeba #13699432 @mhr / #13699435 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13699432",
          "cefr_level": "A1",
          "word_slugs": [
            "verkehrt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
