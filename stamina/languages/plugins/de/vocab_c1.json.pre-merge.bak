    {
      "slug": "h-noun",
      "lemma": "h",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6655,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "abbreviation of Haft",
          "abbreviation of Haftung",
          "abbreviation of Halt",
          "abbreviation of Handel"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14017302",
          "text": "Er hat H1N1.",
          "translation": "У него H1N1.",
          "source": "Tatoeba #14017302 @mhr / #14017226 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14017302",
          "cefr_level": "A1",
          "word_slugs": [
            "h-noun"
          ]
        },
        {
          "id": "2260041",
          "text": "Das chemische Symbol H steht für Wasserstoff.",
          "translation": "Химический символ H обозначает водород.",
          "source": "Tatoeba #2260041 @Zaghawa / #3467814 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2260041",
          "cefr_level": "A1",
          "word_slugs": [
            "h-noun"
          ]
        },
        {
          "id": "2692918",
          "text": "Die Strukturformel von Wasser ist H-O-H.",
          "translation": "Структурная формула воды: H-O-H.",
          "source": "Tatoeba #2692918 @Pfirsichbaeumchen / #2982027 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2692918",
          "cefr_level": "A1",
          "word_slugs": [
            "h-noun"
          ]
        },
        {
          "id": "13754534",
          "text": "„Welches Element wird mit dem Symbol H bezeichnet?“ – „Wasserstoff.“",
          "translation": "«Какой элемент обозначается символом H?» — «Водород».",
          "source": "Tatoeba #13754534 @mhr / #13754264 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13754534",
          "cefr_level": "A1",
          "word_slugs": [
            "h-noun"
          ]
        }
      ],
