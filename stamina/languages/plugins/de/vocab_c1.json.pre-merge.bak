    {
      "slug": "sammlung-noun",
      "lemma": "Sammlung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6126,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "коллекция"
        ],
        "en": [
          "collection",
          "raising",
          "gathering",
          "contemplation, concentration, composure"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2995424",
          "text": "Er ist stolz auf seine Sammlung.",
          "translation": "Он гордится своей коллекцией.",
          "source": "Tatoeba #2995424 @pne / #3875821 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2995424",
          "cefr_level": "A1",
          "word_slugs": [
            "sammlung-noun"
          ]
        },
        {
          "id": "6313806",
          "text": "Du hast eine ganz nette Sammlung.",
          "translation": "У тебя неплохая коллекция.",
          "source": "Tatoeba #6313806 @Pfirsichbaeumchen / #6166832 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6313806",
          "cefr_level": "A1",
          "word_slugs": [
            "sammlung-noun"
          ]
        },
        {
          "id": "8072646",
          "text": "Tom hat eine Sammlung seltener Münzen.",
          "translation": "У Тома есть коллекция редких монет.",
          "source": "Tatoeba #8072646 @freibiermann / #8073567 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8072646",
          "cefr_level": "A1",
          "word_slugs": [
            "sammlung-noun"
          ]
        },
        {
          "id": "13773451",
          "text": "Tatoeba ist keine Sammlung einzelner Wörter.",
          "translation": "Татоэба не собрание отдельных слов.",
          "source": "Tatoeba #13773451 @mhr / #13773160 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13773451",
          "cefr_level": "A1",
          "word_slugs": [
            "sammlung-noun"
          ]
        },
        {
          "id": "4454351",
          "text": "Ich besitze eine Sammlung von Hermelinfigürchen.",
          "translation": "У меня есть коллекция фигурок горностаев.",
          "source": "Tatoeba #4454351 @rocco_granata / #4454239 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4454351",
          "cefr_level": "A1",
          "word_slugs": [
            "sammlung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Sammlung",
        "nominative_pl": ""
      }
    },
    {
      "slug": "anruft-verb",
      "lemma": "anruft",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6127,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of anrufen:",
          "third-person singular dependent present",
          "inflection of anrufen:",
          "second-person plural dependent present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3753856",
          "text": "Sorge dafür, dass Tom mich anruft!",
          "translation": "Напомни Тому, чтобы он мне позвонил!",
          "source": "Tatoeba #3753856 @freddy1 / #6680417 @alina88 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3753856",
          "cefr_level": "A1",
          "word_slugs": [
            "anruft-verb"
          ]
        },
        {
          "id": "5995957",
          "text": "Was soll ich tun, wenn Tom anruft?",
          "translation": "Что мне делать, если Том позвонит?",
          "source": "Tatoeba #5995957 @Zaghawa / #5490098 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5995957",
          "cefr_level": "A1",
          "word_slugs": [
            "anruft-verb"
          ]
        },
        {
          "id": "12221288",
          "text": "Wenn jemand anruft, bin ich nicht da.",
          "translation": "Если кто-нибудь позвонит, меня нет.",
          "source": "Tatoeba #12221288 @mhr / #11219533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12221288",
          "cefr_level": "A1",
          "word_slugs": [
            "anruft-verb"
          ]
        },
        {
          "id": "12221289",
          "text": "Wenn jemand anruft, bin ich nicht anwesend.",
          "translation": "Если кто-нибудь позвонит, меня нет.",
          "source": "Tatoeba #12221289 @mhr / #11219533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12221289",
          "cefr_level": "A1",
          "word_slugs": [
            "anruft-verb"
          ]
        },
        {
          "id": "1547134",
          "text": "Er hat gesagt, dass er um zehn anruft.",
          "translation": "Он сказал, что позвонит в десять.",
          "source": "Tatoeba #1547134 @al_ex_an_der / #5110125 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1547134",
          "cefr_level": "A1",
          "word_slugs": [
            "anruft-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "tauchte-verb",
      "lemma": "tauchte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6128,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of tauchen:",
          "first/third-person singular preterite",
          "inflection of tauchen:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1788314",
          "text": "Ich tauchte im Fluss.",
          "translation": "Я нырял в реке.",
          "source": "Tatoeba #1788314 @Tintling / #6560948 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1788314",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchte-verb"
          ]
        },
        {
          "id": "1415681",
          "text": "Der Frosch tauchte unter.",
          "translation": "Лягушка нырнула.",
          "source": "Tatoeba #1415681 @Esperantostern / #13084336 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1415681",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchte-verb"
          ]
        },
        {
          "id": "10483451",
          "text": "Ich tauchte in den Fluss.",
          "translation": "Я нырнул в реку.",
          "source": "Tatoeba #10483451 @Pfirsichbaeumchen / #384285 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10483451",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchte-verb"
          ]
        },
        {
          "id": "14067102",
          "text": "Mayuko tauchte ins kalte Wasser ein.",
          "translation": "Маюко нырнула в холодную воду.",
          "source": "Tatoeba #14067102 @mhr / #14066925 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067102",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchte-verb"
          ]
        },
        {
          "id": "13925440",
          "text": "Der Biwa-See tauchte vor uns auf.",
          "translation": "Перед нашими глазами появилось озеро Бива.",
          "source": "Tatoeba #13925440 @IAlexI / #12433117 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13925440",
          "cefr_level": "A1",
          "word_slugs": [
            "tauchte-verb"
          ]
        }
