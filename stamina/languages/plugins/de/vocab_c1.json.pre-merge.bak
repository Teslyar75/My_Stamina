    {
      "slug": "kneipe-noun",
      "lemma": "Kneipe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7604,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "бар"
        ],
        "en": [
          "pub, bar",
          "a student’s cramped dwelling"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "7762835",
          "text": "Die Kneipe ist geöffnet.",
          "translation": "Кабак открыт.",
          "source": "Tatoeba #7762835 @felix63 / #13061576 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7762835",
          "cefr_level": "A1",
          "word_slugs": [
            "kneipe-noun"
          ]
        },
        {
          "id": "3029973",
          "text": "Diese Kneipe ist ein beliebter Studententreffpunkt.",
          "translation": "Этот бар - популярное место студенческих встреч.",
          "source": "Tatoeba #3029973 @Pfirsichbaeumchen / #2173963 @Tretiz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3029973",
          "cefr_level": "A1",
          "word_slugs": [
            "kneipe-noun"
          ]
        },
        {
          "id": "9276766",
          "text": "In dieser Kneipe sind immer viele Studenten.",
          "translation": "В этой забегаловке всегда много студентов.",
          "source": "Tatoeba #9276766 @felix63 / #9276992 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9276766",
          "cefr_level": "A1",
          "word_slugs": [
            "kneipe-noun"
          ]
        },
        {
          "id": "11071493",
          "text": "Tom wartete in der Kneipe bereits auf uns.",
          "translation": "Том уже ждал нас в баре.",
          "source": "Tatoeba #11071493 @Pfirsichbaeumchen / #11071489 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11071493",
          "cefr_level": "A1",
          "word_slugs": [
            "kneipe-noun"
          ]
        },
        {
          "id": "13839180",
          "text": "„Meine Freunde leben hier“, sagte Tom und zeigte auf die Kneipe.",
          "translation": "«Мои друзья здесь живут», – сказал Том, показав на кабак.",
          "source": "Tatoeba #13839180 @maaster / #13842328 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13839180",
          "cefr_level": "A1",
          "word_slugs": [
            "kneipe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Kneipe",
        "nominative_pl": ""
      }
    },
