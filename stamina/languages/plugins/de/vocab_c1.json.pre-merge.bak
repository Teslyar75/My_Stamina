    {
      "slug": "entsteht-verb",
      "lemma": "entsteht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7125,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of entstehen:",
          "third-person singular present",
          "inflection of entstehen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7042449",
          "text": "Wie entsteht Schnee?",
          "translation": "Как образуется снег?",
          "source": "Tatoeba #7042449 @list / #9283957 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7042449",
          "cefr_level": "A1",
          "word_slugs": [
            "entsteht-verb"
          ]
        },
        {
          "id": "13735248",
          "text": "Wenn Sie Blau und Gelb mischen, entsteht die Farbe Grün.",
          "translation": "Если смешать синий и жёлтый, получится зелёный.",
          "source": "Tatoeba #13735248 @Biderl / #13735251 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13735248",
          "cefr_level": "A1",
          "word_slugs": [
            "entsteht-verb"
          ]
        },
        {
          "id": "13862763",
          "text": "Ein Regenbogen entsteht, wenn es regnet und die Sonne scheint.",
          "translation": "Радуга бывает, если идёт дождь и светит солнце.",
          "source": "Tatoeba #13862763 @mhr / #13862749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13862763",
          "cefr_level": "A1",
          "word_slugs": [
            "entsteht-verb"
          ]
        }
