    {
      "slug": "ihretwegen-adv",
      "lemma": "ihretwegen",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7664,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "because of her, for her sake",
          "because of them, for their sake",
          "as far as she is concerned (she doesn't mind if); for all she cares",
          "as far as they are concerned (they don't mind if); for all they care"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12287790",
          "text": "Ich bin ihretwegen hier.",
          "translation": "Я здесь из-за неё.",
          "source": "Tatoeba #12287790 @Pfirsichbaeumchen / #3943894 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12287790",
          "cefr_level": "A1",
          "word_slugs": [
            "ihretwegen-adv"
          ]
        },
        {
          "id": "12858069",
          "text": "Ich bin Ihretwegen hier.",
          "translation": "Я здесь из-за Вас.",
          "source": "Tatoeba #12858069 @Waldelfe / #13280503 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12858069",
          "cefr_level": "A1",
          "word_slugs": [
            "ihretwegen-adv"
          ]
        },
        {
          "id": "12457998",
          "text": "Ich habe Ihretwegen Probleme.",
          "translation": "У меня из-за вас проблемы.",
          "source": "Tatoeba #12457998 @Waldelfe / #12457992 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12457998",
          "cefr_level": "A1",
          "word_slugs": [
            "ihretwegen-adv"
          ]
        },
        {
          "id": "12458002",
          "text": "Ihretwegen habe ich Probleme.",
          "translation": "Из-за тебя у меня проблемы.",
          "source": "Tatoeba #12458002 @Waldelfe / #7804765 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12458002",
          "cefr_level": "A1",
          "word_slugs": [
            "ihretwegen-adv"
          ]
        },
        {
          "id": "12457996",
          "text": "Ich habe Ihretwegen Unannehmlichkeiten.",
          "translation": "У меня из-за вас неприятности.",
          "source": "Tatoeba #12457996 @Waldelfe / #12457994 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12457996",
          "cefr_level": "A1",
          "word_slugs": [
            "ihretwegen-adv"
          ]
        }
      ],
