      "gender": "n",
      "examples": [
        {
          "id": "13641337",
          "text": "Tom braucht Möbel.",
          "translation": "Тому нужна мебель.",
          "source": "Tatoeba #13641337 @Waldelfe / #5562740 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13641337",
          "cefr_level": "A1",
          "word_slugs": [
            "möbel-noun"
          ]
        },
        {
          "id": "4905158",
          "text": "Sie verkaufen Möbel.",
