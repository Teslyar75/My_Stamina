    {
      "slug": "dritt-particle",
      "lemma": "dritt",
      "pos": "particle",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8302,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "only used in zu dritt."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12306727",
          "text": "Wir wohnen zu dritt in diesem Haus.",
          "translation": "Мы живём в этом доме втроём.",
          "source": "Tatoeba #12306727 @Pfirsichbaeumchen / #12306703 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12306727",
          "cefr_level": "A1",
          "word_slugs": [
            "dritt-particle"
          ]
        },
        {
          "id": "4057985",
          "text": "Wir kommen zu dritt. Zu wievielt kommt ihr?",
          "translation": "Мы придём втроём. А вас сколько будет?",
          "source": "Tatoeba #4057985 @Pfirsichbaeumchen / #4061328 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4057985",
          "cefr_level": "A1",
          "word_slugs": [
            "dritt-particle"
          ]
        },
        {
          "id": "1712824",
          "text": "Sie waren zu dritt, und alle waren bewaffnet.",
          "translation": "Их было трое, и все они были вооружены.",
          "source": "Tatoeba #1712824 @Pfirsichbaeumchen / #4490068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1712824",
          "cefr_level": "A1",
          "word_slugs": [
            "dritt-particle"
          ]
        },
        {
          "id": "1721625",
          "text": "Wir werden zu dritt sein: du, Anna und ich.",
          "translation": "Мы будем втроём: ты, Анна и я.",
          "source": "Tatoeba #1721625 @al_ex_an_der / #2727183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1721625",
          "cefr_level": "A1",
          "word_slugs": [
            "dritt-particle"
          ]
        },
        {
          "id": "10512530",
          "text": "Dieses Spiel kann man sowohl zu zweit als auch zu dritt spielen.",
          "translation": "В эту игру можно играть как вдвоём, так и втроём.",
          "source": "Tatoeba #10512530 @Pfirsichbaeumchen / #10512529 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10512530",
          "cefr_level": "A1",
          "word_slugs": [
            "dritt-particle"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
