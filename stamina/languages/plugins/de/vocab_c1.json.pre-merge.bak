    {
      "slug": "leuchten-verb",
      "lemma": "leuchten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7774,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "светиться"
        ],
        "en": [
          "to shine"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12203351",
          "text": "Warum leuchten Sterne?",
          "translation": "Почему звёзды светят?",
          "source": "Tatoeba #12203351 @mhr / #7247970 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12203351",
          "cefr_level": "A1",
          "word_slugs": [
            "leuchten-verb"
          ]
        },
        {
          "id": "12203352",
          "text": "Warum leuchten die Sterne?",
          "translation": "Почему звёзды светят?",
          "source": "Tatoeba #12203352 @mhr / #7247970 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12203352",
          "cefr_level": "A1",
          "word_slugs": [
            "leuchten-verb"
          ]
        },
        {
          "id": "12036675",
          "text": "Je dunkler der Himmel ist, desto heller leuchten die Sterne.",
          "translation": "Чем темнее небо, тем ярче звёзды.",
          "source": "Tatoeba #12036675 @Esperantostern / #12036773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12036675",
          "cefr_level": "A1",
          "word_slugs": [
            "leuchten-verb"
          ]
        }
      ],
      "tags": [
