    {
      "slug": "hahn-noun",
      "lemma": "Hahn",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6282,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "cock, rooster",
          "ellipsis of Wasserhahn (“tap, faucet”)",
          "ellipsis of Fasshahn or Zapfhahn (“spigot, stopcock”)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "1233538",
          "text": "Danach kräht kein Hahn.",
          "translation": "Никому до этого нет дела.",
          "source": "Tatoeba #1233538 @Esperantostern / #3831130 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1233538",
          "cefr_level": "A1",
          "word_slugs": [
            "hahn-noun"
          ]
        },
        {
          "id": "11867240",
          "text": "Ich habe Angst vor dem Hahn.",
          "translation": "Я боюсь петуха.",
          "source": "Tatoeba #11867240 @maaster / #11867762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11867240",
          "cefr_level": "A1",
          "word_slugs": [
            "hahn-noun"
          ]
        },
        {
          "id": "4870195",
          "text": "Repariere den Hahn in der Küche!",
          "translation": "Почини кран на кухне.",
          "source": "Tatoeba #4870195 @al_ex_an_der / #13483092 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4870195",
          "cefr_level": "A1",
          "word_slugs": [
            "hahn-noun"
          ]
        },
        {
          "id": "2042177",
          "text": "Der Hahn schrie die ganze Nacht lang.",
          "translation": "Петух кричал всю ночь напролёт.",
          "source": "Tatoeba #2042177 @al_ex_an_der / #2043670 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2042177",
          "cefr_level": "A1",
          "word_slugs": [
            "hahn-noun"
          ]
        },
        {
          "id": "13396296",
          "text": "Ich habe viele Hennen, aber keinen Hahn.",
          "translation": "У меня много кур, но нет петуха.",
          "source": "Tatoeba #13396296 @Waldelfe / #6798792 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13396296",
          "cefr_level": "A1",
          "word_slugs": [
            "hahn-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Hahn",
        "nominative_pl": ""
      }
    },
