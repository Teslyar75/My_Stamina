    {
      "slug": "ablehnen-verb",
      "lemma": "ablehnen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5609,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to decline, refuse, reject, turn down"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2062394",
          "text": "Ich konnte nicht ablehnen.",
          "translation": "Я не мог отказать.",
          "source": "Tatoeba #2062394 @Pfirsichbaeumchen / #2060696 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2062394",
          "cefr_level": "A1",
          "word_slugs": [
            "ablehnen-verb"
          ]
        },
        {
          "id": "533838",
          "text": "Ich musste sein Angebot ablehnen.",
          "translation": "Мне пришлось отклонить его предложение.",
          "source": "Tatoeba #533838 @al_ex_an_der / #8194568 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/533838",
          "cefr_level": "A1",
          "word_slugs": [
            "ablehnen-verb"
          ]
        },
        {
          "id": "12395881",
          "text": "Du hättest sofort ablehnen sollen.",
          "translation": "Тебе надо было сразу отказаться.",
          "source": "Tatoeba #12395881 @Pfirsichbaeumchen / #8192798 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12395881",
          "cefr_level": "A1",
          "word_slugs": [
            "ablehnen-verb"
          ]
        },
        {
          "id": "12395882",
          "text": "Ihr hättet sofort ablehnen sollen.",
          "translation": "Вам надо было сразу отказаться.",
          "source": "Tatoeba #12395882 @Pfirsichbaeumchen / #8192801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12395882",
          "cefr_level": "A1",
          "word_slugs": [
            "ablehnen-verb"
          ]
        },
        {
          "id": "12395883",
          "text": "Sie hätten sofort ablehnen sollen.",
          "translation": "Вам надо было сразу отказаться.",
          "source": "Tatoeba #12395883 @Pfirsichbaeumchen / #8192801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12395883",
