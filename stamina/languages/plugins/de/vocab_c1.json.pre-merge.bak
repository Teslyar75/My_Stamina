          "inflection of oberer:",
          "strong genitive masculine/neuter singular",
          "inflection of oberer:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8370335",
          "text": "Das Symbol am oberen Kartenrand bedeutet „Stückkosten“.",
          "translation": "Символ в верхней части карты обозначает стоимость юнита.",
          "source": "Tatoeba #8370335 @Inego / #8370338 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8370335",
          "cefr_level": "A1",
          "word_slugs": [
            "oberen-adj"
          ]
        },
        {
          "id": "9837000",
          "text": "Sogar die oberen Schichten der Atmosphäre sind verschmutzt.",
          "translation": "Даже верхние слои атмосферы загрязнены.",
          "source": "Tatoeba #9837000 @GaryGaryGary / #4561509 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9837000",
          "cefr_level": "A1",
          "word_slugs": [
            "oberen-adj"
          ]
        },
        {
          "id": "1669853",
          "text": "Möchten Sie im oberen oder im unteren Bett schlafen?",
          "translation": "Вы хотели бы на верхней кровати спать или на нижней?",
          "source": "Tatoeba #1669853 @al_ex_an_der / #13889732 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1669853",
          "cefr_level": "A1",
          "word_slugs": [
            "oberen-adj"
          ]
        },
        {
          "id": "1669854",
          "text": "Möchtest du im oberen oder im unteren Bett schlafen?",
          "translation": "Ты хотел бы на верхней кровати спать или на нижней?",
          "source": "Tatoeba #1669854 @al_ex_an_der / #13889731 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1669854",
          "cefr_level": "A1",
          "word_slugs": [
            "oberen-adj"
          ]
        },
        {
          "id": "7460214",
          "text": "Warum zeichnest du immer eine kleine Sonne in der rechten oberen Ecke?",
          "translation": "Почему ты всегда рисуешь маленькое солнце в правом верхнем углу?",
          "source": "Tatoeba #7460214 @Pfirsichbaeumchen / #5774930 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7460214",
          "cefr_level": "A1",
          "word_slugs": [
            "oberen-adj"
          ]
        }
      ],
