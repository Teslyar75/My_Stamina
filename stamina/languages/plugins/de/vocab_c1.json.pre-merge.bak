          "source": "Tatoeba #2172599 @al_ex_an_der / #2172598 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2172599",
          "cefr_level": "A1",
          "word_slugs": [
