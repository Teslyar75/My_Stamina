          ]
        },
        {
          "id": "12741181",
          "text": "Kontaktieren Sie ihre Verwandten!",
          "translation": "Свяжитесь с её родственниками.",
          "source": "Tatoeba #12741181 @mhr / #12740969 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12741181",
          "cefr_level": "A1",
