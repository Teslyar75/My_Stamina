    {
      "slug": "gerichtet-verb",
      "lemma": "gerichtet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5388,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of richten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13735208",
          "text": "„Was?“ – „Das war nicht an Sie gerichtet.“",
          "translation": "«Что, простите?» — «Это я не Вам».",
          "source": "Tatoeba #13735208 @mhr / #13735180 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13735208",
          "cefr_level": "A1",
          "word_slugs": [
            "gerichtet-verb"
          ]
        },
        {
          "id": "13735206",
          "text": "„Was?“ – „Das war nicht an dich gerichtet.“",
          "translation": "«Что?» — «Это я не тебе».",
          "source": "Tatoeba #13735206 @mhr / #13735181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13735206",
          "cefr_level": "A1",
          "word_slugs": [
            "gerichtet-verb"
          ]
        },
        {
          "id": "2496353",
          "text": "Ist dieser Brief an dich oder an mich gerichtet?",
          "translation": "Это письмо адресовано тебе или мне?",
          "source": "Tatoeba #2496353 @freddy1 / #2978665 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2496353",
          "cefr_level": "A1",
          "word_slugs": [
            "gerichtet-verb"
          ]
        },
        {
          "id": "13208523",
          "text": "Es ist komisch, diese Frage an mich gerichtet zu hören.",
          "translation": "Странно слышать этот вопрос, обращённый ко мне.",
          "source": "Tatoeba #13208523 @frpzzd / #13208515 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13208523",
          "cefr_level": "A1",
          "word_slugs": [
            "gerichtet-verb"
          ]
        },
        {
          "id": "2428286",
          "text": "Ihre Aufmerksamkeit ist lediglich auf die äußere Seite der Dinge gerichtet.",
          "translation": "Она обращает внимание только на внешнюю сторону вещей.",
          "source": "Tatoeba #2428286 @al_ex_an_der / #2428281 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2428286",
          "cefr_level": "A1",
          "word_slugs": [
            "gerichtet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "fordern-verb",
      "lemma": "fordern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5389,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "требовать",
          "просить"
        ],
        "en": [
          "to demand, ask",
          "to claim",
          "to require",
          "to challenge"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5685003",
          "text": "Wir fordern die Abschaffung dieses Gesetzes.",
          "translation": "Мы требуем упразднения этого закона.",
          "source": "Tatoeba #5685003 @Pfirsichbaeumchen / #4492016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5685003",
          "cefr_level": "A1",
          "word_slugs": [
            "fordern-verb"
          ]
        },
        {
          "id": "3120026",
          "text": "Die Teilnehmer der Kundgebung fordern Autonomie.",
          "translation": "Участники митинга требуют автономии.",
          "source": "Tatoeba #3120026 @al_ex_an_der / #3120024 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3120026",
          "cefr_level": "A1",
          "word_slugs": [
            "fordern-verb"
          ]
        },
        {
          "id": "13447255",
          "text": "Wir fordern alle auf, Ruhe zu bewahren.",
          "translation": "Мы призываем всех сохранять спокойствие.",
          "source": "Tatoeba #13447255 @mhr / #13447058 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13447255",
          "cefr_level": "A1",
          "word_slugs": [
            "fordern-verb"
          ]
        },
        {
          "id": "10876361",
          "text": "Ich habe mich nicht getraut, noch mehr zu fordern.",
          "translation": "Я не осмелился потребовать больше.",
          "source": "Tatoeba #10876361 @kotik / #10877178 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10876361",
          "cefr_level": "A1",
          "word_slugs": [
            "fordern-verb"
          ]
        },
        {
          "id": "1283703",
          "text": "Tom weiß nicht den Unterschied zwischen bitten und fordern.",
          "translation": "Фома не знает разницу между просьбой и требованием.",
          "source": "Tatoeba #1283703 @al_ex_an_der / #3451595 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1283703",
          "cefr_level": "A1",
          "word_slugs": [
            "fordern-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
