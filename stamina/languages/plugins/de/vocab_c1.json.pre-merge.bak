        "en": [
          "box (container made from metal or plastic, less often wood)",
          "tin, can (air-tight container for food)",
          "socket",
          "vagina, vulva"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "435725",
          "text": "Die Dose ist leer.",
          "translation": "Банка пустая.",
          "source": "Tatoeba #435725 @MUIRIEL / #5692178 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/435725",
          "cefr_level": "A1",
          "word_slugs": [
            "dose-noun"
          ]
        },
        {
          "id": "685927",
          "text": "In der Dose sind sechs Äpfel.",
          "translation": "В коробке шесть яблок.",
          "source": "Tatoeba #685927 @MUIRIEL / #1086228 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/685927",
          "cefr_level": "A1",
          "word_slugs": [
            "dose-noun"
          ]
        },
        {
          "id": "9017323",
          "text": "Ich habe eine Dose Sardinen gekauft.",
          "translation": "Я купил банку сардин.",
          "source": "Tatoeba #9017323 @brauchinet / #9038353 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9017323",
          "cefr_level": "A1",
          "word_slugs": [
            "dose-noun"
          ]
        },
        {
          "id": "455379",
          "text": "Mein Sohn hat ein Bonbon aus der Dose genommen.",
          "translation": "Мой сын взял конфету из коробки.",
          "source": "Tatoeba #455379 @MUIRIEL / #796190 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/455379",
          "cefr_level": "A1",
          "word_slugs": [
            "dose-noun"
          ]
        },
        {
          "id": "2082849",
          "text": "Tom machte sich zum Abendbrot eine Dose Ravioli warm.",
          "translation": "Том разогрел на ужин консервы с равиоли.",
          "source": "Tatoeba #2082849 @Pfirsichbaeumchen / #2242271 @KatrinI (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2082849",
          "cefr_level": "A1",
          "word_slugs": [
            "dose-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
