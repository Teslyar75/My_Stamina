          ]
        },
        {
          "id": "3944639",
          "text": "Mein Nacken schmerzt etwas.",
          "translation": "У меня шея немного болит.",
          "source": "Tatoeba #3944639 @Kuraimegami / #3944679 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3944639",
