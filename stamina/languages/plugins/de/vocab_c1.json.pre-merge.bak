          ]
        },
        {
          "id": "12193545",
          "text": "Das ist ein gutes Argument.",
          "translation": "Хороший аргумент.",
          "source": "Tatoeba #12193545 @mhr / #12415370 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12193545",
          "cefr_level": "A1",
          "word_slugs": [
            "argument-noun"
          ]
        },
        {
          "id": "2997056",
          "text": "Dieses Argument ist reine Rhetorik.",
          "translation": "Этот аргумент - чистая риторика.",
          "source": "Tatoeba #2997056 @al_ex_an_der / #2997105 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2997056",
          "cefr_level": "A1",
          "word_slugs": [
            "argument-noun"
          ]
        },
        {
          "id": "3586323",
          "text": "Dieses Argument hat mich überzeugt.",
          "translation": "Этот довод убедил меня.",
          "source": "Tatoeba #3586323 @al_ex_an_der / #3586321 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3586323",
          "cefr_level": "A1",
          "word_slugs": [
            "argument-noun"
          ]
        },
        {
          "id": "2490184",
          "text": "Das ist kein überzeugendes Argument.",
