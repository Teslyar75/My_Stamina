    {
      "slug": "dessert-noun",
      "lemma": "Dessert",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8055,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "десерт"
        ],
        "en": [
          "dessert"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "13981471",
          "text": "Ist das das Dessert?",
          "translation": "Это десерт?",
          "source": "Tatoeba #13981471 @mhr / #13981467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13981471",
          "cefr_level": "A1",
          "word_slugs": [
            "dessert-noun"
          ]
        },
        {
          "id": "13981473",
          "text": "Ist das ein Dessert?",
          "translation": "Это десерт?",
          "source": "Tatoeba #13981473 @mhr / #13981467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13981473",
          "cefr_level": "A1",
          "word_slugs": [
            "dessert-noun"
          ]
        },
        {
          "id": "4895704",
          "text": "Tiramisu ist das bekannteste italienische Dessert in der Welt.",
          "translation": "Тирамису — самый известный в мире итальянский десерт.",
          "source": "Tatoeba #4895704 @Esperantostern / #13148435 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4895704",
          "cefr_level": "A1",
          "word_slugs": [
            "dessert-noun"
          ]
        },
        {
          "id": "14064900",
          "text": "Das Essen war sehr scharf und das Dessert sehr süß.",
          "translation": "Еда была очень острой, а десерт — очень сладким.",
          "source": "Tatoeba #14064900 @carlosalberto / #14064899 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14064900",
          "cefr_level": "A1",
          "word_slugs": [
            "dessert-noun"
          ]
        },
        {
          "id": "5772544",
          "text": "Die Ehe ist ein Bankett, das mit dem Dessert beginnt.",
          "translation": "Брак — это банкет, который начинается с десерта.",
          "source": "Tatoeba #5772544 @Esperantostern / #13304062 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5772544",
          "cefr_level": "A1",
          "word_slugs": [
            "dessert-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Dessert",
        "nominative_pl": ""
      }
