    {
      "slug": "kolonie-noun",
      "lemma": "Kolonie",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9045,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "colony (settlement away from the mainland/motherland)",
          "synonym of Siedlung (“housing estate”), especially when created specifically for the workers of a mine or factory",
          "colony, (ethnic) community (group of foreigners, immigrants, or their descendants)",
          "colony (group of animals, bacteria etc.)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1587333",
          "text": "Brasilien war eine portugiesische Kolonie.",
          "translation": "Бразилия была португальской колонией.",
          "source": "Tatoeba #1587333 @Esperantostern / #3134865 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1587333",
          "cefr_level": "A1",
          "word_slugs": [
            "kolonie-noun"
          ]
        },
        {
          "id": "2878951",
          "text": "Diese Kolonie wurde im Jahre 1700 gegründet.",
          "translation": "Эта колония была основана в 1700.",
          "source": "Tatoeba #2878951 @Pfirsichbaeumchen / #1566585 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2878951",
          "cefr_level": "A1",
          "word_slugs": [
            "kolonie-noun"
          ]
        },
        {
          "id": "5608975",
          "text": "Zimbabwe war einmal eine Kolonie Britanniens.",
          "translation": "Зимбабве когда-то было колонией Британии.",
          "source": "Tatoeba #5608975 @Pfirsichbaeumchen / #5607519 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5608975",
          "cefr_level": "A1",
          "word_slugs": [
            "kolonie-noun"
          ]
        },
        {
          "id": "5770019",
          "text": "In dieser Kolonie ist er der Herr über Leben und Tod.",
          "translation": "В этой колонии он распорядитель жизни и смерти.",
          "source": "Tatoeba #5770019 @maaster / #5770663 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5770019",
          "cefr_level": "A1",
          "word_slugs": [
            "kolonie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
