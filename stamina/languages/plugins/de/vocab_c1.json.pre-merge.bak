      },
      "gender": null,
      "examples": [
        {
          "id": "699983",
          "text": "Ein gewisser Herr Braun ist am Apparat.",
          "translation": "Звонит некий г-н Браун.",
          "source": "Tatoeba #699983 @Manfredo / #4405193 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/699983",
