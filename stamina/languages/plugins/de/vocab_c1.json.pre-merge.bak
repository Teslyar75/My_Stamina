    {
      "slug": "pablo-name",
      "lemma": "Pablo",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5426,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "13369871",
          "text": "Pablo hat mit fünf lesen gelernt.",
          "translation": "Пабло научился читать в пять лет.",
          "source": "Tatoeba #13369871 @mhr / #5520845 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13369871",
          "cefr_level": "A1",
          "word_slugs": [
            "pablo-name"
          ]
        },
        {
          "id": "13668828",
          "text": "Pablo, auf Tischen sitzt man nicht!",
          "translation": "Пабло, на столах не сидят!",
          "source": "Tatoeba #13668828 @mhr / #13668801 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13668828",
          "cefr_level": "A1",
          "word_slugs": [
            "pablo-name"
          ]
        },
        {
          "id": "13369874",
          "text": "Pablo hat als Fünfjähriger lesen gelernt.",
          "translation": "Пабло научился читать в пять лет.",
          "source": "Tatoeba #13369874 @mhr / #5520845 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13369874",
          "cefr_level": "A1",
          "word_slugs": [
            "pablo-name"
          ]
        },
        {
          "id": "12171846",
          "text": "Pablo, auf dem Tisch sitzt man nicht!",
          "translation": "Пабло, на столе не сидят!",
          "source": "Tatoeba #12171846 @mhr / #12171309 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12171846",
          "cefr_level": "A1",
          "word_slugs": [
            "pablo-name"
          ]
        },
        {
          "id": "13369872",
          "text": "Pablo hat im Alter von fünf Jahren lesen gelernt.",
          "translation": "Пабло научился читать в пять лет.",
          "source": "Tatoeba #13369872 @mhr / #5520845 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13369872",
          "cefr_level": "A1",
          "word_slugs": [
            "pablo-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Pablo",
        "nominative_pl": ""
      }
