      },
      "gender": "n",
      "examples": [
        {
          "id": "2973979",
          "text": "Das ist die perfekte Welle.",
          "translation": "Это идеальная волна.",
          "source": "Tatoeba #2973979 @Hybrid / #2974095 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2973979",
          "cefr_level": "A1",
          "word_slugs": [
            "welle-noun"
          ]
        },
        {
          "id": "3657693",
          "text": "Dies löste eine Welle der Empörung aus.",
          "translation": "Это вызвало волну возмущения.",
          "source": "Tatoeba #3657693 @al_ex_an_der / #3657691 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3657693",
          "cefr_level": "A1",
          "word_slugs": [
            "welle-noun"
          ]
        },
        {
          "id": "3657694",
          "text": "Dies rief eine Welle der Empörung hervor.",
          "translation": "Это вызвало волну возмущения.",
          "source": "Tatoeba #3657694 @al_ex_an_der / #3657691 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3657694",
          "cefr_level": "A1",
          "word_slugs": [
            "welle-noun"
          ]
        },
        {
          "id": "12447907",
          "text": "Eine große Welle hat das Kanu umgeworfen.",
          "translation": "Каноэ перевернула большая волна.",
          "source": "Tatoeba #12447907 @Pfirsichbaeumchen / #12447719 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12447907",
          "cefr_level": "A1",
          "word_slugs": [
            "welle-noun"
          ]
        },
        {
          "id": "9938331",
          "text": "Eine plötzliche Welle der Übelkeit überkam ihn.",
          "translation": "Внезапная волна тошноты накатила на него.",
          "source": "Tatoeba #9938331 @GaryGaryGary / #1620927 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9938331",
          "cefr_level": "A1",
          "word_slugs": [
            "welle-noun"
          ]
        }
      ],
