          ]
        },
        {
          "id": "12450365",
          "text": "Hast du in der Schublade nachgesehen?",
          "translation": "Ты в ящике смотрел?",
          "source": "Tatoeba #12450365 @Waldelfe / #9031183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12450365",
          "cefr_level": "A1",
          "word_slugs": [
            "schublade-noun"
          ]
        },
        {
          "id": "12450366",
          "text": "Habt ihr in der Schublade nachgesehen?",
          "translation": "Вы в ящике смотрели?",
          "source": "Tatoeba #12450366 @Waldelfe / #9031184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12450366",
          "cefr_level": "A1",
