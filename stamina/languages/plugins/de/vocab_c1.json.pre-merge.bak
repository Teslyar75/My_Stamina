      "gender": null,
      "examples": [
        {
          "id": "13020490",
          "text": "Halte an der Tankstelle an!",
          "translation": "Останови на заправке.",
          "source": "Tatoeba #13020490 @mhr / #13020479 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13020490",
          "cefr_level": "A1",
          "word_slugs": [
            "tankstelle-noun"
          ]
        },
        {
          "id": "6971486",
          "text": "Tom fuhr auf die Tankstelle.",
          "translation": "Том заехал на заправку.",
          "source": "Tatoeba #6971486 @Pfirsichbaeumchen / #6969373 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6971486",
          "cefr_level": "A1",
          "word_slugs": [
            "tankstelle-noun"
          ]
        },
        {
          "id": "9344301",
          "text": "Früher war hier eine Tankstelle.",
          "translation": "Раньше здесь была заправка.",
          "source": "Tatoeba #9344301 @Pfirsichbaeumchen / #9509280 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9344301",
          "cefr_level": "A1",
          "word_slugs": [
            "tankstelle-noun"
          ]
        },
        {
          "id": "7761365",
          "text": "Wir müssen eine Tankstelle finden.",
          "translation": "Нам надо найти заправку.",
          "source": "Tatoeba #7761365 @felix63 / #12731353 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7761365",
          "cefr_level": "A1",
          "word_slugs": [
            "tankstelle-noun"
          ]
        },
        {
          "id": "5867701",
          "text": "Mein Bruder arbeitet bei einer Tankstelle.",
          "translation": "Мой брат работает на заправочной станции.",
          "source": "Tatoeba #5867701 @Pfirsichbaeumchen / #2659278 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5867701",
          "cefr_level": "A1",
          "word_slugs": [
            "tankstelle-noun"
          ]
        }
