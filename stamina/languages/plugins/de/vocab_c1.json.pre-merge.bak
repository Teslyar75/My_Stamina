      "gender": null,
      "examples": [
        {
          "id": "1533467",
          "text": "Du missbrauchst deine Autorität.",
          "translation": "Ты злоупотребляешь своей властью.",
          "source": "Tatoeba #1533467 @al_ex_an_der / #6771872 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1533467",
          "cefr_level": "A1",
          "word_slugs": [
            "autorität-noun"
          ]
        },
        {
          "id": "3015325",
          "text": "Sie genießen in Europa Autorität.",
          "translation": "Они пользуются авторитетом в Европе.",
          "source": "Tatoeba #3015325 @al_ex_an_der / #3521978 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3015325",
          "cefr_level": "A1",
          "word_slugs": [
