          "source": "Tatoeba #2830621 @raggione / #4619452 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2830621",
          "cefr_level": "A1",
          "word_slugs": [
            "perücke-noun"
          ]
        },
        {
          "id": "3263371",
          "text": "Das ist eine Perücke.",
          "translation": "Это парик.",
          "source": "Tatoeba #3263371 @al_ex_an_der / #4175756 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3263371",
          "cefr_level": "A1",
          "word_slugs": [
            "perücke-noun"
          ]
        },
        {
          "id": "3263370",
          "text": "Das ist keine Perücke!",
          "translation": "Это не парик!",
          "source": "Tatoeba #3263370 @al_ex_an_der / #9133936 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3263370",
          "cefr_level": "A1",
          "word_slugs": [
            "perücke-noun"
          ]
        }
