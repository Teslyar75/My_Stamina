    {
      "slug": "vietnam-name",
      "lemma": "Vietnam",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5195,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Vietnam (a country in Southeast Asia; official name: Sozialistische Republik Vietnam)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13775399",
          "text": "Alles ist billig in Vietnam.",
          "translation": "Во Вьетнаме всё дёшево.",
          "source": "Tatoeba #13775399 @maaster / #13777311 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13775399",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        },
        {
          "id": "13867415",
          "text": "Vietnam ist ein südostasiatisches Land.",
          "translation": "Вьетнам - страна в Юго-Восточной Азии.",
          "source": "Tatoeba #13867415 @mhr / #4279238 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13867415",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        },
        {
          "id": "2639523",
          "text": "Wie heißt die Hauptstadt von Vietnam?",
          "translation": "Как называется столица Вьетнама?",
          "source": "Tatoeba #2639523 @Olya / #2648492 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2639523",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        },
        {
          "id": "2639525",
          "text": "Die Hauptstadt von Vietnam ist Hanoi.",
          "translation": "Столица Вьетнама - Ханой.",
          "source": "Tatoeba #2639525 @Olya / #2647701 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2639525",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        },
        {
          "id": "10704930",
          "text": "Weil ich in Vietnam geboren wurde, spreche ich Vietnamesisch.",
          "translation": "Поскольку я родился во Вьетнаме, я говорю по-вьетнамски.",
          "source": "Tatoeba #10704930 @MrOhno / #11151611 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10704930",
          "cefr_level": "A1",
          "word_slugs": [
            "vietnam-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
