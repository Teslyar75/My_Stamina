    {
      "slug": "herkunft-noun",
      "lemma": "Herkunft",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6838,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "происхождение"
        ],
        "en": [
          "origin, source",
          "descent (lineage or hereditary derivation)",
          "etymology (origin of a word)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1522196",
          "text": "Sie ist von französischer Herkunft.",
          "translation": "Она француженка по происхождению.",
          "source": "Tatoeba #1522196 @Esperantostern / #441874 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1522196",
          "cefr_level": "A1",
          "word_slugs": [
            "herkunft-noun"
          ]
        },
        {
          "id": "12365501",
          "text": "Die Herkunft des Baskischen ist unbekannt.",
          "translation": "Происхождение баскского языка неизвестно.",
          "source": "Tatoeba #12365501 @mhr / #12365297 @Txoria (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12365501",
          "cefr_level": "A1",
          "word_slugs": [
            "herkunft-noun"
          ]
        },
        {
          "id": "1817049",
          "text": "Sie war britische Staatsbürgerin französischer Herkunft.",
          "translation": "Она была британской гражданкой французского происхождения.",
          "source": "Tatoeba #1817049 @Zaghawa / #13557592 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1817049",
          "cefr_level": "A1",
          "word_slugs": [
            "herkunft-noun"
          ]
        },
        {
          "id": "12365500",
          "text": "Die Herkunft der baskischen Sprache ist unbekannt.",
          "translation": "Происхождение баскского языка неизвестно.",
          "source": "Tatoeba #12365500 @mhr / #12365297 @Txoria (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12365500",
          "cefr_level": "A1",
          "word_slugs": [
            "herkunft-noun"
          ]
        },
        {
          "id": "13945192",
          "text": "In Deutschland leben viele Menschen türkischer Herkunft.",
          "translation": "В Германии живёт много выходцев из Турции.",
          "source": "Tatoeba #13945192 @mhr / #13945184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13945192",
          "cefr_level": "A1",
          "word_slugs": [
            "herkunft-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Herkunft",
        "nominative_pl": ""
      }
    },
    {
      "slug": "annahme-noun",
      "lemma": "Annahme",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6839,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "предположение"
        ],
        "en": [
          "presupposition, assumption, hypothesis",
          "acceptance, the act of accepting",
          "receipt, reception, the act of receiving",
          "the act of stopping and controlling the ball"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2488759",
          "text": "Jedwede Annahme wäre spekulativ.",
          "translation": "Любое предположение было бы умозрительным.",
          "source": "Tatoeba #2488759 @al_ex_an_der / #2488758 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2488759",
          "cefr_level": "A1",
          "word_slugs": [
            "annahme-noun"
          ]
        },
        {
          "id": "12870932",
          "text": "Das war nur eine Annahme.",
          "translation": "Это было всего лишь предположение.",
          "source": "Tatoeba #12870932 @Waldelfe / #4022620 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12870932",
          "cefr_level": "A1",
          "word_slugs": [
            "annahme-noun"
          ]
        },
        {
          "id": "450742",
          "text": "Auf jeden Fall ist deine Annahme falsch.",
          "translation": "В любом случае вы не правы в своей догадке.",
          "source": "Tatoeba #450742 @xtofu80 / #446681 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/450742",
          "cefr_level": "A1",
          "word_slugs": [
            "annahme-noun"
          ]
        },
        {
          "id": "2385158",
          "text": "Je mehr er nachdachte, desto überzeugender erschien ihm diese Annahme.",
          "translation": "Чем больше он размышлял, тем убедительнее казалось ему это предположение.",
          "source": "Tatoeba #2385158 @al_ex_an_der / #2385154 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2385158",
          "cefr_level": "A1",
          "word_slugs": [
            "annahme-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Annahme",
        "nominative_pl": ""
      }
    },
    {
      "slug": "wirfst-verb",
      "lemma": "wirfst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6840,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of werfen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5986107",
          "text": "Du wirfst einen Stein ins Wasser.",
          "translation": "Ты бросаешь в воду камень.",
          "source": "Tatoeba #5986107 @christian63 / #5986714 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5986107",
          "cefr_level": "A1",
          "word_slugs": [
            "wirfst-verb"
          ]
        },
        {
          "id": "3489037",
          "text": "Ich möchte, dass du einen Blick darauf wirfst.",
          "translation": "Я хочу, что бы ты взглянул на это.",
          "source": "Tatoeba #3489037 @brauchinet / #4809734 @amina2901 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3489037",
          "cefr_level": "A1",
          "word_slugs": [
            "wirfst-verb"
          ]
        },
        {
          "id": "5097745",
          "text": "„Warum wirfst du Bücher ins Feuer?“ – „Weil mir kalt ist.“",
          "translation": "\"Почему ты бросаешь книги в огонь?\" - \"Потому что мне холодно\".",
          "source": "Tatoeba #5097745 @Pfirsichbaeumchen / #5098919 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5097745",
          "cefr_level": "A1",
          "word_slugs": [
            "wirfst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
