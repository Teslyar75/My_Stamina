    {
      "slug": "horizont-noun",
      "lemma": "Horizont",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8728,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "horizon (line where the sky appears to meet the earth; (figurative) range of someone’s thinking or insight)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2493134",
          "text": "Der Horizont weitete sich.",
          "translation": "Горизонт расширился.",
          "source": "Tatoeba #2493134 @al_ex_an_der / #2493133 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2493134",
          "cefr_level": "A1",
          "word_slugs": [
            "horizont-noun"
          ]
        },
        {
          "id": "7645176",
          "text": "Die Sonne versinkt am Horizont.",
          "translation": "Солнце заходит за горизонт.",
          "source": "Tatoeba #7645176 @Pfirsichbaeumchen / #6543464 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7645176",
          "cefr_level": "A1",
          "word_slugs": [
            "horizont-noun"
          ]
        },
        {
          "id": "3771996",
          "text": "Ein Schiff erschien am Horizont.",
          "translation": "На горизонте появился корабль.",
          "source": "Tatoeba #3771996 @Zaghawa / #5515353 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3771996",
          "cefr_level": "A1",
          "word_slugs": [
            "horizont-noun"
          ]
        },
        {
          "id": "11542509",
          "text": "Es waren Silhouetten am Horizont.",
          "translation": "На горизонте виднелись силуэты.",
          "source": "Tatoeba #11542509 @Pfirsichbaeumchen / #13308105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11542509",
          "cefr_level": "A1",
          "word_slugs": [
            "horizont-noun"
          ]
        },
        {
          "id": "368684",
          "text": "Gute Filme erweitern den Horizont.",
          "translation": "Хорошие кинофильмы расширяют горизонт.",
          "source": "Tatoeba #368684 @xtofu80 / #468359 @apuhtina (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/368684",
          "cefr_level": "A1",
          "word_slugs": [
            "horizont-noun"
          ]
        }
      ],
      "tags": [
