          "vulva"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "486010",
          "text": "Er wurde vor Scham rot.",
          "translation": "Он покраснел от стыда.",
          "source": "Tatoeba #486010 @xtofu80 / #2637363 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/486010",
          "cefr_level": "A1",
          "word_slugs": [
            "scham-noun"
          ]
        },
        {
          "id": "7294010",
          "text": "Tom wäre vor Scham fast gestorben.",
          "translation": "Том чуть не умер от смущения.",
          "source": "Tatoeba #7294010 @Pfirsichbaeumchen / #6542554 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7294010",
          "cefr_level": "A1",
          "word_slugs": [
            "scham-noun"
          ]
        },
        {
          "id": "2943431",
          "text": "Angst, Scham und Schuldgefühl bilden einen wirkungsvollen Mechanismus zur Manipulation von Menschen.",
          "translation": "Страх, стыд и чувство вины – это эффективные способы манипуляции людьми.",
          "source": "Tatoeba #2943431 @al_ex_an_der / #2943432 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2943431",
          "cefr_level": "A1",
          "word_slugs": [
            "scham-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Scham",
        "nominative_pl": ""
      }
