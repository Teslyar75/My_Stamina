          "inflection of gefährlich:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8110281",
          "text": "Das ist ein gefährlicher Weg.",
          "translation": "Это опасный путь.",
          "source": "Tatoeba #8110281 @Pfirsichbaeumchen / #5149218 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8110281",
          "cefr_level": "A1",
          "word_slugs": [
