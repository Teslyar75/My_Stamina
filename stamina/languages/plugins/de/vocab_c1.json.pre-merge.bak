          ]
        },
        {
          "id": "3445118",
          "text": "Ich hab’ die Autoschlüssel.",
          "translation": "Ключи от машины у меня.",
          "source": "Tatoeba #3445118 @pne / #11967020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3445118",
          "cefr_level": "A1",
          "word_slugs": [
            "autoschlüssel-noun"
          ]
        },
        {
          "id": "14005833",
          "text": "Gebt Tom die Autoschlüssel!",
          "translation": "Дайте ключи от машины Тому.",
          "source": "Tatoeba #14005833 @mhr / #14005818 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14005833",
          "cefr_level": "A1",
