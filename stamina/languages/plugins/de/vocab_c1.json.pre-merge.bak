    {
      "slug": "angebracht-verb",
      "lemma": "angebracht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5760,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of anbringen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8177277",
          "text": "Die Frage war völlig angebracht.",
          "translation": "Вопрос был вполне уместный.",
          "source": "Tatoeba #8177277 @Pfirsichbaeumchen / #4038514 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8177277",
          "cefr_level": "A1",
          "word_slugs": [
            "angebracht-verb"
          ]
        },
        {
          "id": "5075431",
          "text": "Polizeibeamte haben vor Toms Büro Überwachungskameras angebracht.",
          "translation": "Сотрудники полиции установили камеры наружного наблюдения перед офисом Тома.",
          "source": "Tatoeba #5075431 @Pfirsichbaeumchen / #5075487 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5075431",
          "cefr_level": "A1",
          "word_slugs": [
            "angebracht-verb"
          ]
        },
        {
          "id": "9680574",
          "text": "Tom hat auf dem Dach eine Fernsehantenne angebracht.",
          "translation": "Том установил на крыше телевизионную антенну.",
          "source": "Tatoeba #9680574 @Pfirsichbaeumchen / #8942889 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9680574",
          "cefr_level": "A1",
          "word_slugs": [
            "angebracht-verb"
          ]
        },
        {
          "id": "6824732",
          "text": "Die Verkehrszeichen sind normalerweise auf der Straßenseite der Fahrtrichtung angebracht.",
          "translation": "Дорожные знаки обычно расположены на стороне дороги по направлению движения.",
          "source": "Tatoeba #6824732 @brauchinet / #6824925 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6824732",
          "cefr_level": "A1",
          "word_slugs": [
            "angebracht-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
