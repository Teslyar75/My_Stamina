    {
      "slug": "militärische-adj",
      "lemma": "militärische",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9022,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of militärisch:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of militärisch:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2905333",
          "text": "Er erhielt mehrere militärische Auszeichnungen.",
          "translation": "Он приобрёл множество военных наград.",
          "source": "Tatoeba #2905333 @al_ex_an_der / #2906513 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2905333",
          "cefr_level": "A1",
          "word_slugs": [
            "militärische-adj"
          ]
        },
        {
          "id": "6596220",
          "text": "Im Sommerlager herrschte eine geradezu militärische Disziplin.",
          "translation": "В летнем лагере была почти военная дисциплина.",
          "source": "Tatoeba #6596220 @Pfirsichbaeumchen / #6295372 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6596220",
          "cefr_level": "A1",
          "word_slugs": [
            "militärische-adj"
          ]
        },
        {
          "id": "3425134",
          "text": "Der militärische Konflikt in Osten der Ukraine spitzt sich zu.",
          "translation": "Военный конфликт на востоке Украины обостряется.",
          "source": "Tatoeba #3425134 @al_ex_an_der / #3425133 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3425134",
          "cefr_level": "A1",
          "word_slugs": [
            "militärische-adj"
          ]
        },
        {
          "id": "3071310",
          "text": "Hier ist eine neue militärische Taktik zu erkennen: die Charmeoffensive.",
          "translation": "Вот новая военная тактика для сведения: атака обаянием.",
          "source": "Tatoeba #3071310 @al_ex_an_der / #3071846 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3071310",
          "cefr_level": "A1",
          "word_slugs": [
            "militärische-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
