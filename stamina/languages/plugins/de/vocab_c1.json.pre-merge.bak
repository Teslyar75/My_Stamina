    {
      "slug": "wahrlich-adv",
      "lemma": "wahrlich",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9878,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "truly, really, verily"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1910845",
          "text": "Zwei Experten sind wahrlich genug.",
          "translation": "Двух специалистов вполне достаточно.",
          "source": "Tatoeba #1910845 @al_ex_an_der / #1910841 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1910845",
          "cefr_level": "A1",
          "word_slugs": [
            "wahrlich-adv"
          ]
        },
        {
          "id": "7854630",
          "text": "Er ist wahrlich seines Vaters Sohn.",
          "translation": "Он действительно сын своего отца.",
          "source": "Tatoeba #7854630 @Pfirsichbaeumchen / #7854615 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7854630",
          "cefr_level": "A1",
          "word_slugs": [
            "wahrlich-adv"
          ]
        },
        {
          "id": "1945101",
          "text": "Das ist eine wahrlich salomonische Lösung.",
          "translation": "Это поистине соломоново решение.",
          "source": "Tatoeba #1945101 @al_ex_an_der / #1945095 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1945101",
          "cefr_level": "A1",
          "word_slugs": [
            "wahrlich-adv"
          ]
        },
        {
          "id": "3472657",
          "text": "Diese Komödie brachte mich wahrlich zum Lachen.",
          "translation": "Эта комедия действительно меня рассмешила.",
          "source": "Tatoeba #3472657 @al_ex_an_der / #3472712 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3472657",
          "cefr_level": "A1",
          "word_slugs": [
            "wahrlich-adv"
          ]
        },
        {
          "id": "3076217",
          "text": "Wahnsinn gibt es in der Welt wahrlich im Überfluss.",
          "translation": "Право, мир переполнен безумием.",
          "source": "Tatoeba #3076217 @al_ex_an_der / #4934077 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3076217",
          "cefr_level": "A1",
          "word_slugs": [
            "wahrlich-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
