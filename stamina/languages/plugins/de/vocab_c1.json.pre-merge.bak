    {
      "slug": "spürte-verb",
      "lemma": "spürte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6285,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of spüren:",
          "first/third-person singular preterite",
          "inflection of spüren:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "360645",
          "text": "Er spürte, wie etwas sein Bein hinaufkroch.",
          "translation": "Он почувствовал, что по ноге что-то ползет.",
          "source": "Tatoeba #360645 @Wolf / #1277838 @ainurshakirov (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/360645",
          "cefr_level": "A1",
          "word_slugs": [
            "spürte-verb"
          ]
        },
        {
          "id": "2568729",
          "text": "Er spürte die Wärme der Sonne auf seiner Haut.",
          "translation": "Он чувствовал на коже солнечное тепло.",
          "source": "Tatoeba #2568729 @Pfirsichbaeumchen / #11154542 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2568729",
          "cefr_level": "A1",
          "word_slugs": [
            "spürte-verb"
          ]
        },
        {
          "id": "9104633",
          "text": "Tom spürte die Waffe in seiner Hand und wurde merklich mutiger.",
          "translation": "Ощутив в руке оружие, Том заметно осмелел.",
          "source": "Tatoeba #9104633 @carlosalberto / #4019447 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9104633",
          "cefr_level": "A1",
          "word_slugs": [
            "spürte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "versammlung-noun",
      "lemma": "Versammlung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6286,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "собрание",
          "ассамблея"
        ],
        "en": [
          "gathering, meeting, assembly, congregation",
          "assembly"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "14003848",
          "text": "Die Versammlung fand hier statt.",
          "translation": "Собрание проходило здесь.",
          "source": "Tatoeba #14003848 @mhr / #14003697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14003848",
          "cefr_level": "A1",
          "word_slugs": [
            "versammlung-noun"
          ]
        },
        {
          "id": "14003844",
          "text": "Die Versammlung hat hier stattgefunden.",
          "translation": "Собрание проходило здесь.",
          "source": "Tatoeba #14003844 @mhr / #14003697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14003844",
          "cefr_level": "A1",
          "word_slugs": [
            "versammlung-noun"
          ]
        },
        {
          "id": "740313",
          "text": "Der Vorsitzende eröffnete die Versammlung.",
          "translation": "Председатель объявил собрание открытым.",
          "source": "Tatoeba #740313 @Manfredo / #5901138 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/740313",
          "cefr_level": "A1",
          "word_slugs": [
            "versammlung-noun"
          ]
        },
        {
          "id": "2094703",
          "text": "Ich nahm an der Versammlung teil.",
          "translation": "Я участвовал в собрании.",
          "source": "Tatoeba #2094703 @Esperantostern / #2236584 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2094703",
          "cefr_level": "A1",
          "word_slugs": [
            "versammlung-noun"
          ]
        },
        {
          "id": "935489",
          "text": "Die Versammlung ging bis zum Mittag.",
          "translation": "Собрание продолжалось до полудня.",
          "source": "Tatoeba #935489 @Sudajaengi / #12262191 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/935489",
          "cefr_level": "A1",
          "word_slugs": [
            "versammlung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Versammlung",
        "nominative_pl": ""
      }
    },
