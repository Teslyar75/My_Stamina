    {
      "slug": "erhebt-verb",
      "lemma": "erhebt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8422,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of erheben:",
          "third-person singular present",
          "inflection of erheben:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9114579",
          "text": "Tom erhebt nie die Stimme.",
          "translation": "Том никогда не повышает голос.",
          "source": "Tatoeba #9114579 @Pfirsichbaeumchen / #3390436 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9114579",
          "cefr_level": "A1",
          "word_slugs": [
            "erhebt-verb"
          ]
        },
        {
          "id": "1772937",
          "text": "Das Schloss erhebt sich über der Stadt.",
          "translation": "Замок возвышается над городом.",
          "source": "Tatoeba #1772937 @al_ex_an_der / #1772936 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1772937",
          "cefr_level": "A1",
          "word_slugs": [
            "erhebt-verb"
          ]
        },
        {
          "id": "4463160",
          "text": "Die Sonne erhebt sich über den Horizont.",
          "translation": "На горизонте поднимается солнце.",
          "source": "Tatoeba #4463160 @Pfirsichbaeumchen / #4463146 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4463160",
          "cefr_level": "A1",
          "word_slugs": [
            "erhebt-verb"
          ]
        },
        {
          "id": "7871262",
          "text": "Erhebt mir gegenüber bitte nicht die Stimme!",
          "translation": "Не повышайте на меня голос, пожалуйста.",
          "source": "Tatoeba #7871262 @Pfirsichbaeumchen / #7871214 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7871262",
          "cefr_level": "A1",
          "word_slugs": [
            "erhebt-verb"
          ]
        },
        {
          "id": "815021",
          "text": "Der Feigling ist der Allererste, der die Faust erhebt.",
          "translation": "Трус — первый, кто поднимает кулак.",
          "source": "Tatoeba #815021 @korntex / #413878 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/815021",
          "cefr_level": "A1",
          "word_slugs": [
            "erhebt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
