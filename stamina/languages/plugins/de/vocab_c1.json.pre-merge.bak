          "quality (level of excellence, level of being free from defects)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1916334",
          "text": "Menge bedeutet nicht unbedingt Qualität.",
          "translation": "Количество необязательно означает качество.",
          "source": "Tatoeba #1916334 @al_ex_an_der / #3676061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1916334",
          "cefr_level": "A1",
          "word_slugs": [
            "qualität-noun"
          ]
        },
        {
          "id": "940251",
          "text": "Dieser Artikel ist von hoher Qualität.",
          "translation": "Это высококачественный товар.",
          "source": "Tatoeba #940251 @Espi / #12004388 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/940251",
          "cefr_level": "A1",
          "word_slugs": [
            "qualität-noun"
          ]
        },
        {
          "id": "11265098",
          "text": "Dieses Shampoo ist von guter Qualität.",
          "translation": "Это шампунь хорошего качества.",
          "source": "Tatoeba #11265098 @felix63 / #11265148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11265098",
          "cefr_level": "A1",
          "word_slugs": [
            "qualität-noun"
          ]
        },
        {
          "id": "12364277",
          "text": "Dieser Wein ist von höchster Qualität.",
          "translation": "Это вино высшего качества.",
          "source": "Tatoeba #12364277 @felix63 / #12364337 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12364277",
          "cefr_level": "A1",
          "word_slugs": [
            "qualität-noun"
          ]
        },
        {
          "id": "2334280",
          "text": "Quantität sagt nichts über Qualität aus.",
          "translation": "Количество ничего не говорит о качестве.",
          "source": "Tatoeba #2334280 @al_ex_an_der / #2334283 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2334280",
