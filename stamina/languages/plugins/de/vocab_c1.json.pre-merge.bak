          "inflection of wagen:",
          "first-person singular present",
          "inflection of wagen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2503055",
          "text": "Ich wage zu vermuten, dass Sie ein Künstler sind.",
          "translation": "Рискну предположить, что вы художник.",
          "source": "Tatoeba #2503055 @al_ex_an_der / #2503057 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2503055",
          "cefr_level": "A1",
