          "inflection of trennen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1697920",
          "text": "Die zwei Städte trennt ein Fluss.",
          "translation": "Два города разделены рекой.",
          "source": "Tatoeba #1697920 @Esperantostern / #789680 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1697920",
          "cefr_level": "A1",
          "word_slugs": [
            "trennt-verb"
          ]
        },
        {
          "id": "2911917",
          "text": "Der Atlantik trennt Amerika von Europa.",
          "translation": "Атлантический океан разделяет Америку и Европу.",
          "source": "Tatoeba #2911917 @Pfirsichbaeumchen / #803742 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2911917",
          "cefr_level": "A1",
          "word_slugs": [
            "trennt-verb"
          ]
        },
        {
          "id": "3399730",
          "text": "Die Beringstraße trennt Asien von Nordamerika.",
          "translation": "Берингов пролив отделяет Азию от Северной Америки.",
          "source": "Tatoeba #3399730 @Pfirsichbaeumchen / #2099629 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3399730",
          "cefr_level": "A1",
          "word_slugs": [
            "trennt-verb"
          ]
        },
        {
          "id": "752918",
          "text": "Ein Fluss trennt die Stadt in Ost und West.",
          "translation": "На восточную и западную части город разделяет река.",
          "source": "Tatoeba #752918 @al_ex_an_der / #5631982 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/752918",
          "cefr_level": "A1",
          "word_slugs": [
            "trennt-verb"
          ]
        }
      ],
