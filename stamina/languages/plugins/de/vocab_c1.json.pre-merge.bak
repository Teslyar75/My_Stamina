    {
      "slug": "kündigen-verb",
      "lemma": "kündigen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6143,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "расторгать",
          "отменять"
        ],
        "en": [
          "to cancel, to terminate (a continuous obligation)",
          "to make known, to notify, to proclaim"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12905389",
          "text": "Ich werde bestimmt kündigen.",
          "translation": "Я обязательно уволюсь.",
          "source": "Tatoeba #12905389 @mhr / #12905374 @kalmez (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12905389",
          "cefr_level": "A1",
          "word_slugs": [
            "kündigen-verb"
          ]
        },
        {
          "id": "12905390",
          "text": "Ich werde auf jeden Fall kündigen.",
          "translation": "Я обязательно уволюсь.",
          "source": "Tatoeba #12905390 @mhr / #12905374 @kalmez (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12905390",
          "cefr_level": "A1",
          "word_slugs": [
            "kündigen-verb"
          ]
        },
        {
          "id": "13975184",
          "text": "Sie können dir jetzt nicht kündigen.",
          "translation": "Они не могут тебя сейчас уволить.",
          "source": "Tatoeba #13975184 @mhr / #13975139 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13975184",
          "cefr_level": "A1",
          "word_slugs": [
            "kündigen-verb"
          ]
        },
        {
          "id": "13975188",
          "text": "Sie können dir momentan nicht kündigen.",
          "translation": "Они не могут тебя сейчас уволить.",
          "source": "Tatoeba #13975188 @mhr / #13975139 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13975188",
          "cefr_level": "A1",
          "word_slugs": [
            "kündigen-verb"
          ]
        },
        {
          "id": "13631659",
          "text": "Jetzt wird man mir wahrscheinlich kündigen.",
          "translation": "Теперь меня, скорее всего, уволят.",
          "source": "Tatoeba #13631659 @mhr / #13631602 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13631659",
          "cefr_level": "A1",
          "word_slugs": [
            "kündigen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
