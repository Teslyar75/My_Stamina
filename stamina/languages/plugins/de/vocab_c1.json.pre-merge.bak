        {
          "id": "1881341",
          "text": "Hast du ein Kondom benutzt?",
          "translation": "Ты пользовался презервативом?",
          "source": "Tatoeba #1881341 @Pfirsichbaeumchen / #5295522 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1881341",
          "cefr_level": "A1",
          "word_slugs": [
            "kondom-noun"
          ]
        },
        {
          "id": "2039442",
          "text": "Tom benutzt immer ein Kondom.",
          "translation": "Том всегда пользуется презервативом.",
          "source": "Tatoeba #2039442 @Vortarulo / #2068509 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2039442",
          "cefr_level": "A1",
          "word_slugs": [
            "kondom-noun"
          ]
        },
        {
          "id": "584256",
          "text": "Tut mir leid, ich mache es nicht ohne Kondom.",
          "translation": "Извини, я не буду делать это без презерватива.",
          "source": "Tatoeba #584256 @MUIRIEL / #2285861 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/584256",
          "cefr_level": "A1",
          "word_slugs": [
            "kondom-noun"
          ]
        }
      ],
