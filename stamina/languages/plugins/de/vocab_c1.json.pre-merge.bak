      },
      "gender": null,
      "examples": [
        {
          "id": "7011189",
          "text": "Er ist schwach im Englischen.",
          "translation": "Он слаб в английском.",
          "source": "Tatoeba #7011189 @Pfirsichbaeumchen / #8751381 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7011189",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-name"
          ]
        },
        {
          "id": "11839721",
          "text": "Gibt es im Englischen Grammatikregeln?",
          "translation": "Есть ли в английском грамматические правила?",
          "source": "Tatoeba #11839721 @Pfirsichbaeumchen / #2934293 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11839721",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-name"
          ]
        },
        {
          "id": "12901948",
          "text": "Ich will mich im Englischen üben.",
          "translation": "Я хочу попрактиковаться в английском.",
          "source": "Tatoeba #12901948 @mhr / #12901686 @LanguagesLover (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12901948",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-name"
          ]
        },
        {
          "id": "5511601",
          "text": "Ich will fließend im Englischen werden.",
          "translation": "Я хочу свободно говорить по-английски.",
          "source": "Tatoeba #5511601 @Pfirsichbaeumchen / #10851865 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5511601",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-name"
          ]
        },
        {
          "id": "3887729",
          "text": "Herr Katō unterrichtet uns im Englischen.",
          "translation": "Господин Като преподает нам английский.",
          "source": "Tatoeba #3887729 @Pfirsichbaeumchen / #3587935 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3887729",
          "cefr_level": "A1",
          "word_slugs": [
            "englischen-name"
          ]
        }
      ],
