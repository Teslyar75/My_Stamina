    {
      "slug": "stattfinden-verb",
      "lemma": "stattfinden",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5858,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "состояться",
          "иметь место"
        ],
        "en": [
          "to take place, to happen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10286414",
          "text": "Soll das bald stattfinden?",
          "translation": "Это скоро должно состояться?",
          "source": "Tatoeba #10286414 @manese / #11696254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10286414",
          "cefr_level": "A1",
          "word_slugs": [
            "stattfinden-verb"
          ]
        },
        {
          "id": "13818050",
          "text": "Die Messe wird nicht stattfinden.",
          "translation": "Месса не состоится.",
          "source": "Tatoeba #13818050 @scaui0 / #13818078 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13818050",
          "cefr_level": "A1",
          "word_slugs": [
            "stattfinden-verb"
          ]
        },
        {
          "id": "632961",
          "text": "Die Zeremonie wird morgen stattfinden.",
          "translation": "Церемония состоится завтра.",
          "source": "Tatoeba #632961 @Manfredo / #388151 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/632961",
          "cefr_level": "A1",
          "word_slugs": [
            "stattfinden-verb"
          ]
        },
        {
          "id": "13754535",
          "text": "Heute wird kein Französischunterricht stattfinden.",
          "translation": "Сегодня французского не будет.",
          "source": "Tatoeba #13754535 @mhr / #13754228 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13754535",
          "cefr_level": "A1",
          "word_slugs": [
            "stattfinden-verb"
          ]
        },
        {
          "id": "12901494",
          "text": "Die Wahlen werden im Januar stattfinden.",
          "translation": "Выборы пройдут в январе.",
          "source": "Tatoeba #12901494 @mhr / #12901274 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12901494",
          "cefr_level": "A1",
          "word_slugs": [
            "stattfinden-verb"
          ]
        }
      ],
      "tags": [
