          "source": "Tatoeba #1949393 @al_ex_an_der / #1949391 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1949393",
          "cefr_level": "A1",
          "word_slugs": [
            "kühl-adj"
          ]
        },
        {
          "id": "13835420",
          "text": "Dieser Sommer ist kühl.",
