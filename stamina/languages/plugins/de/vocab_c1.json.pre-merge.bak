        "en": [
          "fortress, fortification"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3531799",
          "text": "Die Festung fiel.",
          "translation": "Крепость пала.",
          "source": "Tatoeba #3531799 @al_ex_an_der / #3531798 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3531799",
          "cefr_level": "A1",
          "word_slugs": [
            "festung-noun"
          ]
        },
        {
          "id": "1814916",
          "text": "Die Belagerung der Festung dauerte lange.",
          "translation": "Осада крепости продолжалась долго.",
          "source": "Tatoeba #1814916 @Esperantostern / #6059796 @diana_brain (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1814916",
          "cefr_level": "A1",
          "word_slugs": [
            "festung-noun"
          ]
        },
        {
          "id": "753544",
          "text": "Die Festung war in der Hand des Feindes.",
          "translation": "Крепость была в руках врага.",
          "source": "Tatoeba #753544 @xtofu80 / #4892176 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/753544",
          "cefr_level": "A1",
          "word_slugs": [
            "festung-noun"
          ]
        },
        {
          "id": "13701164",
          "text": "Der Mensch ist eine Festung, die von innen heraus belagert wird.",
          "translation": "Человек есть крепость, осаждаемая изнутри.",
          "source": "Tatoeba #13701164 @Waldelfe / #1916386 @symbol (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13701164",
          "cefr_level": "A1",
          "word_slugs": [
            "festung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
