          ]
        },
        {
          "id": "1211698",
          "text": "Ich heiße Wang Jiaming.",
          "translation": "Меня зовут Ван Цзямин.",
          "source": "Tatoeba #1211698 @PeterR / #379446 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1211698",
          "cefr_level": "A1",
          "word_slugs": [
