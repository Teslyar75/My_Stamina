      },
      "gender": null,
      "examples": [
        {
          "id": "7961874",
          "text": "Ich schreibe Lieder.",
          "translation": "Я пишу песни.",
          "source": "Tatoeba #7961874 @wolfgangth / #5910855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7961874",
