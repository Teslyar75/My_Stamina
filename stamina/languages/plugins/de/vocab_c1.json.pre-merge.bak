    {
      "slug": "hindern-verb",
      "lemma": "hindern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6244,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мешать",
          "препятствовать"
        ],
        "en": [
          "to impede, hinder",
          "to prevent"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "427296",
          "text": "Niemand kann mich daran hindern, dort hinzugehen.",
          "translation": "Никто не сможет удержать меня от того, чтобы пойти туда.",
          "source": "Tatoeba #427296 @MUIRIEL / #531280 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/427296",
          "cefr_level": "A1",
          "word_slugs": [
            "hindern-verb"
          ]
        },
        {
          "id": "6841863",
          "text": "Ich glaube, dass ich Tom daran nicht hindern kann.",
          "translation": "Мне кажется, что я не смогу помешать Тому это сделать.",
          "source": "Tatoeba #6841863 @manese / #6842481 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841863",
          "cefr_level": "A1",
          "word_slugs": [
            "hindern-verb"
          ]
        },
        {
          "id": "12831086",
          "text": "Ich wußte, daß ihr Tom nicht würdet hindern können, das zu tun.",
          "translation": "Я знал, что вы не сможете помешать Тому это сделать.",
          "source": "Tatoeba #12831086 @Waldelfe / #12831079 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12831086",
          "cefr_level": "A1",
          "word_slugs": [
            "hindern-verb"
          ]
        },
        {
          "id": "12831087",
          "text": "Ich wußte, daß Sie Tom nicht würden hindern können, das zu tun.",
          "translation": "Я знал, что вы не сможете помешать Тому это сделать.",
          "source": "Tatoeba #12831087 @Waldelfe / #12831079 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12831087",
          "cefr_level": "A1",
          "word_slugs": [
            "hindern-verb"
          ]
        },
        {
          "id": "12831088",
          "text": "Ich wußte, daß du Tom nicht würdest hindern können, das zu tun.",
          "translation": "Я знал, что ты не сможешь помешать Тому это сделать.",
          "source": "Tatoeba #12831088 @Waldelfe / #12831080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12831088",
          "cefr_level": "A1",
          "word_slugs": [
            "hindern-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
