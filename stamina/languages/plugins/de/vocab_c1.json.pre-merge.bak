        "en": [
          "angle, nook; corner (seen from the inside)",
          "angle (figure, measure thereof)",
          "one of the two areas of a goal near where the post and crossbar meet;",
          "chevron"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "1928787",
          "text": "Ein Quadrat hat vier Winkel.",
          "translation": "У квадрата четыре угла.",
