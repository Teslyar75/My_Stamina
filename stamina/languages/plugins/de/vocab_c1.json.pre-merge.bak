          "source": "Tatoeba #2053150 @al_ex_an_der / #2053140 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2053150",
          "cefr_level": "A1",
          "word_slugs": [
            "luxus-noun"
          ]
        },
        {
          "id": "12713093",
          "text": "Ein Privatflugzeug ist ein unnötiger Luxus.",
          "translation": "Частный самолет - ненужная роскошь.",
          "source": "Tatoeba #12713093 @mhr / #12713087 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12713093",
          "cefr_level": "A1",
          "word_slugs": [
            "luxus-noun"
          ]
        },
        {
          "id": "3634311",
          "text": "Dieser Luxus-Zug ist ein Palast auf Rädern.",
          "translation": "Этот шикарный поезд — дворец на колёсах.",
          "source": "Tatoeba #3634311 @al_ex_an_der / #3634707 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3634311",
          "cefr_level": "A1",
          "word_slugs": [
            "luxus-noun"
          ]
        }
