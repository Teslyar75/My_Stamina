    {
      "slug": "chor-noun",
      "lemma": "Chor",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6972,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "хор"
        ],
        "en": [
          "choir; chorus (group of people singing together)",
          "choir (part of a church building)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6167255",
          "text": "Sie singt im Chor.",
          "translation": "Она поёт в хоре.",
          "source": "Tatoeba #6167255 @Pfirsichbaeumchen / #5792179 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6167255",
          "cefr_level": "A1",
          "word_slugs": [
            "chor-noun"
          ]
        },
        {
          "id": "344288",
          "text": "Sie sangen im Chor.",
          "translation": "Они пели хором.",
          "source": "Tatoeba #344288 @MUIRIEL / #2738659 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344288",
          "cefr_level": "A1",
          "word_slugs": [
            "chor-noun"
          ]
        },
        {
          "id": "6554705",
          "text": "Tom singt in einem Chor.",
          "translation": "Том поёт в хоре.",
          "source": "Tatoeba #6554705 @Esperantostern / #6554555 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6554705",
          "cefr_level": "A1",
          "word_slugs": [
            "chor-noun"
          ]
        },
        {
          "id": "8542459",
          "text": "Ich singe gerne im Chor.",
          "translation": "Я люблю петь в хоре.",
          "source": "Tatoeba #8542459 @felix63 / #8555757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8542459",
          "cefr_level": "A1",
          "word_slugs": [
            "chor-noun"
          ]
        },
        {
          "id": "588716",
          "text": "Wir sangen Lieder im Chor.",
          "translation": "Мы распевали песни хором.",
          "source": "Tatoeba #588716 @cost / #1679991 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/588716",
          "cefr_level": "A1",
          "word_slugs": [
            "chor-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Chor",
        "nominative_pl": ""
