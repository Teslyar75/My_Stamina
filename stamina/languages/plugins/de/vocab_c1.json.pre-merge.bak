          "cefr_level": "A1",
          "word_slugs": [
            "picknick-noun"
          ]
        },
        {
          "id": "5113388",
          "text": "Das Picknick wurde wegen des Regens abgesagt.",
          "translation": "Пикник был отменён из-за дождя.",
          "source": "Tatoeba #5113388 @raggione / #1531854 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5113388",
          "cefr_level": "A1",
          "word_slugs": [
            "picknick-noun"
          ]
        },
        {
          "id": "10087752",
          "text": "Es ist ein wunderschöner Tag für ein Picknick.",
          "translation": "Прекрасный день для пикника.",
          "source": "Tatoeba #10087752 @Pfirsichbaeumchen / #3970311 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10087752",
          "cefr_level": "A1",
