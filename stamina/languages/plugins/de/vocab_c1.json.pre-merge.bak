    {
      "slug": "galt-verb",
      "lemma": "galt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9349,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of gelten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3801613",
          "text": "In Russland galt der julianische Kalender.",
          "translation": "В России действовал юлианский календарь.",
          "source": "Tatoeba #3801613 @Tlustulimu / #3805675 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3801613",
          "cefr_level": "A1",
          "word_slugs": [
            "galt-verb"
          ]
        },
        {
          "id": "2848544",
          "text": "Jahrhundertelang galt Deutsch als Sprache der Philosophie.",
          "translation": "Столетия немецкий язык был языком философии.",
          "source": "Tatoeba #2848544 @raggione / #2879161 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2848544",
          "cefr_level": "A1",
          "word_slugs": [
            "galt-verb"
          ]
        },
        {
          "id": "2437096",
          "text": "Dieser Platz galt einst als der verkehrsreichste Platz in Europa.",
          "translation": "Эта площадь когда-то считалась самой оживленной площадью Европы.",
          "source": "Tatoeba #2437096 @al_ex_an_der / #2437099 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2437096",
          "cefr_level": "A1",
          "word_slugs": [
            "galt-verb"
          ]
        },
        {
          "id": "9081688",
          "text": "Viele Jahre lang galt Pluto als der neunte Planet des Sonnensystems.",
          "translation": "Много лет Плутон считался девятой планетой нашей Солнечной системы.",
          "source": "Tatoeba #9081688 @Pfirsichbaeumchen / #5224159 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9081688",
          "cefr_level": "A1",
          "word_slugs": [
            "galt-verb"
          ]
        },
        {
          "id": "3492767",
          "text": "Maria galt zu ihrer Zeit als eine der schönsten Frauen der Welt.",
          "translation": "В своё время Мэри считалась одной из самых красивых женщин мира.",
          "source": "Tatoeba #3492767 @Pfirsichbaeumchen / #3492962 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3492767",
          "cefr_level": "A1",
          "word_slugs": [
            "galt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
