    {
      "slug": "verhandlungen-noun",
      "lemma": "Verhandlungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6642,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Verhandlung"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3268190",
          "text": "Sie müssen Verhandlungen beginnen.",
          "translation": "Они должны начать переговоры.",
          "source": "Tatoeba #3268190 @al_ex_an_der / #3120842 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3268190",
          "cefr_level": "A1",
          "word_slugs": [
            "verhandlungen-noun"
          ]
        },
        {
          "id": "4311397",
          "text": "Die Verhandlungen sind gescheitert.",
          "translation": "Переговоры потерпели неудачу.",
          "source": "Tatoeba #4311397 @al_ex_an_der / #4533023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4311397",
          "cefr_level": "A1",
          "word_slugs": [
            "verhandlungen-noun"
          ]
        },
        {
          "id": "2593871",
          "text": "Ich selbst führte die Verhandlungen.",
          "translation": "Я сам вёл переговоры.",
          "source": "Tatoeba #2593871 @al_ex_an_der / #2593869 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2593871",
          "cefr_level": "A1",
          "word_slugs": [
            "verhandlungen-noun"
          ]
        },
        {
          "id": "831341",
          "text": "Unsere Verhandlungen gerieten ins Stocken.",
          "translation": "Наши переговоры зашли в тупик.",
          "source": "Tatoeba #831341 @xtofu80 / #1108925 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/831341",
          "cefr_level": "A1",
          "word_slugs": [
            "verhandlungen-noun"
          ]
        },
        {
          "id": "12927693",
          "text": "Die Verhandlungen fanden hinter verschlossenen Türen statt.",
          "translation": "Переговоры проходили за закрытыми дверями.",
          "source": "Tatoeba #12927693 @mhr / #12927667 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12927693",
          "cefr_level": "A1",
          "word_slugs": [
            "verhandlungen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
