    {
      "slug": "zugestossen-verb",
      "lemma": "zugestoßen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7067,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of zustoßen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2835978",
          "text": "Ihm muss unterwegs etwas zugestoßen sein.",
          "translation": "Должно быть, с ним что-то случилось в дороге.",
          "source": "Tatoeba #2835978 @Pfirsichbaeumchen / #2819889 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2835978",
          "cefr_level": "A1",
          "word_slugs": [
            "zugestossen-verb"
          ]
        },
        {
          "id": "9927023",
          "text": "Er wusste nicht, was ihr zugestoßen war.",
          "translation": "Он не знал, что с ней случилось.",
          "source": "Tatoeba #9927023 @Laoan / #9012577 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9927023",
          "cefr_level": "A1",
          "word_slugs": [
            "zugestossen-verb"
          ]
        },
        {
          "id": "6379387",
          "text": "Ich hoffe, dass ihr nichts zugestoßen ist.",
          "translation": "Надеюсь, с ней ничего не случилось.",
          "source": "Tatoeba #6379387 @Pfirsichbaeumchen / #3495990 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6379387",
          "cefr_level": "A1",
          "word_slugs": [
            "zugestossen-verb"
          ]
        },
        {
          "id": "7011191",
          "text": "Tom fragte mich, was Maria zugestoßen sei.",
          "translation": "Том спросил у меня, что случилось с Мэри.",
          "source": "Tatoeba #7011191 @Pfirsichbaeumchen / #3504963 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7011191",
          "cefr_level": "A1",
          "word_slugs": [
            "zugestossen-verb"
          ]
        },
        {
          "id": "7294019",
          "text": "Ich glaube, ich weiß, was Tom zugestoßen ist.",
          "translation": "Думаю, я знаю, что случилось с Томом.",
          "source": "Tatoeba #7294019 @Pfirsichbaeumchen / #4513328 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7294019",
          "cefr_level": "A1",
          "word_slugs": [
            "zugestossen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
