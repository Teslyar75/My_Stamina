          "inflection of singen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3685049",
          "text": "Ich singe gut!",
          "translation": "Я хорошо пою.",
          "source": "Tatoeba #3685049 @Esperantostern / #2038438 @Vokabre (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3685049",
          "cefr_level": "A1",
          "word_slugs": [
            "singe-verb"
          ]
        },
        {
          "id": "8824323",
          "text": "Ich singe nie.",
          "translation": "Я никогда не пою.",
          "source": "Tatoeba #8824323 @mramosch / #10186972 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8824323",
          "cefr_level": "A1",
          "word_slugs": [
            "singe-verb"
          ]
        },
        {
          "id": "594895",
          "text": "Ich singe gern.",
          "translation": "Я люблю петь.",
          "source": "Tatoeba #594895 @juwu / #531433 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/594895",
          "cefr_level": "A1",
          "word_slugs": [
            "singe-verb"
          ]
        },
        {
          "id": "532570",
          "text": "Ich singe gerne.",
          "translation": "Я люблю петь.",
          "source": "Tatoeba #532570 @MUIRIEL / #531433 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/532570",
          "cefr_level": "A1",
