          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1768884",
          "text": "Überlasse ihn mir.",
          "translation": "Оставь его мне.",
          "source": "Tatoeba #1768884 @Pfirsichbaeumchen / #6155952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1768884",
          "cefr_level": "A1",
          "word_slugs": [
            "überlasse-verb"
          ]
        },
        {
          "id": "342026",
          "text": "Das überlasse ich dir.",
          "translation": "Я предоставляю это тебе.",
          "source": "Tatoeba #342026 @lilygilder / #2945579 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/342026",
          "cefr_level": "A1",
          "word_slugs": [
            "überlasse-verb"
          ]
        },
        {
          "id": "371848",
          "text": "Ich überlasse dir diese Sache.",
          "translation": "Оставляю это дело тебе.",
          "source": "Tatoeba #371848 @xtofu80 / #5168240 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/371848",
          "cefr_level": "A1",
          "word_slugs": [
            "überlasse-verb"
          ]
        },
        {
          "id": "371846",
          "text": "Ich überlasse dir die Entscheidung.",
          "translation": "Оставляю решение за тобой.",
          "source": "Tatoeba #371846 @xtofu80 / #3517467 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/371846",
          "cefr_level": "A1",
          "word_slugs": [
            "überlasse-verb"
          ]
        },
        {
          "id": "4508072",
          "text": "Ich überlasse die Entscheidung Ihnen.",
          "translation": "Оставляю решение за Вами.",
          "source": "Tatoeba #4508072 @raggione / #4508110 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4508072",
          "cefr_level": "A1",
          "word_slugs": [
            "überlasse-verb"
          ]
        }
      ],
