    {
      "slug": "erhöht-verb",
      "lemma": "erhöht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5960,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of erhöhen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1717050",
          "text": "Fieber erhöht den Puls.",
          "translation": "Лихорадка учащает пульс.",
          "source": "Tatoeba #1717050 @Esperantostern / #2944189 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1717050",
          "cefr_level": "A1",
          "word_slugs": [
            "erhöht-verb"
          ]
        },
        {
          "id": "1729816",
          "text": "Dies erhöht die Produktivität.",
          "translation": "Это увеличит производительность.",
          "source": "Tatoeba #1729816 @Esperantostern / #1584821 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1729816",
          "cefr_level": "A1",
          "word_slugs": [
            "erhöht-verb"
          ]
        },
        {
          "id": "10456216",
          "text": "Ihr Blutdruck ist leicht erhöht.",
          "translation": "У вас слегка повышенное давление.",
          "source": "Tatoeba #10456216 @Pfirsichbaeumchen / #10456220 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10456216",
          "cefr_level": "A1",
          "word_slugs": [
            "erhöht-verb"
          ]
        },
        {
          "id": "3074694",
          "text": "Der Lohn wird im April erhöht.",
          "translation": "Заработная плата будет повышена с апреля.",
          "source": "Tatoeba #3074694 @faehrmann / #1941627 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3074694",
          "cefr_level": "A1",
          "word_slugs": [
            "erhöht-verb"
          ]
        },
        {
          "id": "2205803",
          "text": "Die Sicherheitsmaßnahmen in der Stadt wurden erhöht.",
          "translation": "В городе были усилены меры безопасности.",
          "source": "Tatoeba #2205803 @Pfirsichbaeumchen / #3044665 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2205803",
          "cefr_level": "A1",
