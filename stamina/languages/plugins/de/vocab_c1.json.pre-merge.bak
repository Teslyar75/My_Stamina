        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12219709",
          "text": "Wo sind meine Werkzeuge?",
          "translation": "Где мои инструменты?",
          "source": "Tatoeba #12219709 @felix63 / #12354500 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12219709",
          "cefr_level": "A1",
          "word_slugs": [
