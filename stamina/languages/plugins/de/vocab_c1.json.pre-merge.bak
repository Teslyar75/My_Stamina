    {
      "slug": "abzulenken-verb",
      "lemma": "abzulenken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9614,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "zu-infinitive of ablenken"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3255567",
          "text": "Hör auf, vom Thema abzulenken!",
          "translation": "Хватит отклоняться от темы!",
          "source": "Tatoeba #3255567 @Pfirsichbaeumchen / #3255609 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3255567",
          "cefr_level": "A1",
          "word_slugs": [
            "abzulenken-verb"
          ]
        },
        {
          "id": "2946636",
          "text": "Ich lese nur, um mich abzulenken.",
          "translation": "Читаю только для развлечения.",
          "source": "Tatoeba #2946636 @al_ex_an_der / #2946627 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2946636",
          "cefr_level": "A1",
          "word_slugs": [
            "abzulenken-verb"
          ]
        },
        {
          "id": "3749388",
          "text": "Ich brauche etwas, um mich abzulenken.",
          "translation": "Мне нужно что-нибудь, чтобы отвлечься.",
          "source": "Tatoeba #3749388 @brauchinet / #13803044 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3749388",
          "cefr_level": "A1",
          "word_slugs": [
            "abzulenken-verb"
          ]
        },
        {
          "id": "12978217",
          "text": "Man hat für uns Feinde erfunden, um uns abzulenken.",
          "translation": "Нам придумали врагов, чтобы нас отвлечь.",
          "source": "Tatoeba #12978217 @mhr / #12978181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12978217",
          "cefr_level": "A1",
          "word_slugs": [
            "abzulenken-verb"
          ]
        },
        {
          "id": "12978211",
          "text": "Man hat sich für uns Feinde ausgedacht, um uns abzulenken.",
          "translation": "Нам придумали врагов, чтобы нас отвлечь.",
          "source": "Tatoeba #12978211 @mhr / #12978181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12978211",
          "cefr_level": "A1",
          "word_slugs": [
            "abzulenken-verb"
          ]
        }
      ],
