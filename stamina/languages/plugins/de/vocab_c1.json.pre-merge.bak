    {
      "slug": "befahl-verb",
      "lemma": "befahl",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8647,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of befehlen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2228429",
          "text": "Er befahl mir aufzustehen.",
          "translation": "Он приказал мне встать.",
          "source": "Tatoeba #2228429 @Pfirsichbaeumchen / #467019 @katjka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2228429",
          "cefr_level": "A1",
          "word_slugs": [
            "befahl-verb"
          ]
        },
        {
          "id": "643863",
          "text": "Takuya befahl mir, sofort anzufangen.",
          "translation": "Такуя приказал мне немедленно начинать.",
          "source": "Tatoeba #643863 @Pfirsichbaeumchen / #4956846 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/643863",
          "cefr_level": "A1",
          "word_slugs": [
            "befahl-verb"
          ]
        },
        {
          "id": "666667",
          "text": "Der Polizist befahl ihnen anzuhalten.",
          "translation": "Полицейский приказал им остановиться.",
          "source": "Tatoeba #666667 @Manfredo / #1930422 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/666667",
          "cefr_level": "A1",
          "word_slugs": [
            "befahl-verb"
          ]
        },
        {
          "id": "1796006",
          "text": "Der Kapitän befahl, die Segel einzuziehen.",
          "translation": "Капитан приказал убрать паруса.",
          "source": "Tatoeba #1796006 @Esperantostern / #7750675 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1796006",
          "cefr_level": "A1",
          "word_slugs": [
            "befahl-verb"
          ]
        },
        {
          "id": "2514583",
          "text": "Sie befahl ihm, keine Befehle zu geben.",
          "translation": "Она приказала ему не раздавать приказаний.",
          "source": "Tatoeba #2514583 @brauchinet / #2529469 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2514583",
          "cefr_level": "A1",
          "word_slugs": [
            "befahl-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
