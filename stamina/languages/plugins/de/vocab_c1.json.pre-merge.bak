          "cefr_level": "A1",
          "word_slugs": [
            "geliehen-verb"
          ]
        },
        {
          "id": "13648914",
          "text": "Habe ich dir mein Buch geliehen?",
          "translation": "Я одалживал тебе свою книгу?",
          "source": "Tatoeba #13648914 @mhr / #13648918 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13648914",
          "cefr_level": "A1",
          "word_slugs": [
            "geliehen-verb"
          ]
        },
        {
          "id": "13648915",
          "text": "Maria hat Tom ein Buch geliehen.",
          "translation": "Мэри одолжила Тому книгу.",
          "source": "Tatoeba #13648915 @mhr / #13648919 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13648915",
          "cefr_level": "A1",
          "word_slugs": [
            "geliehen-verb"
          ]
        }
