      },
      "gender": "n",
      "examples": [
        {
          "id": "6904509",
          "text": "Die Vase ist durchsichtig.",
          "translation": "Ваза прозрачная.",
          "source": "Tatoeba #6904509 @Esperantostern / #9406142 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6904509",
          "cefr_level": "A1",
          "word_slugs": [
            "vase-noun"
          ]
        },
        {
          "id": "551511",
          "text": "Diese Vase ist aus Eisen.",
          "translation": "Эта ваза сделана из железа.",
          "source": "Tatoeba #551511 @al_ex_an_der / #4177565 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/551511",
          "cefr_level": "A1",
          "word_slugs": [
            "vase-noun"
          ]
        },
        {
          "id": "1428714",
          "text": "Eine Vase fiel vom Tisch.",
          "translation": "Со стола упала ваза.",
          "source": "Tatoeba #1428714 @Esperantostern / #13454850 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1428714",
          "cefr_level": "A1",
          "word_slugs": [
            "vase-noun"
          ]
        },
        {
          "id": "363443",
          "text": "Wer hat die Vase zerbrochen?",
          "translation": "Кто разбил вазу?",
          "source": "Tatoeba #363443 @Wolf / #612471 @Aleksej (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/363443",
          "cefr_level": "A1",
          "word_slugs": [
            "vase-noun"
          ]
        },
        {
          "id": "3243273",
          "text": "Die Vase steht auf dem Tisch.",
          "translation": "Ваза стоит на столе.",
          "source": "Tatoeba #3243273 @Trinkschokolade / #4760413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3243273",
          "cefr_level": "A1",
          "word_slugs": [
            "vase-noun"
          ]
        }
      ],
      "tags": [
