    {
      "slug": "monats-noun",
      "lemma": "Monats",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7017,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Monat"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3832283",
          "text": "Ich bezahle Sie am Ende des Monats.",
          "translation": "Я заплачу вам в конце месяца.",
          "source": "Tatoeba #3832283 @Pfirsichbaeumchen / #2549949 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3832283",
          "cefr_level": "A1",
          "word_slugs": [
            "monats-noun"
          ]
        },
        {
          "id": "3832280",
          "text": "Ich bezahle dich am Ende des Monats.",
          "translation": "Я заплачу тебе в конце месяца.",
          "source": "Tatoeba #3832280 @Pfirsichbaeumchen / #13845295 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3832280",
          "cefr_level": "A1",
          "word_slugs": [
            "monats-noun"
          ]
        },
        {
          "id": "3832281",
          "text": "Ich bezahle euch am Ende des Monats.",
          "translation": "Я заплачу вам в конце месяца.",
          "source": "Tatoeba #3832281 @Pfirsichbaeumchen / #2549949 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3832281",
          "cefr_level": "A1",
          "word_slugs": [
            "monats-noun"
          ]
        },
        {
          "id": "344666",
          "text": "Sag mir den Namen des neunten Monats.",
          "translation": "Скажи мне название девятого месяца.",
          "source": "Tatoeba #344666 @MUIRIEL / #5391905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344666",
          "cefr_level": "A1",
          "word_slugs": [
            "monats-noun"
          ]
        },
        {
          "id": "7588216",
          "text": "Ich werde am Letzten des Monats bezahlt.",
          "translation": "Мне платят в последний день месяца.",
          "source": "Tatoeba #7588216 @Pfirsichbaeumchen / #7587646 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7588216",
          "cefr_level": "A1",
          "word_slugs": [
            "monats-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
