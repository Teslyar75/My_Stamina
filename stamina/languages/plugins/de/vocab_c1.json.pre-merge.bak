      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6940,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "запустить"
        ],
        "en": [
          "to trigger, to initiate, to cause",
          "to ransom"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13435885",
          "text": "Das wird einen Dominoeffekt auslösen.",
          "translation": "Это вызовет эффект домино.",
