    {
      "slug": "gekündigt-verb",
      "lemma": "gekündigt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5258,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of kündigen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12272893",
          "text": "Sie haben mir gekündigt.",
          "translation": "Они меня уволили.",
          "source": "Tatoeba #12272893 @mhr / #12272509 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12272893",
          "cefr_level": "A1",
          "word_slugs": [
            "gekündigt-verb"
          ]
        },
        {
          "id": "5320181",
          "text": "Ich habe vorgestern gekündigt.",
          "translation": "Я позавчера уволился.",
          "source": "Tatoeba #5320181 @Pfirsichbaeumchen / #12378732 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5320181",
          "cefr_level": "A1",
          "word_slugs": [
            "gekündigt-verb"
          ]
        },
        {
          "id": "8444260",
          "text": "Die Chefin hat mir gekündigt.",
          "translation": "Начальница меня уволила.",
          "source": "Tatoeba #8444260 @felix63 / #8454207 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8444260",
          "cefr_level": "A1",
          "word_slugs": [
            "gekündigt-verb"
          ]
        },
        {
          "id": "8557464",
          "text": "Er hat ihrem Vater gekündigt.",
          "translation": "Он уволил её отца.",
          "source": "Tatoeba #8557464 @Pfirsichbaeumchen / #2579600 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8557464",
          "cefr_level": "A1",
          "word_slugs": [
            "gekündigt-verb"
          ]
        },
        {
          "id": "13659465",
          "text": "Warum hat sie dir nicht gekündigt?",
          "translation": "Почему она тебя не уволила?",
          "source": "Tatoeba #13659465 @mhr / #13658878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13659465",
          "cefr_level": "A1",
          "word_slugs": [
            "gekündigt-verb"
          ]
        }
      ],
