          ]
        },
        {
          "id": "9463567",
          "text": "Sie sind speziell.",
          "translation": "Вы особенный.",
          "source": "Tatoeba #9463567 @Pfirsichbaeumchen / #3465090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9463567",
          "cefr_level": "A1",
