        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6275693",
          "text": "Der Balkon ist klein.",
          "translation": "Балкон маленький.",
          "source": "Tatoeba #6275693 @rmateo / #8068327 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6275693",
          "cefr_level": "A1",
          "word_slugs": [
            "balkon-noun"
          ]
        },
        {
          "id": "356658",
          "text": "Ich bin auf dem Balkon.",
          "translation": "Я на балконе.",
          "source": "Tatoeba #356658 @MUIRIEL / #3052088 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/356658",
          "cefr_level": "A1",
          "word_slugs": [
            "balkon-noun"
          ]
        },
        {
          "id": "7154252",
          "text": "Wir sind auf dem Balkon.",
          "translation": "Мы на балконе.",
          "source": "Tatoeba #7154252 @Luiaard / #7154259 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7154252",
          "cefr_level": "A1",
          "word_slugs": [
            "balkon-noun"
          ]
        },
        {
          "id": "3352957",
          "text": "Gehen wir auf den Balkon!",
          "translation": "Пойдём на балкон.",
          "source": "Tatoeba #3352957 @al_ex_an_der / #3352955 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3352957",
          "cefr_level": "A1",
          "word_slugs": [
            "balkon-noun"
          ]
        },
        {
          "id": "6681622",
          "text": "Tom raucht auf dem Balkon.",
          "translation": "Том курит на балконе.",
          "source": "Tatoeba #6681622 @felix63 / #6684840 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6681622",
          "cefr_level": "A1",
