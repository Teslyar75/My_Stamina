      "gender": null,
      "examples": [
        {
          "id": "10686847",
          "text": "Japanische Sommer sind heiß.",
          "translation": "Лето в Японии жаркое.",
          "source": "Tatoeba #10686847 @Yorwba / #5123887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10686847",
          "cefr_level": "A1",
          "word_slugs": [
            "japanische-name"
          ]
        },
        {
          "id": "851909",
          "text": "Japanische Häuser sind klein.",
          "translation": "У японцев маленькие дома.",
          "source": "Tatoeba #851909 @Esperantostern / #6533047 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/851909",
          "cefr_level": "A1",
          "word_slugs": [
            "japanische-name"
          ]
        },
        {
          "id": "13880148",
          "text": "Hat das Japanische ein Alphabet?",
