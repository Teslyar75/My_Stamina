      "examples": [
        {
          "id": "4201873",
          "text": "Tom küsste Marias Nacken.",
          "translation": "Том поцеловал Мэри в шею.",
          "source": "Tatoeba #4201873 @Ooneykcall / #3008308 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4201873",
          "cefr_level": "A1",
          "word_slugs": [
