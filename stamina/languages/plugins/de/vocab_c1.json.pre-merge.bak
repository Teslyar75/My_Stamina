    {
      "slug": "professionelle-adj",
      "lemma": "professionelle",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9019,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of professionell:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of professionell:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "785295",
          "text": "Sie wurden professionelle Fußballer.",
          "translation": "Они стали профессиональными футболистами.",
          "source": "Tatoeba #785295 @Pfirsichbaeumchen / #2716952 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/785295",
          "cefr_level": "A1",
          "word_slugs": [
            "professionelle-adj"
          ]
        },
        {
          "id": "785294",
          "text": "Sie wurden professionelle Fußballspieler.",
          "translation": "Они стали профессиональными футболистами.",
          "source": "Tatoeba #785294 @Pfirsichbaeumchen / #2716952 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/785294",
          "cefr_level": "A1",
          "word_slugs": [
            "professionelle-adj"
          ]
        },
        {
          "id": "6794494",
          "text": "Tom konnte es sich nicht leisten, professionelle Schauspieler zu engagieren.",
          "translation": "Том не мог себе позволить нанять профессиональных актёров.",
          "source": "Tatoeba #6794494 @Pfirsichbaeumchen / #6805684 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6794494",
          "cefr_level": "A1",
          "word_slugs": [
            "professionelle-adj"
          ]
        },
        {
          "id": "9944988",
          "text": "Sie hatte immer davon geträumt, eine professionelle Schachspielerin zu werden.",
          "translation": "Она всегда мечтала стать профессиональной шахматисткой.",
          "source": "Tatoeba #9944988 @carlosalberto / #9944994 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9944988",
          "cefr_level": "A1",
          "word_slugs": [
            "professionelle-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
