    {
      "slug": "flüstern-verb",
      "lemma": "flüstern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6997,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to whisper"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7919643",
          "text": "Ich habe euch flüstern hören.",
          "translation": "Я слышал, как вы шептались.",
          "source": "Tatoeba #7919643 @Pfirsichbaeumchen / #7919499 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7919643",
          "cefr_level": "A1",
          "word_slugs": [
            "flüstern-verb"
          ]
        },
        {
          "id": "9447469",
          "text": "Ich habe sie flüstern gehört.",
          "translation": "Я слышал, как они шепчутся.",
          "source": "Tatoeba #9447469 @Pfirsichbaeumchen / #5788444 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9447469",
          "cefr_level": "A1",
          "word_slugs": [
            "flüstern-verb"
          ]
        },
        {
          "id": "3765152",
          "text": "Es ist unhöflich, in Gegenwart anderer zu flüstern.",
          "translation": "Это грубо - шептаться в присутствии других людей.",
          "source": "Tatoeba #3765152 @Pfirsichbaeumchen / #4874843 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3765152",
          "cefr_level": "A1",
          "word_slugs": [
            "flüstern-verb"
          ]
        },
        {
          "id": "4009243",
          "text": "Ich habe meine Eltern gestern Nacht flüstern gehört.",
          "translation": "Я слышал, как мои родители шептались прошлой ночью.",
          "source": "Tatoeba #4009243 @pullnosemans / #1417618 @MikaM (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4009243",
          "cefr_level": "A1",
          "word_slugs": [
            "flüstern-verb"
          ]
        },
        {
          "id": "12962380",
          "text": "In der Gegenwart anderer Leute zu flüstern ist unhöflich.",
          "translation": "Шептаться в присутствии других людей невежливо.",
          "source": "Tatoeba #12962380 @mhr / #12962320 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12962380",
          "cefr_level": "A1",
          "word_slugs": [
            "flüstern-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
