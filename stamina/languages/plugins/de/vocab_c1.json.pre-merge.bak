            "münzen-noun"
          ]
        },
        {
          "id": "9159934",
          "text": "Ich sammle ausländische Münzen.",
          "translation": "Я собираю иностранные монеты.",
          "source": "Tatoeba #9159934 @Yorwba / #9139636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9159934",
          "cefr_level": "A1",
          "word_slugs": [
            "münzen-noun"
          ]
        },
        {
          "id": "4105627",
          "text": "Ich habe nur amerikanische Münzen.",
          "translation": "У меня только американские монеты.",
          "source": "Tatoeba #4105627 @Pfirsichbaeumchen / #4106239 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4105627",
          "cefr_level": "A1",
          "word_slugs": [
            "münzen-noun"
          ]
        }
      ],
