      "gender": "n",
      "examples": [
        {
          "id": "824363",
          "text": "Das zweite Semester hat geendet.",
          "translation": "Закончился второй семестр.",
          "source": "Tatoeba #824363 @Espi / #2573322 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/824363",
          "cefr_level": "A1",
          "word_slugs": [
            "semester-noun"
          ]
        },
        {
          "id": "9152455",
          "text": "Das neue Semester hat angefangen.",
          "translation": "Начался новый семестр.",
          "source": "Tatoeba #9152455 @Pfirsichbaeumchen / #9142557 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9152455",
          "cefr_level": "A1",
          "word_slugs": [
            "semester-noun"
          ]
        },
        {
          "id": "6547806",
          "text": "Dieses Semester habe ich Französisch.",
          "translation": "В этом семестре у меня французский.",
          "source": "Tatoeba #6547806 @arved / #2499783 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6547806",
          "cefr_level": "A1",
          "word_slugs": [
            "semester-noun"
          ]
        },
        {
          "id": "5166048",
          "text": "In diesem Semester studiere ich Spanisch.",
          "translation": "В этом семестре я изучаю испанский.",
          "source": "Tatoeba #5166048 @faehrmann / #4310783 @soniamiku (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5166048",
          "cefr_level": "A1",
          "word_slugs": [
            "semester-noun"
          ]
        }
      ],
      "tags": [
