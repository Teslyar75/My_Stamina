    {
      "slug": "videos-noun",
      "lemma": "Videos",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6433,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Video"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8147427",
          "text": "Tom hat bei Youtube alle seine Videos gelöscht.",
          "translation": "Том удалил с ютьюба все свои видео.",
          "source": "Tatoeba #8147427 @Pfirsichbaeumchen / #8151289 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8147427",
          "cefr_level": "A1",
          "word_slugs": [
