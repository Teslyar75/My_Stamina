    {
      "slug": "erfinden-verb",
      "lemma": "erfinden",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6535,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "изобретать"
        ],
        "en": [
          "to invent",
          "to fabricate (something untrue); to make up (a story)",
          "to find out, to discover"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2889054",
          "text": "Wir müssen das Rad nicht neu erfinden.",
          "translation": "Нам не нужно заново изобретать колесо.",
          "source": "Tatoeba #2889054 @al_ex_an_der / #2889042 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2889054",
          "cefr_level": "A1",
          "word_slugs": [
            "erfinden-verb"
          ]
        },
        {
          "id": "11735831",
          "text": "Mann muss nicht immer alles neu erfinden.",
          "translation": "Не обязательно каждый раз изобретать что-то новое.",
          "source": "Tatoeba #11735831 @kotik / #11735834 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11735831",
          "cefr_level": "A1",
          "word_slugs": [
            "erfinden-verb"
          ]
        },
        {
          "id": "943223",
          "text": "Lustige Geschichten zu erfinden ist ihre Stärke.",
          "translation": "Придумывать смешные истории - это ее конек.",
          "source": "Tatoeba #943223 @Miyako / #11877599 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/943223",
          "cefr_level": "A1",
          "word_slugs": [
            "erfinden-verb"
          ]
        },
        {
          "id": "943252",
          "text": "Interessante Geschichten zu erfinden ist ihre Stärke.",
          "translation": "Придумывать интересные истории - это ее конек.",
          "source": "Tatoeba #943252 @Miyako / #11877608 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/943252",
          "cefr_level": "A1",
          "word_slugs": [
            "erfinden-verb"
          ]
        },
        {
          "id": "13996255",
          "text": "Man braucht das Rad nicht neu zu erfinden.",
          "translation": "Не нужно заново изобретать колесо.",
          "source": "Tatoeba #13996255 @mhr / #13996047 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13996255",
          "cefr_level": "A1",
