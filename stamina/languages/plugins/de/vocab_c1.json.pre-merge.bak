    {
      "slug": "hässliche-adj",
      "lemma": "hässliche",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6765,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of hässlich:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of hässlich:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5205000",
          "text": "Das hässliche Entlein wurde ein schöner Schwan.",
          "translation": "Гадкий утёнок стал прекрасным лебедем.",
          "source": "Tatoeba #5205000 @faehrmann / #636040 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5205000",
          "cefr_level": "A1",
          "word_slugs": [
            "hässliche-adj"
          ]
        },
        {
          "id": "3179613",
          "text": "Hast du schon einmal eine hässliche Katze gesehen?",
          "translation": "Ты когда-нибудь видел некрасивую кошку?",
          "source": "Tatoeba #3179613 @Pfirsichbaeumchen / #3164664 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3179613",
          "cefr_level": "A1",
          "word_slugs": [
            "hässliche-adj"
          ]
        },
        {
          "id": "1783113",
          "text": "Stimmt es, dass es schöne und hässliche Sprachen gibt?",
          "translation": "Это правда, что есть красивые и некрасивые языки?",
          "source": "Tatoeba #1783113 @Pfirsichbaeumchen / #5044911 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1783113",
          "cefr_level": "A1",
          "word_slugs": [
            "hässliche-adj"
          ]
        },
        {
          "id": "10002446",
          "text": "Ach schau! Das hässliche Mädchen ist ein Schmetterling geworden.",
          "translation": "Гляди-ка! Девчонка-уродина стала бабочкой.",
          "source": "Tatoeba #10002446 @maaster / #10002927 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10002446",
          "cefr_level": "A1",
          "word_slugs": [
            "hässliche-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
