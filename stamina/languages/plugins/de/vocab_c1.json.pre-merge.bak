    {
      "slug": "irrst-verb",
      "lemma": "irrst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5627,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of irren"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "594371",
          "text": "Du irrst dich.",
          "translation": "Ошибаешься.",
          "source": "Tatoeba #594371 @samueldora / #5887275 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/594371",
          "cefr_level": "A1",
          "word_slugs": [
            "irrst-verb"
          ]
        },
        {
          "id": "3800177",
          "text": "Und da irrst du.",
          "translation": "Вот где ты ошибаешься.",
          "source": "Tatoeba #3800177 @Pfirsichbaeumchen / #422412 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3800177",
          "cefr_level": "A1",
          "word_slugs": [
            "irrst-verb"
          ]
        },
        {
          "id": "1562252",
          "text": "Genau da irrst du.",
          "translation": "Тут-то ты и ошибаешься.",
          "source": "Tatoeba #1562252 @Okidokay / #4957333 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1562252",
          "cefr_level": "A1",
          "word_slugs": [
            "irrst-verb"
          ]
        },
        {
          "id": "1685078",
          "text": "Mir scheint, du irrst dich.",
          "translation": "Мне кажется, ты неправ.",
          "source": "Tatoeba #1685078 @Zaghawa / #470883 @Gruzilkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1685078",
          "cefr_level": "A1",
          "word_slugs": [
            "irrst-verb"
          ]
        },
        {
          "id": "11817408",
          "text": "Ich denke, dass du dich irrst.",
          "translation": "Я думаю, ты ошибаешься.",
          "source": "Tatoeba #11817408 @Pfirsichbaeumchen / #2718185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11817408",
          "cefr_level": "A1",
          "word_slugs": [
            "irrst-verb"
          ]
        }
      ],
