    {
      "slug": "dom-noun",
      "lemma": "Dom",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7776,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "собор"
        ],
        "en": [
          "cathedral (church serving as seat of a bishop, by extension, any large church)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13734469",
          "text": "Hattet ihr Zeit, den Dom zu besuchen?",
          "translation": "Вы успели посетить собор?",
          "source": "Tatoeba #13734469 @Ioan_Cristian / #13734481 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13734469",
          "cefr_level": "A1",
          "word_slugs": [
            "dom-noun"
          ]
        },
        {
          "id": "13934672",
          "text": "Der Trierer Dom wurde im Zweiten Weltkrieg beschädigt.",
          "translation": "Трирский собор был повреждён во время Второй мировой войны.",
          "source": "Tatoeba #13934672 @Ioan_Cristian / #13957500 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13934672",
          "cefr_level": "A1",
          "word_slugs": [
            "dom-noun"
          ]
        },
        {
          "id": "13934526",
          "text": "Der Trierer Dom wurde nach dem Zweiten Weltkrieg wiederhergestellt.",
          "translation": "После Второй мировой войны Трирский собор был восстановлен.",
          "source": "Tatoeba #13934526 @Ioan_Cristian / #13957514 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13934526",
          "cefr_level": "A1",
          "word_slugs": [
            "dom-noun"
          ]
        },
        {
          "id": "4253114",
          "text": "Auf dem Weg nach Bonn haben wir noch den Kölner Dom mitgenommen.",
          "translation": "По дороге в Бонн мы заглянули ещё в Кёльнский собор.",
          "source": "Tatoeba #4253114 @raggione / #4253580 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4253114",
          "cefr_level": "A1",
          "word_slugs": [
            "dom-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Dom",
        "nominative_pl": ""
      }
    },
