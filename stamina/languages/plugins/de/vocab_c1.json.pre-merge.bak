    {
      "slug": "begreife-verb",
      "lemma": "begreife",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8547,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of begreifen:",
          "first-person singular present",
          "inflection of begreifen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "845616",
          "text": "Ich begreife nicht, was der Lehrer sagt.",
          "translation": "Я не понимаю, что говорит учитель.",
          "source": "Tatoeba #845616 @Zaghawa / #4434307 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/845616",
          "cefr_level": "A1",
          "word_slugs": [
            "begreife-verb"
          ]
        },
        {
          "id": "8053093",
          "text": "Ich begreife langsam, dass es unmöglich ist.",
          "translation": "Я начинаю постепенно понимать, что это невозможно.",
          "source": "Tatoeba #8053093 @raggione / #8053420 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8053093",
          "cefr_level": "A1",
          "word_slugs": [
            "begreife-verb"
          ]
        },
        {
          "id": "842165",
          "text": "Ich begreife nicht, was der Lehrer gesagt hat.",
          "translation": "Я не понимаю, что сказал учитель.",
          "source": "Tatoeba #842165 @Espi / #2723724 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/842165",
          "cefr_level": "A1",
          "word_slugs": [
            "begreife-verb"
          ]
        },
        {
          "id": "2486703",
          "text": "Ich begreife nicht, wie sie das gemacht hat. Das war ein Wunder.",
          "translation": "Я не понимаю, как она это сделала. Это было чудо.",
          "source": "Tatoeba #2486703 @al_ex_an_der / #2486660 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2486703",
          "cefr_level": "A1",
          "word_slugs": [
            "begreife-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
