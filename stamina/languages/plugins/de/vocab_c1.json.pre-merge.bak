          "inflection of melden:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12585783",
          "text": "Ein Schüler meldete sich.",
          "translation": "Один ученик поднял руку.",
          "source": "Tatoeba #12585783 @Pfirsichbaeumchen / #12587143 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12585783",
          "cefr_level": "A1",
          "word_slugs": [
            "meldete-verb"
          ]
        },
        {
          "id": "4942785",
          "text": "Ich meldete mich freiwillig.",
          "translation": "Я вызвалась добровольцем.",
          "source": "Tatoeba #4942785 @Hans_Adler / #12965580 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4942785",
          "cefr_level": "A1",
          "word_slugs": [
            "meldete-verb"
          ]
        },
        {
          "id": "12579714",
          "text": "Eine Schülerin meldete sich.",
          "translation": "Одна ученица подняла руку.",
          "source": "Tatoeba #12579714 @Pfirsichbaeumchen / #12587144 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12579714",
          "cefr_level": "A1",
          "word_slugs": [
            "meldete-verb"
          ]
        },
        {
          "id": "6144347",
          "text": "Einer der Schüler meldete sich.",
          "translation": "Один из учеников поднял руку.",
          "source": "Tatoeba #6144347 @Pfirsichbaeumchen / #6144291 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6144347",
          "cefr_level": "A1",
          "word_slugs": [
            "meldete-verb"
          ]
        },
        {
          "id": "12585364",
          "text": "Eine der Schülerinnen meldete sich.",
          "translation": "Одна из учениц подняла руку.",
          "source": "Tatoeba #12585364 @mhr / #12585507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12585364",
          "cefr_level": "A1",
          "word_slugs": [
            "meldete-verb"
          ]
        }
      ],
