    {
      "slug": "verpasse-verb",
      "lemma": "verpasse",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8336,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verpassen:",
          "first-person singular present",
          "inflection of verpassen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5079761",
          "text": "Verpasse nicht diese Gelegenheit.",
          "translation": "Не упусти эту возможность.",
          "source": "Tatoeba #5079761 @Juri / #5082004 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5079761",
          "cefr_level": "A1",
          "word_slugs": [
            "verpasse-verb"
          ]
        },
        {
          "id": "401091",
          "text": "Verpasse nicht eine günstige Gelegenheit.",
          "translation": "Не упускай хорошую возможность.",
          "source": "Tatoeba #401091 @xtofu80 / #3551802 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/401091",
          "cefr_level": "A1",
          "word_slugs": [
            "verpasse-verb"
          ]
        },
        {
          "id": "3641529",
          "text": "Ich verpasse keine Chance, eine Chance zu verpassen.",
          "translation": "Я никогда не упускаю шанс упустить шанс.",
          "source": "Tatoeba #3641529 @al_ex_an_der / #3641522 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3641529",
          "cefr_level": "A1",
          "word_slugs": [
            "verpasse-verb"
          ]
        },
        {
          "id": "13524406",
          "text": "Ich schlafe im Bus oft ein und verpasse meine Haltestelle.",
          "translation": "Я часто засыпаю в автобусе и пропускаю свою остановку.",
          "source": "Tatoeba #13524406 @mhr / #13524092 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13524406",
          "cefr_level": "A1",
          "word_slugs": [
            "verpasse-verb"
          ]
        },
        {
          "id": "13524407",
          "text": "Ich schlafe im Bus oft ein und verpasse dann meine Haltestelle.",
          "translation": "Я часто засыпаю в автобусе и пропускаю свою остановку.",
          "source": "Tatoeba #13524407 @mhr / #13524092 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13524407",
          "cefr_level": "A1",
          "word_slugs": [
            "verpasse-verb"
          ]
        }
      ],
      "tags": [
