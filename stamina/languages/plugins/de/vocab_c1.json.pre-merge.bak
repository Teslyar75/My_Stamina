    {
      "slug": "steige-verb",
      "lemma": "steige",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6450,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of steigen:",
          "first-person singular present",
          "inflection of steigen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "949247",
          "text": "Ich steige hier aus.",
          "translation": "Я здесь выхожу.",
          "source": "Tatoeba #949247 @Sudajaengi / #3180163 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/949247",
          "cefr_level": "A1",
          "word_slugs": [
            "steige-verb"
          ]
        },
        {
          "id": "13742852",
          "text": "Ich steige ins Flugzeug.",
          "translation": "Я сажусь в самолёт.",
          "source": "Tatoeba #13742852 @mhr / #13742754 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13742852",
          "cefr_level": "A1",
          "word_slugs": [
            "steige-verb"
          ]
        },
        {
          "id": "2625253",
          "text": "Ja, ich steige hier um.",
          "translation": "Да, я выхожу здесь.",
          "source": "Tatoeba #2625253 @Olya / #2625254 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2625253",
          "cefr_level": "A1",
          "word_slugs": [
            "steige-verb"
          ]
        },
        {
          "id": "13742912",
          "text": "Ich steige aus dem Auto.",
          "translation": "Я выхожу из машины.",
          "source": "Tatoeba #13742912 @mhr / #13742749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13742912",
          "cefr_level": "A1",
          "word_slugs": [
            "steige-verb"
          ]
        },
        {
          "id": "396245",
          "text": "Ich steige auch dort aus.",
          "translation": "Я тоже там выхожу.",
          "source": "Tatoeba #396245 @xtofu80 / #13706439 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/396245",
          "cefr_level": "A1",
          "word_slugs": [
            "steige-verb"
          ]
        }
      ],
