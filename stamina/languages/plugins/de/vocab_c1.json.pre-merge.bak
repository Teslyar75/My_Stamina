    {
      "slug": "angestellten-noun",
      "lemma": "Angestellten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5266,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Angestellter:",
          "strong genitive/accusative singular",
          "inflection of Angestellter:",
          "strong dative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2678311",
          "text": "Ich will kein Unternehmen mit mehr als dreißig Angestellten führen.",
          "translation": "Я не хочу управлять компанией с более чем тридцатью сотрудниками.",
          "source": "Tatoeba #2678311 @al_ex_an_der / #2678309 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2678311",
          "cefr_level": "A1",
          "word_slugs": [
            "angestellten-noun"
          ]
        },
        {
          "id": "368742",
          "text": "Die Belange der Angestellten sind eng mit den Belangen der Firma verknüpft.",
          "translation": "Интересы сотрудников тесно связаны с интересами фирмы.",
          "source": "Tatoeba #368742 @xtofu80 / #8067379 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/368742",
          "cefr_level": "A1",
          "word_slugs": [
            "angestellten-noun"
          ]
        }
      ],
