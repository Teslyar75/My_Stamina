    {
      "slug": "mithilfe-prep",
      "lemma": "mithilfe",
      "pos": "prep",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9929,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "с помощью"
        ],
        "en": [
          "by means of, with"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13835519",
          "text": "Taubstumme kommunizieren mithilfe der Gebärdensprache.",
          "translation": "Глухонемые общаются с помощью жестового языка.",
          "source": "Tatoeba #13835519 @mhr / #13835463 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13835519",
          "cefr_level": "A1",
          "word_slugs": [
            "mithilfe-prep"
          ]
        },
        {
          "id": "13019286",
          "text": "Er übertrug die Zeichnung mithilfe von Pauspapier.",
          "translation": "Он перевёл рисунок через кальку.",
          "source": "Tatoeba #13019286 @mhr / #13019227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13019286",
          "cefr_level": "A1",
          "word_slugs": [
            "mithilfe-prep"
          ]
        },
        {
          "id": "13019285",
          "text": "Er übertrug die Zeichnung mithilfe von Transparentpapier.",
          "translation": "Он перевёл рисунок через кальку.",
          "source": "Tatoeba #13019285 @mhr / #13019227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13019285",
          "cefr_level": "A1",
          "word_slugs": [
            "mithilfe-prep"
          ]
        },
        {
          "id": "13019287",
          "text": "Er pauste die Zeichnung mithilfe von Pauspapier ab.",
          "translation": "Он перевёл рисунок через кальку.",
          "source": "Tatoeba #13019287 @mhr / #13019227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13019287",
          "cefr_level": "A1",
          "word_slugs": [
            "mithilfe-prep"
          ]
        },
        {
          "id": "13019288",
          "text": "Er hat die Zeichnung mithilfe von Pauspapier abgepaust.",
          "translation": "Он перевёл рисунок через кальку.",
          "source": "Tatoeba #13019288 @mhr / #13019227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13019288",
          "cefr_level": "A1",
          "word_slugs": [
            "mithilfe-prep"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
