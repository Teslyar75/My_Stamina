    {
      "slug": "anker-noun",
      "lemma": "Anker",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8269,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "а́нкер"
        ],
        "en": [
          "anchor"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6826417",
          "text": "Tom warf den Anker über Bord.",
          "translation": "Том бросил якорь через борт.",
          "source": "Tatoeba #6826417 @raggione / #6826568 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6826417",
          "cefr_level": "A1",
          "word_slugs": [
            "anker-noun"
          ]
        },
        {
          "id": "8631824",
          "text": "Zahlreiche Boote lagen in der Bucht vor Anker.",
          "translation": "На якоре в бухте стояло множество лодок.",
          "source": "Tatoeba #8631824 @Melang / #8632420 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8631824",
          "cefr_level": "A1",
          "word_slugs": [
            "anker-noun"
          ]
        },
        {
          "id": "1219398",
          "text": "Das Schiff lichtet den Anker, und die Reise beginnt.",
          "translation": "Корабль поднимает якорь, и путешествие начинается.",
          "source": "Tatoeba #1219398 @PeterR / #8254357 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1219398",
          "cefr_level": "A1",
          "word_slugs": [
            "anker-noun"
          ]
        },
        {
          "id": "6826423",
          "text": "Das Schiff ging im Hafen vor Anker und löschte seine Ladung.",
          "translation": "Корабль бросил якорь в порту и выгрузил товары.",
          "source": "Tatoeba #6826423 @raggione / #6826573 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6826423",
          "cefr_level": "A1",
          "word_slugs": [
            "anker-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
