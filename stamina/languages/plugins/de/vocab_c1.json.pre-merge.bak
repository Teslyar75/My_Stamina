          ]
        },
        {
          "id": "4922872",
          "text": "Der Tisch ist gedeckt mit allerlei Obst.",
          "translation": "Стол накрыт всевозможными фруктами.",
          "source": "Tatoeba #4922872 @al_ex_an_der / #13657354 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4922872",
          "cefr_level": "A1",
          "word_slugs": [
