        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2630711",
          "text": "Alle mochten Tom.",
          "translation": "Всем нравился Том.",
          "source": "Tatoeba #2630711 @Pfirsichbaeumchen / #2611191 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2630711",
          "cefr_level": "A1",
          "word_slugs": [
            "mochten-verb"
          ]
        },
        {
          "id": "11514884",
          "text": "Die mochten Tom nicht.",
          "translation": "Том им не нравился.",
          "source": "Tatoeba #11514884 @Pfirsichbaeumchen / #3629831 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11514884",
          "cefr_level": "A1",
          "word_slugs": [
            "mochten-verb"
          ]
        },
        {
          "id": "4778678",
          "text": "Wir mochten dieses Spiel.",
