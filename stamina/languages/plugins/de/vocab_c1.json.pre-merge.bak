          "table (raised dinner table or elevated long table, e.g., one at a banquet)",
          "slab, tablet",
          "plaque"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "11209557",
          "text": "Geht an die Tafel!",
          "translation": "Идите к доске.",
          "source": "Tatoeba #11209557 @felix63 / #11262933 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11209557",
          "cefr_level": "A1",
