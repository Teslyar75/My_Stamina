      },
      "gender": null,
      "examples": [
        {
          "id": "604771",
          "text": "Such in den gelben Seiten!",
          "translation": "Поищи в \"жёлтых страницах\".",
          "source": "Tatoeba #604771 @Manfredo / #3008310 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/604771",
          "cefr_level": "A1",
          "word_slugs": [
            "gelben-adj"
          ]
        },
        {
          "id": "7158199",
          "text": "Es gibt auch einen gelben.",
          "translation": "Есть ещё такой жёлтый.",
          "source": "Tatoeba #7158199 @Luiaard / #7912961 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7158199",
          "cefr_level": "A1",
          "word_slugs": [
            "gelben-adj"
          ]
        },
        {
          "id": "1275765",
          "text": "Suche auf den gelben Seiten!",
          "translation": "Поищи в \"жёлтых страницах\".",
          "source": "Tatoeba #1275765 @jakov / #3008310 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1275765",
          "cefr_level": "A1",
          "word_slugs": [
            "gelben-adj"
          ]
        },
        {
          "id": "4468199",
          "text": "Iss nicht den gelben Schnee.",
          "translation": "Не ешь жёлтый снег.",
          "source": "Tatoeba #4468199 @Vortarulo / #4864851 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4468199",
          "cefr_level": "A1",
          "word_slugs": [
            "gelben-adj"
          ]
        },
        {
          "id": "4468201",
          "text": "Nicht den gelben Schnee essen.",
          "translation": "Не ешь жёлтый снег.",
          "source": "Tatoeba #4468201 @Vortarulo / #4864851 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4468201",
          "cefr_level": "A1",
          "word_slugs": [
            "gelben-adj"
          ]
        }
      ],
      "tags": [
