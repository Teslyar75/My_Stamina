        ],
        "en": [
          "to joke; to jest; to frolic"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11984947",
          "text": "Ich war mir sicher, dass Sie scherzen.",
          "translation": "Я был уверен, что вы шутите.",
          "source": "Tatoeba #11984947 @Pfirsichbaeumchen / #11984878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11984947",
          "cefr_level": "A1",
          "word_slugs": [
            "scherzen-verb"
          ]
        },
        {
          "id": "9077081",
          "text": "Ich kann nie sagen, ob Sie scherzen oder es ernst meinen.",
          "translation": "Я никогда не могу понять, шутите вы или говорите серьёзно.",
          "source": "Tatoeba #9077081 @carlosalberto / #9077018 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9077081",
          "cefr_level": "A1",
          "word_slugs": [
