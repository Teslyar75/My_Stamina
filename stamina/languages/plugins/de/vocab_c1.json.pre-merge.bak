    {
      "slug": "tagelang-adj",
      "lemma": "tagelang",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9414,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "lasting for days"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6689591",
          "text": "Ich habe tagelang nichts gegessen.",
          "translation": "Я несколько дней ничего не ел.",
          "source": "Tatoeba #6689591 @Esperantostern / #9231141 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6689591",
          "cefr_level": "A1",
          "word_slugs": [
            "tagelang-adj"
          ]
        },
        {
          "id": "1794364",
          "text": "Es schneite tagelang ohne Unterbrechung.",
          "translation": "Снег шёл несколько дней без остановки.",
          "source": "Tatoeba #1794364 @Tamy / #13671276 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1794364",
          "cefr_level": "A1",
          "word_slugs": [
            "tagelang-adj"
          ]
        },
        {
          "id": "2707757",
          "text": "Sie gingen sich tagelang aus dem Weg.",
          "translation": "Несколько дней они избегали друг друга.",
          "source": "Tatoeba #2707757 @Pfirsichbaeumchen / #1863388 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2707757",
          "cefr_level": "A1",
          "word_slugs": [
            "tagelang-adj"
          ]
        },
        {
          "id": "2707756",
          "text": "Sie gingen einander tagelang aus dem Weg.",
          "translation": "Несколько дней они избегали друг друга.",
          "source": "Tatoeba #2707756 @Pfirsichbaeumchen / #1863388 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2707756",
          "cefr_level": "A1",
          "word_slugs": [
            "tagelang-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der tagelang",
        "nominative_pl": ""
      }
