    {
      "slug": "pflichten-noun",
      "lemma": "Pflichten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5978,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of pflichten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2289334",
          "text": "Wie lauten deine Pflichten?",
          "translation": "Каковы твои обязанности?",
          "source": "Tatoeba #2289334 @Pfirsichbaeumchen / #6879871 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2289334",
          "cefr_level": "A1",
          "word_slugs": [
            "pflichten-noun"
          ]
        },
        {
          "id": "13483170",
          "text": "Du musst seine Pflichten erfüllen.",
          "translation": "Ты должен исполнять его обязанности.",
          "source": "Tatoeba #13483170 @mhr / #13483165 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13483170",
          "cefr_level": "A1",
          "word_slugs": [
            "pflichten-noun"
          ]
        },
        {
          "id": "535074",
          "text": "Er hat seine Pflichten vernachlässigt.",
          "translation": "Он забросил свои обязанности.",
          "source": "Tatoeba #535074 @xtofu80 / #1577862 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/535074",
          "cefr_level": "A1",
          "word_slugs": [
            "pflichten-noun"
          ]
        },
        {
          "id": "12788266",
          "text": "Vergesst nicht, dass ihr außer Rechten auch Pflichten habt.",
          "translation": "Не забывайте, что кроме прав у вас есть и обязанности.",
          "source": "Tatoeba #12788266 @mhr / #12787940 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12788266",
          "cefr_level": "A1",
          "word_slugs": [
            "pflichten-noun"
          ]
        },
        {
          "id": "12788268",
          "text": "Vergesst nicht, dass ihr neben Rechten auch Pflichten habt.",
          "translation": "Не забывайте, что кроме прав у вас есть и обязанности.",
          "source": "Tatoeba #12788268 @mhr / #12787940 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12788268",
          "cefr_level": "A1",
          "word_slugs": [
            "pflichten-noun"
          ]
        }
      ],
