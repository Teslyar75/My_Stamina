    {
      "slug": "lehren-verb",
      "lemma": "lehren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5196,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "учить"
        ],
        "en": [
          "to teach (a class, a subject); to be a teacher",
          "to teach"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2669100",
          "text": "Die Lehrer lehren.",
          "translation": "Учителя учат.",
          "source": "Tatoeba #2669100 @Pfirsichbaeumchen / #2677798 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2669100",
          "cefr_level": "A1",
          "word_slugs": [
            "lehren-verb"
          ]
        },
        {
          "id": "1743806",
          "text": "Ich kann dich etwas lehren.",
          "translation": "Я могу тебя кое-чему научить.",
          "source": "Tatoeba #1743806 @Pfirsichbaeumchen / #2768430 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1743806",
          "cefr_level": "A1",
          "word_slugs": [
            "lehren-verb"
          ]
        },
        {
          "id": "631425",
          "text": "Kannst du mich lehren zu stehlen?",
          "translation": "Можешь научить меня воровать?",
          "source": "Tatoeba #631425 @kolonjano / #2524296 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/631425",
          "cefr_level": "A1",
          "word_slugs": [
            "lehren-verb"
          ]
        },
        {
          "id": "2924789",
          "text": "Man muss Kinder das Teilen lehren.",
          "translation": "Нужно детей учить делиться.",
          "source": "Tatoeba #2924789 @Pfirsichbaeumchen / #2927662 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2924789",
          "cefr_level": "A1",
          "word_slugs": [
            "lehren-verb"
          ]
        },
        {
          "id": "8656323",
          "text": "Manchmal lehren wir und manchmal lernen wir.",
          "translation": "Иногда мы учим, а иногда сами учимся.",
          "source": "Tatoeba #8656323 @Melang / #4830310 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8656323",
          "cefr_level": "A1",
          "word_slugs": [
            "lehren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
