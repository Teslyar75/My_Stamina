      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Sonntag"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10053677",
          "text": "Sonntags arbeite ich nicht.",
          "translation": "Я по воскресеньям не работаю.",
          "source": "Tatoeba #10053677 @wolfgangth / #7675428 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10053677",
          "cefr_level": "A1",
          "word_slugs": [
            "sonntags-noun"
          ]
        },
        {
          "id": "9552354",
          "text": "Sonntags schlafe ich länger.",
          "translation": "По воскресеньям я сплю дольше.",
          "source": "Tatoeba #9552354 @felix63 / #10188303 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9552354",
          "cefr_level": "A1",
          "word_slugs": [
            "sonntags-noun"
          ]
        },
        {
          "id": "6377248",
          "text": "Sonntags sind wir zu Hause.",
          "translation": "По воскресеньям мы дома.",
          "source": "Tatoeba #6377248 @raggione / #6377294 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6377248",
          "cefr_level": "A1",
          "word_slugs": [
            "sonntags-noun"
          ]
        },
        {
          "id": "1796612",
          "text": "Sonntags bin ich nie zuhause.",
          "translation": "В воскресенье меня никогда не бывает дома.",
          "source": "Tatoeba #1796612 @Tamy / #2832285 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1796612",
          "cefr_level": "A1",
          "word_slugs": [
            "sonntags-noun"
          ]
        },
        {
          "id": "818791",
          "text": "Sonntags ist er immer zuhause.",
          "translation": "Он всегда у себя по воскресеньям.",
          "source": "Tatoeba #818791 @Manfredo / #727898 @ivanov (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/818791",
          "cefr_level": "A1",
          "word_slugs": [
            "sonntags-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
