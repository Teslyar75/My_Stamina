        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3402758",
          "text": "Der Server ist ausgefallen.",
          "translation": "Сервер упал.",
          "source": "Tatoeba #3402758 @Pfirsichbaeumchen / #899453 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3402758",
          "cefr_level": "A1",
