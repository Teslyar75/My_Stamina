    {
      "slug": "flieger-noun",
      "lemma": "Flieger",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5041,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "пилот",
          "лётчик",
          "самолёт"
        ],
        "en": [
          "aeroplane, airplane"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "636467",
          "text": "Der Flieger landete sicher.",
          "translation": "Самолёт благополучно приземлился.",
          "source": "Tatoeba #636467 @Manfredo / #6479326 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/636467",
          "cefr_level": "A1",
          "word_slugs": [
            "flieger-noun"
          ]
        },
        {
          "id": "608665",
          "text": "Unser Flieger hatte ungefähr dreißig Minuten Verspätung.",
          "translation": "Наш самолёт минут на тридцать опаздывал.",
          "source": "Tatoeba #608665 @virgil / #9010506 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/608665",
          "cefr_level": "A1",
          "word_slugs": [
            "flieger-noun"
          ]
        },
        {
          "id": "608432",
          "text": "Sein Flieger ist noch nicht am Flughafen angekommen.",
          "translation": "Его самолет ещё не прибыл в аэропорт.",
          "source": "Tatoeba #608432 @virgil / #1536093 @Anne_Paen (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/608432",
          "cefr_level": "A1",
          "word_slugs": [
            "flieger-noun"
          ]
        },
        {
          "id": "5984441",
          "text": "Ich fahre nicht mit dem Zug nach Berlin, sondern nehme einen Flieger.",
          "translation": "Я в Берлин не поездом еду, а лечу самолётом.",
          "source": "Tatoeba #5984441 @Pfirsichbaeumchen / #5534052 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5984441",
          "cefr_level": "A1",
          "word_slugs": [
            "flieger-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Flieger",
        "nominative_pl": ""
      }
