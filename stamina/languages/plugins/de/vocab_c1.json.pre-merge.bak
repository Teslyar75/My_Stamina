    {
      "slug": "bislang-adv",
      "lemma": "bislang",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8519,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "до сих пор"
        ],
        "en": [
          "so far, hitherto, until now"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13451086",
          "text": "Bislang ist das nur eine Hypothese.",
          "translation": "Пока что это только гипотеза.",
          "source": "Tatoeba #13451086 @mhr / #13450913 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13451086",
          "cefr_level": "A1",
          "word_slugs": [
            "bislang-adv"
          ]
        },
        {
          "id": "4448375",
          "text": "Bislang habe ich es niemandem gesagt.",
          "translation": "Я пока никому не сказал.",
          "source": "Tatoeba #4448375 @Pfirsichbaeumchen / #3110331 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4448375",
          "cefr_level": "A1",
          "word_slugs": [
            "bislang-adv"
          ]
        },
        {
          "id": "13910173",
          "text": "All dies ist bislang nur in Planung.",
          "translation": "Всё это пока только в планах.",
          "source": "Tatoeba #13910173 @mhr / #13910072 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13910173",
          "cefr_level": "A1",
          "word_slugs": [
            "bislang-adv"
          ]
        },
        {
          "id": "12598987",
          "text": "Bislang habe ich über neun Länder besucht.",
          "translation": "Пока что я посетил больше девяти стран.",
          "source": "Tatoeba #12598987 @Waldelfe / #12598675 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12598987",
          "cefr_level": "A1",
          "word_slugs": [
            "bislang-adv"
          ]
        },
        {
          "id": "10967406",
          "text": "Bislang hat unser Team alle Spiele gewonnen.",
          "translation": "Пока что наша команда выигрывала все игры.",
          "source": "Tatoeba #10967406 @p0wcr / #10968856 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967406",
          "cefr_level": "A1",
          "word_slugs": [
            "bislang-adv"
          ]
        }
      ],
