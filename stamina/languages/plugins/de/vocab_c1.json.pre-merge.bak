    {
      "slug": "prinzipien-noun",
      "lemma": "Prinzipien",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7451,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Prinzip"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "450626",
          "text": "Er hat feste Prinzipien.",
          "translation": "У него твёрдые принципы.",
          "source": "Tatoeba #450626 @Pfirsichbaeumchen / #4559193 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/450626",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzipien-noun"
          ]
        },
        {
          "id": "5149772",
          "text": "Tom hat keine Prinzipien.",
          "translation": "У Тома нет принципов.",
          "source": "Tatoeba #5149772 @raggione / #8992445 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5149772",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzipien-noun"
          ]
        },
        {
          "id": "3579719",
          "text": "Das ist gegen meine Prinzipien.",
          "translation": "Это против моих принципов.",
          "source": "Tatoeba #3579719 @Esperantostern / #2736737 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3579719",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzipien-noun"
          ]
        },
        {
          "id": "362746",
          "text": "Das geht gegen meine Prinzipien.",
          "translation": "Это противоречит моим принципам.",
          "source": "Tatoeba #362746 @Wolf / #2149667 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/362746",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzipien-noun"
          ]
        },
        {
          "id": "8990542",
          "text": "Im Leben muss man Prinzipien haben.",
          "translation": "В жизни надо иметь принципы.",
          "source": "Tatoeba #8990542 @Adelpa / #8992444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8990542",
          "cefr_level": "A1",
          "word_slugs": [
            "prinzipien-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
