    {
      "slug": "probiere-verb",
      "lemma": "probiere",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9754,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of probieren:",
          "first-person singular present",
          "inflection of probieren:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13881060",
          "text": "Probiere neue Dinge aus!",
          "translation": "Пробуй новое!",
          "source": "Tatoeba #13881060 @Biderl / #13881073 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13881060",
          "cefr_level": "A1",
          "word_slugs": [
            "probiere-verb"
          ]
        },
        {
          "id": "643559",
          "text": "Probiere einmal diese Soße.",
          "translation": "Попробуй этот соус.",
          "source": "Tatoeba #643559 @Pfirsichbaeumchen / #446858 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/643559",
          "cefr_level": "A1",
          "word_slugs": [
            "probiere-verb"
          ]
        },
        {
          "id": "1551129",
          "text": "Ich probiere, dieses Problem zu lösen.",
          "translation": "Я пытаюсь решить эту проблему.",
          "source": "Tatoeba #1551129 @Zaghawa / #2369922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1551129",
          "cefr_level": "A1",
          "word_slugs": [
            "probiere-verb"
          ]
        },
        {
          "id": "5347906",
          "text": "Morgen probiere ich mal, aus schwarzen Johannisbeeren Likör herzustellen.",
          "translation": "Завтра попробую приготовить ликер из черной смородины.",
          "source": "Tatoeba #5347906 @Pfirsichbaeumchen / #5346465 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5347906",
          "cefr_level": "A1",
          "word_slugs": [
            "probiere-verb"
          ]
        }
      ],
      "tags": [
