    {
      "slug": "ehrlichkeit-noun",
      "lemma": "Ehrlichkeit",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6807,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "честность"
        ],
        "en": [
          "honesty"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "11836428",
          "text": "Danke für die Ehrlichkeit!",
          "translation": "Спасибо за честность.",
          "source": "Tatoeba #11836428 @Pfirsichbaeumchen / #3993251 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11836428",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrlichkeit-noun"
          ]
        },
        {
          "id": "3803089",
          "text": "Ihre Ehrlichkeit ist fragwürdig.",
          "translation": "Их честность вызывает сомнения.",
          "source": "Tatoeba #3803089 @Tickler / #13622069 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3803089",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrlichkeit-noun"
          ]
        },
        {
          "id": "2817303",
          "text": "Ich bin von seiner Ehrlichkeit überzeugt.",
          "translation": "Я уверен в его честности.",
          "source": "Tatoeba #2817303 @Pfirsichbaeumchen / #655763 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2817303",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrlichkeit-noun"
          ]
        },
        {
          "id": "5724761",
          "text": "Er lobte das Mädchen für ihre Ehrlichkeit.",
          "translation": "Он похвалил девочку за честность.",
          "source": "Tatoeba #5724761 @Pfirsichbaeumchen / #542102 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5724761",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrlichkeit-noun"
          ]
        },
        {
          "id": "5257792",
          "text": "Er lobte den Schüler für seine Ehrlichkeit.",
          "translation": "Он похвалил ученика за честность.",
          "source": "Tatoeba #5257792 @Pfirsichbaeumchen / #5931091 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5257792",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrlichkeit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Ehrlichkeit",
        "nominative_pl": ""
      }
