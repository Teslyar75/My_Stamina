    {
      "slug": "hamburg-name",
      "lemma": "Hamburg",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8408,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Hamburg (the second-largest city in and simultaneously a state of Germany)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6910234",
          "text": "Ich war in Hamburg.",
          "translation": "Я был в Гамбурге.",
          "source": "Tatoeba #6910234 @ruth_tatoeba / #6973109 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6910234",
          "cefr_level": "A1",
          "word_slugs": [
            "hamburg-name"
          ]
        },
        {
          "id": "866652",
          "text": "Hamburg liegt an der Elbe.",
          "translation": "Гамбург расположен на реке Эльба.",
          "source": "Tatoeba #866652 @Esperantostern / #4676683 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/866652",
          "cefr_level": "A1",
          "word_slugs": [
            "hamburg-name"
          ]
        },
        {
          "id": "7004032",
          "text": "Tom ist nach Hamburg gefahren.",
          "translation": "Том поехал в Гамбург.",
          "source": "Tatoeba #7004032 @felix63 / #10720319 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7004032",
          "cefr_level": "A1",
          "word_slugs": [
            "hamburg-name"
          ]
        },
        {
          "id": "9525091",
          "text": "In Hamburg muss ich umsteigen.",
          "translation": "Мне надо сделать пересадку в Гамбурге.",
          "source": "Tatoeba #9525091 @Taam / #9527549 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9525091",
          "cefr_level": "A1",
          "word_slugs": [
            "hamburg-name"
          ]
        },
        {
          "id": "12231498",
          "text": "Morgen fahre ich nach Hamburg.",
          "translation": "Завтра я еду в Гамбург.",
          "source": "Tatoeba #12231498 @Pfirsichbaeumchen / #12231502 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12231498",
          "cefr_level": "A1",
          "word_slugs": [
            "hamburg-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
