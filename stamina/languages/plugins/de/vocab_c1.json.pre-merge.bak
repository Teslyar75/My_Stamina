    {
      "slug": "dezember-noun",
      "lemma": "Dezember",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5394,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "December (the twelfth and last month of the Gregorian calendar, following November and preceding the January of the following year, containing the southern solstice)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13385834",
          "text": "Ich liebe den Dezember.",
          "translation": "Я люблю декабрь.",
          "source": "Tatoeba #13385834 @Waldelfe / #10639189 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13385834",
          "cefr_level": "A1",
          "word_slugs": [
            "dezember-noun"
          ]
        },
        {
          "id": "776647",
          "text": "Der Dezember hat 31 Tage.",
          "translation": "В декабре 31 день.",
          "source": "Tatoeba #776647 @MUIRIEL / #1440528 @Kuka19 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/776647",
          "cefr_level": "A1",
          "word_slugs": [
            "dezember-noun"
          ]
        },
        {
          "id": "10184342",
          "text": "Wir haben jetzt Dezember.",
          "translation": "У нас сейчас декабрь.",
          "source": "Tatoeba #10184342 @Pfirsichbaeumchen / #10184088 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10184342",
          "cefr_level": "A1",
          "word_slugs": [
            "dezember-noun"
          ]
        },
        {
          "id": "13385833",
          "text": "Mir gefällt der Dezember.",
          "translation": "Мне нравится декабрь.",
          "source": "Tatoeba #13385833 @Waldelfe / #10639190 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13385833",
          "cefr_level": "A1",
          "word_slugs": [
            "dezember-noun"
          ]
        },
        {
          "id": "841789",
          "text": "Weihnachten ist am 25. Dezember.",
          "translation": "Рождество 25 декабря.",
          "source": "Tatoeba #841789 @Espi / #3604531 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/841789",
          "cefr_level": "A1",
          "word_slugs": [
            "dezember-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
