          ]
        },
        {
          "id": "2853537",
          "text": "Dieser Satz ist leider völlig unverständlich.",
          "translation": "К сожалению, это предложение совершенно невразумительно.",
          "source": "Tatoeba #2853537 @Pfirsichbaeumchen / #4402044 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2853537",
          "cefr_level": "A1",
          "word_slugs": [
            "unverständlich-adj"
          ]
        },
        {
          "id": "14089247",
          "text": "Einem Außenstehenden ist das vielleicht unverständlich.",
          "translation": "Человеку со стороны это может быть непонятно.",
          "source": "Tatoeba #14089247 @mhr / #14089104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14089247",
          "cefr_level": "A1",
          "word_slugs": [
            "unverständlich-adj"
          ]
        },
        {
          "id": "3601007",
          "text": "Ich hoffe, mein russischer Satz ist nicht ganz unverständlich.",
          "translation": "Я надеюсь, что мое русское предложение не совсем непонятное.",
          "source": "Tatoeba #3601007 @al_ex_an_der / #3601001 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3601007",
          "cefr_level": "A1",
