    {
      "slug": "widersprechen-verb",
      "lemma": "widersprechen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8513,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "возражать"
        ],
        "en": [
          "to object; to disagree",
          "to contradict",
          "to be contradictory"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2227416",
          "text": "Sie widersprechen sich selbst.",
          "translation": "Вы сами себе противоречите.",
          "source": "Tatoeba #2227416 @Pfirsichbaeumchen / #2357570 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2227416",
          "cefr_level": "A1",
          "word_slugs": [
            "widersprechen-verb"
          ]
        },
        {
          "id": "3550518",
          "text": "Ich konnte ihr nicht widersprechen.",
          "translation": "Я не мог ей перечить.",
          "source": "Tatoeba #3550518 @al_ex_an_der / #13071974 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3550518",
          "cefr_level": "A1",
          "word_slugs": [
            "widersprechen-verb"
          ]
        },
        {
          "id": "12713193",
          "text": "Seine Worte widersprechen der Realität.",
          "translation": "Его слова противоречат действительности.",
          "source": "Tatoeba #12713193 @mhr / #12713187 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12713193",
          "cefr_level": "A1",
          "word_slugs": [
            "widersprechen-verb"
          ]
        },
        {
          "id": "11547574",
          "text": "Es fällt schwer, dir zu widersprechen.",
          "translation": "Трудно с тобой не согласиться.",
          "source": "Tatoeba #11547574 @Pfirsichbaeumchen / #10592647 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11547574",
          "cefr_level": "A1",
          "word_slugs": [
            "widersprechen-verb"
          ]
        },
        {
          "id": "5428923",
          "text": "Wenn du friedlich leben willst, darfst du niemandem widersprechen.",
          "translation": "Хочешь жить в мире – никому не перечь.",
          "source": "Tatoeba #5428923 @Esperantostern / #8586946 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5428923",
          "cefr_level": "A1",
          "word_slugs": [
            "widersprechen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
