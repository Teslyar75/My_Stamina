      },
      "gender": null,
      "examples": [
        {
          "id": "982079",
          "text": "Ich unterstütze ihn.",
          "translation": "Я его поддерживаю.",
          "source": "Tatoeba #982079 @Esperantostern / #2566694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/982079",
          "cefr_level": "A1",
          "word_slugs": [
            "unterstütze-verb"
          ]
        },
        {
          "id": "2497069",
          "text": "Ich unterstütze Sie nicht.",
          "translation": "Я вас не поддерживаю.",
          "source": "Tatoeba #2497069 @Pfirsichbaeumchen / #2496356 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2497069",
          "cefr_level": "A1",
          "word_slugs": [
            "unterstütze-verb"
          ]
        },
        {
          "id": "1608569",
          "text": "Ich unterstütze diese Idee.",
          "translation": "Я поддерживаю эту идею.",
          "source": "Tatoeba #1608569 @al_ex_an_der / #3671697 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1608569",
          "cefr_level": "A1",
          "word_slugs": [
            "unterstütze-verb"
          ]
        },
        {
          "id": "2497070",
          "text": "Ich unterstütze euch nicht.",
          "translation": "Я вас не поддерживаю.",
          "source": "Tatoeba #2497070 @Pfirsichbaeumchen / #2496356 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2497070",
          "cefr_level": "A1",
          "word_slugs": [
            "unterstütze-verb"
          ]
        },
        {
          "id": "3467841",
          "text": "Ich unterstütze deinen Vorschlag.",
          "translation": "Я поддерживаю твоё предложение.",
          "source": "Tatoeba #3467841 @Pfirsichbaeumchen / #3430969 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3467841",
          "cefr_level": "A1",
          "word_slugs": [
            "unterstütze-verb"
          ]
        }
      ],
