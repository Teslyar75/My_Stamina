            "überprüfe-verb"
          ]
        },
        {
          "id": "14020266",
          "text": "Überprüfe bitte die Kommas!",
          "translation": "Проверь запятые, пожалуйста.",
          "source": "Tatoeba #14020266 @mhr / #14020234 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14020266",
          "cefr_level": "A1",
          "word_slugs": [
            "überprüfe-verb"
          ]
        },
        {
          "id": "9455555",
          "text": "Überprüfe noch einmal alles!",
          "translation": "Ещё раз всё проверь.",
          "source": "Tatoeba #9455555 @Pfirsichbaeumchen / #9468608 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9455555",
          "cefr_level": "A1",
          "word_slugs": [
            "überprüfe-verb"
          ]
        },
        {
          "id": "14107818",
          "text": "Überprüfe, ob du deine Stadt gut kennst!",
          "translation": "Проверь, хорошо ли ты знаешь свой город.",
          "source": "Tatoeba #14107818 @mhr / #14107748 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14107818",
