    {
      "slug": "lud-verb",
      "lemma": "lud",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8277,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of laden"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1342024",
          "text": "Sie lud ihn ein.",
          "translation": "Она его пригласила.",
          "source": "Tatoeba #1342024 @al_ex_an_der / #8650640 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1342024",
          "cefr_level": "A1",
          "word_slugs": [
            "lud-verb"
          ]
        },
        {
          "id": "5222930",
          "text": "Sie lud mich ein.",
          "translation": "Она пригласила меня.",
          "source": "Tatoeba #5222930 @Pfirsichbaeumchen / #5222684 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5222930",
          "cefr_level": "A1",
          "word_slugs": [
            "lud-verb"
          ]
        },
        {
          "id": "4801350",
          "text": "Ich lud die Nachbarn ein.",
          "translation": "Я приглашал соседей.",
          "source": "Tatoeba #4801350 @Tamy / #12624162 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4801350",
          "cefr_level": "A1",
          "word_slugs": [
            "lud-verb"
          ]
        },
        {
          "id": "673477",
          "text": "Ich lud sie ins Kino ein.",
          "translation": "Я пригласил её в кино.",
          "source": "Tatoeba #673477 @samueldora / #2202188 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/673477",
          "cefr_level": "A1",
          "word_slugs": [
            "lud-verb"
          ]
        },
        {
          "id": "727051",
          "text": "Er lud sie ins Konzert ein.",
          "translation": "Он пригласил их на концерт.",
          "source": "Tatoeba #727051 @Dejo / #6005701 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/727051",
          "cefr_level": "A1",
          "word_slugs": [
            "lud-verb"
          ]
        }
      ],
