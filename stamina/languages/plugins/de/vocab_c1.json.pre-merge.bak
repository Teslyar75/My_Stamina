    {
      "slug": "verlobten-noun",
      "lemma": "Verlobten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6547,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Verlobter:",
          "genitive singular",
          "inflection of Verlobter:",
          "strong genitive/accusative singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1812980",
          "text": "Sie spricht oft mit ihrem Verlobten.",
          "translation": "Она часто говорит со своим женихом.",
          "source": "Tatoeba #1812980 @pne / #2417863 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1812980",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobten-noun"
          ]
        },
        {
          "id": "12407403",
          "text": "Sie strickt ihrem Verlobten einen Pullover.",
          "translation": "Она вяжет своему жениху свитер.",
          "source": "Tatoeba #12407403 @Waldelfe / #12420038 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12407403",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobten-noun"
          ]
        },
        {
          "id": "5955696",
          "text": "Tom will uns nicht seiner Verlobten vorstellen.",
          "translation": "Том не хочет знакомить нас со своей невестой.",
          "source": "Tatoeba #5955696 @Pfirsichbaeumchen / #5755324 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5955696",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobten-noun"
          ]
        },
        {
          "id": "955610",
          "text": "Er schwor seiner Verlobten Treue bis zum Tod.",
          "translation": "Он поклялся своей невесте в верности до самой смерти.",
          "source": "Tatoeba #955610 @Manfredo / #2026512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/955610",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobten-noun"
          ]
        },
        {
          "id": "5912699",
          "text": "Maria will mich mit ihrem Verlobten bekannt machen.",
          "translation": "Мэри хочет познакомить меня со своим женихом.",
          "source": "Tatoeba #5912699 @Pfirsichbaeumchen / #5755319 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5912699",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
