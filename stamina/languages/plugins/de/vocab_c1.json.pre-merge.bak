    {
      "slug": "fünften-num",
      "lemma": "fünften",
      "pos": "num",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7380,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of fünfte:",
          "strong genitive masculine/neuter singular",
          "inflection of fünfte:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12761950",
          "text": "Sein Geburtstag ist am fünften Mai.",
          "translation": "У него день рождения пятого мая.",
          "source": "Tatoeba #12761950 @mhr / #12761373 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12761950",
          "cefr_level": "A1",
          "word_slugs": [
            "fünften-num"
          ]
        },
        {
          "id": "2718870",
          "text": "Am fünften Juni ist der Weltumwelttag.",
          "translation": "5 июня - Всемирный день окружающей среды.",
          "source": "Tatoeba #2718870 @Pfirsichbaeumchen / #2983894 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2718870",
          "cefr_level": "A1",
          "word_slugs": [
            "fünften-num"
          ]
        },
        {
          "id": "2974646",
          "text": "Der Deutschkurs beginnt am fünften Oktober.",
          "translation": "Курсы немецкого языка начинаются пятого октября.",
          "source": "Tatoeba #2974646 @al_ex_an_der / #1183466 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2974646",
          "cefr_level": "A1",
          "word_slugs": [
            "fünften-num"
          ]
        },
        {
          "id": "656914",
          "text": "Nehmen Sie den Aufzug zur fünften Etage.",
          "translation": "Поднимитесь на лифте на пятый этаж.",
          "source": "Tatoeba #656914 @samueldora / #2348440 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/656914",
          "cefr_level": "A1",
          "word_slugs": [
            "fünften-num"
          ]
        },
        {
          "id": "6763130",
          "text": "„Wo sitzt du?“ – „In der fünften Reihe.“",
          "translation": "\"Где ты сидишь?\" - \"В пятом ряду\".",
          "source": "Tatoeba #6763130 @felix63 / #6768707 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6763130",
          "cefr_level": "A1",
          "word_slugs": [
            "fünften-num"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
