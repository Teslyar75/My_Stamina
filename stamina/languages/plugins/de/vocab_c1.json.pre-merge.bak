    {
      "slug": "glücklicherweise-adv",
      "lemma": "glücklicherweise",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7128,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "к счастью"
        ],
        "en": [
          "fortunately; luckily"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "343544",
          "text": "Glücklicherweise war das Wetter schön.",
          "translation": "К счастью, погода была хорошая.",
          "source": "Tatoeba #343544 @MUIRIEL / #1678052 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/343544",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklicherweise-adv"
          ]
        },
        {
          "id": "13628225",
          "text": "Glücklicherweise ist er nicht gestorben.",
          "translation": "К счастью, он не умер.",
          "source": "Tatoeba #13628225 @kbylr / #423005 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13628225",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklicherweise-adv"
          ]
        },
        {
          "id": "3016905",
          "text": "Glücklicherweise ist sie nicht gestorben.",
          "translation": "К счастью, она не умерла.",
          "source": "Tatoeba #3016905 @Pfirsichbaeumchen / #1848263 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3016905",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklicherweise-adv"
          ]
        },
        {
          "id": "2418947",
          "text": "Glücklicherweise gab es keinen Verkehrsstau.",
          "translation": "К счастью пробок не было.",
          "source": "Tatoeba #2418947 @al_ex_an_der / #2418933 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2418947",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklicherweise-adv"
          ]
        },
        {
          "id": "7756137",
          "text": "„Sind Sie glücklich?“ – „Glücklicherweise, ja!“",
          "translation": "\"Вы счастливы?\" - \"К счастью, да!\"",
          "source": "Tatoeba #7756137 @felix63 / #7756789 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7756137",
          "cefr_level": "A1",
          "word_slugs": [
            "glücklicherweise-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
