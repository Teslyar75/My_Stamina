        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "655040",
          "text": "Ihr Armband ist sehr wertvoll.",
          "translation": "Ее браслет очень дорогой.",
          "source": "Tatoeba #655040 @kolonjano / #2847027 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/655040",
          "cefr_level": "A1",
          "word_slugs": [
            "wertvoll-adj"
          ]
        },
        {
          "id": "12716235",
          "text": "Der Erfahrungsaustausch ist immer wertvoll.",
          "translation": "Обмен опытом всегда ценен.",
          "source": "Tatoeba #12716235 @Balamax / #12716236 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12716235",
          "cefr_level": "A1",
          "word_slugs": [
            "wertvoll-adj"
          ]
        },
        {
          "id": "798928",
          "text": "Nichts ist so wertvoll wie Gesundheit.",
          "translation": "Ничто так не ценно, как здоровье.",
          "source": "Tatoeba #798928 @samueldora / #798931 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/798928",
          "cefr_level": "A1",
          "word_slugs": [
            "wertvoll-adj"
          ]
        },
        {
          "id": "376134",
          "text": "Nichts ist so wertvoll wie Freundschaft.",
          "translation": "Нет большей ценности, чем дружба.",
          "source": "Tatoeba #376134 @MUIRIEL / #468119 @tensin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/376134",
          "cefr_level": "A1",
          "word_slugs": [
            "wertvoll-adj"
          ]
        },
        {
          "id": "2970522",
          "text": "Jeder Mensch ist einzigartig und wertvoll.",
          "translation": "Каждый человек уникален и ценен.",
          "source": "Tatoeba #2970522 @al_ex_an_der / #2970519 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2970522",
          "cefr_level": "A1",
          "word_slugs": [
            "wertvoll-adj"
          ]
        }
