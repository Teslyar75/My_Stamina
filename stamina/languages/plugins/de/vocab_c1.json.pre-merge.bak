          "cefr_level": "A1",
          "word_slugs": [
            "zutritt-noun"
          ]
        },
        {
          "id": "8695615",
          "text": "Reportern für die Presse ist der Zutritt nicht gestattet.",
          "translation": "Газетчикам не разрешили входить.",
          "source": "Tatoeba #8695615 @driini / #1576553 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8695615",
          "cefr_level": "A1",
          "word_slugs": [
            "zutritt-noun"
          ]
        },
        {
          "id": "1654938",
          "text": "Zutritt streng verboten.",
          "translation": "Вход строго запрещен.",
          "source": "Tatoeba #1654938 @al_ex_an_der / #10371356 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1654938",
