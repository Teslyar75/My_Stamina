    {
      "slug": "kommunizieren-verb",
      "lemma": "kommunizieren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6406,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to communicate (to exchange information)",
          "to communicate, to take communion"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10113866",
          "text": "Wir können auf Französisch kommunizieren.",
          "translation": "Мы можем общаться по-французски.",
          "source": "Tatoeba #10113866 @giefingl / #9615379 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10113866",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunizieren-verb"
          ]
        },
        {
          "id": "12707214",
          "text": "Sie kommunizieren durch Gesten miteinander.",
          "translation": "Они общаются между собой жестами.",
          "source": "Tatoeba #12707214 @Waldelfe / #12707182 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12707214",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunizieren-verb"
          ]
        },
        {
          "id": "13835519",
          "text": "Taubstumme kommunizieren mithilfe der Gebärdensprache.",
          "translation": "Глухонемые общаются с помощью жестового языка.",
          "source": "Tatoeba #13835519 @mhr / #13835463 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13835519",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunizieren-verb"
          ]
        },
        {
          "id": "355923",
          "text": "Wir kommunizieren mit Hilfe von Wörtern.",
          "translation": "Мы общаемся при помощи слов.",
          "source": "Tatoeba #355923 @lilygilder / #3193383 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/355923",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunizieren-verb"
          ]
        },
        {
          "id": "1047369",
          "text": "Piloten kommunizieren mit dem Flughafen per Funk.",
          "translation": "Пилоты связываются с аэропортом по радио.",
          "source": "Tatoeba #1047369 @tatomeimei / #6484448 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1047369",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunizieren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
