    {
      "slug": "märz-noun",
      "lemma": "März",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5624,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "March (the third month of the Gregorian calendar, following February and preceding April, containing the northward equinox)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10184338",
          "text": "Wir haben jetzt März.",
          "translation": "У нас сейчас март.",
          "source": "Tatoeba #10184338 @Pfirsichbaeumchen / #10184093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10184338",
          "cefr_level": "A1",
          "word_slugs": [
            "märz-noun"
          ]
        },
        {
          "id": "982053",
          "text": "Ende März heiraten wir.",
          "translation": "Мы поженимся в конце марта.",
          "source": "Tatoeba #982053 @Sudajaengi / #2569957 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/982053",
          "cefr_level": "A1",
          "word_slugs": [
            "märz-noun"
          ]
        },
        {
          "id": "2217384",
          "text": "Wir heiraten Ende März.",
          "translation": "Мы поженимся в конце марта.",
          "source": "Tatoeba #2217384 @Vortarulo / #2569957 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2217384",
          "cefr_level": "A1",
          "word_slugs": [
            "märz-noun"
          ]
        },
        {
          "id": "2718908",
          "text": "Am 14. März ist Pi-Tag.",
          "translation": "14 марта - День числа пи.",
          "source": "Tatoeba #2718908 @Pfirsichbaeumchen / #6456660 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2718908",
          "cefr_level": "A1",
          "word_slugs": [
            "märz-noun"
          ]
        },
        {
          "id": "13832380",
          "text": "Im März wird Tom dreißig.",
          "translation": "В марте Тому исполняется тридцать.",
          "source": "Tatoeba #13832380 @mhr / #13832699 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13832380",
          "cefr_level": "A1",
          "word_slugs": [
            "märz-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
