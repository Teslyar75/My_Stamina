    {
      "slug": "andreas-name",
      "lemma": "Andreas",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9493,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Andrew (biblical figure)",
          "a male given name from Ancient Greek, equivalent to English Andrew"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10304997",
          "text": "Andreas hat ein blaugrünes T-Shirt und eine grüne Hose.",
          "translation": "У Андрея футболка цвета морской волны и зелёные штаны.",
          "source": "Tatoeba #10304997 @Rovo / #13858540 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10304997",
          "cefr_level": "A1",
          "word_slugs": [
            "andreas-name"
          ]
        },
        {
          "id": "2810521",
          "text": "„Andreas, wo ist die Karte? Hast du sie?“ – „Ich glaube, nicht.“",
          "translation": "\"Андрей, где карта? Она у тебя?\" - \"Я полагаю, нет\".",
          "source": "Tatoeba #2810521 @Pfirsichbaeumchen / #2809761 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2810521",
          "cefr_level": "A1",
          "word_slugs": [
            "andreas-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "andreas-noun",
      "lemma": "Andreas",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9493,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
