    {
      "slug": "reichlich-adj",
      "lemma": "reichlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6276,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "more than enough, abundant, copious, plentiful"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3624697",
          "text": "Tom schwitzt reichlich.",
          "translation": "Том сильно потеет.",
          "source": "Tatoeba #3624697 @fleur74 / #3625069 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3624697",
          "cefr_level": "A1",
          "word_slugs": [
            "reichlich-adj"
          ]
        },
        {
          "id": "786556",
          "text": "Wir haben reichlich Zeit.",
          "translation": "Времени у нас предостаточно.",
          "source": "Tatoeba #786556 @al_ex_an_der / #3570906 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/786556",
          "cefr_level": "A1",
          "word_slugs": [
            "reichlich-adj"
          ]
        },
        {
          "id": "3584751",
          "text": "Sehr große Fenster sorgen für reichlich Tageslicht.",
          "translation": "Очень большие окна обеспечивают высокий уровень освещённости.",
          "source": "Tatoeba #3584751 @al_ex_an_der / #3586276 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3584751",
          "cefr_level": "A1",
