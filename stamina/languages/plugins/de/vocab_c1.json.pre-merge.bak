    {
      "slug": "feuerzeug-noun",
      "lemma": "Feuerzeug",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8444,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "tinderbox",
          "lighter"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1287835",
          "text": "Hast du ein Feuerzeug?",
          "translation": "У тебя есть зажигалка?",
          "source": "Tatoeba #1287835 @enteka / #1601391 @mutternoise (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1287835",
          "cefr_level": "A1",
          "word_slugs": [
            "feuerzeug-noun"
          ]
        },
        {
          "id": "9524268",
          "text": "Ist dein Feuerzeug neu?",
          "translation": "У тебя новая зажигалка?",
          "source": "Tatoeba #9524268 @Taam / #9528503 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9524268",
          "cefr_level": "A1",
          "word_slugs": [
            "feuerzeug-noun"
          ]
        },
        {
          "id": "6482548",
          "text": "Hat jemand ein Feuerzeug?",
          "translation": "У кого-нибудь есть зажигалка?",
          "source": "Tatoeba #6482548 @Pfirsichbaeumchen / #6055024 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6482548",
          "cefr_level": "A1",
          "word_slugs": [
            "feuerzeug-noun"
          ]
        },
        {
          "id": "7079752",
          "text": "Vergiss nicht deine Zigaretten und dein Feuerzeug!",
          "translation": "Не забудь сигареты и зажигалку!",
          "source": "Tatoeba #7079752 @Pfirsichbaeumchen / #7079762 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7079752",
          "cefr_level": "A1",
          "word_slugs": [
            "feuerzeug-noun"
          ]
        },
        {
          "id": "8641747",
          "text": "Tom zündet die Kerze mit einem Feuerzeug an.",
          "translation": "Том зажигает свечу зажигалкой.",
          "source": "Tatoeba #8641747 @Melang / #13442821 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8641747",
          "cefr_level": "A1",
          "word_slugs": [
            "feuerzeug-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
