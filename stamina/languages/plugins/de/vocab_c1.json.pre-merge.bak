    {
      "slug": "gleichfalls-adv",
      "lemma": "gleichfalls",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7305,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "также"
        ],
        "en": [
          "likewise"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12988823",
          "text": "„Danke!“ – „Danke gleichfalls!“",
          "translation": "«Спасибо!» – «Тебе спасибо!»",
          "source": "Tatoeba #12988823 @mhr / #12988418 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12988823",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichfalls-adv"
          ]
        },
        {
          "id": "11100995",
          "text": "Danke gleichfalls! Du hast mir sehr geholfen!",
          "translation": "Тебе тоже спасибо! Ты мне очень помог!",
          "source": "Tatoeba #11100995 @Pfirsichbaeumchen / #11100013 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11100995",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichfalls-adv"
          ]
        },
        {
          "id": "11100996",
          "text": "Danke gleichfalls! Ihr habt mir sehr geholfen!",
          "translation": "Вам тоже спасибо! Вы мне очень помогли!",
          "source": "Tatoeba #11100996 @Pfirsichbaeumchen / #11100033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11100996",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichfalls-adv"
          ]
        },
        {
          "id": "11100997",
          "text": "Danke gleichfalls! Sie haben mir sehr geholfen!",
          "translation": "Вам тоже спасибо! Вы мне очень помогли!",
          "source": "Tatoeba #11100997 @Pfirsichbaeumchen / #11100033 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11100997",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichfalls-adv"
          ]
        }
      ],
