          "cefr_level": "A1",
          "word_slugs": [
            "möbel-noun"
          ]
        },
        {
          "id": "3567532",
          "text": "Wir hatten viele Möbel.",
          "translation": "У нас было много мебели.",
          "source": "Tatoeba #3567532 @Pfirsichbaeumchen / #3567529 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3567532",
          "cefr_level": "A1",
          "word_slugs": [
            "möbel-noun"
          ]
        },
        {
          "id": "676977",
          "text": "Die Möbel waren staubig.",
