    {
      "slug": "kreuzung-noun",
      "lemma": "Kreuzung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8330,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "перекрёсток"
        ],
        "en": [
          "crossing, intersection",
          "crossbreeding",
          "crossbreed"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1013547",
          "text": "Wie heißt diese Kreuzung?",
          "translation": "Как называется этот перекрёсток?",
          "source": "Tatoeba #1013547 @Pfirsichbaeumchen / #808266 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1013547",
          "cefr_level": "A1",
          "word_slugs": [
            "kreuzung-noun"
          ]
        },
        {
          "id": "3240658",
          "text": "Diese Kreuzung ist gefährlich.",
          "translation": "Этот перекрёсток опасен.",
          "source": "Tatoeba #3240658 @freddy1 / #3241806 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3240658",
          "cefr_level": "A1",
          "word_slugs": [
            "kreuzung-noun"
          ]
        },
        {
          "id": "10662422",
          "text": "An der Kreuzung links abbiegen.",
          "translation": "На перекрёстке поверни налево.",
          "source": "Tatoeba #10662422 @Pfirsichbaeumchen / #3260875 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10662422",
          "cefr_level": "A1",
          "word_slugs": [
            "kreuzung-noun"
          ]
        },
        {
          "id": "662162",
          "text": "An der nächsten Kreuzung rechts!",
          "translation": "На следующем перекрестке направо.",
          "source": "Tatoeba #662162 @stefz / #4949545 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/662162",
          "cefr_level": "A1",
          "word_slugs": [
            "kreuzung-noun"
          ]
        },
        {
          "id": "6151227",
          "text": "Auf dieser Kreuzung ist immer Hochbetrieb.",
          "translation": "На этом перекрёстке постоянное оживление.",
          "source": "Tatoeba #6151227 @raggione / #8365828 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6151227",
          "cefr_level": "A1",
          "word_slugs": [
            "kreuzung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Kreuzung",
        "nominative_pl": ""
      }
    },
    {
      "slug": "häusern-name",
      "lemma": "Häusern",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8331,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a municipality of Baden-Württemberg, Germany"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12406983",
          "text": "Er lebt in zwei Häusern.",
          "translation": "Он живёт на два дома.",
          "source": "Tatoeba #12406983 @Rovo / #5633842 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12406983",
          "cefr_level": "A1",
          "word_slugs": [
            "häusern-name"
          ]
        },
        {
          "id": "10502219",
          "text": "In diesen Häusern wohnt niemand.",
          "translation": "В этих домах никто не живёт.",
          "source": "Tatoeba #10502219 @maaster / #13808201 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10502219",
          "cefr_level": "A1",
          "word_slugs": [
            "häusern-name"
          ]
        },
        {
          "id": "11458978",
          "text": "In einigen Häusern gingen die Lichter an.",
          "translation": "В нескольких домах включился свет.",
          "source": "Tatoeba #11458978 @Adelpa / #11459041 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11458978",
          "cefr_level": "A1",
          "word_slugs": [
            "häusern-name"
          ]
        },
        {
          "id": "3318044",
          "text": "Der Wind blies die Dächer von den Häusern.",
          "translation": "Ветром сдуло крыши домов.",
          "source": "Tatoeba #3318044 @al_ex_an_der / #3318042 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3318044",
          "cefr_level": "A1",
          "word_slugs": [
            "häusern-name"
          ]
        },
        {
          "id": "3655995",
          "text": "In den Häusern mit fünf Etagen gibt es keine Aufzüge.",
          "translation": "В пятиэтажках не бывает лифтов.",
          "source": "Tatoeba #3655995 @Esperantostern / #3655491 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3655995",
          "cefr_level": "A1",
          "word_slugs": [
            "häusern-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
