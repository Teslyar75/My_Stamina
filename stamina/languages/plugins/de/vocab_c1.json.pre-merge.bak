    {
      "slug": "neffe-noun",
      "lemma": "Neffe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5028,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nephew (son of one's sibling or sibling-in-law)",
          "another male relative, especially a grandson, but also a cousin etc."
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3128870",
          "text": "Ist Tom dein Neffe?",
          "translation": "Том твой племянник?",
          "source": "Tatoeba #3128870 @samueldora / #3128878 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3128870",
          "cefr_level": "A1",
          "word_slugs": [
            "neffe-noun"
          ]
        },
        {
          "id": "469976",
          "text": "John ist mein Neffe.",
          "translation": "Джон - мой племянник.",
          "source": "Tatoeba #469976 @Espi / #2765256 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/469976",
          "cefr_level": "A1",
          "word_slugs": [
            "neffe-noun"
          ]
        },
        {
          "id": "8188963",
          "text": "Mein Neffe ist zwölf.",
          "translation": "Моему племяннику двенадцать.",
          "source": "Tatoeba #8188963 @Pfirsichbaeumchen / #8188778 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8188963",
          "cefr_level": "A1",
          "word_slugs": [
            "neffe-noun"
          ]
        },
        {
          "id": "9387010",
          "text": "Toms Neffe ist berühmt.",
          "translation": "Племянник Тома знаменит.",
          "source": "Tatoeba #9387010 @Pfirsichbaeumchen / #9499689 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9387010",
          "cefr_level": "A1",
          "word_slugs": [
            "neffe-noun"
          ]
        },
        {
          "id": "5435645",
          "text": "Mein Neffe heiratet morgen.",
          "translation": "Мой племянник завтра женится.",
          "source": "Tatoeba #5435645 @Pfirsichbaeumchen / #10360816 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5435645",
          "cefr_level": "A1",
          "word_slugs": [
            "neffe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Neffe",
        "nominative_pl": ""
      }
    },
    {
      "slug": "sue-name",
      "lemma": "Sue",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5029,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": "f",
      "examples": [
        {
          "id": "639577",
          "text": "Tom und Sue lieben sich.",
          "translation": "Том и Сью любят друг друга.",
          "source": "Tatoeba #639577 @BraveSentry / #2588050 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/639577",
          "cefr_level": "A1",
          "word_slugs": [
            "sue-name"
          ]
        },
        {
          "id": "2118612",
          "text": "Tom und Sue lieben einander.",
          "translation": "Том и Сью любят друг друга.",
          "source": "Tatoeba #2118612 @Zaghawa / #2588050 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2118612",
          "cefr_level": "A1",
          "word_slugs": [
            "sue-name"
          ]
        },
        {
          "id": "6388948",
          "text": "Tom und Sue kennen sich schon seit 1985.",
          "translation": "Том и Сью знакомы с 1985 года.",
