          "cefr_level": "A1",
          "word_slugs": [
            "juckt-verb"
          ]
        },
        {
          "id": "1341310",
          "text": "Meine Nase juckt.",
          "translation": "У меня нос зудит.",
          "source": "Tatoeba #1341310 @Zaghawa / #433037 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1341310",
          "cefr_level": "A1",
          "word_slugs": [
            "juckt-verb"
          ]
        },
        {
          "id": "543593",
          "text": "Ich habe Fußpilz und es juckt sehr.",
          "translation": "У меня грибок на ноге и он очень зудит.",
          "source": "Tatoeba #543593 @al_ex_an_der / #1533560 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/543593",
          "cefr_level": "A1",
