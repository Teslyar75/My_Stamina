          ]
        },
        {
          "id": "11630317",
          "text": "Ich schreibe es an die Tafel.",
          "translation": "Я напишу это на доске.",
          "source": "Tatoeba #11630317 @Pfirsichbaeumchen / #6171077 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11630317",
          "cefr_level": "A1",
