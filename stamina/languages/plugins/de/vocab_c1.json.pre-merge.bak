    {
      "slug": "helm-noun",
      "lemma": "Helm",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5799,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "helmet",
          "helm roof",
          "helmet, as shown above a coat of arms"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6088900",
          "text": "Gib mir den Helm.",
          "translation": "Дай мне каску.",
          "source": "Tatoeba #6088900 @Pfirsichbaeumchen / #6306017 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6088900",
          "cefr_level": "A1",
          "word_slugs": [
            "helm-noun"
          ]
        },
        {
          "id": "5854239",
          "text": "Du hast meinen Helm.",
          "translation": "У тебя мой шлем.",
          "source": "Tatoeba #5854239 @dasbeispielholz / #3409936 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5854239",
          "cefr_level": "A1",
          "word_slugs": [
            "helm-noun"
          ]
        },
        {
          "id": "6819061",
          "text": "Tom braucht einen Helm.",
          "translation": "Тому нужен шлем.",
          "source": "Tatoeba #6819061 @Pfirsichbaeumchen / #5444608 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6819061",
          "cefr_level": "A1",
          "word_slugs": [
            "helm-noun"
          ]
        },
        {
          "id": "7999245",
          "text": "Feuerwehrleute tragen einen Helm.",
          "translation": "Пожарные носят каску.",
          "source": "Tatoeba #7999245 @Pfirsichbaeumchen / #2772751 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7999245",
          "cefr_level": "A1",
          "word_slugs": [
            "helm-noun"
          ]
        },
        {
          "id": "12495384",
          "text": "Warum warst du ohne Helm?",
          "translation": "Почему ты был без шлема?",
          "source": "Tatoeba #12495384 @Waldelfe / #12187405 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12495384",
          "cefr_level": "A1",
          "word_slugs": [
            "helm-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
