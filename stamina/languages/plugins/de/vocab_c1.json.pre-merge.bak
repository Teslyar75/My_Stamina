          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12533577",
          "text": "Ich mag ehrliche Menschen.",
          "translation": "Я люблю честных людей.",
          "source": "Tatoeba #12533577 @Vortarulo / #4627533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12533577",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrliche-adj"
          ]
        },
        {
          "id": "1700278",
          "text": "Das ist eine ehrliche Frage.",
          "translation": "Это честный вопрос.",
          "source": "Tatoeba #1700278 @Pfirsichbaeumchen / #11389024 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1700278",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrliche-adj"
          ]
        },
        {
          "id": "11966698",
          "text": "Ich erwarte eine ehrliche Antwort.",
          "translation": "Я жду честного ответа.",
          "source": "Tatoeba #11966698 @Pfirsichbaeumchen / #10874105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11966698",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrliche-adj"
          ]
        },
        {
          "id": "13907318",
          "text": "Sie war eine ehrliche Politikerin.",
          "translation": "Она была честным политиком.",
          "source": "Tatoeba #13907318 @Waldelfe / #6937056 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13907318",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrliche-adj"
          ]
        },
        {
          "id": "3424969",
          "text": "Danke für diese überaus ehrliche Meinung.",
          "translation": "Спасибо за столь честное мнение.",
          "source": "Tatoeba #3424969 @al_ex_an_der / #3424961 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3424969",
          "cefr_level": "A1",
          "word_slugs": [
            "ehrliche-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
