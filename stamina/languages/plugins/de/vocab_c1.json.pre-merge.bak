    {
      "slug": "frühstücken-verb",
      "lemma": "frühstücken",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6411,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to have breakfast, to breakfast (to eat the morning meal)",
          "to have something for breakfast (to eat as one's morning meal)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "747832",
          "text": "Wann frühstücken Sie?",
          "translation": "Когда Вы завтракаете?",
          "source": "Tatoeba #747832 @Manfredo / #6597680 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/747832",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-verb"
          ]
        },
        {
          "id": "3519496",
          "text": "Lass uns frühstücken!",
          "translation": "Давай завтракать!",
          "source": "Tatoeba #3519496 @Pfirsichbaeumchen / #9248925 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3519496",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-verb"
          ]
        },
        {
          "id": "3965304",
          "text": "Du musst frühstücken.",
          "translation": "Тебе нужно позавтракать.",
          "source": "Tatoeba #3965304 @Kuraimegami / #5773132 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3965304",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-verb"
          ]
        },
        {
          "id": "3519497",
          "text": "Lasst uns frühstücken!",
          "translation": "Давайте завтракать!",
          "source": "Tatoeba #3519497 @Pfirsichbaeumchen / #9248675 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3519497",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-verb"
          ]
        },
        {
          "id": "5773135",
          "text": "Ihr müsst frühstücken.",
          "translation": "Вам нужно позавтракать.",
          "source": "Tatoeba #5773135 @Pfirsichbaeumchen / #5773292 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5773135",
          "cefr_level": "A1",
          "word_slugs": [
            "frühstücken-verb"
          ]
        }
      ],
      "tags": [
