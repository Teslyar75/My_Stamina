    {
      "slug": "entworfen-verb",
      "lemma": "entworfen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8172,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of entwerfen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8646238",
          "text": "Er hat das neue Gebäude entworfen.",
          "translation": "Он спроектировал новое здание.",
          "source": "Tatoeba #8646238 @Pfirsichbaeumchen / #8030209 @Ivanovb (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8646238",
          "cefr_level": "A1",
          "word_slugs": [
            "entworfen-verb"
          ]
        },
        {
          "id": "12212374",
          "text": "Diese Häuser hat Tom entworfen und gebaut.",
          "translation": "Эти дома спроектировал и построил Том.",
          "source": "Tatoeba #12212374 @mhr / #12212201 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12212374",
          "cefr_level": "A1",
          "word_slugs": [
            "entworfen-verb"
          ]
        },
        {
          "id": "8386746",
          "text": "Weißt du, wer dieses Programm entworfen hat?",
          "translation": "Ты знаешь, кто создал эту программу?",
          "source": "Tatoeba #8386746 @Pfirsichbaeumchen / #5774688 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8386746",
          "cefr_level": "A1",
          "word_slugs": [
            "entworfen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
