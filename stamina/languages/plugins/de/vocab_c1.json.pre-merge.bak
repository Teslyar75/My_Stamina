        },
        {
          "id": "3548970",
          "text": "Warum hat die Polizei uns nicht in Kenntnis gesetzt?",
          "translation": "Почему полиция не поставила нас в известность?",
          "source": "Tatoeba #3548970 @Pfirsichbaeumchen / #3549580 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3548970",
          "cefr_level": "A1",
          "word_slugs": [
            "kenntnis-noun"
          ]
        },
        {
          "id": "2250671",
          "text": "Ich nahm gar nicht zur Kenntnis, wie sie gekleidet war.",
          "translation": "Я не заметил, во что она была одета.",
          "source": "Tatoeba #2250671 @Pfirsichbaeumchen / #2603801 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2250671",
          "cefr_level": "A1",
          "word_slugs": [
            "kenntnis-noun"
          ]
        },
        {
          "id": "2430338",
          "text": "Er hat seine profunde Kenntnis des Themas unter Beweis gestellt.",
          "translation": "Он показал глубокие знания по данной теме.",
          "source": "Tatoeba #2430338 @al_ex_an_der / #2430334 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430338",
          "cefr_level": "A1",
          "word_slugs": [
            "kenntnis-noun"
          ]
        },
        {
          "id": "1954089",
          "text": "Ohne Kenntnis der russischen Sprache in Russland zu leben, ist schwierig.",
          "translation": "Тяжело живется в России без знания русского языка.",
          "source": "Tatoeba #1954089 @al_ex_an_der / #1953281 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1954089",
          "cefr_level": "A1",
          "word_slugs": [
            "kenntnis-noun"
          ]
        }
      ],
