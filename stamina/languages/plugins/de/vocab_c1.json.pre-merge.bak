      },
      "gender": null,
      "examples": [
        {
          "id": "2494075",
          "text": "In meinen Schuhen sind Löcher.",
          "translation": "У меня ботинки дырявые.",
          "source": "Tatoeba #2494075 @Pfirsichbaeumchen / #2494077 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2494075",
          "cefr_level": "A1",
          "word_slugs": [
            "schuhen-noun"
          ]
        },
        {
          "id": "13683567",
          "text": "Geht nicht mit Schuhen ins Haus!",
          "translation": "Не заходите в дом в обуви!",
          "source": "Tatoeba #13683567 @Vortarulo / #13683595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13683567",
          "cefr_level": "A1",
          "word_slugs": [
            "schuhen-noun"
          ]
        },
        {
          "id": "10782045",
          "text": "Ich habe sie den Schuhen vorgezogen.",
          "translation": "Я выбрал их вместо туфель.",
          "source": "Tatoeba #10782045 @GaryGaryGary / #424287 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10782045",
          "cefr_level": "A1",
          "word_slugs": [
            "schuhen-noun"
          ]
        },
        {
          "id": "798618",
          "text": "Ich sah den Jungen mit braunen Schuhen.",
          "translation": "Я видел мальчика в коричневых ботинках.",
          "source": "Tatoeba #798618 @Pfirsichbaeumchen / #4955448 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/798618",
          "cefr_level": "A1",
          "word_slugs": [
            "schuhen-noun"
          ]
        },
        {
          "id": "11213677",
          "text": "In den Schuhen habe ich Blasen bekommen.",
          "translation": "У меня от тех туфель мозоли были.",
          "source": "Tatoeba #11213677 @Pfirsichbaeumchen / #6864616 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11213677",
          "cefr_level": "A1",
          "word_slugs": [
            "schuhen-noun"
          ]
        }
