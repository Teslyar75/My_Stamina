    {
      "slug": "schenke-verb",
      "lemma": "schenke",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5996,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schenken:",
          "first-person singular present",
          "inflection of schenken:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1046926",
          "text": "Ich schenke es ihr.",
          "translation": "Я дарю ей это.",
          "source": "Tatoeba #1046926 @Sudajaengi / #2061962 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1046926",
          "cefr_level": "A1",
          "word_slugs": [
            "schenke-verb"
          ]
        },
        {
          "id": "13633499",
          "text": "Ich schenke dir ein Buch.",
          "translation": "Дарю тебе книгу.",
          "source": "Tatoeba #13633499 @mhr / #914280 @joulin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13633499",
          "cefr_level": "A1",
          "word_slugs": [
            "schenke-verb"
          ]
        },
        {
          "id": "8907758",
          "text": "Nimm es! Ich schenke es dir.",
          "translation": "Бери! Дарю.",
          "source": "Tatoeba #8907758 @felix63 / #13932398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8907758",
          "cefr_level": "A1",
          "word_slugs": [
            "schenke-verb"
          ]
        },
        {
          "id": "13932552",
          "text": "Nehmt es! Ich schenke es euch.",
          "translation": "Берите! Дарю.",
          "source": "Tatoeba #13932552 @mhr / #13932399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13932552",
          "cefr_level": "A1",
          "word_slugs": [
            "schenke-verb"
          ]
        },
        {
          "id": "5463813",
          "text": "Ich schenke den Damen die Blumen.",
          "translation": "Я дарю дамам цветы.",
          "source": "Tatoeba #5463813 @nina99nv / #5463815 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5463813",
          "cefr_level": "A1",
          "word_slugs": [
            "schenke-verb"
          ]
        }
      ],
