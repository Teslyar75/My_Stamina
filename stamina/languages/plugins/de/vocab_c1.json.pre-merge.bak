    {
      "slug": "propheten-noun",
      "lemma": "Propheten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8807,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Prophet:",
          "genitive/dative/accusative singular",
          "inflection of Prophet:",
          "nominative/genitive/dative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2135665",
          "text": "Bete zum Allmächtigen und nicht zu seinen Propheten.",
          "translation": "Молись всевышнему, а не его пророкам.",
          "source": "Tatoeba #2135665 @sismic / #650655 @salikh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2135665",
          "cefr_level": "A1",
          "word_slugs": [
            "propheten-noun"
          ]
        },
        {
          "id": "2353572",
          "text": "Wenn der Berg nicht zum Propheten kommt, muss der Prophet zum Berg.",
          "translation": "Если гора не идёт к пророку, пророк идёт к горе.",
          "source": "Tatoeba #2353572 @Esperantostern / #2983860 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2353572",
          "cefr_level": "A1",
          "word_slugs": [
            "propheten-noun"
          ]
        }
      ],
