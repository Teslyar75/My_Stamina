    {
      "slug": "hinzu-adv",
      "lemma": "hinzu",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8013,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "in addition, besides",
          "on the way there"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7961889",
          "text": "Füge etwas Salz hinzu.",
          "translation": "Добавь немного соли.",
          "source": "Tatoeba #7961889 @wolfgangth / #7961927 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7961889",
          "cefr_level": "A1",
          "word_slugs": [
            "hinzu-adv"
          ]
        },
        {
          "id": "14082377",
          "text": "Ich fügte nichts hinzu.",
          "translation": "Я ничего не добавлял.",
          "source": "Tatoeba #14082377 @Rovo / #14082379 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14082377",
          "cefr_level": "A1",
          "word_slugs": [
            "hinzu-adv"
          ]
        },
        {
          "id": "2506815",
          "text": "Marie fügte Sätze hinzu.",
          "translation": "Мэри добавляла предложения.",
          "source": "Tatoeba #2506815 @Zaghawa / #6558155 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2506815",
          "cefr_level": "A1",
          "word_slugs": [
            "hinzu-adv"
          ]
        },
        {
          "id": "611799",
          "text": "Füge keine Anmerkungen hinzu.",
          "translation": "Не добавляй примечаний.",
          "source": "Tatoeba #611799 @MUIRIEL / #2903171 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/611799",
          "cefr_level": "A1",
          "word_slugs": [
            "hinzu-adv"
          ]
        },
        {
          "id": "383104",
          "text": "Fügen Sie das Fleisch hinzu.",
          "translation": "Добавьте мясо.",
          "source": "Tatoeba #383104 @MUIRIEL / #1223182 @poji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/383104",
          "cefr_level": "A1",
          "word_slugs": [
            "hinzu-adv"
          ]
        }
