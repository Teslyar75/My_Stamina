    {
      "slug": "grösseren-adj",
      "lemma": "größeren",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5193,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gross:",
          "strong genitive masculine/neuter singular comparative degree",
          "inflection of gross:",
          "weak/mixed genitive/dative all-gender singular comparative degree"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8516485",
          "text": "Ich will einen größeren Kühlschrank.",
          "translation": "Я хочу холодильник побольше.",
          "source": "Tatoeba #8516485 @Luiaard / #8064602 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8516485",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseren-adj"
          ]
        },
        {
          "id": "8066595",
          "text": "Wir brauchen einen größeren Kühlschrank.",
          "translation": "Нам нужен холодильник побольше.",
          "source": "Tatoeba #8066595 @Pfirsichbaeumchen / #8064604 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8066595",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseren-adj"
          ]
        },
        {
          "id": "3421362",
          "text": "Tom sucht nach einer größeren Wohnung.",
          "translation": "Том ищет квартиру побольше.",
          "source": "Tatoeba #3421362 @a_coder / #8678883 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3421362",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseren-adj"
          ]
        },
        {
          "id": "759210",
          "text": "Er sucht im Moment nach einem größeren Haus.",
          "translation": "Сейчас он ищет дом побольше.",
          "source": "Tatoeba #759210 @Bellinger / #3319000 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/759210",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseren-adj"
          ]
        },
        {
          "id": "13652455",
          "text": "Es gibt keinen größeren Schatz als das Wissen.",
          "translation": "Нет большего сокровища, чем знание.",
          "source": "Tatoeba #13652455 @mhr / #13652258 @Qvadratus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13652455",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseren-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
