    {
      "slug": "erhält-verb",
      "lemma": "erhält",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5367,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third-person singular present of erhalten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1833444",
          "text": "Wenn man 3 und 3 zusammenzählt, erhält man 6.",
          "translation": "Если сложить три и три, получится шесть.",
          "source": "Tatoeba #1833444 @Wauzl / #12714205 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1833444",
          "cefr_level": "A1",
          "word_slugs": [
            "erhält-verb"
          ]
        },
        {
          "id": "773916",
          "text": "Wenn man Blau und Rot mischt, erhält man Violett.",
          "translation": "Если смешать синий и красный, получится фиолетовый.",
          "source": "Tatoeba #773916 @Pfirsichbaeumchen / #2383825 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/773916",
          "cefr_level": "A1",
          "word_slugs": [
            "erhält-verb"
          ]
        },
        {
          "id": "14089220",
          "text": "Wenn man alle Farben mischt, erhält man einen grau-braun-rötlichen Ton.",
          "translation": "Если смешать все цвета, получится серо-буро-малиновый.",
          "source": "Tatoeba #14089220 @mhr / #14089185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14089220",
          "cefr_level": "A1",
          "word_slugs": [
            "erhält-verb"
          ]
        }
      ],
