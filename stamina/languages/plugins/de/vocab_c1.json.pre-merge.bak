    {
      "slug": "amsterdam-name",
      "lemma": "Amsterdam",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9094,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Amsterdam (a city and municipality of North Holland, Netherlands; the capital city of the Netherlands)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6447540",
          "text": "Amsterdam ist eine fahrradfreundliche Stadt.",
          "translation": "Амстердам - город, удобный для велосипедистов.",
          "source": "Tatoeba #6447540 @Pfirsichbaeumchen / #6447704 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6447540",
          "cefr_level": "A1",
          "word_slugs": [
            "amsterdam-name"
          ]
        },
        {
          "id": "5126097",
          "text": "Amsterdam ist berühmt für seine Grachten.",
          "translation": "Амстердам знаменит своими каналами.",
          "source": "Tatoeba #5126097 @Pfirsichbaeumchen / #5119803 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5126097",
          "cefr_level": "A1",
          "word_slugs": [
            "amsterdam-name"
          ]
        },
        {
          "id": "522281",
          "text": "Die Hauptstadt der Niederlande ist Amsterdam.",
          "translation": "Столица Нидерландов - Амстердам.",
          "source": "Tatoeba #522281 @Espi / #2496172 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/522281",
          "cefr_level": "A1",
          "word_slugs": [
            "amsterdam-name"
          ]
        },
        {
          "id": "5028748",
          "text": "„Wo wohntest du?“ – „Ich wohnte in Amsterdam.“",
          "translation": "\"Где ты жил?\" - \"Я жил в Амстердаме\".",
          "source": "Tatoeba #5028748 @Tamy / #9019412 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5028748",
          "cefr_level": "A1",
          "word_slugs": [
            "amsterdam-name"
          ]
        },
        {
          "id": "9025611",
          "text": "„Wo wohnten Sie?“ – „Ich wohnte in Amsterdam.“",
          "translation": "\"Где Вы жили?\" - \"Я жил в Амстердаме\".",
          "source": "Tatoeba #9025611 @Pfirsichbaeumchen / #9019413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9025611",
          "cefr_level": "A1",
          "word_slugs": [
            "amsterdam-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "arbeitszimmer-noun",
      "lemma": "Arbeitszimmer",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9095,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "workroom, study (room for work, typically in a private house)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "913889",
          "text": "Das ist mein Arbeitszimmer.",
          "translation": "Это мой рабочий кабинет.",
          "source": "Tatoeba #913889 @Esperantostern / #5657351 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/913889",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeitszimmer-noun"
          ]
        },
        {
          "id": "5826405",
          "text": "Tom ging in Marias Arbeitszimmer.",
          "translation": "Том вошёл в кабинет Мэри.",
          "source": "Tatoeba #5826405 @Pfirsichbaeumchen / #5041455 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5826405",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeitszimmer-noun"
          ]
        },
        {
          "id": "400714",
          "text": "Diese Tür führt ins Arbeitszimmer.",
          "translation": "Эта дверь ведёт в кабинет.",
          "source": "Tatoeba #400714 @xtofu80 / #400720 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/400714",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeitszimmer-noun"
          ]
        },
        {
          "id": "6690852",
          "text": "In meinem Arbeitszimmer bin ich allein.",
          "translation": "В моём рабочем кабинете я сижу один.",
          "source": "Tatoeba #6690852 @brauchinet / #6695069 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6690852",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeitszimmer-noun"
          ]
        },
        {
          "id": "2391190",
          "text": "Sie ging im Arbeitszimmer auf und ab.",
          "translation": "Она ходила взад и вперёд по кабинету.",
          "source": "Tatoeba #2391190 @al_ex_an_der / #2391182 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2391190",
          "cefr_level": "A1",
          "word_slugs": [
            "arbeitszimmer-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
