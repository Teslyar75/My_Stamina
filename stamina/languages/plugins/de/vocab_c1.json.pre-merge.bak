      "gender": null,
      "examples": [
        {
          "id": "6391807",
          "text": "Jeder hat Schwächen.",
          "translation": "У всех есть слабости.",
          "source": "Tatoeba #6391807 @Pfirsichbaeumchen / #3561513 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6391807",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächen-noun"
          ]
        },
        {
          "id": "3829821",
          "text": "Ich kenne meine Schwächen.",
          "translation": "Я знаю свои слабости.",
          "source": "Tatoeba #3829821 @Tlustulimu / #3829814 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3829821",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächen-noun"
          ]
        },
        {
          "id": "7411230",
          "text": "Tom kennt Marias Schwächen.",
          "translation": "Том знает слабости Мэри.",
          "source": "Tatoeba #7411230 @manese / #7411677 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7411230",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächen-noun"
          ]
        },
        {
          "id": "398902",
          "text": "Jeder hat seine Stärken und Schwächen.",
          "translation": "У каждого есть сильные и слабые стороны.",
          "source": "Tatoeba #398902 @MUIRIEL / #5585 @Ann74 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398902",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächen-noun"
          ]
        },
        {
          "id": "2943492",
