      "gender": null,
      "examples": [
        {
          "id": "4485960",
          "text": "Wir alle wurden Kommunisten.",
          "translation": "Мы все стали коммунистами.",
          "source": "Tatoeba #4485960 @Pfirsichbaeumchen / #4485955 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4485960",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunisten-noun"
          ]
        },
        {
          "id": "4485961",
          "text": "Wir sind alle Kommunisten geworden.",
          "translation": "Мы все стали коммунистами.",
          "source": "Tatoeba #4485961 @Pfirsichbaeumchen / #4485955 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4485961",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunisten-noun"
          ]
        },
        {
          "id": "1953258",
          "text": "Die Kommunisten leugnen die Existenz Gottes.",
          "translation": "Коммунисты отрицают существование Бога.",
          "source": "Tatoeba #1953258 @al_ex_an_der / #1953255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1953258",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunisten-noun"
          ]
        },
        {
          "id": "1953259",
          "text": "Die Kommunisten bestreiten die Existenz Gottes.",
          "translation": "Коммунисты отрицают существование Бога.",
          "source": "Tatoeba #1953259 @al_ex_an_der / #1953255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1953259",
          "cefr_level": "A1",
          "word_slugs": [
            "kommunisten-noun"
          ]
        }
      ],
