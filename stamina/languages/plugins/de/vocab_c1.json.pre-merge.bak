    {
      "slug": "gebunden-verb",
      "lemma": "gebunden",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5653,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of binden"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1231176",
          "text": "Mir sind die Hände gebunden.",
          "translation": "У меня руки связаны.",
          "source": "Tatoeba #1231176 @Esperantostern / #8889426 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1231176",
          "cefr_level": "A1",
          "word_slugs": [
            "gebunden-verb"
          ]
        },
        {
          "id": "4444017",
          "text": "Deine Krawatte ist nicht richtig gebunden.",
          "translation": "У тебя галстук неправильно завязан.",
          "source": "Tatoeba #4444017 @al_ex_an_der / #5897234 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4444017",
          "cefr_level": "A1",
          "word_slugs": [
            "gebunden-verb"
          ]
        },
        {
          "id": "1282709",
          "text": "Kannst du mir zeigen, wie ein Schlips gebunden wird?",
          "translation": "Не мог бы ты мне показать, как завязывать галстук?",
          "source": "Tatoeba #1282709 @Esperantostern / #4932134 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1282709",
          "cefr_level": "A1",
          "word_slugs": [
            "gebunden-verb"
          ]
        },
        {
          "id": "7528678",
          "text": "Wir würden euch gerne helfen, aber unsere Hände sind gebunden.",
          "translation": "Мы бы вам с радостью помогли, но у нас связаны руки.",
          "source": "Tatoeba #7528678 @raggione / #7529830 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7528678",
          "cefr_level": "A1",
