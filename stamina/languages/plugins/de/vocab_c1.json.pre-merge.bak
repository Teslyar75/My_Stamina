    {
      "slug": "schlimmen-adj",
      "lemma": "schlimmen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7086,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schlimm:",
          "strong genitive masculine/neuter singular",
          "inflection of schlimm:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8662422",
          "text": "Tom wohnt in einem schlimmen Stadtteil.",
          "translation": "Том живёт в плохом районе.",
