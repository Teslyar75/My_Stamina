    {
      "slug": "sünder-noun",
      "lemma": "Sünder",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8164,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "грешник"
        ],
        "en": [
          "sinner"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "8300821",
          "text": "Du bist ein Sünder.",
          "translation": "Ты грешник.",
          "source": "Tatoeba #8300821 @GuidoW / #8300823 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8300821",
          "cefr_level": "A1",
          "word_slugs": [
            "sünder-noun"
          ]
        },
        {
          "id": "9081210",
          "text": "Tom ist ein Sünder.",
          "translation": "Том — грешник.",
          "source": "Tatoeba #9081210 @Pfirsichbaeumchen / #13673631 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9081210",
          "cefr_level": "A1",
          "word_slugs": [
            "sünder-noun"
          ]
        },
        {
          "id": "2204761",
          "text": "Jeder Mensch ist ein Sünder.",
          "translation": "Каждый человек — грешник.",
          "source": "Tatoeba #2204761 @Manfredo / #5618864 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2204761",
          "cefr_level": "A1",
          "word_slugs": [
            "sünder-noun"
          ]
        },
        {
          "id": "4461856",
          "text": "Jeder Heilige hat eine Vergangenheit, und jeder Sünder hat eine Zukunft.",
          "translation": "У каждого святого есть прошлое, у каждого грешника есть будущее.",
          "source": "Tatoeba #4461856 @Pfirsichbaeumchen / #2242005 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4461856",
          "cefr_level": "A1",
          "word_slugs": [
            "sünder-noun"
          ]
        },
        {
          "id": "4969664",
          "text": "Es gibt keinen Heiligen ohne Vergangenheit und keinen Sünder ohne Zukunft.",
          "translation": "Не бывает святых без прошлого и грешников без будущего.",
          "source": "Tatoeba #4969664 @Esperantostern / #5618879 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4969664",
          "cefr_level": "A1",
          "word_slugs": [
            "sünder-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Sünder",
        "nominative_pl": ""
      }
    },
    {
