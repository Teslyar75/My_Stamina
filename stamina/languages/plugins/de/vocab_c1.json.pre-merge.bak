    {
      "slug": "schein-noun",
      "lemma": "Schein",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6499,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сияние"
        ],
        "en": [
          "shine, gleam, flash",
          "semblance, appearance",
          "certificate, ticket, bill, note",
          "ellipsis of Geldschein: banknote"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1080385",
          "text": "Der Schein trügt.",
          "translation": "Внешность может быть обманчива.",
          "source": "Tatoeba #1080385 @Esperantostern / #1510308 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1080385",
          "cefr_level": "A1",
          "word_slugs": [
            "schein-noun"
          ]
        },
        {
          "id": "13925430",
          "text": "Das ist nur Schein.",
          "translation": "Это видимость.",
          "source": "Tatoeba #13925430 @IAlexI / #9076988 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13925430",
          "cefr_level": "A1",
          "word_slugs": [
            "schein-noun"
          ]
        },
        {
          "id": "2978529",
          "text": "Der Schein kann trügen.",
          "translation": "Внешность может быть обманчива.",
          "source": "Tatoeba #2978529 @freddy1 / #1510308 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2978529",
          "cefr_level": "A1",
          "word_slugs": [
            "schein-noun"
          ]
        },
        {
          "id": "365912",
          "text": "Können Sie diesen 10-Dollar-Schein wechseln?",
          "translation": "Не могли бы вы разменять эту десятидолларовую купюру?",
          "source": "Tatoeba #365912 @Wolf / #2930973 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/365912",
          "cefr_level": "A1",
          "word_slugs": [
            "schein-noun"
          ]
        },
        {
          "id": "725597",
          "text": "Können Sie einen 10 000-Yen-Schein wechseln?",
          "translation": "Вы можете разменять купюру в десять тысяч иен?",
          "source": "Tatoeba #725597 @Dejo / #8615557 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/725597",
          "cefr_level": "A1",
          "word_slugs": [
            "schein-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
