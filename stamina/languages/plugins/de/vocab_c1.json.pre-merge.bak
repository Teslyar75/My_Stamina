      "gender": null,
      "examples": [
        {
          "id": "9966128",
          "text": "Ein 1-Yen-Stück herzustellen kostet 3 Yen.",
          "translation": "Чеканка монеты в одну иену обходится в три иены.",
          "source": "Tatoeba #9966128 @Pfirsichbaeumchen / #9966131 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9966128",
          "cefr_level": "A1",
          "word_slugs": [
            "herzustellen-verb"
          ]
        },
        {
          "id": "5347906",
          "text": "Morgen probiere ich mal, aus schwarzen Johannisbeeren Likör herzustellen.",
