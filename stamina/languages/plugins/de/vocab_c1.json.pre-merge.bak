        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8388618",
          "text": "Gewalt erzeugt Gegengewalt.",
          "translation": "Насилие порождает ответное насилие.",
          "source": "Tatoeba #8388618 @Luiaard / #9105870 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8388618",
          "cefr_level": "A1",
          "word_slugs": [
            "erzeugt-verb"
          ]
        },
        {
          "id": "12735490",
          "text": "Zwang erzeugt keine Liebe.",
          "translation": "Насильно мил не будешь.",
          "source": "Tatoeba #12735490 @Bernie75 / #3207792 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12735490",
          "cefr_level": "A1",
          "word_slugs": [
            "erzeugt-verb"
          ]
        },
        {
          "id": "7757557",
          "text": "Honig wird von Bienen erzeugt.",
          "translation": "Мёд делают пчёлы.",
          "source": "Tatoeba #7757557 @Pfirsichbaeumchen / #10921594 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7757557",
          "cefr_level": "A1",
          "word_slugs": [
            "erzeugt-verb"
          ]
        },
        {
          "id": "3219236",
          "text": "Die Furigana werden automatisch erzeugt.",
          "translation": "Фуригана генерируется автоматически.",
          "source": "Tatoeba #3219236 @Pfirsichbaeumchen / #5274420 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3219236",
          "cefr_level": "A1",
          "word_slugs": [
            "erzeugt-verb"
          ]
        },
        {
          "id": "1645628",
          "text": "Diese Organe wurden in Reagenzgläsern erzeugt.",
          "translation": "Эти органы были выращены в пробирках.",
