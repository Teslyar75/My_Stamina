    {
      "slug": "empfehle-verb",
      "lemma": "empfehle",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6883,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of empfehlen:",
          "first-person singular present",
          "inflection of empfehlen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6783230",
          "text": "Ich empfehle dir dieses Gericht.",
          "translation": "Я рекомендую тебе это блюдо.",
          "source": "Tatoeba #6783230 @felix63 / #12097800 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6783230",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehle-verb"
          ]
        },
        {
          "id": "13811291",
          "text": "Ich empfehle euch, eine Zusatzversicherung abzuschließen.",
          "translation": "Советую вам оформить расширенную страховку.",
          "source": "Tatoeba #13811291 @mhr / #13811278 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13811291",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehle-verb"
          ]
        },
        {
          "id": "9402242",
          "text": "Ich empfehle euch, es selbst zu tun.",
          "translation": "Советую вам сделать это самим.",
          "source": "Tatoeba #9402242 @Yorwba / #9461521 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9402242",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehle-verb"
          ]
        },
        {
          "id": "2461950",
          "text": "Ich empfehle euch, den Zug zu nehmen.",
          "translation": "Я советую вам ехать поездом.",
          "source": "Tatoeba #2461950 @Zaghawa / #7949864 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2461950",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehle-verb"
          ]
        },
        {
          "id": "6783245",
          "text": "Ich empfehle dir, dieses Buch zu lesen.",
          "translation": "Рекомендую тебе прочесть эту книгу.",
          "source": "Tatoeba #6783245 @felix63 / #12749051 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6783245",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehle-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
