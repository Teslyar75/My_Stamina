    {
      "slug": "bestimmtes-adj",
      "lemma": "bestimmtes",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7554,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of bestimmt"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13142981",
          "text": "Willst du etwas Bestimmtes?",
          "translation": "Ты хочешь что-нибудь конкретное?",
          "source": "Tatoeba #13142981 @frpzzd / #13142987 @frpzzd (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13142981",
          "cefr_level": "A1",
          "word_slugs": [
            "bestimmtes-adj"
          ]
        },
        {
          "id": "1983298",
          "text": "Er hat kein bestimmtes Ziel.",
          "translation": "У него нет определённой цели.",
          "source": "Tatoeba #1983298 @Alois / #5008367 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1983298",
          "cefr_level": "A1",
          "word_slugs": [
            "bestimmtes-adj"
          ]
        },
        {
          "id": "6783355",
          "text": "Suchen Sie etwas Bestimmtes? Kann ich Ihnen helfen?",
          "translation": "Вы что-то определённое ищете? Я могу Вам помочь?",
          "source": "Tatoeba #6783355 @felix63 / #6783434 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6783355",
          "cefr_level": "A1",
          "word_slugs": [
            "bestimmtes-adj"
          ]
        },
        {
          "id": "12423118",
          "text": "Jeder Antikörper zielt auf ein bestimmtes Bakterium oder Virus ab.",
          "translation": "Каждое антитело нацелено на определённую бактерию или вирус.",
          "source": "Tatoeba #12423118 @Yorwba / #12423710 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12423118",
          "cefr_level": "A1",
          "word_slugs": [
            "bestimmtes-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
