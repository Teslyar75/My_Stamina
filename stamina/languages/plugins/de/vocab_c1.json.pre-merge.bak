    {
      "slug": "gerannt-verb",
      "lemma": "gerannt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7218,
      "frequency_band": "goethe-c1",
      "translations": {
