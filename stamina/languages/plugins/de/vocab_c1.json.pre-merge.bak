    {
      "slug": "wiederhaben-verb",
      "lemma": "wiederhaben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6965,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to have back"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9496415",
          "text": "Ich wollte meine Kinder wiederhaben.",
          "translation": "Я хотела вернуть себе детей.",
          "source": "Tatoeba #9496415 @Pfirsichbaeumchen / #9495818 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9496415",
          "cefr_level": "A1",
          "word_slugs": [
            "wiederhaben-verb"
          ]
        },
        {
          "id": "3180429",
          "text": "Ich will meinen Schlüssel wiederhaben.",
          "translation": "Я хочу, чтобы мне вернули мой ключ.",
          "source": "Tatoeba #3180429 @Pfirsichbaeumchen / #3282643 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3180429",
          "cefr_level": "A1",
          "word_slugs": [
            "wiederhaben-verb"
          ]
        },
        {
          "id": "5280126",
          "text": "Ich will meine zwanzig Dollar wiederhaben.",
          "translation": "Я хочу получить обратно свои 20 долларов.",
          "source": "Tatoeba #5280126 @Pfirsichbaeumchen / #5280127 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5280126",
          "cefr_level": "A1",
          "word_slugs": [
            "wiederhaben-verb"
          ]
        },
        {
          "id": "3008422",
          "text": "Du hast meine Sonnenbrille, und die will ich wiederhaben.",
          "translation": "У тебя мои солнечные очки, и я хочу их назад.",
          "source": "Tatoeba #3008422 @Pfirsichbaeumchen / #2031671 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3008422",
          "cefr_level": "A1",
          "word_slugs": [
            "wiederhaben-verb"
          ]
        },
        {
          "id": "10289356",
          "text": "Wir sind froh, dass wir dich wiederhaben! Wir haben dich sehr vermisst!",
          "translation": "Мы рады, что ты снова с нами! Мы по тебе очень скучали!",
          "source": "Tatoeba #10289356 @Pfirsichbaeumchen / #10289362 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10289356",
          "cefr_level": "A1",
          "word_slugs": [
            "wiederhaben-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
