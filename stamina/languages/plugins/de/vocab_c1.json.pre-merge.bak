          ]
        },
        {
          "id": "365710",
          "text": "Seine Worte erwiesen sich als wahr.",
          "translation": "Его слова подтвердились.",
          "source": "Tatoeba #365710 @lilygilder / #8437343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/365710",
          "cefr_level": "A1",
