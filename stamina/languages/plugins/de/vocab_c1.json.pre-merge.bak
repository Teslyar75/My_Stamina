        ],
        "en": [
          "alternative spelling of Club",
          "The continuation of a political party in the National Council of Austria and the parliament of an Austrian federal state, in other parliaments called Fraktion"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2185723",
          "text": "Willkommen im Klub!",
          "translation": "Добро пожаловать в клуб!",
          "source": "Tatoeba #2185723 @Pfirsichbaeumchen / #4287269 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2185723",
          "cefr_level": "A1",
          "word_slugs": [
            "klub-noun"
          ]
        },
        {
          "id": "10650780",
          "text": "Willkommen im Klub, Tom.",
          "translation": "Добро пожаловать в клуб, Том.",
          "source": "Tatoeba #10650780 @Adelpa / #12267834 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10650780",
          "cefr_level": "A1",
          "word_slugs": [
            "klub-noun"
          ]
        },
        {
          "id": "1704071",
          "text": "Ich gehöre nicht zum Klub.",
          "translation": "Я не состою в клубе.",
          "source": "Tatoeba #1704071 @Hans07 / #11959751 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1704071",
          "cefr_level": "A1",
          "word_slugs": [
            "klub-noun"
          ]
        },
        {
          "id": "934286",
          "text": "Dieser Klub hat fünfzig Mitglieder.",
          "translation": "В этом клубе пятьдесят членов.",
          "source": "Tatoeba #934286 @Fingerhut / #8765997 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/934286",
          "cefr_level": "A1",
          "word_slugs": [
            "klub-noun"
          ]
        },
        {
          "id": "7018042",
          "text": "Gibt es einen Klub im Dorf?",
          "translation": "Есть ли в посёлке клуб?",
          "source": "Tatoeba #7018042 @Esperantostern / #2386184 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7018042",
          "cefr_level": "A1",
          "word_slugs": [
            "klub-noun"
          ]
        }
      ],
