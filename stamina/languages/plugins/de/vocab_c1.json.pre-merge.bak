    {
      "slug": "shoppen-verb",
      "lemma": "shoppen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9922,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to shop"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "842040",
          "text": "Mein Hobby ist shoppen.",
          "translation": "Моё увлечение - делать покупки.",
          "source": "Tatoeba #842040 @Espi / #886839 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/842040",
          "cefr_level": "A1",
          "word_slugs": [
            "shoppen-verb"
          ]
        },
        {
          "id": "13850592",
          "text": "Wir gehen shoppen; wollt ihr mitkommen?",
          "translation": "Мы по магазинам. Хотите с нами?",
          "source": "Tatoeba #13850592 @Vortarulo / #13850593 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13850592",
          "cefr_level": "A1",
          "word_slugs": [
            "shoppen-verb"
          ]
        },
        {
          "id": "418974",
          "text": "Hast du Lust, mit mir shoppen zu gehen?",
          "translation": "Нет желания пройтись со мной по магазинам?",
          "source": "Tatoeba #418974 @MUIRIEL / #2749373 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/418974",
          "cefr_level": "A1",
          "word_slugs": [
            "shoppen-verb"
          ]
        },
        {
          "id": "2188305",
          "text": "Ich kümmere mich um die Kinder, während du shoppen gehst.",
          "translation": "Я позабочусь о детях, пока ты в магазине.",
          "source": "Tatoeba #2188305 @Vortarulo / #2576337 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2188305",
          "cefr_level": "A1",
          "word_slugs": [
            "shoppen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
