    {
      "slug": "bereite-verb",
      "lemma": "bereite",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5298,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bereiten:",
          "first-person singular present",
          "inflection of bereiten:",
          "singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3600560",
          "text": "Bereite eine Mehlspeise zu!",
          "translation": "Приготовь чего-нибудь мучного!",
          "source": "Tatoeba #3600560 @al_ex_an_der / #3602651 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3600560",
          "cefr_level": "A1",
          "word_slugs": [
            "bereite-verb"
          ]
        },
        {
          "id": "7480135",
          "text": "Er sagte, das bereite ihm Sorgen.",
          "translation": "Он сказал, что это его беспокоит.",
          "source": "Tatoeba #7480135 @Pfirsichbaeumchen / #7480123 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7480135",
          "cefr_level": "A1",
          "word_slugs": [
            "bereite-verb"
          ]
        },
        {
          "id": "12293339",
          "text": "Bereite dich auf die Prüfung vor!",
          "translation": "Готовься к экзамену.",
          "source": "Tatoeba #12293339 @Pfirsichbaeumchen / #12292952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12293339",
          "cefr_level": "A1",
          "word_slugs": [
            "bereite-verb"
          ]
        },
        {
          "id": "7480136",
          "text": "Er sagte, dass ihm das Sorgen bereite.",
          "translation": "Он сказал, что это его беспокоит.",
          "source": "Tatoeba #7480136 @Pfirsichbaeumchen / #7480123 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7480136",
          "cefr_level": "A1",
          "word_slugs": [
            "bereite-verb"
          ]
        },
        {
          "id": "4627621",
          "text": "Ich bereite nicht das Abendessen für sie.",
          "translation": "Я не готовлю им ужин.",
          "source": "Tatoeba #4627621 @Tamy / #13949900 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4627621",
          "cefr_level": "A1",
          "word_slugs": [
            "bereite-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
