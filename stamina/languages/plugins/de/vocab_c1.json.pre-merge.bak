    {
      "slug": "faden-noun",
      "lemma": "Faden",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7200,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "нить",
          "нитка"
        ],
        "en": [
          "yarn, thread",
          "fathom",
          "suture"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "4259715",
          "text": "Die Seidenraupe spinnt einen Faden.",
          "translation": "Шелкопряд плетёт нить.",
          "source": "Tatoeba #4259715 @Esperantostern / #4477759 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4259715",
          "cefr_level": "A1",
          "word_slugs": [
            "faden-noun"
          ]
        },
        {
          "id": "7223136",
          "text": "Sie näht mit Nadel und Faden.",
          "translation": "Она шьёт иголкой и ниткой.",
          "source": "Tatoeba #7223136 @Pfirsichbaeumchen / #1941621 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7223136",
          "cefr_level": "A1",
          "word_slugs": [
            "faden-noun"
          ]
        },
        {
          "id": "1016780",
          "text": "Ihr Leben hing am seidenen Faden.",
          "translation": "Её жизнь держалась на волоске.",
          "source": "Tatoeba #1016780 @MUIRIEL / #6555184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1016780",
          "cefr_level": "A1",
          "word_slugs": [
            "faden-noun"
          ]
        },
        {
          "id": "1016781",
          "text": "Sein Leben hing am seidenen Faden.",
          "translation": "Его жизнь держалась на волоске.",
          "source": "Tatoeba #1016781 @MUIRIEL / #6555183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1016781",
          "cefr_level": "A1",
          "word_slugs": [
            "faden-noun"
          ]
        },
        {
          "id": "12460209",
          "text": "Dieser Faden ist dünner als ein Menschenhaar.",
          "translation": "Эта нить тоньше человеческого волоса.",
          "source": "Tatoeba #12460209 @Waldelfe / #4777319 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12460209",
          "cefr_level": "A1",
          "word_slugs": [
            "faden-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
