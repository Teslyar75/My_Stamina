    {
      "slug": "zerstörte-verb",
      "lemma": "zerstörte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9017,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of zerstören:",
          "first/third-person singular preterite",
          "inflection of zerstören:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1955591",
          "text": "Der Taifun zerstörte viele Häuser.",
          "translation": "Тайфун разрушил много домов.",
          "source": "Tatoeba #1955591 @Tamy / #894648 @pauldhunt (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1955591",
          "cefr_level": "A1",
          "word_slugs": [
            "zerstörte-verb"
          ]
        },
        {
          "id": "801475",
          "text": "Ein Erdbeben zerstörte das Gebäude.",
          "translation": "Землетрясение разрушило здание.",
          "source": "Tatoeba #801475 @al_ex_an_der / #3070104 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/801475",
          "cefr_level": "A1",
          "word_slugs": [
            "zerstörte-verb"
          ]
        },
        {
          "id": "782141",
          "text": "Das Feuer zerstörte das hohe Gebäude.",
          "translation": "Огонь разрушил высокое здание.",
          "source": "Tatoeba #782141 @Hans_Adler / #1591361 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/782141",
          "cefr_level": "A1",
          "word_slugs": [
            "zerstörte-verb"
          ]
        },
        {
          "id": "1392930",
          "text": "Der Tornado zerstörte das ganze Dorf.",
          "translation": "Торнадо разрушил всю деревню.",
          "source": "Tatoeba #1392930 @Esperantostern / #6915682 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1392930",
          "cefr_level": "A1",
          "word_slugs": [
            "zerstörte-verb"
          ]
        },
        {
          "id": "614734",
          "text": "Der Teufel zerstörte Hiroshima und Nagasaki.",
          "translation": "Дьявол уничтожил Хиросиму и Нагасаки.",
          "source": "Tatoeba #614734 @samueldora / #614761 @igor_chubin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/614734",
          "cefr_level": "A1",
          "word_slugs": [
            "zerstörte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
