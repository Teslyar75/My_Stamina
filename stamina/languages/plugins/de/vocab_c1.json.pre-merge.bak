    {
      "slug": "grossem-adj",
      "lemma": "großem",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6766,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong dative masculine/neuter singular of gross"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "341024",
          "text": "Diese Uhr ist von großem Wert.",
          "translation": "Это очень ценные часы.",
          "source": "Tatoeba #341024 @tinacalysto / #10323691 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341024",
          "cefr_level": "A1",
          "word_slugs": [
            "grossem-adj"
          ]
        },
        {
          "id": "3563435",
          "text": "Wir haben dies mit großem Vergnügen getan.",
          "translation": "Мы сделали это с большим удовольствием.",
          "source": "Tatoeba #3563435 @al_ex_an_der / #11866909 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3563435",
          "cefr_level": "A1",
          "word_slugs": [
            "grossem-adj"
          ]
        },
        {
          "id": "629252",
          "text": "Mit großem Vergnügen lesen wir Äsops Fabeln.",
          "translation": "С большим удовольствием мы читаем басни Эзопа.",
          "source": "Tatoeba #629252 @kolonjano / #5537606 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/629252",
          "cefr_level": "A1",
          "word_slugs": [
            "grossem-adj"
          ]
        },
        {
          "id": "2861942",
          "text": "Dieses Wörterbuch ist für uns von großem Wert.",
          "translation": "Этот словарь представляет для нас большую ценность.",
          "source": "Tatoeba #2861942 @Tamy / #12221989 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2861942",
          "cefr_level": "A1",
          "word_slugs": [
            "grossem-adj"
          ]
        },
        {
          "id": "4153276",
          "text": "Die Phantasie ist eine Eigenschaft von großem Wert.",
          "translation": "Фантазия есть качество величайшей ценности.",
          "source": "Tatoeba #4153276 @AqQoyriq_1 / #4153270 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4153276",
          "cefr_level": "A1",
          "word_slugs": [
            "grossem-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
