    {
      "slug": "gelobt-verb",
      "lemma": "gelobt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8476,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person plural present of geloben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6843609",
          "text": "Tom hat mich gelobt.",
          "translation": "Том похвалил меня.",
          "source": "Tatoeba #6843609 @felix63 / #6845613 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6843609",
          "cefr_level": "A1",
          "word_slugs": [
            "gelobt-verb"
          ]
        },
        {
          "id": "4040125",
          "text": "Alle haben mich gelobt.",
          "translation": "Меня все хвалили.",
          "source": "Tatoeba #4040125 @brauchinet / #14054014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4040125",
          "cefr_level": "A1",
          "word_slugs": [
            "gelobt-verb"
          ]
        },
        {
          "id": "1520279",
          "text": "Ihr Lehrer hat sie gelobt.",
          "translation": "Их учитель их похвалил.",
          "source": "Tatoeba #1520279 @Pfirsichbaeumchen / #12628724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1520279",
          "cefr_level": "A1",
          "word_slugs": [
            "gelobt-verb"
          ]
        },
        {
          "id": "12722477",
          "text": "Er hat seinen Sohn gelobt.",
          "translation": "Он хвалил своего сына.",
          "source": "Tatoeba #12722477 @mhr / #12722417 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12722477",
          "cefr_level": "A1",
          "word_slugs": [
            "gelobt-verb"
          ]
        },
        {
          "id": "12722484",
          "text": "Er hat dessen Sohn gelobt.",
          "translation": "Он хвалил его сына.",
          "source": "Tatoeba #12722484 @mhr / #12722416 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12722484",
