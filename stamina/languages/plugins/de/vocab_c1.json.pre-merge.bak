        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2513778",
          "text": "Der Soldat ist gerannt.",
          "translation": "Солдат побежал.",
          "source": "Tatoeba #2513778 @Zaghawa / #5699975 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2513778",
          "cefr_level": "A1",
          "word_slugs": [
            "gerannt-verb"
          ]
        },
        {
          "id": "12997312",
          "text": "Wir sind 10 Kilometer gerannt.",
          "translation": "Мы пробежали десять километров.",
          "source": "Tatoeba #12997312 @Vortarulo / #577482 @Maksimo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12997312",
          "cefr_level": "A1",
          "word_slugs": [
            "gerannt-verb"
          ]
        },
        {
          "id": "556098",
          "text": "Ich bin gerannt, um pünktlich zu sein.",
          "translation": "Я побежал, чтобы успеть вовремя.",
          "source": "Tatoeba #556098 @cost / #9352716 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/556098",
          "cefr_level": "A1",
          "word_slugs": [
            "gerannt-verb"
          ]
        },
        {
          "id": "10527935",
          "text": "Ich bin den ganzen Weg zum Bahnhof gerannt.",
          "translation": "Я пробежал весь путь до станции.",
          "source": "Tatoeba #10527935 @Pfirsichbaeumchen / #6536620 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10527935",
          "cefr_level": "A1",
          "word_slugs": [
            "gerannt-verb"
          ]
        },
        {
          "id": "10527939",
          "text": "Den ganzen Weg zum Bahnhof bin ich gerannt.",
          "translation": "Всю дорогу до вокзала я бежал.",
          "source": "Tatoeba #10527939 @Pfirsichbaeumchen / #10527790 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10527939",
          "cefr_level": "A1",
