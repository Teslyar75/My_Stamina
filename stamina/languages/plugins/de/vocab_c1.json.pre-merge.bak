    {
      "slug": "schalt-verb",
      "lemma": "schalt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6884,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schalen:",
          "third-person singular present",
          "inflection of schalen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12121128",
          "text": "Schalt das Radio aus!",
          "translation": "Выключи радио!",
          "source": "Tatoeba #12121128 @Pfirsichbaeumchen / #10346195 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12121128",
          "cefr_level": "A1",
          "word_slugs": [
