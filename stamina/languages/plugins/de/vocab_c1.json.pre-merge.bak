    {
      "slug": "gewidmet-verb",
      "lemma": "gewidmet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9705,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of widmen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12821505",
          "text": "Wem ist dieses Denkmal gewidmet?",
          "translation": "Кому поставлен этот памятник?",
          "source": "Tatoeba #12821505 @mhr / #12821464 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12821505",
          "cefr_level": "A1",
          "word_slugs": [
            "gewidmet-verb"
          ]
        },
        {
          "id": "12821519",
          "text": "Das Denkmal ist einem Schriftsteller gewidmet.",
          "translation": "Это памятник писателю.",
          "source": "Tatoeba #12821519 @mhr / #12821526 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12821519",
          "cefr_level": "A1",
          "word_slugs": [
            "gewidmet-verb"
          ]
        },
        {
          "id": "13874779",
          "text": "Ich habe diesem Problem große Aufmerksamkeit gewidmet.",
          "translation": "Я уделил большое внимание этой проблеме.",
          "source": "Tatoeba #13874779 @mhr / #13874777 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13874779",
          "cefr_level": "A1",
          "word_slugs": [
            "gewidmet-verb"
          ]
        },
        {
          "id": "12962491",
          "text": "Sie haben der Warnung keinerlei Aufmerksamkeit gewidmet.",
          "translation": "Они не обратили никакого внимания на предупреждение.",
          "source": "Tatoeba #12962491 @mhr / #12962477 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12962491",
          "cefr_level": "A1",
          "word_slugs": [
            "gewidmet-verb"
          ]
        },
        {
          "id": "12599622",
          "text": "Im Buch ist ihr ein ganzes Kapitel gewidmet.",
          "translation": "В книге ей посвящена целая глава.",
          "source": "Tatoeba #12599622 @mhr / #12598016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12599622",
          "cefr_level": "A1",
          "word_slugs": [
            "gewidmet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
