          "source": "Tatoeba #6469892 @Pfirsichbaeumchen / #5217653 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6469892",
          "cefr_level": "A1",
          "word_slugs": [
