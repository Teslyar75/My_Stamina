    {
      "slug": "teilnehmer-noun",
      "lemma": "Teilnehmer",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9698,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "участник"
        ],
        "en": [
          "agent noun of teilnehmen; participant"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "368818",
          "text": "Alle Teilnehmer sind Japaner.",
          "translation": "Все участники - японцы.",
          "source": "Tatoeba #368818 @xtofu80 / #9061293 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/368818",
          "cefr_level": "A1",
          "word_slugs": [
            "teilnehmer-noun"
          ]
        },
        {
          "id": "3120026",
          "text": "Die Teilnehmer der Kundgebung fordern Autonomie.",
          "translation": "Участники митинга требуют автономии.",
          "source": "Tatoeba #3120026 @al_ex_an_der / #3120024 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3120026",
          "cefr_level": "A1",
          "word_slugs": [
            "teilnehmer-noun"
          ]
        },
        {
          "id": "12983702",
          "text": "Die Teilnehmer tauchten ihre Hände in eiskaltes Wasser.",
          "translation": "Участники погрузили руки в ледяную воду.",
          "source": "Tatoeba #12983702 @Stuhr / #13079416 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12983702",
          "cefr_level": "A1",
          "word_slugs": [
            "teilnehmer-noun"
          ]
        },
        {
          "id": "3226920",
          "text": "Fünfzig Teilnehmer des Marathonlaufs nahmen medizinische Hilfe in Anspruch.",
          "translation": "За помощью к медикам обратились пятьдесят участников марафона.",
          "source": "Tatoeba #3226920 @al_ex_an_der / #3226919 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3226920",
          "cefr_level": "A1",
          "word_slugs": [
            "teilnehmer-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Teilnehmer",
        "nominative_pl": ""
      }
