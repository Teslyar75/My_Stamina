        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13281218",
          "text": "Er stiehlt Honig.",
          "translation": "Он ворует мёд.",
          "source": "Tatoeba #13281218 @Waldelfe / #13276769 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13281218",
          "cefr_level": "A1",
          "word_slugs": [
