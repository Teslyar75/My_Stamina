    {
      "slug": "körperlich-adj",
      "lemma": "körperlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7211,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "физический",
          "телесный"
        ],
        "en": [
          "bodily, physical"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12408930",
          "text": "Frauen sind körperlich schwächer als Männer.",
          "translation": "Женщины физически слабее мужчин.",
          "source": "Tatoeba #12408930 @mayabe / #2184126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12408930",
          "cefr_level": "A1",
          "word_slugs": [
            "körperlich-adj"
          ]
        },
        {
          "id": "3332761",
          "text": "Ich möchte körperlich und seelisch stärker werden.",
          "translation": "Я хочу стать сильнее и физически, и духовно.",
          "source": "Tatoeba #3332761 @Pfirsichbaeumchen / #4891541 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3332761",
          "cefr_level": "A1",
          "word_slugs": [
            "körperlich-adj"
          ]
        },
        {
          "id": "13092717",
          "text": "Ich bin dazu körperlich nicht in der Lage.",
          "translation": "Я на это физически неспособен.",
          "source": "Tatoeba #13092717 @Waldelfe / #11843679 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13092717",
          "cefr_level": "A1",
          "word_slugs": [
            "körperlich-adj"
          ]
        },
        {
          "id": "11360628",
          "text": "Sport macht uns gesund, sowohl geistig als auch körperlich.",
          "translation": "Спорт делает нас здоровыми как духовно, так и телесно.",
          "source": "Tatoeba #11360628 @mayabe / #14111080 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11360628",
          "cefr_level": "A1",
          "word_slugs": [
            "körperlich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der körperlich",
        "nominative_pl": ""
      }
