    {
      "slug": "anlügen-verb",
      "lemma": "anlügen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5856,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "лгать ( солгать )"
        ],
        "en": [
          "to lie to, to tell someone a lie, to tell someone lies"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12657381",
          "text": "Tom würde Sie nicht anlügen.",
          "translation": "Том не стал бы Вам лгать.",
          "source": "Tatoeba #12657381 @Waldelfe / #13171107 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12657381",
          "cefr_level": "A1",
          "word_slugs": [
            "anlügen-verb"
          ]
        },
        {
          "id": "5244419",
          "text": "Ich werde dich nicht anlügen.",
          "translation": "Я не буду тебе врать.",
          "source": "Tatoeba #5244419 @christian42 / #4542745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5244419",
          "cefr_level": "A1",
          "word_slugs": [
            "anlügen-verb"
          ]
        },
        {
          "id": "10570449",
          "text": "Hätte ich Sie anlügen sollen?",
          "translation": "Я должен был Вам солгать?",
          "source": "Tatoeba #10570449 @Pfirsichbaeumchen / #12312559 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10570449",
          "cefr_level": "A1",
          "word_slugs": [
            "anlügen-verb"
          ]
        },
        {
          "id": "12501314",
          "text": "Tom will Maria nicht anlügen.",
          "translation": "Том не хочет лгать Мэри.",
