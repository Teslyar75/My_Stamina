      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5118,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of organisieren:",
          "third-person singular present",
          "inflection of organisieren:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13555775",
          "text": "Ich hatte alles organisiert.",
          "translation": "Я всё организовал.",
          "source": "Tatoeba #13555775 @Rovo / #10069034 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13555775",
          "cefr_level": "A1",
          "word_slugs": [
            "organisiert-verb"
          ]
        },
        {
          "id": "11391010",
          "text": "Er ist nicht sehr organisiert.",
          "translation": "Он не очень организован.",
          "source": "Tatoeba #11391010 @felix63 / #11671103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11391010",
          "cefr_level": "A1",
          "word_slugs": [
            "organisiert-verb"
          ]
        },
        {
          "id": "13146119",
          "text": "Ich habe eine Party organisiert.",
