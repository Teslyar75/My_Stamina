    {
      "slug": "jules-noun",
      "lemma": "Jules",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5099,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "10526529",
          "text": "Die Romane von Jules Verne haben praktisch die Zukunft vorhergesagt.",
          "translation": "Романы Жюля Верна практически предсказали будущее.",
          "source": "Tatoeba #10526529 @Pfirsichbaeumchen / #10526129 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10526529",
          "cefr_level": "A1",
          "word_slugs": [
            "jules-noun"
          ]
        },
        {
          "id": "13929059",
          "text": "Jules Verne hat sich eine Reise zum Mond vorgestellt.",
          "translation": "Жюль Верн вообразил путешествие на Луну.",
          "source": "Tatoeba #13929059 @Ioan_Cristian / #13931288 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13929059",
          "cefr_level": "A1",
          "word_slugs": [
