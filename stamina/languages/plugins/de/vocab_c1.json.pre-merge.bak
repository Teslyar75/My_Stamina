          "id": "12831041",
          "text": "Verdächtigt ihr jemanden?",
          "translation": "Вы кого-нибудь подозреваете?",
          "source": "Tatoeba #12831041 @Waldelfe / #9049671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12831041",
          "cefr_level": "A1",
          "word_slugs": [
            "verdächtigt-verb"
          ]
        },
        {
          "id": "13759426",
          "text": "Verdächtigt ihr mich auch?",
          "translation": "Меня вы тоже подозреваете?",
          "source": "Tatoeba #13759426 @mhr / #13759227 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13759426",
          "cefr_level": "A1",
          "word_slugs": [
            "verdächtigt-verb"
          ]
        },
        {
          "id": "672323",
          "text": "Sie wurde der Spionage verdächtigt.",
          "translation": "Её подозревали в шпионаже.",
          "source": "Tatoeba #672323 @samueldora / #12975009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/672323",
          "cefr_level": "A1",
          "word_slugs": [
            "verdächtigt-verb"
          ]
        },
        {
          "id": "12887405",
          "text": "Niemand verdächtigt dich irgend etwas.",
          "translation": "Тебя никто ни в чём не подозревает.",
          "source": "Tatoeba #12887405 @Waldelfe / #10664652 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12887405",
          "cefr_level": "A1",
          "word_slugs": [
            "verdächtigt-verb"
          ]
        },
        {
          "id": "10132274",
          "text": "Sie wird verdächtigt, eine Spionin zu sein.",
          "translation": "Её подозревают в шпионаже.",
          "source": "Tatoeba #10132274 @wolfgangth / #12975008 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10132274",
          "cefr_level": "A1",
          "word_slugs": [
            "verdächtigt-verb"
          ]
        }
      ],
