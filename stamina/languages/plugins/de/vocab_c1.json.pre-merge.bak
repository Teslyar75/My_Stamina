        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7357439",
          "text": "Donald Duck ist eine Ente.",
          "translation": "Дональд Дак - это утка.",
          "source": "Tatoeba #7357439 @manese / #7805075 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7357439",
          "cefr_level": "A1",
          "word_slugs": [
            "donald-name"
          ]
        },
        {
          "id": "8759216",
          "text": "Donald Trump ist ein krankhafter Lügner.",
          "translation": "Дональд Трамп - патологический лжец.",
          "source": "Tatoeba #8759216 @shekitten / #8752729 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8759216",
          "cefr_level": "A1",
          "word_slugs": [
            "donald-name"
          ]
        },
        {
          "id": "8761338",
          "text": "Donald Trump ist ein pathologischer Lügner.",
          "translation": "Дональд Трамп - патологический лжец.",
          "source": "Tatoeba #8761338 @shekitten / #8752729 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8761338",
          "cefr_level": "A1",
          "word_slugs": [
            "donald-name"
          ]
        },
        {
          "id": "13611786",
          "text": "„Kein anderer Präsident hätte das gleiche wie ich getan“, sagte Donald Trump.",
          "translation": "«Ни один президент не сделал бы того же, что я», – сказал Дональд Трамп.",
          "source": "Tatoeba #13611786 @Waldelfe / #13611782 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13611786",
          "cefr_level": "A1",
          "word_slugs": [
            "donald-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
