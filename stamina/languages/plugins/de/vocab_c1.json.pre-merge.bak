      "gender": "f",
      "examples": [
        {
          "id": "6322151",
          "text": "Kein Schmerz ist von Dauer.",
          "translation": "Никакая боль не длится вечно.",
          "source": "Tatoeba #6322151 @raggione / #10627952 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6322151",
          "cefr_level": "A1",
          "word_slugs": [
