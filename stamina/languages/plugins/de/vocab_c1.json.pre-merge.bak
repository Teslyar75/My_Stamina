    {
      "slug": "geheimes-adj",
      "lemma": "geheimes",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9179,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of geheim"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "801449",
          "text": "Wir hatten ein geheimes Treffen.",
          "translation": "У нас была тайная встреча.",
          "source": "Tatoeba #801449 @al_ex_an_der / #1515633 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/801449",
          "cefr_level": "A1",
          "word_slugs": [
            "geheimes-adj"
          ]
        },
        {
          "id": "3587255",
          "text": "Ich fand Toms geheimes Versteck.",
          "translation": "Я нашёл секретное укрытие Тома.",
          "source": "Tatoeba #3587255 @al_ex_an_der / #3589027 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3587255",
          "cefr_level": "A1",
          "word_slugs": [
            "geheimes-adj"
          ]
        },
        {
          "id": "6333413",
          "text": "Siehst du die schwarze Metalltür? Dahinter befindet sich mein geheimes Laboratorium.",
          "translation": "Видишь чёрную металлическую дверь? За ней моя секретная лаборатория.",
          "source": "Tatoeba #6333413 @Pfirsichbaeumchen / #5856726 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6333413",
          "cefr_level": "A1",
          "word_slugs": [
            "geheimes-adj"
          ]
        }
      ],
