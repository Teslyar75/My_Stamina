    {
      "slug": "versetzen-verb",
      "lemma": "versetzen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5675,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "перемещать",
          "приводить",
          "переводить"
        ],
        "en": [
          "to move, displace, especially something heavy or fixed",
          "to transfer (to another position, location, etc.)",
          "to promote, allow to pass (to the next grade)",
          "to put (someone in some mental state)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "373133",
          "text": "Der Glaube kann Berge versetzen.",
          "translation": "Вера может свернуть горы.",
          "source": "Tatoeba #373133 @MUIRIEL / #1525478 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/373133",
          "cefr_level": "A1",
          "word_slugs": [
            "versetzen-verb"
          ]
        },
        {
          "id": "6707846",
          "text": "Versuche, dich in seine Lage zu versetzen!",
          "translation": "Попробуй поставить себя на его место!",
          "source": "Tatoeba #6707846 @Pfirsichbaeumchen / #6712562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6707846",
          "cefr_level": "A1",
          "word_slugs": [
            "versetzen-verb"
          ]
        },
        {
          "id": "1819039",
          "text": "Versuch mal, dich in die Lage deiner Mutter zu versetzen.",
          "translation": "Попробуй поставить себя на место своей матери.",
          "source": "Tatoeba #1819039 @pne / #3236370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1819039",
          "cefr_level": "A1",
          "word_slugs": [
            "versetzen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
