    {
      "slug": "zukünftige-adj",
      "lemma": "zukünftige",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7584,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of zukünftig:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of zukünftig:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7455193",
          "text": "Ich bedauere deine zukünftige Frau.",
          "translation": "Мне жаль твою будущую жену.",
          "source": "Tatoeba #7455193 @Pfirsichbaeumchen / #8832035 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7455193",
          "cefr_level": "A1",
          "word_slugs": [
            "zukünftige-adj"
          ]
        },
        {
          "id": "2997683",
          "text": "Wie werden zukünftige Städte aussehen?",
          "translation": "Как будут выглядеть будущие города?",
          "source": "Tatoeba #2997683 @al_ex_an_der / #2997704 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2997683",
          "cefr_level": "A1",
          "word_slugs": [
            "zukünftige-adj"
          ]
        },
        {
          "id": "7455192",
          "text": "Deine zukünftige Frau tut mir leid.",
          "translation": "Мне жаль твою будущую жену.",
          "source": "Tatoeba #7455192 @Pfirsichbaeumchen / #8832035 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7455192",
          "cefr_level": "A1",
          "word_slugs": [
            "zukünftige-adj"
          ]
        },
        {
          "id": "10031859",
          "text": "Ich habe meine zukünftige Frau gesehen.",
          "translation": "Я увидел свою будущую жену.",
          "source": "Tatoeba #10031859 @Pfirsichbaeumchen / #5349281 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10031859",
          "cefr_level": "A1",
          "word_slugs": [
            "zukünftige-adj"
          ]
        },
        {
          "id": "1959058",
          "text": "Die Gesetzgebenden streiten über eine zukünftige Reform des Rentensystems.",
          "translation": "Законодатели спорят о будущей реформе пенсионной системы.",
          "source": "Tatoeba #1959058 @al_ex_an_der / #1959057 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1959058",
          "cefr_level": "A1",
          "word_slugs": [
            "zukünftige-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
