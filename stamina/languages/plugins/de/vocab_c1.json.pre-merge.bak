        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7478857",
          "text": "Gibt es Bananen?",
          "translation": "Есть бананы?",
          "source": "Tatoeba #7478857 @Yorwba / #5229649 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7478857",
          "cefr_level": "A1",
          "word_slugs": [
            "bananen-noun"
          ]
        },
        {
          "id": "8828725",
          "text": "Mag Tom Bananen?",
          "translation": "Том любит бананы?",
          "source": "Tatoeba #8828725 @mramosch / #8829462 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8828725",
          "cefr_level": "A1",
          "word_slugs": [
            "bananen-noun"
          ]
        },
        {
          "id": "7611454",
          "text": "Magst du Bananen?",
          "translation": "Ты любишь бананы?",
          "source": "Tatoeba #7611454 @raggione / #7611493 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7611454",
          "cefr_level": "A1",
