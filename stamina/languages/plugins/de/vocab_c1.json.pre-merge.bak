    {
      "slug": "täte-verb",
      "lemma": "täte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5299,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular subjunctive II of tun"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11878548",
          "text": "Ich täte es gern.",
          "translation": "Я охотно бы это сделал.",
          "source": "Tatoeba #11878548 @Pfirsichbaeumchen / #11878556 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11878548",
          "cefr_level": "A1",
          "word_slugs": [
            "täte-verb"
          ]
        },
        {
          "id": "5853693",
          "text": "Was täte Tom ohne uns?",
          "translation": "Что бы Том без нас делал?",
          "source": "Tatoeba #5853693 @raggione / #5855524 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5853693",
          "cefr_level": "A1",
          "word_slugs": [
            "täte-verb"
          ]
        },
        {
          "id": "7147786",
          "text": "Tom täte so etwas nicht.",
          "translation": "Том такого не сделал бы.",
          "source": "Tatoeba #7147786 @Pfirsichbaeumchen / #5357410 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7147786",
          "cefr_level": "A1",
          "word_slugs": [
            "täte-verb"
          ]
        },
        {
          "id": "12151720",
          "text": "Für Geld täte Tom alles.",
          "translation": "Том на всё пошёл бы ради денег.",
          "source": "Tatoeba #12151720 @Pfirsichbaeumchen / #12151723 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12151720",
          "cefr_level": "A1",
          "word_slugs": [
            "täte-verb"
          ]
        },
        {
          "id": "7328551",
          "text": "Maria täte so etwas nicht.",
          "translation": "Мэри такого не сделала бы.",
          "source": "Tatoeba #7328551 @Pfirsichbaeumchen / #5357413 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7328551",
          "cefr_level": "A1",
          "word_slugs": [
            "täte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "benutzte-verb",
      "lemma": "benutzte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5300,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of benutzt:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of benutzt:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "437582",
          "text": "Sie benutzte Margarine statt Butter.",
          "translation": "Она использовала маргарин вместо масла.",
          "source": "Tatoeba #437582 @futureboy / #1576515 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/437582",
          "cefr_level": "A1",
          "word_slugs": [
            "benutzte-verb"
          ]
        },
        {
          "id": "368831",
          "text": "Er benutzte mich als Versuchskaninchen.",
          "translation": "Он использовал меня в качестве подопытного кролика.",
          "source": "Tatoeba #368831 @Wolf / #1945554 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/368831",
          "cefr_level": "A1",
          "word_slugs": [
            "benutzte-verb"
          ]
        },
        {
          "id": "713640",
          "text": "Er benutzte seinen Schirm als Waffe.",
          "translation": "Он использовал свой зонт в качестве оружия.",
          "source": "Tatoeba #713640 @Esperantostern / #3005228 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/713640",
          "cefr_level": "A1",
          "word_slugs": [
            "benutzte-verb"
          ]
        },
        {
          "id": "12182733",
          "text": "Tom benutzte sein Telefon als Spiegel.",
          "translation": "Том использовал свой телефон вместо зеркала.",
          "source": "Tatoeba #12182733 @Pfirsichbaeumchen / #13424431 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12182733",
          "cefr_level": "A1",
          "word_slugs": [
            "benutzte-verb"
          ]
        },
        {
          "id": "14003515",
          "text": "Der Gnom benutzte einen Pilz als Regenschirm.",
          "translation": "Гном использовал гриб как зонтик.",
          "source": "Tatoeba #14003515 @Rovo / #14003517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14003515",
          "cefr_level": "A1",
          "word_slugs": [
            "benutzte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
