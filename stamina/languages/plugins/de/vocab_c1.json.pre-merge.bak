          ]
        },
        {
          "id": "2410149",
          "text": "Sie sind ihrer Bestrafung entgangen.",
          "translation": "Они избежали наказания.",
          "source": "Tatoeba #2410149 @Pfirsichbaeumchen / #2408082 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2410149",
          "cefr_level": "A1",
          "word_slugs": [
            "bestrafung-noun"
          ]
        },
        {
          "id": "923552",
          "text": "Die Bestrafung sollte im Verhältnis zum Verbrechen stehen.",
          "translation": "Наказание должно быть соразмерно преступлению.",
          "source": "Tatoeba #923552 @xtofu80 / #2261032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/923552",
          "cefr_level": "A1",
