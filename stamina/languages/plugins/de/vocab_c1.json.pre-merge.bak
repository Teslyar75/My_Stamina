      "gender": null,
      "examples": [
        {
          "id": "4436607",
          "text": "Ihre Bemühungen sind zum Scheitern verurteilt.",
          "translation": "Ваши усилия обречены на провал.",
          "source": "Tatoeba #4436607 @al_ex_an_der / #4436599 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4436607",
          "cefr_level": "A1",
          "word_slugs": [
            "scheitern-noun"
          ]
        },
        {
          "id": "4436605",
          "text": "Ihre Anstrengungen sind zum Scheitern verurteilt.",
          "translation": "Ваши усилия обречены на провал.",
          "source": "Tatoeba #4436605 @al_ex_an_der / #4436599 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4436605",
          "cefr_level": "A1",
          "word_slugs": [
            "scheitern-noun"
          ]
        },
        {
          "id": "4575126",
          "text": "In seiner Autobiografie beschreibt der Autor sein Scheitern.",
          "translation": "В автобиографии описывает автор своё фиаско.",
          "source": "Tatoeba #4575126 @al_ex_an_der / #4575911 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4575126",
          "cefr_level": "A1",
          "word_slugs": [
            "scheitern-noun"
          ]
        },
        {
          "id": "12355656",
          "text": "Der Regen hätte unsere Pläne fast zum Scheitern gebracht.",
          "translation": "Дождь едва не сорвал наши планы.",
          "source": "Tatoeba #12355656 @Pfirsichbaeumchen / #12355578 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12355656",
          "cefr_level": "A1",
          "word_slugs": [
            "scheitern-noun"
          ]
        },
        {
          "id": "1851254",
          "text": "Warum sind viele Vorhaben von Anfang an zum Scheitern verurteilt?",
          "translation": "Почему многие проекты изначально провальны?",
          "source": "Tatoeba #1851254 @al_ex_an_der / #1851248 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1851254",
          "cefr_level": "A1",
