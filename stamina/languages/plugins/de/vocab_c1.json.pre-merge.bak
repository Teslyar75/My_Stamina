    {
      "slug": "zwanzig-noun",
      "lemma": "Zwanzig",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5321,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "twenty (number)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4278117",
          "text": "„Wann fährt der Bus?“ – „Zwanzig vor und zehn nach.“",
          "translation": "\"Когда здесь автобус?\" - \"Без двадцати и в десять минут\".",
          "source": "Tatoeba #4278117 @raggione / #4278444 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4278117",
          "cefr_level": "A1",
          "word_slugs": [
            "zwanzig-noun"
          ]
        },
        {
          "id": "3067062",
          "text": "Zwanzig Jahre sind schon vergangen.",
          "translation": "Прошло уже двадцать лет.",
          "source": "Tatoeba #3067062 @raggione / #436086 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3067062",
          "cefr_level": "A1",
          "word_slugs": [
            "zwanzig-noun"
          ]
        },
        {
          "id": "8220946",
          "text": "Zwanzig geteilt durch zwei ist zehn.",
          "translation": "Двадцать разделить на два будет десять.",
          "source": "Tatoeba #8220946 @Pfirsichbaeumchen / #8106398 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8220946",
          "cefr_level": "A1",
          "word_slugs": [
            "zwanzig-noun"
          ]
        },
        {
          "id": "11603238",
          "text": "Zwanzig Jahre sind vergangen, und nichts hat sich geändert.",
          "translation": "Двадцать лет прошло, а ничего не изменилось.",
          "source": "Tatoeba #11603238 @Pfirsichbaeumchen / #11603218 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11603238",
          "cefr_level": "A1",
          "word_slugs": [
            "zwanzig-noun"
          ]
        },
        {
          "id": "13446124",
          "text": "Zwanzig Kilometer westlich von hier verlief die Große Seidenstraße.",
          "translation": "В двадцати километрах к западу отсюда проходил Великий шёлковый путь.",
          "source": "Tatoeba #13446124 @mhr / #13446120 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13446124",
          "cefr_level": "A1",
          "word_slugs": [
            "zwanzig-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
