      "translations": {
        "ru": [
          "благодарность"
        ],
        "en": [
          "gratitude, gratefulness, thankfulness"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "361959",
          "text": "Ich möchte ihr meine Dankbarkeit ausdrücken.",
          "translation": "Я хотел бы выразить ей свою благодарность.",
          "source": "Tatoeba #361959 @Wolf / #5427729 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/361959",
          "cefr_level": "A1",
          "word_slugs": [
            "dankbarkeit-noun"
          ]
        },
        {
          "id": "2118356",
          "text": "Mir fehlen die Worte, um meine Dankbarkeit auszudrücken.",
          "translation": "У меня нет слов, чтобы выразить мою благодарность.",
          "source": "Tatoeba #2118356 @al_ex_an_der / #2118338 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2118356",
          "cefr_level": "A1",
          "word_slugs": [
            "dankbarkeit-noun"
          ]
        },
        {
          "id": "551402",
          "text": "Er schenkte mir diese Puppe als Zeichen seiner Dankbarkeit.",
          "translation": "Он подарил мне эту куклу в знак благодарности.",
          "source": "Tatoeba #551402 @xtofu80 / #626606 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/551402",
          "cefr_level": "A1",
          "word_slugs": [
            "dankbarkeit-noun"
          ]
        },
        {
          "id": "1854178",
          "text": "Immer, wenn ich auf einem Berggipfel stehe, fühle ich Dankbarkeit.",
          "translation": "Всегда, когда я стою на вершине горы, я чувствую благодарность.",
          "source": "Tatoeba #1854178 @Esperantostern / #1854181 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1854178",
          "cefr_level": "A1",
          "word_slugs": [
            "dankbarkeit-noun"
          ]
        },
        {
          "id": "2118357",
          "text": "Mir fehlen die Worte, um meiner Dankbarkeit Ausdruck zu verleihen.",
          "translation": "У меня нет слов, чтобы выразить мою благодарность.",
          "source": "Tatoeba #2118357 @al_ex_an_der / #2118338 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2118357",
          "cefr_level": "A1",
          "word_slugs": [
            "dankbarkeit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Dankbarkeit",
        "nominative_pl": ""
      }
