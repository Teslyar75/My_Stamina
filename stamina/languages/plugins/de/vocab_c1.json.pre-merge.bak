    {
      "slug": "beginne-noun",
      "lemma": "Beginne",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6453,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Beginn"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3572635",
          "text": "Verbessere die Welt. Beginne bei dir selbst.",
          "translation": "Улучши мир. Начни с себя.",
          "source": "Tatoeba #3572635 @Manfredo / #3572744 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3572635",
          "cefr_level": "A1",
          "word_slugs": [
            "beginne-noun"
          ]
        },
        {
          "id": "4522039",
          "text": "Beginne mit einfachen Sätzen.",
          "translation": "Начни с простых предложений.",
          "source": "Tatoeba #4522039 @Esperantostern / #4528226 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4522039",
          "cefr_level": "A1",
          "word_slugs": [
            "beginne-noun"
          ]
        },
        {
          "id": "2490822",
          "text": "Beginne einen Satz nicht mit „aber“!",
          "translation": "Не начинай предложение с \"но\".",
          "source": "Tatoeba #2490822 @Pfirsichbaeumchen / #7836177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2490822",
          "cefr_level": "A1",
          "word_slugs": [
            "beginne-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
