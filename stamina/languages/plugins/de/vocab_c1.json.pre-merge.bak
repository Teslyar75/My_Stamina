      "gender": null,
      "examples": [
        {
          "id": "9048239",
          "text": "Nicht auf den Stufen sitzen!",
          "translation": "Не сидите на ступеньках.",
          "source": "Tatoeba #9048239 @Pfirsichbaeumchen / #9033693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9048239",
          "cefr_level": "A1",
          "word_slugs": [
            "stufen-noun"
          ]
        },
        {
          "id": "1872877",
          "text": "Tom sah, wie Maria die Stufen hinaufging.",
          "translation": "Том видел, как Мэри поднимается по ступенькам.",
          "source": "Tatoeba #1872877 @Pfirsichbaeumchen / #13189380 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1872877",
          "cefr_level": "A1",
          "word_slugs": [
            "stufen-noun"
          ]
        },
        {
          "id": "2988424",
          "text": "Bitte achten Sie darauf, wo Sie hintreten, denn hier gibt es Stufen.",
          "translation": "Пожалуйста, внимательно смотрите, куда ступаете, поскольку здесь ступеньки.",
          "source": "Tatoeba #2988424 @Ayame / #2989352 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2988424",
