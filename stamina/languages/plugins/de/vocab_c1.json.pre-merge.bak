    {
      "slug": "statue-noun",
      "lemma": "Statue",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6705,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "statue"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5200207",
          "text": "Diese Statue gehört uns.",
          "translation": "Эта статуя принадлежит нам.",
          "source": "Tatoeba #5200207 @Pfirsichbaeumchen / #4817337 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5200207",
          "cefr_level": "A1",
          "word_slugs": [
            "statue-noun"
          ]
        },
        {
          "id": "11823155",
          "text": "Diese Statue gehört mir.",
          "translation": "Эта статуя принадлежит мне.",
          "source": "Tatoeba #11823155 @Pfirsichbaeumchen / #4821467 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11823155",
          "cefr_level": "A1",
          "word_slugs": [
            "statue-noun"
          ]
        },
        {
          "id": "8818831",
          "text": "Mir gefällt diese Statue.",
          "translation": "Мне нравится эта статуя.",
          "source": "Tatoeba #8818831 @196510089036 / #4095167 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8818831",
          "cefr_level": "A1",
          "word_slugs": [
            "statue-noun"
          ]
        },
        {
          "id": "560120",
          "text": "Diese Statue ist lebensgroß.",
          "translation": "Это статуя в натуральную величину.",
          "source": "Tatoeba #560120 @cost / #402846 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/560120",
          "cefr_level": "A1",
          "word_slugs": [
            "statue-noun"
          ]
        },
        {
          "id": "362221",
          "text": "Diese Statue hat Lebensgröße.",
          "translation": "Это статуя в натуральную величину.",
          "source": "Tatoeba #362221 @Wolf / #402846 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/362221",
          "cefr_level": "A1",
          "word_slugs": [
            "statue-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
