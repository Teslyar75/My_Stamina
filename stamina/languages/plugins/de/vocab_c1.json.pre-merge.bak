          ]
        },
        {
          "id": "13736847",
          "text": "Die KI ist ein schlechter Ersatz für einen Menschen.",
          "translation": "ИИ — плохая замена человеку.",
          "source": "Tatoeba #13736847 @mhr / #13736854 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13736847",
          "cefr_level": "A1",
          "word_slugs": [
