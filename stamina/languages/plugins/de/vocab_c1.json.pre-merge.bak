    {
      "slug": "weltkrieg-noun",
      "lemma": "Weltkrieg",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6398,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мировая война"
        ],
        "en": [
          "world war"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1312386",
          "text": "Der Erste Weltkrieg begann 1914.",
          "translation": "Первая мировая война началась в 1914 году.",
          "source": "Tatoeba #1312386 @Morgengrauen / #831782 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1312386",
          "cefr_level": "A1",
          "word_slugs": [
            "weltkrieg-noun"
          ]
        },
        {
          "id": "365027",
          "text": "Der Zweite Weltkrieg endete 1945.",
          "translation": "Вторая мировая война закончилась в 1945 году.",
          "source": "Tatoeba #365027 @Wolf / #3013726 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/365027",
          "cefr_level": "A1",
          "word_slugs": [
            "weltkrieg-noun"
          ]
        },
        {
          "id": "950992",
          "text": "Der Erste Weltkrieg fing 1914 an.",
          "translation": "Первая мировая война началась в 1914 году.",
          "source": "Tatoeba #950992 @Pfirsichbaeumchen / #831782 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/950992",
          "cefr_level": "A1",
          "word_slugs": [
            "weltkrieg-noun"
          ]
        },
        {
          "id": "691809",
          "text": "Der Erste Weltkrieg brach 1914 aus.",
          "translation": "Первая мировая война разразилась в 1914 году.",
          "source": "Tatoeba #691809 @Manfredo / #2844201 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/691809",
          "cefr_level": "A1",
          "word_slugs": [
            "weltkrieg-noun"
          ]
        },
        {
          "id": "733406",
          "text": "Der Zweite Weltkrieg brach 1939 aus.",
          "translation": "Вторая мировая война разразилась в 1939 году.",
          "source": "Tatoeba #733406 @Esperantostern / #2099432 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/733406",
          "cefr_level": "A1",
          "word_slugs": [
            "weltkrieg-noun"
          ]
        }
