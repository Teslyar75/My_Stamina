    {
      "slug": "ängste-noun",
      "lemma": "Ängste",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8644,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Angst"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12108850",
          "text": "Eure Ängste sind unbegründet.",
          "translation": "Ваши страхи беспочвенны.",
          "source": "Tatoeba #12108850 @Naina / #13059432 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12108850",
          "cefr_level": "A1",
          "word_slugs": [
            "ängste-noun"
          ]
        },
        {
          "id": "1390167",
          "text": "Einsamkeit ist die Mutter aller Ängste.",
          "translation": "Одиночество – мать всех страхов.",
          "source": "Tatoeba #1390167 @Esperantostern / #3119122 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1390167",
          "cefr_level": "A1",
          "word_slugs": [
            "ängste-noun"
          ]
        },
        {
          "id": "12877078",
          "text": "Es gelang ihr, ihre Ängste zu überwinden.",
          "translation": "Ей удалось преодолеть свои страхи.",
          "source": "Tatoeba #12877078 @mhr / #12875538 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12877078",
          "cefr_level": "A1",
          "word_slugs": [
            "ängste-noun"
          ]
        },
        {
          "id": "12877079",
          "text": "Sie schaffte es, ihre Ängste zu überwinden.",
          "translation": "Ей удалось преодолеть свои страхи.",
          "source": "Tatoeba #12877079 @mhr / #12875538 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12877079",
          "cefr_level": "A1",
          "word_slugs": [
            "ängste-noun"
          ]
        },
        {
          "id": "3589717",
          "text": "Alt werden heißt, die Ängste über die Vergangenheit loszuwerden.",
          "translation": "Постареть — значит отбросить беспокойство о прошлом.",
          "source": "Tatoeba #3589717 @MisterTrouser / #4193607 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3589717",
          "cefr_level": "A1",
          "word_slugs": [
            "ängste-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
