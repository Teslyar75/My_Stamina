    {
      "slug": "anfängt-verb",
      "lemma": "anfängt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5287,
      "frequency_band": "goethe-c1",
      "translations": {
