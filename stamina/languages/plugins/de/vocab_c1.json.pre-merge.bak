    {
      "slug": "vermutung-noun",
      "lemma": "Vermutung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6699,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "guess",
          "supposition",
          "suspicion",
          "conjecture"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10533705",
          "text": "Ihre Vermutung ist richtig.",
          "translation": "Ваше допущение верно.",
          "source": "Tatoeba #10533705 @GaryGaryGary / #4809499 @stifler86 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10533705",
          "cefr_level": "A1",
          "word_slugs": [
            "vermutung-noun"
          ]
        },
        {
          "id": "13885639",
          "text": "Das ist nur eine Vermutung.",
          "translation": "Это всего лишь предположение.",
          "source": "Tatoeba #13885639 @Waldelfe / #4578763 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13885639",
          "cefr_level": "A1",
          "word_slugs": [
            "vermutung-noun"
          ]
        },
        {
          "id": "1508411",
          "text": "Deine Vermutung liegt komplett daneben.",
          "translation": "Твоя догадка далека от истины.",
          "source": "Tatoeba #1508411 @Zaghawa / #4945198 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1508411",
          "cefr_level": "A1",
          "word_slugs": [
            "vermutung-noun"
          ]
        },
        {
          "id": "11082132",
          "text": "Die Riemannsche Vermutung ist unbewiesen.",
          "translation": "Гипотеза Римана не доказана.",
          "source": "Tatoeba #11082132 @Pfirsichbaeumchen / #4688176 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11082132",
          "cefr_level": "A1",
          "word_slugs": [
            "vermutung-noun"
          ]
        },
        {
          "id": "3522222",
          "text": "Tom fand ein Gegenbeispiel, das Marias Vermutung widerlegte.",
          "translation": "Том нашёл контрпример, который опроверг предположение Марии.",
          "source": "Tatoeba #3522222 @Pfirsichbaeumchen / #3524073 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3522222",
          "cefr_level": "A1",
          "word_slugs": [
            "vermutung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
