    {
      "slug": "aufhängen-verb",
      "lemma": "aufhängen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7056,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "вешать"
        ],
        "en": [
          "to hang, to suspend",
          "to hang up (the telephone)",
          "to hang (someone)",
          "to crash"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3115979",
          "text": "Könntest du die Wäsche aufhängen?",
          "translation": "Ты не мог бы развесить бельё?",
          "source": "Tatoeba #3115979 @Ennocb / #13600158 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3115979",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhängen-verb"
          ]
        },
        {
          "id": "12555145",
          "text": "Wo wollt ihr das Bild aufhängen?",
          "translation": "Где вы хотите повесить картину?",
          "source": "Tatoeba #12555145 @mhr / #12555134 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12555145",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhängen-verb"
          ]
        },
        {
          "id": "12555147",
          "text": "Wo willst du das Bild aufhängen?",
          "translation": "Где ты хочешь повесить картину?",
          "source": "Tatoeba #12555147 @mhr / #6176191 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12555147",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhängen-verb"
          ]
        },
        {
          "id": "4755813",
          "text": "Wo soll ich diesen Kalender aufhängen?",
          "translation": "Где мне повесить этот календарь?",
          "source": "Tatoeba #4755813 @bonny37 / #10495133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4755813",
          "cefr_level": "A1",
          "word_slugs": [
            "aufhängen-verb"
          ]
        },
        {
          "id": "840161",
          "text": "Wo könnte ich diesen Kalender aufhängen?",
          "translation": "Где бы мне повесить этот календарь?",
          "source": "Tatoeba #840161 @Esperantostern / #5910353 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/840161",
