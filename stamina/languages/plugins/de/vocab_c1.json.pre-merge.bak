          "cefr_level": "A1",
          "word_slugs": [
            "sonnenuntergang-noun"
          ]
        },
        {
          "id": "5879769",
          "text": "Es wurde kalt nach Sonnenuntergang.",
          "translation": "После заката похолодало.",
          "source": "Tatoeba #5879769 @dasbeispielholz / #5935620 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5879769",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenuntergang-noun"
          ]
        },
        {
          "id": "5935246",
          "text": "Nach Sonnenuntergang wurde es kalt.",
          "translation": "После заката похолодало.",
          "source": "Tatoeba #5935246 @Pfirsichbaeumchen / #5935620 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5935246",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenuntergang-noun"
          ]
        },
        {
          "id": "349783",
          "text": "Was für ein schöner Sonnenuntergang!",
