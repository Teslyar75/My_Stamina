          ]
        },
        {
          "id": "7010422",
          "text": "Dieser Mann kommt mir vage bekannt vor.",
          "translation": "Этот человек мне кажется смутно знакомым.",
          "source": "Tatoeba #7010422 @EzRhil / #6481968 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7010422",
          "cefr_level": "A1",
