    {
      "slug": "gebet-noun",
      "lemma": "Gebet",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5373,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "prayer"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "13712529",
          "text": "Es ist Zeit fürs Gebet.",
          "translation": "Время молитвы.",
          "source": "Tatoeba #13712529 @Waldelfe / #13321867 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13712529",
          "cefr_level": "A1",
          "word_slugs": [
            "gebet-noun"
          ]
        },
        {
          "id": "4425744",
          "text": "Das Gebet wird auf Gebetsteppichen verrichtet.",
          "translation": "Намаз проводится на молельных ковриках.",
          "source": "Tatoeba #4425744 @brauchinet / #4425750 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4425744",
          "cefr_level": "A1",
          "word_slugs": [
            "gebet-noun"
          ]
        },
        {
          "id": "7463838",
          "text": "Ich konnte mich auf kein einziges Gebet besinnen.",
          "translation": "Я не смогла вспомнить ни одну молитву.",
          "source": "Tatoeba #7463838 @Pfirsichbaeumchen / #6544094 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7463838",
          "cefr_level": "A1",
          "word_slugs": [
            "gebet-noun"
          ]
        },
        {
          "id": "1097731",
          "text": "Das Vaterunser ist das bekannteste Gebet des Christentums.",
          "translation": "Отче наш — самая известная христианская молитва.",
          "source": "Tatoeba #1097731 @Esperantostern / #1787693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1097731",
          "cefr_level": "A1",
          "word_slugs": [
            "gebet-noun"
          ]
        },
        {
          "id": "5163374",
          "text": "Die Hohepriesterin sprach zur Eröffnung der Zeremonie ein Gebet.",
          "translation": "Архиереи прочли молитву на церемонии открытия.",
          "source": "Tatoeba #5163374 @Pfirsichbaeumchen / #7469994 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5163374",
          "cefr_level": "A1",
          "word_slugs": [
            "gebet-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Gebet",
        "nominative_pl": ""
      }
    },
