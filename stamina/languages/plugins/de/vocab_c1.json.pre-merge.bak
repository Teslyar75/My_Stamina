          "addicted"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13905201",
          "text": "Kinder sind von ihren Eltern abhängig.",
          "translation": "Дети зависят от родителей.",
          "source": "Tatoeba #13905201 @Ioan_Cristian / #11251053 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13905201",
          "cefr_level": "A1",
          "word_slugs": [
            "abhängig-adj"
          ]
        },
        {
          "id": "1068158",
          "text": "Tom und Mary sind voneinander abhängig.",
          "translation": "Том и Мэри зависят друг от друга.",
          "source": "Tatoeba #1068158 @Pfirsichbaeumchen / #1480916 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1068158",
          "cefr_level": "A1",
          "word_slugs": [
            "abhängig-adj"
          ]
        },
        {
          "id": "845411",
          "text": "Der Preis ist von der Größe abhängig.",
          "translation": "Стоимость зависит от размера.",
          "source": "Tatoeba #845411 @MUIRIEL / #10794103 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/845411",
          "cefr_level": "A1",
          "word_slugs": [
            "abhängig-adj"
          ]
        },
        {
          "id": "358337",
          "text": "Er ist völlig abhängig von seinen Eltern.",
          "translation": "Он полностью зависит от родителей.",
          "source": "Tatoeba #358337 @MUIRIEL / #2734480 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/358337",
          "cefr_level": "A1",
          "word_slugs": [
            "abhängig-adj"
          ]
        },
        {
          "id": "4902522",
          "text": "Meine Laune ist total vom Wetter abhängig.",
          "translation": "Моё настроение целиком зависит от погоды.",
          "source": "Tatoeba #4902522 @maaster / #9022409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4902522",
          "cefr_level": "A1",
          "word_slugs": [
            "abhängig-adj"
          ]
        }
      ],
