    {
      "slug": "verbannt-verb",
      "lemma": "verbannt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8196,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verbannen:",
          "second-person plural present",
          "inflection of verbannen:",
          "third-person singular present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12867903",
          "text": "Im Jahre 1814 wurde Napoleon auf die Insel Elba verbannt.",
          "translation": "В 1814 году Наполеон был сослан на остров Эльбу.",
          "source": "Tatoeba #12867903 @Waldelfe / #4537601 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12867903",
          "cefr_level": "A1",
          "word_slugs": [
            "verbannt-verb"
          ]
        },
        {
          "id": "2912847",
          "text": "Im Jahr 1902 wurde er verhaftet und nach Sibirien verbannt.",
          "translation": "В 1902 году он был арестован и сослан в Сибирь.",
          "source": "Tatoeba #2912847 @al_ex_an_der / #2912768 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2912847",
          "cefr_level": "A1",
          "word_slugs": [
            "verbannt-verb"
          ]
        },
        {
          "id": "13830162",
          "text": "Jazz wurde in Deutschland während der Nazizeit aus dem Rundfunk verbannt.",
          "translation": "Во времена нацистов джаз в Германии был исключён из радиовещания.",
          "source": "Tatoeba #13830162 @mhr / #13830177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13830162",
          "cefr_level": "A1",
          "word_slugs": [
            "verbannt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
