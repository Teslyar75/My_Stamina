    {
      "slug": "versorgt-verb",
      "lemma": "versorgt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5474,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of versorgen:",
          "third-person singular present",
          "inflection of versorgen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2485987",
          "text": "Die Babys werden von Freiwilligen versorgt.",
          "translation": "О младенцах заботятся волонтёры.",
          "source": "Tatoeba #2485987 @Tamy / #4207971 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2485987",
          "cefr_level": "A1",
          "word_slugs": [
            "versorgt-verb"
          ]
        },
        {
          "id": "4350099",
          "text": "Dieser See versorgt die Stadt mit Wasser.",
          "translation": "Это озеро обеспечивает город водой.",
          "source": "Tatoeba #4350099 @pullnosemans / #5893483 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4350099",
          "cefr_level": "A1",
          "word_slugs": [
            "versorgt-verb"
          ]
        },
        {
          "id": "399652",
          "text": "Der Fluss versorgt die Stadt mit Elektrizität.",
          "translation": "Река обеспечивает город электроэнергией.",
          "source": "Tatoeba #399652 @xtofu80 / #2893555 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399652",
          "cefr_level": "A1",
          "word_slugs": [
            "versorgt-verb"
          ]
        },
        {
          "id": "2485992",
          "text": "Das Baby wurde von seiner Großmutter versorgt.",
          "translation": "О ребёнке заботилась бабушка.",
          "source": "Tatoeba #2485992 @Tamy / #8547181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2485992",
          "cefr_level": "A1",
          "word_slugs": [
            "versorgt-verb"
          ]
        },
        {
          "id": "2846075",
          "text": "Wer versorgt dich, wenn du einmal krank bist?",
          "translation": "Кто позаботится о тебе, если заболеешь?",
          "source": "Tatoeba #2846075 @raggione / #2847029 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2846075",
          "cefr_level": "A1",
          "word_slugs": [
            "versorgt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
