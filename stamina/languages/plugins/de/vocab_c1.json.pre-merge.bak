          "word_slugs": [
            "politische-adj"
          ]
        },
        {
          "id": "5076817",
          "text": "Wir brauchen eine politische Revolution.",
          "translation": "Нам нужна политическая революция.",
          "source": "Tatoeba #5076817 @al_ex_an_der / #5077553 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5076817",
          "cefr_level": "A1",
          "word_slugs": [
            "politische-adj"
          ]
        },
        {
          "id": "824379",
          "text": "Sie gründeten eine neue politische Partei.",
          "translation": "Они основали новую политическую партию.",
          "source": "Tatoeba #824379 @cumori / #12328145 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/824379",
          "cefr_level": "A1",
          "word_slugs": [
            "politische-adj"
          ]
        },
        {
          "id": "2289453",
          "text": "Diese Zeitung hat keine politische Ausrichtung.",
          "translation": "У этой газеты нет политического уклона.",
          "source": "Tatoeba #2289453 @Pfirsichbaeumchen / #4748296 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2289453",
          "cefr_level": "A1",
          "word_slugs": [
            "politische-adj"
          ]
        },
        {
          "id": "6938059",
          "text": "Sie versuchen eine neue politische Partei zu organisieren.",
          "translation": "Они пытаются образовать новую политическую партию.",
          "source": "Tatoeba #6938059 @moskytoo / #7412466 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6938059",
          "cefr_level": "A1",
          "word_slugs": [
            "politische-adj"
          ]
