    {
      "slug": "breche-verb",
      "lemma": "breche",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6280,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of brechen:",
          "first-person singular present",
          "inflection of brechen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3937848",
          "text": "Ich breche die Schule ab.",
          "translation": "Я бросаю школу.",
          "source": "Tatoeba #3937848 @Dani6187 / #4864557 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3937848",
          "cefr_level": "A1",
          "word_slugs": [
            "breche-verb"
          ]
        },
        {
          "id": "8097998",
          "text": "Manchmal breche ich die Regeln.",
          "translation": "Иногда я нарушаю правила.",
          "source": "Tatoeba #8097998 @Pfirsichbaeumchen / #5902802 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8097998",
          "cefr_level": "A1",
          "word_slugs": [
            "breche-verb"
          ]
        },
        {
          "id": "2124781",
          "text": "Die Lebenden rufe ich, die Toten beklage ich, die Blitze breche ich.",
          "translation": "Зову живых, оплакиваю мертвых, сокрушаю молнии.",
          "source": "Tatoeba #2124781 @al_ex_an_der / #2124775 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2124781",
          "cefr_level": "A1",
          "word_slugs": [
            "breche-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
