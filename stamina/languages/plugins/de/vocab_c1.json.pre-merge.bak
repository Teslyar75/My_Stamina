    {
      "slug": "eisenbahn-noun",
      "lemma": "Eisenbahn",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9222,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "railway, railroad (transporting system)",
          "train"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13033243",
          "text": "Die Eisenbahn ist das Leben.",
          "translation": "Железная дорога - это жизнь.",
          "source": "Tatoeba #13033243 @mhr / #13032162 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13033243",
          "cefr_level": "A1",
          "word_slugs": [
            "eisenbahn-noun"
          ]
        },
        {
          "id": "4271112",
          "text": "Sein Vater arbeitete bei der Eisenbahn.",
          "translation": "Его отец был железнодорожником.",
          "source": "Tatoeba #4271112 @raggione / #4271159 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4271112",
          "cefr_level": "A1",
          "word_slugs": [
            "eisenbahn-noun"
          ]
        },
        {
          "id": "3311640",
          "text": "Die Eisenbahn gabelt sich hinter der Brücke.",
          "translation": "Железная дорога разделяется надвое после моста.",
          "source": "Tatoeba #3311640 @al_ex_an_der / #3311633 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3311640",
          "cefr_level": "A1",
          "word_slugs": [
            "eisenbahn-noun"
          ]
        },
        {
          "id": "3016300",
          "text": "Damals gab es in Japan noch keine Eisenbahn.",
          "translation": "В то время в Японии не было железных дорог.",
          "source": "Tatoeba #3016300 @Pfirsichbaeumchen / #1407166 @saiko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3016300",
          "cefr_level": "A1",
          "word_slugs": [
            "eisenbahn-noun"
          ]
        },
        {
          "id": "13728810",
          "text": "In Russland hat die Eisenbahn eine andere Spurweite.",
          "translation": "В России другая ширина железнодорожной колеи.",
          "source": "Tatoeba #13728810 @mhr / #13728807 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13728810",
          "cefr_level": "A1",
          "word_slugs": [
            "eisenbahn-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
