      "gender": null,
      "examples": [
        {
          "id": "14073911",
          "text": "Das kann ich nicht beeinflussen.",
          "translation": "На это я повлиять не могу.",
          "source": "Tatoeba #14073911 @mhr / #14071956 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14073911",
          "cefr_level": "A1",
          "word_slugs": [
            "beeinflussen-verb"
          ]
        },
        {
          "id": "7697145",
          "text": "Maria ist leicht zu beeinflussen.",
          "translation": "Мэри легко поддаётся влиянию.",
          "source": "Tatoeba #7697145 @wolfgangth / #7893859 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7697145",
          "cefr_level": "A1",
          "word_slugs": [
            "beeinflussen-verb"
          ]
        },
        {
          "id": "3524822",
          "text": "Marias Vater kann man leicht beeinflussen.",
          "translation": "На отца Марии легко повлиять.",
          "source": "Tatoeba #3524822 @al_ex_an_der / #3524858 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3524822",
          "cefr_level": "A1",
          "word_slugs": [
            "beeinflussen-verb"
          ]
        },
        {
          "id": "4939024",
          "text": "Man kann die Geschehnisse nicht beeinflussen.",
          "translation": "Невозможно повлиять на события.",
