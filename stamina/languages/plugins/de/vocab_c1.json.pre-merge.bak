    {
      "slug": "kanzler-noun",
      "lemma": "Kanzler",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8564,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "канцлер"
        ],
        "en": [
          "chancellor (title of a head of government)",
          "ellipsis of Bundeskanzler",
          "chancellor (title of a head of government)",
          "ellipsis of Reichskanzler"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "7878362",
          "text": "Wen nannte man den eisernen Kanzler?",
          "translation": "Кого называли \"железным канцлером\"?",
          "source": "Tatoeba #7878362 @felix63 / #12394547 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7878362",
          "cefr_level": "A1",
          "word_slugs": [
            "kanzler-noun"
          ]
        },
        {
          "id": "10341635",
          "text": "Wer wird der nächste Kanzler Deutschlands sein?",
          "translation": "Кто станет следующим канцлером Германии?",
          "source": "Tatoeba #10341635 @maaster / #10341642 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10341635",
          "cefr_level": "A1",
          "word_slugs": [
            "kanzler-noun"
          ]
        },
        {
          "id": "570738",
          "text": "Konrad Adenauer war der erste Kanzler der Bundesrepublik Deutschland.",
          "translation": "Конрад Аденауэр был первым канцлером Федеративной Республики Германия.",
          "source": "Tatoeba #570738 @Pfirsichbaeumchen / #5739515 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/570738",
          "cefr_level": "A1",
          "word_slugs": [
            "kanzler-noun"
          ]
        },
        {
          "id": "7878375",
          "text": "Wen nannte man den eisernen Kanzler? Helmut Kohl oder Otto von Bismarck?",
          "translation": "Кого называли \"железным канцлером\"? Гельмута Коля или Отто фон Бисмарка?",
          "source": "Tatoeba #7878375 @felix63 / #12394598 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7878375",
          "cefr_level": "A1",
          "word_slugs": [
            "kanzler-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Kanzler",
        "nominative_pl": ""
