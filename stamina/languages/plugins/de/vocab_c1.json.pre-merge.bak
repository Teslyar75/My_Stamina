        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11643362",
          "text": "Es lebe die Demokratie!",
          "translation": "Да здравствует демократия!",
          "source": "Tatoeba #11643362 @Adelpa / #3173157 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11643362",
          "cefr_level": "A1",
          "word_slugs": [
            "demokratie-noun"
          ]
        },
        {
          "id": "14098297",
          "text": "Ich liebe die Demokratie.",
          "translation": "Я люблю демократию.",
          "source": "Tatoeba #14098297 @mhr / #14097004 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14098297",
          "cefr_level": "A1",
          "word_slugs": [
            "demokratie-noun"
          ]
        },
        {
          "id": "1054903",
          "text": "Er verteidigt die Demokratie.",
          "translation": "Он защищает демократию.",
          "source": "Tatoeba #1054903 @MUIRIEL / #12890585 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1054903",
          "cefr_level": "A1",
          "word_slugs": [
            "demokratie-noun"
          ]
        },
        {
          "id": "11643364",
          "text": "Es lebe die wahre Demokratie!",
          "translation": "Да здравствует истинная демократия!",
          "source": "Tatoeba #11643364 @Adelpa / #12364724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11643364",
          "cefr_level": "A1",
          "word_slugs": [
            "demokratie-noun"
          ]
        },
        {
          "id": "11643365",
          "text": "Es lebe die echte Demokratie!",
          "translation": "Да здравствует истинная демократия!",
          "source": "Tatoeba #11643365 @Adelpa / #12364724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11643365",
          "cefr_level": "A1",
          "word_slugs": [
            "demokratie-noun"
          ]
        }
