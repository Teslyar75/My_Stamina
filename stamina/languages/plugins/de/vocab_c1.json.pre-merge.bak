    {
      "slug": "ältere-adj",
      "lemma": "ältere",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5886,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of alt:",
          "strong/mixed nominative/accusative feminine singular comparative degree",
          "inflection of alt:",
          "strong nominative/accusative plural comparative degree"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8634565",
          "text": "Ich habe ältere Brüder.",
          "translation": "У меня есть старшие братья.",
          "source": "Tatoeba #8634565 @Melang / #8640343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634565",
          "cefr_level": "A1",
          "word_slugs": [
