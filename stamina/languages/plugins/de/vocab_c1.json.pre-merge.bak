    {
      "slug": "gemeinsamen-adj",
      "lemma": "gemeinsamen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6401,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gemeinsam:",
          "strong genitive masculine/neuter singular",
          "inflection of gemeinsam:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3544721",
          "text": "Wir haben einen gemeinsamen Freund.",
          "translation": "У нас есть общий друг.",
          "source": "Tatoeba #3544721 @Pfirsichbaeumchen / #3544719 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3544721",
          "cefr_level": "A1",
          "word_slugs": [
            "gemeinsamen-adj"
          ]
        },
        {
          "id": "12072267",
          "text": "Wie geht es unserem gemeinsamen Bekannten?",
          "translation": "Как поживает наш общий знакомый?",
          "source": "Tatoeba #12072267 @Pfirsichbaeumchen / #12066210 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12072267",
          "cefr_level": "A1",
          "word_slugs": [
            "gemeinsamen-adj"
          ]
        },
        {
          "id": "12072268",
          "text": "Wie geht es unserer gemeinsamen Bekannten?",
          "translation": "Как поживает наша общая знакомая?",
          "source": "Tatoeba #12072268 @Pfirsichbaeumchen / #12066211 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12072268",
          "cefr_level": "A1",
          "word_slugs": [
            "gemeinsamen-adj"
          ]
        },
        {
          "id": "13452129",
          "text": "Pferde und Esel haben einen gemeinsamen Vorfahren.",
          "translation": "У лошади и осла общий предок.",
          "source": "Tatoeba #13452129 @mhr / #13451959 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13452129",
          "cefr_level": "A1",
          "word_slugs": [
            "gemeinsamen-adj"
          ]
        },
        {
          "id": "6323774",
          "text": "Das Internet ist ein Treffpunkt für Menschen mit gemeinsamen Interessen.",
          "translation": "Интернет — место встречи людей с общими интересами.",
          "source": "Tatoeba #6323774 @Pfirsichbaeumchen / #5794506 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6323774",
          "cefr_level": "A1",
          "word_slugs": [
            "gemeinsamen-adj"
          ]
        }
      ],
