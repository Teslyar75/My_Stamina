    {
      "slug": "verletzte-noun",
      "lemma": "Verletzte",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6529,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Verletzter:",
          "strong nominative/accusative plural",
          "inflection of Verletzter:",
          "weak nominative singular"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "5263049",
          "text": "Es gab viele Verletzte.",
          "translation": "Было много раненых.",
          "source": "Tatoeba #5263049 @Sudajaengi / #4997923 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5263049",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzte-noun"
          ]
        },
        {
          "id": "873914",
          "text": "Wie viel Blut hat der Verletzte verloren?",
          "translation": "Сколько крови потерял потерпевший?",
          "source": "Tatoeba #873914 @Pfirsichbaeumchen / #1464716 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/873914",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzte-noun"
          ]
        },
        {
          "id": "13079340",
          "text": "Es gibt Tote und Verletzte auf beiden Seiten.",
          "translation": "Есть погибшие и раненые с обеих сторон.",
          "source": "Tatoeba #13079340 @mhr / #13079338 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13079340",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzte-noun"
          ]
        },
        {
          "id": "8099148",
          "text": "Verletzte Bären sind gewöhnlich gefährlich.",
          "translation": "Раненые медведи обычно опасны.",
          "source": "Tatoeba #8099148 @Pfirsichbaeumchen / #6166660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8099148",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzte-noun"
          ]
        },
        {
          "id": "8099146",
          "text": "Verletzte Bären sind gewöhnlich sehr gefährlich.",
          "translation": "Раненые медведи, как правило, очень опасны.",
          "source": "Tatoeba #8099146 @Pfirsichbaeumchen / #3407365 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8099146",
          "cefr_level": "A1",
          "word_slugs": [
            "verletzte-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Verletzte",
