          ]
        },
        {
          "id": "2246255",
          "text": "Ich hatte noch nie einen Alptraum.",
          "translation": "У меня никогда не было кошмаров.",
          "source": "Tatoeba #2246255 @Pfirsichbaeumchen / #2493938 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2246255",
          "cefr_level": "A1",
          "word_slugs": [
            "alptraum-noun"
          ]
        },
        {
          "id": "13107651",
          "text": "Ich hoffe, es war nur ein Alptraum.",
          "translation": "Надеюсь, это был просто ночной кошмар.",
          "source": "Tatoeba #13107651 @maaster / #13111427 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13107651",
          "cefr_level": "A1",
          "word_slugs": [
            "alptraum-noun"
          ]
        },
        {
          "id": "3549679",
          "text": "Ich hoffe, dass dieser Traum kein Alptraum ist.",
          "translation": "Я надеюсь, что этот сон не кошмар.",
          "source": "Tatoeba #3549679 @Pfirsichbaeumchen / #3549589 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3549679",
          "cefr_level": "A1",
          "word_slugs": [
            "alptraum-noun"
          ]
        }
