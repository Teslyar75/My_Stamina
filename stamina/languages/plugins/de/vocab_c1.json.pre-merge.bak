    {
      "slug": "bedienen-verb",
      "lemma": "bedienen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5012,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "прислуживать",
          "управлять"
        ],
        "en": [
          "to serve",
          "to operate",
          "to play a card according to the grouping of the first card of a trick; to follow suit",
          "to help oneself"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14096826",
          "text": "Dieser Ofen ist leicht zu bedienen.",
          "translation": "Эта плита проста в использовании.",
          "source": "Tatoeba #14096826 @mhr / #14092877 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14096826",
          "cefr_level": "A1",
          "word_slugs": [
            "bedienen-verb"
          ]
        },
        {
          "id": "1914945",
          "text": "Es war niemand im Laden, um mich zu bedienen.",
          "translation": "В магазине не было никого, кто бы мог меня обслужить.",
          "source": "Tatoeba #1914945 @Tamy / #12349042 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1914945",
          "cefr_level": "A1",
          "word_slugs": [
            "bedienen-verb"
          ]
        },
        {
          "id": "1048907",
          "text": "Verglichen mit dem alten Modell, ist dieses viel leichter zu bedienen.",
          "translation": "По сравнению с предыдущей моделью, эта намного легче в управлении.",
          "source": "Tatoeba #1048907 @Sudajaengi / #9461737 @schwetterling (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1048907",
          "cefr_level": "A1",
          "word_slugs": [
            "bedienen-verb"
          ]
        },
        {
          "id": "3605560",
          "text": "Ich habe dicke Finger, deshalb kann ich keine kleine Tastatur bedienen.",
          "translation": "У меня толстые пальцы, поэтому я не могу использовать маленькие клавиатуры.",
          "source": "Tatoeba #3605560 @Esperantostern / #3606958 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3605560",
          "cefr_level": "A1",
          "word_slugs": [
            "bedienen-verb"
          ]
        },
        {
          "id": "12815009",
          "text": "Wir wurden darin ausgebildet, wie wir die Maschinen zu bedienen hatten.",
          "translation": "Нас обучили как обращаться с машинами.",
          "source": "Tatoeba #12815009 @Waldelfe / #2731549 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12815009",
          "cefr_level": "A1",
          "word_slugs": [
            "bedienen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
