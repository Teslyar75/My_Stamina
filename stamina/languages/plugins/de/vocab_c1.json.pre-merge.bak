    {
      "slug": "standpunkt-noun",
      "lemma": "Standpunkt",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7074,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "точка зрения"
        ],
        "en": [
          "standpoint",
          "stance, point of view (attitude, opinion, or set of beliefs)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12863707",
          "text": "Ich verstehe Ihren Standpunkt nicht.",
          "translation": "Мне не понятна Ваша позиция.",
          "source": "Tatoeba #12863707 @mhr / #12863519 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12863707",
          "cefr_level": "A1",
          "word_slugs": [
            "standpunkt-noun"
          ]
        },
        {
          "id": "12863710",
          "text": "Ich verstehe euren Standpunkt nicht.",
          "translation": "Мне не понятна ваша позиция.",
          "source": "Tatoeba #12863710 @mhr / #12863518 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12863710",
          "cefr_level": "A1",
          "word_slugs": [
            "standpunkt-noun"
          ]
        },
        {
          "id": "13633906",
          "text": "Er hält seinen Standpunkt für den einzig richtigen.",
          "translation": "Он считает свою точку зрения единственно правильной.",
          "source": "Tatoeba #13633906 @mhr / #13633800 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13633906",
          "cefr_level": "A1",
          "word_slugs": [
            "standpunkt-noun"
          ]
        },
        {
          "id": "12249731",
          "text": "Du hast deinen Standpunkt, und ich habe meinen. Offensichtlich unterscheiden sie sich.",
          "translation": "У тебя своя точка зрения, а у меня своя. Очевидно, что они разные.",
          "source": "Tatoeba #12249731 @Pfirsichbaeumchen / #11737106 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12249731",
          "cefr_level": "A1",
          "word_slugs": [
            "standpunkt-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Standpunkt",
        "nominative_pl": ""
      }
