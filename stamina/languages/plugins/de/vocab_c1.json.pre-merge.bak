    {
      "slug": "erwachsenen-noun",
      "lemma": "Erwachsenen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5881,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of Erwachsener:",
          "strong genitive/accusative singular",
          "inflection of Erwachsener:",
          "strong dative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1121218",
          "text": "Sie machten die Erwachsenen verrückt.",
          "translation": "Они сводили взрослых с ума.",
          "source": "Tatoeba #1121218 @kitab / #2304641 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1121218",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsenen-noun"
          ]
        },
        {
          "id": "6197788",
          "text": "Alle Erwachsenen waren einmal Kinder.",
          "translation": "Все взрослые когда-то были детьми.",
          "source": "Tatoeba #6197788 @Pfirsichbaeumchen / #6458302 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6197788",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsenen-noun"
          ]
        },
        {
          "id": "5597951",
          "text": "Das ist ein Erwachsenen- und kein Kinderfilm.",
          "translation": "Это фильм для взрослых, а не для детей.",
          "source": "Tatoeba #5597951 @Pfirsichbaeumchen / #5270440 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5597951",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsenen-noun"
          ]
        },
        {
          "id": "8232285",
          "text": "Der zehnjährige Tom arbeitete gleichberechtigt neben Erwachsenen.",
          "translation": "Десятилетний Том работал наравне со взрослыми.",
          "source": "Tatoeba #8232285 @Pfirsichbaeumchen / #6533166 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8232285",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsenen-noun"
          ]
        },
        {
          "id": "6173026",
          "text": "Ihr hättet das einem der Erwachsenen sagen müssen.",
          "translation": "Вы должны были сказать об этом кому-то из взрослых.",
          "source": "Tatoeba #6173026 @Pfirsichbaeumchen / #6170514 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6173026",
          "cefr_level": "A1",
          "word_slugs": [
            "erwachsenen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
