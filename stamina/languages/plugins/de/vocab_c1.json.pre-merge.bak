    {
      "slug": "beginne-verb",
      "lemma": "beginne",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6453,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of beginnen:",
          "first-person singular present",
          "inflection of beginnen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3889163",
          "text": "Ich beginne morgen.",
          "translation": "Я начну завтра.",
          "source": "Tatoeba #3889163 @Zaghawa / #6059771 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3889163",
          "cefr_level": "A1",
          "word_slugs": [
            "beginne-verb"
          ]
        },
        {
          "id": "8346588",
          "text": "Ich beginne den Tag.",
          "translation": "Я начинаю день.",
          "source": "Tatoeba #8346588 @felix63 / #8561629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8346588",
          "cefr_level": "A1",
          "word_slugs": [
            "beginne-verb"
          ]
        },
        {
          "id": "982725",
          "text": "Ich beginne heute Abend.",
          "translation": "Я начну сегодня вечером.",
          "source": "Tatoeba #982725 @Esperantostern / #2077318 @AV (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/982725",
          "cefr_level": "A1",
          "word_slugs": [
            "beginne-verb"
          ]
        },
        {
          "id": "360921",
          "text": "Ich beginne zu verstehen.",
          "translation": "Я начинаю понимать.",
          "source": "Tatoeba #360921 @MUIRIEL / #631556 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/360921",
          "cefr_level": "A1",
          "word_slugs": [
            "beginne-verb"
          ]
        },
        {
          "id": "13825849",
          "text": "Ich beginne heute Nachmittag.",
          "translation": "Я начинаю сегодня днём.",
          "source": "Tatoeba #13825849 @mhr / #13825734 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13825849",
          "cefr_level": "A1",
          "word_slugs": [
            "beginne-verb"
          ]
        }
      ],
      "tags": [
