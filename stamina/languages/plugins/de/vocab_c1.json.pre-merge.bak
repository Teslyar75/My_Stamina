    {
      "slug": "krankheiten-noun",
      "lemma": "Krankheiten",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6647,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Krankheit"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "381652",
          "text": "Unsauberkeit verursacht Krankheiten.",
          "translation": "Нечистоплотность порождает болезни.",
          "source": "Tatoeba #381652 @Ole / #468282 @tensin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/381652",
          "cefr_level": "A1",
          "word_slugs": [
            "krankheiten-noun"
          ]
        },
        {
          "id": "7030215",
          "text": "Tom hat Angst vor Krankheiten.",
          "translation": "Том боится болезней.",
          "source": "Tatoeba #7030215 @list / #9369741 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7030215",
          "cefr_level": "A1",
          "word_slugs": [
            "krankheiten-noun"
          ]
        },
        {
          "id": "13630366",
          "text": "Ratten sind Überträger vieler Krankheiten.",
          "translation": "Крысы являются переносчиками множества болезней.",
          "source": "Tatoeba #13630366 @carlosalberto / #12533888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13630366",
          "cefr_level": "A1",
          "word_slugs": [
            "krankheiten-noun"
          ]
        },
        {
          "id": "12728901",
          "text": "Viren können schwere Krankheiten hervorrufen.",
          "translation": "Вирусы могут вызывать серьёзные болезни.",
          "source": "Tatoeba #12728901 @mhr / #12728896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12728901",
          "cefr_level": "A1",
          "word_slugs": [
            "krankheiten-noun"
          ]
        },
        {
          "id": "12728903",
          "text": "Viren können schwere Krankheiten verursachen.",
          "translation": "Вирусы могут вызывать серьёзные болезни.",
          "source": "Tatoeba #12728903 @mhr / #12728896 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12728903",
          "cefr_level": "A1",
          "word_slugs": [
            "krankheiten-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
