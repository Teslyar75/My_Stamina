    {
      "slug": "empfindest-verb",
      "lemma": "empfindest",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9488,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of empfinden:",
          "second-person singular present",
          "inflection of empfinden:",
          "second-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10456197",
          "text": "Sag ihm doch einfach, was du empfindest!",
          "translation": "Просто скажи ему уже о своих чувствах!",
          "source": "Tatoeba #10456197 @Pfirsichbaeumchen / #10456209 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10456197",
          "cefr_level": "A1",
          "word_slugs": [
            "empfindest-verb"
          ]
        },
        {
          "id": "4968507",
          "text": "„Was empfindest du für Tom?“ – „Gar nichts. Er ist mir egal.“",
          "translation": "«Что ты чувствуешь к Тому?» – «Совсем ничего. Он мне безразличен».",
          "source": "Tatoeba #4968507 @Pfirsichbaeumchen / #5888122 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4968507",
          "cefr_level": "A1",
          "word_slugs": [
            "empfindest-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
