    {
      "slug": "eingefallen-verb",
      "lemma": "eingefallen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5494,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of einfallen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1350080",
          "text": "Eine gute Idee ist ihm eingefallen.",
          "translation": "Ему пришла в голову хорошая идея.",
          "source": "Tatoeba #1350080 @Manfredo / #4388310 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1350080",
          "cefr_level": "A1",
          "word_slugs": [
            "eingefallen-verb"
          ]
        },
        {
          "id": "8629040",
          "text": "Das Dach des Hauses ist eingefallen.",
          "translation": "Крыша дома обрушилась.",
          "source": "Tatoeba #8629040 @Melang / #8632718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8629040",
          "cefr_level": "A1",
          "word_slugs": [
            "eingefallen-verb"
          ]
        },
        {
          "id": "1370263",
          "text": "Die Feinde sind in unser Land eingefallen.",
          "translation": "Враги вторглись в нашу страну.",
          "source": "Tatoeba #1370263 @al_ex_an_der / #1793726 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1370263",
          "cefr_level": "A1",
          "word_slugs": [
            "eingefallen-verb"
          ]
        },
        {
          "id": "2883892",
          "text": "Warum ist uns das nicht früher eingefallen?",
          "translation": "Почему мы раньше об этом не подумали?",
          "source": "Tatoeba #2883892 @Pfirsichbaeumchen / #4865085 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2883892",
          "cefr_level": "A1",
          "word_slugs": [
            "eingefallen-verb"
          ]
        },
        {
          "id": "6313370",
          "text": "Und warum ist es dir nicht eingefallen, das früher zu sagen?",
          "translation": "И почему тебе не пришло в голову сказать об этом раньше?",
          "source": "Tatoeba #6313370 @Pfirsichbaeumchen / #5355749 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6313370",
          "cefr_level": "A1",
          "word_slugs": [
            "eingefallen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
