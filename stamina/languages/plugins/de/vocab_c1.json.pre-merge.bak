      },
      "gender": null,
      "examples": [
        {
          "id": "10039726",
          "text": "Wie die Zeit vergeht!",
          "translation": "Как летит время!",
          "source": "Tatoeba #10039726 @Yorwba / #1987945 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10039726",
          "cefr_level": "A1",
          "word_slugs": [
            "vergeht-verb"
          ]
        },
        {
          "id": "13475090",
          "text": "Der Tag vergeht schnell.",
          "translation": "День проходит быстро.",
          "source": "Tatoeba #13475090 @mhr / #13475085 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13475090",
          "cefr_level": "A1",
          "word_slugs": [
            "vergeht-verb"
          ]
        },
        {
          "id": "967136",
          "text": "Die Zeit vergeht schnell.",
          "translation": "Время быстро проходит.",
          "source": "Tatoeba #967136 @Sudajaengi / #592069 @leyla (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/967136",
          "cefr_level": "A1",
          "word_slugs": [
            "vergeht-verb"
          ]
        },
        {
          "id": "9996965",
          "text": "Die Zeit vergeht langsam.",
          "translation": "Время тянется медленно.",
          "source": "Tatoeba #9996965 @Yorwba / #6056339 @sergiomelo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9996965",
          "cefr_level": "A1",
          "word_slugs": [
            "vergeht-verb"
          ]
        },
        {
          "id": "13440011",
          "text": "Ein Jahr vergeht schnell.",
          "translation": "Год быстро проходит.",
          "source": "Tatoeba #13440011 @Adelpa / #13440032 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13440011",
          "cefr_level": "A1",
          "word_slugs": [
            "vergeht-verb"
          ]
        }
      ],
