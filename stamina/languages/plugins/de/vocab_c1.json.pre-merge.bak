          ]
        },
        {
          "id": "3143644",
          "text": "Er besuchte den Lehrer.",
          "translation": "Он навестил учителя.",
          "source": "Tatoeba #3143644 @faehrmann / #4420959 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3143644",
