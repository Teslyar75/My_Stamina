      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of übertreiben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3684777",
          "text": "Du übertreibst alles.",
          "translation": "Ты всё преувеличиваешь.",
          "source": "Tatoeba #3684777 @al_ex_an_der / #3684608 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3684777",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreibst-verb"
          ]
        },
        {
          "id": "3422541",
          "text": "Ich finde, du übertreibst.",
          "translation": "По-моему, ты преувеличиваешь.",
          "source": "Tatoeba #3422541 @Pfirsichbaeumchen / #3631851 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3422541",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreibst-verb"
          ]
        },
        {
          "id": "3247205",
          "text": "Ich glaube, du übertreibst.",
          "translation": "По-моему, ты преувеличиваешь.",
          "source": "Tatoeba #3247205 @freddy1 / #3631851 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3247205",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreibst-verb"
          ]
        },
        {
          "id": "2835207",
          "text": "Übertreibst du nicht ein bisschen?",
          "translation": "Ты не преувеличиваешь немного?",
          "source": "Tatoeba #2835207 @brauchinet / #12624590 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2835207",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreibst-verb"
          ]
        },
        {
          "id": "8242012",
          "text": "Findest du nicht, dass du etwas übertreibst?",
          "translation": "Тебе не кажется, что ты слегка преувеличиваешь?",
          "source": "Tatoeba #8242012 @Pfirsichbaeumchen / #12390565 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8242012",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreibst-verb"
          ]
        }
