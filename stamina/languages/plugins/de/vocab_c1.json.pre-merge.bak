          ]
        },
        {
          "id": "13603633",
          "text": "Ihr hättet Toms Gesichtsausdruck sehen sollen!",
          "translation": "Нужно было видеть выражение лица Тома.",
          "source": "Tatoeba #13603633 @Waldelfe / #6616764 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13603633",
          "cefr_level": "A1",
