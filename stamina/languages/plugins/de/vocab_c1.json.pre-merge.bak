    {
      "slug": "tierarzt-noun",
      "lemma": "Tierarzt",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8228,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "veterinarian, veterinary surgeon (male or of unspecified gender)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "10099306",
          "text": "Tom ist kein Tierarzt.",
          "translation": "Том не ветеринар.",
          "source": "Tatoeba #10099306 @wolfgangth / #9038641 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10099306",
          "cefr_level": "A1",
          "word_slugs": [
            "tierarzt-noun"
          ]
        },
        {
          "id": "2785309",
          "text": "Mein Bruder ist Tierarzt.",
          "translation": "Мой брат — ветеринар.",
          "source": "Tatoeba #2785309 @mahannah / #6016482 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2785309",
          "cefr_level": "A1",
          "word_slugs": [
            "tierarzt-noun"
          ]
        },
        {
          "id": "6555001",
          "text": "Tom wollte Tierarzt werden.",
          "translation": "Том хотел стать ветеринаром.",
          "source": "Tatoeba #6555001 @Esperantostern / #3647626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6555001",
          "cefr_level": "A1",
          "word_slugs": [
            "tierarzt-noun"
          ]
        },
        {
          "id": "2872773",
          "text": "Ich brachte meinen Hund zum Tierarzt.",
          "translation": "Я привёл свою собаку к ветеринару.",
          "source": "Tatoeba #2872773 @alik_farber / #6702679 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2872773",
          "cefr_level": "A1",
          "word_slugs": [
            "tierarzt-noun"
          ]
        },
        {
          "id": "14069405",
          "text": "Ich will Tierarzt sein wie mein Papa.",
          "translation": "Я хочу быть ветеринаром, как папа.",
          "source": "Tatoeba #14069405 @maaster / #14072993 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14069405",
          "cefr_level": "A1",
          "word_slugs": [
            "tierarzt-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Tierarzt",
        "nominative_pl": ""
      }
    },
    {
      "slug": "cousins-noun",
      "lemma": "Cousins",
      "pos": "noun",
      "language": "de",
