          ]
        },
        {
          "id": "7828448",
          "text": "Habt keine Angst vor Änderungen.",
          "translation": "Не бойтесь перемен.",
          "source": "Tatoeba #7828448 @raggione / #4674207 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7828448",
          "cefr_level": "A1",
          "word_slugs": [
            "änderungen-noun"
          ]
        },
        {
          "id": "7828447",
          "text": "Fürchte dich nicht vor Änderungen.",
