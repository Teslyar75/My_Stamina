    {
      "slug": "schenkte-verb",
      "lemma": "schenkte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7911,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of schenken:",
          "first/third-person singular preterite",
          "inflection of schenken:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "978375",
          "text": "Sie schenkte mir etwas.",
          "translation": "Она мне кое-что подарила.",
          "source": "Tatoeba #978375 @Sudajaengi / #12820829 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/978375",
          "cefr_level": "A1",
          "word_slugs": [
            "schenkte-verb"
          ]
        },
        {
          "id": "12184537",
          "text": "Er schenkte ihr Blumen.",
          "translation": "Он ей подарил цветы.",
          "source": "Tatoeba #12184537 @Pfirsichbaeumchen / #13549220 @EugeneGS (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12184537",
          "cefr_level": "A1",
          "word_slugs": [
            "schenkte-verb"
          ]
        },
        {
          "id": "6381763",
          "text": "Tom schenkte Maria Blumen.",
          "translation": "Том подарил Мэри цветы.",
          "source": "Tatoeba #6381763 @Pfirsichbaeumchen / #6042533 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6381763",
          "cefr_level": "A1",
          "word_slugs": [
            "schenkte-verb"
          ]
        },
        {
          "id": "4309991",
          "text": "Niemand schenkte ihr Glauben.",
          "translation": "Никто ей не верил.",
          "source": "Tatoeba #4309991 @al_ex_an_der / #4308618 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4309991",
          "cefr_level": "A1",
          "word_slugs": [
            "schenkte-verb"
          ]
        },
        {
          "id": "2991361",
          "text": "Tom schenkte Maria Diamantohrringe.",
          "translation": "Том подарил Марии бриллиантовые серёжки.",
          "source": "Tatoeba #2991361 @Pfirsichbaeumchen / #3874582 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2991361",
          "cefr_level": "A1",
          "word_slugs": [
            "schenkte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
