          "zu-infinitive of ausschalten"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12688223",
          "text": "Vergiss nicht, die Bildschirme auszuschalten!",
          "translation": "Не забудь выключить мониторы.",
          "source": "Tatoeba #12688223 @mhr / #12687143 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12688223",
          "cefr_level": "A1",
          "word_slugs": [
