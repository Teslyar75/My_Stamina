        "en": [
          "to drive away, to drive off",
          "to drive away, take away with a vehicle"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3693535",
          "text": "Willst du wegfahren?",
          "translation": "Ты хочешь уехать?",
          "source": "Tatoeba #3693535 @Elliv / #3688909 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3693535",
          "cefr_level": "A1",
          "word_slugs": [
            "wegfahren-verb"
          ]
        },
        {
          "id": "12204191",
          "text": "Er wird bald wegfahren.",
          "translation": "Он скоро уедет.",
          "source": "Tatoeba #12204191 @mhr / #6179068 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12204191",
          "cefr_level": "A1",
          "word_slugs": [
            "wegfahren-verb"
          ]
        },
        {
          "id": "12204192",
          "text": "Sie wird bald wegfahren.",
          "translation": "Она скоро уедет.",
          "source": "Tatoeba #12204192 @mhr / #6179069 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12204192",
          "cefr_level": "A1",
          "word_slugs": [
            "wegfahren-verb"
          ]
        },
        {
          "id": "7293464",
          "text": "Ich will überhaupt nicht wegfahren.",
          "translation": "Мне совсем не хочется уезжать.",
          "source": "Tatoeba #7293464 @rajmund / #7292196 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7293464",
          "cefr_level": "A1",
          "word_slugs": [
            "wegfahren-verb"
          ]
        },
        {
          "id": "13919167",
          "text": "Er wird in einer Stunde wegfahren.",
          "translation": "Он уедет через час.",
          "source": "Tatoeba #13919167 @mhr / #13919142 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13919167",
          "cefr_level": "A1",
