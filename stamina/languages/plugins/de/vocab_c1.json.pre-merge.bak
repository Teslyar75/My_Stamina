      },
      "gender": null,
      "examples": [
        {
          "id": "11587566",
          "text": "Wen suchten Sie?",
          "translation": "Кого Вы искали?",
          "source": "Tatoeba #11587566 @Rovo / #11587897 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11587566",
          "cefr_level": "A1",
          "word_slugs": [
            "suchten-verb"
          ]
        },
        {
          "id": "11733251",
          "text": "Alle suchten Tom.",
          "translation": "Все искали Тома.",
          "source": "Tatoeba #11733251 @mhr / #4240902 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11733251",
          "cefr_level": "A1",
          "word_slugs": [
            "suchten-verb"
          ]
        },
        {
          "id": "11587574",
          "text": "Wir suchten jemanden.",
          "translation": "Мы кое-кого искали.",
          "source": "Tatoeba #11587574 @Pfirsichbaeumchen / #11586899 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11587574",
          "cefr_level": "A1",
          "word_slugs": [
            "suchten-verb"
          ]
        },
        {
          "id": "8291070",
          "text": "Wir suchten einen Freund.",
          "translation": "Мы искали друга.",
          "source": "Tatoeba #8291070 @felix63 / #9002833 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8291070",
          "cefr_level": "A1",
          "word_slugs": [
            "suchten-verb"
          ]
        },
        {
          "id": "12152225",
          "text": "Ich wusste, wen Sie suchten.",
          "translation": "Я знал, кого Вы ищете.",
          "source": "Tatoeba #12152225 @Pfirsichbaeumchen / #12153188 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12152225",
          "cefr_level": "A1",
          "word_slugs": [
            "suchten-verb"
          ]
        }
      ],
