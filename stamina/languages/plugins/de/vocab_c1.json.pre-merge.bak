    {
      "slug": "komischen-adj",
      "lemma": "komischen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7553,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of komisch:",
          "strong genitive masculine/neuter singular",
          "inflection of komisch:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3045978",
          "text": "Vergangene Nacht hatte ich einen komischen Traum.",
          "translation": "Прошлой ночью мне приснился странный сон.",
          "source": "Tatoeba #3045978 @Zaghawa / #408401 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3045978",
          "cefr_level": "A1",
          "word_slugs": [
            "komischen-adj"
          ]
        },
        {
          "id": "13623535",
          "text": "Warum sprichst du mit einer so komischen Stimme?",
          "translation": "Почему ты говоришь таким странным голосом?",
          "source": "Tatoeba #13623535 @maaster / #13623548 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13623535",
          "cefr_level": "A1",
          "word_slugs": [
            "komischen-adj"
          ]
        }
      ],
      "tags": [
