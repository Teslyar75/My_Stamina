    {
      "slug": "verzeihe-verb",
      "lemma": "verzeihe",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9703,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verzeihen:",
          "first-person singular present",
          "inflection of verzeihen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "809973",
          "text": "Ich verzeihe dir.",
          "translation": "Я тебя прощаю.",
          "source": "Tatoeba #809973 @yunyo / #4475356 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/809973",
          "cefr_level": "A1",
          "word_slugs": [
            "verzeihe-verb"
          ]
        },
        {
          "id": "5898561",
          "text": "Ich verzeihe alles.",
          "translation": "Я прощаю всё.",
          "source": "Tatoeba #5898561 @raggione / #5906190 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5898561",
          "cefr_level": "A1",
          "word_slugs": [
            "verzeihe-verb"
          ]
        },
        {
          "id": "1967067",
          "text": "Ich verzeihe Ihnen nicht.",
          "translation": "Я не прощаю Вас.",
          "source": "Tatoeba #1967067 @Manfredo / #6197407 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1967067",
          "cefr_level": "A1",
          "word_slugs": [
            "verzeihe-verb"
          ]
        },
        {
          "id": "4622709",
          "text": "Ich verzeihe ihnen nicht.",
          "translation": "Я их не прощаю.",
          "source": "Tatoeba #4622709 @Tamy / #2759575 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4622709",
          "cefr_level": "A1",
          "word_slugs": [
            "verzeihe-verb"
          ]
        },
        {
          "id": "3696993",
          "text": "Na gut. Ich verzeihe dir.",
          "translation": "Ничего. Я тебя прощаю.",
          "source": "Tatoeba #3696993 @Esperantostern / #3697065 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3696993",
          "cefr_level": "A1",
          "word_slugs": [
            "verzeihe-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
