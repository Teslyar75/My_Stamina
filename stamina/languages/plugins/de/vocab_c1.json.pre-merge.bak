      },
      "gender": null,
      "examples": [
        {
          "id": "13095432",
          "text": "Er hat eine kranke Lunge.",
          "translation": "У него больные лёгкие.",
          "source": "Tatoeba #13095432 @mhr / #13094965 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13095432",
          "cefr_level": "A1",
