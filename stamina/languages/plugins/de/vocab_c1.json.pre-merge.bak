    {
      "slug": "vergleichen-verb",
      "lemma": "vergleichen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5801,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to compare"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13445208",
          "text": "Denken heißt vergleichen.",
          "translation": "Думать — значит сравнивать.",
          "source": "Tatoeba #13445208 @Waldelfe / #7643723 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13445208",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-verb"
          ]
        },
        {
          "id": "12181194",
          "text": "Wie kann man vergleichen?",
          "translation": "Как можно сравнивать?",
          "source": "Tatoeba #12181194 @xallace / #12181195 @xallace (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12181194",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-verb"
          ]
        },
        {
          "id": "8232039",
          "text": "Womit kann man das vergleichen?",
          "translation": "С чем это можно сравнить?",
          "source": "Tatoeba #8232039 @Pfirsichbaeumchen / #6770974 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8232039",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-verb"
          ]
        },
        {
          "id": "13434795",
          "text": "Die kann man nicht vergleichen.",
          "translation": "Их нельзя сравнивать.",
          "source": "Tatoeba #13434795 @mhr / #11376982 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13434795",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-verb"
          ]
        },
        {
          "id": "13434796",
          "text": "Man kann sie nicht vergleichen.",
          "translation": "Их нельзя сравнивать.",
          "source": "Tatoeba #13434796 @mhr / #11376982 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13434796",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "vergleichen-noun",
      "lemma": "Vergleichen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5801,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Vergleich"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13445214",
          "text": "Vergleichen Sie die Ergebnisse!",
          "translation": "Сравните результаты.",
          "source": "Tatoeba #13445214 @Waldelfe / #11106243 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13445214",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-noun"
          ]
        },
        {
          "id": "8210501",
          "text": "Vergleichen Sie sich nicht mit anderen.",
          "translation": "Не сравнивайте себя с другими.",
          "source": "Tatoeba #8210501 @Pfirsichbaeumchen / #6640419 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8210501",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-noun"
          ]
        },
        {
          "id": "13712210",
          "text": "Vergleichen Sie Ihre Antworten mit meinen!",
          "translation": "Сравните свои ответы с моими.",
          "source": "Tatoeba #13712210 @mhr / #12606385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13712210",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-noun"
          ]
        },
        {
          "id": "1009290",
          "text": "Vergleichen Sie Ihre Übersetzung mit seiner.",
          "translation": "Сравните свой перевод с его.",
          "source": "Tatoeba #1009290 @Sudajaengi / #12298729 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1009290",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-noun"
          ]
        },
        {
          "id": "13712169",
          "text": "Vergleichen Sie mich bitte nicht mit ihm.",
          "translation": "Не сравнивайте меня с ним, пожалуйста.",
          "source": "Tatoeba #13712169 @mhr / #13711984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13712169",
          "cefr_level": "A1",
          "word_slugs": [
            "vergleichen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "schweiz-name",
      "lemma": "Schweiz",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5802,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Switzerland (a country in Western Europe and Central Europe)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13755828",
          "text": "Ich wohne in der Schweiz.",
          "translation": "Я живу в Швейцарии.",
          "source": "Tatoeba #13755828 @ninefi / #11148773 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13755828",
          "cefr_level": "A1",
          "word_slugs": [
            "schweiz-name"
          ]
        },
        {
          "id": "8475398",
          "text": "Ich arbeite in der Schweiz.",
          "translation": "Я работаю в Швейцарии.",
          "source": "Tatoeba #8475398 @Luiaard / #11931485 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8475398",
          "cefr_level": "A1",
          "word_slugs": [
            "schweiz-name"
          ]
        },
        {
          "id": "5066771",
          "text": "Die Schweiz ist nicht Schweden.",
          "translation": "Швейцария не Швеция.",
          "source": "Tatoeba #5066771 @al_ex_an_der / #5066777 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5066771",
          "cefr_level": "A1",
          "word_slugs": [
            "schweiz-name"
          ]
        },
        {
          "id": "5983899",
          "text": "Die Schweiz liegt in Mitteleuropa.",
          "translation": "Швейцария находится в Центральной Европе.",
          "source": "Tatoeba #5983899 @Pfirsichbaeumchen / #5990837 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5983899",
          "cefr_level": "A1",
          "word_slugs": [
            "schweiz-name"
          ]
        },
        {
          "id": "8631647",
          "text": "Grenzt Deutschland an die Schweiz?",
          "translation": "Германия граничит со Швейцарией?",
          "source": "Tatoeba #8631647 @Pfirsichbaeumchen / #5383741 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8631647",
          "cefr_level": "A1",
          "word_slugs": [
            "schweiz-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Schweiz",
        "nominative_pl": ""
      }
    },
    {
      "slug": "bemerken-verb",
