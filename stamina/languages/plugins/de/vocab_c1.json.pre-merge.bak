    {
      "slug": "tugend-noun",
      "lemma": "Tugend",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9333,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "достоинство"
        ],
        "en": [
          "virtue"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3136299",
          "text": "Schlichtheit ist eine Tugend.",
          "translation": "Простота является добродетелью.",
          "source": "Tatoeba #3136299 @al_ex_an_der / #3136283 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3136299",
          "cefr_level": "A1",
          "word_slugs": [
            "tugend-noun"
          ]
        },
        {
          "id": "8629187",
          "text": "Bescheidenheit ist eine Tugend.",
          "translation": "Скромность - это добродетель.",
          "source": "Tatoeba #8629187 @Melang / #8632648 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8629187",
          "cefr_level": "A1",
          "word_slugs": [
            "tugend-noun"
          ]
        },
        {
          "id": "1855537",
          "text": "Schönheit vergeht, Tugend besteht.",
          "translation": "Красота преходяща, добродетель вечна.",
          "source": "Tatoeba #1855537 @Esperantostern / #5599167 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1855537",
          "cefr_level": "A1",
          "word_slugs": [
            "tugend-noun"
          ]
        },
        {
          "id": "3545840",
          "text": "Verdunkelte Tugend scheint heller.",
          "translation": "Завуалированная добродетель светит ярче.",
          "source": "Tatoeba #3545840 @Esperantostern / #3546996 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3545840",
          "cefr_level": "A1",
          "word_slugs": [
            "tugend-noun"
          ]
        },
        {
          "id": "3136273",
          "text": "Die Einfachheit ist eine Tugend.",
          "translation": "Простота является добродетелью.",
