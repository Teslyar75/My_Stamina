      "translations": {
        "en": [
          "inflection of menschlich:",
          "strong/mixed nominative masculine singular",
          "inflection of menschlich:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "364464",
          "text": "Ein menschlicher Körper besteht aus unzähligen Zellen.",
          "translation": "Человеческое тело состоит из бесчисленного количества клеток.",
          "source": "Tatoeba #364464 @Wolf / #1799417 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/364464",
          "cefr_level": "A1",
          "word_slugs": [
            "menschlicher-adj"
          ]
        },
        {
          "id": "13618683",
          "text": "Hie und da konnte waren Spuren menschlicher Aktivität sichtbar.",
          "translation": "То там, то здесь были видны следы человеческой деятельности.",
          "source": "Tatoeba #13618683 @Waldelfe / #13616725 @frpzzd (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13618683",
          "cefr_level": "A1",
          "word_slugs": [
            "menschlicher-adj"
          ]
        },
        {
          "id": "13618681",
          "text": "Hie und da konnte waren Spuren menschlicher Tätigkeit zu sehen.",
          "translation": "То там, то здесь были видны следы человеческой деятельности.",
          "source": "Tatoeba #13618681 @Waldelfe / #13616725 @frpzzd (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13618681",
          "cefr_level": "A1",
