    {
      "slug": "hebt-verb",
      "lemma": "hebt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5091,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of heben:",
          "third-person singular present",
          "inflection of heben:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8320762",
          "text": "Er hebt sein Bein.",
          "translation": "Он поднимает ногу.",
          "source": "Tatoeba #8320762 @MisterTrouser / #11836411 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8320762",
          "cefr_level": "A1",
