    {
      "slug": "geste-noun",
      "lemma": "Geste",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6389,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gesture"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1549313",
          "text": "Er machte eine ungeduldige Geste.",
          "translation": "Он сделал нетерпеливый жест.",
          "source": "Tatoeba #1549313 @Zaghawa / #12749030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1549313",
          "cefr_level": "A1",
          "word_slugs": [
            "geste-noun"
          ]
        },
        {
          "id": "2510169",
          "text": "Manchmal ist eine freundliche Geste mehr wert als viele Worte.",
          "translation": "Иногда один дружеский жест стоит больше, чем множество слов.",
          "source": "Tatoeba #2510169 @al_ex_an_der / #2510174 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2510169",
          "cefr_level": "A1",
          "word_slugs": [
            "geste-noun"
          ]
        },
        {
          "id": "2510178",
          "text": "Manchmal ist eine freundschaftliche Geste mehr wert als tausend Worte.",
          "translation": "Иногда один дружеский жест стоит больше, чем множество слов.",
          "source": "Tatoeba #2510178 @al_ex_an_der / #2510174 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2510178",
          "cefr_level": "A1",
          "word_slugs": [
            "geste-noun"
          ]
        }
      ],
