    {
      "slug": "beschuldigt-verb",
      "lemma": "beschuldigt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5217,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of beschuldigen:",
          "third-person singular present",
          "inflection of beschuldigen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1443751",
          "text": "Ein schlechter Handwerker beschuldigt sein Werkzeug.",
          "translation": "Плохому танцору ноги мешают.",
          "source": "Tatoeba #1443751 @Esperantostern / #3589476 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1443751",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigt-verb"
          ]
        },
        {
          "id": "10018649",
          "text": "Tom wurde beschuldigt, ein Spion zu sein.",
          "translation": "Тома обвинили в том, что он шпион.",
          "source": "Tatoeba #10018649 @Melang / #6368350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10018649",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigt-verb"
          ]
        },
        {
          "id": "6792482",
          "text": "Sie weiß nicht, wessen man sie beschuldigt.",
          "translation": "Она не знает, в чём её обвиняют.",
          "source": "Tatoeba #6792482 @brauchinet / #6793170 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6792482",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigt-verb"
          ]
        },
        {
          "id": "1004497",
          "text": "Er wurde beschuldigt, Geld gestohlen zu haben.",
          "translation": "Его обвинили в краже денег.",
          "source": "Tatoeba #1004497 @Manfredo / #1109381 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1004497",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigt-verb"
          ]
        },
        {
          "id": "13452204",
          "text": "Warum beschuldigt sie mich für das Geschehene?",
          "translation": "Почему она обвиняет меня в случившемся?",
          "source": "Tatoeba #13452204 @mhr / #13451579 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13452204",
          "cefr_level": "A1",
          "word_slugs": [
            "beschuldigt-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
