      "examples": [
        {
          "id": "2571236",
          "text": "Er hielt das Gleichgewicht.",
          "translation": "Он держал равновесие.",
          "source": "Tatoeba #2571236 @Pfirsichbaeumchen / #3348486 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2571236",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichgewicht-noun"
          ]
        },
        {
          "id": "2941946",
          "text": "Tom hielt das Gleichgewicht.",
          "translation": "Том держал равновесие.",
          "source": "Tatoeba #2941946 @Pfirsichbaeumchen / #4947198 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2941946",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichgewicht-noun"
          ]
        },
        {
          "id": "4807434",
          "text": "Ich verlor das Gleichgewicht.",
          "translation": "Я потерял равновесие.",
          "source": "Tatoeba #4807434 @Tamy / #4947206 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4807434",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichgewicht-noun"
          ]
        },
        {
          "id": "3269681",
          "text": "Ich versuche, mein Gleichgewicht wiederzufinden.",
          "translation": "Я попытаюсь восстановить равновесие.",
          "source": "Tatoeba #3269681 @raggione / #3269974 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3269681",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichgewicht-noun"
          ]
        },
        {
          "id": "344274",
          "text": "Er verlor das Gleichgewicht und fiel hin.",
          "translation": "Он потерял равновесие и упал.",
          "source": "Tatoeba #344274 @MUIRIEL / #2422748 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/344274",
          "cefr_level": "A1",
          "word_slugs": [
            "gleichgewicht-noun"
          ]
        }
      ],
