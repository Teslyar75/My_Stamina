    {
      "slug": "absolute-adj",
      "lemma": "absolute",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5469,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of absolut:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of absolut:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "369154",
          "text": "Sie benötigen absolute Bettruhe.",
          "translation": "Вам необходим полный покой.",
          "source": "Tatoeba #369154 @xtofu80 / #1724829 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/369154",
          "cefr_level": "A1",
          "word_slugs": [
            "absolute-adj"
          ]
        },
        {
          "id": "6997732",
          "text": "Tom hat das absolute Gehör.",
          "translation": "У Тома абсолютный слух.",
          "source": "Tatoeba #6997732 @raggione / #6997738 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6997732",
          "cefr_level": "A1",
          "word_slugs": [
            "absolute-adj"
          ]
        },
        {
          "id": "1241845",
          "text": "Das ist der absolute Hammer!",
          "translation": "Это потрясающе!",
          "source": "Tatoeba #1241845 @Esperantostern / #6786626 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1241845",
          "cefr_level": "A1",
          "word_slugs": [
            "absolute-adj"
          ]
        },
        {
          "id": "2902646",
          "text": "Das ist die absolute Wahrheit!",
          "translation": "Это абсолютная правда.",
          "source": "Tatoeba #2902646 @Manfredo / #2682263 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2902646",
          "cefr_level": "A1",
          "word_slugs": [
            "absolute-adj"
          ]
        },
        {
          "id": "370818",
          "text": "Computer sind heutzutage eine absolute Notwendigkeit.",
          "translation": "Компьютер сейчас — абсолютная необходимость.",
          "source": "Tatoeba #370818 @xtofu80 / #3695934 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/370818",
          "cefr_level": "A1",
          "word_slugs": [
            "absolute-adj"
          ]
        }
      ],
