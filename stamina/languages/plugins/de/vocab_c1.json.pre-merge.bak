    {
      "slug": "klaren-adj",
      "lemma": "klaren",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6238,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of klar:",
          "strong genitive masculine/neuter singular",
          "inflection of klar:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6808281",
          "text": "Ich habe einen klaren Plan.",
          "translation": "У меня есть четкий план.",
          "source": "Tatoeba #6808281 @Swetlanaw / #6808279 @Swetlanaw (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6808281",
          "cefr_level": "A1",
          "word_slugs": [
            "klaren-adj"
          ]
        },
        {
          "id": "2369818",
          "text": "An klaren Tagen kann man den Fuji sehen.",
          "translation": "В ясный день можно видеть гору Фудзи.",
          "source": "Tatoeba #2369818 @Pfirsichbaeumchen / #3239029 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2369818",
          "cefr_level": "A1",
          "word_slugs": [
            "klaren-adj"
          ]
        },
        {
          "id": "3571901",
          "text": "Gut, ich werde morgen mit einem klaren Kopf darüber nachdenken.",
          "translation": "Ладно, подумаю завтра, на свежую голову.",
          "source": "Tatoeba #3571901 @al_ex_an_der / #3571688 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3571901",
          "cefr_level": "A1",
          "word_slugs": [
            "klaren-adj"
          ]
        },
        {
          "id": "3388895",
          "text": "An klaren Tagen kann man in der Ferne den Fuji sehen.",
          "translation": "В ясные дни вдали можно увидеть Фудзи.",
          "source": "Tatoeba #3388895 @Pfirsichbaeumchen / #3536062 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3388895",
          "cefr_level": "A1",
          "word_slugs": [
            "klaren-adj"
          ]
        },
        {
          "id": "8636765",
          "text": "In einer klaren Nacht kann man am Himmel die Milchstraße sehen.",
          "translation": "В ясную ночь в небе виден Млечный Путь.",
          "source": "Tatoeba #8636765 @Melang / #8639013 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636765",
          "cefr_level": "A1",
          "word_slugs": [
            "klaren-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
