          ]
        },
        {
          "id": "6285502",
          "text": "Haben Sie russische Zeitungen?",
          "translation": "У вас есть российские газеты?",
          "source": "Tatoeba #6285502 @Pfirsichbaeumchen / #6217372 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6285502",
          "cefr_level": "A1",
          "word_slugs": [
            "russische-adj"
          ]
        },
        {
          "id": "12858088",
          "text": "Anfisa ist russische Staatsbürgerin.",
          "translation": "Анфиса - гражданка России.",
          "source": "Tatoeba #12858088 @Waldelfe / #7971629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12858088",
          "cefr_level": "A1",
          "word_slugs": [
