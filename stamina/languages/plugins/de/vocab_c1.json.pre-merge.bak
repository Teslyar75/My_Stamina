    {
      "slug": "derart-adv",
      "lemma": "derart",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9299,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "so, thus, in such a manner",
          "to such an extent"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3044096",
          "text": "Ist das wirklich derart wichtig?",
          "translation": "Это действительно настолько важно?",
          "source": "Tatoeba #3044096 @Pfirsichbaeumchen / #10073202 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3044096",
          "cefr_level": "A1",
          "word_slugs": [
            "derart-adv"
          ]
        },
        {
          "id": "14110737",
          "text": "Erklären Sie es mir derart, dass ich es verstehe.",
          "translation": "Объясните мне так, чтобы я понял.",
          "source": "Tatoeba #14110737 @frpzzd / #8736521 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14110737",
          "cefr_level": "A1",
          "word_slugs": [
            "derart-adv"
          ]
        },
        {
          "id": "2769448",
          "text": "Ich habe keine Lust, irgendetwas zu tun, wenn es derart heiß ist.",
          "translation": "Мне ничего не хочется делать, когда такая жара.",
          "source": "Tatoeba #2769448 @raggione / #13339552 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2769448",
          "cefr_level": "A1",
          "word_slugs": [
            "derart-adv"
          ]
        },
        {
          "id": "2479274",
          "text": "Es schien ihr, als hätte sie nie zuvor derart klare Gedanken gehabt.",
          "translation": "Ей казалось, что у неё никогда ещё не было таких ясных мыслей.",
          "source": "Tatoeba #2479274 @al_ex_an_der / #2479272 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2479274",
          "cefr_level": "A1",
          "word_slugs": [
            "derart-adv"
          ]
        },
        {
          "id": "1718203",
          "text": "Hättest du nicht derart viel gegessen, wärest du jetzt nicht so müde.",
          "translation": "Если бы ты не ел так много, не был бы сейчас таким сонным.",
          "source": "Tatoeba #1718203 @Pfirsichbaeumchen / #1398864 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1718203",
          "cefr_level": "A1",
          "word_slugs": [
            "derart-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "unteren-adj",
      "lemma": "unteren",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9300,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of unterer:",
          "strong genitive masculine/neuter singular",
          "inflection of unterer:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14096825",
          "text": "Im unteren Stockwerk ist das Licht an.",
          "translation": "На нижнем этаже горит свет.",
          "source": "Tatoeba #14096825 @mhr / #14097349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14096825",
          "cefr_level": "A1",
          "word_slugs": [
            "unteren-adj"
          ]
        },
        {
          "id": "2379763",
          "text": "In den unteren Stockwerken ist es sehr dunkel.",
          "translation": "На нижних этажах очень темно.",
          "source": "Tatoeba #2379763 @Pfirsichbaeumchen / #8178063 @AntonKhorev (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2379763",
          "cefr_level": "A1",
          "word_slugs": [
            "unteren-adj"
          ]
        },
        {
          "id": "1669853",
          "text": "Möchten Sie im oberen oder im unteren Bett schlafen?",
          "translation": "Вы хотели бы на верхней кровати спать или на нижней?",
          "source": "Tatoeba #1669853 @al_ex_an_der / #13889732 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1669853",
          "cefr_level": "A1",
          "word_slugs": [
            "unteren-adj"
          ]
        },
        {
          "id": "1669854",
          "text": "Möchtest du im oberen oder im unteren Bett schlafen?",
          "translation": "Ты хотел бы на верхней кровати спать или на нижней?",
          "source": "Tatoeba #1669854 @al_ex_an_der / #13889731 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1669854",
          "cefr_level": "A1",
          "word_slugs": [
            "unteren-adj"
          ]
        },
        {
          "id": "3346072",
          "text": "Die unteren Stockwerke der Häuser waren in das Blau der Dämmerung getaucht.",
          "translation": "Нижние этажи домов погружались в синие сумерки.",
          "source": "Tatoeba #3346072 @al_ex_an_der / #3346069 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3346072",
          "cefr_level": "A1",
          "word_slugs": [
            "unteren-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
