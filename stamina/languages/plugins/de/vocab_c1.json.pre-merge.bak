    {
      "slug": "irgendeiner-pron",
      "lemma": "irgendeiner",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5019,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "feminine genitive/dative singular of irgendein"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4208066",
          "text": "Spielt irgendeiner deiner Freunde Gitarre?",
          "translation": "Кто-нибудь из твоих друзей играет на гитаре?",
          "source": "Tatoeba #4208066 @Pfirsichbaeumchen / #5326785 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4208066",
          "cefr_level": "A1",
          "word_slugs": [
            "irgendeiner-pron"
          ]
        },
        {
          "id": "441771",
          "text": "Wir sind immer irgendeiner Gefahr ausgesetzt.",
          "translation": "Мы постоянно подвергаемся какой-либо опасности.",
          "source": "Tatoeba #441771 @xtofu80 / #2269910 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/441771",
          "cefr_level": "A1",
          "word_slugs": [
            "irgendeiner-pron"
          ]
        },
        {
          "id": "3240718",
          "text": "Tom begriff nicht, dass er in irgendeiner Gefahr war.",
          "translation": "Том не осознавал, что находится в какой-либо опасности.",
          "source": "Tatoeba #3240718 @freddy1 / #3241801 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3240718",
          "cefr_level": "A1",
          "word_slugs": [
            "irgendeiner-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
