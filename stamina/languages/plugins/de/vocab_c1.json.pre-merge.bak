      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6319,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Australia (a country consisting of a main island, the island of Tasmania and other smaller islands, located in Oceania; historically, a collection of former colonies of the British",
          "Australia (a continent consisting of the land on the Australian tectonic plate, i.e. Australia, New Guinea and intervening islands)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6625953",
          "text": "Ich mag Australien.",
          "translation": "Мне нравится Австралия.",
          "source": "Tatoeba #6625953 @Felixjp / #4754946 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6625953",
          "cefr_level": "A1",
          "word_slugs": [
            "australien-name"
          ]
        },
        {
          "id": "10063249",
          "text": "Magst du Australien?",
          "translation": "Тебе нравится Австралия?",
          "source": "Tatoeba #10063249 @wolfgangth / #8261349 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10063249",
          "cefr_level": "A1",
          "word_slugs": [
            "australien-name"
          ]
        },
        {
          "id": "9066990",
          "text": "Ich kenne Australien.",
          "translation": "Я знаю Австралию.",
          "source": "Tatoeba #9066990 @list / #9358086 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9066990",
          "cefr_level": "A1",
          "word_slugs": [
            "australien-name"
          ]
        },
        {
          "id": "12427963",
          "text": "Wir lieben Australien.",
          "translation": "Мы любим Австралию.",
          "source": "Tatoeba #12427963 @Waldelfe / #10995776 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12427963",
          "cefr_level": "A1",
          "word_slugs": [
            "australien-name"
          ]
        },
        {
          "id": "7697118",
          "text": "Maria liebt Australien.",
          "translation": "Мэри любит Австралию.",
          "source": "Tatoeba #7697118 @wolfgangth / #7893925 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7697118",
          "cefr_level": "A1",
          "word_slugs": [
