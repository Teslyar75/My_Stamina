    {
      "slug": "wehtut-verb",
      "lemma": "wehtut",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8601,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "3613066",
          "text": "Passt auf, dass ihr euch nicht wehtut!",
          "translation": "Будьте внимательны, чтобы не причинить себе вреда!",
          "source": "Tatoeba #3613066 @raggione / #3616005 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3613066",
          "cefr_level": "A1",
          "word_slugs": [
            "wehtut-verb"
          ]
        },
