          ]
        },
        {
          "id": "13775482",
          "text": "Das ist ein Merkmal hoher Intelligenz.",
          "translation": "Это показатель высокого интеллекта.",
          "source": "Tatoeba #13775482 @mhr / #13775266 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13775482",
          "cefr_level": "A1",
          "word_slugs": [
            "hoher-adj"
          ]
        },
        {
          "id": "14014328",
          "text": "Ein hoher Preis garantiert keine Qualität.",
          "translation": "Высокая цена не гарантия качества.",
          "source": "Tatoeba #14014328 @mhr / #14014256 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14014328",
          "cefr_level": "A1",
          "word_slugs": [
            "hoher-adj"
          ]
        },
        {
          "id": "5443725",
          "text": "Japan ist ein Land mit hoher Bevölkerungsdichte.",
          "translation": "Япония — страна с большой плотностью населения.",
          "source": "Tatoeba #5443725 @Zaghawa / #6329207 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5443725",
          "cefr_level": "A1",
          "word_slugs": [
            "hoher-adj"
          ]
        },
        {
          "id": "14014327",
          "text": "Ein hoher Preis ist keine Garantie für Qualität.",
