      },
      "gender": null,
      "examples": [
        {
          "id": "3364563",
          "text": "Ich empfinde genauso.",
          "translation": "Я чувствую то же самое.",
          "source": "Tatoeba #3364563 @Pfirsichbaeumchen / #2810565 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3364563",
          "cefr_level": "A1",
          "word_slugs": [
            "empfinde-verb"
          ]
        },
        {
          "id": "403009",
          "text": "Ich empfinde eine tiefe Liebe für Japan.",
          "translation": "Я испытываю глубокую любовь к Японии.",
          "source": "Tatoeba #403009 @MUIRIEL / #12260617 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/403009",
          "cefr_level": "A1",
          "word_slugs": [
            "empfinde-verb"
          ]
        },
        {
          "id": "2707652",
          "text": "Ich empfinde keinen Hass meinem Bruder gegenüber.",
          "translation": "У меня нет ненависти к моему брату.",
          "source": "Tatoeba #2707652 @Pfirsichbaeumchen / #2707435 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2707652",
          "cefr_level": "A1",
          "word_slugs": [
            "empfinde-verb"
          ]
        },
        {
          "id": "4461067",
          "text": "Ihr alle wisst, was ich für Marika empfinde.",
          "translation": "Вы все знаете, что я чувствую к Марике.",
          "source": "Tatoeba #4461067 @brauchinet / #7807674 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4461067",
          "cefr_level": "A1",
          "word_slugs": [
            "empfinde-verb"
          ]
        },
        {
          "id": "5152120",
          "text": "In letzter Zeit empfinde ich alles nur noch als lästig.",
          "translation": "В последннее время я чувствую, что мне всё в тягость.",
          "source": "Tatoeba #5152120 @dispy / #5153444 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5152120",
          "cefr_level": "A1",
          "word_slugs": [
            "empfinde-verb"
          ]
        }
      ],
