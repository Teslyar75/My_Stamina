    {
      "slug": "manches-pron",
      "lemma": "manches",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7237,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive masculine/neuter singular of manch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12274977",
          "text": "Wir sehen manches einfach anders.",
          "translation": "Просто мы по-разному смотрим на некоторые вещи.",
          "source": "Tatoeba #12274977 @Pfirsichbaeumchen / #12274951 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12274977",
          "cefr_level": "A1",
          "word_slugs": [
            "manches-pron"
          ]
        },
        {
          "id": "4899934",
          "text": "Manches spielt einfach keine Rolle.",
          "translation": "Многое просто не играет никакой роли.",
          "source": "Tatoeba #4899934 @raggione / #6448201 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4899934",
          "cefr_level": "A1",
          "word_slugs": [
            "manches-pron"
          ]
        },
        {
          "id": "3527239",
          "text": "Manches können wir ändern, wenn wir es nur versuchen.",
          "translation": "Кое-что мы можем изменить, если просто попытаемся.",
          "source": "Tatoeba #3527239 @Pfirsichbaeumchen / #13215067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3527239",
          "cefr_level": "A1",
          "word_slugs": [
            "manches-pron"
          ]
        },
        {
          "id": "11988259",
          "text": "Über manches kann man leicht reden, es aber tun fällt schwer.",
          "translation": "О многих вещах легко говорить, но сложно делать.",
          "source": "Tatoeba #11988259 @Pfirsichbaeumchen / #474687 @las (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11988259",
          "cefr_level": "A1",
          "word_slugs": [
            "manches-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
