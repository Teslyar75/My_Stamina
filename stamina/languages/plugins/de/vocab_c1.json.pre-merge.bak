      "translations": {
        "en": [
          "inflection of politisch:",
          "strong genitive masculine/neuter singular",
          "inflection of politisch:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6823034",
          "text": "Gehören Sie zu einer politischen Partei?",
          "translation": "Вы состоите в какой-нибудь политической партии?",
          "source": "Tatoeba #6823034 @felix63 / #6823040 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6823034",
          "cefr_level": "A1",
          "word_slugs": [
            "politischen-adj"
          ]
        },
        {
          "id": "4537405",
          "text": "Tom ist einer politischen Partei beigetreten.",
          "translation": "Том вступил в политическую партию.",
          "source": "Tatoeba #4537405 @Pfirsichbaeumchen / #11641247 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4537405",
          "cefr_level": "A1",
          "word_slugs": [
            "politischen-adj"
          ]
        },
        {
          "id": "823142",
          "text": "Lincoln begrüßte seinen alten politischen Gegner.",
          "translation": "Линкольн приветствовал своего старого политического оппонента.",
          "source": "Tatoeba #823142 @Pfirsichbaeumchen / #860182 @timsa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/823142",
          "cefr_level": "A1",
          "word_slugs": [
            "politischen-adj"
          ]
        },
        {
          "id": "7430805",
          "text": "Der Gesundheitsschutz der Bevölkerung ist eines der politischen Ziele unserer Partei.",
          "translation": "Забота о здоровье населения - одна из политических целей нашей партии.",
          "source": "Tatoeba #7430805 @raggione / #7451746 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7430805",
          "cefr_level": "A1",
          "word_slugs": [
            "politischen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
