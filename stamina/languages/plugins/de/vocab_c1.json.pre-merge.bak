    {
      "slug": "ernähren-verb",
      "lemma": "ernähren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6348,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to nourish, to feed",
          "to eat",
          "to support"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12685391",
          "text": "Wovon ernähren sich Tiger?",
          "translation": "Чем питаются тигры?",
          "source": "Tatoeba #12685391 @mhr / #12684813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12685391",
          "cefr_level": "A1",
          "word_slugs": [
            "ernähren-verb"
          ]
        },
        {
          "id": "12697346",
          "text": "Wovon ernähren sich Wölfe?",
          "translation": "Чем питаются волки?",
          "source": "Tatoeba #12697346 @mhr / #12697342 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12697346",
          "cefr_level": "A1",
          "word_slugs": [
            "ernähren-verb"
          ]
        },
        {
          "id": "14061019",
          "text": "Wovon ernähren sich Frösche?",
          "translation": "Чем питаются лягушки?",
          "source": "Tatoeba #14061019 @mhr / #13298907 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14061019",
          "cefr_level": "A1",
          "word_slugs": [
            "ernähren-verb"
          ]
        },
        {
          "id": "2677732",
          "text": "Ich muss die Familie ernähren.",
          "translation": "Мне надо кормить семью.",
          "source": "Tatoeba #2677732 @al_ex_an_der / #2677726 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2677732",
          "cefr_level": "A1",
          "word_slugs": [
            "ernähren-verb"
          ]
        },
        {
          "id": "2761203",
          "text": "Robben ernähren sich von Fisch.",
          "translation": "Тюлени питаются рыбой.",
          "source": "Tatoeba #2761203 @brauchinet / #12215825 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2761203",
          "cefr_level": "A1",
          "word_slugs": [
            "ernähren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
