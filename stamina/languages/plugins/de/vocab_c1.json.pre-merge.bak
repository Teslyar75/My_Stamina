    {
      "slug": "machtlos-adj",
      "lemma": "machtlos",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9720,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "бессильный"
        ],
        "en": [
          "powerless"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4971609",
          "text": "Sie sind machtlos.",
          "translation": "Ты бессилен.",
          "source": "Tatoeba #4971609 @Esperantostern / #4971514 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4971609",
          "cefr_level": "A1",
          "word_slugs": [
            "machtlos-adj"
          ]
        },
        {
          "id": "1816339",
          "text": "Gegen Dummheit sind selbst die Götter machtlos.",
          "translation": "Против глупости даже боги бессильны.",
          "source": "Tatoeba #1816339 @Pfirsichbaeumchen / #8406667 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1816339",
          "cefr_level": "A1",
          "word_slugs": [
            "machtlos-adj"
          ]
        },
        {
          "id": "13635809",
          "text": "Verstand und Logik sind gegenüber Sturheit und Dummheit machtlos.",
          "translation": "Разум и логика бессильны перед упрямством и глупостью.",
          "source": "Tatoeba #13635809 @mhr / #13635803 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635809",
          "cefr_level": "A1",
          "word_slugs": [
            "machtlos-adj"
          ]
        },
        {
          "id": "13635811",
          "text": "Vernunft und Logik sind gegenüber Starrsinn und Dummheit machtlos.",
          "translation": "Разум и логика бессильны перед упрямством и глупостью.",
          "source": "Tatoeba #13635811 @mhr / #13635803 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635811",
          "cefr_level": "A1",
          "word_slugs": [
            "machtlos-adj"
          ]
        },
        {
          "id": "13635817",
          "text": "Vernunft und Logik sind machtlos gegenüber Starrsinn und Dummheit.",
          "translation": "Разум и логика бессильны перед упрямством и глупостью.",
          "source": "Tatoeba #13635817 @mhr / #13635803 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635817",
          "cefr_level": "A1",
          "word_slugs": [
            "machtlos-adj"
          ]
        }
