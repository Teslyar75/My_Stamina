        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12525565",
          "text": "Du bist eine kluge Frau.",
          "translation": "Ты умная женщина.",
          "source": "Tatoeba #12525565 @Waldelfe / #12099561 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12525565",
          "cefr_level": "A1",
