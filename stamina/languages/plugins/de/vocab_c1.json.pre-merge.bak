          "word_slugs": [
            "eintritt-noun"
          ]
        },
        {
          "id": "2569443",
          "text": "Wie viel kostet der Eintritt?",
          "translation": "Сколько стоит вход?",
          "source": "Tatoeba #2569443 @VirtuOZ / #2468179 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2569443",
