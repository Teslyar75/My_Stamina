    {
      "slug": "jahrhunderts-noun",
      "lemma": "Jahrhunderts",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6877,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Jahrhundert"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "532290",
          "text": "Esperanto ist die Sprache des 21. Jahrhunderts.",
          "translation": "Эсперанто - язык двадцать первого века.",
          "source": "Tatoeba #532290 @Manfredo / #2706122 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/532290",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderts-noun"
          ]
        },
        {
          "id": "3030499",
          "text": "Das Haus wurde Anfang des Jahrhunderts gebaut.",
          "translation": "Дом построили в начале века.",
          "source": "Tatoeba #3030499 @al_ex_an_der / #3030500 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3030499",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderts-noun"
          ]
        },
        {
          "id": "14097600",
          "text": "Meine Eltern wurden Mitte des zwanzigsten Jahrhunderts geboren.",
          "translation": "Мои родители родились в середине двадцатого века.",
          "source": "Tatoeba #14097600 @mhr / #14097595 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14097600",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderts-noun"
          ]
        },
        {
          "id": "6317721",
          "text": "In diesem Satz lebt noch der Geist des 19. Jahrhunderts.",
          "translation": "В этом предложении все еще жив дух XIX века.",
          "source": "Tatoeba #6317721 @Pfirsichbaeumchen / #12658378 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6317721",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderts-noun"
          ]
        },
        {
          "id": "12125824",
          "text": "Heute zählt er zu den bedeutendsten Komponisten des 19. Jahrhunderts.",
          "translation": "Сегодня он считается одним из самых выдающихся композиторов девятнадцатого века.",
          "source": "Tatoeba #12125824 @Lundian / #12125874 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12125824",
          "cefr_level": "A1",
          "word_slugs": [
            "jahrhunderts-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
