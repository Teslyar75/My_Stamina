        {
          "id": "3474181",
          "text": "In der Ferne donnern Kanonenschüsse.",
          "translation": "Вдалеке гремели пушечные выстрелы.",
          "source": "Tatoeba #3474181 @al_ex_an_der / #3474728 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3474181",
          "cefr_level": "A1",
          "word_slugs": [
            "ferne-noun"
          ]
        },
        {
          "id": "12769938",
          "text": "In der Ferne bellte ein Hund.",
          "translation": "Вдалеке залаяла собака.",
          "source": "Tatoeba #12769938 @mhr / #12768590 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12769938",
          "cefr_level": "A1",
          "word_slugs": [
            "ferne-noun"
          ]
        },
        {
          "id": "14056351",
          "text": "Tom grüßte mich aus der Ferne.",
          "translation": "Том поприветствовал меня издалека.",
          "source": "Tatoeba #14056351 @mhr / #14056205 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14056351",
          "cefr_level": "A1",
          "word_slugs": [
            "ferne-noun"
          ]
        },
        {
          "id": "435179",
          "text": "Wir hörten Schüsse in der Ferne.",
          "translation": "Мы услышали вдалеке выстрелы.",
          "source": "Tatoeba #435179 @muzikanta_hipopotamo / #2383020 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/435179",
          "cefr_level": "A1",
          "word_slugs": [
            "ferne-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
