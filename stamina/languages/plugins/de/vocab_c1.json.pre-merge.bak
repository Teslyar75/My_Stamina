    {
      "slug": "saison-noun",
      "lemma": "Saison",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5970,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "сезон"
        ],
        "en": [
          "season (a part of a year when something particular happens)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1622261",
          "text": "Erdbeeren haben gerade Saison.",
          "translation": "Сейчас клубничный сезон.",
          "source": "Tatoeba #1622261 @Pfirsichbaeumchen / #480638 @tirpitz (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1622261",
          "cefr_level": "A1",
          "word_slugs": [
            "saison-noun"
          ]
        },
        {
          "id": "1439481",
          "text": "Wassermelonen haben jetzt Saison.",
          "translation": "Сейчас сезон арбузов.",
          "source": "Tatoeba #1439481 @Espi / #3693046 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1439481",
          "cefr_level": "A1",
          "word_slugs": [
            "saison-noun"
          ]
        },
        {
          "id": "12434300",
          "text": "Die Saison hat noch nicht angefangen.",
          "translation": "Сезон ещё не начался.",
          "source": "Tatoeba #12434300 @maaster / #12435157 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12434300",
          "cefr_level": "A1",
          "word_slugs": [
            "saison-noun"
          ]
        },
        {
          "id": "8333915",
          "text": "Für ihn ist die Saison zu Ende.",
          "translation": "Для него сезон окончен.",
          "source": "Tatoeba #8333915 @brauchinet / #12214549 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8333915",
          "cefr_level": "A1",
          "word_slugs": [
            "saison-noun"
          ]
        },
        {
          "id": "10052092",
          "text": "Hat Tom in dieser Saison ein Tor geschossen?",
          "translation": "Том забил гол в этом сезоне?",
          "source": "Tatoeba #10052092 @sakslane / #10051930 @BW (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10052092",
          "cefr_level": "A1",
          "word_slugs": [
            "saison-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Saison",
        "nominative_pl": ""
      }
