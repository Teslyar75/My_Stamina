    {
      "slug": "lebenden-adj",
      "lemma": "lebenden",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5032,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of lebend:",
          "strong genitive masculine/neuter singular",
          "inflection of lebend:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7748573",
          "text": "Elefanten sind die größten heutzutage lebenden Tiere.",
          "translation": "Слоны — самые крупные животные, живущие в наши дни.",
          "source": "Tatoeba #7748573 @restcoser / #811734 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7748573",
          "cefr_level": "A1",
          "word_slugs": [
            "lebenden-adj"
          ]
        },
        {
          "id": "987",
          "text": "Elefanten sind die größten derzeitig lebenden Landtiere.",
          "translation": "Слоны — самые крупные из ныне живущих сухопутных животных.",
          "source": "Tatoeba #987 @MUIRIEL / #13756630 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/987",
          "cefr_level": "A1",
          "word_slugs": [
            "lebenden-adj"
          ]
        },
        {
          "id": "405193",
          "text": "Ich habe noch nie einen lebenden Wal gesehen.",
          "translation": "Я никогда не видел живого кита.",
          "source": "Tatoeba #405193 @xtofu80 / #11511906 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/405193",
          "cefr_level": "A1",
          "word_slugs": [
            "lebenden-adj"
          ]
        },
        {
          "id": "3234254",
          "text": "Der Arzt schickte einen lebenden Patienten ins Leichenschauhaus.",
          "translation": "Врач отправил в морг живого пациента.",
          "source": "Tatoeba #3234254 @al_ex_an_der / #3234154 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3234254",
          "cefr_level": "A1",
          "word_slugs": [
            "lebenden-adj"
          ]
        },
        {
          "id": "11584426",
          "text": "Welches sind die ältesten noch lebenden Tiere der Welt?",
          "translation": "Какие ныне живущие животные самые старые в мире?",
          "source": "Tatoeba #11584426 @Pfirsichbaeumchen / #12121913 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11584426",
          "cefr_level": "A1",
          "word_slugs": [
            "lebenden-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
