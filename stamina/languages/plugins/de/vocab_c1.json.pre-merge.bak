    {
      "slug": "amüsiert-verb",
      "lemma": "amüsiert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5176,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of amüsieren:",
          "third-person singular present",
          "inflection of amüsieren:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6639853",
          "text": "Ich habe mich gestern sehr amüsiert.",
          "translation": "Вчера я хорошо повеселился.",
          "source": "Tatoeba #6639853 @dasbeispielholz / #4654518 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6639853",
          "cefr_level": "A1",
          "word_slugs": [
            "amüsiert-verb"
          ]
        },
        {
          "id": "3696980",
          "text": "Amüsiert euch gut! Wir werden uns in einer Stunde wiedersehen.",
          "translation": "Веселитесь! Увидимся через час.",
          "source": "Tatoeba #3696980 @Esperantostern / #13866974 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3696980",
          "cefr_level": "A1",
          "word_slugs": [
            "amüsiert-verb"
          ]
        },
        {
          "id": "2187491",
          "text": "Alles interessiert mich, alles amüsiert oder verärgert mich, ganz nach den Umständen.",
          "translation": "Всё мне интересно, всё меня забавляет или огорчает, в зависимости от обстоятельств.",
          "source": "Tatoeba #2187491 @al_ex_an_der / #2187490 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2187491",
          "cefr_level": "A1",
          "word_slugs": [
            "amüsiert-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
