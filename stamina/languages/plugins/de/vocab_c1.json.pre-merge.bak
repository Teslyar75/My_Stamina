    {
      "slug": "hochzeitstag-noun",
      "lemma": "Hochzeitstag",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5423,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "день свадьбы"
        ],
        "en": [
          "wedding day",
          "wedding anniversary"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1935193",
          "text": "Ich habe unseren Hochzeitstag vergessen.",
          "translation": "Я забыл о годовщине нашей свадьбы.",
          "source": "Tatoeba #1935193 @Pfirsichbaeumchen / #3532067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1935193",
          "cefr_level": "A1",
          "word_slugs": [
            "hochzeitstag-noun"
          ]
        },
        {
          "id": "1368664",
          "text": "Wir gratulieren dir zum Hochzeitstag und wünschen dir alles Gute.",
          "translation": "В день вашей свадьбы поздравляем вас и желаем вам обоим всего наилучшего.",
          "source": "Tatoeba #1368664 @Esperantostern / #1368465 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1368664",
          "cefr_level": "A1",
          "word_slugs": [
            "hochzeitstag-noun"
          ]
        },
        {
          "id": "1368668",
          "text": "Wir gratulieren euch zum Hochzeitstag und wünschen euch alles Gute.",
          "translation": "В день вашей свадьбы поздравляем вас и желаем вам обоим всего наилучшего.",
          "source": "Tatoeba #1368668 @al_ex_an_der / #1368465 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1368668",
          "cefr_level": "A1",
          "word_slugs": [
            "hochzeitstag-noun"
          ]
        },
        {
          "id": "2849126",
          "text": "Tom vergisst nie, seiner Ehefrau zum Hochzeitstag Blumen zu schenken.",
          "translation": "Том не забывает никогда подарить своей жене цветы в день их свадьбы.",
          "source": "Tatoeba #2849126 @al_ex_an_der / #2849168 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2849126",
          "cefr_level": "A1",
          "word_slugs": [
            "hochzeitstag-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Hochzeitstag",
        "nominative_pl": ""
      }
    },
    {
      "slug": "melodie-noun",
      "lemma": "Melodie",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5424,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мелодия"
        ],
        "en": [
          "melody, tune (sequence of notes that makes up a musical phrase)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "815669",
          "text": "Spiel uns eine Melodie.",
          "translation": "Сыграй нам мелодию.",
          "source": "Tatoeba #815669 @jakov / #5997035 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/815669",
          "cefr_level": "A1",
          "word_slugs": [
            "melodie-noun"
          ]
        },
        {
          "id": "604240",
          "text": "Wie heißt diese Melodie?",
          "translation": "Как называется эта мелодия?",
          "source": "Tatoeba #604240 @Dejo / #6167165 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/604240",
          "cefr_level": "A1",
          "word_slugs": [
            "melodie-noun"
          ]
        },
        {
          "id": "2890593",
          "text": "Was für eine schöne Melodie!",
          "translation": "Какой красивый мотив!",
          "source": "Tatoeba #2890593 @Pfirsichbaeumchen / #2890449 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2890593",
          "cefr_level": "A1",
          "word_slugs": [
            "melodie-noun"
          ]
        },
        {
          "id": "2890594",
          "text": "Das ist eine schöne Melodie.",
          "translation": "Красивая мелодия.",
          "source": "Tatoeba #2890594 @Pfirsichbaeumchen / #3290118 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2890594",
          "cefr_level": "A1",
          "word_slugs": [
            "melodie-noun"
          ]
        },
        {
          "id": "13434730",
          "text": "Ich erkannte die Melodie nicht.",
          "translation": "Я не узнал мелодию.",
          "source": "Tatoeba #13434730 @mhr / #13435601 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13434730",
          "cefr_level": "A1",
          "word_slugs": [
            "melodie-noun"
          ]
        }
