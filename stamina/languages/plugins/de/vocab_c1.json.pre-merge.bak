      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "точный",
          "чёткий",
          "конкретный",
          "меткий",
          "выверенный",
          "прецизионный"
        ],
        "en": [
          "inflection of präzis:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of präzis:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13080858",
          "text": "Der Aufsatz war kurz und präzise.",
          "translation": "Эссе было кратким и точным.",
          "source": "Tatoeba #13080858 @mhr / #13080813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13080858",
          "cefr_level": "A1",
          "word_slugs": [
            "präzise-adj"
          ]
        },
        {
          "id": "13080862",
          "text": "Der Aufsatz war knapp und präzise.",
          "translation": "Эссе было кратким и точным.",
          "source": "Tatoeba #13080862 @mhr / #13080813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13080862",
          "cefr_level": "A1",
          "word_slugs": [
            "präzise-adj"
          ]
        },
        {
          "id": "13851528",
          "text": "Das ewige Dilemma aller Übersetzer: präzise oder schön übersetzen?",
          "translation": "Вечная дилемма всех переводчиков: перевести точно или красиво?",
          "source": "Tatoeba #13851528 @carlosalberto / #13851456 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13851528",
          "cefr_level": "A1",
          "word_slugs": [
            "präzise-adj"
          ]
        },
        {
          "id": "3527127",
          "text": "In gründlich durchdachten Sätzen umreißt dieses Parteiprogramm eine präzise politische Perspektive.",
          "translation": "В основательно продуманных предложениях эта партийная программа очерчивает точную политическую перспективу.",
          "source": "Tatoeba #3527127 @al_ex_an_der / #3527238 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3527127",
          "cefr_level": "A1",
          "word_slugs": [
            "präzise-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
