    {
      "slug": "anhand-prep",
      "lemma": "anhand",
      "pos": "prep",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9604,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "by means of, with (the help of)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14040646",
          "text": "Der Turm wurde anhand alter Skizzen wiederaufgebaut.",
          "translation": "Башня была восстановлена по старинным чертежам.",
          "source": "Tatoeba #14040646 @mhr / #14040584 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14040646",
          "cefr_level": "A1",
          "word_slugs": [
            "anhand-prep"
          ]
        },
        {
          "id": "765393",
          "text": "Der Lehrer erklärte seine Theorie anhand von Bildern.",
          "translation": "Учитель объяснял свою теорию, используя иллюстрации.",
          "source": "Tatoeba #765393 @jakov / #2847433 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/765393",
          "cefr_level": "A1",
          "word_slugs": [
            "anhand-prep"
          ]
        },
        {
          "id": "1420035",
          "text": "Können Sie das anhand eines konkreten Beispiels veranschaulichen?",
          "translation": "Вы можете это проиллюстрировать на конкретном примере?",
          "source": "Tatoeba #1420035 @al_ex_an_der / #2358080 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1420035",
          "cefr_level": "A1",
          "word_slugs": [
            "anhand-prep"
          ]
        },
        {
          "id": "11325349",
          "text": "Könntest du anhand eines Beispiels erklären, was du sagen willst?",
          "translation": "Ты не мог бы на примере объяснить, что ты имеешь в виду?",
          "source": "Tatoeba #11325349 @Pfirsichbaeumchen / #11327327 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11325349",
          "cefr_level": "A1",
          "word_slugs": [
            "anhand-prep"
          ]
        },
        {
          "id": "9755359",
          "text": "Die Leiche wurde anhand eines Leberflecks auf der Wange identifiziert.",
          "translation": "Труп был опознан по родинке на щеке.",
          "source": "Tatoeba #9755359 @GaryGaryGary / #4574298 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9755359",
          "cefr_level": "A1",
          "word_slugs": [
            "anhand-prep"
          ]
        }
