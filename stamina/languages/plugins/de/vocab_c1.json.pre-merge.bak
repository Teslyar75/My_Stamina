      "translations": {
        "en": [
          "inflection of kriminell:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of kriminell:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7919645",
          "text": "Tom hat eine kriminelle Vergangenheit.",
          "translation": "У Тома уголовное прошлое.",
          "source": "Tatoeba #7919645 @Pfirsichbaeumchen / #2959017 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7919645",
          "cefr_level": "A1",
          "word_slugs": [
            "kriminelle-adj"
          ]
        },
        {
          "id": "369784",
          "text": "Das ist eine kriminelle Handlung und du wirst sicherlich dafür bestraft werden!",
          "translation": "Это уголовное преступление, и ты несомненно будешь за это наказан!",
          "source": "Tatoeba #369784 @kriskelvin / #2932379 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/369784",
