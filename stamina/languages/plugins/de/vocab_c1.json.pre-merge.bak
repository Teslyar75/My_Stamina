    {
      "slug": "besuche-noun",
      "lemma": "Besuche",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5022,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Besuch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2030916",
          "text": "Er freute sich über diese Besuche.",
          "translation": "Он радовался этим визитам.",
          "source": "Tatoeba #2030916 @Sirio60 / #12159612 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2030916",
          "cefr_level": "A1",
          "word_slugs": [
            "besuche-noun"
          ]
        },
        {
          "id": "632071",
          "text": "Mein Rat: Besuche ihn jetzt nicht, kontaktiere ihn nur telefonisch.",
          "translation": "Мой совет - не ходи к нему сейчас, просто позвони.",
          "source": "Tatoeba #632071 @kolonjano / #1599094 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/632071",
          "cefr_level": "A1",
          "word_slugs": [
            "besuche-noun"
          ]
        },
        {
          "id": "2629783",
          "text": "Besuche mein Profil bei Facebook.",
          "translation": "Зайди ко мне на страницу в Фейсбуке.",
          "source": "Tatoeba #2629783 @Olya / #2629785 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2629783",
          "cefr_level": "A1",
          "word_slugs": [
            "besuche-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "besuche-verb",
      "lemma": "besuche",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5022,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of besuchen:",
          "first-person singular present",
          "inflection of besuchen:",
          "singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "581278",
          "text": "Ich besuche eine Privatschule.",
          "translation": "Я хожу в частную школу.",
          "source": "Tatoeba #581278 @Zaghawa / #1510969 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/581278",
          "cefr_level": "A1",
          "word_slugs": [
            "besuche-verb"
          ]
        },
        {
          "id": "8078724",
          "text": "Ich besuche Tom nicht oft.",
          "translation": "Я нечасто навещаю Тома.",
          "source": "Tatoeba #8078724 @Luiaard / #8103604 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8078724",
          "cefr_level": "A1",
          "word_slugs": [
            "besuche-verb"
          ]
        },
        {
          "id": "1762875",
          "text": "Ich besuche gerne meinen Onkel.",
          "translation": "Я люблю бывать в гостях у дяди.",
          "source": "Tatoeba #1762875 @Pfirsichbaeumchen / #8061378 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1762875",
          "cefr_level": "A1",
          "word_slugs": [
            "besuche-verb"
          ]
        },
        {
          "id": "3064757",
          "text": "Ich besuche dich nächsten Sonntag.",
          "translation": "Я навещу тебя в следующее воскресенье.",
          "source": "Tatoeba #3064757 @freddy1 / #3064771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3064757",
          "cefr_level": "A1",
          "word_slugs": [
            "besuche-verb"
          ]
        },
        {
          "id": "581279",
          "text": "Ich besuche eine staatliche Schule.",
          "translation": "Я хожу в государственную школу.",
          "source": "Tatoeba #581279 @Zaghawa / #10802718 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/581279",
          "cefr_level": "A1",
          "word_slugs": [
            "besuche-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
