          ]
        },
        {
          "id": "6793552",
          "text": "Tom will bewundert werden.",
          "translation": "Том хочет, чтобы им восхищались.",
          "source": "Tatoeba #6793552 @Esperantostern / #3777917 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6793552",
          "cefr_level": "A1",
          "word_slugs": [
            "bewundert-verb"
          ]
        },
        {
          "id": "1350016",
          "text": "Ja, jeder bewundert die Bilder, die er malt.",
