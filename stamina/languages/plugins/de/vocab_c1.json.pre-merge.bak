          ]
        },
        {
          "id": "7716746",
          "text": "Ich bin schlecht im Französischen.",
          "translation": "Я слаб во французском.",
          "source": "Tatoeba #7716746 @Pfirsichbaeumchen / #6400655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7716746",
          "cefr_level": "A1",
          "word_slugs": [
