    {
      "slug": "dose-noun",
      "lemma": "Dose",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6557,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
