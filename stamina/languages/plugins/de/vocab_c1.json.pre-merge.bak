          "cefr_level": "A1",
          "word_slugs": [
            "männliche-adj"
          ]
        },
        {
          "id": "13655700",
          "text": "Männliche Hirsche haben Hörner, aber Weibchen nicht.",
          "translation": "У самцов оленей есть рога, а у самок — нет.",
          "source": "Tatoeba #13655700 @Naina / #13655725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13655700",
          "cefr_level": "A1",
