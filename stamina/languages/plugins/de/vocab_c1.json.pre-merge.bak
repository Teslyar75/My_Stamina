    {
      "slug": "schoss-verb",
      "lemma": "schoss",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5024,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Formerly standard spelling of schoss which was deprecated in the spelling reform (Rechtschreibreform) of 1996."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5862880",
          "text": "Tom schoss dreimal.",
          "translation": "Том трижды выстрелил.",
          "source": "Tatoeba #5862880 @Pfirsichbaeumchen / #5862948 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5862880",
          "cefr_level": "A1",
          "word_slugs": [
            "schoss-verb"
          ]
        },
        {
          "id": "1314466",
          "text": "Er schoss auf mich.",
          "translation": "Он в меня выстрелил.",
          "source": "Tatoeba #1314466 @al_ex_an_der / #5192394 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1314466",
          "cefr_level": "A1",
          "word_slugs": [
            "schoss-verb"
          ]
        },
        {
          "id": "4943114",
          "text": "Sie schoss auf ihn.",
          "translation": "Она выстрелила в него.",
          "source": "Tatoeba #4943114 @Hans_Adler / #5192391 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4943114",
          "cefr_level": "A1",
          "word_slugs": [
            "schoss-verb"
          ]
        },
        {
          "id": "7697072",
          "text": "Maria schoss auf mich.",
          "translation": "Мэри в меня стреляла.",
          "source": "Tatoeba #7697072 @wolfgangth / #7894795 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7697072",
          "cefr_level": "A1",
          "word_slugs": [
            "schoss-verb"
          ]
        },
        {
          "id": "12187488",
          "text": "Er schoss den Bären an.",
          "translation": "Он подстрелил медведя.",
          "source": "Tatoeba #12187488 @mhr / #8651546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12187488",
