    {
      "slug": "fingen-verb",
      "lemma": "fingen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7063,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of fangen:",
          "first/third-person plural preterite",
          "inflection of fangen:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12003410",
          "text": "Sie fingen einen Dieb.",
          "translation": "Они поймали вора.",
          "source": "Tatoeba #12003410 @Augustus / #9527666 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12003410",
          "cefr_level": "A1",
          "word_slugs": [
            "fingen-verb"
          ]
        },
        {
          "id": "6015511",
          "text": "Sie fingen fünf Schmetterlinge.",
          "translation": "Они поймали пять бабочек.",
          "source": "Tatoeba #6015511 @list / #5284721 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6015511",
          "cefr_level": "A1",
          "word_slugs": [
            "fingen-verb"
          ]
        },
        {
          "id": "6173719",
          "text": "Sie fingen an zu tanzen.",
          "translation": "Они начали танцевать.",
          "source": "Tatoeba #6173719 @raggione / #4832964 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6173719",
          "cefr_level": "A1",
          "word_slugs": [
            "fingen-verb"
          ]
        },
        {
          "id": "3152104",
          "text": "Sie fingen an zu schießen.",
          "translation": "Они начали стрелять.",
          "source": "Tatoeba #3152104 @Pfirsichbaeumchen / #2987662 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3152104",
          "cefr_level": "A1",
          "word_slugs": [
            "fingen-verb"
          ]
        },
        {
          "id": "5843466",
          "text": "Beide fingen zu lachen an.",
          "translation": "Оба засмеялись.",
          "source": "Tatoeba #5843466 @raggione / #4768578 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5843466",
          "cefr_level": "A1",
          "word_slugs": [
            "fingen-verb"
          ]
        }
      ],
