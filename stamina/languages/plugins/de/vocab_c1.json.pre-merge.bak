    {
      "slug": "genaue-adj",
      "lemma": "genaue",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6468,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of genau:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of genau:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8838394",
          "text": "Ich kenne das genaue Datum.",
          "translation": "Я знаю точную дату.",
          "source": "Tatoeba #8838394 @carlosalberto / #8837863 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8838394",
          "cefr_level": "A1",
          "word_slugs": [
            "genaue-adj"
          ]
        },
        {
          "id": "10125049",
          "text": "Ich kenne das genaue Datum nicht.",
          "translation": "Я не знаю точную дату.",
          "source": "Tatoeba #10125049 @wolfgangth / #10125053 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10125049",
          "cefr_level": "A1",
          "word_slugs": [
            "genaue-adj"
          ]
        },
        {
          "id": "13475730",
          "text": "Die genaue Zahl nennt euch niemand.",
          "translation": "Точную цифру никто вам не назовёт.",
          "source": "Tatoeba #13475730 @mhr / #13475591 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13475730",
          "cefr_level": "A1",
          "word_slugs": [
            "genaue-adj"
          ]
        },
        {
          "id": "11860981",
          "text": "Ich wollte die genaue Uhrzeit wissen.",
          "translation": "Я хотел знать точное время.",
          "source": "Tatoeba #11860981 @stickerkleber / #11860998 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11860981",
          "cefr_level": "A1",
          "word_slugs": [
            "genaue-adj"
          ]
        },
        {
          "id": "752478",
          "text": "Bitte sagen Sie mir die genaue Zeit.",
          "translation": "Скажите мне, пожалуйста, точное время.",
          "source": "Tatoeba #752478 @Manfredo / #7166887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/752478",
          "cefr_level": "A1",
          "word_slugs": [
            "genaue-adj"
          ]
        }
      ],
      "tags": [
