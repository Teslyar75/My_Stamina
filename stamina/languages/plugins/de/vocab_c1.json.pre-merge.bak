      "gender": "m",
      "examples": [
        {
          "id": "8661653",
          "text": "Der Berg Fuji ist außergewöhnlich.",
          "translation": "Гора Фудзи необыкновенная.",
          "source": "Tatoeba #8661653 @Melang / #14043284 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8661653",
          "cefr_level": "A1",
          "word_slugs": [
            "aussergewöhnlich-adj"
          ]
        },
        {
          "id": "3755378",
          "text": "Der Winter war außergewöhnlich mild.",
          "translation": "Зима была необычайно мягкой.",
          "source": "Tatoeba #3755378 @Jens_Odo / #5929400 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3755378",
          "cefr_level": "A1",
          "word_slugs": [
            "aussergewöhnlich-adj"
          ]
        },
        {
          "id": "1937406",
          "text": "Das ist ein außergewöhnlich langer Satz.",
          "translation": "Это необычайно длинное предложение.",
          "source": "Tatoeba #1937406 @al_ex_an_der / #1937379 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1937406",
          "cefr_level": "A1",
          "word_slugs": [
            "aussergewöhnlich-adj"
          ]
        },
        {
          "id": "7448814",
          "text": "Das ist dir außergewöhnlich gut gelungen.",
          "translation": "Ты справился с этим экстраординарно.",
          "source": "Tatoeba #7448814 @Pfirsichbaeumchen / #7451931 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7448814",
          "cefr_level": "A1",
          "word_slugs": [
            "aussergewöhnlich-adj"
          ]
        },
        {
          "id": "1103345",
          "text": "Kioto ist eine außergewöhnlich schöne Stadt.",
          "translation": "Киото - необыкновенно красивый город.",
          "source": "Tatoeba #1103345 @Haehnchenpaella / #4353198 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1103345",
          "cefr_level": "A1",
