          ]
        },
        {
          "id": "12741183",
          "text": "Kontaktieren Sie seine Verwandten!",
          "translation": "Свяжитесь с его родственниками.",
          "source": "Tatoeba #12741183 @mhr / #12740967 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12741183",
          "cefr_level": "A1",
          "word_slugs": [
            "verwandten-noun"
          ]
        },
        {
          "id": "11150228",
          "text": "Tom wohnt bei seinen Verwandten.",
