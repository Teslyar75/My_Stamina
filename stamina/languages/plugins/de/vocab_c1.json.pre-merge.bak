    {
      "slug": "gewann-verb",
      "lemma": "gewann",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6458,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of gewinnen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1204772",
          "text": "Tom gewann die Wette.",
          "translation": "Том выиграл пари.",
          "source": "Tatoeba #1204772 @Espi / #5785021 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1204772",
          "cefr_level": "A1",
          "word_slugs": [
            "gewann-verb"
          ]
        },
        {
          "id": "7696954",
          "text": "Helen gewann den Preis.",
          "translation": "Елена выиграла приз.",
          "source": "Tatoeba #7696954 @wolfgangth / #10951641 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7696954",
          "cefr_level": "A1",
          "word_slugs": [
            "gewann-verb"
          ]
        },
        {
          "id": "8634603",
          "text": "Er gewann den Nobelpreis.",
          "translation": "Он получил Нобелевскую премию.",
          "source": "Tatoeba #8634603 @Melang / #8640236 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634603",
          "cefr_level": "A1",
          "word_slugs": [
            "gewann-verb"
          ]
        },
        {
          "id": "1757685",
          "text": "Er gewann eine Goldmedaille.",
          "translation": "Он завоевал золотую медаль.",
          "source": "Tatoeba #1757685 @Pfirsichbaeumchen / #2819366 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1757685",
          "cefr_level": "A1",
          "word_slugs": [
            "gewann-verb"
          ]
        },
        {
          "id": "1757687",
          "text": "Sie gewann eine Goldmedaille.",
          "translation": "Она выиграла золотую медаль.",
          "source": "Tatoeba #1757687 @Pfirsichbaeumchen / #2086622 @Lathean (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1757687",
          "cefr_level": "A1",
          "word_slugs": [
            "gewann-verb"
          ]
        }
      ],
