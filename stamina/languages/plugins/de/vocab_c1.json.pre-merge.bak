        "en": [
          "ham, pork from the hindquarter",
          "hams, buttocks",
          "old tome or painting"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "356584",
          "text": "Er mag Schinken und Eier.",
          "translation": "Он любит ветчину и яйца.",
          "source": "Tatoeba #356584 @MUIRIEL / #598823 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/356584",
          "cefr_level": "A1",
          "word_slugs": [
            "schinken-noun"
          ]
        },
        {
          "id": "6196915",
          "text": "Ich habe mir ein Sandwich mit Schinken, Salat und Tomaten bestellt.",
          "translation": "Я заказал сэндвич с беконом, салатом и помидорами.",
          "source": "Tatoeba #6196915 @Pfirsichbaeumchen / #4979731 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6196915",
          "cefr_level": "A1",
          "word_slugs": [
            "schinken-noun"
          ]
        },
        {
          "id": "7525379",
          "text": "Tom kann nicht kochen, es sei denn, es sind Spiegeleier mit Schinken.",
          "translation": "Том не умеет готовить, разве что яичницу с ветчиной.",
          "source": "Tatoeba #7525379 @Pfirsichbaeumchen / #5682898 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7525379",
          "cefr_level": "A1",
          "word_slugs": [
