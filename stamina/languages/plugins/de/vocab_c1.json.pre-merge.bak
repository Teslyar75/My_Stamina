    {
      "slug": "mädchens-noun",
      "lemma": "Mädchens",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5532,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Mädchen",
          "plural of Mädchen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2775688",
          "text": "Siehst du die Mutter des Mädchens?",
          "translation": "Ты видишь мать девочки?",
          "source": "Tatoeba #2775688 @ferka / #12299062 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2775688",
          "cefr_level": "A1",
          "word_slugs": [
            "mädchens-noun"
          ]
        },
        {
          "id": "6760127",
          "text": "Wo sind die Eltern dieses Mädchens?",
          "translation": "Где родители этой девочки?",
          "source": "Tatoeba #6760127 @Pfirsichbaeumchen / #6141185 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6760127",
          "cefr_level": "A1",
          "word_slugs": [
            "mädchens-noun"
          ]
        },
        {
          "id": "1706290",
          "text": "Die Augen dieses Mädchens sind blau.",
          "translation": "У этой девушки голубые глаза.",
          "source": "Tatoeba #1706290 @Pfirsichbaeumchen / #5653690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1706290",
          "cefr_level": "A1",
          "word_slugs": [
            "mädchens-noun"
          ]
        },
        {
          "id": "2625081",
          "text": "Ich kenne den Namen dieses Mädchens.",
          "translation": "Я знаю имя этой девочки.",
          "source": "Tatoeba #2625081 @Olya / #2625082 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2625081",
          "cefr_level": "A1",
          "word_slugs": [
