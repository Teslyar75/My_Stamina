        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13662858",
          "text": "Haben wir einen Verband?",
          "translation": "У нас бинт есть?",
          "source": "Tatoeba #13662858 @mhr / #13662843 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13662858",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-noun"
          ]
        },
        {
          "id": "894828",
          "text": "Nehmen Sie den Verband ab.",
          "translation": "Снимите повязку.",
          "source": "Tatoeba #894828 @Pfirsichbaeumchen / #894829 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/894828",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-noun"
          ]
        },
        {
          "id": "8634375",
          "text": "Der Arzt legt einen Verband an.",
          "translation": "Врач накладывает повязку.",
          "source": "Tatoeba #8634375 @Melang / #8641917 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634375",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-noun"
          ]
        },
        {
          "id": "4928327",
          "text": "Die Krankenschwester verband die Wunde mit einem Verband.",
          "translation": "Медсестра перевязала рану бинтом.",
          "source": "Tatoeba #4928327 @raggione / #4928355 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4928327",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-noun"
          ]
        },
        {
          "id": "701250",
          "text": "Er reinigte die Wunde, bevor er einen Verband anlegte.",
          "translation": "Он промыл рану, прежде чем наложить повязку.",
          "source": "Tatoeba #701250 @Manfredo / #1467873 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/701250",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
