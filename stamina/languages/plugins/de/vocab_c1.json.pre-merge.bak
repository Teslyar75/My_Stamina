    {
      "slug": "freuden-noun",
      "lemma": "Freuden",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8068,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Freude"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12336317",
          "text": "Jeden Alters seine Freuden.",
          "translation": "В каждом возрасте есть свои удовольствия.",
          "source": "Tatoeba #12336317 @Bernie75 / #3798828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12336317",
          "cefr_level": "A1",
          "word_slugs": [
            "freuden-noun"
          ]
        },
        {
          "id": "2300973",
          "text": "Das werde ich mit Freuden tun.",
          "translation": "Я с радостью это сделаю.",
          "source": "Tatoeba #2300973 @Pfirsichbaeumchen / #5512632 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2300973",
          "cefr_level": "A1",
          "word_slugs": [
            "freuden-noun"
          ]
        },
        {
          "id": "8986657",
          "text": "Das ist eine der größten Freuden des Lebens.",
          "translation": "Это одно из самых больших удовольствий в жизни.",
          "source": "Tatoeba #8986657 @Pfirsichbaeumchen / #2915415 @astyng (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8986657",
          "cefr_level": "A1",
          "word_slugs": [
            "freuden-noun"
          ]
        },
        {
          "id": "11510243",
          "text": "Reisen ist eine der traurigsten Freuden im Leben.",
          "translation": "Путешествовать - одно из самых грустных удовольствий в жизни.",
          "source": "Tatoeba #11510243 @Pfirsichbaeumchen / #11510190 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11510243",
          "cefr_level": "A1",
          "word_slugs": [
            "freuden-noun"
          ]
        },
        {
          "id": "11510242",
          "text": "Das Reisen ist eine der traurigsten Freuden im Leben.",
          "translation": "Путешествие - одно из самых грустных удовольствий в жизни.",
          "source": "Tatoeba #11510242 @Pfirsichbaeumchen / #11510199 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11510242",
          "cefr_level": "A1",
