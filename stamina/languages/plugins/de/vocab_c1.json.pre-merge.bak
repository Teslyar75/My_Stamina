          ]
        },
        {
          "id": "13976356",
          "text": "Tom ist mit einem Dolch erstochen worden.",
          "translation": "Тома закололи кинжалом.",
          "source": "Tatoeba #13976356 @mhr / #13976327 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13976356",
          "cefr_level": "A1",
          "word_slugs": [
            "dolch-noun"
          ]
        },
        {
          "id": "1229614",
          "text": "Ich brauche einen Dolch. Meine Schwiegermutter kommt auf Besuch.",
          "translation": "Мне нужен кинжал. Приезжает в гости тёща.",
          "source": "Tatoeba #1229614 @al_ex_an_der / #4956646 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1229614",
          "cefr_level": "A1",
