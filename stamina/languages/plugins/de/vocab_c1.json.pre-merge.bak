    {
      "slug": "verbringt-verb",
      "lemma": "verbringt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6622,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verbringen:",
