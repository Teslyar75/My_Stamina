        ],
        "en": [
          "accountant, bookkeeper"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "12420423",
          "text": "Er war Buchhalter.",
          "translation": "Он был бухгалтером.",
          "source": "Tatoeba #12420423 @Waldelfe / #12420419 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12420423",
          "cefr_level": "A1",
          "word_slugs": [
            "buchhalter-noun"
          ]
        },
        {
          "id": "12722896",
          "text": "Der Buchhalter und der Kassierer sind Brüder.",
          "translation": "Бухгалтер и кассир - братья.",
          "source": "Tatoeba #12722896 @Vortarulo / #12038464 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12722896",
          "cefr_level": "A1",
          "word_slugs": [
            "buchhalter-noun"
          ]
        },
        {
          "id": "13704180",
          "text": "Tom arbeitete als Buchhalter in einer kleinen Firma.",
          "translation": "Том работал бухгалтером в небольшой фирме.",
          "source": "Tatoeba #13704180 @mhr / #13704183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13704180",
          "cefr_level": "A1",
          "word_slugs": [
            "buchhalter-noun"
          ]
        },
        {
          "id": "13027916",
          "text": "Er arbeitet als Buchhalter in einem großen Unternehmen.",
          "translation": "Он работает бухгалтером на крупном предприятии.",
          "source": "Tatoeba #13027916 @Rovo / #13072495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13027916",
          "cefr_level": "A1",
          "word_slugs": [
            "buchhalter-noun"
          ]
        },
        {
          "id": "13704182",
          "text": "Tom hat als Buchhalter in einer kleinen Firma gearbeitet.",
          "translation": "Том работал бухгалтером в небольшой фирме.",
          "source": "Tatoeba #13704182 @mhr / #13704183 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13704182",
          "cefr_level": "A1",
          "word_slugs": [
            "buchhalter-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
