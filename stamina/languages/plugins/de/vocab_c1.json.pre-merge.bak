    {
      "slug": "ruhiger-adj",
      "lemma": "ruhiger",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6943,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of ruhig:",
          "strong/mixed nominative masculine singular",
          "inflection of ruhig:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3854052",
          "text": "Heute ist ein ruhiger Tag.",
          "translation": "Сегодня спокойный день.",
          "source": "Tatoeba #3854052 @Pfirsichbaeumchen / #3854033 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3854052",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhiger-adj"
          ]
        },
        {
          "id": "12414422",
          "text": "Es ist ein ruhiger Winterabend.",
          "translation": "Стоит тихий зимний вечер.",
          "source": "Tatoeba #12414422 @Adelpa / #12414474 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12414422",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhiger-adj"
          ]
        },
        {
          "id": "12414430",
          "text": "Es ist ein ruhiger Sommerabend.",
          "translation": "Стоит тихий летний вечер.",
          "source": "Tatoeba #12414430 @Adelpa / #12414473 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12414430",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhiger-adj"
          ]
        },
        {
          "id": "4153362",
          "text": "Bei ruhiger Überlegung sieht das anders aus.",
          "translation": "Если спокойно обдумать, это выглядит иначе.",
          "source": "Tatoeba #4153362 @AqQoyriq_1 / #4153365 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4153362",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhiger-adj"
          ]
        },
        {
          "id": "2490435",
          "text": "Maria meint, Tom sei ein kluger, ruhiger und ausgeglichener Mensch.",
          "translation": "Мария думает, что Том умный, спокойный и уравновешенный человек.",
          "source": "Tatoeba #2490435 @al_ex_an_der / #2486632 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2490435",
          "cefr_level": "A1",
          "word_slugs": [
            "ruhiger-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
