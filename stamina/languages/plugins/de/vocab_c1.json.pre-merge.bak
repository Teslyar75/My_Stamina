    {
      "slug": "höchsten-adj",
      "lemma": "höchsten",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6444,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "superlative degree of hoch"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2205702",
          "text": "Ihre Waren sind von der höchsten Qualität.",
          "translation": "Их товары высочайшего качества.",
          "source": "Tatoeba #2205702 @Pfirsichbaeumchen / #2344737 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2205702",
          "cefr_level": "A1",
          "word_slugs": [
            "höchsten-adj"
          ]
        },
        {
          "id": "7534723",
          "text": "Tom arbeitet im höchsten Gebäude der Stadt.",
          "translation": "Том работает в самом высоком здании города.",
          "source": "Tatoeba #7534723 @Pfirsichbaeumchen / #7534802 @Gusskov (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7534723",
          "cefr_level": "A1",
          "word_slugs": [
            "höchsten-adj"
          ]
        },
        {
          "id": "1803976",
          "text": "Die Zeremonie wird höchsten dreißig Minuten dauern.",
          "translation": "Церемония продлится самое большее тридцать минут.",
          "source": "Tatoeba #1803976 @al_ex_an_der / #13589779 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1803976",
          "cefr_level": "A1",
          "word_slugs": [
            "höchsten-adj"
          ]
        },
        {
          "id": "13567045",
          "text": "Die Arbeitslosenquote ist eine der höchsten in Europa.",
          "translation": "Уровень безработицы - один из самых высоких в Европе.",
          "source": "Tatoeba #13567045 @mhr / #13464869 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13567045",
          "cefr_level": "A1",
          "word_slugs": [
            "höchsten-adj"
          ]
        },
        {
          "id": "6098956",
