        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10588732",
          "text": "Wie wird man eine Fee?",
          "translation": "Как стать феей?",
          "source": "Tatoeba #10588732 @Pfirsichbaeumchen / #10579676 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10588732",
          "cefr_level": "A1",
