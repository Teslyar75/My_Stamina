    {
      "slug": "beschweren-verb",
      "lemma": "beschweren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6002,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "утяжелять",
          "пожаловаться",
          "нажаловаться"
        ],
        "en": [
          "to weight, to weight down",
          "to complain"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6796898",
          "text": "Wir beschweren uns nicht.",
          "translation": "Мы не жалуемся.",
          "source": "Tatoeba #6796898 @Esperantostern / #4773239 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6796898",
          "cefr_level": "A1",
          "word_slugs": [
            "beschweren-verb"
          ]
        },
        {
          "id": "9455730",
          "text": "Beschweren Sie sich bitte nicht!",
          "translation": "Не жалуйтесь, пожалуйста.",
          "source": "Tatoeba #9455730 @Pfirsichbaeumchen / #9466092 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9455730",
          "cefr_level": "A1",
          "word_slugs": [
            "beschweren-verb"
          ]
        },
        {
          "id": "9787606",
          "text": "Tom wird sich sicherlich beschweren.",
          "translation": "Том наверняка будет жаловаться.",
          "source": "Tatoeba #9787606 @GaryGaryGary / #4405759 @lovermann (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9787606",
          "cefr_level": "A1",
          "word_slugs": [
            "beschweren-verb"
          ]
        },
        {
          "id": "2942538",
          "text": "Beschweren Sie sich nicht vorschnell!",
          "translation": "Не спешите жаловаться!",
          "source": "Tatoeba #2942538 @al_ex_an_der / #2942536 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2942538",
          "cefr_level": "A1",
          "word_slugs": [
            "beschweren-verb"
          ]
        },
        {
          "id": "13934494",
          "text": "Ich werde mich über Sie beschweren.",
          "translation": "Я на вас жаловаться буду.",
          "source": "Tatoeba #13934494 @IAlexI / #6789408 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13934494",
          "cefr_level": "A1",
          "word_slugs": [
            "beschweren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
