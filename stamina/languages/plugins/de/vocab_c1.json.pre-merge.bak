    {
      "slug": "verband-verb",
      "lemma": "verband",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7575,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of verbinden"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11539213",
          "text": "Er verband mir die Augen.",
          "translation": "Он завязал мне глаза.",
          "source": "Tatoeba #11539213 @doemaar14 / #11539240 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11539213",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-verb"
          ]
        },
        {
          "id": "6929277",
          "text": "Maria verband Tom den Arm.",
          "translation": "Мэри перевязала Тому руку.",
          "source": "Tatoeba #6929277 @Pfirsichbaeumchen / #6620409 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6929277",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-verb"
          ]
        },
        {
          "id": "4928327",
          "text": "Die Krankenschwester verband die Wunde mit einem Verband.",
          "translation": "Медсестра перевязала рану бинтом.",
          "source": "Tatoeba #4928327 @raggione / #4928355 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4928327",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-verb"
          ]
        },
        {
          "id": "4784244",
          "text": "Mit seiner Mutter verband ihn ein inniges, emotionsreiches Verhältnis.",
          "translation": "С матерью его связывали тесные, эмоциональные отношения.",
          "source": "Tatoeba #4784244 @al_ex_an_der / #4784939 @taranbo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4784244",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-verb"
          ]
        },
        {
          "id": "1686008",
          "text": "Orientexpress ist der Name eines Zuges, der einst Paris und Istanbul verband.",
          "translation": "\"Восточный экспресс\" - это название поезда, соединявшего когда-то Париж и Стамбул.",
          "source": "Tatoeba #1686008 @al_ex_an_der / #12914612 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1686008",
          "cefr_level": "A1",
          "word_slugs": [
            "verband-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
