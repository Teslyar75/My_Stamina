          ]
        },
        {
          "id": "13088618",
          "text": "In der Kirche ist es eiskalt.",
          "translation": "В церкви чрезвычайно холодно.",
          "source": "Tatoeba #13088618 @mhr / #13088607 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13088618",
          "cefr_level": "A1",
          "word_slugs": [
            "eiskalt-adj"
          ]
        },
        {
          "id": "1820063",
          "text": "Meine Hände und Füsse waren eiskalt.",
          "translation": "Руки и ноги у меня были ледяные.",
          "source": "Tatoeba #1820063 @Tamy / #5032873 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1820063",
          "cefr_level": "A1",
