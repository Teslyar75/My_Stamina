    {
      "slug": "narbe-noun",
      "lemma": "Narbe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5768,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "рубец",
          "шрам"
        ],
        "en": [
          "scar",
          "stigma",
          "sod, turf, sward (the upper part/the surface of a lawn)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "12577989",
          "text": "Tom zeigte mir seine Narbe.",
          "translation": "Том показал мне свой шрам.",
          "source": "Tatoeba #12577989 @Waldelfe / #12577776 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12577989",
          "cefr_level": "A1",
          "word_slugs": [
            "narbe-noun"
          ]
        },
        {
          "id": "4921477",
          "text": "Tom hat eine Narbe im Gesicht.",
          "translation": "У Тома на лице есть шрам.",
          "source": "Tatoeba #4921477 @Pfirsichbaeumchen / #4920665 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4921477",
          "cefr_level": "A1",
          "word_slugs": [
            "narbe-noun"
          ]
        },
        {
          "id": "10151310",
          "text": "Zeigen Sie mir bitte die Narbe.",
          "translation": "Покажите мне шрам, пожалуйста.",
          "source": "Tatoeba #10151310 @driini / #11096901 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10151310",
          "cefr_level": "A1",
          "word_slugs": [
            "narbe-noun"
          ]
        },
        {
          "id": "5182052",
          "text": "Tom hat eine Narbe auf der Wange.",
          "translation": "У Тома шрам на щеке.",
          "source": "Tatoeba #5182052 @Manfredo / #5024427 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5182052",
          "cefr_level": "A1",
          "word_slugs": [
            "narbe-noun"
          ]
        },
        {
          "id": "4910871",
          "text": "Er hat eine große Narbe im Gesicht.",
          "translation": "У него большой шрам на лице.",
          "source": "Tatoeba #4910871 @al_ex_an_der / #10291472 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4910871",
          "cefr_level": "A1",
          "word_slugs": [
            "narbe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
