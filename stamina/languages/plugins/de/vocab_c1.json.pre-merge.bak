    {
      "slug": "alters-noun",
      "lemma": "Alters",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8027,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Alter"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12336317",
          "text": "Jeden Alters seine Freuden.",
          "translation": "В каждом возрасте есть свои удовольствия.",
          "source": "Tatoeba #12336317 @Bernie75 / #3798828 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12336317",
          "cefr_level": "A1",
          "word_slugs": [
            "alters-noun"
          ]
        },
        {
          "id": "2766298",
          "text": "Sie war eine Frau mittleren Alters.",
          "translation": "Это была женщина средних лет.",
          "source": "Tatoeba #2766298 @Pfirsichbaeumchen / #2766299 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2766298",
          "cefr_level": "A1",
          "word_slugs": [
            "alters-noun"
          ]
        },
        {
          "id": "12910190",
          "text": "Sie ist eine dicke Frau mittleren Alters.",
          "translation": "Она толстая женщина средних лет.",
          "source": "Tatoeba #12910190 @Waldelfe / #3219444 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12910190",
          "cefr_level": "A1",
          "word_slugs": [
            "alters-noun"
          ]
        },
        {
          "id": "3966750",
          "text": "Er arbeitet immer noch, trotz seines Alters.",
          "translation": "Он всё ещё работает, несмотря на свой возраст.",
          "source": "Tatoeba #3966750 @pne / #3967164 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3966750",
          "cefr_level": "A1",
          "word_slugs": [
            "alters-noun"
          ]
        },
        {
          "id": "347966",
          "text": "Trotz seines Alters ist er im Geiste jung geblieben.",
          "translation": "Несмотря на возраст, он остался молод духом.",
          "source": "Tatoeba #347966 @lilygilder / #11108747 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/347966",
          "cefr_level": "A1",
          "word_slugs": [
            "alters-noun"
          ]
        }
      ],
