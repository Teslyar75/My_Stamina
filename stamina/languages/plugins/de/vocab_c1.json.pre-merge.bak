    {
      "slug": "provinz-noun",
      "lemma": "Provinz",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9229,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "провинция"
        ],
        "en": [
          "province (administrative subdivision)",
          "hinterland; backwater (remote area unaffected by new fashions and ideas)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "10695498",
          "text": "Er lebt in der Provinz.",
          "translation": "Он живёт в провинции.",
          "source": "Tatoeba #10695498 @Pfirsichbaeumchen / #10695089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10695498",
          "cefr_level": "A1",
          "word_slugs": [
            "provinz-noun"
          ]
        },
        {
          "id": "10695497",
          "text": "Sie lebt in der Provinz.",
          "translation": "Она живёт в провинции.",
          "source": "Tatoeba #10695497 @Pfirsichbaeumchen / #10695090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10695497",
          "cefr_level": "A1",
          "word_slugs": [
            "provinz-noun"
          ]
        },
        {
          "id": "13474888",
          "text": "Ich komme selbst aus der Provinz.",
          "translation": "Я сама из провинции.",
          "source": "Tatoeba #13474888 @mhr / #13474874 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13474888",
          "cefr_level": "A1",
          "word_slugs": [
            "provinz-noun"
          ]
        },
        {
          "id": "13797789",
          "text": "Sie machen eine Reise durch die Provinz.",
          "translation": "Они путешествуют по провинции.",
          "source": "Tatoeba #13797789 @Vortarulo / #13797826 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13797789",
          "cefr_level": "A1",
          "word_slugs": [
            "provinz-noun"
          ]
        },
        {
          "id": "13041126",
          "text": "New York sollte eine Provinz Kanadas werden.",
          "translation": "Нью-Йорк должен стать провинцией Канады.",
          "source": "Tatoeba #13041126 @mhr / #13041089 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13041126",
          "cefr_level": "A1",
          "word_slugs": [
            "provinz-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
