    {
      "slug": "kinn-noun",
      "lemma": "Kinn",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7697,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "chin"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10472759",
          "text": "Maria hat ein Grübchen im Kinn.",
          "translation": "У Мэри ямочка на подбородке.",
          "source": "Tatoeba #10472759 @Pfirsichbaeumchen / #10626034 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10472759",
          "cefr_level": "A1",
          "word_slugs": [
            "kinn-noun"
          ]
        },
        {
          "id": "4049956",
          "text": "Wissen Sie, woher Tom die Narbe an seinem Kinn hat?",
          "translation": "Вы знаете, откуда у Тома этот шрам на подбородке?",
          "source": "Tatoeba #4049956 @Zaghawa / #4050025 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4049956",
          "cefr_level": "A1",
          "word_slugs": [
            "kinn-noun"
          ]
        },
        {
          "id": "4049951",
          "text": "Wisst ihr, wie Tom zu der Narbe an seinem Kinn kam?",
          "translation": "Вы знаете, откуда у Тома этот шрам на подбородке?",
          "source": "Tatoeba #4049951 @Zaghawa / #4050025 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4049951",
          "cefr_level": "A1",
          "word_slugs": [
            "kinn-noun"
          ]
        },
        {
          "id": "4049950",
          "text": "Weißt du, wie Tom an die Narbe an seinem Kinn gekommen ist?",
          "translation": "Ты знаешь, откуда у Тома этот шрам на подбородке?",
          "source": "Tatoeba #4049950 @Zaghawa / #4050023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4049950",
          "cefr_level": "A1",
          "word_slugs": [
            "kinn-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
