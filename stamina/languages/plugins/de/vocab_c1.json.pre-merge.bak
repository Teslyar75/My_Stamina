    {
      "slug": "langweilen-verb",
      "lemma": "langweilen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7540,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "надоедать",
          "скучать"
        ],
        "en": [
          "to bore (inspire boredom in someone)",
          "to be bored, to feel bored"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6333321",
          "text": "Langweilen Sie sich?",
          "translation": "Вам скучно?",
          "source": "Tatoeba #6333321 @Pfirsichbaeumchen / #4426473 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6333321",
          "cefr_level": "A1",
          "word_slugs": [
            "langweilen-verb"
          ]
        },
        {
          "id": "13965771",
          "text": "Wir langweilen uns hier.",
          "translation": "Нам тут скучно.",
          "source": "Tatoeba #13965771 @Waldelfe / #8399860 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13965771",
          "cefr_level": "A1",
          "word_slugs": [
            "langweilen-verb"
          ]
        },
        {
          "id": "2650825",
          "text": "Sie langweilen mich nicht.",
          "translation": "Они не дают мне скучать.",
          "source": "Tatoeba #2650825 @Olya / #2650828 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650825",
          "cefr_level": "A1",
          "word_slugs": [
            "langweilen-verb"
          ]
        },
        {
          "id": "6028375",
          "text": "Die Schüler langweilen sich.",
          "translation": "Ученики скучают.",
          "source": "Tatoeba #6028375 @Pfirsichbaeumchen / #7416555 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6028375",
          "cefr_level": "A1",
          "word_slugs": [
            "langweilen-verb"
          ]
        },
        {
          "id": "13873410",
          "text": "Das wird Sie bald langweilen.",
          "translation": "Это Вам быстро наскучит.",
          "source": "Tatoeba #13873410 @Rovo / #13873546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13873410",
          "cefr_level": "A1",
          "word_slugs": [
            "langweilen-verb"
          ]
        }
      ],
