    {
      "slug": "einmischen-verb",
      "lemma": "einmischen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6658,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to interfere, to intervene",
          "to mix into, to blend into"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12425845",
          "text": "Ich werde mich nicht einmischen.",
          "translation": "Я не буду вмешиваться.",
          "source": "Tatoeba #12425845 @Waldelfe / #3458820 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12425845",
          "cefr_level": "A1",
          "word_slugs": [
            "einmischen-verb"
          ]
        },
        {
          "id": "7148102",
          "text": "Ich wollte mich nicht einmischen.",
          "translation": "Мне не хотелось вмешиваться.",
          "source": "Tatoeba #7148102 @Luiaard / #7151742 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7148102",
          "cefr_level": "A1",
          "word_slugs": [
            "einmischen-verb"
          ]
        },
        {
          "id": "3443114",
          "text": "Ich hätte mich nicht einmischen sollen.",
          "translation": "Мне не следовало вмешиваться.",
          "source": "Tatoeba #3443114 @moskbnea / #12395042 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3443114",
          "cefr_level": "A1",
          "word_slugs": [
            "einmischen-verb"
          ]
        },
        {
          "id": "398565",
          "text": "Sie sollten sich nicht in die Innenpolitik anderer Länder einmischen.",
          "translation": "Им не следует вмешиваться во внутреннюю политику других стран.",
          "source": "Tatoeba #398565 @xtofu80 / #10951043 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398565",
          "cefr_level": "A1",
          "word_slugs": [
