        {
          "id": "3430832",
          "text": "Können Sie pfeifen?",
          "translation": "Вы умеете свистеть?",
          "source": "Tatoeba #3430832 @Pfirsichbaeumchen / #3443801 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3430832",
          "cefr_level": "A1",
