        ],
        "en": [
          "jazz (musical art form)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "3770730",
          "text": "Er mag Jazz.",
          "translation": "Ему нравится джаз.",
          "source": "Tatoeba #3770730 @mauersegler / #3634432 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3770730",
          "cefr_level": "A1",
          "word_slugs": [
            "jazz-noun"
          ]
        },
        {
          "id": "579333",
          "text": "Ich mag Jazz.",
          "translation": "Мне нравится джаз.",
          "source": "Tatoeba #579333 @jakov / #407619 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/579333",
          "cefr_level": "A1",
          "word_slugs": [
            "jazz-noun"
          ]
        },
        {
          "id": "6615108",
          "text": "Tom mag Jazz.",
          "translation": "Том любит джаз.",
          "source": "Tatoeba #6615108 @Felixjp / #3056385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6615108",
          "cefr_level": "A1",
          "word_slugs": [
            "jazz-noun"
          ]
        },
        {
          "id": "7712177",
          "text": "Sie mag Jazz.",
          "translation": "Она любит джаз.",
          "source": "Tatoeba #7712177 @wolfgangth / #3634468 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7712177",
          "cefr_level": "A1",
          "word_slugs": [
            "jazz-noun"
          ]
        },
        {
          "id": "7697104",
          "text": "Maria mag Jazz.",
          "translation": "Мэри любит джаз.",
          "source": "Tatoeba #7697104 @wolfgangth / #6740766 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7697104",
          "cefr_level": "A1",
          "word_slugs": [
            "jazz-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
