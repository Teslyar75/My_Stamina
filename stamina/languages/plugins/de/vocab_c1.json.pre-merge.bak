        },
        {
          "id": "1812321",
          "text": "Ich habe noch nie so ein Tattoo gesehen.",
          "translation": "Я никогда ещё не видел такой татуировки.",
          "source": "Tatoeba #1812321 @Tamy / #2934092 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1812321",
          "cefr_level": "A1",
          "word_slugs": [
            "tattoo-noun"
          ]
        },
        {
          "id": "5182056",
          "text": "Ich habe ein Tattoo auf meiner linken Schulter.",
          "translation": "У меня на левом плече татуировка.",
          "source": "Tatoeba #5182056 @Manfredo / #5182123 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5182056",
          "cefr_level": "A1",
          "word_slugs": [
            "tattoo-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
