    {
      "slug": "gesetzes-noun",
      "lemma": "Gesetzes",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8972,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Gesetz"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5685003",
          "text": "Wir fordern die Abschaffung dieses Gesetzes.",
          "translation": "Мы требуем упразднения этого закона.",
          "source": "Tatoeba #5685003 @Pfirsichbaeumchen / #4492016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5685003",
          "cefr_level": "A1",
          "word_slugs": [
            "gesetzes-noun"
          ]
        },
        {
          "id": "12593190",
          "text": "Von der Existenz dieses Gesetzes wußten sehr wenige.",
          "translation": "О существовании этого закона знают очень немногие.",
          "source": "Tatoeba #12593190 @Waldelfe / #11037441 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12593190",
          "cefr_level": "A1",
          "word_slugs": [
            "gesetzes-noun"
          ]
        },
        {
          "id": "2337856",
          "text": "Nicht ein Wissenschaftler zweifelt an der Allgemeingültigkeit dieses Gesetzes.",
          "translation": "В универсальности этого закона не сомневается ни один учёный.",
          "source": "Tatoeba #2337856 @al_ex_an_der / #2337848 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2337856",
          "cefr_level": "A1",
          "word_slugs": [
            "gesetzes-noun"
          ]
        },
        {
          "id": "2192344",
          "text": "Ich erkenne nur eine Diktatur an — die Diktatur des Gesetzes.",
          "translation": "Я признаю только одну диктатуру — диктатуру закона.",
          "source": "Tatoeba #2192344 @al_ex_an_der / #2192340 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2192344",
          "cefr_level": "A1",
          "word_slugs": [
            "gesetzes-noun"
          ]
        },
        {
          "id": "2423225",
          "text": "Meine Frage ist: Wie wird die Diskussion dieses Gesetzes ablaufen?",
          "translation": "Мой вопрос состоит в том, каким образом будет происходить обсуждение этого закона?",
          "source": "Tatoeba #2423225 @al_ex_an_der / #2423219 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2423225",
          "cefr_level": "A1",
          "word_slugs": [
            "gesetzes-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
