          ]
        },
        {
          "id": "7482949",
          "text": "Kannst du besser japanisch oder chinesisch kochen?",
          "translation": "Ты лучше готовишь блюда японской или китайской кухни?",
          "source": "Tatoeba #7482949 @Pfirsichbaeumchen / #7483105 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7482949",
          "cefr_level": "A1",
          "word_slugs": [
