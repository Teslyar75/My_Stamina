    {
      "slug": "abreise-noun",
      "lemma": "Abreise",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8410,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "отъезд"
        ],
        "en": [
          "departure"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2337129",
          "text": "Morgen ist der Tag der Abreise.",
          "translation": "Завтра день отъезда.",
          "source": "Tatoeba #2337129 @freddy1 / #12101038 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2337129",
          "cefr_level": "A1",
          "word_slugs": [
            "abreise-noun"
          ]
        },
        {
          "id": "841968",
          "text": "Er hat seine Abreise auf morgen verschoben.",
          "translation": "Он отложил свой отъезд до завтра.",
          "source": "Tatoeba #841968 @MUIRIEL / #1706399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/841968",
          "cefr_level": "A1",
          "word_slugs": [
            "abreise-noun"
          ]
        },
        {
          "id": "2735195",
          "text": "Tom hat seine Abreise auf Sonntag verschoben.",
          "translation": "Том отложил свой отъезд до воскресенья.",
          "source": "Tatoeba #2735195 @Pfirsichbaeumchen / #2984036 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2735195",
          "cefr_level": "A1",
          "word_slugs": [
            "abreise-noun"
          ]
        },
        {
          "id": "443582",
          "text": "Er entschloss sich, seine Abreise zu verschieben.",
          "translation": "Он решил отложить свой отъезд.",
          "source": "Tatoeba #443582 @Pfirsichbaeumchen / #351430 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/443582",
          "cefr_level": "A1",
          "word_slugs": [
            "abreise-noun"
          ]
        },
        {
          "id": "7901193",
          "text": "Wir müssen vor der Abreise noch etwas erledigen.",
          "translation": "Нам ещё нужно кое-что сделать перед отъездом.",
          "source": "Tatoeba #7901193 @Pfirsichbaeumchen / #7900861 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7901193",
          "cefr_level": "A1",
          "word_slugs": [
            "abreise-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Abreise",
        "nominative_pl": ""
      }
