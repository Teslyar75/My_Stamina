          ]
        },
        {
          "id": "4838644",
          "text": "Tragt alle Stühle auf die Terrasse.",
          "translation": "Вынесите все стулья на террасу.",
          "source": "Tatoeba #4838644 @al_ex_an_der / #13227185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4838644",
          "cefr_level": "A1",
          "word_slugs": [
            "terrasse-noun"
          ]
        },
        {
          "id": "6814561",
          "text": "Der Wäscheständer ist auf der Terrasse.",
          "translation": "Стойка для сушки белья на террасе.",
          "source": "Tatoeba #6814561 @brauchinet / #6814627 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6814561",
          "cefr_level": "A1",
          "word_slugs": [
            "terrasse-noun"
          ]
        },
        {
          "id": "12328818",
          "text": "Bring die Stühle alle auf die Terrasse!",
          "translation": "Отнеси все стулья на террасу.",
          "source": "Tatoeba #12328818 @Pfirsichbaeumchen / #13227184 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12328818",
          "cefr_level": "A1",
          "word_slugs": [
            "terrasse-noun"
          ]
        },
        {
          "id": "4838642",
          "text": "Tragen Sie alle Stühle auf die Terrasse.",
          "translation": "Вынесите все стулья на террасу.",
          "source": "Tatoeba #4838642 @al_ex_an_der / #13227185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4838642",
