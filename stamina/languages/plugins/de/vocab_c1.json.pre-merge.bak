    {
      "slug": "pommes-noun",
      "lemma": "Pommes",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6692,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "fries, French fries, chips (UK)",
          "a single fry, a single chip (UK)",
          "a portion of fries"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8109431",
          "text": "Ich mag Pommes.",
          "translation": "Мне нравится картошка фри.",
          "source": "Tatoeba #8109431 @Luiaard / #8110340 @Takirabor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8109431",
          "cefr_level": "A1",
          "word_slugs": [
            "pommes-noun"
          ]
        },
        {
          "id": "12368382",
          "text": "Jeder mag Pommes-Chips.",
          "translation": "Все любят картофельные чипсы.",
          "source": "Tatoeba #12368382 @Rovo / #12371600 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12368382",
          "cefr_level": "A1",
          "word_slugs": [
            "pommes-noun"
          ]
        },
        {
          "id": "7470019",
          "text": "Ich liebe Pommes frites mit Ketchup.",
          "translation": "Я люблю жареную картошку с кетчупом.",
          "source": "Tatoeba #7470019 @Pfirsichbaeumchen / #7470026 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7470019",
          "cefr_level": "A1",
          "word_slugs": [
            "pommes-noun"
          ]
        },
        {
          "id": "7470018",
          "text": "Ich esse gerne Pommes frites mit Ketchup.",
          "translation": "Я ем с удовольствием жареную картошку с кетчупом.",
          "source": "Tatoeba #7470018 @Pfirsichbaeumchen / #7470024 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7470018",
          "cefr_level": "A1",
          "word_slugs": [
            "pommes-noun"
          ]
        },
        {
          "id": "1190271",
          "text": "Deutsche Kinder lieben Pommes frites mit Ketchup.",
          "translation": "Немецкие дети любят жареную картошку с кетчупом.",
          "source": "Tatoeba #1190271 @Esperantostern / #7469995 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1190271",
          "cefr_level": "A1",
          "word_slugs": [
            "pommes-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
