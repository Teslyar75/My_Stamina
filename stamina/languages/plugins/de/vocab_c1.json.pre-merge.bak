    {
      "slug": "befehlen-verb",
      "lemma": "befehlen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5096,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to command; to order (someone to do something)",
          "to give orders; to be in command",
          "to entrust"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12005374",
          "text": "Gehorchen ist nicht so einfach wie befehlen.",
          "translation": "Подчиняться не так просто, как командовать.",
          "source": "Tatoeba #12005374 @Pfirsichbaeumchen / #11252186 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12005374",
          "cefr_level": "A1",
          "word_slugs": [
            "befehlen-verb"
          ]
        },
        {
          "id": "1967420",
          "text": "Ich kann Tom nicht befehlen, das zu tun.",
          "translation": "Я не могу приказать Тому сделать это.",
          "source": "Tatoeba #1967420 @Pfirsichbaeumchen / #5262782 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1967420",
          "cefr_level": "A1",
          "word_slugs": [
            "befehlen-verb"
          ]
        },
        {
          "id": "1967417",
          "text": "Ich kann Tom nicht befehlen, glücklich zu sein.",
          "translation": "Я не могу приказать Тому, чтобы он был счастлив.",
          "source": "Tatoeba #1967417 @Pfirsichbaeumchen / #11703757 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1967417",
          "cefr_level": "A1",
          "word_slugs": [
            "befehlen-verb"
          ]
        },
        {
          "id": "13503529",
          "text": "Mit welchem Recht befehlen Sie mir, das zu tun?",
          "translation": "По какому праву Вы приказываете мне это сделать?",
          "source": "Tatoeba #13503529 @kbylr / #13503532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13503529",
          "cefr_level": "A1",
          "word_slugs": [
            "befehlen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
