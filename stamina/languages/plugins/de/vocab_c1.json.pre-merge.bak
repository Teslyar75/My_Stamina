          ]
        },
        {
          "id": "723720",
          "text": "Der Doktor entschied, sofort zu operieren.",
          "translation": "Доктор решил немедленно оперировать.",
          "source": "Tatoeba #723720 @Esperantostern / #2974408 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/723720",
          "cefr_level": "A1",
          "word_slugs": [
            "operieren-verb"
          ]
        },
        {
          "id": "1544299",
          "text": "Er muss sich nächste Woche operieren lassen.",
          "translation": "На следующей неделе ему должны сделать операцию.",
          "source": "Tatoeba #1544299 @Pfirsichbaeumchen / #12465837 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1544299",
          "cefr_level": "A1",
          "word_slugs": [
            "operieren-verb"
          ]
        }
      ],
