          "cefr_level": "A1",
          "word_slugs": [
            "autorität-noun"
          ]
        },
        {
          "id": "4095409",
          "text": "Sie ist auf ihrem Gebiet eine Autorität.",
          "translation": "Она является авторитетом в своей области.",
          "source": "Tatoeba #4095409 @Pfirsichbaeumchen / #4095230 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4095409",
          "cefr_level": "A1",
          "word_slugs": [
            "autorität-noun"
          ]
        },
        {
          "id": "13944512",
          "text": "Autorität muss man sich verdienen.",
          "translation": "Авторитет нужно заработать.",
          "source": "Tatoeba #13944512 @mhr / #13944303 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13944512",
          "cefr_level": "A1",
          "word_slugs": [
            "autorität-noun"
          ]
        }
