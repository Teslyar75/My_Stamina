    {
      "slug": "schwächer-adj",
      "lemma": "schwächer",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9487,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "comparative degree of schwach"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13769570",
          "text": "Der Wind wird schwächer.",
          "translation": "Ветер слабеет.",
          "source": "Tatoeba #13769570 @Biderl / #13769483 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13769570",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächer-adj"
          ]
        },
        {
          "id": "13128437",
          "text": "Der Schneesturm wurde schwächer.",
          "translation": "Метель стихла.",
          "source": "Tatoeba #13128437 @Biderl / #13128850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13128437",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächer-adj"
          ]
        },
        {
          "id": "10285518",
          "text": "Sie ist schwächer als er.",
          "translation": "Она слабее его.",
          "source": "Tatoeba #10285518 @Pfirsichbaeumchen / #10285517 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10285518",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächer-adj"
          ]
        },
        {
          "id": "12341876",
          "text": "Er ist schwächer als sie.",
          "translation": "Он слабее её.",
          "source": "Tatoeba #12341876 @mhr / #13075356 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12341876",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächer-adj"
          ]
        },
        {
          "id": "12408931",
          "text": "Frauen sind physisch schwächer als Männer.",
          "translation": "Женщины физически слабее мужчин.",
          "source": "Tatoeba #12408931 @mayabe / #2184126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12408931",
          "cefr_level": "A1",
          "word_slugs": [
            "schwächer-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
