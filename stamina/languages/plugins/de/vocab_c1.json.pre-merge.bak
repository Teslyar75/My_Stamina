      "gender": "f",
      "examples": [
        {
          "id": "13407038",
          "text": "Das ist banale Eifersucht.",
          "translation": "Это банальная ревность.",
          "source": "Tatoeba #13407038 @mhr / #13406835 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13407038",
