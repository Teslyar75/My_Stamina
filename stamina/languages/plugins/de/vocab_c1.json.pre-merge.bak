        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3156157",
          "text": "Ich bin nicht gut im Russischen.",
          "translation": "В русском языке я не силён.",
          "source": "Tatoeba #3156157 @Pfirsichbaeumchen / #1953236 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3156157",
          "cefr_level": "A1",
          "word_slugs": [
            "russischen-noun"
          ]
        },
        {
          "id": "12901955",
          "text": "Ich will mich im Russischen üben.",
          "translation": "Я хочу попрактиковаться в русском.",
          "source": "Tatoeba #12901955 @mhr / #12901700 @LanguagesLover (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12901955",
          "cefr_level": "A1",
          "word_slugs": [
            "russischen-noun"
          ]
        },
        {
          "id": "13556142",
          "text": "Im Russischen gibt es sechs Fälle.",
          "translation": "В русском языке шесть падежей.",
          "source": "Tatoeba #13556142 @mhr / #13556050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13556142",
          "cefr_level": "A1",
          "word_slugs": [
            "russischen-noun"
          ]
        },
        {
          "id": "10643719",
          "text": "Im Russischen gibt es keine Artikel.",
          "translation": "В русском языке нет артиклей.",
          "source": "Tatoeba #10643719 @Pfirsichbaeumchen / #10643476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10643719",
          "cefr_level": "A1",
          "word_slugs": [
            "russischen-noun"
          ]
        },
        {
          "id": "8248260",
          "text": "Ich übersetze vom Russischen ins Kasachische.",
          "translation": "Я перевожу с русского языка на казахский.",
          "source": "Tatoeba #8248260 @Pfirsichbaeumchen / #1565475 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8248260",
          "cefr_level": "A1",
          "word_slugs": [
            "russischen-noun"
          ]
        }
      ],
      "tags": [
