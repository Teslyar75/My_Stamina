          "source": "Tatoeba #12563339 @Waldelfe / #12559111 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12563339",
          "cefr_level": "A1",
          "word_slugs": [
            "wölfe-noun"
          ]
        },
        {
          "id": "5990803",
          "text": "Warum heulen Wölfe?",
          "translation": "Почему волки воют?",
          "source": "Tatoeba #5990803 @Adelpa / #5990805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5990803",
          "cefr_level": "A1",
          "word_slugs": [
            "wölfe-noun"
          ]
        },
        {
          "id": "7745666",
          "text": "Wo sind die Wölfe?",
          "translation": "Где волки?",
          "source": "Tatoeba #7745666 @list / #3341899 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7745666",
          "cefr_level": "A1",
          "word_slugs": [
