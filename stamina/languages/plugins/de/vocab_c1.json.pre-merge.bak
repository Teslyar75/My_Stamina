    {
      "slug": "gramm-noun",
      "lemma": "Gramm",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7972,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "грамм"
        ],
        "en": [
          "gram (unit of mass)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "4963597",
          "text": "Zwei Gramm Pfeffer genügen.",
          "translation": "Два грамма перца достаточно.",
          "source": "Tatoeba #4963597 @Manfredo / #4963605 @russica (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4963597",
          "cefr_level": "A1",
          "word_slugs": [
            "gramm-noun"
          ]
        },
        {
          "id": "2692274",
          "text": "Koche dreihundert Gramm Reis!",
          "translation": "Свари триста грамм риса.",
          "source": "Tatoeba #2692274 @Pfirsichbaeumchen / #3750714 @zwhzwh (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2692274",
          "cefr_level": "A1",
          "word_slugs": [
            "gramm-noun"
          ]
        },
        {
          "id": "12430142",
          "text": "Hundert Gramm Mehl hinzufügen.",
          "translation": "Добавьте сто граммов муки.",
          "source": "Tatoeba #12430142 @Pfirsichbaeumchen / #8331542 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12430142",
          "cefr_level": "A1",
          "word_slugs": [
            "gramm-noun"
          ]
        },
        {
          "id": "4963598",
          "text": "Zwei Gramm Pfeffer sind genug.",
          "translation": "Два грамма перца достаточно.",
          "source": "Tatoeba #4963598 @Manfredo / #4963605 @russica (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4963598",
          "cefr_level": "A1",
          "word_slugs": [
            "gramm-noun"
          ]
        },
        {
          "id": "10782615",
          "text": "Wieviel Gramm ist eine Tasse Reis?",
          "translation": "Сколько грамм в чашке риса?",
          "source": "Tatoeba #10782615 @Pfirsichbaeumchen / #10782619 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10782615",
          "cefr_level": "A1",
          "word_slugs": [
            "gramm-noun"
          ]
        }
      ],
