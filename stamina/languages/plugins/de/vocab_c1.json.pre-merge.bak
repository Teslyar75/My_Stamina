    {
      "slug": "vertreter-noun",
      "lemma": "Vertreter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6459,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "представитель"
        ],
        "en": [
          "agent noun of vertreten",
          "representative, agent"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "764918",
          "text": "Ein Vertreter der Regierung beantwortete die Fragen der Journalisten.",
          "translation": "Представитель правительства ответил на вопросы журналистов.",
