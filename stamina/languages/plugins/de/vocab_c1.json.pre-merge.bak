    {
      "slug": "aufstand-noun",
      "lemma": "Aufstand",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5467,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "uprising, insurrection"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6985828",
          "text": "Das ist kein ziviler Ungehorsam, sondern ein Aufstand.",
          "translation": "Это не гражданское неповиновение, а восстание.",
          "source": "Tatoeba #6985828 @Pfirsichbaeumchen / #14042345 @Alex_M (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6985828",
          "cefr_level": "A1",
          "word_slugs": [
            "aufstand-noun"
          ]
        },
        {
          "id": "14048857",
          "text": "Sie war eine kluge Frau und machte keinen Aufstand.",
          "translation": "Она была умной женщиной и скандалить не стала.",
          "source": "Tatoeba #14048857 @mhr / #14048710 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14048857",
          "cefr_level": "A1",
          "word_slugs": [
            "aufstand-noun"
          ]
        },
        {
          "id": "13383977",
          "text": "Dieser Aufstand wurde zum ersten Vorboten der bevorstehenden Revolution.",
          "translation": "Это восстание стало первой ласточкой грядущей революции.",
          "source": "Tatoeba #13383977 @mhr / #13383960 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13383977",
          "cefr_level": "A1",
          "word_slugs": [
            "aufstand-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "aufstand-verb",
      "lemma": "aufstand",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5467,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular dependent preterite of aufstehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12419263",
          "text": "Ich weiß nicht, warum ich so früh aufstand.",
          "translation": "Не знаю, зачем я так рано встал.",
          "source": "Tatoeba #12419263 @mhr / #5710511 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12419263",
          "cefr_level": "A1",
          "word_slugs": [
            "aufstand-verb"
          ]
        },
        {
          "id": "449598",
          "text": "Als ich heute Morgen aufstand, hatte ich Kopfschmerzen.",
          "translation": "Когда я встал утром, у меня болела голова.",
          "source": "Tatoeba #449598 @esocom / #598962 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/449598",
          "cefr_level": "A1",
          "word_slugs": [
            "aufstand-verb"
          ]
        },
        {
          "id": "4684734",
          "text": "Als ich aufstand, stand die Sonne schon hoch am Himmel.",
          "translation": "Когда я встал, солнце уже поднялось высоко на небе.",
          "source": "Tatoeba #4684734 @JWeighardt / #4684748 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4684734",
          "cefr_level": "A1",
          "word_slugs": [
            "aufstand-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
