          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3460905",
          "text": "Ihm gelingt alles.",
          "translation": "Ему всё удаётся.",
          "source": "Tatoeba #3460905 @Pfirsichbaeumchen / #3459254 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3460905",
          "cefr_level": "A1",
