    {
      "slug": "überzeugung-noun",
      "lemma": "Überzeugung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9032,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "убеждение"
        ],
        "en": [
          "conviction, belief",
          "persuasion, convincing"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13248693",
          "text": "Ist das deine Überzeugung?",
          "translation": "Ты в этом убеждён?",
          "source": "Tatoeba #13248693 @Biderl / #13248700 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13248693",
          "cefr_level": "A1",
          "word_slugs": [
            "überzeugung-noun"
          ]
        },
        {
          "id": "10107428",
          "text": "Der Glaube ist keine Frage der Wahl, sondern der Überzeugung.",
          "translation": "Вера - это вопрос не выбора, а убеждения.",
          "source": "Tatoeba #10107428 @sakslane / #10106673 @dimitris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10107428",
          "cefr_level": "A1",
          "word_slugs": [
            "überzeugung-noun"
          ]
        },
        {
          "id": "676",
          "text": "Eine Meinung ist nur dann schockierend, wenn sie eine Überzeugung ist.",
          "translation": "Мнение шокирует лишь тогда, когда это убеждение.",
          "source": "Tatoeba #676 @MUIRIEL / #5655 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/676",
          "cefr_level": "A1",
          "word_slugs": [
            "überzeugung-noun"
          ]
        },
        {
          "id": "1578323",
          "text": "Das ist eine interessante Meinung. Wie bist du zu dieser Überzeugung gekommen?",
          "translation": "Интересное мнение. И как ты пришёл к такому выводу?",
          "source": "Tatoeba #1578323 @al_ex_an_der / #1959725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1578323",
          "cefr_level": "A1",
          "word_slugs": [
            "überzeugung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Überzeugung",
        "nominative_pl": ""
      }
