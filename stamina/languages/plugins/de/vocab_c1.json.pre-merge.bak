    {
      "slug": "preise-noun",
      "lemma": "Preise",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5961,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Preis",
          "dative singular of Preis"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "700280",
          "text": "Die Preise stiegen.",
          "translation": "Цены взлетели.",
          "source": "Tatoeba #700280 @kolonjano / #1993170 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/700280",
          "cefr_level": "A1",
          "word_slugs": [
            "preise-noun"
          ]
        },
        {
          "id": "353655",
          "text": "Die Preise sind hoch.",
          "translation": "Цены высокие.",
          "source": "Tatoeba #353655 @MUIRIEL / #2988586 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/353655",
          "cefr_level": "A1",
          "word_slugs": [
            "preise-noun"
          ]
        },
        {
          "id": "1762896",
          "text": "Ich gewinne gerne Preise.",
          "translation": "Я люблю выигрывать призы.",
          "source": "Tatoeba #1762896 @Pfirsichbaeumchen / #12975585 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1762896",
          "cefr_level": "A1",
          "word_slugs": [
            "preise-noun"
          ]
        },
        {
          "id": "9012730",
          "text": "Die Preise werden steigen.",
          "translation": "Цены вырастут.",
          "source": "Tatoeba #9012730 @Pfirsichbaeumchen / #5590772 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9012730",
          "cefr_level": "A1",
          "word_slugs": [
            "preise-noun"
          ]
        },
        {
          "id": "4856247",
          "text": "Alle Preise sind gestiegen.",
          "translation": "Все цены поднялись.",
          "source": "Tatoeba #4856247 @al_ex_an_der / #5725177 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4856247",
          "cefr_level": "A1",
          "word_slugs": [
            "preise-noun"
          ]
        }
      ],
      "tags": [
