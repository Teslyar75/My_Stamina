    {
      "slug": "schlamm-noun",
      "lemma": "Schlamm",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8092,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "шлам"
        ],
        "en": [
          "mud",
          "sludge, ooze"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8661951",
          "text": "Toms Auto steckte im Schlamm fest.",
          "translation": "Машина Тома застряла в грязи.",
          "source": "Tatoeba #8661951 @Melang / #4241185 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8661951",
          "cefr_level": "A1",
          "word_slugs": [
            "schlamm-noun"
          ]
        },
        {
          "id": "457901",
          "text": "Er war von Kopf bis Fuß mit Schlamm bedeckt.",
          "translation": "Он был с головы до ног покрыт грязью.",
          "source": "Tatoeba #457901 @MUIRIEL / #3513446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/457901",
          "cefr_level": "A1",
          "word_slugs": [
            "schlamm-noun"
          ]
        },
        {
          "id": "6758996",
          "text": "Schnee, Regen, Schlamm – ich werde bei jedem Unwetter gehen.",
          "translation": "Снег, дождь, грязь — я приду в любую непогоду.",
          "source": "Tatoeba #6758996 @Pfirsichbaeumchen / #6208466 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6758996",
          "cefr_level": "A1",
          "word_slugs": [
            "schlamm-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
