      "gender": null,
      "examples": [
        {
          "id": "14063555",
          "text": "Sie ist zwanzig.",
          "translation": "Ей двадцать.",
          "source": "Tatoeba #14063555 @ninefi / #14063556 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14063555",
