    {
      "slug": "flecken-noun",
      "lemma": "Flecken",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6203,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "alternative form of Fleck (“stain, sport, blot, smear”)",
          "a village or small town, (especially historical) a place with limited town privileges, such as market rights"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13437472",
          "text": "Ich sehe schwarze Flecken.",
          "translation": "Я вижу чёрные пятна.",
          "source": "Tatoeba #13437472 @maaster / #13448311 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13437472",
          "cefr_level": "A1",
          "word_slugs": [
            "flecken-noun"
          ]
        },
        {
          "id": "3857425",
          "text": "Sie hat überall am Körper rote Flecken.",
          "translation": "У неё красные пятна по всему телу.",
          "source": "Tatoeba #3857425 @Zaghawa / #3034650 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3857425",
          "cefr_level": "A1",
          "word_slugs": [
            "flecken-noun"
          ]
        },
        {
          "id": "8786916",
          "text": "Er hatte überall am Körper blaue Flecken.",
          "translation": "У него по всему телу были синяки.",
          "source": "Tatoeba #8786916 @wolfgangth / #12731492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8786916",
          "cefr_level": "A1",
          "word_slugs": [
            "flecken-noun"
          ]
        }
      ],
      "tags": [
