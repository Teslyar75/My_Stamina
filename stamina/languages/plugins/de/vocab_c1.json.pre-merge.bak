        ],
        "en": [
          "sharp edge",
          "sawgrass"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "6798058",
          "text": "Die Eckzähne sind zwischen den Schneide- und den Backenzähnen.",
          "translation": "Клыки находятся между резцами и молярами.",
          "source": "Tatoeba #6798058 @brauchinet / #6798209 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6798058",
          "cefr_level": "A1",
          "word_slugs": [
            "schneide-noun"
          ]
        },
        {
          "id": "7754705",
          "text": "Schneide die Gurken!",
          "translation": "Нарежь огурцы.",
          "source": "Tatoeba #7754705 @Neisklar / #8695343 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7754705",
          "cefr_level": "A1",
          "word_slugs": [
            "schneide-noun"
          ]
        },
        {
          "id": "435699",
          "text": "Schneide die Kartoffeln.",
          "translation": "Нарежь картофель.",
          "source": "Tatoeba #435699 @MUIRIEL / #2252036 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/435699",
          "cefr_level": "A1",
          "word_slugs": [
            "schneide-noun"
          ]
        },
        {
          "id": "10282584",
          "text": "Schneide dir die Nägel!",
          "translation": "Постриги ногти.",
          "source": "Tatoeba #10282584 @Pfirsichbaeumchen / #5769673 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10282584",
          "cefr_level": "A1",
          "word_slugs": [
            "schneide-noun"
          ]
        },
        {
          "id": "13315245",
          "text": "Schneide unterdessen die Tomaten!",
          "translation": "Порежь пока помидоры.",
          "source": "Tatoeba #13315245 @Waldelfe / #10851905 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13315245",
          "cefr_level": "A1",
          "word_slugs": [
            "schneide-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
