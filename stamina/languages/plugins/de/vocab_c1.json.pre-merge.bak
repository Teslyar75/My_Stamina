    {
      "slug": "drang-noun",
      "lemma": "Drang",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8219,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "pressure; stress",
          "urge; impulse; longing"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3614855",
          "text": "Tom widerstand dem Drang, Mary zu küssen.",
          "translation": "Том сдержал порыв поцеловать Мэри.",
          "source": "Tatoeba #3614855 @Mixtli / #3615497 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3614855",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-noun"
          ]
        },
        {
          "id": "3614856",
          "text": "Ich verspürte den Drang, laut zu schreien.",
          "translation": "Я ощутил желание громко вскрикнуть.",
          "source": "Tatoeba #3614856 @Mixtli / #3618071 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3614856",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-noun"
          ]
        },
        {
          "id": "7066727",
          "text": "Tom hat einen unwiderstehlichen Drang zum Lügen.",
          "translation": "У Тома неудержимая склонность ко лжи.",
          "source": "Tatoeba #7066727 @AqQoyriq_1 / #7066730 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7066727",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-noun"
          ]
        },
        {
          "id": "2036540",
          "text": "Es war schwer, den Drang zu unterdrücken, Tom zu erwürgen.",
          "translation": "Было трудно подавить желание задушить Тома.",
          "source": "Tatoeba #2036540 @Pfirsichbaeumchen / #2839416 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2036540",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "drang-verb",
      "lemma": "drang",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8219,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person singular preterite of dringen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "808289",
          "text": "Der Penis drang in die Vagina ein.",
          "translation": "Пенис вошёл в вагину.",
          "source": "Tatoeba #808289 @Manfredo / #775409 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/808289",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-verb"
          ]
        },
        {
          "id": "2911414",
          "text": "Ein Schwall kalter Luft drang durch die Tür.",
          "translation": "Волна холодного воздуха проникла в дверь.",
          "source": "Tatoeba #2911414 @al_ex_an_der / #2911413 @Erviy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2911414",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-verb"
          ]
        },
        {
          "id": "3596667",
          "text": "Der Dieb drang durch ein Waschküchenfenster ins Haus ein.",
          "translation": "Вор проник в дом через окно прачечной.",
          "source": "Tatoeba #3596667 @al_ex_an_der / #3597344 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3596667",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-verb"
          ]
        },
        {
          "id": "2417835",
          "text": "Das Licht eines neuen Tages drang durch die Nebelschichten.",
          "translation": "Свет нового дня уже сочился сквозь слои тумана.",
          "source": "Tatoeba #2417835 @al_ex_an_der / #2417833 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2417835",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-verb"
          ]
        },
        {
          "id": "2498486",
          "text": "Die Tür schloss hermetisch. Von außen drang kein Laut an mein Ohr.",
          "translation": "Дверь закрывалась герметически. Ни единого звука извне не доносилось до моих ушей.",
          "source": "Tatoeba #2498486 @al_ex_an_der / #2498485 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2498486",
          "cefr_level": "A1",
          "word_slugs": [
            "drang-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "redeten-verb",
      "lemma": "redeten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8220,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of reden:",
          "first/third-person plural preterite",
          "inflection of reden:",
          "first/third-person plural subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12330971",
          "text": "Wir redeten laut.",
          "translation": "Мы громко разговаривали.",
          "source": "Tatoeba #12330971 @Balamax / #10293889 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12330971",
          "cefr_level": "A1",
          "word_slugs": [
            "redeten-verb"
          ]
        },
        {
          "id": "607529",
          "text": "Sie redeten über Liebe.",
          "translation": "Они говорили о любви.",
          "source": "Tatoeba #607529 @virgil / #607560 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/607529",
          "cefr_level": "A1",
          "word_slugs": [
            "redeten-verb"
          ]
        },
        {
          "id": "6326554",
          "text": "Sie redeten in Rätseln.",
          "translation": "Они говорили загадками.",
          "source": "Tatoeba #6326554 @Sleepyscreen / #6360665 @A123d (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6326554",
          "cefr_level": "A1",
          "word_slugs": [
            "redeten-verb"
          ]
        },
        {
          "id": "1343615",
          "text": "Wir redeten bis um zwei.",
          "translation": "Мы проговорили до двух часов.",
          "source": "Tatoeba #1343615 @Zaghawa / #8000267 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1343615",
          "cefr_level": "A1",
          "word_slugs": [
            "redeten-verb"
          ]
        },
        {
          "id": "6402178",
          "text": "Gestern redeten sie über den Urlaub.",
          "translation": "Вчера они говорили об отпуске.",
          "source": "Tatoeba #6402178 @Hannivar / #6377407 @astru (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6402178",
          "cefr_level": "A1",
          "word_slugs": [
            "redeten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
