          ]
        },
        {
          "id": "1779882",
          "text": "Sie wurde hinter Gitter gebracht.",
          "translation": "Она была брошена за решётку.",
          "source": "Tatoeba #1779882 @Pfirsichbaeumchen / #12962339 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1779882",
          "cefr_level": "A1",
          "word_slugs": [
            "gitter-noun"
          ]
        },
        {
          "id": "14007870",
          "text": "Die Fenster im Erdgeschoss haben Gitter.",
          "translation": "На окнах первого этажа решётки.",
          "source": "Tatoeba #14007870 @mhr / #14007049 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14007870",
          "cefr_level": "A1",
          "word_slugs": [
            "gitter-noun"
          ]
        }
      ],
