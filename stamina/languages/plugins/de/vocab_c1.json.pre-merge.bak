    {
      "slug": "hasste-verb",
      "lemma": "hasste",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6341,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of hassen:",
          "first/third-person singular preterite",
          "inflection of hassen:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8843728",
          "text": "Er hasste sich.",
          "translation": "Он себя ненавидел.",
          "source": "Tatoeba #8843728 @wolfgangth / #8666680 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8843728",
          "cefr_level": "A1",
          "word_slugs": [
            "hasste-verb"
          ]
        },
        {
          "id": "8958770",
          "text": "Tom hasste sie.",
          "translation": "Том их ненавидел.",
          "source": "Tatoeba #8958770 @wolfgangth / #8958771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8958770",
          "cefr_level": "A1",
          "word_slugs": [
            "hasste-verb"
          ]
        },
        {
          "id": "12005925",
          "text": "Sie hasste sie.",
          "translation": "Она её ненавидела.",
          "source": "Tatoeba #12005925 @Augustus / #13261775 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12005925",
          "cefr_level": "A1",
          "word_slugs": [
            "hasste-verb"
          ]
        },
        {
          "id": "12531190",
          "text": "Ich hasste Tom.",
          "translation": "Я ненавидела Тома.",
          "source": "Tatoeba #12531190 @mayabe / #2606341 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12531190",
          "cefr_level": "A1",
          "word_slugs": [
