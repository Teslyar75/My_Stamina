    {
      "slug": "stiefvater-noun",
      "lemma": "Stiefvater",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8810,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "отчим"
        ],
        "en": [
          "stepfather"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13507756",
          "text": "Tom haßte seinen Stiefvater.",
          "translation": "Том ненавидел своего отчима.",
          "source": "Tatoeba #13507756 @Waldelfe / #6455520 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13507756",
          "cefr_level": "A1",
          "word_slugs": [
            "stiefvater-noun"
          ]
        },
        {
          "id": "13616201",
          "text": "Tom nennt seinen Stiefvater „Papa“.",
          "translation": "Том называет отчима папой.",
          "source": "Tatoeba #13616201 @mhr / #13616231 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13616201",
          "cefr_level": "A1",
          "word_slugs": [
            "stiefvater-noun"
          ]
        },
        {
          "id": "7463866",
          "text": "Tom wohnt bei seiner Mutter und seinem Stiefvater.",
          "translation": "Том живёт с матерью и отчимом.",
          "source": "Tatoeba #7463866 @Pfirsichbaeumchen / #6772936 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7463866",
          "cefr_level": "A1",
          "word_slugs": [
            "stiefvater-noun"
          ]
        },
        {
          "id": "7460256",
          "text": "„Ist das dein Vater?“ – „Nein, das ist mein Stiefvater.“",
          "translation": "\"Это твой отец?\" — \"Нет, это отчим\".",
          "source": "Tatoeba #7460256 @Pfirsichbaeumchen / #6152208 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7460256",
          "cefr_level": "A1",
          "word_slugs": [
            "stiefvater-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Stiefvater",
        "nominative_pl": ""
      }
    },
    {
      "slug": "grimm-noun",
      "lemma": "Grimm",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8811,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "wrath, deep-rooted anger, rage"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1123079",
          "text": "Herr Grimm ist ein Geschichtslehrer.",
          "translation": "Господин Гримм - преподаватель истории.",
          "source": "Tatoeba #1123079 @Vortarulo / #6623709 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1123079",
          "cefr_level": "A1",
          "word_slugs": [
            "grimm-noun"
          ]
        },
        {
          "id": "2671085",
          "text": "Die Gebrüder Grimm sammelten Märchen aus ganz Deutschland.",
          "translation": "Братья Гримм собирали сказки по всей Германии.",
          "source": "Tatoeba #2671085 @Pfirsichbaeumchen / #2796673 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2671085",
          "cefr_level": "A1",
          "word_slugs": [
            "grimm-noun"
          ]
        },
        {
          "id": "13780826",
          "text": "Viele Disney-Filme basieren auf den Märchen der Gebrüder Grimm.",
          "translation": "Многие диснеевские фильмы основаны на сказках братьев Гримм.",
          "source": "Tatoeba #13780826 @TanukiKun / #13875397 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13780826",
          "cefr_level": "A1",
          "word_slugs": [
            "grimm-noun"
          ]
        },
        {
          "id": "13907480",
          "text": "Sie recherchiert über die Brüder Grimm, weil sie Literaturstudentin ist.",
          "translation": "Она исследует творчество братьев Гримм, потому что учится на литературоведа.",
          "source": "Tatoeba #13907480 @Ioan_Cristian / #13907501 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13907480",
          "cefr_level": "A1",
          "word_slugs": [
            "grimm-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
