    {
      "slug": "ewige-adj",
      "lemma": "ewige",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5876,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of ewig:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of ewig:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3861300",
          "text": "Ewige Liebe gibt es nicht.",
          "translation": "Вечной любви не бывает.",
          "source": "Tatoeba #3861300 @Pfirsichbaeumchen / #3859380 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3861300",
          "cefr_level": "A1",
          "word_slugs": [
            "ewige-adj"
          ]
        },
        {
          "id": "8565718",
          "text": "Ich glaube an das ewige Leben.",
          "translation": "Я верю в вечную жизнь.",
          "source": "Tatoeba #8565718 @Pfirsichbaeumchen / #7157233 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8565718",
          "cefr_level": "A1",
          "word_slugs": [
            "ewige-adj"
          ]
        },
        {
          "id": "4449849",
          "text": "Nur ein früher Tod gewährt ewige Jugend.",
          "translation": "Вечная молодость возможна только при ранней смерти.",
          "source": "Tatoeba #4449849 @AqQoyriq_1 / #4449858 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4449849",
          "cefr_level": "A1",
          "word_slugs": [
            "ewige-adj"
          ]
        },
        {
          "id": "12371055",
          "text": "Es gibt weder ewige Freud’ noch endloses Leid.",
          "translation": "Ни радости вечной, ни печали бесконечной.",
          "source": "Tatoeba #12371055 @Bernie75 / #2760081 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12371055",
          "cefr_level": "A1",
          "word_slugs": [
            "ewige-adj"
          ]
        },
        {
          "id": "13851528",
          "text": "Das ewige Dilemma aller Übersetzer: präzise oder schön übersetzen?",
          "translation": "Вечная дилемма всех переводчиков: перевести точно или красиво?",
          "source": "Tatoeba #13851528 @carlosalberto / #13851456 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13851528",
          "cefr_level": "A1",
          "word_slugs": [
            "ewige-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
