    {
      "slug": "betrügt-verb",
      "lemma": "betrügt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7093,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of betrügen:",
          "third-person singular present",
          "inflection of betrügen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13042966",
          "text": "Ihr Mann betrügt Sie.",
          "translation": "Муж Вам изменяет.",
          "source": "Tatoeba #13042966 @Waldelfe / #5378016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13042966",
          "cefr_level": "A1",
          "word_slugs": [
            "betrügt-verb"
          ]
        },
        {
          "id": "12873204",
          "text": "Er betrügt ihn ständig.",
          "translation": "Он всё время его обманывает.",
          "source": "Tatoeba #12873204 @mhr / #12873105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12873204",
          "cefr_level": "A1",
          "word_slugs": [
            "betrügt-verb"
          ]
        },
        {
          "id": "13042965",
          "text": "Dein Mann betrügt dich.",
          "translation": "Муж тебе изменяет.",
          "source": "Tatoeba #13042965 @Waldelfe / #5378013 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13042965",
          "cefr_level": "A1",
          "word_slugs": [
            "betrügt-verb"
          ]
        },
        {
          "id": "5882825",
          "text": "Ich glaube, Tom betrügt uns.",
          "translation": "По-моему, Том нас обманывает.",
          "source": "Tatoeba #5882825 @Pfirsichbaeumchen / #5506230 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5882825",
          "cefr_level": "A1",
          "word_slugs": [
            "betrügt-verb"
          ]
        },
        {
          "id": "3012694",
          "text": "Ich glaube, mein Freund betrügt mich.",
          "translation": "Думаю, мой парень мне изменяет.",
          "source": "Tatoeba #3012694 @freddy1 / #3244283 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3012694",
          "cefr_level": "A1",
          "word_slugs": [
            "betrügt-verb"
          ]
        }
      ],
