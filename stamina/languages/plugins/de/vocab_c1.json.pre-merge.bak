        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11232175",
          "text": "Woher wusste sie, wo sie mich fände?",
          "translation": "Откуда она знала, где меня найти?",
          "source": "Tatoeba #11232175 @Pfirsichbaeumchen / #7282518 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11232175",
          "cefr_level": "A1",
          "word_slugs": [
            "fände-verb"
          ]
        },
        {
          "id": "739305",
          "text": "Ich würde laut schreien, wenn ich einen Skorpion in meinem Zimmer fände.",
          "translation": "Я бы громко кричала, если бы нашла скорпиона в своей комнате.",
          "source": "Tatoeba #739305 @Dejo / #1525005 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/739305",
          "cefr_level": "A1",
          "word_slugs": [
            "fände-verb"
          ]
        }
      ],
      "tags": [
