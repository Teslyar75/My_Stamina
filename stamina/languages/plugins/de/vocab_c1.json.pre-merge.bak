      "cefr_level": "C1",
      "frequency_rank": 5162,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мудрость"
        ],
        "en": [
          "wisdom",
          "insight",
          "wise saying, wise words"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5464281",
          "text": "Philosophie ist Liebe zur Weisheit.",
          "translation": "Философия - это любовь к мудрости.",
          "source": "Tatoeba #5464281 @Pfirsichbaeumchen / #5124811 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5464281",
          "cefr_level": "A1",
          "word_slugs": [
            "weisheit-noun"
          ]
        },
        {
          "id": "8245296",
          "text": "Athene ist die Göttin der Weisheit.",
          "translation": "Афина — богиня мудрости.",
          "source": "Tatoeba #8245296 @Pfirsichbaeumchen / #8147011 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8245296",
          "cefr_level": "A1",
          "word_slugs": [
            "weisheit-noun"
          ]
        },
        {
          "id": "11927207",
          "text": "Zweifel ist der Beginn aller Weisheit.",
          "translation": "Сомнение - начало мудрости.",
          "source": "Tatoeba #11927207 @Adelpa / #11568294 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11927207",
          "cefr_level": "A1",
          "word_slugs": [
            "weisheit-noun"
          ]
        },
        {
          "id": "1271587",
          "text": "Wiederholung ist die Mutter der Weisheit.",
          "translation": "Повторение — мать учения.",
          "source": "Tatoeba #1271587 @al_ex_an_der / #981758 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1271587",
          "cefr_level": "A1",
          "word_slugs": [
            "weisheit-noun"
          ]
        },
        {
          "id": "1435350",
          "text": "Die Weisheit ist die Tochter der Erfahrung.",
          "translation": "Мудрость - дочь опыта.",
          "source": "Tatoeba #1435350 @al_ex_an_der / #1889070 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1435350",
          "cefr_level": "A1",
          "word_slugs": [
            "weisheit-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Weisheit",
        "nominative_pl": ""
      }
