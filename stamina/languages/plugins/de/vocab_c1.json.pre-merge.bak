        "en": [
          "to catch up (a person, vehicle, competitor etc. ahead of you)",
          "to make up (lost time, a shortfall)",
          "to reel in (a net, flag etc.)",
          "to go shopping"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3107159",
          "text": "Ich werde dich bald einholen.",
          "translation": "Я скоро тебя догоню.",
          "source": "Tatoeba #3107159 @freddy1 / #9689017 @schwetterling (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3107159",
          "cefr_level": "A1",
          "word_slugs": [
            "einholen-verb"
          ]
        },
        {
          "id": "424274",
          "text": "Wenn du dich beeilst, kannst du ihn einholen.",
          "translation": "Если поторопишься, то ещё догонишь его.",
          "source": "Tatoeba #424274 @MUIRIEL / #1993728 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/424274",
          "cefr_level": "A1",
          "word_slugs": [
            "einholen-verb"
          ]
        },
        {
          "id": "631887",
          "text": "Geh nur schon vor, ich werde dich bald einholen.",
          "translation": "Иди вперед, я скоро догоню тебя.",
          "source": "Tatoeba #631887 @BraveSentry / #4863851 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/631887",
          "cefr_level": "A1",
          "word_slugs": [
            "einholen-verb"
          ]
        }
      ],
