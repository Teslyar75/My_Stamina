    {
      "slug": "sonnenaufgang-noun",
      "lemma": "Sonnenaufgang",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6206,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "восход солнца"
        ],
        "en": [
          "sunrise"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12495639",
          "text": "Warten wir bis Sonnenaufgang!",
          "translation": "Давайте подождём до восхода солнца.",
          "source": "Tatoeba #12495639 @Waldelfe / #12511091 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12495639",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenaufgang-noun"
          ]
        },
        {
          "id": "9387044",
          "text": "Tom steht bei Sonnenaufgang auf.",
          "translation": "Том встаёт с восходом солнца.",
          "source": "Tatoeba #9387044 @Pfirsichbaeumchen / #9494944 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9387044",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenaufgang-noun"
          ]
        },
        {
          "id": "13482924",
          "text": "Sie wartet auf den Sonnenaufgang.",
          "translation": "Она ждёт восхода солнца.",
          "source": "Tatoeba #13482924 @mhr / #13481304 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13482924",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenaufgang-noun"
          ]
        },
        {
          "id": "12495642",
          "text": "Laßt uns bis Sonnenaufgang warten!",
          "translation": "Давайте подождём до восхода солнца.",
          "source": "Tatoeba #12495642 @Waldelfe / #12511091 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12495642",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenaufgang-noun"
          ]
        },
        {
          "id": "3452022",
          "text": "Tom wurde beim Sonnenaufgang geweckt.",
          "translation": "Том проснулся с восходом солнца.",
          "source": "Tatoeba #3452022 @Esperantostern / #3459451 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3452022",
          "cefr_level": "A1",
