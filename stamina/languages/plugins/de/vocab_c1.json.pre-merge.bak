    {
      "slug": "gesunde-adj",
      "lemma": "gesunde",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8966,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of gesund:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of gesund:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10020678",
          "text": "Rauchen ist keine gesunde Angewohnheit.",
          "translation": "Курение — нездоровая привычка.",
          "source": "Tatoeba #10020678 @Melang / #3539589 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10020678",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunde-adj"
          ]
        },
        {
          "id": "13991306",
          "text": "Wir sind für eine gesunde Lebensweise!",
          "translation": "Мы за здоровый образ жизни!",
          "source": "Tatoeba #13991306 @mhr / #13991185 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13991306",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunde-adj"
          ]
        },
        {
          "id": "10879331",
          "text": "Ich hoffe, der gesunde Menschenverstand wird gewinnen.",
          "translation": "Надеюсь, здравый смысл победит.",
          "source": "Tatoeba #10879331 @maaster / #10879333 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10879331",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunde-adj"
          ]
        },
        {
          "id": "11531762",
          "text": "Eine gesunde Seele wohnt in einem gesunden Körper.",
          "translation": "В здоровом теле здоровый дух.",
          "source": "Tatoeba #11531762 @Adelpa / #432540 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11531762",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunde-adj"
          ]
        },
        {
          "id": "1801797",
          "text": "Ich bin der letzte geistig gesunde Mann auf der Welt.",
          "translation": "Я последний в мире человек в здравом уме.",
          "source": "Tatoeba #1801797 @marcelostockle / #1801862 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1801797",
          "cefr_level": "A1",
          "word_slugs": [
            "gesunde-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
