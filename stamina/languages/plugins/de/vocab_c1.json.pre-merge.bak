          ]
        },
        {
          "id": "1895101",
          "text": "Wo ist die russische Botschaft?",
          "translation": "Где находится российское посольство?",
          "source": "Tatoeba #1895101 @Esperantostern / #2169084 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1895101",
          "cefr_level": "A1",
          "word_slugs": [
            "russische-adj"
          ]
        },
        {
          "id": "1287796",
          "text": "Moskau ist eine russische Stadt.",
          "translation": "Москва - российский город.",
          "source": "Tatoeba #1287796 @Esperantostern / #1791800 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1287796",
          "cefr_level": "A1",
