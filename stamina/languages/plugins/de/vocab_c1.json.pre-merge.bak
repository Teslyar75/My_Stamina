    {
      "slug": "markus-name",
      "lemma": "Markus",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9747,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Mark the Evangelist (biblical character).",
          "a male given name from Latin"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2168938",
          "text": "Seit wann wohnt Markus hier?",
          "translation": "С каких пор Маркус живет здесь?",
          "source": "Tatoeba #2168938 @al_ex_an_der / #2875700 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2168938",
          "cefr_level": "A1",
          "word_slugs": [
            "markus-name"
          ]
        },
        {
          "id": "1129993",
          "text": "Als Markus ankam, schlief ich.",
          "translation": "Когда пришёл Маркус, я спал.",
          "source": "Tatoeba #1129993 @Esperantostern / #2576180 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1129993",
          "cefr_level": "A1",
          "word_slugs": [
            "markus-name"
          ]
        },
        {
          "id": "2418743",
          "text": "Markus nimmt erstmalig an einem Motorradrennen teil.",
          "translation": "Марк впервые принимает участие в мотогонках.",
          "source": "Tatoeba #2418743 @Pfirsichbaeumchen / #2412072 @mora2013 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2418743",
          "cefr_level": "A1",
          "word_slugs": [
            "markus-name"
          ]
        },
        {
          "id": "2418744",
          "text": "Markus nimmt zum ersten Mal an einem Motorradrennen teil.",
          "translation": "Марк впервые принимает участие в мотогонках.",
          "source": "Tatoeba #2418744 @Pfirsichbaeumchen / #2412072 @mora2013 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2418744",
          "cefr_level": "A1",
          "word_slugs": [
            "markus-name"
          ]
        },
        {
          "id": "3926908",
          "text": "Markus hat einen Bruder, aber er spricht nie von ihm.",
          "translation": "У Маркуса есть брат, но он никогда о нём не говорит.",
          "source": "Tatoeba #3926908 @kolonjano / #5233385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3926908",
          "cefr_level": "A1",
          "word_slugs": [
            "markus-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
