    {
      "slug": "wundern-verb",
      "lemma": "wundern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5515,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "удивлять"
        ],
        "en": [
          "to surprise, to astonish (of sights, behaviors, outcomes)",
          "to be surprised",
          "to wonder, to consider something strange, to be confused"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10551272",
          "text": "Da wird er sich aber wundern!",
          "translation": "То-то он удивится!",
          "source": "Tatoeba #10551272 @kotik / #8752045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10551272",
          "cefr_level": "A1",
          "word_slugs": [
            "wundern-verb"
          ]
        },
        {
          "id": "2160907",
          "text": "Da braucht man sich nicht zu wundern.",
          "translation": "Тут нечему удивляться.",
          "source": "Tatoeba #2160907 @Tamy / #3512727 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2160907",
          "cefr_level": "A1",
          "word_slugs": [
            "wundern-verb"
          ]
        },
        {
          "id": "7888888",
          "text": "Ich würde mich nicht wundern, wenn das geschähe.",
          "translation": "Я бы не удивился, если бы это случилось.",
          "source": "Tatoeba #7888888 @Pfirsichbaeumchen / #7873539 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7888888",
          "cefr_level": "A1",
          "word_slugs": [
            "wundern-verb"
          ]
        },
        {
          "id": "438",
          "text": "Überrascht sein, sich wundern, heißt anfangen, zu verstehen.",
          "translation": "Изумление, удивление - это первый шаг на пути к постижению.",
          "source": "Tatoeba #438 @MUIRIEL / #5628 @Dorenda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/438",
          "cefr_level": "A1",
          "word_slugs": [
            "wundern-verb"
          ]
        },
        {
          "id": "2461036",
          "text": "Man braucht sich nicht zu wundern, dass sie ausgestorben sind.",
          "translation": "Неудивительно, что они вымерли.",
