    {
      "slug": "messe-noun",
      "lemma": "Messe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6687,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "fair (trade exhibition)",
          "mass, the eucharistic liturgy"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "594879",
          "text": "Die Stadt veranstaltet die Messe.",
          "translation": "Город представил выставку.",
          "source": "Tatoeba #594879 @cost / #599899 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/594879",
          "cefr_level": "A1",
          "word_slugs": [
            "messe-noun"
          ]
        },
        {
          "id": "13818050",
          "text": "Die Messe wird nicht stattfinden.",
          "translation": "Месса не состоится.",
          "source": "Tatoeba #13818050 @scaui0 / #13818078 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13818050",
          "cefr_level": "A1",
          "word_slugs": [
            "messe-noun"
          ]
        },
        {
          "id": "1321768",
          "text": "Paris ist wohl eine Messe wert.",
          "translation": "Париж стоит мессы.",
          "source": "Tatoeba #1321768 @al_ex_an_der / #2039944 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1321768",
          "cefr_level": "A1",
          "word_slugs": [
            "messe-noun"
          ]
        },
        {
          "id": "1103354",
          "text": "Wir gehen in die Kirche zur Messe.",
          "translation": "Мы идём в церковь на мессу.",
          "source": "Tatoeba #1103354 @Haehnchenpaella / #3806050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1103354",
          "cefr_level": "A1",
          "word_slugs": [
            "messe-noun"
          ]
        },
        {
          "id": "3046014",
          "text": "Messe jeden Winkel des Dreieckes.",
          "translation": "Измерь все углы треугольника.",
          "source": "Tatoeba #3046014 @Manfredo / #9151779 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3046014",
          "cefr_level": "A1",
          "word_slugs": [
            "messe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
