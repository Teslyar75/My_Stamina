    {
      "slug": "männlich-adj",
      "lemma": "männlich",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7729,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мужской"
        ],
        "en": [
          "male",
          "manly",
          "masculine"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1916321",
          "text": "Irren ist männlich.",
          "translation": "Мужчинам свойственно ошибаться.",
          "source": "Tatoeba #1916321 @Esperantostern / #13457511 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1916321",
          "cefr_level": "A1",
          "word_slugs": [
            "männlich-adj"
          ]
        },
        {
          "id": "1918639",
          "text": "Er ist stark und männlich.",
          "translation": "Он сильный и мужественный.",
          "source": "Tatoeba #1918639 @Pfirsichbaeumchen / #3146852 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1918639",
          "cefr_level": "A1",
          "word_slugs": [
            "männlich-adj"
          ]
        },
        {
          "id": "3931128",
          "text": "Männer mögen es, männlich auszusehen.",
          "translation": "Мужчинам нравится выглядеть мужественными.",
          "source": "Tatoeba #3931128 @futuro / #493156 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3931128",
          "cefr_level": "A1",
          "word_slugs": [
            "männlich-adj"
          ]
        },
        {
          "id": "13820368",
          "text": "Im Spanischen können Substantive männlich oder weiblich sein.",
          "translation": "В испанском языке существительные могут быть мужского и женского рода.",
          "source": "Tatoeba #13820368 @mhr / #13819334 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13820368",
          "cefr_level": "A1",
          "word_slugs": [
            "männlich-adj"
          ]
        },
        {
          "id": "621566",
          "text": "Ich habe drei Hunde: einer ist männlich, und die anderen sind weiblich.",
          "translation": "У меня три собаки: один кобель, остальные суки.",
          "source": "Tatoeba #621566 @BraveSentry / #10609057 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/621566",
          "cefr_level": "A1",
          "word_slugs": [
            "männlich-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der männlich",
        "nominative_pl": ""
      }
