    {
      "slug": "gestalt-noun",
      "lemma": "Gestalt",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6598,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "гешта́льт"
        ],
        "en": [
          "shape, form, figure, outline",
          "shape, build of a person, silhouette, profile",
          "figure, character, person"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12561955",
          "text": "Die Ideen nehmen allmählich Gestalt an.",
          "translation": "Идеи понемногу принимают форму.",
          "source": "Tatoeba #12561955 @mhr / #12561504 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12561955",
          "cefr_level": "A1",
          "word_slugs": [
            "gestalt-noun"
          ]
        },
        {
          "id": "1511902",
          "text": "Die Erde hat die Gestalt eines Balles.",
          "translation": "Земля имеет форму шара.",
          "source": "Tatoeba #1511902 @Esperantostern / #3148616 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1511902",
          "cefr_level": "A1",
          "word_slugs": [
            "gestalt-noun"
          ]
        },
        {
          "id": "912411",
          "text": "Die Wolke hatte die Gestalt eines Bären.",
          "translation": "Облако имело форму медведя.",
          "source": "Tatoeba #912411 @Sudajaengi / #8260027 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/912411",
          "cefr_level": "A1",
          "word_slugs": [
            "gestalt-noun"
          ]
        },
        {
          "id": "12561876",
          "text": "Die Ideen nehmen nach und nach Gestalt an.",
          "translation": "Идеи понемногу принимают форму.",
          "source": "Tatoeba #12561876 @mhr / #12561504 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12561876",
          "cefr_level": "A1",
          "word_slugs": [
            "gestalt-noun"
          ]
        },
        {
          "id": "2577883",
          "text": "In der Hölle ist der Teufel eine positive Gestalt.",
          "translation": "В аду дьявол — положительный персонаж.",
          "source": "Tatoeba #2577883 @Esperantostern / #5618239 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2577883",
          "cefr_level": "A1",
          "word_slugs": [
            "gestalt-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
