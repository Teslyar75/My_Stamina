    {
      "slug": "ausgefallen-verb",
      "lemma": "ausgefallen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6822,
      "frequency_band": "goethe-c1",
      "translations": {
