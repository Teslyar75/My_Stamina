    {
      "slug": "betet-verb",
      "lemma": "betet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7962,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of beten:",
          "third-person singular present",
          "inflection of beten:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7984150",
          "text": "Pater Tom betet in der alten Kapelle.",
          "translation": "Отец Том молится в старой часовне.",
          "source": "Tatoeba #7984150 @Pfirsichbaeumchen / #13361352 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7984150",
          "cefr_level": "A1",
          "word_slugs": [
            "betet-verb"
          ]
        },
        {
          "id": "1452608",
          "text": "Die Kirche ist ein Haus, wo man betet.",
          "translation": "Церковь - это дом, где молятся.",
          "source": "Tatoeba #1452608 @Esperantostern / #9378985 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1452608",
          "cefr_level": "A1",
          "word_slugs": [
            "betet-verb"
          ]
        },
        {
          "id": "545088",
          "text": "Braga betet, Porto arbeitet, Coimbra studiert und Lissabon vergnügt sich.",
          "translation": "Брага молится, Порту работает, Коимбра учится, а Лиссабон развлекается.",
          "source": "Tatoeba #545088 @MUIRIEL / #13114312 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/545088",
          "cefr_level": "A1",
          "word_slugs": [
            "betet-verb"
          ]
        }
