        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4803916",
          "text": "Ich trage Lippenstift nicht gerne.",
          "translation": "Я не люблю красить губы.",
          "source": "Tatoeba #4803916 @Raringo / #10873369 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4803916",
          "cefr_level": "A1",
          "word_slugs": [
