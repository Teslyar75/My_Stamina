      "translations": {
        "ru": [
          "упаковка"
        ],
        "en": [
          "pack, package, packet",
          "a poultice, especially one for cosmetic purposes",
          "a large defeat, battering",
          "the act of packing, a certain method of it"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "9594664",
          "text": "Ich brauche eine Packung Eier.",
          "translation": "Мне нужна упаковка яиц.",
          "source": "Tatoeba #9594664 @Pfirsichbaeumchen / #11119000 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9594664",
          "cefr_level": "A1",
          "word_slugs": [
            "packung-noun"
          ]
        },
        {
          "id": "6808994",
          "text": "Kauf bitte eine Packung Spaghetti!",
          "translation": "Купи пачку спагетти, пожалуйста.",
          "source": "Tatoeba #6808994 @Pfirsichbaeumchen / #13769636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6808994",
          "cefr_level": "A1",
          "word_slugs": [
            "packung-noun"
          ]
        },
        {
          "id": "13979070",
          "text": "Tom hat die ganze Packung gegessen.",
          "translation": "Том съел всю пачку.",
          "source": "Tatoeba #13979070 @mhr / #13978928 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13979070",
          "cefr_level": "A1",
          "word_slugs": [
            "packung-noun"
          ]
        },
        {
          "id": "13979065",
          "text": "Tom hat die ganze Packung aufgegessen.",
          "translation": "Том съел всю пачку.",
          "source": "Tatoeba #13979065 @mhr / #13978928 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13979065",
          "cefr_level": "A1",
          "word_slugs": [
            "packung-noun"
          ]
        },
        {
          "id": "14008059",
          "text": "Und was ist in dieser Packung? Zucker?",
          "translation": "А в этой пачке что, сахар?",
          "source": "Tatoeba #14008059 @mhr / #14008050 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14008059",
          "cefr_level": "A1",
          "word_slugs": [
            "packung-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
