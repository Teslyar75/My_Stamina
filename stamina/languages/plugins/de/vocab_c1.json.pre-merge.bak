    {
      "slug": "mysteriöse-adj",
      "lemma": "mysteriöse",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9371,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of mysteriös:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of mysteriös:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4304823",
          "text": "Krokodile sind mysteriöse Tiere.",
          "translation": "Крокодилы - загадочные животные.",
          "source": "Tatoeba #4304823 @Adelpa / #4317528 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4304823",
          "cefr_level": "A1",
          "word_slugs": [
            "mysteriöse-adj"
          ]
        },
        {
          "id": "13753987",
          "text": "Er verschwand auf mysteriöse Weise.",
          "translation": "Он таинственным образом исчез.",
          "source": "Tatoeba #13753987 @Rovo / #13753999 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13753987",
          "cefr_level": "A1",
          "word_slugs": [
            "mysteriöse-adj"
          ]
        },
        {
          "id": "9869602",
          "text": "Tom ist auf mysteriöse Weise verschwunden.",
          "translation": "Том таинственным образом исчез.",
          "source": "Tatoeba #9869602 @GaryGaryGary / #6566386 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9869602",
          "cefr_level": "A1",
          "word_slugs": [
            "mysteriöse-adj"
          ]
        },
        {
          "id": "112",
          "text": "Ich mochte mysteriöse Charaktere schon immer mehr.",
          "translation": "Мне всегда больше нравились таинственные персонажи.",
          "source": "Tatoeba #112 @ludoviko / #5444 @Tonari (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/112",
          "cefr_level": "A1",
          "word_slugs": [
            "mysteriöse-adj"
          ]
        },
        {
          "id": "552277",
          "text": "Kommentare haben die mysteriöse Angewohnheit, in den Weiten Tatoebalands verloren zu gehen.",
          "translation": "Комментарии имеют таинственное свойство теряться на просторах Татоэбаландии.",
          "source": "Tatoeba #552277 @MUIRIEL / #1905014 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/552277",
          "cefr_level": "A1",
          "word_slugs": [
            "mysteriöse-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
