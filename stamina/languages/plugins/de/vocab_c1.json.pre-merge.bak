      },
      "gender": null,
      "examples": [
        {
          "id": "12303428",
          "text": "Ihr seid die Experten.",
          "translation": "Вы специалисты.",
          "source": "Tatoeba #12303428 @mhr / #5560661 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12303428",
          "cefr_level": "A1",
          "word_slugs": [
            "experten-noun"
          ]
        },
        {
          "id": "10159942",
          "text": "Wir brauchen einen Experten.",
          "translation": "Нам нужен эксперт.",
          "source": "Tatoeba #10159942 @sakslane / #10159615 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10159942",
          "cefr_level": "A1",
          "word_slugs": [
            "experten-noun"
          ]
        },
        {
          "id": "1910845",
          "text": "Zwei Experten sind wahrlich genug.",
          "translation": "Двух специалистов вполне достаточно.",
          "source": "Tatoeba #1910845 @al_ex_an_der / #1910841 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1910845",
          "cefr_level": "A1",
          "word_slugs": [
            "experten-noun"
          ]
        },
        {
          "id": "2305501",
          "text": "Ein dreizehnjähriger Schüler berichtigte einen Fehler von NASA-Experten.",
          "translation": "Тринадцатилетний школьник исправил ошибку экспертов НАСА.",
          "source": "Tatoeba #2305501 @al_ex_an_der / #2305497 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2305501",
          "cefr_level": "A1",
          "word_slugs": [
            "experten-noun"
          ]
        },
        {
          "id": "8816899",
          "text": "Experten können sich irren.",
          "translation": "Эксперты могут ошибаться.",
          "source": "Tatoeba #8816899 @carlosalberto / #8816292 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8816899",
          "cefr_level": "A1",
          "word_slugs": [
            "experten-noun"
          ]
        }
      ],
