    {
      "slug": "vertreiben-verb",
      "lemma": "vertreiben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6586,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "отгонять"
        ],
        "en": [
          "to force to leave, to drive away",
          "to pass (time)",
          "to put on the market, to sell (especially in large quantities)",
          "to put colors softly together"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5984565",
          "text": "Wir spielen Karten, um uns die Zeit zu vertreiben.",
          "translation": "Мы играем в карты, чтобы убить время.",
          "source": "Tatoeba #5984565 @Pfirsichbaeumchen / #3492101 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5984565",
          "cefr_level": "A1",
          "word_slugs": [
            "vertreiben-verb"
          ]
        },
        {
          "id": "1652739",
          "text": "Wir beschlossen, das Geschäft auszudehnen und Lebensmittel zu vertreiben.",
          "translation": "Мы решили расширить бизнес и начать продавать продукты питания.",
          "source": "Tatoeba #1652739 @Pfirsichbaeumchen / #2237913 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1652739",
