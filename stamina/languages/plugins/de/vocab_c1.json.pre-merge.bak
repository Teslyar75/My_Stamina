          "inflection of beeilen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5428291",
          "text": "Ich beeile mich.",
          "translation": "Я спешу.",
          "source": "Tatoeba #5428291 @nina99nv / #468851 @ArsWalrus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5428291",
          "cefr_level": "A1",
          "word_slugs": [
            "beeile-verb"
          ]
        },
        {
          "id": "5362924",
          "text": "Bitte beeile dich.",
          "translation": "Побыстрей, пожалуйста!",
          "source": "Tatoeba #5362924 @RandomUsername / #13936416 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5362924",
          "cefr_level": "A1",
          "word_slugs": [
            "beeile-verb"
          ]
        },
        {
          "id": "13041406",
          "text": "Beeile dich nicht so!",
          "translation": "Не спеши так!",
          "source": "Tatoeba #13041406 @Stuhr / #3287587 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13041406",
          "cefr_level": "A1",
          "word_slugs": [
            "beeile-verb"
          ]
        },
        {
          "id": "4261641",
          "text": "Beeile dich! Wir erwarten dich!",
          "translation": "Давай быстрей! Мы тебя ждём!",
          "source": "Tatoeba #4261641 @Esperantostern / #7809102 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4261641",
          "cefr_level": "A1",
          "word_slugs": [
            "beeile-verb"
          ]
        },
        {
          "id": "7004263",
          "text": "Der Zug fährt ab! Beeile dich!",
          "translation": "Поезд отправляется! Поторопись!",
          "source": "Tatoeba #7004263 @Pfirsichbaeumchen / #5174130 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7004263",
          "cefr_level": "A1",
          "word_slugs": [
            "beeile-verb"
          ]
        }
