          ]
        },
        {
          "id": "13438332",
          "text": "Der Stein rollte den Hügel hinunter.",
          "translation": "Камень скатился с холма.",
          "source": "Tatoeba #13438332 @mhr / #11297903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13438332",
