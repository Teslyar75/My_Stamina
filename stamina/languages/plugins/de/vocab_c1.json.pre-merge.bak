    {
      "slug": "gebildet-verb",
      "lemma": "gebildet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9763,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of bilden"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13826197",
          "text": "Diese Mädchen sind gebildet und klug.",
          "translation": "Эти девушки образованные и смышлёные.",
          "source": "Tatoeba #13826197 @mhr / #13826190 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13826197",
          "cefr_level": "A1",
          "word_slugs": [
            "gebildet-verb"
          ]
        },
        {
          "id": "8892601",
          "text": "Die Blutzellen werden im Knochenmark gebildet.",
          "translation": "Клетки крови образуются в костном мозге.",
          "source": "Tatoeba #8892601 @brauchinet / #6276736 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8892601",
          "cefr_level": "A1",
          "word_slugs": [
            "gebildet-verb"
          ]
        },
        {
          "id": "4506947",
          "text": "Ich habe mir noch keine Meinung gebildet.",
          "translation": "Я ещё не составил себе мнения об этом.",
          "source": "Tatoeba #4506947 @raggione / #12354150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4506947",
          "cefr_level": "A1",
          "word_slugs": [
            "gebildet-verb"
          ]
        },
        {
          "id": "1893496",
          "text": "Am Abend haben sich einige Wolken gebildet.",
          "translation": "К вечеру образовалось несколько облаков.",
          "source": "Tatoeba #1893496 @Espi / #3484731 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1893496",
          "cefr_level": "A1",
          "word_slugs": [
            "gebildet-verb"
          ]
        },
        {
          "id": "12354136",
          "text": "Ich habe mir noch keine eigene Meinung gebildet.",
          "translation": "Я ещё не составил себе мнения об этом.",
          "source": "Tatoeba #12354136 @Naina / #12354150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12354136",
          "cefr_level": "A1",
          "word_slugs": [
            "gebildet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
