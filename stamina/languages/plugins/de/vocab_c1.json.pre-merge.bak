    {
      "slug": "romantische-adj",
      "lemma": "romantische",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5427,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of romantisch:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of romantisch:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8177296",
          "text": "Paris ist eine romantische Stadt.",
          "translation": "Париж - романтический город.",
          "source": "Tatoeba #8177296 @Pfirsichbaeumchen / #8174446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8177296",
          "cefr_level": "A1",
          "word_slugs": [
            "romantische-adj"
          ]
        },
        {
          "id": "7269474",
          "text": "Venedig ist eine romantische Stadt.",
          "translation": "Венеция - романтический город.",
          "source": "Tatoeba #7269474 @Pfirsichbaeumchen / #7028399 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7269474",
          "cefr_level": "A1",
          "word_slugs": [
            "romantische-adj"
          ]
        },
        {
          "id": "4631371",
          "text": "Die Frauen lieben romantische Männer.",
          "translation": "Женщины любят романтичных мужчин.",
          "source": "Tatoeba #4631371 @Tamy / #5023111 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4631371",
          "cefr_level": "A1",
          "word_slugs": [
            "romantische-adj"
          ]
        },
        {
          "id": "9067047",
          "text": "Maria sieht sich gerne romantische Komödien an.",
          "translation": "Мэри любит смотреть романтические комедии.",
          "source": "Tatoeba #9067047 @Pfirsichbaeumchen / #7812621 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9067047",
          "cefr_level": "A1",
          "word_slugs": [
            "romantische-adj"
          ]
        },
        {
          "id": "11120111",
          "text": "Dieses italienische Restaurant hat eine romantische Atmosphäre.",
          "translation": "В этом итальянском ресторане романтичная атмосфера.",
          "source": "Tatoeba #11120111 @Pfirsichbaeumchen / #11120113 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11120111",
          "cefr_level": "A1",
          "word_slugs": [
            "romantische-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
