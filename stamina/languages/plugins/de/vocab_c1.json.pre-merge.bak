    {
      "slug": "trag-verb",
      "lemma": "trag",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6632,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "singular imperative of tragen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "936415",
          "text": "Trag den Tisch bitte nach draußen.",
          "translation": "Вынеси стол на улицу, пожалуйста.",
          "source": "Tatoeba #936415 @Sudajaengi / #7500441 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/936415",
          "cefr_level": "A1",
          "word_slugs": [
            "trag-verb"
          ]
        },
        {
          "id": "1135657",
          "text": "Papa, ich kann nicht mehr laufen. Trag mich!",
          "translation": "Папа, я не могу больше идти. Понеси меня.",
          "source": "Tatoeba #1135657 @MUIRIEL / #2771971 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1135657",
          "cefr_level": "A1",
          "word_slugs": [
            "trag-verb"
          ]
        },
        {
          "id": "3634013",
          "text": "Trag den Mantel oder du wirst dich erkälten.",
          "translation": "Носи пальто, а то простудишься.",
          "source": "Tatoeba #3634013 @Tamy / #3634757 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3634013",
          "cefr_level": "A1",
          "word_slugs": [
            "trag-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
