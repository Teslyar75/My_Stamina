          "cefr_level": "A1",
          "word_slugs": [
            "seattle-name"
          ]
        },
        {
          "id": "13872170",
          "text": "In Seattle ist es regnerisch.",
          "translation": "В Сиэтле дождливо.",
          "source": "Tatoeba #13872170 @mhr / #13872088 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13872170",
          "cefr_level": "A1",
          "word_slugs": [
            "seattle-name"
          ]
        }
      ],
