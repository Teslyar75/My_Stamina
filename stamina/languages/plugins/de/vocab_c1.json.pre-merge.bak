    {
      "slug": "entstanden-verb",
      "lemma": "entstanden",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8138,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "first/third-person plural preterite of entstehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14003940",
          "text": "Wie sind die Niederlande entstanden?",
          "translation": "Как появились Нидерланды?",
          "source": "Tatoeba #14003940 @mhr / #14003903 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14003940",
          "cefr_level": "A1",
          "word_slugs": [
            "entstanden-verb"
          ]
        },
        {
          "id": "1325476",
          "text": "Woher stammt das Meer? Wie entstanden die großen Salzwassermassen?",
          "translation": "Откуда взялось море? Как возникла большая масса солёной воды?",
          "source": "Tatoeba #1325476 @al_ex_an_der / #1325485 @elsteris (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1325476",
          "cefr_level": "A1",
          "word_slugs": [
            "entstanden-verb"
          ]
        },
        {
          "id": "1843243",
          "text": "Die Philosophie, so heißt es, ist aus dem Staunen entstanden.",
          "translation": "Говорят, философия родится из удивления.",
          "source": "Tatoeba #1843243 @Esperantostern / #3541948 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1843243",
          "cefr_level": "A1",
          "word_slugs": [
            "entstanden-verb"
          ]
        },
        {
          "id": "7027387",
          "text": "Die ersten Fotoaufnahmen der Welt entstanden in den 1830er Jahren.",
          "translation": "Первые в мире фотографии были сделаны в тридцатых годах девятнадцатого века.",
          "source": "Tatoeba #7027387 @Pfirsichbaeumchen / #13104925 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7027387",
          "cefr_level": "A1",
          "word_slugs": [
            "entstanden-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
