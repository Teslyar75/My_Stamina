        {
          "id": "13234994",
          "text": "Ich bereue viel.",
          "translation": "Я много о чём жалею.",
          "source": "Tatoeba #13234994 @Waldelfe / #5913796 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13234994",
          "cefr_level": "A1",
          "word_slugs": [
            "bereue-verb"
          ]
        },
        {
          "id": "1793814",
          "text": "Ich bereue nichts.",
          "translation": "Я ни о чём не жалею.",
          "source": "Tatoeba #1793814 @Pfirsichbaeumchen / #2362680 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1793814",
          "cefr_level": "A1",
          "word_slugs": [
            "bereue-verb"
          ]
        },
        {
          "id": "3430733",
          "text": "Nein, ich bereue nichts.",
          "translation": "Нет, я ни о чём не сожалею.",
          "source": "Tatoeba #3430733 @Plusquamperfekt / #3443854 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3430733",
          "cefr_level": "A1",
          "word_slugs": [
            "bereue-verb"
          ]
        },
        {
          "id": "13380729",
          "text": "Ich bereue es allmählich.",
          "translation": "Я начинаю жалеть об этом.",
          "source": "Tatoeba #13380729 @Waldelfe / #4746812 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13380729",
          "cefr_level": "A1",
          "word_slugs": [
            "bereue-verb"
          ]
        },
        {
          "id": "5841298",
          "text": "Ich bereue es kein bisschen.",
          "translation": "Я совершенно об этом не жалею.",
          "source": "Tatoeba #5841298 @Pfirsichbaeumchen / #4231653 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5841298",
          "cefr_level": "A1",
          "word_slugs": [
            "bereue-verb"
          ]
        }
