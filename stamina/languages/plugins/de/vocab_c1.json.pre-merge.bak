    {
      "slug": "restaurants-noun",
      "lemma": "Restaurants",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7678,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "genitive singular of Restaurant",
          "plural of Restaurant"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3032952",
          "text": "Ich kenne viele gute Restaurants.",
          "translation": "Я знаю много хороших ресторанов.",
          "source": "Tatoeba #3032952 @Pfirsichbaeumchen / #5318787 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3032952",
          "cefr_level": "A1",
          "word_slugs": [
            "restaurants-noun"
          ]
        },
        {
          "id": "2448406",
          "text": "Geht Marika in japanische Restaurants?",
          "translation": "Марика ходит в японские рестораны?",
          "source": "Tatoeba #2448406 @Pfirsichbaeumchen / #6707147 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2448406",
          "cefr_level": "A1",
          "word_slugs": [
            "restaurants-noun"
          ]
        },
        {
          "id": "3294327",
          "text": "Ich bin der Besitzer dieses Restaurants.",
          "translation": "Я владелец этого ресторана.",
          "source": "Tatoeba #3294327 @freddy1 / #3294490 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3294327",
          "cefr_level": "A1",
          "word_slugs": [
            "restaurants-noun"
          ]
        },
        {
          "id": "901215",
          "text": "Rauchen ist in kalifornischen Restaurants verboten.",
          "translation": "В ресторанах Калифорнии курение запрещено.",
          "source": "Tatoeba #901215 @Pfirsichbaeumchen / #6707232 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/901215",
          "cefr_level": "A1",
          "word_slugs": [
            "restaurants-noun"
          ]
        },
        {
          "id": "13154885",
          "text": "Tom ist einer der Besitzer dieses Restaurants.",
          "translation": "Том — один из владельцев этого ресторана.",
          "source": "Tatoeba #13154885 @Rovo / #14085864 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13154885",
          "cefr_level": "A1",
          "word_slugs": [
            "restaurants-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
