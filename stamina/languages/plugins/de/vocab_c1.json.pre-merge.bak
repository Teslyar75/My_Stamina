    {
      "slug": "arrogant-adj",
      "lemma": "arrogant",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8618,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "надменный",
          "высокомерный"
        ],
        "en": [
          "arrogant"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4066645",
          "text": "Er ist so arrogant!",
          "translation": "Он такой надменный!",
          "source": "Tatoeba #4066645 @studybrick_samuel / #10362808 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4066645",
          "cefr_level": "A1",
          "word_slugs": [
            "arrogant-adj"
          ]
        },
        {
          "id": "8072313",
          "text": "Tom ist so arrogant.",
          "translation": "Том такой высокомерный.",
          "source": "Tatoeba #8072313 @Luiaard / #5129071 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8072313",
          "cefr_level": "A1",
          "word_slugs": [
            "arrogant-adj"
          ]
        },
        {
          "id": "3428690",
          "text": "Man sagt, ich sei arrogant.",
          "translation": "Говорят, что я якобы заносчив.",
          "source": "Tatoeba #3428690 @al_ex_an_der / #3435498 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3428690",
          "cefr_level": "A1",
          "word_slugs": [
            "arrogant-adj"
          ]
        },
        {
          "id": "4886965",
          "text": "Er ist klug, aber arrogant.",
          "translation": "Он умён, но высокомерен.",
          "source": "Tatoeba #4886965 @Pfirsichbaeumchen / #10362817 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4886965",
          "cefr_level": "A1",
          "word_slugs": [
            "arrogant-adj"
          ]
        },
        {
          "id": "1924573",
          "text": "Er ist uns gegenüber arrogant.",
          "translation": "Он ведёт себя надменно по отношению к нам.",
          "source": "Tatoeba #1924573 @Zaghawa / #10161985 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1924573",
          "cefr_level": "A1",
          "word_slugs": [
            "arrogant-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der arrogant",
