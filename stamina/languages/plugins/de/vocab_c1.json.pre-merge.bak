        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "940251",
          "text": "Dieser Artikel ist von hoher Qualität.",
          "translation": "Это высококачественный товар.",
          "source": "Tatoeba #940251 @Espi / #12004388 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/940251",
          "cefr_level": "A1",
