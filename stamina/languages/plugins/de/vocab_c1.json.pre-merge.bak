      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "обозначать",
          "обозначить",
          "означить"
        ],
        "en": [
          "to name (give a name to), to call, to designate, to denote",
          "to identify with, to indicate, to describe as",
          "to describe oneself, to identify"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1803501",
          "text": "Mit dem Zeichen „⊂“ bezeichnen wir die echte Inklusion.",
          "translation": "Мы используем символ «⊂» для обозначения строгого включения.",
          "source": "Tatoeba #1803501 @Pfirsichbaeumchen / #407421 @arseniiv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1803501",
          "cefr_level": "A1",
          "word_slugs": [
            "bezeichnen-verb"
          ]
        },
        {
          "id": "2038285",
          "text": "Ich kenne ihre Eltern und sie bezeichnen mich schon als Sohn.",
          "translation": "Я знаю её родителей, и они меня уже сыном называют.",
          "source": "Tatoeba #2038285 @al_ex_an_der / #2038284 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2038285",
          "cefr_level": "A1",
          "word_slugs": [
            "bezeichnen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
