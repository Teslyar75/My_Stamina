    {
      "slug": "rathaus-noun",
      "lemma": "Rathaus",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8056,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "ратуша"
        ],
        "en": [
          "city hall, town hall (city council meeting house)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "571430",
          "text": "Das Rathaus ist im Stadtzentrum.",
          "translation": "Ратуша находится в центре города.",
          "source": "Tatoeba #571430 @Manfredo / #5790767 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/571430",
          "cefr_level": "A1",
          "word_slugs": [
            "rathaus-noun"
          ]
        },
        {
          "id": "586965",
          "text": "Das Rathaus befindet sich gleich um die Ecke.",
          "translation": "Ратуша находится в двух шагах отсюда.",
          "source": "Tatoeba #586965 @Pfirsichbaeumchen / #1945545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/586965",
          "cefr_level": "A1",
          "word_slugs": [
            "rathaus-noun"
          ]
        },
        {
          "id": "6880315",
          "text": "Das Rathaus ist nicht weit entfernt von hier.",
          "translation": "Ратуша недалеко отсюда.",
          "source": "Tatoeba #6880315 @felix63 / #13774442 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6880315",
          "cefr_level": "A1",
          "word_slugs": [
            "rathaus-noun"
          ]
        },
        {
          "id": "3452954",
          "text": "Der Bäcker vor dem Rathaus hat seine Preise erhöht.",
          "translation": "В булочной напротив мэрии подняли цены.",
          "source": "Tatoeba #3452954 @Trinkschokolade / #4075189 @Settler (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3452954",
          "cefr_level": "A1",
          "word_slugs": [
            "rathaus-noun"
          ]
        },
        {
          "id": "3558820",
          "text": "Die Bäckerei vor dem Rathaus hat ihre Preise erhöht.",
          "translation": "Булочная перед ратушей подняла цены.",
          "source": "Tatoeba #3558820 @kolonjano / #3558982 @Inalie (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3558820",
          "cefr_level": "A1",
          "word_slugs": [
            "rathaus-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
