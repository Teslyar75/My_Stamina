    {
      "slug": "schale-noun",
      "lemma": "Schale",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7677,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "кожура",
          "скорлупа"
        ],
        "en": [
          "dish (shallow container)",
          "bowl; cup (roughly hemispherical container)",
          "scale (dish of a balance)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "8337925",
          "text": "Isst du Äpfel mit Schale?",
          "translation": "Ты ешь яблоки вместе с кожурой?",
          "source": "Tatoeba #8337925 @Pfirsichbaeumchen / #6447137 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8337925",
          "cefr_level": "A1",
          "word_slugs": [
            "schale-noun"
          ]
        },
        {
          "id": "6867416",
          "text": "Diese Schale ist zu klein.",
          "translation": "Эта миска слишком маленькая.",
          "source": "Tatoeba #6867416 @felix63 / #6878400 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6867416",
          "cefr_level": "A1",
          "word_slugs": [
            "schale-noun"
          ]
        },
        {
          "id": "14068997",
          "text": "In der Schale steckt das Gesündeste.",
          "translation": "В кожуре всё самое полезное.",
          "source": "Tatoeba #14068997 @mhr / #14068979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14068997",
          "cefr_level": "A1",
          "word_slugs": [
            "schale-noun"
          ]
        },
        {
          "id": "13708758",
          "text": "Ich esse Äpfel immer mit der Schale.",
          "translation": "Я яблоки всегда ем с кожурой.",
          "source": "Tatoeba #13708758 @Waldelfe / #13708754 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13708758",
          "cefr_level": "A1",
          "word_slugs": [
            "schale-noun"
          ]
        },
        {
          "id": "14069027",
          "text": "In der Schale ist das Gesündeste enthalten.",
          "translation": "В кожуре всё самое полезное.",
          "source": "Tatoeba #14069027 @mhr / #14068979 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14069027",
          "cefr_level": "A1",
          "word_slugs": [
            "schale-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Schale",
        "nominative_pl": ""
      }
    },
