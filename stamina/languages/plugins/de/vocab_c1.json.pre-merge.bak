      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Cousin"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7277191",
          "text": "Sie sind Cousins.",
          "translation": "Они двоюродные братья.",
          "source": "Tatoeba #7277191 @Yorwba / #4475537 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7277191",
          "cefr_level": "A1",
          "word_slugs": [
            "cousins-noun"
          ]
        },
        {
          "id": "412198",
          "text": "Ich habe drei Cousins.",
          "translation": "У меня три двоюродных брата.",
          "source": "Tatoeba #412198 @MUIRIEL / #3611263 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/412198",
          "cefr_level": "A1",
          "word_slugs": [
            "cousins-noun"
          ]
        },
        {
          "id": "3399737",
          "text": "Seid ihr wirklich Cousins?",
          "translation": "Вы действительно двоюродные братья?",
          "source": "Tatoeba #3399737 @Pfirsichbaeumchen / #12942910 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3399737",
          "cefr_level": "A1",
          "word_slugs": [
            "cousins-noun"
          ]
        },
        {
          "id": "1285944",
          "text": "Du und ich sind Cousins.",
          "translation": "Мы с тобой двоюродные братья.",
          "source": "Tatoeba #1285944 @Espi / #11824837 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1285944",
          "cefr_level": "A1",
          "word_slugs": [
            "cousins-noun"
          ]
        },
        {
          "id": "4058120",
          "text": "Tom und ich sind Cousins.",
          "translation": "Мы с Томом двоюродные братья.",
          "source": "Tatoeba #4058120 @Pfirsichbaeumchen / #5525879 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4058120",
          "cefr_level": "A1",
          "word_slugs": [
            "cousins-noun"
          ]
        }
      ],
      "tags": [
