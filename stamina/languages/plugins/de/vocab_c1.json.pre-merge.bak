    {
      "slug": "vorschlagen-verb",
      "lemma": "vorschlagen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5078,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "предлагать"
        ],
        "en": [
          "to propose, to suggest"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3191740",
          "text": "Das würde ich nie vorschlagen.",
          "translation": "Я бы никогда не предложил этого.",
          "source": "Tatoeba #3191740 @Pfirsichbaeumchen / #2633029 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3191740",
          "cefr_level": "A1",
          "word_slugs": [
            "vorschlagen-verb"
          ]
        },
        {
          "id": "12577549",
          "text": "Darf ich ein anderes Hotel vorschlagen?",
          "translation": "Могу я предложить другой отель?",
          "source": "Tatoeba #12577549 @Waldelfe / #3683004 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12577549",
          "cefr_level": "A1",
          "word_slugs": [
            "vorschlagen-verb"
          ]
        },
        {
          "id": "5459183",
          "text": "Ich wollte gerade das Gleiche vorschlagen.",
          "translation": "Я как раз хотел предложить то же самое.",
          "source": "Tatoeba #5459183 @Pfirsichbaeumchen / #10632396 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5459183",
          "cefr_level": "A1",
          "word_slugs": [
            "vorschlagen-verb"
          ]
        },
        {
          "id": "6935535",
          "text": "Ich würde die folgende Änderung vorschlagen.",
          "translation": "Я бы предложил следующее изменение.",
          "source": "Tatoeba #6935535 @moskytoo / #8812629 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6935535",
          "cefr_level": "A1",
          "word_slugs": [
            "vorschlagen-verb"
          ]
        },
        {
          "id": "13296524",
          "text": "Darf ich eine alternative Lösung vorschlagen?",
          "translation": "Могу я предложить альтернативное решение?",
          "source": "Tatoeba #13296524 @frpzzd / #13247298 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13296524",
          "cefr_level": "A1",
          "word_slugs": [
            "vorschlagen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
