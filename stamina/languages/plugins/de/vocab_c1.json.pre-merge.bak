            "beantwortet-verb"
          ]
        },
        {
          "id": "1837154",
          "text": "Bitte beantwortet alle Fragen.",
          "translation": "Ответьте на все вопросы, пожалуйста.",
          "source": "Tatoeba #1837154 @Zaghawa / #10971097 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1837154",
          "cefr_level": "A1",
          "word_slugs": [
            "beantwortet-verb"
          ]
        },
        {
          "id": "13893711",
          "text": "Beantwortet einfach die Frage!",
          "translation": "Просто отвечайте на вопрос.",
          "source": "Tatoeba #13893711 @mhr / #13893868 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13893711",
          "cefr_level": "A1",
          "word_slugs": [
            "beantwortet-verb"
          ]
        },
        {
          "id": "13987047",
          "text": "Beantwortet diese Frage nicht!",
          "translation": "Не отвечайте на этот вопрос.",
          "source": "Tatoeba #13987047 @mhr / #13987255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13987047",
