          "cefr_level": "A1",
          "word_slugs": [
            "angeschaut-verb"
          ]
        },
        {
          "id": "12185874",
          "text": "Sie haben sich ein Bild angeschaut.",
          "translation": "Они посмотрели на картину.",
          "source": "Tatoeba #12185874 @mhr / #5987704 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12185874",
          "cefr_level": "A1",
          "word_slugs": [
            "angeschaut-verb"
          ]
        },
        {
          "id": "13879947",
          "text": "Ich werde ohnehin schon schief angeschaut.",
          "translation": "На меня и так уже косо смотрят.",
          "source": "Tatoeba #13879947 @mhr / #13879922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13879947",
          "cefr_level": "A1",
          "word_slugs": [
            "angeschaut-verb"
          ]
        },
        {
          "id": "13941008",
          "text": "Welchen Film hast du dir gestern angeschaut?",
          "translation": "Какой фильм ты вчера смотрел?",
