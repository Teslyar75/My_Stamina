    {
      "slug": "rast-verb",
      "lemma": "rast",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9764,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of rasen:",
          "second/third-person singular present",
          "inflection of rasen:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13428500",
          "text": "Die Zeit vergeht nicht einfach, sondern sie rast wie besessen dahin.",
          "translation": "Время не просто идёт, а несётся с бешеной скоростью.",
