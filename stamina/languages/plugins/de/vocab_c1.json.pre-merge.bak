    {
      "slug": "verbindet-verb",
      "lemma": "verbindet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6046,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
