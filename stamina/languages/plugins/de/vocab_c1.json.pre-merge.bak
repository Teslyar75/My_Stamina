    {
      "slug": "amerikanischer-adj",
      "lemma": "amerikanischer",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7800,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of amerikanisch:",
          "strong/mixed nominative masculine singular",
