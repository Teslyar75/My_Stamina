          ]
        },
        {
          "id": "10713199",
          "text": "Meine Großeltern sind tot.",
          "translation": "Мои бабушка и дедушка умерли.",
          "source": "Tatoeba #10713199 @carlosalberto / #10714517 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10713199",
          "cefr_level": "A1",
          "word_slugs": [
            "grosseltern-noun"
          ]
        },
        {
          "id": "8335272",
          "text": "Wir helfen unseren Großeltern.",
          "translation": "Мы помогаем бабушке с дедушкой.",
          "source": "Tatoeba #8335272 @felix63 / #11570128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8335272",
          "cefr_level": "A1",
          "word_slugs": [
            "grosseltern-noun"
          ]
        },
        {
          "id": "6692337",
          "text": "Woher stammten eure Großeltern?",
          "translation": "Откуда родом были ваши дедушка с бабушкой?",
          "source": "Tatoeba #6692337 @felix63 / #11850335 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6692337",
          "cefr_level": "A1",
          "word_slugs": [
            "grosseltern-noun"
          ]
        }
