    {
      "slug": "eingenommen-verb",
      "lemma": "eingenommen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8173,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of einnehmen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13803890",
          "text": "Wer hat deinen Platz eingenommen?",
          "translation": "Кто занял твоё место?",
          "source": "Tatoeba #13803890 @mhr / #13803117 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13803890",
          "cefr_level": "A1",
          "word_slugs": [
            "eingenommen-verb"
          ]
        },
        {
          "id": "3465715",
          "text": "Die Separatisten haben den Flughafen eingenommen.",
          "translation": "Сепаратисты взяли аэропорт.",
          "source": "Tatoeba #3465715 @al_ex_an_der / #3465712 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3465715",
          "cefr_level": "A1",
          "word_slugs": [
            "eingenommen-verb"
          ]
        },
        {
          "id": "4916611",
          "text": "Er ist zu sehr von sich eingenommen.",
          "translation": "Он очень высокого мнения о себе.",
          "source": "Tatoeba #4916611 @Manfredo / #4918732 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4916611",
          "cefr_level": "A1",
          "word_slugs": [
            "eingenommen-verb"
          ]
        },
        {
          "id": "1099296",
          "text": "Das Medikament muss dreimal täglich eingenommen werden.",
          "translation": "Это лекарство надо принимать три раза в день.",
          "source": "Tatoeba #1099296 @MUIRIEL / #3972326 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1099296",
          "cefr_level": "A1",
          "word_slugs": [
            "eingenommen-verb"
          ]
        },
        {
          "id": "13607065",
          "text": "Anscheinend waren die Tabletten, die ich vorhin eingenommen habe, wirksam.",
          "translation": "Похоже, принятые мной до того таблетки оказались действенными.",
          "source": "Tatoeba #13607065 @mhr / #13607030 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13607065",
          "cefr_level": "A1",
          "word_slugs": [
            "eingenommen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
