    {
      "slug": "nadel-noun",
      "lemma": "Nadel",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5225,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "needle; hook (implement for sewing, knitting, or crocheting)",
          "pin (implement for fixing something)",
          "needle (indicating device)",
          "needle (sensor for phonograph stylus)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6804282",
          "text": "Wir nähen mit einer Nadel.",
          "translation": "Мы шьём иглой.",
          "source": "Tatoeba #6804282 @manese / #6804509 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6804282",
          "cefr_level": "A1",
          "word_slugs": [
            "nadel-noun"
          ]
        },
        {
          "id": "7223136",
          "text": "Sie näht mit Nadel und Faden.",
          "translation": "Она шьёт иголкой и ниткой.",
          "source": "Tatoeba #7223136 @Pfirsichbaeumchen / #1941621 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7223136",
          "cefr_level": "A1",
          "word_slugs": [
            "nadel-noun"
          ]
        },
        {
          "id": "12448669",
          "text": "Könnten Sie mir die Nadel einfädeln?",
          "translation": "Вы не вденете мне нитку в иголку?",
          "source": "Tatoeba #12448669 @Waldelfe / #10168756 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12448669",
          "cefr_level": "A1",
          "word_slugs": [
            "nadel-noun"
          ]
        },
        {
          "id": "1498457",
          "text": "Es ist nicht leicht, eine Nadel einzufädeln.",
          "translation": "Нелегко вдеть нитку в иголку.",
          "source": "Tatoeba #1498457 @Esperantostern / #4870320 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1498457",
          "cefr_level": "A1",
          "word_slugs": [
            "nadel-noun"
          ]
        },
        {
          "id": "7824537",
          "text": "Die Nadel eines Kompasses zeigt nach Norden.",
          "translation": "Стрелка компаса указывает на север.",
          "source": "Tatoeba #7824537 @Pfirsichbaeumchen / #1792922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7824537",
          "cefr_level": "A1",
          "word_slugs": [
            "nadel-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
