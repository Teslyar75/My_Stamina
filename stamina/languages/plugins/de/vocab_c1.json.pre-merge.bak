    {
      "slug": "tonnen-noun",
      "lemma": "Tonnen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7508,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Tonne"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1931538",
          "text": "Dieser Stein wiegt fünf Tonnen.",
          "translation": "Этот камень весит пять тонн.",
          "source": "Tatoeba #1931538 @Beatminister / #3543613 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1931538",
          "cefr_level": "A1",
          "word_slugs": [
            "tonnen-noun"
          ]
        },
        {
          "id": "786481",
          "text": "Wir möchten gerne 18 Tonnen Olivenöl bestellen.",
          "translation": "Мы хотели бы заказать 18 тонн оливкового масла.",
          "source": "Tatoeba #786481 @Hans_Adler / #3948745 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/786481",
          "cefr_level": "A1",
          "word_slugs": [
            "tonnen-noun"
          ]
        },
        {
          "id": "8845552",
          "text": "Ein ausgewachsener afrikanischer Elefant wiegt etwa vier Tonnen.",
          "translation": "Взрослый африканский слон весит около четырёх тонн.",
          "source": "Tatoeba #8845552 @carlosalberto / #8845252 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8845552",
          "cefr_level": "A1",
          "word_slugs": [
            "tonnen-noun"
          ]
        },
        {
          "id": "6992667",
          "text": "In China werden täglich etwa zehn Millionen Tonnen Kohle abgebaut.",
          "translation": "В Китае каждый день добывают примерно десять миллионов тонн угля.",
          "source": "Tatoeba #6992667 @Pfirsichbaeumchen / #4828320 @eishiya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6992667",
          "cefr_level": "A1",
          "word_slugs": [
            "tonnen-noun"
          ]
        },
        {
          "id": "11983303",
          "text": "In Australien werden jeden Tag über eine Million Tonnen Kohle abgebaut.",
          "translation": "В Австралии ежедневно добывается более миллиона тонн угля.",
          "source": "Tatoeba #11983303 @Pfirsichbaeumchen / #4821725 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11983303",
          "cefr_level": "A1",
          "word_slugs": [
            "tonnen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
