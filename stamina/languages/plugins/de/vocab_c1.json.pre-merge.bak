          ]
        },
        {
          "id": "10496869",
          "text": "Ich liebe sie von ganzer Seele.",
          "translation": "Я люблю её всей душой.",
          "source": "Tatoeba #10496869 @Pfirsichbaeumchen / #10496866 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10496869",
          "cefr_level": "A1",
          "word_slugs": [
