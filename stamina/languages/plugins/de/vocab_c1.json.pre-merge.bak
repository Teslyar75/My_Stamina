    {
      "slug": "situationen-noun",
      "lemma": "Situationen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7376,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Situation"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1934189",
          "text": "Ausweglose Situationen gibt es nicht.",
          "translation": "Безвыходных положений не бывает.",
          "source": "Tatoeba #1934189 @al_ex_an_der / #1750745 @gleki (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1934189",
          "cefr_level": "A1",
          "word_slugs": [
            "situationen-noun"
          ]
        },
        {
          "id": "1775249",
          "text": "Es gibt im Leben verschiedene Situationen.",
          "translation": "В жизни бывают разные ситуации.",
          "source": "Tatoeba #1775249 @al_ex_an_der / #1775248 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1775249",
          "cefr_level": "A1",
          "word_slugs": [
            "situationen-noun"
          ]
        },
        {
          "id": "3698284",
          "text": "Das ist in solchen Situationen sehr gefährlich.",
          "translation": "Это очень опасно в таких ситуациях.",
          "source": "Tatoeba #3698284 @al_ex_an_der / #3698285 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3698284",
          "cefr_level": "A1",
          "word_slugs": [
            "situationen-noun"
          ]
        },
        {
          "id": "2430872",
          "text": "Man kann in solchen Situationen nicht vorsichtig genug sein.",
          "translation": "В таких ситуациях нельзя быть слишком осторожным.",
          "source": "Tatoeba #2430872 @salutony / #12433921 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2430872",
          "cefr_level": "A1",
          "word_slugs": [
            "situationen-noun"
          ]
        },
        {
          "id": "4902354",
          "text": "Die Zeit vergeht und verändert unweigerlich Umstände, Situationen und Menschen.",
          "translation": "Время течёт и неизбежно изменяет обстоятельства, ситуации и людей.",
          "source": "Tatoeba #4902354 @al_ex_an_der / #4902379 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4902354",
          "cefr_level": "A1",
          "word_slugs": [
            "situationen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
