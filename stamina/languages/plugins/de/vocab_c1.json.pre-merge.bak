    {
      "slug": "nachmittags-adv",
      "lemma": "nachmittags",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8485,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "днём"
        ],
        "en": [
          "in the afternoon, p.m."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5489666",
          "text": "Es wird nachmittags regnen.",
          "translation": "После обеда будет дождь.",
          "source": "Tatoeba #5489666 @wolfgangth / #5487127 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5489666",
          "cefr_level": "A1",
          "word_slugs": [
            "nachmittags-adv"
          ]
        },
        {
          "id": "11971814",
          "text": "Ich schlafe gerne nachmittags.",
          "translation": "Я люблю спать днём.",
          "source": "Tatoeba #11971814 @Naina / #11971818 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11971814",
          "cefr_level": "A1",
          "word_slugs": [
            "nachmittags-adv"
          ]
        },
        {
          "id": "606433",
          "text": "Es ist zwei Uhr nachmittags.",
          "translation": "Два часа пополудни.",
          "source": "Tatoeba #606433 @MUIRIEL / #4581800 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/606433",
          "cefr_level": "A1",
          "word_slugs": [
            "nachmittags-adv"
          ]
        },
        {
          "id": "407618",
          "text": "Sie hat immer nachmittags Zeit.",
          "translation": "После обеда у нее всегда есть время.",
          "source": "Tatoeba #407618 @xtofu80 / #407629 @Hellerick (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/407618",
          "cefr_level": "A1",
          "word_slugs": [
            "nachmittags-adv"
          ]
        },
        {
          "id": "2750491",
          "text": "Tom trinkt nachmittags nie Kaffee.",
          "translation": "Том никогда не пьёт кофе после обеда.",
          "source": "Tatoeba #2750491 @Pfirsichbaeumchen / #9178259 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2750491",
          "cefr_level": "A1",
          "word_slugs": [
            "nachmittags-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
