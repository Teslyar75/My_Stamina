    {
      "slug": "union-noun",
      "lemma": "Union",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8777,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "союз"
        ],
        "en": [
          "union"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13648779",
          "text": "Die Europäische Union hat 23 Amtssprachen.",
          "translation": "В Европейском союзе двадцать три официальных языка.",
          "source": "Tatoeba #13648779 @mhr / #13637791 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13648779",
          "cefr_level": "A1",
          "word_slugs": [
            "union-noun"
          ]
        },
        {
          "id": "5862541",
          "text": "Großbritannien verlässt die Europäische Union.",
          "translation": "Великобритания покидает Европейский союз.",
          "source": "Tatoeba #5862541 @Pfirsichbaeumchen / #5863150 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5862541",
          "cefr_level": "A1",
          "word_slugs": [
            "union-noun"
          ]
        },
        {
          "id": "10324689",
          "text": "Die Union hat die Wahl verloren.",
          "translation": "ХДС проиграл выборы.",
          "source": "Tatoeba #10324689 @rmateo / #10325093 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10324689",
          "cefr_level": "A1",
          "word_slugs": [
            "union-noun"
          ]
        },
        {
          "id": "13238085",
          "text": "Ich lebe in der Europäischen Union.",
          "translation": "Я живу в Евросоюзе.",
          "source": "Tatoeba #13238085 @felix63 / #13238089 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13238085",
          "cefr_level": "A1",
          "word_slugs": [
            "union-noun"
          ]
        },
        {
          "id": "540731",
          "text": "Litauen ist Mitglied der Europäischen Union.",
          "translation": "Литва — член Евросоюза.",
          "source": "Tatoeba #540731 @al_ex_an_der / #3297264 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/540731",
          "cefr_level": "A1",
          "word_slugs": [
            "union-noun"
          ]
        }
      ],
