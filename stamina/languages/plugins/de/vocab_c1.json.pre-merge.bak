      "gender": null,
      "examples": [
        {
          "id": "7219150",
          "text": "Das Doppelte von 3 ist 6.",
          "translation": "Дважды три будет шесть.",
          "source": "Tatoeba #7219150 @manese / #7280539 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7219150",
          "cefr_level": "A1",
