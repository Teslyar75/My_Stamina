      },
      "gender": null,
      "examples": [
        {
          "id": "3719650",
          "text": "Wie verbringst du Neujahr?",
          "translation": "Как ты проводишь Новый год?",
          "source": "Tatoeba #3719650 @Pfirsichbaeumchen / #13697311 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3719650",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringst-verb"
          ]
        },
        {
          "id": "2763786",
          "text": "Wie verbringst du deine Freizeit?",
          "translation": "Как ты проводишь свободное время?",
          "source": "Tatoeba #2763786 @raggione / #4953888 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2763786",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringst-verb"
          ]
        },
        {
          "id": "12639638",
          "text": "Verbringst du gern Zeit mit Kindern?",
          "translation": "Ты любишь проводить время с детьми?",
          "source": "Tatoeba #12639638 @Waldelfe / #12639650 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12639638",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringst-verb"
          ]
        },
        {
          "id": "3125338",
          "text": "Du verbringst zu viel Zeit mit ihm.",
          "translation": "Ты проводишь с ним слишком много времени.",
          "source": "Tatoeba #3125338 @freddy1 / #3528936 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3125338",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringst-verb"
          ]
        },
        {
          "id": "1664046",
          "text": "Du verbringst zu viel Zeit am Rechner.",
          "translation": "Ты слишком много времени проводишь за компьютером.",
          "source": "Tatoeba #1664046 @Pfirsichbaeumchen / #4954076 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1664046",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringst-verb"
          ]
        }
