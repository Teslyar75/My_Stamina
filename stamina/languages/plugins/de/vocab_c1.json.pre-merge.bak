    {
      "slug": "elend-adj",
      "lemma": "elend",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5448,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "miserable",
          "wretched",
          "sordid"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2364179",
          "text": "Ich bin elend und arm.",
          "translation": "Я убог и нищ.",
          "source": "Tatoeba #2364179 @al_ex_an_der / #2370465 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2364179",
          "cefr_level": "A1",
          "word_slugs": [
            "elend-adj"
          ]
        },
        {
          "id": "2417616",
          "text": "Ich stöhnte ins Telefon: „Mir ist elend.“",
          "translation": "Я простонал в трубку: \"Мне очень плохо\".",
          "source": "Tatoeba #2417616 @al_ex_an_der / #2417612 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2417616",
          "cefr_level": "A1",
          "word_slugs": [
            "elend-adj"
          ]
        },
        {
          "id": "4248261",
          "text": "Seien wir ehrlich: unser Leben ist elend, mühevoll und kurz.",
          "translation": "Будем честны: наша жизнь жалкая, тяжёлая и короткая.",
          "source": "Tatoeba #4248261 @AqQoyriq_1 / #4248263 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4248261",
          "cefr_level": "A1",
          "word_slugs": [
            "elend-adj"
          ]
        },
        {
          "id": "13808612",
          "text": "Das Wort „Fakir“ stammt aus dem Arabischen und bedeutet „arm, elend, Bettler“.",
          "translation": "Слово «факир» происходит из арабского языка и означает «бедный, несчастный, нищий».",
          "source": "Tatoeba #13808612 @carlosalberto / #13808610 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13808612",
          "cefr_level": "A1",
          "word_slugs": [
            "elend-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der elend",
        "nominative_pl": ""
      }
    },
    {
      "slug": "andauernd-verb",
      "lemma": "andauernd",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5449,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "present participle of andauern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11861013",
          "text": "Er beschwert sich andauernd.",
          "translation": "Он постоянно жалуется.",
          "source": "Tatoeba #11861013 @stickerkleber / #645420 @nami (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11861013",
          "cefr_level": "A1",
          "word_slugs": [
            "andauernd-verb"
          ]
        },
        {
          "id": "5214759",
          "text": "Ich verliere andauernd etwas.",
          "translation": "Я постоянно что-нибудь теряю.",
          "source": "Tatoeba #5214759 @Pfirsichbaeumchen / #6610370 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5214759",
          "cefr_level": "A1",
          "word_slugs": [
            "andauernd-verb"
          ]
        },
        {
          "id": "8592601",
          "text": "Das bekomme ich andauernd zu hören.",
          "translation": "Люди всё время мне это говорят.",
          "source": "Tatoeba #8592601 @Pfirsichbaeumchen / #8592598 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8592601",
          "cefr_level": "A1",
          "word_slugs": [
            "andauernd-verb"
          ]
        },
        {
          "id": "12424200",
          "text": "Die Leute fragen mich das andauernd.",
          "translation": "Люди постоянно меня об этом спрашивают.",
          "source": "Tatoeba #12424200 @brauchinet / #3522562 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12424200",
          "cefr_level": "A1",
          "word_slugs": [
            "andauernd-verb"
          ]
        },
        {
          "id": "9941595",
          "text": "Man kann schon mal was vergessen, aber du vergisst andauernd was.",
          "translation": "Время от времени можно что-то и забыть, но ты забываешь о чём-нибудь постоянно.",
          "source": "Tatoeba #9941595 @Pfirsichbaeumchen / #9994763 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9941595",
          "cefr_level": "A1",
          "word_slugs": [
            "andauernd-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
