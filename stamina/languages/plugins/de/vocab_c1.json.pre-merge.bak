    {
      "slug": "vorgesehen-verb",
      "lemma": "vorgesehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8758,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of vorsehen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2743326",
          "text": "Es ist ein Referendum vorgesehen.",
          "translation": "Планируется референдум.",
          "source": "Tatoeba #2743326 @Zaghawa / #13512075 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2743326",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgesehen-verb"
          ]
        },
        {
          "id": "3674244",
          "text": "Was hast du für den Nachmittag vorgesehen?",
          "translation": "Что у тебя запланировано на послеобеда?",
          "source": "Tatoeba #3674244 @Esperantostern / #3675875 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3674244",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgesehen-verb"
          ]
        },
        {
          "id": "13443696",
          "text": "Der Bus ist für fünfzig Personen vorgesehen.",
          "translation": "Автобус рассчитан на пятьдесят человек.",
          "source": "Tatoeba #13443696 @mhr / #13443353 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13443696",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgesehen-verb"
          ]
        },
        {
          "id": "13053641",
          "text": "Das Spiel ist für fünf- bis sechsjährige Kinder vorgesehen.",
          "translation": "Игра рассчитана на детей пяти-шести лет.",
          "source": "Tatoeba #13053641 @mhr / #13053579 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13053641",
          "cefr_level": "A1",
          "word_slugs": [
            "vorgesehen-verb"
          ]
        },
        {
          "id": "408547",
          "text": "Der Flug 101 aus Paris ist eine Stunde früher als vorgesehen angekommen.",
          "translation": "Самолет 101 из Парижа прибыл на час раньше, чем планировалось.",
          "source": "Tatoeba #408547 @MUIRIEL / #5148542 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/408547",
          "cefr_level": "A1",
