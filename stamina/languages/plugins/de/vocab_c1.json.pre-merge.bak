    {
      "slug": "vorwürfe-noun",
      "lemma": "Vorwürfe",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5742,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Vorwurf"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4482070",
          "text": "Alle machen dir Vorwürfe.",
          "translation": "Все тебя упрекают.",
          "source": "Tatoeba #4482070 @Esperantostern / #4158622 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4482070",
          "cefr_level": "A1",
          "word_slugs": [
            "vorwürfe-noun"
          ]
        },
        {
          "id": "3608670",
          "text": "Hör auf, dir selber Vorwürfe zu machen.",
          "translation": "Хватит себя упрекать.",
          "source": "Tatoeba #3608670 @Jan_Schreiber / #3647139 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3608670",
          "cefr_level": "A1",
          "word_slugs": [
            "vorwürfe-noun"
          ]
        },
        {
          "id": "12088937",
          "text": "Tom machte sich Vorwürfe, nicht früher gehandelt zu haben.",
          "translation": "Том винил себя за то, что не начал действовать раньше.",
          "source": "Tatoeba #12088937 @Pfirsichbaeumchen / #12088927 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12088937",
          "cefr_level": "A1",
          "word_slugs": [
            "vorwürfe-noun"
          ]
        },
        {
          "id": "7533590",
          "text": "Tom und Maria konnten gar nicht aufhören, sich selbst Vorwürfe zu machen.",
          "translation": "Том и Мария были абсолютно неспособны перестать себя винить.",
          "source": "Tatoeba #7533590 @Pfirsichbaeumchen / #7533938 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7533590",
          "cefr_level": "A1",
          "word_slugs": [
            "vorwürfe-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
