    {
      "slug": "unterm-contraction",
      "lemma": "unterm",
      "pos": "contraction",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5750,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "contraction of unter + dem"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3089104",
          "text": "Die Hausschuhe sind unterm Bett.",
          "translation": "Тапочки под кроватью.",
          "source": "Tatoeba #3089104 @raggione / #6301261 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3089104",
          "cefr_level": "A1",
          "word_slugs": [
            "unterm-contraction"
          ]
        },
        {
          "id": "4929049",
          "text": "Hast du jemals unterm Sternenzelt geschlafen?",
          "translation": "Ты когда-нибудь засыпал под звездами?",
          "source": "Tatoeba #4929049 @al_ex_an_der / #4932920 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4929049",
          "cefr_level": "A1",
          "word_slugs": [
            "unterm-contraction"
          ]
        },
        {
          "id": "2328291",
          "text": "Ich habe deine Schlappen unterm Bett gefunden.",
          "translation": "Я нашёл твои тапочки под кроватью.",
          "source": "Tatoeba #2328291 @Pfirsichbaeumchen / #12304671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2328291",
          "cefr_level": "A1",
          "word_slugs": [
            "unterm-contraction"
          ]
        },
        {
          "id": "2034259",
          "text": "Der Hund schlief mit dem Schwanz unterm Bauch.",
          "translation": "Собака спала, поджав хвост под живот.",
          "source": "Tatoeba #2034259 @al_ex_an_der / #12282830 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2034259",
          "cefr_level": "A1",
          "word_slugs": [
            "unterm-contraction"
          ]
        }
      ],
