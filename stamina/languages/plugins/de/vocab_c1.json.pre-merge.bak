        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "909900",
          "text": "Sie will ihn umarmen.",
          "translation": "Она хочет его обнять.",
          "source": "Tatoeba #909900 @Esperantostern / #2143684 @Leonid204 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/909900",
          "cefr_level": "A1",
