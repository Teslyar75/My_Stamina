          ]
        },
        {
          "id": "5959123",
          "text": "Der Oleander benötigt wenig Pflege.",
          "translation": "Олеандр не нуждается в особом уходе.",
          "source": "Tatoeba #5959123 @Adelpa / #11297926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5959123",
