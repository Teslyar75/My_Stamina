          ]
        },
        {
          "id": "3191062",
          "text": "Ich habe vergessen, das Licht auszuschalten.",
          "translation": "Я забыл выключить свет.",
          "source": "Tatoeba #3191062 @Pfirsichbaeumchen / #3190061 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3191062",
          "cefr_level": "A1",
          "word_slugs": [
