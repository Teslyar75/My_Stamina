        "en": [
          "cook, a cooker (female)"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13443225",
          "text": "Ich arbeite als Köchin.",
          "translation": "Я работаю поварихой.",
          "source": "Tatoeba #13443225 @ninefi / #13443234 @ninefi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13443225",
          "cefr_level": "A1",
          "word_slugs": [
            "köchin-noun"
          ]
        },
        {
          "id": "8932442",
          "text": "Sie ist eine gute Köchin.",
          "translation": "Она хорошо готовит.",
          "source": "Tatoeba #8932442 @wolfgangth / #2471372 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8932442",
          "cefr_level": "A1",
          "word_slugs": [
            "köchin-noun"
          ]
        },
        {
          "id": "10498995",
          "text": "Du bist eine gute Köchin.",
          "translation": "Ты хорошая повариха.",
          "source": "Tatoeba #10498995 @Adelpa / #10498998 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10498995",
          "cefr_level": "A1",
          "word_slugs": [
            "köchin-noun"
          ]
        },
        {
          "id": "605296",
          "text": "Sie ist keine gute Köchin.",
          "translation": "Повар из нее никакой.",
          "source": "Tatoeba #605296 @virgil / #9733650 @schwetterling (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/605296",
          "cefr_level": "A1",
          "word_slugs": [
            "köchin-noun"
          ]
        },
        {
          "id": "10178914",
          "text": "Meine Mutter ist eine gute Köchin.",
          "translation": "Моя мама хорошо готовит.",
          "source": "Tatoeba #10178914 @wolfgangth / #6389122 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10178914",
          "cefr_level": "A1",
          "word_slugs": [
            "köchin-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
