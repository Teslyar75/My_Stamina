      "gender": "m",
      "examples": [
        {
          "id": "926104",
          "text": "Du bist sehr elegant.",
          "translation": "Ты очень элегантный.",
          "source": "Tatoeba #926104 @Esperantostern / #3529455 @pgavda (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/926104",
          "cefr_level": "A1",
          "word_slugs": [
