    {
      "slug": "solcher-pron",
      "lemma": "solcher",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5772,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of solch:",
          "strong/mixed nominative masculine singular",
          "inflection of solch:",
          "strong genitive/dative feminine singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5609021",
          "text": "Sei kein solcher Egoist!",
          "translation": "Не будь таким эгоистом.",
          "source": "Tatoeba #5609021 @Pfirsichbaeumchen / #5608985 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5609021",
          "cefr_level": "A1",
          "word_slugs": [
            "solcher-pron"
          ]
        },
        {
          "id": "2195651",
          "text": "Es war ein solcher Schock.",
          "translation": "Это было такое потрясение.",
          "source": "Tatoeba #2195651 @Tamy / #2202200 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2195651",
          "cefr_level": "A1",
          "word_slugs": [
            "solcher-pron"
          ]
        },
        {
          "id": "12595499",
          "text": "Die Anzahl solcher Verbrechen steigt.",
          "translation": "Число таких преступлений растёт.",
          "source": "Tatoeba #12595499 @mhr / #12595477 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12595499",
          "cefr_level": "A1",
          "word_slugs": [
            "solcher-pron"
          ]
        },
        {
          "id": "12595501",
          "text": "Die Anzahl solcher Straftaten steigt.",
          "translation": "Число таких преступлений растёт.",
          "source": "Tatoeba #12595501 @mhr / #12595477 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12595501",
          "cefr_level": "A1",
          "word_slugs": [
            "solcher-pron"
          ]
        },
        {
          "id": "12595502",
          "text": "Die Anzahl solcher Straftaten nimmt zu.",
          "translation": "Число таких преступлений растёт.",
          "source": "Tatoeba #12595502 @mhr / #12595477 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12595502",
          "cefr_level": "A1",
          "word_slugs": [
            "solcher-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
