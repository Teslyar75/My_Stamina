    {
      "slug": "chefs-noun",
      "lemma": "Chefs",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9548,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Chef"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2287666",
          "text": "Er ist der Privatsekretär des Chefs.",
          "translation": "Он личный секретарь директора.",
          "source": "Tatoeba #2287666 @Pfirsichbaeumchen / #2283812 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2287666",
          "cefr_level": "A1",
          "word_slugs": [
            "chefs-noun"
          ]
        },
        {
          "id": "2590955",
          "text": "Ich wurde beschuldigt, das Mittagessen des Chefs verzehrt zu haben.",
          "translation": "Меня обвинили в том, что я съел обед начальника.",
          "source": "Tatoeba #2590955 @Pfirsichbaeumchen / #14077374 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2590955",
          "cefr_level": "A1",
          "word_slugs": [
            "chefs-noun"
          ]
        },
        {
          "id": "2844516",
          "text": "Chefs sind auch nur Menschen — sie wissen es nur nicht.",
          "translation": "Шефы - тоже люди, вот только они этого не знают.",
          "source": "Tatoeba #2844516 @Esperantostern / #2844527 @AqQoyriq (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2844516",
          "cefr_level": "A1",
          "word_slugs": [
            "chefs-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
