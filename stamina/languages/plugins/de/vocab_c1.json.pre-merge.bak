    {
      "slug": "japanischen-adj",
      "lemma": "japanischen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9195,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of japanisch:",
          "strong genitive masculine/neuter singular",
          "inflection of japanisch:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5847735",
          "text": "Tom hat einen japanischen Freund.",
          "translation": "У Тома есть друг-японец.",
          "source": "Tatoeba #5847735 @Esperantostern / #5265973 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5847735",
          "cefr_level": "A1",
          "word_slugs": [
            "japanischen-adj"
          ]
        },
        {
          "id": "3452029",
          "text": "Magst du die japanischen Gerichte?",
          "translation": "Нравятся тебе японские кушанья?",
          "source": "Tatoeba #3452029 @Esperantostern / #3459447 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3452029",
          "cefr_level": "A1",
          "word_slugs": [
            "japanischen-adj"
          ]
        },
        {
          "id": "7851997",
          "text": "Ich habe keine japanischen Freunde.",
          "translation": "У меня нет друзей-японцев.",
          "source": "Tatoeba #7851997 @Pfirsichbaeumchen / #7852016 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7851997",
          "cefr_level": "A1",
          "word_slugs": [
            "japanischen-adj"
          ]
        },
        {
          "id": "12146591",
          "text": "Mein Mann mag die japanischen Autos.",
