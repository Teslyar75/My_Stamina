          ]
        },
        {
          "id": "824583",
          "text": "Es war ein schrecklicher Tag.",
          "translation": "Ужасный был день.",
          "source": "Tatoeba #824583 @al_ex_an_der / #4607973 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/824583",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecklicher-adj"
          ]
        },
        {
          "id": "12426041",
          "text": "Tom war ein schrecklicher Mann.",
          "translation": "Том был ужасным мужем.",
          "source": "Tatoeba #12426041 @Rovo / #5104476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12426041",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecklicher-adj"
          ]
        },
        {
          "id": "3516994",
          "text": "Tom ist in schrecklicher Gefahr.",
          "translation": "Том в ужасной опасности.",
          "source": "Tatoeba #3516994 @Pfirsichbaeumchen / #3515788 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3516994",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecklicher-adj"
          ]
        },
        {
          "id": "663494",
          "text": "Das war ein schrecklicher Unfall.",
          "translation": "Это была ужасная авария.",
          "source": "Tatoeba #663494 @Pfirsichbaeumchen / #5894564 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/663494",
          "cefr_level": "A1",
          "word_slugs": [
            "schrecklicher-adj"
          ]
        }
      ],
      "tags": [
