    {
      "slug": "ohnmacht-noun",
      "lemma": "Ohnmacht",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9956,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "обморок",
          "бессилие"
        ],
        "en": [
          "faint, fainting",
          "powerlessness, helplessness"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1692647",
          "text": "Tom fiel in Ohnmacht.",
          "translation": "Том упал в обморок.",
          "source": "Tatoeba #1692647 @Pfirsichbaeumchen / #2898057 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1692647",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnmacht-noun"
          ]
        },
        {
          "id": "6001531",
          "text": "Er war einer Ohnmacht nahe.",
          "translation": "Он был близок к обмороку.",
          "source": "Tatoeba #6001531 @raggione / #6874591 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6001531",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnmacht-noun"
          ]
        },
        {
          "id": "9411020",
          "text": "Sie wäre beinahe in Ohnmacht gefallen.",
          "translation": "Она чуть не упала в обморок.",
          "source": "Tatoeba #9411020 @Pfirsichbaeumchen / #2821813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9411020",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnmacht-noun"
          ]
        },
        {
          "id": "13112703",
          "text": "Mich überkommt ein Gefühl der Ohnmacht.",
          "translation": "Меня переполняет чувство бессилия.",
          "source": "Tatoeba #13112703 @mhr / #13112523 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13112703",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnmacht-noun"
          ]
        },
        {
          "id": "7012076",
          "text": "Maria wäre beinahe in Ohnmacht gefallen.",
          "translation": "Мэри чуть не упала в обморок.",
          "source": "Tatoeba #7012076 @Pfirsichbaeumchen / #6740412 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7012076",
          "cefr_level": "A1",
          "word_slugs": [
            "ohnmacht-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Ohnmacht",
        "nominative_pl": ""
      }
