    {
      "slug": "träumst-verb",
      "lemma": "träumst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9213,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of träumen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5882998",
          "text": "Was träumst du?",
          "translation": "О чём ты мечтаешь?",
          "source": "Tatoeba #5882998 @Pfirsichbaeumchen / #5735164 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5882998",
          "cefr_level": "A1",
          "word_slugs": [
            "träumst-verb"
          ]
        },
        {
          "id": "2451798",
          "text": "Träumst du auf Französisch?",
          "translation": "Тебе снятся сны на французском?",
          "source": "Tatoeba #2451798 @Pfirsichbaeumchen / #11131296 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2451798",
          "cefr_level": "A1",
          "word_slugs": [
            "träumst-verb"
          ]
        },
        {
          "id": "2341281",
          "text": "Du träumst davon, Millionär zu werden.",
          "translation": "Ты мечтаешь стать миллионером.",
          "source": "Tatoeba #2341281 @Pfirsichbaeumchen / #2498805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2341281",
          "cefr_level": "A1",
          "word_slugs": [
            "träumst-verb"
          ]
        },
        {
          "id": "4543874",
          "text": "Träumst du ab und zu auch in Esperanto?",
          "translation": "Тебе тоже время от времени снятся сны на эсперанто?",
          "source": "Tatoeba #4543874 @Esperantostern / #13600959 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4543874",
          "cefr_level": "A1",
          "word_slugs": [
            "träumst-verb"
          ]
        },
        {
          "id": "1423811",
          "text": "Träumst du im Schlaf auch schon auf Esperanto?",
          "translation": "А сны тебе тоже уже на эсперанто снятся?",
          "source": "Tatoeba #1423811 @Esperantostern / #2152948 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1423811",
          "cefr_level": "A1",
          "word_slugs": [
            "träumst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
