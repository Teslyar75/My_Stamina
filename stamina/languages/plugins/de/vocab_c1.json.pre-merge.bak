    {
      "slug": "treibst-verb",
      "lemma": "treibst",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5215,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "second-person singular present of treiben"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1823156",
          "text": "Was treibst du hier?",
          "translation": "Что ты здесь делаешь?",
          "source": "Tatoeba #1823156 @Pfirsichbaeumchen / #466803 @Aqn (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1823156",
          "cefr_level": "A1",
          "word_slugs": [
            "treibst-verb"
          ]
        },
        {
          "id": "631430",
          "text": "Treibst du gern Sport?",
          "translation": "Ты любишь заниматься спортом?",
          "source": "Tatoeba #631430 @kolonjano / #6909487 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/631430",
          "cefr_level": "A1",
          "word_slugs": [
            "treibst-verb"
          ]
        },
        {
          "id": "1208003",
          "text": "Treibst du irgendwelchen Sport?",
          "translation": "Ты занимаешься каким-нибудь видом спорта?",
          "source": "Tatoeba #1208003 @samueldora / #4849209 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1208003",
          "cefr_level": "A1",
          "word_slugs": [
            "treibst-verb"
          ]
        },
        {
          "id": "8232408",
          "text": "Warum treibst du keinen Sport?",
          "translation": "Почему ты не занимаешься спортом?",
          "source": "Tatoeba #8232408 @Pfirsichbaeumchen / #6914884 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8232408",
          "cefr_level": "A1",
          "word_slugs": [
            "treibst-verb"
          ]
        },
        {
          "id": "10107003",
          "text": "Mit solchen wie ihm treibst du dich besser nicht herum.",
          "translation": "Не стоит тебе общаться с такими, как он.",
          "source": "Tatoeba #10107003 @Pfirsichbaeumchen / #8157869 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10107003",
          "cefr_level": "A1",
          "word_slugs": [
            "treibst-verb"
          ]
        }
      ],
      "tags": [
