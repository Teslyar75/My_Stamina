          ]
        },
        {
          "id": "13080858",
          "text": "Der Aufsatz war kurz und präzise.",
          "translation": "Эссе было кратким и точным.",
          "source": "Tatoeba #13080858 @mhr / #13080813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13080858",
          "cefr_level": "A1",
          "word_slugs": [
            "aufsatz-noun"
          ]
        },
        {
          "id": "13080862",
          "text": "Der Aufsatz war knapp und präzise.",
          "translation": "Эссе было кратким и точным.",
          "source": "Tatoeba #13080862 @mhr / #13080813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13080862",
          "cefr_level": "A1",
          "word_slugs": [
