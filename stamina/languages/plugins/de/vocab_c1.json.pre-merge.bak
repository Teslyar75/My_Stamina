      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to turn out well, to work out, to go smoothly, to succeed, to come off"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8728420",
          "text": "Wird es mir gelingen?",
          "translation": "Мне это удастся?",
          "source": "Tatoeba #8728420 @Yorwba / #8728423 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8728420",
          "cefr_level": "A1",
          "word_slugs": [
            "gelingen-verb"
          ]
        },
        {
          "id": "12174617",
          "text": "Es wird ihm gelingen.",
          "translation": "У него получится.",
          "source": "Tatoeba #12174617 @mhr / #4976619 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12174617",
          "cefr_level": "A1",
          "word_slugs": [
            "gelingen-verb"
          ]
        },
        {
          "id": "12174619",
          "text": "Es wird ihr gelingen.",
          "translation": "У неё получится.",
          "source": "Tatoeba #12174619 @mhr / #4976514 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12174619",
          "cefr_level": "A1",
          "word_slugs": [
            "gelingen-verb"
          ]
        },
        {
          "id": "13604673",
          "text": "Es wird nicht gelingen.",
          "translation": "Ничего не получится.",
          "source": "Tatoeba #13604673 @mhr / #1724685 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13604673",
          "cefr_level": "A1",
          "word_slugs": [
            "gelingen-verb"
          ]
        },
        {
          "id": "13604672",
          "text": "Das wird nicht gelingen.",
          "translation": "Ничего не получится.",
          "source": "Tatoeba #13604672 @mhr / #1724685 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13604672",
          "cefr_level": "A1",
          "word_slugs": [
