        {
          "id": "683003",
          "text": "Millionen von wilden Tieren leben in Alaska.",
          "translation": "Миллионы диких животных живут на Аляске.",
          "source": "Tatoeba #683003 @Pfirsichbaeumchen / #1221869 @sascha (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/683003",
          "cefr_level": "A1",
          "word_slugs": [
            "tieren-noun"
          ]
        },
        {
          "id": "9149854",
          "text": "Nilpferde gehören zu den gefährlichsten Tieren Afrikas.",
          "translation": "Гиппопотамы - одни из самых опасных животных Африки.",
          "source": "Tatoeba #9149854 @Pfirsichbaeumchen / #4684659 @villard85 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9149854",
          "cefr_level": "A1",
          "word_slugs": [
            "tieren-noun"
          ]
        },
        {
          "id": "13332689",
          "text": "Ihn interessiert alles, was mit Tieren zu tun hat.",
          "translation": "Ему интересно всё, что касается животных.",
          "source": "Tatoeba #13332689 @Waldelfe / #13332666 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13332689",
          "cefr_level": "A1",
          "word_slugs": [
            "tieren-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
