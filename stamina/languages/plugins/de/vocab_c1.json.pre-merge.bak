      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a male given name from Latin [in turn from Ancient Greek, in turn from Hebrew], feminine equivalent Gabriele, equivalent to English Gabriel",
          "a male given name from Latin [in turn from Ancient Greek, in turn from Hebrew], feminine equivalent Gabriele, equivalent to English Gabriel",
          "Gabriel (archangel)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13449974",
          "text": "Ich bin Erzengel Gabriel.",
          "translation": "Я архангел Гавриил.",
          "source": "Tatoeba #13449974 @noog / #13449993 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13449974",
          "cefr_level": "A1",
          "word_slugs": [
            "gabriel-name"
          ]
        },
        {
          "id": "13050556",
          "text": "Der Erzengel Gabriel spricht zu mir.",
          "translation": "Со мной говорит архангел Гавриил.",
          "source": "Tatoeba #13050556 @Rovo / #13527740 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13050556",
          "cefr_level": "A1",
          "word_slugs": [
            "gabriel-name"
          ]
        },
        {
          "id": "12454862",
          "text": "Gabriel beschloß, sein Glück zu versuchen.",
          "translation": "Габриэль решил попытать счастья.",
          "source": "Tatoeba #12454862 @Waldelfe / #12454865 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12454862",
          "cefr_level": "A1",
          "word_slugs": [
            "gabriel-name"
          ]
        },
        {
          "id": "1144014",
          "text": "Gabriel ist nur einer der Engel Gottes.",
          "translation": "Гавриил — лишь один из ангелов Бога.",
          "source": "Tatoeba #1144014 @Rovo / #609925 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1144014",
          "cefr_level": "A1",
          "word_slugs": [
            "gabriel-name"
          ]
        }
      ],
