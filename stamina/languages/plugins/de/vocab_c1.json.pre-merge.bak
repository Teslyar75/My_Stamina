    {
      "slug": "empfange-verb",
      "lemma": "empfange",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7307,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of empfangen:",
          "first-person singular present",
          "inflection of empfangen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4908361",
          "text": "Ich gebe lieber Geschenke, als dass ich welche empfange.",
          "translation": "Я больше люблю дарить подарки, чем их получать.",
          "source": "Tatoeba #4908361 @Pfirsichbaeumchen / #4908357 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4908361",
          "cefr_level": "A1",
          "word_slugs": [
            "empfange-verb"
          ]
        },
        {
          "id": "12227433",
          "text": "Ich bin nicht gerne Gast, noch empfange ich gerne Gäste.",
          "translation": "Я не люблю ни ходить в гости, ни принимать гостей.",
          "source": "Tatoeba #12227433 @Pfirsichbaeumchen / #12224809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12227433",
          "cefr_level": "A1",
          "word_slugs": [
            "empfange-verb"
          ]
        },
        {
          "id": "12227434",
          "text": "Weder bin ich gerne Gast, noch empfange ich gerne Gäste.",
          "translation": "Я не люблю ни ходить в гости, ни принимать гостей.",
          "source": "Tatoeba #12227434 @Pfirsichbaeumchen / #12224809 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12227434",
          "cefr_level": "A1",
          "word_slugs": [
            "empfange-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
