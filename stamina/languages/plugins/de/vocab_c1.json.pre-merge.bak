          ]
        },
        {
          "id": "341714",
          "text": "Das Wetter ist ideal für ein Picknick.",
          "translation": "Это идеальная погода для пикника.",
          "source": "Tatoeba #341714 @MUIRIEL / #882181 @aleph (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/341714",
          "cefr_level": "A1",
          "word_slugs": [
            "picknick-noun"
          ]
        },
        {
          "id": "1797087",
