    {
      "slug": "flut-noun",
      "lemma": "Flut",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8262,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "прилив"
        ],
        "en": [
          "flow, flood, high tide (rising movement of the tide; the time around when it reaches its peak)",
          "flood(s), great masses of water, usually of the sea",
          "flooding, flood, overflow of a body of water; usually only when very violent and disastrous"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13404527",
          "text": "Die Flut beginnt.",
          "translation": "Начинается прилив.",
          "source": "Tatoeba #13404527 @mhr / #13166181 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13404527",
          "cefr_level": "A1",
          "word_slugs": [
            "flut-noun"
          ]
        },
        {
          "id": "14009381",
          "text": "Die Brücke wurde von der Flut weggerissen.",
          "translation": "Мост унесло наводнением.",
          "source": "Tatoeba #14009381 @mhr / #14009328 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14009381",
          "cefr_level": "A1",
          "word_slugs": [
            "flut-noun"
          ]
        },
        {
          "id": "14009382",
          "text": "Die Brücke wurde von der Flut fortgerissen.",
          "translation": "Мост унесло наводнением.",
          "source": "Tatoeba #14009382 @mhr / #14009328 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14009382",
          "cefr_level": "A1",
          "word_slugs": [
            "flut-noun"
          ]
        },
        {
          "id": "14009384",
          "text": "Die Brücke ist von der Flut fortgerissen worden.",
          "translation": "Мост унесло наводнением.",
          "source": "Tatoeba #14009384 @mhr / #14009328 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14009384",
          "cefr_level": "A1",
          "word_slugs": [
            "flut-noun"
          ]
        },
        {
          "id": "4709148",
          "text": "Mehr als hundert Häuser wurden von der Flut beschädigt.",
          "translation": "Более ста домов пострадало от наводнения.",
          "source": "Tatoeba #4709148 @bonny37 / #4709319 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4709148",
          "cefr_level": "A1",
          "word_slugs": [
            "flut-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
