        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11567631",
          "text": "Ich stimme Schorschs Analyse zu.",
          "translation": "Я согласна с анализом Жоры.",
          "source": "Tatoeba #11567631 @Pfirsichbaeumchen / #11568026 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11567631",
          "cefr_level": "A1",
          "word_slugs": [
            "analyse-noun"
          ]
        },
        {
          "id": "13998178",
          "text": "Das Problem erfordert eine sorgfältige Analyse.",
          "translation": "Проблема требует серьёзного анализа.",
          "source": "Tatoeba #13998178 @mhr / #13998168 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13998178",
          "cefr_level": "A1",
          "word_slugs": [
            "analyse-noun"
          ]
        },
        {
          "id": "12983019",
          "text": "Man müsste eine vergleichende Analyse der Resultate erstellen.",
          "translation": "Пришлось бы выполнить сравнительный анализ результатов.",
          "source": "Tatoeba #12983019 @mhr / #12982823 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12983019",
          "cefr_level": "A1",
          "word_slugs": [
            "analyse-noun"
          ]
        }
      ],
