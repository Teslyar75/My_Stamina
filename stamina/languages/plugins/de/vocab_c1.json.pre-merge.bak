    {
      "slug": "note-noun",
      "lemma": "Note",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8129,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "нота"
        ],
        "en": [
          "note (character indicating the length and pitch of a tone)",
          "note",
          "grade, mark"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3741873",
          "text": "Ich habe eine schlechte Note bekommen.",
          "translation": "Я получил плохую оценку.",
          "source": "Tatoeba #3741873 @raggione / #6149319 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3741873",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        },
        {
          "id": "363363",
          "text": "Er bekommt bestenfalls eine durchschnittliche Note.",
          "translation": "Он получает, в лучшем случае, средний балл.",
          "source": "Tatoeba #363363 @Wolf / #4936217 @Helginka (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/363363",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        },
        {
          "id": "8384257",
          "text": "Er hat eine sehr schlechte Note bekommen.",
          "translation": "Он получил очень плохую оценку.",
          "source": "Tatoeba #8384257 @felix63 / #8397300 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8384257",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        },
        {
          "id": "351821",
          "text": "Er hat eine gute Note in Mathematik bekommen.",
          "translation": "Он получил хорошую оценку по математике.",
          "source": "Tatoeba #351821 @MUIRIEL / #2005460 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/351821",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        },
        {
          "id": "10258393",
          "text": "In der Oper steht jede gesungene Note für ein unaussprechliches Gefühl.",
          "translation": "В опере каждая спетая нота выражает чувство, которое невозможно передать словами.",
          "source": "Tatoeba #10258393 @Yorwba / #10259950 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10258393",
          "cefr_level": "A1",
          "word_slugs": [
            "note-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
