    {
      "slug": "zueinander-adv",
      "lemma": "zueinander",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6355,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "together",
          "to each other, to one another"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1399866",
          "text": "Sie passen zueinander.",
          "translation": "Они подходят друг другу.",
          "source": "Tatoeba #1399866 @enteka / #8193758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1399866",
          "cefr_level": "A1",
          "word_slugs": [
            "zueinander-adv"
          ]
        },
        {
          "id": "3520489",
          "text": "Seid höflich zueinander!",
          "translation": "Будьте взаимно вежливы!",
          "source": "Tatoeba #3520489 @al_ex_an_der / #3520487 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3520489",
          "cefr_level": "A1",
          "word_slugs": [
            "zueinander-adv"
          ]
        },
        {
          "id": "2289438",
          "text": "Die Farben passen gut zueinander.",
          "translation": "Эти цвета хорошо сочетаются друг с другом.",
          "source": "Tatoeba #2289438 @Pfirsichbaeumchen / #8444900 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2289438",
          "cefr_level": "A1",
          "word_slugs": [
            "zueinander-adv"
          ]
        },
        {
          "id": "1984778",
          "text": "Diese Farben passen nicht zueinander.",
          "translation": "Эти цвета друг с другом не сочетаются.",
          "source": "Tatoeba #1984778 @Tamy / #11088529 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1984778",
          "cefr_level": "A1",
          "word_slugs": [
            "zueinander-adv"
          ]
        },
        {
          "id": "3022940",
          "text": "Tom und Maria scheinen zueinander zu passen.",
          "translation": "Похоже, Том и Мэри подходят друг другу.",
          "source": "Tatoeba #3022940 @Pfirsichbaeumchen / #3022985 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3022940",
          "cefr_level": "A1",
          "word_slugs": [
            "zueinander-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
