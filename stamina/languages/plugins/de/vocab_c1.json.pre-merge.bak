      },
      "gender": null,
      "examples": [
        {
          "id": "1204583",
          "text": "Sie trugen alle Uniformen.",
          "translation": "Они все были одеты в униформу.",
          "source": "Tatoeba #1204583 @samueldora / #2677745 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1204583",
          "cefr_level": "A1",
          "word_slugs": [
            "uniformen-noun"
          ]
        },
        {
          "id": "5064073",
          "text": "Sie tragen alle Uniformen.",
          "translation": "Они все в униформе.",
          "source": "Tatoeba #5064073 @dispy / #5058618 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5064073",
          "cefr_level": "A1",
          "word_slugs": [
            "uniformen-noun"
          ]
        },
        {
          "id": "365629",
          "text": "An unserer Schule tragen wir Uniformen.",
          "translation": "В нашей школе мы носим форму.",
