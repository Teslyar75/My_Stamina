    {
      "slug": "begrüsse-verb",
      "lemma": "begrüße",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9595,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of begrüssen:",
          "first-person singular present",
          "inflection of begrüssen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3657526",
          "text": "Ich begrüße Sie.",
          "translation": "Я приветствую вас.",
          "source": "Tatoeba #3657526 @al_ex_an_der / #3657524 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3657526",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsse-verb"
          ]
        },
        {
          "id": "3657525",
          "text": "Ich begrüße euch.",
          "translation": "Я приветствую вас.",
          "source": "Tatoeba #3657525 @al_ex_an_der / #3657524 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3657525",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsse-verb"
          ]
        },
        {
          "id": "2871199",
          "text": "Auch ich begrüße dich herzlich bei Tatoeba.",
          "translation": "Я тоже сердечно приветствую тебя на Татоэбе.",
          "source": "Tatoeba #2871199 @al_ex_an_der / #2871198 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2871199",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsse-verb"
          ]
        },
        {
          "id": "3087407",
          "text": "Land der Freiheit, Land der Zukunft, ich begrüße dich!",
          "translation": "Земля свободы, земля будущего, приветствую тебя.",
          "source": "Tatoeba #3087407 @Pfirsichbaeumchen / #1482447 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3087407",
          "cefr_level": "A1",
          "word_slugs": [
            "begrüsse-verb"
          ]
        }
      ],
