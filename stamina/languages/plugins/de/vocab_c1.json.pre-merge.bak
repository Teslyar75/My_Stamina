      "gender": null,
      "examples": [
        {
          "id": "12438142",
          "text": "Wir haben ähnliche Namen.",
          "translation": "У нас похожие имена.",
          "source": "Tatoeba #12438142 @mhr / #12438126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12438142",
          "cefr_level": "A1",
          "word_slugs": [
