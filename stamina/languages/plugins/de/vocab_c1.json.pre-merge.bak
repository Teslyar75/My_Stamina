          ]
        },
        {
          "id": "12564246",
          "text": "Ihr schuldet uns nichts.",
          "translation": "Вы ничего нам не должны.",
          "source": "Tatoeba #12564246 @Waldelfe / #4605473 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12564246",
          "cefr_level": "A1",
          "word_slugs": [
            "schuldet-verb"
          ]
        },
        {
          "id": "10090423",
          "text": "Tom schuldet mir 3000 Taler.",
