    {
      "slug": "rechtfertigen-verb",
      "lemma": "rechtfertigen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7322,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "оправдывать"
        ],
        "en": [
          "to justify, to defend (a chosen course of action or behavior; of a person)",
          "to justify, to vindicate (a chosen course of action or behavior; of circumstances)",
          "to justify one's behavior, to defend one's actions"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10349363",
          "text": "Sie müssen ihre Existenz irgendwie rechtfertigen.",
          "translation": "Они должны как-то оправдать своё существование.",
          "source": "Tatoeba #10349363 @kotik / #10349365 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10349363",
          "cefr_level": "A1",
          "word_slugs": [
            "rechtfertigen-verb"
          ]
        },
        {
          "id": "7323299",
          "text": "Dein Verhalten ist durch nichts zu rechtfertigen.",
          "translation": "Твоё поведение ничем не может быть оправдано.",
          "source": "Tatoeba #7323299 @brauchinet / #7323584 @Rotor_AU (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7323299",
          "cefr_level": "A1",
          "word_slugs": [
            "rechtfertigen-verb"
          ]
        },
        {
          "id": "13038195",
          "text": "Diese Bombardierung lässt sich nicht mit militärischer Notwendigkeit rechtfertigen.",
          "translation": "Эту бомбардировку нельзя оправдать военной необходимостью.",
          "source": "Tatoeba #13038195 @mhr / #13038165 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13038195",
          "cefr_level": "A1",
          "word_slugs": [
            "rechtfertigen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "belügen-verb",
      "lemma": "belügen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7323,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to lie to, to tell someone a lie, to tell someone lies"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3608847",
          "text": "Sie belügen uns.",
          "translation": "Они нам лгут.",
          "source": "Tatoeba #3608847 @Jan_Schreiber / #5500245 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3608847",
          "cefr_level": "A1",
          "word_slugs": [
            "belügen-verb"
          ]
        },
        {
          "id": "13341330",
          "text": "Belügen wir uns nie!",
          "translation": "Давай не будем никогда друг другу врать.",
          "source": "Tatoeba #13341330 @Waldelfe / #13341220 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13341330",
          "cefr_level": "A1",
          "word_slugs": [
            "belügen-verb"
          ]
        },
        {
          "id": "3283445",
          "text": "Hör auf, mich zu belügen!",
          "translation": "Перестань мне врать.",
          "source": "Tatoeba #3283445 @Pfirsichbaeumchen / #3477427 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3283445",
          "cefr_level": "A1",
          "word_slugs": [
            "belügen-verb"
          ]
        },
        {
          "id": "2438831",
          "text": "Er würde mich nie belügen.",
          "translation": "Он бы никогда мне не соврал.",
          "source": "Tatoeba #2438831 @Pfirsichbaeumchen / #4973657 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2438831",
          "cefr_level": "A1",
          "word_slugs": [
            "belügen-verb"
          ]
        },
        {
          "id": "13341327",
          "text": "Wir wollen uns nie belügen!",
          "translation": "Давай не будем никогда друг другу врать.",
          "source": "Tatoeba #13341327 @Waldelfe / #13341220 @amanshi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13341327",
          "cefr_level": "A1",
          "word_slugs": [
            "belügen-verb"
          ]
        }
