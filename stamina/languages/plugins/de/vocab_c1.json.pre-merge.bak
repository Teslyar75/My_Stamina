          ]
        },
        {
          "id": "8842538",
          "text": "Er stiehlt Sachen.",
          "translation": "Он ворует вещи.",
          "source": "Tatoeba #8842538 @wolfgangth / #13487128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8842538",
          "cefr_level": "A1",
          "word_slugs": [
            "stiehlt-verb"
          ]
        },
        {
          "id": "9679911",
          "text": "Warum stiehlt Tom?",
          "translation": "Почему Том крадёт?",
          "source": "Tatoeba #9679911 @felix63 / #11309749 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9679911",
