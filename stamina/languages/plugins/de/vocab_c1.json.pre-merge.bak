      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "тормозить"
        ],
        "en": [
          "to brake, slow down, decelerate"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4924976",
          "text": "Statt zu bremsen, gab ich Gas.",
          "translation": "Вместо того чтобы затормозить, я дал газу.",
          "source": "Tatoeba #4924976 @al_ex_an_der / #4924984 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4924976",
          "cefr_level": "A1",
          "word_slugs": [
            "bremsen-verb"
          ]
        },
        {
          "id": "3567783",
          "text": "Warum wollen Sie den Prozess der Integration Europas bremsen?",
          "translation": "Почему вы хотите затормозить процесс европейской интеграции?",
          "source": "Tatoeba #3567783 @al_ex_an_der / #3567936 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3567783",
          "cefr_level": "A1",
          "word_slugs": [
            "bremsen-verb"
          ]
        },
        {
          "id": "3567793",
          "text": "Warum wollen Sie den Prozess der europäischen Integration bremsen?",
          "translation": "Почему вы хотите затормозить процесс европейской интеграции?",
          "source": "Tatoeba #3567793 @al_ex_an_der / #3567936 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3567793",
          "cefr_level": "A1",
