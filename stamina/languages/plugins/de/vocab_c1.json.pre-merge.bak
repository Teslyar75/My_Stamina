    {
      "slug": "psychologie-noun",
      "lemma": "Psychologie",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9797,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "psychology"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1927089",
          "text": "Ich studiere Psychologie.",
          "translation": "Я изучаю психологию.",
          "source": "Tatoeba #1927089 @Tamy / #5233962 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1927089",
          "cefr_level": "A1",
          "word_slugs": [
            "psychologie-noun"
          ]
        },
        {
          "id": "1538151",
          "text": "Mein Hauptfach war Psychologie.",
          "translation": "Моим основным предметом была психология.",
          "source": "Tatoeba #1538151 @al_ex_an_der / #11486508 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1538151",
          "cefr_level": "A1",
          "word_slugs": [
            "psychologie-noun"
          ]
        },
        {
          "id": "1925547",
          "text": "Meine Mutter unterrichtet Psychologie.",
          "translation": "Моя мать преподаёт психологию.",
          "source": "Tatoeba #1925547 @Tamy / #5014172 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1925547",
          "cefr_level": "A1",
          "word_slugs": [
            "psychologie-noun"
          ]
        },
        {
          "id": "1629569",
          "text": "Die Psychologie ist eine empirische Wissenschaft.",
          "translation": "Психология - эмпирическая наука.",
          "source": "Tatoeba #1629569 @al_ex_an_der / #3807218 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1629569",
          "cefr_level": "A1",
          "word_slugs": [
            "psychologie-noun"
          ]
        },
        {
          "id": "3125480",
          "text": "Wenn Sie Psychologie studieren, dann werden Sie noch schneller noch unglücklicher werden.",
          "translation": "Если вы будете изучать психологию, вы станете несчастнее еще быстрее.",
          "source": "Tatoeba #3125480 @al_ex_an_der / #11066366 @Almi92 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3125480",
          "cefr_level": "A1",
          "word_slugs": [
            "psychologie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "zwing-verb",
      "lemma": "zwing",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9798,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "singular imperative of zwingen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12487918",
          "text": "Zwing mich nicht zu tanzen!",
          "translation": "Не заставляй меня танцевать.",
          "source": "Tatoeba #12487918 @Waldelfe / #8716178 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12487918",
          "cefr_level": "A1",
          "word_slugs": [
            "zwing-verb"
          ]
        },
        {
          "id": "3292615",
          "text": "Zwing mich nicht das zu tun!",
          "translation": "Не заставляй меня это делать!",
          "source": "Tatoeba #3292615 @freddy1 / #3292634 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3292615",
          "cefr_level": "A1",
          "word_slugs": [
            "zwing-verb"
          ]
        },
        {
          "id": "7803246",
          "text": "Zwing mich nicht, das zu essen!",
          "translation": "Не заставляй меня это есть.",
          "source": "Tatoeba #7803246 @Pfirsichbaeumchen / #8716189 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7803246",
          "cefr_level": "A1",
          "word_slugs": [
            "zwing-verb"
          ]
        },
        {
          "id": "7830093",
          "text": "Bitte zwing mich nicht, dahin zu gehen!",
          "translation": "Не заставляй меня туда ходить, пожалуйста.",
          "source": "Tatoeba #7830093 @Pfirsichbaeumchen / #7829976 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7830093",
          "cefr_level": "A1",
          "word_slugs": [
            "zwing-verb"
          ]
        },
        {
          "id": "2782887",
          "text": "Zwing mich nicht, diese Frage zu beantworten!",
          "translation": "Не заставляй меня отвечать на этот вопрос!",
          "source": "Tatoeba #2782887 @Pfirsichbaeumchen / #2782881 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2782887",
          "cefr_level": "A1",
          "word_slugs": [
            "zwing-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
