    {
      "slug": "spinnen-verb",
      "lemma": "spinnen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6597,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "прясть",
          "ткать"
        ],
        "en": [
          "to spin (a thread, a web, a cocoon, etc.)",
          "to develop, extend (a thought, story, etc.)",
          "to exaggerate (an event), to fabricate (something untrue)",
          "to act or talk strangely, foolishly, (of a machine also) to malfunction"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "427301",
          "text": "Spinnen spinnen Netze.",
          "translation": "Пауки плетут паутину.",
