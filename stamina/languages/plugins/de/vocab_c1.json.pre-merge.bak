          ]
        },
        {
          "id": "2160226",
          "text": "Den Planeten regieren kybernetische Organismen.",
          "translation": "Планета управляется киборгами.",
          "source": "Tatoeba #2160226 @al_ex_an_der / #2160211 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2160226",
