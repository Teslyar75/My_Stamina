    {
      "slug": "teilweise-adv",
      "lemma": "teilweise",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9153,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "partially, to some extent",
          "sometimes, occasionally",
          "in part, in some cases"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13574940",
          "text": "Teilweise hat er recht.",
          "translation": "Отчасти он прав.",
          "source": "Tatoeba #13574940 @mhr / #13574900 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13574940",
          "cefr_level": "A1",
          "word_slugs": [
            "teilweise-adv"
          ]
        },
        {
          "id": "2984876",
          "text": "Sie hat teilweise recht.",
          "translation": "Она отчасти права.",
          "source": "Tatoeba #2984876 @al_ex_an_der / #13806424 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2984876",
          "cefr_level": "A1",
          "word_slugs": [
            "teilweise-adv"
          ]
        },
        {
          "id": "2929585",
          "text": "Hier ist ein teilweise ähnlicher Satz.",
          "translation": "Вот частично похожее предложение.",
          "source": "Tatoeba #2929585 @al_ex_an_der / #8601934 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2929585",
          "cefr_level": "A1",
          "word_slugs": [
            "teilweise-adv"
          ]
        },
        {
          "id": "813184",
          "text": "Verkommene Subjekte bevölkern teilweise auch Wahllokale.",
          "translation": "И на избирательных участках встречаются иногда опустившиеся люди.",
          "source": "Tatoeba #813184 @BraveSentry / #3235020 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/813184",
          "cefr_level": "A1",
          "word_slugs": [
            "teilweise-adv"
          ]
        },
        {
          "id": "11160350",
          "text": "Ich glaube, du hast zumindest teilweise Recht.",
          "translation": "Думаю, ты по крайней мере частично прав.",
          "source": "Tatoeba #11160350 @Ooneykcall / #11160353 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11160350",
          "cefr_level": "A1",
