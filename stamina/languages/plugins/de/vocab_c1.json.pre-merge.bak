    {
      "slug": "feinden-noun",
      "lemma": "Feinden",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8455,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "dative plural of Feind"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2119263",
          "text": "Wir sind von Feinden umgeben.",
          "translation": "Мы окружены врагами.",
          "source": "Tatoeba #2119263 @al_ex_an_der / #2119261 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2119263",
          "cefr_level": "A1",
          "word_slugs": [
            "feinden-noun"
          ]
        },
        {
          "id": "12175537",
          "text": "Die Politik hat uns zu Feinden gemacht.",
          "translation": "Политика сделала нас врагами.",
          "source": "Tatoeba #12175537 @Adelpa / #12175594 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12175537",
          "cefr_level": "A1",
          "word_slugs": [
            "feinden-noun"
          ]
        },
        {
          "id": "2291975",
          "text": "Vergib Deinen Feinden, aber vergiss niemals ihre Namen.",
          "translation": "Прощай врагам своим, но никогда не забывай их имена!",
          "source": "Tatoeba #2291975 @Esperantostern / #4434385 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2291975",
          "cefr_level": "A1",
          "word_slugs": [
            "feinden-noun"
          ]
        },
        {
          "id": "2766290",
          "text": "Vergib deinen Feinden, doch vergiss nicht, wie sie heißen!",
          "translation": "Прости своих врагов, но не забывай их имён.",
          "source": "Tatoeba #2766290 @Pfirsichbaeumchen / #2766288 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2766290",
          "cefr_level": "A1",
          "word_slugs": [
            "feinden-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
