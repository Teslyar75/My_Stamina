          ]
        },
        {
          "id": "1795670",
          "text": "Der Plan funktionierte gut.",
          "translation": "План отлично сработал.",
          "source": "Tatoeba #1795670 @Esperantostern / #7834847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1795670",
          "cefr_level": "A1",
          "word_slugs": [
            "funktionierte-verb"
          ]
        },
        {
          "id": "3019940",
          "text": "Die Bremse funktionierte nicht.",
          "translation": "Тормоз не сработал.",
          "source": "Tatoeba #3019940 @Pfirsichbaeumchen / #3065067 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3019940",
          "cefr_level": "A1",
          "word_slugs": [
            "funktionierte-verb"
          ]
        },
        {
          "id": "6595968",
          "text": "Meine Heizung funktionierte nicht.",
          "translation": "У меня отопление не работало.",
          "source": "Tatoeba #6595968 @brauchinet / #12933794 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6595968",
          "cefr_level": "A1",
          "word_slugs": [
            "funktionierte-verb"
          ]
        },
        {
