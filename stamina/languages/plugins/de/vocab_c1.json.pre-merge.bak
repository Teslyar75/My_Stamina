      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Hong Kong (a city, island and special administrative region in southeastern China)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2059346",
          "text": "Ich bin gerade in Hongkong.",
          "translation": "Я сейчас в Гонконге.",
          "source": "Tatoeba #2059346 @Tamy / #2053050 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2059346",
          "cefr_level": "A1",
          "word_slugs": [
            "hongkong-name"
          ]
        },
        {
          "id": "3451839",
          "text": "Einmal war ich in Hongkong.",
          "translation": "Как-то раз я был в Гонконге.",
          "source": "Tatoeba #3451839 @Esperantostern / #3451842 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3451839",
          "cefr_level": "A1",
          "word_slugs": [
            "hongkong-name"
          ]
        },
        {
          "id": "14047369",
          "text": "Ich war einmal in Hongkong.",
          "translation": "Я однажды был в Гонконге.",
          "source": "Tatoeba #14047369 @mhr / #14047090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14047369",
          "cefr_level": "A1",
          "word_slugs": [
            "hongkong-name"
          ]
        },
        {
          "id": "14069808",
          "text": "In Hongkong wird Kantonesisch gesprochen.",
          "translation": "В Гонконге говорят на кантонском языке.",
          "source": "Tatoeba #14069808 @mhr / #14070178 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14069808",
          "cefr_level": "A1",
          "word_slugs": [
            "hongkong-name"
          ]
        },
        {
          "id": "827930",
          "text": "Sie hat viele Freunde in Hongkong.",
          "translation": "У неё много друзей в Гонконге.",
          "source": "Tatoeba #827930 @Zaghawa / #1709622 @ashulga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/827930",
          "cefr_level": "A1",
          "word_slugs": [
            "hongkong-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
