    {
      "slug": "übertreiben-verb",
      "lemma": "übertreiben",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7031,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "преувеличивать",
          "перегибать палку"
        ],
        "en": [
          "to exaggerate",
          "to overdo, to go overboard"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3422544",
          "text": "Ich finde, Sie übertreiben.",
          "translation": "По-моему, Вы преувеличиваете.",
          "source": "Tatoeba #3422544 @Pfirsichbaeumchen / #6692813 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3422544",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreiben-verb"
          ]
        },
        {
          "id": "12195306",
          "text": "Ich will nicht übertreiben.",
          "translation": "Я не хочу преувеличивать.",
          "source": "Tatoeba #12195306 @Naina / #12195356 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12195306",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreiben-verb"
          ]
        },
        {
          "id": "788177",
          "text": "Man kann's auch übertreiben.",
          "translation": "Ну, не преувеличивайте.",
          "source": "Tatoeba #788177 @BraveSentry / #2873923 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/788177",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreiben-verb"
          ]
        },
        {
          "id": "8242013",
          "text": "Finden Sie nicht, dass Sie etwas übertreiben?",
          "translation": "Вам не кажется, что Вы слегка преувеличиваете?",
          "source": "Tatoeba #8242013 @Pfirsichbaeumchen / #12390569 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8242013",
          "cefr_level": "A1",
          "word_slugs": [
            "übertreiben-verb"
          ]
        },
        {
          "id": "1619422",
          "text": "Du hast die Angewohnheit, alles zu übertreiben.",
          "translation": "У тебя привычка всё преувеличивать.",
          "source": "Tatoeba #1619422 @Pfirsichbaeumchen / #3695697 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1619422",
          "cefr_level": "A1",
          "word_slugs": [
