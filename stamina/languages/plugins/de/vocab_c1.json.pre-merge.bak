    {
      "slug": "weite-verb",
      "lemma": "weite",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7955,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of weiten:",
          "first-person singular present",
          "inflection of weiten:",
          "singular imperative"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13996921",
          "text": "Das ist eine weite Distanz!",
          "translation": "Это большое расстояние!",
          "source": "Tatoeba #13996921 @Biderl / #13996930 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13996921",
          "cefr_level": "A1",
          "word_slugs": [
            "weite-verb"
          ]
        },
        {
          "id": "14078685",
          "text": "Ich bin weite Entfernungen gewohnt.",
          "translation": "Я привык к большим расстояниям.",
          "source": "Tatoeba #14078685 @mhr / #14078658 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14078685",
          "cefr_level": "A1",
          "word_slugs": [
            "weite-verb"
          ]
        },
        {
          "id": "7712542",
          "text": "Er ist an weite Fußmärsche gewöhnt.",
          "translation": "Он привык к долгим пешим переходам.",
          "source": "Tatoeba #7712542 @wolfgangth / #14078672 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7712542",
          "cefr_level": "A1",
          "word_slugs": [
            "weite-verb"
          ]
        },
        {
          "id": "4884517",
          "text": "Sie ist an weite Fußmärsche gewöhnt.",
          "translation": "Она привыкла к долгим пешим переходам.",
          "source": "Tatoeba #4884517 @Pfirsichbaeumchen / #14078670 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4884517",
          "cefr_level": "A1",
          "word_slugs": [
            "weite-verb"
          ]
        },
        {
          "id": "2135254",
          "text": "Enge Schornsteine ziehen besser als weite.",
          "translation": "В узких дымоходах тяга лучше, чем в широких.",
          "source": "Tatoeba #2135254 @Esperantostern / #7307368 @Rotor_AU (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2135254",
