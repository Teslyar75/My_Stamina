          ]
        },
        {
          "id": "14032862",
          "text": "Es wurde der Tod des ehemaligen Präsidenten bekanntgegeben.",
          "translation": "Было объявлено о смерти бывшего президента.",
          "source": "Tatoeba #14032862 @mhr / #14032781 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14032862",
          "cefr_level": "A1",
          "word_slugs": [
            "ehemaligen-adj"
          ]
        },
        {
          "id": "8186733",
          "text": "Kommt Maria aus der ehemaligen DDR? Oder woher kann sie Russisch?",
          "translation": "Мария из бывшей ГДР? Или откуда она знает русский?",
          "source": "Tatoeba #8186733 @Pfirsichbaeumchen / #8186994 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8186733",
          "cefr_level": "A1",
          "word_slugs": [
