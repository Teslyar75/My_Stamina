    {
      "slug": "russische-noun",
      "lemma": "Russische",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5573,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": null,
      "examples": [
        {
          "id": "5926301",
          "text": "Hier sind sieben Sätze – die müssen ins Russische übersetzt werden.",
          "translation": "Здесь семь предложений, их надо перевести на русский.",
          "source": "Tatoeba #5926301 @Pfirsichbaeumchen / #5908515 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5926301",
          "cefr_level": "A1",
          "word_slugs": [
            "russische-noun"
          ]
        },
        {
          "id": "8854344",
          "text": "Ich weiß nicht, wie ich diesen Satz ins Russische übersetzen soll.",
          "translation": "Я не знаю, как перевести это предложение на русский.",
          "source": "Tatoeba #8854344 @carlosalberto / #8854008 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8854344",
          "cefr_level": "A1",
          "word_slugs": [
            "russische-noun"
          ]
        },
        {
          "id": "8773641",
          "text": "Die Russische Musikalische Gesellschaft wurde 1859 von der Großfürstin Jelena Pawlowna gegründet.",
          "translation": "Русское музыкальное общество было основано в 1859 году Великой княгиней Еленой Павловной.",
          "source": "Tatoeba #8773641 @Pfirsichbaeumchen / #8774330 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8773641",
          "cefr_level": "A1",
          "word_slugs": [
            "russische-noun"
          ]
        },
        {
          "id": "10728498",
          "text": "Der Russische Zar Iwan der Schreckliche wurde wegen seiner Grausamkeit „Wassiljewitsch“ genannt.",
          "translation": "Русский царь Иван Грозный за жестокость был прозван Васильевичем.",
          "source": "Tatoeba #10728498 @Ooneykcall / #10522885 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10728498",
          "cefr_level": "A1",
          "word_slugs": [
            "russische-noun"
          ]
        },
        {
          "id": "931707",
          "text": "Russische Mädchen lieben Isländer.",
          "translation": "Русские девчонки любят исландцев.",
          "source": "Tatoeba #931707 @Esperantostern / #520055 @FeuDRenais (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/931707",
          "cefr_level": "A1",
          "word_slugs": [
            "russische-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
