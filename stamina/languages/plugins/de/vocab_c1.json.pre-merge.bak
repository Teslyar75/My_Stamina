    {
      "slug": "feststellen-verb",
      "lemma": "feststellen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5731,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "констатировать"
        ],
        "en": [
          "to determine, to ascertain, to establish, to find, to see",
          "to notice, to realize, to observe",
          "to declare, to state",
          "to lock, to secure, to fix into place"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13274076",
          "text": "Du wirst wahrscheinlich keinerlei Unterschied feststellen.",
          "translation": "Ты, вероятно, не заметишь никакой разницы.",
          "source": "Tatoeba #13274076 @Waldelfe / #13274079 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13274076",
          "cefr_level": "A1",
          "word_slugs": [
            "feststellen-verb"
          ]
        },
        {
          "id": "13274072",
          "text": "Sie werden wahrscheinlich keinerlei Unterschied feststellen.",
          "translation": "Вы, вероятно, не заметите никакой разницы.",
          "source": "Tatoeba #13274072 @Waldelfe / #13273924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13274072",
          "cefr_level": "A1",
          "word_slugs": [
            "feststellen-verb"
          ]
        },
        {
          "id": "13274073",
          "text": "Ihr werdet wahrscheinlich keinerlei Unterschied feststellen.",
          "translation": "Вы, вероятно, не заметите никакой разницы.",
          "source": "Tatoeba #13274073 @Waldelfe / #13273924 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13274073",
          "cefr_level": "A1",
          "word_slugs": [
            "feststellen-verb"
          ]
        },
        {
          "id": "12638261",
          "text": "Ich kann nicht genau feststellen, was schiefgegangen ist.",
          "translation": "Я не могу точно определить, что пошло не так.",
          "source": "Tatoeba #12638261 @mhr / #12636758 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12638261",
          "cefr_level": "A1",
          "word_slugs": [
            "feststellen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
