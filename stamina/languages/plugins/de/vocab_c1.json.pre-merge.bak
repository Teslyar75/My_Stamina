          ]
        },
        {
          "id": "2446139",
          "text": "Du musst eine Fee finden.",
          "translation": "Тебе нужно найти фею.",
          "source": "Tatoeba #2446139 @al_ex_an_der / #2446125 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2446139",
          "cefr_level": "A1",
          "word_slugs": [
