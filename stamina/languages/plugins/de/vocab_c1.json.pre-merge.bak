          "text": "Tom hat sich gut benommen.",
          "translation": "Том вёл себя хорошо.",
          "source": "Tatoeba #6619351 @Felixjp / #5430847 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6619351",
          "cefr_level": "A1",
          "word_slugs": [
            "benommen-adj"
          ]
        },
        {
          "id": "3233317",
          "text": "Er hat sich schlecht benommen.",
          "translation": "Он плохо себя вёл.",
          "source": "Tatoeba #3233317 @Zaghawa / #1461232 @dariyus (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3233317",
          "cefr_level": "A1",
          "word_slugs": [
            "benommen-adj"
          ]
        },
        {
          "id": "350190",
          "text": "Er hat sich vernünftig benommen.",
          "translation": "Он вел себя разумно.",
          "source": "Tatoeba #350190 @human600 / #1165716 @benutzer (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/350190",
          "cefr_level": "A1",
          "word_slugs": [
            "benommen-adj"
          ]
        },
        {
          "id": "2089227",
          "text": "Hast du dich heute gut benommen?",
          "translation": "Ты себя вёл хорошо сегодня?",
          "source": "Tatoeba #2089227 @Zaghawa / #2582351 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2089227",
          "cefr_level": "A1",
          "word_slugs": [
            "benommen-adj"
          ]
        },
        {
          "id": "2582439",
          "text": "Habt ihr euch heute gut benommen?",
          "translation": "Вы себя вели хорошо сегодня?",
          "source": "Tatoeba #2582439 @Pfirsichbaeumchen / #2582357 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2582439",
          "cefr_level": "A1",
          "word_slugs": [
            "benommen-adj"
          ]
        }
      ],
