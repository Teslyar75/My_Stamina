      },
      "gender": null,
      "examples": [
        {
          "id": "2298271",
          "text": "Tom fehlte ihnen.",
          "translation": "Им не хватало Тома.",
          "source": "Tatoeba #2298271 @Pfirsichbaeumchen / #3291162 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2298271",
          "cefr_level": "A1",
