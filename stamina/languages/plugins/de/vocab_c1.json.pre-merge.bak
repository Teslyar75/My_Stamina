      "gender": null,
      "examples": [
        {
          "id": "2185714",
          "text": "Ich war erschüttert.",
          "translation": "Я был потрясён.",
          "source": "Tatoeba #2185714 @Pfirsichbaeumchen / #3294206 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2185714",
          "cefr_level": "A1",
          "word_slugs": [
            "erschüttert-verb"
          ]
        },
        {
          "id": "13726379",
          "text": "Ihre Kollegen waren erschüttert, nachdem sie erfahren hatten, was ihr zugestoßen war.",
          "translation": "Её коллеги были потрясены, узнав, что с ней случилось.",
          "source": "Tatoeba #13726379 @Waldelfe / #7759969 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13726379",
          "cefr_level": "A1",
          "word_slugs": [
            "erschüttert-verb"
          ]
        },
        {
          "id": "13726378",
          "text": "Seine Kollegen waren erschüttert, nachdem sie erfahren hatten, was ihm zugestoßen war.",
