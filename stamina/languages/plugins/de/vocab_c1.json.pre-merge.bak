          ]
        },
        {
          "id": "3714900",
          "text": "Hat sonst noch jemand Beschwerden?",
          "translation": "У кого-нибудь ещё есть жалобы?",
          "source": "Tatoeba #3714900 @Pfirsichbaeumchen / #3714819 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3714900",
          "cefr_level": "A1",
          "word_slugs": [
            "beschwerden-noun"
          ]
        },
        {
          "id": "742",
          "text": "Wenn ich Migräne habe, vermindert Aspirin meine Beschwerden nicht.",
          "translation": "Когда у меня мигрень, аспирин не снимает боль.",
          "source": "Tatoeba #742 @MUIRIEL / #2980244 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/742",
