          ]
        },
        {
          "id": "10822886",
          "text": "Schon monatelang steht das Auto in der Garage.",
          "translation": "Машина уже несколько месяцев стоит в гараже.",
          "source": "Tatoeba #10822886 @maaster / #10839073 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10822886",
          "cefr_level": "A1",
          "word_slugs": [
            "monatelang-adv"
          ]
        }
