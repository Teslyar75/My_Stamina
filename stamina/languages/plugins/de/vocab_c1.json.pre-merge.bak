    {
      "slug": "grundlage-noun",
      "lemma": "Grundlage",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9268,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "основа"
        ],
        "en": [
          "foundation",
          "basis",
          "groundwork"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1642435",
          "text": "Dieses Gerücht entbehrt jeder Grundlage.",
          "translation": "Та сплетня не имеет под собой никаких оснований.",
          "source": "Tatoeba #1642435 @al_ex_an_der / #826774 @Patissier (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1642435",
          "cefr_level": "A1",
          "word_slugs": [
            "grundlage-noun"
          ]
        },
        {
          "id": "12716518",
          "text": "Wasser ist die Grundlage des Lebens.",
          "translation": "Вода - основа жизни.",
          "source": "Tatoeba #12716518 @mhr / #12716491 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12716518",
          "cefr_level": "A1",
          "word_slugs": [
            "grundlage-noun"
          ]
        },
        {
          "id": "8891700",
          "text": "Wasser ist die Grundlage allen Lebens.",
          "translation": "Вода - основа всего живого.",
          "source": "Tatoeba #8891700 @Adelpa / #8892644 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8891700",
          "cefr_level": "A1",
          "word_slugs": [
            "grundlage-noun"
          ]
        },
        {
          "id": "486899",
          "text": "Mathematik ist die Grundlage aller Wissenschaften.",
          "translation": "Математика - основа всех наук.",
          "source": "Tatoeba #486899 @xtofu80 / #828980 @Arkadeko (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/486899",
          "cefr_level": "A1",
          "word_slugs": [
            "grundlage-noun"
          ]
        },
        {
          "id": "13785972",
          "text": "Deine Theorie hat keine wissenschaftliche Grundlage.",
          "translation": "Твоя теория не имеет под собой научной основы.",
          "source": "Tatoeba #13785972 @mhr / #13785867 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13785972",
          "cefr_level": "A1",
          "word_slugs": [
            "grundlage-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Grundlage",
        "nominative_pl": ""
      }
