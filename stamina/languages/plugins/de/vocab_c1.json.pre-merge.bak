    {
      "slug": "riss-verb",
      "lemma": "riss",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5351,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Formerly standard spelling of riss which was deprecated in the spelling reform (Rechtschreibreform) of 1996."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3032783",
          "text": "Tom riss die Seite heraus.",
          "translation": "Том вырвал страницу.",
          "source": "Tatoeba #3032783 @raggione / #4139771 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3032783",
          "cefr_level": "A1",
          "word_slugs": [
            "riss-verb"
          ]
        },
        {
          "id": "13425255",
          "text": "Er riß das Papier entzwei.",
          "translation": "Он разорвал бумагу пополам.",
          "source": "Tatoeba #13425255 @Waldelfe / #13765724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13425255",
          "cefr_level": "A1",
          "word_slugs": [
            "riss-verb"
          ]
        },
        {
          "id": "3032780",
          "text": "Tom riss eine Seite heraus.",
          "translation": "Том вырвал страницу.",
          "source": "Tatoeba #3032780 @raggione / #4139771 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3032780",
          "cefr_level": "A1",
          "word_slugs": [
            "riss-verb"
          ]
        },
        {
          "id": "3560064",
          "text": "Maria riss ihr Kleid in Fetzen.",
          "translation": "Мария порвала своё платье в клочья.",
          "source": "Tatoeba #3560064 @al_ex_an_der / #3561360 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3560064",
          "cefr_level": "A1",
          "word_slugs": [
            "riss-verb"
          ]
        },
        {
          "id": "6742173",
          "text": "Er riss einige Seiten aus dem Buch.",
          "translation": "Он вырвал из книги несколько страниц.",
          "source": "Tatoeba #6742173 @Pfirsichbaeumchen / #6007342 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6742173",
          "cefr_level": "A1",
