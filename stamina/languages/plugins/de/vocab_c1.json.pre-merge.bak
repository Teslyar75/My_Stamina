    {
      "slug": "sonnenschein-noun",
      "lemma": "Sonnenschein",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7010,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "sunshine"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "381409",
          "text": "Du bist mein Sonnenschein.",
          "translation": "Ты моё солнышко.",
          "source": "Tatoeba #381409 @Ole / #468255 @tensin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/381409",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenschein-noun"
          ]
        },
        {
          "id": "5378084",
          "text": "Guten Morgen, mein Sonnenschein.",
          "translation": "Доброе утро, солнце мое.",
          "source": "Tatoeba #5378084 @nina99nv / #5378086 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5378084",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenschein-noun"
          ]
        },
        {
          "id": "13635424",
          "text": "Die Wettervorhersage verspricht Sonnenschein.",
          "translation": "Прогноз погоды обещает солнце.",
          "source": "Tatoeba #13635424 @mhr / #13635148 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635424",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenschein-noun"
          ]
        },
        {
          "id": "459360",
          "text": "Nach dem Regen kommt Sonnenschein.",
          "translation": "Заглянет солнце и в наше оконце.",
          "source": "Tatoeba #459360 @xtofu80 / #464826 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/459360",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenschein-noun"
          ]
        },
        {
          "id": "7188900",
          "text": "Pflanzen brauchen Sonnenschein und Wasser.",
          "translation": "Растениям нужен солнечный свет и вода.",
          "source": "Tatoeba #7188900 @Pfirsichbaeumchen / #6682887 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7188900",
          "cefr_level": "A1",
          "word_slugs": [
            "sonnenschein-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
