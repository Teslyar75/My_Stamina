          ]
        },
        {
          "id": "1985806",
          "text": "Sie schliefen in demselben Bett.",
          "translation": "Они спали в одной постели.",
          "source": "Tatoeba #1985806 @Pfirsichbaeumchen / #2762471 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1985806",
