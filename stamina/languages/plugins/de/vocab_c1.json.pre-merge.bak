        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6822639",
          "text": "Schenke Tom ein!",
          "translation": "Налей Тому!",
          "source": "Tatoeba #6822639 @list / #6822990 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6822639",
          "cefr_level": "A1",
          "word_slugs": [
            "schenke-noun"
          ]
        },
        {
          "id": "1580634",
          "text": "Schenke mit Herz, nicht mit dem Portmonee!",
          "translation": "Дарите своё сердце, а не кошелёк.",
          "source": "Tatoeba #1580634 @al_ex_an_der / #1580631 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1580634",
          "cefr_level": "A1",
          "word_slugs": [
            "schenke-noun"
          ]
        }
      ],
