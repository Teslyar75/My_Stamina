      "gender": null,
      "examples": [
        {
          "id": "11679579",
          "text": "Sie lebt auf dem Lande.",
          "translation": "Она живёт в деревне.",
          "source": "Tatoeba #11679579 @mhr / #1558594 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11679579",
