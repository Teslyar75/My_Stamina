    {
      "slug": "bedrückt-adj",
      "lemma": "bedrückt",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8632,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gloomy, depressed"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "2770950",
          "text": "Sag mir doch, was dich bedrückt.",
          "translation": "Скажи же мне, что тебя тяготит.",
          "source": "Tatoeba #2770950 @raggione / #14109354 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2770950",
          "cefr_level": "A1",
          "word_slugs": [
            "bedrückt-adj"
          ]
        },
        {
          "id": "8889062",
          "text": "Du wirkst bedrückt. Was bekümmert dich?",
          "translation": "Ты выглядишь подавленным. Что тебя беспокоит?",
          "source": "Tatoeba #8889062 @Pfirsichbaeumchen / #8889093 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8889062",
          "cefr_level": "A1",
          "word_slugs": [
            "bedrückt-adj"
          ]
        },
        {
          "id": "1582292",
          "text": "Du siehst bedrückt aus. Ist etwas passiert?",
          "translation": "Ты выглядишь удручённым. Что-то случилось?",
          "source": "Tatoeba #1582292 @jakov / #1582299 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1582292",
          "cefr_level": "A1",
          "word_slugs": [
            "bedrückt-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der bedrückt",
        "nominative_pl": ""
      }
    },
    {
      "slug": "streitet-verb",
      "lemma": "streitet",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8633,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of streiten:",
          "third-person singular present",
          "inflection of streiten:",
          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7277224",
          "text": "Streitet euch nicht.",
          "translation": "Не боритесь.",
          "source": "Tatoeba #7277224 @Yorwba / #2652809 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7277224",
          "cefr_level": "A1",
          "word_slugs": [
            "streitet-verb"
          ]
        },
        {
          "id": "12584065",
          "text": "Streitet ihr euch oft?",
          "translation": "Вы часто ссоритесь?",
          "source": "Tatoeba #12584065 @Waldelfe / #13728574 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12584065",
          "cefr_level": "A1",
          "word_slugs": [
            "streitet-verb"
          ]
        },
        {
          "id": "11719472",
          "text": "Tom streitet sich nicht gern.",
          "translation": "Том не любит спорить.",
          "source": "Tatoeba #11719472 @Pfirsichbaeumchen / #7982332 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11719472",
          "cefr_level": "A1",
          "word_slugs": [
            "streitet-verb"
          ]
        },
        {
          "id": "12187666",
          "text": "Tom streitet sich mit seiner Frau.",
          "translation": "Том ссорится с женой.",
          "source": "Tatoeba #12187666 @mhr / #7784495 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12187666",
          "cefr_level": "A1",
          "word_slugs": [
            "streitet-verb"
          ]
        },
        {
          "id": "1587755",
          "text": "Sie streitet ständig mit ihren Eltern.",
          "translation": "Она постоянно ссорится с родителями.",
          "source": "Tatoeba #1587755 @Zaghawa / #1109134 @souris_qui_rit (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1587755",
          "cefr_level": "A1",
          "word_slugs": [
            "streitet-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
