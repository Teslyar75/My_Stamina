        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14068253",
          "text": "Man muss in Büchern nachschlagen.",
          "translation": "Нужно свериться с книгами.",
          "source": "Tatoeba #14068253 @mhr / #14068208 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14068253",
          "cefr_level": "A1",
          "word_slugs": [
            "büchern-noun"
          ]
        },
        {
          "id": "712587",
          "text": "Ich lese alle Arten von Büchern.",
          "translation": "Я читаю самые разные книги.",
          "source": "Tatoeba #712587 @Esperantostern / #13788421 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/712587",
          "cefr_level": "A1",
          "word_slugs": [
            "büchern-noun"
          ]
        },
        {
          "id": "2414567",
          "text": "Keines von diesen Büchern ist interessant.",
          "translation": "Ни одна из этих книг не интересна.",
          "source": "Tatoeba #2414567 @Tamy / #6482878 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2414567",
          "cefr_level": "A1",
          "word_slugs": [
            "büchern-noun"
          ]
        },
        {
          "id": "7352357",
          "text": "Sie hat eine große Zahl an Büchern.",
          "translation": "У неё огромное количество книг.",
          "source": "Tatoeba #7352357 @Pfirsichbaeumchen / #7290105 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7352357",
          "cefr_level": "A1",
          "word_slugs": [
            "büchern-noun"
          ]
        },
        {
          "id": "600103",
          "text": "Was hast du mit den Büchern gemacht?",
          "translation": "Что ты сделал с книгами?",
          "source": "Tatoeba #600103 @MUIRIEL / #795352 @Wadimiy (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/600103",
          "cefr_level": "A1",
          "word_slugs": [
            "büchern-noun"
          ]
        }
