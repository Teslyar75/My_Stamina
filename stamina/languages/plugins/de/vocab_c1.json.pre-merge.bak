        },
        {
          "id": "1952107",
          "text": "Ich finde die Formel nicht.",
          "translation": "Я не нахожу формулу.",
          "source": "Tatoeba #1952107 @al_ex_an_der / #1952105 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1952107",
          "cefr_level": "A1",
          "word_slugs": [
            "formel-noun"
          ]
        },
        {
          "id": "12774212",
          "text": "Schwefelsäure hat die Formel H₂SO₄.",
          "translation": "Формула серной кислоты - H₂SO₄.",
