    {
      "slug": "freies-adj",
      "lemma": "freies",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9028,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular of frei"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2343052",
          "text": "Das ist ein freies Land.",
          "translation": "Это свободная страна.",
          "source": "Tatoeba #2343052 @Pfirsichbaeumchen / #2571626 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2343052",
          "cefr_level": "A1",
          "word_slugs": [
            "freies-adj"
          ]
        },
        {
          "id": "7027274",
          "text": "Haben Sie ein freies Zimmer?",
          "translation": "У Вас есть свободная комната?",
          "source": "Tatoeba #7027274 @list / #7027361 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7027274",
          "cefr_level": "A1",
          "word_slugs": [
            "freies-adj"
          ]
        },
        {
          "id": "2479455",
          "text": "Nur ein freies Volk kann glücklich sein.",
          "translation": "Только свободный народ может быть счастлив.",
          "source": "Tatoeba #2479455 @raggione / #7863452 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2479455",
          "cefr_level": "A1",
          "word_slugs": [
            "freies-adj"
          ]
        },
        {
          "id": "2488793",
          "text": "Die vorgeschlagene Problemlösung lässt der Vorstellungskraft freies Spiel.",
          "translation": "Предложенное решение задачи даёт полную свободу воображению.",
          "source": "Tatoeba #2488793 @al_ex_an_der / #2488791 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2488793",
          "cefr_level": "A1",
          "word_slugs": [
            "freies-adj"
          ]
        }
