          "word_slugs": [
            "caesar-noun"
          ]
        },
        {
          "id": "13941873",
          "text": "Caesar hatte kein Handy.",
          "translation": "У Цезаря не было мобильного телефона.",
          "source": "Tatoeba #13941873 @Vortarulo / #3516904 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13941873",
