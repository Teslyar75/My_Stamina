    {
      "slug": "möglichst-adv",
      "lemma": "möglichst",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5967,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "как можно",
          "насколько это возможно"
        ],
        "en": [
          "as much as possible",
          "preferably"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "368710",
          "text": "Lies möglichst viele Bücher.",
          "translation": "Читай как можно больше книг.",
          "source": "Tatoeba #368710 @xtofu80 / #3471558 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/368710",
          "cefr_level": "A1",
          "word_slugs": [
            "möglichst-adv"
          ]
        },
        {
          "id": "10103936",
          "text": "Ich möchte möglichst lange hierbleiben.",
          "translation": "Я хотел бы остаться здесь как можно дольше.",
          "source": "Tatoeba #10103936 @Pfirsichbaeumchen / #5199783 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10103936",
          "cefr_level": "A1",
          "word_slugs": [
            "möglichst-adv"
          ]
        },
        {
          "id": "5882720",
          "text": "Sprich möglichst leise! Die Kinder schlafen.",
          "translation": "Говори как можно тише. Дети спят.",
          "source": "Tatoeba #5882720 @Pfirsichbaeumchen / #5540776 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5882720",
          "cefr_level": "A1",
          "word_slugs": [
            "möglichst-adv"
          ]
        },
        {
          "id": "2343745",
          "text": "Mein größter Wunsch: „Schreibt möglichst einfach!“",
          "translation": "Моё самое большое желание: \"Пишите как можно проще!\"",
          "source": "Tatoeba #2343745 @al_ex_an_der / #2343739 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2343745",
          "cefr_level": "A1",
          "word_slugs": [
            "möglichst-adv"
          ]
        },
        {
          "id": "11069402",
          "text": "Jugendliche wollen möglichst schnell wirtschaftlich unabhängig werden.",
          "translation": "Молодёжь хочет как можно быстрее стать экономически независимой.",
          "source": "Tatoeba #11069402 @p0wcr / #11103425 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11069402",
          "cefr_level": "A1",
          "word_slugs": [
            "möglichst-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
