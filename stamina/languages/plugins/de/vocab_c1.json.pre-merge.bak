    {
      "slug": "föderation-noun",
      "lemma": "Föderation",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6556,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "federation (a union or alliance of organizations, both nationally and internationally)",
          "federation (a federal state)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13584941",
          "text": "Russland ist eine Föderation.",
          "translation": "Россия - это федерация.",
          "source": "Tatoeba #13584941 @mhr / #13584437 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13584941",
          "cefr_level": "A1",
          "word_slugs": [
            "föderation-noun"
          ]
        },
        {
          "id": "2639130",
          "text": "Moskau ist die Hauptstadt der Russischen Föderation.",
          "translation": "Москва — столица России.",
          "source": "Tatoeba #2639130 @Olya / #1791802 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2639130",
          "cefr_level": "A1",
          "word_slugs": [
            "föderation-noun"
          ]
        },
        {
          "id": "3261141",
          "text": "Im Katastrophengebiet sind auch Rettungskräfte aus der Russischen Föderation im Einsatz.",
          "translation": "В районе бедствия работают и российские спасатели.",
          "source": "Tatoeba #3261141 @al_ex_an_der / #3261140 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3261141",
          "cefr_level": "A1",
          "word_slugs": [
            "föderation-noun"
          ]
        }
      ],
      "tags": [
