          ]
        },
        {
          "id": "400246",
          "text": "Spinnen spinnen gerne Netze.",
          "translation": "Пауки любят плести паутину.",
          "source": "Tatoeba #400246 @MUIRIEL / #398744 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/400246",
          "cefr_level": "A1",
          "word_slugs": [
            "spinnen-verb"
          ]
        },
        {
          "id": "936176",
          "text": "Haben Sie schon einmal eine Spinne ein Netz spinnen sehen?",
          "translation": "Вы когда-нибудь видели, как паук плетёт паутину?",
          "source": "Tatoeba #936176 @MUIRIEL / #11140304 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/936176",
          "cefr_level": "A1",
          "word_slugs": [
            "spinnen-verb"
          ]
        }
      ],
