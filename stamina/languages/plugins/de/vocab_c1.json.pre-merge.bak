    {
      "slug": "beiseite-adv",
      "lemma": "beiseite",
      "pos": "adv",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5932,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "alternative form of zur Seite (“aside, to the side”)",
          "away; out of one’s way; aside (more forceful, resolute; often figurative)",
          "aside (to a place where one can talk in confidence)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "758854",
          "text": "Ich nahm ihn beiseite.",
          "translation": "Я отозвал его в сторону.",
          "source": "Tatoeba #758854 @Dejo / #10045459 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/758854",
          "cefr_level": "A1",
          "word_slugs": [
            "beiseite-adv"
          ]
        },
        {
          "id": "11827939",
          "text": "Ich lege Geld für den Kauf eines Hauses beiseite.",
          "translation": "Я откладываю деньги на покупку дома.",
          "source": "Tatoeba #11827939 @Pfirsichbaeumchen / #10569327 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11827939",
          "cefr_level": "A1",
          "word_slugs": [
            "beiseite-adv"
          ]
        },
        {
          "id": "6038741",
          "text": "Du solltest etwas Geld für deine Hochzeit beiseite legen.",
          "translation": "Ты должен отложить немного денег на свою свадьбу.",
          "source": "Tatoeba #6038741 @raggione / #6888120 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6038741",
          "cefr_level": "A1",
          "word_slugs": [
            "beiseite-adv"
          ]
        },
        {
          "id": "6592347",
          "text": "Tom legt jeden Monat Geld beiseite zum Kauf eines Autos.",
          "translation": "Том каждый месяц откладывает деньги на покупку машины.",
          "source": "Tatoeba #6592347 @Pfirsichbaeumchen / #6592284 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6592347",
          "cefr_level": "A1",
          "word_slugs": [
            "beiseite-adv"
          ]
        },
        {
          "id": "12575046",
          "text": "Spaß beiseite: mit deinen Kopfschmerzen solltest du mal zum Arzt!",
          "translation": "Кроме шуток, тебе к врачу надо с твоей головной болью.",
          "source": "Tatoeba #12575046 @Waldelfe / #12575128 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12575046",
          "cefr_level": "A1",
          "word_slugs": [
            "beiseite-adv"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
