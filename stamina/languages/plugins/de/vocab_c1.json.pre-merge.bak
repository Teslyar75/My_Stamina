          ]
        },
        {
          "id": "398907",
          "text": "Ich tanze gerne.",
          "translation": "Я люблю танцевать.",
          "source": "Tatoeba #398907 @MUIRIEL / #2596456 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/398907",
          "cefr_level": "A1",
          "word_slugs": [
            "tanze-verb"
          ]
        },
        {
          "id": "10061717",
          "text": "Ich tanze sehr gerne.",
