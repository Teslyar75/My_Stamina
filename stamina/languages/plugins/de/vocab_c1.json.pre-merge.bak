    {
      "slug": "qual-noun",
      "lemma": "Qual",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8271,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "мука"
        ],
        "en": [
          "agony, anguish, torment, torture (that one suffers)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "592749",
          "text": "Wer die Wahl hat, hat die Qual.",
          "translation": "Кому выбирать, тому и страдать.",
          "source": "Tatoeba #592749 @Swift / #1521402 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/592749",
          "cefr_level": "A1",
          "word_slugs": [
            "qual-noun"
          ]
        },
        {
          "id": "14069021",
          "text": "Die Qual war ihm ins Gesicht geschrieben.",
          "translation": "На лице его было написано страдание.",
          "source": "Tatoeba #14069021 @mhr / #14069009 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14069021",
          "cefr_level": "A1",
          "word_slugs": [
            "qual-noun"
          ]
        },
        {
          "id": "3531004",
          "text": "Klavier zu spielen, war für mich eine Qual.",
          "translation": "Играть на пианино было для меня мучением.",
          "source": "Tatoeba #3531004 @al_ex_an_der / #13093345 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3531004",
          "cefr_level": "A1",
          "word_slugs": [
            "qual-noun"
          ]
        },
        {
          "id": "6841882",
          "text": "Der Zwang befreit uns von der Qual der Wahl.",
          "translation": "Необходимость освобождает нас от мук выбора.",
          "source": "Tatoeba #6841882 @manese / #6842475 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6841882",
          "cefr_level": "A1",
          "word_slugs": [
            "qual-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
