    {
      "slug": "drittel-noun",
      "lemma": "Drittel",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8213,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "third"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "819494",
          "text": "Ein Drittel der Erdoberfläche ist Wüste.",
          "translation": "Треть земной поверхности - пустыня.",
          "source": "Tatoeba #819494 @Esperantostern / #635974 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/819494",
          "cefr_level": "A1",
          "word_slugs": [
            "drittel-noun"
          ]
        },
        {
          "id": "1808381",
          "text": "Ein Drittel ist weniger als ein Halb.",
          "translation": "Треть меньше половины.",
          "source": "Tatoeba #1808381 @Esperantostern / #4475295 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1808381",
          "cefr_level": "A1",
          "word_slugs": [
            "drittel-noun"
          ]
        },
        {
          "id": "2131789",
          "text": "Rund zwei Drittel unseres Körpers sind Wasser.",
          "translation": "Около двух третей нашего тела составляет вода.",
          "source": "Tatoeba #2131789 @al_ex_an_der / #4042158 @kotik (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2131789",
          "cefr_level": "A1",
          "word_slugs": [
            "drittel-noun"
          ]
        },
        {
          "id": "11265429",
          "text": "Was ist größer: ein Viertel oder ein Drittel?",
          "translation": "Что больше: одна четверть или одна треть?",
          "source": "Tatoeba #11265429 @Pfirsichbaeumchen / #11265419 @ZegPhig (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11265429",
          "cefr_level": "A1",
          "word_slugs": [
            "drittel-noun"
          ]
        },
        {
          "id": "8364407",
          "text": "Zwei Drittel der Erdoberfläche sind mit Wasser bedeckt.",
          "translation": "Две трети поверхности Земли покрыты водой.",
          "source": "Tatoeba #8364407 @Adelpa / #8293045 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8364407",
          "cefr_level": "A1",
          "word_slugs": [
            "drittel-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
