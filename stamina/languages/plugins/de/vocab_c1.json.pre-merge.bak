          ]
        },
        {
          "id": "5939366",
          "text": "Du redest von Tom so, als wäre er ein Vollidiot.",
          "translation": "Ты говоришь о Томе так, будто он полный идиот.",
          "source": "Tatoeba #5939366 @Pfirsichbaeumchen / #5781208 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5939366",
          "cefr_level": "A1",
