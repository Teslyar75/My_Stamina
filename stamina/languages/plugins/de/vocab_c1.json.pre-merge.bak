      },
      "gender": null,
      "examples": [
        {
          "id": "2458765",
          "text": "Er spielt Gitarre.",
          "translation": "Он играет на гитаре.",
          "source": "Tatoeba #2458765 @Pfirsichbaeumchen / #4190586 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2458765",
          "cefr_level": "A1",
