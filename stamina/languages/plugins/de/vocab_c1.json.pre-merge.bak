          "nominative/accusative/genitive plural of Wolf (“wolf”)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12399058",
          "text": "Wo sind Wölfe?",
          "translation": "Где волки?",
          "source": "Tatoeba #12399058 @Pfirsichbaeumchen / #3341899 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12399058",
          "cefr_level": "A1",
          "word_slugs": [
            "wölfe-noun"
          ]
        },
        {
          "id": "12563339",
          "text": "Was fressen Wölfe?",
