    {
      "slug": "donner-noun",
      "lemma": "Donner",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5826,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "thunder"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "588759",
          "text": "Der Donner grollte.",
          "translation": "Прогремел гром.",
          "source": "Tatoeba #588759 @cost / #5130364 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/588759",
          "cefr_level": "A1",
          "word_slugs": [
            "donner-noun"
          ]
        },
        {
          "id": "6837347",
          "text": "Der Donner folgt dem Blitz.",
          "translation": "За молнией следует гром.",
          "source": "Tatoeba #6837347 @rmateo / #6840421 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6837347",
          "cefr_level": "A1",
          "word_slugs": [
            "donner-noun"
          ]
        },
        {
          "id": "2146682",
          "text": "Auf Blitz folgt gewöhnlich Donner.",
