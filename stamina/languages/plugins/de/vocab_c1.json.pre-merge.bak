    {
      "slug": "reparatur-noun",
      "lemma": "Reparatur",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9917,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "починка",
          "ремонт"
        ],
        "en": [
          "repair, mending"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "348431",
          "text": "Mein Auto ist in Reparatur.",
          "translation": "Моя машина в сервисе.",
          "source": "Tatoeba #348431 @MUIRIEL / #824024 @afyodor (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/348431",
          "cefr_level": "A1",
          "word_slugs": [
            "reparatur-noun"
          ]
        },
        {
          "id": "8634553",
          "text": "Wie teuer ist die Reparatur?",
          "translation": "Сколько будет стоить ремонт?",
          "source": "Tatoeba #8634553 @Melang / #5488885 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634553",
          "cefr_level": "A1",
          "word_slugs": [
            "reparatur-noun"
          ]
        },
        {
          "id": "13790790",
          "text": "Wir arbeiten an seiner Reparatur.",
          "translation": "Мы работаем над его починкой.",
          "source": "Tatoeba #13790790 @felix63 / #13878499 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13790790",
          "cefr_level": "A1",
          "word_slugs": [
            "reparatur-noun"
          ]
        },
        {
          "id": "9347122",
          "text": "Oljas Tragrechner befindet sich noch in Reparatur.",
          "translation": "Ноутбук Оли ещё в ремонте.",
          "source": "Tatoeba #9347122 @Pfirsichbaeumchen / #7702210 @mytmpacc2015 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9347122",
          "cefr_level": "A1",
          "word_slugs": [
            "reparatur-noun"
          ]
        },
        {
          "id": "8634551",
          "text": "Mein Auto muss zur Reparatur in die Werkstatt.",
          "translation": "Мне надо сдать машину на ремонт в мастерскую.",
          "source": "Tatoeba #8634551 @Melang / #8640374 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634551",
          "cefr_level": "A1",
          "word_slugs": [
            "reparatur-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
