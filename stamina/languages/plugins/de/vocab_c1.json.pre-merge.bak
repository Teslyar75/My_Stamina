    {
      "slug": "adoptieren-verb",
      "lemma": "adoptieren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9710,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to adopt (a child)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7441763",
          "text": "Bitte nicht Tom adoptieren!",
          "translation": "Пожалуйста, не усыновляйте Тома!",
          "source": "Tatoeba #7441763 @Pfirsichbaeumchen / #7446507 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7441763",
          "cefr_level": "A1",
          "word_slugs": [
            "adoptieren-verb"
          ]
        },
        {
          "id": "10265669",
          "text": "Diesen Satz bitte adoptieren!",
          "translation": "Пожалуйста, присвой это предложение!",
          "source": "Tatoeba #10265669 @Pfirsichbaeumchen / #5488774 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10265669",
          "cefr_level": "A1",
          "word_slugs": [
            "adoptieren-verb"
          ]
        },
        {
          "id": "361961",
          "text": "Meine Frau wollte ein Kind adoptieren.",
          "translation": "Моя жена хотела усыновить ребёнка.",
          "source": "Tatoeba #361961 @Wolf / #2605915 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/361961",
          "cefr_level": "A1",
          "word_slugs": [
            "adoptieren-verb"
          ]
        },
        {
          "id": "13900338",
          "text": "Ich hörte, sie wollten ein Kind adoptieren.",
          "translation": "Я слышала, что они хотят усыновить ребенка.",
          "source": "Tatoeba #13900338 @Waldelfe / #12724731 @Katie_Yves (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13900338",
          "cefr_level": "A1",
          "word_slugs": [
            "adoptieren-verb"
          ]
        },
        {
          "id": "4007115",
          "text": "Tom und Maria beschlossen, Johannes zu adoptieren.",
          "translation": "Том и Мэри решили усыновить Джона.",
          "source": "Tatoeba #4007115 @Pfirsichbaeumchen / #4007110 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4007115",
          "cefr_level": "A1",
          "word_slugs": [
            "adoptieren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
