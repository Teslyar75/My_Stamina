        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1489745",
          "text": "Wer ist der Sekretär?",
          "translation": "Кто секретарь?",
          "source": "Tatoeba #1489745 @Zaghawa / #5682587 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1489745",
          "cefr_level": "A1",
          "word_slugs": [
            "sekretär-noun"
          ]
        },
        {
          "id": "8821413",
          "text": "Ich brauche einen Sekretär.",
          "translation": "Мне нужен секретарь.",
          "source": "Tatoeba #8821413 @Pfirsichbaeumchen / #5550068 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8821413",
          "cefr_level": "A1",
          "word_slugs": [
            "sekretär-noun"
          ]
        },
        {
          "id": "5868323",
          "text": "Ich bin Toms neuer Sekretär.",
          "translation": "Я новый секретарь Тома.",
          "source": "Tatoeba #5868323 @Pfirsichbaeumchen / #5478165 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5868323",
          "cefr_level": "A1",
          "word_slugs": [
            "sekretär-noun"
          ]
        },
        {
          "id": "4156891",
          "text": "Er stellte einen neuen Sekretär ein.",
          "translation": "Он нанял нового секретаря.",
          "source": "Tatoeba #4156891 @pullnosemans / #3669745 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4156891",
          "cefr_level": "A1",
          "word_slugs": [
            "sekretär-noun"
          ]
        },
        {
          "id": "4156920",
          "text": "Mein Sohn ist mit seinem Sekretär verlobt.",
          "translation": "Мой сын обручён со своим секретарём.",
          "source": "Tatoeba #4156920 @pullnosemans / #5893511 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4156920",
          "cefr_level": "A1",
          "word_slugs": [
            "sekretär-noun"
          ]
        }
