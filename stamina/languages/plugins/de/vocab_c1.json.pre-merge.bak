          "second-person plural present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12628098",
          "text": "Genießt das Leben!",
          "translation": "Радуйтесь жизни.",
          "source": "Tatoeba #12628098 @mhr / #12628084 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12628098",
          "cefr_level": "A1",
          "word_slugs": [
            "geniesst-verb"
          ]
        },
        {
          "id": "8634656",
          "text": "Tom genießt das Leben.",
          "translation": "Том наслаждается жизнью.",
          "source": "Tatoeba #8634656 @Melang / #7878552 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634656",
          "cefr_level": "A1",
          "word_slugs": [
            "geniesst-verb"
          ]
        },
        {
          "id": "8634534",
          "text": "Genießt das schöne Wetter!",
          "translation": "Наслаждайтесь прекрасной погодой!",
          "source": "Tatoeba #8634534 @Melang / #8640440 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634534",
          "cefr_level": "A1",
          "word_slugs": [
            "geniesst-verb"
          ]
        },
        {
          "id": "7533474",
          "text": "Tom genießt großes Ansehen als Wissenschaftler.",
          "translation": "Том обладает большим научным авторитетом.",
          "source": "Tatoeba #7533474 @Pfirsichbaeumchen / #7533971 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7533474",
          "cefr_level": "A1",
          "word_slugs": [
            "geniesst-verb"
          ]
        },
        {
          "id": "6797315",
          "text": "Das Leben gehört dem, der es genießt.",
          "translation": "Жизнь принадлежит тем, кто ей наслаждается.",
          "source": "Tatoeba #6797315 @ruth_tatoeba / #6798253 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6797315",
          "cefr_level": "A1",
          "word_slugs": [
            "geniesst-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
