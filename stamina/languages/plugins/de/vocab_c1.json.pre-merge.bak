        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6600444",
          "text": "Verbringt ein schönes Wochenende!",
          "translation": "Хороших вам выходных!",
          "source": "Tatoeba #6600444 @ruth_tatoeba / #1191140 @Keiden (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6600444",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringt-verb"
          ]
        },
        {
          "id": "2763788",
          "text": "Wie verbringt ihr eure Freizeit?",
          "translation": "Как вы проводите свободное время?",
          "source": "Tatoeba #2763788 @raggione / #2711527 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2763788",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringt-verb"
          ]
        },
        {
          "id": "1454293",
          "text": "Manchmal verbringt er Zeit allein.",
          "translation": "Иногда он проводит время в одиночестве.",
          "source": "Tatoeba #1454293 @human600 / #6955708 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1454293",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringt-verb"
          ]
        },
        {
          "id": "3975509",
          "text": "Tom verbringt viel Zeit am Strand.",
          "translation": "Том много времени проводит на пляже.",
          "source": "Tatoeba #3975509 @Pfirsichbaeumchen / #3958029 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3975509",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringt-verb"
          ]
        },
        {
          "id": "8636780",
          "text": "Sie verbringt viel Zeit im Garten.",
          "translation": "Она проводит много времени в саду.",
          "source": "Tatoeba #8636780 @Melang / #8636782 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8636780",
          "cefr_level": "A1",
          "word_slugs": [
            "verbringt-verb"
          ]
        }
      ],
