      },
      "gender": null,
      "examples": [
        {
          "id": "10289144",
          "text": "Sie ist bezaubernd.",
          "translation": "Она очаровательна.",
          "source": "Tatoeba #10289144 @sakslane / #10289058 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10289144",
