    {
      "slug": "ernsthafte-adj",
      "lemma": "ernsthafte",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9490,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of ernsthaft:",
          "strong/mixed nominative/accusative feminine singular",
          "inflection of ernsthaft:",
          "strong nominative/accusative plural"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2038283",
          "text": "Wir haben eine sehr ernsthafte Beziehung.",
          "translation": "У нас очень серьёзные отношения.",
          "source": "Tatoeba #2038283 @al_ex_an_der / #2038281 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2038283",
          "cefr_level": "A1",
          "word_slugs": [
            "ernsthafte-adj"
          ]
        },
        {
          "id": "1286226",
          "text": "Sich zu verheiraten, ist eine ernsthafte Sache.",
          "translation": "Женитьба - дело серьёзное.",
          "source": "Tatoeba #1286226 @Hans_Adler / #2160350 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1286226",
          "cefr_level": "A1",
          "word_slugs": [
            "ernsthafte-adj"
          ]
        },
        {
          "id": "1684508",
          "text": "Hattest du schon einmal eine ernsthafte Erkrankung?",
          "translation": "У тебя когда-нибудь была серьёзная болезнь?",
          "source": "Tatoeba #1684508 @lisha / #2657111 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1684508",
          "cefr_level": "A1",
          "word_slugs": [
            "ernsthafte-adj"
          ]
        },
        {
          "id": "1200321",
          "text": "Sekundenschlaf ist eine ernsthafte Gefahr für übermüdete Autofahrer.",
          "translation": "Микросон - это серьезная опасность для переутомленных водителей.",
          "source": "Tatoeba #1200321 @MUIRIEL / #9804543 @Svetislava (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1200321",
          "cefr_level": "A1",
          "word_slugs": [
            "ernsthafte-adj"
          ]
        },
        {
          "id": "7803380",
          "text": "Ich bin noch nicht bereit, eine ernsthafte Beziehung einzugehen.",
          "translation": "Я ещё не готова вступать в серьёзные отношения.",
          "source": "Tatoeba #7803380 @Pfirsichbaeumchen / #5282072 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7803380",
          "cefr_level": "A1",
          "word_slugs": [
            "ernsthafte-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
