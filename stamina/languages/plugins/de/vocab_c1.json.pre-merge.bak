    {
      "slug": "klettern-verb",
      "lemma": "klettern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6387,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "влезать"
        ],
        "en": [
          "to climb (e.g. up a tree)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "379802",
          "text": "Affen klettern auf Bäume.",
          "translation": "Обезьяны лазают по деревьям.",
          "source": "Tatoeba #379802 @MUIRIEL / #5704758 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379802",
          "cefr_level": "A1",
          "word_slugs": [
            "klettern-verb"
          ]
        },
        {
          "id": "1709434",
          "text": "Wir klettern auf die Palme.",
          "translation": "Мы забираемся на пальму.",
          "source": "Tatoeba #1709434 @Pfirsichbaeumchen / #7528933 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1709434",
          "cefr_level": "A1",
          "word_slugs": [
            "klettern-verb"
          ]
        },
        {
          "id": "8629843",
          "text": "Nicht auf die Mauer klettern!",
          "translation": "Не лезь на стену.",
          "source": "Tatoeba #8629843 @Pfirsichbaeumchen / #8575315 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8629843",
          "cefr_level": "A1",
          "word_slugs": [
            "klettern-verb"
          ]
        },
        {
          "id": "11046924",
          "text": "Elefanten klettern nicht auf Bäume.",
          "translation": "Слоны не залазят на деревья.",
          "source": "Tatoeba #11046924 @maaster / #11047403 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11046924",
          "cefr_level": "A1",
          "word_slugs": [
            "klettern-verb"
          ]
        },
        {
          "id": "401097",
          "text": "Eichhörnchen klettern flink auf Bäume.",
          "translation": "Белки быстро взбираются по деревьям.",
          "source": "Tatoeba #401097 @xtofu80 / #4955958 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/401097",
          "cefr_level": "A1",
          "word_slugs": [
            "klettern-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
