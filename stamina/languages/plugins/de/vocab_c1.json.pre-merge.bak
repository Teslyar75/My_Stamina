    {
      "slug": "vorhang-noun",
      "lemma": "Vorhang",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6626,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "curtain",
          "draperies",
          "drop"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12655593",
          "text": "Kann ich den Vorhang öffnen?",
          "translation": "Можно мне открыть занавес?",
          "source": "Tatoeba #12655593 @Fabe86 / #14034330 @Alex_M (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12655593",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhang-noun"
          ]
        },
        {
          "id": "4940450",
          "text": "Kann ich den Vorhang aufmachen?",
          "translation": "Можно я шторы открою?",
          "source": "Tatoeba #4940450 @raggione / #14005329 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4940450",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhang-noun"
          ]
        },
        {
          "id": "4940448",
          "text": "Dürfte ich den Vorhang aufmachen?",
          "translation": "Можно я шторы открою?",
          "source": "Tatoeba #4940448 @raggione / #14005329 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4940448",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhang-noun"
          ]
        },
        {
          "id": "5458138",
          "text": "Verstecken wir uns hinter dem Vorhang!",
          "translation": "Давай спрячемся за шторой.",
          "source": "Tatoeba #5458138 @Pfirsichbaeumchen / #4535759 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5458138",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhang-noun"
          ]
        },
        {
          "id": "6296217",
          "text": "Der Vorhang war oben, und die Vorführung hatte begonnen.",
          "translation": "Занавес поднялся, и представление началось.",
          "source": "Tatoeba #6296217 @Pfirsichbaeumchen / #4807943 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6296217",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhang-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
