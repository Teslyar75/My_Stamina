      "translations": {
        "en": [
          "A torch, a flashlight: a portable electric light source"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "9547046",
          "text": "Hat jemand eine Taschenlampe?",
          "translation": "У кого-нибудь есть фонарик?",
          "source": "Tatoeba #9547046 @Adelpa / #5924364 @AHuMELLIHuK (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9547046",
          "cefr_level": "A1",
          "word_slugs": [
