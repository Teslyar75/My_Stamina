    {
      "slug": "kandidat-noun",
      "lemma": "Kandidat",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8641,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "candidate"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "1507930",
          "text": "Er kandidierte als parteiloser Kandidat.",
          "translation": "Он выдвигался как независимый кандидат.",
          "source": "Tatoeba #1507930 @Zaghawa / #2864549 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1507930",
          "cefr_level": "A1",
          "word_slugs": [
            "kandidat-noun"
          ]
        },
        {
          "id": "682986",
          "text": "Der Kandidat der Republikaner gewann die Wahl.",
          "translation": "Кандидат от республиканцев выиграл выборы.",
          "source": "Tatoeba #682986 @al_ex_an_der / #2780612 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/682986",
          "cefr_level": "A1",
          "word_slugs": [
            "kandidat-noun"
          ]
        },
        {
          "id": "682987",
          "text": "Der Kandidat der Republikaner hat die Wahl gewonnen.",
          "translation": "Кандидат от республиканцев выиграл выборы.",
          "source": "Tatoeba #682987 @Pfirsichbaeumchen / #2780612 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/682987",
          "cefr_level": "A1",
          "word_slugs": [
