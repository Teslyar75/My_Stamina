    {
      "slug": "gescheitert-verb",
      "lemma": "gescheitert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9594,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of scheitern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "4311397",
          "text": "Die Verhandlungen sind gescheitert.",
          "translation": "Переговоры потерпели неудачу.",
          "source": "Tatoeba #4311397 @al_ex_an_der / #4533023 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4311397",
          "cefr_level": "A1",
          "word_slugs": [
            "gescheitert-verb"
          ]
        },
        {
          "id": "11373698",
          "text": "Alle unsere Versuche sind gescheitert.",
          "translation": "Все наши попытки провалились.",
          "source": "Tatoeba #11373698 @Bernie75 / #1827900 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11373698",
          "cefr_level": "A1",
          "word_slugs": [
            "gescheitert-verb"
          ]
        },
        {
          "id": "14067191",
          "text": "Er erklärte, warum der Versuch gescheitert war.",
          "translation": "Он объяснил, почему опыт провалился.",
          "source": "Tatoeba #14067191 @mhr / #14066813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067191",
          "cefr_level": "A1",
          "word_slugs": [
            "gescheitert-verb"
          ]
        },
        {
          "id": "11745366",
          "text": "Alle Versuche, einen Friedensvertrag auszuhandeln, sind gescheitert.",
          "translation": "Все попытки заключить мирный договор провалились.",
          "source": "Tatoeba #11745366 @Pfirsichbaeumchen / #11745370 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11745366",
          "cefr_level": "A1",
          "word_slugs": [
            "gescheitert-verb"
          ]
        },
        {
          "id": "14067192",
          "text": "Er hat erklärt, warum der Versuch gescheitert ist.",
          "translation": "Он объяснил, почему опыт провалился.",
          "source": "Tatoeba #14067192 @mhr / #14066813 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14067192",
          "cefr_level": "A1",
          "word_slugs": [
            "gescheitert-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
