        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1331295",
          "text": "Verwechseln Sie nicht Meinungen mit Fakten.",
          "translation": "Не путайте мнения с фактами.",
          "source": "Tatoeba #1331295 @Espi / #11787532 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1331295",
          "cefr_level": "A1",
          "word_slugs": [
