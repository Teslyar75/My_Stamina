    {
      "slug": "model-noun",
      "lemma": "Model",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6967,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "модель"
        ],
        "en": [
          "model"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "6148596",
          "text": "Ich bin Schauspielerin, kein Model.",
          "translation": "Я актриса, а не модель.",
          "source": "Tatoeba #6148596 @Espi / #5644512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6148596",
          "cefr_level": "A1",
          "word_slugs": [
            "model-noun"
          ]
        },
        {
          "id": "5819078",
          "text": "Bist du ein Model oder ein Schauspieler?",
          "translation": "Ты модель или актёр?",
          "source": "Tatoeba #5819078 @dasbeispielholz / #6671024 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5819078",
          "cefr_level": "A1",
          "word_slugs": [
            "model-noun"
          ]
        },
        {
          "id": "705566",
          "text": "Dieses Model wurde wegen ihrer Schlankheit berühmt.",
          "translation": "Эта модель известна своей гибкостью.",
          "source": "Tatoeba #705566 @Esperantostern / #1520956 @Waldemar (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/705566",
          "cefr_level": "A1",
          "word_slugs": [
            "model-noun"
          ]
        },
        {
          "id": "12280447",
          "text": "„Jessica sieht wie ein Model aus.“ – „Hör auf, sie so anzustarren!“",
          "translation": "\"Джессика похожа на модель\". - \"Перестань на неё так пялиться!\"",
          "source": "Tatoeba #12280447 @Pfirsichbaeumchen / #12280476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12280447",
          "cefr_level": "A1",
          "word_slugs": [
            "model-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Model",
        "nominative_pl": ""
      }
    },
    {
      "slug": "model-name",
      "lemma": "Model",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6967,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "6148596",
          "text": "Ich bin Schauspielerin, kein Model.",
          "translation": "Я актриса, а не модель.",
          "source": "Tatoeba #6148596 @Espi / #5644512 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6148596",
          "cefr_level": "A1",
          "word_slugs": [
            "model-name"
          ]
        },
        {
          "id": "5819078",
          "text": "Bist du ein Model oder ein Schauspieler?",
          "translation": "Ты модель или актёр?",
          "source": "Tatoeba #5819078 @dasbeispielholz / #6671024 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5819078",
          "cefr_level": "A1",
          "word_slugs": [
            "model-name"
          ]
        },
        {
          "id": "705566",
          "text": "Dieses Model wurde wegen ihrer Schlankheit berühmt.",
          "translation": "Эта модель известна своей гибкостью.",
          "source": "Tatoeba #705566 @Esperantostern / #1520956 @Waldemar (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/705566",
          "cefr_level": "A1",
          "word_slugs": [
            "model-name"
          ]
        },
        {
          "id": "12280447",
          "text": "„Jessica sieht wie ein Model aus.“ – „Hör auf, sie so anzustarren!“",
          "translation": "\"Джессика похожа на модель\". - \"Перестань на неё так пялиться!\"",
          "source": "Tatoeba #12280447 @Pfirsichbaeumchen / #12280476 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12280447",
          "cefr_level": "A1",
          "word_slugs": [
            "model-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Model",
        "nominative_pl": ""
      }
