    {
      "slug": "wunderschönen-adj",
      "lemma": "wunderschönen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6760,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of wunderschön:",
          "strong genitive masculine/neuter singular",
          "inflection of wunderschön:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13779232",
          "text": "Sie wohnen in einem wunderschönen Haus.",
          "translation": "Вы живёте в замечательном доме.",
          "source": "Tatoeba #13779232 @Biderl / #13779235 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13779232",
          "cefr_level": "A1",
          "word_slugs": [
            "wunderschönen-adj"
          ]
        },
        {
          "id": "3259125",
          "text": "Die Raupe verwandelte sich in einen wunderschönen Schmetterling.",
          "translation": "Гусеница превратилась в прекрасную бабочку.",
          "source": "Tatoeba #3259125 @Pfirsichbaeumchen / #3333720 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3259125",
          "cefr_level": "A1",
          "word_slugs": [
            "wunderschönen-adj"
          ]
        },
        {
          "id": "13934033",
          "text": "Wir gingen durch die Stadt und erfreuten uns an der wunderschönen Architektur.",
          "translation": "Мы шли по городу и наслаждались прекрасной архитектурой.",
          "source": "Tatoeba #13934033 @mhr / #13932785 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13934033",
          "cefr_level": "A1",
          "word_slugs": [
            "wunderschönen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "bestehe-verb",
      "lemma": "bestehe",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6761,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bestehen:",
          "first-person singular present",
          "inflection of bestehen:",
          "first/third-person singular subjunctive I"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "969328",
          "text": "Wenn ich meine Prüfungen bestehe, werde ich lange Ferien machen.",
          "translation": "Если я сдам свои экзамены, у меня будут длинные каникулы.",
          "source": "Tatoeba #969328 @holger / #1976758 @olyalya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/969328",
          "cefr_level": "A1",
          "word_slugs": [
            "bestehe-verb"
          ]
        },
        {
          "id": "4904605",
          "text": "Die alten Ägypter glaubten, die menschliche Seele bestehe aus fünf Teilen.",
          "translation": "Древние египтяне считали, что человеческая душа состоит из пяти частей.",
          "source": "Tatoeba #4904605 @Pfirsichbaeumchen / #4904546 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4904605",
          "cefr_level": "A1",
          "word_slugs": [
            "bestehe-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
