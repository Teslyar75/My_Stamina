      "gender": null,
      "examples": [
        {
          "id": "10668960",
          "text": "Wählt eure Freunde mit Bedacht.",
          "translation": "Тщательно выбирайте друзей.",
          "source": "Tatoeba #10668960 @annalog / #8400126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10668960",
          "cefr_level": "A1",
          "word_slugs": [
            "bedacht-noun"
          ]
        },
        {
          "id": "6702458",
          "text": "Wähle deine Freunde mit Bedacht.",
          "translation": "Тщательно выбирай друзей.",
          "source": "Tatoeba #6702458 @Pfirsichbaeumchen / #8400125 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6702458",
          "cefr_level": "A1",
          "word_slugs": [
            "bedacht-noun"
          ]
        },
        {
          "id": "12393791",
          "text": "Nutzen Sie Ihre Zeit mit Bedacht.",
          "translation": "Используйте своё время с умом.",
          "source": "Tatoeba #12393791 @Bernie75 / #4552498 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12393791",
          "cefr_level": "A1",
          "word_slugs": [
            "bedacht-noun"
          ]
        },
        {
          "id": "10668959",
          "text": "Wählen Sie Ihre Freunde mit Bedacht.",
          "translation": "Тщательно выбирайте друзей.",
          "source": "Tatoeba #10668959 @annalog / #8400126 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10668959",
          "cefr_level": "A1",
          "word_slugs": [
            "bedacht-noun"
          ]
        },
        {
          "id": "3245386",
          "text": "So verwenden Sie es mit Bedacht und verschwenden sie es nicht!",
          "translation": "Так что используйте его с умом и не тратьте его впустую.",
