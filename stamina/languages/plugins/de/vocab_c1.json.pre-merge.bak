    {
      "slug": "privaten-adj",
      "lemma": "privaten",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6446,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of privat:",
          "strong genitive masculine/neuter singular",
          "inflection of privat:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3498524",
          "text": "Tom nimmt privaten Französischunterricht.",
          "translation": "Том берёт частные уроки французского.",
          "source": "Tatoeba #3498524 @Pfirsichbaeumchen / #3877375 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3498524",
          "cefr_level": "A1",
          "word_slugs": [
            "privaten-adj"
          ]
        },
        {
          "id": "7484961",
          "text": "Tom fand diese Uhr auf einem privaten Trödelmarkt.",
          "translation": "Том нашёл эти часы на частной распродаже барахла.",
          "source": "Tatoeba #7484961 @raggione / #7487065 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7484961",
          "cefr_level": "A1",
          "word_slugs": [
            "privaten-adj"
          ]
        },
        {
          "id": "1173536",
          "text": "Es ist kinderleicht, an deine privaten Daten zu kommen.",
          "translation": "Добраться до твоих личных данных - с этим и ребенок справится.",
          "source": "Tatoeba #1173536 @Sudajaengi / #1668310 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1173536",
          "cefr_level": "A1",
          "word_slugs": [
            "privaten-adj"
          ]
        },
        {
          "id": "14049159",
          "text": "Diese Politiker verwechseln das öffentliche Leben mit dem privaten.",
          "translation": "Эти политики путают общественную жизнь с частной.",
          "source": "Tatoeba #14049159 @mhr / #14049001 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14049159",
          "cefr_level": "A1",
          "word_slugs": [
            "privaten-adj"
          ]
        },
        {
          "id": "723",
          "text": "Die privaten Colleges und Universitäten der Vereinigten Staaten sind selbstständig.",
          "translation": "Частные колледжи и университеты в Соединенных Штатах автономны.",
          "source": "Tatoeba #723 @MUIRIEL / #2980198 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/723",
          "cefr_level": "A1",
          "word_slugs": [
            "privaten-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
