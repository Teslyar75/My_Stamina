    {
      "slug": "fortschritt-noun",
      "lemma": "Fortschritt",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5860,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "progress, advancement"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12207688",
          "text": "Der Fortschritt ist kaum zu sehen.",
          "translation": "Прогресс едва заметен.",
          "source": "Tatoeba #12207688 @maaster / #13875476 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12207688",
          "cefr_level": "A1",
          "word_slugs": [
            "fortschritt-noun"
          ]
        },
        {
          "id": "2489188",
          "text": "Der Fortschritt des Schülers ist zufriedenstellend.",
          "translation": "Успеваемость ученика удовлетворительна.",
          "source": "Tatoeba #2489188 @Tamy / #12338418 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2489188",
          "cefr_level": "A1",
          "word_slugs": [
            "fortschritt-noun"
          ]
        },
        {
          "id": "3760455",
          "text": "Ich denke, wir haben einen echten Fortschritt erzielt.",
          "translation": "Я думаю, мы добились серьезного прогресса.",
          "source": "Tatoeba #3760455 @Jens_Odo / #3760427 @Robertpaulson (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3760455",
          "cefr_level": "A1",
          "word_slugs": [
            "fortschritt-noun"
          ]
        },
        {
          "id": "1302807",
          "text": "Ist es ein Fortschritt, wenn ein Kannibale Messer und Gabel benutzt?",
          "translation": "Если людоед пользуется ножом и вилкой - это прогресс?",
          "source": "Tatoeba #1302807 @Esperantostern / #3887929 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1302807",
          "cefr_level": "A1",
          "word_slugs": [
            "fortschritt-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
