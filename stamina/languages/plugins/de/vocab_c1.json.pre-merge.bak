    {
      "slug": "jenen-pron",
      "lemma": "jenen",
      "pos": "pron",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9495,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "accusative masculine singular of jener",
          "dative plural of jener"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7669589",
          "text": "Jenen Tag werde ich nicht vergessen.",
          "translation": "Тот день я не забуду.",
          "source": "Tatoeba #7669589 @Pfirsichbaeumchen / #7667230 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7669589",
          "cefr_level": "A1",
          "word_slugs": [
            "jenen-pron"
          ]
        },
        {
          "id": "12744248",
          "text": "Er wird jenen Tag niemals vergessen.",
          "translation": "Он никогда не забудет тот день.",
          "source": "Tatoeba #12744248 @mhr / #12744258 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12744248",
          "cefr_level": "A1",
          "word_slugs": [
            "jenen-pron"
          ]
        },
        {
          "id": "11998650",
          "text": "Jenen Teil des Hauses gab es früher nicht.",
          "translation": "Той части дома раньше не было.",
          "source": "Tatoeba #11998650 @Pfirsichbaeumchen / #11999121 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11998650",
          "cefr_level": "A1",
          "word_slugs": [
            "jenen-pron"
          ]
        },
        {
          "id": "3285753",
          "text": "Sie antwortete, dass sie jenen Mann noch nie gesehen habe.",
          "translation": "Она ответила, что никогда раньше не видела этого человека.",
          "source": "Tatoeba #3285753 @Pfirsichbaeumchen / #3285805 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3285753",
          "cefr_level": "A1",
          "word_slugs": [
            "jenen-pron"
          ]
        },
        {
          "id": "1695832",
          "text": "Die Fingerabdrücke auf der Waffe stimmen mit jenen des Verdächtigen überein.",
          "translation": "Оставленные на оружии отпечатки пальцев совпадают с отпечатками подозреваемого.",
          "source": "Tatoeba #1695832 @Pfirsichbaeumchen / #1996257 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1695832",
          "cefr_level": "A1",
          "word_slugs": [
            "jenen-pron"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
