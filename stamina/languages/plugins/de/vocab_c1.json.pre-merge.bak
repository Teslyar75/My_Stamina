      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bedeuten:",
          "first/third-person singular preterite",
          "inflection of bedeuten:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5538901",
          "text": "Tom bedeutete mir einzutreten.",
          "translation": "Том подал мне знак войти.",
          "source": "Tatoeba #5538901 @Pfirsichbaeumchen / #5538970 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5538901",
          "cefr_level": "A1",
          "word_slugs": [
            "bedeutete-verb"
          ]
        },
        {
          "id": "7937402",
          "text": "Tom bedeutete uns hereinzukommen.",
          "translation": "Том жестом пригласил нас войти.",
          "source": "Tatoeba #7937402 @Pfirsichbaeumchen / #7937133 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7937402",
          "cefr_level": "A1",
          "word_slugs": [
            "bedeutete-verb"
          ]
        },
        {
          "id": "13815257",
          "text": "Tom bedeutete mir hereinzukommen.",
          "translation": "Том сделал мне знак войти.",
          "source": "Tatoeba #13815257 @Waldelfe / #5621632 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13815257",
          "cefr_level": "A1",
          "word_slugs": [
            "bedeutete-verb"
          ]
        },
        {
          "id": "7854713",
          "text": "Tom bedeutete Maria näherzukommen.",
          "translation": "Том сделал Мэри знак подойти.",
          "source": "Tatoeba #7854713 @Pfirsichbaeumchen / #7854676 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7854713",
          "cefr_level": "A1",
          "word_slugs": [
            "bedeutete-verb"
          ]
        },
        {
          "id": "2402577",
          "text": "Sie bedeutete mir zu schweigen.",
          "translation": "Она сделала знак, чтобы я молчал.",
          "source": "Tatoeba #2402577 @al_ex_an_der / #2402575 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2402577",
          "cefr_level": "A1",
          "word_slugs": [
            "bedeutete-verb"
          ]
        }
      ],
