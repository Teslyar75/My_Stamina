    {
      "slug": "verlobte-noun",
      "lemma": "Verlobte",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5155,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "невеста"
        ],
        "en": [
          "inflection of Verlobter:",
          "strong nominative/accusative plural",
          "inflection of Verlobter:",
          "weak nominative singular"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "6911264",
          "text": "Ich bin Toms Verlobte.",
          "translation": "Я невеста Тома.",
          "source": "Tatoeba #6911264 @Pfirsichbaeumchen / #3069177 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6911264",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobte-noun"
          ]
        },
        {
          "id": "8629162",
          "text": "Wo ist deine Verlobte?",
          "translation": "Где твоя невеста?",
          "source": "Tatoeba #8629162 @Melang / #8632701 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8629162",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobte-noun"
          ]
        },
        {
          "id": "1813005",
          "text": "Das ist seine Verlobte.",
          "translation": "Это его невеста.",
          "source": "Tatoeba #1813005 @pne / #2821866 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1813005",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobte-noun"
          ]
        },
        {
          "id": "1812999",
          "text": "Er stellte seine Verlobte vor.",
          "translation": "Он представил свою невесту.",
          "source": "Tatoeba #1812999 @pne / #11568220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1812999",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobte-noun"
          ]
        },
        {
          "id": "1854325",
          "text": "Er hat seine Verlobte vorgestellt.",
          "translation": "Он представил свою невесту.",
          "source": "Tatoeba #1854325 @Zaghawa / #11568220 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1854325",
          "cefr_level": "A1",
          "word_slugs": [
            "verlobte-noun"
          ]
        }
      ],
      "tags": [
