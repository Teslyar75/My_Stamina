          "mouse cursor (informally even when not in the form of an arrow)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13595932",
          "text": "Kein einziger Pfeil traf ins Ziel.",
          "translation": "Ни одна стрела не попала в цель.",
          "source": "Tatoeba #13595932 @frpzzd / #12748172 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13595932",
          "cefr_level": "A1",
          "word_slugs": [
            "pfeil-noun"
          ]
        },
        {
          "id": "13565489",
          "text": "Er schoß einen Pfeil nach dem Reh.",
          "translation": "Он пустил стрелу в оленя.",
          "source": "Tatoeba #13565489 @Waldelfe / #2666098 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13565489",
          "cefr_level": "A1",
          "word_slugs": [
            "pfeil-noun"
          ]
        },
        {
          "id": "439646",
          "text": "Der Pfeil zeigt den Weg nach Tokyo.",
          "translation": "Стрелка указывает дорогу на Токио.",
          "source": "Tatoeba #439646 @Inoue / #1994771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/439646",
          "cefr_level": "A1",
          "word_slugs": [
            "pfeil-noun"
          ]
        },
        {
          "id": "13565491",
          "text": "Er schoß einen Pfeil auf das Reh ab.",
          "translation": "Он пустил стрелу в оленя.",
          "source": "Tatoeba #13565491 @Waldelfe / #2666098 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13565491",
          "cefr_level": "A1",
          "word_slugs": [
            "pfeil-noun"
          ]
        },
        {
          "id": "13565487",
          "text": "Er schoß mit einem Pfeil auf das Reh.",
          "translation": "Он пустил стрелу в оленя.",
          "source": "Tatoeba #13565487 @Waldelfe / #2666098 @Lenin_1917 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13565487",
