    {
      "slug": "gelten-verb",
      "lemma": "gelten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5964,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "считаться"
        ],
        "en": [
          "to be valid; to count; to hold true",
          "to be effective; to be in force",
          "to be worth",
          "to be about, to concern"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5340108",
          "text": "Regeln gelten für alle.",
          "translation": "Правила действуют для всех.",
          "source": "Tatoeba #5340108 @raggione / #6299690 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5340108",
          "cefr_level": "A1",
          "word_slugs": [
            "gelten-verb"
          ]
        },
        {
          "id": "3717983",
          "text": "Die Sonderkonditionen gelten bis Ende 2025.",
          "translation": "Льготные условия будут действовать до конца 2025 года.",
          "source": "Tatoeba #3717983 @al_ex_an_der / #3717975 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3717983",
          "cefr_level": "A1",
          "word_slugs": [
            "gelten-verb"
          ]
        },
        {
          "id": "3474462",
          "text": "Kühe gelten in Indien als heilige Tiere.",
          "translation": "В Индии коровы считаются священными животными.",
          "source": "Tatoeba #3474462 @Pfirsichbaeumchen / #6907249 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3474462",
          "cefr_level": "A1",
          "word_slugs": [
            "gelten-verb"
          ]
        },
        {
          "id": "3717984",
          "text": "Die Vorzugskonditionen gelten bis zum Ende des Jahres 2025.",
          "translation": "Льготные условия будут действовать до конца 2025 года.",
          "source": "Tatoeba #3717984 @al_ex_an_der / #3717975 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3717984",
          "cefr_level": "A1",
          "word_slugs": [
            "gelten-verb"
          ]
        },
        {
          "id": "4793752",
          "text": "Hochdeutsche Varianten mancher Ausdrücke gelten in der Schweiz als unhöflich.",
          "translation": "Традиционно немецкие варианты некоторых выражений считаются в Швейцарии невежливыми.",
          "source": "Tatoeba #4793752 @AqQoyriq_1 / #4793758 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4793752",
          "cefr_level": "A1",
          "word_slugs": [
            "gelten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
