    {
      "slug": "erinnerte-verb",
      "lemma": "erinnerte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7004,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
