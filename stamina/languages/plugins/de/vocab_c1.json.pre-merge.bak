      },
      "gender": null,
      "examples": [
        {
          "id": "6850142",
          "text": "Wer finanziert das Projekt?",
          "translation": "Кто финансирует проект?",
          "source": "Tatoeba #6850142 @list / #8230162 @fjay69 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6850142",
          "cefr_level": "A1",
          "word_slugs": [
            "finanziert-verb"
          ]
        },
        {
          "id": "7554220",
          "text": "Wer finanziert Ihr Projekt?",
          "translation": "Кто финансирует Ваш проект?",
          "source": "Tatoeba #7554220 @Pfirsichbaeumchen / #7053953 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7554220",
          "cefr_level": "A1",
          "word_slugs": [
            "finanziert-verb"
          ]
        },
        {
          "id": "10832523",
          "text": "Wer finanziert den Islamischen Staat?",
          "translation": "Кто финансирует Исламское государство?",
          "source": "Tatoeba #10832523 @maaster / #11524173 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10832523",
          "cefr_level": "A1",
          "word_slugs": [
            "finanziert-verb"
          ]
        },
        {
          "id": "2039119",
          "text": "Das kanadische Gesundheitswesen wird durch Steuern finanziert.",
          "translation": "Канадское здравоохранение финансируется за счёт налогов.",
          "source": "Tatoeba #2039119 @al_ex_an_der / #2039143 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2039119",
          "cefr_level": "A1",
          "word_slugs": [
            "finanziert-verb"
          ]
        },
        {
          "id": "2943371",
          "text": "Dieses Programm muss aus dem Staatshaushalt finanziert werden.",
          "translation": "Эту программу нужно финансировать из государственного бюджета.",
          "source": "Tatoeba #2943371 @al_ex_an_der / #2943349 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2943371",
          "cefr_level": "A1",
          "word_slugs": [
            "finanziert-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
