    {
      "slug": "vorbereitung-noun",
      "lemma": "Vorbereitung",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9074,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "приготовление"
        ],
        "en": [
          "preparation"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "13052706",
          "text": "Ich gebe euch eine halbe Stunde Zeit zur Vorbereitung.",
          "translation": "Даю вам полчаса времени на подготовку.",
          "source": "Tatoeba #13052706 @mhr / #13052614 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13052706",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbereitung-noun"
          ]
        },
        {
          "id": "13985350",
          "text": "Die Vorbereitung hat zu viel Zeit in Anspruch genommen.",
          "translation": "Подготовка заняла слишком много времени.",
          "source": "Tatoeba #13985350 @mhr / #13985153 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13985350",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbereitung-noun"
          ]
        },
        {
          "id": "12777916",
          "text": "Wir haben für die Vorbereitung noch die ganze Woche Zeit.",
          "translation": "У нас на подготовку ещё целая неделя.",
          "source": "Tatoeba #12777916 @mhr / #12777907 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12777916",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbereitung-noun"
          ]
        },
        {
          "id": "12777917",
          "text": "Wir haben für die Vorbereitung noch eine ganze Woche Zeit.",
          "translation": "У нас на подготовку ещё целая неделя.",
          "source": "Tatoeba #12777917 @mhr / #12777907 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12777917",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbereitung-noun"
          ]
        }
