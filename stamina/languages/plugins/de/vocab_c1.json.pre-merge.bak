    {
      "slug": "verstossen-verb",
      "lemma": "verstoßen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6565,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to cast out (of a community), to disown",
          "to infringe, to break, to violate, to be contrary to",
          "to obturate, to occlude by propping something into",
          "to hide, to conceal"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14007842",
          "text": "Ihr habt gegen die Vertragsbedingungen verstoßen.",
          "translation": "Вы нарушили условия договора.",
          "source": "Tatoeba #14007842 @mhr / #14007098 @kitler (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14007842",
          "cefr_level": "A1",
          "word_slugs": [
            "verstossen-verb"
          ]
        },
        {
          "id": "14007841",
          "text": "Sie haben gegen die Vertragsbedingungen verstoßen.",
          "translation": "Вы нарушили условия договора.",
          "source": "Tatoeba #14007841 @mhr / #14007098 @kitler (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14007841",
          "cefr_level": "A1",
          "word_slugs": [
            "verstossen-verb"
          ]
        },
        {
          "id": "13860915",
          "text": "Achtung, verstoßen Sie nicht gegen die Regeln!",
          "translation": "Осторожно, не нарушайте правила.",
          "source": "Tatoeba #13860915 @mhr / #13860531 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13860915",
          "cefr_level": "A1",
          "word_slugs": [
            "verstossen-verb"
          ]
        },
        {
          "id": "13860913",
          "text": "Vorsicht, verstoßen Sie nicht gegen die Regeln!",
          "translation": "Осторожно, не нарушайте правила.",
          "source": "Tatoeba #13860913 @mhr / #13860531 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13860913",
          "cefr_level": "A1",
          "word_slugs": [
            "verstossen-verb"
          ]
        },
        {
          "id": "823235",
          "text": "Ich werde nie wieder gegen ein Gesetz verstoßen.",
          "translation": "Я больше никогда не буду нарушать закон.",
          "source": "Tatoeba #823235 @al_ex_an_der / #2134821 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/823235",
          "cefr_level": "A1",
          "word_slugs": [
            "verstossen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
