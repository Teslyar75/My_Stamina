    {
      "slug": "investieren-verb",
      "lemma": "investieren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7577,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "инвестировать"
        ],
        "en": [
          "to invest (time, money, etc.)",
          "to invest (to ceremonially install someone in some office)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "5094460",
          "text": "Muss unser Land in alternative Energien investieren?",
          "translation": "Должна ли наша страна инвестировать в альтернативную энергетику?",
          "source": "Tatoeba #5094460 @al_ex_an_der / #5094597 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5094460",
          "cefr_level": "A1",
          "word_slugs": [
            "investieren-verb"
          ]
        },
        {
          "id": "8375220",
          "text": "Investieren Sie niemals in etwas, das frisst oder repariert werden muss.",
          "translation": "Никогда не инвестируйте в то, что жрёт или может нуждаться в ремонте.",
          "source": "Tatoeba #8375220 @Esperantostern / #8376430 @Inego (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8375220",
          "cefr_level": "A1",
          "word_slugs": [
            "investieren-verb"
          ]
        },
        {
          "id": "12385712",
          "text": "Ich habe kein Interesse daran, mein Geld in dieses Projekt zu investieren.",
          "translation": "У меня нет никакого интереса вкладывать свои деньги в этот проект.",
          "source": "Tatoeba #12385712 @Bernie75 / #12385709 @Bernie75 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12385712",
          "cefr_level": "A1",
          "word_slugs": [
            "investieren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
