    {
      "slug": "aufgelegt-verb",
      "lemma": "aufgelegt",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7014,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of auflegen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12880227",
          "text": "Das Buch wurde mehrmals neu aufgelegt.",
          "translation": "Книга несколько раз переиздавалась.",
          "source": "Tatoeba #12880227 @mhr / #12880218 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12880227",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgelegt-verb"
          ]
        },
        {
          "id": "13973525",
          "text": "Das Wörterbuch ist dreimal neu aufgelegt worden.",
          "translation": "Словарь трижды переиздавался.",
          "source": "Tatoeba #13973525 @mhr / #13973420 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13973525",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgelegt-verb"
          ]
        },
        {
          "id": "8235842",
          "text": "Ich bin gerade irgendwie nicht zu Scherzen aufgelegt.",
          "translation": "Мне сейчас как-то не до шуток.",
          "source": "Tatoeba #8235842 @Pfirsichbaeumchen / #7047987 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8235842",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgelegt-verb"
          ]
        },
        {
          "id": "942996",
          "text": "Kaum hatte ich aufgelegt, klingelte das Telefon schon wieder.",
          "translation": "Не успел я положить трубку, как телефон снова зазвонил.",
          "source": "Tatoeba #942996 @Sudajaengi / #4464674 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/942996",
          "cefr_level": "A1",
          "word_slugs": [
            "aufgelegt-verb"
          ]
        },
        {
          "id": "9387564",
          "text": "Kaum dass ich aufgelegt hatte, klingelte das Telefon schon wieder.",
