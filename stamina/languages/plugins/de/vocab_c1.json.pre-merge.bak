    {
      "slug": "vorbereitungen-noun",
      "lemma": "Vorbereitungen",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8549,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Vorbereitung"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1572693",
          "text": "Sind deine Vorbereitungen für die Reise abgeschlossen?",
          "translation": "Твои приготовления к путешествию завершены?",
          "source": "Tatoeba #1572693 @al_ex_an_der / #1572682 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1572693",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbereitungen-noun"
          ]
        },
        {
          "id": "13985349",
          "text": "Die Vorbereitungen haben zu viel Zeit in Anspruch genommen.",
          "translation": "Приготовления заняли слишком много времени.",
          "source": "Tatoeba #13985349 @mhr / #13985152 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13985349",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbereitungen-noun"
          ]
        },
        {
          "id": "13985344",
          "text": "Im Museum laufen die letzten Vorbereitungen für die Eröffnung der Ausstellung.",
          "translation": "В музее идут последние приготовления перед открытием выставки.",
          "source": "Tatoeba #13985344 @mhr / #13985157 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13985344",
          "cefr_level": "A1",
          "word_slugs": [
            "vorbereitungen-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
    {
      "slug": "fortfahren-verb",
      "lemma": "fortfahren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8550,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "уезжать",
          "увозить"
        ],
        "en": [
          "to drive away, drive off",
          "to drive away, remove by means of a vehicle",
          "to continue",
          "to continue, to resume"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2864515",
          "text": "Ich werde fortfahren.",
          "translation": "Я буду двигаться дальше.",
          "source": "Tatoeba #2864515 @alik_farber / #1910334 @shanghainese (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2864515",
          "cefr_level": "A1",
          "word_slugs": [
            "fortfahren-verb"
          ]
        },
        {
          "id": "4422627",
          "text": "Lasst uns fortfahren.",
          "translation": "Давайте выезжать.",
          "source": "Tatoeba #4422627 @Dokuyaku / #9248709 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4422627",
          "cefr_level": "A1",
          "word_slugs": [
            "fortfahren-verb"
          ]
        },
        {
          "id": "12402689",
          "text": "Zum Fortfahren die Rautentaste drücken.",
          "translation": "Чтобы продолжить, нажмите \"решётку\".",
          "source": "Tatoeba #12402689 @Yorwba / #12630746 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12402689",
          "cefr_level": "A1",
          "word_slugs": [
            "fortfahren-verb"
          ]
        },
        {
          "id": "2443839",
          "text": "Ich werde fortfahren, meinen Traum zu verwirklichen.",
          "translation": "Я буду продолжать осуществлять свою мечту.",
          "source": "Tatoeba #2443839 @al_ex_an_der / #2443838 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2443839",
          "cefr_level": "A1",
          "word_slugs": [
            "fortfahren-verb"
          ]
        },
        {
          "id": "2444707",
          "text": "Solange meine Frau mich unterstützt, werde ich fortfahren, meinen Traum zu verwirklichen.",
          "translation": "Пока моя жена меня поддерживает, я буду продолжать осуществлять свою мечту.",
          "source": "Tatoeba #2444707 @al_ex_an_der / #2444730 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2444707",
          "cefr_level": "A1",
          "word_slugs": [
            "fortfahren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
    },
