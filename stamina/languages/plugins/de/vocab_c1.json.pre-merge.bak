    {
      "slug": "physik-noun",
      "lemma": "Physik",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9551,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "physics"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "931263",
          "text": "Zum Teufel mit der Physik!",
          "translation": "К чёрту физику!",
          "source": "Tatoeba #931263 @Sudajaengi / #1629250 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/931263",
          "cefr_level": "A1",
          "word_slugs": [
            "physik-noun"
          ]
        },
        {
          "id": "11983893",
          "text": "Ich interessiere mich für Physik.",
          "translation": "Я интересуюсь физикой.",
          "source": "Tatoeba #11983893 @Naina / #11972741 @Snegsova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11983893",
          "cefr_level": "A1",
          "word_slugs": [
            "physik-noun"
          ]
        },
        {
          "id": "13721124",
          "text": "Meine Freundin will Physik studieren.",
          "translation": "Моя девушка хочет изучать физику.",
          "source": "Tatoeba #13721124 @Ioan_Cristian / #13858401 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13721124",
          "cefr_level": "A1",
          "word_slugs": [
            "physik-noun"
          ]
        },
        {
          "id": "6761091",
          "text": "Willkommen in der Welt der Physik!",
          "translation": "Добро пожаловать в мир физики.",
          "source": "Tatoeba #6761091 @Pfirsichbaeumchen / #5964746 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6761091",
          "cefr_level": "A1",
          "word_slugs": [
            "physik-noun"
          ]
        },
        {
          "id": "1796530",
          "text": "Hast du mit Physik immer noch Probleme?",
          "translation": "У тебя всё ещё трудности с физикой?",
          "source": "Tatoeba #1796530 @Tamy / #2832235 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1796530",
          "cefr_level": "A1",
          "word_slugs": [
            "physik-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
