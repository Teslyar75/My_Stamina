    {
      "slug": "missbraucht-verb",
      "lemma": "mißbraucht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7053,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "obsolete spelling of missbraucht"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3231674",
          "text": "Tom missbraucht seine Stellung.",
          "translation": "Том злоупотребляет своим положением.",
          "source": "Tatoeba #3231674 @Trebalor / #4005651 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3231674",
          "cefr_level": "A1",
          "word_slugs": [
            "missbraucht-verb"
          ]
        },
        {
          "id": "13937528",
          "text": "Diese Katze missbraucht ihre Macht.",
          "translation": "Эта кошка злоупотребляет своей властью.",
          "source": "Tatoeba #13937528 @mhr / #13937444 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13937528",
          "cefr_level": "A1",
          "word_slugs": [
            "missbraucht-verb"
          ]
        },
        {
          "id": "876499",
          "text": "Er muss das Privileg missbraucht haben.",
          "translation": "Он, должно быть, злоупотребил привилегией.",
          "source": "Tatoeba #876499 @jxan / #884965 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/876499",
          "cefr_level": "A1",
          "word_slugs": [
            "missbraucht-verb"
          ]
        },
        {
          "id": "2210100",
          "text": "Tagtäglich werden Daten im Internet geraubt, verkauft und missbraucht.",
          "translation": "Кража, продажа и злоупотребление данными в Интернете происходят ежедневно.",
          "source": "Tatoeba #2210100 @al_ex_an_der / #2210099 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2210100",
          "cefr_level": "A1",
          "word_slugs": [
            "missbraucht-verb"
          ]
        }
      ],
