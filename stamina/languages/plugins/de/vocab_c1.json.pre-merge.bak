    {
      "slug": "zweifeln-verb",
      "lemma": "zweifeln",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7105,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "недоумевать"
        ],
        "en": [
          "to doubt, to be doubtful"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "13264403",
          "text": "Du darfst nicht zweifeln.",
          "translation": "Ты не должен сомневаться.",
          "source": "Tatoeba #13264403 @Waldelfe / #10695155 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13264403",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-verb"
          ]
        },
        {
          "id": "13264404",
          "text": "Ihr dürft nicht zweifeln.",
          "translation": "Вы не должны сомневаться.",
          "source": "Tatoeba #13264404 @Waldelfe / #10695156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13264404",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-verb"
          ]
        },
        {
          "id": "13264405",
          "text": "Sie dürfen nicht zweifeln.",
          "translation": "Вы не должны сомневаться.",
          "source": "Tatoeba #13264405 @Waldelfe / #10695156 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13264405",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-verb"
          ]
        },
        {
          "id": "1289923",
          "text": "Skeptiker zweifeln an allem.",
          "translation": "Скептики во всём сомневаются.",
          "source": "Tatoeba #1289923 @enteka / #3758259 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1289923",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-verb"
          ]
        },
        {
          "id": "2161451",
          "text": "Daran ist nicht zu zweifeln.",
          "translation": "В этом не приходится сомневаться.",
          "source": "Tatoeba #2161451 @Tamy / #6360741 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2161451",
          "cefr_level": "A1",
          "word_slugs": [
            "zweifeln-verb"
          ]
        }
