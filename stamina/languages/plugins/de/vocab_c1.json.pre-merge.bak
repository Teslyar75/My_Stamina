          ]
        },
        {
          "id": "9463570",
          "text": "Ihr seid speziell.",
          "translation": "Вы особенные.",
          "source": "Tatoeba #9463570 @Pfirsichbaeumchen / #3032716 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9463570",
          "cefr_level": "A1",
          "word_slugs": [
            "speziell-adj"
          ]
        },
        {
          "id": "5019777",
          "text": "Diese Bibliothek enthält Bücher speziell für blinde Kinder.",
          "translation": "В этой библиотеке есть специальные книги для слепых детей.",
          "source": "Tatoeba #5019777 @al_ex_an_der / #5027246 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5019777",
          "cefr_level": "A1",
          "word_slugs": [
            "speziell-adj"
          ]
        },
        {
          "id": "14090753",
          "text": "Diese Wohnungen sind speziell für junge Familien konzipiert.",
          "translation": "Эти квартиры спроектированы специально для молодых семей.",
          "source": "Tatoeba #14090753 @mhr / #14090725 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14090753",
          "cefr_level": "A1",
