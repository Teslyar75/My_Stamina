    {
      "slug": "begleiter-noun",
      "lemma": "Begleiter",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9418,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "спутник",
          "аккомпаниатор",
          "артикль"
        ],
        "en": [
          "companion",
          "escort",
          "accompanist",
          "article"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "5568378",
          "text": "Eine Gans ist kein Begleiter für ein Schwein.",
          "translation": "Гусь свинье не товарищ.",
          "source": "Tatoeba #5568378 @Esperantostern / #1728393 @naXa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5568378",
          "cefr_level": "A1",
          "word_slugs": [
            "begleiter-noun"
          ]
        },
        {
          "id": "797713",
          "text": "Ruhm ist nicht immer ein Begleiter des Erfolgs.",
          "translation": "Слава не всегда сопровождает успех.",
          "source": "Tatoeba #797713 @Hans_Adler / #2665809 @megaton (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/797713",
          "cefr_level": "A1",
          "word_slugs": [
            "begleiter-noun"
          ]
        },
        {
          "id": "3548454",
          "text": "Im Jahr 1957 bekam unser Planet einen neuen Begleiter.",
          "translation": "В 1957 году наша планета получила новый спутник.",
          "source": "Tatoeba #3548454 @al_ex_an_der / #3548464 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3548454",
          "cefr_level": "A1",
          "word_slugs": [
            "begleiter-noun"
          ]
        },
        {
          "id": "1814211",
          "text": "Er und sein Begleiter baten mich, mit ihnen mitzukommen.",
          "translation": "Он со своим спутником попросили меня пойти с ними.",
          "source": "Tatoeba #1814211 @Tamy / #1580791 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1814211",
          "cefr_level": "A1",
          "word_slugs": [
            "begleiter-noun"
          ]
        },
        {
          "id": "4932153",
          "text": "Kein Weg ist lang mit einem guten Freund als Begleiter.",
          "translation": "Ни один путь не будет долог с хорошим другом в качестве попутчика.",
          "source": "Tatoeba #4932153 @Esperantostern / #4932492 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4932153",
          "cefr_level": "A1",
          "word_slugs": [
            "begleiter-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Begleiter",
        "nominative_pl": ""
      }
    },
