          "cefr_level": "A1",
          "word_slugs": [
            "einlegen-verb"
          ]
        },
        {
          "id": "3016585",
          "text": "Seine Zähne können einen Ruhetag einlegen.",
          "translation": "Его зубы могут праздновать выходной.",
          "source": "Tatoeba #3016585 @al_ex_an_der / #3016637 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3016585",
          "cefr_level": "A1",
          "word_slugs": [
            "einlegen-verb"
          ]
        },
        {
          "id": "12281762",
          "text": "Lass uns eine Pause im Schatten einlegen!",
          "translation": "Давай передохнём в тени.",
          "source": "Tatoeba #12281762 @mhr / #8250104 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12281762",
          "cefr_level": "A1",
          "word_slugs": [
