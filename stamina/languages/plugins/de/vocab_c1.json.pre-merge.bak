    {
      "slug": "napoleon-name",
      "lemma": "Napoleon",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7831,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "Наполеон"
        ],
        "en": [
          "Napoleon Bonaparte"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "12482320",
          "text": "Napoleon war Korse.",
          "translation": "Наполеон был корсиканцем.",
          "source": "Tatoeba #12482320 @Waldelfe / #10675862 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12482320",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-name"
          ]
        },
        {
          "id": "2256643",
          "text": "Napoleon wurde im Jahre 1804 gekrönt.",
          "translation": "Наполеон был коронован в 1804 году.",
          "source": "Tatoeba #2256643 @Pfirsichbaeumchen / #3579404 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2256643",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-name"
          ]
        },
        {
          "id": "415127",
          "text": "Napoleon führte seine Truppen nach Russland.",
          "translation": "Наполеон направил свои войска в Россию.",
          "source": "Tatoeba #415127 @konny / #1531903 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/415127",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-name"
          ]
        },
        {
          "id": "9408375",
          "text": "Wie denken die Franzosen heute über Napoleon?",
          "translation": "Что французы думают сегодня о Наполеоне?",
          "source": "Tatoeba #9408375 @Pfirsichbaeumchen / #9486455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9408375",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-name"
          ]
        },
        {
          "id": "749717",
          "text": "Napoleon lebte auf der Insel Elba im Exil.",
          "translation": "Наполеон жил в изгнании на острове Эльба.",
          "source": "Tatoeba #749717 @Manfredo / #4231922 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/749717",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Napoleon",
        "nominative_pl": ""
      }
    },
    {
      "slug": "napoleon-noun",
      "lemma": "Napoleon",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7831,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": "n",
      "examples": [
        {
          "id": "9408375",
          "text": "Wie denken die Franzosen heute über Napoleon?",
          "translation": "Что французы думают сегодня о Наполеоне?",
          "source": "Tatoeba #9408375 @Pfirsichbaeumchen / #9486455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9408375",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-noun"
          ]
        },
        {
          "id": "12867903",
          "text": "Im Jahre 1814 wurde Napoleon auf die Insel Elba verbannt.",
          "translation": "В 1814 году Наполеон был сослан на остров Эльбу.",
          "source": "Tatoeba #12867903 @Waldelfe / #4537601 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12867903",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-noun"
          ]
        },
        {
          "id": "440076",
          "text": "Die Schlacht bei Waterloo war die letzte Schlacht Napoleon Bonapartes.",
          "translation": "Битва при Ватерлоо была последней битвой Наполеона Бонапарта.",
          "source": "Tatoeba #440076 @jerom / #2791446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/440076",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-noun"
          ]
        },
        {
          "id": "2746681",
          "text": "Die Schlacht von Waterloo war die letzte Schlacht von Napoleon Bonaparte.",
          "translation": "Битва при Ватерлоо была последней битвой Наполеона Бонапарта.",
          "source": "Tatoeba #2746681 @Tamy / #2791446 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2746681",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-noun"
          ]
        },
        {
          "id": "10518989",
          "text": "Stalin war kleiner als Napoleon – richtiger gesagt, Stalin war tatsächlich klein.",
          "translation": "Сталин был ниже Наполеона, точнее сказать, Сталин был по-настоящему низким.",
          "source": "Tatoeba #10518989 @maaster / #11536097 @kurzawhile (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10518989",
          "cefr_level": "A1",
          "word_slugs": [
            "napoleon-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Napoleon",
        "nominative_pl": ""
      }
