    {
      "slug": "mitgehen-verb",
      "lemma": "mitgehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7260,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to come along",
          "to accompany"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11064344",
          "text": "Er kann mit mir mitgehen.",
          "translation": "Он может пойти со мной.",
          "source": "Tatoeba #11064344 @toivo / #11884545 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11064344",
          "cefr_level": "A1",
          "word_slugs": [
            "mitgehen-verb"
          ]
        },
        {
          "id": "13600795",
          "text": "Er wird mit dir mitgehen.",
          "translation": "Он пойдёт с тобой.",
          "source": "Tatoeba #13600795 @mhr / #13600590 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13600795",
          "cefr_level": "A1",
          "word_slugs": [
            "mitgehen-verb"
          ]
        },
        {
          "id": "11064346",
          "text": "Sie kann mit mir mitgehen.",
          "translation": "Она может пойти со мной.",
          "source": "Tatoeba #11064346 @toivo / #11884551 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11064346",
          "cefr_level": "A1",
          "word_slugs": [
            "mitgehen-verb"
          ]
        },
        {
          "id": "13864926",
          "text": "Er kann mit ihnen mitgehen.",
          "translation": "Он может пойти с ними.",
          "source": "Tatoeba #13864926 @mhr / #13736836 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13864926",
          "cefr_level": "A1",
          "word_slugs": [
            "mitgehen-verb"
          ]
        },
        {
          "id": "2971980",
          "text": "Tom sagt, er werde mitgehen.",
          "translation": "Том говорит, он пойдёт с нами.",
          "source": "Tatoeba #2971980 @raggione / #2971995 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2971980",
          "cefr_level": "A1",
          "word_slugs": [
            "mitgehen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
