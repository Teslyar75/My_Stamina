    {
      "slug": "wecker-noun",
      "lemma": "Wecker",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8137,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "alarm clock",
          "agent noun of wecken; waker, knocker-up (person with the duty to wake others up at a certain time)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "985276",
          "text": "Der Wecker klingelt.",
          "translation": "Будильник звонит.",
          "source": "Tatoeba #985276 @Esperantostern / #2503992 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/985276",
          "cefr_level": "A1",
