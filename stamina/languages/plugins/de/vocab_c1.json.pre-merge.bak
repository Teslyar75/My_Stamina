    {
      "slug": "gereicht-verb",
      "lemma": "gereicht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8608,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of reichen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1534710",
          "text": "Tom hat Maria ein Buch gereicht.",
          "translation": "Том протянул Мэри книгу.",
          "source": "Tatoeba #1534710 @Pfirsichbaeumchen / #3012779 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1534710",
          "cefr_level": "A1",
          "word_slugs": [
