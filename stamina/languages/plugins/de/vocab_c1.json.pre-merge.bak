            "versiegelt-verb"
          ]
        },
        {
          "id": "14112945",
          "text": "Der Brief war nicht versiegelt.",
          "translation": "Письмо было не запечатано.",
          "source": "Tatoeba #14112945 @mhr / #14112864 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14112945",
          "cefr_level": "A1",
          "word_slugs": [
            "versiegelt-verb"
          ]
        },
        {
          "id": "5035014",
          "text": "Ich habe die Dokumente versiegelt.",
          "translation": "Я запечатал документы.",
          "source": "Tatoeba #5035014 @Tamy / #5372436 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5035014",
          "cefr_level": "A1",
          "word_slugs": [
            "versiegelt-verb"
          ]
        },
        {
          "id": "6743232",
          "text": "Für wen ist dieser Brief? Er ist mit einem Herzchen versiegelt!",
          "translation": "Кому это письмо? Оно запечатано сердечком.",
          "source": "Tatoeba #6743232 @Pfirsichbaeumchen / #13669507 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6743232",
          "cefr_level": "A1",
          "word_slugs": [
            "versiegelt-verb"
          ]
        },
        {
          "id": "12563993",
          "text": "Laßt mich ein paar Worte hinzufügen, bevor ihr den Brief versiegelt!",
          "translation": "Дайте мне добавить несколько слов, прежде чем запечатаете письмо.",
          "source": "Tatoeba #12563993 @Waldelfe / #2985598 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12563993",
          "cefr_level": "A1",
          "word_slugs": [
            "versiegelt-verb"
          ]
        }
