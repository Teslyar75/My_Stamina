    {
      "slug": "ausstehen-verb",
      "lemma": "ausstehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7035,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to stand, to endure",
          "to be pending",
          "to be overdue",
          "to be displayed for sale"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10727229",
          "text": "Er kann Tom nicht ausstehen.",
          "translation": "Он терпеть не может Тома.",
          "source": "Tatoeba #10727229 @Pfirsichbaeumchen / #4677469 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10727229",
          "cefr_level": "A1",
          "word_slugs": [
            "ausstehen-verb"
          ]
        },
        {
          "id": "749851",
          "text": "Ich kann ihn nicht ausstehen.",
          "translation": "Я его не выношу.",
          "source": "Tatoeba #749851 @Manfredo / #1937493 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/749851",
          "cefr_level": "A1",
          "word_slugs": [
            "ausstehen-verb"
          ]
        },
        {
          "id": "11398676",
          "text": "Ich konnte sie nie ausstehen.",
          "translation": "Я всегда её терпеть не мог.",
          "source": "Tatoeba #11398676 @Pfirsichbaeumchen / #4893430 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11398676",
          "cefr_level": "A1",
          "word_slugs": [
            "ausstehen-verb"
          ]
        },
        {
          "id": "8819455",
          "text": "Er kann Sport nicht ausstehen.",
          "translation": "Он терпеть не может спорт.",
          "source": "Tatoeba #8819455 @Pfirsichbaeumchen / #8819448 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8819455",
          "cefr_level": "A1",
          "word_slugs": [
            "ausstehen-verb"
          ]
        },
        {
          "id": "3348589",
          "text": "Jesus kann euch nicht ausstehen.",
          "translation": "Иисус терпеть вас не может.",
          "source": "Tatoeba #3348589 @mrtaistoi / #3348578 @mrtaistoi (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3348589",
          "cefr_level": "A1",
          "word_slugs": [
            "ausstehen-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
