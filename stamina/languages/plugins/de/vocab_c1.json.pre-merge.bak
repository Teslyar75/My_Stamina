    {
      "slug": "gans-noun",
      "lemma": "Gans",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7773,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "goose",
          "hen; silly goose"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "399952",
          "text": "Die Gans ist ein Wasservogel.",
          "translation": "Гусь - водоплавающая птица.",
          "source": "Tatoeba #399952 @MUIRIEL / #3990492 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/399952",
          "cefr_level": "A1",
          "word_slugs": [
            "gans-noun"
          ]
        },
        {
          "id": "2155205",
          "text": "Er kauft den Hafer von der Gans.",
          "translation": "Он закупается втридорога.",
          "source": "Tatoeba #2155205 @Esperantostern / #3199273 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2155205",
          "cefr_level": "A1",
          "word_slugs": [
            "gans-noun"
          ]
        },
        {
          "id": "5568378",
          "text": "Eine Gans ist kein Begleiter für ein Schwein.",
          "translation": "Гусь свинье не товарищ.",
          "source": "Tatoeba #5568378 @Esperantostern / #1728393 @naXa (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5568378",
          "cefr_level": "A1",
          "word_slugs": [
            "gans-noun"
          ]
        },
        {
          "id": "4657258",
          "text": "Flög' eine Gans übers Meer, käm' eine Gans wieder her.",
          "translation": "Всё равно вернётся гусем, хоть слетает за моря.",
          "source": "Tatoeba #4657258 @AqQoyriq_1 / #4660474 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4657258",
          "cefr_level": "A1",
          "word_slugs": [
            "gans-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "das",
        "nominative_sg": "das Gans",
        "nominative_pl": ""
      }
    },
