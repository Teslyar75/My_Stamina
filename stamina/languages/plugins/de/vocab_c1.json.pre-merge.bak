      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "впускать",
          "наливать",
          "наполнять"
        ],
        "en": [
          "to let in; to admit; to grant entry",
          "to introduce; to cause to enter a room or fill a container, usually slowly",
          "to draw a bath; to run a bath",
          "to cause to be embedded in something; to recess; to inset"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2935870",
          "text": "Darauf würde ich mich nicht einlassen.",
          "translation": "Я бы не стал в это ввязываться.",
          "source": "Tatoeba #2935870 @raggione / #9816351 @schwetterling (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2935870",
          "cefr_level": "A1",
