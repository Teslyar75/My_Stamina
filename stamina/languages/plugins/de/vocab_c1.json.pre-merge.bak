          "cefr_level": "A1",
          "word_slugs": [
            "eifersucht-noun"
          ]
        },
        {
          "id": "12457132",
          "text": "Eifersucht ist ein Liebesbeweis.",
          "translation": "Ревность - доказательство любви.",
          "source": "Tatoeba #12457132 @Waldelfe / #12456926 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12457132",
          "cefr_level": "A1",
