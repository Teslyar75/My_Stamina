    {
      "slug": "reichweite-noun",
      "lemma": "Reichweite",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5500,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "range (The maximum distance of a weapon, radio station, sensor, vehicle without refueling, etc.)",
          "reach, outreach",
          "arm's reach"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2976255",
          "text": "Außer Reichweite von Kindern aufbewahren!",
          "translation": "Хранить в недоступном для детей месте!",
          "source": "Tatoeba #2976255 @Pfirsichbaeumchen / #3011253 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2976255",
          "cefr_level": "A1",
          "word_slugs": [
            "reichweite-noun"
          ]
        },
        {
          "id": "2450732",
          "text": "Der Spitzel ist schon längst außer Reichweite.",
          "translation": "Шпион уже давно вне досягаемости.",
          "source": "Tatoeba #2450732 @sashasosho / #2450746 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2450732",
          "cefr_level": "A1",
          "word_slugs": [
            "reichweite-noun"
          ]
        },
        {
          "id": "910493",
          "text": "Deponiere die Medizin außer Reichweite der Kinder.",
          "translation": "Храните лекарство в недоступном для детей месте.",
          "source": "Tatoeba #910493 @Sudajaengi / #1359182 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/910493",
          "cefr_level": "A1",
          "word_slugs": [
            "reichweite-noun"
          ]
        },
        {
          "id": "13646043",
          "text": "Bewahren Sie dieses Medikament außerhalb der Reichweite von Kindern auf.",
          "translation": "Храните это лекарство в недоступном для детей месте.",
          "source": "Tatoeba #13646043 @mhr / #13646030 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13646043",
          "cefr_level": "A1",
          "word_slugs": [
            "reichweite-noun"
          ]
        },
        {
          "id": "483275",
          "text": "Medikamente sollten nicht in der Reichweite von Kindern aufbewahrt werden.",
          "translation": "Лекарства не должны храниться в доступном для детей месте.",
          "source": "Tatoeba #483275 @Ullalia / #1588042 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/483275",
          "cefr_level": "A1",
          "word_slugs": [
            "reichweite-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
