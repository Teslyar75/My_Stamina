          ]
        },
        {
          "id": "3295409",
          "text": "Sie hat zwanzig Kinder.",
          "translation": "У неё двадцать детей.",
          "source": "Tatoeba #3295409 @Pfirsichbaeumchen / #3295374 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3295409",
