      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "gerund of wellen"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6833109",
          "text": "Dieser Physiker untersucht Wellen.",
          "translation": "Этот физик изучает волны.",
          "source": "Tatoeba #6833109 @Pfirsichbaeumchen / #6834188 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6833109",
          "cefr_level": "A1",
          "word_slugs": [
            "wellen-noun"
          ]
        },
        {
          "id": "757447",
          "text": "Die Wellen sind heute hoch.",
          "translation": "Волны сегодня высокие.",
          "source": "Tatoeba #757447 @Esperantostern / #8703047 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/757447",
          "cefr_level": "A1",
          "word_slugs": [
            "wellen-noun"
          ]
        },
        {
          "id": "1561514",
          "text": "Die Wellen verschlangen das Boot.",
          "translation": "Волны поглотили лодку.",
          "source": "Tatoeba #1561514 @al_ex_an_der / #2631878 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1561514",
          "cefr_level": "A1",
          "word_slugs": [
            "wellen-noun"
          ]
        },
        {
          "id": "1016794",
          "text": "Ich sende positive Wellen. Ommmmmm.",
          "translation": "Я посылаю позитивные волны. Аум-м-м-м.",
          "source": "Tatoeba #1016794 @MUIRIEL / #9115636 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1016794",
          "cefr_level": "A1",
          "word_slugs": [
            "wellen-noun"
          ]
        },
        {
          "id": "13679269",
          "text": "Die Wellen brechen sich an den Felsen.",
          "translation": "Волны разбиваются о скалы.",
          "source": "Tatoeba #13679269 @mhr / #13679248 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13679269",
          "cefr_level": "A1",
          "word_slugs": [
            "wellen-noun"
          ]
        }
      ],
