    {
      "slug": "wüsstest-verb",
      "lemma": "wüsstest",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5167,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "Formerly standard spelling of wüsstest which was deprecated in the spelling reform (Rechtschreibreform) of 1996."
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1894362",
          "text": "Wir dachten, du wüsstest es.",
          "translation": "Мы думали, ты знаешь.",
          "source": "Tatoeba #1894362 @Pfirsichbaeumchen / #5516241 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1894362",
          "cefr_level": "A1",
          "word_slugs": [
            "wüsstest-verb"
          ]
        },
        {
          "id": "12579014",
          "text": "Tu so, als wüßtest du nichts!",
          "translation": "Притворись, что ты ничего не знаешь.",
          "source": "Tatoeba #12579014 @Waldelfe / #4443929 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12579014",
          "cefr_level": "A1",
          "word_slugs": [
            "wüsstest-verb"
          ]
        },
        {
          "id": "13440955",
          "text": "Ich dachte, das wüsstest du schon.",
          "translation": "Я думал, ты это уже знаешь.",
          "source": "Tatoeba #13440955 @Vortarulo / #13441000 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13440955",
          "cefr_level": "A1",
          "word_slugs": [
            "wüsstest-verb"
          ]
        },
        {
          "id": "8625521",
          "text": "Ich dachte, du wüsstest es bereits.",
          "translation": "Я думал, ты уже знаешь.",
          "source": "Tatoeba #8625521 @Pfirsichbaeumchen / #4120265 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8625521",
          "cefr_level": "A1",
          "word_slugs": [
            "wüsstest-verb"
          ]
        },
        {
          "id": "12575947",
          "text": "Ich dachte, du wüßtest die Wahrheit.",
          "translation": "Я думала, что ты знаешь правду.",
          "source": "Tatoeba #12575947 @Waldelfe / #12575946 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12575947",
          "cefr_level": "A1",
          "word_slugs": [
            "wüsstest-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
