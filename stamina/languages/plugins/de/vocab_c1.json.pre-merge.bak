          "to recommend; to advocate",
          "to propose, to advise in favor of",
          "to demonstrate one’s merits, to approve oneself"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1425861",
          "text": "Welchen empfehlen Sie?",
          "translation": "Который рекомендуете?",
          "source": "Tatoeba #1425861 @Cocolate / #1367454 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1425861",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlen-verb"
          ]
        },
        {
          "id": "989627",
          "text": "Was empfehlen Sie mir?",
          "translation": "Что вы мне посоветуете?",
          "source": "Tatoeba #989627 @MUIRIEL / #2137834 @ReggaeOn (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/989627",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlen-verb"
          ]
        },
        {
          "id": "601530",
          "text": "Welches Medikament empfehlen Sie?",
          "translation": "Какое лекарство вы посоветуете?",
          "source": "Tatoeba #601530 @MUIRIEL / #1670372 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/601530",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlen-verb"
          ]
        },
        {
          "id": "3872795",
          "text": "Ich würde es nicht empfehlen.",
          "translation": "Я бы не советовал.",
          "source": "Tatoeba #3872795 @Giulio / #3872855 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3872795",
          "cefr_level": "A1",
          "word_slugs": [
            "empfehlen-verb"
          ]
        },
        {
          "id": "8059256",
          "text": "Das würde ich nicht empfehlen.",
          "translation": "Я бы не советовал этого.",
          "source": "Tatoeba #8059256 @Luiaard / #2632970 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8059256",
          "cefr_level": "A1",
