        "en": [
          "piece of advice; (in plural) advice"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "10159126",
          "text": "Mir gefällt dein Ratschlag.",
          "translation": "Мне нравится твой совет.",
          "source": "Tatoeba #10159126 @sakslane / #10159069 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10159126",
          "cefr_level": "A1",
          "word_slugs": [
            "ratschlag-noun"
          ]
        },
        {
          "id": "404902",
          "text": "Dein Ratschlag war sehr hilfreich.",
          "translation": "Твой совет мне очень помог.",
          "source": "Tatoeba #404902 @xtofu80 / #2979787 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/404902",
          "cefr_level": "A1",
          "word_slugs": [
            "ratschlag-noun"
          ]
        },
        {
          "id": "379833",
          "text": "Er hat ihm einen Ratschlag gegeben.",
          "translation": "Он дал ему совет.",
          "source": "Tatoeba #379833 @MUIRIEL / #598986 @kobylkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/379833",
          "cefr_level": "A1",
          "word_slugs": [
            "ratschlag-noun"
          ]
        },
        {
          "id": "139484",
          "text": "Lass mich dir einen Ratschlag geben.",
          "translation": "Позволь мне дать тебе один совет.",
          "source": "Tatoeba #139484 @MUIRIEL / #12110862 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/139484",
          "cefr_level": "A1",
          "word_slugs": [
            "ratschlag-noun"
          ]
        },
        {
          "id": "13458231",
          "text": "Für deinen Ratschlag bin ich sehr dankbar.",
          "translation": "Я очень благодарен тебе за совет.",
