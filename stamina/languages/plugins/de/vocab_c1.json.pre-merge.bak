    {
      "slug": "orchester-noun",
      "lemma": "Orchester",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9343,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "orchestra"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8634459",
          "text": "Er ist Musiker in einem Orchester.",
          "translation": "Он музыкант в оркестре.",
          "source": "Tatoeba #8634459 @Melang / #8641519 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8634459",
          "cefr_level": "A1",
          "word_slugs": [
            "orchester-noun"
          ]
        },
        {
          "id": "7575012",
          "text": "Das Orchester beginnt mit der Probe.",
          "translation": "Оркестр начинает репетицию.",
          "source": "Tatoeba #7575012 @driini / #6029979 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7575012",
          "cefr_level": "A1",
          "word_slugs": [
            "orchester-noun"
          ]
        },
        {
          "id": "729",
          "text": "Das Orchester macht misstönende Geräusche beim Stimmen.",
          "translation": "Оркестр издаёт негармоничные звуки при настройке инструментов.",
          "source": "Tatoeba #729 @MUIRIEL / #2980277 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/729",
          "cefr_level": "A1",
          "word_slugs": [
            "orchester-noun"
          ]
        },
        {
          "id": "2571702",
          "text": "Tom spielt in einem der örtlichen Orchester Cello.",
          "translation": "Том играет в одном из местных оркестров на виолончели.",
          "source": "Tatoeba #2571702 @Pfirsichbaeumchen / #5649082 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2571702",
          "cefr_level": "A1",
          "word_slugs": [
            "orchester-noun"
          ]
        },
        {
          "id": "4561550",
          "text": "Was für eine wunderschöne Melodie, die das Orchester gerade spielt.",
          "translation": "Какую прелестную мелодию играет сейчас оркестр.",
          "source": "Tatoeba #4561550 @Juri / #3071565 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4561550",
          "cefr_level": "A1",
          "word_slugs": [
            "orchester-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
