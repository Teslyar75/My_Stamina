    {
      "slug": "entgehen-verb",
      "lemma": "entgehen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6483,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "избегать"
