    {
      "slug": "kreisen-verb",
      "lemma": "kreisen",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8203,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to circle, to wheel",
          "to revolve"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1468489",
          "text": "Elektronen kreisen um den Atomkern.",
          "translation": "Электроны вращаются вокруг атомного ядра.",
          "source": "Tatoeba #1468489 @Esperantostern / #6792113 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1468489",
          "cefr_level": "A1",
          "word_slugs": [
            "kreisen-verb"
          ]
        },
        {
          "id": "904830",
          "text": "Die Planeten kreisen um die Sonne.",
          "translation": "Планеты расположены вокруг Солнца.",
          "source": "Tatoeba #904830 @Sudajaengi / #3789711 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/904830",
          "cefr_level": "A1",
          "word_slugs": [
            "kreisen-verb"
          ]
        },
        {
          "id": "1941075",
          "text": "Meine Gedanken kreisen stets um Tom.",
          "translation": "Мои мысли всегда вертятся вокруг Тома.",
          "source": "Tatoeba #1941075 @Pfirsichbaeumchen / #6795485 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1941075",
          "cefr_level": "A1",
          "word_slugs": [
            "kreisen-verb"
          ]
        },
        {
          "id": "3749048",
          "text": "Die Elektronen kreisen um den Atomkern.",
          "translation": "Электроны вращаются вокруг атомного ядра.",
          "source": "Tatoeba #3749048 @Jens_Odo / #6792113 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3749048",
          "cefr_level": "A1",
          "word_slugs": [
            "kreisen-verb"
          ]
        },
        {
          "id": "753929",
          "text": "Tausende Satelliten kreisen um die Erde.",
          "translation": "Тысячи спутников вращаются вокруг Земли.",
          "source": "Tatoeba #753929 @al_ex_an_der / #3673763 @sharptoothed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/753929",
