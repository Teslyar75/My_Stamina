    {
      "slug": "verehrte-verb",
      "lemma": "verehrte",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8799,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of verehren:",
          "first/third-person singular preterite",
          "inflection of verehren:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12185896",
          "text": "Verehrte Damen und Herren, willkommen an Bord.",
          "translation": "Уважаемые дамы и господа, добро пожаловать на борт.",
          "source": "Tatoeba #12185896 @Rovo / #13280786 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12185896",
          "cefr_level": "A1",
          "word_slugs": [
            "verehrte-verb"
          ]
        },
        {
          "id": "3252863",
          "text": "Sind Sie, verehrte Kollegen, mit meinem Vorschlag zufrieden?",
          "translation": "Удовлетворены ли вы моим предложением, уважаемые коллеги?",
          "source": "Tatoeba #3252863 @al_ex_an_der / #3252852 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3252863",
          "cefr_level": "A1",
          "word_slugs": [
            "verehrte-verb"
          ]
        },
        {
          "id": "1855962",
          "text": "Verehrte Nutzer des Weltnetzes, Tatoeba begrüßt Sie auf seiner offiziellen Website.",
          "translation": "Уважаемые пользователи Всемирной сети, Татоэба приветствует вас на своем официальном сайте.",
          "source": "Tatoeba #1855962 @al_ex_an_der / #1855953 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1855962",
          "cefr_level": "A1",
          "word_slugs": [
            "verehrte-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
