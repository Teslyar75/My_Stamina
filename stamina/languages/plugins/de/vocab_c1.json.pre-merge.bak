    {
      "slug": "zeile-noun",
      "lemma": "Zeile",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9170,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "ряд"
        ],
        "en": [
          "line, row",
          "in a text or table",
          "line, row",
          "of certain other things, especially houses or building elements like windows, sometimes also stalls, parked cars, trees, etc."
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "2650751",
          "text": "Tom ist keine Zeile wert.",
          "translation": "Том не стоит того, чтобы ему писать.",
          "source": "Tatoeba #2650751 @Olya / #2650752 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2650751",
          "cefr_level": "A1",
          "word_slugs": [
            "zeile-noun"
          ]
        },
        {
          "id": "8147238",
          "text": "Schreib auf jede zweite Zeile.",
          "translation": "Пиши через строчку.",
          "source": "Tatoeba #8147238 @Pfirsichbaeumchen / #12159565 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8147238",
          "cefr_level": "A1",
          "word_slugs": [
            "zeile-noun"
          ]
        },
        {
          "id": "8147241",
          "text": "Schreibt auf jede zweite Zeile.",
          "translation": "Пишите через строчку.",
          "source": "Tatoeba #8147241 @Pfirsichbaeumchen / #12159566 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8147241",
          "cefr_level": "A1",
          "word_slugs": [
            "zeile-noun"
          ]
        },
        {
          "id": "8147240",
          "text": "Schreiben Sie auf jede zweite Zeile.",
          "translation": "Пишите через строчку.",
          "source": "Tatoeba #8147240 @Pfirsichbaeumchen / #12159566 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8147240",
          "cefr_level": "A1",
          "word_slugs": [
            "zeile-noun"
          ]
        },
        {
          "id": "826618",
          "text": "Beginnen wir bei der vorletzten Zeile!",
          "translation": "Начнём с предпоследней строчки.",
          "source": "Tatoeba #826618 @Manfredo / #12228783 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/826618",
          "cefr_level": "A1",
          "word_slugs": [
