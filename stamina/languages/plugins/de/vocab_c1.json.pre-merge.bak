    {
      "slug": "fell-noun",
      "lemma": "Fell",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7009,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "шкура"
        ],
        "en": [
          "fur, coat, pelt (hairy skin of an animal)",
          "hide (the detached, tanned skin of an animal)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "10219668",
          "text": "Er hat ein hübsches Fell.",
          "translation": "У него красивый мех.",
          "source": "Tatoeba #10219668 @manese / #11740132 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10219668",
          "cefr_level": "A1",
          "word_slugs": [
            "fell-noun"
          ]
        },
        {
          "id": "1245856",
          "text": "Katzen haben schönes weiches Fell.",
          "translation": "У кошек красивый мягкий мех.",
          "source": "Tatoeba #1245856 @Tlustulimu / #4945836 @Afonkin (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1245856",
          "cefr_level": "A1",
          "word_slugs": [
            "fell-noun"
          ]
        },
        {
          "id": "784892",
          "text": "Das Fell schützt Tiere vor der Kälte.",
          "translation": "Мех защищает животных от холода.",
          "source": "Tatoeba #784892 @Pfirsichbaeumchen / #4515865 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/784892",
          "cefr_level": "A1",
          "word_slugs": [
            "fell-noun"
          ]
        },
        {
          "id": "12726449",
          "text": "Das Fell schützt die Tiere vor Kälte.",
          "translation": "Мех защищает животных от холода.",
          "source": "Tatoeba #12726449 @Adelpa / #4515865 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12726449",
          "cefr_level": "A1",
          "word_slugs": [
            "fell-noun"
          ]
        },
        {
          "id": "1709808",
          "text": "Sein Körper war mit braunem Fell bedeckt.",
          "translation": "Его тело было покрыто коричневым мехом.",
          "source": "Tatoeba #1709808 @Zaghawa / #2993505 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1709808",
          "cefr_level": "A1",
          "word_slugs": [
            "fell-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
