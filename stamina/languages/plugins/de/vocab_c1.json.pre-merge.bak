    {
      "slug": "betrag-noun",
      "lemma": "Betrag",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9881,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "amount, sum",
          "the magnitude or length of a vector"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3148750",
          "text": "Der gezahlte Betrag wird nicht zurückerstattet.",
          "translation": "Оплаченная сумма не возвращается.",
          "source": "Tatoeba #3148750 @faehrmann / #1528773 @ABChessel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3148750",
          "cefr_level": "A1",
          "word_slugs": [
            "betrag-noun"
          ]
        },
        {
          "id": "2671131",
          "text": "Es handelt sich um einen Betrag von 1000 Dollar.",
          "translation": "Речь идёт о сумме в тысячу долларов.",
          "source": "Tatoeba #2671131 @Olya / #2671133 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2671131",
          "cefr_level": "A1",
          "word_slugs": [
            "betrag-noun"
          ]
        },
        {
          "id": "13631734",
          "text": "Ich überweise ihr jeden Monat einen kleinen Betrag.",
          "translation": "Я перевожу ей каждый месяц небольшую сумму.",
          "source": "Tatoeba #13631734 @mhr / #13631725 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13631734",
          "cefr_level": "A1",
          "word_slugs": [
            "betrag-noun"
          ]
        },
        {
          "id": "13631739",
          "text": "Ich überweise ihm jeden Monat einen kleinen Betrag.",
          "translation": "Я перевожу ему каждый месяц небольшую сумму.",
          "source": "Tatoeba #13631739 @mhr / #13631724 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13631739",
          "cefr_level": "A1",
          "word_slugs": [
            "betrag-noun"
          ]
        }
      ],
