          "metro"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "11007511",
          "text": "Er fährt oft mit der Metro.",
          "translation": "Он часто ездит на метро.",
          "source": "Tatoeba #11007511 @toivo / #5715147 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11007511",
          "cefr_level": "A1",
          "word_slugs": [
            "metro-noun"
          ]
        },
        {
          "id": "754750",
          "text": "Sie wollen bei der Metro arbeiten?",
          "translation": "Вы хотите работать в \"МЕТРО\"?!",
          "source": "Tatoeba #754750 @Pfirsichbaeumchen / #991582 @Kuyo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/754750",
          "cefr_level": "A1",
          "word_slugs": [
            "metro-noun"
          ]
        },
        {
          "id": "6333386",
          "text": "Die Moskauer sind stolz auf ihre Metro.",
          "translation": "Москвичи гордятся своим метро.",
          "source": "Tatoeba #6333386 @Pfirsichbaeumchen / #5547818 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6333386",
          "cefr_level": "A1",
          "word_slugs": [
            "metro-noun"
          ]
        },
        {
          "id": "6314143",
          "text": "Die Moskauer Metro öffnet morgens um 5.30 Uhr.",
          "translation": "Московское метро открывается с 05-30 утра.",
          "source": "Tatoeba #6314143 @Pfirsichbaeumchen / #5699301 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6314143",
          "cefr_level": "A1",
          "word_slugs": [
            "metro-noun"
          ]
        },
        {
          "id": "8232425",
          "text": "Tom wartete am Ausgang der Metro auf Maria.",
          "translation": "Том ждал Мэри на выходе из метро.",
          "source": "Tatoeba #8232425 @Pfirsichbaeumchen / #5393967 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8232425",
          "cefr_level": "A1",
          "word_slugs": [
            "metro-noun"
          ]
        }
      ],
