          "cefr_level": "A1",
          "word_slugs": [
            "befolgt-verb"
          ]
        },
        {
          "id": "9829852",
          "text": "Ich habe alle Regeln befolgt.",
          "translation": "Я следовал всем правилам.",
          "source": "Tatoeba #9829852 @GaryGaryGary / #4325047 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/9829852",
          "cefr_level": "A1",
          "word_slugs": [
            "befolgt-verb"
          ]
        }
