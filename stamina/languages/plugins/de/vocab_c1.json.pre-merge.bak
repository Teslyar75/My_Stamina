    {
      "slug": "wandern-verb",
      "lemma": "wandern",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6215,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "путешествовать пешком"
        ],
        "en": [
          "to hike, to go trekking",
          "to wander, to migrate, to move spontaneously, to end up (somewhere)"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8595444",
          "text": "Wir gehen gern wandern.",
          "translation": "Мы любим ходить в поход.",
          "source": "Tatoeba #8595444 @felix63 / #14024652 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8595444",
          "cefr_level": "A1",
          "word_slugs": [
            "wandern-verb"
          ]
        },
        {
          "id": "13148682",
          "text": "Möchten Sie mit uns wandern?",
          "translation": "Хотите пойти с нами в поход?",
          "source": "Tatoeba #13148682 @frpzzd / #8957573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13148682",
          "cefr_level": "A1",
          "word_slugs": [
            "wandern-verb"
          ]
        },
        {
          "id": "13148684",
          "text": "Möchtet ihr mit uns wandern?",
          "translation": "Хотите пойти с нами в поход?",
          "source": "Tatoeba #13148684 @frpzzd / #8957573 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13148684",
          "cefr_level": "A1",
          "word_slugs": [
            "wandern-verb"
          ]
        },
        {
          "id": "6005075",
          "text": "Am Dienstag sind wir wandern gegangen.",
          "translation": "Во вторник мы ходили в поход.",
          "source": "Tatoeba #6005075 @christian63 / #12545294 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6005075",
          "cefr_level": "A1",
          "word_slugs": [
            "wandern-verb"
          ]
        },
        {
          "id": "412",
          "text": "Viele Menschen wandern ziellos durchs Leben.",
          "translation": "Многие блуждают по жизни без цели.",
          "source": "Tatoeba #412 @MUIRIEL / #13879537 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/412",
          "cefr_level": "A1",
          "word_slugs": [
            "wandern-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
