    {
      "slug": "grösseres-adj",
      "lemma": "größeres",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6053,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "strong/mixed nominative/accusative neuter singular comparative degree of gross"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "8081261",
          "text": "Tom braucht ein größeres Boot.",
          "translation": "Тому нужна лодка побольше.",
          "source": "Tatoeba #8081261 @Luiaard / #8102320 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8081261",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseres-adj"
          ]
        },
        {
          "id": "5208756",
          "text": "Tom braucht ein größeres Zimmer.",
          "translation": "Тому нужна комната побольше.",
          "source": "Tatoeba #5208756 @Adalwin / #4674069 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5208756",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseres-adj"
          ]
        },
        {
          "id": "4023402",
          "text": "Du wirst ein größeres Boot brauchen.",
          "translation": "Тебе понадобится лодка побольше.",
          "source": "Tatoeba #4023402 @Esperantostern / #6334505 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4023402",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseres-adj"
          ]
        },
        {
          "id": "13024404",
          "text": "Tom hat ein größeres Büro als Maria.",
          "translation": "Кабинет Тома больше, чем у Марии.",
          "source": "Tatoeba #13024404 @Pfirsichbaeumchen / #6864686 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13024404",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseres-adj"
          ]
        },
        {
          "id": "7368087",
          "text": "Tom hat sich ein größeres Auto gekauft.",
          "translation": "Том купил себе машину побольше.",
          "source": "Tatoeba #7368087 @Pfirsichbaeumchen / #9231444 @Selena777 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7368087",
          "cefr_level": "A1",
          "word_slugs": [
            "grösseres-adj"
          ]
        }
      ],
