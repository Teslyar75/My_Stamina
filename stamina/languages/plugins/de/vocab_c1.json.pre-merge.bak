    {
      "slug": "vorhänge-noun",
      "lemma": "Vorhänge",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8557,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Vorhang"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1425211",
          "text": "Die Vorhänge und Teppiche waren restauriert.",
          "translation": "Шторы и ковры были отреставрированы.",
          "source": "Tatoeba #1425211 @Cocolate / #739038 @jonnywalker (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1425211",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhänge-noun"
          ]
        },
        {
          "id": "2020494",
          "text": "Der Wind bewegt die Vorhänge am Fenster.",
          "translation": "Ветер шевелит занавески на окне.",
          "source": "Tatoeba #2020494 @al_ex_an_der / #2020563 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2020494",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhänge-noun"
          ]
        },
        {
          "id": "8345397",
          "text": "Sie schloss die Vorhänge und ging zu Bett.",
          "translation": "Она задёрнула шторы и пошла спать.",
          "source": "Tatoeba #8345397 @Inego / #7772255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8345397",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhänge-noun"
          ]
        },
        {
          "id": "8346520",
          "text": "Sie zog die Vorhänge zu und ging zu Bett.",
          "translation": "Она задёрнула шторы и пошла спать.",
          "source": "Tatoeba #8346520 @Inego / #7772255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8346520",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhänge-noun"
          ]
        },
        {
          "id": "602987",
          "text": "Mach die Vorhänge auf und lass die Sonne rein.",
          "translation": "Открой шторы и впусти солнечный свет.",
          "source": "Tatoeba #602987 @BraveSentry / #12318278 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/602987",
          "cefr_level": "A1",
          "word_slugs": [
            "vorhänge-noun"
          ]
        }
      ],
