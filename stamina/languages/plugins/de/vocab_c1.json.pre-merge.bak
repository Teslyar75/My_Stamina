    {
      "slug": "ward-verb",
      "lemma": "ward",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5021,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "archaic form of wurde, first/third-person singular preterite of werden"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "7031347",
          "text": "Er ward nimmermehr gesehen.",
          "translation": "Больше его не видели.",
          "source": "Tatoeba #7031347 @Pfirsichbaeumchen / #5362455 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7031347",
          "cefr_level": "A1",
          "word_slugs": [
            "ward-verb"
          ]
        },
        {
          "id": "2558715",
          "text": "Er ward nie mehr gesehen.",
          "translation": "Его больше никогда не видели.",
          "source": "Tatoeba #2558715 @Pfirsichbaeumchen / #6955621 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2558715",
          "cefr_level": "A1",
          "word_slugs": [
            "ward-verb"
          ]
        },
        {
          "id": "2558717",
          "text": "Sie ward nie mehr gesehen.",
          "translation": "Больше её никто не видел.",
          "source": "Tatoeba #2558717 @Pfirsichbaeumchen / #2519235 @paul_lingvo (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2558717",
          "cefr_level": "A1",
          "word_slugs": [
            "ward-verb"
          ]
        },
        {
          "id": "3433918",
          "text": "Er ruhte und ward stärker.",
          "translation": "Он отдохнул и стал сильнее.",
          "source": "Tatoeba #3433918 @Pfirsichbaeumchen / #3439195 @sigavax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3433918",
          "cefr_level": "A1",
          "word_slugs": [
            "ward-verb"
          ]
        },
        {
          "id": "11082897",
          "text": "Er ward nie mehr lebend gesehen.",
          "translation": "Живой его больше не видели.",
          "source": "Tatoeba #11082897 @Pfirsichbaeumchen / #8263322 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11082897",
          "cefr_level": "A1",
          "word_slugs": [
            "ward-verb"
          ]
        }
