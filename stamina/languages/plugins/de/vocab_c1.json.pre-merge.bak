    {
      "slug": "binde-name",
      "lemma": "Binde",
      "pos": "name",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8569,
      "frequency_band": "goethe-c1",
      "translations": {},
      "gender": "m",
      "examples": [
        {
          "id": "1371915",
          "text": "Binde dir die Schuhe!",
          "translation": "Завяжи шнурки.",
          "source": "Tatoeba #1371915 @NadineWohlfahrt / #1862790 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1371915",
          "cefr_level": "A1",
          "word_slugs": [
            "binde-name"
          ]
        },
        {
          "id": "7728737",
          "text": "Binde dir den Schuh gut zu, sonst stolperst du.",
          "translation": "Завяжи шнурки как следует, а то споткнёшься.",
          "source": "Tatoeba #7728737 @brauchinet / #13524102 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7728737",
          "cefr_level": "A1",
          "word_slugs": [
            "binde-name"
          ]
        },
        {
          "id": "13524404",
          "text": "Binde dir die Schnürsenkel ordentlich zu, sonst stolperst du.",
          "translation": "Завяжи шнурки как следует, а то споткнёшься.",
          "source": "Tatoeba #13524404 @mhr / #13524102 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13524404",
          "cefr_level": "A1",
          "word_slugs": [
            "binde-name"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Binde",
        "nominative_pl": ""
      }
    },
    {
      "slug": "zwiebeln-noun",
      "lemma": "Zwiebeln",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8570,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "plural of Zwiebel"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "6923288",
          "text": "Ich mag Zwiebeln.",
          "translation": "Я люблю лук.",
          "source": "Tatoeba #6923288 @wolfgangth / #6959588 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6923288",
          "cefr_level": "A1",
          "word_slugs": [
            "zwiebeln-noun"
          ]
        },
        {
          "id": "6619422",
          "text": "Tom hasst Zwiebeln.",
          "translation": "Том терпеть не может лук.",
          "source": "Tatoeba #6619422 @Felixjp / #9096501 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6619422",
          "cefr_level": "A1",
          "word_slugs": [
            "zwiebeln-noun"
          ]
        },
        {
          "id": "10167174",
          "text": "Ich liebe Zwiebeln.",
          "translation": "Обожаю лук.",
          "source": "Tatoeba #10167174 @Pfirsichbaeumchen / #6590091 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10167174",
          "cefr_level": "A1",
          "word_slugs": [
            "zwiebeln-noun"
          ]
        },
        {
          "id": "12308998",
          "text": "Ich brate Zwiebeln.",
          "translation": "Я пожарю лук.",
          "source": "Tatoeba #12308998 @Pfirsichbaeumchen / #12308771 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12308998",
          "cefr_level": "A1",
          "word_slugs": [
            "zwiebeln-noun"
          ]
        },
        {
          "id": "7696975",
          "text": "Emily hasst Zwiebeln.",
          "translation": "Эмили ненавидит лук.",
          "source": "Tatoeba #7696975 @wolfgangth / #2535402 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7696975",
          "cefr_level": "A1",
          "word_slugs": [
            "zwiebeln-noun"
          ]
        }
      ],
