    {
      "slug": "jugendliche-noun",
      "lemma": "Jugendliche",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 9015,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "девочка-подросток"
        ],
        "en": [
          "inflection of Jugendlicher:",
          "strong nominative/accusative plural",
          "inflection of Jugendlicher:",
          "weak nominative singular"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "4483962",
          "text": "In Frankreich haben viele Jugendliche Motorräder.",
          "translation": "Во Франции у многих молодых людей есть мотоциклы.",
          "source": "Tatoeba #4483962 @Esperantostern / #7038885 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4483962",
          "cefr_level": "A1",
          "word_slugs": [
            "jugendliche-noun"
          ]
        },
        {
          "id": "845010",
          "text": "Der Jugendliche, der spricht, ist mein Bruder.",
          "translation": "Молодой человек, который говорит, — мой брат.",
          "source": "Tatoeba #845010 @Esperantostern / #13940097 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/845010",
          "cefr_level": "A1",
          "word_slugs": [
            "jugendliche-noun"
          ]
        },
        {
          "id": "12679762",
          "text": "Als Jugendliche hatte ich eine schwarze Katze.",
          "translation": "В молодости у меня была чёрная кошка.",
          "source": "Tatoeba #12679762 @mhr / #12679219 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12679762",
          "cefr_level": "A1",
          "word_slugs": [
            "jugendliche-noun"
          ]
        },
        {
          "id": "12679766",
          "text": "Als Jugendliche hatte ich einen schwarzen Kater.",
          "translation": "В молодости у меня был чёрный кот.",
          "source": "Tatoeba #12679766 @mhr / #12679218 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12679766",
          "cefr_level": "A1",
          "word_slugs": [
            "jugendliche-noun"
          ]
        },
        {
          "id": "8626293",
          "text": "Maria hat als Jugendliche viele Dummheiten begangen.",
          "translation": "В молодости Мария наделала много глупостей.",
          "source": "Tatoeba #8626293 @Pfirsichbaeumchen / #8626916 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8626293",
          "cefr_level": "A1",
          "word_slugs": [
            "jugendliche-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Jugendliche",
        "nominative_pl": ""
      }
    },
