    {
      "slug": "bemüht-verb",
      "lemma": "bemüht",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7817,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of bemühen:",
          "second-person plural present",
          "inflection of bemühen:",
          "third-person singular present"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "2346741",
          "text": "Er bemüht sich.",
          "translation": "Он старается.",
          "source": "Tatoeba #2346741 @Pfirsichbaeumchen / #5216917 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2346741",
          "cefr_level": "A1",
          "word_slugs": [
            "bemüht-verb"
          ]
        },
        {
          "id": "12376649",
          "text": "Ich habe mich bemüht.",
          "translation": "Я старался.",
          "source": "Tatoeba #12376649 @mhr / #12376663 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12376649",
          "cefr_level": "A1",
          "word_slugs": [
            "bemüht-verb"
          ]
        },
        {
          "id": "11227005",
          "text": "Bemüht euch, mehr zu Fuß zu gehen.",
          "translation": "Старайтесь больше ходить пешком.",
          "source": "Tatoeba #11227005 @Pfirsichbaeumchen / #11226658 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11227005",
          "cefr_level": "A1",
          "word_slugs": [
            "bemüht-verb"
          ]
        },
        {
          "id": "11227001",
          "text": "Bemüht euch, öfter zu Fuß zu gehen.",
          "translation": "Старайтесь чаще ходить пешком.",
          "source": "Tatoeba #11227001 @Pfirsichbaeumchen / #11226660 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/11227001",
          "cefr_level": "A1",
          "word_slugs": [
            "bemüht-verb"
          ]
        },
        {
          "id": "943123",
          "text": "Er bemüht sich, mit dem Rauchen aufzuhören.",
          "translation": "Он старается бросить курить.",
          "source": "Tatoeba #943123 @Sudajaengi / #565351 @V_Zmoova (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/943123",
          "cefr_level": "A1",
          "word_slugs": [
            "bemüht-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
