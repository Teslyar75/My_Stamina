          ]
        },
        {
          "id": "3325978",
          "text": "Welche Farbe hat die Wolke?",
          "translation": "Какого цвета облако?",
          "source": "Tatoeba #3325978 @al_ex_an_der / #3325989 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3325978",
          "cefr_level": "A1",
          "word_slugs": [
            "wolke-noun"
          ]
        },
        {
          "id": "6837334",
          "text": "Die große Wolke ist schwarz.",
          "translation": "Большое облако - чёрное.",
          "source": "Tatoeba #6837334 @rmateo / #6840427 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6837334",
          "cefr_level": "A1",
