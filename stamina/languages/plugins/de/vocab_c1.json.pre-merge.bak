    {
      "slug": "umzug-noun",
      "lemma": "Umzug",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8734,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "переезд"
        ],
        "en": [
          "move, removal, relocation (change of residence)",
          "parade"
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "1761249",
          "text": "Kannst du mir beim Umzug helfen?",
          "translation": "Можешь помочь мне с переездом?",
          "source": "Tatoeba #1761249 @Zaghawa / #5503693 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1761249",
          "cefr_level": "A1",
          "word_slugs": [
            "umzug-noun"
          ]
        },
        {
          "id": "1761251",
          "text": "Könnt ihr mir beim Umzug helfen?",
          "translation": "Можете помочь мне с переездом?",
          "source": "Tatoeba #1761251 @Zaghawa / #5503694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1761251",
          "cefr_level": "A1",
          "word_slugs": [
            "umzug-noun"
          ]
        },
        {
          "id": "1761254",
          "text": "Können Sie mir beim Umzug helfen?",
          "translation": "Можете помочь мне с переездом?",
          "source": "Tatoeba #1761254 @Zaghawa / #5503694 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1761254",
          "cefr_level": "A1",
          "word_slugs": [
            "umzug-noun"
          ]
        },
        {
          "id": "8741295",
          "text": "Ihre Freunde helfen ihr beim Umzug.",
          "translation": "Друзья помогают ей с переездом.",
          "source": "Tatoeba #8741295 @felix63 / #10651427 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/8741295",
          "cefr_level": "A1",
          "word_slugs": [
            "umzug-noun"
          ]
        },
        {
          "id": "4262597",
          "text": "Am Samstag werde ich Freunden beim Umzug helfen.",
          "translation": "В субботу я буду помогать друзьям с переездом.",
          "source": "Tatoeba #4262597 @AqQoyriq_1 / #4262598 @AqQoyriq_1 (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4262597",
          "cefr_level": "A1",
          "word_slugs": [
            "umzug-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "der",
        "nominative_sg": "der Umzug",
        "nominative_pl": ""
      }
    },
