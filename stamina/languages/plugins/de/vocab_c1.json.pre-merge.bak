        {
          "id": "12164278",
          "text": "Mich wundert etwas anderes.",
          "translation": "Меня другое удивляет.",
          "source": "Tatoeba #12164278 @mhr / #11002224 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12164278",
          "cefr_level": "A1",
          "word_slugs": [
            "wundert-verb"
          ]
        },
        {
          "id": "7728945",
          "text": "Es wundert mich nicht, dass du die Antwort nicht weißt.",
          "translation": "Меня не удивляет, что ты не знаешь ответа.",
          "source": "Tatoeba #7728945 @raggione / #10696655 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7728945",
          "cefr_level": "A1",
          "word_slugs": [
            "wundert-verb"
          ]
        },
        {
          "id": "7728948",
          "text": "Es wundert mich nicht, dass ihr die Antwort nicht wisst.",
          "translation": "Меня не удивляет, что вы не знаете ответа.",
          "source": "Tatoeba #7728948 @raggione / #10696656 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7728948",
          "cefr_level": "A1",
          "word_slugs": [
            "wundert-verb"
          ]
        },
        {
          "id": "2225822",
          "text": "Es wundert mich, dass sich ein Linguist wie er so irren kann.",
          "translation": "Удивительно, что такой специалист в лингвистике, как он, может так ошибаться.",
          "source": "Tatoeba #2225822 @Pfirsichbaeumchen / #13669528 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2225822",
          "cefr_level": "A1",
          "word_slugs": [
            "wundert-verb"
          ]
        }
      ],
