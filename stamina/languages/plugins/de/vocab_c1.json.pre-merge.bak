    {
      "slug": "haft-noun",
      "lemma": "Haft",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6607,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "заключение"
        ],
        "en": [
          "arrest, custody, imprisonment (the state of being confined by order of a government or ruler)",
          "captivity (any confinement, e.g. by criminals)"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "2975588",
          "text": "Er wurde zu lebenslanger Haft verurteilt.",
          "translation": "Он был приговорен к пожизненному заключению.",
          "source": "Tatoeba #2975588 @freddy1 / #10624957 @Balamax (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2975588",
          "cefr_level": "A1",
          "word_slugs": [
            "haft-noun"
          ]
        },
        {
          "id": "2597356",
          "text": "Ich will, dass man Tom wegen Mordes in Haft nimmt.",
          "translation": "Я хочу, чтобы Том был арестован за убийство.",
          "source": "Tatoeba #2597356 @al_ex_an_der / #2597352 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2597356",
          "cefr_level": "A1",
          "word_slugs": [
            "haft-noun"
          ]
        },
        {
          "id": "2597363",
          "text": "Ich will, dass Tom wegen Mordes in Haft genommen wird.",
          "translation": "Я хочу, чтобы Том был арестован за убийство.",
          "source": "Tatoeba #2597363 @al_ex_an_der / #2597352 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2597363",
          "cefr_level": "A1",
          "word_slugs": [
            "haft-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
