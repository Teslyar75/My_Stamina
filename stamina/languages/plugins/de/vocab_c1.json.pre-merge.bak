    {
      "slug": "aushalten-verb",
      "lemma": "aushalten",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5743,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "вытерпеть"
        ],
        "en": [
          "to stand, to endure something or someone:",
          "to stand, to take, to endure",
          "to stand, to endure something or someone:",
          "to stand, to bear, to take, to tolerate"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3307732",
          "text": "Wir mussten viele Schwierigkeiten aushalten.",
          "translation": "Нам пришлось перенести много трудностей.",
          "source": "Tatoeba #3307732 @al_ex_an_der / #3307730 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3307732",
          "cefr_level": "A1",
          "word_slugs": [
            "aushalten-verb"
          ]
        },
        {
          "id": "3089708",
          "text": "Ich kann den Schmerz nicht mehr aushalten.",
          "translation": "Я больше не могу терпеть боль.",
          "source": "Tatoeba #3089708 @al_ex_an_der / #3089704 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3089708",
          "cefr_level": "A1",
          "word_slugs": [
            "aushalten-verb"
          ]
        },
        {
          "id": "568501",
          "text": "Ich kann die Schmerzen nicht mehr aushalten.",
          "translation": "Я больше не могу терпеть эту боль.",
          "source": "Tatoeba #568501 @Manfredo / #585298 @ae5s (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/568501",
          "cefr_level": "A1",
          "word_slugs": [
            "aushalten-verb"
          ]
        },
        {
          "id": "1290873",
          "text": "Sie kann es ohne Zigaretten nicht aushalten.",
          "translation": "Она не может обходиться без сигарет.",
          "source": "Tatoeba #1290873 @enteka / #1572037 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1290873",
          "cefr_level": "A1",
          "word_slugs": [
            "aushalten-verb"
          ]
        },
        {
          "id": "1217523",
          "text": "Ich kann diese Hitze einfach nicht mehr aushalten.",
          "translation": "Я просто не могу больше выносить эту жару.",
          "source": "Tatoeba #1217523 @Manfredo / #5571340 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1217523",
          "cefr_level": "A1",
          "word_slugs": [
            "aushalten-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
