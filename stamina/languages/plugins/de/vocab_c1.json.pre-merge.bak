      "gender": "f",
      "examples": [
        {
          "id": "5921998",
          "text": "Ein Jahr Garantie.",
          "translation": "Гарантия 1 год.",
          "source": "Tatoeba #5921998 @Pfirsichbaeumchen / #5472176 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5921998",
          "cefr_level": "A1",
          "word_slugs": [
            "garantie-noun"
          ]
        },
        {
          "id": "12441026",
          "text": "Die Garantie läuft ab.",
          "translation": "Гарантия истекает.",
          "source": "Tatoeba #12441026 @felix63 / #12907262 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12441026",
          "cefr_level": "A1",
          "word_slugs": [
            "garantie-noun"
          ]
        },
        {
          "id": "13930371",
          "text": "Wir geben keine Garantie.",
          "translation": "Мы не даём гарантий.",
          "source": "Tatoeba #13930371 @IAlexI / #8399373 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13930371",
          "cefr_level": "A1",
          "word_slugs": [
            "garantie-noun"
          ]
        },
        {
          "id": "361470",
          "text": "Ehrlichkeit ist keine Garantie für Erfolg.",
          "translation": "Честность не гарантия успеха.",
          "source": "Tatoeba #361470 @Wolf / #1580825 @Biga (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/361470",
          "cefr_level": "A1",
          "word_slugs": [
            "garantie-noun"
          ]
        },
        {
          "id": "5390422",
          "text": "Ich kann nicht so eine Garantie geben.",
          "translation": "Я не могу дать такой гарантии.",
          "source": "Tatoeba #5390422 @Yakuwari / #5390441 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5390422",
          "cefr_level": "A1",
          "word_slugs": [
            "garantie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
