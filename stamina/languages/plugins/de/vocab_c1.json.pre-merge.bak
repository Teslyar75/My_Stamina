    {
      "slug": "wehren-verb",
      "lemma": "wehren",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5425,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "to defend oneself",
          "to prevent the spread of something, to fight",
          "to deny, to prevent someone from doing something"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "10967424",
          "text": "Menschen wehren sich naturgemäß gegen Veränderung.",
          "translation": "Люди по природе своей сопротивляются переменам.",
          "source": "Tatoeba #10967424 @p0wcr / #10968527 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10967424",
          "cefr_level": "A1",
          "word_slugs": [
            "wehren-verb"
          ]
        },
        {
          "id": "1972803",
          "text": "Auch der Löwe muss sich vor der Mücke wehren.",
          "translation": "Даже лев должен защищаться от комара.",
          "source": "Tatoeba #1972803 @Esperantostern / #2896466 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1972803",
          "cefr_level": "A1",
          "word_slugs": [
            "wehren-verb"
          ]
        },
        {
          "id": "1973247",
          "text": "Der Liebe und dem Feuer muss man beizeiten wehren.",
          "translation": "Любовь и огонь нужно вовремя поддерживать.",
          "source": "Tatoeba #1973247 @Esperantostern / #13187265 @Korovin_Ilya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1973247",
          "cefr_level": "A1",
          "word_slugs": [
            "wehren-verb"
          ]
        },
        {
          "id": "3044970",
          "text": "Wir müssen denen helfen, die sich nicht wehren können.",
          "translation": "Мы должны помочь тем, кто не может себя защитить.",
          "source": "Tatoeba #3044970 @al_ex_an_der / #3044966 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3044970",
          "cefr_level": "A1",
          "word_slugs": [
            "wehren-verb"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "",
        "nominative_sg": "",
        "nominative_pl": ""
      }
