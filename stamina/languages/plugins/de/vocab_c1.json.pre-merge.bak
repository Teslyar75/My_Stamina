          ]
        },
        {
          "id": "12595501",
          "text": "Die Anzahl solcher Straftaten steigt.",
          "translation": "Число таких преступлений растёт.",
          "source": "Tatoeba #12595501 @mhr / #12595477 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12595501",
