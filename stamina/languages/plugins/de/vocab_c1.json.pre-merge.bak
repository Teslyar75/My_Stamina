    {
      "slug": "übrigen-adj",
      "lemma": "übrigen",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7731,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of übrig:",
          "strong genitive masculine/neuter singular",
          "inflection of übrig:",
          "weak/mixed genitive/dative all-gender singular"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "14016831",
          "text": "Im Übrigen sehe ich alles.",
          "translation": "Между прочим, я всё вижу.",
          "source": "Tatoeba #14016831 @mhr / #14016782 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14016831",
          "cefr_level": "A1",
          "word_slugs": [
            "übrigen-adj"
          ]
        },
        {
          "id": "14036914",
          "text": "Ich habe im Übrigen auch Geld.",
          "translation": "У меня тоже, между прочим, деньги есть.",
          "source": "Tatoeba #14036914 @mhr / #14036546 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/14036914",
          "cefr_level": "A1",
          "word_slugs": [
            "übrigen-adj"
          ]
        },
        {
          "id": "10477438",
          "text": "Die übrigen Passagiere wurden nicht verletzt.",
          "translation": "Остальные пассажиры не пострадали.",
          "source": "Tatoeba #10477438 @Pfirsichbaeumchen / #10477255 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10477438",
          "cefr_level": "A1",
          "word_slugs": [
            "übrigen-adj"
          ]
        },
        {
          "id": "3006747",
          "text": "Was machen wir mit dem übrigen Brot?",
          "translation": "Что будем делать с оставшимся хлебом?",
          "source": "Tatoeba #3006747 @raggione / #3012971 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3006747",
          "cefr_level": "A1",
          "word_slugs": [
            "übrigen-adj"
          ]
        },
        {
          "id": "1956511",
          "text": "Im Übrigen erscheint mir das Projekt völlig zufriedenstellend.",
          "translation": "В остальном проект кажется мне вполне удовлетворительным.",
          "source": "Tatoeba #1956511 @al_ex_an_der / #1956509 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1956511",
          "cefr_level": "A1",
          "word_slugs": [
            "übrigen-adj"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
