    {
      "slug": "momente-noun",
      "lemma": "Momente",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 5172,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "nominative/accusative/genitive plural of Moment"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "12705208",
          "text": "Für solche Momente lohnt es sich zu leben.",
          "translation": "Ради таких моментов стоит жить.",
          "source": "Tatoeba #12705208 @maaster / #12705610 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12705208",
          "cefr_level": "A1",
          "word_slugs": [
            "momente-noun"
          ]
        },
        {
          "id": "4472747",
          "text": "Das war einer der besten Momente meines Lebens.",
          "translation": "Это был один из лучших моментов в моей жизни.",
          "source": "Tatoeba #4472747 @Pfirsichbaeumchen / #4472744 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/4472747",
          "cefr_level": "A1",
          "word_slugs": [
            "momente-noun"
          ]
        },
        {
          "id": "2678258",
          "text": "Es gab zwei Momente, in denen es für mich nicht einfach war.",
          "translation": "Было два момента, когда мне было нелегко.",
          "source": "Tatoeba #2678258 @al_ex_an_der / #2678257 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2678258",
          "cefr_level": "A1",
          "word_slugs": [
            "momente-noun"
          ]
        },
        {
          "id": "10975692",
          "text": "Momente des Glücks kennen weder Zukunft noch Vergangenheit.",
          "translation": "Моменты счастья не знают ни будущего, ни прошлого.",
          "source": "Tatoeba #10975692 @Esperantostern / #10977026 @carlosalberto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10975692",
          "cefr_level": "A1",
          "word_slugs": [
            "momente-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
