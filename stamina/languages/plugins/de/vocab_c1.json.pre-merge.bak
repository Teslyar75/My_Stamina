          ]
        },
        {
          "id": "966165",
          "text": "Schreiben Sie ihr Geburtsdatum hierhin.",
          "translation": "Напишите здесь дату своего рождения.",
          "source": "Tatoeba #966165 @MUIRIEL / #3059389 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/966165",
