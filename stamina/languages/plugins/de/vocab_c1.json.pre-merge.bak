    {
      "slug": "misstrauisch-adj",
      "lemma": "misstrauisch",
      "pos": "adj",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7689,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "недоверчивый"
        ],
        "en": [
          "Formerly standard spelling of misstrauisch which was deprecated in the spelling reform (Rechtschreibreform) of 1996."
        ]
      },
      "gender": "m",
      "examples": [
        {
          "id": "13896287",
          "text": "Ich bin sehr mißtrauisch.",
          "translation": "Я очень недоверчивый.",
          "source": "Tatoeba #13896287 @Waldelfe / #7983011 @odexed (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13896287",
          "cefr_level": "A1",
          "word_slugs": [
            "misstrauisch-adj"
          ]
        },
        {
          "id": "6968664",
          "text": "Er sah mich misstrauisch an.",
          "translation": "Он смотрел на меня с подозрением.",
          "source": "Tatoeba #6968664 @Pfirsichbaeumchen / #4973482 @Karok (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6968664",
          "cefr_level": "A1",
          "word_slugs": [
            "misstrauisch-adj"
          ]
        },
        {
          "id": "5295684",
          "text": "Warum bist du so misstrauisch?",
          "translation": "Почему ты такой недоверчивый?",
          "source": "Tatoeba #5295684 @Sudajaengi / #5502874 @nina99nv (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5295684",
          "cefr_level": "A1",
          "word_slugs": [
            "misstrauisch-adj"
          ]
        },
        {
          "id": "7464138",
          "text": "Ich weiß, warum Tom misstrauisch wurde.",
          "translation": "Я знаю, почему Том стал недоверчивым.",
          "source": "Tatoeba #7464138 @Pfirsichbaeumchen / #7464311 @alik_farber (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7464138",
          "cefr_level": "A1",
          "word_slugs": [
            "misstrauisch-adj"
          ]
        },
        {
          "id": "12849348",
          "text": "Die Nachbarn sind ihm gegenüber misstrauisch.",
          "translation": "Соседи относятся к нему подозрительно.",
          "source": "Tatoeba #12849348 @mhr / #12849149 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12849348",
          "cefr_level": "A1",
          "word_slugs": [
            "misstrauisch-adj"
          ]
        }
