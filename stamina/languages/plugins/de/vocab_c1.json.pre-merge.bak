      "gender": null,
      "examples": [
        {
          "id": "453715",
          "text": "Worauf basiert deine Theorie?",
          "translation": "На чём основывается твоя теория?",
          "source": "Tatoeba #453715 @Espi / #1914627 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/453715",
          "cefr_level": "A1",
          "word_slugs": [
            "basiert-verb"
          ]
        },
        {
          "id": "10770623",
          "text": "Ihre Theorie basiert auf Fakten.",
          "translation": "Её теория основывается на фактах.",
          "source": "Tatoeba #10770623 @toivo / #3342955 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/10770623",
          "cefr_level": "A1",
          "word_slugs": [
