    {
      "slug": "sprecher-noun",
      "lemma": "Sprecher",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7948,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "a speaker; one who speaks (male or unspecified sex); especially:",
          "one who speaks in a presentation or performance, such as a radio drama or voiceover",
          "a speaker; one who speaks (male or unspecified sex); especially:",
          "an announcer, newsreader"
        ]
      },
      "gender": "f",
      "examples": [
        {
          "id": "3767570",
          "text": "Der Sprecher nutzte jede sich bietende Gelegenheit, um sich wichtigzutun.",
          "translation": "Говоривший использовал всякую подвернувшуюся возможность, чтобы выпятить себя.",
          "source": "Tatoeba #3767570 @Pfirsichbaeumchen / #3768446 @Ooneykcall (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3767570",
          "cefr_level": "A1",
          "word_slugs": [
            "sprecher-noun"
          ]
        },
        {
          "id": "5778440",
          "text": "Die meisten Sprecher des Laotischen leben nicht in Laos, sondern in Thailand.",
          "translation": "Большинство говорящих на лаосском живут не в Лаосе, а в Таиланде.",
          "source": "Tatoeba #5778440 @Pfirsichbaeumchen / #5777473 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5778440",
          "cefr_level": "A1",
          "word_slugs": [
            "sprecher-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
      "german": {
        "article": "die",
        "nominative_sg": "die Sprecher",
        "nominative_pl": ""
      }
    },
    {
      "slug": "chemie-noun",
      "lemma": "Chemie",
      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 7949,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "chemistry"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "3898345",
          "text": "Er mag Chemie.",
          "translation": "Он любит химию.",
          "source": "Tatoeba #3898345 @Miyako / #8060850 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3898345",
          "cefr_level": "A1",
          "word_slugs": [
            "chemie-noun"
          ]
        },
        {
          "id": "5992259",
          "text": "Sie mag Chemie.",
          "translation": "Она любит химию.",
          "source": "Tatoeba #5992259 @christian63 / #8060853 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/5992259",
          "cefr_level": "A1",
          "word_slugs": [
            "chemie-noun"
          ]
        },
        {
          "id": "7636161",
          "text": "Tom mag Chemie.",
          "translation": "Тому нравится химия.",
          "source": "Tatoeba #7636161 @wolfgangth / #7899090 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7636161",
          "cefr_level": "A1",
          "word_slugs": [
            "chemie-noun"
          ]
        },
        {
          "id": "247",
          "text": "Ich hasse Chemie.",
          "translation": "Я ненавижу химию.",
          "source": "Tatoeba #247 @MUIRIEL / #5578 @poji (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/247",
          "cefr_level": "A1",
          "word_slugs": [
            "chemie-noun"
          ]
        },
        {
          "id": "425620",
          "text": "Studierst du Chemie?",
          "translation": "Ты изучаешь химию?",
          "source": "Tatoeba #425620 @MUIRIEL / #2761383 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/425620",
          "cefr_level": "A1",
          "word_slugs": [
            "chemie-noun"
          ]
        }
      ],
      "tags": [
        "C1"
      ],
      "source": "Kaikki de (CC BY-SA 4.0); examples: Tatoeba (CC BY 2.0 FR)",
      "verified": true,
