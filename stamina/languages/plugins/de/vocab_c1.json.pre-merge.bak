          "cefr_level": "A1",
          "word_slugs": [
            "hebe-verb"
          ]
        },
        {
          "id": "6582384",
          "text": "Wer kein Buch hat, hebe die Hand.",
          "translation": "У кого нет книги, поднимите руку.",
