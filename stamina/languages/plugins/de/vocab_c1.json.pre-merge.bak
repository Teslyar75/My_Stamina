          ]
        },
        {
          "id": "1136189",
          "text": "Er ist das schwarze Schaf der Familie.",
          "translation": "Он в семье белая ворона.",
          "source": "Tatoeba #1136189 @MUIRIEL / #10951923 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1136189",
          "cefr_level": "A1",
          "word_slugs": [
            "schaf-noun"
          ]
        },
        {
          "id": "13031080",
          "text": "Das Schaf wurde von dem Wolf gerissen.",
          "translation": "Овцу убил волк.",
          "source": "Tatoeba #13031080 @mhr / #13030875 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13031080",
