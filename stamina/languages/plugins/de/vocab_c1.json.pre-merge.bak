    {
      "slug": "heiratete-verb",
      "lemma": "heiratete",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6589,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "inflection of heiraten:",
          "first/third-person singular preterite",
          "inflection of heiraten:",
          "first/third-person singular subjunctive II"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "414000",
          "text": "Er heiratete Ann.",
          "translation": "Он женился на Анне.",
          "source": "Tatoeba #414000 @xtofu80 / #1786298 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/414000",
          "cefr_level": "A1",
          "word_slugs": [
            "heiratete-verb"
          ]
        },
        {
          "id": "2554050",
          "text": "Ich heiratete Tom.",
          "translation": "Я вышла замуж за Тома.",
          "source": "Tatoeba #2554050 @ieflicca / #2606704 @Olya (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2554050",
          "cefr_level": "A1",
          "word_slugs": [
            "heiratete-verb"
          ]
        },
        {
          "id": "12031719",
          "text": "Wer heiratete sie?",
          "translation": "Кто на ней женился?",
          "source": "Tatoeba #12031719 @mhr / #12413956 @Wezel (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/12031719",
          "cefr_level": "A1",
          "word_slugs": [
            "heiratete-verb"
          ]
        },
        {
          "id": "6557024",
          "text": "Tom heiratete Maria.",
          "translation": "Том женился на Мэри.",
          "source": "Tatoeba #6557024 @Pfirsichbaeumchen / #3056207 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/6557024",
          "cefr_level": "A1",
          "word_slugs": [
            "heiratete-verb"
          ]
        },
        {
          "id": "797835",
          "text": "Er heiratete diese Frau.",
          "translation": "Он женился на этой женщине.",
          "source": "Tatoeba #797835 @Manfredo / #4230191 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/797835",
          "cefr_level": "A1",
          "word_slugs": [
            "heiratete-verb"
          ]
        }
