    {
      "slug": "platziert-verb",
      "lemma": "platziert",
      "pos": "verb",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 8404,
      "frequency_band": "goethe-c1",
      "translations": {
        "en": [
          "past participle of platzieren"
        ]
      },
      "gender": null,
      "examples": [
        {
          "id": "1916378",
          "text": "Das Observatorium ist gut platziert.",
          "translation": "Обсерватория удачно расположена.",
          "source": "Tatoeba #1916378 @Tamy / #10630671 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/1916378",
          "cefr_level": "A1",
          "word_slugs": [
            "platziert-verb"
          ]
        },
        {
          "id": "2373905",
          "text": "Was ist in diesem Gebäude platziert?",
          "translation": "Что помещается в этом здании?",
          "source": "Tatoeba #2373905 @Esperantostern / #2316118 @soweli_Elepanto (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2373905",
          "cefr_level": "A1",
          "word_slugs": [
            "platziert-verb"
          ]
        },
        {
          "id": "13635767",
          "text": "Ein Exlibris wird normalerweise auf der Innenseite des Einbands platziert.",
          "translation": "Экслибрис обычно ставится на внутренней стороне переплёта.",
          "source": "Tatoeba #13635767 @mhr / #13635713 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/13635767",
          "cefr_level": "A1",
          "word_slugs": [
