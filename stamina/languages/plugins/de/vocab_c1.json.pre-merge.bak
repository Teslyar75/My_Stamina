      "pos": "noun",
      "language": "de",
      "cefr_level": "C1",
      "frequency_rank": 6197,
      "frequency_band": "goethe-c1",
      "translations": {
        "ru": [
          "шайба"
        ],
        "en": [
          "flat piece or surface",
          "disc",
          "flat piece or surface",
          "slice (e.g. of bread)"
        ]
      },
      "gender": "n",
      "examples": [
        {
          "id": "7010997",
          "text": "Im Notfall Scheibe einschlagen.",
          "translation": "При аварии разбить стекло.",
          "source": "Tatoeba #7010997 @driini / #4492018 @marafon (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/7010997",
          "cefr_level": "A1",
          "word_slugs": [
            "scheibe-noun"
          ]
        },
        {
          "id": "3454711",
          "text": "Die Erde ist eine Scheibe.",
          "translation": "Земля плоская.",
          "source": "Tatoeba #3454711 @Pfirsichbaeumchen / #3454697 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/3454711",
          "cefr_level": "A1",
          "word_slugs": [
            "scheibe-noun"
          ]
        },
        {
          "id": "2279015",
          "text": "Mir scheint, die Erde ist eine Scheibe.",
          "translation": "Мне кажется, Земля плоская.",
          "source": "Tatoeba #2279015 @al_ex_an_der / #2279013 @al_ex_an_der (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2279015",
          "cefr_level": "A1",
          "word_slugs": [
            "scheibe-noun"
          ]
        },
        {
          "id": "2913625",
          "text": "Tom bestrich sich eine Scheibe Brot mit Erdbeermarmelade.",
          "translation": "Том намазал ломтик хлеба земляничным мармеладом.",
          "source": "Tatoeba #2913625 @Pfirsichbaeumchen / #2927707 @corvard (CC BY 2.0 FR) https://tatoeba.org/eng/sentences/show/2913625",
          "cefr_level": "A1",
          "word_slugs": [
            "scheibe-noun"
          ]
        }
      ],
