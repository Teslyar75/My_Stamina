          "cefr_level": "A1",
          "word_slugs": [
            "vorschläge-noun"
          ]
        },
        {
          "id": "8118311",
          "text": "Sie hat alle Vorschläge abgewiesen.",
          "translation": "Она отвергла все предложения.",
