      "minutes": 20,
      "theory": [
        {
          "kind": "text",
          "text": "Deutsche Wortbildung: Präfixe (Veränderung der Bedeutung), Suffixe (Wortartänderung), Komposita (Zusammensetzungen)."
        },
        {
          "kind": "rule",
          "title": "Präfixe (Verben)",
          "text": "be- (transitivieren: liegen → belügen), ent- (Gegenteil/Entfernung: laden → entladen), er- (Erfolg/Inchoativ: finden → erfinden), ver- (Fehler/Richtung: laufen → verlaufen), zer- (Zerstörung: brechen → zerbrechen), miss- (Misslingen: verstehen → missverstehen)."
        },
        {
          "kind": "rule",
          "title": "Präfixe (Adjektive/Substantive)",
          "text": "un- (Negation: glücklich → unglücklich), miss- (Miss-: Erfolg → Misserfolg), Haupt- (Haupt-: Stadt → Hauptstadt), Fehl- (Fehl-: Leitung → Fehlleitung)."
        },
        {
          "kind": "rule",
          "title": "Suffixe (Substantive)",
          "text": "-ung (Verben: entscheiden → Entscheidung), -heit/-keit (Adjektive: gesund → Gesundheit, frei → Freiheit), -nis (Adjektive/Verben: bitter → Bitternis, kennen → Kenntnis), -tum (Adjektive/Substantive: eigen → Eigentum), -schaft (Substantive: Freund → Freundschaft)."
        },
        {
          "kind": "rule",
          "title": "Suffixe (Adjektive)",
          "text": "-bar (Möglichkeit: lesen → lesbar), -los (Fehlen: hoffen → hoffnungslos), -haft (Eigenschaft: Kind → kindhaft), -ig (Eigenschaft: mutig), -isch (Zugehörigkeit: deutsch)."
        },
        {
          "kind": "rule",
          "title": "Komposita",
          "text": "Bestimmungswort + Grundwort: Hauptstadt, Handschuh, Zahnarzt. Fugenlaute: -n-, -s-, -en-, -e- (Hundehütte, Arbeitsamt, Gastgeber)."
        },
        {
          "kind": "example",
          "de": "Entscheidung, Gesundheit, lesbar, hoffnungslos, Hauptstadt, Handschuh, missverstehen, erfinden, zerbrechen.",
          "ru": "Решение, здоровье, читаемый, безнадежный, столица, перчатка, неверно понять, изобретать, разбить.",
          "note": "Präfixe verändern Bedeutung, Suffixe Wortart, Komposita = neue Wörter."
        }
      ],
