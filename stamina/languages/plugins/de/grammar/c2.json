    {
      "id": "c2-02-idiomatik",
      "order": 2,
      "title": "Идиомы и коллокации",
      "subtitle": "Feste Ausdrücke, Bildlichkeit, Phraseme, Redewendungen",
      "topics": [
        "funktionsverbgefuege"
      ],
      "prereq": [
        "c2-01-nuancen",
        "b2-08-funktionsverbgefuege"
      ],
      "minutes": 20,
      "theory": [
        {
          "kind": "text",
          "text": "Idiome = feste Ausdrücke, deren Bedeutung nicht aus den Einzelwörtern ableitbar ist. Phraseme = teilidiomatisch. Kollokationen = häufige Wortverbindungen."
        },
        {
          "kind": "rule",
          "title": "Vollidiome (Bedeutung nicht ableitbar)",
          "text": "ins Gras beißen (sterben), den Löffel abgeben (sterben), das Handtuch werfen (aufgeben), um den heißen Brei reden (nicht direkt sagen), den Nagel auf den Kopf treffen (genau richtig)."
        },
        {
          "kind": "rule",
          "title": "Phraseme (teilweise idiomatisch)",
          "text": "eine Rolle spielen, in Frage stellen, zu Rate ziehen, ins Gewicht fallen, die Fäden ziehen, das Ruder herumreißen."
        },
        {
          "kind": "rule",
          "title": "Kollokationen (häufige Kombinationen)",
          "text": "schwer wiegen, große Bedeutung haben, in Betracht ziehen, Anwendung finden, Rechnung tragen."
        },
        {
          "kind": "rule",
          "title": "Redewendungen mit Körperteilen",
          "text": "den Kopf verlieren (Panik), die Zähne zusammenbeißen (durchhalten), ein Auge zudrücken (tolerieren), die Finger kreuzen (hoffen), ins Fettnäpfchen treten (Fehler machen)."
        },
        {
          "kind": "example",
          "de": "Er hat den Löffel abgegeben. (gestorben). Um den heißen Brei reden. (nicht direkt). Die Fäden ziehen. (hinter den Kulissen steuern). Ins Fettnäpfchen treten. (peinlicher Fehler).",
          "ru": "Он сдал кончики. (умер). Ходить вокруг да около. (не по существу). Пускать нити. (управлять тайно). Наступать на грабли. (глупая ошибка).",
          "note": "Idiome nicht wörtlich übersetzbar. Phraseme teilweise. Kollokationen = Statistik."
        }
      ],
      "drills": [
