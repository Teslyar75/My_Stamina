    {
      "id": "c2-03-stilregister",
      "order": 3,
      "title": "Стилистические регистры",
      "subtitle": "Hochsprache, Umgangssprache, Fachsprache, Jugendslang, Netzhaut",
      "topics": [
        "wortbildung"
      ],
      "prereq": [
        "c2-01-nuancen",
        "c2-02-idiomatik",
        "c1-03-akademisch"
      ],
      "minutes": 20,
      "theory": [
        {
          "kind": "text",
          "text": "Stilregister = Sprachvarietäten nach Situation, Thema, Medium. C2 beherrscht Registerwechsel bewusst."
        },
        {
          "kind": "rule",
          "title": "Hochsprache (gehoben)",
          "text": "Archaismen, komplexe Syntax, Nominalstil, Konjunktiv I, Fremdwörter. 'Es sei dahingestellt, ob...' 'Der Beschluss bedarf der Genehmigung.'"
        },
        {
          "kind": "rule",
          "title": "Standardsprache (schriftlich/mündlich)",
          "text": "Klare Grammatik, moderate Fremdwörter, Verbalstil. 'Es ist unklar, ob...' 'Der Beschluss muss genehmigt werden.'"
        },
        {
          "kind": "rule",
          "title": "Umgangssprache (mündlich, privat)",
          "text": "Kurzformen, Partikeln, elliptisch, idiomatisch. 'Is unklar, ob...' 'Der Beschluss muss genehmigt werden, gell?'"
        },
        {
          "kind": "rule",
          "title": "Fachsprache / Behördendeutsch",
          "text": "Präzision, Nominalstil, Passiv, Definitionen. 'Die Antragstellung erfolgt formgebunden.' 'Eine Genehmigungspflicht besteht.'"
        },
        {
          "kind": "rule",
          "title": "Jugendslang / Netzhaut",
          "text": "Anglizismen, Verkürzungen, Neologismen, Ironie. 'Das ist cringe.' 'Ich bin down.' 'No cap.' 'Ehrenmann.'"
        },
        {
          "kind": "example",
          "de": "Hoch: Es sei dahingestellt. Standard: Es ist unklar. Umgangssprachlich: Is unklar. Behörde: Die Klärung erfolgt. Jugend: Das ist cringe.",
          "ru": "Высокий: Предстоит решить. Стандарт: Неясно. Разговорный: Неясно. Канцелярит: Прояснение производится. Молодёжь: Это кринж.",
          "note": "Registerwechsel = stilistische Kompetenz."
        }
      ],
      "drills": [
        {
          "id": "c2-03-d01",
          "type": "choice",
          "prompt": "Hochsprache: 'Es ____ dahingestellt, ob...'",
          "options": [
            "sei",
            "ist",
            "wäre",
