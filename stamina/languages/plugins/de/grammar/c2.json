    {
      "id": "c2-02-idiomatik",
      "order": 2,
      "title": "Идиомы и коллокации",
      "subtitle": "Feste Ausdrücke, Bildlichkeit, Phraseme, Redewendungen",
      "topics": [
        "funktionsverbgefuege"
      ],
      "prereq": [
        "c2-01-nuancen",
        "b2-08-funktionsverbgefuege"
      ],
      "minutes": 20,
      "theory": [
        {
          "kind": "text",
          "text": "Идиомы = устойчивые выражения, значение которых не выводится из отдельных слов. Фраземи = частично идиоматичны. Коллокации = частые словосочетания."
        },
        {
          "kind": "rule",
          "title": "Полные идиомы (значение не выводится)",
          "text": "ins Gras beißen (умереть), den Löffel abgeben (умереть), das Handtuch werfen (сдаться), um den heißen Brei reden (не говорить прямо), den Nagel auf den Kopf treffen (попасть в точку)."
        },
        {
          "kind": "rule",
          "title": "Фраземи (частично идиоматичны)",
          "text": "eine Rolle spielen (играть роль), in Frage stellen (поставить под сомнение), zu Rate ziehen (обратиться за советом), ins Gewicht fallen (иметь значение), die Fäden ziehen (пускать нити), das Ruder herumreißen (перехватить управление)."
        },
        {
          "kind": "rule",
          "title": "Коллокации (частые сочетания)",
          "text": "schwer wiegen (весить много / иметь большой вес), große Bedeutung haben (иметь большое значение), in Betracht ziehen (рассмотреть), Anwendung finden (найти применение), Rechnung tragen (принять во внимание)."
        },
        {
          "kind": "rule",
          "title": "Устойчивые выражения с частями тела",
          "text": "den Kopf verlieren (паника), die Zähne zusammenbeißen (выдерживать), ein Auge zudrücken (закрывать глаза), die Finger kreuzen (надеяться), ins Fettnäpfchen treten (совершить ошибку)."
        },
        {
          "kind": "example",
          "de": "Er hat den Löffel abgegeben. (gestorben). Um den heißen Brei reden. (nicht direkt). Die Fäden ziehen. (hinter den Kulissen steuern). Ins Fettnäpfchen treten. (peinlicher Fehler).",
          "ru": "Он сдал кончики. (умер). Ходить вокруг да около. (не по существу). Пускать нити. (управлять тайно). Наступать на грабли. (глупая ошибка).",
          "note": "Идиомы нельзя переводить дословно. Фраземи — частично. Коллокации — это статистика."
        }
      ],
