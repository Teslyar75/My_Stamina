    {
      "id": "c2-01-nuancen",
      "order": 1,
      "title": "Тонкие различия близких слов",
      "subtitle": "synonyme Verben/Adjektive, Registerunterschiede, Kollokationen",
      "topics": [
        "wortbildung"
      ],
      "prereq": [
        "c1-06-wortbildung",
        "c1-03-akademisch"
      ],
      "minutes": 20,
      "theory": [
        {
          "kind": "text",
          "text": "C2: тонкости значения, регистр (формальный/разговорный), устойчивые коллокации, стилистические нюансы."
        },
        {
          "kind": "rule",
          "title": "Глаголы: sehen / anschauen / betrachten / beobachten",
          "text": "sehen = неосознанно (просто видеть). anschauen = осознанно, кратко. betrachten = дольше, внимательно. beobachten = систематически, во времени."
        },
        {
          "kind": "rule",
          "title": "Глаголы: fragen / bitten / ersuchen / auffordern",
          "text": "fragen = нейтрально. bitten = вежливо, просьба. ersuchen = формально, ведомственно. auffordern = авторитарно, официально."
        },
        {
          "kind": "rule",
          "title": "Прилагательные: groß / großartig / gewaltig / riesig",
          "text": "groß = физически. großartig = с восхищением. gewaltig = впечатляюще, часто негативно. riesig = очень большой (разговорно)."
        },
        {
          "kind": "rule",
          "title": "Коллокации (устойчивые сочетания)",
          "text": "eine Entscheidung treffen (не *machen), zur Kenntnis nehmen (не *wissen), in Frage kommen (не *fragen), Anwendung finden (не *finden)."
        },
        {
          "kind": "rule",
          "title": "Регистр: формальный vs разговорный",
          "text": "erhalten (формально) vs bekommen (нейтрально) vs kriegen (разговорно). verfügen über (формально) vs haben (нейтрально)."
        },
        {
          "kind": "example",
          "de": "Er betrachtet das Bild. (nicht *anschaut lange). Die Behörde ersucht um Auskunft. (nicht *fragt). Eine große Entscheidung treffen. Er verfügt über gute Kenntnisse. (formell)",
          "ru": "Он рассматривает картину. Ведомство запрашивает сведения. Принять важное решение. Он обладает хорошими знаниями (офиц.).",
          "note": "betrachten — более длительное, чем anschauen. ersuchen — официальнее, чем fragen. treffen — правильный глагол для решения, не machen. verfügen über — официальный вариант haben."
        }
      ],
      "drills": [
