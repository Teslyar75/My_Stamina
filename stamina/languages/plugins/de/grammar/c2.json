    {
      "id": "c2-04-fehleranalyse",
      "order": 4,
      "title": "Typische Fehler und wie man sie erkennt",
      "subtitle": "Interferenzfehler, Hyperkorrektur, Falsche Freunde, Syntaxfallen",
      "topics": [
        "konjunktiv_ii",
        "passiv_zeiten",
        "wortbildung"
      ],
      "prereq": [
        "c2-03-stilregister",
        "c1-03-akademisch",
        "b2-09-passiv-modal"
      ],
      "minutes": 20,
      "theory": [
        {
          "kind": "text",
          "text": "C2-Fehleranalyse: Erkennen und Korrigieren typischer Fehler von Lernern (auch fortgeschrittenen)."
        },
        {
          "kind": "rule",
          "title": "Interferenz (Muttersprache)",
          "text": "Russisch: 'Ich bin einverstanden' (richtig) vs 'Ich stimme zu' (richtig). Falsch: 'Ich bin einverstanden mit dir' (lieber: 'Ich stimme dir zu'). 'Ich habe Recht' vs 'Ich liege richtig'."
        },
        {
          "kind": "rule",
          "title": "Hyperkorrektur",
          "text": "Überkorrektur: 'wen' statt 'wem' (wem = Dativ!). 'Der Mann, den ich helfe' (falsch, helfen + Dat → dem). 'Ich rate dir zu kommen' (richtig: rate dir, zu kommen)."
        },
        {
          "kind": "rule",
          "title": "Falsche Freunde (Deutsch-Russisch)",
          "text": "aktuell = gegenwärtig (nicht *aktuell = wirklich). eventuell = möglicherweise (nicht *эвентуально = случайно). konfus = verwirrt (nicht *конфуз = смущённый). symmetrisch = symmetrisch (ok)."
        },
        {
          "kind": "rule",
          "title": "Syntaxfallen",
          "text": "V2-Verletzung: 'Heute ich gehe' (falsch). Präpositionalfall: 'Ich warte auf ihn' (nicht *auf er). Konjunktiv: 'Wenn ich wäre' (falsch: 'wäre ich'). Passiv: 'ist geworden' statt 'ist worden'."
        },
        {
          "kind": "rule",
          "title": "Kasusfehler bei Verben",
          "text": "helfen + Dat (nicht Akk), danken + Dat, folgen + Dat, gefallen + Dat. 'Ich helfe ihn' → falsch: 'Ich helfe ihm'."
        },
        {
          "kind": "example",
          "de": "Falsch: 'Ich helfe ihn.' Richtig: 'Ich helfe ihm.' Falsch: 'Wenn ich wäre reich.' Richtig: 'Wäre ich reich.' Falsch: 'Das ist geworden.' Richtig: 'Das ist geworden.' (Partizip II) / 'Das ist worden.' (Passiv Perfekt).",
          "ru": "Ошибка: 'Я помогаю ему (Akk)'. Правильно: 'Ich helfe ihm (Dat)'. Ошибка: 'Wenn ich wäre reich'. Правильно: 'Wäre ich reich'.",
          "note": "Kasus (helfen + Dat), V2, Konjunktiv II Wortstellung, Passiv Perfekt (worden)."
        }
      ],
      "drills": [
        {
          "id": "c2-04-d01",
          "type": "choice",
          "prompt": "Kasus bei 'helfen': 'Ich helfe ____ '",
          "options": [
            "ihm",
            "ihn",
            "er",
            "sein"
          ],
          "answer": [
            "ihm"
          ],
          "why": "helfen + Dativ."
        },
        {
          "id": "c2-04-d02",
          "type": "choice",
          "prompt": "Konjunktiv II Wortstellung: '____ ich reich, ____ ich reisen.'",
          "options": [
            "Wäre / würde",
            "Wenn ich / würde",
            "Wäre / würde ich",
            "Wenn ich wäre / würde ich"
