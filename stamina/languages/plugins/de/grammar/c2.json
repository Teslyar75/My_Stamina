    {
      "id": "c2-01-nuancen",
      "order": 1,
      "title": "Тонкие различия близких слов",
      "subtitle": "synonyme Verben/Adjektive, Registerunterschiede, Kollokationen",
      "topics": [
        "wortbildung"
      ],
      "prereq": [
        "c1-06-wortbildung",
        "c1-03-akademisch"
      ],
      "minutes": 20,
      "theory": [
        {
          "kind": "text",
          "text": "C2: Feinheiten der Bedeutung, Register (formell/umgangssprachlich), feste Kollokationen, stilistische Nuancen."
        },
        {
          "kind": "rule",
          "title": "Verben: sehen/anschauen/betrachten/beobachten",
          "text": "sehen = unwillkürlich. anschauen = bewusst, kurz. betrachten = länger, aufmerksam. beobachten = systematisch, über Zeit."
        },
        {
          "kind": "rule",
          "title": "Verben: fragen/bitten/ersuchen/auffordern",
          "text": "fragen = neutral. bitten = höflich, Bitte. ersuchen = formell, behördlich. auffordern = autoritär, offiziell."
        },
        {
          "kind": "rule",
          "title": "Adjektive: groß/großartig/gewaltig/riesig",
          "text": "grß = physisch. großartig = bewundernd. gewaltig = beeindruckend, oft negativ. riesig = sehr groß (umgangssprachlich)."
        },
        {
          "kind": "rule",
          "title": "Kollokationen (feste Verbindungen)",
          "text": "eine Entscheidung treffen (nicht *machen), zur Kenntnis nehmen (nicht *wissen), in Frage kommen (nicht *fragen), Anwendung finden (nicht *finden)."
        },
        {
          "kind": "rule",
          "title": "Register: formell vs umgangssprachlich",
          "text": "erhalten (formell) vs bekommen (neutral) vs kriegen (umgangssprachlich). verfügen über (formell) vs haben (neutral)."
        },
        {
          "kind": "example",
          "de": "Er betrachtet das Bild. (nicht *anschaut lange). Die Behörde ersucht um Auskunft. (nicht *fragt). Eine große Entscheidung treffen. Er verfügt über gute Kenntnisse. (formell)",
          "ru": "Он рассматривает картину. Ведомство запрашивает сведения. Принять важное решение. Он обладает хорошими знаниями (офиц.).",
          "note": "betrachten > anschauen. ersuchen > fragen. treffen > machen. verfügen über > haben."
        }
      ],
      "drills": [
        {
